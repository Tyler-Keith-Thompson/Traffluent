{"identifier":{"url":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"topicSections":[{"anchor":"Recording-a-bodys-events","title":"Recording a body’s events","identifiers":["doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-8blfh","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-mlec","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-26pul","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-pnmv"]},{"anchor":"Reading-what-was-tracked","title":"Reading what was tracked","identifiers":["doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording"]}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"code":"withRecordingTracker","type":"codeVoice"},{"type":"text","text":" makes a tracker, binds it to the current task with "},{"code":"withTracker","type":"codeVoice"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"length of its body, then finishes it and returns a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording"},{"type":"text","text":" of every event tracked"},{"type":"text","text":" "},{"type":"text","text":"through it. Each call makes its own tracker, so tests that run at once never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. Events tracked after the body returns, by work it started but didn’t wait for, are dropped."}],"type":"paragraph"},{"inlineContent":[{"text":"There are four spellings. The body can be synchronous or asynchronous, and it can take the tracker","type":"text"},{"text":" ","type":"text"},{"text":"as a parameter, for code that is handed its tracker (a SwiftUI view given it with ","type":"text"},{"code":"tracker(_:)","type":"codeVoice"},{"text":", a","type":"text"},{"text":" ","type":"text"},{"text":"UIKit view controller given it as a trait) rather than reading ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A recording holds what the body returned, every record with its timestamp, source location and"},{"type":"text","text":" "},{"type":"text","text":"context, each event’s name, and the events of one type through "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording\/events(of:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Add the product to test targets only. To check a tracking plan from a test, use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"TrackingPlanTesting"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["import Testing","import TrackerTesting","","@Test func checkingOutTracksTheCartSize() async {","    let tracked = await withRecordingTracker { tracker in","        tracker.track(CheckoutStarted(cartSize: 3))","        return \"done\"","    }","    #expect(tracked.value == \"done\")","    #expect(tracked.names == [\"CheckoutStarted\"])","    #expect(tracked.events(of: CheckoutStarted.self).map(\\.cartSize) == [3])","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/testingwhatyoutrack","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers views, view controllers and asynchronous code.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/trackertesting"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"TrackerTesting"}],"externalID":"TrackerTesting","symbolKind":"module","title":"TrackerTesting","roleHeading":"Framework","role":"collection"},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"references":{"doc://TrackerTesting/documentation/TrackerTesting":{"url":"\/documentation\/trackertesting","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}],"type":"topic","role":"collection","title":"TrackerTesting","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","kind":"symbol"},"doc://TrackerTesting/documentation/TrackerTesting/TrackerRecording":{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TrackerRecording"}],"url":"\/documentation\/trackertesting\/trackerrecording","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrackerRecording"}],"title":"TrackerRecording","abstract":[{"text":"Every event tracked while ","type":"text"},{"code":"withRecordingTracker","type":"codeVoice"},{"text":" ran its body, in the order tracked, with what","type":"text"},{"text":" ","type":"text"},{"text":"the body returned.","type":"text"}]},"doc://TrackerTesting/documentation/TrackerTesting/withRecordingTracker(_:)-mlec":{"url":"\/documentation\/trackertesting\/withrecordingtracker(_:)-mlec","abstract":[{"type":"text","text":"Runs "},{"code":"body","type":"codeVoice"},{"type":"text","text":" with a tracker of its own bound to the current task, then returns every event"},{"type":"text","text":" "},{"type":"text","text":"tracked through it, in the order tracked."}],"type":"topic","role":"symbol","title":"withRecordingTracker(_:)","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-mlec","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"tex