{"hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","symbolKind":"module","role":"collection","title":"TrackerTesting","externalID":"TrackerTesting","modules":[{"name":"TrackerTesting"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackertesting"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" makes a tracker, binds it to the current task with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"length of its body, then finishes it and returns a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording"},{"type":"text","text":" of every event tracked"},{"type":"text","text":" "},{"type":"text","text":"through it. Each call makes its own tracker, so tests that run at once never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. Events tracked after the body returns, by work it started but didn’t wait for, are dropped."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There are four spellings. The body can be synchronous or asynchronous, and it can take the tracker"},{"type":"text","text":" "},{"type":"text","text":"as a parameter, for code that is handed its tracker (a SwiftUI view given it with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", a"},{"type":"text","text":" "},{"type":"text","text":"UIKit view controller given it as a trait) rather than reading "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"A recording holds what the body returned, every record with its timestamp, source location and","type":"text"},{"text":" ","type":"text"},{"text":"context, each event’s name, and the events of one type through ","type":"text"},{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording\/events(of:)","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Add the product to test targets only. To check a tracking plan from a test, use"},{"type":"text","text":" "},{"type":"codeVoice","code":"TrackingPlanTesting"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Testing","import TrackerTesting","","@Test func checkingOutTracksTheCartSize() async {","    let tracked = await withRecordingTracker { tracker in","        tracker.track(CheckoutStarted(cartSize: 3))","        return \"done\"","    }","    #expect(tracked.value == \"done\")","    #expect(tracked.names == [\"CheckoutStarted\"])","    #expect(tracked.events(of: CheckoutStarted.self).map(\\.cartSize) == [3])","}"]},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/testingwhatyoutrack"},{"type":"text","text":" "},{"type":"text","text":"covers views, view controllers and asynchronous code."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}],"topicSections":[{"title":"Recording a body’s events","anchor":"Recording-a-bodys-events","identifiers":["doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-8blfh","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-mlec","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-26pul","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-pnmv"]},{"title