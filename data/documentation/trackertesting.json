{"abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}],"metadata":{"modules":[{"name":"TrackerTesting"}],"roleHeading":"Framework","title":"TrackerTesting","role":"collection","symbolKind":"module","externalID":"TrackerTesting"},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-8blfh","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-mlec","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-26pul","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-pnmv"],"anchor":"Recording-a-bodys-events","title":"Recording a body’s events"},{"identifiers":["doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording"],"anchor":"Reading-what-was-tracked","title":"Reading what was tracked"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackertesting"]}],"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" makes a tracker, binds it to the current task with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"length of its body, then finishes it and returns a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording"},{"type":"text","text":" of every event tracked"},{"type":"text","text":" "},{"type":"text","text":"through it. Each call makes its own tracker, so tests that run at once never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. Events tracked after the body returns, by work it started but didn’t wait for, are dropped."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are four spellings. The body can be synchronous or asynchronous, and it can take the tracker"},{"type":"text","text":" "},{"type":"text","text":"as a parameter, for code that is handed its tracker (a SwiftUI view given it with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", a"},{"type":"text","text":" "},{"type":"text","text":"UIKit view controller given it as a trait) rather than reading "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A recording holds what the body returned, every record with its timestamp, source location and"},{"type":"text","text":" "},{"type":"text","text":"context, each event’s name, and the events of one type through "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording\/events(of:)","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Add the product to test targets only. To check a tracking plan from a test, use","type":"text"},{"text":" ","type":"text"},{"code":"TrackingPlanTesting","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Testing","import TrackerTesting","","@Test func checkingOutTracksTheCartSize() async {","    let tracked = await withRecordingTracker { tracker in","        tracker.track(CheckoutStarted(cartSize: 3))","        return \"done\"","    }","    #expect(tracked.value == \"done\")","    #expect(tracked.names == [\"CheckoutStarted\"])","    #expect(tracked.events(of: CheckoutStarted.self).map(\\.cartSize) == [3])","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/testingwhatyoutrack","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"covers views, view controllers and asynchronous code."}]}],"kind":"content"}],"references":{"doc://TrackerTesting/documentation/TrackerTesting/withRecordingTracker(_:)-26pul":{"kind":"symbol","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-26pul","role":"symbol","url":"\/documentation\/trackertesting\/withrecordingtracker(_:)-26pul","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withRecordingTracker"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">(("},{"preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier","text":"Tracker"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:14TrackerTesting0A9RecordingV","kind":"typeIdentifier","text":"TrackerRecording"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">"}],"title":"withRecordingTracker(_:)","abstract":[{"type":"text","text":"Runs "},{"type":"codeVoice","code":"body"},{"type":"text","text":" with a tracker of its own, which it is given and which is bound to the current"},{"type":"text","text":" "},{"type":"text","text":"task, then returns every event tracked through it, in the order tracked."}]},"doc://TrackerTesting/documentation/TrackerTesting/withRecordingTracker(_:)-8blfh":{"kind":"symbol","