{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},"metadata":{"modules":[{"name":"TrackerTesting"}],"role":"collection","title":"TrackerTesting","roleHeading":"Framework","symbolKind":"module","externalID":"TrackerTesting"},"topicSections":[{"identifiers":["doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-8blfh","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-mlec","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-26pul","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-pnmv"],"anchor":"Recording-a-bodys-events","title":"Recording a body’s events"},{"identifiers":["doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording"],"anchor":"Reading-what-was-tracked","title":"Reading what was tracked"}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"withRecordingTracker","type":"codeVoice"},{"type":"text","text":" makes a tracker, binds it to the current task with "},{"code":"withTracker","type":"codeVoice"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"length of its body, then finishes it and returns a "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording","isActive":true},{"type":"text","text":" of every event tracked"},{"type":"text","text":" "},{"type":"text","text":"through it. Each call makes its own tracker, so tests that run at once never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. Events tracked after the body returns, by work it started but didn’t wait for, are dropped."}]},{"type":"paragraph","inlineContent":[{"text":"There are four spellings. The body can be synchronous or asynchronous, and it can take the tracker","type":"text"},{"text":" ","type":"text"},{"text":"as a parameter, for code that is handed its tracker (a SwiftUI view given it with ","type":"text"},{"type":"codeVoice","code":"tracker(_:)"},{"text":", a","type":"text"},{"text":" ","type":"text"},{"text":"UIKit view controller given it as a trait) rather than reading ","type":"text"},{"type":"codeVoice","code":"Tracker.current"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A recording holds what the body returned, every record with its timestamp, source location and"},{"type":"text","text":" "},{"type":"text","text":"context, each event’s name, and the events of one type through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording\/events(of:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to test targets only. To check a tracking plan from a test, use"},{"type":"text","text":" "},{"type":"codeVoice","code":"TrackingPlanTesting"},{"type":"text","text":"."}]},{"code":["import Testing","import TrackerTesting","","@Test func checkingOutTracksTheCartSize() async {","    let tracked = await withRecordingTracker { tracker in","        tracker.track(CheckoutStarted(cartSize: 3))","        return \"done\"","    }","    #expect(tracked.value == \"done\")","    #expect(tracked.names == [\"CheckoutStarted\"])","    #expect(tracked.events(of: CheckoutStarted.self).map(\\.cartSize) == [3])","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/testingwhatyoutrack","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers views, view controllers and asynchronous code."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/trackertesting"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/testingwhatyoutrack":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/testingwhatyoutrack","titleInlineContent":[{"type":"text","text":"Testing What Your Code Tracks"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/testingwhatyoutrack","title":"Testing What Your Code Tracks"},"doc://TrackerTesting/documentation/TrackerTesting/withRecordingTracker(_:)-8blfh":{"kind":"symbol","url":"\/documentation\/trackertesting\/withrecordingtracker(_:)-8blfh","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withRecordingTracker","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":">(() ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"TrackerRecording","kind":"typeIdentifier","preciseIdentifier":"s:14TrackerTesting0A9RecordingV"},{"text":"<","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-8blfh","abstract":[{"type":"text","text":"Runs "},{"code":"body","type":"codeVoice"},{"type":"text","text":" with a tracker 