{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"symbolKind":"module","role":"collection","title":"TrackerTesting","externalID":"TrackerTesting","modules":[{"name":"TrackerTesting"}],"roleHeading":"Framework"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" makes a tracker, binds it to the current task with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"length of its body, then finishes it and returns a "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording","isActive":true},{"type":"text","text":" of every event tracked"},{"type":"text","text":" "},{"type":"text","text":"through it. Each call makes its own tracker, so tests that run at once never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. Events tracked after the body returns, by work it started but didn’t wait for, are dropped."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There are four spellings. The body can be synchronous or asynchronous, and it can take the tracker"},{"type":"text","text":" "},{"type":"text","text":"as a parameter, for code that is handed its tracker (a SwiftUI view given it with "},{"code":"tracker(_:)","type":"codeVoice"},{"type":"text","text":", a"},{"type":"text","text":" "},{"type":"text","text":"UIKit view controller given it as a trait) rather than reading "},{"code":"Tracker.current","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A recording holds what the body returned, every record with its timestamp, source location and"},{"type":"text","text":" "},{"type":"text","text":"context, each event’s name, and the events of one type through "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording\/events(of:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Add the product to test targets only. To check a tracking plan from a test, use"},{"type":"text","text":" "},{"type":"codeVoice","code":"TrackingPlanTesting"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Testing","import TrackerTesting","","@Test func checkingOutTracksTheCartSize() async {","    let tracked = await withRecordingTracker { tracker in","        tracker.track(CheckoutStarted(cartSize: 3))","        return \"done\"","    }","    #expect(tracked.value == \"done\")","    #expect(tracked.names == [\"CheckoutStarted\"])","    #expect(tracked.events(of: CheckoutStarted.self).map(\\.cartSize) == [3])","}"]},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/testingwhatyoutrack","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers views, view controllers and asynchronous code."}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Recording a body’s events","anchor":"Recording-a-bodys-events","identifiers":["doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-8blfh","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-mlec","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-26pul","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-pnmv"]},{"title":"Reading what was tracked","anchor":"Reading-what-was-tracked","identifiers":["doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording"]}],"variants":[{"paths":["\/documentation\/trackertesting"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":