{"sections":[],"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}],"metadata":{"role":"collection","title":"TrackerTesting","externalID":"TrackerTesting","modules":[{"name":"TrackerTesting"}],"roleHeading":"Framework","symbolKind":"module"},"identifier":{"url":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Recording-a-bodys-events","title":"Recording a body’s events","identifiers":["doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-8blfh","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-mlec","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-26pul","doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-pnmv"]},{"anchor":"Reading-what-was-tracked","title":"Reading what was tracked","identifiers":["doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"withRecordingTracker","type":"codeVoice"},{"type":"text","text":" makes a tracker, binds it to the current task with "},{"code":"withTracker","type":"codeVoice"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"length of its body, then finishes it and returns a "},{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording","type":"reference","isActive":true},{"type":"text","text":" of every event tracked"},{"type":"text","text":" "},{"type":"text","text":"through it. Each call makes its own tracker, so tests that run at once never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. Events tracked after the body returns, by work it started but didn’t wait for, are dropped."}]},{"type":"paragraph","inlineContent":[{"text":"There are four spellings. The body can be synchronous or asynchronous, and it can take the tracker","type":"text"},{"text":" ","type":"text"},{"text":"as a parameter, for code that is handed its tracker (a SwiftUI view given it with ","type":"text"},{"type":"codeVoice","code":"tracker(_:)"},{"text":", a","type":"text"},{"text":" ","type":"text"},{"text":"UIKit view controller given it as a trait) rather than reading ","type":"text"},{"type":"codeVoice","code":"Tracker.current"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A recording holds what the body returned, every record with its timestamp, source location and"},{"type":"text","text":" "},{"type":"text","text":"context, each event’s name, and the events of one type through "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/TrackerRecording\/events(of:)","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to test targets only. To check a tracking plan from a test, use"},{"type":"text","text":" "},{"type":"codeVoice","code":"TrackingPlanTesting"},{"type":"text","text":"."}]},{"syntax":"swift","code":["import Testing","import TrackerTesting","","@Test func checkingOutTracksTheCartSize() async {","    let tracked = await withRecordingTracker { tracker in","        tracker.track(CheckoutStarted(cartSize: 3))","        return \"done\"","    }","    #expect(tracked.value == \"done\")","    #expect(tracked.names == [\"CheckoutStarted\"])","    #expect(tracked.events(of: CheckoutStarted.self).map(\\.cartSize) == [3])","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/testingwhatyoutrack","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"covers views, view controllers and asynchronous code.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackertesting"]}],"references":{"doc://TrackerTesting/documentation/TrackerTesting/withRecordingTracker(_:)-mlec":{"url":"\/documentation\/trackertesting\/withrecordingtracker(_:)-mlec","abstract":[{"type":"text","text":"Runs "},{"code":"body","type":"codeVoice"},{"type":"text","text":" with a tracker of its own bound to the current task, then returns every event"},{"type":"text","text":" "},{"type":"text","text":"tracked through it, in the order tracked."}],"type":"topic","kind":"symbol","title":"withRecordingTracker(_:)","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting\/withRecordingTracker(_:)-mlec","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withRecordingTracker"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"kind":"keyword","text":"nonisolated(nonsending)"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"TrackerRecording","preciseIdentifier":"s:14TrackerTesting0A9RecordingV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">"}],"role":"symbol"},"doc://TrackerTesting/documentation/TrackerTesting/withRecordingTracker(_:)-26pul":{"kind":"symbol","identif