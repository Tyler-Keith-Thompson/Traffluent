cords"},{"type":"text","text":" "},{"type":"text","text":"already there."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","role":"symbol","type":"topic"},"doc://Persistence/documentation/Persistence/SegmentStore/takeRecoveredRecords()":{"type":"topic","abstract":[{"type":"text","text":"The records of the segments earlier runs left, oldest first, with "},{"code":"isRedelivered","type":"codeVoice"},{"type":"text","text":" set on"},{"type":"text","text":" "},{"type":"text","text":"each one a delivery had started on; later calls return none."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"takeRecoveredRecords"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]"}],"title":"takeRecoveredRecords()","kind":"symbol","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/takerecoveredrecords()","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"},"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"abstract":[{"type":"text","text":"How many records the log keeps that are not yet delivered."}],"kind":"symbol","title":"pendingRecordCount","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"pendingRecordCount"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount","url":"\/documentation\/persistence\/segmentstore\/pendingrecordcount"},"doc://Persistence/documentation/Persistence/SegmentStore/defaultDirectory":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},