ount:)","role":"symbol"},"doc://Persistence/documentation/Persistence/DropReport/writeFailed(recordCount:timestamps:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"writeFailed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"timestamps","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClosedRange","preciseIdentifier":"s:SN","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"url":"\/documentation\/persistence\/dropreport\/writefailed(recordcount:timestamps:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","type":"topic","abstract":[{"type":"text","text":"Writing "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" records, tracked within "},{"type":"codeVoice","code":"timestamps"},{"type":"text","text":", to disk failed (the disk is"},{"type":"text","text":" "},{"type":"text","text":"full, say, or segments that couldn’t be deleted fill the bound), so they are kept in memory"},{"type":"text","text":" "},{"type":"text","text":"only: delivered in this run if it lasts long"},{"type":"text","text":" "},{"type":"text","text":"enough, lost if it ends first."}],"title":"DropReport.writeFailed(recordCount:timestamps:)"},"doc://Persistence/documentation/Persistence/SegmentStore/append(_:)":{"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","abstract":[{"type":"text","text":"Writes "},{"type":"codeVoice","code":"record"},{"type":"text","text":" to the log before returning, when its event type is one of "},{"type":"codeVoice","code":"events"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"it fits the bound."}],"role":"symbol","title":"append(_:)","url":"\/documentation\/persistence\/segmentstore\/append(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"append","kind":"identifier"},{"text":"(","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"}],"kind":"symbol"}}}