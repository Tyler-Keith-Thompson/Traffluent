stract":[{"type":"text","text":"The records of the segments earlier runs left, oldest first, with "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set on"},{"type":"text","text":" "},{"type":"text","text":"each one a delivery had started on; later calls return none."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"},"doc://Persistence/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Persistence\/s8SendableP","title":"Swift.Sendable"},"doc://Persistence/documentation/Persistence/SegmentStore/dropReports":{"url":"\/documentation\/persistence\/segmentstore\/dropreports","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DropReport","preciseIdentifier":"s:11Persistence10DropReportO"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"text":"A report of each drop, in the order they happen, from recovery onwards.","type":"text"}],"title":"dropReports","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","role":"symbol","kind":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/init(directory:byteBound:segmentByteCount:)":{"role":"symbol","title":"init(directory:byteBound:segmentByteCount:)","url":"\/documentation\/persistence\/segmentstore\/init(directory:bytebound:segmentbytecount:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"directory","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"FilePath","kind":"typeIdentifier","preciseIdentifier":"s:13SystemPackage8FilePathV"},{"text":", ","kind":"text"},{"text":"byteBound","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"tex