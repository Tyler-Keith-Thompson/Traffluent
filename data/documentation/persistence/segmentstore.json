,"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistence\/segmentstore"]}],"references":{"doc://Persistence/documentation/Persistence/SegmentStore/init(events:directory:byteBound:segmentByteCount:)":{"kind":"symbol","type":"topic","abstract":[{"text":"A store keeping events of the types ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"directory"},{"text":"; it recovers the records","type":"text"},{"text":" ","type":"text"},{"text":"already there.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","url":"\/documentation\/persistence\/segmentstore\/init(events:directory:bytebound:segmentbytecount:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"events","kind":"externalParam"},{"text":": [any (","kind":"text"},{"text":"Event","kind":"typeIdentifier","preciseIdentifier":"s:6Events5EventP"},{"text":" & ","kind":"text"},{"text":"BinaryCodable","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence13BinaryCodableP"},{"text":").Type], ","kind":"text"},{"text":"directory","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"FilePath","kind":"typeIdentifier","preciseIdentifier":"s:13SystemPackage8FilePathV"},{"text":", ","kind":"text"},{"text":"byteBound","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"segmentByteCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Errno","kind":"typeIdentifier","preciseIdentifier":"s:13SystemPackage5ErrnoV"},{"text":")","kind":"text"}],"title":"init(events:directory:byteBound:segmentByteCount:)"},"doc://Persi