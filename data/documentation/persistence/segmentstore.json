se"},{"kind":"text","text":" "},{"kind":"identifier","text":"undecodable"},{"kind":"text","text":"("},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":")"}],"title":"DropReport.undecodable(recordCount:)","role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"type":"topic","kind":"symbol","role":"symbol","title":"pendingRecordCount","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pendingRecordCount","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"abstract":[{"text":"How many records the log keeps that are not yet delivered.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount","url":"\/documentation\/persistence\/segmentstore\/pendingrecordcount"},"doc://Persistence/documentation/Persistence/DropReport/writeFailed(recordCount:timestamps:)":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","kind":"symbol","url":"\/documentation\/persistence\/dropreport\/writefailed(recordcount:timestamps:)","abstract":[{"text":"Writing ","type":"text"},{"type":"codeVoice","code":"recordCount"},{"text":" records, tracked within ","type":"text"},{"type":"codeVoice","code":"timestamps"},{"text":", to disk failed (the disk is","type":"text"},{"text":" ","type":"text"},{"text":"full, say, or segments that couldn’t be deleted fill the bound), so they are kept in memory","type":"text"},{"text":" ","type":"text"},{"text":"only: delivered in this run if it lasts long","type":"text"},{"text":" ","type":"text"},{"text":"enough, lost if it ends first.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"writeFailed"},{"kind":"text","text":"("}