{"kind":"symbol","identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"seeAlsoSections":[{"generated":true,"title":"Stores","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"],"anchor":"Stores"}],"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"],"anchor":"Instance-Methods"},{"generated":true,"title":"Type Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"],"anchor":"Type-Properties"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"code":["let store = try SegmentStore(events: [SignedUp.self, CheckedOut.self])","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Write-through.","type":"text"}],"type":"strong"},{"type":"text","text":" A tracker’s worker writes each record as it reaches it, before publishing"},{"type":"text","text":" "},{"type":"text","text":"it, with one "},{"type":"codeVoice","code":"write()"},{"type":"text","text":", off the tracking caller’s thread, so the record survives the app"},{"type":"text","text":" "},{"type":"text","text":"crashing or being killed from then on. The store makes the log durable against"},{"type":"text","text":" "},{"type":"text","text":"power loss too ("},{"type":"codeVoice","code":"fsync"},{"type":"text","text":") once per batch, before the batch is delivered, and whenever"},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","isActive":true,"type":"reference"},{"type":"text","text":" is called: call it, after the tracker’s "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":", as the app moves to the"},{"type":"text","text":" "},{"type":"text","text":"background or terminates."},{"type":"text","text":" "},{"type":"text","text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as"},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","isActive":true,"type":"reference"},{"type":"text","text":", and so is one whose event’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" throws."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"What is kept."}],"type":"strong"},{"text":" Only events of the types in ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", which conform to ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Events of any other type are kept in memory only: they are delivered in this run like any","type":"text"},{"text":" ","type":"text"},{"text":"other, are never written, and are lost if the app ends first. The first record of each such","type":"text"},{"text":" ","type":"text"},{"text":"type is reported as ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","isActive":true,"type":"reference"},{"text":", so a type left out of ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"mistake shows up.","type":"text"},{"text":" ","type":"text"},{"text":"A record’s context is not kept: a recovered record is in the top-level ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"as its span ended with the earlier run.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Deleting.","type":"text"}],"type":"strong"},{"type":"text","text":" A segment is deleted as a whole once every record in it is delivered, so a"},{"type":"text","text":" "},{"type":"text","text":"log whose records are all delivered holds no files. A segment kept for one undelivered"},{"type":"text","text":" "},{"type":"text","text":"record keeps its delivered ones too. Only recovery rewrites a segment: one still holding"},{"type":"text","text":" "},{"type":"text","text":"records after it drops some ("},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","isActive":true,"type":"reference"},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"rewritten without them, so each drop is reported once. Should the rewrite fail, the"},{"type":"text","text":" "},{"type":"text","text":"segment is kept as it was and the next launch reports those drops again."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Reading back."}],"type":"strong"},{"text":" When a destination’s full buffer drops a batch on its way through a","type":"text"},{"text":" ","type":"text"},{"text":"delivery, the delivery reads that batch’s records back from the log once the destination","type":"text"},{"text":" ","type":"text"},{"text":"has caught up, reading each segment they are in once, and hands them to it in this run,","type":"text"},{"text":" ","type":"text"},{"text":"each in the context it was tracked in, which the delivery keeps. A record the bound dropped","type":"text"},{"text":" ","type":"text"},{"text":"before the read finished isn’t read back, and one that can’t be read or decoded is logged","type":"text"},{"text":" ","type":"text"},{"text":"and waits for a later launch.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Bound."}]},{"type":"text","text":" The log never holds more than "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":" bytes. When a record wouldn’t fit, the"},{"type":"text","text":" "},{"type":"text","text":"oldest segments are deleted until it does, and each one deleted with records not yet"},{"type":"text","text":" "},{"type":"text","text":"delivered yields a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport"},{"type":"text","text":" on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports"},{"type":"text","text":". A record too large for an empty log"},{"type":"text","text":" "},{"type":"text","text":"is kept in memory only."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Recovery."}],"type":"strong"},{"text":" A store opened on a directory recovers the records earlier runs left there","type":"text"},{"text":" ","type":"text"},{"text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or","type":"text"},{"text":" ","type":"text"},{"text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported.","type":"text"},{"text":" ","type":"text"},{"text":"A segment comes back whole, delivered records and all. Each record a delivery had started on","type":"text"},{"text":" ","type":"text"},{"text":"comes back with ","type":"text"},{"code":"isRedelivered","type":"codeVoice"},{"text":" set, as it may have reached a destination already: one","type":"text"},{"text":" ","type":"text"},{"text":"delivered before the app ended, or one delivered just as it ended, before the store could","type":"text"},{"text":" ","type":"text"},{"text":"delete its segment. A record whose delivery mark can’t be written is held back from that","type":"text"},{"text":" ","type":"text"},{"text":"delivery, so it is never sent twice unannounced, and delivered on a later launch.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Other versions."}],"type":"strong"},{"type":"text","text":" A segment a newer release of the app wrote, in a later version of the"},{"type":"text","text":" "},{"type":"text","text":"format, is left on disk untouched after a rollback, for that release to deliver: this one"},{"type":"text","text":" "},{"type":"text","text":"neither reads it nor counts it toward the bound. A segment in an earlier version, which this"},{"type":"text","text":" "},{"type":"text","text":"one can’t read, is deleted and reported as a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Changed event types."}]},{"text":" Each record’s event is a map of its properties by name, so a record","type":"text"},{"text":" ","type":"text"},{"text":"written before its type changed still reads: a property removed since is skipped, an","type":"text"},{"text":" ","type":"text"},{"text":"optional one added since is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and one with a default value added since has it. A record","type":"text"},{"text":" ","type":"text"},{"text":"stored at another ","type":"text"},{"type":"codeVoice","code":"Event.schemaVersion"},{"text":" than its type’s now is dropped without being read and","type":"text"},{"text":" ","type":"text"},{"text":"reported as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"One at the same version that can’t be read all the same, after a required property was added","type":"text"},{"text":" ","type":"text"},{"text":"or a property’s type changed without raising the version, is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a","type":"text"},{"text":" ","type":"text"},{"text":"store share its log.","type":"text"}],"type":"paragraph"}]}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"]}],"variants":[{"paths":["\/documentation\/persistence\/segmentstore"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"title":"SegmentStore","remoteSource":{"fileName":"SegmentStore.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L70"},"roleHeading":"Structure","modules":[{"name":"Persistence"}],"externalID":"s:11Persistence12SegmentStoreV","navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"symbolKind":"struct","role":"symbol"},"abstract":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"references":{"doc://Persistence/documentation/Persistence":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/persistence","title":"Persistence"},"doc://Persistence/documentation/Persistence/DropReport/writeFailed(recordCount:timestamps:)":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"writeFailed"},{"kind":"text","text":"("},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"timestamps"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SN","kind":"typeIdentifier","text":"ClosedRange"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":">)"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","role":"symbol","kind":"symbol","title":"DropReport.writeFailed(recordCount:timestamps:)","type":"topic","url":"\/documentation\/persistence\/dropreport\/writefailed(recordcount:timestamps:)","abstract":[{"text":"Writing ","type":"text"},{"code":"recordCount","type":"codeVoice"},{"text":" records, tracked within ","type":"text"},{"code":"timestamps","type":"codeVoice"},{"text":", to disk failed (the disk is","type":"text"},{"text":" ","type":"text"},{"text":"full, say, or segments that couldn’t be deleted fill the bound), so they are kept in memory","type":"text"},{"text":" ","type":"text"},{"text":"only: delivered in this run if it lasts long","type":"text"},{"text":" ","type":"text"},{"text":"enough, lost if it ends first.","type":"text"}]},"doc://Persistence/documentation/Persistence/DropReport/corruption(byteCount:)":{"title":"DropReport.corruption(byteCount:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"corruption","kind":"identifier"},{"text":"(","kind":"text"},{"text":"byteCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Recovery found a torn or corrupt record, or a segment header it couldn’t read, and"},{"type":"text","text":" "},{"type":"text","text":"discarded the "},{"type":"codeVoice","code":"byteCount"},{"type":"text","text":" bytes from there to the end of the segment."}],"url":"\/documentation\/persistence\/dropreport\/corruption(bytecount:)","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)"},"doc://Persistence/documentation/Persistence/DropReport/undecodable(recordCount:)":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","abstract":[{"text":"Recovery read ","type":"text"},{"code":"recordCount","type":"codeVoice"},{"text":" intact records it couldn’t decode: their event type isn’t in","type":"text"},{"text":" ","type":"text"},{"text":"the store’s ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", or its ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" threw, as it does for a record","type":"text"},{"text":" ","type":"text"},{"text":"written before a required property was added or a property’s type changed while the","type":"text"},{"text":" ","type":"text"},{"text":"event’s ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":" stayed the same.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/persistence\/dropreport\/undecodable(recordcount:)","title":"DropReport.undecodable(recordCount:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"undecodable","kind":"identifier"},{"text":"(","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://Persistence/documentation/Persistence/SegmentStore/byteCount":{"url":"\/documentation\/persistence\/segmentstore\/bytecount","kind":"symbol","abstract":[{"type":"text","text":"The bytes the log holds on disk: every segment’s header, records and delivery marks."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byteCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"title":"byteCount","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","type":"topic"},"doc://Persistence/s8SendableP":{"identifier":"doc:\/\/Persistence\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Persistence/documentation/Persistence/DropReport/versionMismatch(event:storedVersion:currentVersion:recordCount:)":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","role":"symbol","kind":"symbol","type":"topic","title":"DropReport.versionMismatch(event:storedVersion:currentVersion:recordCount:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"versionMismatch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"event"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"storedVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"currentVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Recovery read "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" intact records of the event named "},{"type":"codeVoice","code":"event"},{"type":"text","text":" stored at"},{"type":"text","text":" "},{"type":"codeVoice","code":"storedVersion"},{"type":"text","text":", while the store’s type of that name is at "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":"), and dropped them without decoding them: the version changed for a"},{"type":"text","text":" "},{"type":"text","text":"change their bytes can’t be read through. Reported once per segment, or per database, for"},{"type":"text","text":" "},{"type":"text","text":"each event and stored version, by the event’s name and then the stored version."}],"url":"\/documentation\/persistence\/dropreport\/versionmismatch(event:storedversion:currentversion:recordcount:)"},"doc://Persistence/documentation/Persistence/SegmentStore/takeRecoveredRecords()":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()","abstract":[{"text":"The records of the segments earlier runs left, oldest first, with ","type":"text"},{"type":"codeVoice","code":"isRedelivered"},{"text":" set on","type":"text"},{"text":" ","type":"text"},{"text":"each one a delivery had started on; later calls return none.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/persistence\/segmentstore\/takerecoveredrecords()","title":"takeRecoveredRecords()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"takeRecoveredRecords","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]","kind":"text"}]},"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount","role":"symbol","kind":"symbol","type":"topic","title":"pendingRecordCount","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pendingRecordCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/persistence\/segmentstore\/pend