"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}],"title":"SegmentStore","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"role":"symbol","url":"\/documentation\/persistence\/segmentstore"},"doc://Persistence/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/Persistence\/s16SendableMetatypeP","title":"Swift.SendableMetatype"}}}