"},{"kind":"text","text":")"}],"abstract":[{"text":"Recovery read ","type":"text"},{"code":"recordCount","type":"codeVoice"},{"text":" intact records it couldn’t decode: their event type isn’t in","type":"text"},{"text":" ","type":"text"},{"text":"the store’s ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", or its ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)"},{"text":" threw, as it does for a record","type":"text"},{"text":" ","type":"text"},{"text":"written before a required property was added or a property’s type changed while the","type":"text"},{"text":" ","type":"text"},{"text":"event’s ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":" stayed the same.","type":"text"}],"kind":"symbol"},"doc://Persistence/documentation/Persistence/DropReport":{"title":"DropReport","role":"symbol","kind":"symbol","abstract":[{"text":"Records a store dropped before they were delivered, and why.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"DropReport"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","type":"topic","url":"\/documentation\/persistence\/dropreport","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DropReport"}]},"doc://Persistence/documentation/Persistence/DropReport/writeFailed(recordCount:timestamps:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"writeFailed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"timestamps","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClosedRange","kind":"typeIdentifier","preciseIdentifier":"s:SN"},{"text":"<","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIden