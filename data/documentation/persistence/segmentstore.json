,"code":"fsync"},{"text":"), so it survives","type":"text"},{"text":" ","type":"text"},{"text":"power loss.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"synchronize"},{"kind":"text","text":"()"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","title":"synchronize()","url":"\/documentation\/persistence\/segmentstore\/synchronize()","role":"symbol","kind":"symbol"},"doc://Persistence/documentation/Persistence/DropReport/corruption(byteCount:)":{"abstract":[{"type":"text","text":"Recovery found a torn or corrupt record, or a segment header it couldn’t read, and"},{"type":"text","text":" "},{"type":"text","text":"discarded the "},{"type":"codeVoice","code":"byteCount"},{"type":"text","text":" bytes from there to the end of the segment."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"corruption"},{"kind":"text","text":"("},{"kind":"externalParam","text":"byteCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","title":"DropReport.corruption(byteCount:)","kind":"symbol","role":"symbol","url":"\/documentation\/persistence\/dropreport\/corruption(bytecount:)"},"doc://Persistence/documentation/Persistence/SegmentStore/takeRecoveredRecords()":{"role":"symbol","abstract":[{"type":"text","text":"The records of the segments earlier runs left, oldest first, with "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set on"},{"type":"text","text":" "},{"type":"text","text":"each one a delivery had started on; later calls return none."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"takeRecoveredRecords","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]","kind":"text"}],"url":"\/documentation\/persistence\/segmentstore\/takerecoveredrecords()","kind":"symbol","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()","title":"takeRecoveredRecords()"},"doc://Persistence/documentation/Persistence/SegmentStore":{"url":"\/documentation\/persistence\/segmentstore","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"abstract":[{"type":"text","text":"A "},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"reference"},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"type":"topic","title":"SegmentStore"},"doc://Persistence/documentation/Persistence/DropReport/undecodable(recordCount:)":{"role":"symbol","abstract":[{"type":"text","text":"Recovery read "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" intact records it couldn’t decode: their event type isn’t in"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"events"},{"type":"text","text":", or its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)"},{"type":"text","text":" threw, as it does for a record"},{"type":"text","text":" "},{"type":"text","text":"written before a required property was added or a property’s type changed while the"},{"type":"text","text":" "},{"type":"text","text":"event’s "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":" stayed the same."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"undecodable","kind":"identifier"},{"text":"(","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"url":"\/documentation\/persistence\/dropreport\/undecodable(recordcount:)","kind":"symbol","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","title":"DropReport.undecodable(recordCount:)"},"doc://Persistence/documentation/Persistence/SegmentStore/defaultByteBound":{"abstract":[{"text":"The bound a store has unless it is given another: 5 MiB (5,242,880 bytes).","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultByteBound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","title":"defaultByteBound","kind":"symbol","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/defaultbytebound"},"doc://Persistence/s8SendableP":{"identifier":"doc:\/\/Persistence\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Persistence/s16SendableMetatypeP":{"identifier":"doc:\/\/Persistence\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://Persistence/documentation/Persistence/DropReport":{"kind":"symbol","abstract":[{"type":"text","text":"Records a store dropped before they were delivered, and why."}],"title":"DropReport","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DropReport","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","role":"symbol","url":"\/documentation\/persistence\/dropreport","navigatorTitle":[{"text":"DropReport","kind":"identifier"}]},"doc://Persistence/documentation/Persistence/DropReport/writeFailed(recordCount:timestamps:)":{"role":"symbol","type":"topic","url":"\/documentation\/persistence\/dropreport\/writefailed(recordcount:timestamps:)","abstract":[{"type":"text","text":"Writing "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" records, tracked within "},{"type":"codeVoice","code":"timestamps"},{"type":"text","text":", to disk failed (the disk is"},{"type":"text","text":" "},{"type":"text","text":"full, say, or segments that couldn’t be deleted fill the bound), so they are kept in memory"},{"type":"text","text":" "},{"type":"text","text":"only: delivered in this run if it lasts long"},{"type":"text","text":" "},{"type":"text","text":"enough, lost if it ends first."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"writeFailed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"timestamps","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClosedRange","kind":"typeIdentifier","preciseIdentifier":"s:SN"},{"text":"<","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":">)","kind":"text"}],"title":"DropReport.writeFailed(recordCount:timestamps:)","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)"},"doc://Persistence/documentation/Persistence/DropReport/notPersisted(event:)":{"type":"topic","role":"symbol","title":"DropReport.notPersisted(event:)","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","kind":"symbol","abstract":[{"text":"A record of the event