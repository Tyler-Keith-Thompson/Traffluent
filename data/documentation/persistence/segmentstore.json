:"text","text":", "},{"kind":"externalParam","text":"byteBound"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"segmentByteCount"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11Persistence17SegmentStoreErrorO","kind":"typeIdentifier","text":"SegmentStoreError"},{"kind":"text","text":")"}],"kind":"symbol","abstract":[{"type":"text","text":"A store keeping events of every type the program declares with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"library’s own, in "},{"type":"codeVoice","code":"directory"},{"type":"text","text":"; it recovers the records already there."}],"title":"init(directory:byteBound:segmentByteCount:)","url":"\/documentation\/persistence\/segmentstore\/init(directory:bytebound:segmentbytecount:)","type":"topic","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(directory:byteBound:segmentByteCount:)"},"doc://Persistence/s16SendableMetatypeP":{"identifier":"doc:\/\/Persistence\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://Persistence/documentation/Persistence/DropReport/versionMismatch(event:storedVersion:currentVersion:recordCount:)":{"title":"DropReport.versionMismatch(event:storedVersion:currentVersion:recordCount:)","url":"\/documentation\/persistence\/dropreport\/versionmismatch(event:storedversion:currentversion:recordcount:)","kind":"symbol","abstract":[{"type":"text","text":"Recovery read "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" intact records of the event named "},{"type":"codeVoice","code":"event"},{"type":"text","text":" stored at"},{"type":"text","text":" "},{"type":"codeVoice","code":"storedVersion"},{"type":"text","text":", while the store’s type of that name is at "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":"), and dropped them without decoding them: the version changed for a"},{"type":"text","text":" "},{"type":"text","text":"change their bytes can’t be read through. Reported once per segment, or per database, for"},{"type":"text","text":" "},{"type":"text","text":"each event and stored version, by the event’s name and then the stored version."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"versionMismatch","kind":"identifier"},{"text":"(","kind":"text"},{"text":"event","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"storedVersion","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"currentVersion","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol"},"doc://Persistence/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/Persistence\/s8SendableP","type":"unresolvable"},"doc://Persistence/documentation/Persistence/DropReport/notPersisted(event:)":{"role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","type":"topic","url":"\/documentation\/persistence\/dropreport\/notpersisted(event:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notPersisted"},{"kind":"text","text":"("},{"kind":"externalParam","text":"event"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":")"}],"kind":"symbol","abstract":[{"type":"text","text":"A record of the event named "},{"type":"codeVoice","code":"event"},{"type":"text","text":" was kept in memory only because its type isn’t one of"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"events"},{"type":"text","text":": its records are delivered in this run, but never written, so they are"},{"type":"text","text":" "},{"type":"text","text":"lost if the app ends first. Reported once per type, on its first record, for as long as the"},{"type":"text","text":" "},{"type":"text","text":"store lives; a type left out by mistake is added to "},{"type":"codeVoice","code":"events"},{"type":"text","text":"."}],"title":"DropReport.notPersisted(event:)"},"doc://Persistence/documentation/Persistence/RecordStore":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"Where a tracker keeps each record until it is delivered, so records survive the app ending.","type":"text"}],"url":"\/documentation\/persistence\/recordstore","title":"RecordStore","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","navigatorTitle":[{"text":"RecordStore","kind":"identifier"}]},"doc://Persistence/documentation/Persistence/DropReport/undecodable(recordCount:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"undecodable","kind":"identifier"},{"text":"(","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentif