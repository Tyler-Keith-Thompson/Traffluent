{"abstract":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore"},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"metadata":{"externalID":"s:11Persistence12SegmentStoreV","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}],"roleHeading":"Structure","role":"symbol","modules":[{"name":"Persistence"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"remoteSource":{"fileName":"SegmentStore.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L47"},"title":"SegmentStore"},"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"]}],"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"],"anchor":"Instance-Methods"},{"title":"Type Properties","generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"],"anchor":"Type-Properties"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"syntax":"swift","code":["let store = try SegmentStore(events: [SignedUp.self, CheckedOut.self])","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Write-through."}],"type":"strong"},{"text":" A tracker’s worker writes each record as it reaches it, before publishing","type":"text"},{"text":" ","type":"text"},{"text":"it, with one ","type":"text"},{"code":"write()","type":"codeVoice"},{"text":", off the tracking caller’s thread, so the record survives the app","type":"text"},{"text":" ","type":"text"},{"text":"crashing or being killed from then on. The store makes the log durable against","type":"text"},{"text":" ","type":"text"},{"text":"power loss too (","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":") once per batch, before the batch is delivered, and whenever","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","isActive":true,"type":"reference"},{"text":" is called: call it, after the tracker’s ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":", as the app moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background or terminates.","type":"text"},{"text":" ","type":"text"},{"text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"What is kept.","type":"text"}]},{"text":" Only events of the types in ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", which conform to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Events of any other type are kept in memory only: they are delivered in this run like any","type":"text"},{"text":" ","type":"text"},{"text":"other, are never written, and produce no drop report, but are lost if the app ends first.","type":"text"},{"text":" ","type":"text"},{"text":"A record’s context is not kept: a recovered record is in the top-level ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"as its span ended with the earlier run.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Deleting.","type":"text"}]},{"type":"text","text":" A segment is deleted as a whole once every record in it is delivered, so a"},{"type":"text","text":" "},{"type":"text","text":"log whose records are all delivered holds no files. There is no compaction: a segment kept"},{"type":"text","text":" "},{"type":"text","text":"for one undelivered record keeps its delivered ones too."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Bound."}]},{"type":"text","text":" The log never holds more than "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":" bytes. When a record wouldn’t fit, the"},{"type":"text","text":" "},{"type":"text","text":"oldest segments are deleted until it does, and each one deleted with records not yet"},{"type":"text","text":" "},{"type":"text","text":"delivered yields a "},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","type":"reference"},{"type":"text","text":" on "},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","type":"reference"},{"type":"text","text":". A record too large for an empty log"},{"type":"text","text":" "},{"type":"text","text":"is kept in memory only."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Recovery.","type":"text"}],"type":"strong"},{"text":" A store opened on a directory recovers the records earlier runs left there","type":"text"},{"text":" ","type":"text"},{"text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or","type":"text"},{"text":" ","type":"text"},{"text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported.","type":"text"},{"text":" ","type":"text"},{"text":"A segment comes back whole, delivered records and all. Each record a delivery had started on","type":"text"},{"text":" ","type":"text"},{"text":"comes back with ","type":"text"},{"type":"codeVoice","code":"isRedelivered"},{"text":" set, as it may have reached a destination already: one","type":"text"},{"text":" ","type":"text"},{"text":"delivered before the app ended, or one delivered just as it ended, before the store could","type":"text"},{"text":" ","type":"text"},{"text":"delete its segment. A record whose delivery mark can’t be written is held back from that","type":"text"},{"text":" ","type":"text"},{"text":"delivery, so it is never sent twice unannounced, and delivered on a later launch.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Newer versions."}]},{"type":"text","text":" A segment a newer release of the app wrote, in a later version of the"},{"type":"text","text":" "},{"type":"text","text":"format, is left on disk untouched after a rollback, for that release to deliver: this one"},{"type":"text","text":" "},{"type":"text","text":"neither reads it nor counts it toward the bound."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a"},{"type":"text","text":" "},{"type":"text","text":"store share its log."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistence\/segmentstore"]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"references":{"doc://Persistence/documentation/Persistence/SegmentStore/directory":{"role":"symbol","kind":"symbol","url":"\/documentation\/persistence\/segmentstore\/directory","title":"directory","abstract":[{"text":"Where the store keeps its segments.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"directory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SystemPackage8FilePathV","text":"FilePath"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory"},"doc://Persistence/documentation/Persistence/RecordStore":{"role":"symbol","kind":"symbol","url":"\/documentation\/persistence\/recordstore","title":"RecordStore","abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","navigatorTitle":[{"text":"RecordStore","kind":"identifier"}]},"doc://Persistence/documentation/Persistence/SegmentStore/defaultDirectory":{"abstract":[{"type":"text","text":"Where a store keeps its segments unless it is given a directory."}],"kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultDirectory","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13SystemPackage8FilePathV","text":"FilePath","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/defaultdirectory","title":"defaultDirectory"},"doc://Persistence/documentation/Persistence/SegmentStore/takeRecoveredRecords()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"takeRecoveredRecords","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The records of the segments earlier runs left, oldest first, with "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set on"},{"type":"text","text":" "},{"type":"text","text":"each one a delivery had started on; later calls return none."}],"title":"takeRecoveredRecords()","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/takerecoveredrecords()","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()","type":"topic","kind":"symbol"},"doc://Persistence/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\