{"kind":"symbol","variants":[{"paths":["\/documentation\/persistence\/segmentstore"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(directory:byteBound:segmentByteCount:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"],"title":"Type Properties","anchor":"Type-Properties","generated":true}],"relationshipsSections":[{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"metadata":{"symbolKind":"struct","navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"externalID":"s:11Persistence12SegmentStoreV","remoteSource":{"fileName":"SegmentStore.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L78"},"role":"symbol","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"modules":[{"name":"Persistence"}],"title":"SegmentStore"},"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"],"title":"Stores","anchor":"Stores","generated":true}],"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"languages":["swift"]}]},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"code":["let store = try SegmentStore()","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Write-through."}],"type":"strong"},{"text":" A tracker’s worker writes each record as it reaches it, before publishing","type":"text"},{"text":" ","type":"text"},{"text":"it, with one ","type":"text"},{"code":"write()","type":"codeVoice"},{"text":", off the tracking caller’s thread, so the record survives the app","type":"text"},{"text":" ","type":"text"},{"text":"crashing or being killed from then on. The store makes the log durable against","type":"text"},{"text":" ","type":"text"},{"text":"power loss too (","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":") once per batch, before the batch is delivered, and whenever","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","type":"reference"},{"text":" is called: call it, after the tracker’s ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":", as the app moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background or terminates.","type":"text"},{"text":" ","type":"text"},{"text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","type":"reference"},{"text":", and so is one whose event’s","type":"text"},{"text":" ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":" throws.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"What is kept.","type":"text"}]},{"type":"text","text":" Every event "},{"type":"codeVoice","code":"DiscoveredEvent.all"},{"type":"text","text":" lists, the "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" structs of every"},{"type":"text","text":" "},{"type":"text","text":"module the program links and the library’s own, or only the "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" types in "},{"type":"codeVoice","code":"events"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Events of any other type are kept in memory only: they are delivered in this run like any"},{"type":"text","text":" "},{"type":"text","text":"other, are never written, and are lost if the app ends first. The first record of each such"},{"type":"text","text":" "},{"type":"text","text":"type is reported as "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","type":"reference","isActive":true},{"type":"text","text":", so a type left out by mistake,"},{"type":"text","text":" "},{"type":"text","text":"such as one that conforms to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" by hand, shows up."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"A recovered record’s session.","type":"text"}],"type":"strong"},{"text":" A record keeps the ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":" of its context, written in","type":"text"},{"text":" ","type":"text"},{"text":"the record’s own bytes, so a record recovered after a relaunch carries the session it was","type":"text"},{"text":" ","type":"text"},{"text":"tracked in, and a vendor destination sends it under the same identity as the first time. A","type":"text"},{"text":" ","type":"text"},{"text":"record written without a session comes back with none. The rest of its context is not kept:","type":"text"},{"text":" ","type":"text"},{"text":"a recovered record is otherwise in the top-level ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":", as its span ended with","type":"text"},{"text":" ","type":"text"},{"text":"the earlier run.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deleting."}]},{"type":"text","text":" A segment is deleted as a whole once every record in it is delivered, so a"},{"type":"text","text":" "},{"type":"text","text":"log whose records are all delivered holds no files. A record’s session goes with its"},{"type":"text","text":" "},{"type":"text","text":"segment: the store keeps no session apart from the records tracked in it. A segment kept"},{"type":"text","text":" "},{"type":"text","text":"for one undelivered record keeps its delivered ones too, sessions and all. Only recovery"},{"type":"text","text":" "},{"type":"text","text":"rewrites a segment: one still holding"},{"type":"text","text":" "},{"type":"text","text":"records after it drops some ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)"},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"rewritten without them, so each drop is reported once. Should the rewrite fail, the"},{"type":"text","text":" "},{"type":"text","text":"segment is kept as it was and the next launch reports those drops again."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reading back."}]},{"type":"text","text":" When a destination’s full buffer drops a batch on its way through a"},{"type":"text","text":" "},{"type":"text","text":"delivery, the delivery reads that batch’s records back from the log once the destination"},{"type":"text","text":" "},{"type":"text","text":"has caught up, reading each segment they are in once, and hands them to it in this run,"},{"type":"text","text":" "},{"type":"text","text":"each in the context it was tracked in, which the delivery keeps. A record the bound dropped"},{"type":"text","text":" "},{"type":"text","text":"before the read finished isn’t read back, and one that can’t be read or decoded is logged"},{"type":"text","text":" "},{"type":"text","text":"and waits for a later launch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Bound."}]},{"type":"text","text":" The log never holds more than "},{"code":"byteBound","type":"codeVoice"},{"type":"text","text":" bytes. When a record wouldn’t fit, the"},{"type":"text","text":" "},{"type":"text","text":"oldest segments are deleted until it does, and each one deleted with records not yet"},{"type":"text","text":" "},{"type":"text","text":"delivered yields a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport"},{"type":"text","text":" on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports"},{"type":"text","text":". A record too large for an empty log"},{"type":"text","text":" "},{"type":"text","text":"is kept in memory only."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Recovery."}]},{"type":"text","text":" A store opened on a directory recovers the records earlier runs left there"},{"type":"text","text":" "},{"type":"text","text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or"},{"type":"text","text":" "},{"type":"text","text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported."},{"type":"text","text":" "},{"type":"text","text":"A segment comes back whole, delivered records and all. Each record a delivery had started on"},{"type":"text","text":" "},{"type":"text","text":"comes back with "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set, as it may have reached a destination already: one"},{"type":"text","text":" "},{"type":"text","text":"delivered before the app ended, or one delivered just as it ended, before the store could"},{"type":"text","text":" "},{"type":"text","text":"delete its segment. A record whose delivery mark can’t be written is held back from that"},{"type":"text","text":" "},{"type":"text","text":"delivery, so it is never sent twice unannounced, and delivered on a later launch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Other versions.","type":"text"}],"type":"strong"},{"type":"text","text":" A segment a newer release of the app wrote, in a later version of the"},{"type":"text","text":" "},{"type":"text","text":"format, is left on disk untouched after a rollback, for that release to deliver: this one"},{"type":"text","text":" "},{"type":"text","text":"neither reads it nor counts it toward the bound. A segment in an earlier version, which this"},{"type":"text","text":" "},{"type":"text","text":"one can’t read, is deleted and reported as a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Changed event types."}]},{"type":"text","text":" Each record’s event is a map of its properties by name, so a record"},{"type":"text","text":" "},{"type":"text","text":"written before its type changed still reads: a property removed since is skipped, an"},{"type":"text","text":" "},{"type":"text","text":"optional one added since is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and one with a default value added since has it. A record"},{"type":"text","text":" "},{"type":"text","text":"stored at another "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":" than its type’s now is dropped without being read and"},{"type":"text","text":" "},{"type":"text","text":"reported as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"One at the same version that can’t be read all the same, after a required property was added"},{"type":"text","text":" "},{"type":"text","text":"or a property’s type changed without raising the version, is dropped and reported as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a"},{"type":"text","text":" "},{"type":"text","text":"store share its log."}]}],"kind":"content"}],"abstract":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true,"type":"reference"},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"references":{"doc://Persistence/documentation/Persistence/SegmentStoreError":{"kind":"symbol","title":"SegmentStoreError","abstract":[{"type":"text","text":"The error "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","isActive":true},{"type":"text","text":" throws: an"},{"type":"text","text":" "},{"type":"text","text":"argument it can’t open a store with, or the file system’s failure."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStoreError"}],"navigatorTitle":[{"kind":"identifier","text":"SegmentStoreError"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","url":"\/documentation\/persistence\/segmentstoreerror","type":"topic"},"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"pendingRecordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"title":"pendingRecordCount","abstract":[{"type":"text","text":"How many records the log keeps that are not yet delivered."}],"url":"\/documentation\/persistence\/segmentstore\/pendingrecordcount","role":"symbol","kind":"symbol","type":"topic","ide