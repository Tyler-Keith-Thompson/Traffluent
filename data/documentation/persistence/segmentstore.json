":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"synchronize"},{"kind":"text","text":"()"}],"title":"synchronize()","kind":"symbol","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/synchronize()","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()"},"doc://Persistence/documentation/Persistence":{"abstract":[],"identifier":"doc:\/\/Persistence\/documentation\/Persistence","title":"Persistence","url":"\/documentation\/persistence","kind":"symbol","role":"collection","type":"topic"},"doc://Persistence/documentation/Persistence/BinaryCodable":{"title":"BinaryCodable","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","abstract":[{"type":"text","text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk."}],"kind":"symbol","type":"topic","url":"\/documentation\/persistence\/binarycodable","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryCodable","kind":"identifier"}],"navigatorTitle":[{"text":"BinaryCodable","kind":"identifier"}]},"doc://Persistence/documentation/Persistence/BinaryCodable/init(from:)":{"required":true,"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"BinaryDecoder","preciseIdentifier":"s:11Persistence13BinaryDecoderV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"BinaryDecodingError","preciseIdentifier":"s:11Persistence19BinaryDecodingErrorO"},{"kind":"text","text":")"}],"defaultImplementations":1,"kind":"symbol","url":"\/documentation\/persistence\/binarycodable\/init(from:)","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","abstract":[{"text":"Reads a value ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/encode(to:)","type":"reference","isActive":true},{"text":" wrote from ","type":"text"},{"code":"decoder","type":"codeVoice"},{"text":".","type":"text"}],"title":"init(from:)","type":"topic"},"doc://Persistence/documentation/Persistence/DropReport/undecodable(recordCount:)":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","abstract":[{"type":"text","text":"Recovery read "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" intact records it couldn’t decode: their event type isn’t in"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"events"},{"type":"text","text":", or its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)"},{"type":"text","text":" threw, as it does for a record"},{"type":"text","text":" "},{"type":"text","text":"written before a required property was added or a property’s type changed while the"},{"type":"text","text":" "},{"type":"text","text":"event’s "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":" stayed the same."}],"type":"topic","title":"DropReport.undecodable(recordCount:)","role":"symbol","kind":"symbol","url":"\/documentation\/persistence\/dropreport\/undecodable(recordcount:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"undecodable"},{"kind":"text","text":"("},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}]},"doc://Persistence/documentation/Persistence/SegmentStore/byteCount":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byteC