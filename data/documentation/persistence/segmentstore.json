d"},{"type":"text","text":" "},{"type":"text","text":"written before a required property was added or a property’s type changed while the"},{"type":"text","text":" "},{"type":"text","text":"event’s "},{"code":"Event.schemaVersion","type":"codeVoice"},{"type":"text","text":" stayed the same."}],"title":"DropReport.undecodable(recordCount:)","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"undecodable","kind":"identifier"},{"text":"(","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)"},"doc://Persistence/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/Persistence\/s8SendableP"},"doc://Persistence/documentation/Persistence/SegmentStore/synchronize()":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"synchronize","kind":"identifier"},{"text":"()","kind":"text"}],"kind":"symbol","role":"symbol","title":"synchronize()","url":"\/documentation\/persistence\/segmentstore\/synchronize()","abstract":[{"type":"text","text":"Flushes every segment written since the last flush to storage ("},{"type":"codeVoice","code":"fsync"},{"type":"text","text":"), so it survives"},{"type":"text","text":" "},{"type":"text","text":"power loss."}]},"doc://Persistence/documentation/Persistence/SegmentStore/defaultByteBound":{"kind":"symbol","type":"topic","url":"\/documentation\/persistence\/segmentstore\/defaultbytebound","abstract":[{"type":"text","text":"The bound a store has unless it is given another: 5 MiB (5,242,880 bytes)."}],"title":"defaultByteBound","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" 