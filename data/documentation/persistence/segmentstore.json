{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"kind":"symbol","relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"syntax":"swift","type":"codeListing","code":["let store = try SegmentStore(events: [SignedUp.self, CheckedOut.self])","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Write-through.","type":"text"}]},{"type":"text","text":" A tracker’s worker writes each record as it reaches it, before publishing"},{"type":"text","text":" "},{"type":"text","text":"it, with one "},{"type":"codeVoice","code":"write()"},{"type":"text","text":", off the tracking caller’s thread, so the record survives the app"},{"type":"text","text":" "},{"type":"text","text":"crashing or being killed from then on. The store makes the log durable against"},{"type":"text","text":" "},{"type":"text","text":"power loss too ("},{"type":"codeVoice","code":"fsync"},{"type":"text","text":") once per batch, before the batch is delivered, and whenever"},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","type":"reference","isActive":true},{"type":"text","text":" is called: call it, after the tracker’s "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":", as the app moves to the"},{"type":"text","text":" "},{"type":"text","text":"background or terminates."},{"type":"text","text":" "},{"type":"text","text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as"},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"What is kept.","type":"text"}],"type":"strong"},{"text":" Only events of the types in ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", which conform to ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Events of any other type are kept in memory only: they are delivered in this run like any","type":"text"},{"text":" ","type":"text"},{"text":"other, are never written, and produce no drop report, but are lost if the app ends first.","type":"text"},{"text":" ","type":"text"},{"text":"A record’s context is not kept: a recovered record is in the top-level ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"as its span ended with the earlier run.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Deleting.","type":"text"}]},{"type":"text","text":" A segment is deleted as a whole once every record in it is delivered, so a"},{"type":"text","text":" "},{"type":"text","text":"log whose records are all delivered holds no files. A segment kept for one undelivered"},{"type":"text","text":" "},{"type":"text","text":"record keeps its delivered ones too. Only recovery rewrites a segment: one still holding"},{"type":"text","text":" "},{"type":"text","text":"records after it drops some ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)"},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"rewritten without them, so each drop is reported once. Should the rewrite fail, the"},{"type":"text","text":" "},{"type":"text","text":"segment is kept as it was and the next launch reports those drops again."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Bound.","type":"text"}],"type":"strong"},{"type":"text","text":" The log never holds more than "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":" bytes. When a record wouldn’t fit, the"},{"type":"text","text":" "},{"type":"text","text":"oldest segments are deleted until it does, and each one deleted with records not yet"},{"type":"text","text":" "},{"type":"text","text":"delivered yields a "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","isActive":true},{"type":"text","text":" on "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","isActive":true},{"type":"text","text":". A record too large for an empty log"},{"type":"text","text":" "},{"type":"text","text":"is kept in memory only."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Recovery."}],"type":"strong"},{"text":" A store opened on a directory recovers the records earlier runs left there","type":"text"},{"text":" ","type":"text"},{"text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or","type":"text"},{"text":" ","type":"text"},{"text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported.","type":"text"},{"text":" ","type":"text"},{"text":"A segment comes back whole, delivered records and all. Each record a delivery had started on","type":"text"},{"text":" ","type":"text"},{"text":"comes back with ","type":"text"},{"code":"isRedelivered","type":"codeVoice"},{"text":" set, as it may have reached a destination already: one","type":"text"},{"text":" ","type":"text"},{"text":"delivered before the app ended, or one delivered just as it ended, before the store could","type":"text"},{"text":" ","type":"text"},{"text":"delete its segment. A record whose delivery mark can’t be written is held back from that","type":"text"},{"text":" ","type":"text"},{"text":"delivery, so it is never sent twice unannounced, and delivered on a later launch.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Other versions.","type":"text"}]},{"type":"text","text":" A segment a newer release of the app wrote, in a later version of the"},{"type":"text","text":" "},{"type":"text","text":"format, is left on disk untouched after a rollback, for that release to deliver: this one"},{"type":"text","text":" "},{"type":"text","text":"neither reads it nor counts it toward the bound. A segment in an earlier version, which this"},{"type":"text","text":" "},{"type":"text","text":"one can’t read, is deleted and reported as a"},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Changed event types."}]},{"text":" Each record’s event is a map of its properties by name, so a record","type":"text"},{"text":" ","type":"text"},{"text":"written before its type changed still reads: a property removed since is skipped, an","type":"text"},{"text":" ","type":"text"},{"text":"optional one added since is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and one with a default value added since has it. A record","type":"text"},{"text":" ","type":"text"},{"text":"stored at another ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":" than its type’s now is dropped without being read and","type":"text"},{"text":" ","type":"text"},{"text":"reported as ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"One at the same version that can’t be read all the same, after a required property was added","type":"text"},{"text":" ","type":"text"},{"text":"or a property’s type changed without raising the version, is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","type":"reference","isActive":true},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a","type":"text"},{"text":" ","type":"text"},{"text":"store share its log.","type":"text"}]}],"kind":"content"}],"metadata":{"symbolKind":"struct","title":"SegmentStore","navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L61","fileName":"SegmentStore.swift"},"externalID":"s:11Persistence12SegmentStoreV","role":"symbol","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"modules":[{"name":"Persistence"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"},"abstract":[{"tex