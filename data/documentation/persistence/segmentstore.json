:"symbol"},"doc://Persistence/documentation/Persistence/DropReport/notPersisted(event:)":{"title":"DropReport.notPersisted(event:)","abstract":[{"type":"text","text":"A record of the event named "},{"type":"codeVoice","code":"event"},{"type":"text","text":" was kept in memory only because its type isn’t one of"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"events"},{"type":"text","text":": its records are delivered in this run, but never written, so they are"},{"type":"text","text":" "},{"type":"text","text":"lost if the app ends first. Reported once per type, on its first record, for as long as the"},{"type":"text","text":" "},{"type":"text","text":"store lives; a type left out by mistake is added to "},{"type":"codeVoice","code":"events"},{"type":"text","text":"."}],"role":"symbol","url":"\/documentation\/persistence\/dropreport\/notpersisted(event:)","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notPersisted","kind":"identifier"},{"text":"(","kind":"text"},{"text":"event","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)"},"doc://Persistence/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Persistence\/s8SendableP","title":"Swift.Sendable"},"doc://Persistence/documentation/Persistence/SegmentStore/synchronize()":{"kind":"symbol","url":"\/documentation\/persistence\/segmentstore\/synchronize()","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"synchronize","kind":"identifier"},{"text":"()","kind":"text"}],"title":"synchronize()","abstract":[{"type":"text","text":"Flushes every segment written since the last flush to storage ("},{