{"sections":[],"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"],"kind":"relationships"}],"variants":[{"paths":["\/documentation\/persistence\/segmentstore"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"Persistence"}],"title":"SegmentStore","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L47","fileName":"SegmentStore.swift"},"roleHeading":"Structure","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"symbolKind":"struct","externalID":"s:11Persistence12SegmentStoreV","navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}]},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"],"generated":true}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["let store = try SegmentStore(events: [SignedUp.self, CheckedOut.self])","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Write-through.","type":"text"}]},{"text":" A tracker’s worker writes each record as it reaches it, before publishing","type":"text"},{"text":" ","type":"text"},{"text":"it, with one ","type":"text"},{"type":"codeVoice","code":"write()"},{"text":", off the tracking caller’s thread, so the record survives the app","type":"text"},{"text":" ","type":"text"},{"text":"crashing or being killed from then on. The store makes the log durable against","type":"text"},{"text":" ","type":"text"},{"text":"power loss too (","type":"text"},{"type":"codeVoice","code":"fsync"},{"text":") once per batch, before the batch is delivered, and whenever","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","isActive":true},{"text":" is called: call it, after the tracker’s ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":", as the app moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background or terminates.","type":"text"},{"text":" ","type":"text"},{"text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"What is kept."}]},{"type":"text","text":" Only events of the types in "},{"type":"codeVoice","code":"events"},{"type":"text","text":", which conform to "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Events of any other type are kept in memory only: they are delivered in this run like any"},{"type":"text","text":" "},{"type":"text","text":"other, are never written, and produce no drop report, but are lost if the app ends first."},{"type":"text","text":" "},{"type":"text","text":"A record’s context is not kept: a recovered record is in the top-level "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as its span ended with the earlier run."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Deleting.","type":"text"}],"type":"strong"},{"type":"text","text":" A segment is deleted as a whole once every record in it is delivered, so a"},{"type":"text","text":" "},{"type":"text","text":"log whose records are all delivered holds no files. There is no compaction: a segment kept"},{"type":"text","text":" "},{"type":"text","text":"for one undelivered record keeps its delivered ones too."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Bound.","type":"text"}],"type":"strong"},{"text":" The log never holds more than ","type":"text"},{"code":"byteBound","type":"codeVoice"},{"text":" bytes. When a record wouldn’t fit, the","type":"text"},{"text":" ","type":"text"},{"text":"oldest segments are deleted until it does, and each one deleted with records not yet","type":"text"},{"text":" ","type":"text"},{"text":"delivered yields a ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","isActive":true,"type":"reference"},{"text":" on ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","isActive":true,"type":"reference"},{"text":". A record too large for an empty log","type":"text"},{"text":" ","type":"text"},{"text":"is kept in memory only.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Recovery."}],"type":"strong"},{"text":" A store opened on a directory recovers the records earlier runs left there","type":"text"},{"text":" ","type":"text"},{"text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or","type":"text"},{"text":" ","type":"text"},{"text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported.","type":"text"},{"text":" ","type":"text"},{"text":"A segment comes back whole, delivered records and all. Each record a delivery had started on","type":"text"},{"text":" ","type":"text"},{"text":"comes back with ","type":"text"},{"code":"isRedelivered","type":"codeVoice"},{"text":" set, as it may have reached a destination already: one","type":"text"},{"text":" ","type":"text"},{"text":"delivered before the app ended, or one delivered just as it ended, before the store could","type":"text"},{"text":" ","type":"text"},{"text":"delete its segment. A record whose delivery mark can’t be written is held back from that","type":"text"},{"text":" ","type":"text"},{"text":"delivery, so it is never sent twice unannounced, and delivered on a later launch.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Newer versions.","type":"text"}],"type":"strong"},{"text":" A segment a newer release of the app wrote, in a later version of the","type":"text"},{"text":" ","type":"text"},{"text":"format, is left on disk untouched after a rollback, for that release to deliver: this one","type":"text"},{"text":" ","type":"text"},{"text":"neither reads it nor counts it toward the bound.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a","type":"text"},{"text":" ","type":"text"},{"text":"store share its log.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"reference","isActive":true},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"references":{"doc://Persistence/documentation/Persistence/SegmentStore/init(events:directory:byteBound:segmentByteCount:)":{"abstract":[{"text":"A store keeping events of the types ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"directory","type":"codeVoice"},{"text":"; it recovers the records","type":"text"},{"text":" ","type":"text"},{"text":"already there.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","title":"init(events:directory:byteBound:segmentByteCount:)","url":"\/documentation\/persistence\/segmentstore\/init(events:directory:bytebound:segmentbytecount:)","role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"events"},{"kind":"text",