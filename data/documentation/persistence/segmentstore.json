":"text","text":"), so it survives"},{"type":"text","text":" "},{"type":"text","text":"power loss."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"synchronize"},{"kind":"text","text":"()"}],"kind":"symbol"},"doc://Persistence/documentation/Persistence/RecordStore":{"role":"symbol","title":"RecordStore","abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"topic","url":"\/documentation\/persistence\/recordstore","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RecordStore"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RecordStore"}]},"doc://Persistence/documentation/Persistence/BinaryCodable/init(from:)":{"role":"symbol","title":"init(from:)","defaultImplementations":1,"abstract":[{"type":"text","text":"Reads a value "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/encode(to:)"},{"type":"text","text":" wrote from "},{"type":"codeVoice","code":"decoder"},{"type":"text","text":"."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","type":"topic","required":true,"url":"\/documentation\/persistence\/binarycodable\/init(from:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Persistence13BinaryDecoderV","text":"BinaryDecoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11Persistence19BinaryDecodingErrorO","text":"BinaryDecodingError"},{"kind":"text","text":")"}]},"d