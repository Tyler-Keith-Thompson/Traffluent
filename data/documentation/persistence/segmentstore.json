{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"externalID":"s:11Persistence12SegmentStoreV","role":"symbol","remoteSource":{"fileName":"SegmentStore.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L78"},"modules":[{"name":"Persistence"}],"title":"SegmentStore","symbolKind":"struct"},"kind":"symbol","abstract":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore"},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"seeAlsoSections":[{"generated":true,"anchor":"Stores","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"],"title":"Stores"}],"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(directory:byteBound:segmentByteCount:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"],"title":"Instance Methods"},{"generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"],"title":"Type Properties"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"variants":[{"paths":["\/documentation\/persistence\/segmentstore"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"codeListing","syntax":"swift","code":["let store = try SegmentStore()","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Write-through.","type":"text"}]},{"type":"text","text":" A tracker’s worker writes each record as it reaches it, before publishing"},{"type":"text","text":" "},{"type":"text","text":"it, with one "},{"code":"write()","type":"codeVoice"},{"type":"text","text":", off the tracking caller’s thread, so the record survives the app"},{"type":"text","text":" "},{"type":"text","text":"crashing or being killed from then on. The store makes the log durable against"},{"type":"text","text":" "},{"type":"text","text":"power loss too ("},{"code":"fsync","type":"codeVoice"},{"type":"text","text":") once per batch, before the batch is delivered, and whenever"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","isActive":true},{"type":"text","text":" is called: call it, after the tracker’s "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":", as the app moves to the"},{"type":"text","text":" "},{"type":"text","text":"background or terminates."},{"type":"text","text":" "},{"type":"text","text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","isActive":true},{"type":"text","text":", and so is one whose event’s"},{"type":"text","text":" "},{"code":"encode(to:)","type":"codeVoice"},{"type":"text","text":" throws."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"What is kept.","type":"text"}]},{"type":"text","text":" Every event "},{"type":"codeVoice","code":"DiscoveredEvent.all"},{"type":"text","text":" lists, the "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" structs of every"},{"type":"text","text":" "},{"type":"text","text":"module the program links and the library’s own, or only the "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" types in "},{"type":"codeVoice","code":"events"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Events of any other type are kept in memory only: they are delivered in this run like any"},{"type":"text","text":" "},{"type":"text","text":"other, are never written, and are lost if the app ends first. The first record of each such"},{"type":"text","text":" "},{"type":"text","text":"type is reported as "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","isActive":true},{"type":"text","text":", so a type left out by mistake,"},{"type":"text","text":" "},{"type":"text","text":"such as one that conforms to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" by hand, shows up."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"A recovered record’s session."}]},{"type":"text","text":" A record keeps the "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" of its context, written in"},{"type":"text","text":" "},{"type":"text","text":"the record’s own bytes, so a record recovered after a relaunch carries the session it was"},{"type":"text","text":" "},{"type":"text","text":"tracked in, and a vendor destination sends it under the same identity as the first time. A"},{"type":"text","text":" "},{"type":"text","text":"record written without a session comes back with none. The rest of its context is not kept:"},{"type":"text","text":" "},{"type":"text","text":"a recovered record is otherwise in the top-level "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":", as its span ended with"},{"type":"text","text":" "},{"type":"text","text":"the earlier run."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Deleting.","type":"text"}]},{"type":"text","text":" A segment is deleted as a whole once every record in it is delivered, so a"},{"type":"text","text":" "},{"type":"text","text":"log whose records are all delivered holds no files. A record’s session goes with its"},{"type":"text","text":" "},{"type":"text","text":"segment: the store keeps no session apart from the records tracked in it. A segment kept"},{"type":"text","text":" "},{"type":"text","text":"for one undelivered record keeps its delivered ones too, sessions and all. Only recovery"},{"type":"text","text":" "},{"type":"text","text":"rewrites a segment: one still holding"},{"type":"text","text":" "},{"type":"text","text":"records after it drops some ("},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","type":"reference","isActive":true},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"rewritten without them, so each drop is reported once. Should the rewrite fail, the"},{"type":"text","text":" "},{"type":"text","text":"segment is kept as it was and the next launch reports those drops again."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reading back."}],"type":"strong"},{"text":" When a destination’s full buffer drops a batch on its way through a","type":"text"},{"text":" ","type":"text"},{"text":"delivery, the delivery reads that batch’s records back from the log once the destination","type":"text"},{"text":" ","type":"text"},{"text":"has caught up, reading each segment they are in once, and hands them to it in this run,","type":"text"},{"text":" ","type":"text"},{"text":"each in the context it was tracked in, which the delivery keeps. A record the bound dropped","type":"text"},{"text":" ","type":"text"},{"text":"before the read finished isn’t read back, and one that can’t be read or decoded is logged","type":"text"},{"text":" ","type":"text"},{"text":"and waits for a later launch.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Bound.","type":"text"}]},{"type":"text","text":" The log never holds more than "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":" bytes. When a record wouldn’t fit, the"},{"type":"text","text":" "},{"type":"text","text":"oldest segments are deleted until it does, and each one deleted with records not yet"},{"type":"text","text":" "},{"type":"text","text":"delivered yields a "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","isActive":true},{"type":"text","text":" on "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","isActive":true},{"type":"text","text":". A record too large for an empty log"},{"type":"text","text":" "},{"type":"text","text":"is kept in memory only."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Recovery."}]},{"type":"text","text":" A store opened on a directory recovers the records earlier runs left there"},{"type":"text","text":" "},{"type":"text","text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or"},{"type":"text","text":" "},{"type":"text","text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported."},{"type":"text","text":" "},{"type":"text","text":"A segment comes back whole, delivered records and all. Each record a delivery had started on"},{"type":"text","text":" "},{"type":"text","text":"comes back with "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set, as it may have reached a destination already: one"},{"type":"text","text":" "},{"type":"text","text":"delivered before the app ended, or one delivered just as it ended, before the store could"},{"type":"text","text":" "},{"type":"text","text":"delete its segment. A record whose delivery mark can’t be written is held back from that"},{"type":"text","text":" "},{"type":"text","text":"delivery, so it is never sent twice unannounced, and delivered on a later launch."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Other versions."}],"type":"strong"},{"text":" A segment a newer release of the app wrote, in a later version of the","type":"text"},{"text":" ","type":"text"},{"text":"format, is left on disk untouched after a rollback, for that release to deliver: this one","type":"text"},{"text":" ","type":"text"},{"text":"neither reads it nor counts it toward the bound. A segment in an earlier version, which this","type":"text"},{"text":" ","type":"text"},{"text":"one can’t read, is deleted and reported as a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Changed event types.","type":"text"}]},{"type":"text","text":" Each record’s event is a map of its properties by name, so a record"},{"type":"text","text":" "},{"type":"text","text":"written before its type changed still reads: a property removed since is skipped, an"},{"type":"text","text":" "},{"type":"text","text":"optional one added since is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and one with a default value added since has it. A record"},{"type":"text","text":" "},{"type":"text","text":"stored at another "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":" than its type’s now is dropped without being read and"},{"type":"text","text":" "},{"type":"text","text":"reported as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"One at the same version that can’t be read all the same, after a required property was added"},{"type":"text","text":" "},{"type":"text","text":"or a property’s type changed without raising the version, is dropped and reported as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a"},{"type":"text","text":" "},{"type":"text","text":"store share its log."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"references":{"doc://Persistence/documentation/Persistence/SegmentStore/defaultDirectory":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory","title":"defaultDirectory","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultDirectory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SystemPackage8FilePathV","text":"FilePath"}],"url":"\/documentation\/persistence\/segmentstore\/defaultdirectory","abstract":[{"type":"text","text":"Where a store keeps its segments unless it is given a directory."}],"role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/init(events:directory:byteBound:segmentByteCount:)":{"url":"\/documentation\/persistence\/segmentstore\/init(events:directory:bytebound:segmentbytecount:)","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","abstract":[{"text":"A store keeping events of the types ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"directory","type":"codeVoice"},{"text":"; it recovers the records","type":"text"},{"text":" ","type":"text"},{"text":"already there.","type":"text"}],"title":"init(events:directory:byteBound:segmentByteCount:)","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"events","kind":"externalParam"},{"text":": [any (","kind":"text"},{"preciseIdentifier":"s:6Events5EventP","text":"Event","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"preciseIdentifier":"s:s7Codablea","text":"Codable","kind":"typeIdentifier"},{"text":").Type], ","kind":"text"},{"text":"directory","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13SystemPackage8FilePathV","text":"FilePath","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"byteBound","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"segmentByteCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11Persistence17SegmentStoreErrorO","text":"SegmentStoreError","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://Persistence/documentation/Persistence/SegmentStoreError":{"kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStoreError"}],"navigatorTitle":[{"kind":"identifier","text":"SegmentStoreError"}],"title":"SegmentStoreError","url":"\/documentation\/persistence\/segmentstoreerror","abstract":[{"type":"text","text":"The error "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","isActive":true},{"type":"text","text":" throws: an"},{"type":"text","text":" "},{"type":"text","text":"argument it can’t open a store with, or the file system’s failure."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError"},"doc://Persistence/documentation/Persistence/DropReport/corruption(byteCount:)":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"corruption"},{"kind":"text","text":"("},{"kind":"externalParam","text":"byteCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"title":"DropReport.corruption(byteCount:)","url":"\/documentation\/persistence\/dropreport\/corruption(bytecount:)","kind":"symbol","abstract":[{"type":"text","text":"Recovery found a torn or corrupt record, or a segment header it couldn’t read, and"},{"type":"text","text":" "},{"type":"text","text":"discarded the "},{"code":"byteCount","type":"codeVoice"},{"type":"text","text":" bytes from there to the end of the segment."}],"role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"title":"SegmentStore","url":"\/documentation\/persistence\/segmentstore","kind":"symbol","abstract":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore"},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/synchronize()":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","title":"synchronize()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"synchronize"},{"kind":"text","text":"()"}],"url":"\/documentation\/persistence\/segmentstore\/synchronize()","abstract":[{"text":"Flushes every segment written since the last flush to storage (","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":"), so it survives","type":"text"},{"text":" ","type":"text"},{"text":"power loss.","type":"text"}],"role":"symbol"},"doc://Persistence/documentation/Persistence":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"topic","title":"Persistence","url":"\/documentation\/persistence","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"role":"collection","kind":"symbol"},"doc://Persistence/s16SendableMetatypeP":{"identifier":"doc:\/\/Persistence\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://Persistence/documentation/Persistence/RecordStore":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"topic","navigatorTitle":[{"text":"RecordStore","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"title":"RecordStore","url":"\/documentation\/persistence\/recordstore","kind":"symbol","abstract":[{"text":"Where a tracker keeps each record until it is delivered, so records survive the app ending.","type":"text"}],"role":"symbol"},"doc://Persistence/documentation/Persistence/DropReport/undecodable(recordCount:)":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","type":"topic","title":"DropReport.undecodable(recordCount:)","url":"\/documentation\/persistence\/dropreport\/undecodable(recordcount:)","abstract":[{"text":"Recovery read ","type":"text"},{"code":"recordCount","type":"codeVoice"},{"text":" intact records it couldn’t decode: their event type isn’t in","type":"text"},{"text":" ","type":"text"},{"text":"the store’s ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", or its ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" threw, as it does for a record","type":"text"},{"text":" ","type":"text"},{"text":"written before a required property was added or a property’s type changed while the","type":"text"},{"text":" ","type":"text"},{"text":"event’s ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":" stayed the same.","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"undecodable","kind":"identifier"},{"text":"(","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","kind":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/append(_:)":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"append","kind":"identifier"},{"text":"(","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":") -> ","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"}],"title":"append(_:)","url":"\/documentation\/persistence\/segmentstore\/append(_:)","kind":"symbol","abstract":[{"text":"Writes ","type":"text"},{"code":"record","type":"codeVoice"},{"text":" to the log before returning, when its event type is one of ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"it fits the bound.","type":"text"}],"role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount","title":"pendingRecordCount","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"pendingRecordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"abstract":[{"text":"How many records the log keeps that are not yet delivered.","type":"text"}],"url":"\/documentation\/persistence\/segmentstore\/pendingrecordcount","role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/defaultByteBound":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","title":"defaultByteBound","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultByteBound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/persistence\/segmentstore\/defaultbytebound","abstract":[{"text":"The bound a store has unless it is given another: 5 MiB (5,242,880 bytes).","type":"text"}],"role":"symbol"},"doc://Persistence/s8SendableP":{"identifier":"doc:\/\/Persistence\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Persistence/documentation/Persistence/SegmentStore/dropReports":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:11Persistence10DropReportO","text":"DropReport"},{"kind":"text","text":">"}],"title":"dropReports","url":"\/documentation\/persistence\/segmentstore\/dropr