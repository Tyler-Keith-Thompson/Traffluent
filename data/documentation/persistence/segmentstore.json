xt":" "},{"kind":"identifier","text":"SegmentStore"}],"url":"\/documentation\/persistence\/segmentstore","type":"topic","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}]},"doc://Persistence/documentation/Persistence":{"title":"Persistence","kind":"symbol","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"url":"\/documentation\/persistence","type":"topic","role":"collection","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"kind":"symbol","abstract":[{"type":"text","text":"How many records the log keeps that are not yet delivered."}],"role":"symbol","title":"pendingRecordCount","type":"topic","url":"\/documentation\/persistence\/segmentstore\/pendingrecordcount","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"pendingRecordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"},"doc://Persistence/documentation/Persistence/RecordStore":{"title":"RecordStore","url":"\/documentation\/persistence\/recordstore","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"navigatorTitle":[{"text":"RecordStore","kind":"identifier"}],"abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"kind":"symbol","type":"topic","role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/dropReports":{"kind":"symbol","url":"\/documentation\/persistence\/segmentstore\/dropreports","