{"variants":[{"paths":["\/documentation\/persistence\/segmentstore"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"],"generated":true,"anchor":"Stores","title":"Stores"}],"kind":"symbol","identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","interfaceLanguage":"swift"},"abstract":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"reference","isActive":true},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(directory:byteBound:segmentByteCount:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"],"generated":true,"anchor":"Type-Properties","title":"Type Properties"}],"metadata":{"title":"SegmentStore","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}],"modules":[{"name":"Persistence"}],"externalID":"s:11Persistence12SegmentStoreV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L72","fileName":"SegmentStore.swift"}},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"code":["let store = try SegmentStore()","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Write-through."}]},{"type":"text","text":" A tracker’s worker writes each record as it reaches it, before publishing"},{"type":"text","text":" "},{"type":"text","text":"it, with one "},{"type":"codeVoice","code":"write()"},{"type":"text","text":", off the tracking caller’s thread, so the record survives the app"},{"type":"text","text":" "},{"type":"text","text":"crashing or being killed from then on. The store makes the log durable against"},{"type":"text","text":" "},{"type":"text","text":"power loss too ("},{"type":"codeVoice","code":"fsync"},{"type":"text","text":") once per batch, before the batch is delivered, and whenever"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()"},{"type":"text","text":" is called: call it, after the tracker’s "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":", as the app moves to the"},{"type":"text","text":" "},{"type":"text","text":"background or terminates."},{"type":"text","text":" "},{"type":"text","text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)"},{"type":"text","text":", and so is one whose event’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" throws."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"What is kept.","type":"text"}]},{"type":"text","text":" Every event "},{"type":"codeVoice","code":"DiscoveredEvent.all"},{"type":"text","text":" lists, the "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" structs of every"},{"type":"text","text":" "},{"type":"text","text":"module the program links and the library’s own, or only the "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" types in "},{"type":"codeVoice","code":"events"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Events of any other type are kept in memory only: they are delivered in this run like any"},{"type":"text","text":" "},{"type":"text","text":"other, are never written, and are lost if the app ends first. The first record of each such"},{"type":"text","text":" "},{"type":"text","text":"type is reported as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)"},{"type":"text","text":", so a type left out by mistake,"},{"type":"text","text":" "},{"type":"text","text":"such as one that conforms to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" by hand, shows up."},{"type":"text","text":" "},{"type":"text","text":"A record’s context is not kept: a recovered record is in the top-level "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as its span ended with the earlier run."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deleting."}]},{"type":"text","text":" A segment is deleted as a whole once every record in it is delivered, so a"},{"type":"text","text":" "},{"type":"text","text":"log whose records are all delivered holds no files. A segment kept for one undelivered"},{"type":"text","text":" "},{"type":"text","text":"record keeps its delivered ones too. Only recovery rewrites a segment: one still holding"},{"type":"text","text":" "},{"type":"text","text":"records after it drops some ("},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","isActive":true},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"rewritten without them, so each drop is reported once. Should the rewrite fail, the"},{"type":"text","text":" "},{"type":"text","text":"segment is kept as it was and the next launch reports those drops again."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Reading back."}],"type":"strong"},{"text":" When a destination’s full buffer drops a batch on its way through a","type":"text"},{"text":" ","type":"text"},{"text":"delivery, the delivery reads that batch’s records back from the log once the destination","type":"text"},{"text":" ","type":"text"},{"text":"has caught up, reading each segment they are in once, and hands them to it in this run,","type":"text"},{"text":" ","type":"text"},{"text":"each in the context it was tracked in, which the delivery keeps. A record the bound dropped","type":"text"},{"text":" ","type":"text"},{"text":"before the read finished isn’t read back, and one that can’t be read or decoded is logged","type":"text"},{"text":" ","type":"text"},{"text":"and waits for a later launch.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Bound."}],"type":"strong"},{"text":" The log never holds more than ","type":"text"},{"code":"byteBound","type":"codeVoice"},{"text":" bytes. When a record wouldn’t fit, the","type":"text"},{"text":" ","type":"text"},{"text":"oldest segments are deleted until it does, and each one deleted with records not yet","type":"text"},{"text":" ","type":"text"},{"text":"delivered yields a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","type":"reference"},{"text":" on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","type":"reference"},{"text":". A record too large for an empty log","type":"text"},{"text":" ","type":"text"},{"text":"is kept in memory only.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Recovery.","type":"text"}]},{"type":"text","text":" A store opened on a directory recovers the records earlier runs left there"},{"type":"text","text":" "},{"type":"text","text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or"},{"type":"text","text":" "},{"type":"text","text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported."},{"type":"text","text":" "},{"type":"text","text":"A segment comes back whole, delivered records and all. Each record a delivery had started on"},{"type":"text","text":" "},{"type":"text","text":"comes back with "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set, as it may have reached a destination already: one"},{"type":"text","text":" "},{"type":"text","text":"delivered before the app ended, or one delivered just as it ended, before the store could"},{"type":"text","text":" "},{"type":"text","text":"delete its segment. A record whose delivery mark can’t be written is held back from that"},{"type":"text","text":" "},{"type":"text","text":"delivery, so it is never sent twice unannounced, and delivered on a later launch."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Other versions.","type":"text"}]},{"type":"text","text":" A segment a newer release of the app wrote, in a later version of the"},{"type":"text","text":" "},{"type":"text","text":"format, is left on disk untouched after a rollback, for that release to deliver: this one"},{"type":"text","text":" "},{"type":"text","text":"neither reads it nor counts it toward the bound. A segment in an earlier version, which this"},{"type":"text","text":" "},{"type":"text","text":"one can’t read, is deleted and reported as a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Changed event types.","type":"text"}]},{"type":"text","text":" Each record’s event is a map of its properties by name, so a record"},{"type":"text","text":" "},{"type":"text","text":"written before its type changed still reads: a property removed since is skipped, an"},{"type":"text","text":" "},{"type":"text","text":"optional one added since is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and one with a default value added since has it. A record"},{"type":"text","text":" "},{"type":"text","text":"stored at another "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":" than its type’s now is dropped without being read and"},{"type":"text","text":" "},{"type":"text","text":"reported as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"One at the same version that can’t be read all the same, after a required property was added"},{"type":"text","text":" "},{"type":"text","text":"or a property’s type changed without raising the version, is dropped and reported as"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a","type":"text"},{"text":" ","type":"text"},{"text":"store share its log.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://Persistence/documentation/Persistence/RecordStore":{"type":"topic","title":"RecordStore","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RecordStore"}],"url":"\/documentation\/persistence\/recordstore","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RecordStore"}]},"doc://Persistence/documentation/Persistence/SegmentStore/defaultByteBound":{"role":"symbol","url":"\/documentation\/persistence\/segmentstore\/defaultbytebound","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultByteBound","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"title":"defaultByteBound","abstract":[{"text":"The bound a store has unless it is given another: 5 MiB (5,242,880 bytes).","type":"text"}],"type":"topic","kind":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/synchronize()":{"role":"symbol","url":"\/documentation\/persistence\/segmentstore\/synchronize()","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"synchronize","kind":"identifier"},{"text":"()","kind":"text"}],"title":"synchronize()","abstract":[{"type":"text","text":"Flushes every segment written since the last flush to storage ("},{"code":"fsync","type":"codeVoice"},{"type":"text","text":"), so it survives"},{"type":"text","text":" "},{"type":"text","text":"power loss."}],"type":"topic","kind":"symbol"},"doc://Persistence/documentation/Persistence":{"role":"collection","url":"\/documentation\/persistence","identifier":"doc:\/\/Persistence\/documentation\/Persistence","title":"Persistence","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"type":"topic","kind":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/byteCount":{"url":"\/documentation\/persistence\/segmentstore\/bytecount","title":"byteCount","abstract":[{"text":"The bytes the log holds on disk: every segment’s header, records and delivery marks.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byteCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]},"doc://Persistence/documentation/Persistence/SegmentStore/append(_:)":{"type":"topic","url":"\/documentation\/persistence\/segmentstore\/append(_:)","title":"append(_:)","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Writes "},{"code":"record","type":"codeVoice"},{"type":"text","text":" to the log before returning, when its event type is one of "},{"code":"events","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"it fits the bound."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"append","kind":"identifier"},{"text":"(","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":") -> ","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"}]},"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"type":"topic","url":"\/documentation\/persistence\/segmentstore\/pendingrecordcount","kind":"symbol","title":"pendingRecordCount","role":"symbol","abstract":[{"type":"text","text":"How many records the log keeps that are not yet delivered."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"pendingRecordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]},"doc://Persistence/documentation/Persistence/SegmentStore":{"type":"topic","title":"SegmentStore","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"url":"\/documentation\/persistence\/segmentstore","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","kind":"symbol","abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}]},"doc://Persistence/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/Persistence\/s8SendableP","type":"unresolvable"},"doc://Persistence/documentation/Persistence/SegmentStore/init(events:directory:byteBound:segmentByteCount:)":{"role":"symbol","url":"\/documentation\/persistence\/segmentstore\/init(events:directory:bytebound:segmentbytecount:)","abstract":[{"text":"A store keeping events of the types ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"directory"},{"text":"; it recovers the records","type":"text"},{"text":" ","type":"text"},{"text":"already there.","type":"text"}],"type":"topic","title":"init(events:directory:byteBound:segmentByteCount:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"events","kind":"externalParam"},{"text":": [any (","kind":"text"},{"text":"Event","preciseIdentifier":"s:6Events5EventP","kind":"typeIdentifier"},{"text":" & ",