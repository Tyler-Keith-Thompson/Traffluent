er":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"writeFailed"},{"kind":"text","text":"("},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"timestamps"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ClosedRange","preciseIdentifier":"s:SN"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":">)"}]},"doc://Persistence/documentation/Persistence/SegmentStore/byteCount":{"title":"byteCount","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byteCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"url":"\/documentation\/persistence\/segmentstore\/bytecount","abstract":[{"text":"The bytes the log holds on disk: every segment’s header, records and delivery marks.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount"},"doc://Persistence/documentation/Persistence/SegmentStore/synchronize()":{"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","kind":"symbol","abstract":[{"text":"Flushes every segment written since the last flush to storage (","type":"text"},{"type":"codeVoice","code":"fsync"},{"text":"), so it survives","type":"text"},{"text":" ","type":"text"},{"text":"power loss.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"synchronize","kind":"identifier"},{"text":"()","kind":"text"}],"title":"synchronize()","url":"\/documentation\/persistence\/segme