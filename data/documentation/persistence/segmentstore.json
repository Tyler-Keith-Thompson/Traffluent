{"abstract":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore"},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"],"generated":true}],"variants":[{"paths":["\/documentation\/persistence\/segmentstore"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"seeAlsoSections":[{"anchor":"Stores","title":"Stores","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"],"generated":true}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}],"externalID":"s:11Persistence12SegmentStoreV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"roleHeading":"Structure","role":"symbol","remoteSource":{"fileName":"SegmentStore.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L69"},"symbolKind":"struct","modules":[{"name":"Persistence"}],"title":"SegmentStore"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"codeListing","code":["let store = try SegmentStore(events: [SignedUp.self, CheckedOut.self])","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Write-through."}],"type":"strong"},{"text":" A tracker’s worker writes each record as it reaches it, before publishing","type":"text"},{"text":" ","type":"text"},{"text":"it, with one ","type":"text"},{"code":"write()","type":"codeVoice"},{"text":", off the tracking caller’s thread, so the record survives the app","type":"text"},{"text":" ","type":"text"},{"text":"crashing or being killed from then on. The store makes the log durable against","type":"text"},{"text":" ","type":"text"},{"text":"power loss too (","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":") once per batch, before the batch is delivered, and whenever","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","type":"reference"},{"text":" is called: call it, after the tracker’s ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":", as the app moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background or terminates.","type":"text"},{"text":" ","type":"text"},{"text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"What is kept."}],"type":"strong"},{"text":" Only events of the types in ","type":"text"},{"type":"codeVoice","code":"events"},{"text":", which conform to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Events of any other type are kept in memory only: they are delivered in this run like any","type":"text"},{"text":" ","type":"text"},{"text":"other, are never written, and are lost if the app ends first. The first record of each such","type":"text"},{"text":" ","type":"text"},{"text":"type is reported as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)"},{"text":", so a type left out of ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"mistake shows up.","type":"text"},{"text":" ","type":"text"},{"text":"A record’s context is not kept: a recovered record is in the top-level ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"as its span ended with the earlier run.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deleting."}]},{"type":"text","text":" A segment is deleted as a whole once every record in it is delivered, so a"},{"type":"text","text":" "},{"type":"text","text":"log whose records are all delivered holds no files. A segment kept for one undelivered"},{"type":"text","text":" "},{"type":"text","text":"record keeps its delivered ones too. Only recovery rewrites a segment: one still holding"},{"type":"text","text":" "},{"type":"text","text":"records after it drops some ("},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","isActive":true},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"rewritten without them, so each drop is reported once. Should the rewrite fail, the"},{"type":"text","text":" "},{"type":"text","text":"segment is kept as it was and the next launch reports those drops again."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Reading back.","type":"text"}]},{"type":"text","text":" When a destination’s full buffer drops a batch on its way through a"},{"type":"text","text":" "},{"type":"text","text":"delivery, the delivery reads that batch’s records back from the log once the destination"},{"type":"text","text":" "},{"type":"text","text":"has caught up, reading each segment they are in once, and hands them to it in this run,"},{"type":"text","text":" "},{"type":"text","text":"each in the context it was tracked in, which the delivery keeps. A record the bound dropped"},{"type":"text","text":" "},{"type":"text","text":"before the read finished isn’t read back, and one that can’t be read or decoded is logged"},{"type":"text","text":" "},{"type":"text","text":"and waits for a later launch."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Bound."}]},{"text":" The log never holds more than ","type":"text"},{"type":"codeVoice","code":"byteBound"},{"text":" bytes. When a record wouldn’t fit, the","type":"text"},{"text":" ","type":"text"},{"text":"oldest segments are deleted until it does, and each one deleted with records not yet","type":"text"},{"text":" ","type":"text"},{"text":"delivered yields a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","type":"reference"},{"text":" on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","type":"reference"},{"text":". A record too large for an empty log","type":"text"},{"text":" ","type":"text"},{"text":"is kept in memory only.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Recovery."}]},{"type":"text","text":" A store opened on a directory recovers the records earlier runs left there"},{"type":"text","text":" "},{"type":"text","text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or"},{"type":"text","text":" "},{"type":"text","text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported."},{"type":"text","text":" "},{"type":"text","text":"A segment comes back whole, delivered records and all. Each record a delivery had started on"},{"type":"text","text":" "},{"type":"text","text":"comes back with "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set, as it may have reached a destination already: one"},{"type":"text","text":" "},{"type":"text","text":"delivered before the app ended, or one delivered just as it ended, before the store could"},{"type":"text","text":" "},{"type":"text","text":"delete its segment. A record whose delivery mark can’t be written is held back from that"},{"type":"text","text":" "},{"type":"text","text":"delivery, so it is never sent twice unannounced, and delivered on a later launch."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Other versions."}]},{"type":"text","text":" A segment a newer release of the app wrote, in a later version of the"},{"type":"text","text":" "},{"type":"text","text":"format, is left on disk untouched after a rollback, for that release to deliver: this one"},{"type":"text","text":" "},{"type":"text","text":"neither reads it nor counts it toward the bound. A segment in an earlier version, which this"},{"type":"text","text":" "},{"type":"text","text":"one can’t read, is deleted and reported as a"},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","isActive":true,"type":"reference"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Changed event types.","type":"text"}]},{"type":"text","text":" Each record’s event is a map of its properties by name, so a record"},{"type":"text","text":" "},{"type":"text","text":"written before its type changed still reads: a property removed since is skipped, an"},{"type":"text","text":" "},{"type":"text","text":"optional one added since is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" and one with a default value added since has it. A record"},{"type":"text","text":" "},{"type":"text","text":"stored at another "},{"code":"Event.schemaVersion","type":"codeVoice"},{"type":"text","text":" than its type’s now is dropped without being read and"},{"type":"text","text":" "},{"type":"text","text":"reported as "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"One at the same version that can’t be read all the same, after a required property was added"},{"type":"text","text":" "},{"type":"text","text":"or a property’s type changed without raising the version, is dropped and reported as"},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","type":"reference","isActive":true},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a"},{"type":"text","text":" "},{"type":"text","text":"store share its log."}]}],"kind":"content"}],"references":{"doc://Persistence/documentation/Persistence/SegmentStore/defaultByteBound":{"url":"\/documentation\/persistence\/segmentstore\/defaultbytebound","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultByteBound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"abstract":[{"text":"The bound a store has unless it is given another: 5 MiB (5,242,880 bytes).","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","title":"defaultByteBound","role":"symbol"},"doc://Persistence/documentation/Persistence":{"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"title":"Persistence","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"doc://Persistence/documentation/Persistence/SegmentStore/takeRecoveredRecords()":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The records of the segments earlier runs left, oldest first, with "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set on"},{"type":"text","text":" "},{"type":"text","text":"each one a delivery had started on; later calls return none."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()","title":"takeRecoveredRecords()","url":"\/documentation\/persistence\/segmentstore\/takerecoveredrecords()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"takeRecoveredRecords"},{"kind":"text","text":"() -> ["},{"preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier","text":"EventRecord"},{"kind":"text","text":"]"}]},"doc://Persistence/documentation/Persistence/DropReport/versionMismatch(event:storedVersion:currentVersion:recordCount:)":{"role":"symbol","title":"DropReport.versionMismatch(event:storedVersion:currentVersion:recordCount:)","abstract":[{"type":"text","text":"Recovery read "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" intact records of the event named "},{"type":"codeVoice","code":"event"},{"type":"text","text":" stored at"},{"type":"text","text":" "},{"type":"codeVoice","code":"storedVersion"},{"type":"text","text":", while the store’s type of that name is at "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":"), and dropped them without decoding them: the version changed for a"},{"type":"text","text":" "},{"type":"text","text":"change their bytes can’t be read through. Reported once per segment, or per database, for"},{"type":"text","text":" "},{"type":"text","text":"each event and stored version, by the event’s name and then the stored version."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","type":"topic","url":"\/documentation\/persistence\/dropreport\/versionmismatch(event:storedversion:currentversion:recordcount:)","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"versionMismatch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"event"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"storedVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"currentVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}]},"doc://Persistence/documentation/Persistence/SegmentStore/init(events:directory:byteBound:segmentByteCount:)":{"abstract":[{"type":"text","text":"A store keeping events of the types "},{"type":"codeVoice","code":"events"},{"type":"text","text":" in "},{"type":"codeVoice","code":"directory"},{"type":"text","text":"; it recovers the records"},{"type":"text","text":" "},{"type":"text","text":"already there."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","title":"init(events:directory:byteBound:seg