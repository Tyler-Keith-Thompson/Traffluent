text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"url":"\/documentation\/persistence","title":"Persistence","identifier":"doc:\/\/Persistence\/documentation\/Persistence","role":"collection","type":"topic","kind":"symbol"},"doc://Persistence/documentation/Persistence/DropReport/writeFailed(recordCount:timestamps:)":{"role":"symbol","title":"DropReport.writeFailed(recordCount:timestamps:)","url":"\/documentation\/persistence\/dropreport\/writefailed(recordcount:timestamps:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"writeFailed"},{"kind":"text","text":"("},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"timestamps"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SN","kind":"typeIdentifier","text":"ClosedRange"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":">)"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Writing "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" records, tracked within "},{"type":"codeVoice","code":"timestamps"},{"type":"text","text":", to disk failed (the disk is"},{"type":"text","text":" "},{"type":"text","text":"full, say, or segments that couldn’t be deleted fill the bound), so they are kept in memory"},{"type":"text","text":" "},{"type":"text","text":"only: delivered in this run if it lasts long"},{"type":"text","text":" "},{"type":"text","text":"enough, lost if it ends first."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)"},"doc://Persistence/documentation/Persistence/DropReport":{"abstract":[{"text":"Records a store dropped before they were delivered, and why.","t