{"abstract":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"reference","isActive":true},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"],"kind":"relationships"}],"variants":[{"paths":["\/documentation\/persistence\/segmentstore"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"},"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"],"title":"Instance Methods"},{"generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"],"title":"Type Properties"}],"metadata":{"modules":[{"name":"Persistence"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"externalID":"s:11Persistence12SegmentStoreV","title":"SegmentStore","remoteSource":{"fileName":"SegmentStore.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L69"},"symbolKind":"struct","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}],"roleHeading":"Structure"},"seeAlsoSections":[{"generated":true,"anchor":"Stores","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"],"title":"Stores"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"codeListing","code":["let store = try SegmentStore(events: [SignedUp.self, CheckedOut.self])","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Write-through.","type":"text"}],"type":"strong"},{"text":" A tracker’s worker writes each record as it reaches it, before publishing","type":"text"},{"text":" ","type":"text"},{"text":"it, with one ","type":"text"},{"code":"write()","type":"codeVoice"},{"text":", off the tracking caller’s thread, so the record survives the app","type":"text"},{"text":" ","type":"text"},{"text":"crashing or being killed from then on. The store makes the log durable against","type":"text"},{"text":" ","type":"text"},{"text":"power loss too (","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":") once per batch, before the batch is delivered, and whenever","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","isActive":true,"type":"reference"},{"text":" is called: call it, after the tracker’s ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":", as the app moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background or terminates.","type":"text"},{"text":" ","type":"text"},{"text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"What is kept.","type":"text"}]},{"type":"text","text":" Only events of the types in "},{"type":"codeVoice","code":"events"},{"type":"text","text":", which conform to "},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Events of any other type are kept in memory only: they are delivered in this run like any"},{"type":"text","text":" "},{"type":"text","text":"other, are never written, and are lost if the app ends first. The first record of each such"},{"type":"text","text":" "},{"type":"text","text":"type is reported as "},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","type":"reference"},{"type":"text","text":", so a type left out of "},{"type":"codeVoice","code":"events"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"mistake shows up."},{"type":"text","text":" "},{"type":"text","text":"A record’s context is not kept: a recovered record is in the top-level "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as its span ended with the earlier run."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deleting."}]},{"text":" A segment is deleted as a whole once every record in it is delivered, so a","type":"text"},{"text":" ","type":"text"},{"text":"log whose records are all delivered holds no files. A segment kept for one undelivered","type":"text"},{"text":" ","type":"text"},{"text":"record keeps its delivered ones too. Only recovery rewrites a segment: one still holding","type":"text"},{"text":" ","type":"text"},{"text":"records after it drops some (","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","isActive":true,"type":"reference"},{"text":") is","type":"text"},{"text":" ","type":"text"},{"text":"rewritten without them, so each drop is reported once. Should the rewrite fail, the","type":"text"},{"text":" ","type":"text"},{"text":"segment is kept as it was and the next launch reports those drops again.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Reading back.","type":"text"}]},{"text":" When a destination’s full buffer drops a batch on its way through a","type":"text"},{"text":" ","type":"text"},{"text":"delivery, the delivery reads that batch’s records back from the log once the destination","type":"text"},{"text":" ","type":"text"},{"text":"has caught up, reading each segment they are in once, and hands them to it in this run,","type":"text"},{"text":" ","type":"text"},{"text":"each in the context it was tracked in, which the delivery keeps. A record the bound dropped","type":"text"},{"text":" ","type":"text"},{"text":"before the read finished isn’t read back, and one that can’t be read or decoded is logged","type":"text"},{"text":" ","type":"text"},{"text":"and waits for a later launch.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Bound."}],"type":"strong"},{"text":" The log never holds more than ","type":"text"},{"type":"codeVoice","code":"byteBound"},{"text":" bytes. When a record wouldn’t fit, the","type":"text"},{"text":" ","type":"text"},{"text":"oldest segments are deleted until it does, and each one deleted with records not yet","type":"text"},{"text":" ","type":"text"},{"text":"delivered yields a ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","type":"reference","isActive":true},{"text":" on ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","type":"reference","isActive":true},{"text":". A record too large for an empty log","type":"text"},{"text":" ","type":"text"},{"text":"is kept in memory only.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Recovery."}]},{"type":"text","text":" A store opened on a directory recovers the records earlier runs left there"},{"type":"text","text":" "},{"type":"text","text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or"},{"type":"text","text":" "},{"type":"text","text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported."},{"type":"text","text":" "},{"type":"text","text":"A segment comes back whole, delivered records and all. Each record a delivery had started on"},{"type":"text","text":" "},{"type":"text","text":"comes back with "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set, as it may have reached a destination already: one"},{"type":"text","text":" "},{"type":"text","text":"delivered before the app ended, or one delivered just as it ended, before the store could"},{"type":"text","text":" "},{"type":"text","text":"delete its segment. A record whose delivery mark can’t be written is held back from that"},{"type":"text","text":" "},{"type":"text","text":"delivery, so it is never sent twice unannounced, and delivered on a later launch."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Other versions."}]},{"type":"text","text":" A segment a newer release of the app wrote, in a later version of the"},{"type":"text","text":" "},{"type":"text","text":"format, is left on disk untouched after a rollback, for that release to deliver: this one"},{"type":"text","text":" "},{"type":"text","text":"neither reads it nor counts it toward the bound. A segment in an earlier version, which this"},{"type":"text","text":" "},{"type":"text","text":"one can’t read, is deleted and reported as a"},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Changed event types.","type":"text"}]},{"type":"text","text":" Each record’s event is a map of its properties by name, so a record"},{"type":"text","text":" "},{"type":"text","text":"written before its type changed still reads: a property removed since is skipped, an"},{"type":"text","text":" "},{"type":"text","text":"optional one added since is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" and one with a default value added since has it. A record"},{"type":"text","text":" "},{"type":"text","text":"stored at another "},{"code":"Event.schemaVersion","type":"codeVoice"},{"type":"text","text":" than its type’s now is dropped without being read and"},{"type":"text","text":" "},{"type":"text","text":"reported as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"One at the same version that can’t be read all the same, after a required property was added"},{"type":"text","text":" "},{"type":"text","text":"or a property’s type changed without raising the version, is dropped and reported as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a","type":"text"},{"text":" ","type":"text"},{"text":"store share its log.","type":"text"}]}],"kind":"content"}],"sections":[],"references":{"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"title":"pendingRecordCount","url":"\/documentation\/persistence\/segmentstore\/pendingrecordcount","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"pendingRecordCount"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"abstract":[{"type":"text","text":"How many records the log keeps that are not yet delivered."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount","kind":"symbol"},"doc://Persistence/documentation/Persistence/RecordStore":{"abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"navigatorTitle":[{"text":"RecordStore","kind":"identifier"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","url":"\/documentation\/persistence\/recordstore","title":"RecordStore","type":"topic"},"doc://Persistence/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Persistence\/s8SendableP","title":"Swift.Sendable"},"doc://Persistence/documentation/Persistence/DropReport/notPersisted(event:)":{"type":"topic","title":"DropReport.notPersisted(event:)","url":"\/documentation\/persistence\/dropreport\/notpersisted(event:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notPersisted"},{"kind":"text","text":"("},{"kind":"externalParam","text":"event"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"A record of the event named "},{"type":"codeVoice","code":"event"},{"type":"text","text":" was kept in memory only because its type isn’t one of"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"events"},{"type":"text","text":": its records are delivered in this run, but never written, so they are"},{"type":"text","text":" "},{"type":"text","text":"lost if the app ends first. Reported once per type, on its first record, for as long as the"},{"type":"text","text":" "},{"type":"text","text":"store lives; a type left out by mistake is added to "},{"type":"codeVoice","code":"events"},{"type":"text","text":"."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","kind":"symbol"},"doc://Persistence/documentation/Persistence/DropReport/versionMismatch(event:storedVersion:currentVersion:recordCount:)":{"abstract":[{"text":"Recovery read ","type":"text"},{"code":"recordCount","type":"codeVoice"},{"text":" intact records of the event named ","type":"text"},{"code":"event","type":"codeVoice"},{"text":" stored at","type":"text"},{"text":" ","type":"text"},{"code":"storedVersion","type":"codeVoice"},{"text":", while the store’s type of that name is at ","type":"text"},{"code":"currentVersion","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":"), and dropped them without decoding them: the version changed for a","type":"text"},{"text":" ","type":"text"},{"text":"change their bytes can’t be read through. Reported once per segment, or per database, for","type":"text"},{"text":" ","type":"text"},{"text":"each event and stored version, by the event’s name and then the stored version.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"versionMismatch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"event"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"storedVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"currentVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","url":"\/documentation\/persistence\/dropreport\/versionmismatch(event:storedversion:currentversion:recordcount:)","title":"DropReport.versionMismatch(event:storedVersion:currentVersion:recordCount:)","type":"topic"},"doc://Persistence/documentation/Persistence/SegmentStore/directory":{"type":"topic","title":"directory","url":"\/documentation\/persistence\/segmentstore\/directory","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"directory","kind":"identifier"},{"text":": ","kind":"text"},{"text":"FilePath","preciseIdentifier":"s:13SystemPackage8FilePathV","kind":"typeIdentifier"}],"abstract":[{"text":"Where the store keeps its segments.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","kind":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/append(_:)":{"abstract":[{"type":"text","text":"Writes "},{"type":"codeVoice","code":"record"},{"type":"text","text":" to the log before returning, when its event type is one of "},{"type":"codeVoice","code":"events"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"it fits the bound."}],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"append","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","url":"\/documentation\/persistence\/segmentstore\/append(_:)","title":"append(_:)","type":"topic"},"doc://Persistence/documentation/Persistence/SegmentStore/dropReports":{"title":"dropReports","url":"\/documentation\/persistence\/segmentstore\/dropreports","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DropReport","preciseIdentifier":"s:11Persistence10DropReportO","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"A report of each drop, in the order they happen, from recovery onwards.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","kind":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/takeRecoveredRecords()":{"title":"takeRecoveredRecords()","url":"\/documentation\/persistence\/segmentstore\/takerecoveredrecords()","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"takeRecoveredRecords","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The records of the segments earlier runs left, oldest first, with "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set on"},{"type":"text","text":" "},{"type":"text","text":"each one a delivery had started on; later calls return none."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()","kind":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/byteCount":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byteCount","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"kind":"symbol","title":"byteCount","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/bytecount","type":"topic","abstract":[{"text":"The bytes the log holds on disk: every segment’s header, records and delivery marks.","type":"text"}]},"doc://Persistence/documentation/Persistence/BinaryCodable/init(from:)":{"type":"topic","title":"init(from:)","url":"\/documentation\/persistence\/binarycodable\/init(from:)","role":"symbol","defaultImplementations":1,"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Persistence13BinaryDecoderV","text":"BinaryDecoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11Persistence19BinaryDecodingErrorO","text":"BinaryDecodingError"},{"kind":"text","text":")"}],"required":true,"abstract":[{"text":"Reads a value ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/encode(to:)","type":"reference"},{"text":" wrote from ","type":"text"},{"type":"codeVoice","code":"decoder"},{"text":".","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","kind":"symbol"},"doc://Persistence/documentation/Persistence/BinaryCodable":{"title":"BinaryCodable","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","type":"topic","role":"symbol","navigatorTitle":[{"text":"BinaryCodable","kind":"identifier"}],"abstract":[{"text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk.","type":"text"}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryCodable","kind":"identifier"}],"url":"\/documentation\/persistence\/binarycodable"},"doc://Persistence/documentation/Persistence/DropReport":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DropReport"}],"kind":"symbol","title":"DropReport","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DropReport"}],"url":"\/documentation\/persistence\/dropreport","type":"topic","abstract":[{"text":"Records a store dropped before they were delivered, and why.","type":"text"}]},"doc://Persistence/documentation/Persistence/SegmentStore/synchronize()":{"type":"topic","title":"synchronize()","url":"\/documentation\/persistence\/segmentstore\/synchronize()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"synchronize","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"text":"Flushes every segment written since the last flush to storage (","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":"), so it survives","type":"text"},{"text":" ","type":"text"},{"text":"power loss.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","kind":"symbol"},"doc://Persistence/documentation/Persistence/DropReport/corruption(byteCount:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"corruption","kind":"identifier"},{"text":"(","kind":"text"},{"text":"byteCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","title":"DropReport.corruption(byteCount:)","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","role":"symbol","url":"\/documentation\/persistence\/dropreport\/corruption(bytecount:)","type":"topic","abstract":[{"type":"text","text":"Recovery found a torn or corrupt record, or a segment header it couldn’t read, and"},{"type":"text","text":" "},{"type":"text","text":"discarded the "},{"type":"codeVoice","code":"byteCount"},{"type":"text","text":" bytes from there to the end of the segment."}]},"doc://Persistence/documentation/Persistence/DropReport/writeFailed(recordCount:timestamps:)":{"title":"DropReport.writeFai