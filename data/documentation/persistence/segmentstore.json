{"metadata":{"title":"SegmentStore","roleHeading":"Structure","externalID":"s:11Persistence12SegmentStoreV","modules":[{"name":"Persistence"}],"role":"symbol","navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L61","fileName":"SegmentStore.swift"}},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"code":["let store = try SegmentStore(events: [SignedUp.self, CheckedOut.self])","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Write-through."}],"type":"strong"},{"text":" A tracker’s worker writes each record as it reaches it, before publishing","type":"text"},{"text":" ","type":"text"},{"text":"it, with one ","type":"text"},{"type":"codeVoice","code":"write()"},{"text":", off the tracking caller’s thread, so the record survives the app","type":"text"},{"text":" ","type":"text"},{"text":"crashing or being killed from then on. The store makes the log durable against","type":"text"},{"text":" ","type":"text"},{"text":"power loss too (","type":"text"},{"type":"codeVoice","code":"fsync"},{"text":") once per batch, before the batch is delivered, and whenever","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()"},{"text":" is called: call it, after the tracker’s ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":", as the app moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background or terminates.","type":"text"},{"text":" ","type":"text"},{"text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"What is kept.","type":"text"}],"type":"strong"},{"text":" Only events of the types in ","type":"text"},{"type":"codeVoice","code":"events"},{"text":", which conform to ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Events of any other type are kept in memory only: they are delivered in this run like any","type":"text"},{"text":" ","type":"text"},{"text":"other, are never written, and produce no drop report, but are lost if the app ends first.","type":"text"},{"text":" ","type":"text"},{"text":"A record’s context is not kept: a recovered record is in the top-level ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"as its span ended with the earlier run.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Deleting."}],"type":"strong"},{"text":" A segment is deleted as a whole once every record in it is delivered, so a","type":"text"},{"text":" ","type":"text"},{"text":"log whose records are all delivered holds no files. A segment kept for one undelivered","type":"text"},{"text":" ","type":"text"},{"text":"record keeps its delivered ones too. Only recovery rewrites a segment: one still holding","type":"text"},{"text":" ","type":"text"},{"text":"records after it drops some (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)"},{"text":") is","type":"text"},{"text":" ","type":"text"},{"text":"rewritten without them, so each drop is reported once. Should the rewrite fail, the","type":"text"},{"text":" ","type":"text"},{"text":"segment is kept as it was and the next launch reports those drops again.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Bound."}]},{"type":"text","text":" The log never holds more than "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":" bytes. When a record wouldn’t fit, the"},{"type":"text","text":" "},{"type":"text","text":"oldest segments are deleted until it does, and each one deleted with records not yet"},{"type":"text","text":" "},{"type":"text","text":"delivered yields a "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","isActive":true},{"type":"text","text":" on "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","isActive":true},{"type":"text","text":". A record too large for an empty log"},{"type":"text","text":" "},{"type":"text","text":"is kept in memory only."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Recovery.","type":"text"}]},{"text":" A store opened on a directory recovers the records earlier runs left there","type":"text"},{"text":" ","type":"text"},{"text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or","type":"text"},{"text":" ","type":"text"},{"text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported.","type":"text"},{"text":" ","type":"text"},{"text":"A segment comes back whole, delivered records and all. Each record a delivery had started on","type":"text"},{"text":" ","type":"text"},{"text":"comes back with ","type":"text"},{"code":"isRedelivered","type":"codeVoice"},{"text":" set, as it may have reached a destination already: one","type":"text"},{"text":" ","type":"text"},{"text":"delivered before the app ended, or one delivered just as it ended, before the store could","type":"text"},{"text":" ","type":"text"},{"text":"delete its segment. A record whose delivery mark can’t be written is held back from that","type":"text"},{"text":" ","type":"text"},{"text":"delivery, so it is never sent twice unannounced, and delivered on a later launch.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Other versions.","type":"text"}]},{"type":"text","text":" A segment a newer release of the app wrote, in a later version of the"},{"type":"text","text":" "},{"type":"text","text":"format, is left on disk untouched after a rollback, for that release to deliver: this one"},{"type":"text","text":" "},{"type":"text","text":"neither reads it nor counts it toward the bound. A segment in an earlier version, which this"},{"type":"text","text":" "},{"type":"text","text":"one can’t read, is deleted and reported as a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Changed event types."}],"type":"strong"},{"text":" Each record’s event is a map of its properties by name, so a record","type":"text"},{"text":" ","type":"text"},{"text":"written before its type changed still reads: a property removed since is skipped, an","type":"text"},{"text":" ","type":"text"},{"text":"optional one added since is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and one with a default value added since has it. A record","type":"text"},{"text":" ","type":"text"},{"text":"stored at another ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":" than its type’s now is dropped without being read and","type":"text"},{"text":" ","type":"text"},{"text":"reported as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"One at the same version that can’t be read all the same, after a required property was added","type":"text"},{"text":" ","type":"text"},{"text":"or a property’s type changed without raising the version, is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","type":"reference"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a","type":"text"},{"text":" ","type":"text"},{"text":"store share its log.","type":"text"}],"type":"paragraph"}]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"],"anchor":"Instance-Methods","title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"],"anchor":"Type-Properties","title":"Type Properties"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"],"title":"Conforms To"}],"kind":"symbol","abstract":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore"},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistence\/segmentstore"]}],"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Persistence/documentation/Persistence/BinaryCodable/init(from:)":{"defaultImplementations":1,"required":true,"title":"init(from:)","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","role":"symbol","kind":"symbol","fragmen