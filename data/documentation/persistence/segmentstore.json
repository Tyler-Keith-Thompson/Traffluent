tion(byteCount:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"corruption"},{"kind":"text","text":"("},{"kind":"externalParam","text":"byteCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","type":"topic","abstract":[{"type":"text","text":"Recovery found a torn or corrupt record, or a segment header it couldn’t read, and"},{"type":"text","text":" "},{"type":"text","text":"discarded the "},{"type":"codeVoice","code":"byteCount"},{"type":"text","text":" bytes from there to the end of the segment."}]},"doc://Persistence/documentation/Persistence/SegmentStore/append(_:)":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"append"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"}],"title":"append(_:)","url":"\/documentation\/persistence\/segmentstore\/append(_:)","abstract":[{"type":"text","text":"Writes "},{"type":"codeVoice","code":"record"},{"type":"text","text":" to the log before returning, when its event type is one of "},{"type":"codeVoice","code":"events"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"it fits the bound."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","role":"symbol"},"doc://Persistence/documentation/Persistence/RecordStore":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"title":"RecordStore","url":"\/documentation\/persistence\/recordstore","identifier":"