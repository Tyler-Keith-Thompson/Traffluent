{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Errno","preciseIdentifier":"s:13SystemPackage5ErrnoV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(events:directory:byteBound:segmentByteCount:)","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","type":"topic","url":"\/documentation\/persistence\/segmentstore\/init(events:directory:bytebound:segmentbytecount:)","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A store keeping events of the types "},{"code":"events","type":"codeVoice"},{"type":"text","text":" in "},{"code":"directory","type":"codeVoice"},{"type":"text","text":"; it recovers the records"},{"type":"text","text":" "},{"type":"text","text":"already there."}]},"doc://Persistence/documentation/Persistence/SegmentStore":{"navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}],"kind":"symbol","type":"topic","url":"\/documentation\/persistence\/segmentstore","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","abstract":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true,"type":"reference"},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"role":"symbol","title":"SegmentStore"},"doc://Persistence/documentation/Persistence/DropReport/writeFailed(recordCount:timestamps:)":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"writeFailed"},{"kind":"text","text":"("},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"timestamps"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SN","text":"ClosedRange"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":">)"}],"kind":"symbol","title":"DropReport.writeFailed(recordCount:timestamps:)","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","abstract":[{"text":"Writing ","type":"text"},{"type":"codeVoice","code":"recordCount"},{"text":" records, tracked within ","type":"text"},{"type":"codeVoice","code":"timestamps"},{"text":", to disk failed (the disk is","type":"text"},{"text":" ","type":"text"},{"text":"full, say, or segments that couldn’t be deleted fill the bound), so they are kept in memory","type":"text"},{"text":" ","type":"text"},{"text":"only: delivered in this run if it lasts long","type":"text"},{"text":" ","type":"text"},{"text":"enough, lost if it ends first.","type":"text"}],"role":"symbol","url":"\/documentation\/persistence\/dropreport\/writefailed(recordcount:timestamps:)"},"doc://Persistence/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/Persistence\/s16SendableMetatypeP","type":"unresolvable"},"doc://Persistence/documentation/Persistence/SegmentStore/byteCount":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"byteCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"kind":"symbol","title":"byteCount","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","abstract":[{"text":"The bytes the log holds on disk: every segment’s header, records and delivery marks.","type":"text"}],"role":"symbol","url":"\/documentation\/persistence\/segmentstore\/bytecount"},"doc://Persistence/s8SendableP":{"identifier":"doc:\/\/Persistence\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"kind":"symbol","url":"\/documentation\/persistence\/segmentstore\/pendingrecordcount","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pendingRecordCount","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount","title":"pendingRecordCount","abstract":[{"text":"How many records the log keeps that are not yet delivered.","type":"text"}]},"doc://Persistence/documentation/Persistence/RecordStore":{"kind":"symbol","url":"\/documentation\/persistence\/recordstore","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","title":"RecordStore","abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"navigatorTitle":[{"text":"RecordStore","kind":"identifier"}]},"doc://Persistence/documentation/Persistence/SegmentStore/synchronize()":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"synchronize","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic","role":"symbol","title":"synchronize()","url":"\/documentation\/persistence\/segmentstore\/synchronize()","abstract":[{"type":"text","text":"Flushes every segment written since the last flush to storage ("},{"type":"codeVoice","code":"fsync"},{"type":"text","text":"), so it survives"},{"type":"text","text":" "},{"type":"text","text":"power loss."}],"kind":"symbol"},"doc://Persistence/documentation/Persistence/DropReport/versionMismatch(event:storedVersion:currentVersion:recordCount:)":{"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"versionMismatch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"event"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"storedVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"currentVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"role":"symbol","url":"\/documentation\/persistence\/dropreport\/versionmismatch(event:storedversion:currentversion:recordcount:)","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","kind":"symbol","abstract":[{"text":"Recovery read ","type":"text"},{"code":"recordCount","type":"codeVoice"},{"text":" intact records of the event named ","type":"text"},{"code":"event","type":"codeVoice"},{"text":" stored at","type":"text"},{"text":" ","type":"text"},{"code":"storedVersion","type":"codeVoice"},{"text":", while the store’s type of that name is at ","type":"text"},{"code":"currentVersion","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":"), and dropped them without decoding them: the version changed for a","type":"text"},{"text":" ","type":"text"},{"text":"change their bytes can’t be read through. Reported once per segment, or per database, for","type":"text"},{"text":" ","type":"text"},{"text":"each event and stored version, by the event’s name and then the stored version.","type":"text"}],"title":"DropReport.versionMismatch(event:storedVersion:currentVersion:recordCount:)"},"doc://Persistence/documentation/Persistence/DropReport/undecodable(recordCount:)":{"kind":"symbol","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","url":"\/documentation\/persistence\/dropreport\/undecodable(recordcount:)","abstract":[{"text":"Recovery read ","type":"text"},{"code":"recordCount","type":"codeVoice"},{"text":" intact records it couldn’t decode: their event type isn’t in","type":"text"},{"text":" ","type":"text"},{"text":"the store’s ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", or its ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","type":"reference","isActive":true},{"text":" threw, as it does for a record","type":"text"},{"text":" ","type":"text"},{"text":"written before a required property was added or a property’s type changed while the","type":"text"},{"text":" ","type":"text"},{"text":"event’s ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":" stayed the same.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"undecodable"},{"kind":"text","text":"("},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"role":"symbol","title":"DropReport.undecodable(recordCount:)"}}}