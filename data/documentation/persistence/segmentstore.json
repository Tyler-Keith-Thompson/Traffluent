ciseIdentifier":"s:Si"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","type":"topic","abstract":[{"text":"The bound a store has unless it is given another: 5 MiB (5,242,880 bytes).","type":"text"}],"url":"\/documentation\/persistence\/segmentstore\/defaultbytebound","role":"symbol"},"doc://Persistence/documentation/Persistence/DropReport/writeFailed(recordCount:timestamps:)":{"abstract":[{"type":"text","text":"Writing "},{"code":"recordCount","type":"codeVoice"},{"type":"text","text":" records, tracked within "},{"code":"timestamps","type":"codeVoice"},{"type":"text","text":", to disk failed (the disk is"},{"type":"text","text":" "},{"type":"text","text":"full, say, or segments that couldn’t be deleted fill the bound), so they are kept in memory"},{"type":"text","text":" "},{"type":"text","text":"only: delivered in this run if it lasts long"},{"type":"text","text":" "},{"type":"text","text":"enough, lost if it ends first."}],"url":"\/documentation\/persistence\/dropreport\/writefailed(recordcount:timestamps:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"writeFailed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"timestamps","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ClosedRange","preciseIdentifier":"s:SN","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"title":"DropReport.writeFailed(recordCount:timestamps:)","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","role":"symbol","kind":"symbol","type":"topic"},"doc://Persistence/documentation/Persistence/SegmentStore/init(events:directory:byteBound:segmentB