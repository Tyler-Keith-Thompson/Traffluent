e8FilePathV","text":"FilePath","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"byteBound","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"segmentByteCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11Persistence17SegmentStoreErrorO","text":"SegmentStoreError","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","role":"symbol","kind":"symbol","title":"init(events:directory:byteBound:segmentByteCount:)","type":"topic","url":"\/documentation\/persistence\/segmentstore\/init(events:directory:bytebound:segmentbytecount:)","abstract":[{"type":"text","text":"A store keeping events of the types "},{"type":"codeVoice","code":"events"},{"type":"text","text":" in "},{"type":"codeVoice","code":"directory"},{"type":"text","text":"; it recovers the records"},{"type":"text","text":" "},{"type":"text","text":"already there."}]},"doc://Persistence/documentation/Persistence/SegmentStore":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"title":"SegmentStore","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","type":"topic","abstract":[{"text":"A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore"},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"role":"symbol","kind":"symbol","url"