{"sections":[],"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(directory:byteBound:segmentByteCount:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"]},{"generated":true,"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"]}],"seeAlsoSections":[{"generated":true,"anchor":"Stores","title":"Stores","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"]}],"kind":"symbol","abstract":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"syntax":"swift","code":["let store = try SegmentStore()","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Write-through.","type":"text"}],"type":"strong"},{"text":" A tracker’s worker writes each record as it reaches it, before publishing","type":"text"},{"text":" ","type":"text"},{"text":"it, with one ","type":"text"},{"code":"write()","type":"codeVoice"},{"text":", off the tracking caller’s thread, so the record survives the app","type":"text"},{"text":" ","type":"text"},{"text":"crashing or being killed from then on. The store makes the log durable against","type":"text"},{"text":" ","type":"text"},{"text":"power loss too (","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":") once per batch, before the batch is delivered, and whenever","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","isActive":true,"type":"reference"},{"text":" is called: call it, after the tracker’s ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":", as the app moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background or terminates.","type":"text"},{"text":" ","type":"text"},{"text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","isActive":true,"type":"reference"},{"text":", and so is one whose event’s","type":"text"},{"text":" ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":" throws.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"What is kept."}],"type":"strong"},{"text":" Every event ","type":"text"},{"code":"DiscoveredEvent.all","type":"codeVoice"},{"text":" lists, the ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" structs of every","type":"text"},{"text":" ","type":"text"},{"text":"module the program links and the library’s own, or only the ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" types in ","type":"text"},{"code":"events","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Events of any other type are kept in memory only: they are delivered in this run like any","type":"text"},{"text":" ","type":"text"},{"text":"other, are never written, and are lost if the app ends first. The first record of each such","type":"text"},{"text":" ","type":"text"},{"text":"type is reported as ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","type":"reference","isActive":true},{"text":", so a type left out by mistake,","type":"text"},{"text":" ","type":"text"},{"text":"such as one that conforms to ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" by hand, shows up.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"A recovered record’s session."}],"type":"strong"},{"text":" A record keeps the ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":" of its context, written in","type":"text"},{"text":" ","type":"text"},{"text":"the record’s own bytes, so a record recovered after a relaunch carries the session it was","type":"text"},{"text":" ","type":"text"},{"text":"tracked in, and a vendor destination sends it under the same identity as the first time. A","type":"text"},{"text":" ","type":"text"},{"text":"record written without a session comes back with none. The rest of its context is not kept:","type":"text"},{"text":" ","type":"text"},{"text":"a recovered record is otherwise in the top-level ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":", as its span ended with","type":"text"},{"text":" ","type":"text"},{"text":"the earlier run.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Deleting."}],"type":"strong"},{"text":" A segment is deleted as a whole once every record in it is delivered, so a","type":"text"},{"text":" ","type":"text"},{"text":"log whose records are all delivered holds no files. A record’s session goes with its","type":"text"},{"text":" ","type":"text"},{"text":"segment: the store keeps no session apart from the records tracked in it. A segment kept","type":"text"},{"text":" ","type":"text"},{"text":"for one undelivered record keeps its delivered ones too, sessions and all. Only recovery","type":"text"},{"text":" ","type":"text"},{"text":"rewrites a segment: one still holding","type":"text"},{"text":" ","type":"text"},{"text":"records after it drops some (","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","isActive":true,"type":"reference"},{"text":") is","type":"text"},{"text":" ","type":"text"},{"text":"rewritten without them, so each drop is reported once. Should the rewrite fail, the","type":"text"},{"text":" ","type":"text"},{"text":"segment is kept as it was and the next launch reports those drops again.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Reading back.","type":"text"}],"type":"strong"},{"type":"text","text":" When a destination’s full buffer drops a batch on its way through a"},{"type":"text","text":" "},{"type":"text","text":"delivery, the delivery reads that batch’s records back from the log once the destination"},{"type":"text","text":" "},{"type":"text","text":"has caught up, reading each segment they are in once, and hands them to it in this run,"},{"type":"text","text":" "},{"type":"text","text":"each in the context it was tracked in, which the delivery keeps. A record the bound dropped"},{"type":"text","text":" "},{"type":"text","text":"before the read finished isn’t read back, and one that can’t be read or decoded is logged"},{"type":"text","text":" "},{"type":"text","text":"and waits for a later launch."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Bound.","type":"text"}]},{"type":"text","text":" The log never holds more than "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":" bytes. When a record wouldn’t fit, the"},{"type":"text","text":" "},{"type":"text","text":"oldest segments are deleted until it does, and each one deleted with records not yet"},{"type":"text","text":" "},{"type":"text","text":"delivered yields a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport"},{"type":"text","text":" on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports"},{"type":"text","text":". A record too large for an empty log"},{"type":"text","text":" "},{"type":"text","text":"is kept in memory only."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Recovery."}]},{"type":"text","text":" A store opened on a directory recovers the records earlier runs left there"},{"type":"text","text":" "},{"type":"text","text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or"},{"type":"text","text":" "},{"type":"text","text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported."},{"type":"text","text":" "},{"type":"text","text":"A segment comes back whole, delivered records and all. Each record a delivery had started on"},{"type":"text","text":" "},{"type":"text","text":"comes back with "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set, as it may have reached a destination already: one"},{"type":"text","text":" "},{"type":"text","text":"delivered before the app ended, or one delivered just as it ended, before the store could"},{"type":"text","text":" "},{"type":"text","text":"delete its segment. A record whose delivery mark can’t be written is held back from that"},{"type":"text","text":" "},{"type":"text","text":"delivery, so it is never sent twice unannounced, and delivered on a later launch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Other versions."}],"type":"strong"},{"text":" A segment a newer release of the app wrote, in a later version of the","type":"text"},{"text":" ","type":"text"},{"text":"format, is left on disk untouched after a rollback, for that release to deliver: this one","type":"text"},{"text":" ","type":"text"},{"text":"neither reads it nor counts it toward the bound. A segment in an earlier version, which this","type":"text"},{"text":" ","type":"text"},{"text":"one can’t read, is deleted and reported as a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Changed event types."}]},{"text":" Each record’s event is a map of its properties by name, so a record","type":"text"},{"text":" ","type":"text"},{"text":"written before its type changed still reads: a property removed since is skipped, an","type":"text"},{"text":" ","type":"text"},{"text":"optional one added since is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and one with a default value added since has it. A record","type":"text"},{"text":" ","type":"text"},{"text":"stored at another ","type":"text"},{"type":"codeVoice","code":"Event.schemaVersion"},{"text":" than its type’s now is dropped without being read and","type":"text"},{"text":" ","type":"text"},{"text":"reported as ","type":"text"},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"One at the same version that can’t be read all the same, after a required property was added","type":"text"},{"text":" ","type":"text"},{"text":"or a property’s type changed without raising the version, is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a"},{"type":"text","text":" "},{"type":"text","text":"store share its log."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","interfaceLanguage":"swift"},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"remoteSource":{"fileName":"SegmentStore.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L78"},"externalID":"s:11Persistence12SegmentStoreV","modules":[{"name":"Persistence"}],"title":"SegmentStore","symbolKind":"struct","role":"symbol","navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"roleHeading":"Structure"},"variants":[{"paths":["\/documentation\/persistence\/segmentstore"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Persistence/documentation/Persistence/SegmentStore":{"title":"SegmentStore","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"type":"topic","url":"\/documentation\/persistence\/segmentstore"},"doc://Persistence/documentation/Persistence/SegmentStore/append(_:)":{"title":"append(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"append"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Writes "},{"type":"codeVoice","code":"record"},{"type":"text","text":" to the log before returning, when its event type is one of "},{"type":"codeVoice","code":"events"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"it fits the bound."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","type":"topic","url":"\/documentation\/persistence\/segmentstore\/append(_:)"},"doc://Persistence/documentation/Persistence/SegmentStore/byteCount":{"url":"\/documentation\/persistence\/segmentstore\/bytecount","title":"byteCount","kind":"symbol","abstract":[{"type":"text","text":"The bytes the log holds on disk: every segment’s header, records and delivery marks."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"byteCount"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/takeRecoveredRecords()":{"title":"takeRecoveredRecords()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"takeRecoveredRecords"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]"}],"kind":"symbol","role":"symbol","abstract":[{"text":"The records of the segments earlier runs left, oldest first, with ","type":"text"},{"type":"codeVoice","code":"isRedelivered"},{"text":" set on","type":"text"},{"text":" ","type":"text"},{"text":"each one a delivery had started on; later calls return none.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()","type":"topic","url":"\/documentation\/persistence\/segmentstore\/takerecoveredrecords()"},"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"title":"pendingRecordCount","fragmen