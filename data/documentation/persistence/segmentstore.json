codeVoice","code":"events"},{"type":"text","text":": its records are delivered in this run, but never written, so they are"},{"type":"text","text":" "},{"type":"text","text":"lost if the app ends first. Reported once per type, on its first record, for as long as the"},{"type":"text","text":" "},{"type":"text","text":"store lives; a type left out by mistake is added to "},{"type":"codeVoice","code":"events"},{"type":"text","text":"."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notPersisted","kind":"identifier"},{"text":"(","kind":"text"},{"text":"event","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}]},"doc://Persistence/documentation/Persistence/SegmentStore/defaultDirectory":{"title":"defaultDirectory","abstract":[{"type":"text","text":"Where a store keeps its segments unless it is given a directory."}],"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultDirectory","kind":"identifier"},{"text":": ","kind":"text"},{"text":"FilePath","kind":"typeIdentifier","preciseIdentifier":"s:13SystemPackage8FilePathV"}],"kind":"symbol","type":"topic","url":"\/documentation\/persistence\/segmentstore\/defaultdirectory","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"},"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"abstract":[{"text":"How many records the log keeps that are not yet delivered.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount","kind":"symbol","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/pendingrecordcount","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pendingRecordCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"pendingRecordCount"},"doc://Persistence/documentation/Persistence/SegmentStore/init(events:directory:byteBound:segmentByteCount:)":{"url":"\/documentation\/persistence\/segmentstore\/init(events:directory:bytebound:segmentbytecount:)","title":"init(events:directory:byteBound:segmentByteCount:)","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","abstract":[{"type":"text","text":"A store keeping events of the types "},{"type":"codeVoice","code":"events"},{"type":"text","text":" in "},{"type":"codeVoice","code":"directory"},{"type":"text","text":"; it recovers the records"},{"type":"text","text":" "},{"type":"text","text":"already there."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"events"},{"kind":"text","text":": [any ("},{"kind":"typeIdentifier","text":"Event","preciseIdentifier":"s:6Events5EventP"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","text":"BinaryCodable","preciseIdentifier":"s:11Persistence13BinaryCodableP"},{"kind":"text","text":").Type], "},{"kind":"externalParam","text":"directory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"FilePath","preciseIdentifier":"s:13SystemPackage8FilePathV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"byteBound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"segmentByteCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},