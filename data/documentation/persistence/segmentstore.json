)","role":"symbol","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"undecodable","kind":"identifier"},{"text":"(","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/persistence\/dropreport\/undecodable(recordcount:)","type":"topic","abstract":[{"text":"Recovery read ","type":"text"},{"code":"recordCount","type":"codeVoice"},{"text":" intact records it couldn’t decode: their event type isn’t in","type":"text"},{"text":" ","type":"text"},{"text":"the store’s ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", or its ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","isActive":true,"type":"reference"},{"text":" threw, as it does for a record","type":"text"},{"text":" ","type":"text"},{"text":"written before a required property was added or a property’s type changed while the","type":"text"},{"text":" ","type":"text"},{"text":"event’s ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":" stayed the same.","type":"text"}]},"doc://Persistence/documentation/Persistence/DropReport/versionMismatch(event:storedVersion:currentVersion:recordCount:)":{"url":"\/documentation\/persistence\/dropreport\/versionmismatch(event:storedversion:currentversion:recordcount:)","title":"DropReport.versionMismatch(event:storedVersion:currentVersion:recordCount:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"versionMismatch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"event"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"storedVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"currentVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"type":"topic","abstract":[{"type":"text","text":"Recovery read "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" intact records of the event named "},{"type":"codeVoice","code":"event"},{"type":"text","text":" stored at"},{"type":"text","text":" "},{"type":"codeVoice","code":"storedVersion"},{"type":"text","text":", while the store’s type of that name is at "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":"), and dropped them without decoding them: the version changed for a"},{"type":"text","text":" "},{"type":"text","text":"change their bytes can’t be read through. Reported once per segment, or per database, for"},{"type":"text","text":" "},{"type":"text","text":"each event and stored version, by the event’s name and then the stored version."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)"},"doc://Persistence/documentation/Persistence/SegmentStore/directory":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","url":"\/documentation\/persistence\/segmentstore\/directory","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Where the store keeps its segments."}],"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"directory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SystemPackage8Fi