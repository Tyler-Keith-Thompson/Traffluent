 say, or segments that couldn’t be deleted fill the bound), so they are kept in memory"},{"type":"text","text":" "},{"type":"text","text":"only: delivered in this run if it lasts long"},{"type":"text","text":" "},{"type":"text","text":"enough, lost if it ends first."}],"url":"\/documentation\/persistence\/dropreport\/writefailed(recordcount:timestamps:)","role":"symbol","type":"topic"},"doc://Persistence/documentation/Persistence/SegmentStore/defaultDirectory":{"abstract":[{"text":"Where a store keeps its segments unless it is given a directory.","type":"text"}],"url":"\/documentation\/persistence\/segmentstore\/defaultdirectory","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultDirectory","kind":"identifier"},{"text":": ","kind":"text"},{"text":"FilePath","kind":"typeIdentifier","preciseIdentifier":"s:13SystemPackage8FilePathV"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory","title":"defaultDirectory"},"doc://Persistence/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Persistence\/s8SendableP","title":"Swift.Sendable"},"doc://Persistence/s16SendableMetatypeP":{"identifier":"doc:\/\/Persistence\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://Persistence/documentation/Persistence/SegmentStore/byteCount":{"type":"topic","kind":"symbol","abstract":[{"text":"The bytes the log holds on disk: every segment’s header, records and delivery marks.","type":"text"}],"title":"byteCount","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/bytecount","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byteCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentSto