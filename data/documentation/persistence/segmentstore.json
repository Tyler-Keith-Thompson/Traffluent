","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"takeRecoveredRecords","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()","title":"takeRecoveredRecords()"},"doc://Persistence/documentation/Persistence/SegmentStore/defaultByteBound":{"url":"\/documentation\/persistence\/segmentstore\/defaultbytebound","abstract":[{"type":"text","text":"The bound a store has unless it is given another: 5 MiB (5,242,880 bytes)."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","title":"defaultByteBound","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultByteBound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]},"doc://Persistence/documentation/Persistence/SegmentStore":{"navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"type":"topic","url":"\/documentation\/persistence\/segmentstore","abstract":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore"},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","title":"SegmentStore","role":"symbol"},"doc://Persistence/documentation/Persistence/BinaryCodable":{"navigatorTitle":[{"text":"BinaryCodable","kind":"identifier"}],"role":"symbol","url":"\/documentation\/persistence\/binarycodable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryCodable","kind":"identifier"}],"kind":"symbol","title":"BinaryCodable","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","type":"topic","abstract":[{"text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk.","type":"text"}]},"doc://Persistence/documentation/Persistence/SegmentStore/append(_:)":{"type":"topic","kind":"symbol","abstract":[{"text":"Writes ","type":"text"},{"code":"record","type":"codeVoice"},{"text":" to the log before returning, when its event type is one of ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"it fits the bound.","type":"text"}],"title":"append(_:)","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/append(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"append","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)"},"doc://Persistence/documentation/Persistence/DropReport/undecodable(recordCount:)":{"url":"\/documentation\/persistence\/dropreport\/undecodable(recordcount:)","abstract":[{"type":"text","text":"Recovery read "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" intact records it couldn’t decode: their event type isn’t in"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"events"},{"type":"text","text":", or its "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","isActive":true},{"type":"text","text":" threw, as it does for a record"},{"type":"text","text":" "},{"type":"text","text":"written before a required property was added or a property’s type changed while the"},{"type":"text","text":" "},{"type":"text","text":"event’s "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":" stayed the same."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","title":"DropReport.undecodable(recordCount:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"undecodable"},{"kind":"text","text":"("},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}]},"doc://Persistence/documentation/Persistence/BinaryCodable/init(from:)":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Reads a value "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/encode(to:)"},{"type":"text","text":" wrote from "},{"code":"decoder","type":"codeVoice"},{"type":"text","text":"."}],"title":"init(from:)","required":true,"role":"symbol","url":"\/documentation\/persistence\/binarycodable\/init(from:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryDecoder","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence13BinaryDecoderV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"BinaryDecodingError","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence19BinaryDecodingErrorO"},{"text":")","kind":"text"}],"defaultImplementations":1,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)"},"doc://Persistence/documentation/Persistence/RecordStore":{"url":"\/documentation\/persistence\/recordstore","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","role":"symbol","title":"RecordStore","kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"abstract":[{"text":"Where a tracker keeps each record until it is delivered, so records survive the app ending.","type":"text"}],"navigatorTitle":[{"text":"RecordStore","kind":"identifier"}]},"doc://Persistence/documentation/Persistence/DropReport":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","title":"DropReport","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DropReport"}],"navigatorTitle":[{"kind":"identifier","text":"DropReport"}],"role":"symbol","type":"topic","url":"\/documentation\/persistence\/dropreport","abstract":[{"text":"Records a store dropped before they were delivered, and why.","type":"text"}]},"doc://Persistence/documentation/Persistence/DropReport/versionMismatch(event:storedVersion:currentVersion:recordCount:)":{"url":"\/documentation\/persistence\/dropreport\/versionmismatch(event:storedversion:currentversion:recordcount:)","abstract":[{"type":"text","text":"Recovery read "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" intact records of the event named "},{"type":"codeVoice","code":"event"},{"type":"text","text":" stored at"},{"type":"text","text":" "},{"type":"codeVoice","code":"storedVersion"},{"type":"text","text":", while the store’s type of that name is at "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":"), and dropped them without decoding them: the version changed for a"},{"type":"text","text":" "},{"type":"text","text":"change their bytes can’t be read through. Reported once per segment, or per database, for"},{"type":"text","text":" "},{"type":"text","text":"each event and stored version, by the event’s name and then the stored version."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","title":"DropReport.versionMismatch(event:storedVersion:currentVersion:recordCount:)","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"versionMismatch","kind":"identifier"},{"text":"(","kind":"text"},{"text":"event","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"storedVersion","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"currentVersion","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://Persistence/documentation/Persistence/SegmentStore/dropReports":{"type":"topic","kind":"symbol","abstract":[{"text":"A report of each drop, in the order they happen, from recovery onwards.","type":"text"}],"title":"dropReports","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/dropreports","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind"