{"abstract":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true,"type":"reference"},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"],"type":"conformsTo"}],"kind":"symbol","seeAlsoSections":[{"title":"Stores","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"],"anchor":"Stores","generated":true}],"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","interfaceLanguage":"swift"},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(directory:byteBound:segmentByteCount:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"],"anchor":"Instance-Properties","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"],"anchor":"Instance-Methods","generated":true},{"title":"Type Properties","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"],"anchor":"Type-Properties","generated":true}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"metadata":{"roleHeading":"Structure","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L78","fileName":"SegmentStore.swift"},"externalID":"s:11Persistence12SegmentStoreV","title":"SegmentStore","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}],"modules":[{"name":"Persistence"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"syntax":"swift","type":"codeListing","code":["let store = try SegmentStore()","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Write-through."}],"type":"strong"},{"text":" A tracker’s worker writes each record as it reaches it, before publishing","type":"text"},{"text":" ","type":"text"},{"text":"it, with one ","type":"text"},{"type":"codeVoice","code":"write()"},{"text":", off the tracking caller’s thread, so the record survives the app","type":"text"},{"text":" ","type":"text"},{"text":"crashing or being killed from then on. The store makes the log durable against","type":"text"},{"text":" ","type":"text"},{"text":"power loss too (","type":"text"},{"type":"codeVoice","code":"fsync"},{"text":") once per batch, before the batch is delivered, and whenever","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","isActive":true,"type":"reference"},{"text":" is called: call it, after the tracker’s ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":", as the app moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background or terminates.","type":"text"},{"text":" ","type":"text"},{"text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)","isActive":true,"type":"reference"},{"text":", and so is one whose event’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"encode(to:)"},{"text":" throws.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"What is kept.","type":"text"}],"type":"strong"},{"text":" Every event ","type":"text"},{"type":"codeVoice","code":"DiscoveredEvent.all"},{"text":" lists, the ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" structs of every","type":"text"},{"text":" ","type":"text"},{"text":"module the program links and the library’s own, or only the ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" types in ","type":"text"},{"type":"codeVoice","code":"events"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Events of any other type are kept in memory only: they are delivered in this run like any","type":"text"},{"text":" ","type":"text"},{"text":"other, are never written, and are lost if the app ends first. The first record of each such","type":"text"},{"text":" ","type":"text"},{"text":"type is reported as ","type":"text"},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","isActive":true},{"text":", so a type left out by mistake,","type":"text"},{"text":" ","type":"text"},{"text":"such as one that conforms to ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":" by hand, shows up.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"A recovered record’s session."}],"type":"strong"},{"text":" A record keeps the ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":" of its context, written in","type":"text"},{"text":" ","type":"text"},{"text":"the record’s own bytes, so a record recovered after a relaunch carries the session it was","type":"text"},{"text":" ","type":"text"},{"text":"tracked in, and a vendor destination sends it under the same identity as the first time. A","type":"text"},{"text":" ","type":"text"},{"text":"record written without a session comes back with none. The rest of its context is not kept:","type":"text"},{"text":" ","type":"text"},{"text":"a recovered record is otherwise in the top-level ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":", as its span ended with","type":"text"},{"text":" ","type":"text"},{"text":"the earlier run.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deleting."}]},{"type":"text","text":" A segment is deleted as a whole once every record in it is delivered, so a"},{"type":"text","text":" "},{"type":"text","text":"log whose records are all delivered holds no files. A record’s session goes with its"},{"type":"text","text":" "},{"type":"text","text":"segment: the store keeps no session apart from the records tracked in it. A segment kept"},{"type":"text","text":" "},{"type":"text","text":"for one undelivered record keeps its delivered ones too, sessions and all. Only recovery"},{"type":"text","text":" "},{"type":"text","text":"rewrites a segment: one still holding"},{"type":"text","text":" "},{"type":"text","text":"records after it drops some ("},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","isActive":true},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"rewritten without them, so each drop is reported once. Should the rewrite fail, the"},{"type":"text","text":" "},{"type":"text","text":"segment is kept as it was and the next launch reports those drops again."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reading back."}],"type":"strong"},{"text":" When a destination’s full buffer drops a batch on its way through a","type":"text"},{"text":" ","type":"text"},{"text":"delivery, the delivery reads that batch’s records back from the log once the destination","type":"text"},{"text":" ","type":"text"},{"text":"has caught up, reading each segment they are in once, and hands them to it in this run,","type":"text"},{"text":" ","type":"text"},{"text":"each in the context it was tracked in, which the delivery keeps. A record the bound dropped","type":"text"},{"text":" ","type":"text"},{"text":"before the read finished isn’t read back, and one that can’t be read or decoded is logged","type":"text"},{"text":" ","type":"text"},{"text":"and waits for a later launch.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Bound.","type":"text"}]},{"type":"text","text":" The log never holds more than "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":" bytes. When a record wouldn’t fit, the"},{"type":"text","text":" "},{"type":"text","text":"oldest segments are deleted until it does, and each one deleted with records not yet"},{"type":"text","text":" "},{"type":"text","text":"delivered yields a "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","type":"reference","isActive":true},{"type":"text","text":" on "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","type":"reference","isActive":true},{"type":"text","text":". A record too large for an empty log"},{"type":"text","text":" "},{"type":"text","text":"is kept in memory only."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Recovery.","type":"text"}],"type":"strong"},{"type":"text","text":" A store opened on a directory recovers the records earlier runs left there"},{"type":"text","text":" "},{"type":"text","text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or"},{"type":"text","text":" "},{"type":"text","text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported."},{"type":"text","text":" "},{"type":"text","text":"A segment comes back whole, delivered records and all. Each record a delivery had started on"},{"type":"text","text":" "},{"type":"text","text":"comes back with "},{"code":"isRedelivered","type":"codeVoice"},{"type":"text","text":" set, as it may have reached a destination already: one"},{"type":"text","text":" "},{"type":"text","text":"delivered before the app ended, or one delivered just as it ended, before the store could"},{"type":"text","text":" "},{"type":"text","text":"delete its segment. A record whose delivery mark can’t be written is held back from that"},{"type":"text","text":" "},{"type":"text","text":"delivery, so it is never sent twice unannounced, and delivered on a later launch."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Other versions.","type":"text"}]},{"type":"text","text":" A segment a newer release of the app wrote, in a later version of the"},{"type":"text","text":" "},{"type":"text","text":"format, is left on disk untouched after a rollback, for that release to deliver: this one"},{"type":"text","text":" "},{"type":"text","text":"neither reads it nor counts it toward the bound. A segment in an earlier version, which this"},{"type":"text","text":" "},{"type":"text","text":"one can’t read, is deleted and reported as a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Changed event types."}],"type":"strong"},{"type":"text","text":" Each record’s event is a map of its properties by name, so a record"},{"type":"text","text":" "},{"type":"text","text":"written before its type changed still reads: a property removed since is skipped, an"},{"type":"text","text":" "},{"type":"text","text":"optional one added since is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and one with a default value added since has it. A record"},{"type":"text","text":" "},{"type":"text","text":"stored at another "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":" than its type’s now is dropped without being read and"},{"type":"text","text":" "},{"type":"text","text":"reported as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"One at the same version that can’t be read all the same, after a required property was added"},{"type":"text","text":" "},{"type":"text","text":"or a property’s type changed without raising the version, is dropped and reported as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a","type":"text"},{"text":" ","type":"text"},{"text":"store share its log.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistence\/segmentstore"]}],"references":{"doc://Persistence/documentation/Persistence":{"kind":"symbol","role":"collection","identifier":"doc:\/\/Persistence\/documentation\/Persistence","title":"Persistence","type":"topic","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"url":"\/documentation\/persistence"},"doc://Persistence/documentation/Persistence/DropReport/corruption(byteCount:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"corruption","kind":"identifier"},{"text":"(","kind":"text"},{"text":"byteCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/persistence\/dropreport\/corruption(bytecount:)","title":"DropReport.corruption(byteCount:)","abstract":[{"type":"text","text":"Recovery found a torn or corrupt record, or a segment header it couldn’t read, and"},{"type":"text","text":" "},{"type":"text","text":"discarded the "},{"type":"codeVoice","code":"byteCount"},{"type":"text","text":" bytes from there to the end of the segment."}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)"},"doc://Persistence/documentation/Persistence/SegmentStore/directory":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"directory","kind":"identifier"},{"text":": ","kind":"text"},{"text":"FilePath","kind":"typeIdentifier","preciseIdentifier":"s:13SystemPackage8FilePathV"}],"url":"\/documentation\/persistence\/segmentstore\/directory","title":"directory","abstract":[{"type":"text","text":"Where the store keeps its segments."}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory"},"doc://Persistence/documentation/Persistence/DropReport/writeFailed(recordCount:timestamps:)":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"writeFailed"},{"kind":"text","text":"("},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"timestamps"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ClosedRange","preciseIdentifier":"s:SN"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":">)"}],"url":"\/documentation\/persistence\/dropreport\/writefailed(recordcount:timestamps:)","title":"DropReport.writeFailed(recordCount:timestamps:)","abstract":[{"type":"text","text":"Writing "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" records, tracked within "},{"type":"codeVoice","code":"timestamps"},{"type":"text","text":", to disk failed (the disk is"},{"type":"text","text":" "},{"type":"text","text":"full, say, or segments that couldn’t be deleted fill the bound), so they are kept in memory"},{"type":"text","text":" "},{"type":"text","text":"only: delivered in this run if it lasts long"},{"type":"text","text":" "},{"type":"text","text":"enough, lost if it ends first."}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)"},"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"abstract":[{"text":"How many records the log keeps that are not yet delivered.","type":"text"}],"title":"pendingRecordCount","type":"topic","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount","url":"\/documentation\/persistence\/segmentstore\/pendingrecordcount","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pendingRecordCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"kind":"symbol"},"doc://Persistence/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/Persistence\/s16SendableMetatypeP","type":"unresolvable"},"doc://Persistence/documentation/Persistence/SegmentStoreError":{"abstract":[{"type":"text","text":"The error "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","isActive":true},{"type":"text","text":" throws: an"},{"type":"text","text":" "},{"type":"text","text":"argument it can’t open a store with, or the file system’s failure."}],"role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStoreError"}],"title":"SegmentStoreError","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SegmentStoreError"}],"kind":"symbol","url":"\/documentation\/persistence\/segmentstoreerror"},"doc://Persistence/documentation/Persistence/SegmentStore/init(events:directory:byteBound:segmentByteCount:)":{"type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"events"},{"kind":"text","text":": [any ("},{"kind":"typeIdentifier","text":"Event","preciseIdentifier":"s:6Events5EventP"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","text":"Codable","preciseIdentifier":"s:s7Codablea"},{"kind":"text","text":").Type], "},{"kind":"externalParam","text":"directory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"FilePath","preciseIdentifier":"s:13SystemPackage8FilePathV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"byteBound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"segmentByteCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"SegmentStoreError","preciseIdentifier":"s:11Persistence17SegmentStoreErrorO"},{"kind":"text","text":")"}],"abstract":[{"text":"A store keeping events of the types ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"directory","type":"codeVoice"},{"text":"; it recovers the records","type":"text"},{"text":" ","type":"text"},{"text":"already there.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","url":"\/documentation\/persistence\/segmentstore\/init(events:directory:bytebound:segmentbytecount:)","role":"symbol","kind":"symbol","title":"init(events:directory:byteBound:segmentByteCount:)"},"doc://Persistence/documentation/Persistence/DropReport/versionMismatch(event:storedVersion:currentVersion:recordCount:)":{"abstract":[{"type":"text","text":"Recovery read "},{"type":"codeVoice","code":"recordCount"},{"type":"text","text":" intact records of the event named "},{"type":"codeVoice","code":"event"},{"type":"text","text":" stored at"},{"type":"text","text":" "},{"type":"codeVoice","code":"storedVersion"},{"type":"text","text":", while the store’s type of that name is at "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":"), and dropped them without decoding them: the version changed for a"},{"type":"text","text":" "},{"type":"text","text":"change their bytes can’t be read through. Reported once per segment, or per database, for"},{"type":"text","text":" "},{"type":"text","text":"each event and stored version, by the event’s name and then the stored version."}],"title":"DropReport.versionMismatch(event:storedVersion:currentVersion:recordCount:)","type":"topic","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","url":"\/documentation\/persistence\/dropreport\/versionmismatch(event:storedversion:currentversion:recordcount:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"versionMismatch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"event"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"storedVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"currentVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"recordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"kind":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/byteCount":{"abstract":[{"type":"text","text":"The bytes the log holds on disk: every segment’s header, records and delivery marks."}],"title":"byteCount","type":"topic","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/bytecount","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byteCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol"},"doc://Persistence/documentation/Persistence/RecordStore":{"abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"url":"\/documentation\/persistence\/recordstore","kind":"symbol","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"title":"RecordStore","type":"topic","navigatorTitle":[{"text":"RecordStore","kind":"identifier"}]},"doc://Persistence/documentation/Persistence/SegmentStore":{"navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"url":"\/documentation\/persistence\/segmentstore","title":"SegmentStore","abstract":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true,"type":"reference"},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"},"doc://Persistence/documentation/Persistence/DropReport/notPersisted(event:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notPersisted","kind":"identifier"},{"text":"(","kind":"text"},{"text":"event","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/persistence\/dropreport\/notpersisted(event:)","title":"DropReport.notPersisted(event:)","abstract":[{"type":"text","text":"A record of the event named "},{"type":"codeVoice","code":"event"},{"type":"text","text":" was kept in memory only because its type isn’t one of"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"events"},{"type":"text","text":": its records are delivered in this run, but never written, so they are"},{"type":"text","text":" "},{"type":"text","text":"lost if the app ends first. Reported once per type, on its first record, for as long as the"},{"type":"text","text":" "},{"type":"text","text":"store lives; a type left out by mistake is added to "},{"type":"codeVoice","code":"events"},{"type":"text","text":"."}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)"},"doc://Persistence/documentation/Persistence/SegmentStore/takeRecoveredRecords()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"takeRecoveredRecords","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/persistence\/segmentstore\/takerecoveredrecords()","title":"takeRecoveredRecords()","abstract":[{"text":"The records of the segments earlier runs left, oldest first, with ","type":"text"},{"code":"isRedelivered","type":"codeVoice"},{"text":" set on","type":"text"},{"text":" ","type":"text"},{"text":"each one a delivery had started on; later calls return none.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/Segmen