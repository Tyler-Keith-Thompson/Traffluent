xt"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]","kind":"text"}],"url":"\/documentation\/persistence\/segmentstore\/takerecoveredrecords()","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()","kind":"symbol","abstract":[{"text":"The records of the segments earlier runs left, oldest first, with ","type":"text"},{"code":"isRedelivered","type":"codeVoice"},{"text":" set on","type":"text"},{"text":" ","type":"text"},{"text":"each one a delivery had started on; later calls return none.","type":"text"}]},"doc://Persistence/documentation/Persistence/DropReport":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DropReport","kind":"identifier"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","role":"symbol","url":"\/documentation\/persistence\/dropreport","abstract":[{"type":"text","text":"Records a store dropped before they were delivered, and why."}],"kind":"symbol","navigatorTitle":[{"text":"DropReport","kind":"identifier"}],"type":"topic","title":"DropReport"},"doc://Persistence/documentation/Persistence/SegmentStore/synchronize()":{"kind":"symbol","title":"synchronize()","abstract":[{"type":"text","text":"Flushes every segment written since the last flush to storage ("},{"code":"fsync","type":"codeVoice"},{"type":"text","text":"), so it survives"},{"type":"text","text":" "},{"type":"text","text":"power loss."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"synchronize"},{"kind":"text","text":"()"}],"url":"\/documentation\/persistence\/segmentstore\/synchronize()","type":"topic","role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/directory":{"role":"symbol","url":"\/documentation\/persistence\/segmentstore\/directory","title":"director