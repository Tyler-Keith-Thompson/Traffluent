,"text":"Reads a value "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/encode(to:)"},{"type":"text","text":" wrote from "},{"type":"codeVoice","code":"decoder"},{"type":"text","text":"."}],"defaultImplementations":1,"required":true,"kind":"symbol","url":"\/documentation\/persistence\/binarycodable\/init(from:)"},"doc://Persistence/documentation/Persistence/DropReport/undecodable(recordCount:)":{"abstract":[{"text":"Recovery read ","type":"text"},{"type":"codeVoice","code":"recordCount"},{"text":" intact records it couldn’t decode: their event type isn’t in","type":"text"},{"text":" ","type":"text"},{"text":"the store’s ","type":"text"},{"type":"codeVoice","code":"events"},{"text":", or its ","type":"text"},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","isActive":true},{"text":" threw, as it does for a record","type":"text"},{"text":" ","type":"text"},{"text":"written before a required property was added or a property’s type changed while the","type":"text"},{"text":" ","type":"text"},{"text":"event’s ","type":"text"},{"type":"codeVoice","code":"Event.schemaVersion"},{"text":" stayed the same.","type":"text"}],"title":"DropReport.undecodable(recordCount:)","role":"symbol","url":"\/documentation\/persistence\/dropreport\/undecodable(recordcount:)","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"undecodable","kind":"identifier"},{"text":"(","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)"},"doc://Persistence/documentation/Persistence/DropReport/writeFailed(recordCount:timestamps:)":{"type":"topic","role":"symbol","fragments":[{"text":"case","