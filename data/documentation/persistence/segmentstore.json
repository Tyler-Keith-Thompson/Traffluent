re/dropReports":{"type":"topic","url":"\/documentation\/persistence\/segmentstore\/dropreports","kind":"symbol","title":"dropReports","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","abstract":[{"text":"A report of each drop, in the order they happen, from recovery onwards.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"DropReport","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence10DropReportO"},{"text":">","kind":"text"}]},"doc://Persistence/documentation/Persistence/DropReport/corruption(byteCount:)":{"role":"symbol","url":"\/documentation\/persistence\/dropreport\/corruption(bytecount:)","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"corruption","kind":"identifier"},{"text":"(","kind":"text"},{"text":"byteCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"title":"DropReport.corruption(byteCount:)","abstract":[{"type":"text","text":"Recovery found a torn or corrupt record, or a segment header it couldn’t read, and"},{"type":"text","text":" "},{"type":"text","text":"discarded the "},{"type":"codeVoice","code":"byteCount"},{"type":"text","text":" bytes from there to the end of the segment."}],"type":"topic","kind":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/defaultDirectory":{"type":"topic","url":"\/documentation\/persistence\/segmentstore\/defaultdirectory","kind":"symbol","title":"defaultDirectory","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirect