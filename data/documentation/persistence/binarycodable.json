","        var map = try decoder.decodeMap()","        plan = try map.decode(forKey: \"plan\")","        seats = try map.decode(forKey: \"seats\")","        coupon = try map.decode(forKey: \"coupon\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"@Event"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"EventMacros"},{"type":"text","text":") writes this conformance for you."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because each property is found by its name, an event type can change while records written"},{"type":"text","text":" "},{"type":"text","text":"before the change are still on disk. A property removed since leaves an entry the decoder"},{"type":"text","text":" "},{"type":"text","text":"skips, an optional property added since reads as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", one with a default value reads it"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/KeyedBinaryDecoder\/decode(_:forKey:default:)","isActive":true},{"type":"text","text":", and properties can be reordered. A"},{"type":"text","text":" "},{"type":"text","text":"change the older bytes can’t satisfy, such as a required property added or a property’s type"},{"type":"text","text":" "},{"type":"text","text":"changed, needs a new "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":": the store drops records stored at another version"},{"type":"text","text":" "},{"type":"text","text":"without reading them, and reports them. One that throws from "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","isActive":true},{"type":"text","text":" all the same is"},{"type":"text","text":" "},{"type":"text","text":"dropped and reported too."}],"type":"paragraph"},{"inlineContent":[{"text":"Each value is one CBOR data item, so any CBOR decoder can read the bytes. Integers are CBOR","type":"text"},{"text":" ","type":"text"},{"text":"integers in the fewest bytes that hold them, ","type":"text"},{"type":"codeVoice","code":"Bool"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Float"},{"text":" ","type":"text"},{"text":"are double- and single-precision floats, ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" a text string, ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":" an array, ","type":"text"},{"type":"codeVoice","code":"Optional"},{"text":" ","type":"text"},{"type":"codeVoice","code":"null"},{"text":" or the value (in a one-element array when the value’s own bytes start with ","type":"text"},{"type":"codeVoice","code":"null"},{"text":", as","type":"text"},{"text":" ","type":"text"},{"text":"a nested optional’s ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" does, or with that array’s head), ","type":"text"},{"type":"codeVoice","code":"Date"},{"text":" ","type":"text"},{"text":"a double of its seconds since 2001-01-01 UTC, and ","type":"text"},{"type":"codeVoice","code":"UUID"},{"text":" a 16-byte byte string tagged 37. An","type":"text"},{"text":" ","type":"text"},{"text":"encoder of your own writes a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value as ","type":"text"},{"type":"codeVoice","code":"undefined"},{"text":".","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Persistence/documentation/Persistence/Swift/Int":{"abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Int","kind":"iden