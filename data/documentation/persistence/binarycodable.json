{"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)"],"anchor":"Initializers"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/encode(to:)"],"anchor":"Instance-Methods"}],"abstract":[{"type":"text","text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk."}],"metadata":{"modules":[{"name":"Persistence"}],"roleHeading":"Protocol","externalID":"s:11Persistence13BinaryCodableP","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryCodable","kind":"identifier"}],"title":"BinaryCodable","symbolKind":"protocol","remoteSource":{"fileName":"BinaryCodable.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/BinaryCodable.swift#L59"},"navigatorTitle":[{"text":"BinaryCodable","kind":"identifier"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"title":"Conforming Types","type":"conformingTypes","kind":"relationships","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Array","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Bool","doc:\/\/Persistence\/documentation\/Persistence\/FoundationEssentials\/Date","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Double","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Float","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Int","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Int16","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Int32","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Int64","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Int8","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Optional","doc:\/\/Persistence\/documentation\/Persistence\/Events\/Refined","doc:\/\/Persistence\/documentation\/Persistence\/Events\/Sensitive","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/String","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/UInt","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/UInt16","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/UInt32","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/UInt64","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/UInt8","doc:\/\/Persistence\/documentation\/Persistence\/FoundationEssentials\/UUID"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryCodable","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"An event type conforms to be kept on disk by a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","type":"reference"},{"text":" until it is delivered. Write","type":"text"},{"text":" ","type":"text"},{"text":"the conformance in an extension, so the type keeps its memberwise initializer, and encode the","type":"text"},{"text":" ","type":"text"},{"text":"stored properties as a map, each under its name:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct SignedUp: Event {","    var plan: String","    var seats: Int","    var coupon: String?","}","","extension SignedUp: BinaryCodable {","    func encode(to encoder: inout BinaryEncoder) {","        encoder.encodeMap { map in","            map.encode(plan, forKey: \"plan\")","            map.encode(seats, forKey: \"seats\")","            map.encode(coupon, forKey: \"coupon\")","        }","    }","","    init(from decoder: inout BinaryDecoder) throws(BinaryDecodingError) {","        var map = try decoder.decodeMap()","        plan = try map.decode(forKey: \"plan\")","        seats = try map.decode(forKey: \"seats\")","        coupon = try map.decode(forKey: \"coupon\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"@Event"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"EventMacros"},{"type":"text","text":") writes this conformance for you."}],"type":"paragraph"},{"inlineContent":[{"text":"Because each property is found by its name, an event type can change while records written","type":"text"},{"text":" ","type":"text"},{"text":"before the change are still on disk. A property removed since leaves an entry the decoder","type":"text"},{"text":" ","type":"text"},{"text":"skips, an optional property added since reads as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", one with a default value reads it","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/KeyedBinaryDecoder\/decode(_:forKey:default:)","isActive":true,"type":"reference"},{"text":", and properties can be reordered. A","type":"text"},{"text":" ","type":"text"},{"text":"change the older bytes can’t satisfy, such as a required property added or a property’s type","type":"text"},{"text":" ","type":"text"},{"text":"changed, needs a new ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":": the store drops records stored at another version","type":"text"},{"text":" ","type":"text"},{"text":"without reading them, and reports them. One that throws from ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","isActive":true,"type":"reference"},{"text":" all the same is","type":"text"},{"text":" ","type":"text"},{"text":"dropped and reported too.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each value is one CBOR data item, so any CBOR decoder can read the bytes. Integers are CBOR","type":"text"},{"text":" ","type":"text"},{"text":"integers in the fewest bytes that hold them, ","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are double- and single-precision floats, ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" a text string, ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" an array, ","type":"text"},{"code":"Optional","type":"codeVoice"},{"text":" ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" or the value (in a one-element array when the value’s own bytes start with ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", as","type":"text"},{"text":" ","type":"text"},{"text":"a nested optional’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" does, or with that array’s head), ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" ","type":"text"},{"text":"a double of its seconds since 2001-01-01 UTC, and ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":" a 16-byte byte string tagged 37. An","type":"text"},{"text":" ","type":"text"},{"text":"encoder of your own writes a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value as ","type":"text"},{"code":"undefined","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistence\/binarycodable"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable"},"sections":[],"kind":"symbol","references":{"doc://Persistence/documentation/Persistence/BinaryCodable":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","role":"symbol","navigatorTitle":[{"