r plan: String","    var seats: Int","    var coupon: String?","}","","extension SignedUp: BinaryCodable {","    func encode(to encoder: inout BinaryEncoder) {","        encoder.encodeMap { map in","            map.encode(plan, forKey: \"plan\")","            map.encode(seats, forKey: \"seats\")","            map.encode(coupon, forKey: \"coupon\")","        }","    }","","    init(from decoder: inout BinaryDecoder) throws(BinaryDecodingError) {","        var map = try decoder.decodeMap()","        plan = try map.decode(forKey: \"plan\")","        seats = try map.decode(forKey: \"seats\")","        coupon = try map.decode(forKey: \"coupon\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"@Event","type":"codeVoice"},{"type":"text","text":" (module "},{"code":"EventMacros","type":"codeVoice"},{"type":"text","text":") writes this conformance for you."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because each property is found by its name, an event type can change while records written"},{"type":"text","text":" "},{"type":"text","text":"before the change are still on disk. A property removed since leaves an entry the decoder"},{"type":"text","text":" "},{"type":"text","text":"skips, an optional property added since reads as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", one with a default value reads it"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/KeyedBinaryDecoder\/decode(_:forKey:default:)","isActive":true},{"type":"text","text":", and properties can be reordered. A"},{"type":"text","text":" "},{"type":"text","text":"change the older bytes can’t satisfy, such as a required property added or a property’s type"},{"type":"text","text":" "},{"type":"text","text":"changed, needs a new "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":": the store drops records stored at another version"},{"type":"text","text":" "},{"type":"text","text":"without reading them, and reports them. One that throws from "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","isActive":true},{"type":"text","text":" all the same is"},{"type":"text","text":" "},{"type":"text","text":"dropped and reported too."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each value is one CBOR data item, so any CBOR decoder can read the bytes. Integers are CBOR"},{"type":"text","text":" "},{"type":"text","text":"integers in the fewest bytes that hold them, "},{"code":"Bool","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" or "},{"code":"false","type":"codeVoice"},{"type":"text","text":", "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Float","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"are double- and single-precision floats, "},{"code":"String","type":"codeVoice"},{"type":"text","text":" a text string, "},{"code":"Array","type":"codeVoice"},{"type":"text","text":" an array, "},{"code":"Optional","type":"codeVoice"},{"type":"text","text":" "},{"code":"null","type":"codeVoice"},{"type":"text","text":" or the value (in a one-element array when the value’s own bytes start with "},{"code":"null","type":"codeVoice"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"a nested optional’s "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" does, or with that array’s head), "},{"code":"Date","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"a double of its seconds since 2001-01-01 UTC, and "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":" a 16-byte byte string tagged 37. An"},{"type":"text","text":" "},{"type":"text","text":"encoder of your own writes a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value as "},{"code":"