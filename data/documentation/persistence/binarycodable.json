    map.encode(seats, forKey: \"seats\")","            map.encode(coupon, forKey: \"coupon\")","        }","    }","","    init(from decoder: inout BinaryDecoder) throws(BinaryDecodingError) {","        var map = try decoder.decodeMap()","        plan = try map.decode(forKey: \"plan\")","        seats = try map.decode(forKey: \"seats\")","        coupon = try map.decode(forKey: \"coupon\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"@Event","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"EventMacros","type":"codeVoice"},{"text":") writes this conformance for you.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Because each property is found by its name, an event type can change while records written","type":"text"},{"text":" ","type":"text"},{"text":"before the change are still on disk. A property removed since leaves an entry the decoder","type":"text"},{"text":" ","type":"text"},{"text":"skips, an optional property added since reads as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", one with a default value reads it","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/KeyedBinaryDecoder\/decode(_:forKey:default:)","isActive":true,"type":"reference"},{"text":", and properties can be reordered. A","type":"text"},{"text":" ","type":"text"},{"text":"change the older bytes can’t satisfy, such as a required property added or a property’s type","type":"text"},{"text":" ","type":"text"},{"text":"changed, needs a new ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":": the store drops records stored at another version","type":"text"},{"text":" ","type":"text"},{"text":"without reading them, and reports them. One that throws from ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","isActive":true,"type":"reference"},{"text":" all the same is","type":"text"},{"text":" ","type":"text"},{"text":"dropped and reported too.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each value is one CBOR data item, so any CBOR decoder can read the bytes. Integers are CBOR"},{"type":"text","text":" "},{"type":"text","text":"integers in the fewest bytes that hold them, "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":", "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Float"},{"type":"text","text":" "},{"type":"text","text":"are double- and single-precision floats, "},{"type":"codeVoice","code":"String"},{"type":"text","text":" a text string, "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" an array, "},{"type":"codeVoice","code":"Optional"},{"type":"text","text":" "},{"type":"codeVoice","code":"null"},{"type":"text","text":" or the value (in a one-element array when the value’s own bytes start with "},{"type":"codeVoice","code":"null"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"a nested optional’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" does, or with that array’s head), "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" "},{"type":"text","text":"a double of its seconds since 2001-01-01 UTC, and "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" a 16-byte byte string tagged 37. An"},{"type":"text","text":" "},{"type":"text","text":"encoder of your own writes a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value as "},{"type":"codeVoice","code":"undefined"},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://Persistence/documentation/Persistence/BinaryCodable/init(from:)":{"defaultImplementations":1,"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("}