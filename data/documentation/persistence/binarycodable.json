{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk.","type":"text"}],"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)"],"anchor":"Initializers"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/encode(to:)"],"anchor":"Instance-Methods"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"variants":[{"paths":["\/documentation\/persistence\/binarycodable"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryCodable"}],"title":"BinaryCodable","externalID":"s:11Persistence13BinaryCodableP","role":"symbol","navigatorTitle":[{"text":"BinaryCodable","kind":"identifier"}],"remoteSource":{"fileName":"BinaryCodable.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/BinaryCodable.swift#L59"},"roleHeading":"Protocol","symbolKind":"protocol","modules":[{"name":"Persistence"}]},"relationshipsSections":[{"kind":"relationships","type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Array","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Bool","doc:\/\/Persistence\/documentation\/Persistence\/FoundationEssentials\/Date","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Double","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Float","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Int","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Int16","doc:\/\/Persistence\/documentation