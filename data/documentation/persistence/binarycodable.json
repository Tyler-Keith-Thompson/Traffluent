","text":"BinaryCodable"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"An event type conforms to be kept on disk by a ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","isActive":true,"type":"reference"},{"text":" until it is delivered. Write","type":"text"},{"text":" ","type":"text"},{"text":"the conformance in an extension, so the type keeps its memberwise initializer, and encode the","type":"text"},{"text":" ","type":"text"},{"text":"stored properties as a map, each under its name:","type":"text"}]},{"code":["struct SignedUp: Event {","    var plan: String","    var seats: Int","    var coupon: String?","}","","extension SignedUp: BinaryCodable {","    func encode(to encoder: inout BinaryEncoder) {","        encoder.encodeMap { map in","            map.encode(plan, forKey: \"plan\")","            map.encode(seats, forKey: \"seats\")","            map.encode(coupon, forKey: \"coupon\")","        }","    }","","    init(from decoder: inout BinaryDecoder) throws(BinaryDecodingError) {","        var map = try decoder.decodeMap()","        plan = try map.decode(forKey: \"plan\")","        seats = try map.decode(forKey: \"seats\")","        coupon = try map.decode(forKey: \"coupon\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"@Event","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"EventMacros","type":"codeVoice"},{"text":") writes this conformance for you.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because each property is found by its name, an event type can change while records written","type":"text"},{"text":" ","type":"text"},{"text":"before the change are still on disk. A property removed since leaves an entry the decoder","type":"text"},{"text":" ","type":"text"},{"text":"skips, an optional property added since reads as ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", one with a default value reads it","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/KeyedBinaryDecoder\/decode(_:forKey:default:)","type":"reference","isActive":true},{"text":", and properties can be reordered. A","type":"text"},{"text":" ","type":"text"},{"text":"change the older bytes can’t satisfy, such as a required property added or a property’s type","type":"text"},{"text":" ","type":"text"},{"text":"changed, needs a new ","type":"text"},{"type":"codeVoice","code":"Event.schemaVersion"},{"text":": the store drops records stored at another version","type":"text"},{"text":" ","type":"text"},{"text":"without reading them, and reports them. One that throws from ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","type":"reference","isActive":true},{"text":" all the same is","type":"text"},{"text":" ","type":"text"},{"text":"dropped and reported too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each value is one CBOR data item, so any CBOR decoder can read the bytes. Integers are CBOR"},{"type":"text","text":" "},{"type":"text","text":"integers in the fewest bytes that hold them, "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":", "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Float"},{"type":"text","text":" "},{"type":"text","text":"are double- and single-precision floats, "},{"type":"codeVoice","code":"String"},{"type":"text","text":" a text string, "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" an array, "},{"type":"codeVoice","code":"Optional"},{"type":"text","text":" "},{"type":"codeVoice","code":"null"},{"type":"text","text":" or the value (in a one-element array when the value’s own bytes start with "},{"type":"codeVoice","code":"null"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"a nested optional’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" does, or with that array’s head), "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" "},{"type":"text","text":"a double of its seconds since 2001-01-01 UTC, and "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" a 16-byte byte string tagged 37. An"},{"type":"text","text":" "},{"type":"text","text":"encoder of your own writes a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value as "},{"type":"codeVoice","code":"undefined"},{"type":"text","text":"."}]}]}],"abstract":[{"text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk.","type":"text"}],"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryCodable","kind":"identifier"}],"title":"BinaryCodable","role":"symbol","modules":[{"name":"Persistence"}],"remoteSource":{"fileName":"BinaryCodable.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/BinaryCodable.swift#L59"},"externalID":"s:11Persistence13BinaryCodableP","symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"BinaryCodable"}],"roleHeading":"Protocol"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/encode(to:)"],"anchor":"Instance-Methods","title":"Instance Methods"}],"references":{"doc://Persistence/documentation/Persistence/FoundationEssentials/UUID":{"role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/FoundationEssentials\/U