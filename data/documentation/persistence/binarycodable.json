{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"abstract":[{"text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/encode(to:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"}],"relationshipsSections":[{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Array","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Bool","doc:\/\/Persistence\/documentation\/Persistence\/FoundationEssentials\/Date","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Double","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Float","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Int","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Int16","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Int32","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Int64","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Int8","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/Optional","doc:\/\/Persistence\/documentation\/Persistence\/Events\/Refined","doc:\/\/Persistence\/documentation\/Persistence\/Events\/Sensitive","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/String","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/UInt","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/UInt16","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/UInt32","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/UInt64","doc:\/\/Persistence\/documentation\/Persistence\/Swift\/UInt8","doc:\/\/Persistence\/documentation\/Persistence\/FoundationEssentials\/UUID"],"title":"Conforming Types","kind":"relationships","type":"conformingTypes"}],"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","interfaceLanguage":"swift"},"metadata":{"externalID":"s:11Persistence13BinaryCodableP","modules":[{"name":"Persistence"}],"navigatorTitle":[{"text":"BinaryCodable","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryCodable"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/BinaryCodable.swift#L59","fileName":"BinaryCodable.swift"},"title":"BinaryCodable","role":"symbol","roleHeading":"Protocol","symbolKind":"protocol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryCodable"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"An event type conforms to be kept on disk by a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"},{"type":"text","text":" until it is delivered. Write"},{"type":"text","text":" "},{"type":"text","text":"the conformance in an extension, so the type keeps its memberwise initializer, and encode the"},{"type":"text","text":" "},{"type":"text","text":"stored properties as a map, each under its name:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SignedUp: Event {","    var plan: String","    var seats: Int","    var coupon: String?","}","","extension SignedUp: BinaryCodable {","    func encode(to encoder: inout BinaryEncoder) {","        encoder.encodeMap { map in","            map.encode(plan, forKey: \"plan\")","            map.encode(seats, forKey: \"seats\")","            map.encode(coupon, forKey: \"coupon\")","        }","    }","","    init(from decoder: inout BinaryDecoder) throws(BinaryDecodingError) {","        var map = try decoder.decodeMap()","        plan = try map.decode(forKey: \"plan\")","        seats = try map.decode(forKey: \"seats\")","        coupon = try map.decode(forKey: \"coupon\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"@Event","type":"codeVoice"},{"type":"text","text":" (module "},{"code":"EventMacros","type":"codeVoice"},{"type":"text","text":") writes this conformance for you."}],"type":"paragraph"},{"inlineContent":[{"text":"Because each property is found by its name, an event type can change while records written","type":"text"},{"text":" ","type":"text"},{"text":"before the change are still on disk. A property removed since leaves an entry the decoder","type":"text"},{"text":" ","type":"text"},{"text":"skips, an optional property added since reads as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", one with a default value reads it","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/KeyedBinaryDecoder\/decode(_:forKey:default:)","type":"reference"},{"text":", and properties can be reordered. A","type":"text"},{"text":" ","type":"text"},{"text":"change the older bytes can’t satisfy, such as a required property added or a property’s type","type":"text"},{"text":" ","type":"text"},{"text":"changed, needs a new ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":": the store drops records stored at another version","type":"text"},{"text":" ","type":"text"},{"text":"without reading them, and reports them. One that throws from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)","type":"reference"},{"text":" all the same is","type":"text"},{"text":" ","type":"text"},{"text":"dropped and reported too.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each value is one CBOR data item, so any CBOR decoder can read the bytes. Integers are CBOR"},{"type":"text","text":" "},{"type":"text","text":"integers in the fewest bytes that hold them, "},{"code":"Bool","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" or "},{"code":"false","type":"codeVoice"},{"type":"text","text":", "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Float","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"are double- and single-precision floats, "},{"code":"String","type":"codeVoice"},{"type":"text","text":" a text string, "},{"code":"Array","type":"codeVoice"},{"type":"text","text":" an array, "},{"code":"Optional","type":"codeVoice"},{"type":"text","text":" "},{"code":"null","type":"codeVoice"},{"type":"text","text":" or the value (in a one-element array when the value’s own bytes start with "},{"code":"null","type":"codeVoice"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"a nested optional’s "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" does, or with that array’s head), "},{"code":"Date","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"a double of its seconds since 2001-01-01 UTC, and "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":" a 16-byte byte string tagged 37. An"},{"type":"text","text":" "},{"type":"text","text":"encoder of your own writes a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value as "},{"code":"undefined","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/persistence\/binarycodable"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://Persistence/documentation/Persistence/Swift/Array":{"url":"\/documentation\/persistence\/swift\/array","abstract":[],"kind":"symbol","identifier":"doc:\/\/Persistence\/