"text","text":" all the same is"},{"type":"text","text":" "},{"type":"text","text":"dropped and reported too."}]},{"type":"paragraph","inlineContent":[{"text":"Each value is one CBOR data item, so any CBOR decoder can read the bytes. Integers are CBOR","type":"text"},{"text":" ","type":"text"},{"text":"integers in the fewest bytes that hold them, ","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are double- and single-precision floats, ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" a text string, ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" an array, ","type":"text"},{"code":"Optional","type":"codeVoice"},{"text":" ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" or the value (in a one-element array when the value’s own bytes start with ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", as","type":"text"},{"text":" ","type":"text"},{"text":"a nested optional’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" does, or with that array’s head), ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" ","type":"text"},{"text":"a double of its seconds since 2001-01-01 UTC, and ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":" a 16-byte byte string tagged 37. An","type":"text"},{"text":" ","type":"text"},{"text":"encoder of your own writes a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value as ","type":"text"},{"code":"undefined","type":"codeVoice"},{"text":".","type":"text"}]}]}],"references":{"doc://Persistence/documentation/Persistence/Swift/Int":{"title":"Int","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"I