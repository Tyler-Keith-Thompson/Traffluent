{"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryCodable","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"An event type conforms to be kept on disk by a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"},{"type":"text","text":" until it is delivered. Write"},{"type":"text","text":" "},{"type":"text","text":"the conformance in an extension, so the type keeps its memberwise initializer, and encode the"},{"type":"text","text":" "},{"type":"text","text":"stored properties as a map, each under its name:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SignedUp: Event {","    var plan: String","    var seats: Int","    var coupon: String?","}","","extension SignedUp: BinaryCodable {","    func encode(to encoder: inout BinaryEncoder) {","        encoder.encodeMap { map in","            map.encode(plan, forKey: \"plan\")","            map.encode(seats, forKey: \"seats\")","            map.encode(coupon, forKey: \"coupon\")","        }","    }","","    init(from decoder: inout BinaryDecoder) throws(BinaryDecodingError) {","        var map = try decoder.decodeMap()","        plan = try map.decode(forKey: \"plan\")","        seats = try map.decode(forKey: \"seats\")","        coupon = try map.decode(forKey: \"coupon\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"@Event"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"EventMacros"},{"type":"text","text":") writes this conformance for you."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because each property is found by its name, an event type can change while records written"},{"type":"text","text":" "},{"type":"text","text":"before the change are still on disk. A property removed since leaves an entry the decoder"},{"type":"text","text":" "},{"type":"text","text":"skips, an optional property added since reads as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", one with a default value reads it"},{"type":"text","text":" "},{"type":"text","text":"through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/KeyedBinaryDecoder\/decode(_:forKey:default:)"},{"type":"text","text":", and properties can be reordered. A"},{"type":"text","text":" "},{"type":"text","text":"change the older bytes can’t satisfy, such as a required property added or a property’s type"},{"type":"text","text":" "},{"type":"text","text":"changed, needs a new "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":": the store drops records stored at another version"},{"type":"text","text":" "},{"type":"text","text":"without reading them, and reports them. One that throws from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)"},{"type":"text","text":" all the same is"},{"type":"text","text":" "},{"type":"text","text":"dropped and reported too."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each value is one CBOR data item, so any CBOR decoder can read the bytes. Integers are CBOR"},{"type":"text","text":" "},{"type":"text","text":"integers in the fewest bytes that hold them, "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":", "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Float"},{"type":"text","text":" "},{"type":"text","text":"are double- and single-precision floats, "},{"type":"codeVoice","code":"String"},{"type":"text","text":" a text string, "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" an array, "},{"type":"codeVoice","code":"Optional"},{"type":"text","text":" "},{"type":"codeVoice","code":"null"},{"type":"text","text":" or the value (in a one-element array when the value’s own bytes start with "},{"type":"codeVoice","code":"null"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"a nested optional’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" does, or with that array’s head), "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" "},{"type":"text","text":"a double of its seconds since 2001-01-01 UTC, and "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" a 16-byte byte string tagged 37. An"},{"type":"text","text":" "},{"type":"text","text":"encoder of your own writes a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value as "},{"type":"codeVoice","code":"undefined"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable"},"variants":[{"paths":["\/documentation\/persistence\/binarycodable"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"title":"BinaryCodable","navigatorTitle":[{"text":"BinaryCodable","kind":"identifier"}],"roleHeading":"Protocol","symbolKind":"protocol","externalID":"s:11Persistence13BinaryCodableP","modules":[{"name":"Persistence"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/BinaryCodable.swift#L59","fileName":"BinaryCodable.swift"},"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryCodable"}],"role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk.","type