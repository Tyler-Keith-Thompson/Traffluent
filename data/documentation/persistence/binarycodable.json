true"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Float"},{"text":" ","type":"text"},{"text":"are double- and single-precision floats, ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" a text string, ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":" an array, ","type":"text"},{"type":"codeVoice","code":"Optional"},{"text":" ","type":"text"},{"type":"codeVoice","code":"null"},{"text":" or the value (in a one-element array when the value’s own bytes start with ","type":"text"},{"type":"codeVoice","code":"null"},{"text":", as","type":"text"},{"text":" ","type":"text"},{"text":"a nested optional’s ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" does, or with that array’s head), ","type":"text"},{"type":"codeVoice","code":"Date"},{"text":" ","type":"text"},{"text":"a double of its seconds since 2001-01-01 UTC, and ","type":"text"},{"type":"codeVoice","code":"UUID"},{"text":" a 16-byte byte string tagged 37. An","type":"text"},{"text":" ","type":"text"},{"text":"encoder of your own writes a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value as ","type":"text"},{"type":"codeVoice","code":"undefined"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/persistence\/binarycodable"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"abstract":[{"type":"text","text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk."}],"references":{"doc://Persistence/documentation/Persistence/SegmentStore":{"title":"SegmentStore","kind":"symbol","abstract":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Persistence\/