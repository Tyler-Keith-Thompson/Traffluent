xt":", ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are double- and single-precision floats, ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" a text string, ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" an array, ","type":"text"},{"code":"Optional","type":"codeVoice"},{"text":" ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" or the value (in a one-element array when the value’s own bytes start with ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", as","type":"text"},{"text":" ","type":"text"},{"text":"a nested optional’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" does, or with that array’s head), ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" ","type":"text"},{"text":"a double of its seconds since 2001-01-01 UTC, and ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":" a 16-byte byte string tagged 37. An","type":"text"},{"text":" ","type":"text"},{"text":"encoder of your own writes a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value as ","type":"text"},{"code":"undefined","type":"codeVoice"},{"text":".","type":"text"}]}]}],"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistence\/binarycodable"]}],"topicSections":[{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/init(from:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable\/encode(to:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Persistence/documentation/Persistence/RecordStore":{"abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the a