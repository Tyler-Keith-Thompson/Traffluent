type":"reference"},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"url":"\/documentation\/persistence\/segmentstore","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","title":"SegmentStore","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://Persistence/documentation/Persistence":{"type":"topic","url":"\/documentation\/persistence","title":"Persistence","role":"collection","identifier":"doc:\/\/Persistence\/documentation\/Persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"kind":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/dropReports":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"DropReport","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence10DropReportO"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A report of each drop, in the order they happen, from recovery onwards."}],"kind":"symbol","title":"dropReports","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","type":"topic","url":"\/documentation\/persistence\/segmentstore\/dropreports","role":"symbol"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}],"url":"\/documentation\/asyncqueues\/asyncqueue","role":"symbol","kind":"symbol","title":"AsyncQueue","abstract":[{"type":"text","text":"The reports or deliveries a library type makes, in the order it makes them, kept until they"},{"type":"text","text":" "},{"type":"text","text":"are read; one reader at a time reads them."}],"navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}]},"doc://Persistence/documentation/Persistence/DropReport":{"navigatorTitle":[{"text":"DropReport","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DropReport","kind":"identifier"}],"abstract":[{"type":"text","text":"Records a store dropped before they were delivered, and why."}],"kind":"symbol","title":"DropReport","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","type":"topic","url":"\/documentation\/persistence\/dropreport","role":"symbol"}}}