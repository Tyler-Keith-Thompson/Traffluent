{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistence\/segmentstore\/dropreports"]}],"abstract":[{"text":"A report of each drop, in the order they happen, from recovery onwards.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","text":"AsyncQueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:11Persistence10DropReportO","kind":"typeIdentifier","text":"DropReport","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Reports wait, without a bound, until they are read, so none is missed by reading late.","type":"text"},{"text":" ","type":"text"},{"text":"Drops are rare (each is a whole segment, or bytes recovery couldn’t read), so they don’t","type":"text"},{"text":" ","type":"text"},{"text":"pile up. The sequence ends once the store is gone and every report has been read.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads the reports at a time. The first iterator to read holds them until its"},{"type":"text","text":" "},{"type":"text","text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a"},{"type":"text","text":" "},{"type":"text","text":"warning once, then reads on from the next report, so the first gets every report in order."},{"type":"text","text":" "},{"type":"text","text":"A reader cancelled while it waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"]]},"metadata":{"symbolKind":"property","modules":[{"name":"Persistence"}],"title":"dropReports","role":"symbol","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","text":"AsyncQueue"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:11Persistence10DropReportO","kind":"typeIdentifier","text":"DropReport"},{"kind":"text","text":">"}],"remoteSource":{"fileName":"SegmentStore.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L169"},"externalID":"s:11Persistence12SegmentStoreV11dropReports11AsyncQueues0F5QueueVyAA10DropReportOGvp"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports"},"sections":[],"kind":"symbol","references":{"doc://Persistence/documentation/Persistence":{"kind":"symbol","role":"collection","identifier":"doc:\/\/Persistence\/documentation\/Persistence","title":"Persistence","type":"topic","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"url":"\/documentation\/persistence"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"abstract":[{"text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"url":"\/documentation\/asyncqueues\/asyncqueue","kind":"symbol","role":"symbol","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"title":"AsyncQueue","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}]},"doc://Persistence/documentation/Persistence/RecordStore":{"abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"url":"\/documentation\/persistence\/recordstore","kind":"symbol","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"title":"RecordStore","type":"topic","navigatorTitle":[{"text":"RecordStore","kind":"identifier"}]},"doc://Persistence/documentation/Persistence/SegmentStore":{"navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"url":"\/documentation\/persistence\/segmentstore","title":"SegmentStore","abstract":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true,"type":"reference"},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"},"doc://Persistence/documentation/Persistence/DropReport":{"abstract":[{"text":"Records a store dropped before they were delivered, and why.","type":"text"}],"navigatorTitle":[{"text":"DropReport","kind":"identifier"}],"title":"DropReport","type":"topic","role":"symbol","url":"\/documentation\/persistence\/dropreport","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","fragments":[{"text":"enum","kind":"keyword"},{"te