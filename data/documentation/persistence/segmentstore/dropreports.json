{"abstract":[{"text":"A report of each drop, in the order they happen, from recovery onwards.","type":"text"}],"variants":[{"paths":["\/documentation\/persistence\/segmentstore\/dropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports"},"sections":[],"metadata":{"modules":[{"name":"Persistence"}],"externalID":"s:11Persistence12SegmentStoreV11dropReports11AsyncQueues0F5QueueVyAA10DropReportOGvp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DropReport","preciseIdentifier":"s:11Persistence10DropReportO"},{"kind":"text","text":">"}],"roleHeading":"Instance Property","symbolKind":"property","remoteSource":{"fileName":"SegmentStore.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L169"},"title":"dropReports","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue"},{"text":"<","kind":"text"},{"text":"DropReport","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence10DropReportO","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait, without a bound, until they are read, so none is missed by reading late."},{"type":"text","text":" "},{"type":"text","text":"Drops are rare (each is a whole segment, or bytes recovery couldn’t read), so they don’t"},{"type":"text","text":" "},{"type":"text","text":"pile up. The sequence ends once the store is gone and every report has been read."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads the reports at a time. The first iterator to read holds them until its"},{"type":"text","text":" "},{"type":"text","text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a"},{"type":"text","text":" "},{"type":"text","text":"warning once, then reads on from the next report, so the first gets every report in order."},{"type":"text","text":" "},{"type":"text","text":"A reader cancelled while it waits returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}]}],"references":{"doc://Persistence/documentation/Persistence/SegmentStore":{"title":"SegmentStore","navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","kind":"symbol","url":"\/documentation\/persistence\/segmentstore","abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://Persistence/documentation/Persistence":{"title":"Persistence","identifier":"doc:\/\/Persistence\/documentation\/Persistence","kind":"symbol","url":"\/documentation\/persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"role":"collection","type":"topic"},"doc://Persistence/documentation/Persistence/SegmentStore/dropReports":{"abstract":[{"type":"text","text":"A report of each drop, in the order they happen, from recovery onwards."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"DropReport","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence10DropReportO"},{"text":">","kind":"text"}],"kind":"symbol","title":"dropReports","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","type":"topic","url":"\/documentation\/persistence\/segmentstore\/dropreports"},"doc://Persistence/documentation/Persistence/DropReport":{"url":"\/documentation\/persistence\/dropreport","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","title":"DropReport","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DropReport"}],"abstract":[{"type":"text","text":"Records a store dropped before they were delivered, and why."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DropReport"}],"type":"topic"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"type":"topic","title":"AsyncQueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","abstract":[{"text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"url":"\/documentation\/asyncqueues\/asyncqueue","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"role":"symbol"},"doc://Persistence/documentation/Persistence/RecordStore":{"abstract":[{"text":"Where a tracker keeps each record until it is delivered, so records survive the app ending.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"RecordStore","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","title":"RecordStore","url":"\/documentation\/persistence\/recordstore","role":"symbol"}}}