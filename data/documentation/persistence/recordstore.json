"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracker given a store ("},{"code":"Tracker(store:)","type":"codeVoice"},{"type":"text","text":") appends each record to it as the tracker’s worker"},{"type":"text","text":" "},{"type":"text","text":"reaches the record, before publishing it, and starts its records with the ones the store kept"},{"type":"text","text":" "},{"type":"text","text":"from earlier runs. A store tags each record"},{"type":"text","text":" "},{"type":"text","text":"it keeps with a "},{"code":"DeliveryTag","type":"codeVoice"},{"type":"text","text":" naming itself as the "},{"code":"Acknowledger","type":"codeVoice"},{"type":"text","text":", so a"},{"type":"text","text":" "},{"type":"text","text":"delivery tells it when the record is about to be delivered and once it has been."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","isActive":true},{"type":"text","text":" is the default; conform to keep records elsewhere."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"references":{"doc://Persistence/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/Persistence\/s16SendableMetatypeP","type":"unresolvable"},"doc://Persistence/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/Persistence\/s8SendableP"},"doc://Persistence/documentation/Persistence":{"type":"topic","kind":"symbol","role":"collection","title":"Persistence","abstract":[],"identifier":"doc:\/\/Persistence\/documentation\/Persistence","url":"\/documentation\/persistence"},"doc://Persistence/documentation/Persistence/RecordStore/append(_:)":{"title":"append(_:)","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore\/append(_:)","abstract":[{"text":"Keeps ","type":"text"},{"type":"codeVoice","code":"re