arts with them."}],"title":"takeRecoveredRecords()","kind":"symbol","role":"symbol"},"doc://Persistence/documentation/Persistence/RecordStore":{"url":"\/documentation\/persistence\/recordstore","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","navigatorTitle":[{"kind":"identifier","text":"RecordStore"}],"type":"topic","title":"RecordStore","role":"symbol","kind":"symbol","abstract":[{"text":"Where a tracker keeps each record until it is delivered, so records survive the app ending.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RecordStore"}]},"doc://Persistence/documentation/Persistence/SegmentStore":{"title":"SegmentStore","kind":"symbol","abstract":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true,"type":"reference"},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/persistence\/segmentstore"}}}