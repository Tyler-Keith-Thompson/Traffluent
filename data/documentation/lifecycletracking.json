type":"text"},{"text":" ","type":"text"},{"text":"to compare against: each new one starts with the version it is given.","type":"text"}],"navigatorTitle":[{"text":"InMemoryVersionStore","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InMemoryVersionStore","kind":"identifier"}],"title":"InMemoryVersionStore","url":"\/documentation\/lifecycletracking\/inmemoryversionstore","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore"},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleBatchStrategy":{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","type":"topic","abstract":[{"type":"text","text":"A batch strategy that flushes as a delivery reads an "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true,"type":"reference"},{"type":"text","text":" or"},{"type":"text","text":" "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true,"type":"reference"},{"type":"text","text":" record, so what is pending goes out as the app leaves the foreground"},{"type":"text","text":" "},{"type":"text","text":"rather than waiting for its count or time."}],"url":"\/documentation\/lifecycletracking\/lifecyclebatchstrategy","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LifecycleBatchStrategy"}],"title":"LifecycleBatchStrategy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LifecycleBatchStrategy"}],"kind":"symbol"},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation":{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","type":"topic","abstract":[{"text":"Lifecycle tracking that ","type":"text"},{"code":"trackLifecycle","t