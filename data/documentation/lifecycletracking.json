{"abstract":[{"type":"text","text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s records durable as the app leaves the foreground."}],"hierarchy":{"paths":[[]]},"sections":[],"topicSections":[{"title":"Tracking the lifecycle","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker\/trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"],"anchor":"Tracking-the-lifecycle"},{"title":"Events","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated"],"anchor":"Events"},{"title":"Keeping the version","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore"],"anchor":"Keeping-the-version"},{"title":"Delivering as the app leaves","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy"],"anchor":"Delivering-as-the-app-leaves"},{"generated":true,"title":"Extended Modules","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Afluent"],"anchor":"Extended-Modules"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/lifecycletracking"]}],"kind":"symbol","metadata":{"modules":[{"name":"LifecycleTracking"}],"roleHeading":"Framework","title":"LifecycleTracking","externalID":"LifecycleTracking","role":"collection","symbolKind":"module"},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this module to track the application’s lifecycle on any platform. Nothing is tracked until"},{"type":"text","text":" "},{"type":"text","text":"the app calls "},{"type":"codeVoice","code":"trackLifecycle"},{"type":"text","text":" on its tracker as it launches, and keeps the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","isActive":true},{"type":"text","text":" it returns; tracking stops when that is cancelled, finished or released."},{"type":"text","text":" "},{"type":"text","text":"For the screens and controls inside the app, see"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As it starts, it compares the app’s version ("},{"type":"codeVoice","code":"CFBundleShortVersionString"},{"type":"text","text":" by default, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"version:"},{"type":"text","text":") with the one its "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","isActive":true},{"type":"text","text":" saved at the last launch. No saved version tracks"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","isActive":true},{"type":"text","text":", a different one "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","isActive":true},{"type":"text","text":", the same one neither. Then it"},{"type":"text","text":" "},{"type":"text","text":"tracks "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":". After that, from "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s, "},{"type":"codeVoice","code":"WKApplication"},{"type":"text","text":"’s or"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSApplication"},{"type":"text","text":"’s notifications, it tracks "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"the background and, where the platform reports it, "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true},{"type":"text","text":", each once per"},{"type":"text","text":" "},{"type":"text","text":"transition. A server or a tool on Linux has no notifications, so it calls"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true},{"type":"text","text":" as it ends:"}]},{"syntax":"swift","code":["let tracker = Tracker()","let lifecycle = tracker.trackLifecycle(version: \"2.1\", versionStore: InMemoryVersionStore(version: \"2.0\"))","\/\/ tracks ApplicationUpdated(previousVersion: \"2.0\", version: \"2.1\"), then ApplicationOpened(fromBackground: false)","","\/\/ ... the process's work ...","","await lifecycle.finish()  \/\/ tracks ApplicationTerminated","await tracker.finish()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The store keeps the version and nothing else. "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","isActive":true},{"type":"text","text":" keeps it in a file, by default"},{"type":"text","text":" "},{"type":"text","text":"beside a "},{"code":"SegmentStore","type":"codeVoice"},{"type":"text","text":"’s records; "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore","isActive":true},{"type":"text","text":" keeps it in memory, for tests; any type"},{"type":"text","text":" "},{"type":"text","text":"of yours can conform. "},{"code":"kinds:","type":"codeVoice"},{"type":"text","text":" turns kinds of event off, while the version is still saved."}]},{"type":"paragraph","inlineContent":[{"text":"As the app leaves the foreground, it waits for the tracker’s worker to write every record tracked","type":"text"},{"text":" ","type":"text"},{"text":"so far to the tracker’s store, then calls the store’s ","type":"text"},{"type":"codeVoice","code":"synchronize()"},{"text":". A delivery batched with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","type":"reference","isActive":true},{"text":" (","type":"text"},{"type":"codeVoice","code":".lifecycle"},{"text":") sends what is pending as it reads the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"text":" record. The notification’s handler only hands the transition on; the","type":"text"},{"text":" ","type":"text"},{"text":"work runs on a task of its own, and where the system suspends apps in the background it holds","type":"text"},{"text":" ","type":"text"},{"text":"background time until the records are durable.","type":"text"}]}]}],"references":{"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation/cancel()":{"title":"cancel()","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/cancel()","type":"topic","kind":"symbol","url":"\/documentation\/lifecycletracking\/lifecycleobservation\/cancel()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"text":"Stops observing the app’s lifecycle, tracking nothing more; does nothing if it stopped","type":"text"},{"text":" ","type":"text"},{"text":"already.","type":"text"}]},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationInstalled/version":{"abstract":[{"text":"The version installed.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled\/version","title":"version","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"version","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"url":"\/documentation\/lifecycletracking\/applicationinstalled\/version"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"type":"topic","url":"\/documentation\/lifecycletracking","kind":"symbol","abstract":[{"text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s records durable as the app leaves the foreground.","type":"text"}],"title":"LifecycleTracking","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","role":"collection"},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation":{"title":"LifecycleObservation","identifie