{"abstract":[{"text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s records durable as the app leaves the foreground.","type":"text"}],"metadata":{"externalID":"LifecycleTracking","roleHeading":"Framework","modules":[{"name":"LifecycleTracking"}],"role":"collection","symbolKind":"module","title":"LifecycleTracking"},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[[]]},"topicSections":[{"anchor":"Tracking-the-lifecycle","title":"Tracking the lifecycle","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker\/trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"]},{"anchor":"Events","title":"Events","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated"]},{"anchor":"Keeping-the-version","title":"Keeping the version","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore"]},{"anchor":"Delivering-as-the-app-leaves","title":"Delivering as the app leaves","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy"]},{"anchor":"Extended-Modules","generated":true,"title":"Extended Modules","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Afluent"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/lifecycletracking"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Use this module to track the application’s lifecycle on any platform. Nothing is tracked until","type":"text"},{"text":" ","type":"text"},{"text":"the app calls ","type":"text"},{"code":"trackLifecycle","type":"codeVoice"},{"text":" on its tracker as it launches, and keeps the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"},{"text":" it returns; tracking stops when that is cancelled, finished or released.","type":"text"},{"text":" ","type":"text"},{"text":"For the screens and controls inside the app, see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"As it starts, it compares the app’s version ("},{"type":"codeVoice","code":"CFBundleShortVersionString"},{"type":"text","text":" by default, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"version:"},{"type":"text","text":") with the one its "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","isActive":true},{"type":"text","text":" saved at the last launch. No saved version tracks"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","isActive":true},{"type":"text","text":", a different one "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","isActive":true},{"type":"text","text":", the same one neither. Then it"},{"type":"text","text":" "},{"type":"text","text":"tracks "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":". After that, from "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s, "},{"type":"codeVoice","code":"WKApplication"},{"type":"text","text":"’s or"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSApplication"},{"type":"text","text":"’s notifications, it tracks "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"the background and, where the platform reports it, "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true},{"type":"text","text":", each once per"},{"type":"text","text":" "},{"type":"text","text":"transition. A server or a tool on Linux has no notifications, so it calls"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true},{"type":"text","text":" as it ends:"}],"type":"paragraph"},{"syntax":"swift","code":["let tracker = Tracker()","let lifecycle = tracker.trackLifecycle(version: \"2.1\", versionStore: InMemoryVersionStore(version: \"2.0\"))","\/\/ tracks ApplicationUpdated(previousVersion: \"2.0\", version: \"2.1\"), then ApplicationOpened(fromBackground: false)","","\/\/ ... the process's work ...","","await lifecycle.finish()  \/\/ tracks ApplicationTerminated","await tracker.finish()"],"type":"codeListing"},{"inlineContent":[{"text":"The store keeps the version and nothing else. ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore"},{"text":" keeps it in a file, by default","type":"text"},{"text":" ","type":"text"},{"text":"beside a ","type":"text"},{"type":"codeVoice","code":"SegmentStore"},{"text":"’s records; ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore"},{"text":" keeps it in memory, for tests; any type","type":"text"},{"text":" ","type":"text"},{"text":"of yours can conform. ","type":"text"},{"type":"codeVoice","code":"kinds:"},{"text":" turns kinds of event off, while the version is still saved.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"As the app leaves the foreground, it waits for the tracker’s worker to write every record tracked"},{"type":"text","text":" "},{"type":"text","text":"so far to the tracker’s store, then calls the store’s "},{"code":"synchronize()","type":"codeVoice"},{"type":"text","text":". A delivery batched with"},{"type":"text","text":" "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","type":"reference","isActive":true},{"type":"text","text":" ("},{"code":".lifecycle","type":"codeVoice"},{"type":"text","text":") sends what is pending as it reads the"},{"type":"text","text":" "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"type":"text","text":" record. The notification’s handler only hands the transition on; the"},{"type":"text","text":" "},{"type":"text","text":"work runs on a task of its own, and where the system suspends apps in the background it holds"},{"type":"text","text":" "},{"type":"text","text":"background time until the records are durable."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationInstalled":{"type":"topic","url":"\/documentation\/lifecycletracking\/applicationinstalled","role":"symbol","kind":"symbol","abstract":[{"text":"The app ran for the first time on this device, at ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled\/version","type":"reference"},{"text":": what ","type":"text"},{"code":"trackLifecycle","type":"codeVoice"},{"text":" tracks as","type":"text"},{"text":" ","type":"text"},{"text":"it starts when its version store holds no version yet.","type":"text"}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ApplicationInstalled"}],"title":"ApplicationInstalled","navigatorTitle":[{"kind":"identifier","text":"ApplicationInstalled"}]},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationUpdated/version":{"url":"\/documentation\/lifecycletracking\/applicationupdated\/version","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The version the app runs at now."}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated\/version","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"title":"version"},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation/cancel()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"kind":"text","text":"()"}],"title":"cancel()","type":"topic","role":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/cancel()","url":"\/documentation\/lifecycletracking\/lifecycleobservation\/cancel()","abstract":[{"text":"Stops observing the app’s lifecycle, tracking nothing more; does nothing if it stopped","type":"text"},{"text":" ","type":"text"},{"text":"already.","type":"text"}],"kind":"symbol"},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation/finish()":{"title":"finish()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"type":"topic","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","kind":"symbol","url":"\/documentation\/lifecycletracking\/lifecycleobservation\/finish()","role":"symbol","abstract":[{"type":"text","text":"Ends the app’s lifecycle: stops observing it, then tracks "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"unless one was tracked already or "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/Kind\/terminated","isActive":true,"type":"reference"},{"type":"text","text":" is off, and makes the tracker’s"},{"type":"text","text":" "},{"type":"text","text":"records durable as on backgrounding. Returns once that is done, or at once if tracking"},{"type":"text","text":" "},{"type":"text","text":"was cancelled."}]},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation":{"title":"LifecycleObservation","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LifecycleObservation"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","navig