{"topicSections":[{"title":"Tracking the lifecycle","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker\/trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"],"anchor":"Tracking-the-lifecycle"},{"title":"Events","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated"],"anchor":"Events"},{"title":"Keeping the version","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore"],"anchor":"Keeping-the-version"},{"title":"Delivering as the app leaves","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy"],"anchor":"Delivering-as-the-app-leaves"},{"title":"Extended Modules","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Afluent"],"generated":true,"anchor":"Extended-Modules"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/lifecycletracking"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","interfaceLanguage":"swift"},"metadata":{"externalID":"LifecycleTracking","symbolKind":"module","modules":[{"name":"LifecycleTracking"}],"role":"collection","roleHeading":"Framework","title":"LifecycleTracking"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Use this module to track the application’s lifecycle on any platform. Nothing is tracked until","type":"text"},{"text":" ","type":"text"},{"text":"the app calls ","type":"text"},{"code":"trackLifecycle","type":"codeVoice"},{"text":" on its tracker as it launches, and keeps the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","isActive":true,"type":"reference"},{"text":" it returns; tracking stops when that is cancelled, finished or released.","type":"text"},{"text":" ","type":"text"},{"text":"For the screens and controls inside the app, see","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"As it starts, it compares the app’s version ("},{"type":"codeVoice","code":"CFBundleShortVersionString"},{"type":"text","text":" by default, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"version:"},{"type":"text","text":") with the one its "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","isActive":true},{"type":"text","text":" saved at the last launch. No saved version tracks"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","isActive":true},{"type":"text","text":", a different one "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","isActive":true},{"type":"text","text":", the same one neither. Then it"},{"type":"text","text":" "},{"type":"text","text":"tracks "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":". After that, from "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s, "},{"type":"codeVoice","code":"WKApplication"},{"type":"text","text":"’s or"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSApplication"},{"type":"text","text":"’s notifications, it tracks "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"the background and, where the platform reports it, "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true},{"type":"text","text":", each once per"},{"type":"text","text":" "},{"type":"text","text":"transition. A server or a tool on Linux has no notifications, so it calls"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true},{"type":"text","text":" as it ends:"}],"type":"paragraph"},{"syntax":"swift","code":["let tracker = Tracker()","let lifecycle = tracker.trackLifecycle(version: \"2.1\", versionStore: InMemoryVersionStore(version: \"2.0\"))","\/\/ tracks ApplicationUpdated(previousVersion: \"2.0\", version: \"2.1\"), then ApplicationOpened(fromBackground: false)","","\/\/ ... the process's work ...","","await lifecycle.finish()  \/\/ tracks ApplicationTerminated","await tracker.finish()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The store keeps the version and nothing else. "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","isActive":true},{"type":"text","text":" keeps it in a file, by default"},{"type":"text","text":" "},{"type":"text","text":"beside a "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":"’s records; "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore","isActive":true},{"type":"text","text":" keeps it in memory, for tests; any type"},{"type":"text","text":" "},{"type":"text","text":"of yours can conform. "},{"type":"codeVoice","code":"kinds:"},{"type":"text","text":" turns kinds of event off, while the version is still saved."}],"type":"paragraph"},{"inlineContent":[{"text":"As the app leaves the foreground, it waits for the tracker’s worker to write every record tracked","type":"text"},{"text":" ","type":"text"},{"text":"so far to the tracker’s store, then calls the store’s ","type":"text"},{"code":"synchronize()","type":"codeVoice"},{"text":". A delivery batched with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","type":"reference"},{"text":" (","type":"text"},{"code":".lifecycle","type":"codeVoice"},{"text":") sends what is pending as it reads the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference"},{"text":" record. The notification’s handler only hands the transition on; the","type":"text"},{"text":" ","type":"text"},{"text":"work runs on a task of its own, and where the system suspends apps in the background it holds","type":"text"},{"text":" ","type":"text"},{"text":"background time until the records are durable.","type":"text"}],"type":"paragraph"}]}],"sections":[],"kind":"symbol","abstract":[{"text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s records durable as the app leaves the foreground.","type":"text"}],"references":{"doc://LifecycleTracking/documentation/LifecycleTracking/Afluent":{"type":"topic","url":"\/documentation\/lifecycletracking\/afluent","abstract":[],"title":"Afluent","role":"collection","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Afluent","kind":"symbol"},"doc://LifecycleTracking/documentation/LifecycleTracking/FileVersionStore":{"kind":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","type":"topic","url":"\/documentation\/lifecycletracking\/fileversionstore","abstract":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","type":"reference"},{"text":" that keeps the version in a file named ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" in a directory.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileVersionStore"}],"navigatorTitle":[{"kind":"identifier","text":"FileVersionStore"}],"role":"symbol","title":"FileVersionStore"},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationOpened/fromBackground":{"title":"fromBackground","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fromBackground","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/lifecycletracking\/applicationopened\/frombackground","kind":"symbol","abstract":[{"type":"text","text":"Whether the app came back from the background, rather than being launched."}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened\/fromBackground","type":"topic"},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationUpdated":{"title":"ApplicationUpdated","role":"sy