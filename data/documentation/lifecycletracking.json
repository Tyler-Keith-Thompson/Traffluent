{"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"externalID":"LifecycleTracking","role":"collection","title":"LifecycleTracking","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"LifecycleTracking"}]},"abstract":[{"text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s records durable as the app leaves the foreground.","type":"text"}],"kind":"symbol","identifier":{"url":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use this module to track the application’s lifecycle on any platform. Nothing is tracked until","type":"text"},{"text":" ","type":"text"},{"text":"the app calls ","type":"text"},{"code":"trackLifecycle","type":"codeVoice"},{"text":" on its tracker as it launches, and keeps the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","isActive":true,"type":"reference"},{"text":" it returns; tracking stops when that is cancelled, finished or released.","type":"text"},{"text":" ","type":"text"},{"text":"For the screens and controls inside the app, see","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"As it starts, it compares the app’s version (","type":"text"},{"code":"CFBundleShortVersionString","type":"codeVoice"},{"text":" by default, or","type":"text"},{"text":" ","type":"text"},{"code":"version:","type":"codeVoice"},{"text":") with the one its ","type":"text"},{"identifier":"doc:\/\/