{"abstract":[{"type":"text","text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s records durable as the app leaves the foreground."}],"metadata":{"modules":[{"name":"LifecycleTracking"}],"title":"LifecycleTracking","role":"collection","symbolKind":"module","roleHeading":"Framework","externalID":"LifecycleTracking"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/lifecycletracking"]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","interfaceLanguage":"swift"},"topicSections":[{"title":"Tracking the lifecycle","anchor":"Tracking-the-lifecycle","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker\/trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"]},{"title":"Events","anchor":"Events","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated"]},{"title":"Keeping the version","anchor":"Keeping-the-version","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore"]},{"title":"Delivering as the app leaves","anchor":"Delivering-as-the-app-leaves","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy"]},{"title":"Extended Modules","anchor":"Extended-Modules","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Afluent"],"generated":true}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"Use this module to track the application’s lifecycle on any platform. Nothing is tracked until","type":"text"},{"text":" ","type":"text"},{"text":"the app calls ","type":"text"},{"code":"trackLifecycle","type":"codeVoice"},{"text":" on its tracker as it launches, and keeps the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","isActive":true,"type":"reference"},{"text":" it returns; tracking stops when that is cancelled, finished or released.","type":"text"},{"text":" ","type":"text"},{"text":"For the screens and controls inside the app, see","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"As it starts, it compares the app’s version ("},{"type":"codeVoice","code":"CFBundleShortVersionString"},{"type":"text","text":" by default, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"version:"},{"type":"text","text":") with the one its "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","isActive":true},{"type":"text","text":" saved at the last launch. No saved version tracks"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","isActive":true},{"type":"text","text":", a different one "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","isActive":true},{"type":"text","text":", the same one neither. Then it"},{"type":"text","text":" "},{"type":"text","text":"tracks "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":". After that, from "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s, "},{"type":"codeVoice","code":"WKApplication"},{"type":"text","text":"’s or"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSApplication"},{"type":"text","text":"’s notifications, it tracks "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"the background and, where the platform reports it, "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true},{"type":"text","text":", each once per"},{"type":"text","text":" "},{"type":"text","text":"transition. A server or a tool on Linux has no notifications, so it calls"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true},{"type":"text","text":" as it ends:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker()","let lifecycle = tracker.trackLifecycle(version: \"2.1\", versionStore: InMemoryVersionStore(version: \"2.0\"))","\/\/ tracks ApplicationUpdated(previousVersion: \"2.0\", version: \"2.1\"), then ApplicationOpened(fromBackground: false)","","\/\/ ... the process's work ...","","await lifecycle.finish()  \/\/ tracks ApplicationTerminated","await tracker.finish()"]},{"inlineContent":[{"type":"text","text":"The store keeps the version and nothing else. "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","type":"reference","isActive":true},{"type":"text","text":" keeps it in a file, by default"},{"type":"text","text":" "},{"type":"text","text":"beside a "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":"’s records; "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore","type":"reference","isActive":true},{"type":"text","text":" keeps it in memory, for tests; any type"},{"type":"text","text":" "},{"type":"text","text":"of yours can conform. "},{"type":"codeVoice","code":"kinds:"},{"type":"text","text":" turns kinds of event off, while the version is still saved."}],"type":"paragraph"},{"inlineContent":[{"text":"As the app leaves the foreground, it waits for the tracker’s worker to write every record tracked","type":"text"},{"text":" ","type":"text"},{"text":"so far to the tracker’s store, then calls the store’s ","type":"text"},{"code":"synchronize()","type":"codeVoice"},{"text":". A delivery batched with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy"},{"text":" (","type":"text"},{"code":".lifecycle","type":"codeVoice"},{"text":") sends what is pending as it reads the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded"},{"text":" record. The notification’s handler only hands the transition on; the","type":"text"},{"text":" ","type":"text"},{"text":"work runs on a task of its own, and where the system suspends apps in the background it holds","type":"text"},{"text":" ","type":"text"},{"text":"background time until the records are durable.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation":{"url":"\/documentation\/lifecycletracking\/lifecycleobservation","role":"symbol","navigatorTitle":[{"text":"LifecycleObservation","kind":"identifier"}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LifecycleObservation","kind":"identifier"}],"title":"LifecycleObservation","abstract":[{"text":"Lifecycle tracking that ","type":"text"},{"code":"trackLifecycle","type":"codeVoice"},{"text":" started, which goes on until ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/cancel()"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()"},{"text":" is called, or the last copy of this value is released.","type":"text"}],"kind":"symbol","type":"topic"},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleBatchStrategy":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LifecycleBatchStrategy"}],"navigatorTitle":[{"kind":"identifier","text":"LifecycleBatchStrategy"}],"title":"LifecycleBatchStrategy","kind":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","type":"topic","role":"symbol","abstract":[{"text":"A batch strategy that flushes as a delivery reads an ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"text":" or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTrac