{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking"},"metadata":{"symbolKind":"module","role":"collection","modules":[{"name":"LifecycleTracking"}],"roleHeading":"Framework","title":"LifecycleTracking","externalID":"LifecycleTracking"},"abstract":[{"text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s records durable as the app leaves the foreground.","type":"text"}],"topicSections":[{"anchor":"Tracking-the-lifecycle","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker\/trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"],"title":"Tracking the lifecycle"},{"anchor":"Events","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated"],"title":"Events"},{"anchor":"Keeping-the-version","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore"],"title":"Keeping the version"},{"anchor":"Delivering-as-the-app-leaves","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy"],"title":"Delivering as the app leaves"},{"anchor":"Extended-Modules","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Afluent"],"generated":true,"title":"Extended Modules"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this module to track the application’s lifecycle on any platform. Nothing is tracked until"},{"type":"text","text":" "},{"type":"text","text":"the app calls "},{"code":"trackLifecycle","type":"codeVoice"},{"type":"text","text":" on its tracker as it launches, and keeps the"},{"type":"text","text":" "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","isActive":true,"type":"reference"},{"type":"text","text":" it returns; tracking stops when that is cancelled, finished or released."},{"type":"text","text":" "},{"type":"text","text":"For the screens and controls inside the app, see"},{"type":"text","text":" "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"As it starts, it compares the app’s version ("},{"type":"codeVoice","code":"CFBundleShortVersionString"},{"type":"text","text":" by default, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"version:"},{"type":"text","text":") with the one its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore"},{"type":"text","text":" saved at the last launch. No saved version tracks"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled"},{"type":"text","text":", a different one "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated"},{"type":"text","text":", the same one neither. Then it"},{"type":"text","text":" "},{"type":"text","text":"tracks "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened"},{"type":"text","text":". After that, from "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s, "},{"type":"codeVoice","code":"WKApplication"},{"type":"text","text":"’s or"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSApplication"},{"type":"text","text":"’s notifications, it tracks "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"the background and, where the platform reports it, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated"},{"type":"text","text":", each once per"},{"type":"text","text":" "},{"type":"text","text":"transition. A server or a tool on Linux has no notifications, so it calls"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()"},{"type":"text","text":" as it ends:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker()","let lifecycle = tracker.trackLifecycle(version: \"2.1\", versionStore: InMemoryVersionStore(version: \"2.0\"))","\/\/ tracks ApplicationUpdated(previousVersion: \"2.0\", version: \"2.1\"), then ApplicationOpened(fromBackground: false)","","\/\/ ... the process's work ...","","await lifecycle.finish()  \/\/ tracks ApplicationTerminated","await tracker.finish()"]},{"inlineContent":[{"text":"The store keeps the version and nothing else. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","type":"reference"},{"text":" keeps it in a file, by default","type":"text"},{"text":" ","type":"text"},{"text":"beside a ","type":"text"},{"code":"SegmentStore","type":"codeVoice"},{"text":"’s records; ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore","type":"reference"},{"text":" keeps it in memory, for tests; any type","type":"text"},{"text":" ","type":"text"},{"text":"of yours can conform. ","type":"text"},{"code":"kinds:","type":"codeVoice"},{"text":" turns kinds of event off, while the version is still saved.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"As the app leaves the foreground, it waits for the tracker’s worker to write every record tracked"},{"type":"text","text":" "},{"type":"text","text":"so far to the tracker’s store, then calls the store’s "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":". A delivery batched with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy"},{"type":"text","text":" ("},{"type":"codeVoice","code":".lifecycle"},{"type":"text","text":") sends what is pending as it reads the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded"},{"type":"text","text":" record. The notification’s handler only hands the transition on; the"},{"type":"text","text":" "},{"type":"text","text":"work runs on a task of its own, and where the system suspends apps in the background it holds"},{"type":"text","text":" "},{"type":"text","text":"background time until the records are durable."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentatio