king\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()"},{"type":"text","text":" is called, or the last copy of this value is released."}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","role":"symbol","type":"topic","kind":"symbol","title":"LifecycleObservation","url":"\/documentation\/lifecycletracking\/lifecycleobservation","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LifecycleObservation"}],"navigatorTitle":[{"kind":"identifier","text":"LifecycleObservation"}]},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationBackgrounded":{"kind":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","url":"\/documentation\/lifecycletracking\/applicationbackgrounded","type":"topic","abstract":[{"text":"The app moved to the background: what ","type":"text"},{"type":"codeVoice","code":"trackLifecycle"},{"text":" tracks each time the app leaves the","type":"text"},{"text":" ","type":"text"},{"text":"foreground (on macOS, each time it stops being the active app).","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ApplicationBackgrounded"}],"navigatorTitle":[{"kind":"identifier","text":"ApplicationBackgrounded"}],"role":"symbol","title":"ApplicationBackgrounded"},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationOpened":{"type":"topic","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","url":"\/documentation\/lifecycletracking\/applicationopened","title":"ApplicationOpened","role":"symbol","navigatorTitle":[{"text":"ApplicationOpened","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The app was opened: launched, or brought back to the foreground when "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/Lifecycl