":"Privacy Manifests","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}],"kind":"article"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"kind":"symbol","type":"topic","url":"\/documentation\/lifecycletracking","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","title":"LifecycleTracking","abstract":[],"role":"collection"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"type":"topic","url":"\/documentation\/loggingdestinations","title":"LoggingDestinations","role":"collection","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","abstract":[],"kind":"symbol"},"doc://TracingDestinations/documentation/TracingDestinations":{"kind":"symbol","type":"topic","url":"\/documentation\/tracingdestinations","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","title":"TracingDestinations","abstract":[],"role":"collection"},"doc://TrackerTesting/documentation/TrackerTesting":{"type":"topic","url":"\/documentation\/trackertesting","title":"TrackerTesting","role":"collection","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","abstract":[],"kind":"symbol"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"kind":"symbol","type":"topic","url":"\/documentation\/swiftuitracking","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","title":"SwiftUITracking","abstract":[],"role":"collection"},"doc://Checksums/documentation/Checksums":{"type":"topic","url":"\/documentation\/checksums","title":"Checksums","role":"collection","identifier":"doc:\/\/Checksums\/documentation\/Checksums","abstract":[],"kind":"symbol"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"kind":"symbol","type":"topic","url":"\/documentation\/automaticcontroltracking","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","title":"AutomaticControlTracking","abstract":[],"role":"collection"},"doc://Destinations/documentation/Destinations":{"type":"topic","url":"\/documentation\/destinations","title":"Destinations","role":"collection","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[],"kind":"symbol"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"kind":"symbol","type":"topic","url":"\/documentation\/trackingplantesting","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","title":"TrackingPlanTesting","abstract":[],"role":"collection"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"type":"topic","url":"\/documentation\/traffluent\/whatgoeswhere","title":"Logging, Tracing, Metrics and Analytics","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}],"kind":"article"}}}