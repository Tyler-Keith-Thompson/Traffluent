n/JSONValues":{"identifier":"doc:\/\/JSONValues\/documentation\/JSONValues","title":"JSONValues","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A JSON value that renders to the same bytes on every platform and Swift release."}],"role":"collection","url":"\/documentation\/jsonvalues"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"kind":"article","role":"article","url":"\/documentation\/traffluent\/changingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"type":"topic","title":"Changing an Event"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"kind":"symbol","role":"collection","url":"\/documentation\/googleanalyticsencoding","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","abstract":[{"text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol.","type":"text"}],"type":"topic","title":"GoogleAnalyticsEncoding"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"abstract":[{"type":"text","text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it."}],"url":"\/documentation\/traffluent\/whatgoeswhere","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","title":"Logging, Tracing, Metrics and Analytics"},"doc://Sessions/documentation/Sessions":{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","title":"Sessions","type":"topic","kind":"symbol","abstract":[{"text":"Put every event a tracker tracks in a session, and sample whole sessions.","type":"text"}],"role":"collection","url":"\/documentation\/sessions"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"kind":"article","role":"article","url":"\/documentation\/traffluent\/choosingdestinations","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"type":"topic","title":"Choosing Destinations"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding":{"kind":"symbol","role":"collection","url":"\/documentation\/segmentspecencoding","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","abstract":[{"text":"Send records as Segment-spec track calls to Segment, RudderStack or Customer.io Data Pipelines.","type":"text"}],"type":"topic","title":"SegmentSpecEncoding"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","title":"LoggingDestinations","type":"topic","kind":"symbol","abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"type":"codeVoice","code":"Logger"},{"text":".","type":"text"}],"role":"collection","url":"\/documentation\/loggingdestinations"},"doc://PropertyJSON/documentation/PropertyJSON":{"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","title":"PropertyJSON","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The vendor-neutral pieces a JSON "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" is built from: properties, context, timestamps, identity and batch splitting."}],"role":"collection","url":"\/documentation\/propertyjson"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","title":"Getting Started","type":"topic","kind":"article","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app track