affluent","type":"topic","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://Trackers/documentation/Trackers":{"abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"url":"\/documentation\/trackers","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"title":"TrackingPlanTesting","kind":"symbol","role":"collection","url":"\/documentation\/trackingplantesting","type":"topic","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"url":"\/documentation\/traffluent\/changingevents","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","title":"Changing an Event"},"doc://Sessions/documentation/Sessions":{"title":"Sessions","kind":"symbol","role":"collection","url":"\/documentation\/sessions","type":"topic","abstract":[{"type":"text","text":"Put every event a tracker tracks in a session, and sample whole sessions."}],"identifier":"doc:\/\/Sessions\/documentation\/Sessions"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of 