:"\/documentation\/eventmacros"},"doc://Events/documentation/Events":{"title":"Events","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/Events\/documentation\/Events","url":"\/documentation\/events","type":"topic"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","kind":"symbol","type":"topic","abstract":[],"role":"collection","title":"LifecycleTracking","url":"\/documentation\/lifecycletracking"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"title":"SwiftUITracking","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","url":"\/documentation\/swiftuitracking","type":"topic"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","kind":"article","type":"topic","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"role":"article","title":"Choosing Destinations","url":"\/documentation\/traffluent\/choosingdestinations"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","kind":"symbol","type":"topic","abstract":[],"role":"collection","title":"AutomaticScreenTracking","url":"\/documentation\/automaticscreentracking"},"doc://TrackingPlans/documentation/TrackingPlans":{"title":"TrackingPlans","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","url":"\/documentation\/trackingplans","type":"topic"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","kind":"symbol","type":"topic","abstract":[],"role":"collection","title":"PostHogEncoding","url":"\/documentation\/posthogencoding"},"doc://Trackers/documentation/Trackers":{"title":"Trackers","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/Trackers\/documentation\/Trackers","url":"\/documentation\/trackers","type":"topic"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","kind":"symbol","type":"topic","abstract":[],"role":"collection","title":"LoggingDestinations","url":"\/documentation\/loggingdestinations"},"doc://StandardContext/documentation/StandardContext":{"title":"StandardContext","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","url":"\/documentation\/standardcontext","type":"topic"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","role":"article","kind":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","url":"\/documentation\/traffluent\/automatictracking","type":"topic"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","kind":"article","type":"topic","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"role":"article","title":"Consent Gating","url":"\/documentation\/traffluent\/consentgating"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","kind":"article","type":"topic","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"role":"article","title":"Persisting Records","url":"\/documentation\/traffluent\/persistingrecords"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","kind":"article","type":"topic","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"role":"article","title":"Tracking Events","url":"\/documentation\/traffluent\/trackingevents"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","kind":"article","type":"topic","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"role":"article","title":"Sampling Events","url":"\/documentation\/traffluent\/samplingevents"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","kind":"symbol","type":"topic","abstract":[],"role":"collection","title":"GRDBPersistence","url":"\/documentation\/grdbpersistence"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"title":"CollectorEncoding","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","url":"\/documentation\/collectorencoding","type":"topic"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","kind":"article","type":"topic","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"role":"article","title":"Testing What Your Code Tracks","url":"\/documentation\/traffluent\/testingwhatyoutrack"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"title":"Identifying People","role":"article","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","abstract":[{"text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent.","type":"text"}],"url":"\/documentation\/traffluent\/identifyingpeople","type":"topic"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","kind":"symbol","type":"topic","abstract":[],"role":"collection","title":"AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"title":"Logging, Tracing, Metrics and Analytics","role":"article","kind":"article","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","url":"\/documentation\/traffluent\/whatgoeswhere","type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","kind":"article","type":"topic","abstract":[{"text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it.","type":"text"}],"role":"article","title":"Exporting and Checking a Tracking Plan","url":"\/documentation\/traffluent\/trackingplanworkflow"}}}