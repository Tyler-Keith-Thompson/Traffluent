e":"text","text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol."}],"url":"\/documentation\/googleanalyticsencoding","role":"collection"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","title":"CollectorEncoding","kind":"symbol","type":"topic","abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" to send.","type":"text"}],"url":"\/documentation\/collectorencoding","role":"collection"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"role":"collection","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"topic","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}],"kind":"symbol","title":"AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","title":"Logging, Tracing, Metrics and Analytics","type":"topic","kind":"article","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}],"url":"\/documentation\/traffluent\/whatgoeswhere","role":"article"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking"},"doc://AsyncQueues/documentation/AsyncQueues":{"role":"collection","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues","type":"topic","abstract":[{"type":"text","text":"The sequence type of every report and delivery stream the library hands out, and of an app’s own, read by one task at a time."}],"kind":"symbol","title":"AsyncQueues","url":"\/documentation\/asyncqueues"},"doc://Traffluent/documentation/Traffluent":{"abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"title":"Traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","type":"topic","role":"collection","url":"\/documentation\/traffluent","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"topic","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/trackingevents","title":"Tracking Events"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"topic","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/consentgating","title":"Consent Gating"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","title":"AutomaticScreenTracking","type":"topic","kind":"symbol","abstract":[{"text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on","type":"text"},{"text":" ","type":"text"},{"text":"each screen.","type":"text"}],"url":"\/documentation\/automaticscreentracking","role":"collection"},"doc://MatomoEncoding/do