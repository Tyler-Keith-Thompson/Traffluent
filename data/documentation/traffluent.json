you can fill in your app’s own manifest and privacy labels."}],"title":"Privacy Manifests","kind":"article","role":"article","url":"\/documentation\/traffluent\/privacymanifests"},"doc://Destinations/documentation/Destinations":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"topic","url":"\/documentation\/destinations","title":"Destinations","role":"collection","kind":"symbol","abstract":[]},"doc://Traffluent/documentation/Traffluent":{"url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"title":"Traffluent","kind":"symbol","role":"collection","type":"topic"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","url":"\/documentation\/traffluent\/identifyingpeople","title":"Identifying People","role":"article","kind":"article","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}]},"doc://Checksums/documentation/Checksums":{"type":"topic","identifier":"doc:\/\/Checksums\/documentation\/Checksums","abstract":[],"title":"Checksums","kind":"symbol","role":"collection","url":"\/documentation\/checksums"},"doc://Events/documentation/Events":{"url":"\/documentation\/events","identifier":"doc:\/\/Events\/documentation\/Events","type":"topic","abstract":[],"title":"Events","kind":"symbol","role":"collection"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","url":"\/documentation\/traffluent\/samplingevents","title":"Sampling Events","role":"article","kind":"article","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}]},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"title":"Changing an Event","kind":"article","role":"article","url":"\/documentation\/traffluent\/changingevents"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"title":"Exporting and Checking a Tracking Plan","kind":"article","role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"title":"Tracking from SwiftUI, UIKit and AppKit","kind":"article","role":"article","url":"\/documentation\/traffluent\/trackingfromviews"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"title":"Tracking Events","kind":"article","role":"article","url":"\/documentation\/traffluent\/trackingevents"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"topic","url":"\/documentation\/automaticcontroltracking","title":"AutomaticControlTracking","role":"collection","kind":"symbol","abstract":[]},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"title":"Automatic Tracking","kind":"article","role":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","url":"\/documentation\/traffluent\/whatgoeswhere","title":"Logging, Tracing, Metrics and Analytics","role":"article","kind":"article","abstract":[{"type":"text","text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it."}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic","url":"\/documentation\/httpdestinations","title":"HTTPDestinations","role":"collection","kind":"symbol","abstract":[]},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","url":"\/documentation\/traffluent\/definingevents","title":"Defining Events","role":"article","kind":"article","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}]},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"type":"t