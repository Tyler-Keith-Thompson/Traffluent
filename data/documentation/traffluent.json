{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent"},"metadata":{"roleHeading":"Framework","role":"collection","symbolKind":"module","modules":[{"name":"Traffluent"}],"title":"Traffluent","externalID":"Traffluent"},"sections":[],"topicSections":[{"title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"anchor":"Essentials"},{"title":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"],"anchor":"Modules"},{"title":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"],"anchor":"Testing"}],"abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"An event is a value conforming to ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":". A ","type":"text"},{"type":"codeVoice","code":"Tracker"},{"text":" is a value: tracking an event records it as an ","type":"text"},{"type":"codeVoice","code":"EventRecord"},{"text":", with its timestamp, the caller’s ","type":"text"},{"type":"codeVoice","code":"SourceLocation"},{"text":" and its ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":", as one of the tracker’s ","type":"text"},{"type":"codeVoice","code":"records"},{"text":". Delivering is a chain of operators over that sequence: Afluent’s ","type":"text"},{"type":"codeVoice","code":"batch(strategy:)"},{"text":" (or ","type":"text"},{"type":"codeVoice","code":"batch()"},{"text":", the default) gathers the records into batches, and ","type":"text"},{"type":"codeVoice","code":"deliver(to:)"},{"text":" hands each batch to every destination, as a lazy unit of work. A ","type":"text"},{"type":"codeVoice","code":"Destination"},{"text":" is a plain sink, narrowed or transformed by its modifiers: ","type":"text"},{"type":"codeVoice","code":"accepting(_:)"},{"text":" for the consent categories it serves, ","type":"text"},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"droppingCallSite()"},{"text":". A tracker given a ","type":"text"},{"type":"codeVoice","code":"Consent"},{"text":" delivers an event only once the user grants its ","type":"text"},{"type":"codeVoice","code":"ConsentCategory"},{"text":", holding it while undecided and dropping it when denied. ","type":"text"},{"type":"codeVoice","code":"track"},{"text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a ","type":"text"},{"type":"codeVoice","code":"SegmentStore"},{"text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a ","type":"text"},{"type":"codeVoice","code":"Refined"},{"text":" value, which satisfies its ","type":"text"},{"type":"codeVoice","code":"Refinement"},{"text":"‘s ","type":"text"},{"type":"codeVoice","code":"Constraint"},{"text":"s from the moment it is made, or carries constraints declared with ","type":"text"},{"type":"codeVoice","code":"@Constrained"},{"text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a ","type":"text"},{"type":"codeVoice","code":"RejectionReport"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"rejectionReports"},{"text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its ","type":"text"},{"type":"codeVoice","code":"ScreenKey"},{"text":" (","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true},{"text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene (","type":"text"},{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true},{"text":"), and AppKit views find it up their responder chain (","type":"text"},{"type":"reference","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","isActive":true},{"text":"); a control’s ","type":"text"},{"type":"codeVoice","code":"track"},{"text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with ","type":"text"},{"type":"codeVoice","code":"trackScreensAutomatically"},{"text":", which tracks ","type":"text"},{"type":"codeVoice","code":"ScreenViewed"},{"text":" as each screen’s view controller appears, without swizzling (","type":"text"},{"type":"reference","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","isActive":true},{"text":"), and UIKit controls once a window scene turns it on with ","type":"text"},{"type":"codeVoice","code":"trackControlsAutomatically"},{"text":", which tracks ","type":"text"},{"type":"codeVoice","code":"ControlActivated"},{"text":" as a touch activates each control named by its accessibility identifier (","type":"text"},{"type":"reference","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","isActive":true},{"text":"). On every platform, ","type":"text"},{"type":"codeVoice","code":"trackLifecycle"},{"text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground (","type":"text"},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","isActive":true},{"text":"). A tracker given the ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions"},{"text":" enricher stamps every event with its session’s ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking ","type":"text"},{"type":"codeVoice","code":"SessionEnded"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"SessionStarted"},{"text":" (","type":"text"},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true},{"text":"). A tracker given ","type":"text"},{"type":"codeVoice","code":"Sampler"},{"text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with ","type":"text"},{"type":"codeVoice","code":"Sampler.sessions(rate:)"},{"text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a ","type":"text"},{"type":"codeVoice","code":"SamplingDropReport"},{"text":" and stamping each kept record with its ","type":"text"},{"type":"codeVoice","code":"SampleRateKey"},{"text":". The standard enrichers, ","type":"text"},{"type":"codeVoice","code":"Enricher.application()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"device()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"operatingSystem()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"locale()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"network()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"vendorIdentifier()"},{"text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once (","type":"text"},{"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" imports every module but "},{"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true},{"type":"text","text":", a product of its own for apps"},{"type":"text","text":" "},{"type":"text","text":"that already use GRDB; "},{"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","isActive":true},{"type":"text","text":", whose "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" macro derives an event’s conformances"},{"type":"text","text":" "},{"type":"text","text":"and schema from its declaration and which alone builds swift-syntax; "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","isActive":true},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","isActive":true},{"type":"text","text":", which runs that check from an app’s tests; and "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose "},{"code":"withRecordingTracker","type":"codeVoice"},{"type":"text","text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own."}]},{"type":"codeListing","syntax":"swift","code":["import Traffluent","","struct SignedUp: Event {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"]}]}],"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent"]}],"references":{"doc://LifecycleTracking/documentation/LifecycleTracking":{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","title":"LifecycleTracking","role":"collection","abstract":[],"url":"\/documentation\/lifecycletracking","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","title":"Changing an Event","role":"article","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"url":"\/documentation\/traffluent\/changingevents","kind":"article","type":"topic"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/swiftuitracking","title":"SwiftUITracking","type":"topic"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","title":"TrackingPlanTesting","role":"collection","abstract":[],"url":"\/documentation\/trackingplantesting","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","kind":"symbol","role":"collection","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent","title":"Traffluent","type":"topic"},"doc://Sessions/documentation/Sessions":{"kind":"symbol","identifier":"doc:\/\/Sessions\/documentation\/Sessions","role":"collection","abstract":[],"url":"\/documentation\/sessions","title":"Sessions","type":"topic"},"doc://Destinations/documentation/Destinations":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/destinations","title":"Destinations","type":"topic"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","title":"Identifying People","role":"article","abstract":[{"text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent.","type":"text"}],"url":"\/documentation\/traffluent\/identifyingpeople","kind":"article","type":"topic"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"kind":"symbol","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","role":"collection","abstract":[],"url":"\/documentation\/automaticcontroltracking","title":"AutomaticControlTracking","type":"topic"},"doc://TrackingPlans/documentation/TrackingPlans":{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","title":"TrackingPlans","role":"collection","abstract":[],"url":"\/documentation\/trackingplans","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","title":"Logging, Tracing, Metrics and Analytics","role":"article","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}],"url":"\/documentation\/traffluent\/whatgoeswhere","kind":"article","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","role":"collection","abstract":[],"url":"\/documentation\/httpdestinations","title":"HTTPDestinations","type":"topic"},"doc://Persistence/documentation/Persistence":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","title":"Persistence","role":"collection","abstract":[],"url":"\/documentation\/persistence","kind":"symbol","type":"topic"},"doc://Checksums/documentation/Checksums":{"kind":"symbol","identifier":"doc:\/\/Checksums\/documentation\/Checksums","role":"collection","abstract":[],"url":"\/documentation\/checksums","title":"Checksums","type":"topic"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","title":"GRDBPersistence","role":"collection","abstract":[],"url":"\/documentation\/grdbpersistence","kind":"symbol","type":"topic"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"kind":"symbol","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","role":"collection","abstract":[],"url":"\/documentation\/automaticscreentracking","title":"AutomaticScreenTracking","type":"topic"},"doc://UIKitTracking/documentation/UIKitTracking":{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","title":"UIKitTracking","role":"collection","abstract":[],"url":"\/documentation\/uikittracking","kind":"symbol","type":"topic"},"doc://StandardContext/documentation/StandardContext":{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","title":"StandardContext","role":"collection","abstract":[],"url":"\/documentation\/standardcontext","kind":"symbol","type":"topic"},"doc://AppKitTracking/documentation/AppKitTracking":{"kind":"symbol","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","role":"collection","abstract":[],"url":"\/documentation\/appkittracking","title":"AppKitTracking","type":"topic"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","role":"article","abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}],"url":"\/documentation\/traffluent\/privacymanifests","title":"Privacy Manifests","type":"topic"},"doc://TracingDestinations/documentation/TracingDestinations":{"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","title":"TracingDestinations","role":"collection","abstract":[],"url":"\/documentation\/tracingdestinations","kind":"symbol","type":"topic"},"doc://EventMacros/documentation/EventMacros":{"kind":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","role":"collection","abstract":[],"url":"\/documentation\/eventmacros","title":"EventMacros","type":"topic"},"doc://TrackerTesting/documentation/TrackerTesting":{"id