":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","title":"CollectorEncoding","role":"collection","type":"topic","kind":"symbol"},"doc://UIKitTracking/documentation/UIKitTracking":{"type":"topic","url":"\/documentation\/uikittracking","role":"collection","title":"UIKitTracking","kind":"symbol","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}]},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","kind":"article","type":"topic","role":"article","url":"\/documentation\/traffluent\/persistingrecords"},"doc://AppKitTracking/documentation/AppKitTracking":{"url":"\/documentation\/appkittracking","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","title":"AppKitTracking","role":"collection","type":"topic","kind":"symbol"},"doc://Events/documentation/Events":{"type":"topic","url":"\/documentation\/events","role":"collection","title":"Events","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events","abstract":[{"type":"text","text":"The types every other module shares: the "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" protocol, the values its properties can hold, and the record a tracker makes of each event."}]},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"url":"\/documentation\/traffluent\/sessionsandstandardcontext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","title":"Sessions and Standard Context","role":"article","type":"topic","kind":"article"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"url":"\/documentation\/automaticcontroltracking","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","title":"AutomaticControlTracking","role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"type":"topic","url":"\/documentation\/traffluent\/automatictracking","role":"article","kind":"article","title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}]},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"url":"\/documentation\/traffluent\/whatgoeswhere","abstract":[{"type":"text","text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","title":"Logging, Tracing, Metrics and Analytics","role":"article","type":"topic","kind":"article"},"doc://Traffluent/documentation/Traffluent":{"url":"\/documentation\/traffluent","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","