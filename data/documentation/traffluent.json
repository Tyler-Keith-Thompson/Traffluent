topic","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"role":"article","title":"Changing an Event","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","url":"\/documentation\/traffluent\/changingevents","kind":"article","type":"topic","abstract":[{"text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","role":"article","title":"Exporting and Checking a Tracking Plan","url":"\/documentation\/traffluent\/trackingplanworkflow","type":"topic","kind":"article","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}]},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"role":"collection","title":"TrackingPlanTesting","url":"\/documentation\/trackingplantesting","type":"topic","kind":"symbol","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"role":"article","title":"Tracking Events","url":"\/documentation\/traffluent\/trackingevents","type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"role":"collection","title":"AutomaticControlTracking","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking","kind":"symbol","type":"topic","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}]},"doc://Events/documentation/Events":{"abstract":[{"type":"text","text":"The types every other module shares: the "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" protocol, the values its properties can hold, and the record a tracker makes of each event."}],"role":"collection","title":"Events","url":"\/documentation\/events","type":"topic","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events"},"doc://Persistence/documentation/Persistence":{"abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"role":"collection","title":"Persistence","url":"\/documentation\/persistence","type":"topic","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"role":"collection","title":"AmplitudeEncoding","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","url":"\/documentation\/amplitudeencoding","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Send records to an Amplitude project through its HTTP V2 API."}]},"doc://TrackerTesting/documentation/TrackerTesting":{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","role":"collection","title":"TrackerTesting","url":"\/documentation\/trackertesting","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}]},"doc://Traffluent/documentation/Tr