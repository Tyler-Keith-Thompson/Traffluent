{"topicSections":[{"anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"title":"Essentials"},{"anchor":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"title":"Guides"},{"anchor":"Choosing-what-to-record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"title":"Choosing what to record"},{"anchor":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"],"title":"Modules"},{"anchor":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"],"title":"Testing"}],"kind":"symbol","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent"]}],"sections":[],"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Framework","title":"Traffluent","externalID":"Traffluent","symbolKind":"module","role":"collection"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"An event is a value conforming to "},{"code":"Event","type":"codeVoice"},{"type":"text","text":". A "},{"code":"Tracker","type":"codeVoice"},{"type":"text","text":" is a value: tracking an event records it as an "},{"code":"EventRecord","type":"codeVoice"},{"type":"text","text":", with its timestamp, the caller’s "},{"code":"SourceLocation","type":"codeVoice"},{"type":"text","text":" and its "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":", as one of the tracker’s "},{"code":"records","type":"codeVoice"},{"type":"text","text":". Delivering is a chain of operators over that sequence: Afluent’s "},{"code":"batch(strategy:)","type":"codeVoice"},{"type":"text","text":" (or "},{"code":"batch()","type":"codeVoice"},{"type":"text","text":", the default) gathers the records into batches, and "},{"code":"deliver(to:)","type":"codeVoice"},{"type":"text","text":" hands each batch to every destination, as a lazy unit of work. A "},{"code":"Destination","type":"codeVoice"},{"type":"text","text":" is a plain sink, narrowed or transformed by its modifiers: "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":" for the consent categories it serves, "},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"droppingCallSite()","type":"codeVoice"},{"type":"text","text":". A tracker given a "},{"code":"Consent","type":"codeVoice"},{"type":"text","text":" delivers an event only once the user grants its "},{"code":"ConsentCategory","type":"codeVoice"},{"type":"text","text":", holding it while undecided and dropping it when denied. "},{"code":"track","type":"codeVoice"},{"type":"text","text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a "},{"code":"SegmentStore","type":"codeVoice"},{"type":"text","text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a "},{"code":"Refined","type":"codeVoice"},{"type":"text","text":" value, which satisfies its "},{"code":"Refinement","type":"codeVoice"},{"type":"text","text":"‘s "},{"code":"Constraint","type":"codeVoice"},{"type":"text","text":"s from the moment it is made, or carries constraints declared with "},{"code":"@Constrained","type":"codeVoice"},{"type":"text","text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a "},{"code":"RejectionReport","type":"codeVoice"},{"type":"text","text":" on "},{"code":"rejectionReports","type":"codeVoice"},{"type":"text","text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its "},{"code":"ScreenKey","type":"codeVoice"},{"type":"text","text":" ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},{"type":"text","text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":"), and AppKit views find it up their responder chain ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},{"type":"text","text":"); a control’s "},{"code":"track","type":"codeVoice"},{"type":"text","text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with "},{"code":"trackScreensAutomatically","type":"codeVoice"},{"type":"text","text":", which tracks "},{"code":"ScreenViewed","type":"codeVoice"},{"type":"text","text":" as each screen’s view controller appears, without swizzling ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking"},{"type":"text","text":"), and UIKit controls once a window scene turns it on with "},{"code":"trackControlsAutomatically","type":"codeVoice"},{"type":"text","text":", which tracks "},{"code":"ControlActivated","type":"codeVoice"},{"type":"text","text":" as a touch activates each control named by its accessibility identifier ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking"},{"type":"text","text":"). On every platform, "},{"code":"trackLifecycle","type":"codeVoice"},{"type":"text","text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking"},{"type":"text","text":"). A tracker given the "},{"code":"Enricher.sessions","type":"codeVoice"},{"type":"text","text":" enricher stamps every event with its session’s "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking "},{"code":"SessionEnded","type":"codeVoice"},{"type":"text","text":" and "},{"code":"SessionStarted","type":"codeVoice"},{"type":"text","text":" ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions"},{"type":"text","text":"). A tracker given "},{"code":"Sampler","type":"codeVoice"},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with "},{"code":"Sampler.sessions(rate:)","type":"codeVoice"},{"type":"text","text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a "},{"code":"SamplingDropReport","type":"codeVoice"},{"type":"text","text":" and stamping each kept record with its "},{"code":"SampleRateKey","type":"codeVoice"},{"type":"text","text":". The standard enrichers, "},{"code":"Enricher.application()","type":"codeVoice"},{"type":"text","text":", "},{"code":"device()","type":"codeVoice"},{"type":"text","text":", "},{"code":"operatingSystem()","type":"codeVoice"},{"type":"text","text":", "},{"code":"locale()","type":"codeVoice"},{"type":"text","text":", "},{"code":"network()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"vendorIdentifier()","type":"codeVoice"},{"type":"text","text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" imports every module but "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},{"type":"text","text":", a product of its own for apps"},{"type":"text","text":" "},{"type":"text","text":"that already use GRDB; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" macro derives an event’s conformances"},{"type":"text","text":" "},{"type":"text","text":"and schema from its declaration and which alone builds swift-syntax; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},{"type":"text","text":", which runs that check from an app’s tests; and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Traffluent","","struct SignedUp: Event {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"]}],"kind":"content"}],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"kind":"article","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"type":"topic","url":"\/documentation\/traffluent\/sessionsandstandardcontext","title":"Sessions and Standard Context","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"url":"\/documentation\/traffluent","title":"Traffluent","role":"collection","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"title":"Logging, Tracing, Metrics and Analytics","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","url":"\/documentation\/traffluent\/whatgoeswhere","role":"article","kind":"article","type":"topic"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"url":"\/documentation\/collectorencoding","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","type":"topic","title":"CollectorEncoding"},"doc://UIKitTracking/documentation/UIKitTracking":{"url":"\/documentation\/uikittracking","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"topic","title":"UIKitTracking"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"url":"\/documentation\/traffluent\/definingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","title":"Defining Events","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"role":"article","kind":"article","type":"topic"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"url":"\/documentation\/automaticcontroltracking","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"topic","title":"AutomaticControlTracking"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"url":"\/documentation\/traffluent\/testingwhatyoutrack","title":"Testing What Your Code Tracks","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","role":"article","kind":"article","type":"topic"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"url":"\/documentation\/automaticscreentracking","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","type":"topic","title":"AutomaticScreenTracking"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"url":"\/documentation\/swiftuitracking","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"topic","title":"SwiftUITracking"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"url":"\/documentation\/traffluent\/trackingfromviews","role":"article","kind":"article","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"topic","title":"Tracking from SwiftUI, UIKit and AppKit"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"url":"\/documentation\/traffluent\/changingevents","title":"Changing an Event","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"},"doc://TracingDestinations/documentation/TracingDestinations":{"title":"TracingDestinations","abstract":[],"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","url":"\/documentation\/tracingdestinations","role":"collection","kind":"symbol","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"url":"\/documentation\/httpdestinations","abstract":[],"title":"HTTPDestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","role":"collection","kind":"symbol","type":"topic"},"doc://Trackers/documentation/Trackers":{"title":"Trackers","abstract":[],"identifier":"doc:\/\/Trackers\/documentation\/Trackers","url":"\/documentation\/trackers","role":"collection","kind":"symbol","type":"topic"},"doc://EventMacros/documentation/EventMacros":{"url":"\/documentation\/eventmacros","abstract":[],"title":"EventMacros","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","role":"collection","kind":"symbol","type":"topic"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"url":"\/documentation\/grdbpersistence","abstract":[],"title":"GRDBPersistence","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","role":"collection","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"url":"\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},"doc://TrackingPlans/documentation/TrackingPlans":{"url":"\/documentation\/trackingplans","abstract":[],"title":"TrackingPlans","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","role":"collection","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","type":"topic","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"url":"\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"title":"Tracking Events","url":"\/documentation\/traffluent\/trackingevents","role":"article","kind":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","title":"Identifying People","url":"\/documentation\/traffluent\/identifyingpeople","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"role":"article","kind":"article","type":"topic"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"url":"\/documentation\/loggingdestinations","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","type":"topic","title":"LoggingDestinations"},"doc://StandardContext/documentation/StandardContext":{"url":"\/documentation\/standardcontext","abstract":[],"title":"StandardContext","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","role":"collection","kind":"symbol","type":"topic"},"doc://AppKitTracking/documentation/AppKitTracking":{"url":"\/documentation\/appkittracking","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"topic","title":"AppKitTracking"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"title":"Choosing Destinations","url":"\/documentation\/traffluent\/choosingdestinations","role":"article","kind":"article","type":"topic"},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"topic","title":"Destinations"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"url":"\/documentation\/trackingplantesting","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","type":"topic","title":"TrackingPlanTesting"},"doc://TrackerTesting/documentation/TrackerTesting":{"url":"\/documentation\/trackertesting","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","type":"topic","title":"TrackerTesting"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"url":"\/documentation\/lifecycletracking","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","type":"topic","title":"LifecycleTracking"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","url":"\/documentation\/traffluent\/samplingevents","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"role":"article","kind":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"url":"\/documentation\/traffluent\/privacymanifests","title":"Privacy Manifests","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"},"doc://Events/documentation/Events":{"title":"Events","abstract":[],"identifier":"doc:\/\/Events\/documentation\/Events","url":"\/documentation\/events","role":"collection","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"url":"\/documentation\/traffluent\/consentgating","role":"article","kind":"article","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"topic","title":"Consent Gating"},"doc://Checksums/documentation/Checksums":{"url":"\/documentation\/checksums","abstract":[],"title":"Checksums","identifier":"doc:\/\/Checksums\/documentation\/Checksums","role":"collection","kind":"symbol","type":"topic"},"doc://Persistence/documentation/Persistence":{"url":"\/documentation\/persistence","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"topic","title":"Persistence"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"url":"\/documentation\/traffluent\/trackingplanworkflow","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","title":"Exporting and Checking a Tracking Plan","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"role":"article","kind":"article","type":"topic"},"doc://Sessions/documentation/Sessions":{"url":"\/documentation\/sessions","abstract":[],"title":"Sessions","identifier":"doc:\/\/Sessions\/documentation\/Sessions","role":"collection","kind":"symbol","type":"topic"}}}