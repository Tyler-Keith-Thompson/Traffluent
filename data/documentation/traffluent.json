odifiers."}]},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"role":"article","url":"\/documentation\/traffluent\/definingevents","type":"topic","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","kind":"article","title":"Defining Events"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"abstract":[{"type":"text","text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on"},{"type":"text","text":" "},{"type":"text","text":"each screen."}],"type":"topic","url":"\/documentation\/automaticscreentracking","kind":"symbol","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","title":"AutomaticScreenTracking","role":"collection"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"kind":"symbol","url":"\/documentation\/httpdestinations","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","title":"HTTPDestinations","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"role":"collection"},"doc://UIKitTracking/documentation/UIKitTracking":{"abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"type":"topic","url":"\/documentation\/uikittracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","kind":"symbol","title":"UIKitTracking","role":"collection"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","url":"\/documentation\/traffluent\/gettingstarted","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"title":"Getting Started","role":"article"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"kind":"symbol","type":"topic","url":"\/documentation\/collectorencoding","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" to send.","type":"text"}],"title":"CollectorEncoding","role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","type":"topic","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","kind":"article","title":"Exporting and Checking a Tracking Plan"},"doc://Sessions/documentation/Sessions":{"role":"collection","url":"\/documentation\/sessions","identifier":"doc:\/\/Sessions\/documentation\/Sessions","abstract":[{"type":"text","text":"Put every event a tracker tracks in a session, and sample whole sessions."}],"type":"topic","kind":"symbol","title":"Sessions"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"kind":"article","role":"article","title":"Privacy Manifests","url":"\/documentation\/traffluent\/privacymanifests","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","type":"topic","abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}]},"doc://PropertyJSON/documentation/PropertyJSON":{"abstract":[],"url":"\/documentation\/propertyjson","type":"topic","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","kind":"symbol","title":"PropertyJSON","role":"collection"},"doc://EventMacros/documentation/EventMacros":{"kind":"symbol","role":"collection","title":"EventMacros","url":"\/documentation\/eventmacros","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","type":"topic","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"type":"topic","kind":"article","url":"\/documentation\/traffluent\/identifyingpeople","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","abstract":[{"text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent.","type":"text"}],"title":"Identifying People"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"type":"topic","kind":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"title":"Sessions and Standard Context"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"role":"article","url":"\/documentation\/traffluent\/automatictracking","type":"topic","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","kind":"article","title":"Automatic Tracking"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"type":"topic","kind":"symbol","url":"\/documentation\/lifecycletracking","role":"collection","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","abstract":[{"text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s records durable as the app leaves the foreground.","type":"text"}],"title":"LifecycleTracking"}}}