{"sections":[],"topicSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"anchor":"Essentials","title":"Essentials"},{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"anchor":"Guides","title":"Guides"},{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"anchor":"Choosing-what-to-record","title":"Choosing what to record"},{"identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","doc:\/\/PropertyJSON\/documentation\/PropertyJSON","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"],"anchor":"Modules","title":"Modules"},{"identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"],"anchor":"Testing","title":"Testing"}],"abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent"]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Each event is a struct, so the compiler checks its name and every property. A tracker holds back","type":"text"},{"text":" ","type":"text"},{"text":"the events the user hasn’t consented to, stamps the rest with their session and device, keeps them","type":"text"},{"text":" ","type":"text"},{"text":"on disk and delivers them to your server, sending again when the network or the server fails.","type":"text"}],"type":"paragraph"},{"text":"An app’s analytics, from launch","level":3,"anchor":"An-apps-analytics-from-launch","type":"heading"},{"inlineContent":[{"text":"Declare the events. The tracker rejects an event that breaks a constraint before it is stored or","type":"text"},{"text":" ","type":"text"},{"text":"delivered, and a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value reaches only the destinations that don’t redact it:","type":"text"}],"type":"paragraph"},{"code":["import SwiftUI","import Traffluent","import TrackingPlans","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart {","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Build the tracker and start its delivery once, as the app launches:"}],"type":"paragraph"},{"code":["func startAnalytics(consent: Consent) throws -> Tracker {","    let plan = try TrackingPlan(schemas: [","        ProductAddedToCart.schema, SignedUp.schema, SessionStarted.schema, SessionEnded.schema,","    ])","    \/\/ Records wait on disk until they are delivered, across launches.","    let store = try SegmentStore(events: [","        ProductAddedToCart.self, SignedUp.self, SessionStarted.self, SessionEnded.self,","    ])","    \/\/ Every event gets its session, and the app, device, OS, locale and network it was tracked on.","    let tracker = Tracker(","        store: store,","        consent: consent,","        enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()])","","    let collector = HTTPDestination(","        endpoint: collectorURL,","        headerFields: [.authorization: \"Bearer \\(apiKey)\"],","        encoder: CollectorBatchEncoder(plan: plan))","    \/\/ Analytics events only, without their email addresses, 20 at a time or every 30 seconds.","    let delivery = tracker.records.batch().deliver(","        to: collector.accepting(.analytics).redactingSensitiveValues())","    Task {","        do {","            try await delivery.execute()  \/\/ for the life of the app","        } catch {","            print(\"Delivery stopped: \\(error)\")","        }","    }","","    \/\/ Every event that won't arrive, and why.","    let rejections = tracker.rejectionReports","    let consentDrops = consent.dropReports","    let storeDrops = store.dropReports","    let collectorDrops = collector.dropReports","    Task {","        await withDiscardingTaskGroup { group in","            group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","            group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","            group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","            group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        }","    }","    return tracker","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Then make the tracker the app’s default and hand it to the views, which track through it:","type":"text"}],"type":"paragraph"},{"code":["@main","struct StoreApp: App {","    let tracker: Tracker","","    init() {","        do {","            \/\/ The user's earlier decisions, which the app saved; undecided categories wait in memory.","            let tracker = try startAnalytics(consent: Consent(savedDecisions))","            \/\/ `Tracker.current` falls back to it where nothing else reaches, such as a detached task.","            try Tracker.bootstrap(tracker)","            self.tracker = tracker","        } catch {","            print(\"Analytics are off: \\(error)\")","            tracker = .noOp","        }","    }","","    var body: some Scene {","        WindowGroup {","            CartView()","                .tracker(tracker)","        }","    }","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            tracker.track(ProductAddedToCart(productID: \"canvas-tote\", quantity: 1))","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" imports every module except "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true},{"type":"text","text":" and the testing modules, which are products of their own."}],"type":"paragraph"},{"text":"Where to go next","level":3,"anchor":"Where-to-go-next","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Set it up step by step, from adding the package to testing what you track: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Declare events and their constraints: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},{"type":"text","text":"; change one that has shipped:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Track from SwiftUI, UIKit and AppKit views: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"reference","isActive":true},{"type":"text","text":"; let screens, controls and"},{"type":"text","text":" "},{"type":"text","text":"the app’s lifecycle track themselves: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Reach the tracker from any code, batch records and add context to them: "},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep events when the app ends or goes offline before delivering them: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Ask for consent and gate events by it: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Keep a fraction of events or sessions: ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Group events into sessions and stamp them with the app and device: ","type":"text"},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A session’s key is a UUIDv7, its start time in Unix milliseconds followed by random bits, held in","type":"text"},{"text":" ","type":"text"},{"text":"memory only.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Export the events’ schemas and catch breaking changes in CI: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Test what your code tracks: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Send to logs, traces, your own server, PostHog or memory, with values for one destination","type":"text"},{"text":" ","type":"text"},{"text":"alone: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Decide what belongs in an event and what stays out of it: ","type":"text"},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","isActive":true},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"modules":[{"name":"Traffluent"}],"externalID":"Traffluent","title":"Traffluent","role":"collection","symbolKind":"module","roleHeading":"Framework"},"hierarchy":{"paths":[[]]},"references":{"doc://Persistence/documentation/Persistence":{"role":"collection","url":"\/documentation\/persistence","identifier":"doc:\/\/Persistence\/documentation\/Persistence","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"type":"topic","kind":"symbol","title":"Persistence"},"doc://Events/documentation/Events":{"kind":"symbol","role":"collection","title":"Events","identifier":"doc:\/\/Events\/documentation\/Events","url":"\/documentation\/events","type":"topic","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}]},"doc://TrackerTesting/documentation/TrackerTesting":{"abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}],"url":"\/documentation\/trackertesting","type":"topic","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","kind":"symbol","title":"TrackerTesting","role":"collection"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"kind":"symbol","url":"\/documentation\/posthogencoding","type":"topic","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","title":"PostHogEncoding","abstract":[{"text":"Write batches of records for PostHog’s batch capture API, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"role":"collection"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"kind":"article","role":"article","title":"Logging, Tracing, Metrics and Analytics","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","url":"\/documentation\/traffluent\/whatgoeswhere","type":"topic","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"role":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"kind":"article","title":"Testing What Your Code Tracks"},"doc://Checksums/documentation/Checksums":{"abstract":[{"type":"text","text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it."}],"url":"\/documentation\/checksums","type":"topic","identifier":"doc:\/\/Checksums\/documentation\/Checksums","kind":"symbol","title":"Checksums","role":"collection"},"doc://TrackingPlans/documentation/TrackingPlans":{"kind":"symbol","role":"collection","title":"TrackingPlans","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","url":"\/documentation\/trackingplans","type":"topic","abstract":[{"text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"type":"topic","kind":"article","url":"\/documentation\/traffluent\/consentgating","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"title":"Consent Gating"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"type":"topic","kind":"article","url":"\/documentation\/traffluent\/samplingevents","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"title":"Sampling Events"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"kind":"symbol","role":"collection","title":"AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"topic","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"role":"article","url":"\/documentation\/traffluent\/changingevents","type":"topic","abstract":[{"text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","kind":"article","title":"Changing an Event"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"url":"\/documentation\/trackingplantesting","type":"topic","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","kind":"symbol","title":"TrackingPlanTesting","role":"collection"},"doc://Destinations/documentation/Destinations":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations","url":"\/documentation\/destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"title":"Destinations","role":"collection"},"doc://StandardContext/documentation/StandardContext":{"type":"topic","kind":"symbol","url":"\/documentation\/standardcontext","role":"collection","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"title":"StandardContext"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"role":"collection","url":"\/documentation\/loggingdestinations","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","title":"LoggingDestinations"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"role":"article","url":"\/documentation\/traffluent\/persistingrecords","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"type":"topic","kind":"article","title":"Persisting Records"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"role":"article","url":"\/documentation\/traffluent\/trackingfromviews","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"type":"topic","kind":"article","title":"Tracking from SwiftUI, UIKit and AppKit"},"doc://AppKitTracking/documentation/AppKitTracking":{"kind":"symbol","role":"collection","title":"AppKitTracking","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","url":"\/documentation\/appkittracking","type":"topic","abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}]},"doc://GRDBPersistence/documentation/GRDBPersistence":{"url":"\/documentation\/grdbpersistence","kind":"symbol","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","type":"topic","title":"GRDBPersistence","abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","url":"\/documentation\/traffluent\/trackingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to