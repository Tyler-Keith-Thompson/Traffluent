pe":"topic","role":"collection","title":"Persistence","abstract":[],"url":"\/documentation\/persistence","kind":"symbol"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","type":"topic","role":"collection","title":"LoggingDestinations","abstract":[],"url":"\/documentation\/loggingdestinations","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"title":"Defining Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","role":"article","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"kind":"article","url":"\/documentation\/traffluent\/definingevents"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"url":"\/documentation\/traffluent\/trackingplanworkflow","type":"topic","title":"Exporting and Checking a Tracking Plan","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","kind":"article","role":"article","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}]},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"topic","role":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"kind":"article","url":"\/documentation\/traffluent\/consentgating"},"doc://UIKitTracking/documentation/UIKitTracking":{"title":"UIKitTracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"topic","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/uikittracking"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"topic","role":"article","title":"Identifying People","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"url":"\/documentation\/traffluent\/identifyingpeople","kind":"article"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"title":"TrackingPlanTesting","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","type":"topic","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/trackingplantesting"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"url":"\/documentation\/traffluent\/whatgoeswhere","type":"topic","title":"Logging, Tracing, Metrics and Analytics","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","kind":"article","role":"article","abstract":[{"type":"text","text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it."}]},"doc://EventMacros/documentation/EventMacros":{"title":"EventMacros","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","type":"topic","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/eventmacros"}}}