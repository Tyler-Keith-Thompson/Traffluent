{"abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each event is a struct, so the compiler checks its name and every property. A tracker holds back","type":"text"},{"text":" ","type":"text"},{"text":"the events the user hasn’t consented to, stamps the rest with their session and device, keeps them","type":"text"},{"text":" ","type":"text"},{"text":"on disk and delivers them to your server, sending again when the network or the server fails.","type":"text"}]},{"level":3,"type":"heading","text":"An app’s analytics, from launch","anchor":"An-apps-analytics-from-launch"},{"type":"paragraph","inlineContent":[{"text":"Declare the events. The tracker rejects an event that breaks a constraint before it is stored or","type":"text"},{"text":" ","type":"text"},{"text":"delivered, and a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value reaches only the destinations that don’t redact it:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import Traffluent","import TrackingPlans","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart {","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build the tracker and start its delivery once, as the app launches:"}]},{"syntax":"swift","type":"codeListing","code":["func startAnalytics(consent: Consent) throws -> Tracker {","    let plan = try TrackingPlan(schemas: [","        ProductAddedToCart.schema, SignedUp.schema, SessionStarted.schema, SessionEnded.schema,","    ])","    \/\/ Records wait on disk until they are delivered, across launches.","    let store = try SegmentStore(events: [","        ProductAddedToCart.self, SignedUp.self, SessionStarted.self, SessionEnded.self,","    ])","    \/\/ Every event gets its session, and the app, device, OS, locale and network it was tracked on.","    let tracker = Tracker(","        store: store,","        consent: consent,","        enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()])","","    let collector = HTTPDestination(","        endpoint: collectorURL,","        headerFields: [.authorization: \"Bearer \\(apiKey)\"],","        encoder: CollectorBatchEncoder(plan: plan))","    \/\/ Analytics events only, without their email addresses, 20 at a time or every 30 seconds.","    let delivery = tracker.records.batch().deliver(","        to: collector.accepting(.analytics).redactingSensitiveValues())","    Task {","        do {","            try await delivery.execute()  \/\/ for the life of the app","        } catch {","            print(\"Delivery stopped: \\(error)\")","        }","    }","","    \/\/ Every event that won't arrive, and why.","    let rejections = tracker.rejectionReports","    let consentDrops = consent.dropReports","    let storeDrops = store.dropReports","    let collectorDrops = collector.dropReports","    Task {","        await withDiscardingTaskGroup { group in","            group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","            group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","            group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","            group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        }","    }","    return tracker","}"]},{"type":"paragraph","inlineContent":[{"text":"Then make the tracker the app’s default and hand it to the views, which track through it:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@main","struct StoreApp: App {","    let tracker: Tracker","","    init() {","        do {","            \/\/ The user's earlier decisions, which the app saved; undecided categories wait in memory.","            let tracker = try startAnalytics(consent: Consent(savedDecisions))","            \/\/ `Tracker.current` falls back to it where nothing else reaches, such as a detached task.","            try Tracker.bootstrap(tracker)","            self.tracker = tracker","        } catch {","            print(\"Analytics are off: \\(error)\")","            tracker = .noOp","        }","    }","","    var body: some Scene {","        WindowGroup {","            CartView()","                .tracker(tracker)","        }","    }","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            tracker.track(ProductAddedToCart(productID: \"canvas-tote\", quantity: 1))","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"text":" imports every module except ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","type":"reference","isActive":true},{"text":" and the testing modules, which are products of their own.","type":"text"}]},{"level":3,"type":"heading","text":"Where to go next","anchor":"Where-to-go-next"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set it up step by step, from adding the package to testing what you track: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Declare events and their constraints: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","isActive":true,"type":"reference"},{"text":"; change one that has shipped:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Track from SwiftUI, UIKit and AppKit views: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"},{"type":"text","text":"; let screens, controls and"},{"type":"text","text":" "},{"type":"text","text":"the app’s lifecycle track themselves: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Reach the tracker from any code, batch records and add context to them: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep events when the app ends or goes offline before delivering them: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ask for consent and gate events by it: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep a fraction of events or sessions: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Group events into sessions and stamp them with the app and device: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A session’s key is a UUIDv7, its start time in Unix milliseconds followed by random bits, held in"},{"type":"text","text":" "},{"type":"text","text":"memory only."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Export the events’ schemas and catch breaking changes in CI: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Test what your code tracks: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Send to logs, traces, your own server, PostHog or memory, with values for one destination"},{"type":"text","text":" "},{"type":"text","text":"alone: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decide what belongs in an event and what stays out of it: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere"},{"type":"text","text":", "},{"type":"reference","isActive":true,"id