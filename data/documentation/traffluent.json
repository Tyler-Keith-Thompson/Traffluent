documentation\/EventMacros","type":"topic","title":"EventMacros","role":"collection"},"doc://TracingDestinations/documentation/TracingDestinations":{"url":"\/documentation\/tracingdestinations","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","abstract":[],"role":"collection","type":"topic","title":"TracingDestinations","kind":"symbol"},"doc://UIKitTracking/documentation/UIKitTracking":{"abstract":[],"kind":"symbol","url":"\/documentation\/uikittracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"topic","title":"UIKitTracking","role":"collection"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"url":"\/documentation\/grdbpersistence","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","abstract":[],"role":"collection","type":"topic","title":"GRDBPersistence","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"abstract":[{"text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent.","type":"text"}],"kind":"article","url":"\/documentation\/traffluent\/identifyingpeople","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"topic","title":"Identifying People","role":"article"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","url":"\/documentation\/lifecycletracking","abstract":[],"role":"collection","type":"topic","title":"LifecycleTracking","kind":"symbol"},"doc://Checksums/documentation/Checksums":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/Checksums\/documentation\/Checksums","url":"\/documentation\/checksums","type":"topic","title":"Checksums","role":"collection"},"doc://Persistence/documentation/Persistence":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","url":"\/documentation\/persistence","abstract":[],"role":"collec