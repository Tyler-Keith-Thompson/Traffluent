ingDestinations\/documentation\/TracingDestinations","title":"TracingDestinations"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"url":"\/documentation\/traffluent\/definingevents","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"type":"topic","title":"Defining Events","kind":"article"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"url":"\/documentation\/lifecycletracking","role":"collection","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s records durable as the app leaves the foreground."}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","title":"LifecycleTracking"},"doc://StandardContext/documentation/StandardContext":{"url":"\/documentation\/standardcontext","role":"collection","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"type":"topic","title":"StandardContext","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"url":"\/documentation\/traffluent\/changingevents","role":"article","kind":"article","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","title":"Changing an Event"},"doc://GRDBPersistence/documentation/GRDBPersistence":{