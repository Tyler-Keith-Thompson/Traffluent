mentation\/sessions","kind":"symbol"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"abstract":[],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","url":"\/documentation\/swiftuitracking","role":"collection","kind":"symbol","type":"topic","title":"SwiftUITracking"}}}