{"topicSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"]},{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"]},{"title":"Choosing what to record","anchor":"Choosing-what-to-record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"]},{"title":"Modules","anchor":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","doc:\/\/PropertyJSON\/documentation\/PropertyJSON","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"]},{"title":"Testing","anchor":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"]}],"metadata":{"title":"Traffluent","externalID":"Traffluent","symbolKind":"module","modules":[{"name":"Traffluent"}],"roleHeading":"Framework","role":"collection"},"kind":"symbol","sections":[],"abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"An event is a value that conforms to ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":", declared with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"Tracker","type":"codeVoice"},{"text":" is a value: tracking an event records it as an ","type":"text"},{"code":"EventRecord","type":"codeVoice"},{"text":", with its timestamp, the caller’s ","type":"text"},{"code":"SourceLocation","type":"codeVoice"},{"text":" and its ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":", as one of the tracker’s ","type":"text"},{"code":"records","type":"codeVoice"},{"text":". Delivering is a chain of operators over that sequence: Afluent’s ","type":"text"},{"code":"batch(strategy:)","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"batch()","type":"codeVoice"},{"text":", the default) gathers the records into batches, and ","type":"text"},{"code":"deliver(to:)","type":"codeVoice"},{"text":" hands each batch to every destination, as a lazy unit of work. A ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" is a plain sink, narrowed or transformed by its modifiers: ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":" for the consent categories it serves, ","type":"text"},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"droppingCallSite()","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"enriched(by:)","type":"codeVoice"},{"text":", which runs an ","type":"text"},{"code":"Enricher","type":"codeVoice"},{"text":" on the records that destination alone receives. A tracker given a ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":" delivers an event only once the user grants its ","type":"text"},{"code":"ConsentCategory","type":"codeVoice"},{"text":", holding it while undecided and dropping it when denied. ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a ","type":"text"},{"code":"SegmentStore","type":"codeVoice"},{"text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" value, which satisfies its ","type":"text"},{"code":"Refinement","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"Constraint","type":"codeVoice"},{"text":"s from the moment it is made, or carries constraints declared with ","type":"text"},{"code":"@Constrained","type":"codeVoice"},{"text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a ","type":"text"},{"code":"RejectionReport","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"rejectionReports","type":"codeVoice"},{"text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its ","type":"text"},{"code":"ScreenKey","type":"codeVoice"},{"text":" (","type":"text"},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true,"type":"reference"},{"text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene (","type":"text"},{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true,"type":"reference"},{"text":"), and AppKit views find it up their responder chain (","type":"text"},{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","isActive":true,"type":"reference"},{"text":"); a control’s ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with ","type":"text"},{"code":"trackScreensAutomatically","type":"codeVoice"},{"text":", which tracks ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" as each screen’s view controller appears, without swizzling (","type":"text"},{"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","isActive":true,"type":"reference"},{"text":"), and UIKit controls once a window scene turns it on with ","type":"text"},{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":", which tracks ","type":"text"},{"code":"ControlActivated","type":"codeVoice"},{"text":" as a touch activates each control named by its accessibility identifier (","type":"text"},{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","isActive":true,"type":"reference"},{"text":"). On every platform, ","type":"text"},{"code":"trackLifecycle","type":"codeVoice"},{"text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground (","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","isActive":true,"type":"reference"},{"text":"). A tracker given the ","type":"text"},{"code":"Enricher.sessions","type":"codeVoice"},{"text":" enricher stamps every event with its session’s ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking ","type":"text"},{"code":"SessionEnded","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"SessionStarted","type":"codeVoice"},{"text":" (","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true,"type":"reference"},{"text":"). A tracker given ","type":"text"},{"code":"Sampler","type":"codeVoice"},{"text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with ","type":"text"},{"code":"Sampler.sessions(rate:)","type":"codeVoice"},{"text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a ","type":"text"},{"code":"SamplingDropReport","type":"codeVoice"},{"text":" and stamping each kept record with its ","type":"text"},{"code":"SampleRateKey","type":"codeVoice"},{"text":". The standard enrichers, ","type":"text"},{"code":"Enricher.application()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"operatingSystem()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"locale()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"network()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"vendorIdentifier()","type":"codeVoice"},{"text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once (","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" imports "},{"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","isActive":true},{"type":"text","text":", whose "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" macro derives an event’s conformances"},{"type":"text","text":" "},{"type":"text","text":"and schema from its declaration, and every other module but "},{"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true},{"type":"text","text":", a product of its"},{"type":"text","text":" "},{"type":"text","text":"own for apps that already use GRDB; "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","isActive":true},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","isActive":true},{"type":"text","text":", which runs that check from an app’s tests; and "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own."}]},{"type":"codeListing","syntax":"swift","code":["import Traffluent","","@Event","struct SignedUp {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"]}]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent"]}],"references":{"doc://LifecycleTracking/documentation/LifecycleTracking":{"role":"collection","title":"LifecycleTracking","abstract":[{"text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s records durable as the app leaves the foreground.","type":"text"}],"url":"\/documentation\/lifecycletracking","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","type":"topic","kind":"article","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"url":"\/documentation\/traffluent\/choosingdestinations","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","type":"topic","kind":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},"doc://Events/documentation/Events":{"role":"collection","title":"Events","url":"\/documentation\/events","abstract":[{"type":"text","text":"The types every other module shares: the "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" protocol, the values its properties can hold, and the record a tracker makes of each event."}],"identifier":"doc:\/\/Events\/documentation\/Events","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"title":"Defining Events","type":"topic","kind":"article","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"url":"\/documentation\/traffluent\/definingevents","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"title":"Privacy Manifests","type":"topic","kind":"article","abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}],"url":"\/documentation\/traffluent\/privacymanifests","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"role":"article","title":"Tracking from SwiftUI, UIKit and AppKit","url":"\/documentation\/traffluent\/trackingfromviews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","kind":"article","type":"topic"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"title":"AutomaticScreenTracking","type":"topic","kind":"symbol","url":"\/documentation\/automaticscreentracking","abstract":[{"type":"text","text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on"},{"type":"text","text":" "},{"type":"text","text":"each screen."}],"role":"collection","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking"},"doc://EventMacros/documentation/EventMacros":{"role":"collection","title":"EventMacros","url":"\/documentation\/eventmacros","abstract":[{"type":"text","text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy."}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","kind":"symbol","type":"topic"},"doc://TrackingPlans/documentation/TrackingPlans":{"title":"TrackingPlans","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it."}],"url":"\/documentation\/trackingplans","role":"collection","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"role":"article","title":"Identifying People","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"url":"\/documentation\/traffluent\/identifyingpeople","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","kind":"article","type":"topic"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"title":"PostHogEncoding","type":"topic","kind":"symbol","url":"\/documentation\/posthogencoding","abstract":[{"type":"text","text":"Write batches of records for PostHog’s batch capture API, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"role":"collection","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},"doc://Trackers/documentation/Trackers":{"role":"collection","title":"Trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"url":"\/documentation\/trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol","type":"topic"},"doc://Persistence/documentation/Persistence":{"role":"collection","title":"Persistence","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"url":"\/documentation\/persistence","identifier":"doc:\/\/Persistence\/documentation\/Persistence","kind":"symbol","type":"topic"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"title":"LoggingDestinations","type":"topic","kind":"symbol","url":"\/documentation\/loggingdestinations","abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"role":"collection","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"role":"collection","title":"AutomaticControlTracking","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"url":"\/documentation\/automaticcontroltracking","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","type":"topic","kind":"article","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"url":"\/documentation\/traffluent\/persistingrecords","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},"doc://AppKitTracking/documentation/AppKitTracking":{"role":"collection","title":"AppKitTracking","url":"\/documentation\/appkittracking","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","kind":"symbol","type":"topic"},"doc://StandardContext/documentation/StandardContext":{"title":"StandardContext","type":"topic","kind":"symbol","url":"\/documentation\/standardcontext","abstract":[{"type":"text","text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on."}],"role":"collection","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","title":"Tracking Events","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"url":"\/documentation\/traffluent\/trackingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","kind":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"title":"Testing What Your Code Tracks","type":"topic","kind":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"doc://Checksums/documentation/Checksums":{"role":"collection","title":"Checksums","url":"\/documentation\/checksums","abstract":[{"type":"text","text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it."}],"identifier":"doc:\/\/Checksums\/documentation\/Checksums","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"role":"article","title":"Sampling Events","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"url":"\/documentation\/traffluent\/samplingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","kind":"article","type":"topic"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"title":"CollectorEncoding","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" to send."}],"url":"\/documentation\/collectorencoding","role":"collection","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"role":"collection","title":"SwiftUITracking","abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"url":"\/documentation\/swiftuitracking","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","kind":"symbol","type":"topic"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"role":"collection","title":"GRDBPersistence","abstract":[{"type":"text","text":"Keep each record in a table of the app’s own GRDB database until it is delivered."}],"url":"\/documentation\/grdbpersistence","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","type":"topic","kind":"article","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"url":"\/documentation\/traffluent\/automatictracking","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","type":"topic","kind":"symbol","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"url":"\/documentation\/httpdestinations","role":"collection","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://Sessions/documentation/Sessions":{"role":"collection","title":"Sessions","url":"\/documentation\/sessions","abstract":[{"type":"text","text":"Put every event a tracker tracks in a session, and sample whole sessions."}],"identifier":"doc:\/\/Sessions\/documentation\/Sessions","kind":"symbol","type":"topic"},"doc://UIKitTracking/documentation/UIKitTracking":{"title":"UIKitTracking","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"url":"\/documentation\/uikittracking","role":"collection","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},"doc://PropertyJSON/documentation/PropertyJSON":{"role":"collection","title":"PropertyJSON","abstract":[],"url":"\/documentation\/propertyjson","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"role":"article","title":"Changing an Event","abstract":[{"text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it.","type":"text"}],"url":"\/documentation\/traffluent\/changingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","kind":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","type":"topic","kind":"article","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"url":"\/documentation\/traffluent\/sessionsandstandardcontext","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"role":"article","title":"Consent Gating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","kind":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"title":"Getting Started","type":"topic","kind":"article","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"url":"\/documentation\/traffluent\/gettingstarted","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted"},"doc://TrackerTesting/documentation/TrackerTesting":{"role":"collection","title":"TrackerTesting","url":"\/documentation\/trackertesting","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","kind":"symbol","type":"topic"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"title":"TrackingPlanTesting","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"url":"\/documentation\/trackingplantesting","role":"collection","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"doc://Destinations/documentation/Destinations":{"role":"collection","title":"Destinations","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}],"url":"\/documentation\/destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","kind":"symbol","type":"topic"},"doc://TracingDestinations/documentation/TracingDestinations":{"title":"TracingDestinations","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A destination that adds each tracked event to the span that was active when it was tracked."}],"url":"\/documentation\/tracingdestinations","role":"collection","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"role":"article","title":"Logging, Tracing, Metrics and Analytics","url":"\/documentation\/traffluent\/whatgoeswhere","abstract":[{"type":"text","text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","kind":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","type":"topic","kind":"symbol","url":"\/documentation\/traffluent","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"role":"collection","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"}}}