{"topicSections":[{"anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"title":"Essentials"},{"anchor":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"],"title":"Guides"},{"anchor":"Choosing-what-to-record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"title":"Choosing what to record"},{"anchor":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","doc:\/\/HeapEncoding\/documentation\/HeapEncoding","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","doc:\/\/PropertyJSON\/documentation\/PropertyJSON","doc:\/\/JSONValues\/documentation\/JSONValues","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/AsyncQueues\/documentation\/AsyncQueues","doc:\/\/Checksums\/documentation\/Checksums"],"title":"Modules"},{"anchor":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting","doc:\/\/DestinationTesting\/documentation\/DestinationTesting"],"title":"Testing"}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Each event is a struct, so the compiler checks its name and every property. A tracker holds back","type":"text"},{"text":" ","type":"text"},{"text":"the events the user hasn’t consented to, stamps the rest with their session and device, keeps them","type":"text"},{"text":" ","type":"text"},{"text":"on disk and delivers them to your server, sending again when the network or the server fails.","type":"text"}]},{"anchor":"An-apps-analytics-from-launch","text":"An app’s analytics, from launch","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare the events. The tracker rejects an event that breaks a constraint before it is stored or"},{"type":"text","text":" "},{"type":"text","text":"delivered, and a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value reaches only the destinations that don’t redact it:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import Traffluent","import TrackingPlans","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart {","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build the tracker and start its delivery once, as the app launches:"}]},{"syntax":"swift","type":"codeListing","code":["func startAnalytics(consent: Consent) throws -> Tracker {","    \/\/ The plan and the store each take every @Event in the app, and the library's own.","    let plan = try TrackingPlan()","    \/\/ Records wait on disk until they are delivered, across launches.","    let store = try SegmentStore()","    \/\/ Every event gets its session, and the app, device, OS, locale and network it was tracked on.","    let tracker = Tracker(","        store: store,","        consent: consent,","        enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()])","","    let collector = HTTPDestination(","        endpoint: collectorURL,","        headerFields: [.authorization: \"Bearer \\(apiKey)\"],","        encoder: CollectorBatchEncoder(plan: plan))","    \/\/ Analytics events only, without their email addresses, 20 at a time or every 30 seconds.","    let delivery = tracker.records.batch().deliver(","        to: collector.accepting(.analytics).redactingSensitiveValues())","    Task {","        do {","            try await delivery.execute()  \/\/ for the life of the app","        } catch {","            print(\"Delivery stopped: \\(error)\")","        }","    }","","    \/\/ Every event that won't arrive, and why.","    let rejections = tracker.rejectionReports","    let consentDrops = consent.dropReports","    let storeDrops = store.dropReports","    let collectorDrops = collector.dropReports","    Task {","        await withDiscardingTaskGroup { group in","            group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","            group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","            group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","            group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        }","    }","    return tracker","}"]},{"type":"paragraph","inlineContent":[{"text":"Then make the tracker the app’s default and hand it to the views, which track through it:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@main","struct StoreApp: App {","    let tracker: Tracker","","    init() {","        do {","            \/\/ The user's earlier decisions, which the app saved; undecided categories wait in memory.","            let tracker = try startAnalytics(consent: Consent(savedDecisions))","            \/\/ `Tracker.current` falls back to it where nothing else reaches, such as a detached task.","            try Tracker.bootstrap(tracker)","            self.tracker = tracker","        } catch {","            print(\"Analytics are off: \\(error)\")","            tracker = .noOp","        }","    }","","    var body: some Scene {","        WindowGroup {","            CartView()","                .tracker(tracker)","        }","    }","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            tracker.track(ProductAddedToCart(productID: \"canvas-tote\", quantity: 1))","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" imports every module except "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/JSONValues\/documentation\/JSONValues"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},{"type":"text","text":" and the testing modules, which are products of their own."}]},{"anchor":"Where-to-go-next","text":"Where to go next","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Set it up step by step, from adding the package to testing what you track: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare events and their constraints: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},{"type":"text","text":"; change one that has shipped:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Track from SwiftUI, UIKit and AppKit views: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"},{"type":"text","text":"; let screens, controls and"},{"type":"text","text":" "},{"type":"text","text":"the app’s lifecycle track themselves: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Reach the tracker from any code, batch records and add context to them: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Keep events when the app ends or goes offline before delivering them: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ask for consent and gate events by it: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Keep a fraction of events or sessions: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Group events into sessions and stamp them with the app and device: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A session’s key is a UUIDv7, its start time in Unix milliseconds followed by random bits, held in","type":"text"},{"text":" ","type":"text"},{"text":"memory only.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Export the events’ schemas and catch breaking changes in CI: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Test what your code tracks: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Send to logs, traces, your own server, PostHog, Amplitude, Mixpanel, Segment, RudderStack,"},{"type":"text","text":" "},{"type":"text","text":"Customer.io, Google Analytics from a server or memory, with values for one destination alone:"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Send to an analytics vendor not yet covered, from a module of your own:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decide what belongs in an event and what stays out of it: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","type":"reference","isActive":true},{"type":"text","text":"."}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent"]}],"metadata":{"modules":[{"name":"Traffluent"}],"role":"collection","symbolKind":"module","title":"Traffluent","roleHeading":"Framework","externalID":"Traffluent"},"sections":[],"kind":"symbol","abstr