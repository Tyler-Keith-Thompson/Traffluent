{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent"]}],"abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"metadata":{"externalID":"Traffluent","title":"Traffluent","role":"collection","modules":[{"name":"Traffluent"}],"symbolKind":"module","roleHeading":"Framework"},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"]},{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"]},{"title":"Choosing what to record","anchor":"Choosing-what-to-record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"]},{"title":"Modules","anchor":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","doc:\/\/HeapEncoding\/documentation\/HeapEncoding","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","doc:\/\/PropertyJSON\/documentation\/PropertyJSON","doc:\/\/JSONValues\/documentation\/JSONValues","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/AsyncQueues\/documentation\/AsyncQueues","doc:\/\/Checksums\/documentation\/Checksums"]},{"title":"Testing","anchor":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting","doc:\/\/DestinationTesting\/documentation\/DestinationTesting"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event is a struct, so the compiler checks its name and every property. A tracker holds back"},{"type":"text","text":" "},{"type":"text","text":"the events the user hasn’t consented to, stamps the rest with their session and device, keeps them"},{"type":"text","text":" "},{"type":"text","text":"on disk and delivers them to your server, sending again when the network or the server fails."}]},{"type":"heading","level":3,"text":"An app’s analytics, from launch","anchor":"An-apps-analytics-from-launch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare the events. The tracker rejects an event that breaks a constraint before it is stored or"},{"type":"text","text":" "},{"type":"text","text":"delivered, and a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value reaches only the destinations that don’t redact it:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","import Traffluent","import TrackingPlans","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart {","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build the tracker and start its delivery once, as the app launches:"}]},{"type":"codeListing","syntax":"swift","code":["func startAnalytics(consent: Consent) throws -> Tracker {","    \/\/ The plan and the store each take every @Event in the app, and the library's own.","    let plan = try TrackingPlan()","    \/\/ Records wait on disk until they are delivered, across launches.","    let store = try SegmentStore()","    \/\/ Every event gets its session, and the app, device, OS, locale and network it was tracked on.","    let tracker = Tracker(","        store: store,","        consent: consent,","        enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()])","","    let collector = HTTPDestination(","        endpoint: collectorURL,","        headerFields: [.authorization: \"Bearer \\(apiKey)\"],","        encoder: CollectorBatchEncoder(plan: plan))","    \/\/ Analytics events only, without their email addresses, 20 at a time or every 30 seconds.","    let delivery = tracker.records.batch().deliver(","        to: collector.accepting(.analytics).redactingSensitiveValues())","    Task {","        do {","            try await delivery.execute()  \/\/ for the life of the app","        } catch {","            print(\"Delivery stopped: \\(error)\")","        }","    }","","    \/\/ Every event that won't arrive, and why.","    let rejections = tracker.rejectionReports","    let consentDrops = consent.dropReports","    let storeDrops = store.dropReports","    let collectorDrops = collector.dropReports","    Task {","        await withDiscardingTaskGroup { group in","            group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","            group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","            group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","            group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        }","    }","    return tracker","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then make the tracker the app’s default and hand it to the views, which track through it:"}]},{"type":"codeListing","syntax":"swift","code":["@main","struct StoreApp: App {","    let tracker: Tracker","","    init() {","        do {","            \/\/ The user's earlier decisions, which the app saved; undecided categories wait in memory.","            let tracker = try startAnalytics(consent: Consent(savedDecisions))","            \/\/ `Tracker.current` falls back to it where nothing else reaches, such as a detached task.","            try Tracker.bootstrap(tracker)","            self.tracker = tracker","        } catch {","            print(\"Analytics are off: \\(error)\")","            tracker = .noOp","        }","    }","","    var body: some Scene {","        WindowGroup {","            CartView()","                .tracker(tracker)","        }","    }","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            tracker.track(ProductAddedToCart(productID: \"canvas-tote\", quantity: 1))","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"text":" imports every module except ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/