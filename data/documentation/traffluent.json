ection"},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","abstract":[],"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"topic","title":"Destinations","kind":"symbol","role":"collection"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"role":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","type":"topic","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"title":"Testing What Your Code Tracks","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","kind":"article"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","kind":"article","title":"Automatic Tracking","role":"article"},"doc://EventMacros/documentation/EventMacros":{"url":"\/documentation\/eventmacros","abstract":[],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","type":"topic","title":"EventMacros","kind":"symbol","role":"collection"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"role":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","type":"topic","title":"Sessions and Standard Context","kind":"article"},"doc://Events/documentation/Events":{"abstract":[],"url":"\/documentation\/events","identifier":"doc:\/\/Events\/documentation\/Events","type":"topic","title":"Events","kind":"symbol","role":"collection"},"doc://UIKitTracking/documentation/UIKitTracking":{"role":"collection","url":"\/documentation\/uikittracking","title":"UIKitTracking","abstract":[],"type":"topic","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","kind":"symbol"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"role":"collection","type":"topic","title":"LoggingDestinations","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","abstract":[],"url":"\/documentation\/loggingdestinations","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"url":"\/documentation\/traffluent\/choosingdestinations","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"topic","title":"Choosing Destinations","kind":"article","role":"article"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"abstract":[{"type":"text","text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it."}],"url":"\/documentation\/traffluent\/whatgoeswhere","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","type":"topic","kind":"article","title":"Logging, Tracing, Metrics and Analytics","role":"article"},"doc://AppKitTracking/documentation/AppKitTracking":{"role":"collection","url":"\/documentation\/appkittracking","abstract":[],"type":"topic","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","title":"AppKitTracking","kind":"symbol"},"doc://Sessions/documentation/Sessions":{"url":"\/documentation\/sessions","abstract":[],"identifier":"doc:\/\/Sessions\/documentation\/Sessions","kind":"symbol","type":"topic","title":"Sessions","role":"collection"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"role":"article","url":"\/documentation\/traffluent\/identifyingpeople","title":"Identifying People","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"kind":"article"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","type":"topic","title":"Tracking Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent\/trackingevents","kind":"article"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"url":"\/documentation\/traffluent\/consentgating","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"topic","title":"Consent Gating","kind":"article","role":"article"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"role":"collection","url":"\/documentation\/automaticcontroltracking","abstract":[],"type":"topic","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","title":"AutomaticControlTracking","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"role":"article","url":"\/documentation\/traffluent\/samplingevents","title":"Sampling Events","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"kind":"article"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"role":"collection","url":"\/documentation\/httpdestinations","abstract":[],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic","title":"HTTPDestinations","kind":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans":{"role":"collection","url":"\/documentation\/trackingplans","title":"TrackingPlans","type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","abstract":[],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"url":"\/documentation\/traffluent\/trackingfromviews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"topic","title":"Tracking from SwiftUI, UIKit and AppKit","kind":"article","role":"article"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"url":"\/documentation\/automaticscreentracking","abstract":[],"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","kind":"symbol","type":"topic","title":"AutomaticScreenTracking","role":"collection"},"doc://StandardContext/documentation/StandardContext":{"role":"collection","url":"\/documentation\/standardcontext","abstract":[],"type":"topic","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","title":"StandardContext","kind":"symbol"},"doc://TracingDestinations/documentation/TracingDestinations":{"abstract":[],"url":"\/documentation\/tracingdestinations","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","kind":"symbol","title":"TracingDestinations","type":"topic","role":"collection"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"url":"\/documentation\/traffluent\/privacymanifests","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","kind":"article","type":"topic","title":"Privacy Manifests","role":"article"},"doc://Checksums/documentation/Checksums":{"url":"\/documentation\/checksums","abstract":[],"identifier":"doc:\/\/Checksums\/documentation\/Checksums","kind":"symbol","type":"topic","title":"Checksums","role":"collection"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"abstract":[{"text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it.","type":"text"}],"url":"\/documentation\/traffluent\/changingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","kind":"article","type":"topic","title":"Changing an Event","role":"article"}}}