ject through its HTTP V2 API."}],"type":"topic","title":"AmplitudeEncoding"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"kind":"symbol","role":"collection","url":"\/documentation\/httpdestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"type":"topic","title":"HTTPDestinations"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","title":"PostHogEncoding","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}],"role":"collection","url":"\/documentation\/posthogencoding"},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","title":"MixpanelEncoding","type":"topic","kind":"symbol","abstract":[{"text":"Send records to a Mixpanel project through its track API.","type":"text"}],"role":"collection","url":"\/documentation\/mixpanelencoding"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"kind":"symbol","role":"collection","url":"\/documentation\/lifecycletracking","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","abstract":[{"type":"text","text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s records durable as the app leaves the foreground."}],"type":"topic","title":"LifecycleTracking"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","title":"Exporting and Checking a Tracking Plan","type":"topic","kind":"article","abstract":[{"type":"text","text":"Tell the people and services that read your events what each even