gDestinations"},"doc://Trackers/documentation/Trackers":{"title":"Trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"kind":"symbol","url":"\/documentation\/trackers","type":"topic","role":"collection","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://EventMacros/documentation/EventMacros":{"url":"\/documentation\/eventmacros","type":"topic","kind":"symbol","title":"EventMacros","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","abstract":[{"type":"text","text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy."}],"role":"collection"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"abstract":[{"text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s records durable as the app leaves the foreground.","type":"text"}],"title":"LifecycleTracking","kind":"symbol","url":"\/documentation\/lifecycletracking","role":"collection","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","type":"topic"},"doc://TrackerTesting/documentation/TrackerTesting":{"title":"TrackerTesting","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"kind":"symbol","url":"\/documentation\/trackertesting","type":"topic","role":"collection","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},"doc://AppKitTracking/documentation/AppKitTracking":{"title":"AppKitTracking","abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}],"kind":"symbol","url":"\/documentation\/appkittracking","type":"topic","role":"collection","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","type":"topic","kind":"symbol","title":"Destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"role":"collection"},"doc://Checksums/documentation/Checksums":{"url":"\/documentation\/checksums","type":"topic","kind":"symbol","title":"Checksums","identifier":"doc:\/\/Checksums\/documentation\/Checksums","abstract":[{"type":"text","text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it."}],"role":"collection"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"url":"\/documentation\/httpdestinations","type":"topic","kind":"symbol","title":"HTTPDestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"role":"collection"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"kind":"article","url":"\/documentation\/traffluent\/automatictracking","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},"doc://Events/documentation/Events":{"title":"Events","abstract":[{"type":"text","text":"The types every other module shares: the "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" protocol, the values its properties can hold, and the record a tracker makes of each event."}],"kind":"symbol","url":"\/documentation\/events","type":"topic","role":"collection","identifier":"doc:\/\/Events\/documen