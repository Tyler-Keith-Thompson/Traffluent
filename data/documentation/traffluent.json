{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[[]]},"sections":[],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"anchor":"Essentials","title":"Essentials"},{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"],"anchor":"Guides","title":"Guides"},{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"anchor":"Choosing-what-to-record","title":"Choosing what to record"},{"identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","doc:\/\/HeapEncoding\/documentation\/HeapEncoding","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","doc:\/\/PropertyJSON\/documentation\/PropertyJSON","doc:\/\/JSONValues\/documentation\/JSONValues","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/AsyncQueues\/documentation\/AsyncQueues","doc:\/\/Checksums\/documentation\/Checksums"],"anchor":"Modules","title":"Modules"},{"identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting","doc:\/\/DestinationTesting\/documentation\/DestinationTesting"],"anchor":"Testing","title":"Testing"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each event is a struct, so the compiler checks its name and every property. A tracker holds back","type":"text"},{"text":" ","type":"text"},{"text":"the events the user hasn’t consented to, stamps the rest with their session and device, keeps them","type":"text"},{"text":" ","type":"text"},{"text":"on disk and delivers them to your server, sending again when the network or the server fails.","type":"text"}]},{"level":3,"text":"An app’s analytics, from launch","type":"heading","anchor":"An-apps-analytics-from-launch"},{"type":"paragraph","inlineContent":[{"text":"Declare the events. The tracker rejects an event that breaks a constraint before it is stored or","type":"text"},{"text":" ","type":"text"},{"text":"delivered, and a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value reaches only the destinations that don’t redact it:","type":"text"}]},{"code":["import SwiftUI","import Traffluent","import TrackingPlans","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart {","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build the tracker and start its delivery once, as the app launches:"}]},{"code":["func startAnalytics(consent: Consent) throws -> Tracker {","    \/\/ The plan and the store each take every @Event in the app, and the library's own.","    let plan = try TrackingPlan()","    \/\/ Records wait on disk until they are delivered, across launches.","    let store = try SegmentStore()","    \/\/ Every event gets its session, and the app, device, OS, locale and network it was tracked on.","    let tracker = Tracker(","        store: store,","        consent: consent,","        enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()])","","    let collector = HTTPDestination(","        endpoint: collectorURL,","        headerFields: [.authorization: \"Bearer \\(apiKey)\"],","        encoder: CollectorBatchEncoder(plan: plan))","    \/\/ Analytics events only, without their email addresses, 20 at a time or every 30 seconds.","    let delivery = tracker.records.batch().deliver(","        to: collector.accepting(.analytics).redactingSensitiveValues())","    Task {","        do {","            try await delivery.execute()  \/\/ for the life of the app","        } catch {","            print(\"Delivery stopped: \\(error)\")","        }","    }","","    \/\/ Every event that won't arrive, and why.","    let rejections = tracker.rejectionReports","    let consentDrops = consent.dropReports","    let storeDrops = store.dropReports","    let collectorDrops = collector.dropReports","    Task {","        await withDiscardingTaskGroup { group in","            group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","            group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","            group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","            group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        }","    }","    return tracker","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then make the tracker the app’s default and hand it to the views, which track through it:"}]},{"code":["@main","struct StoreApp: App {","    let tracker: Tracker","","    init() {","        do {","            \/\/ The user's earlier decisions, which the app saved; undecided categories wait in memory.","            let tracker = try startAnalytics(consent: Consent(savedDecisions))","            \/\/ `Tracker.current` falls back to it where nothing else reaches, such as a detached task.","            try Tracker.bootstrap(tracker)","            self.tracker = tracker","        } catch {","            print(\"Analytics are off: \\(error)\")","            tracker = .noOp","        }","    }","","    var body: some Scene {","        WindowGroup {","            CartView()","                .tracker(tracker)","        }","    }","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            tracker.track(ProductAddedToCart(productID: \"canvas-tote\", quantity: 1))","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"text":" imports every module except ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/JSONValues\/documentation\/JSONValues"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},{"text":" and the testing modules, which are products of their own.","type":"text"}]},{"level":3,"text":"Where to go next","type":"heading","anchor":"Where-to-go-next"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set it up step by step, from adding the package to testing what you track: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Declare events and their constraints: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","isActive":true,"type":"reference"},{"text":"; change one that has shipped:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Track from SwiftUI, UIKit and AppKit views: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"},{"text":"; let screens, controls and","type":"text"},{"text":" ","type":"text"},{"text":"the app’s lifecycle track themselves: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Reach the tracker from any code, batch records and add context to them: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Keep events when the app ends or goes offline before delivering them: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Ask for consent and gate events by it: ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep a fraction of events or sessions: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Group events into sessions and stamp them with the app and device: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A session’s key is a UUIDv7, its start time in Unix milliseconds followed by random bits, held in"},{"type":"text","text":" "},{"type":"text","text":"memory only."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Export the events’ schemas and catch breaking changes in CI: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Test what your code tracks: ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Send to logs, traces, your own server, PostHog, Amplitude, Mixpanel, Segment, RudderStack,"},{"type":"text","text":" "},{"type":"text","text":"Customer.io, Google Analytics from a server or memory, with values for one destination alone:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Send to an analytics vendor not yet covered, from a module of your own:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Decide what belongs in an event and what stays out of it: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","type":"reference","isActive":true},{"text":".","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"kind":"symbol","metadata":{"modules":[{"name":"Traffluent"}