c:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","kind":"symbol","type":"topic","url":"\/documentation\/automaticcontroltracking","title":"AutomaticControlTracking","role":"collection","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}]},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","role":"article","title":"Choosing Destinations","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"url":"\/documentation\/traffluent\/choosingdestinations","type":"topic","kind":"article"},"doc://Persistence/documentation/Persistence":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","kind":"symbol","type":"topic","url":"\/documentation\/persistence","title":"Persistence","role":"collection","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}]},"doc://CollectorEncoding/documentation/CollectorEncoding":{"kind":"symbol","role":"collection","title":"CollectorEncoding","abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" to send."}],"url":"\/documentation\/collectorencoding","type":"topic","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","kind":"symbol","type":"topic","url":"\/documentation\/amplitudeencoding","title":"AmplitudeEncoding","role":"collection","abstract":[{"text":"Send records to an Amplitude project through its HTTP V2 API.","type":"text"}]},"doc://Events/documentation/Events":{"kind":"symbol","role":"collection","title":"Events","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"url":"\/documentation\/events","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events"},"doc://StandardContext/documentation/StandardContext":{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","kind":"symbol","type":"topic","url":"\/documentation\/standardcontext","title":"StandardContext","role":"collection","abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"kind":"article","role":"article","title":"Exporting and Checking a Tracking Plan","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"url":"\/documentation\/traffluent\/trackingplanworkflow","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","kind":"article","type":"topic","url":"\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","role":"article","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}]},"doc://Destinations/documentation/Destinations":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection","title":"Destinations","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"type":"codeVoice","code":"Destination"},{"text"