"type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"title":"Tracking from SwiftUI, UIKit and AppKit","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","kind":"article","type":"topic","role":"article","url":"\/documentation\/traffluent\/trackingfromviews"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"url":"\/documentation\/traffluent\/samplingevents","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","title":"Sampling Events","role":"article","type":"topic","kind":"article"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"title":"Testing What Your Code Tracks","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","kind":"article","type":"topic","role":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"url":"\/documentation\/posthogencoding","abstract":[{"type":"text","text":"Write batches of records for PostHog’s batch capture API, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","title":"PostHogEncoding","role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"url":"\/documentation\/traffluent\/definingevents","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":", and constrain