{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/traffluent"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent"},"sections":[],"topicSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"title":"Essentials","anchor":"Essentials"},{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"title":"Guides","anchor":"Guides"},{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"title":"Choosing what to record","anchor":"Choosing-what-to-record"},{"identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","doc:\/\/PropertyJSON\/documentation\/PropertyJSON","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"],"title":"Modules","anchor":"Modules"},{"identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"],"title":"Testing","anchor":"Testing"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"An event is a value that conforms to "},{"code":"Event","type":"codeVoice"},{"type":"text","text":", declared with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":". A "},{"code":"Tracker","type":"codeVoice"},{"type":"text","text":" is a value: tracking an event records it as an "},{"code":"EventRecord","type":"codeVoice"},{"type":"text","text":", with its timestamp, the caller’s "},{"code":"SourceLocation","type":"codeVoice"},{"type":"text","text":" and its "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":", as one of the tracker’s "},{"code":"records","type":"codeVoice"},{"type":"text","text":". Delivering is a chain of operators over that sequence: Afluent’s "},{"code":"batch(strategy:)","type":"codeVoice"},{"type":"text","text":" (or "},{"code":"batch()","type":"codeVoice"},{"type":"text","text":", the default) gathers the records into batches, and "},{"code":"deliver(to:)","type":"codeVoice"},{"type":"text","text":" hands each batch to every destination, as a lazy unit of work. A "},{"code":"Destination","type":"codeVoice"},{"type":"text","text":" is a plain sink, narrowed or transformed by its modifiers: "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":" for the consent categories it serves, "},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"droppingCallSite()","type":"codeVoice"},{"type":"text","text":". A tracker given a "},{"code":"Consent","type":"codeVoice"},{"type":"text","text":" delivers an event only once the user grants its "},{"code":"ConsentCategory","type":"codeVoice"},{"type":"text","text":", holding it while undecided and dropping it when denied. "},{"code":"track","type":"codeVoice"},{"type":"text","text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a "},{"code":"SegmentStore","type":"codeVoice"},{"type":"text","text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a "},{"code":"Refined","type":"codeVoice"},{"type":"text","text":" value, which satisfies its "},{"code":"Refinement","type":"codeVoice"},{"type":"text","text":"‘s "},{"code":"Constraint","type":"codeVoice"},{"type":"text","text":"s from the moment it is made, or carries constraints declared with "},{"code":"@Constrained","type":"codeVoice"},{"type":"text","text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a "},{"code":"RejectionReport","type":"codeVoice"},{"type":"text","text":" on "},{"code":"rejectionReports","type":"codeVoice"},{"type":"text","text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its "},{"code":"ScreenKey","type":"codeVoice"},{"type":"text","text":" ("},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"reference","isActive":true},{"type":"text","text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene ("},{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"reference","isActive":true},{"type":"text","text":"), and AppKit views find it up their responder chain ("},{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"reference","isActive":true},{"type":"text","text":"); a control’s "},{"code":"track","type":"codeVoice"},{"type":"text","text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with "},{"code":"trackScreensAutomatically","type":"codeVoice"},{"type":"text","text":", which tracks "},{"code":"ScreenViewed","type":"codeVoice"},{"type":"text","text":" as each screen’s view controller appears, without swizzling ("},{"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","type":"reference","isActive":true},{"type":"text","text":"), and UIKit controls once a window scene turns it on with "},{"code":"trackControlsAutomatically","type":"codeVoice"},{"type":"text","text":", which tracks "},{"code":"ControlActivated","type":"codeVoice"},{"type":"text","text":" as a touch activates each control named by its accessibility identifier ("},{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"reference","isActive":true},{"type":"text","text":"). On every platform, "},{"code":"trackLifecycle","type":"codeVoice"},{"type":"text","text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground ("},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","type":"reference","isActive":true},{"type":"text","text":"). A tracker given the "},{"code":"Enricher.sessions","type":"codeVoice"},{"type":"text","text":" enricher stamps every event with its session’s "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking "},{"code":"SessionEnded","type":"codeVoice"},{"type":"text","text":" and "},{"code":"SessionStarted","type":"codeVoice"},{"type":"text","text":" ("},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"reference","isActive":true},{"type":"text","text":"). A tracker given "},{"code":"Sampler","type":"codeVoice"},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with "},{"code":"Sampler.sessions(rate:)","type":"codeVoice"},{"type":"text","text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a "},{"code":"SamplingDropReport","type":"codeVoice"},{"type":"text","text":" and stamping each kept record with its "},{"code":"SampleRateKey","type":"codeVoice"},{"type":"text","text":". The standard enrichers, "},{"code":"Enricher.application()","type":"codeVoice"},{"type":"text","text":", "},{"code":"device()","type":"codeVoice"},{"type":"text","text":", "},{"code":"operatingSystem()","type":"codeVoice"},{"type":"text","text":", "},{"code":"locale()","type":"codeVoice"},{"type":"text","text":", "},{"code":"network()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"vendorIdentifier()","type":"codeVoice"},{"type":"text","text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once ("},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"text":" imports ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},{"text":", whose ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" macro derives an event’s conformances","type":"text"},{"text":" ","type":"text"},{"text":"and schema from its declaration, and every other module but ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},{"text":", a product of its","type":"text"},{"text":" ","type":"text"},{"text":"own for apps that already use GRDB; ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},{"text":", which runs that check from an app’s tests; and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"code":"withRecordingTracker","type":"codeVoice"},{"text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import Traffluent","","@Event","struct SignedUp {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"syntax":"swift"}]}],"metadata":{"modules":[{"name":"Traffluent"}],"symbolKind":"module","externalID":"Traffluent","title":"Traffluent","role":"collection","roleHeading":"Framework"},"abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"kind":"symbol","references":{"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","url":"\/documentation\/traffluent\/whatgoeswhere","title":"Logging, Tracing, Metrics and Analytics","role":"article"},"doc://PropertyJSON/documentation/PropertyJSON":{"type":"topic","kind":"symbol","abstract":[],"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","url":"\/documentation\/propertyjson","title":"PropertyJSON","role":"collection"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"type":"topic","kind":"article","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","url":"\/documentation\/traffluent\/identifyingpeople","title":"Identifying People","role":"article"},"doc://StandardContext/documentation/StandardContext":{"kind":"symbol","type":"topic","abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","url":"\/documentation\/standardcontext","title":"StandardContext","role":"collection"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan."}],"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","url":"\/documentation\/trackingplantesting","title":"TrackingPlanTesting","role":"collection"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"title":"AutomaticControlTracking","role":"collection","type":"topic","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"kind":"symbol"},"doc://TracingDestinations/documentation/TracingDestinations":{"kind":"symbol","type":"topic","abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","url":"\/documentation\/tracingdestinations","title":"TracingDestinations","role":"collection"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","type":"topic","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"role":"article","url":"\/documentation\/traffluent\/consentgating","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},"doc://TrackerTesting/documentation/TrackerTesting":{"title":"TrackerTesting","type":"topic","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"role":"collection","url":"\/documentation\/trackertesting","kind":"symbol","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},"doc://UIKitTracking/documentation/UIKitTracking":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","url":"\/documentation\/uikittracking","title":"UIKitTracking","role":"collection"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"title":"SwiftUITracking","type":"topic","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"role":"collection","url":"\/documentation\/swiftuitracking","kind":"symbol","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},"doc://Destinations/documentation/Destinations":{"type":"topic","kind":"symbol","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations","url":"\/documentation\/destinations","title":"Destinations","role":"collection"},"doc://AppKitTracking/documentation/AppKitTracking":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","url":"\/documentation\/appkittracking","title":"AppKitTracking","role":"collection"},"doc://Trackers/documentation/Trackers":{"title":"Trackers","role":"collection","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","url":"\/documentation\/trackers","abstract":[{"text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent.","type":"text"}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","type":"topic","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"role":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},"doc://Sessions/documentation/Sessions":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Put every event a tracker tracks in a session, and sample whole sessions."}],"identifier":"doc:\/\/Sessions\/documentation\/Sessions","url":"\/documentation\/sessions","title":"Sessions","role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","type":"topic","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","url":"\/documentation\/traffluent\/trackingevents","title":"Tracking Events","role":"article"},"doc://EventMacros/documentation/EventMacros":{"title":"EventMacros","type":"topic","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"role":"collection","url":"\/documentation\/eventmacros","kind":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","url":"\/documentation\/traffluent\/trackingfromviews","title":"Tracking from SwiftUI, UIKit and AppKit","role":"article"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","url":"\/documentation\/traffluent\/definingevents","title":"Defining Events","role":"article"},"doc://Events/documentation/Events":{"kind":"symbol","type":"topic","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"identifier":"doc:\/\/Events\/documentation\/Events","url":"\/documentation\/events","title":"Events","role":"collection"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"title":"CollectorEncoding","role":"collection","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","type":"topic","url":"\/documentation\/collectorencoding","abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","url":"\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking","role":"article"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"type":"topic","kind":"article","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","url":"\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","role":"article"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","type":"topic","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},"doc://TrackingPlans/documentation/TrackingPlans":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks as a tracking plan, and check the events against the plan committed before them."}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","url":"\/documentation\/trackingplans","title":"TrackingPlans","role":"collection"},"doc://Checksums/documentation/Checksums":{"kind":"symbol","type":"topic","abstract":[{"text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it.","type":"text"}],"identifier":"doc:\/\/Checksums\/documentation\/Checksums","url":"\/documentation\/checksums","title":"Checksums","role":"collection"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"kind":"symbol","type":"topic","abstract":[{"text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s records durable as the app leaves the foreground.","type":"text"}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","url":"\/documentation\/lifecycletracking","title":"LifecycleTracking","role":"collection"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"title":"PostHogEncoding","role":"collection","type":"topic","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","url":"\/documentation\/posthogencoding","abstract":[{"type":"text","text":"Write batches of records for PostHog’s batch capture API, for an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" to send."}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"title":"Changing an Event","type":"topic","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"role":"article","url":"\/documentation\/traffluent\/changingevents","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","role":"collection","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic","url":"\/documentation\/httpdestinations","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"kind":"symbol"},"doc://Persistence/documentation/Persistence":{"title":"Persistence","type":"topic","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"role":"collection","url":"\/documentation\/persistence","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","type":"topic","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"role":"article","url":"\/documentation\/traffluent\/choosingdestinations","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"kind":"symbol","type":"topic","abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"code":"Logger","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","url":"\/documentation\/loggingdestinations","title":"LoggingDestinations","role":"collection"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"title":"Testing What Your Code Tracks","type":"topic","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"role":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"title":"Privacy Manifests","type":"topic","abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}],"role":"article","url":"\/documentation\/traffluent\/privacymanifests","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"title":"AutomaticScreenTracking","role":"collection","type":"topic","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","url":"\/documentation\/automaticscreentracking","abstract":[{"text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on","type":"text"},{"text":" ","type":"text"},{"text":"each screen.","type":"text"}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","type":"topic","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"role":"article","url":"\/documentation\/traffluent\/samplingevents","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"title":"GRDBPersistence","role":"collection","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","type":"topic","url":"\/documentation\/grdbpersistence","abstract":[{"type":"text","text":"Keep each record in a table of the app’s own GRDB database until it is delivered."}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","type":"topic","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"role":"collection","url":"\/documentation\/traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"}}}