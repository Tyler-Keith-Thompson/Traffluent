{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","topicSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"]},{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"]},{"title":"Choosing what to record","anchor":"Choosing-what-to-record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"]},{"title":"Modules","anchor":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"]},{"title":"Testing","anchor":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"]}],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"metadata":{"symbolKind":"module","role":"collection","modules":[{"name":"Traffluent"}],"externalID":"Traffluent","roleHeading":"Framework","title":"Traffluent"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An event is a value conforming to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":". A "},{"type":"codeVoice","code":"Tracker"},{"type":"text","text":" is a value: tracking an event records it as an "},{"type":"codeVoice","code":"EventRecord"},{"type":"text","text":", with its timestamp, the caller’s "},{"type":"codeVoice","code":"SourceLocation"},{"type":"text","text":" and its "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":", as one of the tracker’s "},{"type":"codeVoice","code":"records"},{"type":"text","text":". Delivering is a chain of operators over that sequence: Afluent’s "},{"type":"codeVoice","code":"batch(strategy:)"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"batch()"},{"type":"text","text":", the default) gathers the records into batches, and "},{"type":"codeVoice","code":"deliver(to:)"},{"type":"text","text":" hands each batch to every destination, as a lazy unit of work. A "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" is a plain sink, narrowed or transformed by its modifiers: "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":" for the consent categories it serves, "},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"droppingCallSite()"},{"type":"text","text":". A tracker given a "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":" delivers an event only once the user grants its "},{"type":"codeVoice","code":"ConsentCategory"},{"type":"text","text":", holding it while undecided and dropping it when denied. "},{"type":"codeVoice","code":"track"},{"type":"text","text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value, which satisfies its "},{"type":"codeVoice","code":"Refinement"},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"Constraint"},{"type":"text","text":"s from the moment it is made, or carries constraints declared with "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a "},{"type":"codeVoice","code":"RejectionReport"},{"type":"text","text":" on "},{"type":"codeVoice","code":"rejectionReports"},{"type":"text","text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true},{"type":"text","text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene ("},{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true},{"type":"text","text":"), and AppKit views find it up their responder chain ("},{"type":"reference","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","isActive":true},{"type":"text","text":"); a control’s "},{"type":"codeVoice","code":"track"},{"type":"text","text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with "},{"type":"codeVoice","code":"trackScreensAutomatically"},{"type":"text","text":", which tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" as each screen’s view controller appears, without swizzling ("},{"type":"reference","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","isActive":true},{"type":"text","text":"), and UIKit controls once a window scene turns it on with "},{"type":"codeVoice","code":"trackControlsAutomatically"},{"type":"text","text":", which tracks "},{"type":"codeVoice","code":"ControlActivated"},{"type":"text","text":" as a touch activates each control named by its accessibility identifier ("},{"type":"reference","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","isActive":true},{"type":"text","text":"). On every platform, "},{"type":"codeVoice","code":"trackLifecycle"},{"type":"text","text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground ("},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","isActive":true},{"type":"text","text":"). A tracker given the "},{"type":"codeVoice","code":"Enricher.sessions"},{"type":"text","text":" enricher stamps every event with its session’s "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking "},{"type":"codeVoice","code":"SessionEnded"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true},{"type":"text","text":"). A tracker given "},{"type":"codeVoice","code":"Sampler"},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with "},{"type":"codeVoice","code":"Sampler.sessions(rate:)"},{"type":"text","text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a "},{"type":"codeVoice","code":"SamplingDropReport"},{"type":"text","text":" and stamping each kept record with its "},{"type":"codeVoice","code":"SampleRateKey"},{"type":"text","text":". The standard enrichers, "},{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":", "},{"type":"codeVoice","code":"device()"},{"type":"text","text":", "},{"type":"codeVoice","code":"operatingSystem()"},{"type":"text","text":", "},{"type":"codeVoice","code":"locale()"},{"type":"text","text":", "},{"type":"codeVoice","code":"network()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vendorIdentifier()"},{"type":"text","text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once ("},{"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"text":" imports every module but ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},{"text":", a product of its own for apps","type":"text"},{"text":" ","type":"text"},{"text":"that already use GRDB; ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},{"text":", whose ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" macro derives an event’s conformances","type":"text"},{"text":" ","type":"text"},{"text":"and schema from its declaration and which alone builds swift-syntax; ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},{"text":", which runs that check from an app’s tests; and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"code":"withRecordingTracker","type":"codeVoice"},{"text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own.","type":"text"}]},{"code":["import Traffluent","","struct SignedUp: Event {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"type":"codeListing","syntax":"swift"}]}],"sections":[],"variants":[{"paths":["\/documentation\/traffluent"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"references":{"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"title":"Identifying People","type":"topic","kind":"article","url":"\/documentation\/traffluent\/identifyingpeople","abstract":[{"text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","role":"article"},"doc://Checksums/documentation/Checksums":{"role":"collection","title":"Checksums","kind":"symbol","identifier":"doc:\/\/Checksums\/documentation\/Checksums","url":"\/documentation\/checksums","type":"topic","abstract":[]},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"title":"AutomaticControlTracking","kind":"symbol","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"topic","url":"\/documentation\/automaticcontroltracking","abstract":[],"role":"collection"},"doc://AppKitTracking/documentation/AppKitTracking":{"title":"AppKitTracking","type":"topic","kind":"symbol","url":"\/documentation\/appkittracking","abstract":[],"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","role":"collection"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"role":"collection","title":"HTTPDestinations","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","url":"\/documentation\/httpdestinations","type":"topic","abstract":[]},"doc://LifecycleTracking/documentation/LifecycleTracking":{"role":"collection","title":"LifecycleTracking","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","kind":"symbol","url":"\/documentation\/lifecycletracking","type":"topic","abstract":[]},"doc://LoggingDestinations/documentation/LoggingDestinations":{"title":"LoggingDestinations","kind":"symbol","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","type":"topic","url":"\/documentation\/loggingdestinations","abstract":[],"role":"collection"},"doc://Events/documentation/Events":{"role":"collection","title":"Events","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events","url":"\/documentation\/events","type":"topic","abstract":[]},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"role":"article","title":"Defining Events","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","url":"\/documentation\/traffluent\/definingevents","type":"topic","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}]},"doc://Traffluent/documentation/Traffluent":{"role":"collection","title":"Traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","url":"\/documentation\/traffluent","type":"topic","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}]},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"title":"Tracking Events","type":"topic","kind":"article","url":"\/documentation\/traffluent\/trackingevents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","role":"article"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","type":"topic","kind":"article","url":"\/documentation\/traffluent\/consentgating","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","role":"article"},"doc://TracingDestinations/documentation/TracingDestinations":{"title":"TracingDestinations","kind":"symbol","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","type":"topic","url":"\/documentation\/tracingdestinations","abstract":[],"role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"title":"Tracking from SwiftUI, UIKit and AppKit","type":"topic","kind":"article","url":"\/documentation\/traffluent\/trackingfromviews","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","role":"article"},"doc://TrackingPlans/documentation/TrackingPlans":{"role":"collection","title":"TrackingPlans","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","kind":"symbol","url":"\/documentation\/trackingplans","type":"topic","abstract":[]},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"role":"article","title":"Sampling Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","kind":"article","url":"\/documentation\/traffluent\/samplingevents","type":"topic","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}]},"doc://Destinations/documentation/Destinations":{"role":"collection","title":"Destinations","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations","url":"\/documentation\/destinations","type":"topic","abstract":[]},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","type":"topic","kind":"article","url":"\/documentation\/traffluent\/choosingdestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","role":"article"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"role":"article","title":"Testing What Your Code Tracks","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","kind":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","type":"topic","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}]},"doc://CollectorEncoding/documentation/CollectorEncoding":{"title":"CollectorEncoding","kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","type":"topic","url":"\/documentation\/collectorencoding","abstract":[],"role":"collection"},"doc://StandardContext/documentation/StandardContext":{"title":"StandardContext","type":"topic","kind":"symbol","url":"\/documentation\/standardcontext","abstract":[],"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","role":"collection"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"role":"article","title":"Automatic Tracking","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","url":"\/documentation\/traffluent\/automatictracking","type":"topic","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}]},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"role":"article","title":"Persisting Records","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","url":"\/documentation\/traffluent\/persistingrecords","type":"topic","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}]},"doc://TrackerTesting/documentation/TrackerTesting":{"role":"collection","title":"TrackerTesting","kind":"symbol","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","url":"\/documentation\/trackertesting","type":"topic","abstract":[]},"doc://Sessions/documentation/Sessions":{"role":"collection","title":"Sessions","identifier":"doc:\/\/Sessions\/documentation\/Sessions","kind":"symbol","url":"\/documentation\/sessions","type":"topic","abstract":[]},"doc://Trackers/documentation/Trackers":{"role":"collection","title":"Trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol","url":"\/documentation\/trackers","type":"topic","abstract":[]},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"role":"article","title":"Logging, Tracing, Metrics and Analytics","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","url":"\/documentation\/traffluent\/whatgoeswhere","type":"topic","abstract":[{"type":"text","text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it."}]},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"title":"Changing an Event","type":"topic","kind":"article","url":"\/documentation\/traffluent\/changingevents","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","role":"article"},"doc://EventMacros/documentation/EventMacros":{"role":"collection","title":"EventMacros","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","kind":"symbol","url":"\/documentation\/eventmacros","type":"topic","abstract":[]},"doc://GRDBPersistence/documentation/GRDBPersistence":{"title":"GRDBPersistence","type":"topic","kind":"symbol","url":"\/documentation\/grdbpersistence","abstract":[],"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","role":"collection"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"title":"SwiftUITracking","type":"topic","kind":"symbol","url":"\/documentation\/swiftuitracking","abstract":[],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","type":"topic","kind":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","role":"article"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"title":"TrackingPlanTesting","type":"topic","kind":"symbol","url":"\/documentation\/trackingplantesting","abstract":[],"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","role":"collection"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"role":"collection","title":"AutomaticScreenTracking","kind":"symbol","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","url":"\/documentation\/automaticscreentracking","type":"topic","abstract":[]},"doc://UIKitTracking/documentation/UIKitTracking":{"role":"collection","title":"UIKitTracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","kind":"symbol","url":"\/documentation\/uikittracking","type":"topic","abstract":[]},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","type":"topic","kind":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","role":"article"},"doc://Persistence/documentation/Persistence":{"role":"collection","title":"Persistence","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence","url":"\/documentation\/persistence","type":"topic","abstract":[]},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"title":"Privacy Manifests","type":"topic","kind":"article","url":"\/documentation\/traffluent\/privacymanifests","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","role":"article"}}}