{"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"topicSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"title":"Essentials","anchor":"Essentials"},{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"title":"Guides","anchor":"Guides"},{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"title":"Choosing what to record","anchor":"Choosing-what-to-record"},{"identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"],"title":"Modules","anchor":"Modules"},{"identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"],"title":"Testing","anchor":"Testing"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An event is a value conforming to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":". A "},{"type":"codeVoice","code":"Tracker"},{"type":"text","text":" is a value: tracking an event records it as an "},{"type":"codeVoice","code":"EventRecord"},{"type":"text","text":", with its timestamp, the caller’s "},{"type":"codeVoice","code":"SourceLocation"},{"type":"text","text":" and its "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":", as one of the tracker’s "},{"type":"codeVoice","code":"records"},{"type":"text","text":". Delivering is a chain of operators over that sequence: Afluent’s "},{"type":"codeVoice","code":"batch(strategy:)"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"batch()"},{"type":"text","text":", the default) gathers the records into batches, and "},{"type":"codeVoice","code":"deliver(to:)"},{"type":"text","text":" hands each batch to every destination, as a lazy unit of work. A "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" is a plain sink, narrowed or transformed by its modifiers: "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":" for the consent categories it serves, "},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"droppingCallSite()"},{"type":"text","text":". A tracker given a "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":" delivers an event only once the user grants its "},{"type":"codeVoice","code":"ConsentCategory"},{"type":"text","text":", holding it while undecided and dropping it when denied. "},{"type":"codeVoice","code":"track"},{"type":"text","text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value, which satisfies its "},{"type":"codeVoice","code":"Refinement"},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"Constraint"},{"type":"text","text":"s from the moment it is made, or carries constraints declared with "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a "},{"type":"codeVoice","code":"RejectionReport"},{"type":"text","text":" on "},{"type":"codeVoice","code":"rejectionReports"},{"type":"text","text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true},{"type":"text","text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene ("},{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true},{"type":"text","text":"), and AppKit views find it up their responder chain ("},{"type":"reference","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","isActive":true},{"type":"text","text":"); a control’s "},{"type":"codeVoice","code":"track"},{"type":"text","text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with "},{"type":"codeVoice","code":"trackScreensAutomatically"},{"type":"text","text":", which tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" as each screen’s view controller appears, without swizzling ("},{"type":"reference","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","isActive":true},{"type":"text","text":"), and UIKit controls once a window scene turns it on with "},{"type":"codeVoice","code":"trackControlsAutomatically"},{"type":"text","text":", which tracks "},{"type":"codeVoice","code":"ControlActivated"},{"type":"text","text":" as a touch activates each control named by its accessibility identifier ("},{"type":"reference","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","isActive":true},{"type":"text","text":"). On every platform, "},{"type":"codeVoice","code":"trackLifecycle"},{"type":"text","text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground ("},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","isActive":true},{"type":"text","text":"). A tracker given the "},{"type":"codeVoice","code":"Enricher.sessions"},{"type":"text","text":" enricher stamps every event with its session’s "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking "},{"type":"codeVoice","code":"SessionEnded"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true},{"type":"text","text":"). A tracker given "},{"type":"codeVoice","code":"Sampler"},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with "},{"type":"codeVoice","code":"Sampler.sessions(rate:)"},{"type":"text","text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a "},{"type":"codeVoice","code":"SamplingDropReport"},{"type":"text","text":" and stamping each kept record with its "},{"type":"codeVoice","code":"SampleRateKey"},{"type":"text","text":". The standard enrichers, "},{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":", "},{"type":"codeVoice","code":"device()"},{"type":"text","text":", "},{"type":"codeVoice","code":"operatingSystem()"},{"type":"text","text":", "},{"type":"codeVoice","code":"locale()"},{"type":"text","text":", "},{"type":"codeVoice","code":"network()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vendorIdentifier()"},{"type":"text","text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once ("},{"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" imports every module but "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},{"type":"text","text":", a product of its own for apps"},{"type":"text","text":" "},{"type":"text","text":"that already use GRDB; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},{"type":"text","text":", whose "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" macro derives an event’s conformances"},{"type":"text","text":" "},{"type":"text","text":"and schema from its declaration and which alone builds swift-syntax; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},{"type":"text","text":", which runs that check from an app’s tests; and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose "},{"code":"withRecordingTracker","type":"codeVoice"},{"type":"text","text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own."}],"type":"paragraph"},{"code":["import Traffluent","","struct SignedUp: Event {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent"]}],"metadata":{"role":"collection","modules":[{"name":"Traffluent"}],"symbolKind":"module","roleHeading":"Framework","externalID":"Traffluent","title":"Traffluent"},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"references":{"doc://CollectorEncoding/documentation/CollectorEncoding":{"kind":"symbol","role":"collection","title":"CollectorEncoding","abstract":[],"type":"topic","url":"\/documentation\/collectorencoding","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","title":"AutomaticScreenTracking","url":"\/documentation\/automaticscreentracking","role":"collection"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"title":"Consent Gating","type":"topic","url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"type":"topic","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","title":"Exporting and Checking a Tracking Plan","url":"\/documentation\/traffluent\/trackingplanworkflow","role":"article"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"type":"topic","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","title":"Testing What Your Code Tracks","url":"\/documentation\/traffluent\/testingwhatyoutrack","role":"article"},"doc://Sessions/documentation/Sessions":{"kind":"symbol","role":"collection","title":"Sessions","abstract":[],"type":"topic","url":"\/documentation\/sessions","identifier":"doc:\/\/Sessions\/documentation\/Sessions"},"doc://Checksums/documentation/Checksums":{"kind":"symbol","role":"collection","title":"Checksums","abstract":[],"type":"topic","url":"\/documentation\/checksums","identifier":"doc:\/\/Checksums\/documentation\/Checksums"},"doc://Destinations/documentation/Destinations":{"kind":"symbol","role":"collection","title":"Destinations","abstract":[],"type":"topic","url":"\/documentation\/destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","title":"SwiftUITracking","url":"\/documentation\/swiftuitracking","role":"collection"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"kind":"article","role":"article","title":"Sessions and Standard Context","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"type":"topic","url":"\/documentation\/traffluent\/sessionsandstandardcontext","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},"doc://AppKitTracking/documentation/AppKitTracking":{"kind":"symbol","role":"collection","title":"AppKitTracking","abstract":[],"type":"topic","url":"\/documentation\/appkittracking","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},"doc://TracingDestinations/documentation/TracingDestinations":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","title":"TracingDestinations","url":"\/documentation\/tracingdestinations","role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"type":"topic","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","title":"Tracking from SwiftUI, UIKit and AppKit","url":"\/documentation\/traffluent\/trackingfromviews","role":"article"},"doc://Persistence/documentation/Persistence":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence","title":"Persistence","url":"\/documentation\/persistence","role":"collection"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"type":"topic","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","title":"Identifying People","url":"\/documentation\/traffluent\/identifyingpeople","role":"article"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"type":"topic","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","title":"Persisting Records","url":"\/documentation\/traffluent\/persistingrecords","role":"article"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","title":"AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking","role":"collection"},"doc://EventMacros/documentation/EventMacros":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","title":"EventMacros","url":"\/documentation\/eventmacros","role":"collection"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"kind":"article","role":"article","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"title":"Changing an Event","type":"topic","url":"\/documentation\/traffluent\/changingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"type":"topic","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","title":"Choosing Destinations","url":"\/documentation\/traffluent\/choosingdestinations","role":"article"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"kind":"symbol","role":"collection","title":"TrackingPlanTesting","abstract":[],"type":"topic","url":"\/documentation\/trackingplantesting","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"doc://Trackers/documentation/Trackers":{"kind":"symbol","role":"collection","title":"Trackers","abstract":[],"type":"topic","url":"\/documentation\/trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","role":"article","title":"Tracking Events","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"type":"topic","url":"\/documentation\/traffluent\/trackingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"kind":"article","role":"article","title":"Logging, Tracing, Metrics and Analytics","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}],"type":"topic","url":"\/documentation\/traffluent\/whatgoeswhere","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere"},"doc://TrackingPlans/documentation/TrackingPlans":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","title":"TrackingPlans","url":"\/documentation\/trackingplans","role":"collection"},"doc://TrackerTesting/documentation/TrackerTesting":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","title":"TrackerTesting","url":"\/documentation\/trackertesting","role":"collection"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"kind":"article","role":"article","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"title":"Privacy Manifests","type":"topic","url":"\/documentation\/traffluent\/privacymanifests","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","title":"GRDBPersistence","url":"\/documentation\/grdbpersistence","role":"collection"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"type":"topic","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","title":"Automatic Tracking","url":"\/documentation\/traffluent\/automatictracking","role":"article"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"kind":"article","role":"article","title":"Defining Events","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"type":"topic","url":"\/documentation\/traffluent\/definingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","title":"HTTPDestinations","url":"\/documentation\/httpdestinations","role":"collection"},"doc://StandardContext/documentation/StandardContext":{"kind":"symbol","role":"collection","abstract":[],"title":"StandardContext","type":"topic","url":"\/documentation\/standardcontext","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"},"doc://UIKitTracking/documentation/UIKitTracking":{"kind":"symbol","role":"collection","title":"UIKitTracking","abstract":[],"type":"topic","url":"\/documentation\/uikittracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"kind":"symbol","role":"collection","title":"LoggingDestinations","abstract":[],"type":"topic","url":"\/documentation\/loggingdestinations","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"doc://Events/documentation/Events":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events","title":"Events","url":"\/documentation\/events","role":"collection"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","title":"LifecycleTracking","url":"\/documentation\/lifecycletracking","role":"collection"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"kind":"article","role":"article","title":"Sampling Events","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"type":"topic","url":"\/documentation\/traffluent\/samplingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"doc://Traffluent/documentation/Traffluent":{"type":"topic","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","url":"\/documentation\/traffluent","role":"collection"}}}