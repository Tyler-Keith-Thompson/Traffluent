ffluent\/sessionsandstandardcontext","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","title":"Sessions and Standard Context"},"doc://TracingDestinations/documentation/TracingDestinations":{"title":"TracingDestinations","kind":"symbol","role":"collection","url":"\/documentation\/tracingdestinations","type":"topic","abstract":[{"type":"text","text":"A destination that adds each tracked event to the span that was active when it was tracked."}],"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations"},"doc://Persistence/documentation/Persistence":{"abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"url":"\/documentation\/persistence","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence","title":"Persistence"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","kind":"article","role":"article","url":"\/documentation\/traffluent\/consentgating","type":"topic","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"url":"\/documentation\/traffluent\/writingavendordestination","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","title":"Writing a Vendor Destination"},"doc://EventMacros/documentation/EventMacros":{"title":"EventMacros","kind":"symbol","role":"collection","url":"\/documentation\/eventmacros","type":"topic","abstract":[{"type":"text","text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy."}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},"doc://HeapEncoding/documentation/HeapEncoding":{"abstract":[{"text":"Send records to Heap as custom events, through its server-side bulk track API.","type":"text"}],"url":"\/documentation\/heapencoding","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","title":"HeapEncoding"},"doc://MatomoEncoding/documentation/MatomoEncoding":{"title":"MatomoEncoding","kind":"symbol","role":"collection","url":"\/documentation\/matomoencoding","type":"topic","abstract":[{"type":"text","text":"Send records to a Matomo installation as events, through its bulk tracking API."}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding"},"doc://Events/documentation/Events":{"abstract":[{"type":"text","text":"The types every other module shares: the "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" protocol, the values its properties can hold, and the record a tracker makes of each event."}],"url":"\/documentation\/events","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events","title":"Events"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding":{"title":"SegmentSpecEncoding","kind":"symbol","role":"collection","url":"\/documentation\/segmentspecencoding","type":"topic","abstract":[{"type":"text","text":"Send records as Segment-spec track calls to Segment, RudderStack or Customer.io Data Pipelines."}],"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"url":"\/documentation\/httpdestinations","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","title":"HTTPDestinations"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"title":"LifecycleTracking","kind":"symbol","role":"collection","url":"\/documentation\/lifecycletracking","type":"topic","abstract":[{"text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s records durable as the app leaves the foreground.","type":"text"}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"abstract":[{"type":"text","text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on"},{"type":"text","text":" "},{"type":"text","text":"each screen."}],"url":"\/documentation\/automaticscreentracking","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","title":"AutomaticScreenTracking"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"title":"Getting Started","kind":"article","role":"article","url":"\/documentation\/traffluent\/gettingstarted","type":"topic","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"url":"\/documentation\/traffluent\/definingevents","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","title":"Defining Events"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"title":"AutomaticControlTracking","kind":"symbol","role":"collection","url":"\/documentation\/automaticcontroltracking","type":"topic","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking"},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"url":"\/documentation\/mixpanelencoding","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","title":"MixpanelEncoding"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"title":"GoogleAnalyticsEncoding","kind":"symbol","role":"collection","url":"\/documentation\/googleanalyticsencoding","type":"topic","abstract":[{"text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol.","type":"text"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"url":"\/documentation\/traffluent\/testingwhatyoutrack","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","title":"Testing What Your Code Tracks"},"doc://Destinations/documentation/Destinations":{"title":"Destinations","kind":"symbol","role":"collection","url":"\/documentation\/destinations","type":"topic","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}],"url":"\/documentation\/posthogencoding","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","title":"PostHogEncoding"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","kind":"article","role":"article","url":"\/documentation\/traffluent\/choosingdestinations","type":"topic","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},"doc://JSONValues/documentation/JSONValues":{"abstract":[{"type":"text","text":"A JSON value that renders to the same bytes on every platform and Swift release."}],"url":"\/documentation\/jsonvalues","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/JSONValues\/documentation\/JSONValues","title":"JSONValues"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","kind":"article","role":"article","url":"\/documentation\/traffluent\/samplingevents","type":"topic","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"doc://AppKitTracking/documentation/AppKitTracking":{"abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"url":"\/documentation\/appkittracking","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/A