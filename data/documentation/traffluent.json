ion\/Events","abstract":[{"type":"text","text":"The types every other module shares: the "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" protocol, the values its properties can hold, and the record a tracker makes of each event."}],"type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"role":"article","url":"\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"type":"topic","kind":"article"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"url":"\/documentation\/posthogencoding","abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"topic","title":"PostHogEncoding","role":"collection","kind":"symbol"},"doc://Checksums/documentation/Checksums":{"url":"\/documentation\/checksums","abstract":[{"type":"text","text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it."}],"type":"topic","identifier":"doc:\/\/Checksums\/documentation\/Checksums","title":"Checksums","role":"collection","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"url":"\/documentation\/traffluent\/gettingstarted","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","type":"topic","kind":"article","role":"article","title":"Getting Started","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"url":"\/documentation\/traffluent\/trackingevents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to an