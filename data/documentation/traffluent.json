,"title":"Modules"},{"identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"],"anchor":"Testing","title":"Testing"}],"variants":[{"paths":["\/documentation\/traffluent"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","role":"article","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"url":"\/documentation\/traffluent\/sessionsandstandardcontext","type":"topic"},"doc://TrackerTesting/documentation/TrackerTesting":{"title":"TrackerTesting","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","url":"\/documentation\/trackertesting","type":"topic"},"doc://PropertyJSON/documentation/PropertyJSON":{"title":"PropertyJSON","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","url":"\/documentation\/propertyjson","type":"topic"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","kind":"article","type":"topic","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"role":"article","title":"Defining Events","url":"\/documentation\/traffluent\/definingevents"},"doc://AppKitTracking/documentation/AppKitTracking":{"title":"AppKitTracking","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","url":"\/documentation\/appkittracking","type":"topic"},"doc://Destinations/documentation/Destinations":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","kind":"symbol","type":"topic","abstract":[],"role":"collection","title":"Destinations","url":"\/documentation\/destinations"},"doc://Checksums/documentation/Checksums":{"title":"Checksums","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/Checksums\/documentation\/Checksums","url":"\/documentation\/checksums","type":"topic"},"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","role":"collection","kind":"symbol","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","url":"\/documentation\/traffluent","type":"topic"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"title":"Changing an Event","role":"article","kind":"article","abstract":[{"text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","url":"\/documentation\/traffluent\/changingevents","type":"topic"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","kind":"article","type":"topic","abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}],"role":"article","title":"Privacy Manifests","url":"\/documentation\/traffluent\/privacymanifests"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"title":"TrackingPlanTesting","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/TrackingPlanTesting\/