/persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"doc://TrackerTesting/documentation/TrackerTesting":{"role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"url":"\/documentation\/trackertesting","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","type":"topic","title":"TrackerTesting"},"doc://Traffluent/documentation/Traffluent":{"role":"collection","kind":"symbol","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","url":"\/documentation\/traffluent","type":"topic","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"title":"Defining Events","url":"\/documentation\/traffluent\/definingevents","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"kind":"article","role":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"abstract":[{"type":"text","text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on"},{"type":"text","text":" "},{"type":"text","text":"each screen."}],"role":"collection","type":"topic","kind":"symbol","title":"AutomaticScreenTracking","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","url":"\/documentation\/automaticscreentracking"},"doc://Destinations/documentation/Destinations":