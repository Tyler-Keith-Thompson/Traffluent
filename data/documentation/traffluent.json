:"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","kind":"article","title":"Defining Events","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}]},"doc://EventMacros/documentation/EventMacros":{"url":"\/documentation\/eventmacros","type":"topic","role":"collection","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","kind":"symbol","title":"EventMacros","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}]},"doc://SwiftUITracking/documentation/SwiftUITracking":{"url":"\/documentation\/swiftuitracking","kind":"symbol","role":"collection","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"topic","title":"SwiftUITracking"},"doc://Persistence/documentation/Persistence":{"url":"\/documentation\/persistence","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"topic","title":"Persistence"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"url":"\/documentation\/posthogencoding","type":"topic","role":"collection","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","kind":"symbol","title":"PostHogEncoding","abstract":[{"type":"text","text":"Write batches of records for PostHog’s batch capture API, for an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" to send."}]},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"url":"\/documentation\/traffluent\/identifyingpeople","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","kind":"article","title":"Identifying People","abstract":[{"text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"url":"\/documentation\/traffluent\/samplingevents","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","kind":"article","title":"Sampling Events","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}]},"doc://Trackers/documentation/Trackers":{"url":"\/documentation\/trackers","type":"topic","role":"collection","identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol","title":"Trackers","abstract":[{"text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"url":"\/documentation\/traffluent\/testingwhatyoutrack","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","kind":"article","title":"Testing What Your Code Tracks","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}]},"doc://Events/documentation/Events":{"url":"\/documentation\/events","kind":"symbol","role":"collection","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"identifier":"doc:\/\/Events\/documentation\/Events","type":"topic","title":"Events"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"url":"\/documentation\/automaticscreentracking","kind":"symbol","role":"collection","abstract":[{"text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on","type":"text"},{"text":" ","type":"text"},{"text":"each screen.","type":"text"}],"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","type":"topic","title":"AutomaticScreenTracking"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"url":"\/documentation\/traffluent\/privacymanifests","kind":"article","role":"article","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","type":"topic","title":"Privacy Manifests"},"doc://AppKitTracking/documentation/AppKitTracking":{"kind":"symbol","url":"\/documentation\/appkittracking","role":"collection","abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}],"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"topic","title":"AppKitTracking"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"url":"\/documentation\/automaticcontroltracking","type":"topic","role":"collection","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","kind":"symbol","title":"AutomaticControlTracking","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}]},"doc://StandardContext/documentation/StandardContext":{"kind":"symbol","url":"\/documentation\/standardcontext","role":"collection","abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"topic","title":"StandardContext"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"url":"\/documentation\/trackingplantesting","type":"topic","role":"collection","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","kind":"symbol","title":"TrackingPlanTesting","abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan."}]},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"url":"\/documentation\/traffluent\/sessionsandstandardcontext","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","kind":"article","title":"Sessions and Standard Context","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}]},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent\/trackingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","role":"article","title":"Tracking Events","type":"topic"},"doc://TrackerTesting/documentation/TrackerTesting":{"url":"\/documentation\/trackertesting","type":"topic","role":"collection","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","kind":"symbol","title":"TrackerTesting","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}]},"doc://TracingDestinations/documentation/TracingDestinations":{"url":"\/documentation\/tracingdestinations","type":"topic","role":"collection","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","kind":"symbol","title":"TracingDestinations","abstract":[{"type":"text","text":"A destination that adds each tracked event to the span that was active when it was tracked."}]},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","type":"topic","role":"collection","identifier":"doc:\/\/Destinations\/documentation\/Destinations","kind":"symbol","title":"Destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}]},"doc://LoggingDestinations/documentation/LoggingDestinations":{"kind":"symbol","abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"code":"Logger","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","url":"\/documentation\/loggingdestinations","role":"collection","title":"LoggingDestinations","type":"topic"},"doc://PropertyJSON/documentation/PropertyJSON":{"url":"\/documentation\/propertyjson","type":"topic","role":"collection","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","kind":"symbol","title":"PropertyJSON","abstract":[]},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"url":"\/documentation\/traffluent\/trackingplanworkflow","kind":"article","role":"article","abstract":[{"text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"topic","title":"Exporting and Checking a Tracking Plan"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","kind":"article","role":"article","abstract":[{"type":"text","text":"Track screen views, contro