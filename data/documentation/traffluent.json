{"abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"topicSections":[{"title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"anchor":"Essentials"},{"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"],"anchor":"Guides"},{"title":"Choosing what to record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"anchor":"Choosing-what-to-record"},{"title":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","doc:\/\/PropertyJSON\/documentation\/PropertyJSON","doc:\/\/JSONValues\/documentation\/JSONValues","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/AsyncQueues\/documentation\/AsyncQueues","doc:\/\/Checksums\/documentation\/Checksums"],"anchor":"Modules"},{"title":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting","doc:\/\/DestinationTesting\/documentation\/DestinationTesting"],"anchor":"Testing"}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Each event is a struct, so the compiler checks its name and every property. A tracker holds back"},{"type":"text","text":" "},{"type":"text","text":"the events the user hasn’t consented to, stamps the rest with their session and device, keeps them"},{"type":"text","text":" "},{"type":"text","text":"on disk and delivers them to your server, sending again when the network or the server fails."}],"type":"paragraph"},{"level":3,"anchor":"An-apps-analytics-from-launch","text":"An app’s analytics, from launch","type":"heading"},{"inlineContent":[{"type":"text","text":"Declare the events. The tracker rejects an event that breaks a constraint before it is stored or"},{"type":"text","text":" "},{"type":"text","text":"delivered, and a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value reaches only the destinations that don’t redact it:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import Traffluent","import TrackingPlans","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart {","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Build the tracker and start its delivery once, as the app launches:"}],"type":"paragraph"},{"syntax":"swift","code":["func startAnalytics(consent: Consent) throws -> Tracker {","    \/\/ The plan and the store each take every @Event in the app, and the library's own.","    let plan = try TrackingPlan()","    \/\/ Records wait on disk until they are delivered, across launches.","    let store = try SegmentStore()","    \/\/ Every event gets its session, and the app, device, OS, locale and network it was tracked on.","    let tracker = Tracker(","        store: store,","        consent: consent,","        enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()])","","    let collector = HTTPDestination(","        endpoint: collectorURL,","        headerFields: [.authorization: \"Bearer \\(apiKey)\"],","        encoder: CollectorBatchEncoder(plan: plan))","    \/\/ Analytics events only, without their email addresses, 20 at a time or every 30 seconds.","    let delivery = tracker.records.batch().deliver(","        to: collector.accepting(.analytics).redactingSensitiveValues())","    Task {","        do {","            try await delivery.execute()  \/\/ for the life of the app","        } catch {","            print(\"Delivery stopped: \\(error)\")","        }","    }","","    \/\/ Every event that won't arrive, and why.","    let rejections = tracker.rejectionReports","    let consentDrops = consent.dropReports","    let storeDrops = store.dropReports","    let collectorDrops = collector.dropReports","    Task {","        await withDiscardingTaskGroup { group in","            group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","            group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","            group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","            group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        }","    }","    return tracker","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then make the tracker the app’s default and hand it to the views, which track through it:"}],"type":"paragraph"},{"syntax":"swift","code":["@main","struct StoreApp: App {","    let tracker: Tracker","","    init() {","        do {","            \/\/ The user's earlier decisions, which the app saved; undecided categories wait in memory.","            let tracker = try startAnalytics(consent: Consent(savedDecisions))","            \/\/ `Tracker.current` falls back to it where nothing else reaches, such as a detached task.","            try Tracker.bootstrap(tracker)","            self.tracker = tracker","        } catch {","            print(\"Analytics are off: \\(error)\")","            tracker = .noOp","        }","    }","","    var body: some Scene {","        WindowGroup {","            CartView()","                .tracker(tracker)","        }","    }","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            tracker.track(ProductAddedToCart(productID: \"canvas-tote\", quantity: 1))","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" imports every module except "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/JSONValues\/documentation\/JSONValues"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},{"type":"text","text":" and the testing modules, which are products of their own."}],"type":"paragraph"},{"level":3,"anchor":"Where-to-go-next","text":"Where to go next","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Set it up step by step, from adding the package to testing what you track: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Declare events and their constraints: ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},{"text":"; change one that has shipped:","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Track from SwiftUI, UIKit and AppKit views: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","isActive":true},{"type":"text","text":"; let screens, controls and"},{"type":"text","text":" "},{"type":"text","text":"the app’s lifecycle track themselves: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Reach the tracker from any code, batch records and add context to them: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Keep events when the app ends or goes offline before delivering them: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ask for consent and gate events by it: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Keep a fraction of events or sessions: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Group events into sessions and stamp them with the app and device: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A session’s key is a UUIDv7, its start time in Unix milliseconds followed by random bits, held in"},{"type":"text","text":" "},{"type":"text","text":"memory only."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Export the events’ schemas and catch breaking changes in CI: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","isActive":true,"type":"reference"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Test what your code tracks: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Send to logs, traces, your own server, PostHog, Amplitude, Mixpanel, Segment, RudderStack,"},{"type":"text","text":" "},{"type":"text","text":"Customer.io or memory, with values for one destination alone: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Send to an analytics vendor not yet covered, from a module of your own:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decide what belongs in an event and what stays out of it: "},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","type":"reference"},{"type":"text","text":"."}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/traffluent"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"externalID":"Traffluent","modules":[{"name":"Traffluent"}],"role":"collection","symbolKind":"module","roleHeading":"Framework","title":"Traffluent"},"references":{"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"kind":"article","title":"Exporting and Checking a Tracking Plan","url":"\/documentation\/traffluent\/trackingplanworkflow","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"role":"article"},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"role":"article","type":"topic","title":"Writing a Vendor Destination","kind":"article","abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"url":"\/documentation\/traffluent\/writingavendordestination","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"role":"article","type":"topic","title":"Privacy Manifests","url":"\/documentation\/traffluent\/privacymanifests","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"role":"article","type":"topic","title":"Testing What Your Code Tracks","url":"\/documentation\/traffluent\/testingwhatyoutrack","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}]},"doc://GRDBPersistence/documentation/GRDBPersistence":{"role":"collection","type":"topic","title":"GRDBPersistence","kind":"symbol","url":"\/documentation\/grdbpersistence","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","abstract":[{"type":"text","text":"Keep each record in a table of the app’s own GRDB database until it is delivered."}]},"doc://Sessions/documentation/Sessions":{"role":"collection","url":"\/documentation\/sessions","identifier":"doc:\/\/Sessions\/documentation\/Sessions","title":"Sessions","abstract":[{"text":"Put every event a tracker tracks in a session, and sample whole sessions.","type":"text"}],"type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"role":"article","type":"topic","title":"Changing an Event","kind":"article","url":"\/documentation\/traffluent\/changingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}]},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"role":"article","type":"topic","title":"Getting Started","url":"\/documentation\/traffluent\/gettingstarted","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}]},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"role":"collection","type":"topic","title":"TrackingPlanTesting","kind":"symbol","abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","url":"\/documentation\/trackingplantesting"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"role":"article","type":"topic","title":"Choosing Destinations","url":"\/documentation\/traffluent\/choosingdestinations","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}]},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","type":"topic","title":"Tracking Events","url":"\/documentation\/traffluent\/trackingevents","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"role":"collection","url":"\/documentation\/mixpanelencoding","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","title":"MixpanelEncoding","type":"topic","abstract":[{"text":"Send records to a Mixpanel project through its track API.","type":"text"}],"kind":"symbol"},"doc://TracingDestinations/documentation/TracingDestinations":{"role":"collection","url":"\/documentation\/tracingdestinations","identi