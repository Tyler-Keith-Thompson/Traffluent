ntMacros","type":"topic","title":"EventMacros","kind":"symbol","url":"\/documentation\/eventmacros","abstract":[],"role":"collection"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","type":"topic","abstract":[],"title":"LoggingDestinations","kind":"symbol","url":"\/documentation\/loggingdestinations","role":"collection"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"kind":"symbol","type":"topic","title":"HTTPDestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","url":"\/documentation\/httpdestinations","abstract":[],"role":"collection"},"doc://StandardContext/documentation/StandardContext":{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","kind":"symbol","type":"topic","title":"StandardContext","abstract":[],"url":"\/documentation\/standardcontext","role":"collection"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"title":"SwiftUITracking","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","kind":"symbol","type":"topic","url":"\/documentation\/swiftuitracking","abstract":[],"role":"collection"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"topic","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"title":"Choosing Destinations","kind":"article","url":"\/documentation\/traffluent\/choosingdestinations","role":"article"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","title":"Exporting and Checking a Tracking Plan","abstract":[{"text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it.","type":"text"}],"url":"\/documentation\/traffluent\/trackingplanworkflow","role":"article"},"doc://Sessions/documentation/Sessions":{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"topic","abstract":[],"title":"Sessions","kind":"symbol","url":"\/documentation\/sessions","role":"collection"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"title":"Defining Events","kind":"article","url":"\/documentation\/traffluent\/definingevents","role":"article"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"title":"Automatic Tracking","kind":"article","url":"\/documentation\/traffluent\/automatictracking","role":"article"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","type":"topic","abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}],"title":"Privacy Manifests","kind":"article","url":"\/documentation\/traffluent\/privacymanifests","role":"article"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","type":"topic","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"title":"Sampling Events","kind":"article","url":"\/documentation\/traffluent\/samplingevents","role":"article"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","type":"topic","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"title":"Changing an Event","kind":"article","url":"\/documentation\/traffluent\/changingevents","role":"article"},"doc://Events/documentation/Events":{"identifier":"doc:\/\/Events\/documentation\/Events","type":"topic","abstract":[],"title":"Events","kind":"symbol","url":"\/documentation\/events","role":"collection"},"doc://PropertyJSON/documentation/PropertyJSON":{"kind":"symbol","type":"topic","title":"PropertyJSON","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","url":"\/documentation\/propertyjson","abstract":[],"role":"collection"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"topic","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"title":"Consent Gating","kind":"article","url":"\/documentation\/traffluent\/consentgating","role":"article"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","type":"topic","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"title":"Testing What Your Code Tracks","kind":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","role":"article"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","type":"topic","abstract":[],"title":"LifecycleTracking","kind":"symbol","url":"\/documentation\/lifecycletracking","role":"collection"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"kind":"symbol","type":"topic","title":"CollectorEncoding","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","url":"\/documentation\/collectorencoding","abstract":[],"role":"collection"},"doc://AppKitTracking/documentation/AppKitTracking":{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"topic","abstract":[],"title":"AppKitTracking","kind":"symbol","url":"\/documentation\/appkittracking","role":"collection"},"doc://TracingDestinations/documentation/TracingDestinations":{"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","type":"topic","abstract":[],"title":"TracingDestinations","kind":"symbol","url":"\/documentation\/tracingdestinations","role":"collection"},"doc://TrackerTesting/documentation/TrackerTesting":{"kind":"symbol","type":"topic","title":"TrackerTesting","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","url":"\/documentation\/trackertesting","abstract":[],"role":"collection"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","type":"topic","abstract":[],"title":"GRDBPersistence","kind":"symbol","url":"\/documentation\/grdbpersistence","role":"collection"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","title":"Persisting Records","kind":"article","url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"role":"article"},"doc://Destinations/documentation/Destinations":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"topic","abstract":[],"title":"Destinations","kind":"symbol","url":"\/documentation\/destinations","role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","title":"Tracking Events","type":"topic","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent\/trackingevents","role":"article"},"doc://TrackingPlans/documentation/TrackingPlans":{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","type":"topic","abstract":[],"title":"TrackingPlans","kind":"symbol","url":"\/documentation\/trackingplans","role":"collection"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","type":"topic","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"title":"Sessions and Standard Context","kind":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","role":"article"},"doc://Checksums/documentation/Checksums":{"kind":"symbol","type":"topic","title":"Checksums","identifier":"doc:\/\/Checksums\/documentation\/Checksums","url":"\/documentation\/checksums","abstract":[],"role":"collection"}}}