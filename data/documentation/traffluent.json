{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"anchor":"Essentials"},{"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"anchor":"Guides"},{"title":"Choosing what to record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"anchor":"Choosing-what-to-record"},{"title":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","doc:\/\/PropertyJSON\/documentation\/PropertyJSON","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"],"anchor":"Modules"},{"title":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"],"anchor":"Testing"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An event is a value that conforms to "},{"code":"Event","type":"codeVoice"},{"type":"text","text":", declared with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":". A "},{"code":"Tracker","type":"codeVoice"},{"type":"text","text":" is a value: tracking an event records it as an "},{"code":"EventRecord","type":"codeVoice"},{"type":"text","text":", with its timestamp, the caller’s "},{"code":"SourceLocation","type":"codeVoice"},{"type":"text","text":" and its "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":", as one of the tracker’s "},{"code":"records","type":"codeVoice"},{"type":"text","text":". Delivering is a chain of operators over that sequence: Afluent’s "},{"code":"batch(strategy:)","type":"codeVoice"},{"type":"text","text":" (or "},{"code":"batch()","type":"codeVoice"},{"type":"text","text":", the default) gathers the records into batches, and "},{"code":"deliver(to:)","type":"codeVoice"},{"type":"text","text":" hands each batch to every destination, as a lazy unit of work. A "},{"code":"Destination","type":"codeVoice"},{"type":"text","text":" is a plain sink, narrowed or transformed by its modifiers: "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":" for the consent categories it serves, "},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"type":"text","text":", "},{"code":"droppingCallSite()","type":"codeVoice"},{"type":"text","text":", and "},{"code":"enriched(by:)","type":"codeVoice"},{"type":"text","text":", which runs an "},{"code":"Enricher","type":"codeVoice"},{"type":"text","text":" on the records that destination alone receives. A tracker given a "},{"code":"Consent","type":"codeVoice"},{"type":"text","text":" delivers an event only once the user grants its "},{"code":"ConsentCategory","type":"codeVoice"},{"type":"text","text":", holding it while undecided and dropping it when denied. "},{"code":"track","type":"codeVoice"},{"type":"text","text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a "},{"code":"SegmentStore","type":"codeVoice"},{"type":"text","text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a "},{"code":"Refined","type":"codeVoice"},{"type":"text","text":" value, which satisfies its "},{"code":"Refinement","type":"codeVoice"},{"type":"text","text":"‘s "},{"code":"Constraint","type":"codeVoice"},{"type":"text","text":"s from the moment it is made, or carries constraints declared with "},{"code":"@Constrained","type":"codeVoice"},{"type":"text","text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a "},{"code":"RejectionReport","type":"codeVoice"},{"type":"text","text":" on "},{"code":"rejectionReports","type":"codeVoice"},{"type":"text","text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its "},{"code":"ScreenKey","type":"codeVoice"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},{"type":"text","text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":"), and AppKit views find it up their responder chain ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},{"type":"text","text":"); a control’s "},{"code":"track","type":"codeVoice"},{"type":"text","text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with "},{"code":"trackScreensAutomatically","type":"codeVoice"},{"type":"text","text":", which tracks "},{"code":"ScreenViewed","type":"codeVoice"},{"type":"text","text":" as each screen’s view controller appears, without swizzling ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking"},{"type":"text","text":"), and UIKit controls once a window scene turns it on with "},{"code":"trackControlsAutomatically","type":"codeVoice"},{"type":"text","text":", which tracks "},{"code":"ControlActivated","type":"codeVoice"},{"type":"text","text":" as a touch activates each control named by its accessibility identifier ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking"},{"type":"text","text":"). On every platform, "},{"code":"trackLifecycle","type":"codeVoice"},{"type":"text","text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking"},{"type":"text","text":"). A tracker given the "},{"code":"Enricher.sessions","type":"codeVoice"},{"type":"text","text":" enricher stamps every event with its session’s "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking "},{"code":"SessionEnded","type":"codeVoice"},{"type":"text","text":" and "},{"code":"SessionStarted","type":"codeVoice"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"},{"type":"text","text":"). A tracker given "},{"code":"Sampler","type":"codeVoice"},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with "},{"code":"Sampler.sessions(rate:)","type":"codeVoice"},{"type":"text","text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a "},{"code":"SamplingDropReport","type":"codeVoice"},{"type":"text","text":" and stamping each kept record with its "},{"code":"SampleRateKey","type":"codeVoice"},{"type":"text","text":". The standard enrichers, "},{"code":"Enricher.application()","type":"codeVoice"},{"type":"text","text":", "},{"code":"device()","type":"codeVoice"},{"type":"text","text":", "},{"code":"operatingSystem()","type":"codeVoice"},{"type":"text","text":", "},{"code":"locale()","type":"codeVoice"},{"type":"text","text":", "},{"code":"network()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"vendorIdentifier()","type":"codeVoice"},{"type":"text","text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" imports "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" macro derives an event’s conformances"},{"type":"text","text":" "},{"type":"text","text":"and schema from its declaration, and every other module but "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},{"type":"text","text":", a product of its"},{"type":"text","text":" "},{"type":"text","text":"own for apps that already use GRDB; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},{"type":"text","text":", which runs that check from an app’s tests; and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own."}]},{"type":"codeListing","syntax":"swift","code":["import Traffluent","","@Event","struct SignedUp {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"]}],"kind":"content"}],"abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"hierarchy":{"paths":[[]]},"kind":"symbol","metadata":{"modules":[{"name":"Traffluent"}],"role":"collection","roleHeading":"Framework","symbolKind":"module","title":"Traffluent","externalID":"Traffluent"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent"]}],"references":{"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","role":"article","title":"Exporting and Checking a Tracking Plan","kind":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"type":"topic"},"doc://TrackingPlans/documentation/TrackingPlans":{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","role":"collection","title":"TrackingPlans","kind":"symbol","url":"\/documentation\/trackingplans","abstract":[{"text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it.","type":"text"}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"title":"Tracking from SwiftUI, UIKit and AppKit","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"topic","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/trackingfromviews"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","role":"article","title":"Changing an Event","kind":"article","url":"\/documentation\/traffluent\/changingevents","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"type":"topic"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"title":"TrackingPlanTesting","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/trackingplantesting"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"type":"topic","kind":"article","role":"article","url":"\/documentation\/traffluent\/consentgating"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"title":"Logging, Tracing, Metrics and Analytics","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","type":"topic","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/whatgoeswhere"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","role":"collection","title":"PostHogEncoding","kind":"symbol","url":"\/documentation\/posthogencoding","abstract":[{"type":"text","text":"Write batches of records for PostHog’s batch capture API, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"type":"topic"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","role":"collection","title":"LifecycleTracking","kind":"symbol","url":"\/documentation\/lifecycletracking","abstract":[{"type":"text","text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s records durable as the app leaves the foreground."}],"type":"topic"},"doc://Checksums/documentation/Checksums":{"title":"Checksums","identifier":"doc:\/\/Checksums\/documentation\/Checksums","abstract":[{"text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it.","type":"text"}],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/checksums"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"title":"Identifying People","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"topic","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/identifyingpeople"},"doc://TrackerTesting/documentation/TrackerTesting":{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","role":"collection","title":"TrackerTesting","kind":"symbol","url":"\/documentation\/trackertesting","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}],"type":"topic"},"doc://TracingDestinations/documentation/TracingDestinations":{"title":"TracingDestinations","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","abstract":[{"type":"text","text":"A destination that adds each tracked event to the span that was active when it was tracked."}],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/tracingdestinations"},"doc://Persistence/documentation/Persistence":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","role":"collection","title":"Persistence","kind":"symbol","url":"\/documentation\/persistence","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"type":"topic"},"doc://PropertyJSON/documentation/PropertyJSON":{"title":"PropertyJSON","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","type":"topic","abstract":[],"kind":"symbol","role":"collection","url":"\/documentation\/propertyjson"},"doc://StandardContext/documentation/StandardContext":{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","role":"collection","title":"StandardContext","kind":"symbol","url":"\/documentation\/standardcontext","abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","role":"article","title":"Getting Started","kind":"article","url":"\/documentation\/traffluent\/gettingstarted","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"title":"Tracking Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"type":"topic","kind":"article","role":"article","url":"\/documentation\/traffluent\/trackingevents"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","role":"collection","title":"LoggingDestinations","kind":"symbol","url":"\/documentation\/loggingdestinations","abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"code":"Logger","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"title":"Defining Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/definingevents"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"title":"SwiftUITracking","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/swiftuitracking"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"topic","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/choosingdestinations"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","role":"article","title":"Privacy Manifests","kind":"article","url":"\/documentation\/traffluent\/privacymanifests","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"type":"topic"},"doc://UIKitTracking/documentation/UIKitTracking":{"title":"UIKitTracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"topic","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"kind":"symbol","role":"collection","url":"\/documentation\/uikittracking"},"doc://Destinations/documentation/Destinations":{"title":"Destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/destinations"},"doc://AppKitTracking/documentation/AppKitTracking":{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","role":"collection","title":"AppKitTracking","kind":"symbol","url":"\/documentation\/appkittracking","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"type":"topic"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"title":"AutomaticScreenTracking","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","abstract":[{"text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on","type":"text"},{"text":" ","type":"text"},{"text":"each screen.","type":"text"}],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/automaticscreentracking"},"doc://Trackers/documentation/Trackers":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","role":"collection","title":"Trackers","kind":"symbol","url":"\/documentation\/trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/automatictracking"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"title":"GRDBPersistence","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/grdbpersistence"},"doc://EventMacros/documentation/EventMacros":{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","role":"collection","title":"EventMacros","kind":"symbol","url":"\/documentation\/eventmacros","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"type":"topic"},"doc://Sessions/documentation/Sessions":{"title":"Sessions","identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"topic","abstract":[{"text":"Put every event a tracker tracks in a session, and sample whole sessions.","type":"text"}],"kind":"symbol","role":"collection","url":"\/documentation\/sessions"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","role":"collection","title":"HTTPDestinations","kind":"symbol","url":"\/documentation\/httpdestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"type":"topic"},"doc://Events/documentation/Events":{"title":"Events","identifier":"doc:\/\/Events\/documentation\/Events","abstract":[{"type":"text","text":"The types every other module shares: the "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" protocol, the values its properties can hold, and the record a tracker makes of each event."}],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/events"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/persistingrecords"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","role":"collection","title":"AutomaticControlTracking","kind":"symbol","url":"\/documentation\/automaticcontroltracking","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","type":"topic","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","role":"collection","title":"Traffluent","kind":"symbol","url":"\/documentation\/traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","role":"article","title":"Sampling Events","kind":"article","url":"\/documentation\/traffluent\/samplingevents","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","role":"article","title":"Testing What Your Code Tracks","kind":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"type":"topic"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","role":"collection","title":"CollectorEncoding","kind":"symbol","url":"\/documentation\/collectorencoding","abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"type":"topic"}}}