luent\/documentation\/Traffluent\/DefiningEvents","url":"\/documentation\/traffluent\/definingevents","role":"article"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","url":"\/documentation\/traffluent\/samplingevents","role":"article"},"doc://AppKitTracking/documentation/AppKitTracking":{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","url":"\/documentation\/appkittracking","role":"collection","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"title":"AppKitTracking","kind":"symbol","type":"topic"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"title":"LoggingDestinations","kind":"symbol","type":"topic","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","role":"collection","url":"\/documentation\/loggingdestinations","abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}]},"doc://MatomoEncoding/documentation/MatomoEncoding":{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","url":"\/documentation\/matomoencoding","role":"collection","abstract":[{"type":"text","text":"Send records to a Matomo installation as events, through its bulk tracking API."}],"title":"MatomoEncoding","type":"topic","kind":"symbol"},"doc://TrackerTesting/documentation/TrackerTesting":{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","title":"TrackerTesting","role":"collection","type":"topic","kind":"symbol","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}],"url":"