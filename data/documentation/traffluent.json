ocumentation\/trackingplans","kind":"symbol","type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","title":"TrackingPlans","abstract":[{"text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it.","type":"text"}],"role":"collection"},"doc://TrackerTesting/documentation/TrackerTesting":{"type":"topic","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","title":"TrackerTesting","url":"\/documentation\/trackertesting","role":"collection","kind":"symbol","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}]},"doc://AppKitTracking/documentation/AppKitTracking":{"url":"\/documentation\/appkittracking","kind":"symbol","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"topic","title":"AppKitTracking","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"role":"collection"},"doc://TracingDestinations/documentation/TracingDestinations":{"type":"topic","title":"TracingDestinations","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","url":"\/documentation\/tracingdestinations","role":"collection","kind":"symbol","abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}]},"doc://UIKitTracking/documentation/UIKitTracking":{"url":"\/documentation\/uikittracking","kind":"symbol","type":"topic","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","title":"UIKitTracking","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"role":"collection"},"doc://Sessions/documentation/Sessions":{"type":"topic","identifier":"doc:\/\/Sessions\/documentation\/Sessions","title":"Sessions","url":"\/documentation\/sessions","role":"collection","kind":"symbol","abstract":[{"text":"Put every event a tracker tracks in a session, and sample whole sessions.","type":"text"}]},"doc://GRDBPersistence/documentation/GRDBPersistence":{"type":"topic","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","title":"GRDBPersistence","url":"\/documentation\/grdbpersistence","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Keep each record in a table of the app’s own GRDB database until it is delivered."}]},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"url":"\/documentation\/traffluent\/trackingevents","kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","title":"Tracking Events","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"role":"article"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"url":"\/documentation\/automaticscreentracking","kind":"symbol","type":"topic","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","title":"AutomaticScreenTracking","abstract":[{"text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on","type":"text"},{"text":" ","type":"text"},{"text":"each screen.","type":"text"}],"role":"collection"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"url":"\/documentation\/traffluent\/whatgoeswhere","kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","title":"Logging, Tracing, Metrics and Analytics","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}],"role":"article"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"type":"topic","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","title":"SwiftUITracking","url":"\/documentation\/swiftuitracking","role":"collection","kind":"symbol","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}]}}}