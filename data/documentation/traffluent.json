e":"text"}],"title":"LifecycleTracking","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","title":"Choosing Destinations","role":"article","type":"topic","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"kind":"article","url":"\/documentation\/traffluent\/choosingdestinations"},"doc://Destinations/documentation/Destinations":{"title":"Destinations","kind":"symbol","type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection","url":"\/documentation\/destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"title":"GoogleAnalyticsEncoding","kind":"symbol","type":"topic","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","role":"collection","url":"\/documentation\/googleanalyticsencoding","abstract":[{"type":"text","text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol."}]},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","role":"collection","type":"topic","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"kind":"symbol","url":"\/documentation\/traffluent"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","url":"\/documentation\/collectorencoding","role":"collection","abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" to send."}],"title":"CollectorEncoding","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"title":"Writing a Vendor Destination","abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","url":"\/documentation\/traffluent\/writingavendordestination","role":"article"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","title":"Consent Gating","role":"article","type":"topic","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"kind":"article","url":"\/documentation\/traffluent\/consentgating"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"type":"topic","role":"collection","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","kind":"symbol","url":"\/documentation\/swiftuitracking","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"title":"SwiftUITracking"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","url":"\/documentation\/traffluent\/whatgoeswhere","role":"article","abstract":[{"type":"text","text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it."}],"title":"Logging, Tracing, Metrics and Analytics","type":"topic","kind":"article"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"type":"topic","role":"collection","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","kind":"symbol","url":"\/documentation\/grdbpersistence","abstract":[{"type":"text","text":"Keep each record in a table of the app’s own GRDB database until it is delivered."}],"title":"GRDBPersistence"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","url":"\/documentation\/automaticscreentracking","role":"collection","abstract":[{"text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on","type":"text"},{"text":" ","type":"text"},{"text":"each screen.","type":"text"}],"title":"AutomaticScreenTracking","kind":"symbol","type":"topic"},"doc://Sessions/documentation/Sessions":{"type":"topic","role":"collection","identifier":"doc:\/\/Sessions\/documentation\/Sessions","url":"\/documentation\/sessions","kind":"symbol","abstract":[{"text":"Put every event a tracker tracks in a session, and sample whole sessions.","type":"text"}],"title":"Sessions"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","title":"Persisting Records","role":"article","type":"topic","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"kind":"article","url":"\/documentation\/traffluent\/persistingrecords"},"doc://Events/documentation/Events":{"identifier":"doc:\/\/Events\/documentation\/Events","url":"\/documentation\/events","role":"collection","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"title":"Events","kind":"symbol","type":"topic"},"doc://AsyncQueues/documentation/AsyncQueues":{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues","ti