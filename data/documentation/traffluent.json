:" protocol, the values its properties can hold, and the record a tracker makes of each event."}],"role":"collection"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"kind":"symbol","type":"topic","title":"HTTPDestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"url":"\/documentation\/httpdestinations","role":"collection"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"title":"Sampling Events","url":"\/documentation\/traffluent\/samplingevents","type":"topic","kind":"article"},"doc://HeapEncoding/documentation/HeapEncoding":{"url":"\/documentation\/heapencoding","kind":"symbol","title":"HeapEncoding","type":"topic","abstract":[{"type":"text","text":"Send records to Heap as custom events, through its server-side bulk track API."}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","role":"collection"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"url":"\/documentation\/traffluent\/gettingstarted","kind":"article","title":"Getting Started","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"role":"article"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"url":"\/documentation\/automaticscreentracking","kind":"symbol","title":"AutomaticScreenTracking","type":"topic","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","abstract":[{"type":"text","text":"Track a screen view each time a screen’s view contro