ation\/Trackers","kind":"symbol","title":"Trackers"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"type":"topic","url":"\/documentation\/traffluent\/definingevents","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"kind":"article","title":"Defining Events"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","url":"\/documentation\/loggingdestinations","title":"LoggingDestinations","role":"collection"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"role":"collection","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"topic","url":"\/documentation\/swiftuitracking","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"kind":"symbol","title":"SwiftUITracking"},"doc://Sessions/documentation/Sessions":{"abstract":[{"type":"text","text":"Put every event a tracker tracks in a session, and sample whole sessions."}],"title":"Sessions","type":"topic","kind":"symbol","url":"\/documentation\/sessions","identifier":"doc:\/\/Sessions\/documentation\/Sessions","role":"collection"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"abstract":[{"text":"Send records to an Amplitude project through its HTTP V2 API.","type":"text"}],"title":"AmplitudeEncoding","type":"topic","kind":"symbol","url":"\/documentation\/amplitudeencoding","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncod