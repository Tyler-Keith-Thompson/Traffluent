isk until it is delivered, so the records a tracker tracked survive the app ending."}],"kind":"symbol","url":"\/documentation\/persistence","type":"topic","role":"collection","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"title":"Tracking from SwiftUI, UIKit and AppKit","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"kind":"article","url":"\/documentation\/traffluent\/trackingfromviews","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"url":"\/documentation\/posthogencoding","type":"topic","kind":"symbol","title":"PostHogEncoding","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","abstract":[{"type":"text","text":"Write batches of records for PostHog’s batch capture API, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"role":"collection"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"kind":"article","url":"\/documentation\/traffluent\/persistingrecords","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"title":"Tracking Events","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"kind":"article","url":"\/documentation\/traffluent\/trackingevents","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents"},"doc://StandardContext/documentation/StandardContext":{"url