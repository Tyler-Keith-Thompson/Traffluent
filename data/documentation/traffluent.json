fying People"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" to send."}],"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","kind":"symbol","url":"\/documentation\/collectorencoding","type":"topic","role":"collection","title":"CollectorEncoding"},"doc://Sessions/documentation/Sessions":{"abstract":[{"text":"Put every event a tracker tracks in a session, and sample whole sessions.","type":"text"}],"identifier":"doc:\/\/Sessions\/documentation\/Sessions","kind":"symbol","type":"topic","url":"\/documentation\/sessions","role":"collection","title":"Sessions"},"doc://AsyncQueues/documentation/AsyncQueues":{"role":"collection","type":"topic","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues","abstract":[{"type":"text","text":"The sequence type of every report and delivery stream the library hands out, and of an app’s own, read by one task at a time."}],"kind":"symbol","url":"\/documentation\/asyncqueues","title":"AsyncQueues"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"abstract":[{"type":"text","text":"Send records to an Amplitude project through its HTTP V2 API."}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","kind":"symbol","url":"\/documentation\/amplitudeencoding","type":"topic","role":"collection","title":"AmplitudeEncoding"},"doc://Trackers/documentation/Trackers":{"abstract":[{"text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol","url":"\/documentation\/trackers","type":"topic","role":"collection","title":"Trackers"},"doc://StandardContext/documentation/StandardContext":{"url":"\/documentation\/standardcontext","abstract"