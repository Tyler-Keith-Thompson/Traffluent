],"roleHeading":"Framework","role":"collection","externalID":"Traffluent","title":"Traffluent","symbolKind":"module"},"references":{"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","role":"article","url":"\/documentation\/traffluent\/choosingdestinations","type":"topic","title":"Choosing Destinations","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"kind":"article"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","role":"article","title":"Logging, Tracing, Metrics and Analytics","type":"topic","url":"\/documentation\/traffluent\/whatgoeswhere","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}],"kind":"article"},"doc://Traffluent/documentation/Traffluent":{"role":"collection","url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","type":"topic","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","role":"collection","url":"\/documentation\/httpdestinations","type":"topic","title":"HTTPDestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"kind":"symbol"},"doc://Checksums/documentation/Checksums":{"role":"collection","abstract":[{"text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it.","type":"text"}],"url":"\/documentation\/checksums","kind":"symbol","identifier":"doc:\/\/Checksums\/documentation\/Checksums","type":"topic","title":"Checksums"},"doc://Destinations/documentation/Destinations":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection","title":"Destinations","type":"topic","url":"\/documentation\/destinations","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}],"kind":"symbol"},"doc://Persistence/documentation/Persistence":{"role":"collection","url":"\/documentation\/persistence","identifier":"doc:\/\/Persistence\/documentation\/Persistence","title":"Persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"kind":"symbol","type":"topic"},"doc://SnowplowEncoding/documentation/SnowplowEncoding":{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","role":"collection","url":"\/documentation\/snowplowencoding","type":"topic","title":"SnowplowEncoding","abstract":[{"type":"text","text":"Send records to a Snowplow collector as self-describing events, whose schemas come from the tracking plan."}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"role":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","title":"Testing What Your Code Tracks","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"type":"topic","kind":"article"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","role":"collection","title":"LoggingDestinations","type":"topic","url":"\/documentation\/loggingdestinations","abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"type":"codeVoice","code":"Logger"},{"text":".","type":"text"}],"kind":"symbol"},"doc://AsyncQueues/documentation/AsyncQueues":{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues","role":"collection","url":"\/documentation\/asyncqueues","title":"AsyncQueues","type":"topic","abstract":[{"type":"text","text":"The sequence type of every report and delivery stream the library hands out, and of an app’s own, read by one task at a time."}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"role":"article","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"url":"\/documentation\/traffluent\/sessionsandstandardcontext","kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","title":"Sessions and Standard Context"},"doc://Events/documentation/Events":{"role":"collection","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"url":"\/documentation\/events","kind":"symbol","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events","title":"Events"},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"role":"collection","abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"url":"\/documentation\/mixpanelencoding","kind":"symbol","type":"topic","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","title":"MixpanelEncoding"},"doc://HeapEncoding/documentation/HeapEncoding":{"role":"collection","abstract":[{"text":"Send records to Heap as custom events, through its server-side bulk track API.","type":"text"}],"url":"\/documentation\/heapencoding","kind":"symbol","type":"topic","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","title":"HeapEncoding"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","role":"collection","title":"GRDBPersistence","type":"topic","url":"\/documentation\/grdbpersistence","abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"role":"article","url":"\/documentation\/traffluent\/gettingstarted","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","title":"Getting Started","type":"topic","kind":"article","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}]},"doc://SwiftUITracking/documentation/SwiftUITracking":{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","role":"collection","url":"\/documentation\/swiftuitracking","title":"SwiftUITracking","type":"topic","abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"kind":"symbol"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding":{"role":"collection","abstract":[{"text":"Send records as Segment-spec track calls to Segment, RudderStack or Customer.io Data Pipelines.","type":"text"}],"url":"\/documentation\/segmentspecencoding","kind":"symbol","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","title":"SegmentSpecEncoding","type":"topic"},"doc://AppKitTracking/documentation/AppKitTracking":{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","role":"collection","url":"\/documentation\/appkittracking","type":"topic","title":"AppKitTracking","abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}],"kind":"symbol"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"role":"collection","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"url":"\/documentation\/automaticcontroltracking","kind":"symbol","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"topic","title":"AutomaticControlTracking"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"role":"collection","abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"url":"\/documentation\/posthogencoding","kind":"symbol","type":"topic","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","title":"PostHogEncoding"},"doc://AptabaseEncoding/documentation/AptabaseEncoding":{"role":"collection","abstract":[{"text":"Send records to Aptabase, in its cloud or on your own server, through its events API.","type":"text"}],"url":"\/documentation\/aptabaseencoding","kind":"symbol","type":"topic","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","title":"AptabaseEncoding"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"role":"article","url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","title":"Consent Gating","type":"topic","kind":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}]},"doc://Trackers/documentation/Trackers":{"role":"collection","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"url":"\/documentation\/trackers","kind":"symbol","type":"topic","title":"Trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://Traffluent/documentation/Traffluent/De