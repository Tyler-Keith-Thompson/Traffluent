litting."}],"type":"topic","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","title":"PropertyJSON","role":"collection","kind":"symbol"},"doc://UIKitTracking/documentation/UIKitTracking":{"kind":"symbol","type":"topic","title":"UIKitTracking","url":"\/documentation\/uikittracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"type":"topic","kind":"article"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"kind":"symbol","title":"LoggingDestinations","type":"topic","url":"\/documentation\/loggingdestinations","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"code":"Logger","type":"codeVoice"},{"text":".","type":"text"}],"role":"collection"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"role":"article","url":"\/documentation\/traffluent\/identifyingpeople","title":"Identifying People","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"type":"topic","kind":"article"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"role":"article","url":"\/documentation\/traffluen