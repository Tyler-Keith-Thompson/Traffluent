{"topicSections":[{"title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"anchor":"Essentials"},{"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"anchor":"Guides"},{"title":"Choosing what to record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"anchor":"Choosing-what-to-record"},{"title":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","doc:\/\/PropertyJSON\/documentation\/PropertyJSON","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"],"anchor":"Modules"},{"title":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"],"anchor":"Testing"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"kind":"symbol","variants":[{"paths":["\/documentation\/traffluent"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Framework","symbolKind":"module","modules":[{"name":"Traffluent"}],"title":"Traffluent","role":"collection","externalID":"Traffluent"},"abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"An event is a value conforming to ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"Tracker","type":"codeVoice"},{"text":" is a value: tracking an event records it as an ","type":"text"},{"code":"EventRecord","type":"codeVoice"},{"text":", with its timestamp, the caller’s ","type":"text"},{"code":"SourceLocation","type":"codeVoice"},{"text":" and its ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":", as one of the tracker’s ","type":"text"},{"code":"records","type":"codeVoice"},{"text":". Delivering is a chain of operators over that sequence: Afluent’s ","type":"text"},{"code":"batch(strategy:)","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"batch()","type":"codeVoice"},{"text":", the default) gathers the records into batches, and ","type":"text"},{"code":"deliver(to:)","type":"codeVoice"},{"text":" hands each batch to every destination, as a lazy unit of work. A ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" is a plain sink, narrowed or transformed by its modifiers: ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":" for the consent categories it serves, ","type":"text"},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"droppingCallSite()","type":"codeVoice"},{"text":". A tracker given a ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":" delivers an event only once the user grants its ","type":"text"},{"code":"ConsentCategory","type":"codeVoice"},{"text":", holding it while undecided and dropping it when denied. ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a ","type":"text"},{"code":"SegmentStore","type":"codeVoice"},{"text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" value, which satisfies its ","type":"text"},{"code":"Refinement","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"Constraint","type":"codeVoice"},{"text":"s from the moment it is made, or carries constraints declared with ","type":"text"},{"code":"@Constrained","type":"codeVoice"},{"text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a ","type":"text"},{"code":"RejectionReport","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"rejectionReports","type":"codeVoice"},{"text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its ","type":"text"},{"code":"ScreenKey","type":"codeVoice"},{"text":" (","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"reference"},{"text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene (","type":"text"},{"isActive":true,"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"reference"},{"text":"), and AppKit views find it up their responder chain (","type":"text"},{"isActive":true,"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"reference"},{"text":"); a control’s ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with ","type":"text"},{"code":"trackScreensAutomatically","type":"codeVoice"},{"text":", which tracks ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" as each screen’s view controller appears, without swizzling (","type":"text"},{"isActive":true,"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","type":"reference"},{"text":"), and UIKit controls once a window scene turns it on with ","type":"text"},{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":", which tracks ","type":"text"},{"code":"ControlActivated","type":"codeVoice"},{"text":" as a touch activates each control named by its accessibility identifier (","type":"text"},{"isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"reference"},{"text":"). On every platform, ","type":"text"},{"code":"trackLifecycle","type":"codeVoice"},{"text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground (","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","type":"reference"},{"text":"). A tracker given the ","type":"text"},{"code":"Enricher.sessions","type":"codeVoice"},{"text":" enricher stamps every event with its session’s ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking ","type":"text"},{"code":"SessionEnded","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"SessionStarted","type":"codeVoice"},{"text":" (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"reference"},{"text":"). A tracker given ","type":"text"},{"code":"Sampler","type":"codeVoice"},{"text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with ","type":"text"},{"code":"Sampler.sessions(rate:)","type":"codeVoice"},{"text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a ","type":"text"},{"code":"SamplingDropReport","type":"codeVoice"},{"text":" and stamping each kept record with its ","type":"text"},{"code":"SampleRateKey","type":"codeVoice"},{"text":". The standard enrichers, ","type":"text"},{"code":"Enricher.application()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"operatingSystem()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"locale()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"network()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"vendorIdentifier()","type":"codeVoice"},{"text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once (","type":"text"},{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"text":" imports every module but ","type":"text"},{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true,"type":"reference"},{"text":", a product of its own for apps","type":"text"},{"text":" ","type":"text"},{"text":"that already use GRDB; ","type":"text"},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","isActive":true,"type":"reference"},{"text":", whose ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" macro derives an event’s conformances","type":"text"},{"text":" ","type":"text"},{"text":"and schema from its declaration and which alone builds swift-syntax; ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","isActive":true,"type":"reference"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","isActive":true,"type":"reference"},{"text":", which runs that check from an app’s tests; and ","type":"text"},{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"code":"withRecordingTracker","type":"codeVoice"},{"text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own.","type":"text"}],"type":"paragraph"},{"code":["import Traffluent","","struct SignedUp: Event {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"syntax":"swift","type":"codeListing"}]}],"references":{"doc://Sessions/documentation/Sessions":{"url":"\/documentation\/sessions","kind":"symbol","role":"collection","abstract":[{"text":"Put every event a tracker tracks in a session, and sample whole sessions.","type":"text"}],"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"topic","title":"Sessions"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"url":"\/documentation\/traffluent\/trackingfromviews","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","kind":"article","title":"Tracking from SwiftUI, UIKit and AppKit","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}]},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"url":"\/documentation\/traffluent\/whatgoeswhere","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","kind":"article","title":"Logging, Tracing, Metrics and Analytics","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"kind":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","role":"article","title":"Consent Gating","type":"topic"},"doc://Checksums/documentation/Checksums":{"url":"\/documentation\/checksums","type":"topic","role":"collec