{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent"]}],"abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"sections":[],"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"title":"Essentials","anchor":"Essentials"},{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"title":"Guides","anchor":"Guides"},{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"title":"Choosing what to record","anchor":"Choosing-what-to-record"},{"identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"],"title":"Modules","anchor":"Modules"},{"identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"],"title":"Testing","anchor":"Testing"}],"metadata":{"externalID":"Traffluent","modules":[{"name":"Traffluent"}],"role":"collection","symbolKind":"module","roleHeading":"Framework","title":"Traffluent"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"An event is a value conforming to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":". A "},{"type":"codeVoice","code":"Tracker"},{"type":"text","text":" is a value: tracking an event records it as an "},{"type":"codeVoice","code":"EventRecord"},{"type":"text","text":", with its timestamp, the caller’s "},{"type":"codeVoice","code":"SourceLocation"},{"type":"text","text":" and its "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":", as one of the tracker’s "},{"type":"codeVoice","code":"records"},{"type":"text","text":". Delivering is a chain of operators over that sequence: Afluent’s "},{"type":"codeVoice","code":"batch(strategy:)"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"batch()"},{"type":"text","text":", the default) gathers the records into batches, and "},{"type":"codeVoice","code":"deliver(to:)"},{"type":"text","text":" hands each batch to every destination, as a lazy unit of work. A "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" is a plain sink, narrowed or transformed by its modifiers: "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":" for the consent categories it serves, "},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"droppingCallSite()"},{"type":"text","text":". A tracker given a "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":" delivers an event only once the user grants its "},{"type":"codeVoice","code":"ConsentCategory"},{"type":"text","text":", holding it while undecided and dropping it when denied. "},{"type":"codeVoice","code":"track"},{"type":"text","text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value, which satisfies its "},{"type":"codeVoice","code":"Refinement"},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"Constraint"},{"type":"text","text":"s from the moment it is made, or carries constraints declared with "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a "},{"type":"codeVoice","code":"RejectionReport"},{"type":"text","text":" on "},{"type":"codeVoice","code":"rejectionReports"},{"type":"text","text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" ("},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"reference","isActive":true},{"type":"text","text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene ("},{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"reference","isActive":true},{"type":"text","text":"), and AppKit views find it up their responder chain ("},{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"reference","isActive":true},{"type":"text","text":"); a control’s "},{"type":"codeVoice","code":"track"},{"type":"text","text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with "},{"type":"codeVoice","code":"trackScreensAutomatically"},{"type":"text","text":", which tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" as each screen’s view controller appears, without swizzling ("},{"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","type":"reference","isActive":true},{"type":"text","text":"), and UIKit controls once a window scene turns it on with "},{"type":"codeVoice","code":"trackControlsAutomatically"},{"type":"text","text":", which tracks "},{"type":"codeVoice","code":"ControlActivated"},{"type":"text","text":" as a touch activates each control named by its accessibility identifier ("},{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"reference","isActive":true},{"type":"text","text":"). On every platform, "},{"type":"codeVoice","code":"trackLifecycle"},{"type":"text","text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground ("},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","type":"reference","isActive":true},{"type":"text","text":"). A tracker given the "},{"type":"codeVoice","code":"Enricher.sessions"},{"type":"text","text":" enricher stamps every event with its session’s "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking "},{"type":"codeVoice","code":"SessionEnded"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":" ("},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"reference","isActive":true},{"type":"text","text":"). A tracker given "},{"type":"codeVoice","code":"Sampler"},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with "},{"type":"codeVoice","code":"Sampler.sessions(rate:)"},{"type":"text","text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a "},{"type":"codeVoice","code":"SamplingDropReport"},{"type":"text","text":" and stamping each kept record with its "},{"type":"codeVoice","code":"SampleRateKey"},{"type":"text","text":". The standard enrichers, "},{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":", "},{"type":"codeVoice","code":"device()"},{"type":"text","text":", "},{"type":"codeVoice","code":"operatingSystem()"},{"type":"text","text":", "},{"type":"codeVoice","code":"locale()"},{"type":"text","text":", "},{"type":"codeVoice","code":"network()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vendorIdentifier()"},{"type":"text","text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once ("},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" imports every module but "},{"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true},{"type":"text","text":", a product of its own for apps"},{"type":"text","text":" "},{"type":"text","text":"that already use GRDB; "},{"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","isActive":true},{"type":"text","text":", whose "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" macro derives an event’s conformances"},{"type":"text","text":" "},{"type":"text","text":"and schema from its declaration and which alone builds swift-syntax; "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","isActive":true},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","isActive":true},{"type":"text","text":", which runs that check from an app’s tests; and "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own."}],"type":"paragraph"},{"code":["import Traffluent","","struct SignedUp: Event {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://CollectorEncoding/documentation/CollectorEncoding":{"kind":"symbol","abstract":[],"url":"\/documentation\/collectorencoding","role":"collection","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","type":"topic","title":"CollectorEncoding"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"kind":"symbol","abstract":[],"url":"\/documentation\/lifecycletracking","role":"collection","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","type":"topic","title":"LifecycleTracking"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","role":"collection","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[],"type":"topic","url":"\/documentation\/httpdestinations","kind":"symbol"},"doc://UIKitTracking/documentation/UIKitTracking":{"title":"UIKitTracking","role":"collection","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","abstract":[],"type":"topic","url":"\/documentation\/uikittracking","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"title":"Tracking from SwiftUI, UIKit and AppKit","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"type":"topic","url":"\/documentation\/traffluent\/trackingfromviews","kind":"article"},"doc://Checksums/documentation/Checksums":{"kind":"symbol","abstract":[],"url":"\/documentation\/checksums","role":"collection","identifier":"doc:\/\/Checksums\/documentation\/Checksums","type":"topic","title":"Checksums"},"doc://Sessions/documentation/Sessions":{"kind":"symbol","abstract":[],"url":"\/documentation\/sessions","role":"collection","identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"topic","title":"Sessions"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"title":"SwiftUITracking","role":"collection","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","abstract":[],"type":"topic","url":"\/documentation\/swiftuitracking","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"title":"Privacy Manifests","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}],"type":"topic","url":"\/documentation\/traffluent\/privacymanifests","kind":"article"},"doc://Destinations/documentation/Destinations":{"title":"Destinations","role":"collection","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[],"type":"topic","url":"\/documentation\/destinations","kind":"symbol"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"kind":"symbol","abstract":[],"url":"\/documentation\/grdbpersistence","role":"collection","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","type":"topic","title":"GRDBPersistence"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"kind":"symbol","abstract":[],"url":"\/documentation\/automaticscreentracking","role":"collection","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","type":"topic","title":"AutomaticScreenTracking"},"doc://TrackingPlans/documentation/TrackingPlans":{"title":"TrackingPlans","role":"collection","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","abstract":[],"type":"topic","url":"\/documentation\/trackingplans","kind":"symbol"},"doc://EventMacros/documentation/EventMacros":{"kind":"symbol","abstract":[],"url":"\/documentation\/eventmacros","role":"collection","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","type":"topic","title":"EventMacros"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"title":"Testing What Your Code Tracks","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"type":"topic","url":"\/documentation\/traffluent\/testingwhatyoutrack","kind":"article"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"kind":"article","abstract":[{"text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it.","type":"text"}],"url":"\/documentation\/traffluent\/changingevents","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","type":"topic","title":"Changing an Event"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"type":"topic","url":"\/documentation\/traffluent\/automatictracking","kind":"article"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"kind":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"url":"\/documentation\/traffluent\/consentgating","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"topic","title":"Consent Gating"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"title":"LoggingDestinations","role":"collection","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","abstract":[],"type":"topic","url":"\/documentation\/loggingdestinations","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"url":"\/documentation\/traffluent\/persistingrecords","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","title":"Persisting Records"},"doc://TracingDestinations/documentation/TracingDestinations":{"kind":"symbol","abstract":[],"url":"\/documentation\/tracingdestinations","role":"collection","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","type":"topic","title":"TracingDestinations"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"title":"Logging, Tracing, Metrics and Analytics","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}],"type":"topic","url":"\/documentation\/traffluent\/whatgoeswhere","kind":"article"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"type":"topic","url":"\/documentation\/traffluent\/samplingevents","kind":"article"},"doc://AppKitTracking/documentation/AppKitTracking":{"kind":"symbol","abstract":[],"url":"\/documentation\/appkittracking","role":"collection","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"topic","title":"AppKitTracking"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"type":"topic","url":"\/documentation\/traffluent\/sessionsandstandardcontext","kind":"article"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent","role":"collection","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","type":"topic","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"type":"topic","url":"\/documentation\/traffluent\/choosingdestinations","kind":"article"},"doc://TrackerTesting/documentation/TrackerTesting":{"title":"TrackerTesting","role":"collection","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","abstract":[],"type":"topic","url":"\/documentation\/trackertesting","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"url":"\/documentation\/traffluent\/trackingevents","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"topic","title":"Tracking Events"},"doc://StandardContext/documentation/StandardContext":{"title":"StandardContext","role":"collection","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","abstract":[],"type":"topic","url":"\/documentation\/standardcontext","kind":"symbol"},"doc://Trackers/documentation/Trackers":{"kind":"symbol","abstract":[],"url":"\/documentation\/trackers","role":"collection","identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"topic","title":"Trackers"},"doc://Persistence/documentation/Persistence":{"title":"Persistence","role":"collection","identifier":"doc:\/\/Persistence\/documentation\/Persistence","abstract":[],"type":"topic","url":"\/documentation\/persistence","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"kind":"article","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"url":"\/documentation\/traffluent\/identifyingpeople","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"topic","title":"Identifying People"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"title":"Defining Events","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"type":"topic","url":"\/documentation\/traffluent\/definingevents","kind":"article"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"title":"AutomaticControlTracking","role":"collection","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","abstract":[],"type":"topic","url":"\/documentation\/automaticcontroltracking","kind":"symbol"},"doc://Events/documentation/Events":{"title":"Events","role":"collection","identifier":"doc:\/\/Events\/documentation\/Events","abstract":[],"type":"topic","url":"\/documentation\/events","kind":"symbol"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"kind":"symbol","abstract":[],"url":"\/documentation\/trackingplantesting","role":"collection","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","type":"topic","title":"TrackingPlanTesting"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"type":"topic","url":"\/documentation\/traffluent\/trackingplanworkflow","kind":"article"}}}