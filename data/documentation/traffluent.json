ckers","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://JSONValues/documentation/JSONValues":{"title":"JSONValues","kind":"symbol","type":"topic","abstract":[{"text":"A JSON value that renders to the same bytes on every platform and Swift release.","type":"text"}],"role":"collection","url":"\/documentation\/jsonvalues","identifier":"doc:\/\/JSONValues\/documentation\/JSONValues"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"url":"\/documentation\/traffluent\/persistingrecords","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","title":"Persisting Records","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"role":"article","kind":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"url":"\/documentation\/traffluent\/gettingstarted","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","title":"Getting Started","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"role":"article","kind":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","kind":"article","role":"article","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"title":"Sessions and Standard Context","url":"\/documentation\/traffluent\/sessionsandstandardcontext","type":"topic"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","kind":"article","type":"topic","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"role":"article","url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},"doc://Events/documentation/Events":{"url":"\/documentation\/events","identifier":"doc:\/\/Events\/documentation\/Events","title":"Events","abstract":[{"type":"text","text":"The types every other module shares: the "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" protocol, the values its properties can hold, and the record a tracker makes of each event."}],"role":"collection","kind":"symbol","type":"topic"},"doc://Checksums/documentation/Checksums":{"url":"\/documentation\/checksums","identifier":"doc:\/\/Checksums\/documentation\/Checksums","title":"Checksums","abstract":[{"text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it.","type":"text"}],"role":"collection","kind":"symbol","type":"topic"},"doc://StandardContext/documentation/StandardContext":{"url":"\/documentation\/standardcontext","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","title":"StandardContext","abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"role":"collection","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","kind":"article","type":"topic","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"role":"article","url":"\/documentation\/traffluent\/samplingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"title":"Testing What Your Code Tracks","kind":"article","type":"topic","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"role":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack