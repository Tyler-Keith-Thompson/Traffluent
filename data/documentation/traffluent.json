://Traffluent/documentation/Traffluent/AutomaticTracking":{"type":"topic","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"role":"article","url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","title":"Automatic Tracking","kind":"article"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"type":"topic","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"role":"article","url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","title":"Consent Gating","kind":"article"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"type":"topic","abstract":[],"role":"collection","url":"\/documentation\/collectorencoding","title":"CollectorEncoding","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","kind":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans":{"type":"topic","abstract":[],"role":"collection","url":"\/documentation\/trackingplans","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","title":"TrackingPlans","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"type":"topic","abstract":[],"role":"collection","url":"\/documentation\/httpdestinations","title":"HTTPDestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","kind":"symbol"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"kind":"symbol","abstract":[],"role":"collection","url":"\/documentation\/grdbpersistence","title":"GRDBPersistence","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"type":"topic","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"role":"article","url":"\/documentation\/traffluent\/trackingfromviews","title":"Tracking from SwiftUI, UIKit and AppKit","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","kind":"article"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"type":"topic","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"role":"article","url":"\/documentation\/traffluent\/changingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","title":"Changing an Event","kind":"article"}}}