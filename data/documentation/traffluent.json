{"kind":"symbol","topicSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"]},{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"]},{"title":"Choosing what to record","anchor":"Choosing-what-to-record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"]},{"title":"Modules","anchor":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","doc:\/\/PropertyJSON\/documentation\/PropertyJSON","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"]},{"title":"Testing","anchor":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"]}],"variants":[{"paths":["\/documentation\/traffluent"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"title":"Traffluent","externalID":"Traffluent","symbolKind":"module","modules":[{"name":"Traffluent"}],"roleHeading":"Framework","role":"collection"},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An event is a value that conforms to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":", declared with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":". A "},{"type":"codeVoice","code":"Tracker"},{"type":"text","text":" is a value: tracking an event records it as an "},{"type":"codeVoice","code":"EventRecord"},{"type":"text","text":", with its timestamp, the caller’s "},{"type":"codeVoice","code":"SourceLocation"},{"type":"text","text":" and its "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":", as one of the tracker’s "},{"type":"codeVoice","code":"records"},{"type":"text","text":". Delivering is a chain of operators over that sequence: Afluent’s "},{"type":"codeVoice","code":"batch(strategy:)"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"batch()"},{"type":"text","text":", the default) gathers the records into batches, and "},{"type":"codeVoice","code":"deliver(to:)"},{"type":"text","text":" hands each batch to every destination, as a lazy unit of work. A "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" is a plain sink, narrowed or transformed by its modifiers: "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":" for the consent categories it serves, "},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":", "},{"type":"codeVoice","code":"droppingCallSite()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"enriched(by:)"},{"type":"text","text":", which runs an "},{"type":"codeVoice","code":"Enricher"},{"type":"text","text":" on the records that destination alone receives. A tracker given a "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":" delivers an event only once the user grants its "},{"type":"codeVoice","code":"ConsentCategory"},{"type":"text","text":", holding it while undecided and dropping it when denied. "},{"type":"codeVoice","code":"track"},{"type":"text","text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value, which satisfies its "},{"type":"codeVoice","code":"Refinement"},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"Constraint"},{"type":"text","text":"s from the moment it is made, or carries constraints declared with "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a "},{"type":"codeVoice","code":"RejectionReport"},{"type":"text","text":" on "},{"type":"codeVoice","code":"rejectionReports"},{"type":"text","text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},{"type":"text","text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":"), and AppKit views find it up their responder chain ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},{"type":"text","text":"); a control’s "},{"type":"codeVoice","code":"track"},{"type":"text","text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with "},{"type":"codeVoice","code":"trackScreensAutomatically"},{"type":"text","text":", which tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" as each screen’s view controller appears, without swizzling ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking"},{"type":"text","text":"), and UIKit controls once a window scene turns it on with "},{"type":"codeVoice","code":"trackControlsAutomatically"},{"type":"text","text":", which tracks "},{"type":"codeVoice","code":"ControlActivated"},{"type":"text","text":" as a touch activates each control named by its accessibility identifier ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking"},{"type":"text","text":"). On every platform, "},{"type":"codeVoice","code":"trackLifecycle"},{"type":"text","text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking"},{"type":"text","text":"). A tracker given the "},{"type":"codeVoice","code":"Enricher.sessions"},{"type":"text","text":" enricher stamps every event with its session’s "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking "},{"type":"codeVoice","code":"SessionEnded"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"},{"type":"text","text":"). A tracker given "},{"type":"codeVoice","code":"Sampler"},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with "},{"type":"codeVoice","code":"Sampler.sessions(rate:)"},{"type":"text","text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a "},{"type":"codeVoice","code":"SamplingDropReport"},{"type":"text","text":" and stamping each kept record with its "},{"type":"codeVoice","code":"SampleRateKey"},{"type":"text","text":". The standard enrichers, "},{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":", "},{"type":"codeVoice","code":"device()"},{"type":"text","text":", "},{"type":"codeVoice","code":"operatingSystem()"},{"type":"text","text":", "},{"type":"codeVoice","code":"locale()"},{"type":"text","text":", "},{"type":"codeVoice","code":"network()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vendorIdentifier()"},{"type":"text","text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" imports "},{"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","isActive":true},{"type":"text","text":", whose "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" macro derives an event’s conformances"},{"type":"text","text":" "},{"type":"text","text":"and schema from its declaration, and every other module but "},{"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true},{"type":"text","text":", a product of its"},{"type":"text","text":" "},{"type":"text","text":"own for apps that already use GRDB; "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","isActive":true},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","isActive":true},{"type":"text","text":", which runs that check from an app’s tests; and "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own."}]},{"type":"codeListing","syntax":"swift","code":["import Traffluent","","@Event","struct SignedUp {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"]}],"kind":"content"}],"hierarchy":{"paths":[[]]},"references":{"doc://LifecycleTracking/documentation/LifecycleTracking":{"url":"\/documentation\/lifecycletracking","title":"LifecycleTracking","abstract":[{"text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s records durable as the app leaves the foreground.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","role":"collection","type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","role":"article","url":"\/documentation\/traffluent\/trackingfromviews","title":"Tracking from SwiftUI, UIKit and AppKit","kind":"article","type":"topic","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"url":"\/documentation\/traffluent\/whatgoeswhere","title":"Logging, Tracing, Metrics and Analytics","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"url":"\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","role":"article","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"url":"\/documentation\/httpdestinations","title":"HTTPDestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","role":"collection","type":"topic"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"title":"Getting Started","url":"\/documentation\/traffluent\/gettingstarted","role":"article","kind":"article","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"url":"\/documentation\/swiftuitracking","title":"SwiftUITracking","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"url":"\/documentation\/traffluent\/identifyingpeople","title":"Identifying People","abstract":[{"text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","role":"article","type":"topic"},"doc://TrackingPlans/documentation/TrackingPlans":{"url":"\/documentation\/trackingplans","title":"TrackingPlans","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","abstract":[{"text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it.","type":"text"}],"role":"collection","type":"topic","kind":"symbol"},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","title":"Destinations","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection","type":"topic"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"url":"\/documentation\/traffluent\/testingwhatyoutrack","title":"Testing What Your Code Tracks","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://TrackerTesting/documentation/TrackerTesting":{"title":"TrackerTesting","url":"\/documentation\/trackertesting","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"type":"topic","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"url":"\/documentation\/posthogencoding","title":"PostHogEncoding","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","abstract":[{"text":"Write batches of records for PostHog’s batch capture API, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"role":"collection","type":"topic","kind":"symbol"},"doc://StandardContext/documentation/StandardContext":{"url":"\/documentation\/standardcontext","title":"StandardContext","abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","role":"collection","type":"topic"},"doc://PropertyJSON/documentation/PropertyJSON":{"url":"\/documentation\/propertyjson","title":"PropertyJSON","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","abstract":[],"role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","url":"\/documentation\/traffluent\/choosingdestinations","role":"article","kind":"article","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"url":"\/documentation\/traffluent\/definingevents","title":"Defining Events","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","role":"article","type":"topic"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"url":"\/documentation\/trackingplantesting","title":"TrackingPlanTesting","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"role":"collection","type":"topic","kind":"symbol"},"doc://UIKitTracking/documentation/UIKitTracking":{"url":"\/documentation\/uikittracking","title":"UIKitTracking","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"kind":"symbol","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","role":"collection","type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"url":"\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://Persistence/documentation/Persistence":{"url":"\/documentation\/persistence","title":"Persistence","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence","role":"collection","type":"topic"},"doc://Sessions/documentation/Sessions":{"url":"\/documentation\/sessions","title":"Sessions","identifier":"doc:\/\/Sessions\/documentation\/Sessions","abstract":[{"type":"text","text":"Put every event a tracker tracks in a session, and sample whole sessions."}],"role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"url":"\/documentation\/traffluent\/changingevents","title":"Changing an Event","abstract":[{"text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","role":"article","type":"topic"},"doc://AppKitTracking/documentation/AppKitTracking":{"url":"\/documentation\/appkittracking","title":"AppKitTracking","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}],"role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","role":"collection","url":"\/documentation\/traffluent","title":"Traffluent","kind":"symbol","type":"topic","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}]},"doc://GRDBPersistence/documentation/GRDBPersistence":{"url":"\/documentation\/grdbpersistence","title":"GRDBPersistence","abstract":[{"type":"text","text":"Keep each record in a table of the app’s own GRDB database until it is delivered."}],"kind":"symbol","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","role":"collection","type":"topic"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"url":"\/documentation\/traffluent\/sessionsandstandardcontext","title":"Sessions and Standard Context","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://Checksums/documentation/Checksums":{"url":"\/documentation\/checksums","title":"Checksums","abstract":[{"text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Checksums\/documentation\/Checksums","role":"collection","type":"topic"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"url":"\/documentation\/automaticscreentracking","title":"AutomaticScreenTracking","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","abstract":[{"text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on","type":"text"},{"text":" ","type":"text"},{"text":"each screen.","type":"text"}],"role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"url":"\/documentation\/traffluent\/privacymanifests","title":"Privacy Manifests","abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","role":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","role":"article","url":"\/documentation\/traffluent\/trackingevents","title":"Tracking Events","kind":"article","type":"topic","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"url":"\/documentation\/automaticcontroltracking","title":"AutomaticControlTracking","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","role":"collection","type":"topic"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"url":"\/documentation\/traffluent\/consentgating","title":"Consent Gating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://Trackers/documentation/Trackers":{"url":"\/documentation\/trackers","title":"Trackers","abstract":[{"text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers","role":"collection","type":"topic"},"doc://Events/documentation/Events":{"url":"\/documentation\/events","title":"Events","identifier":"doc:\/\/Events\/documentation\/Events","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"role":"collection","type":"topic","kind":"symbol"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"url":"\/documentation\/collectorencoding","title":"CollectorEncoding","abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","role":"collection","type":"topic"},"doc://TracingDestinations/documentation/TracingDestinations":{"url":"\/documentation\/tracingdestinations","title":"TracingDestinations","abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"url":"\/documentation\/traffluent\/samplingevents","title":"Sampling Events","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","role":"article","type":"topic"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"url":"\/documentation\/loggingdestinations","title":"LoggingDestinations","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"code":"Logger","type":"codeVoice"},{"text":".","type":"text"}],"role":"collection","type":"topic","kind":"symbol"},"doc://EventMacros/documentation/EventMacros":{"url":"\/documentation\/eventmacros","title":"EventMacros","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","role":"collection","type":"topic"}}}