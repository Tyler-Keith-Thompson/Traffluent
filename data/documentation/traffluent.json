/documentation/TelemetryDeckEncoding":{"kind":"symbol","type":"topic","title":"TelemetryDeckEncoding","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","url":"\/documentation\/telemetrydeckencoding","abstract":[{"type":"text","text":"Send records to TelemetryDeck as signals, through its Ingest API v3."}],"role":"collection"},"doc://Checksums/documentation/Checksums":{"kind":"symbol","type":"topic","title":"Checksums","identifier":"doc:\/\/Checksums\/documentation\/Checksums","url":"\/documentation\/checksums","abstract":[{"text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it.","type":"text"}],"role":"collection"},"doc://TrackingPlans/documentation/TrackingPlans":{"kind":"symbol","url":"\/documentation\/trackingplans","title":"TrackingPlans","abstract":[{"text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it.","type":"text"}],"type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","role":"collection"},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"kind":"article","type":"topic","title":"Writing a Vendor Destination","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","abstract":[{"text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships.","type":"text"}],"url":"\/documentation\/traffluent\/writingavendordestination","role":"article"},"doc://StandardContext/documentation/StandardContext":{"kind":"symbol","role":"collection","type":"topic","abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"url":"\/documentation\/standardcontext","title":"StandardContext","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"},"doc