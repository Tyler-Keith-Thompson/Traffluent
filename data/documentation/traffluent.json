d":"symbol","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","url":"\/documentation\/tracingdestinations","role":"collection","type":"topic","abstract":[],"title":"TracingDestinations"},"doc://TrackingPlans/documentation/TrackingPlans":{"url":"\/documentation\/trackingplans","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","type":"topic","abstract":[],"kind":"symbol","title":"TrackingPlans","role":"collection"},"doc://TrackerTesting/documentation/TrackerTesting":{"kind":"symbol","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","url":"\/documentation\/trackertesting","role":"collection","type":"topic","abstract":[],"title":"TrackerTesting"},"doc://UIKitTracking/documentation/UIKitTracking":{"url":"\/documentation\/uikittracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"topic","title":"UIKitTracking","abstract":[],"kind":"symbol","role":"collection"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"url":"\/documentation\/swiftuitracking","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"topic","title":"SwiftUITracking","abstract":[],"kind":"symbol","role":"collection"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"url":"\/documentation\/automaticscreentracking","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","type":"topic","abstract":[],"kind":"symbol","title":"AutomaticScreenTracking","role":"collection"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"url":"\/documentation\/traffluent\/definingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"title":"Defining Events","kind":"article","role":"article"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","url":"\/documentation\/collectorencoding","role":"collection","type":"topic","abstract":[],"title":"CollectorEncoding"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","url":"\/documentation\/traffluent\/samplingevents","role":"article","type":"topic","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"title":"Sampling Events"},"doc://Sessions/documentation/Sessions":{"kind":"symbol","identifier":"doc:\/\/Sessions\/documentation\/Sessions","url":"\/documentation\/sessions","role":"collection","type":"topic","abstract":[],"title":"Sessions"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"url":"\/documentation\/traffluent\/identifyingpeople","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"topic","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"kind":"article","title":"Identifying People","role":"article"},"doc://PropertyJSON/documentation/PropertyJSON":{"kind":"symbol","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","url":"\/documentation\/propertyjson","role":"collection","type":"topic","abstract":[],"title":"PropertyJSON"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"url":"\/documentation\/traffluent\/choosingdestinations","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","kind":"article","type":"topic","title":"Choosing Destinations","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"role":"article"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"kind":"symbol","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking","role":"collection","type":"topic","abstract":[],"title":"AutomaticControlTracking"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"kind":"symbol","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","url":"\/documentation\/trackingplantesting","role":"collection","type":"topic","abstract":[],"title":"TrackingPlanTesting"},"doc://Trackers/documentation/Trackers":{"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers","url":"\/documentation\/trackers","role":"collection","type":"topic","abstract":[],"title":"Trackers"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"url":"\/documentation\/traffluent\/privacymanifests","type":"topic","role":"article","title":"Privacy Manifests","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","kind":"article","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}]},"doc://PostHogEncoding/documentation/PostHogEncoding":{"url":"\/documentation\/posthogencoding","type":"topic","role":"collection","title":"PostHogEncoding","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","abstract":[],"kind":"symbol"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"url":"\/documentation\/loggingdestinations","type":"topic","role":"collection","title":"LoggingDestinations","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","abstract":[],"kind":"symbol"},"doc://EventMacros/documentation/EventMacros":{"kind":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","url":"\/documentation\/eventmacros","role":"collection","type":"topic","abstract":[],"title":"EventMacros"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"url":"\/documentation\/traffluent\/trackingevents","type":"topic","role":"article","title":"Tracking Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","kind":"article","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","url":"\/documentation\/traffluent\/persistingrecords","role":"article","type":"topic","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"title":"Persisting Records"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","url":"\/documentation\/traffluent\/trackingplanworkflow","role":"article","type":"topic","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"title":"Exporting and Checking a Tracking Plan"}}}