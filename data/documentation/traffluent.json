{"hierarchy":{"paths":[[]]},"abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"sections":[],"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"]},{"anchor":"Modules","title":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"]},{"anchor":"Testing","title":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"]}],"metadata":{"roleHeading":"Framework","role":"collection","externalID":"Traffluent","symbolKind":"module","modules":[{"name":"Traffluent"}],"title":"Traffluent"},"kind":"symbol","identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"inlineContent":[{"text":"An event is a value conforming to ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"Tracker","type":"codeVoice"},{"text":" is a value: tracking an event records it as an ","type":"text"},{"code":"EventRecord","type":"codeVoice"},{"text":", with its timestamp, the caller’s ","type":"text"},{"code":"SourceLocation","type":"codeVoice"},{"text":" and its ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":", as one of the tracker’s ","type":"text"},{"code":"records","type":"codeVoice"},{"text":". Delivering is a chain of operators over that sequence: Afluent’s ","type":"text"},{"code":"batch(strategy:)","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"batch()","type":"codeVoice"},{"text":", the default) gathers the records into batches, and ","type":"text"},{"code":"deliver(to:)","type":"codeVoice"},{"text":" hands each batch to every destination, as a lazy unit of work. A ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" is a plain sink, narrowed or transformed by its modifiers: ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":" for the consent categories it serves, ","type":"text"},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"droppingCallSite()","type":"codeVoice"},{"text":". A tracker given a ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":" delivers an event only once the user grants its ","type":"text"},{"code":"ConsentCategory","type":"codeVoice"},{"text":", holding it while undecided and dropping it when denied. ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a ","type":"text"},{"code":"SegmentStore","type":"codeVoice"},{"text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" value, which satisfies its ","type":"text"},{"code":"Refinement","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"Constraint","type":"codeVoice"},{"text":"s from the moment it is made, or carries constraints declared with ","type":"text"},{"code":"@Constrained","type":"codeVoice"},{"text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a ","type":"text"},{"code":"RejectionReport","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"rejectionReports","type":"codeVoice"},{"text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its ","type":"text"},{"code":"ScreenKey","type":"codeVoice"},{"text":" (","type":"text"},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"reference","isActive":true},{"text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene (","type":"text"},{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"reference","isActive":true},{"text":"), and AppKit views find it up their responder chain (","type":"text"},{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"reference","isActive":true},{"text":"); a control’s ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with ","type":"text"},{"code":"trackScreensAutomatically","type":"codeVoice"},{"text":", which tracks ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" as each screen’s view controller appears, without swizzling (","type":"text"},{"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","type":"reference","isActive":true},{"text":"), and UIKit controls once a window scene turns it on with ","type":"text"},{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":", which tracks ","type":"text"},{"code":"ControlActivated","type":"codeVoice"},{"text":" as a touch activates each control named by its accessibility identifier (","type":"text"},{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"reference","isActive":true},{"text":"). On every platform, ","type":"text"},{"code":"trackLifecycle","type":"codeVoice"},{"text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground (","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","type":"reference","isActive":true},{"text":"). A tracker given the ","type":"text"},{"code":"Enricher.sessions","type":"codeVoice"},{"text":" enricher stamps every event with its session’s ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking ","type":"text"},{"code":"SessionEnded","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"SessionStarted","type":"codeVoice"},{"text":" (","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"reference","isActive":true},{"text":"). A tracker given ","type":"text"},{"code":"Sampler","type":"codeVoice"},{"text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with ","type":"text"},{"code":"Sampler.sessions(rate:)","type":"codeVoice"},{"text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a ","type":"text"},{"code":"SamplingDropReport","type":"codeVoice"},{"text":" and stamping each kept record with its ","type":"text"},{"code":"SampleRateKey","type":"codeVoice"},{"text":". The standard enrichers, ","type":"text"},{"code":"Enricher.application()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"operatingSystem()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"locale()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"network()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"vendorIdentifier()","type":"codeVoice"},{"text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once (","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" imports every module but "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},{"type":"text","text":", a product of its own for apps"},{"type":"text","text":" "},{"type":"text","text":"that already use GRDB; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},{"type":"text","text":", whose "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" macro derives an event’s conformances"},{"type":"text","text":" "},{"type":"text","text":"and schema from its declaration and which alone builds swift-syntax; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},{"type":"text","text":", which runs that check from an app’s tests; and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose "},{"code":"withRecordingTracker","type":"codeVoice"},{"type":"text","text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own."}],"type":"paragraph"},{"code":["import Traffluent","","struct SignedUp: Event {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/traffluent"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://Events/documentation/Events":{"kind":"symbol","role":"collection","type":"topic","title":"Events","url":"\/documentation\/events","abstract":[],"identifier":"doc:\/\/Events\/documentation\/Events"},"doc://TrackerTesting/documentation/TrackerTesting":{"role":"collection","abstract":[],"url":"\/documentation\/trackertesting","kind":"symbol","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","type":"topic","title":"TrackerTesting"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","role":"collection","type":"topic","title":"Traffluent","url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"kind":"symbol","role":"collection","type":"topic","title":"HTTPDestinations","url":"\/documentation\/httpdestinations","abstract":[],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"kind":"article","role":"article","title":"Privacy Manifests","type":"topic","url":"\/documentation\/traffluent\/privacymanifests","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"role":"collection","abstract":[],"url":"\/documentation\/loggingdestinations","kind":"symbol","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","type":"topic","title":"LoggingDestinations"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"kind":"symbol","role":"collection","type":"topic","title":"AutomaticScreenTracking","url":"\/documentation\/automaticscreentracking","abstract":[],"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"role":"collection","abstract":[],"url":"\/documentation\/grdbpersistence","kind":"symbol","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","type":"topic","title":"GRDBPersistence"},"doc://StandardContext/documentation/StandardContext":{"kind":"symbol","role":"collection","title":"StandardContext","type":"topic","url":"\/documentation\/standardcontext","abstract":[],"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"kind":"symbol","role":"collection","type":"topic","title":"SwiftUITracking","url":"\/documentation\/swiftuitracking","abstract":[],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},"doc://Checksums/documentation/Checksums":{"role":"collection","abstract":[],"url":"\/documentation\/checksums","kind":"symbol","identifier":"doc:\/\/Checksums\/documentation\/Checksums","type":"topic","title":"Checksums"},"doc://UIKitTracking/documentation/UIKitTracking":{"kind":"symbol","role":"collection","type":"topic","title":"UIKitTracking","url":"\/documentation\/uikittracking","abstract":[],"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"role":"collection","abstract":[],"url":"\/documentation\/automaticcontroltracking","kind":"symbol","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"topic","title":"AutomaticControlTracking"},"doc://Persistence/documentation/Persistence":{"kind":"symbol","role":"collection","type":"topic","title":"Persistence","url":"\/documentation\/persistence","abstract":[],"identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"role":"collection","abstract":[],"url":"\/documentation\/lifecycletracking","kind":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","type":"topic","title":"LifecycleTracking"},"doc://Destinations/documentation/Destinations":{"kind":"symbol","role":"collection","type":"topic","title":"Destinations","url":"\/documentation\/destinations","abstract":[],"identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://Sessions/documentation/Sessions":{"kind":"symbol","role":"collection","title":"Sessions","type":"topic","url":"\/documentation\/sessions","identifier":"doc:\/\/Sessions\/documentation\/Sessions","abstract":[]},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"role":"collection","abstract":[],"url":"