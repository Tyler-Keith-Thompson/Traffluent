/documentation\/TrackerTesting","doc:\/\/DestinationTesting\/documentation\/DestinationTesting"],"anchor":"Testing"}],"references":{"doc://StandardContext/documentation/StandardContext":{"abstract":[{"type":"text","text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on."}],"role":"collection","title":"StandardContext","kind":"symbol","url":"\/documentation\/standardcontext","type":"topic","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/traffluent","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"title":"Traffluent"},"doc://AsyncQueues/documentation/AsyncQueues":{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues","type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/asyncqueues","title":"AsyncQueues","abstract":[{"type":"text","text":"The sequence type of every report and delivery stream the library hands out, and of an app’s own, read by one task at a time."}]},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"role":"article","title":"Writing a Vendor Destination","kind":"article","url":"\/documentation\/traffluent\/writingavendordestination","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"},"doc://HeapEncoding/documentation/HeapEncoding":{"title":"HeapEncoding","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","type":"topic","abstract":[{"text":"Send records to Heap as custom events, through its server-side bulk track API.","type":"te