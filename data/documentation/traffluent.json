uent\/sessionsandstandardcontext","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","kind":"article","title":"Sessions and Standard Context"},"doc://SnowplowEncoding/documentation/SnowplowEncoding":{"role":"collection","type":"topic","url":"\/documentation\/snowplowencoding","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","abstract":[{"text":"Send records to a Snowplow collector as self-describing events, whose schemas come from the tracking plan.","type":"text"}],"kind":"symbol","title":"SnowplowEncoding"},"doc://Destinations/documentation/Destinations":{"role":"collection","type":"topic","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations","url":"\/documentation\/destinations","kind":"symbol","title":"Destinations"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"role":"article","type":"topic","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","url":"\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan"},"doc://TrackingPlans/documentation/TrackingPlans":{"abstract":[{"text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it.","type":"text"}],"title":"TrackingPlans","kind":"symbol","type":"topic","url":"\/documentati