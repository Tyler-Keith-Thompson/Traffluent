{"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each event is a struct, so the compiler checks its name and every property. A tracker holds back","type":"text"},{"text":" ","type":"text"},{"text":"the events the user hasn’t consented to, stamps the rest with their session and device, keeps them","type":"text"},{"text":" ","type":"text"},{"text":"on disk and delivers them to your server, sending again when the network or the server fails.","type":"text"}]},{"text":"An app’s analytics, from launch","level":3,"type":"heading","anchor":"An-apps-analytics-from-launch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare the events. The tracker rejects an event that breaks a constraint before it is stored or"},{"type":"text","text":" "},{"type":"text","text":"delivered, and a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value reaches only the destinations that don’t redact it:"}]},{"code":["import SwiftUI","import Traffluent","import TrackingPlans","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart {","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Build the tracker and start its delivery once, as the app launches:","type":"text"}]},{"code":["func startAnalytics(consent: Consent) throws -> Tracker {","    \/\/ The plan and the store each take every @Event in the app, and the library's own.","    let plan = try TrackingPlan()","    \/\/ Records wait on disk until they are delivered, across launches.","    let store = try SegmentStore()","    \/\/ Every event gets its session, and the app, device, OS, locale and network it was tracked on.","    let tracker = Tracker(","        store: store,","        consent: consent,","        enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()])","","    let collector = HTTPDestination(","        endpoint: collectorURL,","        headerFields: [.authorization: \"Bearer \\(apiKey)\"],","        encoder: CollectorBatchEncoder(plan: plan))","    \/\/ Analytics events only, without their email addresses, 20 at a time or every 30 seconds.","    let delivery = tracker.records.batch().deliver(","        to: collector.accepting(.analytics).redactingSensitiveValues())","    Task {","        do {","            try await delivery.execute()  \/\/ for the life of the app","        } catch {","            print(\"Delivery stopped: \\(error)\")","        }","    }","","    \/\/ Every event that won't arrive, and why.","    let rejections = tracker.rejectionReports","    let consentDrops = consent.dropReports","    let storeDrops = store.dropReports","    let collectorDrops = collector.dropReports","    Task {","        await withDiscardingTaskGroup { group in","            group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","            group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","            group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","            group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        }","    }","    return tracker","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then make the tracker the app’s default and hand it to the views, which track through it:"}]},{"code":["@main","struct StoreApp: App {","    let tracker: Tracker","","    init() {","        do {","            \/\/ The user's earlier decisions, which the app saved; undecided categories wait in memory.","            let tracker = try startAnalytics(consent: Consent(savedDecisions))","            \/\/ `Tracker.current` falls back to it where nothing else reaches, such as a detached task.","            try Tracker.bootstrap(tracker)","            self.tracker = tracker","        } catch {","            print(\"Analytics are off: \\(error)\")","            tracker = .noOp","        }","    }","","    var body: some Scene {","        WindowGroup {","            CartView()","                .tracker(tracker)","        }","    }","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            tracker.track(ProductAddedToCart(productID: \"canvas-tote\", quantity: 1))","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"text":" imports every module except ","type":"text"},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/JSONValues\/documentation\/JSONValues","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true},{"text":" and the testing modules, which are products of their own.","type":"text"}]},{"text":"Where to go next","level":3,"type":"heading","anchor":"Where-to-go-next"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set it up step by step, from adding the package to testing what you track: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Declare events and their constraints: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},{"type":"text","text":"; change one that has shipped:"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Track from SwiftUI, UIKit and AppKit views: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","isActive":true},{"type":"text","text":"; let screens, controls and"},{"type":"text","text":" "},{"type":"text","text":"the app’s lifecycle track themselves: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Reach the tracker from any code, batch records and add context to them: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep events when the app ends or goes offline before delivering them: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Ask for consent and gate events by it: ","type":"text"},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep a fraction of events or sessions: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Group events into sessions and stamp them with the app and device: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A session’s key is a UUIDv7, its start time in Unix milliseconds followed by random bits, held in","type":"text"},{"text":" ","type":"text"},{"text":"memory only.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Export the events’ schemas and catch breaking changes in CI: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Test what your code tracks: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Send to logs, traces, your own server, PostHog, Amplitude, Mixpanel, Segment, RudderStack,","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io, Google Analytics from a server or memory, with values for one destination alone:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Send to an analytics vendor not yet covered, from a module of your own:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Decide what belongs in an event and what stays out of it: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent"]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"metadata":{"title":"Traffluent","roleHeading":"Framework","role":"collection","symbolKind":"module","modules":[{"name":"Traffluent"}],"externalID":"Traffluent"},"topicSections":[{"title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"anchor":"Essentials"},{"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"],"anchor":"Guides"},{"title":"Choosing what to record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"anchor":"Choosing-what-to-record"},{"title":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","do