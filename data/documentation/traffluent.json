pe":"text"}]},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","type":"topic","kind":"article","role":"article","url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","type":"topic","kind":"article","role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it.","type":"text"}]},"doc://Persistence/documentation/Persistence":{"kind":"symbol","abstract":[],"title":"Persistence","role":"collection","url":"\/documentation\/persistence","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"title":"Tracking Events","type":"topic","kind":"article","role":"article","url":"\/documentation\/traffluent\/trackingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}]},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"kind":"symbol","abstract":[],"title":"TrackingPlanTesting","role":"collection","url":"\/documentation\/trackingplantesting","type":"topic","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"title":"Traffluent","role":"collection","url":"\/documentation\/traffluent","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"title":"GRDBPersistence","type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/grdbpersistence","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","abstract":[]},"doc://SwiftUITracking/documentation/SwiftUITracking":{"kind":"symbol","abstract":[],"title":"SwiftUITracking","role":"collection","url":"\/documentation\/swiftuitracking","type":"topic","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","type":"topic","kind":"article","role":"article","url":"\/documentation\/traffluent\/persistingrecords","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"title":"Identifying People","type":"topic","kind":"article","role":"article","url":"\/documentation\/traffluent\/identifyingpeople","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}]},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"kind":"article","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"title":"Testing What Your Code Tracks","role":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"title":"CollectorEncoding","type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/collectorencoding","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","abstract":[]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"kind":"symbol","abstract":[],"title":"HTTPDestinations","role":"collection","url":"\/documentation\/httpdestinations","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"kind":"article","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"title":"Sampling Events","role":"article","url":"\/documentation\/traffluent\/samplingevents","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"kind":"article","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"title":"Defining Events","role":"article","url":"\/documentation\/traffluent\/definingevents","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},"doc://Events/documentation/Events":{"title":"Events","type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/events","identifier":"doc:\/\/Events\/documentation\/Events","abstract":[]},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"kind":"article","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"title":"Choosing Destinations","role":"article","url":"\/documentation\/traffluent\/choosingdestinations","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"title":"LoggingDestinations","type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/loggingdestinations","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","abstract":[]},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"kind":"article","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"title":"Changing an Event","role":"article","url":"\/documentation\/traffluent\/changingevents","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"}}}