/PersistingRecords":{"kind":"article","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"type":"topic","title":"Persisting Records"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","url":"\/documentation\/swiftuitracking","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"type":"topic","title":"SwiftUITracking","kind":"symbol","role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"kind":"article","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","url":"\/documentation\/traffluent\/trackingplanworkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"type":"topic","title":"Exporting and Checking a Tracking Plan"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}],"type":"topic","title":"AutomaticControlTracking","kind":"symbol","role":"collection"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"kind":"symbol","role":"collection","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","url":"\/documentation\/collectorencoding","abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"type":"topic","title":"CollectorEncoding"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","url":"\/documentation\/traffluent\/trackingfromviews","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"type":"topic","title":"Tracking from SwiftUI, UIKit and AppKit","kind":"article","role":"article"},"doc://Sessions/documentation/Sessions":{"kind":"symbol","role":"collection","identifier":"doc:\/\/Sessions\/documentation\/Sessions","url":"\/documentation\/sessions","abstract":[{"text":"Put every event a tracker tracks in a session, and sample whole sessions.","type":"text"}],"type":"topic","title":"Sessions"},"doc://TrackerTesting/documentation/TrackerTesting":{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","url":"\/documentation\/trackertesting","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}],"type":"topic","title":"TrackerTesting","kind":"symbol","role":"collection"},"doc://Checksums/documentation/Checksums":{"kind":"symbol","role":"collection","identifier":"doc:\/\/Checksums\/documentation\/Checksums","url":"\/documentation\/checksums","abstract":[{"type":"text","text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it."}],"type":"topic","title":"Checksums"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","url":"\/documentation\/posthogencoding","abstract":[{"text":"Write batches of records for PostHog’s batch capture API, for an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" to send.","type":"text"}],"type":"topic","title":"PostHogEncoding","kind":"symbol","role":"collection"},"doc://Persistence/documentation/Persistence":{"kind":"symbol","role":"collection","identifier":"doc:\/\/Persistence\/documentation\/Persistence","url":"\/documentation\/persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"type":"topic","title":"Persistence"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","url":"\/documentation\/traffluent\/definingevents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"type":"topic","title":"Defining Events","kind":"article","role":"article"},"doc://TrackingPlans/documentation/TrackingPlans":{"kind":"symbol","role":"collection","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","url":"\/documentation\/trackingplans","abstract":[{"text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it.","type":"text"}],"type":"topic","title":"TrackingPlans"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","url":"\/documentation\/traffluent\/testingwhatyoutrack","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"type":"topic","title":"Testing What Your Code Tracks","kind":"article","role":"article"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"kind":"symbol","role":"collection","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","url":"\/documentation\/lifecycletracking","abstract":[{"text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s records durable as the app leaves the foreground.","type":"text"}],"type":"topic","title":"LifecycleTracking"},"doc://UIKitTracking/documentation/UIKitTracking":{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","url":"\/documentation\/uikittracking","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"type":"topic","title":"UIKitTracking","kind":"symbol","role":"collection"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"kind":"article","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","url":"\/documentation\/traffluent\/consentgating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"type":"topic","title":"Consent Gating"},"doc://TracingDestinations/documentation/TracingDestinations":{"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","url":"\/documentation\/tracingdestinations","abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"type":"topic","title":"TracingDestinations","kind":"symbol","role":"collection"},"doc://PropertyJSON/documentation/PropertyJSON":{"kind":"symbol","role":"collection","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","url":"\/documentation\/propertyjson","abstract":[],"type":"topic","title":"PropertyJSON"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","url":"\/documentation\/traffluent\/sessionsandstandardcontext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"type":"topic","title":"Sessions and Standard Context","kind":"article","role":"article"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"kind":"symbol","role":"collection","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","url":"\/documentation\/automaticscreentracking","abstract":[{"type":"text","text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on"},{"type":"text","text":" "},{"type":"text","text":"each screen."}],"type":"topic","title":"AutomaticScreenTracking"},"doc://Events/documentation/Events":{"identifier":"doc:\/\/Events\/documentation\/Events","url":"\/documentation\/events","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"type":"topic","title":"Events","kind":"symbol","role":"collection"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"kind":"symbol","role":"collection","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","url":"\/documentation\/httpdestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"type":"topic","title":"HTTPDestinations"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","url":"\/documentation\/grdbpersistence","abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"type":"topic","title":"GRDBPersistence","kind":"symbol","role":"collection"},"doc://EventMacros/documentation/EventMacros":{"kind":"symbol","role":"collection","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","url":"\/documentation\/eventmacros","abstract":[{"type":"text","text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy."}],"type":"topic","title":"EventMacros"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","url":"\/documentation\/traffluent\/choosingdestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"type":"topic","title":"Choosing Destinations","kind":"article","role":"article"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"kind":"symbol","role":"collection","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","url":"\/documentation\/trackingplantesting","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"type":"topic","title":"TrackingPlanTesting"},"doc://Destinations/documentation/Destinations":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","url":"\/documentation\/destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"code":"Destination","type":"codeVoice"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"type":"topic","title":"Destinations","kind":"symbol","role":"collection"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","role":"collection","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","url":"\/documentation\/traffluent","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"type":"topic","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","url":"\/documentation\/traffluent\/changingevents","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"type":"topic","title":"Changing an Event","kind":"article","role":"article"},"doc://StandardContext/documentation/StandardContext":{"kind":"symbol","role":"collection","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","url":"\/documentation\/standardcontext","abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"type":"topic","title":"StandardContext"},"doc://AppKitTracking/documentation/AppKitTracking":{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","url":"\/documentation\/appkittracking","abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}],"type":"topic","title":"AppKitTracking","kind":"symbol","role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","url":"\/documentation\/traffluent\/trackingevents","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"type":"topic","title":"Tracking Events"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","url":"\/documentation\/traffluent\/identifyingpeople","abstract":[{"text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent.","type":"text"}],"type":"topic","title":"Identifying People","kind":"article","role":"article"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"kind":"article","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","url":"\/documentation\/traffluent\/samplingevents","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"type":"topic","title":"Sampling Events"}}}