ing","role":"collection","kind":"symbol","type":"topic","abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","title":"PostHogEncoding"},"doc://Persistence/documentation/Persistence":{"url":"\/documentation\/persistence","role":"collection","identifier":"doc:\/\/Persistence\/documentation\/Persistence","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"type":"topic","title":"Persistence","kind":"symbol"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"url":"\/documentation\/collectorencoding","role":"collection","kind":"symbol","abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"type":"topic","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","title":"CollectorEncoding"},"doc://TrackerTesting/documentation/TrackerTesting":{"url":"\/documentation\/trackertesting","role":"collection","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}],"type":"topic","title":"TrackerTesting","kind":"symbol"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"url":"\/documentation\/automaticcontroltracking","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"type":"topic","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","title":"AutomaticControlTracking"},"doc://Traffluent/documentation/Traffluent/WritingAVendor