c:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","role":"article","title":"Defining Events","url":"\/documentation\/traffluent\/definingevents","type":"topic","kind":"article","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"role":"collection","title":"HTTPDestinations","url":"\/documentation\/httpdestinations","type":"topic","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://PropertyJSON/documentation/PropertyJSON":{"role":"collection","title":"PropertyJSON","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","url":"\/documentation\/propertyjson","kind":"symbol","type":"topic","abstract":[{"text":"The vendor-neutral pieces a JSON ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" is built from: properties, context, timestamps, identity and batch splitting.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"role":"article","title":"Writing a Vendor Destination","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","url":"\/documentation\/traffluent\/writingavendordestination","kind":"article","type":"topic","abstract":[{"text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"role":"article","title":"Tracking from SwiftUI, UIKit and 