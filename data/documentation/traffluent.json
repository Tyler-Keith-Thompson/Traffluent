ncoding","kind":"symbol","role":"collection","title":"TelemetryDeckEncoding","url":"\/documentation\/telemetrydeckencoding","abstract":[{"text":"Send records to TelemetryDeck as signals, through its Ingest API v3.","type":"text"}],"type":"topic"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"title":"TrackingPlanTesting","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/trackingplantesting"},"doc://AsyncQueues/documentation/AsyncQueues":{"kind":"symbol","title":"AsyncQueues","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues","type":"topic","role":"collection","abstract":[{"type":"text","text":"The sequence type of every report and delivery stream the library hands out, and of an app’s own, read by one task at a time."}],"url":"\/documentation\/asyncqueues"},"doc://JSONValues/documentation/JSONValues":{"title":"JSONValues","identifier":"doc:\/\/JSONValues\/documentation\/JSONValues","abstract":[{"text":"A JSON value that renders to the same bytes on every platform and Swift release.","type":"text"}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/jsonvalues"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","title":"Persisting Records","type":"topic","role":"article","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"url":"\/documentation\/traffluent\/persistingrecords"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/automatictracking"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","title":"Defining Events","type":"topic","role":"article","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"url":"\/documentation\/traffluent\/definingevents"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"title":"AutomaticControlTracking","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/automaticcontroltracking"},"doc://SnowplowEncoding/documentation/SnowplowEncoding":{"title":"SnowplowEncoding","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","abstract":[{"text":"Send records to a Snowplow collector as self-describing events, whose schemas come from the tracking plan.","type":"text"}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/snowplowencoding"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"title":"GoogleAnalyticsEncoding","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","abstract":[{"type":"text","text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol."}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/googleanalyticsencoding"},"doc://Events/documentation/Events":{"identifier":"doc:\/\/Events\/documentation\/Events","kind":"symbol","role":"collection","title":"Events","url":"\/documentation\/events","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/httpdestinations"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"url":"\/documentation\/traffluent\/gettingstarted","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","role":"article","title":"Getting Started","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"title":"Identifying People","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","abstract":[{"text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent.","type":"text"}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/identifyingpeople"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding":{"title":"SegmentSpecEncoding","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","abstract":[{"text":"Send records as Segment-spec track calls to Segment, RudderStack or Cu