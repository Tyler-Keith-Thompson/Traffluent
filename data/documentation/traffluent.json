{"metadata":{"role":"collection","externalID":"Traffluent","symbolKind":"module","modules":[{"name":"Traffluent"}],"title":"Traffluent","roleHeading":"Framework"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent"},"hierarchy":{"paths":[[]]},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"topicSections":[{"title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"anchor":"Essentials"},{"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"anchor":"Guides"},{"title":"Choosing what to record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"],"anchor":"Choosing-what-to-record"},{"title":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","doc:\/\/PropertyJSON\/documentation\/PropertyJSON","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"],"anchor":"Modules"},{"title":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"],"anchor":"Testing"}],"variants":[{"paths":["\/documentation\/traffluent"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An event is a value that conforms to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":", declared with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":". A "},{"type":"codeVoice","code":"Tracker"},{"type":"text","text":" is a value: tracking an event records it as an "},{"type":"codeVoice","code":"EventRecord"},{"type":"text","text":", with its timestamp, the caller’s "},{"type":"codeVoice","code":"SourceLocation"},{"type":"text","text":" and its "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":", as one of the tracker’s "},{"type":"codeVoice","code":"records"},{"type":"text","text":". Delivering is a chain of operators over that sequence: Afluent’s "},{"type":"codeVoice","code":"batch(strategy:)"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"batch()"},{"type":"text","text":", the default) gathers the records into batches, and "},{"type":"codeVoice","code":"deliver(to:)"},{"type":"text","text":" hands each batch to every destination, as a lazy unit of work. A "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" is a plain sink, narrowed or transformed by its modifiers: "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":" for the consent categories it serves, "},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"droppingCallSite()"},{"type":"text","text":". A tracker given a "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":" delivers an event only once the user grants its "},{"type":"codeVoice","code":"ConsentCategory"},{"type":"text","text":", holding it while undecided and dropping it when denied. "},{"type":"codeVoice","code":"track"},{"type":"text","text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value, which satisfies its "},{"type":"codeVoice","code":"Refinement"},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"Constraint"},{"type":"text","text":"s from the moment it is made, or carries constraints declared with "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a "},{"type":"codeVoice","code":"RejectionReport"},{"type":"text","text":" on "},{"type":"codeVoice","code":"rejectionReports"},{"type":"text","text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},{"type":"text","text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":"), and AppKit views find it up their responder chain ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},{"type":"text","text":"); a control’s "},{"type":"codeVoice","code":"track"},{"type":"text","text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with "},{"type":"codeVoice","code":"trackScreensAutomatically"},{"type":"text","text":", which tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" as each screen’s view controller appears, without swizzling ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking"},{"type":"text","text":"), and UIKit controls once a window scene turns it on with "},{"type":"codeVoice","code":"trackControlsAutomatically"},{"type":"text","text":", which tracks "},{"type":"codeVoice","code":"ControlActivated"},{"type":"text","text":" as a touch activates each control named by its accessibility identifier ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking"},{"type":"text","text":"). On every platform, "},{"type":"codeVoice","code":"trackLifecycle"},{"type":"text","text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking"},{"type":"text","text":"). A tracker given the "},{"type":"codeVoice","code":"Enricher.sessions"},{"type":"text","text":" enricher stamps every event with its session’s "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking "},{"type":"codeVoice","code":"SessionEnded"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"},{"type":"text","text":"). A tracker given "},{"type":"codeVoice","code":"Sampler"},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with "},{"type":"codeVoice","code":"Sampler.sessions(rate:)"},{"type":"text","text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a "},{"type":"codeVoice","code":"SamplingDropReport"},{"type":"text","text":" and stamping each kept record with its "},{"type":"codeVoice","code":"SampleRateKey"},{"type":"text","text":". The standard enrichers, "},{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":", "},{"type":"codeVoice","code":"device()"},{"type":"text","text":", "},{"type":"codeVoice","code":"operatingSystem()"},{"type":"text","text":", "},{"type":"codeVoice","code":"locale()"},{"type":"text","text":", "},{"type":"codeVoice","code":"network()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vendorIdentifier()"},{"type":"text","text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"import Traffluent"},{"text":" imports ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},{"text":", whose ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" macro derives an event’s conformances","type":"text"},{"text":" ","type":"text"},{"text":"and schema from its declaration, and every other module but ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},{"text":", a product of its","type":"text"},{"text":" ","type":"text"},{"text":"own for apps that already use GRDB; ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},{"text":", which runs that check from an app’s tests; and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"type":"codeVoice","code":"withRecordingTracker"},{"text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own.","type":"text"}],"type":"paragraph"},{"code":["import Traffluent","","@Event","struct SignedUp {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"syntax":"swift","type":"codeListing"}]}],"references":{"doc://Destinations/documentation/Destinations":{"title":"Destinations","type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"type":"codeVoice","code":"Destination"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}],"url":"\/documentation\/destinations","role":"collection","kind":"symbol"},"doc://Trackers/documentation/Trackers":{"title":"Trackers","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"url":"\/documentation\/trackers","role":"collection","kind":"symbol"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"title":"LoggingDestinations","kind":"symbol","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"role":"collection","type":"topic","url":"\/documentation\/loggingdestinations"},"doc://TrackerTesting/documentation/TrackerTesting":{"title":"TrackerTesting","type":"topic","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"url":"\/documentation\/trackertesting","role":"collection","kind":"symbol"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"title":"TrackingPlanTesting","kind":"symbol","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","role":"collection","type":"topic","url":"\/documentation\/trackingplantesting"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"title":"CollectorEncoding","kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"role":"collection","type":"topic","url":"\/documentation\/collectorencoding"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"url":"\/documentation\/traffluent\/sessionsandstandardcontext","role":"article","kind":"article"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"title":"SwiftUITracking","type":"topic","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"url":"\/documentation\/swiftuitracking","role":"collection","kind":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans":{"title":"TrackingPlans","type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","abstract":[{"type":"text","text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it."}],"url":"\/documentation\/trackingplans","role":"collection","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"title":"Logging, Tracing, Metrics and Analytics","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","abstract":[{"type":"text","text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it."}],"url":"\/documentation\/traffluent\/whatgoeswhere","role":"article","kind":"article"},"doc://Checksums/documentation/Checksums":{"title":"Checksums","identifier":"doc:\/\/Checksums\/documentation\/Checksums","kind":"symbol","abstract":[{"text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it.","type":"text"}],"role":"collection","type":"topic","url":"\/documentation\/checksums"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"title":"AutomaticScreenTracking","type":"topic","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","abstract":[{"type":"text","text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on"},{"type":"text","text":" "},{"type":"text","text":"each screen."}],"url":"\/documentation\/automaticscreentracking","role":"collection","kind":"symbol"},"doc://Persistence/documentation/Persistence":{"title":"Persistence","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"url":"\/documentation\/persistence","role":"collection","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"role":"collection","type":"topic","url":"\/documentation\/httpdestinations"},"doc://Events/documentation/Events":{"title":"Events","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"url":"\/documentation\/events","role":"collection","kind":"symbol"},"doc://StandardContext/documentation/StandardContext":{"title":"StandardContext","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","kind":"symbol","abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"role":"collection","type":"topic","url":"\/documentation\/standardcontext"},"doc://AppKitTracking/documentation/AppKitTracking":{"title":"AppKitTracking","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/appkittracking"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/persistingrecords"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","kind":"article","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","role":"article","type":"topic","url":"\/documentation\/traffluent\/samplingevents"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"title":"Identifying People","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"url":"\/documentation\/traffluent\/identifyingpeople","role":"article","kind":"article"},"doc://Sessions/documentation/Sessions":{"title":"Sessions","kind":"symbol","abstract":[{"type":"text","text":"Put every event a tracker tracks in a session, and sample whole sessions."}],"identifier":"doc:\/\/Sessions\/documentation\/Sessions","role":"collection","type":"topic","url":"\/documentation\/sessions"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"title":"Privacy Manifests","kind":"article","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","role":"article","type":"topic","url":"\/documentation\/traffluent\/privacymanifests"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"title":"AutomaticControlTracking","type":"topic","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"url":"\/documentation\/automaticcontroltracking","role":"collection","kind":"symbol"},"doc://UIKitTracking/documentation/UIKitTracking":{"title":"UIKitTracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","kind":"symbol","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"role":"collection","type":"topic","url":"\/documentation\/uikittracking"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"title":"GRDBPersistence","type":"topic","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"url":"\/documentation\/grdbpersistence","role":"collection","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"title":"Tracking Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/trackingevents"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"title":"PostHogEncoding","kind":"symbol","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","abstract":[{"text":"Write batches of records for PostHog’s batch capture API, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"role":"collection","type":"topic","url":"\/documentation\/posthogencoding"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"title":"Defining Events","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"url":"\/documentation\/traffluent\/definingevents","role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"role":"article","type":"topic","url":"\/documentation\/traffluent\/choosingdestinations"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"title":"Testing What Your Code Tracks","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"url":"\/documentation\/traffluent\/testingwhatyoutrack","role":"article","kind":"article"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"title":"LifecycleTracking","kind":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","abstract":[{"type":"text","text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s records durable as the app leaves the foreground."}],"role":"collection","type":"topic","url":"\/documentation\/lifecycletracking"},"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"url":"\/documentation\/traffluent","role":"collection","kind":"symbol"},"doc://PropertyJSON/documentation/PropertyJSON":{"title":"PropertyJSON","kind":"symbol","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","abstract":[],"role":"collection","type":"topic","url":"\/documentation\/propertyjson"},"doc://TracingDestinations/documentation/TracingDestinations":{"title":"TracingDestinations","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","kind":"symbol","abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"role":"collection","type":"topic","url":"\/documentation\/tracingdestinations"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"url":"\/documentation\/traffluent\/trackingplanworkflow","role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"title":"Changing an Event","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/changingevents"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/consentgating"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","kind":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"role":"article","type":"topic","url":"\/documentation\/traffluent\/automatictracking"},"doc://EventMacros/documentation/EventMacros":{"title":"EventMacros","type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"url":"\/documentation\/eventmacros","role":"collection","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"title":"Tracking from SwiftUI, UIKit and AppKit","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"url":"\/documentation\/traffluent\/trackingfromviews","role":"article","kind":"article"}}}