ns","url":"\/documentation\/httpdestinations","type":"topic","title":"HTTPDestinations"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"abstract":[{"type":"text","text":"Write batches of records for PostHog’s batch capture API, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","title":"PostHogEncoding","url":"\/documentation\/posthogencoding","role":"collection","type":"topic","kind":"symbol"},"doc://AppKitTracking/documentation/AppKitTracking":{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","role":"collection","type":"topic","kind":"symbol","title":"AppKitTracking","url":"\/documentation\/appkittracking","abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}]},"doc://EventMacros/documentation/EventMacros":{"role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy."}],"url":"\/documentation\/eventmacros","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","type":"topic","title":"EventMacros"},"doc://Sessions/documentation/Sessions":{"title":"Sessions","url":"\/documentation\/sessions","abstract":[{"text":"Put every event a tracker tracks in a session, and sample whole sessions.","type":"text"}],"kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/Sessions\/documentation\/Sessions"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"role":"article","kind":"article","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","url":"\/documentation\/traffluent\/testingwhatyoutrack","type":"topic","title":"Testing What Your Code Tracks"},"doc://Tr