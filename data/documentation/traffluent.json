BPersistence":{"type":"topic","url":"\/documentation\/grdbpersistence","role":"collection","kind":"symbol","title":"GRDBPersistence","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","abstract":[{"type":"text","text":"Keep each record in a table of the app’s own GRDB database until it is delivered."}]},"doc://TrackerTesting/documentation/TrackerTesting":{"type":"topic","url":"\/documentation\/trackertesting","role":"collection","kind":"symbol","title":"TrackerTesting","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"title":"Privacy Manifests","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","kind":"article","type":"topic","role":"article","url":"\/documentation\/traffluent\/privacymanifests"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"url":"\/documentation\/trackingplantesting","abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","title":"TrackingPlanTesting","role":"collection","type":"topic","kind":"symbol"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"url":"\/documentation\/automaticscreentracking","abstract":[{"type":"text","text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on"},{"type":"text","text":" "},{"type":"text","text":"each screen."}],"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","title":"AutomaticScreenTracking","role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"type":"topic","url":"\/documentation\/traffluent\/gettingstarted","role":"article","title":"Getting Started","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}]},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"type":"topic","url":"\/documentation\/traffluent\/choosingdestinations","role":"article","title":"Choosing Destinations","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}]},"doc://Destinations/documentation/Destinations":{"type":"topic","url":"\/documentation\/destinations","role":"collection","title":"Destinations","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}]},"doc://EventMacros/documentation/EventMacros":{"url":"\/documentation\/eventmacros","abstract":[{"type":"text","text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy."}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","title":"EventMacros","role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"type":"topic","url":"\/documentation\/traffluent\/trackingplanworkflow","role":"article","kind":"article","title":"Exporting and Checking a Tracking Plan","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}]},"doc://Trackers/documentation/Trackers":{"url":"\/documentation\/trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers","role":"collection","type":"topic","kind":"symbol"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"type":"topic","url":"\/documentation\/loggingdestinations","role":"collection","title":"LoggingDestinations","kind":"symbol","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}]},"doc://SwiftUITracking/documentation/SwiftUITracking":{"url":"\/documentation\/swiftuitracking","abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","title":"SwiftUITracking","role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"type":"topic","url":"\/documentation\/traffluent\/identifyingpeople","role":"article","title":"Identifying People","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}]},"doc://TracingDestinations/documentation/TracingDestinations":{"type":"topic","url":"\/documentation\/tracingdestinations","role":"collection","title":"TracingDestinations","kind":"symbol","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","abstract":[{"type":"text","text":"A destination that adds each tracked event to the span that was active when it was tracked."}]}}}