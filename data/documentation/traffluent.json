{"metadata":{"modules":[{"name":"Traffluent"}],"role":"collection","title":"Traffluent","symbolKind":"module","roleHeading":"Framework","externalID":"Traffluent"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent"]}],"kind":"symbol","primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event is a struct, so the compiler checks its name and every property. A tracker holds back"},{"type":"text","text":" "},{"type":"text","text":"the events the user hasn’t consented to, stamps the rest with their session and device, keeps them"},{"type":"text","text":" "},{"type":"text","text":"on disk and delivers them to your server, sending again when the network or the server fails."}]},{"type":"heading","anchor":"An-apps-analytics-from-launch","level":3,"text":"An app’s analytics, from launch"},{"type":"paragraph","inlineContent":[{"text":"Declare the events. The tracker rejects an event that breaks a constraint before it is stored or","type":"text"},{"text":" ","type":"text"},{"text":"delivered, and a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value reaches only the destinations that don’t redact it:","type":"text"}]},{"type":"codeListing","code":["import SwiftUI","import Traffluent","import TrackingPlans","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart {","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Build the tracker and start its delivery once, as the app launches:","type":"text"}]},{"type":"codeListing","code":["func startAnalytics(consent: Consent) throws -> Tracker {","    let plan = try TrackingPlan(schemas: [","        ProductAddedToCart.schema, SignedUp.schema, SessionStarted.schema, SessionEnded.schema,","    ])","    \/\/ Records wait on disk until they are delivered, across launches.","    let store = try SegmentStore(events: [","        ProductAddedToCart.self, SignedUp.self, SessionStarted.self, SessionEnded.self,","    ])","    \/\/ Every event gets its session, and the app, device, OS, locale and network it was tracked on.","    let tracker = Tracker(","        store: store,","        consent: consent,","        enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()])","","    let collector = HTTPDestination(","        endpoint: collectorURL,","        headerFields: [.authorization: \"Bearer \\(apiKey)\"],","        encoder: CollectorBatchEncoder(plan: plan))","    \/\/ Analytics events only, without their email addresses, 20 at a time or every 30 seconds.","    let delivery = tracker.records.batch().deliver(","        to: collector.accepting(.analytics).redactingSensitiveValues())","    Task {","        do {","            try await delivery.execute()  \/\/ for the life of the app","        } catch {","            print(\"Delivery stopped: \\(error)\")","        }","    }","","    \/\/ Every event that won't arrive, and why.","    let rejections = tracker.rejectionReports","    let consentDrops = consent.dropReports","    let storeDrops = store.dropReports","    let collectorDrops = collector.dropReports","    Task {","        await withDiscardingTaskGroup { group in","            group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","            group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","            group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","            group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        }","    }","    return tracker","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then make the tracker the app’s default and hand it to the views, which track through it:"}]},{"type":"codeListing","code":["@main","struct StoreApp: App {","    let tracker: Tracker","","    init() {","        do {","            \/\/ The user's earlier decisions, which the app saved; undecided categories wait in memory.","            let tracker = try startAnalytics(consent: Consent(savedDecisions))","            \/\/ `Tracker.current` falls back to it where nothing else reaches, such as a detached task.","            try Tracker.bootstrap(tracker)","            self.tracker = tracker","        } catch {","            print(\"Analytics are off: \\(error)\")","            tracker = .noOp","        }","    }","","    var body: some Scene {","        WindowGroup {","            CartView()","                .tracker(tracker)","        }","    }","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            tracker.track(ProductAddedToCart(productID: \"canvas-tote\", quantity: 1))","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import Traffluent"},{"text":" imports every module except ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","type":"reference","isActive":true},{"text":" and the testing modules, which are products of their own.","type":"text"}]},{"type":"heading","anchor":"Where-to-go-next","level":3,"text":"Where to go next"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Set it up step by step, from adding the package to testing what you track: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Declare events and their constraints: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},{"text":"; change one that has shipped:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Track from SwiftUI, UIKit and AppKit views: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"},{"type":"text","text":"; let screens, controls and"},{"type":"text","text":" "},{"type":"text","text":"the app’s lifecycle track themselves: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Reach the tracker from any code, batch records and add context to them: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Keep events when the app ends or goes offline before delivering them: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Ask for consent and gate events by it: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Keep a fraction of events or sessions: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Group events into sessions and stamp them with the app and device: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A session’s key is a UUIDv7, its start time in Unix milliseconds followed by random bits, held in","type":"text"},{"text":" ","type":"text"},{"text":"memory only.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Export the events’ schemas and catch breaking changes in CI: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Test what your code tracks: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Send to logs, traces, your own server, PostHog or memory, with values for one destination"},{"type":"text","text":" "},{"type":"text","text":"alone: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Decide what belongs in an event and what stays out of it: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"