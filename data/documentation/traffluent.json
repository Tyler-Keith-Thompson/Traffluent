{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"variants":[{"paths":["\/documentation\/traffluent"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"role":"collection","roleHeading":"Framework","externalID":"Traffluent","symbolKind":"module","title":"Traffluent","modules":[{"name":"Traffluent"}]},"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"]},{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"]},{"anchor":"Choosing-what-to-record","title":"Choosing what to record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"]},{"anchor":"Modules","title":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","doc:\/\/PropertyJSON\/documentation\/PropertyJSON","doc:\/\/JSONValues\/documentation\/JSONValues","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/AsyncQueues\/documentation\/AsyncQueues","doc:\/\/Checksums\/documentation\/Checksums"]},{"anchor":"Testing","title":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting","doc:\/\/DestinationTesting\/documentation\/DestinationTesting"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Each event is a struct, so the compiler checks its name and every property. A tracker holds back"},{"type":"text","text":" "},{"type":"text","text":"the events the user hasn’t consented to, stamps the rest with their session and device, keeps them"},{"type":"text","text":" "},{"type":"text","text":"on disk and delivers them to your server, sending again when the network or the server fails."}],"type":"paragraph"},{"text":"An app’s analytics, from launch","anchor":"An-apps-analytics-from-launch","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Declare the events. The tracker rejects an event that breaks a constraint before it is stored or"},{"type":"text","text":" "},{"type":"text","text":"delivered, and a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value reaches only the destinations that don’t redact it:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import Traffluent","import TrackingPlans","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart {","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","}"]},{"inlineContent":[{"type":"text","text":"Build the tracker and start its delivery once, as the app launches:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func startAnalytics(consent: Consent) throws -> Tracker {","    \/\/ The plan and the store each take every @Event in the app, and the library's own.","    let plan = try TrackingPlan()","    \/\/ Records wait on disk until they are delivered, across launches.","    let store = try SegmentStore()","    \/\/ Every event gets its session, and the app, device, OS, locale and network it was tracked on.","    let tracker = Tracker(","        store: store,","        consent: consent,","        enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()])","","    let collector = HTTPDestination(","        endpoint: collectorURL,","        headerFields: [.authorization: \"Bearer \\(apiKey)\"],","        encoder: CollectorBatchEncoder(plan: plan))","    \/\/ Analytics events only, without their email addresses, 20 at a time or every 30 seconds.","    let delivery = tracker.records.batch().deliver(","        to: collector.accepting(.analytics).redactingSensitiveValues())","    Task {","        do {","            try await delivery.execute()  \/\/ for the life of the app","        } catch {","            print(\"Delivery stopped: \\(error)\")","        }","    }","","    \/\/ Every event that won't arrive, and why.","    let rejections = tracker.rejectionReports","    let consentDrops = consent.dropReports","    let storeDrops = store.dropReports","    let collectorDrops = collector.dropReports","    Task {","        await withDiscardingTaskGroup { group in","            group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","            group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","            group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","            group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        }","    }","    return tracker","}"]},{"inlineContent":[{"text":"Then make the tracker the app’s default and hand it to the views, which track through it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@main","struct StoreApp: App {","    let tracker: Tracker","","    init() {","        do {","            \/\/ The user's earlier decisions, which the app saved; undecided categories wait in memory.","            let tracker = try startAnalytics(consent: Consent(savedDecisions))","            \/\/ `Tracker.current` falls back to it where nothing else reaches, such as a detached task.","            try Tracker.bootstrap(tracker)","            self.tracker = tracker","        } catch {","            print(\"Analytics are off: \\(error)\")","            tracker = .noOp","        }","    }","","    var body: some Scene {","        WindowGroup {","            CartView()","                .tracker(tracker)","        }","    }","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            tracker.track(ProductAddedToCart(productID: \"canvas-tote\", quantity: 1))","        }","    }","}"]},{"inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" imports every module except "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/JSONValues\/documentation\/JSONValues","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true,"type":"reference"},{"type":"text","text":" and the testing"},{"type":"text","text":" "},{"type":"text","text":"modules, which are products of their own."}],"type":"paragraph"},{"text":"Where to go next","anchor":"Where-to-go-next","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"text":"Set it up step by step, from adding the package to testing what you track: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Declare events and their constraints: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},{"type":"text","text":"; change one that has shipped:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Track from SwiftUI, UIKit and AppKit views: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"reference","isActive":true},{"text":"; let screens, controls and","type":"text"},{"text":" ","type":"text"},{"text":"the app’s lifecycle track themselves: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Reach the tracker from any code, batch records and add context to them: ","type":"text"},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep events when the app ends or goes offline before delivering them: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Ask for consent and gate events by it: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep a fraction of events or sessions: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Group events into sessions and stamp them with the app and device: ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A session’s key is a UUIDv7, its start time in Unix milliseconds followed by random bits, held in","type":"text"},{"text":" ","type":"text"},{"text":"memory only.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Export the events’ schemas and catch breaking changes in CI: "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Test what your code tracks: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Send to logs, traces, your own server, PostHog, Amplitude or memory, with values for one"},{"type":"text","text":" "},{"type":"text","text":"destination alone: "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Send to an analytics vendor not yet covered, from a module of your own:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Decide what belongs in an event and what stays out of it: "},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"references":{"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","type":"topic","url":"\/documentation\/traffluent\/changingevents","abstract":[{"text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it.","type":"text"}],"title":"Changing an Event","role":"article"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","url":"\/documentation\/traffluent\/definingevents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"title":"Defining Events","role":"article"},"doc://Persistence/documentation/Persistence":{"abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"url":"\/documentation\/persistence","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence","title":"Persistence"},"doc://DestinationTesting/documentation/DestinationTesting":{"kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","type":"topic","url":"\/documentation\/destinationtesting","abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"title":"DestinationTesting","role":"collection"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/choosingdestinations","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","title":"Choosing Destinations"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"kind":"symbol","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"topic","url":"\/documentation\/posthogencoding","abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}],"title":"PostHogEncoding","role":"collection"},"doc://UIKitTracking/documentation/UIKitTracking":{"kind":"symbol","url":"\/documentation\/uikittracking","role":"collection","type":"topic","title":"UIKitTracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}]},"doc://TrackerTesting/documentation/TrackerTesting":{"kind":"symbol","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","type":"topic","url":"\/documentation\/trackertesting","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}],"title":"TrackerTesting","role":"collection"},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"title":"Writing a Vendor Destination","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/writingavendordestination"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","url":"\/documentation\/traffluent","role":"collection","type":"topic","title":"Traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}]},"doc://AsyncQueues/documentation/AsyncQueues":{"kind":"symbol","url":"\/documentation\/asyncqueues","role":"collection","type":"topic","title":"AsyncQueues","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues","abstract":[{"type":"text","text":"The sequence type of every report and delivery stream the library hands out, and of an app’s own, read by one task at a time."}]},"doc://Destinations/documentation/Destinations":{"abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/destinations","title":"Destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://Trackers/documentation/Trackers":{"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"topic","url":"\/documentation\/trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"title":"Trackers","role":"collection"},"doc://Sessions/documentation/Sessions":{"url":"\/documentation\/sessions","kind":"symbol","role":"collection","type":"topic","title":"Sessions","identifier":"doc:\/\/Sessions\/documentation\/Sessions","abstract":[{"text":"Put every event a tracker tracks in a session, and sample whole sessions.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","type":"topic","url":"\/documentation\/traffluent\/sessionsandstandardcontext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"title":"Sessions and Standard Context","role":"article"},"doc://AppKitTracking/documentation/AppKitTracking":{"kind":"symbol","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"topic","url":"\/documentation\/appkittracking","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"title":"AppKitTracking","role":"collection"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","type":"topic","url":"\/documentation\/traffluent\/samplingevents","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"title":"Sampling Events","role":"article"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"url":"\/documentation\/traffluent\/consentgating","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"role":"article","type":"topic","kind":"article","title":"Consent Gating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"title":"Privacy Manifests","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","kind":"article","abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}],"role":"article","type":"topic","url":"\/documentation\/traffluent\/privacymanifests"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"title":"GRDBPersistence","kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/grdbpersistence","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","abstract":[{"type":"text","text":"Keep each record in a table of the app’s own GRDB database until it is delivered."}]},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"topic","url":"\/documentation\/traffluent\/trackingevents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"title":"Tracking Events","role":"article"},"doc://Checksums/documentation/Checksums":{"kind":"symbol","url":"\/documentation\/checksums","role":"collection","type":"topic","title":"Checksums","identifier":"doc:\/\/Checksums\/documentation\/Checksums","abstract":[{"type":"text","text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it."}]},"doc://CollectorEncoding/documentation/CollectorEncoding":{"title":"CollectorEncoding","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/collectorencoding"},"doc://TracingDestinations/documentation/TracingDestinations":{"kind":"symbol","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","role":"collection","type":"topic","url":"\/documentation\/tracingdestinations","title":"TracingDestinations","abstract":[{"type":"text","text":"A destination that adds each tracked event to the span that was active when it was tracked."}]},"doc://Events/documentation/Events":{"kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events","type":"topic","url":"\/documentation\/events","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"title":"Events","role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"kind":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","role":"article","type":"topic","title":"Exporting and Checking a Tracking Plan","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}]},"doc://SwiftUITracking/documentation/SwiftUITracking":{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"role":"collection","type":"topic","title":"SwiftUITracking","url":"\/documentation\/swiftuitracking","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"title":"Persisting Records","role":"article"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"kind":"symbol","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","type":"topic","url":"\/documentation\/trackingplantesting","abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"title":"TrackingPlanTesting","role":"collection"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"title":"AmplitudeEncoding","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","kind":"symbol","abstract":[{"type":"text","text":"Send records to an Amplitude project through its HTTP V2 API."}],"role":"collection","type":"topic","url":"\/documentation\/amplitudeencoding"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","title":"Logging, Tracing, Metrics and Analytics","kind":"article","abstract":[{"text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it.","type":"text"}],"role":"article","type":"topic","url":"\/documentation\/traffluent\/whatgoeswhere"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","title":"Identifying People","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/identifyingpeople"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"topic","url":"\/documentation\/traffluent\/trackingfromviews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"title":"Tracking from SwiftUI, UIKit and AppKit","role":"article"},"doc://TrackingPlans/documentation/TrackingPlans":{"identifier":"doc:\/\/TrackingPlans\/documentation