{"variants":[{"paths":["\/documentation\/traffluent"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"]},{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"]},{"anchor":"Choosing-what-to-record","title":"Choosing what to record","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"]},{"anchor":"Modules","title":"Modules","identifiers":["doc:\/\/Events\/documentation\/Events","doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","doc:\/\/UIKitTracking\/documentation\/UIKitTracking","doc:\/\/AppKitTracking\/documentation\/AppKitTracking","doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","doc:\/\/TracingDestinations\/documentation\/TracingDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","doc:\/\/EventMacros\/documentation\/EventMacros","doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/Checksums\/documentation\/Checksums"]},{"anchor":"Testing","title":"Testing","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","doc:\/\/TrackerTesting\/documentation\/TrackerTesting"]}],"hierarchy":{"paths":[[]]},"metadata":{"symbolKind":"module","role":"collection","modules":[{"name":"Traffluent"}],"title":"Traffluent","roleHeading":"Framework","externalID":"Traffluent"},"abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"An event is a value conforming to ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"Tracker","type":"codeVoice"},{"text":" is a value: tracking an event records it as an ","type":"text"},{"code":"EventRecord","type":"codeVoice"},{"text":", with its timestamp, the caller’s ","type":"text"},{"code":"SourceLocation","type":"codeVoice"},{"text":" and its ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":", as one of the tracker’s ","type":"text"},{"code":"records","type":"codeVoice"},{"text":". Delivering is a chain of operators over that sequence: Afluent’s ","type":"text"},{"code":"batch(strategy:)","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"batch()","type":"codeVoice"},{"text":", the default) gathers the records into batches, and ","type":"text"},{"code":"deliver(to:)","type":"codeVoice"},{"text":" hands each batch to every destination, as a lazy unit of work. A ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" is a plain sink, narrowed or transformed by its modifiers: ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":" for the consent categories it serves, ","type":"text"},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"droppingCallSite()","type":"codeVoice"},{"text":". A tracker given a ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":" delivers an event only once the user grants its ","type":"text"},{"code":"ConsentCategory","type":"codeVoice"},{"text":", holding it while undecided and dropping it when denied. ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" only queues an event, from any thread; a worker the tracker owns, never on the main actor, does the rest. A tracker given a ","type":"text"},{"code":"SegmentStore","type":"codeVoice"},{"text":" writes each record to disk as its worker reaches it and delivers what an earlier run left first. A property whose valid values are narrower than its type is a ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" value, which satisfies its ","type":"text"},{"code":"Refinement","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"Constraint","type":"codeVoice"},{"text":"s from the moment it is made, or carries constraints declared with ","type":"text"},{"code":"@Constrained","type":"codeVoice"},{"text":"; the tracker’s worker rejects an event that breaks one before anything else, reporting each as a ","type":"text"},{"code":"RejectionReport","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"rejectionReports","type":"codeVoice"},{"text":". On Apple platforms, SwiftUI views read the tracker from the environment and track what they do with view modifiers, and a screen’s events carry its ","type":"text"},{"code":"ScreenKey","type":"codeVoice"},{"text":" (","type":"text"},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true,"type":"reference"},{"text":"). UIKit views and view controllers inherit it as a trait, the same value as SwiftUI’s, set on a window scene (","type":"text"},{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true,"type":"reference"},{"text":"), and AppKit views find it up their responder chain (","type":"text"},{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","isActive":true,"type":"reference"},{"text":"); a control’s ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" tracks an event through the tracker found when its action fires, so each scene or window can have its own. Screen views can track themselves once a window scene or window turns it on with ","type":"text"},{"code":"trackScreensAutomatically","type":"codeVoice"},{"text":", which tracks ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" as each screen’s view controller appears, without swizzling (","type":"text"},{"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","isActive":true,"type":"reference"},{"text":"), and UIKit controls once a window scene turns it on with ","type":"text"},{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":", which tracks ","type":"text"},{"code":"ControlActivated","type":"codeVoice"},{"text":" as a touch activates each control named by its accessibility identifier (","type":"text"},{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","isActive":true,"type":"reference"},{"text":"). On every platform, ","type":"text"},{"code":"trackLifecycle","type":"codeVoice"},{"text":" tracks the app’s installs, updates, opens, moves to the background and terminations, and makes the tracker’s records durable as it leaves the foreground (","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","isActive":true,"type":"reference"},{"text":"). A tracker given the ","type":"text"},{"code":"Enricher.sessions","type":"codeVoice"},{"text":" enricher stamps every event with its session’s ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", a random identifier held in memory only, and starts a new session after a timeout of inactivity, tracking ","type":"text"},{"code":"SessionEnded","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"SessionStarted","type":"codeVoice"},{"text":" (","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true,"type":"reference"},{"text":"). A tracker given ","type":"text"},{"code":"Sampler","type":"codeVoice"},{"text":"s keeps a seeded fraction of the events they apply to, event by event, or whole sessions with ","type":"text"},{"code":"Sampler.sessions(rate:)","type":"codeVoice"},{"text":", dropping the rest on its worker before they are held, written or delivered, reporting each drop as a ","type":"text"},{"code":"SamplingDropReport","type":"codeVoice"},{"text":" and stamping each kept record with its ","type":"text"},{"code":"SampleRateKey","type":"codeVoice"},{"text":". The standard enrichers, ","type":"text"},{"code":"Enricher.application()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"operatingSystem()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"locale()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"network()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"vendorIdentifier()","type":"codeVoice"},{"text":", stamp every event with the app, device, operating system, locale, network connection and the platform’s identifier for vendor, each under a typed key, the static ones read once (","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" imports every module but "},{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","type":"reference","isActive":true},{"type":"text","text":", a product of its own for apps"},{"type":"text","text":" "},{"type":"text","text":"that already use GRDB; "},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","type":"reference","isActive":true},{"type":"text","text":", whose "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" macro derives an event’s conformances"},{"type":"text","text":" "},{"type":"text","text":"and schema from its declaration and which alone builds swift-syntax; "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","type":"reference","isActive":true},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"exports those schemas as a JSON Schema tracking plan and checks the events against a committed one;"},{"type":"text","text":" "},{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","type":"reference","isActive":true},{"type":"text","text":", which runs that check from an app’s tests; and "},{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose "},{"code":"withRecordingTracker","type":"codeVoice"},{"type":"text","text":" gives a test’s body a fresh tracker and returns what it tracked. Each module also has its own documentation and can be imported on its own."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import Traffluent","","struct SignedUp: Event {","    var plan: String","}","","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"]}]}],"references":{"doc://StandardContext/documentation/StandardContext":{"type":"topic","title":"StandardContext","role":"collection","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","url":"\/documentation\/standardcontext","abstract":[],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"type":"topic","title":"Consent Gating","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","url":"\/documentation\/traffluent\/consentgating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"kind":"article"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"type":"topic","title":"LifecycleTracking","role":"collection","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","url":"\/documentation\/lifecycletracking","kind":"symbol","abstract":[]},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"role":"collection","type":"topic","url":"\/documentation\/trackingplantesting","abstract":[],"title":"TrackingPlanTesting","kind":"symbol","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"doc://Sessions/documentation/Sessions":{"type":"topic","title":"Sessions","role":"collection","identifier":"doc:\/\/Sessions\/documentation\/Sessions","url":"\/documentation\/sessions","abstract":[],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"role":"article","type":"topic","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"url":"\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},"doc://Events/documentation/Events":{"type":"topic","title":"Events","role":"collection","identifier":"doc:\/\/Events\/documentation\/Events","url":"\/documentation\/events","abstract":[],"kind":"symbol"},"doc://EventMacros/documentation/EventMacros":{"role":"collection","type":"topic","abstract":[],"url":"\/documentation\/eventmacros","title":"EventMacros","kind":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"role":"collection","type":"topic","url":"\/documentation\/httpdestinations","abstract":[],"title":"HTTPDestinations","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"type":"topic","title":"Changing an Event","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","url":"\/documentation\/traffluent\/changingevents","abstract":[{"text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it.","type":"text"}],"kind":"article"},"doc://AppKitTracking/documentation/AppKitTracking":{"type":"topic","title":"AppKitTracking","role":"collection","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","url":"\/documentation\/appkittracking","abstract":[],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent":{"role":"collection","type":"topic","url":"\/documentation\/traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"title":"Traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"role":"collection","type":"topic","url":"\/documentation\/loggingdestinations","abstract":[],"title":"LoggingDestinations","kind":"symbol","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"type":"topic","title":"Exporting and Checking a Tracking Plan","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"kind":"article","url":"\/documentation\/traffluent\/trackingplanworkflow"},"doc://Checksums/documentation/Checksums":{"type":"topic","title":"Checksums","role":"collection","identifier":"doc:\/\/Checksums\/documentation\/Checksums","url":"\/documentation\/checksums","abstract":[],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","type":"topic","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"url":"\/documentation\/traffluent\/trackingevents","title":"Tracking Events","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"type":"topic","title":"Automatic Tracking","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"kind":"article","url":"\/documentation\/traffluent\/automatictracking"},"doc://TracingDestinations/documentation/TracingDestinations":{"role":"collection","type":"topic","url":"\/documentation\/tracingdestinations","abstract":[],"title":"TracingDestinations","kind":"symbol","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"type":"topic","title":"Testing What Your Code Tracks","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","url":"\/documentation\/traffluent\/testingwhatyoutrack","kind":"article","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}]},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"type":"topic","title":"Sessions and Standard Context","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","url":"\/documentation\/traffluent\/sessionsandstandardcontext","kind":"article","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}]},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"role":"article","type":"topic","url":"\/documentation\/traffluent\/identifyingpeople","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"title":"Identifying People","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"type":"topic","title":"GRDBPersistence","role":"collection","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","abstract":[],"kind":"symbol","url":"\/documentation\/grdbpersistence"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"type":"topic","title":"AutomaticControlTracking","role":"collection","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking","abstract":[],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"type":"topic","title":"Choosing Destinations","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","url":"\/documentation\/traffluent\/choosingdestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"kind":"article"},"doc://Destinations/documentation/Destinations":{"role":"collection","type":"topic","url":"\/documentation\/destinations","abstract":[],"title":"Destinations","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://Trackers/documentation/Trackers":{"role":"collection","type":"topic","url":"\/documentation\/trackers","abstract":[],"title":"Trackers","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://TrackingPlans/documentation/TrackingPlans":{"role":"collection","type":"topic","abstract":[],"url":"\/documentation\/trackingplans","title":"TrackingPlans","kind":"symbol","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"type":"topic","title":"SwiftUITracking","role":"collection","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","url":"\/documentation\/swiftuitracking","abstract":[],"kind":"symbol"},"doc://Persistence/documentation/Persistence":{"role":"collection","type":"topic","abstract":[],"url":"\/documentation\/persistence","title":"Persistence","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"type":"topic","title":"Logging, Tracing, Metrics and Analytics","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","abstract":[{"type":"text","text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it."}],"url":"\/documentation\/traffluent\/whatgoeswhere","kind":"article"},"doc://UIKitTracking/documentation/UIKitTracking":{"role":"collection","type":"topic","url":"\/documentation\/uikittracking","abstract":[],"title":"UIKitTracking","kind":"symbol","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"type":"topic","title":"Tracking from SwiftUI, UIKit and AppKit","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"url":"\/documentation\/traffluent\/trackingfromviews","kind":"article"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"role":"article","type":"topic","url":"\/documentation\/traffluent\/samplingevents","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"title":"Sampling Events","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"type":"topic","title":"AutomaticScreenTracking","role":"collection","identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","url":"\/documentation\/automaticscreentracking","abstract":[],"kind":"symbol"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"role":"collection","type":"topic","url":"\/documentation\/collectorencoding","abstract":[],"title":"CollectorEncoding","kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},"doc://TrackerTesting/documentation/TrackerTesting":{"role":"collection","type":"topic","abstract":[],"url":"\/documentation\/trackertesting","title":"TrackerTesting","kind":"symbol","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"role":"article","type":"topic","url":"\/documentation\/traffluent\/definingevents","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"title":"Defining Events","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"type":"topic","title":"Privacy Manifests","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}],"url":"\/documentation\/traffluent\/privacymanifests","kind":"article"}}}