{"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations"]]},"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"metadata":{"symbolKind":"protocol","modules":[{"name":"Destinations"}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"navigatorTitle":[{"text":"Destination","kind":"identifier"}],"roleHeading":"Protocol","externalID":"s:12Destinations11DestinationP","title":"Destination","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Destination.swift#L23","fileName":"Destination.swift"}},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Destinations\/s8SendableP","doc:\/\/Destinations\/s16SendableMetatypeP"],"type":"inheritsFrom","title":"Inherits From"},{"kind":"relationships","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"],"type":"conformingTypes","title":"Conforming Types"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"sections":[],"topicSections":[{"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"code":"deliver(to:batchBufferLimit:)","type":"codeVoice"},{"text":" gives each destination its batches in the order the events","type":"text"},{"text":" ","type":"text"},{"text":"were tracked, one at a time: the next batch comes once ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference"},{"text":" returns. Batches that","type":"text"},{"text":" ","type":"text"},{"text":"arrive meanwhile wait in a buffer of the destination’s own, which drops its oldest batch when","type":"text"},{"text":" ","type":"text"},{"text":"full, so a destination that falls behind loses batches rather than holding up the others.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"text":" should return promptly and honour cancellation: a delivery waits for it","type":"text"},{"text":" ","type":"text"},{"text":"before it completes, and cancels it when the delivery is cancelled. A destination handles its","type":"text"},{"text":" ","type":"text"},{"text":"own errors (a failed upload, say); the delivery has none to receive.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a tracker keeps its records in a store, returning from "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true},{"type":"text","text":" is what tells the"},{"type":"text","text":" "},{"type":"text","text":"store a batch arrived: once every destination has returned for it, uncancelled, the store"},{"type":"text","text":" "},{"type":"text","text":"forgets those records. A destination that buffers or retries should return only once the"},{"type":"text","text":" "},{"type":"text","text":"batch is somewhere it won’t be lost; a record whose "},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"type":"text","text":" is set may"},{"type":"text","text":" "},{"type":"text","text":"have reached it in an earlier run."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What a destination receives is narrowed by modifiers rather than by code of its own:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","isActive":true},{"type":"text","text":" for the consent categories it serves, "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","isActive":true},{"type":"text","text":". A destination given none receives every record as tracked."}]}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/destination"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Destinations/documentation/Destinations":{"kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations","title":"Destinations","url":"\/documentation\/destinations","type":"topic","abstract":[],"role":"collection"},"doc://Destinations/documentation/Destinations/Destination/receive(_:)":{"url":"\/documentation\/destinations\/destination\/receive(_:)","role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"receive"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRec