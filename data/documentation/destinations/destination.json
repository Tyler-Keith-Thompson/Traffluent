{"abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"relationshipsSections":[{"type":"inheritsFrom","identifiers":["doc:\/\/Destinations\/s8SendableP","doc:\/\/Destinations\/s16SendableMetatypeP"],"kind":"relationships","title":"Inherits From"},{"type":"conformingTypes","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"],"kind":"relationships","title":"Conforming Types"}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"code":"deliver(to:batchBufferLimit:)","type":"codeVoice"},{"text":" gives each destination its batches in the order the events","type":"text"},{"text":" ","type":"text"},{"text":"were tracked, one at a time: the next batch comes once ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference"},{"text":" returns. Batches that","type":"text"},{"text":" ","type":"text"},{"text":"arrive meanwhile wait in a buffer of the destination’s own, which drops its oldest batch when","type":"text"},{"text":" ","type":"text"},{"text":"full, so a destination that falls behind loses batches rather than holding up the others.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"type":"text","text":" shou