:"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"code":"deliver(to:batchBufferLimit:)","type":"codeVoice"},{"text":" gives each destination its batches in the order the events","type":"text"},{"text":" ","type":"text"},{"text":"were tracked, one at a time: the next batch comes once ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true,"type":"reference"},{"text":" returns. Batches that","type":"text"},{"text":" ","type":"text"},{"text":"arrive meanwhile wait in a buffer of the destination’s own, which drops its oldest batch when","type":"text"},{"text":" ","type":"text"},{"text":"full, so a destination that falls behind loses batches rather than holding up the others.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true},{"type":"text","text":" should return promptly and honour cancellation: a delivery waits for it"},{"type":"text","text":" "},{"type":"text","text":"before it completes, and cancels it when the delivery is cancelled. A destination handles its"},{"type":"text","text":" "},{"type":"text","text":"own errors (a failed upload, say); the delivery has none to receive."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When a tracker keeps its records in a store, returning from "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true},{"type":"text","text":" is what tells the"},{"type":"text","text":" "},{"type":"text","text":"store a batch arrived: once every destination has returned for it, uncancelled, the store"},{"type":"text","text":" "},{"type":"text","text":"forgets those records. A destination that buffers or retries should return only once the"},{"type":"text","text":" "},{"type":"text","text":"batch is somewhere it won’t be lost; a record whose "},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"type":"text","text":" is set may"},{"type":"text","text":" "},{"type":"text","text":"have reached it in an earlier run."}],"type":"paragraph"},{"inlineContent":[{"text":"What a destination receives is narrowed by modifiers rather than by code of its own:","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)"},{"text":" for the consent categories it serves, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()"},{"text":". A destination given none receives every record as tracked.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/destination"]}],"references":{"doc://Destinations/documentation/Destinations/Destination/receive(_:)":{"url":"\/documentation\/destinations\/destination\/receive(_:)","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","role":"symbol","required":true,"title":"receive(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"receive"},{"kind":"text","text":"(["},{"preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier","text":"EventRecord"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"}],"abstract":[{"text":"Records ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":".","