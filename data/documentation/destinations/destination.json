{"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Destinations","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","doc:\/\/Destinations\/documentation\/Destinations\/InvalidCapacity"],"title":"Destinations"}],"variants":[{"paths":["\/documentation\/destinations\/destination"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"navigatorTitle":[{"text":"Destination","kind":"identifier"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Destination.swift#L27","fileName":"Destination.swift"},"symbolKind":"protocol","roleHeading":"Protocol","title":"Destination","externalID":"s:12Destinations11DestinationP","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"modules":[{"name":"Destinations"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/Destinations\/s8SendableP","doc:\/\/Destinations\/s16SendableMetatypeP"],"title":"Inherits From"},{"kind":"relationships","type":"conformingTypes","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"],"title":"Conforming Types"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"code":"deliver(to:batchBufferLimit:)","type":"codeVoice"},{"type":"text","text":" gives each destination its batches in the order the events"},{"type":"text","text":" "},{"type":"text","text":"were tracked, one at a time: the next batch comes once "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference","isActive":true},{"type":"text","text":" returns. Batches that"},{"type":"text","text":" "},{"type":"text","text":"arrive meanwhile wait in a buffer of the destination’s own, which drops its oldest batch when"},{"type":"text","text":" "},{"type":"text","text":"full, so a destination that falls behind doesn’t hold up the others."},{"type":"text","text":" "},{"type":"text","text":"The delivery reports each batch dropped. Once the destination has caught up, it gets the"},{"type":"text","text":" "},{"type":"text","text":"dropped batch’s records that a store keeps, read back from the store, after the newer batches"},{"type":"text","text":" "},{"type":"text","text":"it received meanwhile; those kept in memory only are lost."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference"},{"text":" should return as soon as the batch is somewhere it won’t be lost, and honour","type":"text"},{"text":" ","type":"text"},{"text":"cancellation: a delivery waits for it before it completes, and cancels it when the delivery is","type":"text"},{"text":" ","type":"text"},{"text":"cancelled. Until it returns, this destination’s later batches wait in its buffer. A","type":"text"},{"text":" ","type":"text"},{"text":"destination handles its own errors (a failed upload, say); the delivery has none to receive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When a tracker keeps its records in a store, returning from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"type":"text","text":" is what tells the"},{"type":"text","text":" "},{"type":"text","text":"store a batch arrived: once every destination has returned for it, uncancelled, the store"},{"type":"text","text":" "},{"type":"text","text":"forgets those records. A destination that buffers or retries should return only once the"},{"type":"text","text":" "},{"type":"text","text":"batch is somewhere it won’t be lost; a record whose "},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"type":"text","text":" is set may"},{"type":"text","text":" "},{"type":"text","text":"have reached it in an earlier run."}],"type":"paragraph"},{"inlineContent":[{"text":"What a destination receives is narrowed by modifiers rather than by code of its own:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","isActive":true,"type":"reference"},{"text":" for the consent categories it serves, ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","isActive":true,"type":"reference"},{"text":". A destination given none receives every record as tracked.","type":"text"}],"type":"paragraph"}]}],"topicSections":[{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","doc:\/\/Destinations\/documentation\/Destinations\/Destin