{"sections":[],"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"topicSections":[{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"],"anchor":"Instance-Methods"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"kind":"symbol","relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/Destinations\/s8SendableP","doc:\/\/Destinations\/s16SendableMetatypeP"],"kind":"relationships"},{"type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"],"kind":"relationships"}],"variants":[{"paths":["\/documentation\/destinations\/destination"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"code":"deliver(to:batchBufferLimit:)","type":"codeVoice"},{"type":"text","text":" gives each destination its batches in the order the events"},{"type":"text","text":" "},{"type":"text","text":"were tracked, one at a time: the next batch comes once "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true},{"type":"text","text":" returns. Batches that"},{"type":"text","text":" "},{"type":"text","text":"arrive meanwhile wait in a buffer of the destination’s own, which drops its oldest batch when"},{"type":"text","text":" "},{"type":"text","text":"full, so a destination that falls behind loses batches rather than holding up the others."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true,"type":"reference"},{"type":"text","text":" should return promptly and honour cancellation: a delivery waits for it"},{"type":"text","text":" "},{"type":"text","text":"before it completes, and cancels it when the delivery is cancelled. A destination handles its"},{"type":"text","text":" "},{"type":"text","text":"own errors (a failed upload, say); the delivery has none to receive."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When a tracker keeps its records in a store, returning from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"type":"text","text":" is what tells the"},{"type":"text","text":" "},{"type":"text","text":"store a batch arrived: once every destination has returned for it, uncancelled, the store"},{"type":"text","text":" "},{"type":"text","text":"forgets those records. A destination that buffers or retries should return only once the"},{"type":"text","text":" "},{"type":"text","text":"batch is somewhere it won’t be lost; a record whose "},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"type":"text","text":" is set may"},{"type":"text","text":" "},{"type":"text","text":"have reached it in an earlier run."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What a destination receives is narrowed by modifiers rather than by code of its own:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)"},{"type":"text","text":" for the consent categories it serves, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()"},{"type":"text","text":". A destination given none receives every record as tracked."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations"]]},"metadata":{"externalID":"s:12Destinations11DestinationP","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"title":"Destination","modules":[{"name":"Destinations"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"remoteSource":{"fileName":"Destination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Destination.swift#L23"},"roleHeading":"Protocol","role":"symbol","symbolKind":"protocol"},"references":{"doc://Destinations/documentation/Destinations/Destination/droppingCallSite()":{"kind":"symbol","title":"droppingCallSite()","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"droppingCallSite"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","text":"Destination"}],"abstract":[{"text":"This destination, receiving each record without its call site: ","type":"text"},{"type":"codeVoice","code":"EventRecord.sourceLocation"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"type