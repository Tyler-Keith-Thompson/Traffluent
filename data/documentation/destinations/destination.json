ons\/Destination\/droppingCallSite()","isActive":true,"type":"reference"},{"text":". A destination given none receives every record as tracked.","type":"text"}]}]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"],"anchor":"Instance-Methods","title":"Instance Methods"}],"metadata":{"title":"Destination","remoteSource":{"fileName":"Destination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Destination.swift#L24"},"symbolKind":"protocol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"externalID":"s:12Destinations11DestinationP","modules":[{"name":"Destinations"}],"roleHeading":"Protocol","navigatorTitle":[{"kind":"identifier","text":"Destination"}]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/destination"]}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations"]]},"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","interfaceLanguage":"swift"},"references":{"doc://Destinations/documentation/Destinations/ConsoleDestination":{"title":"ConsoleDestination","navigatorTitle":[{"text":"ConsoleDestination","kind":"identifier"}],"url":"\/documentation\/destinations\/consoledestination","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsoleDestination","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A destination that prints each event on a line of its own: its name, then the value.","type":"text"}],"ide