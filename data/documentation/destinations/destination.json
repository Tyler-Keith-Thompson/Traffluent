_:)"},{"text":" should return as soon as the batch is somewhere it won’t be lost, and honour","type":"text"},{"text":" ","type":"text"},{"text":"cancellation: a delivery waits for it before it completes, and cancels it when the delivery is","type":"text"},{"text":" ","type":"text"},{"text":"cancelled. Until it returns, this destination’s later batches wait in its buffer. A","type":"text"},{"text":" ","type":"text"},{"text":"destination handles its own errors (a failed upload, say); the delivery has none to receive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When a tracker keeps its records in a store, returning from ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true,"type":"reference"},{"text":" is what tells the","type":"text"},{"text":" ","type":"text"},{"text":"store a batch arrived: once every destination has returned for it, uncancelled, the store","type":"text"},{"text":" ","type":"text"},{"text":"forgets those records. A destination that buffers or retries should return only once the","type":"text"},{"text":" ","type":"text"},{"text":"batch is somewhere it won’t be lost; a record whose ","type":"text"},{"code":"EventRecord.isRedelivered","type":"codeVoice"},{"text":" is set may","type":"text"},{"text":" ","type":"text"},{"text":"have reached it in an earlier run.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"What a destination receives is narrowed by modifiers rather than by code of its own:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","isActive":true,"type":"reference"},{"text":" for the consent categories it serves, ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","isActive":true,"type":"reference"},{"text":". A destination given none receives every record as tracked.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Destinations/documentation/Destinations/Destination/redactingSensitiveValues()":{"type":"topic","url":"\/documentation\/destinations\/destination\/redactingsensitivevalues()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"redactingSensitiveValues"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","text":"Destination"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","role":"symbol","abstract":[{"text":"This destination, receiving each record with its ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" values redacted:","type":"text"},{"text":" ","type":"text"},{"code":"EventRecord.reveal(_:)","type":"codeVoice"},{"text":" gives ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for every one.","type":"text"}],"title":"redactingSensitiveValues()","kind":"symbol"},"doc://Destinations/documentation/Destinations":{"role":"collection","title":"Destinations","type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"code":"Destination","type":"codeVoice"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"kind":"symbol","url":"\/documentation\/destinations"},"doc://Destinations/documentation/Destinations/Destination/enriched(by:)":{"url":"\/documentation\/destinations\/destination\/enriched(by:)","type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(b