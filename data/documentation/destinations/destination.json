{"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations"]]},"kind":"symbol","topicSections":[{"generated":true,"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"],"anchor":"Instance-Methods","title":"Instance Methods"}],"sections":[],"abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"metadata":{"navigatorTitle":[{"text":"Destination","kind":"identifier"}],"roleHeading":"Protocol","title":"Destination","externalID":"s:12Destinations11DestinationP","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Destination.swift#L23","fileName":"Destination.swift"},"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"modules":[{"name":"Destinations"}],"symbolKind":"protocol"},"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","interfaceLanguage":"swift"},"relationshipsSections":[{"identifiers":["doc:\/\/Destinations\/s8SendableP","doc:\/\/Destinations\/s16SendableMetatypeP"],"kind":"relationships","title":"Inherits From","type":"inheritsFrom"},{"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"],"kind":"relationships","title":"Conforming Types","type":"conformingTypes"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Send