{"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations"]]},"sections":[],"topicSections":[{"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true}],"relationshipsSections":[{"identifiers":["doc:\/\/Destinations\/s8SendableP","doc:\/\/Destinations\/s16SendableMetatypeP"],"title":"Inherits From","kind":"relationships","type":"inheritsFrom"},{"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"],"title":"Conforming Types","kind":"relationships","type":"conformingTypes"}],"variants":[{"paths":["\/documentation\/destinations\/destination"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"remoteSource":{"fileName":"Destination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Destination.swift#L23"},"externalID":"s:12Destinations11DestinationP","title":"Destination","symbolKind":"protocol","roleHeading":"Protocol","role":"symbol","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"modules":[{"name":"Destinations"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"code":"deliver(to:batchBufferLimit:)","type":"codeVoice"},{"text":" gives each destination its batches in the order the events","type":"text"},{"text":" ","type":"text"},{"text":"were tracked, one at a time: the next batch comes once ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true,"type":"reference"},{"text":" returns. Batches that","type":"text"},{"text":" ","type":"text"},{"text":"arrive meanwhile wait in a buffer of the destination’s own, which drops its oldest batch when","type":"text"},{"text":" ","type":"text"},{"text":"full, so a destination that falls behind loses batches rather than holding up the others.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true},{"text":" should return promptly and honour cancellation: a delivery waits for it","type":"text"},{"text":" ","type":"text"},{"text":"before it completes, and cancels it when the delivery is cancelled. A destination handles its","type":"text"},{"text":" ","type":"text"},{"text":"own errors (a failed upload, say); the delivery has none to receive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When a tracker keeps its records in a store, returning from "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true},{"type":"text","text":" is what tells the"},{"type":"text","text":" "},{"type":"text","text":"store a batch arrived: once every destination has returned for it, uncancelled, the store"},{"type":"text","text":" "},{"type":"text","text":"forgets those records. A destination that buffers or retries should return only once the"},{"type":"text","text":" "},{"type":"text","text":"batch is somewhere it won’t be lost; a record whose "},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"type":"text","text":" is set may"},{"type":"text","text":" "},{"type":"text","text":"have reached it in an earlier run."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What a destination receives is narrowed by modifiers rather than by code of its own:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","isActive":true},{"type":"text","text":" for the consent categories it serves, "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","isActive":true},{"type":"text","text":". A destination given none receives every record as tracked."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Destinations/documentation/Destinations/Destination/redactingSensitiveValues()":{"abstract":[{"type":"text","text":"This destination, receiving each record with its "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values redacted:"},{"type":"text","text":" "},{"type":"codeVoice","code":"EventRecord.reveal(_:)"},{"type":"text","text":" gives "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for every one."}],"type":"topic","title":"redactingSensitiveValues()","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","kind":"symbol","url":"\/documentation\/destinations\/destination\/redactingsensitivevalues()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"redactingSensitiveValues","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier"}]},"doc://Destinations/s8SendableP":{"identifier":"doc:\/\/Destinations\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://Destinations/documentation/Destinations/InMemoryDestination":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InMemoryDestination","kind":"identifier"}],"abstract":[{"text":"A destination that keeps the newest records it receives, in memory, for the app to read.","type":"text"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","title":"InMemoryDestination","kind":"symbol","url":"\/documentation\/destinations\/inmemorydestination","role":"symbol","navigatorTitle":[{"text":"InMemoryDestination","kind":"identifier"}],"type":"topic"},"doc://Destinations/documentation/Destinations/Destination/droppingCallSite()":{"kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","title":"droppingCallSite()","url":"\/documentation\/destinations\/destination\/droppingcallsite()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"droppingCallSite","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"This destination, receiving each record without its call site: "},{"code":"EventRecord.sourceLocation","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is "},{"code":"nil","type":"codeVoice"},{"type":"text","t