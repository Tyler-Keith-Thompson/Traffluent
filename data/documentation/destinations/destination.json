{"abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations"]]},"topicSections":[{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/Destinations\/s8SendableP","doc:\/\/Destinations\/s16SendableMetatypeP"],"kind":"relationships"},{"title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"deliver(to:batchBufferLimit:bufferDropReporter:)"},{"type":"text","text":" gives each destination its batches in the"},{"type":"text","text":" "},{"type":"text","text":"order the events were tracked, one at a time: the next batch comes once "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"returns. Batches that arrive meanwhile wait in a buffer of the destination’s own, which drops"},{"type":"text","text":" "},{"type":"text","text":"its oldest batch when full, so a destination that falls behind doesn’t hold up the others."},{"type":"text","text":" "},{"type":"text","text":"The delivery reports each batch dropped. Once the destination has caught up, it gets the"},{"type":"text","text":" "},{"type":"text","text":"dropped batch’s records that a store keeps, read back from the store, after the newer batches"},{"type":"text","text":" "},{"type":"text","text":"it received meanwhile; those kept in memory only are lost."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"type":"text","text":" should return as soon as the batch is somewhere it won’t be lost, and honour"},{"type":"text","text":" "},{"type":"text","text":"cancellation: a delivery waits for it before it completes, and cancels it when the delivery is"},{"type":"text","text":" "},{"type":"text","text":"cancelled. Until it returns, this destination’s later batches wait in its buffer. A"},{"type":"text","text":" "},{"type":"text","text":"destination handles its own errors (a failed upload, say); the delivery has none to receive."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When a tracker keeps its records in a store, returning from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"type":"text","text":" is what tells the"},{"type":"text","text":" "},{"type":"text","text":"store a batch arrived: once every destination has returned for it, uncancelled, the store"},{"type":"text","text":" "},{"type":"text","text":"forgets those records. A destination that buffers or retries should return only once the"},{"type":"text","text":" "},{"type":"text","text":"batch is somewhere it won’t be lost; a record whose "},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"type":"text","text":" is set may"},{"type":"text","text":" "},{"type":"text","text":"have reached it in an earlier run."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What a destination receives is narrowed by modifiers rather than by code of its own:"},{"type":"text","text":" "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","type":"reference","isActive":true},{"type":"text","text":" for the consent categories it serves, "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","type":"reference","isActive":true},{"type":"text","text":". A destination given none receives every record as tracked."}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Destinations","title":"Destinations","generated":true,"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","doc:\/\/Destinations\/documentation\/Destinations\/InvalidCapacity"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/destination"]}],"metadata":{"remoteSource":{"fileName":"Destination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Destination.swift#L27"},"title":"Destination","externalID":"s:12Destinations11DestinationP","modules":[{"name":"Destinations"}],"navigatorTitle":[{"k