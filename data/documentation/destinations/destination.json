nation, receiving only the events in "},{"type":"codeVoice","code":"categories"},{"type":"text","text":"."}],"url":"\/documentation\/destinations\/destination\/accepting(_:)","kind":"symbol","type":"topic"},"doc://Destinations/s16SendableMetatypeP":{"identifier":"doc:\/\/Destinations\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"topic","title":"Destinations","abstract":[],"role":"collection","kind":"symbol"},"doc://Destinations/documentation/Destinations/InMemoryDestination":{"title":"InMemoryDestination","navigatorTitle":[{"text":"InMemoryDestination","kind":"identifier"}],"url":"\/documentation\/destinations\/inmemorydestination","kind":"symbol","abstract":[{"text":"A destination that keeps the newest records it receives, in memory, for the app to read.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InMemoryDestination","kind":"identifier"}]},"doc://Destinations/documentation/Destinations/ConsoleDestination":{"url":"\/documentation\/destinations\/consoledestination","abstract":[{"type":"text","text":"A destination that prints each event on a line of its own: its name, then the value."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsoleDestination","kind":"identifier"}],"navigatorTitle":[{"text":"ConsoleDestination","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","title":"ConsoleDestination","kind":"symbol","type":"topic"},"doc://Destinations/s8SendableP":{"identifier":"doc:\/\/Destinations\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Destinations/documentation/Destinat