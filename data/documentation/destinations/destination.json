xt","text":"forgets those records. A destination that buffers or retries should return only once the"},{"type":"text","text":" "},{"type":"text","text":"batch is somewhere it won’t be lost; a record whose "},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"type":"text","text":" is set may"},{"type":"text","text":" "},{"type":"text","text":"have reached it in an earlier run."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What a destination receives is narrowed by modifiers rather than by code of its own:"},{"type":"text","text":" "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","isActive":true,"type":"reference"},{"type":"text","text":" for the consent categories it serves, "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","isActive":true,"type":"reference"},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","isActive":true,"type":"reference"},{"type":"text","text":". A destination given none receives every record as tracked."}]}]}],"variants":[{"paths":["\/documentation\/destinations\/destination"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Destinations/documentation/Destinations/ConsoleDestination":{"abstract":[{"text":"A destination that prints each event on a line of its own: its name, then the value.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsoleDestination","kind":"identifier"}],"navigatorTitle":[{"text":"ConsoleDestination","kind":"identifier"}],"kind":"symbol","title":"ConsoleDestination","type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","role":"symbol","url":"\/documentation\/destinations\/consoledestination"},"doc://Destinations/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\