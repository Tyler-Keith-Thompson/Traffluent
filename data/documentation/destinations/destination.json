{"metadata":{"externalID":"s:12Destinations11DestinationP","symbolKind":"protocol","role":"symbol","roleHeading":"Protocol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Destination.swift#L27","fileName":"Destination.swift"},"title":"Destination","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"modules":[{"name":"Destinations"}],"navigatorTitle":[{"text":"Destination","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations"]]},"relationshipsSections":[{"identifiers":["doc:\/\/Destinations\/s8SendableP","doc:\/\/Destinations\/s16SendableMetatypeP"],"type":"inheritsFrom","title":"Inherits From","kind":"relationships"},{"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"],"type":"conformingTypes","title":"Conforming Types","kind":"relationships"}],"sections":[],"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"topicSections":[{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/destination"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"deliver(to:batchBufferLimit:bufferDropReporter:)"},{"text":" gives each destination its batches in the","type":"text"},{"text":" ","type":"text"},{"text":"order the events were tracked, one at a time: the next batch comes once ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"text":" ","type":"text"},{"text":"returns. Batches that arrive meanwhile wait in a buffer of the destination’s own, which drops","type":"text"},{"text":" ","type":"text"},{"text":"its oldest batch when full, so a destination that falls behind doesn’t hold up the others.","type":"text"},{"text":" ","type":"text"},{"text":"The delivery reports each batch dropped. Once the destination has caught up, it gets the","type":"text"},{"text":" ","type":"text"},{"text":"dropped batch’s records that a store keeps, read back from the store, after the newer batches","type":"text"},{"text":" ","type":"text"},{"text":"it received meanwhile; those kept in memory only are lost.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true,"type":"reference"},{"type":"text","text":" should return as soon as the batch is somewhere it won’t be lost, and honour"},{"type":"text","text":" "},{"type":"text","text":"cancellation: a delivery waits for it before it completes, and cancels it when the delivery is"},{"type":"text","text":" "},{"type":"text","text":"cancelled. Until it returns, this destination’s later batches wait in its buffer. A"},{"type":"text","text":" "},{"type":"text","text":"destination handles its own errors (a failed upload, say); the delivery has none to receive."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a tracker keeps its records in a store, returning from "},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference"},{"type":"text","text":" is what tells the"},{"type":"text","text":" "},{"type":"text","text":"store a batch arrived: once every destination has returned for it, uncancelled, the store"},{"type":"text","text":" "},{"type":"text","text":"forgets those records. A destination that buffers or retries should return only once the"},{"type":"text","text":" "},{"type":"text","text":"batch is somewhere it won’t be lost; a record whose "},{"code":"EventRecord.isRedelivered","type":"codeVoice"},{"type":"text","text":" is set may"},{"type":"text","text":" "},{"type":"text","text":"have reached it in an earlier run."}]},{"type":"paragraph","inlineContent":[{"text":"What a destination receives is narrowed by modifiers rather than by code of its own:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","type":"reference","isActive":true},{"text":" for the consent categories it serves, ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","type":"reference","isActive":true},{"text":". A destination given none receives every record as tracked.","type":"text"}]}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","interfaceLanguage":"swift"},"references":{"doc://Destinations/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/Destinations\/s16SendableMetatypeP