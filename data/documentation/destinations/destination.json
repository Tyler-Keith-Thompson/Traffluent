ext":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"code":"deliver(to:batchBufferLimit:)","type":"codeVoice"},{"text":" gives each destination its batches in the order the events","type":"text"},{"text":" ","type":"text"},{"text":"were tracked, one at a time: the next batch comes once ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"text":" returns. Batches that","type":"text"},{"text":" ","type":"text"},{"text":"arrive meanwhile wait in a buffer of the destination’s own, which drops its oldest batch when","type":"text"},{"text":" ","type":"text"},{"text":"full, so a destination that falls behind loses batches rather than holding up the others.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"text":" should return promptly and honour cancellation: a delivery waits for it","type":"text"},{"text":" ","type":"text"},{"text":"before it completes, and cancels it when the delivery is cancelled. A destination handles its","type":"text"},{"text":" ","type":"text"},{"text":"own errors (a failed upload, say); the delivery has none to receive.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a tracker keeps its records in a store, returning from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"type":"text","text":" is what tells the"},{"type":"text","text":" "},{"type":"text","text":"store a batch arrived: once every destination has returned for it, uncancelled, the store"},{"type":"text","text":" "},{"type":"text","text":"forgets those records. A destination that buffers or retries should return only once the"},{"type":"text","text":" "},{"type":"text","text":"batch is somewhere it won’t be lost; a record whose "},{"code":"EventRecord.isRedelivered","type":"codeVoice"},{"type":"text","text":" is set may"},{"type":"text","text":" "},{"type":"text","text":"have reached it in an earlier run."}]},{"type":"paragraph","inlineContent":[{"text":"What a destination receives is narrowed by modifiers rather than by code of its own:","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","isActive":true},{"text":" for the consent categories it serves, ","type":"text"},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","isActive":true},{"text":". A destination given none receives every record as tracked.","type":"text"}]}]}],"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"references":{"doc://Destinations/documentation/Destinations":{"title":"Destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","kind":"symbol","url":"\/documentation\/destinations","type":"topic","role":"collection","abstract":[]},"doc://Destinations/documentation/Destinations/Destination":{"title":"Destination","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Destination"}],"url":"\/documentation\/destinations\/destination","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"role":"symbol","abstra