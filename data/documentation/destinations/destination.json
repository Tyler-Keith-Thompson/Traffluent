{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","topicSections":[{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"],"generated":true}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/Destinations\/s8SendableP","doc:\/\/Destinations\/s16SendableMetatypeP"]},{"type":"conformingTypes","kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"]}],"variants":[{"paths":["\/documentation\/destinations\/destination"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"code":"deliver(to:batchBufferLimit:)","type":"codeVoice"},{"type":"text","text":" gives each destination its batches in the order the events"},{"type":"text","text":" "},{"type":"text","text":"were tracked, one at a time: the next batch comes once "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true},{"type":"text","text":" returns. Batches that"},{"type":"text","text":" "},{"type":"text","text":"arrive meanwhile wait in a buffer of the destination’s own, which drops its oldest batch when"},{"type":"text","text":" "},{"type":"text","text":"full, so a destination that falls behind loses batches rather than holding up the others."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference"},{"text":" should return as soon as the batch is somewhere it won’t be lost, and honour","type":"text"},{"text":" ","type":"text"},{"text":"cancellation: a delivery waits for it before it completes, and cancels it when the delivery is","type":"text"},{"text":" ","type":"text"},{"text":"cancelled. Until it returns, this destination’s later batches wait in its buffer. A","type":"text"},{"text":" ","type":"text"},{"text":"destination handles its own errors (a failed upload, say); the delivery has none to receive.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a tracker keeps its records in a store, returning from "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true,"type":"reference"},{"type":"text","text":" is what tells the"},{"type":"text","text":" "},{"type":"text","text":"store a batch arrived: once every destination has returned for it, uncancelled, the store"},{"type":"text","text":" "},{"type":"text","text":"forgets those records. A destination that buffers or retries should return only once the"},{"type":"text","text":" "},{"type":"text","text":"batch is somewhere it won’t be lost; a record whose "},{"code":"EventRecord.isRedelivered","type":"codeVoice"},{"type":"text","text":" is set may"},{"type":"text","text":" "},{"type":"text","text":"have reached it in an earlier run."}]},{"type":"paragraph","inlineContent":[{"text":"What a destination receives is narrowed by modifiers rather than by code of its own:","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","isActive":true},{"text":" for the consent categories it serves, ","type":"text"},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","isActive":true},{"text":". A destination given none receives every record as tracked.","type":"text"}]}],"kind":"content"}],"sections":[],"metadata":{"externalID":"s:12Destinations11DestinationP","modules":[{"name":"Destinations"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Destination"}],"remoteSource":{"fileName":"Destination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Destination.swift#L24"},"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"symbolKind":"protocol","roleHeading":"Protocol","title":"Destination"},"abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"references":{"doc://Destinations/documentation/Destinations/Destination/droppingCallSite()":{"kind":"symbol","role":"symbol","url":"\/documentation\/destinations\/destination\/droppingcallsite()","abstract":[{"type":"text","text":"This destination, receiving each record without its call site: "},{"code":"EventRecord.sourceLocation","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/