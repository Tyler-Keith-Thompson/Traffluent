{"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations"]]},"metadata":{"remoteSource":{"fileName":"Destination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Destination.swift#L27"},"navigatorTitle":[{"kind":"identifier","text":"Destination"}],"role":"symbol","modules":[{"name":"Destinations"}],"roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"title":"Destination","symbolKind":"protocol","externalID":"s:12Destinations11DestinationP"},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"relationshipsSections":[{"type":"inheritsFrom","identifiers":["doc:\/\/Destinations\/s8SendableP","doc:\/\/Destinations\/s16SendableMetatypeP"],"kind":"relationships","title":"Inherits From"},{"type":"conformingTypes","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"],"kind":"relationships","title":"Conforming Types"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/destination"]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"],"title":"Instance Methods","anchor":"Instance-Methods"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","doc:\/\/Destinations\/documentation\/Destinations\/InvalidCapacity"],"title":"Destinations","anchor":"Destinations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"deliver(to:batchBufferLimit:bufferDropReporter:)"},{"type":"text","text":" gives each destination its batches in the"},{"type":"text","text":" "},{"type":"text","text":"order the events were tracked, one at a time: the next batch comes once "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"type":"text","text":" "},{"type":"text","text":"returns. Batches that arrive meanwhile wait in a buffer of the destination’s own, which drops"},{"type":"text","text":" "},{"type":"text","text":"its oldest batch when full, so a destination that falls behind doesn’t hold up the others."},{"type":"text","text":" "},{"type":"text","text":"The delivery reports each batch dropped. Once the destination has caught up, it gets the"},{"type":"text","text":" "},{"type":"text","text":"dropped batch’s records that a store keeps, read back from the store, after the newer batches"},{"type":"text","text":" "},{"type":"text","text":"it received meanwhile; those kept in memory only are lost."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference","isActive":true},{"type":"text","text":" should return as soon as the batch is somewhere it won’t be lost, and honour"},{"type":"text","text":" "},{"type":"text","text":"cancellation: a delivery waits for it before it completes, and cancels it when the delivery is"},{"type":"text","text":" "},{"type":"text","text":"cancelled. Until it returns, this destination’s later batches wait in its buffer. A"},{"type":"text","text":" "},{"type":"text","text":"destination handles its own errors (a failed upload, say); the delivery has none to receive."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When a tracker keeps its records in a store, returning from "},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference"},{"type":"text","text":" is what tells the"},{"type":"text","text":" "},{"type":"text","text":"store a batch arrived: once every destination has returned for it, uncancelled, the store"},{"type":"text","text":" "},{"type":"text","text":"forgets those records. A destination that buffers or retries should return only once the"},{"type":"text","text":" "},{"type":"text","text":"batch is somewhere it won’t be lost; a record whose "},{"code":"EventRecord.isRedelivered","type":"codeVoice"},{"type":"text","text":" is set may"},{"type":"text","text":" "},{"type":"text","text":"have reached it in an earlier run."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What a destination receives is narrowed by modifiers rather than by code of its own:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)"},{"type":"text","text":" for the consent categories it serves, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()"},{"type":"text","text":". A destination given none receives every record as tracked."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"references":{"doc://Destinations/documentation/Destinations/Destination/droppingCallSite()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"droppingCallSite","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier"}],"url":"\/documentation\/destinations\/destination\/droppingcallsite()","kind":"symbol","title":"droppingCallSite()","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","type":"topic","abstract":[{"text":"This destination, receiving each record without its call site: ","type":"text"},{"type":"codeVoice","code":"EventRecord.sourceLocation"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}]},"doc://Destinations/documentation/Destinations/Destination":{"abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"type":"topic","url":"\/documentation\/destinations\/destination","role":"symbol","kind":"symbol","title":"Destination","navigatorTitle":[{"kind":"identifier","text":"Destination"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"doc://Destinations/documentation/Destinations/InMemoryDestination":{"kind":"symbol","url":"\/documentation\/destinations\/inmemorydestination","abstract":[{"text":"A destination that keeps the newest records it receives, in memory, for the app to read.","type":"text"}],"type":"