{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BufferDropReport"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"A delivery reports each batch it drops on its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports"},{"type":"text","text":". Reports no one"},{"type":"text","text":" "},{"type":"text","text":"has read yet merge, one per destination: a later drop adds its counts to the destination’s"},{"type":"text","text":" "},{"type":"text","text":"waiting report and widens its timestamps, so a report may count several batches. Of the"},{"type":"text","text":" "},{"type":"text","text":"batches’ records, those a tracker’s store keeps ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport\/storedRecordCount"},{"type":"text","text":") are not lost: the"},{"type":"text","text":" "},{"type":"text","text":"delivery reads them back from the store and hands them to this destination alone once it has"},{"type":"text","text":" "},{"type":"text","text":"caught up. They wait in the store for a later launch instead when the store can’t read them"},{"type":"text","text":" "},{"type":"text","text":"back, or when the destination falls so far behind that the delivery forgets the batch (it"},{"type":"text","text":" "},{"type":"text","text":"keeps track of ten buffers’ worth, and logs each it forgets). The others, kept in memory only,"},{"type":"text","text":" "},{"type":"text","text":"are lost."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/destinations\/bufferdropreport"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Delivering","identifiers":["