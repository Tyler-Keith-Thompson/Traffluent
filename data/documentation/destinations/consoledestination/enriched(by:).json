{"metadata":{"externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF::SYNTHESIZED::s:12Destinations18ConsoleDestinationV","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events8EnricherV","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","text":"Destination"}],"remoteSource":{"fileName":"Enriched.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34"},"title":"enriched(by:)","roleHeading":"Instance Method","symbolKind":"method","extendedModule":"Destinations","modules":[{"name":"Destinations"}],"role":"symbol"},"abstract":[{"type":"text","text":"This destination, receiving each record with its context changed by "},{"code":"enricher","type":"codeVoice"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"enricher","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events8EnricherV","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","text":"Enricher","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12Destinations11DestinationP","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","text":"Destination","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"enricher","content":[{"type":"paragraph","inlineContent":[{"text":"What each record this destination receives adds to its context.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A destination that hands this one each batch with its records enriched.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"syntax":"swift","code":["let delivery = tracker.records.batch().deliver(","    to: ownBackend.enriched(by: Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The enricher runs on each record of a batch as the delivery hands the batch to this"},{"type":"text","text":" "},{"type":"text","text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:"},{"type":"text","text":" "},{"type":"text","text":"the others are handed the same records without it. It runs on every record the destination"},{"type":"text","text":" "},{"type":"text","text":"receives, records a store recovered from an earlier run included, and reads any value it"},{"type":"text","text":" "},{"type":"text","text":"computes at delivery rather than when the event was tracked. So it suits values about the"},{"type":"text","text":" "},{"type":"text","text":"destination or the delivery, such as a region or a deployment tag, rather than about the"},{"type":"text","text":" "},{"type":"text","text":"event: a recovered record would get this run’s app version and the network at upload time."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Like the other modifiers, the one applied last sees each record first: in"},{"type":"text","text":" "},{"type":"codeVoice","code":"destination.enriched(by: first).enriched(by: second)"},{"type":"text","text":", "},{"type":"codeVoice","code":"second"},{"type":"text","text":" runs, then "},{"type":"codeVoice","code":"first"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"sees what "},{"type":"codeVoice","code":"second"},{"type":"text","text":" set and has the last word on a key both set."}],"type":"paragraph"},{"inlineContent":[{"text":"Records the enricher adds before a record, as ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":" adds ","type":"text"},{"code":"SessionStarted","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"SessionEnded","type":"codeVoice"},{"text":", are left out: they would reach the destination without passing the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as","type":"text"},{"text":" ","type":"text"},{"text":"it is called. Give that kind of enricher to the tracker instead.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") enricher calls for a batch of ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" records.","type":"text"}]}],"style":"note","name":"Complexity","type":"aside"}]}],"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination\/enriched(by:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination"]]},"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/consoledestination\/enriched(by:)"]}],"references":{"doc://Destinations/documentation/Destinations":{"role":"collection","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"type":"codeVoice","code":"Destination"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}],"type":"topic","url":"\/documentation\/destinations","title":"Destinations","kind":"symbol"},"doc://Events/documentation/Events/Enricher":{"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","kind":"symbol","title":"Enricher","url":"\/documentation\/events\/enricher","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Enricher"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Enricher"}]},"doc://Destinations/documentation/Destinations/ConsoleDestination/enriched(by:)":{"abstract":[{"type":"text","text":"This destination, receiving each record with its context changed by "},{"type":"codeVoice","code":"enricher"},{"type":"text","text":"."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination\/enriched(by:)","title":"enriched(by:)","url":"\/documentation\/destinations\/consoledestination\/enriched(by:)","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events8EnricherV","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","text":"Destination"}],"role":"symbol"},"doc://Destinations/documentation/Destinations/ConsoleDestination":{"role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","abstract":[{"text":"A destination that prints each event on a line of its own: its name, then the value.","type":"text"}],"type":"topic","url":"\/documentation\/destinations\/consoledestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsoleDestination","kind":"identifier"}],"navigatorTitle":[{"text":"ConsoleDestination","kind":"identifier"}],"title":"ConsoleDestination","kind":"symbol"},"doc://Destinations/documentation/Destinations/Destination":{"role":"symbol","type":"topic","url":"\/documentation\/destinations\/destination","kind":"symbol","title":"Destination","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Destination"}]}}}