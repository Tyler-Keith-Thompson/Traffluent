tation\/events\/enricher","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Enricher","kind":"identifier"}],"navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","kind":"symbol","title":"Enricher"},"doc://Destinations/documentation/Destinations/Destination":{"kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","role":"symbol","type":"topic","url":"\/documentation\/destinations\/destination","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"navigatorTitle":[{"text":"Destination","kind":"identifier"}],"title":"Destination","abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}]}}}