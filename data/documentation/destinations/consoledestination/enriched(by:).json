{"abstract":[{"type":"text","text":"This destination, receiving each record with its context changed by "},{"code":"enricher","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"}],"roleHeading":"Instance Method","externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF::SYNTHESIZED::s:12Destinations18ConsoleDestinationV","remoteSource":{"fileName":"Enriched.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34"},"title":"enriched(by:)","modules":[{"name":"Destinations"}],"extendedModule":"Destinations","role":"symbol","symbolKind":"method"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination"]]},"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination\/enriched(by:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"enricher","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},{"text":"\n","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"What each record this destination receives adds to its context.","type":"text"}]}],"name":"enricher"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A destination that hands this one each batch with its records enriched."}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"syntax":"swift","type":"codeListing","code":["let delivery = tracker.records.batch().deliver(","    to: ownBackend.enriched(by: Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"]},{"inlineContent":[{"text":"The enricher runs on each record of a batch as the delivery hands the batch to this","type":"text"},{"text":" ","type":"text"},{"text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:","type":"text"},{"text":" ","type":"text"},{"text":"the others are handed the same records without it. It runs on every record the destination","type":"text"},{"text":" ","type":"text"},{"text":"receives, records a store recovered from an earlier run included, and reads any value it","type":"text"},{"text":" ","type":"text"},{"text":"computes at delivery rather than when the event was tracked. So it suits values about the","type":"text"},{"text":" ","type":"text"},{"text":"destination or the delivery, such as a region or a deployment tag, rather than about the","type":"text"},{"text":" ","type":"text"},{"text":"event: a recovered record would get this run’s app version and the network at upload time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Like the other modifiers, the one applied last sees each record first: in","type":"text"},{"text":" ","type":"text"},{"code":"destination.enriched(by: first).enriched(by: second)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"second","type":"codeVoice"},{"text":" runs, then ","type":"text"},{"code":"first","type":"codeVoice"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"sees what ","type":"text"},{"code":"second","type":"codeVoice"},{"text":" set and has the last word on a key both set.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Records the enricher adds before a record, as ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":" adds ","type":"text"},{"code":"SessionStarted","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"SessionEnded","type":"codeVoice"},{"text":", are left out: they would reach the destination without passing the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as","type":"text"},{"text":" ","type":"text"},{"text":"it is called. Give that kind of enricher to the tracker instead.","type":"text"}],"type":"paragraph"},{"name":"Complexity","content":[{"inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") enricher calls for a batch of ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" records.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/destinations\/consoledestination\/enriched(by:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Destinations/documentation/Destinations/Destination":{"abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","url":"\/documentation\/destinations\/destination","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"title":"Destination","navigatorTitle":[{"kind":"identifier","text":"Destination"}]},"doc://Destinations/documentation/Destinations":{"abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"role":"collection","title":"Destinations","url":"\/documentation\/destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"topic","kind":"symbol"},"doc://Destinations/documentation/Destinations/ConsoleDestination":{"navigatorTitle":[{"kind":"identifier","text":"ConsoleDestination"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","type":"topic","title":"ConsoleDestination","kind":"symbol","url":"\/documentation\/destinations\/consoledestination","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsoleDestination"}],"abstract":[{"text":"A destination that prints each event on a line of its own: its name, then the value.","type":"text"}]},"doc://Destinations/documentation/Destinations/ConsoleDestination/enriched(by:)":{"abstract":[{"text":"This destination, receiving each record with its context changed by ","type":"text"},{"type":"codeVoice","code":"enricher"},{"text":".","type":"text"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination\/enriched(by:)","url":"\/documentation\/destinations\/consoledestination\/enriched(by:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events8EnricherV","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","text":"Destination"}],"title":"enriched(by:)"},"doc://Events/documentation/Events/Enricher":{"navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","type":"topic","title":"Enricher","kind":"symbol","url":"\/documentation\/events\/enricher","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Enricher","kind":"identifier"}],"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}]}}}