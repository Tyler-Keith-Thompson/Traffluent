{"sections":[],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"remoteSource":{"fileName":"Enriched.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34"},"symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"Destinations"}],"title":"enriched(by:)","extendedModule":"Destinations","externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF::SYNTHESIZED::s:12Destinations19InMemoryDestinationV","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/enriched(by:)"},"abstract":[{"type":"text","text":"This destination, receiving each record with its context changed by "},{"type":"codeVoice","code":"enricher"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":" "},{"kind":"internalParam","text":"enricher"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events8EnricherV","kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","text":"Destination"},{"kind":"text","text":"\n"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"enricher","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What each record this destination receives adds to its context."}]}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"text":"A destination that hands this one each batch with its records enriched.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"syntax":"swift","code":["let delivery = tracker.records.batch().deliver(","    to: ownBackend.enriched(by: Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"],"type":"codeListing"},{"inlineContent":[{"text":"The enricher runs on each record of a batch as the delivery hands the batch to this","type":"text"},{"text":" ","type":"text"},{"text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:","type":"text"},{"text":" ","type":"text"},{"text":"the others are handed the same records without it. It runs on every record the destination","type":"text"},{"text":" ","type":"text"},{"text":"receives, records a store recovered from an earlier run included, and reads any value it","type":"text"},{"text":" ","type":"text"},{"text":"computes at delivery rather than when the event was tracked. So it suits values about the","type":"text"},{"text":" ","type":"text"},{"text":"destination or the delivery, such as a region or a deployment tag, rather than about the","type":"text"},{"text":" ","type":"text"},{"text":"event: a recovered record would get this run’s app version and the network at upload time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Like the other modifiers, the one applied last sees each record first: in"},{"type":"text","text":" "},{"type":"codeVoice","code":"destination.enriched(by: first).enriched(by: second)"},{"type":"text","text":", "},{"type":"codeVoice","code":"second"},{"type":"text","text":" runs, then "},{"type":"codeVoice","code":"first"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"sees what "},{"type":"codeVoice","code":"second"},{"type":"text","text":" set and has the last word on a key both set."}],"type":"paragraph"},{"inlineContent":[{"text":"Records the enricher adds before a record, as ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":" adds ","type":"text"},{"code":"SessionStarted","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"SessionEnded","type":"codeVoice"},{"text":", are left out: they would reach the destination without passing the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as","type":"text"},{"text":" ","type":"text"},{"text":"it is called. Give that kind of enricher to the tracker instead.","type":"text"}],"type":"paragraph"},{"name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") enricher calls for a batch of "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" records."}],"type":"paragraph"}],"style":"note","type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/destinations\/inmemorydestination\/enriched(by:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Destinations/documentation/Destinations/InMemoryDestination":{"url":"\/documentation\/destinations\/inmemorydestination","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","abstract":[{"type":"text","text":"A destination that keeps the newest records it receives, in memory, for the app to read."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InMemoryDestination","kind":"identifier"}],"title":"InMemoryDestination","role":"symbol","navigatorTitle":[{"text":"InMemoryDestination","kind":"identifier"}],"kind":"symbol"},"doc://Events/documentation/Events/Enricher":{"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","url":"\/documentation\/events\/enricher","abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Enricher","kind":"identifier"}],"title":"Enricher","role":"symbol","navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"kind":"symbol"},"doc://Destinations/documentation/Destinations/Destination":{"navigatorTitle":[{"kind":"identifier","text":"Destination"}],"abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"kind":"symbol","url":"\/documentation\/destinations\/destination","title":"Destination","type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}]},"doc://Destinations/documentation/Destinations":{"title":"Destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"url":"\/documentation\/destinations","type":"topic","role":"collection","identifier":"doc:\/\/Destinations\/documentation\/Destinations","kind":"symbol"},"doc://Destinations/documentation/Destinations/InMemoryDestination/enriched(by:)":{"type":"topic","url":"\/documentation\/destinations\/inmemorydestination\/enriched(by:)","abstract":[{"text":"This destination, receiving each record with its context changed by ","type":"text"},{"code":"enricher","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","title":"enriched(by:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events8EnricherV","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","text":"Destination"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/enriched(by:)"}}}