{"metadata":{"externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF::SYNTHESIZED::s:12Destinations19InMemoryDestinationV","role":"symbol","symbolKind":"method","title":"enriched(by:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP"}],"extendedModule":"Destinations","roleHeading":"Instance Method","modules":[{"name":"Destinations"}],"remoteSource":{"fileName":"Enriched.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34"}},"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/enriched(by:)","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"]]},"abstract":[{"text":"This destination, receiving each record with its context changed by ","type":"text"},{"code":"enricher","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"enricher","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Enricher","preciseIdentifier":"s:6Events8EnricherV","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"languages":["swift"]}]},{"parameters":[{"name":"enricher","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What each record this destination receives adds to its context."}]}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"A destination that hands this one each batch with its records enriched."}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"codeListing","syntax":"swift","code":["let delivery = tracker.records.batch().deliver(","    to: ownBackend.enriched(by: Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The enricher runs on each record of a batch as the delivery hands the batch to this"},{"type":"text","text":" "},{"type":"text","text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:"},{"type":"text","text":" "},{"type":"text","text":"the others are handed the same records without it. It runs on every record the destination"},{"type":"text","text":" "},{"type":"text","text":"receives, records a store recovered from an earlier run included, and reads any value it"},{"type":"text","text":" "},{"type":"text","text":"computes at delivery rather than when the event was tracked. So it suits values about the"},{"type":"text","text":" "},{"type":"text","text":"destination or the delivery, such as a region or a deployment tag, rather than about the"},{"type":"text","text":" "},{"type":"text","text":"event: a recovered record would get this run’s app version and the network at upload time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like the other modifiers, the one applied last sees each record first: in"},{"type":"text","text":" "},{"code":"destination.enriched(by: first).enriched(by: second)","type":"codeVoice"},{"type":"text","text":", "},{"code":"second","type":"codeVoice"},{"type":"text","text":" runs, then "},{"code":"first","type":"codeVoice"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"sees what "},{"code":"second","type":"codeVoice"},{"type":"text","text":" set and has the last word on a key both set."}]},{"type":"paragraph","inlineContent":[{"text":"Records the enricher adds before a record, as ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":" adds ","type":"text"},{"type":"codeVoice","code":"SessionStarted"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"SessionEnded"},{"text":", are left out: they would reach the destination without passing the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as","type":"text"},{"text":" ","type":"text"},{"text":"it is called. Give that kind of enricher to the tracker instead.","type":"text"}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") enricher calls for a batch of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" records."}],"type":"paragraph"}],"type":"aside","name":"Complexity"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/inmemorydestination\/enriched(by:)"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"references":{"doc://Destinations/documentation/Destinations/InMemoryDestination/enriched(by:)":{"title":"enriched(by:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events8EnricherV","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","text":"Destination"}],"abstract":[{"type":"text","text":"This destination, receiving each record with its context changed by "},{"type":"codeVoice","code":"enricher"},{"type":"text","text":"."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/enriched(by:)","kind":"symbol","url":"\/documentation\/destinations\/inmemorydestination\/enriched(by:)","type":"topic"},"doc://Destinations/documentation/Destinations/Destination":{"navigatorTitle":[{"kind":"identifier","text":"Destination"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"kind":"symbol","type":"topic","title":"Destination","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"url":"\/documentation\/destinations\/destination"},"doc://Destinations/documentation/Destinations":{"title":"Destinations","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Where tracked events go: the "},{"code":"Destination","type":"codeVoice"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"url":"\/documentation\/destinations","role":"collection","identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://Destinations/documentation/Destinations/InMemoryDestination":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InMemoryDestination","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","navigatorTitle":[{"text":"InMemoryDestination","kind":"identifier"}],"title":"InMemoryDestination","abstract":[{"type":"text","text":"A destination that keeps the newest records it receives, in memory, for the app to read."}],"url":"\/documentation\/destinations\/inmemorydestination"},"doc://Events/documentation/Events/Enricher":{"type":"topic","role":"symbol","url":"\/documentation\/events\/enricher","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","title":"Enricher","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Enricher"}],"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"navigatorTitle":[{"kind":"identifier","text":"Enricher"}]}}}