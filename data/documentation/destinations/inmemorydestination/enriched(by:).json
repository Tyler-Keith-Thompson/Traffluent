{"abstract":[{"text":"This destination, receiving each record with its context changed by ","type":"text"},{"type":"codeVoice","code":"enricher"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"enricher","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},{"text":"\n","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"enricher","content":[{"type":"paragraph","inlineContent":[{"text":"What each record this destination receives adds to its context.","type":"text"}]}]}]},{"content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A destination that hands this one each batch with its records enriched.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"syntax":"swift","code":["let delivery = tracker.records.batch().deliver(","    to: ownBackend.enriched(by: Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The enricher runs on each record of a batch as the delivery hands the batch to this"},{"type":"text","text":" "},{"type":"text","text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:"},{"type":"text","text":" "},{"type":"text","text":"the others are handed the same records without it. It runs on every record the destination"},{"type":"text","text":" "},{"type":"text","text":"receives, records a store recovered from an earlier run included, and reads any value it"},{"type":"text","text":" "},{"type":"text","text":"computes at delivery rather than when the event was tracked. So it suits values about the"},{"type":"text","text":" "},{"type":"text","text":"destination or the delivery, such as a region or a deployment tag, rather than about the"},{"type":"text","text":" "},{"type":"text","text":"event: a recovered record would get this run’s app version and the network at upload time."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Like the other modifiers, the one applied last sees each record first: in"},{"type":"text","text":" "},{"type":"codeVoice","code":"destination.enriched(by: first).enriched(by: second)"},{"type":"text","text":", "},{"type":"codeVoice","code":"second"},{"type":"text","text":" runs, then "},{"type":"codeVoice","code":"first"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"sees what "},{"type":"codeVoice","code":"second"},{"type":"text","text":" set and has the last word on a key both set."}],"type":"paragraph"},{"inlineContent":[{"text":"Records the enricher adds before a record, as ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":" adds ","type":"text"},{"type":"codeVoice","code":"SessionStarted"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"SessionEnded"},{"text":", are left out: they would reach the destination without passing the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as","type":"text"},{"text":" ","type":"text"},{"text":"it is called. Give that kind of enricher to the tracker instead.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") enricher calls for a batch of "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" records."}],"type":"paragraph"}],"style":"note","name":"Complexity","type":"aside"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/enriched(by:)"},"kind":"symbol","metadata":{"title":"enriched(by:)","externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF::SYNTHESIZED::s:12Destinations19InMemoryDestinationV","remoteSource":{"fileName":"Enriched.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34"},"symbolKind":"method","modules":[{"name":"Destinations"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP"}],"extendedModule":"Destinations","roleHeading":"Instance Method","role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/destinations\/inmemorydestination\/enriched(by:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Destinations/documentation/Destinations":{"role":"collection","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"type":"codeVoice","code":"Destination"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}],"type":"topic","url":"\/documentation\/destinations","title":"Destinations","kind":"symbol"},"doc://Destinations/documentation/Destinations/InMemoryDestination":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","abstract":[{"type":"text","text":"A destination that keeps the newest records it receives, in memory, for the app to read."}],"url":"\/documentation\/destinations\/inmemorydestination","type":"topic","navigatorTitle":[{"text":"InMemoryDestination","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InMemoryDestination","kind":"identifier"}],"kind":"symbol","title":"InMemoryDestination"},"doc://Destinations/documentation/Destinations/InMemoryDestination/enriched(by:)":{"kind":"symbol","url":"\/documentation\/destinations\/inmemorydestination\/enriched(by:)","title":"enriched(by:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"}],"role":"symbol","abstract":[{"text":"This destination, receiving each record with its context changed by ","type":"text"},{"code":"enricher","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/enriched(by:)","type":"topic"},"doc://Events/documentation/Events/Enricher":{"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","kind":"symbol","title":"Enricher","url":"\/documentation\/events\/enricher","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Enricher"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Enricher"}]},"doc://Destinations/documentation/Destinations/Destination":{"role":"symbol","type":"topic","url":"\/documentation\/destinations\/destination","kind":"symbol","title":"Destination","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Destination"}]}}}