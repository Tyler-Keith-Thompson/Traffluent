{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/inmemorydestination\/enriched(by:)"]}],"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/enriched(by:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"]]},"sections":[],"abstract":[{"text":"This destination, receiving each record with its context changed by ","type":"text"},{"code":"enricher","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"enricher","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events8EnricherV","text":"Enricher","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"enricher","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What each record this destination receives adds to its context."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A destination that hands this one each batch with its records enriched.","type":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"syntax":"swift","code":["let delivery = tracker.records.batch().deliver(","    to: ownBackend.enriched(by: Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The enricher runs on each record of a batch as the delivery hands the batch to this","type":"text"},{"text":" ","type":"text"},{"text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:","type":"text"},{"text":" ","type":"text"},{"text":"the others are handed the same records without it. It runs on every record the destination","type":"text"},{"text":" ","type":"text"},{"text":"receives, records a store recovered from an earlier run included, and reads any value it","type":"text"},{"text":" ","type":"text"},{"text":"computes at delivery rather than when the event was tracked. So it suits values about the","type":"text"},{"text":" ","type":"text"},{"text":"destination or the delivery, such as a region or a deployment tag, rather than about the","type":"text"},{"text":" ","type":"text"},{"text":"event: a recovered record would get this run’s app version and the network at upload time.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like the other modifiers, the one applied last sees each record first: in"},{"type":"text","text":" "},{"code":"destination.enriched(by: first).enriched(by: second)","type":"codeVoice"},{"type":"text","text":", "},{"code":"second","type":"codeVoice"},{"type":"text","text":" runs, then "},{"code":"first","type":"codeVoice"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"sees what "},{"code":"second","type":"codeVoice"},{"type":"text","text":" set and has the last word on a key both set."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records the enricher adds before a record, as "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":" adds "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"SessionEnded"},{"type":"text","text":", are left out: they would reach the destination without passing the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as"},{"type":"text","text":" "},{"type":"text","text":"it is called. Give that kind of enricher to the tracker instead."}]},{"style":"note","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") enricher calls for a batch of ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" records.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Complexity"}]}],"kind":"symbol","metadata":{"role":"symbol","roleHeading":"Instance Method","modules":[{"name":"Destinations"}],"title":"enriched(by:)","extendedModule":"Destinations","symbolKind":"method","externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF::SYNTHESIZED::s:12Destinations19InMemoryDestinationV","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events8EnricherV","text":"Enricher","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination","kind":"typeIdentifier"}],"remoteSource":{"fileName":"Enriched.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34"}},"references":{"doc://Destinations/documentation/Destinations/InMemoryDestination/enriched(by:)":{"role":"symbol","kind":"symbol","fragments":[{"text":"func","ki