tion/Destinations":{"type":"topic","title":"Destinations","role":"collection","kind":"symbol","url":"\/documentation\/destinations","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"type":"codeVoice","code":"Destination"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://Destinations/documentation/Destinations/Destination":{"navigatorTitle":[{"kind":"identifier","text":"Destination"}],"title":"Destination","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/destinations\/destination"}}}