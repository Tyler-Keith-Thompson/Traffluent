{"kind":"symbol","variants":[{"paths":["\/documentation\/destinations\/inmemorydestination\/enriched(by:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/enriched(by:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Method","modules":[{"name":"Destinations"}],"externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF::SYNTHESIZED::s:12Destinations19InMemoryDestinationV","role":"symbol","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Enricher","preciseIdentifier":"s:6Events8EnricherV"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP"}],"remoteSource":{"fileName":"Enriched.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34"},"extendedModule":"Destinations","title":"enriched(by:)"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"]]},"sections":[],"abstract":[{"type":"text","text":"This destination, receiving each record with its context changed by "},{"type":"codeVoice","code":"enricher"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"enricher","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"enricher","content":[{"type":"paragraph","inlineContent":[{"text":"What each record this destination receives adds to its context.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A destination that hands this one each batch with its records enriched.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"code":["let delivery = tracker.records.batch().deliver(","    to: ownBackend.enriched(by: Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The enricher runs on each record of a batch as the delivery hands the batch to this"},{"type":"text","text":" "},{"type":"text","text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:"},{"type":"text","text":" "},{"type":"text","text":"the others are handed the same records without it. It runs on every record the destination"},{"type":"text","text":" "},{"type":"text","text":"receives, records a store recovered from an earlier run included, and reads any value it"},{"type":"text","text":" "},{"type":"text","text":"computes at delivery rather than when the event was tracked. So it suits values about the"},{"type":"text","text":" "},{"type":"text","text":"destination or the delivery, such as a region or a deployment tag, rather than about the"},{"type":"text","text":" "},{"type":"text","text":"event: a recovered record would get this run’s app version and the network at upload time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like the other modifiers, the one applied last sees each record first: in"},{"type":"text","text":" "},{"type":"codeVoice","code":"destination.enriched(by: first).enriched(by: second)"},{"type":"text","text":", "},{"type":"codeVoice","code":"second"},{"type":"text","text":" runs, then "},{"type":"codeVoice","code":"first"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"sees what "},{"type":"codeVoice","code":"second"},{"type":"text","text":" set and has the last word on a key both set."}]},{"type":"paragraph","inlineContent":[{"text":"Records the enricher adds before a record, as ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":" adds ","type":"text"},{"code":"SessionStarted","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"SessionEnded","type":"codeVoice"},{"text":", are left out: they would reach the destination without passing the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as","type":"text"},{"text":" ","type":"text"},{"text":"it is called. Give that kind of enricher to the tracker instead.","type":"text"}]},{"name":"Complexity","type":"aside","style":"note","content":[{"inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") enricher calls for a batch of ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" records.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"references":{"doc://Destinations/documentation/Destinations/InMemoryDestination":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","kind":"symbol","role":"symbol","url":"\/documentation\/destinations\/inmemorydestination","abstract":[{"text":"A destination that keeps the newest records it receives, in memory, for the app to read.","type":"text"}],"type":"topic","title":"InMemoryDestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InMemoryDestination"}],"navigatorTitle":[{"kind":"identifier","text":"InMemoryDestination"}]},"doc://Destinations/documentation/Destinations":{"abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/destinations","title":"Destinations"},"doc://Events/documentation/Events/Enricher":{"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Enricher"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","navigatorTitle":[{"kind":"identifier","text":"Enricher"}],"kind":"symbol","url":"\/documentation\/events\/enricher","title":"Enricher","role":"symbol"},"doc://Destinations/documentation/Destinations/Destination":{"type":"topic","url":"\/documentation\/destinations\/destination","title":"Destination","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"doc://Destinations/documentation/Destinations/InMemoryDestination/enriched(by:)":{"url":"\/documentation\/destinations\/inmemorydestination\/enriched(by:)","title":"enriched(by:)","abstract":[{"type":"text","text":"This destination, receiving each record with its context changed by "},{"type":"codeVoice","code":"enricher"},{"type":"text","text":"."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/enriched(by:)","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP"}],"kind":"symbol"}}}