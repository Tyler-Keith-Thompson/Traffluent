Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The enricher runs on each record of a batch as the delivery hands the batch to this"},{"type":"text","text":" "},{"type":"text","text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:"},{"type":"text","text":" "},{"type":"text","text":"the others are handed the same records without it. It runs on every record the destination"},{"type":"text","text":" "},{"type":"text","text":"receives, records a store recovered from an earlier run included, and reads any value it"},{"type":"text","text":" "},{"type":"text","text":"computes at delivery rather than when the event was tracked. So it suits values about the"},{"type":"text","text":" "},{"type":"text","text":"destination or the delivery, such as a region or a deployment tag, rather than about the"},{"type":"text","text":" "},{"type":"text","text":"event: a recovered record would get this run’s app version and the network at upload time."}],"type":"paragraph"},{"inlineContent":[{"text":"Like the other modifiers, the one applied last sees each record first: in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"destination.enriched(by: first).enriched(by: second)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"second"},{"text":" runs, then ","type":"text"},{"type":"codeVoice","code":"first"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"sees what ","type":"text"},{"type":"codeVoice","code":"second"},{"text":" set and has the last word on a key both set.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Records the enricher adds before a record, as ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":" adds ","type":"text"},{"type":"codeVoice","code":"SessionStarted"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"SessionEnded"},{"text":", are left out: they would reach the destination without passing the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as","type":"text"},{"text":" ","type":"text"},{"text":"it is called. Give that kind of enricher to the tracker instead.","type":"text"}],"type":"paragraph"},{"name":"Complexity","style":"note","type":"aside","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") enricher calls for a batch of ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" records.","type":"text"}],"type":"paragraph"}]}]}],"metadata":{"symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"Destinations"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"}],"title":"enriched(by:)","extendedModule":"Destinations","externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF::SYNTHESIZED::s:12Destinations19InMemoryDestinationV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34","fileName":"Enriched.swift"},"role":"symbol"},"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/enriched(by:)","interfaceLanguage":"swift"},"references":{"doc://Destinations/documentation/Destinations":{"role":"collection","title":"Destinations","type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"code":"Destination","type":"codeVoice"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"kind":"symbol","url":"\/documentation\/destinations"},"doc://Destinations/documentation/Destinations/InMemoryDestination":{"role":"symbol","title":"InMemoryDestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InMemoryDestination"}],"navigatorTitle":[{"kind":"identifier","text":"InMemoryDestination"}],"url":"\/documentation\/destinations\/inmemorydestination","kind":"symbol","type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","abstract":[{"text":"A destination that keeps the newest records it receives, in memory, for the app to read.","type":"text"}]},"doc://Events/documentation/Events/Enricher":{"role":"symbol","type":"topic","url":"\/documentation\/events\/enricher","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Enricher","kind":"identifier"}],"navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","kind":"symbol","title":"Enricher"},"doc://Destinations/documentation/Destinations/InMemoryDestination/enriched(by:)":{"role":"symbol","url":"\/documentation\/destinations\/inmemorydestination\/enriched(by:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events8EnricherV","text":"Enricher","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"This destination, receiving each record with its context changed by "},{"code":"enricher","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/enriched(by:)","kind":"symbol","title":"enriched(by:)"},"doc://Destinations/documentation/Destinations/Destination":{"kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","role":"symbol","type":"topic","url":"\/documentation\/destinations\/destination","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"navigatorTitle":[{"text":"Destination","kind":"identifier"}],"title":"Destination","abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}]}}}