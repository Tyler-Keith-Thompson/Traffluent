{"abstract":[{"text":"Each batch as it is received, whole, for a reader that waits for a delivery: a view that","type":"text"},{"text":" ","type":"text"},{"text":"refreshes, or a test that reads once a batch arrives.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/deliveries"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/inmemorydestination\/deliveries"]}],"metadata":{"role":"symbol","remoteSource":{"fileName":"InMemoryDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/InMemoryDestination.swift#L108"},"symbolKind":"property","roleHeading":"Instance Property","title":"deliveries","externalID":"s:12Destinations19InMemoryDestinationV10deliveries11AsyncQueues0F5QueueVySay6Events11EventRecordVGGvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliveries","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier"},{"text":"<[","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":"]>","kind":"text"}],"modules":[{"name":"Destinations"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliveries","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue","kind":"typeIdentifier","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue"},{"text":"<[","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord"},{"text":"]> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Batches not yet read wait in a buffer of the newest "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" batches; a slower reader"},{"type":"text","text":" "},{"type":"text","text":"misses the older ones, and reads "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/records","isActive":true,"type":"reference"},{"type":"text","text":" for what is kept. The sequence ends once the"},{"type":"text","text":" "},{"type":"text","text":"destination and every copy of it are gone and every batch kept has been read."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads the batches at a time; it can fan each one out to the rest of the app. The"},{"type":"text","text":" "},{"type":"text","text":"first iterator to read holds them until its iteration ends or it is released; a second"},{"type":"text","text":" "},{"type":"text","text":"reader meanwhile waits its turn, logging a warning once, then reads on from the next batch,"},{"type":"text","text":" "},{"type":"text","text":"so the first gets every batch in order. A reader cancelled while it waits returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"]]},"references":{"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","role":"symbol","type":"topic","url":"\/documentation\/asyncqueues\/asyncqueue","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}],"navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"abstract":[{"text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"title":"AsyncQueue","kind":"symbol"},"doc://Destinations/documentation/Destinations/InMemoryDestination":{"navigatorTitle":[{"kind":"identifier","text":"InMemoryDestination"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","role":"symbol","title":"InMemoryDestination","type":"topic","kind":"symbol","url":"\/documentation\/destinations\/inmemorydestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InMemoryDestination"}],"abstract":[{"text":"A destination that keeps the newest records it receives, in memory, for the app to read.","type":"text"}]},"doc://Events/documentation/Events/EventRecord":{"type":"topic","title":"EventRecord","url":"\/documentation\/events\/eventrecord","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventRecord"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EventRecord"}],"abstract":[{"type":"text","text":"A tracked event: the event itself, when it was tracked, where, and the context it was tracked in."}]},"doc://Destinations/documentation/Destinations":{"type":"topic","title":"Destinations","url":"\/documentation\/destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection","kind":"symbol","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}]},"doc://Destinations/documentation/Destinations/InMemoryDestination/records":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/records","role":"symbol","type":"topic","url":"\/documentation\/destinations\/inmemorydestination\/records","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"The records kept, in the order received, across batches."}],"title":"records","kind":"symbol"},"doc://Destinations/documentation/Destinations/InMemoryDestination/deliveries":{"url":"\/documentation\/destinations\/inmemorydestination\/deliveries","type":"topic","title":"deliveries","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/deliveries","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliveries"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]>"}],"kind":"symbol","abstract":[{"text":"Each batch as it is received, whole, for a reader that waits for a delivery: a view that","type":"text"},{"text":" ","type":"text"},{"text":"refreshes, or a test that reads once a batch arrives.","type":"text"}]}}}