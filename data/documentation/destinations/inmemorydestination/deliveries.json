"inlineContent":[{"type":"text","text":"The stream has one consumer: iterate it from a single task, which can fan each batch out"},{"type":"text","text":" "},{"type":"text","text":"to the rest of the app. A second iterator takes batches from the first rather than seeing"},{"type":"text","text":" "},{"type":"text","text":"them too. Batches not yet read wait in a buffer of the newest "},{"code":"capacity","type":"codeVoice"},{"type":"text","text":" batches; a slower"},{"type":"text","text":" "},{"type":"text","text":"reader misses the older ones, and reads "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/records","isActive":true},{"type":"text","text":" for what is kept. The stream never"},{"type":"text","text":" "},{"type":"text","text":"finishes."}]}]}],"abstract":[{"text":"Each batch as it is received, whole, for a reader that waits for a delivery: a view that","type":"text"},{"text":" ","type":"text"},{"text":"refreshes, or a test that reads once a batch arrives.","type":"text"}],"kind":"symbol","references":{"doc://Destinations/documentation/Destinations/InMemoryDestination":{"navigatorTitle":[{"kind":"identifier","text":"InMemoryDestination"}],"abstract":[{"text":"A destination that keeps the newest records it receives, in memory, for the app to read.","type":"text"}],"type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","kind":"symbol","role":"symbol","title":"InMemoryDestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InMemoryDestination"}],"url":"\/documentation\/destinations\/inmemorydestination"},"doc://Destinations/documentation/Destinations/InMemoryDestination/deliveries":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/deliveries","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identif