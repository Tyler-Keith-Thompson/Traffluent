e batches at a time; it can fan each one out to the rest of the app. The","type":"text"},{"text":" ","type":"text"},{"text":"first iterator to read holds them until its iteration ends or it is released; a second","type":"text"},{"text":" ","type":"text"},{"text":"reader meanwhile waits its turn, logging a warning once, then reads on from the next batch,","type":"text"},{"text":" ","type":"text"},{"text":"so the first gets every batch in order. A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Instance Property","modules":[{"name":"Destinations"}],"title":"deliveries","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliveries"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]>"}],"externalID":"s:12Destinations19InMemoryDestinationV10deliveries11AsyncQueues0F5QueueVySay6Events11EventRecordVGGvp","remoteSource":{"fileName":"InMemoryDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/InMemoryDestination.swift#L108"},"role":"symbol","symbolKind":"property"},"references":{"doc://Destinations/documentation/Destinations/InMemoryDestination/records":{"abstract":[{"type":"text","text":"The records kept, in the order received, across batches."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/records","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"i