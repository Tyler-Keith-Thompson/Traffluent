{"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliveries"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<["},{"kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Batches not yet read wait in a buffer of the newest ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" batches; a slower reader","type":"text"},{"text":" ","type":"text"},{"text":"misses the older ones, and reads ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/records","type":"reference"},{"text":" for what is kept. The sequence ends once the","type":"text"},{"text":" ","type":"text"},{"text":"destination and every copy of it are gone and every batch kept has been read.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads the batches at a time; it can fan each one out to the rest of the app. The"},{"type":"text","text":" "},{"type":"text","text":"first iterator to read holds them until its iteration ends or it is released; a second"},{"type":"text","text":" "},{"type":"text","text":"reader meanwhile waits its turn, logging a warning once, then reads on from the next batch,"},{"type":"text","text":" "},{"type":"text","text":"so the first gets every batch in order. A reader cancelled while it waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/deliveries","interfaceLanguage":"swift"},"abstract":[{"text":"Each batch as it is received, whole, for a reader that waits for a delivery: a view that","type":"text"},{"text":" ","type":"text"},{"text":"refreshes, or a test that reads once a batch arrives.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"]]},"variants":[{"paths":["\/documentation\/destinations\/inmemorydestination\/deliveries"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/InMemoryDestination.swift#L108","fileName":"InMemoryDestination.swift"},"externalID":"s:12Destinations19InMemoryDestinationV10deliveries11AsyncQueues0F5QueueVySay6Events11EventRecordVGGvp","role":"symbol","title":"deliveries","modules":[{"name":"Destinations"}],"symbolKind":"property","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliveries"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]>"}]},"references":{"doc://Destinations/documentation/Destinations":{"abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"role":"collection","title":"Destinations","url":"\/documentation\/destinat