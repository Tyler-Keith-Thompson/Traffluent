{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bufferDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"BufferDropReport","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","preciseIdentifier":"s:12Destinations16BufferDropReportV"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Reports no one has read yet merge, one per destination: a destination’s later drops add"},{"type":"text","text":" "},{"type":"text","text":"their record counts to its waiting report and widen its timestamps, so the reports waiting"},{"type":"text","text":" "},{"type":"text","text":"are at most one per destination, and a late reader still learns every count lost. The"},{"type":"text","text":" "},{"type":"text","text":"sequence ends once this delivery, every copy of it and every unit of work built on"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/work"},{"type":"text","text":" are gone, their executions have returned, and every report has been read. Read"},{"type":"text","text":" "},{"type":"text","text":"the sequence into a constant before starting the task that reads it, so the task holds the"},{"type":"text","text":" "},{"type":"text","text":"reports and not the delivery."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"One task reads the reports at a time. The first iterator to read holds them until its"},{"type":"text","text":" "},{"type":"text","text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a"},{"type":"text","text":" "},{"type":"text","text":"warning once, then reads on from the next report, so the first gets every report in"},{"type":"text","text":" "},{"type":"text","text":"order. A reader cancelled while it waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/destinations\/delivery\/bufferdropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/Delivery"]]},"sections":[],"metadata":{"role":"symbol","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bufferDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV","text":"BufferDropReport"},{"kind":"text","text":">"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Delivery.swift#L50","fileName":"Delivery.swift"},"symbolKind":"property","externalID":"s:12Destinations8DeliveryV17bufferDropReports11AsyncQueues0F5QueueVyAA06BufferD6ReportVGvp","modules":[{"name":"Destinations"}],"title":"bufferDropReports"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"A report of the batches each destination’s full buffer drops, in the order they are"},{"type":"text","text":" "},{"type":"text","text":"dropped."}],"kind":"symbol","references":{"doc://Destinations/documentation/Destinations/Delivery":{"type":"topic","title":"Delivery","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Delivery","kind":"identifier"}],"abstract":[{"text":"The work of delivering a sequence’s batches to destinations, made by ","type":"text"},{"code":"deliver(to:)","type":"codeVoice"},{"text":", and the","type":"text"},{"text":" ","type":"text"},{"text":"reports of the batches their full buffers drop.","type":"text"}],"url":"\/documentation\/destinations\/delivery","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","navigatorTitle":[{"text":"Delivery","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}],"url":"\/documentation\/asyncqueues\/asyncqueue","type":"topic","navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"title":"AsyncQueue","kind":"symbol","abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","role":"symbol"},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","type":"topic","title":"Destinations","kind":"symbol","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection"},"doc://Destinations/documentation/Destinations/BufferDropReport":{"type":"topic","title":"BufferDropReport","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BufferDropReport","kind":"identifier"}],"abstract":[{"type":"text","text":"Batches a destination’s full buffer dropped before the destination received them."}],"url":"\/documentation\/destinations\/bufferdropreport","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","navigatorTitle":[{"text":"BufferDropReport","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://Destinations/documentation/Destinations/Delivery/work":{"title":"work","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"work"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7Afluent12DeferredTaskC","kind":"typeIdentifier","text":"DeferredTask"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":">"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/work","role":"symbol","url":"\/documentation\/destinations\/delivery\/work","abstract":[{"type":"text","text":"The unit of work that delivers: executing it runs the delivery."}]},"doc://Destinations/documentation/Destinations/Delivery/bufferDropReports":{"type":"topic","title":"bufferDropReports","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bufferDropReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","text":"AsyncQueue"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:12Destinations16BufferDropReportV","kind":"typeIdentifier","text":"BufferDropReport"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"A report of the batches each destination’s full buffer drops, in the order they are"},{"type":"text","text":" "},{"type":"text","text":"dropped."}],"url":"\/documentation\/destinations\/delivery\/bufferdropreports","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","role":"symbol","kind":"symbol"}}}