destination: a destination’s later drops add","type":"text"},{"text":" ","type":"text"},{"text":"their record counts to its waiting report and widen its timestamps, so the reports waiting","type":"text"},{"text":" ","type":"text"},{"text":"are at most one per destination, and a late reader still learns every count lost. The","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends once this delivery, every copy of it and every unit of work built on","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/work"},{"text":" are gone, their executions have returned, and every report has been read. Read","type":"text"},{"text":" ","type":"text"},{"text":"the sequence into a constant before starting the task that reads it, so the task holds the","type":"text"},{"text":" ","type":"text"},{"text":"reports and not the delivery.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"One task reads the reports at a time. The first iterator to read holds them until its"},{"type":"text","text":" "},{"type":"text","text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a"},{"type":"text","text":" "},{"type":"text","text":"warning once, then reads on from the next report, so the first gets every report in"},{"type":"text","text":" "},{"type":"text","text":"order. A reader cancelled while it waits returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/Delivery"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/delivery\/bufferdropreports"]}],"references":{"doc://Destinations/documentation/Destinations":{"type":"topic","title":"Destinations","url":"\/documentation\/destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection","kind":"symbol","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}]},"doc://Destinations/documentation/Destinations/Delivery/work":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/work","abstract":[{"type":"text","text":"The unit of work that delivers: executing it runs the delivery."}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"work","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DeferredTask","preciseIdentifier":"s:7Afluent12DeferredTaskC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"work","kind":"symbol","type":"topic","url":"\/documentation\/destinations\/delivery\/work"},"doc://Destinations/documentation/Destinations/Delivery":{"kind":"symbol","url":"\/documentation\/destinations\/delivery","title":"Delivery","role":"symbol","type":"topic","navigatorTitle":[{"text":"Delivery","kind":"identifier"}],"abstract":[{"type":"text","text":"The work of delivering a sequence’s batches to destinations, made by "},{"type":"codeVoice","code":"deliver(to:)"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"reports of the batches their full buffers drop."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Delivery","kind":"identifier"}]},"doc://Destinations/documentation/Destinations/BufferDropReport":{"url":"\/documentation\/destinations\/bufferdropreport","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","kind":"symbol","title":"BufferDropReport","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BufferDropReport"}],"navigatorTitle":[{"kind":"identifier","text":"BufferDropReport"}],"type":"topic","abstract":[{"type":"text","text":"Batches a destination’s full buffer dropped before the destination received them."}]},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","role":"symbol","type":"topic","url":"\/documentation\/asyncqueues\/asyncqueue","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}],"navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"abstract":[{"text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"title":"AsyncQueue","kind":"symbol"},"doc://Destinations/documentation/Destinations/Delivery/bufferDropReports":{"abstract":[{"type":"text","text":"A report of the batches each destination’s full buffer drops, in the order they are"},{"type":"text","text":" "},{"type":"text","text":"dropped."}],"role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","title":"bufferDropReports","url":"\/documentation\/destinations\/delivery\/bufferdropreports","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bufferDropReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","text":"AsyncQueue"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:12Destinations16BufferDropReportV","kind":"typeIdentifier","text":"BufferDropReport"},{"kind":"text","text":">"}]}}}