{"metadata":{"roleHeading":"Instance Property","symbolKind":"property","title":"bufferDropReports","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bufferDropReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","text":"AsyncQueue"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:12Destinations16BufferDropReportV","kind":"typeIdentifier","text":"BufferDropReport"},{"kind":"text","text":">"}],"modules":[{"name":"Destinations"}],"remoteSource":{"fileName":"Delivery.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Delivery.swift#L50"},"role":"symbol","externalID":"s:12Destinations8DeliveryV17bufferDropReports11AsyncQueues0F5QueueVyAA06BufferD6ReportVGvp"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/Delivery"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/delivery\/bufferdropreports"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bufferDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"BufferDropReport","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Reports no one has read yet merge, one per destination: a destination’s later drops add","type":"text"},{"text":" ","type":"text"},{"text":"their record counts to its waiting report and widen its timestamps, so the reports waiting","type":"text"},{"text":" ","type":"text"},{"text":"are at most one per destination, and a late reader still learns every count lost. The","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends once this delivery, every copy of it and every unit of work built on","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/work","isActive":true,"type":"reference"},{"text":" are gone, their executions have returned, and every report has been read. Read","type":"text"},{"text":" ","type":"text"},{"text":"the sequence into a constant before starting the task that reads it, so the task holds the","type":"text"},{"text":" ","type":"text"},{"text":"reports and not the delivery.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in","type":"text"},{"text":" ","type":"text"},{"text":"order. A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A report of the batches each destination’s full buffer drops, in the order they are","type":"text"},{"text":" ","type":"text"},{"text":"dropped.","type":"text"}],"sections":[],"references":{"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"type":"topic","kind":"symbol","url":"\/documentation\/asyncqueues\/asyncqueue","title":"AsyncQueue","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","abstract":[{"text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"role":"symbol"},"doc://Destinations/documentation/Destinations/BufferDropReport":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BufferDropReport"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BufferDropReport"}],"title":"BufferDropReport","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","role":"symbol","abstract":[{"type":"text","text":"Batches a destination’s full buffer dropped before the destination received them."}],"type":"topic","url":"\/documentation\/destinations\/bufferdropreport"},"doc://Destinations/documentation/Destinations/Delivery/work":{"title":"work","url":"\/documentation\/destinations\/delivery\/work","abstract":[{"text":"The unit of work that delivers: executing it runs the delivery.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/work","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"work"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DeferredTask","preciseIdentifier":"s:7Afluent12DeferredTaskC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":">"}]},"doc://Destinations/documentation/Destinations":{"title":"Destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"url":"\/documentation\/destinations","type":"topic","role":"collection","identifier":"doc:\/\/Destinations\/documentation\/Destinations","kind":"symbol"},"doc://Destinations/documentation/Destinations/Delivery/bufferDropReports":{"url":"\/documentation\/destinations\/delivery\/bufferdropreports","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bufferDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV","text":"BufferDropReport"},{"kind":"text","text":">"}],"title":"bufferDropReports","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","role":"symbol","abstract":[{"type":"text","text":"A report of the batches each destination’s full buffer drops, in the order they are"},{"type":"text","text":" "},{"type":"text","text":"dropped."}],"type":"topic","kind":"symbol"},"doc://Destinations/documentation/Destinations/Delivery":{"title":"Delivery","abstract":[{"text":"The work of delivering a sequence’s batches to destinations, made by ","type":"text"},{"code":"deliver(to:)","type":"codeVoice"},{"text":", and the","type":"text"},{"text":" ","type":"text"},{"text":"reports of the batches their full buffers drop.","type":"text"}],"url":"\/documentation\/destinations\/delivery","type":"topic","role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","navigatorTitle":[{"text":"Delivery","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Delivery","kind":"identifier"}]}}}