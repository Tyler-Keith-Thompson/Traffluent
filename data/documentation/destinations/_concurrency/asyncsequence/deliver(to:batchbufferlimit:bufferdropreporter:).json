ver(to:bufferDropReporter:)","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:bufferDropReporter:)","abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends, as "},{"type":"codeVoice","code":"deliver(to:batchBufferLimit:bufferDropReporter:)"},{"type":"text","text":" does, with a buffer of"},{"type":"text","text":" "},{"type":"text","text":"100 batches for each destination."}],"kind":"symbol"}}}