{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:bufferDropReporter:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"sections":[],"kind":"symbol","metadata":{"role":"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Element"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"[EventRecord]"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"modules":[{"name":"Destinations","relatedModules":["_Concurrency"]}],"extendedModule":"_Concurrency","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L59","fileName":"Deliver.swift"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bufferDropReporter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV","text":"BufferDropReport"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation"},{"kind":"text","text":"?) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","text":"AsynchronousUnitOfWork"},{"kind":"text","text":"<()>\n"}],"externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimit18bufferDropReporterQrAA11Destination_pd_SiScS12ContinuationVyAA0jM6ReportV_GSgtF","title":"deliver(to:batchBufferLimit:bufferDropReporter:)","roleHeading":"Instance Method","symbolKind":"method"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"destinations"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","text":"Destination","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 100, "},{"kind":"externalParam","text":"bufferDropReporter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:12Destinations16BufferDropReportV","kind":"typeIdentifier","text":"BufferDropReport","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"Continuation","preciseIdentifier":"s:ScS12ContinuationV"},{"kind":"text","text":"? = nil) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"AsynchronousUnitOfWork","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP"},{"kind":"text","text":"<()>\n"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"Where each batch goes."}],"type":"paragraph"}],"name":"destinations"},{"content":[{"inlineContent":[{"type":"text","text":"How many batches each destination may have waiting while it is"},{"type":"text","text":" "},{"type":"text","text":"still receiving an earlier one. A tenth of how many dropped batches it keeps track of"},{"type":"text","text":" "},{"type":"text","text":"to read back."}],"type":"paragraph"}],"name":"batchBufferLimit"},{"content":[{"inlineContent":[{"text":"Where a report of each batch a destination’s full buffer drops is","type":"text"},{"text":" ","type":"text"},{"text":"yielded, as it is dropped; none by default. The delivery never finishes it, so one","type":"text"},{"text":" ","type":"text"},{"text":"reporter can serve the deliveries that replace one another.","type":"text"}],"type":"paragraph"}],"name":"bufferDropReporter"}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A unit of work that completes once the last batch is delivered, and throws what","type":"text"},{"text":" ","type":"text"},{"text":"the sequence throws, or ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" when cancelled.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each destination receives its batches in order, one at a time, from a buffer of its own,","type":"text"},{"text":" ","type":"text"},{"text":"so a slow destination delays only itself. When a batch arrives while a destination’s","type":"text"},{"text":" ","type":"text"},{"text":"buffer already holds ","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" batches, the oldest waiting batch is dropped,","type":"text"},{"text":" ","type":"text"},{"text":"logged and reported on ","type":"text"},{"code":"bufferDropReporter","type":"codeVoice"},{"text":" as a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","type":"reference"},{"text":". Its records kept in","type":"text"},{"text":" ","type":"text"},{"text":"memory only are lost. Those a store keeps are not: once that destination has received","type":"text"},{"text":" ","type":"text"},{"text":"every batch waiting in its buffer, the delivery reads them back from the store and hands","type":"text"},{"text":" ","type":"text"},{"text":"them to that destination alone, one dropped batch at a time, oldest first. Read back, a","type":"text"},{"text":" ","type":"text"},{"text":"record is as it was dropped: its ","type":"text"},{"code":"EventRecord.id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EventRecord.isRedelivered","type":"codeVoice"},{"text":", sensitive","type":"text"},{"text":" ","type":"text"},{"text":"values and context, which the delivery keeps meanwhile. The delivery keeps track of at","type":"text"},{"text":" ","type":"text"},{"text":"most ten times ","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" dropped batches per destination; past that it forgets","type":"text"},{"text":" ","type":"text"},{"text":"the oldest, whose records stay in the store for the next launch, and logs it. Once the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends, the work completes after every destination has received its last batch,","type":"text"},{"text":" ","type":"text"},{"text":"the ones read back included.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Records a store keeps (those with an ","type":"text"},{"type":"codeVoice","code":"EventRecord.deliveryTag"},{"text":") are reported to it:","type":"text"},{"text":" ","type":"text"},{"text":"before a batch goes to any destination, and again once every destination’s ","type":"text"},{"type":"codeVoice","code":"receive"},{"text":" ","type":"text"},{"text":"has returned for it without being cancelled, when the store may forget them. A record","type":"text"},{"text":" ","type":"text"},{"text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left","type":"text"},{"text":" ","type":"text"},{"text":"with no records isn’t sent. A record that some destination never received, because the","type":"text"},{"text":" ","type":"text"},{"text":"store no longer kept it or couldn’t read it back when the delivery asked, is never","type":"text"},{"text":" ","type":"text"},{"text":"acknowledged, so a store that still keeps it delivers it on the next launch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records the delivery has read but not delivered are lost to this run when it is cancelled"},{"type":"text","text":" "},{"type":"text","text":"or fails. Without a store they are gone; a store never had them acknowledged, so it"},{"type":"text","text":" "},{"type":"text","text":"delivers them on the next launch (unless its bound drops them first, which it reports)."}]},{"type":"paragraph","inlineContent":[{"text":"Nothing runs until the work is executed, and each execution reads the sequence again, so","type":"text"},{"text":" ","type":"text"},{"text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops","type":"text"},{"text":" ","type":"text"},{"text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of","type":"text"},{"text":" ","type":"text"},{"text":"work: executing a cancelled delivery again throws ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" at once, so build a","type":"text"},{"text":" ","type":"text"},{"text":"new one instead.","type":"text"}]},{"style":"note","name":"Precondition","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"code":"batchBufferLimit","type":"codeVoice"},{"type":"text","text":" is at least 1."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:bufferdropreporter:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The work of delivering each batch of this sequence to every destination, until the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends.","type":"text"}],"references":{"doc://Destinations/documentation/Destinations/BufferDropReport":{"abstract":[{"text":"A batch a destination’s full buffer dropped before the destination received it.","type":"text"}],"url":"\/documentation\/destinations\/bufferdropreport","type":"topic","title":"BufferDropReport","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BufferDropReport","kind":"identifier"}],"navigatorTitle":[{"text":"BufferDropReport","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","kind":"symbol"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/deliver(to:batchBufferLimit:bufferDropReporter:)":{"kind":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"abstract":[{"text":"The work of delivering each batch of this sequence to every destination, until the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends.","type":"text"}],"type":"topic","title":"deliver(to:batchBufferLimit:bufferDropReporter:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"bufferDropReporter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"BufferDropReport","preciseIdentifier":"s:12Destinations16BufferDropReportV","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Continuation","preciseIdentifier":"s:ScS12ContinuationV","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsynchronousUnitOfWork","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","kind":"typeIdentifier"},{"text":"<()>\n","kind":"text"}],"url":"\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:bufferdropreporter:)","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:bufferDropReporter:)","role":"symbol"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence":{"abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncSequence","kind":"identifier","preciseIdentifier":"s:Sci"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence","navigatorTitle":[{"text":"AsyncSequence","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/destinations\/_concurrency\/asyncsequence","kind":"symbol","title":"AsyncSequence"},"doc://Destinations/documentation/Destinations/Destination":{"url":"\/documentation\/destinations\/destination","title":"Destination","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"role":"symbol"},"doc://Destinations/documentation/Destinations/_Concurrency":{"kind":"symbol","abstract":[],"type":"topic","title":"_Concurrency","url":"\/documentation\/destinations\/_concurrency","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","role":"collection"},"doc://Destinations/documentation/Destinations":{"abstract":[],"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"topic","role":"collection","url":"\/documentation\/destinations","kind":"symbol","title":"Destinations"}}}