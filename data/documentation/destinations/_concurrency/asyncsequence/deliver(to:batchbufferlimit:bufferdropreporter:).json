{"kind":"symbol","metadata":{"remoteSource":{"fileName":"Deliver.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L59"},"extendedModule":"_Concurrency","modules":[{"name":"Destinations","relatedModules":["_Concurrency"]}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Element","type":"codeVoice"},{"type":"text","text":" is "},{"code":"[EventRecord]","type":"codeVoice"},{"type":"text","text":"."}]},"role":"symbol","symbolKind":"method","title":"deliver(to:batchBufferLimit:bufferDropReporter:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bufferDropReporter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV","text":"BufferDropReport"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation"},{"kind":"text","text":"?) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","text":"AsynchronousUnitOfWork"},{"kind":"text","text":"<()>\n"}],"externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimit18bufferDropReporterQrAA11Destination_pd_SiScS12ContinuationVyAA0jM6ReportV_GSgtF","roleHeading":"Instance Method"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:bufferDropReporter:)"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"destinations"},{"kind":"text","text":": any "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = 100, "},{"kind":"externalParam","text":"bufferDropReporter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV","text":"BufferDropReport"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation"},{"kind":"text","text":"? = nil) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","text":"AsynchronousUnitOfWork"},{"kind":"text","text":"<()>\n"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"destinations","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where each batch goes."}]}]},{"name":"batchBufferLimit","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How many batches each destination may have waiting while it is"},{"type":"text","text":" "},{"type":"text","text":"still receiving an earlier one. A tenth of how many dropped batches it keeps track of"},{"type":"text","text":" "},{"type":"text","text":"to read back."}]}]},{"name":"bufferDropReporter","content":[{"type":"paragraph","inlineContent":[{"text":"Where a report of each batch a destination’s full buffer drops is","type":"text"},{"text":" ","type":"text"},{"text":"yielded, as it is dropped; none by default. The delivery never finishes it, so one","type":"text"},{"text":" ","type":"text"},{"text":"reporter can serve the deliveries that replace one another.","type":"text"}]}]}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A unit of work that completes once the last batch is delivered, and throws what","type":"text"},{"text":" ","type":"text"},{"text":"the sequence throws, or ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" when cancelled.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each destination receives its batches in order, one at a time, from a buffer of its own,"},{"type":"text","text":" "},{"type":"text","text":"so a slow destination delays only itself. When a batch arrives while a destination’s"},{"type":"text","text":" "},{"type":"text","text":"buffer already holds "},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" batches, the oldest waiting batch is dropped,"},{"type":"text","text":" "},{"type":"text","text":"logged and reported on "},{"type":"codeVoice","code":"bufferDropReporter"},{"type":"text","text":" as a "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","isActive":true},{"type":"text","text":". Its records kept in"},{"type":"text","text":" "},{"type":"text","text":"memory only are lost. Those a store keeps are not: once that destination has received"},{"type":"text","text":" "},{"type":"text","text":"every batch waiting in its buffer, the delivery reads them back from the store and hands"},{"type":"text","text":" "},{"type":"text","text":"them to that destination alone, one dropped batch at a time, oldest first. Read back, a"},{"type":"text","text":" "},{"type":"text","text":"record is as it was dropped: its "},{"type":"codeVoice","code":"EventRecord.id"},{"type":"text","text":", "},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"type":"text","text":", sensitive"},{"type":"text","text":" "},{"type":"text","text":"values and context, which the delivery keeps meanwhile. The delivery keeps track of at"},{"type":"text","text":" "},{"type":"text","text":"most ten times "},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" dropped batches per destination; past that it forgets"},{"type":"text","text":" "},{"type":"text","text":"the oldest, whose records stay in the store for the next launch, and logs it. Once the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends, the work completes after every destination has received its last batch,"},{"type":"text","text":" "},{"type":"text","text":"the ones read back included."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records a store keeps (those with an "},{"type":"codeVoice","code":"EventRecord.deliveryTag"},{"type":"text","text":") are reported to it:"},{"type":"text","text":" "},{"type":"text","text":"before a batch goes to any destination, and again once every destination’s "},{"type":"codeVoice","code":"receive"},{"type":"text","text":" "},{"type":"text","text":"has returned for it without being cancelled, when the store may forget them. A record"},{"type":"text","text":" "},{"type":"text","text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left"},{"type":"text","text":" "},{"type":"text","text":"with no records isn’t sent. A record that some destination never received, because the"},{"type":"text","text":" "},{"type":"text","text":"store no longer kept it or couldn’t read it back when the delivery asked, is never"},{"type":"text","text":" "},{"type":"text","text":"acknowledged, so a store that still keeps it delivers it on the next launch."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records the delivery has read but not delivered are lost to this run when it is cancelled"},{"type":"text","text":" "},{"type":"text","text":"or fails. Without a store they are gone; a store never had them acknowledged, so it"},{"type":"text","text":" "},{"type":"text","text":"delivers them on the next launch (unless its bound drops them first, which it reports)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Nothing runs until the work is executed, and each execution reads the sequence again, so"},{"type":"text","text":" "},{"type":"text","text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops"},{"type":"text","text":" "},{"type":"text","text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of"},{"type":"text","text":" "},{"type":"text","text":"work: executing a cancelled delivery again throws "},{"code":"CancellationError","type":"codeVoice"},{"type":"text","text":" at once, so build a"},{"type":"text","text":" "},{"type":"text","text":"new one instead."}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" is at least 1."}]}],"type":"aside"}]}],"abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"variants":[{"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:bufferdropreporter:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Destinations/documentation/Destinations/Destination":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","title":"Destination","role":"symbol","abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"navigatorTitle":[{"text":"Destination","kind":"identifier"}],"type":"topic","url":"\/documentation\/destinations\/destination"},"doc://Destinations/documentation/Destinations/BufferDropReport":{"title":"BufferDropReport","type":"topic","url":"\/documentation\/destinations\/bufferdropreport","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BufferDropReport"}],"kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","navigatorTitle":[{"kind":"identifier","text":"BufferDropReport"}],"abstract":[{"text":"A batch a destination’s full buffer dropped before the destination received it.","type":"text"}]},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/deliver(to:batchBufferLimit:bufferDropReporter:)":{"type":"topic","kind":"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"url":"\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:bufferdropreporter:)","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:bufferDropReporter:)","title":"deliver(to:batchBufferLimit:bufferDropReporter:)","abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Destination","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"bufferDropReporter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"BufferDropReport","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV"},{"text":">.","kind":"text"},{"text":"Continuation","kind":"typeIdentifier","preciseIdentifier":"s:ScS12ContinuationV"},{"text":"?) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsynchronousUnitOfWork","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP"},{"text":"<()>\n","kind":"text"}]},"doc://Destinations/documentation/Destinations":{"title":"Destinations","type":"topic","url":"\/documentation\/destinations","role":"collection","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[]},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence":{"kind":"symbol","type":"topic","role":"symbol","title":"AsyncSequence","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:Sci","text":"AsyncSequence","kind":"identifier"}],"url":"\/documentation\/destinations\/_concurrency\/asyncsequence","navigatorTitle":[{"text":"AsyncSequence","kind":"identifier"}],"abstract":[]},"doc://Destinations/documentation/Destinations/_Concurrency":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","url":"\/documentation\/destinations\/_concurrency","title":"_Concurrency","abstract":[],"role":"collection"}}}