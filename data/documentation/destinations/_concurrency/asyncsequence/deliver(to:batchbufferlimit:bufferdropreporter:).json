{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:bufferDropReporter:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"destinations","kind":"internalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:12Destinations11DestinationP","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","text":"Destination","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = 100, ","kind":"text"},{"text":"bufferDropReporter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:12Destinations16BufferDropReportV","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","text":"BufferDropReport","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation","kind":"typeIdentifier"},{"text":"? = nil) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","text":"AsynchronousUnitOfWork","kind":"typeIdentifier"},{"text":"<()>\n","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"Where each batch goes."}],"type":"paragraph"}],"name":"destinations"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How many batches each destination may have waiting while it is"},{"type":"text","text":" "},{"type":"text","text":"still receiving an earlier one. A tenth of how many dropped batches it keeps track of"},{"type":"text","text":" "},{"type":"text","text":"to read back."}]}],"name":"batchBufferLimit"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where a report of each batch a destination’s full buffer drops is"},{"type":"text","text":" "},{"type":"text","text":"yielded, as it is dropped; none by default. The delivery never finishes it, so one"},{"type":"text","text":" "},{"type":"text","text":"reporter can serve the deliveries that replace one another."}]}],"name":"bufferDropReporter"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A unit of work that completes once the last batch is delivered, and throws what"},{"type":"text","text":" "},{"type":"text","text":"the sequence throws, or "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" when cancelled."}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"syntax":"swift","type":"codeListing","code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"]},{"type":"paragraph","inlineContent":[{"text":"Each destination receives its batches in order, one at a time, from a buffer of its own,","type":"text"},{"text":" ","type":"text"},{"text":"so a slow destination delays only itself. When a batch arrives while a destination’s","type":"text"},{"text":" ","type":"text"},{"text":"buffer already holds ","type":"text"},{"type":"codeVoice","code":"batchBufferLimit"},{"text":" batches, the oldest waiting batch is dropped,","type":"text"},{"text":" ","type":"text"},{"text":"logged and reported on ","type":"text"},{"type":"codeVoice","code":"bufferDropReporter"},{"text":" as a ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","isActive":true,"type":"reference"},{"text":". Its records kept in","type":"text"},{"text":" ","type":"text"},{"text":"memory only are lost. Those a store keeps are not: once that destination has received","type":"text"},{"text":" ","type":"text"},{"text":"every batch waiting in its buffer, the delivery reads them back from the store and hands","type":"text"},{"text":" ","type":"text"},{"text":"them to that destination alone, one dropped batch at a time, oldest first. Read back, a","type":"text"},{"text":" ","type":"text"},{"text":"record is as it was dropped: its ","type":"text"},{"type":"codeVoice","code":"EventRecord.id"},{"text":", ","type":"text"},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"text":", sensitive","type":"text"},{"text":" ","type":"text"},{"text":"values and context, which the delivery keeps meanwhile. The delivery keeps track of at","type":"text"},{"text":" ","type":"text"},{"text":"most ten times ","type":"text"},{"type":"codeVoice","code":"batchBufferLimit"},{"text":" dropped batches per destination; past that it forgets","type":"text"},{"text":" ","type":"text"},{"text":"the oldest, whose records stay in the store for the next launch, and logs it. Once the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends, the work completes after every destination has received its last batch,","type":"text"},{"text":" ","type":"text"},{"text":"the ones read back included.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records a store keeps (those with an "},{"type":"codeVoice","code":"EventRecord.deliveryTag"},{"type":"text","text":") are reported to it:"},{"type":"text","text":" "},{"type":"text","text":"before a batch goes to any destination, and again once every destination’s "},{"type":"codeVoice","code":"receive"},{"type":"text","text":" "},{"type":"text","text":"has returned for it without being cancelled, when the store may forget them. A record"},{"type":"text","text":" "},{"type":"text","text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left"},{"type":"text","text":" "},{"type":"text","text":"with no records isn’t sent. A record that some destination never received, because the"},{"type":"text","text":" "},{"type":"text","text":"store no longer kept it or couldn’t read it back when the delivery asked, is never"},{"type":"text","text":" "},{"type":"text","text":"acknowledged, so a store that still keeps it delivers it on the next launch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records the delivery has read but not delivered are lost to this run when it is cancelled"},{"type":"text","text":" "},{"type":"text","text":"or fails. Without a store they are gone; a store never had them acknowledged, so it"},{"type":"text","text":" "},{"type":"text","text":"delivers them on the next launch (unless its bound drops them first, which it reports)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing runs until the work is executed, and each execution reads the sequence again, so"},{"type":"text","text":" "},{"type":"text","text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops"},{"type":"text","text":" "},{"type":"text","text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of"},{"type":"text","text":" "},{"type":"text","text":"work: executing a cancelled delivery again throws "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" at once, so build a"},{"type":"text","text":" "},{"type":"text","text":"new one instead."}]},{"type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" is at least 1.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Precondition"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:bufferdropreporter:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"bufferDropReporter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"BufferDropReport","preciseIdentifier":"s:12Destinations16BufferDropReportV","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Continuation","preciseIdentifier":"s:ScS12ContinuationV","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsynchronousUnitOfWork","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","kind":"typeIdentifier"},{"text":"<()>\n","kind":"text"}],"remoteSource":{"fileName":"Deliver.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L59"},"title":"deliver(to:batchBufferLimit:bufferDropReporter:)","role":"symbol","modules":[{"relatedModules":["_Concurrency"],"name":"Destinations"}],"externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimit18bufferDropReporterQrAA11Destination_pd_SiScS12ContinuationVyAA0jM6ReportV_GSgtF","symbolKind":"method","extendedModule":"_Concurrency"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"sections":[],"abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Destinations/documentation/Destinations":{"abstract":[],"identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection","title":"Destinations","url":"\/documentation\/destinations","kind":"symbol","type":"topic"},"doc://Destinations/documentation/Destinations/Destination":{"role":"symbol","title":"Destination","abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"type":"topic","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"url":"\/documentation\/destinations\/destination","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","kind":"symbol"},"doc://Destinations/documentation/Destinations/BufferDropReport":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","kind":"symbol","type":"topic","title":"BufferDropReport","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BufferDropReport","kind":"identifier"}],"url":"\/documentation\/destinations\/bufferdropreport","navigatorTitle":[{"text":"BufferDropReport","kind":"identifier"}],"abstract":[{"type":"text","text":"A batch a destination’s full buffer dropped before the destination received it."}]},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence":{"role":"symbol","title":"AsyncSequence","abstract":[],"type":"topic","navigatorTitle":[{"text":"AsyncSequence","kind":"identifier"}],"url":"\/documentation\/destinations\/_concurrency\/asyncsequence","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncSequence","preciseIdentifier":"s:Sci","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence","kind":"symbol"},"doc://Destinations/documentation/Destinations/_Concurrency":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","title":"_Concurrency","kind":"symbol","role":"collection","type":"topic","abstract":[],"url":"\/documentation\/destinations\/_concurrency"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/deliver(to:batchBufferLimit:bufferDropReporter:)":{"role":"symbol","title":"deliver(to:batchBufferLimit:bufferDropReporter:)","abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"type":"topic","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"url":"\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:bufferdropreporter:)","f