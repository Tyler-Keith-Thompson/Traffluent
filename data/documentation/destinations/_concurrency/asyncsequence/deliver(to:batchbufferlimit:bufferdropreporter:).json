{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:bufferDropReporter:)"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"abstract":[{"text":"The work of delivering each batch of this sequence to every destination, until the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends.","type":"text"}],"variants":[{"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:bufferdropreporter:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"destinations"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"Destination","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","preciseIdentifier":"s:12Destinations11DestinationP"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 100, "},{"kind":"externalParam","text":"bufferDropReporter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"BufferDropReport","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","preciseIdentifier":"s:12Destinations16BufferDropReportV"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"Continuation","preciseIdentifier":"s:ScS12ContinuationV"},{"kind":"text","text":"? = nil) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"AsynchronousUnitOfWork","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP"},{"kind":"text","text":"<()>\n"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where each batch goes."}]}],"name":"destinations"},{"content":[{"inlineContent":[{"text":"How many batches each destination may have waiting while it is","type":"text"},{"text":" ","type":"text"},{"text":"still receiving an earlier one. A tenth of how many dropped batches it keeps track of","type":"text"},{"text":" ","type":"text"},{"text":"to read back.","type":"text"}],"type":"paragraph"}],"name":"batchBufferLimit"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Where a report of each batch a destination’s full buffer drops is","type":"text"},{"text":" ","type":"text"},{"text":"yielded, as it is dropped; none by default. The delivery never finishes it, so one","type":"text"},{"text":" ","type":"text"},{"text":"reporter can serve the deliveries that replace one another.","type":"text"}]}],"name":"bufferDropReporter"}]},{"content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"text":"A unit of work that completes once the last batch is delivered, and throws what","type":"text"},{"text":" ","type":"text"},{"text":"the sequence throws, or ","type":"text"},{"type":"codeVoice","code":"CancellationError"},{"text":" when cancelled.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each destination receives its batches in order, one at a time, from a buffer of its own,"},{"type":"text","text":" "},{"type":"text","text":"so a slow destination delays only itself. When a batch arrives while a destination’s"},{"type":"text","text":" "},{"type":"text","text":"buffer already holds "},{"code":"batchBufferLimit","type":"codeVoice"},{"type":"text","text":" batches, the oldest waiting batch is dropped,"},{"type":"text","text":" "},{"type":"text","text":"logged and reported on "},{"code":"bufferDropReporter","type":"codeVoice"},{"type":"text","text":" as a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"},{"type":"text","text":". Its records kept in"},{"type":"text","text":" "},{"type":"text","text":"memory only are lost. Those a store keeps are not: once that destination has received"},{"type":"text","text":" "},{"type":"text","text":"every batch waiting in its buffer, the delivery reads them back from the store and hands"},{"type":"text","text":" "},{"type":"text","text":"them to that destination alone, one dropped batch at a time, oldest first. Read back, a"},{"type":"text","text":" "},{"type":"text","text":"record is as it was dropped: its "},{"code":"EventRecord.id","type":"codeVoice"},{"type":"text","text":", "},{"code":"EventRecord.isRedelivered","type":"codeVoice"},{"type":"text","text":", sensitive"},{"type":"text","text":" "},{"type":"text","text":"values and context, which the delivery keeps meanwhile. The delivery keeps track of at"},{"type":"text","text":" "},{"type":"text","text":"most ten times "},{"code":"batchBufferLimit","type":"codeVoice"},{"type":"text","text":" dropped batches per destination; past that it forgets"},{"type":"text","text":" "},{"type":"text","text":"the oldest, whose records stay in the store for the next launch, and logs it. Once the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends, the work completes after every destination has received its last batch,"},{"type":"text","text":" "},{"type":"text","text":"the ones read back included."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records a store keeps (those with an "},{"type":"codeVoice","code":"EventRecord.deliveryTag"},{"type":"text","text":") are reported to it:"},{"type":"text","text":" "},{"type":"text","text":"before a batch goes to any destination, and again once every destination’s "},{"type":"codeVoice","code":"receive"},{"type":"text","text":" "},{"type":"text","text":"has returned for it without being cancelled, when the store may forget them. A record"},{"type":"text","text":" "},{"type":"text","text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left"},{"type":"text","text":" "},{"type":"text","text":"with no records isn’t sent. A record that some destination never received, because the"},{"type":"text","text":" "},{"type":"text","text":"store no longer kept it or couldn’t read it back when the delivery asked, is never"},{"type":"text","text":" "},{"type":"text","text":"acknowledged, so a store that still keeps it delivers it on the next launch."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records the delivery has read but not delivered are lost to this run when it is cancelled"},{"type":"text","text":" "},{"type":"text","text":"or fails. Without a store they are gone; a store never had them acknowledged, so it"},{"type":"text","text":" "},{"type":"text","text":"delivers them on the next launch (unless its bound drops them first, which it reports)."}],"type":"paragraph"},{"inlineContent":[{"text":"Nothing runs until the work is executed, and each execution reads the sequence again, so","type":"text"},{"text":" ","type":"text"},{"text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops","type":"text"},{"text":" ","type":"text"},{"text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of","type":"text"},{"text":" ","type":"text"},{"text":"work: executing a cancelled delivery again throws ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" at once, so build a","type":"text"},{"text":" ","type":"text"},{"text":"new one instead.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" is at least 1.","type":"text"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"metadata":{"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bufferDropReporter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV","text":"BufferDropReport"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation"},{"kind":"text","text":"?) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","text":"AsynchronousUnitOfWork"},{"kind":"text","text":"<()>\n"}],"externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimit18bufferDropReporterQrAA11Destination_pd_SiScS12ContinuationVyAA0jM6ReportV_GSgtF","roleHeading":"Instance Method","title":"deliver(to:batchBufferLimit:bufferDropReporter:)","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":"."}]},"remoteSource":{"fileName":"Deliver.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L59"},"extendedModule":"_Concurrency","role":"symbol","modules":[{"name":"Destinations","relatedModules":["_Concurrency"]}]},"sections":[],"references":{"doc://Destinations/documentation/Destinations/_Concurrency":{"title":"_Concurrency","role":"collection","abstract":[],"type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","kind":"symbol","url":"\/documentation\/destinations\/_concurrency"},"doc://Destinations/documentation/Destinations":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[],"url":"\/documentation\/destinations","title":"Destinations","type":"topic","kind":"symbol","role":"collection"},"doc://Destinations/documentation/Destinations/Destination":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"url":"\/documentation\/destinations\/destination","kind":"symbol","type":"topic","title":"Destination","navigatorTitle":[{"kind":"identifier","text":"Destination"}],"role":"symbol"},"doc://Destinations/documentation/Destinations/BufferDropReport":{"url":"\/documentation\/destinations\/bufferdropreport","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BufferDropReport","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"BufferDropReport","kind":"identifier"}],"title":"BufferDropReport","abstract":[{"type":"text","text":"A batch a destination’s full buffer dropped before the destination received it."}]},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:Sci","kind":"identifier","text":"AsyncSequence"}],"navigatorTitle":[{"kind":"identifier","text":"AsyncSequence"}],"abstract":[],"title":"AsyncSequence","kind":"symbol","url":"\/documentation\/destinations\/_concurrency\/asyncsequence","role":"symbol","type":"topic"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/deliver(to:batchBufferLimit:bufferDropReporter:)":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:bufferDropReporter:)","kind":"symbol","title":"deliver(to:batchBufferLimit:bufferDropReporter:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"bufferDropReporter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:12Destinations16BufferDropReportV","text":"BufferDropReport","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","text":"AsynchronousUnitOfWork","kind":"typeIdentifier"},{"text":"<()>\n","kind":"text"}],"role":"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"url":"\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:bufferdropreporter:)","abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}]}}}