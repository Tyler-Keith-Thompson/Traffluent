{"sections":[],"abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"kind":"symbol","metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Destination","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"bufferDropReporter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"BufferDropReport","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV"},{"text":">.","kind":"text"},{"text":"Continuation","kind":"typeIdentifier","preciseIdentifier":"s:ScS12ContinuationV"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"InvalidBatchBufferLimit","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations23InvalidBatchBufferLimitV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsynchronousUnitOfWork","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP"},{"text":"<()>\n","kind":"text"}],"conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"[EventRecord]","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"symbolKind":"method","role":"symbol","roleHeading":"Instance Method","title":"deliver(to:batchBufferLimit:bufferDropReporter:)","externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimit18bufferDropReporterQrAA11Destination_pd_SiScS12ContinuationVyAA0jM6ReportV_GSgtAA012InvalidBatchjK0VYKF","modules":[{"name":"Destinations","relatedModules":["_Concurrency"]}],"extendedModule":"_Concurrency","remoteSource":{"fileName":"Deliver.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L60"}},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"destinations","kind":"internalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:12Destinations11DestinationP","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","text":"Destination","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"bufferDropReporter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:12Destinations16BufferDropReportV","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","text":"BufferDropReport","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:12Destinations23InvalidBatchBufferLimitV","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","text":"InvalidBatchBufferLimit","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","text":"AsynchronousUnitOfWork","kind":"typeIdentifier"},{"text":"<()>\n","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where each batch goes."}]}],"name":"destinations"},{"content":[{"inlineContent":[{"type":"text","text":"How many batches each destination may have waiting while it is"},{"type":"text","text":" "},{"type":"text","text":"still receiving an earlier one. A tenth of how many dropped batches it keeps track of"},{"type":"text","text":" "},{"type":"text","text":"to read back."}],"type":"paragraph"}],"name":"batchBufferLimit"},{"content":[{"inlineContent":[{"type":"text","text":"Where a report of each batch a destination’s full buffer drops is"},{"type":"text","text":" "},{"type":"text","text":"yielded, as it is dropped; none by default. The delivery never finishes it, so one"},{"type":"text","text":" "},{"type":"text","text":"reporter can serve the deliveries that replace one another."}],"type":"paragraph"}],"name":"bufferDropReporter"}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"A unit of work that completes once the last batch is delivered, and throws what","type":"text"},{"text":" ","type":"text"},{"text":"the sequence throws, or ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" when cancelled.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each destination receives its batches in order, one at a time, from a buffer of its own,","type":"text"},{"text":" ","type":"text"},{"text":"so a slow destination delays only itself. When a batch arrives while a destination’s","type":"text"},{"text":" ","type":"text"},{"text":"buffer already holds ","type":"text"},{"type":"codeVoice","code":"batchBufferLimit"},{"text":" batches, the oldest waiting batch is dropped,","type":"text"},{"text":" ","type":"text"},{"text":"logged and reported on ","type":"text"},{"type":"codeVoice","code":"bufferDropReporter"},{"text":" as a ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","isActive":true,"type":"reference"},{"text":". Its records kept in","type":"text"},{"text":" ","type":"text"},{"text":"memory only are lost. Those a store keeps are not: once that destination has received","type":"text"},{"text":" ","type":"text"},{"text":"every batch waiting in its buffer, the delivery reads them back from the store and hands","type":"text"},{"text":" ","type":"text"},{"text":"them to that destination alone, one dropped batch at a time, oldest first. Read back, a","type":"text"},{"text":" ","type":"text"},{"text":"record is as it was dropped: its ","type":"text"},{"type":"codeVoice","code":"EventRecord.id"},{"text":", ","type":"text"},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"text":", sensitive","type":"text"},{"text":" ","type":"text"},{"text":"values and context, which the delivery keeps meanwhile. The delivery keeps track of at","type":"text"},{"text":" ","type":"text"},{"text":"most ten times ","type":"text"},{"type":"codeVoice","code":"batchBufferLimit"},{"text":" dropped batches per destination; past that it forgets","type":"text"},{"text":" ","type":"text"},{"text":"the oldest, whose records stay in the store for the next launch, and logs it. Once the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends, the work completes after every destination has received its last batch,","type":"text"},{"text":" ","type":"text"},{"text":"the ones read back included.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records a store keeps (those with an "},{"type":"codeVoice","code":"EventRecord.deliveryTag"},{"type":"text","text":") are reported to it:"},{"type":"text","text":" "},{"type":"text","text":"before a batch goes to any destination, and again once every destination’s "},{"type":"codeVoice","code":"receive"},{"type":"text","text":" "},{"type":"text","text":"has returned for it without being cancelled, when the store may forget them. A record"},{"type":"text","text":" "},{"type":"text","text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left"},{"type":"text","text":" "},{"type":"text","text":"with no records isn’t sent. A record that some destination never received, because the"},{"type":"text","text":" "},{"type":"text","text":"store no longer kept it or couldn’t read it back when the delivery asked, is never"},{"type":"text","text":" "},{"type":"text","text":"acknowledged, so a store that still keeps it delivers it on the next launch."}],"type":"paragraph"},{"inlineContent":[{"text":"Records the delivery has read but not delivered are lost to this run when it is cancelled","type":"text"},{"text":" ","type":"text"},{"text":"or fails. Without a store they are gone; a store never had them acknowledged, so it","type":"text"},{"text":" ","type":"text"},{"text":"delivers them on the next launch (unless its bound drops them first, which it reports).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Nothing runs until the work is executed, and each execution reads the sequence again, so"},{"type":"text","text":" "},{"type":"text","text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops"},{"type":"text","text":" "},{"type":"text","text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of"},{"type":"text","text":" "},{"type":"text","text":"work: executing a cancelled delivery again throws "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" at once, so build a"},{"type":"text","text":" "},{"type":"text","text":"new one instead."}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","isActive":true},{"type":"text","text":" when "},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" is below 1."}]}],"type":"aside"}]}],"seeAlsoSections":[{"generated":true,"anchor":"Delivering","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:bufferDropReporter:)","doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"],"title":"Delivering"}],"variants":[{"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:bufferdropreporter:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:bufferDropReporter:)"},"references":{"doc://Destinations/documentation/Destinations":{"type":"topic","title":"Destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection","abstract":[{"type":"text","text":"Where tracked events go: the "},{"code":"Destination","type":"codeVoice"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"url":"\/documentation\/destinations","kind":"symbol"},"doc://Destinations/documentation/Destinations/_Concurrency":{"kind":"symbol","type":"topic","abstract":[],"url":"\/documentation\/destinations\/_concurrency","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","title":"_Concurrency","role":"collection"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/deliver(to:batchBufferLimit:bufferDropReporter:)":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","text":"Destination"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bufferDropReporter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:ScS","kind":"typeIdentifier","text":"AsyncStream"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:12Destinations16BufferDropReportV","kind":"typeIdentifier","text":"BufferDropReport"},{"kind":"text","text":">."},{"preciseIdentifier":"s:ScS12ContinuationV","kind":"typeIdentifier","text":"Continuation"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"k