uence ends, as "},{"type":"codeVoice","code":"deliver(to:batchBufferLimit:bufferDropReporter:)"},{"type":"text","text":" does, with a buffer of"},{"type":"text","text":" "},{"type":"text","text":"100 batches for each destination."}],"role":"symbol","title":"deliver(to:bufferDropReporter:)"},"doc://Destinations/documentation/Destinations/_Concurrency":{"type":"topic","abstract":[],"role":"collection","url":"\/documentation\/destinations\/_concurrency","kind":"symbol","title":"_Concurrency","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency"},"doc://Destinations/documentation/Destinations":{"title":"Destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}]},"doc://Destinations/documentation/Destinations/InvalidBatchBufferLimit":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InvalidBatchBufferLimit","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","kind":"symbol","url":"\/documentation\/destinations\/invalidbatchbufferlimit","title":"InvalidBatchBufferLimit","abstract":[{"type":"text","text":"The error "},{"type":"codeVoice","code":"deliver(to:batchBufferLimit:bufferDropReporter:)"},{"type":"text","text":" throws for a batch buffer limit"},{"type":"text","text":" "},{"type":"text","text":"below 1."}],"type":"topic","navigatorTitle":[{"text":"InvalidBatchBufferLimit","kind":"identifier"}],"role":"symbol"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence":{"title":"AsyncSequence","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence","rol