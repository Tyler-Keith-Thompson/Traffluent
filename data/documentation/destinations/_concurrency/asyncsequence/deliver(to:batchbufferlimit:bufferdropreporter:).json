ination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"references":{"doc://Destinations/documentation/Destinations/_Concurrency":{"type":"topic","role":"collection","url":"\/documentation\/destinations\/_concurrency","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","title":"_Concurrency","abstract":[]},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence":{"navigatorTitle":[{"kind":"identifier","text":"AsyncSequence"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence","abstract":[],"kind":"symbol","type":"topic","title":"AsyncSequence","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:Sci","text":"AsyncSequence"}],"url":"\/documentation\/destinations\/_concurrency\/asyncsequence"},"doc://Destinations/documentation/Destinations":{"title":"Destinations","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Where tracked events go: the "},{"code":"Destination","type":"codeVoice"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"url":"\/documentation\/destinations","role":"collection","identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/batch(clock:)":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","abstract":[{"type":"text","text":"Gathers the records into batches of 20, and every 30 seconds by "},{"type":"codeVoice","code":"clock"},{"type":"text","text":" while any are"},{"type":"text","text":" "},{"type":"text","text":"pending."}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"ty