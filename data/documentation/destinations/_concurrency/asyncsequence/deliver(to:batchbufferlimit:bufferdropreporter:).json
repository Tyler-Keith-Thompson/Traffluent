yncSequence","type":"topic"},"doc://Destinations/documentation/Destinations/InvalidBatchBufferLimit":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InvalidBatchBufferLimit"}],"navigatorTitle":[{"kind":"identifier","text":"InvalidBatchBufferLimit"}],"kind":"symbol","url":"\/documentation\/destinations\/invalidbatchbufferlimit","title":"InvalidBatchBufferLimit","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","type":"topic","abstract":[{"text":"The error ","type":"text"},{"code":"deliver(to:batchBufferLimit:bufferDropReporter:)","type":"codeVoice"},{"text":" throws for a batch buffer limit","type":"text"},{"text":" ","type":"text"},{"text":"below 1.","type":"text"}]},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/batch(clock:)":{"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"(","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","text":"Batch","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:7Afluent19EitherBatchStrategyV","text":"EitherBatchStrategy","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"abstract":[{"type":"text","text":"Gathers the records into batches of 20, and every 30 seconds by "},{"type":"codeVoice","code":"clock"},{"type":"text","text":" while any are"},{"type":"text","text":" "},{"type":"text","text":"pending."}],"url":"\/documentation\/destinations\/_concurrency\/asyncsequence\/batch(clock:)","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"EventRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":".","type":"text"}]},"title":"batch(clock:)","role":"symbol"},"doc://Destinations/documentation/Destinations/BufferDropReport":{"url":"\/documentation\/destinations\/bufferdropreport","type":"topic","title":"BufferDropReport","navigatorTitle":[{"text":"BufferDropReport","kind":"identifier"}],"abstract":[{"type":"text","text":"A batch a destination’s full buffer dropped before the destination received it."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BufferDropReport","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","role":"symbol","kind":"symbol"},"doc://Destinations/documentation/Destinations/Destination":{"abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"type":"topic","url":"\/documentation\/destinations\/destination","role":"symbol",