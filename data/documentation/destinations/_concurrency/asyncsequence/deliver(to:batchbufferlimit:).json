r(to:batchBufferLimit:)","kind":"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"url":"\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)","role":"symbol","type":"topic"},"doc://Destinations/documentation/Destinations/_Concurrency":{"abstract":[],"type":"topic","title":"_Concurrency","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","kind":"symbol","url":"\/documentation\/destinations\/_concurrency","role":"collection"}}}