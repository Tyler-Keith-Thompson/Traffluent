{"abstract":[{"text":"The work of delivering each batch of this sequence to every destination, until the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends.","type":"text"}],"metadata":{"externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimitQrAA11Destination_pd_SitF","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Element"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"[EventRecord]"},{"text":".","type":"text"}]},"modules":[{"relatedModules":["_Concurrency"],"name":"Destinations"}],"extendedModule":"_Concurrency","title":"deliver(to:batchBufferLimit:)","roleHeading":"Instance Method","role":"symbol","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L46","fileName":"Deliver.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Destination","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsynchronousUnitOfWork","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP"},{"text":"<()>\n","kind":"text"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"destinations","kind":"internalParam"},{"text":": any ","kind":"text"},{"text":"Destination","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":" = 100) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsynchronousUnitOfWork","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","kind":"typeIdentifier"},{"text":"<()>\n","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"destinations","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where each batch goes."}]}]},{"name":"batchBufferLimit","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How many batches each destination may have waiting while it is"},{"type":"text","text":" "},{"type":"text","text":"still receiving an earlier one."}]}]}]},{"content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A unit of work that completes once the last batch is delivered, and throws what"},{"type":"text","text":" "},{"type":"text","text":"the sequence throws, or "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" when cancelled."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each destination receives its batches in order, one at a time, from a buffer of its own,"},{"type":"text","text":" "},{"type":"text","text":"so a slow destination delays only itself. When a batch arrives while a destination’s"},{"type":"text","text":" "},{"type":"text","text":"buffer already holds "},{"code":"batchBufferLimit","type":"codeVoice"},{"type":"text","text":" batches, the oldest waiting batch is dropped."},{"type":"text","text":" "},{"type":"text","text":"Once the sequence ends, the work completes after every destination has received its last"},{"type":"text","text":" "},{"type":"text","text":"batch."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records a store keeps (those with an "},{"type":"codeVoice","code":"EventRecord.deliveryTag"},{"type":"text","text":") are reported to it:"},{"type":"text","text":" "},{"type":"text","text":"before a batch goes to any destination, and again once every destination’s "},{"type":"codeVoice","code":"receive"},{"type":"text","text":" "},{"type":"text","text":"has returned for it without being cancelled, when the store may forget them. A record"},{"type":"text","text":" "},{"type":"text","text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left"},{"type":"text","text":" "},{"type":"text","text":"with no records isn’t sent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records the delivery has read but not delivered are lost to this run when it is cancelled"},{"type":"text","text":" "},{"type":"text","text":"or fails, and so are batches a destination’s full buffer dropped. Without a store they are"},{"type":"text","text":" "},{"type":"text","text":"gone; a store never had them acknowledged, so it delivers them on the next launch (unless"},{"type":"text","text":" "},{"type":"text","text":"its bound drops them first, which it reports)."}],"type":"paragraph"},{"inlineContent":[{"text":"Nothing runs until the work is executed, and each execution reads the sequence again, so","type":"text"},{"text":" ","type":"text"},{"text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops","type":"text"},{"text":" ","type":"text"},{"text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of","type":"text"},{"text":" ","type":"text"},{"text":"work: executing a cancelled delivery again throws ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" at once, so build a","type":"text"},{"text":" ","type":"text"},{"text":"new one instead.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" is at least 1.","type":"text"}]}],"type":"aside"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"references":{"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/deliver(to:batchBufferLimit:)":{"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Element","type":"codeVoice"},{"type":"text","text":" is "},{"code":"[EventRecord]","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)","abstract":[{"text":"The work of delivering each batch of this sequence to every destination, until the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends.","type":"text"}],"kind":"symbol","title":"deliver(to:batchBufferLimit:)","url":"\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","text":"Destination"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","kind":"typeIdentifier","text":"AsynchronousUnitOfWork"},{"kind":"text","text":"<()>\n"}],"role":"symbol"},"doc://Destinations/documentation/Destinations/Destination":{"navigatorTitle":[{"kind":"identifier","text":"Destination"}],"type":"topic","abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","kind":"symbol","title":"Destination","url":"\/documentation\/destinations\/destination","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"role":"symbol"},"doc://Destinations/documentation/Destinations":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","title":"Destinations","type":"topic","role":"collection