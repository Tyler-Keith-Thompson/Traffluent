{"abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"variants":[{"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"destinations"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"Destination","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","preciseIdentifier":"s:12Destinations11DestinationP"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 100) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"AsynchronousUnitOfWork","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP"},{"kind":"text","text":"<()>\n"}]}]},{"kind":"parameters","parameters":[{"name":"destinations","content":[{"inlineContent":[{"text":"Where each batch goes.","type":"text"}],"type":"paragraph"}]},{"name":"batchBufferLimit","content":[{"inlineContent":[{"text":"How many batches each destination may have waiting while it is","type":"text"},{"text":" ","type":"text"},{"text":"still receiving an earlier one.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"text":"A unit of work that completes once the last batch is delivered, and throws what","type":"text"},{"text":" ","type":"text"},{"text":"the sequence throws, or ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" when cancelled.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"codeListing","syntax":"swift","code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"]},{"type":"paragraph","inlineContent":[{"text":"Each destination receives its batches in order, one at a time, from a buffer of its own,","type":"text"},{"text":" ","type":"text"},{"text":"so a slow destination delays only itself. When a batch arrives while a destination’s","type":"text"},{"text":" ","type":"text"},{"text":"buffer already holds ","type":"text"},{"type":"codeVoice","code":"batchBufferLimit"},{"text":" batches, the oldest waiting batch is dropped.","type":"text"},{"text":" ","type":"text"},{"text":"Once the sequence ends, the work completes after every destination has received its last","type":"text"},{"text":" ","type":"text"},{"text":"batch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records a store keeps (those with an "},{"code":"EventRecord.deliveryTag","type":"codeVoice"},{"type":"text","text":") are reported to it:"},{"type":"text","text":" "},{"type":"text","text":"before a batch goes to any destination, and again once every destination’s "},{"code":"receive","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"has returned for it without being cancelled, when the store may forget them. A record"},{"type":"text","text":" "},{"type":"text","text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left"},{"type":"text","text":" "},{"type":"text","text":"with no records isn’t sent."}]},{"type":"paragraph","inlineContent":[{"text":"Records the delivery has read but not delivered are lost to this run when it is cancelled","type":"text"},{"text":" ","type":"text"},{"text":"or fails, and so are batches a destination’s full buffer dropped. Without a store they are","type":"text"},{"text":" ","type":"text"},{"text":"gone; a store never had them acknowledged, so it delivers them on the next launch (unless","type":"text"},{"text":" ","type":"text"},{"text":"its bound drops them first, which it reports).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Nothing runs until the work is executed, and each execution reads the sequence again, so","type":"text"},{"text":" ","type":"text"},{"text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops","type":"text"},{"text":" ","type":"text"},{"text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of","type":"text"},{"text":" ","type":"text"},{"text":"work: executing a cancelled delivery again throws ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" at once, so build a","type":"text"},{"text":" ","type":"text"},{"text":"new one instead.","type":"text"}]},{"type":"aside","name":"Precondition","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" is at least 1.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)","interfaceLanguage":"swift"},"sections":[],"metadata":{"roleHeading":"Instance Method","externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimitQrAA11Destination_pd_SitF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","text":"AsynchronousUnitOfWork"},{"kind":"text","text":"<()>\n"}],"title":"deliver(to:batchBufferLimit:)","extendedModule":"_Concurrency","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L46","fileName":"Deliver.swift"},"role":"symbol","symbolKind":"method","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"modules":[{"name":"Destinations","relatedModules":["_Concurrency"]}]},"references":{"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence":{"kind":"symbol","url":"\/documentation\/destinations\/_concurrency\/asyncsequence","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"AsyncSequence"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:Sci","kind":"identifier","text":"AsyncSequence"}],"title":"AsyncSequence"},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","role":"collection","abstract":[],"kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations","title":"Destinations","type":"topic"},"doc://Destinations/documentation/Destinations/Destination":{"navigatorTitle":[{"kind":"identifier","text":"Destination"}],"url":"\/documentation\/destinations\/destination","role":"symbol","abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","title":"Destination","type":"topic"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/deliver(to:batchBufferLimit:)":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","text":"AsynchronousUnitOfWork","kind":"typeIdentifier"},{"text":"<()>\n","kind":"text"}],"abstract":[{"text":"The work of delivering each batch of this sequence to every destination, until the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends.","type":"text"}],"kind":"symbol","type":"topic","title":"deliver(to:batchBufferLimit:)","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)","role":"symbol","url":"\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)"},"doc://Destinations/documentation/Destinations/_Concurrency":{"url":"\/documentation\/destinations\/_concurrency","role":"collection","abstract":[],"kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","title":"_Concurrency","type":"topic"}}}