{"metadata":{"role":"symbol","title":"deliver(to:batchBufferLimit:)","extendedModule":"_Concurrency","modules":[{"relatedModules":["_Concurrency"],"name":"Destinations"}],"roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L59","fileName":"Deliver.swift"},"externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimitAA8DeliveryVAA11Destination_pd_SitAA012InvalidBatchjK0VYKF","symbolKind":"method","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"[EventRecord]","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"InvalidBatchBufferLimit","preciseIdentifier":"s:12Destinations23InvalidBatchBufferLimitV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Delivery","preciseIdentifier":"s:12Destinations8DeliveryV"}]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:)","doc:\/\/Destinations\/documentation\/Destinations\/Delivery","doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"],"anchor":"Delivering","title":"Delivering","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)"},"variants":[{"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"destinations","kind":"internalParam"},{"text":": any ","kind":"text"},{"text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"InvalidBatchBufferLimit","preciseIdentifier":"s:12Destinations23InvalidBatchBufferLimitV","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Delivery","preciseIdentifier":"s:12Destinations8DeliveryV","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"Where each batch goes.","type":"text"}],"type":"paragraph"}],"name":"destinations"},{"content":[{"type":"paragraph","inlineContent":[{"text":"How many batches each destination may have waiting while it is","type":"text"},{"text":" ","type":"text"},{"text":"still receiving an earlier one. A tenth of how many dropped batches it keeps track of","type":"text"},{"text":" ","type":"text"},{"text":"to read back.","type":"text"}]}],"name":"batchBufferLimit"}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The delivery, holding the unit of work that completes once the last batch is","type":"text"},{"text":" ","type":"text"},{"text":"delivered, and throws what the sequence throws, or ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" when cancelled;","type":"text"},{"text":" ","type":"text"},{"text":"its ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","isActive":true,"type":"reference"},{"text":" report the batches full buffers drop.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"codeListing","syntax":"swift","code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"]},{"inlineContent":[{"text":"Each destination receives its batches in order, one at a time, from a buffer of its own,","type":"text"},{"text":" ","type":"text"},{"text":"so a slow destination delays only itself. When a batch arrives while a destination’s","type":"text"},{"text":" ","type":"text"},{"text":"buffer already holds ","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" batches, the oldest waiting batch is dropped,","type":"text"},{"text":" ","type":"text"},{"text":"logged and reported on the delivery’s ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","isActive":true,"type":"reference"},{"text":", where the drops no","type":"text"},{"text":" ","type":"text"},{"text":"one has read yet wait as one ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","isActive":true,"type":"reference"},{"text":" per destination. Its records kept in","type":"text"},{"text":" ","type":"text"},{"text":"memory only are lost. Those a store keeps are not: once that destination has received","type":"text"},{"text":" ","type":"text"},{"text":"every batch waiting in its buffer, the delivery reads them back from the store and hands","type":"text"},{"text":" ","type":"text"},{"text":"them to that destination alone, one dropped batch at a time, oldest first. Read back, a","type":"text"},{"text":" ","type":"text"},{"text":"record is as it was dropped: its ","type":"text"},{"code":"EventRecord.id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EventRecord.isRedelivered","type":"codeVoice"},{"text":", sensitive","type":"text"},{"text":" ","type":"text"},{"text":"values and context, which the delivery keeps meanwhile. The delivery keeps track of at","type":"text"},{"text":" ","type":"text"},{"text":"most ten times ","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" dropped batches per destination; past that it forgets","type":"text"},{"text":" ","type":"text"},{"text":"the oldest, whose records stay in the store for the next launch, and logs it. Once the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends, the work completes after every destination has received its last batch,","type":"text"},{"text":" ","type":"text"},{"text":"the ones read back included.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Records a store keeps (those with an ","type":"text"},{"type":"codeVoice","code":"EventRecord.deliveryTag"},{"text":") are reported to it:","type":"text"},{"text":" ","type":"text"},{"text":"before a batch goes to any destination, and again once every destination’s ","type":"text"},{"type":"codeVoice","code":"receive"},{"text":" ","type":"text"},{"text":"has returned for it without being cancelled, when the store may forget them. A record","type":"text"},{"text":" ","type":"text"},{"text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left","type":"text"},{"text":" ","type":"text"},{"text":"with no records isn’t sent. A record that some destination never received, because the","type":"text"},{"text":" ","type":"text"},{"text":"store no longer kept it or couldn’t read it back when the delivery asked, is never","type":"text"},{"text":" ","type":"text"},{"text":"acknowledged, so a store that still keeps it delivers it on the next launch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Records the delivery has read but not delivered are lost to this run when it is cancelled","type":"text"},{"text":" ","type":"text"},{"text":"or fails. Without a store they are gone; a store never had them acknowledged, so it","type":"text"},{"text":" ","type":"text"},{"text":"delivers them on the next launch (unless its bound drops them first, which it reports).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Nothing runs until the work is executed, and each execution reads the sequence again, so","type":"text"},{"text":" ","type":"text"},{"text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops","type":"text"},{"text":" ","type":"text"},{"text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of","type":"text"},{"text":" ","type":"text"},{"text":"work: executing a cancelled delivery again throws ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" at once, so build a","type":"text"},{"text":" ","type":"text"},{"text":"new one instead.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Throws","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit"},{"text":" when ","type":"text"},{"type":"codeVoice","code":"batchBufferLimit"},{"text":" is below 1.","type":"text"}],"type":"paragraph"}]}]}],"references":{"doc://Destinations/documentation/Destinations/_Concurrency":{"type":"topic","url":"\/documentation\/destinations\/_concurrency","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","role":"collection","abstract":[],"title":"_Concurrency","kind":"symbol"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence":{"title":"AsyncSequence","navigatorTitle":[{"text":"AsyncSequence","kind":"identifier"}],"type":"topic","abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncSequence","kind":"identifier","preciseIdentifier":"s:Sci"}],"url":"\/documentation\/destinations\/_concurrency\/asyncsequence","kind":"symbol","role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"},"doc://Destinations/documentation/Destinations/Delivery":{"title":"Delivery","navigatorTitle":[{"text":"Delivery","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The work of delivering a sequence’s batches to destinations, made by "},{"type":"codeVoice","code":"deliver(to:)"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"reports of the batches their full buffers drop."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Delivery","kind":"identifier"}],"url":"\/documentation\/destinations\/delivery","kind":"symbol","role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery"},"doc://Destinations/documentation/Destinations/Delivery/bufferDropReports":{"role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","url":"\/documentation\/destinations\/delivery\/bufferdropreports","abstract":[{"text":"A report of the batches each destination’s full buffer drops, in the order they are","type":"text"},{"text":" ","type":"text"},{"text":"dropped.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bufferDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"BufferDropReport","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV"},{"text":">","kind":"text"}],"type":"topic","title":"bufferDropReports","kind":"symbol"},"doc://Destinations/documentation/Destinations":{"role":"collection","title":"Destinations","type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[{"type":"text","text":"Where tracked events go: the "},{"code":"Destination","type":"codeVoice"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"kind":"symbol","url":"\/documentation\/destinations"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/deliver(to:batchBufferLimit:)":{"type":"to