{"seeAlsoSections":[{"anchor":"Delivering","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:)","doc:\/\/Destinations\/documentation\/Destinations\/Delivery","doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"],"title":"Delivering","generated":true}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"destinations","kind":"internalParam"},{"text":": any ","kind":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","preciseIdentifier":"s:12Destinations23InvalidBatchBufferLimitV","text":"InvalidBatchBufferLimit","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","preciseIdentifier":"s:12Destinations8DeliveryV","text":"Delivery","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"destinations","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where each batch goes."}]}]},{"name":"batchBufferLimit","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How many batches each destination may have waiting while it is"},{"type":"text","text":" "},{"type":"text","text":"still receiving an earlier one. A tenth of how many dropped batches it keeps track of"},{"type":"text","text":" "},{"type":"text","text":"to read back."}]}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The delivery, holding the unit of work that completes once the last batch is","type":"text"},{"text":" ","type":"text"},{"text":"delivered, and throws what the sequence throws, or ","type":"text"},{"type":"codeVoice","code":"CancellationError"},{"text":" when cancelled;","type":"text"},{"text":" ","type":"text"},{"text":"its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","type":"reference"},{"text":" report the batches full buffers drop.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"codeListing","code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each destination receives its batches in order, one at a time, from a buffer of its own,"},{"type":"text","text":" "},{"type":"text","text":"so a slow destination delays only itself. When a batch arrives while a destination’s"},{"type":"text","text":" "},{"type":"text","text":"buffer already holds "},{"code":"batchBufferLimit","type":"codeVoice"},{"type":"text","text":" batches, the oldest waiting batch is dropped,"},{"type":"text","text":" "},{"type":"text","text":"logged and reported on the delivery’s "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","isActive":true},{"type":"text","text":", where the drops no"},{"type":"text","text":" "},{"type":"text","text":"one has read yet wait as one "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","isActive":true},{"type":"text","text":" per destination. Its records kept in"},{"type":"text","text":" "},{"type":"text","text":"memory only are lost. Those a store keeps are not: once that destination has received"},{"type":"text","text":" "},{"type":"text","text":"every batch waiting in its buffer, the delivery reads them back from the store and hands"},{"type":"text","text":" "},{"type":"text","text":"them to that destination alone, one dropped batch at a time, oldest first. Read back, a"},{"type":"text","text":" "},{"type":"text","text":"record is as it was dropped: its "},{"code":"EventRecord.id","type":"codeVoice"},{"type":"text","text":", "},{"code":"EventRecord.isRedelivered","type":"codeVoice"},{"type":"text","text":", sensitive"},{"type":"text","text":" "},{"type":"text","text":"values and context, which the delivery keeps meanwhile. The delivery keeps track of at"},{"type":"text","text":" "},{"type":"text","text":"most ten times "},{"code":"batchBufferLimit","type":"codeVoice"},{"type":"text","text":" dropped batches per destination; past that it forgets"},{"type":"text","text":" "},{"type":"text","text":"the oldest, whose records stay in the store for the next launch, and logs it. Once the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends, the work completes after every destination has received its last batch,"},{"type":"text","text":" "},{"type":"text","text":"the ones read back included."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records a store keeps (those with an "},{"type":"codeVoice","code":"EventRecord.deliveryTag"},{"type":"text","text":") are reported to it:"},{"type":"text","text":" "},{"type":"text","text":"before a batch goes to any destination, and again once every destination’s "},{"type":"codeVoice","code":"receive"},{"type":"text","text":" "},{"type":"text","text":"has returned for it without being cancelled, when the store may forget them. A record"},{"type":"text","text":" "},{"type":"text","text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left"},{"type":"text","text":" "},{"type":"text","text":"with no records isn’t sent. A record that some destination never received, because the"},{"type":"text","text":" "},{"type":"text","text":"store no longer kept it or couldn’t read it back when the delivery asked, is never"},{"type":"text","text":" "},{"type":"text","text":"acknowledged, so a store that still keeps it delivers it on the next launch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records the delivery has read but not delivered are lost to this run when it is cancelled"},{"type":"text","text":" "},{"type":"text","text":"or fails. Without a store they are gone; a store never had them acknowledged, so it"},{"type":"text","text":" "},{"type":"text","text":"delivers them on the next launch (unless its bound drops them first, which it reports)."}]},{"type":"paragraph","inlineContent":[{"text":"Nothing runs until the work is executed, and each execution reads the sequence again, so","type":"text"},{"text":" ","type":"text"},{"text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops","type":"text"},{"text":" ","type":"text"},{"text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of","type":"text"},{"text":" ","type":"text"},{"text":"work: executing a cancelled delivery again throws ","type":"text"},{"type":"codeVoice","code":"CancellationError"},{"text":" at once, so build a","type":"text"},{"text":" ","type":"text"},{"text":"new one instead.","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","isActive":true},{"type":"text","text":" when "},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" is below 1."}],"type":"paragraph"}],"name":"Throws"}]}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)"},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)"]}],"abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"metadata":{"extendedModule":"_Concurrency","role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","ki