quence","kind":"identifier","preciseIdentifier":"s:Sci"}],"abstract":[],"type":"topic"},"doc://Destinations/documentation/Destinations/Destination":{"navigatorTitle":[{"text":"Destination","kind":"identifier"}],"role":"symbol","url":"\/documentation\/destinations\/destination","kind":"symbol","type":"topic","title":"Destination","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"doc://Destinations/documentation/Destinations":{"role":"collection","title":"Destinations","url":"\/documentation\/destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"topic","kind":"symbol","abstract":[]}}}