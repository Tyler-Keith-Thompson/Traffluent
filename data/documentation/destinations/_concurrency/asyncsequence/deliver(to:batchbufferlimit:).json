{"metadata":{"externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimitQrAA11Destination_pd_SitF","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"title":"deliver(to:batchBufferLimit:)","modules":[{"relatedModules":["_Concurrency"],"name":"Destinations"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","text":"AsynchronousUnitOfWork","kind":"typeIdentifier"},{"text":"<()>\n","kind":"text"}],"extendedModule":"_Concurrency","remoteSource":{"fileName":"Deliver.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L46"},"roleHeading":"Instance Method","role":"symbol","symbolKind":"method"},"abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"destinations"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","text":"Destination"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" = 100) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","kind":"typeIdentifier","text":"AsynchronousUnitOfWork"},{"kind":"text","text":"<()>\n"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where each batch goes."}]}],"name":"destinations"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How many batches each destination may have waiting while it is"},{"type":"text","text":" "},{"type":"text","text":"still receiving an earlier one."}]}],"name":"batchBufferLimit"}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A unit of work that completes once the last batch is delivered, and throws what","type":"text"},{"text":" ","type":"text"},{"text":"the sequence throws, or ","type":"text"},{"type":"codeVoice","code":"CancellationError"},{"text":" when cancelled.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"codeListing","syntax":"swift","code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"]},{"inlineContent":[{"type":"text","text":"Each destination receives its batches in order, one at a time, from a buffer of its own,"},{"type":"text","text":" "},{"type":"text","text":"so a slow destination delays only itself. When a batch arrives while a destination’s"},{"type":"text","text":" "},{"type":"text","text":"buffer already holds "},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" batches, the oldest waiting batch is dropped."},{"type":"text","text":" "},{"type":"text","text":"Once the sequence ends, the work completes after every destination has received its last"},{"type":"text","text":" "},{"type":"text","text":"batch."}],"type":"paragraph"},{"inlineContent":[{"text":"Records a store keeps (those with an ","type":"text"},{"code":"EventRecord.deliveryTag","type":"codeVoice"},{"text":") are reported to it:","type":"text"},{"text":" ","type":"text"},{"text":"before a batch goes to any destination, and again once every destination’s ","type":"text"},{"code":"receive","type":"codeVoice"},{"text":" ","type":"text"},{"text":"has returned for it without being cancelled, when the store may forget them. A record","type":"text"},{"text":" ","type":"text"},{"text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left","type":"text"},{"text":" ","type":"text"},{"text":"with no records isn’t sent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records the delivery has read but not delivered are lost to this run when it is cancelled"},{"type":"text","text":" "},{"type":"text","text":"or fails, and so are batches a destination’s full buffer dropped. Without a store they are"},{"type":"text","text":" "},{"type":"text","text":"gone; a store never had them acknowledged, so it delivers them on the next launch (unless"},{"type":"text","text":" "},{"type":"text","text":"its bound drops them first, which it reports)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Nothing runs until the work is executed, and each execution reads the sequence again, so"},{"type":"text","text":" "},{"type":"text","text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops"},{"type":"text","text":" "},{"type":"text","text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of"},{"type":"text","text":" "},{"type":"text","text":"work: executing a cancelled delivery again throws "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" at once, so build a"},{"type":"text","text":" "},{"type":"text","text":"new one instead."}],"type":"paragraph"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" is at least 1.","type":"text"}]}],"type":"aside","style":"note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"sections":[],"references":{"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/deliver(to:batchBufferLimit:)":{"url":"\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)","title":"deliver(to:batchBufferLimit:)","kind":"symbol","type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)","abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","text":"Destination"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","kind":"typeIdentifier","text":"AsynchronousUnitOfWork"},{"kind":"text","text":"<()>\n"}],"role":"symbol","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Element"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"[EventRecord]"},{"text":".","type":"text"}]}},"doc://Destinations/documentation/Destinations":{"kind":"symbol","url":"\/documentation\/destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","abstract":[],"type":"topic","title":"Destinations","role":"collection"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence":{"type":"topic","role":"symbol","title":"AsyncSequence","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncSequence","kind":"identifier","preciseIdentifier":"s:Sci"}],"kind":"symbol","abstract":[],"url":"\/documentation\/destinations\/_concurrency\/asyncsequence","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence","navigatorTitle":[{"text":"AsyncSequence","kind":"identifier"}]},"doc://Destinations/documentation/Destinations/Destination":{"title":"Destination","url":"\/documentation\/destinations\/destination","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"doc://Destinations/documentation/Destinations/_Concurrency":{"kind":"symbol","url":"\/documentation\/destinations\/_concurrency","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","type":"topic","abstract":[],"title":"_Concurrency","role":"collection"}}}