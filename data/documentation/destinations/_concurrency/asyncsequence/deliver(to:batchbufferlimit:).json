{"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"destinations","kind":"internalParam"},{"text":": any ","kind":"text"},{"text":"Destination","kind":"typeIdentifier","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","preciseIdentifier":"s:12Destinations11DestinationP"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = 100) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsynchronousUnitOfWork","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP"},{"text":"<()>\n","kind":"text"}],"platforms":["Linux"]}]},{"parameters":[{"name":"destinations","content":[{"inlineContent":[{"type":"text","text":"Where each batch goes."}],"type":"paragraph"}]},{"name":"batchBufferLimit","content":[{"type":"paragraph","inlineContent":[{"text":"How many batches each destination may have waiting while it is","type":"text"},{"text":" ","type":"text"},{"text":"still receiving an earlier one.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A unit of work that completes once the last batch is delivered, and throws what"},{"type":"text","text":" "},{"type":"text","text":"the sequence throws, or "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" when cancelled."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"codeListing","syntax":"swift","code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"]},{"inlineContent":[{"text":"Each destination receives its batches in order, one at a time, from a buffer of its own,","type":"text"},{"text":" ","type":"text"},{"text":"so a slow destination delays only itself. When a batch arrives while a destination’s","type":"text"},{"text":" ","type":"text"},{"text":"buffer already holds ","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" batches, the oldest waiting batch is dropped.","type":"text"},{"text":" ","type":"text"},{"text":"Once the sequence ends, the work completes after every destination has received its last","type":"text"},{"text":" ","type":"text"},{"text":"batch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records a store keeps (those with an "},{"type":"codeVoice","code":"EventRecord.deliveryTag"},{"type":"text","text":") are reported to it:"},{"type":"text","text":" "},{"type":"text","text":"before a batch goes to any destination, and again once every destination’s "},{"type":"codeVoice","code":"receive"},{"type":"text","text":" "},{"type":"text","text":"has returned for it without being cancelled, when the store may forget them. A record"},{"type":"text","text":" "},{"type":"text","text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left"},{"type":"text","text":" "},{"type":"text","text":"with no records isn’t sent."}],"type":"paragraph"},{"inlineContent":[{"text":"Records the delivery has read but not delivered are lost to this run when it is cancelled","type":"text"},{"text":" ","type":"text"},{"text":"or fails, and so are batches a destination’s full buffer dropped. Without a store they are","type":"text"},{"text":" ","type":"text"},{"text":"gone; a store never had them acknowledged, so it delivers them on the next launch (unless","type":"text"},{"text":" ","type":"text"},{"text":"its bound drops them first, which it reports).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Nothing runs until the work is executed, and each execution reads the sequence again, so"},{"type":"text","text":" "},{"type":"text","text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops"},{"type":"text","text":" "},{"type":"text","text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of"},{"type":"text","text":" "},{"type":"text","text":"work: executing a cancelled delivery again throws "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" at once, so build a"},{"type":"text","text":" "},{"type":"text","text":"new one instead."}],"type":"paragraph"},{"type":"aside","name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" is at least 1."}]}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"remoteSource":{"fileName":"Deliver.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L46"},"roleHeading":"Instance Method","role":"symbol","symbolKind":"method","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"[EventRecord]","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Destination","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsynchronousUnitOfWork","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP"},{"text":"<()>\n","kind":"text"}],"modules":[{"relatedModules":["_Concurrency"],"name":"Destinations"}],"extendedModule":"_Concurrency","title":"deliver(to:batchBufferLimit:)","externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimitQrAA11Destination_pd_SitF"},"abstract":[{"text":"The work of delivering each batch of this sequence to every destination, until the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)"]}],"sections":[],"kind":"symbol","references":{"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence":{"kind":"symbol","type":"topic","abstract":[],"role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:Sci","text":"AsyncSequence"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence","navigatorTitle":[{"kind":"identifier","text":"AsyncSequence"}],"url":"\/documentation\/destinations\/_concurrency\/asyncsequence","title":"AsyncSequence"},"doc://Destinations/documentation/Destinations/Destination":{"role":"symbol","abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"type":"topic","url":"\/documentation\/destinations\/destination","kind":"symbol","title":"Destination"},"doc://Destinations/documentation/Destinations":{"role":"collection","type":"topic","abstract":[],"url":"\/documentation\/destinations","title":"Destinations","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://Destinations/documentation/Destinations/_Concurrency":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","role":"collection","abstract":[],"title":"_Concurrency","kind":"symbol","url":"\/documentation\/destinations\/_concurrency","type":"topic"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/deliver(to:batchBufferLimit:)":{"role":"symbol","abstract":[{"text":"The work of delivering each batch of this sequence to every destination, until the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends.","type":"text"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseI