{"sections":[],"variants":[{"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","seeAlsoSections":[{"title":"Delivering","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:)","doc:\/\/Destinations\/documentation\/Destinations\/Delivery","doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"],"anchor":"Delivering","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"relatedModules":["_Concurrency"],"name":"Destinations"}],"symbolKind":"method","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"title":"deliver(to:batchBufferLimit:)","role":"symbol","externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimitAA8DeliveryVAA11Destination_pd_SitAA012InvalidBatchjK0VYKF","extendedModule":"_Concurrency","roleHeading":"Instance Method","remoteSource":{"fileName":"Deliver.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L59"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Destination","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"InvalidBatchBufferLimit","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations23InvalidBatchBufferLimitV"},{"text":") -> ","kind":"text"},{"text":"Delivery","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations8DeliveryV"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"destinations","kind":"internalParam"},{"text":": any ","kind":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","preciseIdentifier":"s:12Destinations23InvalidBatchBufferLimitV","text":"InvalidBatchBufferLimit","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","preciseIdentifier":"s:12Destinations8DeliveryV","text":"Delivery","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"destinations","content":[{"type":"paragraph","inlineContent":[{"text":"Where each batch goes.","type":"text"}]}]},{"name":"batchBufferLimit","content":[{"inlineContent":[{"text":"How many batches each destination may have waiting while it is","type":"text"},{"text":" ","type":"text"},{"text":"still receiving an earlier one. A tenth of how many dropped batches it keeps track of","type":"text"},{"text":" ","type":"text"},{"text":"to read back.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The delivery, holding the unit of work that completes once the last batch is","type":"text"},{"text":" ","type":"text"},{"text":"delivered, and throws what the sequence throws, or ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" when cancelled;","type":"text"},{"text":" ","type":"text"},{"text":"its ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","isActive":true,"type":"reference"},{"text":" report the batches full buffers drop.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"codeListing","code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each destination receives its batches in order, one at a time, from a buffer of its own,"},{"type":"text","text":" "},{"type":"text","text":"so a slow destination delays only itself. When a batch arrives while a destination’s"},{"type":"text","text":" "},{"type":"text","text":"buffer already holds "},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" batches, the oldest waiting batch is dropped,"},{"type":"text","text":" "},{"type":"text","text":"logged and reported on the delivery’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports"},{"type":"text","text":", where the drops no"},{"type":"text","text":" "},{"type":"text","text":"one has read yet wait as one "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"},{"type":"text","text":" per destination. Its records kept in"},{"type":"text","text":" "},{"type":"text","text":"memory only are lost. Those a store keeps are not: once that destination has received"},{"type":"text","text":" "},{"type":"text","text":"every batch waiting in its buffer, the delivery reads them back from the store and hands"},{"type":"text","text":" "},{"type":"text","text":"them to that destination alone, one dropped batch at a time, oldest first. Read back, a"},{"type":"text","text":" "},{"type":"text","text":"record is as it was dropped: its "},{"type":"codeVoice","code":"EventRecord.id"},{"type":"text","text":", "},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"type":"text","text":", sensitive"},{"type":"text","text":" "},{"type":"text","text":"values and context, which the delivery keeps meanwhile. The delivery keeps track of at"},{"type":"text","text":" "},{"type":"text","text":"most ten times "},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" dropped batches per destination; past that it forgets"},{"type":"text","text":" "},{"type":"text","text":"the oldest, whose records stay in the store for the next launch, and logs it. Once the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends, the work completes after every destination has received its last batch,"},{"type":"text","text":" "},{"type":"text","text":"the ones read back included."}]},{"type":"paragraph","inlineContent":[{"text":"Records a store keeps (those with an ","type":"text"},{"code":"EventRecord.deliveryTag","type":"codeVoice"},{"text":") are reported to it:","type":"text"},{"text":" ","type":"text"},{"text":"before a batch goes to any destination, and again once every destination’s ","type":"text"},{"code":"receive","type":"codeVoice"},{"text":" ","type":"text"},{"text":"has returned for it without being cancelled, when the store may forget them. A record","type":"text"},{"text":" ","type":"text"},{"text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left","type":"text"},{"text":" ","type":"text"},{"text":"with no records isn’t sent. A record that some destination never received, because the","type":"text"},{"text":" ","type":"text"},{"text":"store no longer kept it or couldn’t read it back when the delivery asked, is never","type":"text"},{"text":" ","type":"text"},{"text":"acknowledged, so a store that still keeps it delivers it on the next launch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Records the delivery has read but not delivered are lost to this run when it is cancelled","type":"text"},{"text":" ","type":"text"},{"text":"or fails. Without a store they are gone; a store never had them acknowledged, so it","type":"text"},{"text":" ","type":"text"},{"text":"delivers them on the next launch (unless its bound drops them first, which it reports).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing runs until the work is executed, and each execution reads the sequence again, so"},{"type":"text","text":" "},{"type":"text","text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops"},{"type":"text","text":" "},{"type":"text","text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of"},{"type":"text","text":" "},{"type":"text","text":"work: executing a cancelled delivery again throws "},{"code":"CancellationError","type":"codeVoice"},{"type":"text","text":" at once, so build a"},{"type":"text","text":" "},{"type":"text","text":"new one instead."}]},{"type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","type":"reference"},{"text":" when ","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" is below 1.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Throws"}]}],"references":{"doc://Destinations/documentation/Destinations/BufferDropReport":{"type":"topic","title":"BufferDropReport","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BufferDropReport","kind":"identifier"}],"abstract":[{"type":"text","text":"Batches a destination’s full buffer dropped before the destination received them."}],"url":"\/documentation\/destinations\/bufferdropreport","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","navigatorTitle":[{"text":"BufferDropReport","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://Destinations/documentation/Destinations/Destination":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"url":"\/documentation\/destinations\/destination","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Destination"}],"title":"Destination","kind":"symbol","abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","role":"symbol"},"doc://Destinations/documentation/Destinations/_Concurrency":{"kind":"symbol","url":"\/documentation\/destinations\/_concurrency","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","role":"collection","type":"topic","abstract":[],"title":"_Concurrency"},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/batch(clock:)":{"url":"\/documentation\/destinations\/_concurrency\/asyncsequence\/batch(clock:)","kind":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Element","type":"codeVoice"},{"type":"text","text":" is "},{"code":"EventRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"title":"batch(clock:)","role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","abstract":[{"text":"Gathers the records into batches of 20, and every 30 seconds by ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":" while any are","type":"text"},{"text":" ","type":"text"},{"text":"pending.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Batch","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"EitherBatchStrategy","preciseIdentifier":"s:7Afluent19EitherBatchStrategyV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":">>"}],"type":"topic"},"doc://Destinations/documentation/Destinations/Delivery":{"type":"topic","title":"Delivery","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Delivery","kind":"identifier"}],"abstract":[{"text":"The work of delivering a sequence’s batches to destinations, made by ","type":"text"},{"code":"deliver(to:)","type":"codeVoice"},{"text":", and the","type":"text"},{"text":" ","type":"text"},{"text":"reports of the batches their full buffers drop.","type":"text"}],"url":"\/documentation\/destinations\/delivery","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","navigatorTitle":[{"text":"Delivery","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://Destinations/documentation/Destinations/InvalidBatchBufferLimit":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InvalidBatchBufferLimit","kind":"identifier"}],"url":"\/documentation\/destinations\/invalidbatchbufferlimit","type":"topic","navigatorTitle":[{"text":"InvalidBatchBufferLimit","kind":"identifier"}],"title":"InvalidBatchBufferLimit","kind":"symbol","abstract":[{"type":"text","text":"The error "},{"type":"codeVoice","code":"deliver(to:batchBufferLimit:)"},{"type":"text","text":" throws for a batch buffer limit below 1."}],"identifier":"doc:\/\/Destinations\/documentation\/D