{"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"sections":[],"abstract":[{"type":"text","text":"The work of delivering each batch of this sequence to every destination, until the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"destinations"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","text":"Destination"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations23InvalidBatchBufferLimitV","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","text":"InvalidBatchBufferLimit"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations8DeliveryV","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","text":"Delivery"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where each batch goes."}]}],"name":"destinations"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How many batches each destination may have waiting while it is"},{"type":"text","text":" "},{"type":"text","text":"still receiving an earlier one. A tenth of how many dropped batches it keeps track of"},{"type":"text","text":" "},{"type":"text","text":"to read back."}]}],"name":"batchBufferLimit"}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The delivery, holding the unit of work that completes once the last batch is"},{"type":"text","text":" "},{"type":"text","text":"delivered, and throws what the sequence throws, or "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" when cancelled;"},{"type":"text","text":" "},{"type":"text","text":"its "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","isActive":true},{"type":"text","text":" report the batches full buffers drop."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"syntax":"swift","code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"],"type":"codeListing"},{"inlineContent":[{"text":"Each destination receives its batches in order, one at a time, from a buffer of its own,","type":"text"},{"text":" ","type":"text"},{"text":"so a slow destination delays only itself. When a batch arrives while a destination’s","type":"text"},{"text":" ","type":"text"},{"text":"buffer already holds ","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" batches, the oldest waiting batch is dropped,","type":"text"},{"text":" ","type":"text"},{"text":"logged and reported on the delivery’s ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","isActive":true,"type":"reference"},{"text":", where the drops no","type":"text"},{"text":" ","type":"text"},{"text":"one has read yet wait as one ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","isActive":true,"type":"reference"},{"text":" per destination. Its records kept in","type":"text"},{"text":" ","type":"text"},{"text":"memory only are lost. Those a store keeps are not: once that destination has received","type":"text"},{"text":" ","type":"text"},{"text":"every batch waiting in its buffer, the delivery reads them back from the store and hands","type":"text"},{"text":" ","type":"text"},{"text":"them to that destination alone, one dropped batch at a time, oldest first. Read back, a","type":"text"},{"text":" ","type":"text"},{"text":"record is as it was dropped: its ","type":"text"},{"code":"EventRecord.id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"EventRecord.isRedelivered","type":"codeVoice"},{"text":", sensitive","type":"text"},{"text":" ","type":"text"},{"text":"values and context, which the delivery keeps meanwhile. The delivery keeps track of at","type":"text"},{"text":" ","type":"text"},{"text":"most ten times ","type":"text"},{"code":"batchBufferLimit","type":"codeVoice"},{"text":" dropped batches per destination; past that it forgets","type":"text"},{"text":" ","type":"text"},{"text":"the oldest, whose records stay in the store for the next launch, and logs it. Once the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends, the work completes after every destination has received its last batch,","type":"text"},{"text":" ","type":"text"},{"text":"the ones read back included.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Records a store keeps (those with an ","type":"text"},{"type":"codeVoice","code":"EventRecord.deliveryTag"},{"text":") are reported to it:","type":"text"},{"text":" ","type":"text"},{"text":"before a batch goes to any destination, and again once every destination’s ","type":"text"},{"type":"codeVoice","code":"receive"},{"text":" ","type":"text"},{"text":"has returned for it without being cancelled, when the store may forget them. A record","type":"text"},{"text":" ","type":"text"},{"text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left","type":"text"},{"text":" ","type":"text"},{"text":"with no records isn’t sent. A record that some destination never received, because the","type":"text"},{"text":" ","type":"text"},{"text":"store no longer kept it or couldn’t read it back when the delivery asked, is never","type":"text"},{"text":" ","type":"text"},{"text":"acknowledged, so a store that still keeps it delivers it on the next launch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records the delivery has read but not delivered are lost to this run when it is cancelled"},{"type":"text","text":" "},{"type":"text","text":"or fails. Without a store they are gone; a store never had them acknowledged, so it"},{"type":"text","text":" "},{"type":"text","text":"delivers them on the next launch (unless its bound drops them first, which it reports)."}],"type":"paragraph"},{"inlineContent":[{"text":"Nothing runs until the work is executed, and each execution reads the sequence again, so","type":"text"},{"text":" ","type":"text"},{"text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops","type":"text"},{"text":" ","type":"text"},{"text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of","type":"text"},{"text":" ","type":"text"},{"text":"work: executing a cancelled delivery again throws ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" at once, so build a","type":"text"},{"text":" ","type":"text"},{"text":"new one instead.","type":"text"}],"type":"paragraph"},{"name":"Throws","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","isActive":true},{"type":"text","text":" when "},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" is below 1."}],"type":"paragraph"}]}],"kind":"content"}],"kind":"symbol","metadata":{"role":"symbol","modules":[{"relatedModules":["_Concurrency"],"name":"Destinations"}],"roleHeading":"Instance Method","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"[EventRecord]","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Self","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":".","type":"text"}]},"title":"deliver(to:batchBufferLimit:)","extendedModule":"_Concurrency","symbolKind":"method","externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimitAA8DeliveryVAA11Destination_pd_SitAA012InvalidBatchjK0VYKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"InvalidBatchBufferLimit","preciseIdentifier":"s:12Destinations23InvalidBatchBufferLimitV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Delivery","preciseIdentifier":"s:12Destinations8DeliveryV","kind":"typeIdentifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L59","fileName":"Deliver.swift"}},"seeAlsoSections":[{"title":"Delivering","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:)","doc:\/\/Destinations\/documentation\/Destinations\/Delivery","doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"],"anchor":"Delivering","generated":true}],"references":{"doc://Destinations/documentation/Destinations/InvalidBatchBufferLimit":{"abstract":[{"text":"The error ","type":"text"},{"type":"codeVoice","code":"deliver(to:batchBufferLimit:)"},{"text":" throws for a batch buffer limit below 1.","type":"text"}],"url":"\/documentation\/destinations\/invalidbatchbufferlimit","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InvalidBatchBufferLimit"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","type":"topic","kind":"symbol","title":"InvalidBatchBufferLimit","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"InvalidBatchBufferLimit"}]},"doc://Destinations/documentation/Destinations":{"type":"topic","title":"Destinations","role":"collection","kind":"symbol","url":"\/documentation\/destinations","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"type":"codeVoice","code":"Destination"},{"text":" protocol, the modifiers that narrow what a desti