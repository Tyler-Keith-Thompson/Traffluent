{"metadata":{"modules":[{"name":"Destinations"}],"externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF","role":"symbol","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"}],"roleHeading":"Instance Method","remoteSource":{"fileName":"Enriched.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34"},"extendedModule":"Destinations","title":"enriched(by:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":" "},{"kind":"internalParam","text":"enricher"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"},{"kind":"text","text":"\n"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"enricher","content":[{"inlineContent":[{"text":"What each record this destination receives adds to its context.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A destination that hands this one each batch with its records enriched."}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"codeListing","syntax":"swift","code":["let delivery = tracker.records.batch().deliver(","    to: ownBackend.enriched(by: Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"]},{"type":"paragraph","inlineContent":[{"text":"The enricher runs on each record of a batch as the delivery hands the batch to this","type":"text"},{"text":" ","type":"text"},{"text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:","type":"text"},{"text":" ","type":"text"},{"text":"the others are handed the same records without it. It runs on every record the destination","type":"text"},{"text":" ","type":"text"},{"text":"receives, records a store recovered from an earlier run included, and reads any value it","type":"text"},{"text":" ","type":"text"},{"text":"computes at delivery rather than when the event was tracked. So it suits values about the","type":"text"},{"text":" ","type":"text"},{"text":"destination or the delivery, such as a region or a deployment tag, rather than about the","type":"text"},{"text":" ","type":"text"},{"text":"event: a recovered record would get this run’s app version and the network at upload time.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like the other modifiers, the one applied last sees each record first: in"},{"type":"text","text":" "},{"type":"codeVoice","code":"destination.enriched(by: first).enriched(by: second)"},{"type":"text","text":", "},{"type":"codeVoice","code":"second"},{"type":"text","text":" runs, then "},{"type":"codeVoice","code":"first"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"sees what "},{"type":"codeVoice","code":"second"},{"type":"text","text":" set and has the last word on a key both set."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records the enricher adds before a record, as "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":" adds "},{"code":"SessionStarted","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"SessionEnded","type":"codeVoice"},{"type":"text","text":", are left out: they would reach the destination without passing the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as"},{"type":"text","text":" "},{"type":"text","text":"it is called. Give that kind of enricher to the tracker instead."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") enricher calls for a batch of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" records."}]}]}]}],"sections":[],"abstract":[{"text":"This destination, receiving each record with its context changed by ","type":"text"},{"code":"enricher","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/Destination"]]},"variants":[{"paths":["\/documentation\/destinations\/destination\/enriched(by:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)"},"kind":"symbol","references":{"doc://Destinations/documentation/Destinations":{"role":"collection","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}],"type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations","url":"\/documentation\/destinations","title":"Destinations","kind":"symbol"},"doc://Destinations/documentation/Destinations/Destination/enriched(by:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events8EnricherV","text":"Enricher","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination","kind":"typeIdentifier"}],"kind":"symbol","title":"enriched(by:)","abstract":[{"text":"This destination, receiving each record with its context changed by ","type":"text"},{"code":"enricher","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","url":"\/documentation\/destinations\/destination\/enriched(by:)","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","type":"topic"},"doc://Destinations/documentation/Destinations/Destination":{"kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","title":"Destination","url":"\/documentation\/destinations\/destination","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"role":"symbol","abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}]},"doc://Events/documentation/Events/Enricher":{"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Enricher","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","url":"\/documentation\/events\/enricher","title":"Enricher","navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}]}}}