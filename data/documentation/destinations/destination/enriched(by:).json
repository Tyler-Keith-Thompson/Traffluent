{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":" "},{"kind":"internalParam","text":"enricher"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"},{"kind":"text","text":"\n"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"enricher","content":[{"inlineContent":[{"text":"What each record this destination receives adds to its context.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"A destination that hands this one each batch with its records enriched."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"code":["let delivery = tracker.records.batch().deliver(","    to: ownBackend.enriched(by: Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The enricher runs on each record of a batch as the delivery hands the batch to this"},{"type":"text","text":" "},{"type":"text","text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:"},{"type":"text","text":" "},{"type":"text","text":"the others are handed the same records without it. It runs on every record the destination"},{"type":"text","text":" "},{"type":"text","text":"receives, records a store recovered from an earlier run included, and reads any value it"},{"type":"text","text":" "},{"type":"text","text":"computes at delivery rather than when the event was tracked. So it suits values about the"},{"type":"text","text":" "},{"type":"text","text":"destination or the delivery, such as a region or a deployment tag, rather than about the"},{"type":"text","text":" "},{"type":"text","text":"event: a recovered record would get this run’s app version and the network at upload time."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Like the other modifiers, the one applied last sees each record first: in"},{"type":"text","text":" "},{"type":"codeVoice","code":"destination.enriched(by: first).enriched(by: second)"},{"type":"text","text":", "},{"type":"codeVoice","code":"second"},{"type":"text","text":" runs, then "},{"type":"codeVoice","code":"first"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"sees what "},{"type":"codeVoice","code":"second"},{"type":"text","text":" set and has the last word on a key both set."}],"type":"paragraph"},{"inlineContent":[{"text":"Records the enricher adds before a record, as ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":" adds ","type":"text"},{"type":"codeVoice","code":"SessionStarted"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"SessionEnded"},{"text":", are left out: they would reach the destination without passing the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as","type":"text"},{"text":" ","type":"text"},{"text":"it is called. Give that kind of enricher to the tracker instead.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") enricher calls for a batch of ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" records.","type":"text"}],"type":"paragraph"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/destination\/enriched(by:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/Destination"]]},"metadata":{"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Enricher","preciseIdentifier":"s:6Events8EnricherV"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP"}],"externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF","remoteSource":{"fileName":"Enriched.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34"},"symbolKind":"method","modules":[{"name":"Destinations"}],"role":"symbol","extendedModule":"Destinations","title":"enriched(by:)"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"This destination, receiving each record with its context changed by ","type":"text"},{"code":"enricher","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","references":{"doc://Destinations/documentation/Destinations/Destination":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"url":"\/documentation\/destinations\/destination","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Destination"}],"title":"Destination","kind":"symbol","abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","role":"symbol"},"doc://Destinations/documentation/Destinations/Destination/enriched(by:)":{"title":"enriched(by:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Enricher","preciseIdentifier":"s:6Events8EnricherV"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP"}],"url":"\/documentation\/destinations\/destination\/enriched(by:)","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","role":"symbol","abstract":[{"type":"text","text":"This destination, receiving each record with its context changed by "},{"type":"codeVoice","code":"enricher"},{"type":"text","text":"."}],"type":"topic","kind":"symbol"},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","type":"topic","title":"Destinations","kind":"symbol","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection"},"doc://Events/documentation/Events/Enricher":{"type":"topic","title":"Enricher","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Enricher","kind":"identifier"}],"url":"\/documentation\/events\/enricher","abstract":[{"text":"Adds to the context of each event a tracker tracks, before the record is delivered.","type":"text"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"role":"symbol","kind":"symbol"}}}