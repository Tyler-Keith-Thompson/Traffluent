{"abstract":[{"text":"This destination, receiving each record with its context changed by ","type":"text"},{"code":"enricher","type":"codeVoice"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/Destination"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"symbolKind":"method","modules":[{"name":"Destinations"}],"externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF","roleHeading":"Instance Method","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Enricher","preciseIdentifier":"s:6Events8EnricherV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier"}],"title":"enriched(by:)","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34","fileName":"Enriched.swift"},"extendedModule":"Destinations"},"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/destinations\/destination\/enriched(by:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":" "},{"kind":"internalParam","text":"enricher"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","text":"Enricher","preciseIdentifier":"s:6Events8EnricherV"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP"},{"kind":"text","text":"\n"}]}]},{"kind":"parameters","parameters":[{"name":"enricher","content":[{"inlineContent":[{"type":"text","text":"What each record this destination receives adds to its context."}],"type":"paragraph"}]}]},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"inlineContent":[{"type":"text","text":"A destination that hands this one each batch with its records enriched."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"code":["let delivery = tracker.records.batch().deliver(","    to: ownBackend.enriched(by: Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The enricher runs on each record of a batch as the delivery hands the batch to this","type":"text"},{"text":" ","type":"text"},{"text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:","type":"text"},{"text":" ","type":"text"},{"text":"the others are handed the same records without it. It runs on every record the destination","type":"text"},{"text":" ","type":"text"},{"text":"receives, records a store recovered from an earlier run included, and reads any value it","type":"text"},{"text":" ","type":"text"},{"text":"computes at delivery rather than when the event was tracked. So it suits values about the","type":"text"},{"text":" ","type":"text"},{"text":"destination or the delivery, such as a region or a deployment tag, rather than about the","type":"text"},{"text":" ","type":"text"},{"text":"event: a recovered record would get this run’s app version and the network at upload time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Like the other modifiers, the one applied last sees each record first: in","type":"text"},{"text":" ","type":"text"},{"code":"destination.enriched(by: first).enriched(by: second)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"second","type":"codeVoice"},{"text":" runs, then ","type":"text"},{"code":"first","type":"codeVoice"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"sees what ","type":"text"},{"code":"second","type":"codeVoice"},{"text":" set and has the last word on a key both set.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records the enricher adds before a record, as "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":" adds "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"SessionEnded"},{"type":"text","text":", are left out: they would reach the destination without passing the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as"},{"type":"text","text":" "},{"type":"text","text":"it is called. Give that kind of enricher to the tracker instead."}],"type":"paragraph"},{"name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") enricher calls for a batch of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" records."}],"type":"paragraph"}],"style":"note","type":"aside"}],"kind":"content"}],"kind":"symbol","sections":[],"references":{"doc://Destinations/documentation/Destinations/Destination/enriched(by:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events8EnricherV","text":"Enricher","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","role":"symbol","title":"enriched(by:)","abstract":[{"type":"text","text":"This destination, receiving each record with its context changed by "},{"type":"codeVoice","code":"enricher"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/destinations\/destination\/enriched(by:)"},"doc://Destinations/documentation/Destinations":{"abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations","role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/destinations","title":"Destinations"},"doc://Destinations/documentation/Destinations/Destination":{"type":"topic","url":"\/documentation\/destinations\/destination","title":"Destination","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"doc://Events/documentation/Events/Enricher":{"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Enricher"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","navigatorTitle":[{"kind":"identifier","text":"Enricher"}],"kind":"symbol","url":"\/documentation\/events\/enricher","title":"Enricher","role":"symbol"}}}