ier","text":"Enricher"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Enricher"}],"abstract":[{"text":"Adds to the context of each event a tracker tracks, before the record is delivered.","type":"text"}]}}}