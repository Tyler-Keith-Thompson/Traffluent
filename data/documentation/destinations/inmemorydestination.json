{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations"]]},"metadata":{"remoteSource":{"fileName":"InMemoryDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/InMemoryDestination.swift#L27"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InMemoryDestination","kind":"identifier"}],"externalID":"s:12Destinations19InMemoryDestinationV","title":"InMemoryDestination","roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"InMemoryDestination"}],"role":"symbol","modules":[{"name":"Destinations"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"A destination that keeps the newest records it receives, in memory, for the app to read."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/inmemorydestination"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InMemoryDestination"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"Deliver to it beside the destinations that send events away, then read what arrived: an","type":"text"},{"text":" ","type":"text"},{"text":"in-app event inspector or debug drawer listing what was just tracked, a recent-activity view,","type":"text"},{"text":" ","type":"text"},{"text":"a SwiftUI preview fed sample events, or a test checking what its code tracked.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let destination = InMemoryDestination(capacity: 500)","let tracker = Tracker()","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await tracker.records.batch().deliver(to: destination).execute()","destination.events(of