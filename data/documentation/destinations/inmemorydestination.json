eview fed sample events, or a test checking what its code tracked.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let destination = InMemoryDestination(capacity: 500)","let tracker = Tracker()","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await tracker.records.batch().deliver(to: destination).execute()","destination.events(of: SignedUp.self)  \/\/ [SignedUp(plan: \"pro\")]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"It keeps at most "},{"code":"capacity","type":"codeVoice"},{"type":"text","text":" records, across batches: once a batch takes it past that, the"},{"type":"text","text":" "},{"type":"text","text":"oldest records are dropped until the newest "},{"code":"capacity","type":"codeVoice"},{"type":"text","text":" remain. A batch some of whose records"},{"type":"text","text":" "},{"type":"text","text":"were dropped is kept with the newest of them, so "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/batches"},{"type":"text","text":" always holds "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/records"},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"text","text":"order. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/unbounded()"},{"type":"text","text":" keeps everything, for a run whose length the caller controls."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Copies share what they keep: the copy the delivery holds and the one the app reads are the"},{"type":"text","text":" "},{"type":"text","text":"same log. Reading is safe from any thread while batches arrive."}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/init(capacity: