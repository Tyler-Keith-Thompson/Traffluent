{"abstract":[{"type":"text","text":"A destination that keeps the newest records it receives, in memory, for the app to read."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InMemoryDestination"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"text":"Deliver to it beside the destinations that send events away, then read what arrived: an","type":"text"},{"text":" ","type":"text"},{"text":"in-app event inspector or debug drawer listing what was just tracked, a recent-activity view,","type":"text"},{"text":" ","type":"text"},{"text":"a SwiftUI preview fed sample events, or a test checking what its code tracked.","type":"text"}],"type":"paragraph"},{"code":["let destination = InMemoryDestination(capacity: 500)","let tracker = Tracker()","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await tracker.records.batch().deliver(to: destination).execute()","destination.events(of: SignedUp.self)  \/\/ [SignedUp(plan: \"pro\")]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"It keeps at most "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" records, across batches: once a batch takes it past that, the"},{"type":"text","text":" "},{"type":"text","text":"oldest records are dropped until the newest "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" remain. A batch some of whose records"},{"type":"text","text":" "},{"type":"text","text":"were dropped is kept with the newest of them, so "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/batches","type":"reference","isActive":true},{"type":"text","text":" always holds "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/records","type":"refer