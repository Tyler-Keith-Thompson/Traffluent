{"abstract":[{"type":"text","text":"A destination that keeps the newest records it receives, in memory, for the app to read."}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InMemoryDestination","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Deliver to it beside the destinations that send events away, then read what arrived: an"},{"type":"text","text":" "},{"type":"text","text":"in-app event inspector or debug drawer listing what was just tracked, a recent-activity view,"},{"type":"text","text":" "},{"type":"text","text":"a SwiftUI preview fed sample events, or a test checking what its code tracked."}],"type":"paragraph"},{"syntax":"swift","code":["let destination = try InMemoryDestination(capacity: 500)","let tracker = Tracker()","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await tracker.records.batch().deliver(to: destination).execute()","destination.events(of: SignedUp.self)  \/\/ [SignedUp(plan: \"pro\")]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"It keeps at most "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" records, across batches: once a batch takes it past that, the"},{"type":"text","text":" "},{"type":"text","text":"oldest records are dropped until the newest "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" remain. A batch some of whose records"},{"type":"text","text":" "},{"type":"text","text":"were dropped is kept with the newest of them, so "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/batches","isActive":true},{"type":"text","text":" always holds "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/records","isActive":true},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"text","text":"order. "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/unbounded()","isActive":true},{"type":"text","text":" keeps everything, for a run whose length the caller controls."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Copies share what they keep: the copy the delivery holds and the one the app reads are the"},{"type":"text","text":" "},{"type":"text","text":"same log. Reading is safe from any thread while batches arrive."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations"]]},"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/init()","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/init(capacity:)"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/batches","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/deliveries","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/records"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/events(of:)","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/receive(_:)"]},{"anchor":"Type-Properties","generated":true,"title":"Type Properties","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/defaultCapacity"]},{"anchor":"Type-Methods","generated":true,"title":"Type Methods","identifiers":["doc:\/\/Dest