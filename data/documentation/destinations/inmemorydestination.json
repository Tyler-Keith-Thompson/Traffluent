,{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Deliver to it beside the destinations that send events away, then read what arrived: an","type":"text"},{"text":" ","type":"text"},{"text":"in-app event inspector or debug drawer listing what was just tracked, a recent-activity view,","type":"text"},{"text":" ","type":"text"},{"text":"a SwiftUI preview fed sample events, or a test checking what its code tracked.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let destination = InMemoryDestination(capacity: 500)","let tracker = Tracker()","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await tracker.records.batch().deliver(to: destination).execute()","destination.events(of: SignedUp.self)  \/\/ [SignedUp(plan: \"pro\")]"]},{"type":"paragraph","inlineContent":[{"text":"It keeps at most ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" records, across batches: once a batch takes it past that, the","type":"text"},{"text":" ","type":"text"},{"text":"oldest records are dropped until the newest ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" remain. A batch some of whose records","type":"text"},{"text":" ","type":"text"},{"text":"were dropped is kept with the newest of them, so ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/batches","type":"reference"},{"text":" always holds ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/records","type":"reference"},{"text":", in","type":"text"},{"text":" ","type":"text"},{"text":"order. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/unbounded()","type":"reference"},{"text":" keeps everything, for a run whose length the caller controls.","type":"text"}]},{"type":"paragraph","in