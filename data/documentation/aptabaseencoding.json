{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","type":"reference"},{"text":" makes","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference"},{"text":") for Aptabase in one call. It checks your app","type":"text"},{"text":" ","type":"text"},{"text":"key and takes the region from it: an ","type":"text"},{"type":"codeVoice","code":"A-EU-"},{"text":" key posts to ","type":"text"},{"type":"codeVoice","code":"https:\/\/eu.aptabase.com\/api\/v0\/events"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"A-US-"},{"text":" key to ","type":"text"},{"type":"codeVoice","code":"https:\/\/us.aptabase.com\/api\/v0\/events"},{"text":", and a self-hosted ","type":"text"},{"type":"codeVoice","code":"A-SH-"},{"text":" key to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\/api\/v0\/events"},{"text":" under the ","type":"text"},{"type":"codeVoice","code":"host"},{"text":" you pass. The key goes in each request’s ","type":"text"},{"type":"codeVoice","code":"App-Key"},{"text":" header field,","type":"text"},{"text":" ","type":"text"},{"text":"and an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","type":"reference"},{"text":" writes the body. Each batch is split to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","type":"reference"},{"text":": 25 events a request, the most Aptabase takes, and 1,000,000","type":"text"},{"text":" ","type":"text"},{"text":"bytes a request, the encoder’s own bound, under the 1 MiB that nginx takes by default in front of","type":"text"},{"text":" ","type":"text"},{"text":"many self-hosted servers. A batch with no record the encoder can write, an empty one included,","type":"text"},{"text":" ","type":"text"},{"text":"makes no request. The destination retries no response, a 5xx, 408 and 429, and also 418, which","type":"text"},{"text":" ","type":"text"},{"text":"Aptabase answers when a request’s body arrives slower than 60 bytes a second after a 10-second","type":"text"},{"text":" ","type":"text"},{"text":"grace period, as over a poor connection (","type":"text"},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses","type":"reference"},{"text":"). It drops and","type":"text"},{"text":" ","type":"text"},{"text":"reports any other status. No trace context is sent. ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves this module out, so import","type":"text"},{"text":" ","type":"text"},{"text":"it on its own.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"What Aptabase does with these events depends on more than the events themselves:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Aptabase counts users itself. Its server hashes each request’s IP address and "},{"type":"codeVoice","code":"User-Agent"},{"type":"text","text":" "},{"type":"text","text":"header field with a salt it changes every day, so a user is one network address and client on"},{"type":"text","text":" "},{"type":"text","text":"one day. The destination sends no user or device identifier; it can’t keep the server from"},{"type":"text","text":" "},{"type":"text","text":"seeing the address a request comes from."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Aptabase looks up each request’s IP address and stores its country and region with every event"},{"type":"text","text":" "},{"type":"text","text":"in the request, so its dashboard breaks counts down by where the requests came from."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its sessions are the sessions enricher’s. A record with no session, from a tracker without the"},{"type":"text","text":" "},{"type":"text","text":"enricher, counts as a session of one event. A record a store recovered after a relaunch keeps"},{"type":"text","text":" "},{"type":"text","text":"its session."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Its breakdowns by operating system, app version, build, device model and locale come from the"},{"type":"text","text":" "},{"type":"text","text":"standard context. Give the tracker the standard context enrichers, or those breakdowns are"},{"type":"text","text":" "},{"type":"text","text":"empty. A recovered record keeps only the session of its context, so it shows none of them."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"isDebug","type":"codeVoice"},{"type":"text","text":" decides where events go. Aptabase shows events marked as debug events only in its"},{"type":"text","text":" "},{"type":"text","text":"Debug mode, apart from your users’ events, and keeps them for months rather than years."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Aptabase requires an "},{"type":"codeVoice","code":"sdkVersion"},{"type":"text","text":" with every event, and keeps it, but its events dashboard"},{"type":"text","text":" "},{"type":"text","text":"doesn’t show it. The destination always sends "},{"type":"codeVoice","code":"Traffluent"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The app key is public, as Aptabase’s own SDKs ship it inside every app, and the events API takes","type":"text"},{"text":" ","type":"text"},{"text":"no other credential, so the destination builds on every platform and an app sends to Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"directly.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import AptabaseEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let aptabase = try HTTPDestination.aptabase(","    appKey: appKey,  \/\/ from the app's Instructions page: A-EU-…, A-US-… or A-SH-…","    isDebug: false,  \/\/ true for builds whose events only Debug mode should show","    plan: plan)","let tracker = Tracker(enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale()])","let delivery = tracker.records.batch().deliver(to: aptabase)"]},{"inlineContent":[{"text":"For a self-hosted server, pass the URL it is reached at as ","type":"text"},{"code":"host","type":"codeVoice"},{"text":", such as","type":"text"},{"text":" ","type":"text"},{"code":"https:\/\/aptabase.example.com","type":"codeVoice"},{"text":", with a path where it is served under one; the destination appends","type":"text"},{"text":" ","type":"text"},{"code":"\/api\/v0\/events","type":"codeVoice"},{"text":". A host must be ","type":"text"},{"code":"https","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The factory throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError"},{"type":"text","text":": for a key that is empty or only whitespace; for one"},{"type":"text","text":" "},{"type":"text","text":"that isn’t "},{"type":"codeVoice","code":"A-"},{"type":"text","text":", a region, "},{"type":"codeVoice","code":"-"},{"type":"text","text":" and a body of ASCII letters and digits; for a region other than"},{"type":"text","text":" "},{"type":"codeVoice","code":"EU"},{"type":"text","text":", "},{"type":"codeVoice","code":"US"},{"type":"text","text":", "},{"type":"codeVoice","code":"SH"},{"type":"text","text":" and "},{"type":"codeVoice","code":"DEV"},{"type":"text","text":", in capitals; for a self-hosted key without a host, or a cloud key with"},{"type":"text","text":" "},{"type":"text","text":"one; and for a host that isn’t a plain "},{"type":"codeVoice","code":"https"},{"type":"text","text":" URL, or that already ends in the endpoint. A key of"},{"type":"text","text":" "},{"type":"text","text":"a server run in development ("},{"type":"codeVoice","code":"A-DEV-"},{"type":"text","text":") is taken as a self-hosted one, so it needs the"},{"type":"text","text":" "},{"type":"text","text":"development server’s "},{"type":"codeVoice","code":"https"},{"type":"text","text":" URL as "},{"type":"codeVoice","code":"host"},{"type":"text","text":": Aptabase’s SDKs default to "},{"type":"codeVoice","code":"http:\/\/localhost:3000"},{"type":"text","text":" "},{"type":"text","text":"for such a key, which the factory refuses, so serve the development server over TLS. "},{"type":"codeVoice","code":"isDebug"},{"type":"text","text":" has no default:"},{"type":"text","text":" "},{"type":"text","text":"pass "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for builds whose events only Debug mode should show, such as debug builds."}],"type":"paragraph"},{"anchor":"Sessions","text":"Sessions","level":3,"type":"heading"},{"inlineContent":[{"text":"Each event’s ","type":"text"},{"code":"sessionId","type":"codeVoice"},{"text":" is the record’s session, from the sessions enricher: its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"text":"a lowercase UUID. Nothing else identifies a record: no vendor identifier, device identifier or","type":"text"},{"text":" ","type":"text"},{"text":"account, and no trace context. A record with no session has its own identifier as its","type":"text"},{"text":" ","type":"text"},{"code":"sessionId","type":"codeVoice"},{"text":": making up a session would join unrelated records, skipping the record would lose it,","type":"text"},{"text":" ","type":"text"},{"text":"and Aptabase takes no event without a session.","type":"text"}],"type":"paragraph"},{"anchor":"What-Aptabase-receives","text":"What Aptabase receives","level":3,"type":"heading"},{"inlineContent":[{"text":"Each request is a JSON array of events. Every event has:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"eventName"},{"text":", the event’s name;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sessionId"},{"text":", the session;","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"timestamp","type":"codeVoice"},{"text":", the record’s timestamp in ISO 8601 with milliseconds, so an event sent late still","type":"text"},{"text":" ","type":"text"},{"text":"counts at the time it was tracked;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"systemProps","type":"codeVoice"},{"text":": ","type":"text"},{"code":"osName","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"osVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"appVersion","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"appBuildNumber","type":"codeVoice"},{"text":", ","type":"text"},{"code":"deviceModel","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"locale","type":"codeVoice"},{"text":", the locale’s language and region (","type":"text"},{"code":"en-US","type":"codeVoice"},{"text":"), each when the record’s context has it;","type":"text"},{"text":" ","type":"text"},{"code":"isDebug","type":"codeVoice"},{"text":", as you pass it; and ","type":"text"},{"code":"sdkVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Traffluent","type":"codeVoice"},{"text":". A context value longer than","type":"text"},{"text":" ","type":"text"},{"text":"Aptabase takes (30 characters of the system’s name, 100 of its version, 50 of the app’s","type":"text"},{"text":" ","type":"text"},{"text":"version, 20 of its build and 100 of the device’s model) is left out and the event is sent","type":"text"},{"text":" ","type":"text"},{"text":"without it, as Aptabase would refuse the whole request. A long build number such as","type":"text"},{"text":" ","type":"text"},{"code":"2026.11.27.1432-abc1234","type":"codeVoice"},{"text":" is left out of every event the build sends, so its breakdown is empty.","type":"text"},{"text":" ","type":"text"},{"text":"The encoder logs a notice the first time it leaves out each one;","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"props","type":"codeVoice"},{"text":", when the event has any to send.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The record’s properties are read through the event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is","type":"text"},{"text":" ","type":"text"},{"text":"made with. Aptabase keeps strings, numbers and booleans, and only a placeholder for an object or","type":"text"},{"text":" ","type":"text"},{"text":"an array, so an object or array is flattened into dotted names: a ","type":"text"},{"code":"cart","type":"codeVoice"},{"text":" holding ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"cart.size","type":"codeVoice"},{"text":", and the first element of ","type":"text"},{"code":"tags","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"tags.0","type":"codeVoice"},{"text":". A boolean stays a boolean, which Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"stores as ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":"; a number keeps its JSON type; and a ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" property is left out. A","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is never sent, whatever the record reveals.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Aptabase stores a number as a .NET ","type":"text"},{"code":"decimal","type":"codeVoice"},{"text":", so it keeps 28 decimal places and rounds a smaller","type":"text"},{"text":" ","type":"text"},{"text":"fraction away.","type":"text"}],"type":"paragraph"},{"anchor":"Records-left-out","text":"Records left out","level":3,"type":"heading"},{"inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"one the plan doesn’t describe, whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", or that holds a value JSON can’t;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose event name is only whitespace or longer than the 60 characters Aptabase takes, as"},{"type":"text","text":" "},{"type":"text","text":"Aptabase refuses the whole request holding one;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one with a property, once flattened, whose name is empty, only whitespace or longer than 40"},{"type":"text","text":" "},{"type":"text","text":"characters, which Aptabase would drop;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"one with a string value longer than 180 characters, which Aptabase would cut short;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"one with a number of magnitude 2⁹⁶ (about 7.9 × 10²⁸) or more, past a "},{"type":"codeVoice","code":"decimal"},{"type":"text","text":", for which"},{"type":"text","text":" "},{"type":"text","text":"Aptabase fails the whole request;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose values flatten to the same name twice;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose timestamp falls outside the years 1 to 9999;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one tracked more than 23 hours before its batch is encoded, as Aptabase drops an event more than","type":"text"},{"text":" ","type":"text"},{"text":"a day old while answering 200, the hour to spare for a queue on the server and clocks that","type":"text"},{"text":" ","type":"text"},{"text":"disagree;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one too large for a request of 1,000,000 bytes on its own."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Characters are counted in UTF-16, as .NET counts them, so an emoji counts two. The destination"},{"type":"text","text":" "},{"type":"text","text":"reports each record left out as "},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"type":"text","text":", a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" whose reason is an"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError","type":"reference"},{"type":"text","text":". When the destination is made, it logs a notice for each event and"},{"type":"text","text":" "},{"type":"text","text":"property of the plan whose name would be left out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A request is encoded once and retried as it is, so each request’s deadline is 23 hours after its"},{"type":"text","text":" "},{"type":"text","text":"oldest record was tracked: one still failing by then, a slow upload’s 418 included, isn’t sent"},{"type":"text","text":" "},{"type":"text","text":"again, which Aptabase would answer with 200 while storing nothing. It is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":". A clock that reads NaN or infinite has"},{"type":"text","text":" "},{"type":"text","text":"every record reported. An event from the future, by a clock that runs ahead, is sent, and Aptabase"},{"type":"text","text":" "},{"type":"text","text":"stores it at the time it arrives."}],"type":"paragraph"},{"inlineContent":[{"text":"The 23 hours are measured by the device’s own clock, but Aptabase measures a day by its server’s.","type":"text"},{"text":" ","type":"text"},{"text":"On a device whose clock runs about a day behind, a record tracked just now carries a timestamp a","type":"text"},{"text":" ","type":"text"},{"text":"day old: the encoder sends it, and Aptabase drops it while answering 200, so the record is lost","type":"text"},{"text":" ","type":"text"},{"text":"without a report.","type":"text"}],"type":"paragraph"},{"anchor":"What-Aptabases-answers-say","text":"What Aptabase’s answers say","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Aptabase answers 200 to a request with a key of no app, of a deleted app, or of an account it has"},{"type":"text","text":" "},{"type":"text","text":"locked, such as one past its plan’s monthly events, and stores nothing. Its body says so,"},{"type":"text","text":" "},{"code":"{\"error\": ...}","type":"codeVoice"},{"type":"text","text":", so the destination drops the request and reports it as"},{"type":"text","text":" "},{"code":"HTTPDropReport.rejectedInBody(status:reason:recordIDs:)","type":"codeVoice"},{"type":"text","text":", with Aptabase’s error as the reason."},{"type":"text","text":" "},{"type":"text","text":"Every request is refused that way until the key is fixed or the account unlocked, so watch the"},{"type":"text","text":" "},{"type":"text","text":"drop reports, and check that the first events reach the app’s Live View after setting the"},{"type":"text","text":" "},{"type":"text","text":"destination up. It doesn’t remove duplicates,"},{"type":"text","text":" "},{"type":"text","text":"so a record sent again, after a retry whose answer was lost or a store’s redelivery, is counted"},{"type":"text","text":" "},{"type":"text","text":"twice."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Aptabase takes 20 requests a second from one IP address, and answers 429 past it, which the"},{"type":"text","text":" "},{"type":"text","text":"destination retries on its backoff."}],"type":"paragraph"},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"text":" ","type":"text"},{"text":"covers what Aptabase receives, and why, in more detail.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"Send records to Aptabase, in its cloud or on your own server, through its events API.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError"],"anchor":"Sending-to-Aptabase","title":"Sending to Aptabase"},{"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"],"anchor":"Encoding-batches","title":"Encoding batches"},{"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError"],"anchor":"Records-left-out","title":"Records left out"}],"kind":"symbol","metadata":{"modules":[{"name":"AptabaseEncoding"}],"title":"AptabaseEncoding","symbolKind":"module","roleHeading":"Framework","role":"collection","externalID":"AptabaseEncoding"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/aptabaseencoding"]}],"references":{"doc://AptabaseEncoding/documentation/AptabaseEncoding/HTTPDestinations/HTTPDestination/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)":{"title":"aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"aptabase"},{"kind":"text","text":"("},{"kind":"externalParam","text":"appKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"host"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"isDebug"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseI