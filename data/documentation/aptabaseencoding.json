{"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError"],"anchor":"Sending-to-Aptabase","title":"Sending to Aptabase"},{"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"],"anchor":"Encoding-batches","title":"Encoding batches"},{"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError"],"anchor":"Records-left-out","title":"Records left out"}],"metadata":{"modules":[{"name":"AptabaseEncoding"}],"roleHeading":"Framework","role":"collection","symbolKind":"module","title":"AptabaseEncoding","externalID":"AptabaseEncoding"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)"},{"text":" makes","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"text":") for Aptabase in one call. It checks your app","type":"text"},{"text":" ","type":"text"},{"text":"key and takes the region from it: an ","type":"text"},{"code":"A-EU-","type":"codeVoice"},{"text":" key posts to ","type":"text"},{"code":"https:\/\/eu.aptabase.com\/api\/v0\/events","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"A-US-","type":"codeVoice"},{"text":" key to ","type":"text"},{"code":"https:\/\/us.aptabase.com\/api\/v0\/events","type":"codeVoice"},{"text":", and a self-hosted ","type":"text"},{"code":"A-SH-","type":"codeVoice"},{"text":" key to","type":"text"},{"text":" ","type":"text"},{"code":"\/api\/v0\/events","type":"codeVoice"},{"text":" under the ","type":"text"},{"code":"host","type":"codeVoice"},{"text":" you pass. The key goes in each request’s ","type":"text"},{"code":"App-Key","type":"codeVoice"},{"text":" header field,","type":"text"},{"text":" ","type":"text"},{"text":"and an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},{"text":" writes the body. Each batch is split to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit"},{"text":": 25 events a request, the most Aptabase takes, and 1,000,000","type":"text"},{"text":" ","type":"text"},{"text":"bytes a request, the encoder’s own bound, under the 1 MiB that nginx takes by default in front of","type":"text"},{"text":" ","type":"text"},{"text":"many self-hosted servers. A batch with no record the encoder can write, an empty one included,","type":"text"},{"text":" ","type":"text"},{"text":"makes no request. The destination retries no response, a 5xx, 408 and 429, and also 418, which","type":"text"},{"text":" ","type":"text"},{"text":"Aptabase answers when a request’s body arrives slower than 60 bytes a second after a 10-second","type":"text"},{"text":" ","type":"text"},{"text":"grace period, as over a poor connection (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses"},{"text":"). It drops and","type":"text"},{"text":" ","type":"text"},{"text":"reports any other status. No trace context is sent. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves this module out, so import","type":"text"},{"text":" ","type":"text"},{"text":"it on its own.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What Aptabase does with these events depends on more than the events themselves:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Aptabase counts users itself. Its server hashes each request’s IP address and "},{"type":"codeVoice","code":"User-Agent"},{"type":"text","text":" "},{"type":"text","text":"header field with a salt it changes every day, so a user is one network address and client on"},{"type":"text","text":" "},{"type":"text","text":"one day. The destination sends no user or device identifier; it can’t keep the server from"},{"type":"text","text":" "},{"type":"text","text":"seeing the address a request comes from."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Aptabase looks up each request’s IP address and stores its country and region with every event"},{"type":"text","text":" "},{"type":"text","text":"in the request, so its dashboard breaks counts down by where the requests came from."}]}]},{"content":[{"inlineContent":[{"text":"Its sessions are the sessions enricher’s. A record with no session, from a tracker without the","type":"text"},{"text":" ","type":"text"},{"text":"enricher, counts as a session of one event. A record a store recovered after a relaunch keeps","type":"text"},{"text":" ","type":"text"},{"text":"its session.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its breakdowns by operating system, app version, build, device model and locale come from the"},{"type":"text","text":" "},{"type":"text","text":"standard context. Give the tracker the standard context enrichers, or those breakdowns are"},{"type":"text","text":" "},{"type":"text","text":"empty. A store keeps the standard context beside each record, so a record recovered after a"},{"type":"text","text":" "},{"type":"text","text":"relaunch is broken down by the app version, system and device it was tracked on."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isDebug"},{"type":"text","text":" decides where events go. Aptabase shows events marked as debug events only in its"},{"type":"text","text":" "},{"type":"text","text":"Debug mode, apart from your users’ events, and keeps them for months rather than years."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Aptabase requires an ","type":"text"},{"code":"sdkVersion","type":"codeVoice"},{"text":" with every event, and keeps it, but its events dashboard","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t show it. The destination always sends ","type":"text"},{"code":"Traffluent","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The app key is public, as Aptabase’s own SDKs ship it inside every app, and the events API takes"},{"type":"text","text":" "},{"type":"text","text":"no other credential, so the destination builds on every platform and an app sends to Aptabase"},{"type":"text","text":" "},{"type":"text","text":"directly."}],"type":"paragraph"},{"syntax":"swift","code":["import AptabaseEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let aptabase = try HTTPDestination.aptabase(","    appKey: appKey,  \/\/ from the app's Instructions page: A-EU-…, A-US-… or A-SH-…","    isDebug: false,  \/\/ true for builds whose events only Debug mode should show","    plan: plan)","let tracker = Tracker(enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale()])","let delivery = tracker.records.batch().deliver(to: aptabase)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"For a self-hosted server, pass the URL it is reached at as "},{"type":"codeVoice","code":"host"},{"type":"text","text":", such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/aptabase.example.com"},{"type":"text","text":", with a path where it is served under one; the destination appends"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/api\/v0\/events"},{"type":"text","text":". A host must be "},{"type":"codeVoice","code":"https"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The factory throws "},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError","isActive":true},{"type":"text","text":": for a key that is empty or only whitespace; for one"},{"type":"text","text":" "},{"type":"text","text":"that isn’t "},{"type":"codeVoice","code":"A-"},{"type":"text","text":", a region, "},{"type":"codeVoice","code":"-"},{"type":"text","text":" and a body of ASCII letters and digits; for a region other than"},{"type":"text","text":" "},{"type":"codeVoice","code":"EU"},{"type":"text","text":", "},{"type":"codeVoice","code":"US"},{"type":"text","text":", "},{"type":"codeVoice","code":"SH"},{"type":"text","text":" and "},{"type":"codeVoice","code":"DEV"},{"type":"text","text":", in capitals; for a self-hosted key without a host, or a cloud key with"},{"type":"text","text":" "},{"type":"text","text":"one; and for a host that isn’t a plain "},{"type":"codeVoice","code":"https"},{"type":"text","text":" URL, or that already ends in the endpoint. A key of"},{"type":"text","text":" "},{"type":"text","text":"a server run in development ("},{"type":"codeVoice","code":"A-DEV-"},{"type":"text","text":") is taken as a self-hosted one, so it needs the"},{"type":"text","text":" "},{"type":"text","text":"development server’s "},{"type":"codeVoice","code":"https"},{"type":"text","text":" URL as "},{"type":"codeVoice","code":"host"},{"type":"text","text":": Aptabase’s SDKs default to "},{"type":"codeVoice","code":"http:\/\/localhost:3000"},{"type":"text","text":" "},{"type":"text","text":"for such a key, which the factory refuses, so serve the development server over TLS. "},{"type":"codeVoice","code":"isDebug"},{"type":"text","text":" has no default:"},{"type":"text","text":" "},{"type":"text","text":"pass "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for builds whose events only Debug mode should show, such as debug builds."}],"type":"paragraph"},{"anchor":"Sessions","level":3,"text":"Sessions","type":"heading"},{"inlineContent":[{"text":"Each event’s ","type":"text"},{"code":"sessionId","type":"codeVoice"},{"text":" is the record’s session, from the sessions enricher: its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"text":"a lowercase UUID. Nothing else identifies a record: no vendor identifier, device identifier or","type":"text"},{"text":" ","type":"text"},{"text":"account, and no trace context. A record with no session has its own identifier as its","type":"text"},{"text":" ","type":"text"},{"code":"sessionId","type":"codeVoice"},{"text":": making up a session would join unrelated records, skipping the record would lose it,","type":"text"},{"text":" ","type":"text"},{"text":"and Aptabase takes no event without a session.","type":"text"}],"type":"paragraph"},{"anchor":"What-Aptabase-receives","level":3,"text":"What Aptabase receives","type":"heading"},{"inlineContent":[{"type":"text","text":"Each request is a JSON array of events. Every event has:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"eventName","type":"codeVoice"},{"text":", the event’s name;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sessionId"},{"type":"text","text":", the session;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"},{"type":"text","text":", the record’s timestamp in ISO 8601 with milliseconds, so an event sent late still"},{"type":"text","text":" "},{"type":"text","text":"counts at the time it was tracked;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"systemProps"},{"type":"text","text":": "},{"type":"codeVoice","code":"osName"},{"type":"text","text":" and "},{"type":"codeVoice","code":"osVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"appVersion"},{"type":"text","text":" and "},{"type":"codeVoice","code":"appBuildNumber"},{"type":"text","text":", "},{"type":"codeVoice","code":"deviceModel"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"locale"},{"type":"text","text":", the locale’s language and region ("},{"type":"codeVoice","code":"en-US"},{"type":"text","text":"), each when the record’s context has it;"},{"type":"text","text":" "},{"type":"codeVoice","code":"isDebug"},{"type":"text","text":", as you pass it; and "},{"type":"codeVoice","code":"sdkVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"Traffluent"},{"type":"text","text":". A context value longer than"},{"type":"text","text":" "},{"type":"text","text":"Aptabase takes (30 characters of the system’s name, 100 of its version, 50 of the app’s"},{"type":"text","text":" "},{"type":"text","text":"version, 20 of its build and 100 of the device’s model) is left out and the event is sent"},{"type":"text","text":" "},{"type":"text","text":"without it, as Aptabase would refuse the whole request. A long build number such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"2026.11.27.1432-abc1234"},{"type":"text","text":" is left out of every event the build sends, so its breakdown is empty."},{"type":"text","text":" "},{"type":"text","text":"The encoder logs a notice the first time it leaves out each one;"}]}]},{"content":[{"inlineContent":[{"code":"props","type":"codeVoice"},{"text":", when the event has any to send.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The record’s properties are read through the event’s schema in the "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" the encoder is"},{"type":"text","text":" "},{"type":"text","text":"made with. Aptabase keeps strings, numbers and booleans, and only a placeholder for an object or"},{"type":"text","text":" "},{"type":"text","text":"an array, so an object or array is flattened into dotted names: a "},{"code":"cart","type":"codeVoice"},{"type":"text","text":" holding "},{"code":"size","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"cart.size","type":"codeVoice"},{"type":"text","text":", and the first element of "},{"code":"tags","type":"codeVoice"},{"type":"text","text":" is "},{"code":"tags.0","type":"codeVoice"},{"type":"text","text":". A boolean stays a boolean, which Aptabase"},{"type":"text","text":" "},{"type":"text","text":"stores as "},{"code":"true","type":"codeVoice"},{"type":"text","text":" or "},{"code":"false","type":"codeVoice"},{"type":"text","text":"; a number keeps its JSON type; and a "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" property is left out. A"},{"type":"text","text":" "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is never sent, whatever the record reveals."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Aptabase stores a number as a .NET "},{"type":"codeVoice","code":"decimal"},{"type":"text","text":", so it keeps 28 decimal places and rounds a smaller"},{"type":"text","text":" "},{"type":"text","text":"fraction away."}],"type":"paragraph"},{"anchor":"Records-left-out","level":3,"text":"Records left out","type":"heading"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"one the plan doesn’t describe, whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", or that holds a value JSON can’t;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose event name is only whitespace or longer than the 60 characters Aptabase takes, as","type":"text"},{"text":" ","type":"text"},{"text":"Aptabase refuses the whole request holding one;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one with a property, once flattened, whose name is empty, only whitespace or longer than 40","type":"text"},{"text":" ","type":"text"},{"text":"characters, which Aptabase would drop;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one with a string value longer than 180 characters, which Aptabase would cut short;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one with a number of magnitude 2⁹⁶ (about 7.9 × 10²⁸) or more, past a "},{"type":"codeVoice","code":"decimal"},{"type":"text","text":", for which"},{"type":"text","text":" "},{"type":"text","text":"Aptabase fails the whole request;"}]}]},{"content":[{"inlineContent":[{"text":"one whose values flatten to the same name twice;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose timestamp falls outside the years 1 to 9999;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one tracked more than 23 hours before its batch is encoded, as Aptabase drops an event more than"},{"type":"text","text":" "},{"type":"text","text":"a day old while answering 200, the hour to spare for a queue on the server and clocks that"},{"type":"text","text":" "},{"type":"text","text":"disagree;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one too large for a request of 1,000,000 bytes on its own.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Characters are counted in UTF-16, as .NET counts them, so an emoji counts two. The destination"},{"type":"text","text":" "},{"type":"text","text":"reports each record left out as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" whose reason is an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError"},{"type":"text","text":". When the destination is made, it logs a notice for each event and"},{"type":"text","text":" "},{"type":"text","text":"property of the plan whose name would be left out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A request is encoded once and retried as it is, so each request’s deadline is 23 hours after its"},{"type":"text","text":" "},{"type":"text","text":"oldest record was tracked: one still failing by then, a slow upload’s 418 included, isn’t sent"},{"type":"text","text":" "},{"type":"text","text":"again, which Aptabase would answer with 200 while storing nothing. It is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":". A clock that reads NaN or infinite has"},{"type":"text","text":" "},{"type":"text","text":"every record reported. An event from the future, by a clock that runs ahead, is sent, and Aptabase"},{"type":"text","text":" "},{"type":"text","text":"stores it at the time it arrives."}],"type":"paragraph"},{"inlineContent":[{"text":"The 23 hours are measured by the device’s own clock, but Aptabase measures a day by its server’s.","type":"text"},{"text":" ","type":"text"},{"text":"On a device whose clock runs about a day behind, a record tracked just now carries a timestamp a","type":"text"},{"text":" ","type":"text"},{"text":"day old: the encoder sends it, and Aptabase drops it while answering 200, so the record is lost","type":"text"},{"text":" ","type":"text"},{"text":"without a report.","type":"text"}],"type":"paragraph"},{"anchor":"What-Aptabases-answers-say","level":3,"text":"What Aptabase’s answers say","type":"heading"},{"inlineContent":[{"type":"text","text":"Aptabase answers 200 to a request with a key of no app, of a deleted app, or of an account it has"},{"type":"text","text":" "},{"type":"text","text":"locked, such as one past its plan’s monthly events, and stores nothing. Its body says so,"},{"type":"text","text":" "},{"type":"codeVoice","code":"{\"error\": ...}"},{"type":"text","text":", so the destination drops the request and reports it as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.rejectedInBody(status:reason:recordIDs:)"},{"type":"text","text":", with Aptabase’s error as the reason."},{"type":"text","text":" "},{"type":"text","text":"Every request is refused that way until the key is fixed or the account unlocked, so watch the"},{"type":"text","text":" "},{"type":"text","text":"drop reports, and check that the first events reach the app’s Live View after setting the"},{"type":"text","text":" "},{"type":"text","text":"destination up. It doesn’t remove duplicates,"},{"type":"text","text":" "},{"type":"text","text":"so a record sent again, after a retry whose answer was lost or a store’s redelivery, is counted"},{"type":"text","text":" "},{"type":"text","text":"twice."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Aptabase takes 20 requests a second from one IP address, and answers 429 past it, which the"},{"type":"text","text":" "},{"type":"text","text":"destination retries on its backoff."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what Aptabase receives, and why, in more detail."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Send records to Aptabase, in its cloud or on your own server, through its events API.","type":"text"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/aptabaseencoding"]}],"references":{"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/batchLimit":{"abstract":[{"text":"Aptabase’s limits on one request: 25 events, and 1,000,000 bytes of body and of one event.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","title":"batchLimit","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"role":"symbol","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/batchlimit"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseEncodingError":{"title":"AptabaseEncodingError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AptabaseEncodingError"}],"type":"topic","url":"\/documentation\/aptabaseencoding\/aptabaseencodingerror","navigatorTitle":[{"kind":"identifier","text":"AptabaseEncodingError"}],"role":"symbol","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"kind":"symbol","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError"},"doc://AptabaseEncoding/documentation/AptabaseEncoding":{"abstract":[{"type":"text","text":"Send records to Aptabase, in its cloud or on your own server, through its events API."}],"kind":"symbol","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","title":"AptabaseEncoding","type":"topic","role":"collection","url":"\/documentation\/aptabaseencoding"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseSetupError":{"title":"AptabaseSetupError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AptabaseSetupError","kind":"identifier"}],"type":"topic","url":"\/documentation\/aptabaseencoding\/aptabasesetuperror","navigatorTitle":[{"text":"AptabaseSetupError","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"Why "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)"},{"type":"t