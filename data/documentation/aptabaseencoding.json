{"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"anchor":"Sending-to-Aptabase","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError"],"title":"Sending to Aptabase"},{"anchor":"Encoding-batches","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"],"title":"Encoding batches"},{"anchor":"Records-left-out","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError"],"title":"Records left out"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","isActive":true},{"type":"text","text":" makes"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":") for Aptabase in one call. It checks your app"},{"type":"text","text":" "},{"type":"text","text":"key and takes the region from it: an "},{"type":"codeVoice","code":"A-EU-"},{"type":"text","text":" key posts to "},{"type":"codeVoice","code":"https:\/\/eu.aptabase.com\/api\/v0\/events"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"A-US-"},{"type":"text","text":" key to "},{"type":"codeVoice","code":"https:\/\/us.aptabase.com\/api\/v0\/events"},{"type":"text","text":", and a self-hosted "},{"type":"codeVoice","code":"A-SH-"},{"type":"text","text":" key to"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/api\/v0\/events"},{"type":"text","text":" under the "},{"type":"codeVoice","code":"host"},{"type":"text","text":" you pass. The key goes in each request’s "},{"type":"codeVoice","code":"App-Key"},{"type":"text","text":" header field,"},{"type":"text","text":" "},{"type":"text","text":"and an "},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","isActive":true},{"type":"text","text":" writes the body. Each batch is split to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":": 25 events a request, the most Aptabase takes, and 1,000,000"},{"type":"text","text":" "},{"type":"text","text":"bytes a request, the encoder’s own bound, under the 1 MiB that nginx takes by default in front of"},{"type":"text","text":" "},{"type":"text","text":"many self-hosted servers. A batch with no record the encoder can write, an empty one included,"},{"type":"text","text":" "},{"type":"text","text":"makes no request. The destination retries no response, a 5xx, 408 and 429, and also 418, which"},{"type":"text","text":" "},{"type":"text","text":"Aptabase answers when a request’s body arrives slower than 60 bytes a second after a 10-second"},{"type":"text","text":" "},{"type":"text","text":"grace period, as over a poor connection ("},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses","isActive":true},{"type":"text","text":"). It drops and"},{"type":"text","text":" "},{"type":"text","text":"reports any other status. No trace context is sent. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves this module out, so import"},{"type":"text","text":" "},{"type":"text","text":"it on its own."}],"type":"paragraph"},{"inlineContent":[{"text":"What Aptabase does with these events depends on more than the events themselves:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Aptabase counts users itself. Its server hashes each request’s IP address and "},{"type":"codeVoice","code":"User-Agent"},{"type":"text","text":" "},{"type":"text","text":"header field with a salt it changes every day, so a user is one network address and client on"},{"type":"text","text":" "},{"type":"text","text":"one day. The destination sends no user or device identifier; it can’t keep the server from"},{"type":"text","text":" "},{"type":"text","text":"seeing the address a request comes from."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Aptabase looks up each request’s IP address and stores its country and region with every event","type":"text"},{"text":" ","type":"text"},{"text":"in the request, so its dashboard breaks counts down by where the requests came from.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Its sessions are the sessions enricher’s. A record with no session, from a tracker without the"},{"type":"text","text":" "},{"type":"text","text":"enricher, counts as a session of one event. A record a store recovered after a relaunch keeps"},{"type":"text","text":" "},{"type":"text","text":"its session."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its breakdowns by operating system, app version, build, device model and locale come from the"},{"type":"text","text":" "},{"type":"text","text":"standard context. Give the tracker the standard context enrichers, or those breakdowns are"},{"type":"text","text":" "},{"type":"text","text":"empty. A recovered record keeps only the session of its context, so it shows none of them."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"isDebug"},{"text":" decides where events go. Aptabase shows events marked as debug events only in its","type":"text"},{"text":" ","type":"text"},{"text":"Debug mode, apart from your users’ events, and keeps them for months rather than years.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Aptabase requires an ","type":"text"},{"type":"codeVoice","code":"sdkVersion"},{"text":" with every event, and keeps it, but its events dashboard","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t show it. The destination always sends ","type":"text"},{"type":"codeVoice","code":"Traffluent"},{"text":".","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"The app key is public, as Aptabase’s own SDKs ship it inside every app, and the events API takes"},{"type":"text","text":" "},{"type":"text","text":"no other credential, so the destination builds on every platform and an app sends to Aptabase"},{"type":"text","text":" "},{"type":"text","text":"directly."}],"type":"paragraph"},{"type":"codeListing","code":["import AptabaseEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let aptabase = try HTTPDestination.aptabase(","    appKey: appKey,  \/\/ from the app's Instructions page: A-EU-…, A-US-… or A-SH-…","    isDebug: false,  \/\/ true for builds whose events only Debug mode should show","    plan: plan)","let tracker = Tracker(enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale()])","let delivery = tracker.records.batch().deliver(to: aptabase)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"For a self-hosted server, pass the URL it is reached at as "},{"code":"host","type":"codeVoice"},{"type":"text","text":", such as"},{"type":"text","text":" "},{"code":"https:\/\/aptabase.example.com","type":"codeVoice"},{"type":"text","text":", with a path where it is served under one; the destination appends"},{"type":"text","text":" "},{"code":"\/api\/v0\/events","type":"codeVoice"},{"type":"text","text":". A host must be "},{"code":"https","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The factory throws "},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError","type":"reference","isActive":true},{"type":"text","text":": for a key that is empty or only whitespace; for one"},{"type":"text","text":" "},{"type":"text","text":"that isn’t "},{"code":"A-","type":"codeVoice"},{"type":"text","text":", a region, "},{"code":"-","type":"codeVoice"},{"type":"text","text":" and a body of ASCII letters and digits; for a region other than"},{"type":"text","text":" "},{"code":"EU","type":"codeVoice"},{"type":"text","text":", "},{"code":"US","type":"codeVoice"},{"type":"text","text":", "},{"code":"SH","type":"codeVoice"},{"type":"text","text":" and "},{"code":"DEV","type":"codeVoice"},{"type":"text","text":", in capitals; for a self-hosted key without a host, or a cloud key with"},{"type":"text","text":" "},{"type":"text","text":"one; and for a host that isn’t a plain "},{"code":"https","type":"codeVoice"},{"type":"text","text":" URL, or that already ends in the endpoint. A key of"},{"type":"text","text":" "},{"type":"text","text":"a server run in development ("},{"code":"A-DEV-","type":"codeVoice"},{"type":"text","text":") is taken as a self-hosted one, so it needs the"},{"type":"text","text":" "},{"type":"text","text":"development server’s "},{"code":"https","type":"codeVoice"},{"type":"text","text":" URL as "},{"code":"host","type":"codeVoice"},{"type":"text","text":": Aptabase’s SDKs default to "},{"code":"http:\/\/localhost:3000","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"for such a key, which the factory refuses, so serve the development server over TLS. "},{"code":"isDebug","type":"codeVoice"},{"type":"text","text":" has no default:"},{"type":"text","text":" "},{"type":"text","text":"pass "},{"code":"true","type":"codeVoice"},{"type":"text","text":" for builds whose events only Debug mode should show, such as debug builds."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Sessions","text":"Sessions"},{"inlineContent":[{"type":"text","text":"Each event’s "},{"type":"codeVoice","code":"sessionId"},{"type":"text","text":" is the record’s session, from the sessions enricher: its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" as"},{"type":"text","text":" "},{"type":"text","text":"a lowercase UUID. Nothing else identifies a record: no vendor identifier, device identifier or"},{"type":"text","text":" "},{"type":"text","text":"account, and no trace context. A record with no session has its own identifier as its"},{"type":"text","text":" "},{"type":"codeVoice","code":"sessionId"},{"type":"text","text":": making up a session would join unrelated records, skipping the record would lose it,"},{"type":"text","text":" "},{"type":"text","text":"and Aptabase takes no event without a session."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"What-Aptabase-receives","text":"What Aptabase receives"},{"inlineContent":[{"type":"text","text":"Each request is a JSON array of events. Every event has:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"eventName","type":"codeVoice"},{"text":", the event’s name;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"sessionId","type":"codeVoice"},{"text":", the session;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"},{"type":"text","text":", the record’s timestamp in ISO 8601 with milliseconds, so an event sent late still"},{"type":"text","text":" "},{"type":"text","text":"counts at the time it was tracked;"}]}]},{"content":[{"inlineContent":[{"code":"systemProps","type":"codeVoice"},{"type":"text","text":": "},{"code":"osName","type":"codeVoice"},{"type":"text","text":" and "},{"code":"osVersion","type":"codeVoice"},{"type":"text","text":", "},{"code":"appVersion","type":"codeVoice"},{"type":"text","text":" and "},{"code":"appBuildNumber","type":"codeVoice"},{"type":"text","text":", "},{"code":"deviceModel","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"locale","type":"codeVoice"},{"type":"text","text":", the locale’s language and region ("},{"code":"en-US","type":"codeVoice"},{"type":"text","text":"), each when the record’s context has it;"},{"type":"text","text":" "},{"code":"isDebug","type":"codeVoice"},{"type":"text","text":", as you pass it; and "},{"code":"sdkVersion","type":"codeVoice"},{"type":"text","text":", "},{"code":"Traffluent","type":"codeVoice"},{"type":"text","text":". A context value longer than"},{"type":"text","text":" "},{"type":"text","text":"Aptabase takes (30 characters of the system’s name, 100 of its version, 50 of the app’s"},{"type":"text","text":" "},{"type":"text","text":"version, 20 of its build and 100 of the device’s model) is left out and the event is sent"},{"type":"text","text":" "},{"type":"text","text":"without it, as Aptabase would refuse the whole request. A long build number such as"},{"type":"text","text":" "},{"code":"2026.11.27.1432-abc1234","type":"codeVoice"},{"type":"text","text":" is left out of every event the build sends, so its breakdown is empty."},{"type":"text","text":" "},{"type":"text","text":"The encoder logs a notice the first time it leaves out each one;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"props","type":"codeVoice"},{"text":", when the event has any to send.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The record’s properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is"},{"type":"text","text":" "},{"type":"text","text":"made with. Aptabase keeps strings, numbers and booleans, and only a placeholder for an object or"},{"type":"text","text":" "},{"type":"text","text":"an array, so an object or array is flattened into dotted names: a "},{"type":"codeVoice","code":"cart"},{"type":"text","text":" holding "},{"type":"codeVoice","code":"size"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", and the first element of "},{"type":"codeVoice","code":"tags"},{"type":"text","text":" is "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":". A boolean stays a boolean, which Aptabase"},{"type":"text","text":" "},{"type":"text","text":"stores as "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":"; a number keeps its JSON type; and a "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" property is left out. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Aptabase stores a number as a .NET "},{"code":"decimal","type":"codeVoice"},{"type":"text","text":", so it keeps 28 decimal places and rounds a smaller"},{"type":"text","text":" "},{"type":"text","text":"fraction away."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Records-left-out","text":"Records left out"},{"inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"one the plan doesn’t describe, whose event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", or that holds a value JSON can’t;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose event name is only whitespace or longer than the 60 characters Aptabase takes, as"},{"type":"text","text":" "},{"type":"text","text":"Aptabase refuses the whole request holding one;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one with a property, once flattened, whose name is empty, only whitespace or longer than 40","type":"text"},{"text":" ","type":"text"},{"text":"characters, which Aptabase would drop;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one with a string value longer than 180 characters, which Aptabase would cut short;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one with a number of magnitude 2⁹⁶ (about 7.9 × 10²⁸) or more, past a "},{"code":"decimal","type":"codeVoice"},{"type":"text","text":", for which"},{"type":"text","text":" "},{"type":"text","text":"Aptabase fails the whole request;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose values flatten to the same name twice;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose timestamp falls outside the years 1 to 9999;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one tracked more than 23 hours before its batch is encoded, as Aptabase drops an event more than"},{"type":"text","text":" "},{"type":"text","text":"a day old while answering 200, the hour to spare for a queue on the server and clocks that"},{"type":"text","text":" "},{"type":"text","text":"disagree;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one too large for a request of 1,000,000 bytes on its own.","type":"text"}]}]}]},{"inlineContent":[{"text":"Characters are counted in UTF-16, as .NET counts them, so an emoji counts two. The destination","type":"text"},{"text":" ","type":"text"},{"text":"reports each record left out as ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" whose reason is an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError","isActive":true,"type":"reference"},{"text":". When the destination is made, it logs a notice for each event and","type":"text"},{"text":" ","type":"text"},{"text":"property of the plan whose name would be left out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A request is encoded once and retried as it is, so each request’s deadline is 23 hours after its","type":"text"},{"text":" ","type":"text"},{"text":"oldest record was tracked: one still failing by then, a slow upload’s 418 included, isn’t sent","type":"text"},{"text":" ","type":"text"},{"text":"again, which Aptabase would answer with 200 while storing nothing. It is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":". A clock that reads NaN or infinite has","type":"text"},{"text":" ","type":"text"},{"text":"every record reported. An event from the future, by a clock that runs ahead, is sent, and Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"stores it at the time it arrives.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The 23 hours are measured by the device’s own clock, but Aptabase measures a day by its server’s."},{"type":"text","text":" "},{"type":"text","text":"On a device whose clock runs about a day behind, a record tracked just now carries a timestamp a"},{"type":"text","text":" "},{"type":"text","text":"day old: the encoder sends it, and Aptabase drops it while answering 200, so the record is lost"},{"type":"text","text":" "},{"type":"text","text":"without a report."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"What-Aptabases-answers-say","text":"What Aptabase’s answers say"},{"inlineContent":[{"type":"text","text":"Aptabase answers 200 to a request with a key of no app, of a deleted app, or of an account it has"},{"type":"text","text":" "},{"type":"text","text":"locked, such as one past its plan’s monthly events, and stores nothing. Its body says so,"},{"type":"text","text":" "},{"code":"{\"error\": ...}","type":"codeVoice"},{"type":"text","text":", so the destination drops the request and reports it as"},{"type":"text","text":" "},{"code":"HTTPDropReport.rejectedInBody(status:reason:recordIDs:)","type":"codeVoice"},{"type":"text","text":", with Aptabase’s error as the reason."},{"type":"text","text":" "},{"type":"text","text":"Every request is refused that way until the key is fixed or the account unlocked, so watch the"},{"type":"text","text":" "},{"type":"text","text":"drop reports, and check that the first events reach the app’s Live View after setting the"},{"type":"text","text":" "},{"type":"text","text":"destination up. It doesn’t remove duplicates,"},{"type":"text","text":" "},{"type":"text","text":"so a record sent again, after a retry whose answer was lost or a store’s redelivery, is counted"},{"type":"text","text":" "},{"type":"text","text":"twice."}],"type":"paragraph"},{"inlineContent":[{"text":"Aptabase takes 20 requests a second from one IP address, and answers 429 past it, which the","type":"text"},{"text":" ","type":"text"},{"text":"destination retries on its backoff.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what Aptabase receives, and why, in more detail."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Send records to Aptabase, in its cloud or on your own server, through its events API."}],"sections":[],"variants":[{"paths":["\/documentation\/aptabaseencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"collection","title":"AptabaseEncoding","symbolKind":"module","externalID":"AptabaseEncoding","roleHeading":"Framework","modules":[{"name":"AptabaseEncoding"}]},"references":{"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseEncodingError":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AptabaseEncodingError","kind":"identifier"}],"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError","url":"\/documentation\/aptabaseencoding\/aptabaseencodingerror","role":"symbol","navigatorTitle":[{"text":"AptabaseEncodingError","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Why "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"type":"topic","title":"AptabaseEncodingError"},"doc://AptabaseEncoding/documentation/AptabaseEncoding":{"title":"AptabaseEncoding","kind":"symbol","abstract":[{"text":"Send records to Aptabase, in its cloud or on your own server, through its events API.","type":"text"}],"role":"collection","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","url":"\/documentation\/aptabaseencoding","type":"topic"},"do