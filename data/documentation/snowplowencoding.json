{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:backoff:clock:)","doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:transport:backoff:clock:)","doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowSetupError"],"anchor":"Sending-to-Snowplow","title":"Sending to Snowplow"},{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder"],"anchor":"Encoding-batches","title":"Encoding batches"},{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError"],"anchor":"Records-left-out","title":"Records left out"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:backoff:clock:)","isActive":true},{"text":" makes an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"text":") for a Snowplow pipeline in one call. It checks the","type":"text"},{"text":" ","type":"text"},{"text":"collector’s URL, the Iglu vendor and the app ID, and posts to the collector’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\/com.snowplowanalytics.snowplow\/tp2"},{"text":" endpoint with a ","type":"text"},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","isActive":true},{"text":". It splits each","type":"text"},{"text":" ","type":"text"},{"text":"batch to the limits of Snowplow’s own mobile trackers (","type":"text"},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","isActive":true},{"text":"): 25","type":"text"},{"text":" ","type":"text"},{"text":"events and 40,000 bytes a request, with a larger event, of up to 150,000 bytes, in a request of","type":"text"},{"text":" ","type":"text"},{"text":"its own. A batch with no record the encoder can write, an empty one","type":"text"},{"text":" ","type":"text"},{"text":"included, makes no request. The destination retries no response, a 5xx, 408 and 429, and drops","type":"text"},{"text":" ","type":"text"},{"text":"and reports any other status. No trace context is sent. ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves this module out;","type":"text"},{"text":" ","type":"text"},{"text":"import it on its own.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A collector takes events from anyone who can reach it, so there is no key or secret, and the","type":"text"},{"text":" ","type":"text"},{"text":"destination builds on every platform: an app sends to the collector directly.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import HTTPDestinations","import SnowplowEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let snowplow = try HTTPDestination.snowplow(","    collector: collector,  \/\/ https:\/\/collector.example.com","    vendor: \"com.example\",  \/\/ the Iglu vendor the plan is exported under","    appID: \"shop-ios\",","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: snowplow)"]},{"inlineContent":[{"type":"text","text":"The factory throws "},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowSetupError","isActive":true},{"type":"text","text":" for a collector URL that isn’t "},{"type":"codeVoice","code":"https"},{"type":"text","text":", that has no host,"},{"type":"text","text":" "},{"type":"text","text":"a user name, a query or a fragment, or that already ends in the endpoint; for a vendor Iglu"},{"type":"text","text":" "},{"type":"text","text":"doesn’t take; and for an empty app ID or one longer than 255 UTF-16 code units."}],"type":"paragraph"},{"text":"Schemas from the tracking plan","anchor":"Schemas-from-the-tracking-plan","type":"heading","level":3},{"inlineContent":[{"text":"Each event is a self-describing event: its data comes with the Iglu URI of the schema it must","type":"text"},{"text":" ","type":"text"},{"text":"match, and Snowplow’s pipeline validates it against that schema before loading it. The URI is","type":"text"},{"text":" ","type":"text"},{"text":"named after the event and its version, under the vendor the destination is given:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["iglu:<vendor>\/<name>\/jsonschema\/<version>-0-0"]},{"inlineContent":[{"text":"Version N of an event is SchemaVer ","type":"text"},{"code":"N-0-0","type":"codeVoice"},{"text":", and events always name it. Raising an event’s version","type":"text"},{"text":" ","type":"text"},{"text":"is a breaking change, which is SchemaVer’s MODEL. The export compares each event with the newest","type":"text"},{"text":" ","type":"text"},{"text":"schema of its version the registry holds, by what the two mean rather than their bytes, as the","type":"text"},{"text":" ","type":"text"},{"text":"plan’s own check does:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"An event that hasn’t changed keeps its published file, and nothing is written.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"A breaking change at the same version, such as a property made required, is refused: raise the","type":"text"},{"text":" ","type":"text"},{"text":"event’s version.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A compatible change, such as an optional property added, is an ADDITION. For Iglu Server the","type":"text"},{"text":" ","type":"text"},{"text":"export writes it as ","type":"text"},{"code":"N-0-1","type":"codeVoice"},{"text":", then ","type":"text"},{"code":"N-0-2","type":"codeVoice"},{"text":", each listing the earlier ones in ","type":"text"},{"code":"$supersedes","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"Snowplow validates events naming ","type":"text"},{"code":"N-0-0","type":"codeVoice"},{"text":" against the newest, so a release already in users’","type":"text"},{"text":" ","type":"text"},{"text":"hands keeps validating. Superseding needs Iglu Server 0.11.0 or later and Enrich 3.8.0 or later.","type":"text"},{"text":" ","type":"text"},{"text":"A static repository doesn’t support it: it would validate those events against ","type":"text"},{"code":"N-0-0","type":"codeVoice"},{"text":" alone,","type":"text"},{"text":" ","type":"text"},{"text":"so for one the export refuses the change, and the event needs a new version.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Write the registry from the plan with ","type":"text"},{"code":"TrackingPlan.writeIgluRegistry(to:vendor:registry:)","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"code":"iglu <vendor> server|static <registry-directory>","type":"codeVoice"},{"text":" command of the tracking plan’s executable, or","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"export-tracking-plan","type":"codeVoice"},{"text":" plugin’s ","type":"text"},{"code":"--iglu-vendor","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"--iglu-registry","type":"codeVoice"},{"text":". Then publish it with","type":"text"},{"text":" ","type":"text"},{"code":"igluctl","type":"codeVoice"},{"text":" before the release that sends the events.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An event name Iglu takes holds only ASCII letters, digits, ","type":"text"},{"type":"codeVoice","code":"-"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"_"},{"text":", and the version must be 1","type":"text"},{"text":" ","type":"text"},{"text":"or more. The encoder skips every record of an event that breaks either rule, and logs a notice for","type":"text"},{"text":" ","type":"text"},{"text":"each such event of the plan when the destination is made. The export refuses such an event too.","type":"text"}],"type":"paragraph"},{"text":"What Snowplow receives","anchor":"What-Snowplow-receives","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Each request is a "},{"code":"payload_data","type":"codeVoice"},{"type":"text","text":" 1-0-4 array of events, one per record. Every event has:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"e"},{"type":"text","text":", "},{"type":"codeVoice","code":"ue"},{"type":"text","text":": a self-describing event, with its data in "},{"type":"codeVoice","code":"ue_pr"},{"type":"text","text":" as JSON text;"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"eid"},{"type":"text","text":", the record’s identifier, which a redelivered record keeps;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"dtm"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ttm"},{"type":"text","text":", the record’s timestamp in milliseconds, so Snowplow’s "},{"type":"codeVoice","code":"derived_tstamp"},{"type":"text","text":" is when"},{"type":"text","text":" "},{"type":"text","text":"the event was tracked;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"aid"},{"type":"text","text":", the app ID; "},{"type":"codeVoice","code":"p"},{"type":"text","text":", the platform; "},{"type":"codeVoice","code":"tv"},{"type":"text","text":", "},{"type":"codeVoice","code":"traffluent"},{"type":"text","text":"; and "},{"type":"codeVoice","code":"ip"},{"type":"text","text":", "},{"type":"codeVoice","code":"0.0.0.0"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"stm"},{"type":"text","text":" is sent: a retried request sends the same body again, so a sent time would be the first"},{"type":"text","text":" "},{"type":"text","text":"attempt’s, and Snowplow would move the event later by however long the retries took."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The standard context, when the record has it, goes in "},{"type":"codeVoice","code":"co"},{"type":"text","text":" as Snowplow’s "},{"type":"codeVoice","code":"mobile_context"},{"type":"text","text":" 1-0-3"},{"type":"text","text":" "},{"type":"text","text":"(the operating system, Apple as the manufacturer, the device model, the network type and the"},{"type":"text","text":" "},{"type":"text","text":"language) and "},{"type":"codeVoice","code":"application"},{"type":"text","text":" 1-0-0 (the app’s version and build). The platform is "},{"type":"codeVoice","code":"mob"},{"type":"text","text":" for a phone,"},{"type":"text","text":" "},{"type":"text","text":"pad, watch or Vision Pro, "},{"type":"codeVoice","code":"tv"},{"type":"text","text":" for an Apple TV, "},{"type":"codeVoice","code":"pc"},{"type":"text","text":" for a Mac and "},{"type":"codeVoice","code":"app"},{"type":"text","text":" for a record with no device."}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is made with. A","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is never sent, whatever the record reveals.","type":"text"}],"type":"paragraph"},{"text":"Only the session identifies a record","anchor":"Only-the-session-identifies-a-record","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The record’s session, from the sessions enricher, is its "},{"type":"codeVoice","code":"sid"},{"type":"text","text":", Snowplow’s "},{"type":"codeVoice","code":"domain_sessionid"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"nothing else identifies it. No "},{"type":"codeVoice","code":"duid"},{"type":"text","text":", "},{"type":"codeVoice","code":"uid"},{"type":"text","text":", "},{"type":"codeVoice","code":"nuid"},{"type":"text","text":" or "},{"type":"codeVoice","code":"tnuid"},{"type":"text","text":" is sent, no "},{"type":"codeVoice","code":"client_session"},{"type":"text","text":" "},{"type":"text","text":"entity (its "},{"type":"codeVoice","code":"userId"},{"type":"text","text":" lasts across sessions), and no IDFV, IDFA or other device identifier. The"},{"type":"text","text":" "},{"type":"text","text":"record’s vendor identifier and trace context aren’t sent either. A record with no session, from a"},{"type":"text","text":" "},{"type":"text","text":"tracker without the sessions enricher, is sent without a "},{"type":"codeVoice","code":"sid"},{"type":"text","text":"; a record a store recovered after a"},{"type":"text","text":" "},{"type":"text","text":"relaunch keeps its session and its "},{"type":"codeVoice","code":"sid"},{"type":"text","text":". Snowplow’s mobile data models"},{"type":"text","text":" "},{"type":"text","text":"read a session from the "},{"type":"codeVoice","code":"client_session"},{"type":"text","text":" entity, so set the unified package’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"snowplow__session_identifiers"},{"type":"text","text":" to "},{"type":"codeVoice","code":"[{\"schema\": \"atomic\", \"field\": \"domain_sessionid\"}]"},{"type":"text","text":" for these"},{"type":"text","text":" "},{"type":"text","text":"events."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The collector would give each device an identifier of its own: it sets an "},{"type":"codeVoice","code":"sp"},{"type":"text","text":" cookie, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" keeps and sends back, and records the request’s IP address. Every request carries"},{"type":"text","text":" "},{"type":"codeVoice","code":"SP-Anonymous: *"},{"type":"text","text":", so the collector sets and reads no cookie, records "},{"type":"codeVoice","code":"network_userid"},{"type":"text","text":" as all"},{"type":"text","text":" "},{"type":"text","text":"zeros, and records no IP address or forwarding header fields."}],"type":"paragraph"},{"text":"Records left out","anchor":"Records-left-out","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"one the plan doesn’t describe, whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", or that holds a value JSON can’t;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one whose event name Iglu doesn’t take, or whose version is below 1;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one whose timestamp falls outside the years 0 to 9999, which Snowplow’s enrichment fails;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose JSON is over 150,000 bytes, which the smallest of a pipeline’s streams, SQS’s 192 kB,","type":"text"},{"text":" ","type":"text"},{"text":"might not take with the request around it.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The destination reports each as ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" whose reason is a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"What the collector doesn’t report","anchor":"What-the-collector-doesnt-report","type":"heading","level":3},{"inlineContent":[{"text":"The collector answers 200 to every request it can read and validates nothing. Snowplow checks the","type":"text"},{"text":" ","type":"text"},{"text":"events later, in enrichment. An event whose data its schema rejects, whose schema the pipeline’s","type":"text"},{"text":" ","type":"text"},{"text":"Iglu resolver can’t find, or that is larger than the pipeline’s stream takes, becomes a failed","type":"text"},{"text":" ","type":"text"},{"text":"event: it is kept apart and never reaches the warehouse, though the destination counted it as","type":"text"},{"text":" ","type":"text"},{"text":"delivered. Publish each schema before the release that sends it, and watch the pipeline’s failed","type":"text"},{"text":" ","type":"text"},{"text":"events after a change to the plan. Snowplow’s resolver caches schemas, for 10 minutes by default,","type":"text"},{"text":" ","type":"text"},{"text":"so a schema published after the first event that names it can still be missed for that long.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Snowplow doesn’t remove duplicates as events arrive. A record is sent more than once when a request","type":"text"},{"text":" ","type":"text"},{"text":"is retried after the collector stored it but the answer was lost, when a delivery sends a cancelled","type":"text"},{"text":" ","type":"text"},{"text":"batch again, and when a store redelivers records after a relaunch. Each copy keeps its ","type":"text"},{"type":"codeVoice","code":"eid"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"Snowplow’s data models, which deduplicate on ","type":"text"},{"type":"codeVoice","code":"event_id"},{"text":", count it once.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what Snowplow receives, and why, in more detail."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/snowplowencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding"},"metadata":{"roleHeading":"Framework","title":"SnowplowEncoding","externalID":"SnowplowEncoding","role":"collection","symbolKind":"module","modules":[{"name":"SnowplowEncoding"}]},"kind":"symbol","abstract":[{"type":"text","text":"Send records to a Snowplow collector as self-describing events, whose schemas come from the tracking plan."}],"references":{"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowEncodingError":{"url":"\/documentation\/snowplowencoding\/snowplowencodingerror","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","title":"SnowplowEncodingError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SnowplowEncodingError","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Why "},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","type":"reference","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"kind":"symbol","navigatorTitle":[{"text":"SnowplowEncodingError","kind":"identifier"}],"role":"symbol"},"doc://SnowplowEncoding/documentation/SnowplowEncoding":{"role":"collection","url":"\/documentation\/snowplowencoding","kind":"symbol","title":"SnowplowEncoding","type":"topic","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","abstract":[{"text":"Send records to a Snowplow collector as self-describing events, whose schemas come from the tracking plan.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"type":"text","text":" sends."}],"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"url":"\/documentation\/httpdestinations\/batchencoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","title":"BatchEncoder","kind":"symbol"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowSetupError":{"navigatorTitle":[{"kind":"identifier","text":"SnowplowSetupError"}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowSetupError"}],"url":"\/documentation\/snowplowencoding\/snowplowsetuperror","title":"SnowplowSetupError","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:transport:backoff:clock:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/init(vendor:appID:plan:limit:)","isActive":true,"type":"reference"},{"text":" couldn’t be made.","type":"text"}],"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowSetupError"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/batchLimit":{"url":"\/documentation\/snowplowencoding\/snowplowbatchencoder\/batchlimit","type":"topic","title":"batchLimit","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"role":"symbol","kind":"symbol","abstract":[{"text":"Snowplow’s trackers’ limits on one request, 25 events and 40,000 bytes of body, and an event","type":"text"},{"text":" ","type":"text"},{"text":"of up to 150,000 bytes in a request of its own.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","role":"collection","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"kind":"symbol","type":"topic","title":"HTTPDestinations","url":"\/documentation\/httpdestinations"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","url":"https:\/\/tyler-keith-t