TTPDestinations\/HTTPDestination","type":"reference"},{"text":" sends.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"type":"topic","title":"HTTPDestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","role":"collection","kind":"symbol","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"url":"\/documentation\/httpdestinations"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorEncodingError":{"role":"symbol","kind":"symbol","url":"\/documentation\/collectorencoding\/collectorencodingerror","title":"CollectorEncodingError","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true},{"type":"text","text":" couldn’t encode a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"request as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CollectorEncodingError","kind":"identifier"}],"navigatorTitle":[{"text":"CollectorEncodingError","kind":"identifier"}]},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder":{"role":"symbol","kind":"symbol","url":"\/documentation\/collectorencoding\/collectorbatchencoder","title":"CollectorBatchEncoder","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/Colle