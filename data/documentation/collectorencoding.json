{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/SkippedRecord","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"],"title":"Records left out","anchor":"Records-left-out"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/collectorencoding"]}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder"},{"text":" is the ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" for a self-hosted TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"code":"POST \/v1\/batches","type":"codeVoice"},{"text":". Give it to an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"text":") as its encoder,","type":"text"},{"text":" ","type":"text"},{"text":"and pass the collector’s API key to the destination as an ","type":"text"},{"code":"Authorization: Bearer","type":"codeVoice"},{"text":" header field.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record"},{"type":"text","text":" "},{"type":"text","text":"keeps), the event’s name, its timestamp, whether it is redelivered, its properties and its context."},{"type":"text","text":" "},{"type":"text","text":"Properties are read from the event’s "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":" form, which "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"event’s schema in the "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" the encoder is made with. The context holds the standard"},{"type":"text","text":" "},{"type":"text","text":"context keys the record has values for, its session and sample rate, and its trace context. A"},{"type":"text","text":" "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is written only while the record reveals it; once redacted, a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"property is left out, and an array’s element, or a value inside a type the plan can’t map, is"},{"type":"text","text":" "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and"},{"type":"text","text":" "},{"type":"text","text":"version the plan doesn’t describe, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", and one holding a value"},{"type":"text","text":" "},{"type":"text","text":"JSON can’t, such as a NaN. Each is logged; "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","isActive":true},{"type":"text","text":" returns the body"},{"type":"text","text":" "},{"type":"text","text":"with each record left out as a "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/SkippedRecord","isActive":true},{"type":"text","text":". When no record of a batch can be written,"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/encode(_:)","isActive":true},{"type":"text","text":" throws, and the destination sends nothing."}]},{"type":"paragraph","inlineContent":[{"text":"To send to a server of your own format, write a ","type":"text"},{"type":"codeVoice","code":"BatchEncoder"},{"text":" of your own. To send to PostHog,","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"type":"codeVoice","code":"PostHogBatchEncoder"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"PostHogEncoding"},{"text":").","type":"text"}]},{"type":"codeListing","code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan(schemas: [SignedUp.schema])","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers sending to the collector beside the other destinations."}]}],"kind":"content"}],"abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"metadata":{"roleHeading":"Framework","title":"CollectorEncoding","role":"collection","externalID":"CollectorEncoding","modules":[{"name":"CollectorEncoding"}],"symbolKind":"module"},"references":{"do