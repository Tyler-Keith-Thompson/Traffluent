{"abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" to send."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/collectorencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"CollectorEncoding"}],"role":"collection","title":"CollectorEncoding","externalID":"CollectorEncoding","roleHeading":"Framework","symbolKind":"module"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" is the "},{"code":"BatchEncoder","type":"codeVoice"},{"type":"text","text":" for a self-hosted TraffluentCollector’s"},{"type":"text","text":" "},{"code":"POST \/v1\/batches","type":"codeVoice"},{"type":"text","text":". Give it to an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"type":"text","text":") as its encoder,"},{"type":"text","text":" "},{"type":"text","text":"and pass the collector’s API key to the destination as an "},{"code":"Authorization: Bearer","type":"codeVoice"},{"type":"text","text":" header field."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record"},{"type":"text","text":" "},{"type":"text","text":"keeps), the event’s name, its timestamp, whether it is redelivered, its properties and its context."},{"type":"text","text":" "},{"type":"text","text":"Properties are read from the event’s "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":" form, which "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"event’s schema in the "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" the encoder is made with. The context holds the standard"},{"type":"text","text":" "},{"type":"text","text":"context keys the record has values for, its session and sample rate, and its trace context. A"},{"type":"text","text":" "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is written only while the record reveals it; once redacted, a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"property is left out, and an array’s element, or a value inside a type the plan can’t map, is"},{"type":"text","text":" "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and"},{"type":"text","text":" "},{"type":"text","text":"version the plan doesn’t describe, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one holding a value"},{"type":"text","text":" "},{"type":"text","text":"JSON can’t, such as a NaN, and one whose timestamp has no ISO 8601 form (NaN, infinite, or more"},{"type":"text","text":" "},{"type":"text","text":"than "},{"type":"codeVoice","code":"Int64.max"},{"type":"text","text":" milliseconds from 1970). "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/requests(for:)"},{"type":"text","text":" returns each record left out"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":"), which the destination logs and reports on"},{"type":"text","text":" "},{"type":"text","text":"its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":". When no record of a batch can be written, the destination sends nothing."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)"},{"type":"text","text":" returns the same body and skipped records without a"},{"type":"text","text":" "},{"type":"text","text":"destination."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to a server of your own format, write a "},{"code":"BatchEncoder","type":"codeVoice"},{"type":"text","text":" of your own. To send to PostHog,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"code":"PostHogBatchEncoder","type":"codeVoice"},{"type":"text","text":" (module "},{"code":"PostHogEncoding","type":"codeVoice"},{"type":"text","text":")."}]},{"code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers sending to the collector beside the other destinations."}]}]}],"topicSections":[{"anchor":"Encoding-batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"],"title":"Encoding batches"},{"anchor":"Records-left-out","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"],"title":"Records left out"}],"references":{"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder/batch(of:)":{"type":"topic","title":"batch(of:)","url":"\/documentation\/collectorencoding\/collectorbatchencoder\/batch(of:)","abstract":[{"type":"text","text":"The body of "},{"type":"codeVoice","code":"batch"},{"type":"text","text":" in TraffluentCollector’s ingest format, and the records left out of it."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"CollectorBatch","kind":"typeIdentifier","preciseIdentifier":"s:17CollectorEncoding0A5BatchV"}],"kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder":{"abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of TraffluentCollector’s ingest format, so an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send to a self-hosted collector’s "},{"type":"codeVoice","code":"POST \/v1\/batches"},{"type":"text","text":"."}],"title":"CollectorBatchEncoder","navigatorTitle":[{"text":"CollectorBatchEncoder","kind":"identifier"}],"url":"\/documentation\/collectorencoding\/collectorbatchencoder","role":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CollectorBatchEncoder","kind":"identifier"}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"type":"topic","url":"\/documentation\/httpdestinations","title":"HTTPDestinations","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"role":"collection","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder/requests(for:)":{"url":"\/documentation\/collectorencoding\/collectorbatchencoder\/requests(for:)","abstract":[{"text":"The one request carrying ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":" in TraffluentCollector’s ingest format, and the records","type":"text"},{"text":" ","type":"text"},{"text":"left out of it.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/requests(for:)","title":"requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","text":"BatchRequests"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:17CollectorEncoding0aB5ErrorO","text":"CollectorEncodingError"},{"kind":"text","text":">"}]},"doc://CollectorEncoding/documentation/Col