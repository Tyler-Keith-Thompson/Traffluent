{"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},"kind":"symbol","abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"topicSections":[{"title":"Encoding batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"],"anchor":"Encoding-batches"},{"title":"Records left out","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"],"anchor":"Records-left-out"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true,"type":"reference"},{"text":" is the ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" for a self-hosted TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"code":"POST \/v1\/batches","type":"codeVoice"},{"text":". Give it to an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"text":") as its encoder,","type":"text"},{"text":" ","type":"text"},{"text":"and pass the collector’s API key to the destination as an ","type":"text"},{"code":"Authorization: Bearer","type":"codeVoice"},{"text":" header field.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record"},{"type":"text","text":" "},{"type":"text","text":"keeps), the event’s name, its timestamp, whether it is redelivered, its properties and its context."},{"type":"text","text":" "},{"type":"text","text":"Properties are read from the event’s "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":" form, which "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"event’s schema in the "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" the encoder is made with. The context holds the standard"},{"type":"text","text":" "},{"type":"text","text":"context keys the record has values for, its session and sample rate, and its trace context. A"},{"type":"text","text":" "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is written only while the record reveals it; once redacted, a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"property is left out, and an array’s element, or a value inside a type the plan can’t map, is"},{"type":"text","text":" "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and"},{"type":"text","text":" "},{"type":"text","text":"version the plan doesn’t describe, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one holding a value"},{"type":"text","text":" "},{"type":"text","text":"JSON can’t, such as a NaN, and one whose timestamp has no ISO 8601 form (NaN, infinite, or more"},{"type":"text","text":" "},{"type":"text","text":"than "},{"type":"codeVoice","code":"Int64.max"},{"type":"text","text":" milliseconds from 1970). "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/requests(for:)"},{"type":"text","text":" returns each record left out"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":"), which the destination logs and reports on"},{"type":"text","text":" "},{"type":"text","text":"its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":". When no record of a batch can be written, the destination sends nothing."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)"},{"type":"text","text":" returns the same body and skipped records without a"},{"type":"text","text":" "},{"type":"text","text":"destination."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to a server of your own format, write a "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" of your own. To send to PostHog,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"PostHogBatchEncoder"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":")."}]},{"type":"codeListing","code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"covers sending to the collector beside the other destinations."}]}]}],"variants":[{"paths":["\/documentation\/collectorencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"externalID":"CollectorEncoding","title":"CollectorEncoding","role":"collection","modules":[{"name":"CollectorEncoding"}],"symbolKind":"module","roleHeading":"Framework"},"sections":[],"references":{"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder/batch(of:)":{"title":"batch(of:)","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","url":"\/documentation\/collectorencoding\/collectorbatchencoder\/batch(of:)","type":"topic","abstract":[{"text":"The body of ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":" in TraffluentCollector’s ingest format, and the records left out of it.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"preciseIdentifier":"s:17CollectorEncoding0A5BatchV","text":"CollectorBatch","kind":"typeIdentifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"type":"topic","kind":"symbol","role":"collection","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"title":"HTTPDestinations","url":"\/documentation\/httpdestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"title":"CollectorEncoding","kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","type":"topic","url":"\/documentation\/collectorencoding","abstra