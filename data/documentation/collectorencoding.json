ollectorencoding","type":"topic"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorEncodingError":{"title":"CollectorEncodingError","type":"topic","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t encode a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"request as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"url":"\/documentation\/collectorencoding\/collectorencodingerror","kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CollectorEncodingError"}],"navigatorTitle":[{"kind":"identifier","text":"CollectorEncodingError"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"url":"\/documentation\/httpdestinations","kind":"symbol","type":"topic","title":"HTTPDestinations","role":"collection"}}}