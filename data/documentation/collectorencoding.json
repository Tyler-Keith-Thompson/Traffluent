{"sections":[],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","type":"reference"},{"type":"text","text":" is the "},{"code":"BatchEncoder","type":"codeVoice"},{"type":"text","text":" for a self-hosted TraffluentCollector’s"},{"type":"text","text":" "},{"code":"POST \/v1\/batches","type":"codeVoice"},{"type":"text","text":". Give it to an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" (module "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference"},{"type":"text","text":") as its encoder,"},{"type":"text","text":" "},{"type":"text","text":"and pass the collector’s API key to the destination as an "},{"code":"Authorization: Bearer","type":"codeVoice"},{"type":"text","text":" header field."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record"},{"type":"text","text":" "},{"type":"text","text":"keeps), the event’s name, its timestamp, whether it is redelivered, its properties and its context."},{"type":"text","text":" "},{"type":"text","text":"Properties are read from the event’s "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" form, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. The context holds the standard"},{"type":"text","text":" "},{"type":"text","text":"context keys the record has values for, its session and sample rate, and its trace context. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is written only while the record reveals it."}]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and","type":"text"},{"text":" ","type":"text"},{"text":"version the plan doesn’t describe, one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"BinaryCodable"},{"text":", and one holding a value","type":"text"},{"text":" ","type":"text"},{"text":"JSON can’t, such as a NaN. Each is logged; ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","type":"reference","isActive":true},{"text":" returns the body","type":"text"},{"text":" ","type":"text"},{"text":"with each record left out as a ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/SkippedRecord","type":"reference","isActive":true},{"text":". When no record of a batch can be written,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/encode(_:)","type":"reference","isActive":true},{"text":" throws, and the destination sends nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to a server of your own format, write a "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" of your own. To send to PostHog,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"PostHogBatchEncoder"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":")."}]},{"code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan(schemas: [SignedUp.schema])","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers sending to the collector beside the other destinations."}]}],"kind":"content"}],"kind":"symbol","metadata":{"modules":[{"name":"CollectorEncoding"}],"title":"CollectorEncoding","symbolKind":"module","externalID":"CollectorEncoding","role":"collection","roleHeading":"Framework"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"identifier":{"url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","interfaceLanguage":"swift"},"topicSections":[{"title":"Encoding batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"],"anchor":"Encoding-batches"},{"title":"Records left out","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/SkippedRecord","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"],"anchor":"Records-left-out"}],"variants":[{"paths":["\/documentation\/collectorencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorEncodingError":{"abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true},{"type":"text","text":" couldn’t encode a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"body as a "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/SkippedRecord","isActive":true},{"type":"text","text":". When it can encode no record of a batch, "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/encode(_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"throws the first one’s, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch and logs the error."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError","url":"\/documentation\/collectorencoding\/collectorencodingerror","title":"CollectorEncodingError","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CollectorEncodingError"}],"navigatorTitle":[{"kind":"identifier","text":"CollectorEncodingError"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","title":"Choosing Destinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder/encode(_:)":{"type":"topic","kind":"symbol","title":"encode(_:)","role":"symbol","url":"\/documentation\/collectorencoding\/collectorbatchencoder\/encode(_:)","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/encode(_:)","abstract":[{"text":"The request body for ","type":"text"},{"code":"batch","type":"codeVoice"},