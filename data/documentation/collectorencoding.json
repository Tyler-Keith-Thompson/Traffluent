{"kind":"symbol","identifier":{"url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/collectorencoding"]}],"sections":[],"metadata":{"title":"CollectorEncoding","symbolKind":"module","modules":[{"name":"CollectorEncoding"}],"roleHeading":"Framework","role":"collection","externalID":"CollectorEncoding"},"abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send,"},{"type":"text","text":" "},{"type":"text","text":"and read them back into records on a server."}],"topicSections":[{"anchor":"Encoding-batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"],"title":"Encoding batches"},{"anchor":"Records-left-out","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"],"title":"Records left out"},{"anchor":"Decoding-batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/DecodedCollectorBatch","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoderError","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/NotACollectorBatch"],"title":"Decoding batches"},{"anchor":"Records-that-cant-be-read","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/UndecodedRecord","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorDecodingError"],"title":"Records that can’t be read"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true,"type":"reference"},{"text":" is the ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" for a self-hosted TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"code":"POST \/v1\/batches","type":"codeVoice"},{"text":". Give it to an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"text":") as its encoder,","type":"text"},{"text":" ","type":"text"},{"text":"and pass the collector’s API key to the destination as an ","type":"text"},{"code":"Authorization: Bearer","type":"codeVoice"},{"text":" header field.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record","type":"text"},{"text":" ","type":"text"},{"text":"keeps), the event’s name and version, its timestamp, whether it is redelivered, its properties and","type":"text"},{"text":" ","type":"text"},{"text":"its context.","type":"text"},{"text":" ","type":"text"},{"text":"Properties are read from the event’s ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":" form, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" derives, through the","type":"text"},{"text":" ","type":"text"},{"text":"event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is made with. The context holds the standard","type":"text"},{"text":" ","type":"text"},{"text":"context keys the record has values for, its session and sample rate, and its trace context. A","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is written only while the record reveals it; once redacted, a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property is left out, and an array’s element, or a value inside a type the plan can’t map, is","type":"text"},{"text":" ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and","type":"text"},{"text":" ","type":"text"},{"text":"version the plan doesn’t describe, one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one holding a value","type":"text"},{"text":" ","type":"text"},{"text":"JSON can’t, such as a NaN, and one whose timestamp has no ISO 8601 form (NaN, infinite, or more","type":"text"},{"text":" ","type":"text"},{"text":"than ","type":"text"},{"type":"codeVoice","code":"Int64.max"},{"text":" milliseconds from 1970). ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" returns each record left out","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"text":"), which the destination logs and reports on","type":"text"},{"text":" ","type":"text"},{"text":"its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":". When no record of a batch can be written, the destination sends nothing.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","type":"reference","isActive":true},{"text":" returns the same body and skipped records without a","type":"text"},{"text":" ","type":"text"},{"text":"destination.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to a server of your own format, write a "},{"code":"BatchEncoder","type":"codeVoice"},{"type":"text","text":" of your own. To send to PostHog,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"code":"PostHogBatchEncoder","type":"codeVoice"},{"type":"text","text":" (module "},{"code":"PostHogEncoding","type":"codeVoice"},{"type":"text","text":")."}]},{"type":"codeListing","code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers sending to the collector beside the other destinations."}]},{"type":"heading","level":3,"anchor":"Reading-batches-back","text":"Reading batches back"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder"},{"type":"text","text":" reads a body the encoder wrote back into "},{"code":"EventRecord","type":"codeVoice"},{"type":"text","text":"s, for a server"},{"type":"text","text":" "},{"type":"text","text":"that receives an app’s batches and hands them to another destination, such as a relay in front"},{"type":"text","text":" "},{"type":"text","text":"of Google Analytics. Make it with the plan the app’s encoder was made with. It finds each record’s"},{"type":"text","text":" "},{"type":"text","text":"event type by name and version among the "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":"s the server links, or among the types you list"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder\/init(plan:events:instrument:)"},{"type":"text","text":")."}]},{"type":"codeListing","code":["import CollectorEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let decoder = try CollectorBatchDecoder(plan: plan)","let batch = try decoder.batch(from: body)  \/\/ a body CollectorBatchEncoder wrote","await destination.receive(batch.records)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each record keeps its identifier, timestamp (to the millisecond), event, redelivery flag and the"},{"type":"text","text":" "},{"type":"text","text":"context the body holds: its session’s "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", its sample rate, the standard context and its"},{"type":"text","text":" "},{"type":"text","text":"trace context, which the decoder’s instrument extracts. Encoding the records again with an encoder"},{"type":"text","text":" "},{"type":"text","text":"of the same plan writes the same bytes. A record the decoder can’t read is left out and the rest"},{"type":"text","text":" "},{"type":"text","text":"are read: one of an event it has no type for, one at a version it has no type for or the plan"},{"type":"text","text":" "},{"type":"text","text":"doesn’t describe, one missing a member or holding what the encoder never writes, and one with a"},{"type":"text","text":" "},{"type":"text","text":"property the event’s type can’t read: a required "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" property a delivery redacted, an"},{"type":"text","text":" "},{"type":"text","text":"array of non-optional "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" elements it redacted, or an integer outside its property’s type."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each record states its event’s version, and is read into the decoder’s type of that name and"},{"type":"text","text":" "},{"type":"text","text":"version. Once an app raises an event’s version, its releases still installed send the earlier"},{"type":"text","text":" "},{"type":"text","text":"one, so the server keeps a type for each version the apps send. Two "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" types of one name"},{"type":"text","text":" "},{"type":"text","text":"build only when the earlier one sits in a "},{"type":"codeVoice","code":"private"},{"type":"text","text":" or "},{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":" scope, where the decoder and"},{"type":"text","text":" "},{"type":"codeVoice","code":"TrackingPlan()"},{"type":"text","text":" still find it:"}]},{"type":"codeListing","code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var items: Int","    var currency: String","}","","\/\/ Version 1, which releases still installed send.","private enum EarlierVersions {","    @Event(name: \"checkout_started\")","    struct CheckoutStarted {","        var items: Int","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Declare the earlier version’s type at file scope, as above, or ","type":"text"},{"type":"codeVoice","code":"fileprivate"},{"text":" inside another type:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" can’t expand inside a type that is a ","type":"text"},{"type":"codeVoice","code":"private"},{"text":" member of another","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/definingevents","isActive":true},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record at a version the server has no type for is reported as "},{"type":"codeVoice","code":"unknownVersion"},{"type":"text","text":". Apps built with"},{"type":"text","text":" "},{"type":"text","text":"an earlier Traffluent send no version, and the decoder reads such a record at version 1, or at the"},{"type":"text","text":" "},{"type":"text","text":"lowest version it has when it has no version 1. Those apps sent version 1 unless the event declared"},{"type":"text","text":" "},{"type":"text","text":"another. A record one of them sent at a raised version is read at version 1 too: it is reported"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"undecodableProperty"},{"type":"text","text":" when its properties don’t fit that type, and is read as version 1 when"},{"type":"text","text":" "},{"type":"text","text":"they fit."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/DecodedCollectorBatch\/undecodedRecords"},{"type":"text","text":" holds a report of each, an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/UndecodedRecord"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"reason is a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorDecodingError"},{"type":"text","text":". A body that isn’t a collector batch at all throws"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/NotACollectorBatch"},{"type":"text","text":"."}]}]}],"references":{"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchDecoder/batch(from:)":{"kind":"symbol","url":"\/documentation\/collectorencoding\/collectorbatchdecoder\/batch(from:)","ident