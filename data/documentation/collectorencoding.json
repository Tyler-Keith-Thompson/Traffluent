{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/collectorencoding"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},"sections":[],"metadata":{"symbolKind":"module","roleHeading":"Framework","role":"collection","title":"CollectorEncoding","modules":[{"name":"CollectorEncoding"}],"externalID":"CollectorEncoding"},"kind":"symbol","abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send,","type":"text"},{"text":" ","type":"text"},{"text":"and read them back into records on a server.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"],"title":"Records left out","anchor":"Records-left-out"},{"identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/DecodedCollectorBatch","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoderError","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/NotACollectorBatch"],"title":"Decoding batches","anchor":"Decoding-batches"},{"identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/UndecodedRecord","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorDecodingError"],"title":"Records that can’t be read","anchor":"Records-that-cant-be-read"}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder"},{"text":" is the ","type":"text"},{"type":"codeVoice","code":"BatchEncoder"},{"text":" for a self-hosted TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"POST \/v1\/batches"},{"text":". Give it to an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"text":") as its encoder,","type":"text"},{"text":" ","type":"text"},{"text":"and pass the collector’s API key to the destination as an ","type":"text"},{"type":"codeVoice","code":"Authorization: Bearer"},{"text":" header field.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record"},{"type":"text","text":" "},{"type":"text","text":"keeps), the event’s name, its timestamp, whether it is redelivered, its properties and its context."},{"type":"text","text":" "},{"type":"text","text":"Properties are read from the event’s "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" form, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. The context holds the standard"},{"type":"text","text":" "},{"type":"text","text":"context keys the record has values for, its session and sample rate, and its trace context. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is written only while the record reveals it; once redacted, a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"text","text":"property is left out, and an array’s element, or a value inside a type the plan can’t map, is"},{"type":"text","text":" "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and"},{"type":"text","text":" "},{"type":"text","text":"version the plan doesn’t describe, one whose event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one holding a value"},{"type":"text","text":" "},{"type":"text","text":"JSON can’t, such as a NaN, and one whose timestamp has no ISO 8601 form (NaN, infinite, or more"},{"type":"text","text":" "},{"type":"text","text":"than "},{"code":"Int64.max","type":"codeVoice"},{"type":"text","text":" milliseconds from 1970). "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/requests(for:)"},{"type":"text","text":" returns each record left out"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":"), which the destination logs and reports on"},{"type":"text","text":" "},{"type":"text","text":"its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":". When no record of a batch can be written, the destination sends nothing."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)"},{"type":"text","text":" returns the same body and skipped records without a"},{"type":"text","text":" "},{"type":"text","text":"destination."}]},{"type":"paragraph","inlineContent":[{"text":"To send to a server of your own format, write a ","type":"text"},{"type":"codeVoice","code":"BatchEncoder"},{"text":" of your own. To send to PostHog,","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"type":"codeVoice","code":"PostHogBatchEncoder"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"PostHogEncoding"},{"text":").","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference"},{"text":" ","type":"text"},{"text":"covers sending to the collector beside the other destinations.","type":"text"}]},{"type":"heading","text":"Reading batches back","anchor":"Reading-batches-back","level":3},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder","isActive":true,"type":"reference"},{"text":" reads a body the encoder wrote back into ","type":"text"},{"code":"EventRecord","type":"codeVoice"},{"text":"s, for a server","type":"text"},{"text":" ","type":"text"},{"text":"that receives an app’s batches and hands them to another destination, such as a relay in front","type":"text"},{"text":" ","type":"text"},{"text":"of Google Analytics. Make it with the plan the app’s encoder was made with. It finds each record’s","type":"text"},{"text":" ","type":"text"},{"text":"event type by name among the ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":"s the server links, or among the types you list","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder\/init(plan:events:instrument:)","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import CollectorEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let decoder = try CollectorBatchDecoder(plan: plan)","let batch = try decoder.batch(from: body)  \/\/ a body CollectorBatchEncoder wrote","await destination.receive(batch.records)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each record keeps its identifier, timestamp (to the millisecond), event, redelivery flag and the"},{"type":"text","text":" "},{"type":"text","text":"context the body holds: its session’s "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", its sample rate, the standard context and its"},{"type":"text","text":" "},{"type":"text","text":"trace context, which the decoder’s instrument extracts. Encoding the records again with an encoder"},{"type":"text","text":" "},{"type":"text","text":"of the same plan writes the same bytes. A record the decoder can’t read is left out and the rest"},{"type":"text","text":" "},{"type":"text","text":"are read: one of an event it has no type of, or whose type’s version the plan doesn’t describe, one"},{"type":"text","text":" "},{"type":"text","text":"missing a member or holding what the encoder never writes, and one with a property the event’s"},{"type":"text","text":" "},{"type":"text","text":"type can’t read: a required "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" property a delivery redacted, an array of non-optional"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" elements it redacted, or an integer outside its property’s type."}]},{"type":"paragraph","inlineContent":[{"text":"The body names each record’s event but not its version, so a record is read at the version of the","type":"text"},{"text":" ","type":"text"},{"text":"decoder’s type of that name. Deploy the server with the event types the apps send. Once an event’s","type":"text"},{"text":" ","type":"text"},{"text":"version is raised, a record from an app still at the earlier version is read as the newer one:","type":"text"},{"text":" ","type":"text"},{"text":"reported as ","type":"text"},{"code":"undecodableProperty","type":"codeVoice"},{"text":" when its properties don’t fit the newer type, and read as the","type":"text"},{"text":" ","type":"text"},{"text":"newer version when they do.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/DecodedCollectorBatch\/undecodedRecords"},{"text":" holds a report of each, an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/UndecodedRecord"},{"text":" whose","type":"text"},{"text":" ","type":"text"},{"text":"reason is a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorDecodingError"},{"text":". A body that isn’t a collector batch at all throws","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/NotACollectorBatch"},{"text":".","type":"text"}]}]}],"references":{"doc://CollectorEncoding/documentation/CollectorEncoding/DecodedCollectorBatch/undecodedRecords":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"undecodedRecords","kind":"identifier"},{"text":": [","kind":"text"},{"text":"UndecodedRecord","preciseIdentifier":"s:17CollectorEncoding15UndecodedRecordV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","abstract":[