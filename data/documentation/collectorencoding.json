ue,"type":"reference"},{"type":"text","text":" encodes it: the body of the records it could"},{"type":"text","text":" "},{"type":"text","text":"encode, and the records it left out."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CollectorBatch"}],"kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch","navigatorTitle":[{"kind":"identifier","text":"CollectorBatch"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"type":"topic","url":"\/documentation\/httpdestinations\/batchencoder","title":"BatchEncoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}]}}}