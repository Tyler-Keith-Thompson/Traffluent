lectorBatchEncoder\/encode(_:)"},{"text":" ","type":"text"},{"text":"throws the first one’s, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for the batch and logs the error.","type":"text"}],"url":"\/documentation\/collectorencoding\/collectorencodingerror","title":"CollectorEncodingError","kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError","type":"topic"},"doc://CollectorEncoding/documentation/CollectorEncoding/SkippedRecord":{"type":"topic","role":"symbol","navigatorTitle":[{"text":"SkippedRecord","kind":"identifier"}],"title":"SkippedRecord","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkippedRecord","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A record ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true,"type":"reference"},{"text":" left out of a batch’s body, and why.","type":"text"}],"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/SkippedRecord","url":"\/documentation\/collectorencoding\/skippedrecord"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"type":"topic","role":"collection","title":"CollectorEncoding","kind":"symbol","abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","url":"\/documentation\/collectorencoding"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatch":{"kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch","abstract":[{"type":"text","text":"A batch as "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","type":"reference","