{"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"CollectorEncoding"}],"roleHeading":"Framework","role":"collection","title":"CollectorEncoding","symbolKind":"module","externalID":"CollectorEncoding"},"abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"kind":"symbol","identifier":{"url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"title":"Encoding batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"],"anchor":"Encoding-batches"},{"title":"Records left out","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"],"anchor":"Records-left-out"}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" is the "},{"code":"BatchEncoder","type":"codeVoice"},{"type":"text","text":" for a self-hosted TraffluentCollector’s"},{"type":"text","text":" "},{"code":"POST \/v1\/batches","type":"codeVoice"},{"type":"text","text":". Give it to an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"type":"text","text":") as its encoder,"},{"type":"text","text":" "},{"type":"text","text":"and pass the collector’s API key to the destination as an "},{"code":"Authorization: Bearer","type":"codeVoice"},{"type":"text","text":" header field."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record"},{"type":"text","text":" "},{"type":"text","text":"keeps), the event’s name, its timestamp, whether it is redelivered, its properties and its context."},{"type":"text","text":" "},{"type":"text","text":"Properties are read from the event’s "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" form, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. The context holds the standard"},{"type":"text","text":" "},{"type":"text","text":"context keys the record has values for, its session and sample rate, and its trace context. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is written only while the record reveals it; once redacted, a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"text","text":"property is left out, and an array’s element, or a value inside a type the plan can’t map, is"},{"type":"text","text":" "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and"},{"type":"text","text":" "},{"type":"text","text":"version the plan doesn’t describe, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", and one holding a value"},{"type":"text","text":" "},{"type":"text","text":"JSON can’t, such as a NaN. "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns each record left out"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":"), which the destination logs and reports on"},{"type":"text","text":" "},{"type":"text","text":"its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":". When no record of a batch can be written, the destination sends nothing."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","isActive":true},{"type":"text","text":" returns the same body and skipped records without a"},{"type":"text","text":" "},{"type":"text","text":"destination."}]},{"type":"paragraph","inlineContent":[{"text":"To send to a server of your own format, write a ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" of your own. To send to PostHog,","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"code":"PostHogBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"codeListing","code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers sending to the collector beside the other destinations.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/collectorencoding"]}],"sections":[],"references":{"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder":{"url":"\/documentation\/collectorencoding\/collectorbatchencoder","title":"CollectorBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CollectorBatchEncoder","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of TraffluentCollector’s ingest format, so an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send to a self-hosted collector’s "},{"type":"codeVoice","code":"POST \/v1\/batches"},{"type":"text","text":"."}],"role":"symbol","type":"topic","navigatorTitle":[{"text":"CollectorBatchEncoder","kind":"identifier"}],"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","url":"\/documentation\/httpdestinations","kind":"symbol","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"role":"collection","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatch":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/collectorencoding\/collectorbatch","title":"CollectorBatch","abstract":[{"type":"text","text":"A batch as "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","type":"reference","isActive":true},{"type":"text","text":" encodes it: the body of the records it could"},{"type":"text","text":" "},{"type":"text","text":"encode, and the records it left out."}],"navigatorTitle":[{"kind":"identifier","text":"CollectorBatch"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CollectorBatch"}],"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder/batch(of:)":{"title":"batch(of:)","url":"\/documentation\/collectorencoding\/collectorbatchencoder\/batch(of:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:17CollectorEncoding0A5BatchV","text":"CollectorBatch"}],"kind":"symbol","abstract":[{"type":"text","text":"The body of "},{"code":"batch","type":"codeVoice"},{"type":"text","text":" in TraffluentCollector’s ingest format, and the records left out of it."}],"role":"symbol","type":"topic","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" to send."}],"type":"topic","kind":"symbol","title":"CollectorEncoding","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","role":"collection","url":"\/documentation\/collectorencoding"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/httpdestinations\/batchencoder","title":"BatchE