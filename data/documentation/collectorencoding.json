{"metadata":{"modules":[{"name":"CollectorEncoding"}],"symbolKind":"module","roleHeading":"Framework","externalID":"CollectorEncoding","title":"CollectorEncoding","role":"collection"},"abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},"topicSections":[{"anchor":"Encoding-batches","title":"Encoding batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"]},{"anchor":"Records-left-out","title":"Records left out","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"]}],"kind":"symbol","primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" for a self-hosted TraffluentCollector’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/v1\/batches"},{"type":"text","text":". Give it to an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":") as its encoder,"},{"type":"text","text":" "},{"type":"text","text":"and pass the collector’s API key to the destination as an "},{"type":"codeVoice","code":"Authorization: Bearer"},{"type":"text","text":" header field."}]},{"type":"paragraph","inlineContent":[{"text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record","type":"text"},{"text":" ","type":"text"},{"text":"keeps), the event’s name, its timestamp, whether it is redelivered, its properties and its context.","type":"text"},{"text":" ","type":"text"},{"text":"Properties are read from the event’s ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":" form, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" derives, through the","type":"text"},{"text":" ","type":"text"},{"text":"event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is made with. The context holds the standard","type":"text"},{"text":" ","type":"text"},{"text":"context keys the record has values for, its session and sample rate, and its trace context. A","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is written only while the record reveals it; once redacted, a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property is left out, and an array’s element, or a value inside a type the plan can’t map, is","type":"text"},{"text":" ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and","type":"text"},{"text":" ","type":"text"},{"text":"version the plan doesn’t describe, one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one holding a value","type":"text"},{"text":" ","type":"text"},{"text":"JSON can’t, such as a NaN, and one whose timestamp has no ISO 8601 form (NaN, infinite, or more","type":"text"},{"text":" ","type":"text"},{"text":"than ","type":"text"},{"type":"codeVoice","code":"Int64.max"},{"text":" milliseconds from 1970). ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/requests(for:)"},{"text":" returns each record left out","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":" (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"text":"), which the destination logs and reports on","type":"text"},{"text":" ","type":"text"},{"text":"its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":". When no record of a batch can be written, the destination sends nothing.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)"},{"text":" returns the same body and skipped records without a","type":"text"},{"text":" ","type":"text"},{"text":"destination.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To send to a server of your own format, write a ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" of your own. To send to PostHog,","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"code":"PostHogBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":").","type":"text"}]},{"code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"text":" ","type":"text"},{"text":"covers sending to the collector beside the other destinations.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/collectorencoding"]}],"sections":[],"hierarchy":{"paths":[[]]},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"type":"topic","url":"\/documentation\/httpdestinations\/batchencoder","title":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"type":"text","text":" sends."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","kind":"symbol","role":"collection","type":"topic","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"url":"\/documentation\/httpdestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorEncodingError":{"type":"topic","title":"CollectorEncodingError","url":"\/documentation\/collectorencoding\/collectorencodingerror","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CollectorEncodingError","kind":"identifier"}],"abstract":[{"text":"Why ","type":"text"},{"identifie