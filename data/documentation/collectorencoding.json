chEncoder\/encode(_:)","kind":"symbol","abstract":[{"type":"text","text":"The request body for "},{"code":"batch","type":"codeVoice"},{"type":"text","text":": its records in TraffluentCollector’s ingest format, but for"},{"type":"text","text":" "},{"type":"text","text":"those it can’t encode, which are logged at error level and left out."}],"role":"symbol","title":"encode(_:)","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"url":"\/documentation\/httpdestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","title":"HTTPDestinations","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"kind":"symbol","role":"collection","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"abstract":[{"type":"text","text":"What turns a batch of records into the body of the request "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"kind":"symbol","title":"BatchEncoder","role":"symbol","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder/batch(of:)":{"type":"topic","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","title":"batch(of:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:17CollectorEncoding0A5BatchV","text":"CollectorBatch"}],"abstract":[{"code":"batch","type":"codeVoice"},{"type":"text","text":" encoded as "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/encode(_:)","isActive":true},{"type":"text","text":" encodes it, with the records left out of the body."}],"kind":"symbol","role":"symbol","url":"\/documentation\/collectorencoding\/collectorbatchencoder\/batch(of:)"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CollectorBatchEncoder"}],"kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","url":"\/documentation\/collectorencoding\/collectorbatchencoder","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of TraffluentCollector’s ingest format, so an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send to a self-hosted collector’s "},{"type":"codeVoice","code":"POST \/v1\/batches"},{"type":"text","text":"."}],"role":"symbol","type":"topic","title":"CollectorBatchEncoder","navigatorTitle":[{"kind":"identifier","text":"CollectorBatchEncoder"}]},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorEncodingError":{"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CollectorEncodingError","kind":"identifier"}],"url":"\/documentation\/collectorencoding\/collectorencodingerror","navigatorTitle":[{"text":"CollectorEncodingError","kind":"identifier"}],"role":"symbol","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t encode a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"body as a ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/SkippedRecord","isActive":true,"type":"reference"},{"text":". When it can encode no record of a batch, ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/encode(_:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"throws the first one’s, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch and logs the error.","type":"text"}],"title":"CollectorEncodingError","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError","type":"topic"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatch":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CollectorBatch"}],"url":"\/documentation\/collectorencoding\/collectorbatch","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch","kind":"symbol","abstract":[{"type":"text","text":"A batch as "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","isActive":true},{"type":"text","text":" encodes it: the body of the records it could"},{"type":"text","text":" "},{"type":"text","text":"encode, and the records it left out."}],"role":"symbol","title":"CollectorBatch","type":"topic","navigatorTitle":[{"kind":"identifier","text":"CollectorBatch"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/cho