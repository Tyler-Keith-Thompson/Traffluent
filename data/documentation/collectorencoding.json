: the body of the records it could"},{"type":"text","text":" "},{"type":"text","text":"encode, and the records it left out."}],"navigatorTitle":[{"text":"CollectorBatch","kind":"identifier"}]},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorEncodingError":{"title":"CollectorEncodingError","kind":"symbol","type":"topic","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CollectorEncodingError"}],"role":"symbol","url":"\/documentation\/collectorencoding\/collectorencodingerror","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t encode a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"request as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"CollectorEncodingError"}]}}}