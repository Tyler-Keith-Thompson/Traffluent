{"hierarchy":{"paths":[[]]},"topicSections":[{"anchor":"Encoding-batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"],"title":"Encoding batches"},{"anchor":"Records-left-out","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/SkippedRecord","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"],"title":"Records left out"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","type":"reference","isActive":true},{"type":"text","text":" is the "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" for a self-hosted TraffluentCollector’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/v1\/batches"},{"type":"text","text":". Give it to an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"type":"text","text":") as its encoder,"},{"type":"text","text":" "},{"type":"text","text":"and pass the collector’s API key to the destination as an "},{"type":"codeVoice","code":"Authorization: Bearer"},{"type":"text","text":" header field."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record"},{"type":"text","text":" "},{"type":"text","text":"keeps), the event’s name, its timestamp, whether it is redelivered, its properties and its context."},{"type":"text","text":" "},{"type":"text","text":"Properties are read from the event’s "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":" form, which "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"event’s schema in the "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" the encoder is made with. The context holds the standard"},{"type":"text","text":" "},{"type":"text","text":"context keys the record has values for, its session and sample rate, and its trace context. A"},{"type":"text","text":" "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is written only while the record reveals it; once redacted, a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"property is left out, and an array’s element, or a value inside a type the plan can’t map, is"},{"type":"text","text":" "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and","type":"text"},{"text":" ","type":"text"},{"text":"version the plan doesn’t describe, one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", and one holding a value","type":"text"},{"text":" ","type":"text"},{"text":"JSON can’t, such as a NaN. Each is logged; ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","isActive":true,"type":"reference"},{"text":" returns the body","type":"text"},{"text":" ","type":"text"},{"text":"with each record left out as a ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/SkippedRecord","isActive":true,"type":"reference"},{"text":". When no record of a batch can be written,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/encode(_:)","isActive":true,"type":"reference"},{"text":" throws, and the destination sends nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To send to a server of your own format, write a ","type":"text"},{"type":"codeVoice","code":"BatchEncoder"},{"text":" of your own. To send to PostHog,","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"type":"codeVoice","code":"PostHogBatchEncoder"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"PostHogEncoding"},{"text":").","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan(schemas: [SignedUp.schema])","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"],"type":"codeListing"},{"inlineContent":[{"text":"The guide ","type":"text"},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"text":" ","type":"text"},{"text":"covers sending to the collector beside the other destinations.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},"abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/collectorencoding"]}],"metadata":{"role":"collection","externalID":"CollectorEncoding","symbolKind":"module","title":"CollectorEncoding","modules":[{"name":"CollectorEncoding"}],"roleHeading":"Framework"},"sections":[],"references":{"do