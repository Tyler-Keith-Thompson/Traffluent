{"kind":"symbol","sections":[],"metadata":{"modules":[{"name":"CollectorEncoding"}],"role":"collection","roleHeading":"Framework","title":"CollectorEncoding","externalID":"CollectorEncoding","symbolKind":"module"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","type":"reference","isActive":true},{"text":" is the ","type":"text"},{"type":"codeVoice","code":"BatchEncoder"},{"text":" for a self-hosted TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"POST \/v1\/batches"},{"text":". Give it to an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"text":") as its encoder,","type":"text"},{"text":" ","type":"text"},{"text":"and pass the collector’s API key to the destination as an ","type":"text"},{"type":"codeVoice","code":"Authorization: Bearer"},{"text":" header field.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record","type":"text"},{"text":" ","type":"text"},{"text":"keeps), the event’s name, its timestamp, whether it is redelivered, its properties and its context.","type":"text"},{"text":" ","type":"text"},{"text":"Properties are read from the event’s ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":" form, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" derives, through the","type":"text"},{"text":" ","type":"text"},{"text":"event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is made with. The context holds the standard","type":"text"},{"text":" ","type":"text"},{"text":"context keys the record has values for, its session and sample rate, and its trace context. A","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is written only while the record reveals it; once redacted, a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property is left out, and an array’s element, or a value inside a type the plan can’t map, is","type":"text"},{"text":" ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and"},{"type":"text","text":" "},{"type":"text","text":"version the plan doesn’t describe, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", and one holding a value"},{"type":"text","text":" "},{"type":"text","text":"JSON can’t, such as a NaN. "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"type":"text","text":" returns each record left out"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"type":"text","text":"), which the destination logs and reports on"},{"type":"text","text":" "},{"type":"text","text":"its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":". When no record of a batch can be written, the destination sends nothing."},{"type":"text","text":" "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","type":"reference","isActive":true},{"type":"text","text":" returns the same body and skipped records without a"},{"type":"text","text":" "},{"type":"text","text":"destination."}],"type":"paragraph"},{"inlineContent":[{"text":"To send to a server of your own format, write a ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" of your own. To send to PostHog,","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"code":"PostHogBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"]},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers sending to the collector beside the other destinations."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/collectorencoding"]}],"topicSections":[{"title":"Encoding batches","anchor":"Encoding-batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"]},{"title":"Records left out","anchor":"Records-left-out","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"]}],"abstract":[{"type":"text","t