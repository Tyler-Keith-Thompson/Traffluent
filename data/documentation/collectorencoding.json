{"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},"abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"topicSections":[{"anchor":"Encoding-batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"],"title":"Encoding batches"},{"anchor":"Records-left-out","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/SkippedRecord","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"],"title":"Records left out"}],"sections":[],"kind":"symbol","metadata":{"roleHeading":"Framework","symbolKind":"module","modules":[{"name":"CollectorEncoding"}],"role":"collection","title":"CollectorEncoding","externalID":"CollectorEncoding"},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true,"type":"reference"},{"text":" is the ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" for a self-hosted TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"code":"POST \/v1\/batches","type":"codeVoice"},{"text":". Give it to an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"text":") as its encoder,","type":"text"},{"text":" ","type":"text"},{"text":"and pass the collector’s API key to the destination as an ","type":"text"},{"code":"Authorization: Bearer","type":"codeVoice"},{"text":" header field.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record"},{"type":"text","text":" "},{"type":"text","text":"keeps), the event’s name, its timestamp, whether it is redelivered, its properties and its context."},{"type":"text","text":" "},{"type":"text","text":"Properties are read from the event’s "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" form, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. The context holds the standard"},{"type":"text","text":" "},{"type":"text","text":"context keys the record has values for, its session and sample rate, and its trace context. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is written only while the record reveals it."}],"type":"paragraph"},{"inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and","type":"text"},{"text":" ","type":"text"},{"text":"version the plan doesn’t describe, one whose event isn’t ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":", and one holding a value","type":"text"},{"text":" ","type":"text"},{"text":"JSON can’t, such as a NaN. Each is logged; ","type":"text"},{"isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","type":"reference"},{"text":" returns the body","type":"text"},{"text":" ","type":"text"},{"text":"with each record left out as a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/SkippedRecord","type":"reference"},{"text":". When no record of a batch can be written,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/encode(_:)","type":"reference"},{"text":" throws, and the destination sends nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To send to a server of your own format, write a "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" of your own. To send to PostHog,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"PostHogBatchEncoder"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":")."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan(schemas: [SignedUp.schema])","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"]},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers sending to the collector beside the other destinations."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/collectorencoding"]}],"references":{"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder/encode(_:)":{"role":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/encode(_:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":"