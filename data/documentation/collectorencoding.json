{"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"symbolKind":"module","roleHeading":"Framework","modules":[{"name":"CollectorEncoding"}],"role":"collection","title":"CollectorEncoding","externalID":"CollectorEncoding"},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"],"title":"Records left out","anchor":"Records-left-out"}],"abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" to send."}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" for a self-hosted TraffluentCollector’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/v1\/batches"},{"type":"text","text":". Give it to an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":") as its encoder,"},{"type":"text","text":" "},{"type":"text","text":"and pass the collector’s API key to the destination as an "},{"type":"codeVoice","code":"Authorization: Bearer"},{"type":"text","text":" header field."}]},{"type":"paragraph","inlineContent":[{"text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record","type":"text"},{"text":" ","type":"text"},{"text":"keeps), the event’s name, its timestamp, whether it is redelivered, its properties and its context.","type":"text"},{"text":" ","type":"text"},{"text":"Properties are read from the event’s ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":" form, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" derives, through the","type":"text"},{"text":" ","type":"text"},{"text":"event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is made with. The context holds the standard","type":"text"},{"text":" ","type":"text"},{"text":"context keys the record has values for, its session and sample rate, and its trace context. A","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is written only while the record reveals it; once redacted, a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property is left out, and an array’s element, or a value inside a type the plan can’t map, is","type":"text"},{"text":" ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and"},{"type":"text","text":" "},{"type":"text","text":"version the plan doesn’t describe, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", and one holding a value"},{"type":"text","text":" "},{"type":"text","text":"JSON can’t, such as a NaN. "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns each record left out"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":"), which the destination logs and reports on"},{"type":"text","text":" "},{"type":"text","text":"its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":". When no record of a batch can be written, the destination sends nothing."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","isActive":true},{"type":"text","text":" returns the same body and skipped records without a"},{"type":"text","text":" "},{"type":"text","text":"destination."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to a server of your own format, write a "},{"code":"BatchEncoder","type":"codeVoice"},{"type":"text","text":" of your own. To send to PostHog,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"code":"PostHogBatchEncoder","type":"codeVoice"},{"type":"text","text":" (module "},{"code":"PostHogEncoding","type":"codeVoice"},{"type":"text","text":")."}]},{"type":"codeListing","syntax":"swift","code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers sending to the collector beside the other destinations."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/collectorencoding"]}],"sections":[],"references":{"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CollectorBatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"CollectorBatchEncoder"}],"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of TraffluentCollector’s ingest format, so an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can send to a self-hosted collector’s ","type":"text"},{"code":"POST \/v1\/batches","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","url":"\/documentation\/collectorencoding\/collectorbatchencoder","title":"CollectorBatchEncoder","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"role":"collection","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"title":"HTTPDestinations","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic","url":"\/documentation\/httpdestinations"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Write batches of records in TraffluentCollector’s ingest format, for an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" to send."}],"url":"\/documentation\/collectorencoding","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","type":"topic","title":"CollectorEncodi