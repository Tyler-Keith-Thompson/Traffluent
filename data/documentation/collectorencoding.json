:"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t encode a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"request as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CollectorEncodingError"}]},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatch":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CollectorBatch","kind":"identifier"}],"title":"CollectorBatch","url":"\/documentation\/collectorencoding\/collectorbatch","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch","abstract":[{"text":"A batch as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","type":"reference"},{"text":" encodes it: the body of the records it could","type":"text"},{"text":" ","type":"text"},{"text":"encode, and the records it left out.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"CollectorBatch","kind":"identifier"}]}}}