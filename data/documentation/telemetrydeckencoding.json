{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"TelemetryDeckEncoding","symbolKind":"module","title":"TelemetryDeckEncoding","modules":[{"name":"TelemetryDeckEncoding"}],"role":"collection","roleHeading":"Framework"},"identifier":{"url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","type":"reference"},{"text":" ","type":"text"},{"text":"makes an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference"},{"text":") for TelemetryDeck in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the app ID and your organization’s namespace, then posts to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"https:\/\/nom.telemetrydeck.com\/v3\/<namespace>\/"},{"text":" with a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","type":"reference"},{"text":". Each batch is","type":"text"},{"text":" ","type":"text"},{"text":"split to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","type":"reference"},{"text":": 100 signals a request, as TelemetryDeck’s","type":"text"},{"text":" ","type":"text"},{"text":"SwiftSDK sends them; 333,333 bytes a signal, a third of Ingest API v3’s limit of 1,000,000; and","type":"text"},{"text":" ","type":"text"},{"text":"1,000,000 bytes a request, the encoder’s own bound, as TelemetryDeck documents none. A batch with no record the encoder can write, an empty one included, makes","type":"text"},{"text":" ","type":"text"},{"text":"no request. The destination retries no response, a 5xx (TelemetryDeck answers 503 while its queue","type":"text"},{"text":" ","type":"text"},{"text":"is full), 408 and 429, and drops and reports any other status. No trace context is sent.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves this module out, so import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The app ID only says which app a signal belongs to, and TelemetryDeck’s own SDKs ship it inside","type":"text"},{"text":" ","type":"text"},{"text":"every app, so the destination builds on every platform and an app sends to TelemetryDeck directly.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","import TelemetryDeckEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: telemetryDeck)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The factory throws "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError","isActive":true},{"type":"text","text":" for an app ID that is empty or only whitespace,"},{"type":"text","text":" "},{"type":"text","text":"and for a namespace TelemetryDeck doesn’t take. A namespace holds only ASCII letters, digits, "},{"type":"codeVoice","code":"."},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"_"},{"type":"text","text":" and "},{"type":"codeVoice","code":"-"},{"type":"text","text":", and can’t be "},{"type":"codeVoice","code":"w"},{"type":"text","text":", "},{"type":"codeVoice","code":"."},{"type":"text","text":" or "},{"type":"codeVoice","code":".."},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"code":"testMode","type":"codeVoice"},{"text":" has no default. TelemetryDeck shows test signals only in its Test Mode, apart from your","type":"text"},{"text":" ","type":"text"},{"text":"real users, and its SDK picks test mode for debug builds. Pass whatever your app uses to tell its","type":"text"},{"text":" ","type":"text"},{"text":"builds apart, such as ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" under ","type":"text"},{"code":"#if DEBUG","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" otherwise.","type":"text"}]},{"type":"heading","level":3,"text":"User counts are sessions","anchor":"User-counts-are-sessions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TelemetryDeck counts users by "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":". The destination sends the record’s session, from the"},{"type":"text","text":" "},{"type":"text","text":"sessions enricher, as "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":", hashed the way TelemetryDeck’s SDKs hash a user identifier:"},{"type":"text","text":" "},{"type":"text","text":"SHA-256 of the lowercase UUID, in lowercase hex, with the SDKs’ default, empty salt."},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck salts and hashes "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":" again on its server. The same session is also the"},{"type":"text","text":" "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":", in the clear, so a salt of the app’s own would hide nothing, and the destination takes"},{"type":"text","text":" "},{"type":"text","text":"none. Nothing else identifies a record: no vendor identifier, device identifier or"},{"type":"text","text":" "},{"type":"text","text":"account, and no trace context."}]},{"type":"paragraph","inlineContent":[{"text":"So TelemetryDeck’s user counts are session counts. A person who opens the app three times is three","type":"text"},{"text":" ","type":"text"},{"text":"users, and its retention charts show how long a session lasts, not whether people come back. That","type":"text"},{"text":" ","type":"text"},{"text":"is the library’s default, for privacy. To count devices instead, put","type":"text"},{"text":" ","type":"text"},{"code":"StandardContext","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"VendorIdentifierKey","type":"codeVoice"},{"text":" in the records’ context and send them through a","type":"text"},{"text":" ","type":"text"},{"text":"destination that reads it, or write your own enricher and encoder that send the identifier you","type":"text"},{"text":" ","type":"text"},{"text":"choose. This encoder sends the session alone.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A record with no session, from a tracker without the sessions enricher, is its own user: its","type":"text"},{"text":" ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" is the hash of the record’s identifier, and it has no ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":". A record a store","type":"text"},{"text":" ","type":"text"},{"text":"recovered after a relaunch keeps its session, and with it the ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":" of its","type":"text"},{"text":" ","type":"text"},{"text":"first send. Making up a session","type":"text"},{"text":" ","type":"text"},{"text":"would join unrelated records, and skipping the record would lose it.","type":"text"}]},{"type":"heading","level":3,"text":"What TelemetryDeck receives","anchor":"What-TelemetryDeck-receives"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each request is a JSON array of signals, one per record. Every signal has:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"appID","type":"codeVoice"},{"text":", as given, without surrounding whitespace;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"type","type":"codeVoice"},{"text":", the event’s name;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"clientUser"},{"type":"text","text":", the hashed session, and "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":", the session;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"receivedAt","type":"codeVoice"},{"text":", the record’s timestamp in ISO 8601 with milliseconds, so a signal sent late still","type":"text"},{"text":" ","type":"text"},{"text":"counts at the time it was tracked;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isTestMode"},{"type":"text","text":", "},{"type":"codeVoice","code":"\"true\""},{"type":"text","text":" or "},{"type":"codeVoice","code":"\"false\""},{"type":"text","text":";"}]}]},{"content":[{"inlineContent":[{"code":"TelemetryDeck.SDK.name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Traffluent","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is"},{"type":"text","text":" "},{"type":"text","text":"made with, and sit beside these, each keeping its JSON type. TelemetryDeck doesn’t index nested"},{"type":"text","text":" "},{"type":"text","text":"values, so an object or array is flattened into dotted names: a "},{"type":"codeVoice","code":"cart"},{"type":"text","text":" holding "},{"type":"codeVoice","code":"size"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", and the first element of "},{"type":"codeVoice","code":"tags"},{"type":"text","text":" is "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":". A "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" property is left out. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals. No "},{"type":"codeVoice","code":"floatValue"},{"type":"text","text":" is sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context, when the record has it, becomes TelemetryDeck’s built-in parameters:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Context"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parameters"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.AppInfo.version","type":"codeVoice"},{"type":"text","text":", "},{"code":".buildNumber","type":"codeVoice"},{"type":"text","text":" and "},{"code":".versionAndBuildNumber","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.Device.modelName","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.Device.operatingSystem","type":"codeVoice"},{"text":", ","type":"text"},{"code":".platform","type":"codeVoice"},{"text":", ","type":"text"},{"code":".systemVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":".systemMajorVersion","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".systemMajorMinorVersion","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.RunContext.locale","type":"codeVoice"},{"type":"text","text":" and "},{"code":".language","type":"codeVoice"},{"type":"text","text":", and "},{"code":"TelemetryDeck.UserPreference.region","type":"codeVoice"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The bundle identifier, the form factor and the network aren’t sent.","type":"text"}]},{"type":"heading","level":3,"text":"Records left out","anchor":"Records-left-out"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"one the plan doesn’t describe, whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", or that holds a value JSON can’t;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose event name or parameter name, once flattened, holds anything but ASCII letters, digits,"},{"type":"text","text":" "},{"code":".","type":"codeVoice"},{"type":"text","text":", "},{"code":"_","type":"codeVoice"},{"type":"text","text":" and "},{"code":"-","type":"codeVoice"},{"type":"text","text":", or is empty. TelemetryDeck refuses the whole request for one such name."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose event name or parameter name starts with ","type":"text"},{"code":"TelemetryDeck.","type":"codeVoice"},{"text":", in any case: TelemetryDeck","type":"text"},{"text":" ","type":"text"},{"text":"reserves that scope for its SDKs’ parameters and its server’s;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one with a parameter named as one of a signal’s own members, "},{"type":"codeVoice","code":"appID"},{"type":"text","text":", "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"receivedAt"},{"type":"text","text":", "},{"type":"codeVoice","code":"type"},{"type":"text","text":", "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":", "},{"type":"codeVoice","code":"isTestMode"},{"type":"text","text":" or "},{"type":"codeVoice","code":"floatValue"},{"type":"text","text":", spelled exactly so: in the flat"},{"type":"text","text":" "},{"type":"text","text":"signal it would replace the member. A name like one in another case, such as "},{"type":"codeVoice","code":"Type"},{"type":"text","text":", is sent."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose values flatten to the same name twice;","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"one whose timestamp falls outside the years 1 to 9999, which TelemetryDeck can’t parse;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose JSON is over 333,333 bytes. TelemetryDeck refuses the whole request for a signal over"},{"type":"text","text":" "},{"type":"text","text":"1,000,000 bytes as its server writes it, which may be larger than the encoder’s; a third leaves"},{"type":"text","text":" "},{"type":"text","text":"room for the escapes a re-encoder commonly adds."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination reports each as "},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"type":"text","text":", a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" whose reason is a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"},{"type":"text","text":". When the destination is made, it logs a notice for each event and"},{"type":"text","text":" "},{"type":"text","text":"property of the plan whose name would be left out."}]},{"type":"heading","level":3,"text":"What TelemetryDeck doesn’t report","anchor":"What-TelemetryDeck-doesnt-report"},{"type":"paragraph","inlineContent":[{"text":"TelemetryDeck answers 200 to any namespace and any app ID it can read, so a typo in either loses","type":"text"},{"text":" ","type":"text"},{"text":"every signal without an error. Check that the first signals show up in the dashboard, in Test Mode","type":"text"},{"text":" ","type":"text"},{"text":"when ","type":"text"},{"code":"testMode","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"TelemetryDeck doesn’t remove duplicates. A record is sent more than once when a request is retried"},{"type":"text","text":" "},{"type":"text","text":"after TelemetryDeck stored it but the answer was lost, when a delivery sends a cancelled batch"},{"type":"text","text":" "},{"type":"text","text":"again, and when a store redelivers records after a relaunch, and TelemetryDeck counts each copy."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers what TelemetryDeck receives, and why, in more detail."}]}]}],"hierarchy":{"paths":[[]]},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding"]}],"abstract":[{"type":"text","text":"Send records to TelemetryDeck as signals, through its Ingest API v3."}],"topicSections":[{"title":"Sending to TelemetryDeck","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError"],"anchor":"Sending-to-TelemetryDeck"},{"title":"Encoding batches","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"],"anchor":"Encoding-batches"},{"title":"Records left out","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"],"anchor":"Records-left-out"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations":{"role":"collection","url":"\/documentation\/httpdestinations","type":"topic","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"title":"HTTPDestinations"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of TelemetryDeck’s Ingest API v3, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"can send events to an organization’s ","type":"text"},{"code":"POST \/v3\/<namespace>\/","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","type":"topic","kind":"symbol","title":"TelemetryDeckBatchEncoder","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"url":"\/documentation\/httpdestinations\/batchencoder","role":"symbol","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"type":"text","text":" sends."}],"title":"BatchEncoder","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/init(appID:testMode:plan:limit:)":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An encoder of the events "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, for the TelemetryDeck app "},{"type":"codeVoice","code":"appID"},{"type":"text","text":", marking every"},{"type":"text","text":" "},{"type":"text","text":"event as a test event or not as "},{"type":"codeVoice","code":"testMode"},{"type":"text","text":" says,"},{"type":"text","text":" "},{"type":"text","text":"and splitting each batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"testMode","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:21TelemetryDeckEncoding0aB10SetupErrorO","text":"TelemetryDeckSetupError","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/init(appid:testmode:plan:limit:)","title":"init(appID:testMode:plan:limit:)","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckEncodingError":{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckEncodingError"}],"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckencodingerror","role":"symbol","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for t