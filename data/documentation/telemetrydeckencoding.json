{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Send records to TelemetryDeck as signals, through its Ingest API v3.","type":"text"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding"]}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"makes an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" (module "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference"},{"type":"text","text":") for TelemetryDeck in one call. It checks"},{"type":"text","text":" "},{"type":"text","text":"the app ID and your organization’s namespace, then posts to"},{"type":"text","text":" "},{"code":"https:\/\/nom.telemetrydeck.com\/v3\/<namespace>\/","type":"codeVoice"},{"type":"text","text":" with a "},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","type":"reference"},{"type":"text","text":". Each batch is"},{"type":"text","text":" "},{"type":"text","text":"split to "},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","type":"reference"},{"type":"text","text":": 100 signals a request, as TelemetryDeck’s"},{"type":"text","text":" "},{"type":"text","text":"SwiftSDK sends them; 333,333 bytes a signal, a third of Ingest API v3’s limit of 1,000,000; and"},{"type":"text","text":" "},{"type":"text","text":"1,000,000 bytes a request, the encoder’s own bound, as TelemetryDeck documents none. A batch with no record the encoder can write, an empty one included, makes"},{"type":"text","text":" "},{"type":"text","text":"no request. The destination retries no response, a 5xx (TelemetryDeck answers 503 while its queue"},{"type":"text","text":" "},{"type":"text","text":"is full), 408 and 429, and drops and reports any other status. No trace context is sent."},{"type":"text","text":" "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" leaves this module out, so import it on its own."}]},{"type":"paragraph","inlineContent":[{"text":"The app ID only says which app a signal belongs to, and TelemetryDeck’s own SDKs ship it inside","type":"text"},{"text":" ","type":"text"},{"text":"every app, so the destination builds on every platform and an app sends to TelemetryDeck directly.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import HTTPDestinations","import TelemetryDeckEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: telemetryDeck)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The factory throws "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError","isActive":true},{"type":"text","text":" for an app ID that is empty or only whitespace,"},{"type":"text","text":" "},{"type":"text","text":"and for a namespace TelemetryDeck doesn’t take. A namespace holds only ASCII letters, digits, "},{"type":"codeVoice","code":"."},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"_"},{"type":"text","text":" and "},{"type":"codeVoice","code":"-"},{"type":"text","text":", and can’t be "},{"type":"codeVoice","code":"w"},{"type":"text","text":", "},{"type":"codeVoice","code":"."},{"type":"text","text":" or "},{"type":"codeVoice","code":".."},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"code":"testMode","type":"codeVoice"},{"text":" has no default. TelemetryDeck shows test signals only in its Test Mode, apart from your","type":"text"},{"text":" ","type":"text"},{"text":"real users, and its SDK picks test mode for debug builds. Pass whatever your app uses to tell its","type":"text"},{"text":" ","type":"text"},{"text":"builds apart, such as ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" under ","type":"text"},{"code":"#if DEBUG","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" otherwise.","type":"text"}]},{"level":3,"text":"User counts are sessions","anchor":"User-counts-are-sessions","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TelemetryDeck counts users by "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":". The destination sends the record’s session, from the"},{"type":"text","text":" "},{"type":"text","text":"sessions enricher, as "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":", hashed the way TelemetryDeck’s SDKs hash a user identifier:"},{"type":"text","text":" "},{"type":"text","text":"SHA-256 of the lowercase UUID, in lowercase hex, with the SDKs’ default, empty salt."},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck salts and hashes "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":" again on its server. The same session is also the"},{"type":"text","text":" "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":", in the clear, so a salt of the app’s own would hide nothing, and the destination takes"},{"type":"text","text":" "},{"type":"text","text":"none. Nothing else identifies a record: no vendor identifier, device identifier or"},{"type":"text","text":" "},{"type":"text","text":"account, and no trace context."}]},{"type":"paragraph","inlineContent":[{"text":"So TelemetryDeck’s user counts are session counts. A person who opens the app three times is three","type":"text"},{"text":" ","type":"text"},{"text":"users, and its retention charts show how long a session lasts, not whether people come back. That","type":"text"},{"text":" ","type":"text"},{"text":"is the library’s default, for privacy. To count devices instead, put","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"StandardContext"},{"text":"‘s ","type":"text"},{"type":"codeVoice","code":"VendorIdentifierKey"},{"text":" in the records’ context and send them through a","type":"text"},{"text":" ","type":"text"},{"text":"destination that reads it, or write your own enricher and encoder that send the identifier you","type":"text"},{"text":" ","type":"text"},{"text":"choose. This encoder sends the session alone.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record with no session, such as one a store recovered after a relaunch, is its own user: its"},{"type":"text","text":" "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":" is the hash of the record’s identifier, and it has no "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":". Making up a session"},{"type":"text","text":" "},{"type":"text","text":"would join unrelated records, and skipping the record would lose it."}]},{"level":3,"text":"What TelemetryDeck receives","anchor":"What-TelemetryDeck-receives","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each request is a JSON array of signals, one per record. Every signal has:"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"appID"},{"type":"text","text":", as given, without surrounding whitespace;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"type"},{"type":"text","text":", the event’s name;"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"clientUser"},{"type":"text","text":", the hashed session, and "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":", the session;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"receivedAt"},{"type":"text","text":", the record’s timestamp in ISO 8601 with milliseconds, so a signal sent late still"},{"type":"text","text":" "},{"type":"text","text":"counts at the time it was tracked;"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"isTestMode"},{"type":"text","text":", "},{"type":"codeVoice","code":"\"true\""},{"type":"text","text":" or "},{"type":"codeVoice","code":"\"false\""},{"type":"text","text":";"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.SDK.name"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Traffluent"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s properties are read through the event’s schema in the "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" the encoder is"},{"type":"text","text":" "},{"type":"text","text":"made with, and sit beside these, each keeping its JSON type. TelemetryDeck doesn’t index nested"},{"type":"text","text":" "},{"type":"text","text":"values, so an object or array is flattened into dotted names: a "},{"code":"cart","type":"codeVoice"},{"type":"text","text":" holding "},{"code":"size","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"cart.size","type":"codeVoice"},{"type":"text","text":", and the first element of "},{"code":"tags","type":"codeVoice"},{"type":"text","text":" is "},{"code":"tags.0","type":"codeVoice"},{"type":"text","text":". A "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" property is left out. A"},{"type":"text","text":" "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is never sent, whatever the record reveals. No "},{"code":"floatValue","type":"codeVoice"},{"type":"text","text":" is sent."}]},{"type":"paragraph","inlineContent":[{"text":"The standard context, when the record has it, becomes TelemetryDeck’s built-in parameters:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Context","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parameters"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.version"},{"text":", ","type":"text"},{"type":"codeVoice","code":".buildNumber"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".versionAndBuildNumber"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.modelName"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.operatingSystem"},{"type":"text","text":", "},{"type":"codeVoice","code":".platform"},{"type":"text","text":", "},{"type":"codeVoice","code":".systemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":".systemMajorVersion"},{"type":"text","text":" and "},{"type":"codeVoice","code":".systemMajorMinorVersion"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.RunContext.locale","type":"codeVoice"},{"type":"text","text":" and "},{"code":".language","type":"codeVoice"},{"type":"text","text":", and "},{"code":"TelemetryDeck.UserPreference.region","type":"codeVoice"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The bundle identifier, the form factor and the network aren’t sent."}]},{"level":3,"text":"Records left out","anchor":"Records-left-out","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"one the plan doesn’t describe, whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", or that holds a value JSON can’t;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose event name or parameter name, once flattened, holds anything but ASCII letters, digits,"},{"type":"text","text":" "},{"type":"codeVoice","code":"."},{"type":"text","text":", "},{"type":"codeVoice","code":"_"},{"type":"text","text":" and "},{"type":"codeVoice","code":"-"},{"type":"text","text":", or is empty. TelemetryDeck refuses the whole request for one such name."}]}]},{"content":[{"inlineContent":[{"text":"one whose event name or parameter name starts with ","type":"text"},{"code":"TelemetryDeck.","type":"codeVoice"},{"text":", in any case: TelemetryDeck","type":"text"},{"text":" ","type":"text"},{"text":"reserves that scope for its SDKs’ parameters and its server’s;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one with a parameter named as one of a signal’s own members, ","type":"text"},{"code":"appID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"receivedAt","type":"codeVoice"},{"text":", ","type":"text"},{"code":"type","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isTestMode","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"floatValue","type":"codeVoice"},{"text":", spelled exactly so: in the flat","type":"text"},{"text":" ","type":"text"},{"text":"signal it would replace the member. A name like one in another case, such as ","type":"text"},{"code":"Type","type":"codeVoice"},{"text":", is sent.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose values flatten to the same name twice;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose timestamp falls outside the years 1 to 9999, which TelemetryDeck can’t parse;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose JSON is over 333,333 bytes. TelemetryDeck refuses the whole request for a signal over"},{"type":"text","text":" "},{"type":"text","text":"1,000,000 bytes as its server writes it, which may be larger than the encoder’s; a third leaves"},{"type":"text","text":" "},{"type":"text","text":"room for the escapes a re-encoder commonly adds."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination reports each as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" whose reason is a"},{"type":"text","text":" "},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","type":"reference","isActive":true},{"type":"text","text":". When the destination is made, it logs a notice for each event and"},{"type":"text","text":" "},{"type":"text","text":"property of the plan whose name would be left out."}]},{"level":3,"text":"What TelemetryDeck doesn’t report","anchor":"What-TelemetryDeck-doesnt-report","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"TelemetryDeck answers 200 to any namespace and any app ID it can read, so a typo in either loses","type":"text"},{"text":" ","type":"text"},{"text":"every signal without an error. Check that the first signals show up in the dashboard, in Test Mode","type":"text"},{"text":" ","type":"text"},{"text":"when ","type":"text"},{"code":"testMode","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"TelemetryDeck doesn’t remove duplicates. A record is sent more than once when a request is retried"},{"type":"text","text":" "},{"type":"text","text":"after TelemetryDeck stored it but the answer was lost, when a delivery sends a cancelled batch"},{"type":"text","text":" "},{"type":"text","text":"again, and when a store redelivers records after a relaunch, and TelemetryDeck counts each copy."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers what TelemetryDeck receives, and why, in more detail."}]}]}],"topicSections":[{"anchor":"Sending-to-TelemetryDeck","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError"],"title":"Sending to TelemetryDeck"},{"anchor":"Encoding-batches","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"],"title":"Encoding batches"},{"anchor":"Records-left-out","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"],"title":"Records left out"}],"sections":[],"metadata":{"externalID":"TelemetryDeckEncoding","symbolKind":"module","title":"TelemetryDeckEncoding","modules":[{"name":"TelemetryDeckEncoding"}],"roleHeading":"Framework","role":"collection"},"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"title":"TelemetryDeckBatchEncoder","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder","abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" of TelemetryDeck’s Ingest API v3, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"can send events to an organization’s "},{"code":"POST \/v3\/<namespace>\/","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","role":"symbol","kind":"symbol","type":"topic"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckEncodingError":{"title":"TelemetryDeckEncodingError","type":"topic","kind":"symbol","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckencodingerror","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckEncodingError","kind":"identifier"}],"abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"navigatorTitle":[{"text":"TelemetryDeckEncodingError","kind":"identifier"}],"role":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/init(appID:testMode:plan:limit:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"testMode","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"TelemetryDeckSetupError","preciseIdentifier":"s:21TelemetryDeckEncoding0aB10SetupErrorO","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/init(appid:testmode:plan:limit:)","kind":"symbol","role":"symbol","title":"init(appID:testMode:plan:limit:)","type":"topic","abstract":[{"text":"An encoder of the events ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" describes, for the TelemetryDeck app ","type":"text"},{"type":"codeVoice","code":"appID"},{"text":", marking every","type":"text"},{"text":" ","type":"text"},{"text":"event as a test event or not as ","type":"text"},{"type":"codeVoice","code":"testMode"},{"text":" says,","type":"text"},{"text":" ","type":"text"},{"text":"and splitting each batch to ","type":"text"},{"type":"codeVoice","code":"limit"},{"text":".","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"title":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"role":"symbol","kind":"symbol","type":"topic"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckSetupError":{"abstract":[{"text":"Why ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","type":"reference"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)","type":"