{"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError"],"title":"Sending to TelemetryDeck","anchor":"Sending-to-TelemetryDeck"},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"],"title":"Records left out","anchor":"Records-left-out"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding"]}],"metadata":{"symbolKind":"module","externalID":"TelemetryDeckEncoding","modules":[{"name":"TelemetryDeckEncoding"}],"role":"collection","title":"TelemetryDeckEncoding","roleHeading":"Framework"},"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","type":"reference"},{"text":" ","type":"text"},{"text":"makes an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference"},{"text":") for TelemetryDeck in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the app ID and your organization’s namespace, then posts to","type":"text"},{"text":" ","type":"text"},{"code":"https:\/\/nom.telemetrydeck.com\/v3\/<namespace>\/","type":"codeVoice"},{"text":" with a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","type":"reference"},{"text":". Each batch is","type":"text"},{"text":" ","type":"text"},{"text":"split to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","type":"reference"},{"text":": 100 signals a request, as TelemetryDeck’s","type":"text"},{"text":" ","type":"text"},{"text":"SwiftSDK sends them; 333,333 bytes a signal, a third of Ingest API v3’s limit of 1,000,000; and","type":"text"},{"text":" ","type":"text"},{"text":"1,000,000 bytes a request, the encoder’s own bound, as TelemetryDeck documents none. A batch with no record the encoder can write, an empty one included, makes","type":"text"},{"text":" ","type":"text"},{"text":"no request. The destination retries no response, a 5xx (TelemetryDeck answers 503 while its queue","type":"text"},{"text":" ","type":"text"},{"text":"is full), 408 and 429, and drops and reports any other status. No trace context is sent.","type":"text"},{"text":" ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves this module out, so import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app ID only says which app a signal belongs to, and TelemetryDeck’s own SDKs ship it inside"},{"type":"text","text":" "},{"type":"text","text":"every app, so the destination builds on every platform and an app sends to TelemetryDeck directly."}]},{"type":"codeListing","code":["import HTTPDestinations","import TelemetryDeckEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: telemetryDeck)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The factory throws "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError","isActive":true},{"type":"text","text":" for an app ID that is empty or only whitespace,"},{"type":"text","text":" "},{"type":"text","text":"and for a namespace TelemetryDeck doesn’t take. A namespace holds only ASCII letters, digits, "},{"code":".","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"_","type":"codeVoice"},{"type":"text","text":" and "},{"code":"-","type":"codeVoice"},{"type":"text","text":", and can’t be "},{"code":"w","type":"codeVoice"},{"type":"text","text":", "},{"code":".","type":"codeVoice"},{"type":"text","text":" or "},{"code":"..","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"code":"testMode","type":"codeVoice"},{"text":" has no default. TelemetryDeck shows test signals only in its Test Mode, apart from your","type":"text"},{"text":" ","type":"text"},{"text":"real users, and its SDK picks test mode for debug builds. Pass whatever your app uses to tell its","type":"text"},{"text":" ","type":"text"},{"text":"builds apart, such as ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" under ","type":"text"},{"code":"#if DEBUG","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" otherwise.","type":"text"}]},{"type":"heading","level":3,"text":"User counts are sessions","anchor":"User-counts-are-sessions"},{"type":"paragraph","inlineContent":[{"text":"TelemetryDeck counts users by ","type":"text"},{"type":"codeVoice","code":"clientUser"},{"text":". The destination sends the record’s session, from the","type":"text"},{"text":" ","type":"text"},{"text":"sessions enricher, as ","type":"text"},{"type":"codeVoice","code":"clientUser"},{"text":", hashed the way TelemetryDeck’s SDKs hash a user identifier:","type":"text"},{"text":" ","type":"text"},{"text":"SHA-256 of the lowercase UUID, in lowercase hex, with the SDKs’ default, empty salt.","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck salts and hashes ","type":"text"},{"type":"codeVoice","code":"clientUser"},{"text":" again on its server. The same session is also the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"sessionID"},{"text":", in the clear, so a salt of the app’s own would hide nothing, and the destination takes","type":"text"},{"text":" ","type":"text"},{"text":"none. Nothing else identifies a record: no vendor identifier, device identifier or","type":"text"},{"text":" ","type":"text"},{"text":"account, and no trace context.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"So TelemetryDeck’s user counts are session counts. A person who opens the app three times is three","type":"text"},{"text":" ","type":"text"},{"text":"users, and its retention charts show how long a session lasts, not whether people come back. That","type":"text"},{"text":" ","type":"text"},{"text":"is the library’s default, for privacy. To count devices instead, put","type":"text"},{"text":" ","type":"text"},{"code":"StandardContext","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"VendorIdentifierKey","type":"codeVoice"},{"text":" in the records’ context and send them through a","type":"text"},{"text":" ","type":"text"},{"text":"destination that reads it, or write your own enricher and encoder that send the identifier you","type":"text"},{"text":" ","type":"text"},{"text":"choose. This encoder sends the session alone.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record with no session, such as one a store recovered after a relaunch, is its own user: its"},{"type":"text","text":" "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":" is the hash of the record’s identifier, and it has no "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":". Making up a session"},{"type":"text","text":" "},{"type":"text","text":"would join unrelated records, and skipping the record would lose it."}]},{"type":"heading","level":3,"text":"What TelemetryDeck receives","anchor":"What-TelemetryDeck-receives"},{"type":"paragraph","inlineContent":[{"text":"Each request is a JSON array of signals, one per record. Every signal has:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"appID"},{"type":"text","text":", as given, without surrounding whitespace;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"},{"text":", the event’s name;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"clientUser"},{"text":", the hashed session, and ","type":"text"},{"type":"codeVoice","code":"sessionID"},{"text":", the session;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"receivedAt"},{"type":"text","text":", the record’s timestamp in ISO 8601 with milliseconds, so a signal sent late still"},{"type":"text","text":" "},{"type":"text","text":"counts at the time it was tracked;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"isTestMode","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"true\"","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"\"false\"","type":"codeVoice"},{"text":";","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"TelemetryDeck.SDK.name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Traffluent","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is"},{"type":"text","text":" "},{"type":"text","text":"made with, and sit beside these, each keeping its JSON type. TelemetryDeck doesn’t index nested"},{"type":"text","text":" "},{"type":"text","text":"values, so an object or array is flattened into dotted names: a "},{"type":"codeVoice","code":"cart"},{"type":"text","text":" holding "},{"type":"codeVoice","code":"size"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", and the first element of "},{"type":"codeVoice","code":"tags"},{"type":"text","text":" is "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":". A "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" property is left out. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals. No "},{"type":"codeVoice","code":"floatValue"},{"type":"text","text":" is sent."}]},{"type":"paragraph","inlineContent":[{"text":"The standard context, when the record has it, becomes TelemetryDeck’s built-in parameters:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Context"}]}],[{"type":"paragraph","inlineContent":[{"text":"Parameters","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.version"},{"text":", ","type":"text"},{"type":"codeVoice","code":".buildNumber"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".versionAndBuildNumber"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.Device.modelName","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.Device.operatingSystem","type":"codeVoice"},{"type":"text","text":", "},{"code":".platform","type":"codeVoice"},{"type":"text","text":", "},{"code":".systemVersion","type":"codeVoice"},{"type":"text","text":", "},{"code":".systemMajorVersion","type":"codeVoice"},{"type":"text","text":" and "},{"code":".systemMajorMinorVersion","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.locale"},{"type":"text","text":" and "},{"type":"codeVoice","code":".language"},{"type":"text","text":", and "},{"type":"codeVoice","code":"TelemetryDeck.UserPreference.region"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The bundle identifier, the form factor and the network aren’t sent."}]},{"type":"heading","level":3,"text":"Records left out","anchor":"Records-left-out"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"one the plan doesn’t describe, whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", or that holds a value JSON can’t;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose event name or parameter name, once flattened, holds anything but ASCII letters, digits,"},{"type":"text","text":" "},{"type":"codeVoice","code":"."},{"type":"text","text":", "},{"type":"codeVoice","code":"_"},{"type":"text","text":" and "},{"type":"codeVoice","code":"-"},{"type":"text","text":", or is empty. TelemetryDeck refuses the whole request for one such name."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose event name or parameter name starts with "},{"type":"codeVoice","code":"TelemetryDeck."},{"type":"text","text":", in any case: TelemetryDeck"},{"type":"text","text":" "},{"type":"text","text":"reserves that scope for its SDKs’ parameters and its server’s;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one with a parameter named as one of a signal’s own members, ","type":"text"},{"code":"appID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"receivedAt","type":"codeVoice"},{"text":", ","type":"text"},{"code":"type","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isTestMode","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"floatValue","type":"codeVoice"},{"text":", spelled exactly so: in the flat","type":"text"},{"text":" ","type":"text"},{"text":"signal it would replace the member. A name like one in another case, such as ","type":"text"},{"code":"Type","type":"codeVoice"},{"text":", is sent.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one whose values flatten to the same name twice;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose timestamp falls outside the years 1 to 9999, which TelemetryDeck can’t parse;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose JSON is over 333,333 bytes. TelemetryDeck refuses the whole request for a signal over"},{"type":"text","text":" "},{"type":"text","text":"1,000,000 bytes as its server writes it, which may be larger than the encoder’s; a third leaves"},{"type":"text","text":" "},{"type":"text","text":"room for the escapes a re-encoder commonly adds."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The destination reports each as ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" whose reason is a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"},{"text":". When the destination is made, it logs a notice for each event and","type":"text"},{"text":" ","type":"text"},{"text":"property of the plan whose name would be left out.","type":"text"}]},{"type":"heading","level":3,"text":"What TelemetryDeck doesn’t report","anchor":"What-TelemetryDeck-doesnt-report"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TelemetryDeck answers 200 to any namespace and any app ID it can read, so a typo in either loses"},{"type":"text","text":" "},{"type":"text","text":"every signal without an error. Check that the first signals show up in the dashboard, in Test Mode"},{"type":"text","text":" "},{"type":"text","text":"when "},{"code":"testMode","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"TelemetryDeck doesn’t remove duplicates. A record is sent more than once when a request is retried","type":"text"},{"text":" ","type":"text"},{"text":"after TelemetryDeck stored it but the answer was lost, when a delivery sends a cancelled batch","type":"text"},{"text":" ","type":"text"},{"text":"again, and when a store redelivers records after a relaunch, and TelemetryDeck counts each copy.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what TelemetryDeck receives, and why, in more detail."}]}]}],"kind":"symbol","sections":[],"abstract":[{"text":"Send records to TelemetryDeck as signals, through its Ingest API v3.","type":"text"}],"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/init(appID:testMode:plan:limit:)":{"title":"init(appID:testMode:plan:limit:)","type":"topic","kind":"symbol","role":"symbol","abstract":[{"text":"An encoder of the events ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" describes, for the TelemetryDeck app ","type":"text"},{"code":"appID","type":"codeVoice"},{"text":", marking every","type":"text"},{"text":" ","type":"text"},{"text":"event as a test event or not as ","type":"text"},{"code":"testMode","type":"codeVoice"},{"text":" says,","type":"text"},{"text":" ","type":"text"},{"text":"and splitting each batch to ","type":"text"},{"code":"limit","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"appID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"testMode"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"limit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier","text":"BatchLimit"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:21TelemetryDeckEncoding0aB10SetupErrorO","kind":"typeIdentifier","text":"TelemetryDeckSetupError"},{"kind":"text","text":")"}],"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/init(appid:testmode:plan:limit:)"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/HTTPDestinations/HTTPDestination/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)":{"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"HTTPTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"TelemetryDeckBatchEncoder"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"url":"\/documentation\/telemetrydeckencoding\/httpdestinations\/httpdestination\/telemetrydeck(appid:namespace:testmode:plan:transport:backoff:clock:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"telemetryDeck"},{"kind":"text","text":"("},{"kind":"externalParam","text":"appID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"namespace"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"testMode"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier","text":"Clock"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:21TelemetryDeckEncoding0aB10SetupErrorO","kind":"typeIdentifier","text":"TelemetryDeckSetupError"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"preciseIdentifier":"s:21TelemetryDeckEncoding0aB12BatchEncoderV","kind":"typeIdentifier","text":"TelemetryDeckBatchEncoder"},{"kind":"text","text":">"}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","type":"topic","abstract":[{"type":"text","text":"A destination that sends batches to the TelemetryDeck app "},{"code":"appID","type":"codeVoice"},{"type":"text","text":", in the organization’s"},{"type":"text","text":" "},{"code":"namespace","type":"codeVoice"},{"type":"text","text":", marking every event as a test event or not as "},{"code":"testMode","type":"codeVoice"},{"type":"text","text":" says, through"},{"type":"text","text":" "},{"code":"transp