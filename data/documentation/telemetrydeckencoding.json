{"sections":[],"metadata":{"modules":[{"name":"TelemetryDeckEncoding"}],"externalID":"TelemetryDeckEncoding","roleHeading":"Framework","role":"collection","title":"TelemetryDeckEncoding","symbolKind":"module"},"topicSections":[{"anchor":"Sending-to-TelemetryDeck","title":"Sending to TelemetryDeck","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError"]},{"anchor":"Encoding-batches","title":"Encoding batches","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"]},{"anchor":"Records-left-out","title":"Records left out","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding"]}],"kind":"symbol","abstract":[{"type":"text","text":"Send records to TelemetryDeck as signals, through its Ingest API v3."}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"makes an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"text":") for TelemetryDeck in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the app ID and your organization’s namespace, then posts to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"https:\/\/nom.telemetrydeck.com\/v3\/<namespace>\/"},{"text":" with a ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","type":"reference","isActive":true},{"text":". Each batch is","type":"text"},{"text":" ","type":"text"},{"text":"split to ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":": 100 signals a request, as TelemetryDeck’s","type":"text"},{"text":" ","type":"text"},{"text":"SwiftSDK sends them; 333,333 bytes a signal, a third of Ingest API v3’s limit of 1,000,000; and","type":"text"},{"text":" ","type":"text"},{"text":"1,000,000 bytes a request, the encoder’s own bound, as TelemetryDeck documents none. A batch with no record the encoder can write, an empty one included, makes","type":"text"},{"text":" ","type":"text"},{"text":"no request. The destination retries no response, a 5xx (TelemetryDeck answers 503 while its queue","type":"text"},{"text":" ","type":"text"},{"text":"is full), 408 and 429, and drops and reports any other status. No trace context is sent.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves this module out, so import it on its own.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The app ID only says which app a signal belongs to, and TelemetryDeck’s own SDKs ship it inside"},{"type":"text","text":" "},{"type":"text","text":"every app, so the destination builds on every platform and an app sends to TelemetryDeck directly."}],"type":"paragraph"},{"code":["import HTTPDestinations","import TelemetryDeckEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: telemetryDeck)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The factory throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError"},{"type":"text","text":" for an app ID that is empty or only whitespace,"},{"type":"text","text":" "},{"type":"text","text":"and for a namespace TelemetryDeck doesn’t take. A namespace holds only ASCII letters, digits, "},{"type":"codeVoice","code":"."},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"_"},{"type":"text","text":" and "},{"type":"codeVoice","code":"-"},{"type":"text","text":", and can’t be "},{"type":"codeVoice","code":"w"},{"type":"text","text":", "},{"type":"codeVoice","code":"."},{"type":"text","text":" or "},{"type":"codeVoice","code":".."},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"code":"testMode","type":"codeVoice"},{"text":" has no default. TelemetryDeck shows test signals only in its Test Mode, apart from your","type":"text"},{"text":" ","type":"text"},{"text":"real users, and its SDK picks test mode for debug builds. Pass whatever your app uses to tell its","type":"text"},{"text":" ","type":"text"},{"text":"builds apart, such as ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" under ","type":"text"},{"code":"#if DEBUG","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" otherwise.","type":"text"}],"type":"paragraph"},{"level":3,"text":"User counts are sessions","anchor":"User-counts-are-sessions","type":"heading"},{"inlineContent":[{"text":"TelemetryDeck counts users by ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":". The destination sends the record’s session, from the","type":"text"},{"text":" ","type":"text"},{"text":"sessions enricher, as ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":", hashed the way TelemetryDeck’s SDKs hash a user identifier:","type":"text"},{"text":" ","type":"text"},{"text":"SHA-256 of the lowercase UUID, in lowercase hex, with the SDKs’ default, empty salt.","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck salts and hashes ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" again on its server. The same session is also the","type":"text"},{"text":" ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", in the clear, so a salt of the app’s own would hide nothing, and the destination takes","type":"text"},{"text":" ","type":"text"},{"text":"none. Nothing else identifies a record: no vendor identifier, device identifier or","type":"text"},{"text":" ","type":"text"},{"text":"account, and no trace context.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"So TelemetryDeck’s user counts are session counts. A person who opens the app three times is three","type":"text"},{"text":" ","type":"text"},{"text":"users, and its retention charts show how long a session lasts, not whether people come back. That","type":"text"},{"text":" ","type":"text"},{"text":"is the library’s default, for privacy. To count devices instead, put","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"StandardContext"},{"text":"‘s ","type":"text"},{"type":"codeVoice","code":"VendorIdentifierKey"},{"text":" in the records’ context and send them through a","type":"text"},{"text":" ","type":"text"},{"text":"destination that reads it, or write your own enricher and encoder that send the identifier you","type":"text"},{"text":" ","type":"text"},{"text":"choose. This encoder sends the session alone.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A record with no session, from a tracker without the sessions enricher, is its own user: its","type":"text"},{"text":" ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" is the hash of the record’s identifier, and it has no ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":". A record a store","type":"text"},{"text":" ","type":"text"},{"text":"recovered after a relaunch keeps its session, and with it the ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":" of its","type":"text"},{"text":" ","type":"text"},{"text":"first send. Making up a session","type":"text"},{"text":" ","type":"text"},{"text":"would join unrelated records, and skipping the record would lose it.","type":"text"}],"type":"paragraph"},{"level":3,"text":"What TelemetryDeck receives","anchor":"What-TelemetryDeck-receives","type":"heading"},{"inlineContent":[{"text":"Each request is a JSON array of signals, one per record. Every signal has:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"appID"},{"text":", as given, without surrounding whitespace;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"},{"text":", the event’s name;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"clientUser","type":"codeVoice"},{"type":"text","text":", the hashed session, and "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":", the session;"}]}]},{"content":[{"inlineContent":[{"code":"receivedAt","type":"codeVoice"},{"type":"text","text":", the record’s timestamp in ISO 8601 with milliseconds, so a signal sent late still"},{"type":"text","text":" "},{"type":"text","text":"counts at the time it was tracked;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isTestMode"},{"type":"text","text":", "},{"type":"codeVoice","code":"\"true\""},{"type":"text","text":" or "},{"type":"codeVoice","code":"\"false\""},{"type":"text","text":";"}]}]},{"content":[{"inlineContent":[{"code":"TelemetryDeck.SDK.name","type":"codeVoice"},{"type":"text","text":", "},{"code":"Traffluent","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The record’s properties are read through the event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is","type":"text"},{"text":" ","type":"text"},{"text":"made with, and sit beside these, each keeping its JSON type. TelemetryDeck doesn’t index nested","type":"text"},{"text":" ","type":"text"},{"text":"values, so an object or array is flattened into dotted names: a ","type":"text"},{"code":"cart","type":"codeVoice"},{"text":" holding ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"cart.size","type":"codeVoice"},{"text":", and the first element of ","type":"text"},{"code":"tags","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"tags.0","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" property is left out. A","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is never sent, whatever the record reveals. No ","type":"text"},{"code":"floatValue","type":"codeVoice"},{"text":" is sent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The standard context, when the record has it, becomes TelemetryDeck’s built-in parameters:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Context"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parameters"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}]}],[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.AppInfo.version","type":"codeVoice"},{"text":", ","type":"text"},{"code":".buildNumber","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".versionAndBuildNumber","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.modelName"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.operatingSystem"},{"type":"text","text":", "},{"type":"codeVoice","code":".platform"},{"type":"text","text":", "},{"type":"codeVoice","code":".systemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":".systemMajorVersion"},{"type":"text","text":" and "},{"type":"codeVoice","code":".systemMajorMinorVersion"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"LocaleKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.RunContext.locale","type":"codeVoice"},{"type":"text","text":" and "},{"code":".language","type":"codeVoice"},{"type":"text","text":", and "},{"code":"TelemetryDeck.UserPreference.region","type":"codeVoice"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"The bundle identifier, the form factor and the network aren’t sent.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Records left out","anchor":"Records-left-out","type":"heading"},{"inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"one the plan doesn’t describe, whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", or that holds a value JSON can’t;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose event name or parameter name, once flattened, holds anything but ASCII letters, digits,"},{"type":"text","text":" "},{"code":".","type":"codeVoice"},{"type":"text","text":", "},{"code":"_","type":"codeVoice"},{"type":"text","text":" and "},{"code":"-","type":"codeVoice"},{"type":"text","text":", or is empty. TelemetryDeck refuses the whole request for one such name."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one whose event name or parameter name starts with ","type":"text"},{"code":"TelemetryDeck.","type":"codeVoice"},{"text":", in any case: TelemetryDeck","type":"text"},{"text":" ","type":"text"},{"text":"reserves that scope for its SDKs’ parameters and its server’s;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one with a parameter named as one of a signal’s own members, "},{"type":"codeVoice","code":"appID"},{"type":"text","text":", "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"receivedAt"},{"type":"text","text":", "},{"type":"codeVoice","code":"type"},{"type":"text","text":", "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":", "},{"type":"codeVoice","code":"isTestMode"},{"type":"text","text":" or "},{"type":"codeVoice","code":"floatValue"},{"type":"text","text":", spelled exactly so: in the flat"},{"type":"text","text":" "},{"type":"text","text":"signal it would replace the member. A name like one in another case, such as "},{"type":"codeVoice","code":"Type"},{"type":"text","text":", is sent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose values flatten to the same name twice;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose timestamp falls outside the years 1 to 9999, which TelemetryDeck can’t parse;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose JSON is over 333,333 bytes. TelemetryDeck refuses the whole request for a signal over"},{"type":"text","text":" "},{"type":"text","text":"1,000,000 bytes as its server writes it, which may be larger than the encoder’s; a third leaves"},{"type":"text","text":" "},{"type":"text","text":"room for the escapes a re-encoder commonly adds."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The destination reports each as ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" whose reason is a","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"},{"text":". When the destination is made, it logs a notice for each event and","type":"text"},{"text":" ","type":"text"},{"text":"property of the plan whose name would be left out.","type":"text"}],"type":"paragraph"},{"level":3,"text":"What TelemetryDeck doesn’t report","anchor":"What-TelemetryDeck-doesnt-report","type":"heading"},{"inlineContent":[{"text":"TelemetryDeck answers 200 to any namespace and any app ID it can read, so a typo in either loses","type":"text"},{"text":" ","type":"text"},{"text":"every signal without an error. Check that the first signals show up in the dashboard, in Test Mode","type":"text"},{"text":" ","type":"text"},{"text":"when ","type":"text"},{"code":"testMode","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"TelemetryDeck doesn’t remove duplicates. A record is sent more than once when a request is retried"},{"type":"text","text":" "},{"type":"text","text":"after TelemetryDeck stored it but the answer was lost, when a delivery sends a cancelled batch"},{"type":"text","text":" "},{"type":"text","text":"again, and when a store redelivers records after a relaunch, and TelemetryDeck counts each copy."}],"type":"paragraph"},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference"},{"text":" ","type":"text"},{"text":"covers what TelemetryDeck receives, and why, in more detail.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"type":"text","text":" sends."}],"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","title":"BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder","type":"topic","role":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckSetupError":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckSetupError","kind":"identifier"}],"abstract":[{"type":"text","text":"Why "},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"or "},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)","type":"reference","isActive":true},{"type":"text","text":" couldn’t be made."}],"navigatorTitle":[{"text":"TelemetryDeckSetupError","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError","title":"TelemetryDeckSetupError","type":"topic","url":"\/documentation\/telemetrydeckencoding\/telemetrydecksetuperror","role":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/HTTPDestinations/HTTPDestination/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)":{"url":"\/documentation\/telemetrydeckencoding\/httpdestinations\/httpdestination\/telemetrydeck(appid:namespace:testmode:plan:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"telemetryDeck","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"namespace","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"testMode","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:21TelemetryDeckEncoding0aB10SetupErrorO","text":"TelemetryDeckSetupError","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:21TelemetryDeckEncoding0aB12BatchEncoderV","text":"TelemetryDeckBatchEncoder","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","role":"symbol","abstract":[{"type":"text","text":"A destination that sends batches to the TelemetryDeck app "},{"type":"codeVoice","code":"appID"},{"type":"text","text":", in the organization’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"namespace"},{"type":"text","text":", marking every event as a test event or not as "},{"type":"codeVoice","code":"testMode"},{"type":"text","text":" says, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"conformance":{"constraints":[{"code":"Transport","type":"codeVoice"},{"tex