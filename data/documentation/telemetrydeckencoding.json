{"variants":[{"paths":["\/documentation\/telemetrydeckencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","metadata":{"symbolKind":"module","modules":[{"name":"TelemetryDeckEncoding"}],"roleHeading":"Framework","role":"collection","externalID":"TelemetryDeckEncoding","title":"TelemetryDeckEncoding"},"identifier":{"url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Send records to TelemetryDeck as signals, through its Ingest API v3."}],"topicSections":[{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError"],"anchor":"Sending-to-TelemetryDeck","title":"Sending to TelemetryDeck"},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"],"anchor":"Encoding-batches","title":"Encoding batches"},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"],"anchor":"Records-left-out","title":"Records left out"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"makes an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"text":") for TelemetryDeck in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the app ID and your organization’s namespace, then posts to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"https:\/\/nom.telemetrydeck.com\/v3\/<namespace>\/"},{"text":" with a ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","isActive":true,"type":"reference"},{"text":". Each batch is","type":"text"},{"text":" ","type":"text"},{"text":"split to ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":": 100 signals a request, as TelemetryDeck’s","type":"text"},{"text":" ","type":"text"},{"text":"SwiftSDK sends them; 333,333 bytes a signal, a third of Ingest API v3’s limit of 1,000,000; and","type":"text"},{"text":" ","type":"text"},{"text":"1,000,000 bytes a request, the encoder’s own bound, as TelemetryDeck documents none. A batch with no record the encoder can write, an empty one included, makes","type":"text"},{"text":" ","type":"text"},{"text":"no request. The destination retries no response, a 5xx (TelemetryDeck answers 503 while its queue","type":"text"},{"text":" ","type":"text"},{"text":"is full), 408 and 429, and drops and reports any other status. No trace context is sent.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves this module out, so import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The app ID only says which app a signal belongs to, and TelemetryDeck’s own SDKs ship it inside","type":"text"},{"text":" ","type":"text"},{"text":"every app, so the destination builds on every platform and an app sends to TelemetryDeck directly.","type":"text"}]},{"code":["import HTTPDestinations","import TelemetryDeckEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: telemetryDeck)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The factory throws ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError","isActive":true,"type":"reference"},{"text":" for an app ID that is empty or only whitespace,","type":"text"},{"text":" ","type":"text"},{"text":"and for a namespace TelemetryDeck doesn’t take. A namespace holds only ASCII letters, digits, ","type":"text"},{"type":"codeVoice","code":"."},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"_"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"-"},{"text":", and can’t be ","type":"text"},{"type":"codeVoice","code":"w"},{"text":", ","type":"text"},{"type":"codeVoice","code":"."},{"text":" or ","type":"text"},{"type":"codeVoice","code":".."},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"testMode","type":"codeVoice"},{"text":" has no default. TelemetryDeck shows test signals only in its Test Mode, apart from your","type":"text"},{"text":" ","type":"text"},{"text":"real users, and its SDK picks test mode for debug builds. Pass whatever your app uses to tell its","type":"text"},{"text":" ","type":"text"},{"text":"builds apart, such as ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" under ","type":"text"},{"code":"#if DEBUG","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" otherwise.","type":"text"}]},{"level":3,"type":"heading","anchor":"User-counts-are-sessions","text":"User counts are sessions"},{"type":"paragraph","inlineContent":[{"text":"TelemetryDeck counts users by ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":". The destination sends the record’s session, from the","type":"text"},{"text":" ","type":"text"},{"text":"sessions enricher, as ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":", hashed the way TelemetryDeck’s SDKs hash a user identifier:","type":"text"},{"text":" ","type":"text"},{"text":"SHA-256 of the lowercase UUID, in lowercase hex, with the SDKs’ default, empty salt.","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck salts and hashes ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" again on its server. The same session is also the","type":"text"},{"text":" ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", in the clear, so a salt of the app’s own would hide nothing, and the destination takes","type":"text"},{"text":" ","type":"text"},{"text":"none. Nothing else identifies a record: no vendor identifier, device identifier or","type":"text"},{"text":" ","type":"text"},{"text":"account, and no trace context.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"So TelemetryDeck’s user counts are session counts. A person who opens the app three times is three","type":"text"},{"text":" ","type":"text"},{"text":"users, and its retention charts show how long a session lasts, not whether people come back. That","type":"text"},{"text":" ","type":"text"},{"text":"is the library’s default, for privacy. To count devices instead, put","type":"text"},{"text":" ","type":"text"},{"code":"StandardContext","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"VendorIdentifierKey","type":"codeVoice"},{"text":" in the records’ context and send them through a","type":"text"},{"text":" ","type":"text"},{"text":"destination that reads it, or write your own enricher and encoder that send the identifier you","type":"text"},{"text":" ","type":"text"},{"text":"choose. This encoder sends the session alone.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A record with no session, from a tracker without the sessions enricher, is its own user: its","type":"text"},{"text":" ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" is the hash of the record’s identifier, and it has no ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":". A record a store","type":"text"},{"text":" ","type":"text"},{"text":"recovered after a relaunch keeps its session, and with it the ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":" of its","type":"text"},{"text":" ","type":"text"},{"text":"first send. Making up a session","type":"text"},{"text":" ","type":"text"},{"text":"would join unrelated records, and skipping the record would lose it.","type":"text"}]},{"level":3,"type":"heading","anchor":"What-TelemetryDeck-receives","text":"What TelemetryDeck receives"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each request is a JSON array of signals, one per record. Every signal has:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"appID","type":"codeVoice"},{"text":", as given, without surrounding whitespace;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"type"},{"text":", the event’s name;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"clientUser","type":"codeVoice"},{"text":", the hashed session, and ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", the session;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"receivedAt"},{"type":"text","text":", the record’s timestamp in ISO 8601 with milliseconds, so a signal sent late still"},{"type":"text","text":" "},{"type":"text","text":"counts at the time it was tracked;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"isTestMode","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"true\"","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"\"false\"","type":"codeVoice"},{"text":";","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"TelemetryDeck.SDK.name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Traffluent","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is"},{"type":"text","text":" "},{"type":"text","text":"made with, and sit beside these, each keeping its JSON type. TelemetryDeck doesn’t index nested"},{"type":"text","text":" "},{"type":"text","text":"values, so an object or array is flattened into dotted names: a "},{"type":"codeVoice","code":"cart"},{"type":"text","text":" holding "},{"type":"codeVoice","code":"size"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", and the first element of "},{"type":"codeVoice","code":"tags"},{"type":"text","text":" is "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":". A "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" property is left out. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals. No "},{"type":"codeVoice","code":"floatValue"},{"type":"text","text":" is sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context, when the record has it, becomes TelemetryDeck’s built-in parameters:"}]},{"rows":[[[{"inlineContent":[{"text":"Context","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Parameters"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TelemetryDeck.AppInfo.version","type":"codeVoice"},{"type":"text","text":", "},{"code":".buildNumber","type":"codeVoice"},{"type":"text","text":" and "},{"code":".versionAndBuildNumber","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TelemetryDeck.Device.modelName","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.operatingSystem"},{"type":"text","text":", "},{"type":"codeVoice","code":".platform"},{"type":"text","text":", "},{"type":"codeVoice","code":".systemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":".systemMajorVersion"},{"type":"text","text":" and "},{"type":"codeVoice","code":".systemMajorMinorVersion"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TelemetryDeck.RunContext.locale","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".language","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"TelemetryDeck.UserPreference.region","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The bundle identifier, the form factor and the network aren’t sent.","type":"text"}]},{"level":3,"type":"heading","anchor":"Records-left-out","text":"Records left out"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"one the plan doesn’t describe, whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", or that holds a value JSON can’t;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose event name or parameter name, once flattened, holds anything but ASCII letters, digits,"},{"type":"text","text":" "},{"code":".","type":"codeVoice"},{"type":"text","text":", "},{"code":"_","type":"codeVoice"},{"type":"text","text":" and "},{"code":"-","type":"codeVoice"},{"type":"text","text":", or is empty. TelemetryDeck refuses the whole request for one such name."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose event name or parameter name starts with ","type":"text"},{"code":"TelemetryDeck.","type":"codeVoice"},{"text":", in any case: TelemetryDeck","type":"text"},{"text":" ","type":"text"},{"text":"reserves that scope for its SDKs’ parameters and its server’s;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one with a parameter named as one of a signal’s own members, ","type":"text"},{"code":"appID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"receivedAt","type":"codeVoice"},{"text":", ","type":"text"},{"code":"type","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isTestMode","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"floatValue","type":"codeVoice"},{"text":", spelled exactly so: in the flat","type":"text"},{"text":" ","type":"text"},{"text":"signal it would replace the member. A name like one in another case, such as ","type":"text"},{"code":"Type","type":"codeVoice"},{"text":", is sent.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose values flatten to the same name twice;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose timestamp falls outside the years 1 to 9999, which TelemetryDeck can’t parse;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose JSON is over 333,333 bytes. TelemetryDeck refuses the whole request for a signal over"},{"type":"text","text":" "},{"type":"text","text":"1,000,000 bytes as its server writes it, which may be larger than the encoder’s; a third leaves"},{"type":"text","text":" "},{"type":"text","text":"room for the escapes a re-encoder commonly adds."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination reports each as "},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"type":"text","text":", a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" whose reason is a"},{"type":"text","text":" "},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","isActive":true,"type":"reference"},{"type":"text","text":". When the destination is made, it logs a notice for each event and"},{"type":"text","text":" "},{"type":"text","text":"property of the plan whose name would be left out."}]},{"level":3,"type":"heading","anchor":"What-TelemetryDeck-doesnt-report","text":"What TelemetryDeck doesn’t report"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TelemetryDeck answers 200 to any namespace and any app ID it can read, so a typo in either loses"},{"type":"text","text":" "},{"type":"text","text":"every signal without an error. Check that the first signals show up in the dashboard, in Test Mode"},{"type":"text","text":" "},{"type":"text","text":"when "},{"code":"testMode","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"TelemetryDeck doesn’t remove duplicates. A record is sent more than once when a request is retried"},{"type":"text","text":" "},{"type":"text","text":"after TelemetryDeck stored it but the answer was lost, when a delivery sends a cancelled batch"},{"type":"text","text":" "},{"type":"text","text":"again, and when a store redelivers records after a relaunch, and TelemetryDeck counts each copy."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what TelemetryDeck receives, and why, in more detail."}]}]}],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","title":"Choosing Destinations"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckEncodingError":{"title":"TelemetryDeckEncodingError","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","role":"symbol","navigatorTitle":[{"text":"TelemetryDeckEncodingError","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckEncodingError","kind":"identifier"}],"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckencodingerror","abstract":[{"text":"Why ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"type":"topic","kind":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/init(appID:testMode:plan:limit:)":{"title":"init(appID:testMode:plan:limit:)","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/init(appid:testmode:plan:limit:)","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"testMode","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:21TelemetryDeckEncoding0aB10SetupErrorO","text":"TelemetryDeckSetupError","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"An encoder of the events "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, for the TelemetryDeck app "},{"type":"codeVoice","code":"appID"},{"type":"text","text":", marking every"},{"type":"text","text":" "},{"type":"text","text":"event as a test event or not as "},{"type":"codeVoice","code":"testMode"},{"type":"text","text":" says,"},{"type":"text","text":" "},{"type":"text","text":"and splitting each batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":"."}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckSetupError":{"navigatorTitle":[{"text":"TelemetryDeckSetupError","kind":"identifier"}],"url":"\/documentation\/telemetrydeckencoding\/telemetrydecksetuperror","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError","title":"TelemetryDeckSetupError","abstract":[{"type":"text","text":"Why "},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"or "},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)","type":"reference"},{"type":"text","text":" couldn’t be made."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckSetupError","kind":"identifier"}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"role":"symbol","title":"TelemetryDeckBatchEncoder","kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/Batch