 for the TelemetryDeck app ","type":"text"},{"type":"codeVoice","code":"appID"},{"text":", marking every","type":"text"},{"text":" ","type":"text"},{"text":"event as a test event or not as ","type":"text"},{"type":"codeVoice","code":"testMode"},{"text":" says,","type":"text"},{"text":" ","type":"text"},{"text":"and splitting each batch to ","type":"text"},{"type":"codeVoice","code":"limit"},{"text":".","type":"text"}],"title":"init(appID:testMode:plan:limit:)","role":"symbol","type":"topic"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckSetupError":{"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckSetupError","kind":"identifier"}],"navigatorTitle":[{"text":"TelemetryDeckSetupError","kind":"identifier"}],"abstract":[{"text":"Why ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","type":"reference"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)","type":"reference"},{"text":" couldn’t be made.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError","url":"\/documentation\/telemetrydeckencoding\/telemetrydecksetuperror","title":"TelemetryDeckSetupError"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/HTTPDestinations/HTTPDestination/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)":{"abstract":[{"text":"A destination that sends batches to the TelemetryDeck app ","type":"text"},{"code":"appID","type":"codeVoice"},{"text":", in the organization’s","type":"text"},{"text":" ","type":"text"},{"code":"namespace","type":"c