{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"collection","modules":[{"name":"TelemetryDeckEncoding"}],"title":"TelemetryDeckEncoding","roleHeading":"Framework","externalID":"TelemetryDeckEncoding","symbolKind":"module"},"sections":[],"topicSections":[{"anchor":"Sending-to-TelemetryDeck","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError"],"title":"Sending to TelemetryDeck"},{"anchor":"Encoding-batches","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"],"title":"Encoding batches"},{"anchor":"Records-left-out","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"],"title":"Records left out"}],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)"},{"type":"text","text":" "},{"type":"text","text":"makes an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":") for TelemetryDeck in one call. It checks"},{"type":"text","text":" "},{"type":"text","text":"the app ID and your organization’s namespace, then posts to"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/nom.telemetrydeck.com\/v3\/<namespace>\/"},{"type":"text","text":" with a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"},{"type":"text","text":". Each batch is"},{"type":"text","text":" "},{"type":"text","text":"split to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit"},{"type":"text","text":": 100 signals a request, as TelemetryDeck’s"},{"type":"text","text":" "},{"type":"text","text":"SwiftSDK sends them; 333,333 bytes a signal, a third of Ingest API v3’s limit of 1,000,000; and"},{"type":"text","text":" "},{"type":"text","text":"1,000,000 bytes a request, the encoder’s own bound, as TelemetryDeck documents none. A batch with no record the encoder can write, an empty one included, makes"},{"type":"text","text":" "},{"type":"text","text":"no request. The destination retries no response, a 5xx (TelemetryDeck answers 503 while its queue"},{"type":"text","text":" "},{"type":"text","text":"is full), 408 and 429, and drops and reports any other status. No trace context is sent."},{"type":"text","text":" "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves this module out, so import it on its own."}],"type":"paragraph"},{"inlineContent":[{"text":"The app ID only says which app a signal belongs to, and TelemetryDeck’s own SDKs ship it inside","type":"text"},{"text":" ","type":"text"},{"text":"every app, so the destination builds on every platform and an app sends to TelemetryDeck directly.","type":"text"}],"type":"paragraph"},{"code":["import HTTPDestinations","import TelemetryDeckEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: telemetryDeck)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The factory throws ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError","type":"reference"},{"text":" for an app ID that is empty or only whitespace,","type":"text"},{"text":" ","type":"text"},{"text":"and for a namespace TelemetryDeck doesn’t take. A namespace holds only ASCII letters, digits, ","type":"text"},{"type":"codeVoice","code":"."},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"_"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"-"},{"text":", and can’t be ","type":"text"},{"type":"codeVoice","code":"w"},{"text":", ","type":"text"},{"type":"codeVoice","code":"."},{"text":" or ","type":"text"},{"type":"codeVoice","code":".."},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"testMode"},{"type":"text","text":" has no default. TelemetryDeck shows test signals only in its Test Mode, apart from your"},{"type":"text","text":" "},{"type":"text","text":"real users, and its SDK picks test mode for debug builds. Pass whatever your app uses to tell its"},{"type":"text","text":" "},{"type":"text","text":"builds apart, such as "},{"type":"codeVoice","code":"true"},{"type":"text","text":" under "},{"type":"codeVoice","code":"#if DEBUG"},{"type":"text","text":" and "},{"type":"codeVoice","code":"false"},{"type":"text","text":" otherwise."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"User-counts-are-sessions","text":"User counts are sessions"},{"inlineContent":[{"type":"text","text":"TelemetryDeck counts users by "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":". The destination sends the record’s session, from the"},{"type":"text","text":" "},{"type":"text","text":"sessions enricher, as "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":", hashed the way TelemetryDeck’s SDKs hash a user identifier:"},{"type":"text","text":" "},{"type":"text","text":"SHA-256 of the lowercase UUID, in lowercase hex, with the SDKs’ default, empty salt."},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck salts and hashes "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":" again on its server. The same session is also the"},{"type":"text","text":" "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":", in the clear, so a salt of the app’s own would hide nothing, and the destination takes"},{"type":"text","text":" "},{"type":"text","text":"none. Nothing else identifies a record: no vendor identifier, device identifier or"},{"type":"text","text":" "},{"type":"text","text":"account, and no trace context."}],"type":"paragraph"},{"inlineContent":[{"text":"So TelemetryDeck’s user counts are session counts. A person who opens the app three times is three","type":"text"},{"text":" ","type":"text"},{"text":"users, and its retention charts show how long a session lasts, not whether people come back. That","type":"text"},{"text":" ","type":"text"},{"text":"is the library’s default, for privacy. To count devices instead, put","type":"text"},{"text":" ","type":"text"},{"code":"StandardContext","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"VendorIdentifierKey","type":"codeVoice"},{"text":" in the records’ context and send them through a","type":"text"},{"text":" ","type":"text"},{"text":"destination that reads it, or write your own enricher and encoder that send the identifier you","type":"text"},{"text":" ","type":"text"},{"text":"choose. This encoder sends the session alone.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A record with no session, such as one a store recovered after a relaunch, is its own user: its"},{"type":"text","text":" "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":" is the hash of the record’s identifier, and it has no "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":". Making up a session"},{"type":"text","text":" "},{"type":"text","text":"would join unrelated records, and skipping the record would lose it."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"What-TelemetryDeck-receives","text":"What TelemetryDeck receives"},{"inlineContent":[{"type":"text","text":"Each request is a JSON array of signals, one per record. Every signal has:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"appID","type":"codeVoice"},{"type":"text","text":", as given, without surrounding whitespace;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"},{"type":"text","text":", the event’s name;"}]}]},{"content":[{"inlineContent":[{"code":"clientUser","type":"codeVoice"},{"text":", the hashed session, and ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", the session;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"receivedAt","type":"codeVoice"},{"text":", the record’s timestamp in ISO 8601 with milliseconds, so a signal sent late still","type":"text"},{"text":" ","type":"text"},{"text":"counts at the time it was tracked;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"isTestMode"},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"true\""},{"text":" or ","type":"text"},{"type":"codeVoice","code":"\"false\""},{"text":";","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"TelemetryDeck.SDK.name","type":"codeVoice"},{"type":"text","text":", "},{"code":"Traffluent","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The record’s properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is"},{"type":"text","text":" "},{"type":"text","text":"made with, and sit beside these, each keeping its JSON type. TelemetryDeck doesn’t index nested"},{"type":"text","text":" "},{"type":"text","text":"values, so an object or array is flattened into dotted names: a "},{"type":"codeVoice","code":"cart"},{"type":"text","text":" holding "},{"type":"codeVoice","code":"size"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", and the first element of "},{"type":"codeVoice","code":"tags"},{"type":"text","text":" is "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":". A "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" property is left out. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals. No "},{"type":"codeVoice","code":"floatValue"},{"type":"text","text":" is sent."}],"type":"paragraph"},{"inlineContent":[{"text":"The standard context, when the record has it, becomes TelemetryDeck’s built-in parameters:","type":"text"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Context","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Parameters","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.version"},{"text":", ","type":"text"},{"type":"codeVoice","code":".buildNumber"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".versionAndBuildNumber"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.modelName"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.operatingSystem"},{"type":"text","text":", "},{"type":"codeVoice","code":".platform"},{"type":"text","text":", "},{"type":"codeVoice","code":".systemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":".systemMajorVersion"},{"type":"text","text":" and "},{"type":"codeVoice","code":".systemMajorMinorVersion"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TelemetryDeck.RunContext.locale","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".language","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"TelemetryDeck.UserPreference.region","type":"codeVoice"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"The bundle identifier, the form factor and the network aren’t sent."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Records-left-out","text":"Records left out"},{"inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"one the plan doesn’t describe, whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", or that holds a value JSON can’t;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose event name or parameter name, once flattened, holds anything but ASCII letters, digits,","type":"text"},{"text":" ","type":"text"},{"code":".","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"-","type":"codeVoice"},{"text":", or is empty. TelemetryDeck refuses the whole request for one such name.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose event name or parameter name starts with "},{"type":"codeVoice","code":"TelemetryDeck."},{"type":"text","text":", in any case: TelemetryDeck"},{"type":"text","text":" "},{"type":"text","text":"reserves that scope for its SDKs’ parameters and its server’s;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one with a parameter named as one of a signal’s own members, "},{"code":"appID","type":"codeVoice"},{"type":"text","text":", "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"receivedAt","type":"codeVoice"},{"type":"text","text":", "},{"code":"type","type":"codeVoice"},{"type":"text","text":", "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":", "},{"code":"isTestMode","type":"codeVoice"},{"type":"text","text":" or "},{"code":"floatValue","type":"codeVoice"},{"type":"text","text":", spelled exactly so: in the flat"},{"type":"text","text":" "},{"type":"text","text":"signal it would replace the member. A name like one in another case, such as "},{"code":"Type","type":"codeVoice"},{"type":"text","text":", is sent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose values flatten to the same name twice;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose timestamp falls outside the years 1 to 9999, which TelemetryDeck can’t parse;"}]}]},{"content":[{"inlineContent":[{"text":"one whose JSON is over 333,333 bytes. TelemetryDeck refuses the whole request for a signal over","type":"text"},{"text":" ","type":"text"},{"text":"1,000,000 bytes as its server writes it, which may be larger than the encoder’s; a third leaves","type":"text"},{"text":" ","type":"text"},{"text":"room for the escapes a re-encoder commonly adds.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The destination reports each as "},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"type":"text","text":", a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" whose reason is a"},{"type":"text","text":" "},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","type":"reference","isActive":true},{"type":"text","text":". When the destination is made, it logs a notice for each event and"},{"type":"text","text":" "},{"type":"text","text":"property of the plan whose name would be left out."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"What-TelemetryDeck-doesnt-report","text":"What TelemetryDeck doesn’t report"},{"inlineContent":[{"text":"TelemetryDeck answers 200 to any namespace and any app ID it can read, so a typo in either loses","type":"text"},{"text":" ","type":"text"},{"text":"every signal without an error. Check that the first signals show up in the dashboard, in Test Mode","type":"text"},{"text":" ","type":"text"},{"text":"when ","type":"text"},{"type":"codeVoice","code":"testMode"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"TelemetryDeck doesn’t remove duplicates. A record is sent more than once when a request is retried"},{"type":"text","text":" "},{"type":"text","text":"after TelemetryDeck stored it but the answer was lost, when a delivery sends a cancelled batch"},{"type":"text","text":" "},{"type":"text","text":"again, and when a store redelivers records after a relaunch, and TelemetryDeck counts each copy."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what TelemetryDeck receives, and why, in more detail."}],"type":"paragraph"}]}],"abstract":[{"text":"Send records to TelemetryDeck as signals, through its Ingest API v3.","type":"text"}],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/telemetrydeckencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding":{"role":"collection","title":"TelemetryDeckEncoding","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","url":"\/documentation\/telemetrydeckencoding","abstract":[{"type":"text","text":"Send records to TelemetryDeck as signals, through its Ingest API v3."}],"type":"topic","kind":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of TelemetryDeck’s Ingest API v3, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"can send events to an organization’s "},{"code":"POST \/v3\/<namespace>\/","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder","title":"TelemetryDeckBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","type":"topic","kind":"symbol","navigatorTitle":[{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/HTTPDestinations/HTTPDestination/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)":{"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"URLSessionTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"TelemetryDeckBatchEncoder","type":"codeVoice"},{"text":".","type":"text"}]},"type":"topic","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"telemetryDeck","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"namespace","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"testMode","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"TelemetryDeckSetupError","kind":"typeIdentifier","preciseIdentifier":"s:21TelemetryDeckEncoding0aB10SetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"URLSessionTransport","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV"},{"text":", ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:21TelemetryDeckEncoding0aB12BatchEncoderV"},{"text":">","kind":"text"}],"abstract":[{"text":"A destination that sends batches to the TelemetryDeck app ","type":"text"},{"type":"codeVoice","code":"appID"},{"text":", in the organization’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"namespace"},{"text":", marking every event as a test event or not as ","type":"text"},{"type":"codeVoice","code":"testMode"},{"text":" says, with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"URLSession.shared"},{"text":", retrying a send that fails for now with the waits of ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"clock"},{"text":".","type":"text"}],"title":"telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","url":"\/documentation\/telemetrydeckencoding\/httpdestinations\/httpdestination\/telemetrydeck(appid:namespace:testmode:plan:backoff:clock:)","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","role":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckSetupError":{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError","title":"TelemetryDeckSetupError","role":"symbol","navigatorTitle":[{"text":"TelemetryDeckSetupError","kind":"identifier"}],"abstract":[