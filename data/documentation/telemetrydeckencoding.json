{"sections":[],"identifier":{"url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","interfaceLanguage":"swift"},"topicSections":[{"title":"Sending to TelemetryDeck","anchor":"Sending-to-TelemetryDeck","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError"]},{"title":"Encoding batches","anchor":"Encoding-batches","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"]},{"title":"Records left out","anchor":"Records-left-out","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","type":"reference"},{"text":" ","type":"text"},{"text":"makes an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference"},{"text":") for TelemetryDeck in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the app ID and your organization’s namespace, then posts to","type":"text"},{"text":" ","type":"text"},{"code":"https:\/\/nom.telemetrydeck.com\/v3\/<namespace>\/","type":"codeVoice"},{"text":" with a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","type":"reference"},{"text":". Each batch is","type":"text"},{"text":" ","type":"text"},{"text":"split to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","type":"reference"},{"text":": 100 signals a request, as TelemetryDeck’s","type":"text"},{"text":" ","type":"text"},{"text":"SwiftSDK sends them; 333,333 bytes a signal, a third of Ingest API v3’s limit of 1,000,000; and","type":"text"},{"text":" ","type":"text"},{"text":"1,000,000 bytes a request, the encoder’s own bound, as TelemetryDeck documents none. A batch with no record the encoder can write, an empty one included, makes","type":"text"},{"text":" ","type":"text"},{"text":"no request. The destination retries no response, a 5xx (TelemetryDeck answers 503 while its queue","type":"text"},{"text":" ","type":"text"},{"text":"is full), 408 and 429, and drops and reports any other status. No trace context is sent.","type":"text"},{"text":" ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves this module out, so import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app ID only says which app a signal belongs to, and TelemetryDeck’s own SDKs ship it inside"},{"type":"text","text":" "},{"type":"text","text":"every app, so the destination builds on every platform and an app sends to TelemetryDeck directly."}]},{"syntax":"swift","type":"codeListing","code":["import HTTPDestinations","import TelemetryDeckEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: telemetryDeck)"]},{"type":"paragraph","inlineContent":[{"text":"The factory throws ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError","isActive":true,"type":"reference"},{"text":" for an app ID that is empty or only whitespace,","type":"text"},{"text":" ","type":"text"},{"text":"and for a namespace TelemetryDeck doesn’t take. A namespace holds only ASCII letters, digits, ","type":"text"},{"code":".","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"_","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"-","type":"codeVoice"},{"text":", and can’t be ","type":"text"},{"code":"w","type":"codeVoice"},{"text":", ","type":"text"},{"code":".","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"..","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"testMode"},{"type":"text","text":" has no default. TelemetryDeck shows test signals only in its Test Mode, apart from your"},{"type":"text","text":" "},{"type":"text","text":"real users, and its SDK picks test mode for debug builds. Pass whatever your app uses to tell its"},{"type":"text","text":" "},{"type":"text","text":"builds apart, such as "},{"type":"codeVoice","code":"true"},{"type":"text","text":" under "},{"type":"codeVoice","code":"#if DEBUG"},{"type":"text","text":" and "},{"type":"codeVoice","code":"false"},{"type":"text","text":" otherwise."}]},{"anchor":"User-counts-are-sessions","level":3,"type":"heading","text":"User counts are sessions"},{"type":"paragraph","inlineContent":[{"text":"TelemetryDeck counts users by ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":". The destination sends the record’s session, from the","type":"text"},{"text":" ","type":"text"},{"text":"sessions enricher, as ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":", hashed the way TelemetryDeck’s SDKs hash a user identifier:","type":"text"},{"text":" ","type":"text"},{"text":"SHA-256 of the lowercase UUID, in lowercase hex, with the SDKs’ default, empty salt.","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck salts and hashes ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" again on its server. The same session is also the","type":"text"},{"text":" ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", in the clear, so a salt of the app’s own would hide nothing, and the destination takes","type":"text"},{"text":" ","type":"text"},{"text":"none. Nothing else identifies a record: no vendor identifier, device identifier or","type":"text"},{"text":" ","type":"text"},{"text":"account, and no trace context.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"So TelemetryDeck’s user counts are session counts. A person who opens the app three times is three","type":"text"},{"text":" ","type":"text"},{"text":"users, and its retention charts show how long a session lasts, not whether people come back. That","type":"text"},{"text":" ","type":"text"},{"text":"is the library’s default, for privacy. To count devices instead, put","type":"text"},{"text":" ","type":"text"},{"code":"StandardContext","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"VendorIdentifierKey","type":"codeVoice"},{"text":" in the records’ context and send them through a","type":"text"},{"text":" ","type":"text"},{"text":"destination that reads it, or write your own enricher and encoder that send the identifier you","type":"text"},{"text":" ","type":"text"},{"text":"choose. This encoder sends the session alone.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record with no session, such as one a store recovered after a relaunch, is its own user: its"},{"type":"text","text":" "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":" is the hash of the record’s identifier, and it has no "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":". Making up a session"},{"type":"text","text":" "},{"type":"text","text":"would join unrelated records, and skipping the record would lose it."}]},{"anchor":"What-TelemetryDeck-receives","level":3,"type":"heading","text":"What TelemetryDeck receives"},{"type":"paragraph","inlineContent":[{"text":"Each request is a JSON array of signals, one per record. Every signal has:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"appID","type":"codeVoice"},{"text":", as given, without surrounding whitespace;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"type"},{"type":"text","text":", the event’s name;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"clientUser"},{"type":"text","text":", the hashed session, and "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":", the session;"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"receivedAt"},{"type":"text","text":", the record’s timestamp in ISO 8601 with milliseconds, so a signal sent late still"},{"type":"text","text":" "},{"type":"text","text":"counts at the time it was tracked;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"isTestMode","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"true\"","type":"codeVoice"},{"type":"text","text":" or "},{"code":"\"false\"","type":"codeVoice"},{"type":"text","text":";"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.SDK.name"},{"type":"text","text":", "},{"type":"codeVoice","code":"Traffluent"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The record’s properties are read through the event’s schema in the ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":" the encoder is","type":"text"},{"text":" ","type":"text"},{"text":"made with, and sit beside these, each keeping its JSON type. TelemetryDeck doesn’t index nested","type":"text"},{"text":" ","type":"text"},{"text":"values, so an object or array is flattened into dotted names: a ","type":"text"},{"type":"codeVoice","code":"cart"},{"text":" holding ","type":"text"},{"type":"codeVoice","code":"size"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"cart.size"},{"text":", and the first element of ","type":"text"},{"type":"codeVoice","code":"tags"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"tags.0"},{"text":". A ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" property is left out. A","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value is never sent, whatever the record reveals. No ","type":"text"},{"type":"codeVoice","code":"floatValue"},{"text":" is sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context, when the record has it, becomes TelemetryDeck’s built-in parameters:"}]},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Context"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Parameters"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.version"},{"type":"text","text":", "},{"type":"codeVoice","code":".buildNumber"},{"type":"text","text":" and "},{"type":"codeVoice","code":".versionAndBuildNumber"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.modelName"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.operatingSystem"},{"type":"text","text":", "},{"type":"codeVoice","code":".platform"},{"type":"text","text":", "},{"type":"codeVoice","code":".systemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":".systemMajorVersion"},{"type":"text","text":" and "},{"type":"codeVoice","code":".systemMajorMinorVersion"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.locale"},{"type":"text","text":" and "},{"type":"codeVoice","code":".language"},{"type":"text","text":", and "},{"type":"codeVoice","code":"TelemetryDeck.UserPreference.region"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The bundle identifier, the form factor and the network aren’t sent."}]},{"anchor":"Records-left-out","level":3,"type":"heading","text":"Records left out"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"one the plan doesn’t describe, whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", or that holds a value JSON can’t;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose event name or parameter name, once flattened, holds anything but ASCII letters, digits,"},{"type":"text","text":" "},{"code":".","type":"codeVoice"},{"type":"text","text":", "},{"code":"_","type":"codeVoice"},{"type":"text","text":" and "},{"code":"-","type":"codeVoice"},{"type":"text","text":", or is empty. TelemetryDeck refuses the whole request for one such name."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose event name or parameter name starts with ","type":"text"},{"code":"TelemetryDeck.","type":"codeVoice"},{"text":", in any case: TelemetryDeck","type":"text"},{"text":" ","type":"text"},{"text":"reserves that scope for its SDKs’ parameters and its server’s;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one with a parameter named as one of a signal’s own members, "},{"type":"codeVoice","code":"appID"},{"type":"text","text":", "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"receivedAt"},{"type":"text","text":", "},{"type":"codeVoice","code":"type"},{"type":"text","text":", "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":", "},{"type":"codeVoice","code":"isTestMode"},{"type":"text","text":" or "},{"type":"codeVoice","code":"floatValue"},{"type":"text","text":", spelled exactly so: in the flat"},{"type":"text","text":" "},{"type":"text","text":"signal it would replace the member. A name like one in another case, such as "},{"type":"codeVoice","code":"Type"},{"type":"text","text":", is sent."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose values flatten to the same name twice;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose timestamp falls outside the years 1 to 9999, which TelemetryDeck can’t parse;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose JSON is over 333,333 bytes. TelemetryDeck refuses the whole request for a signal over"},{"type":"text","text":" "},{"type":"text","text":"1,000,000 bytes as its server writes it, which may be larger than the encoder’s; a third leaves"},{"type":"text","text":" "},{"type":"text","text":"room for the escapes a re-encoder commonly adds."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The destination reports each as ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" whose reason is a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","isActive":true,"type":"reference"},{"text":". When the destination is made, it logs a notice for each event and","type":"text"},{"text":" ","type":"text"},{"text":"property of the plan whose name would be left out.","type":"text"}]},{"anchor":"What-TelemetryDeck-doesnt-report","level":3,"type":"heading","text":"What TelemetryDeck doesn’t report"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TelemetryDeck answers 200 to any namespace and any app ID it can read, so a typo in either loses"},{"type":"text","text":" "},{"type":"text","text":"every signal without an error. Check that the first signals show up in the dashboard, in Test Mode"},{"type":"text","text":" "},{"type":"text","text":"when "},{"type":"codeVoice","code":"testMode"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"TelemetryDeck doesn’t remove duplicates. A record is sent more than once when a request is retried","type":"text"},{"text":" ","type":"text"},{"text":"after TelemetryDeck stored it but the answer was lost, when a delivery sends a cancelled batch","type":"text"},{"text":" ","type":"text"},{"text":"again, and when a store redelivers records after a relaunch, and TelemetryDeck counts each copy.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers what TelemetryDeck receives, and why, in more detail.","type":"text"}]}],"kind":"content"}],"metadata":{"externalID":"TelemetryDeckEncoding","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"TelemetryDeckEncoding"}],"role":"collection","title":"TelemetryDeckEncoding"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding"]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[[]]},"abstract":[{"text":"Send records to TelemetryDeck as signals, through its Ingest API v3.","type":"text"}],"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckEncodingError":{"role":"symbol","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","abstract":[{"type":"text","text":"Why "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckEncodingError"}],"title":"TelemetryDeckEncodingError","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckencodingerror","navigatorTitle":[{"kind":"identifier","text":"TelemetryDeckEncodingError"}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding":{"title":"TelemetryDeckEncoding","abstract":[{"type":"text","text":"Send records to TelemetryDeck as signals, through its Ingest API v3."}],"url":"\/documentation\/telemetrydeckencoding","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/TelemetryD