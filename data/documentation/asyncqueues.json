{"identifier":{"url":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Reading-reports","title":"Reading reports","identifiers":["doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue"]}],"hierarchy":{"paths":[[]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","isActive":true,"type":"reference"},{"text":" is what a store’s, a consent’s, a tracker’s and a destination’s report streams","type":"text"},{"text":" ","type":"text"},{"text":"are: ","type":"text"},{"code":"SegmentStore.dropReports","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DatabaseStore.dropReports","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Consent.dropReports","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"Tracker.rejectionReports","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Tracker.samplingDropReports","type":"codeVoice"},{"text":", ","type":"text"},{"code":"HTTPDestination.dropReports","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"InMemoryDestination.deliveries","type":"codeVoice"},{"text":". You read one with ","type":"text"},{"code":"for await","type":"codeVoice"},{"text":", as you would any asynchronous","type":"text"},{"text":" ","type":"text"},{"text":"sequence. The type that owns the queue fills it and ends it. Your code only reads.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What arrives while nothing reads waits for the next read, as the owner’s documentation says:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"A store’s and an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":"’s drop reports wait without a bound."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A tracker’s rejection reports merge into one per event, property and keyword.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Its sampling drop reports merge into one per event type.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A consent’s drop reports merge only when a held-record-limit report follows another."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"InMemoryDestination"},{"type":"text","text":" keeps only its newest batches."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The queue ends once its owner is gone or finished and every waiting element has been read.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"One task reads at a time. The first iterator to read holds the queue until its iteration ends or","type":"text"},{"text":" ","type":"text"},{"text":"the iterator is released, as it is when its task ends. A holder that stops calling ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" but","type":"text"},{"text":" ","type":"text"},{"text":"keeps its iterator keeps the turn. A second reader that starts meanwhile logs a warning once and","type":"text"},{"text":" ","type":"text"},{"text":"waits until the first one’s iteration ends or its iterator is released, then reads on from the","type":"text"},{"text":" ","type":"text"},{"text":"next element. So the reader","type":"text"},{"text":" ","type":"text"},{"text":"holding the queue gets every element, in order, and nothing traps or takes elements from it. A","type":"text"},{"text":" ","type":"text"},{"text":"reader cancelled while it waits returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and leaves the holder alone. To hand every report to","type":"text"},{"text":" ","type":"text"},{"text":"several parts of the app, read the queue in one task and fan each report out from there.","type":"text"}],"type":"paragraph"},{"code":["let reports = store.dropReports","Task {","    for await report in reports {","        logger.warning(\"Dropped: \\(report)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Read the queue into a constant before starting the task, as above, so the task holds the queue"},{"type":"text","text":" "},{"type":"text","text":"and not its owner. The umbrella guide on reading reports is"},{"type":"text","text":" "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/gettingstarted","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"type":"text","text":"The sequence type of every report and delivery stream the library hands out, read by one task at a time."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/asyncqueues"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"collection","symbolKind":"module","roleHeading":"Framework","title":"AsyncQueues","externalID":"AsyncQueues","modules":[{"name":"AsyncQueues"}]},"references":{"doc://AsyncQueues/documentation/AsyncQueues":{"title":"AsyncQueues","url":"\/documentation\/asyncqueues","role":"collection","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues","kind":"symbol","abstract":[{"type":"text","text":"The sequence type of every report and delivery stream the library hands out, read by one task at a time."}],"type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/gettingstarted":{"titleInlineContent":[{"text":"Getting Started","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/gettingstarted","type":"link","title":"Getting Started","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/gettingstarted"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","title":"AsyncQueue","navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"type":"topic","url":"\/documentation\/asyncqueues\/asyncqueue","kind":"symbol","abstract":[{"type":"text","text":"The reports or deliveries a library type makes, in the order it makes them, kept until they"},{"type":"text","text":" "},{"type":"text","text":"are read; one reader at a time reads them."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}]}}}