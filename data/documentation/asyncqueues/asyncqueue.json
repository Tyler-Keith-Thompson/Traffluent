{"sections":[],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/AsyncQueues\/s8SendableP","doc:\/\/AsyncQueues\/s16SendableMetatypeP","doc:\/\/AsyncQueues\/Sci"],"type":"conformsTo"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"struct","title":"AsyncQueue","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AsyncQueues\/AsyncQueue.swift#L47","fileName":"AsyncQueue.swift"},"navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"externalID":"s:11AsyncQueues0A5QueueV","modules":[{"name":"AsyncQueues"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"roleHeading":"Structure","role":"symbol"},"identifier":{"url":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","interfaceLanguage":"swift"},"abstract":[{"text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every report stream the library hands out is one, such as a store’s drop reports:"}]},{"code":["let reports = store.dropReports","Task {","    for await report in reports {","        logger.warning(\"Dropped: \\(report)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"An app makes one through a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/Continuation","type":"reference"},{"text":" where it hands out a stream of its own, such as","type":"text"},{"text":" ","type":"text"},{"text":"the library’s reports merged into one, so a second reader of it waits its turn rather than","type":"text"},{"text":" ","type":"text"},{"text":"trapping:","type":"text"}]},{"code":["let drops = AsyncQueue<String>.Continuation(name: \"the app's drop reports\")","let storeReports = store.dropReports","Task {","    for await report in storeReports {","        drops.enqueue(\"Not stored: \\(report)\")","    }","    drops.finish()","}","let reads = drops.queue"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Only the queue’s maker writes to it: the library’s queues take elements from the library","type":"text"},{"text":" ","type":"text"},{"text":"alone, and an app’s from its continuation. Elements enqueued while no one reads wait for the","type":"text"},{"text":" ","type":"text"},{"text":"next read: without a bound in a queue an app makes; in the library’s, without a bound, merged","type":"text"},{"text":" ","type":"text"},{"text":"into one another, or the newest only, as the documentation of the type that makes them says.","type":"text"},{"text":" ","type":"text"},{"text":"The sequence ends once it is finished and every element before the end has been read.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads at a time. The first iterator to read holds the queue until its iteration ends"},{"type":"text","text":" "},{"type":"text","text":"or the iterator is released, as it is when its task ends. An iterator that reads meanwhile"},{"type":"text","text":" "},{"type":"text","text":"waits its turn, logging a warning as it starts to, then reads on from the next element; several"},{"type":"text","text":" "},{"type":"text","text":"wait in the order they came. So the reader holding the queue gets every element, in order, and"},{"type":"text","text":" "},{"type":"text","text":"no other reader takes one from it. A read whose task is cancelled returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" and takes"},{"type":"text","text":" "},{"type":"text","text":"nothing, ending that iterator’s turn: the next read, by it or by the reader waiting next, gets"},{"type":"text","text":" "},{"type":"text","text":"the element it was waiting for. A reader cancelled while it waits its turn returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" too,"},{"type":"text","text":" "},{"type":"text","text":"leaving the reader holding the queue undisturbed."}]}],"kind":"content"}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/AsyncIterator","doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/Continuation"],"anchor":"Structures","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/makeAsyncIterator()"],"anchor":"Instance-Methods","generated":true},{"title":"Type Aliases","identifiers":["doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/Failure"],"anchor":"Type-Aliases","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/AsyncSequence-Implementations"],"anchor":"Default-Implementations","generated":true}],"hierarchy":{"paths":[["doc:\/\/AsyncQueues\/documentation\/AsyncQueues"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/asyncqueues\/asyncqueue"]}],"kind":"symbol","references":{"doc://AsyncQueues/s8SendableP":{"identifier":"doc:\/\/AsyncQueues\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://AsyncQueues/documentation/AsyncQueues":{"type":"topic","role":"collection","title":"AsyncQueues","kind":"symbol","abstract":[{"text":"The sequence type of every report and delivery stream the library hands out, and of an app’s own, read by one task at a time.","type":"text"}],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues","url":"\/documentation\/asyncqueues"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue/Continuation":{"title":"AsyncQueue.Continuation","type":"topic","kind":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}]},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Continuation"}],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/Continuation","navigatorTitle":[{"kind":"identifier","text":"Continuation"}],"url":"\/documentation\/asyncqueues\/asyncqueue\/continuation","abstract":[{"text":"The writing end of a queue an app makes: it adds elements and ends the queue, while","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/Continuation\/queue"},{"text":" is handed to the code that reads.","type":"text"}],"role":"symbol"},"doc://AsyncQueues/Sci":{"type":"unresolvable","identifier":"doc:\/\/AsyncQueues\/Sci","title":"_Concurrency.AsyncSequence"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue/AsyncSequence-Implementations":{"type":"topic","role":"collectionGroup","title":"AsyncSequence Implementations","kind":"article","abstract":[],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/AsyncSequence-Implementations","url":"\/documentation\/asyncqueues\/asyncqueue\/asyncsequence-implementations"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue/makeAsyncIterator()":{"title":"makeAsyncIterator()","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeAsyncIterator"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV0A8IteratorV","text":"AsyncIterator"}],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/makeAsyncIterator()","url":"\/documentation\/asyncqueues\/asyncqueue\/makeasynciterator()","abstract":[{"text":"An iterator over the queue; reading starts with its first ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":".","type":"text"}],"role":"symbol"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue/AsyncIterator":{"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIterator","kind":"identifier"}],"navigatorTitle":[{"text":"AsyncIterator","kind":"identifier"}],"title":"AsyncQueue.AsyncIterator","kind":"symbol","abstract":[{"text":"Reads a queue, in turn with its other readers.","type":"text"}],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/AsyncIterator","url":"\/documentation\/asyncqueues\/asyncqueue\/asynciterator"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"url":"\/documentation\/asyncqueues\/asyncqueue","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"abstract":[{"text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads","type":"text"},{"text":" ","type":"text"},{"text":"them."