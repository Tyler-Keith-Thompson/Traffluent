{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/asyncqueues\/asyncqueue"]}],"topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/AsyncIterator"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/makeAsyncIterator()"],"generated":true},{"title":"Type Aliases","anchor":"Type-Aliases","identifiers":["doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/Failure"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue\/AsyncSequence-Implementations"],"generated":true}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"syntax":"swift","type":"codeListing","code":["let reports = store.dropReports","Task {","    for await report in reports {","        logger.warning(\"Dropped: \\(report)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Elements made while no one reads wait for the next read, as the type that makes them buffers","type":"text"},{"text":" ","type":"text"},{"text":"them: without a bound, merged into one another, or the newest only, as its documentation says.","type":"text"},{"text":" ","type":"text"},{"text":"The sequence ends once its maker finishes it and every element before the end has been read.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"One task reads at a time. The first iterator to read holds the queue until its iteration ends","type":"text"},{"text":" ","type":"text"},{"text":"or the iterator is released, as it is when its task ends. An iterator that reads meanwhile","type":"text"},{"text":" ","type":"text"},{"text":"waits its turn, logging a warning as it starts to, then reads on from the next element; several","type":"text"},{"text":" ","type":"text"},{"text":"wait in the order they came. So the reader holding the queue gets every element, in order, and","type":"text"},{"text":" ","type":"text"},{"text":"no other reader takes one from it. A read whose task is cancelled returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and takes","type":"text"},{"text":" ","type":"text"},{"text":"nothing, ending that iterator’s turn: the next read, by it or by the reader waiting next, gets","type":"text"},{"text":" ","type":"text"},{"text":"the element it was waiting for. A reader cancelled while it waits its turn returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" too,","type":"text"},{"text":" ","type":"text"},{"text":"leaving the reader holding the queue undisturbed.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/AsyncQueues\/documentation\/AsyncQueues"]]},"metadata":{"role":"symbol","symbolKind":"struct","externalID":"s:11AsyncQueues0A5QueueV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"modules":[{"name":"AsyncQueues"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AsyncQueues\/AsyncQueue.swift#L27","fileName":"AsyncQueue.swift"},"title":"AsyncQueue","navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"roleHeading":"Structure"},"kind":"symbol","relationshipsSections":[{"title":"Conforms To",