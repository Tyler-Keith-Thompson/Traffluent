{"abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","type":"reference"},{"type":"text","text":" finds each record’s span from the "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" the event was tracked"},{"type":"text","text":" "},{"type":"text","text":"in, so a delivery that runs later, under another span or none, still adds the event to the right"},{"type":"text","text":" "},{"type":"text","text":"one. Each span event is named after the event, stamped with the time it was tracked, and carries"},{"type":"text","text":" "},{"type":"text","text":"the event’s description under "},{"type":"codeVoice","code":"event"},{"type":"text","text":" and its call site under OpenTelemetry’s "},{"type":"codeVoice","code":"code.*"},{"type":"text","text":" attribute"},{"type":"text","text":" "},{"type":"text","text":"names."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Span events can’t be added to a span that has ended. A record tracked outside any span, or whose"},{"type":"text","text":" "},{"type":"text","text":"span ended before its batch was delivered, is left out. Batch tightly enough for your spans to"},{"type":"text","text":" "},{"type":"text","text":"outlive their batches, and deliver to another destination as well for the events that must not be"},{"type":"text","text":" "},{"type":"text","text":"lost. To write events to your logs instead, use "},{"code":"LoggerDestination","type":"codeVoice"},{"type":"text","text":" in the "},{"code":"LoggingDestinations","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"module."}]},{"code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: SpanEventDestination(tracer: tracer))","let span = tracer.startSpan(\"checkout\")","ServiceContext.withValue(span.context) {","    tracker.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()","span.end()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The umbrella guide on this area is","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}],"metadata":{"symbolKind":"module","modules":[{"name":"TracingDestinations"}],"externalID":"TracingDestinations","roleHeading":"Framework","role":"collection","title":"TracingDestinations"},"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"],"title":"Destinations","anchor":"Destinations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tracingdestinations"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}]},"doc://TracingDestinations/documentation/TracingDestinations":{"kind":"symbol","title":"TracingDestinations","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","url":"\/documentation\/tracingdestinations","type":"topic","role":"collection","abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}]},"doc://TracingDestinations/documentation/TracingDestinations/SpanEventDestination":{"kind":"symbol","title":"SpanEventDestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpanEventDestination"}],"type":"topic","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","url":"\/documentation\/tracingdestinations\/spaneventdestination","navigatorTitle":[{"kind":"identifier","text":"SpanEventDestination"}],"role":"symbol","abstract":[{"type":"text","text":"A destination that adds each event to the span that was active when the event was tracked."}]}}}