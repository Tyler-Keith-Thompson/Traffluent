{"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"},{"type":"text","text":" finds each record’s span from the "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":" the event was tracked"},{"type":"text","text":" "},{"type":"text","text":"in, so a delivery that runs later, under another span or none, still adds the event to the right"},{"type":"text","text":" "},{"type":"text","text":"one. Each span event is named after the event, stamped with the time it was tracked, and carries"},{"type":"text","text":" "},{"type":"text","text":"the event’s description under "},{"code":"event","type":"codeVoice"},{"type":"text","text":" and its call site under OpenTelemetry’s "},{"code":"code.*","type":"codeVoice"},{"type":"text","text":" attribute"},{"type":"text","text":" "},{"type":"text","text":"names."}]},{"type":"paragraph","inlineContent":[{"text":"Span events can’t be added to a span that has ended. A record tracked outside any span, or whose","type":"text"},{"text":" ","type":"text"},{"text":"span ended before its batch was delivered, is left out. Batch tightly enough for your spans to","type":"text"},{"text":" ","type":"text"},{"text":"outlive their batches, and deliver to another destination as well for the events that must not be","type":"text"},{"text":" ","type":"text"},{"text":"lost. To write events to your logs instead, use ","type":"text"},{"code":"LoggerDestination","type":"codeVoice"},{"text":" in the ","type":"text"},{"code":"LoggingDestinations","type":"codeVoice"},{"text":" ","type":"text"},{"text":"module.","type":"text"}]},{"type":"codeListing","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: SpanEventDestination(tracer: tracer))","let span = tracer.startSpan(\"checkout\")","ServiceContext.withValue(span.context) {","    tracker.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()","span.end()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":"."}]}],"kind":"content"}],"topicSections":[{"anchor":"Destinations","title":"Destinations","identifiers":["doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"]}],"metadata":{"role":"collection","title":"TracingDestinations","externalID":"TracingDestinations","symbolKind":"module","modules":[{"name":"TracingDestinations"}],"roleHeading":"Framework"},"hierarchy":{"paths":[[]]},"abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"identifier":{"url":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/tracingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"title":"Choosing Destinations","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://TracingDestinations/documentation/TracingDestinations":{"abstract":[{"type":"text","text":"A destination that adds each tracked event to the span that was active when it was tracked."}],"role":"collection","type":"topic","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","url":"\/documentation\/tracingdestinations","kind":"symbol","title":"TracingDestinations"},"doc://TracingDestinations/documentation/TracingDestinations/SpanEventDestination":{"title":"SpanEventDestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanEventDestination","kind":"identifier"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"SpanEventDestination","kind":"identifier"}],"abstract":[{"type":"text","text":"A destination that adds each event to the span that was active when the event was tracked."}],"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","url":"\/documentation\/tracingdestinations\/spaneventdestination","role":"symbol"}}}