{"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"identifiers":["doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"],"anchor":"Destinations","title":"Destinations"}],"metadata":{"title":"TracingDestinations","modules":[{"name":"TracingDestinations"}],"role":"collection","externalID":"TracingDestinations","symbolKind":"module","roleHeading":"Framework"},"sections":[],"hierarchy":{"paths":[[]]},"abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"identifier":{"url":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"},{"type":"text","text":" finds each record’s span from the "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" the event was tracked"},{"type":"text","text":" "},{"type":"text","text":"in, so a delivery that runs later, under another span or none, still adds the event to the right"},{"type":"text","text":" "},{"type":"text","text":"one. Each span event is named after the event, stamped with the time it was tracked, and carries"},{"type":"text","text":" "},{"type":"text","text":"the event’s description under "},{"type":"codeVoice","code":"event"},{"type":"text","text":" and its call site under OpenTelemetry’s "},{"type":"codeVoice","code":"code.*"},{"type":"text","text":" attribute"},{"type":"text","text":" "},{"type":"text","text":"names."}],"type":"paragraph"},{"inlineContent":[{"text":"Span events can’t be added to a span that has ended. A record tracked outside any span, or whose","type":"text"},{"text":" ","type":"text"},{"text":"span ended before its batch was delivered, is left out. Batch tightly enough for your spans to","type":"text"},{"text":" ","type":"text"},{"text":"outlive their batches, and deliver to another destination as well for the events that must not be","type":"text"},{"text":" ","type":"text"},{"text":"lost. To write events to your logs instead, use ","type":"text"},{"code":"LoggerDestination","type":"codeVoice"},{"text":" in the ","type":"text"},{"code":"LoggingDestinations","type":"codeVoice"},{"text":" ","type":"text"},{"text":"module.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: SpanEventDestination(tracer: tracer))","let span = tracer.startSpan(\"checkout\")","ServiceContext.withValue(span.context) {","    tracker.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()","span.end()"],"type":"codeListing"},{"inlineContent":[{"text":"The umbrella guide on this area is","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/tracingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://TracingDestinations/documentation/TracingDestinations/SpanEventDestination":{"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SpanEventDestination"}],"url":"\/documentation\/tracingdestinations\/spaneventdestination","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","role":"symbol","title":"SpanEventDestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpanEventDestination"}],"abstract":[{"text":"A destination that adds each event to the span that was active when the event was tracked.","type":"text"}]},"doc://TracingDestinations/documentation/TracingDestinations":{"type":"topic","kind":"symbol","abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","url":"\/documentation\/tracingdestinations","title":"TracingDestinations","role":"collection"}}}