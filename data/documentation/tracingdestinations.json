{"topicSections":[{"title":"Destinations","anchor":"Destinations","identifiers":["doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"]}],"hierarchy":{"paths":[[]]},"abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"identifier":{"url":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","interfaceLanguage":"swift"},"metadata":{"title":"TracingDestinations","role":"collection","roleHeading":"Framework","externalID":"TracingDestinations","symbolKind":"module","modules":[{"name":"TracingDestinations"}]},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","isActive":true},{"type":"text","text":" finds each record’s span from the "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":" the event was tracked"},{"type":"text","text":" "},{"type":"text","text":"in, so a delivery that runs later, under another span or none, still adds the event to the right"},{"type":"text","text":" "},{"type":"text","text":"one. Each span event is named after the event, stamped with the time it was tracked, and carries"},{"type":"text","text":" "},{"type":"text","text":"the event’s description under "},{"code":"event","type":"codeVoice"},{"type":"text","text":" and its call site under OpenTelemetry’s "},{"code":"code.*","type":"codeVoice"},{"type":"text","text":" attribute"},{"type":"text","text":" "},{"type":"text","text":"names."}]},{"type":"paragraph","inlineContent":[{"text":"Span events can’t be added to a span that has ended. A record tracked outside any span, or whose","type":"text"},{"text":" ","type":"text"},{"text":"span ended before its batch was delivered, is left out. Batch tightly enough for your spans to","type":"text"},{"text":" ","type":"text"},{"text":"outlive their batches, and deliver to another destination as well for the events that must not be","type":"text"},{"text":" ","type":"text"},{"text":"lost. To write events to your logs instead, use ","type":"text"},{"type":"codeVoice","code":"LoggerDestination"},{"text":" in the ","type":"text"},{"type":"codeVoice","code":"LoggingDestinations"},{"text":" ","type":"text"},{"text":"module.","type":"text"}]},{"type":"codeListing","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: SpanEventDestination(tracer: tracer))","let span = tracer.startSpan(\"checkout\")","ServiceContext.withValue(span.context) {","    tracker.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()","span.end()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The umbrella guide on this area is","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"text":".","type":"text"}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tracingdestinations"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://TracingDestinations/documentation/TracingDestinations":{"kind":"symbol","type":"topic","title":"TracingDestinations","role":"collection","url":"\/documentation\/tracingdestinations","abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations"},"doc://TracingDestinations/documentation/TracingDestinations/SpanEventDestination":{"navigatorTitle":[{"text":"SpanEventDestination","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanEventDestination","kind":"identifier"}],"abstract":[{"text":"A destination that adds each event to the span that was active when the event was tracked.","type":"text"}],"title":"SpanEventDestination","type":"topic","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","kind":"symbol","role":"symbol","url":"\/documentation\/tracingdestinations\/spaneventdestination"}}}