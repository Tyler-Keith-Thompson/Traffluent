{"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"],"title":"Destinations","anchor":"Destinations"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","isActive":true},{"type":"text","text":" finds each record’s span from the "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" the event was tracked"},{"type":"text","text":" "},{"type":"text","text":"in, so a delivery that runs later, under another span or none, still adds the event to the right"},{"type":"text","text":" "},{"type":"text","text":"one. Each span event is named after the event, stamped with the time it was tracked, and carries"},{"type":"text","text":" "},{"type":"text","text":"the event’s description under "},{"type":"codeVoice","code":"event"},{"type":"text","text":" and its call site under OpenTelemetry’s "},{"type":"codeVoice","code":"code.*"},{"type":"text","text":" attribute"},{"type":"text","text":" "},{"type":"text","text":"names."}]},{"type":"paragraph","inlineContent":[{"text":"Span events can’t be added to a span that has ended. A record tracked outside any span, or whose","type":"text"},{"text":" ","type":"text"},{"text":"span ended before its batch was delivered, is left out. Batch tightly enough for your spans to","type":"text"},{"text":" ","type":"text"},{"text":"outlive their batches, and deliver to another destination as well for the events that must not be","type":"text"},{"text":" ","type":"text"},{"text":"lost. To write events to your logs instead, use ","type":"text"},{"code":"LoggerDestination","type":"codeVoice"},{"text":" in the ","type":"text"},{"code":"LoggingDestinations","type":"codeVoice"},{"text":" ","type":"text"},{"text":"module.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: SpanEventDestination(tracer: tracer))","let span = tracer.startSpan(\"checkout\")","ServiceContext.withValue(span.context) {","    tracker.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()","span.end()"]},{"type":"paragraph","inlineContent":[{"text":"The umbrella guide on this area is","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"text":".","type":"text"}]}]}],"metadata":{"modules":[{"name":"TracingDestinations"}],"symbolKind":"module","role":"collection","roleHeading":"Framework","title":"TracingDestinations","externalID":"TracingDestinations"},"kind":"symbol","abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tracingdestinations"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations"},"sections":[],"references":{"doc://TracingDestinations/documentation/TracingDestinations":{"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","role":"collection","kind":"symbol","title":"TracingDestinations","url":"\/documentation\/tracingdestinations","abstract":[{"type":"text","text":"A destination that adds each tracked event to the span that was active when it was tracked."}],"type":"topic"},"doc://TracingDestinations/documentation/TracingDestinations/SpanEventDestination":{"url":"\/documentation\/tracingdestinations\/spaneventdestination","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanEventDestination","kind":"identifier"}],"navigatorTitle":[{"text":"SpanEventDestination","kind":"identifier"}],"title":"SpanEventDestination","kind":"symbol","abstract":[{"type":"text","text":"A destination that adds each event to the span that was active when the event was tracked."}],"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link"}}}