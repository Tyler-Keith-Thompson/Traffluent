{"abstract":[{"type":"text","text":"A destination that adds each tracked event to the span that was active when it was tracked."}],"metadata":{"modules":[{"name":"TracingDestinations"}],"roleHeading":"Framework","externalID":"TracingDestinations","role":"collection","title":"TracingDestinations","symbolKind":"module"},"topicSections":[{"identifiers":["doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"],"title":"Destinations","anchor":"Destinations"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"},{"text":" finds each record’s span from the ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":" the event was tracked","type":"text"},{"text":" ","type":"text"},{"text":"in, so a delivery that runs later, under another span or none, still adds the event to the right","type":"text"},{"text":" ","type":"text"},{"text":"one. Each span event is named after the event, stamped with the time it was tracked, and carries","type":"text"},{"text":" ","type":"text"},{"text":"the event’s description under ","type":"text"},{"type":"codeVoice","code":"event"},{"text":" and its call site under OpenTelemetry’s ","type":"text"},{"type":"codeVoice","code":"code.*"},{"text":" attribute","type":"text"},{"text":" ","type":"text"},{"text":"names.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Span events can’t be added to a span that has ended. A record tracked outside any span, or whose","type":"text"},{"text":" ","type":"text"},{"text":"span ended before its batch was delivered, is left out. Batch tightly enough for your spans to","type":"text"},{"text":" ","type":"text"},{"text":"outlive their batches, and deliver to another destination as well for the events that must not be","type":"text"},{"text":" ","type":"text"},{"text":"lost. To write events to your logs instead, use ","type":"text"},{"code":"LoggerDestination","type":"codeVoice"},{"text":" in the ","type":"text"},{"code":"LoggingDestinations","type":"codeVoice"},{"text":" ","type":"text"},{"text":"module.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: SpanEventDestination(tracer: tracer))","let span = tracer.startSpan(\"checkout\")","ServiceContext.withValue(span.context) {","    tracker.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()","span.end()"]},{"type":"paragraph","inlineContent":[{"text":"The umbrella guide on this area is","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/tracingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[[]]},"sections":[],"identifier":{"url":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","interfaceLanguage":"swift"},"kind":"symbol","references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}]},"doc://TracingDestinations/documentation/TracingDestinations":{"abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"type":"topic","url":"\/documentation\/tracingdestinations","title":"TracingDestinations","role":"collection","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","kind":"symbol"},"doc://TracingDestinations/documentation/TracingDestinations/SpanEventDestination":{"abstract":[{"text":"A destination that adds each event to the span that was active when the event was tracked.","type":"text"}],"title":"SpanEventDestination","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanEventDestination","kind":"identifier"}],"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","navigatorTitle":[{"text":"SpanEventDestination","kind":"identifier"}],"role":"symbol","url":"\/documentation\/tracingdestinations\/spaneventdestination"}}}