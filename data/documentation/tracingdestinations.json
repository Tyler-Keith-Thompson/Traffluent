{"abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","type":"reference"},{"text":" finds each record’s span from the ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" the event was tracked","type":"text"},{"text":" ","type":"text"},{"text":"in, so a delivery that runs later, under another span or none, still adds the event to the right","type":"text"},{"text":" ","type":"text"},{"text":"one. Each span event is named after the event, stamped with the time it was tracked, and carries","type":"text"},{"text":" ","type":"text"},{"text":"the event’s description under ","type":"text"},{"code":"event","type":"codeVoice"},{"text":" and its call site under OpenTelemetry’s ","type":"text"},{"code":"code.*","type":"codeVoice"},{"text":" attribute","type":"text"},{"text":" ","type":"text"},{"text":"names.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Span events can’t be added to a span that has ended. A record tracked outside any span, or whose","type":"text"},{"text":" ","type":"text"},{"text":"span ended before its batch was delivered, is left out. Batch tightly enough for your spans to","type":"text"},{"text":" ","type":"text"},{"text":"outlive their batches, and deliver to another destination as well for the events that must not be","type":"text"},{"text":" ","type":"text"},{"text":"lost. To write events to your logs instead, use ","type":"text"},{"code":"LoggerDestination","type":"codeVoice"},{"text":" in the ","type":"text"},{"code":"LoggingDestinations","type":"codeVoice"},{"text":" ","type":"text"},{"text":"module.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: SpanEventDestination(tracer: tracer))","let span = tracer.startSpan(\"checkout\")","ServiceContext.withValue(span.context) {","    tracker.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()","span.end()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":"."}],"type":"paragraph"}]}],"metadata":{"roleHeading":"Framework","role":"collection","symbolKind":"module","title":"TracingDestinations","externalID":"TracingDestinations","modules":[{"name":"TracingDestinations"}]},"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","topicSections":[{"title":"Destinations","anchor":"Destinations","identifiers":["doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/tracingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"type":"link","title":"Choosing Destinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://TracingDestinations/documentation/TracingDestinations":{"role":"collection","abstract":[{"type":"text","text":"A destination that adds each tracked event to the span that was active when it was tracked."}],"url":"\/docu