xt":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"text":"<","kind":"text"},{"text":"HeapEncodingError","kind":"typeIdentifier","preciseIdentifier":"s:12HeapEncoding0aB5ErrorO"},{"text":">","kind":"text"}],"abstract":[{"type":"codeVoice","code":"batch"},{"text":" as the requests Heap takes, each within the encoder’s limit, with the records left","type":"text"},{"text":" ","type":"text"},{"text":"out of them.","type":"text"}],"role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"url":"\/documentation\/httpdestinations\/batchencoder","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}],"type":"topic","title":"BatchEncoder"},"doc://HeapEncoding/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/HeapEncoding\/s16SendableMetatypeP"},"doc://HeapEncoding/s8SendableP":{"identifier":"doc:\/\/HeapEncoding\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"}}}