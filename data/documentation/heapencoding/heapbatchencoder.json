act":[{"text":"Every 2xx answer counts as delivered: Heap answers 200 only to a request it takes, and one it can’t with 400.","type":"text"}],"url":"\/documentation\/heapencoding\/heapbatchencoder\/outcome(of:for:)","title":"outcome(of:for:)","type":"topic"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapBatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"HeapBatchEncoder"}],"role":"symbol","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Heap’s server-side bulk track API, so an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send events to a Heap environment’s "},{"type":"codeVoice","code":"POST \/api\/track"},{"type":"text","text":"."}],"url":"\/documentation\/heapencoding\/heapbatchencoder","title":"HeapBatchEncoder","type":"topic"}}}