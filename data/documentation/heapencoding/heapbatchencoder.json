{"topicSections":[{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/Failure"],"anchor":"Type-Aliases","generated":true,"title":"Type Aliases"},{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/transientStatuses"],"anchor":"Type-Properties","generated":true,"title":"Type Properties"},{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/outcome(of:for:)"],"anchor":"Type-Methods","generated":true,"title":"Type Methods"},{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/BatchEncoder-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Heap’s server-side bulk track API, so an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send events to a Heap environment’s "},{"type":"codeVoice","code":"POST \/api\/track"},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapBatchEncoder","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Make the destination with ","type":"text"},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and its limits:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let heap = try HTTPDestination.heap(","    appID: appID,  \/\/ the environment's ID, from Heap's project settings","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":" with two members: "},{"type":"codeVoice","code":"app_id"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"app ID the encoder is made with, without leading or trailing whitespace, and "},{"type":"codeVoice","code":"events"},{"type":"text","text":", an array"},{"type":"text","text":" "},{"type":"text","text":"of one track event per record, oldest first. Each event is an object of these members:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"identity","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"idempotency_key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, flattened; left out when there are none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"type":"codeVoice","code":"user_id"},{"text":", which is Heap’s own ID of a","type":"text"},{"text":" ","type":"text"},{"text":"user, and no ","type":"text"},{"type":"codeVoice","code":"session_id"},{"text":". Heap makes a user for each identity it hasn’t seen, so its users are","type":"text"},{"text":" ","type":"text"},{"text":"sessions. A record with no session (one tracked by a tracker without ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":") is","type":"text"},{"text":" ","type":"text"},{"text":"its own user of one event, linked to nothing: Heap takes no event without an identity. The record’s vendor identifier,","type":"text"},{"text":" ","type":"text"},{"text":"trace context and standard context, and any other context value, aren’t sent: Heap keeps no","type":"text"},{"text":" ","type":"text"},{"text":"built-in property of a server-side event, so they would sit among the event’s own properties,","type":"text"},{"text":" ","type":"text"},{"text":"under names of the encoder’s choosing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. Heap takes a number or a string as a property’s value,"},{"type":"text","text":" "},{"type":"text","text":"so an object or array is spread into a property per value it holds, named after its path,"},{"type":"text","text":" "},{"type":"text","text":"joined by "},{"type":"codeVoice","code":"."},{"type":"text","text":" ("},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":"), a boolean is sent as the string "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is left out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name is over 1,024"},{"type":"text","text":" "},{"type":"text","text":"characters, one with a property Heap reserves or a property name or string value of"},{"type":"text","text":" "},{"type":"text","text":"1,024 characters or more, one whose values flatten to one name, one whose event isn’t"},{"type":"text","text":" "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is outside the years 1 to"},{"type":"text","text":" "},{"type":"text","text":"9999, and one too large for a request ("},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","isActive":true},{"type":"text","text":"). "},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","type":"reference","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. Heap answers a request it takes with 200 and one it can’t with 400, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops and reports with every record of the request. Heap stores an event"},{"type":"text","text":" "},{"type":"text","text":"once per "},{"type":"codeVoice","code":"idempotency_key"},{"type":"text","text":" within one identity, so a record sent again under the same session"},{"type":"text","text":" "},{"type":"text","text":"is stored once. A record a store recovers after a relaunch keeps its session, so it is sent"},{"type":"text","text":" "},{"type":"text","text":"under the identity of its first send, and Heap stores it once. The bytes are the same for the"},{"type":"text","text":" "},{"type":"text","text":"same records on every run and platform: no whitespace, object members in the order of their"},{"type":"text","text":" "},{"type":"text","text":"names’ UTF-8 bytes."}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/HeapEncoding\/documentation\/HeapEncoding"]]},"variants":[{"paths":["\/documentation\/heapencoding\/heapbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"HeapBatchEncoder","modules":[{"name":"HeapEncoding"}],"roleHeading":"Structure","role":"symbol","externalID":"s:12HeapEncoding0A12BatchEncoderV","navigatorTitle":[{"text":"HeapBatchEncoder","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapBatchEncoder"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HeapEncoding\/HeapBatchEncoder.swift#L66","fileName":"HeapBatchEncoder.swift"},"symbolKind":"struct"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HeapEncoding\/s8SendableP","doc:\/\/HeapEncoding\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/init(appID:plan:limit:)":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"HeapSetupError","kind":"typeIdentifier","preciseIdentifier":"s:12HeapEncoding0A10SetupErrorO"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"text":"An encoder of the events ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" describes, for the Heap environment ","type":"text"},{"code":"appID","type":"codeVoice"},{"text":", splitting each","type":"text"},{"text":" ","type":"text"},{"text":"batch to ","type":"text"},{"code":"limit","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/heapencoding\/heapbatchencoder\/init(appid:plan:limit:)","title":"init(appID:plan:limit:)"},"doc://HeapEncoding/documentation/HeapEncoding":{"kind":"symbol","role":"collection","title":"HeapEncoding","abstract":[{"type":"text","text":"Send records to Heap as custom events, through its server-side bulk track API."}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","type":"topic","url":"\/documentation\/heapencoding"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/BatchEncoder-Implementations":{"kind":"article","type":"topic","role":"collectionGroup","url":"\/documentation\/heapencoding\/heapbatchencoder\/batchencoder-implementations","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/BatchEncoder-Implementations","title":"BatchEncoder Implementations","abstract":[]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/batchLimit":{"kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"abstract":[{"text":"Heap’s limits on one request: 1,000 events and 1,000,000 bytes of body, and 1,000,000 bytes","type":"text"},{"text":" ","type":"text"},{"text":"of one event.","type":"text"}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","role":"symbol","type":"topic","url":"\/documentation\/heapencoding\/heapbatchencoder\/batchlimit","title":"batchLimit"},"doc://Events/documentation/Events/Sensitive":{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","role":"symbol","url":"\/documentation\/events\/sensitive","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"title":"Sensitive","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"url":"\/documentation\/httpdestinations\/batchencoder","title":"BatchEncoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":