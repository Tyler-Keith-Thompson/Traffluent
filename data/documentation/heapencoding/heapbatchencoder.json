ifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","type":"topic","title":"requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","text":"BatchRequests"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12HeapEncoding0aB5ErrorO","text":"HeapEncodingError"},{"kind":"text","text":">"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/Failure":{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/Failure","role":"symbol","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"type":"topic","title":"HeapBatchEncoder.Failure","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/heapencoding\/heapbatchencoder\/failure"},"doc://Events/documentation/Events/Sensitive":{"kind":"symbol","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"url":"\/documentation\/events\/sensitive","role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"type":"topic","title":"Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/batchLimit":