ncoding/HeapEncodingError":{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","role":"symbol","url":"\/documentation\/heapencoding\/heapencodingerror","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests as"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"title":"HeapEncodingError","type":"topic","navigatorTitle":[{"kind":"identifier","text":"HeapEncodingError"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapEncodingError"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/outcome(of:for:)":{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/outcome(of:for:)","role":"symbol","url":"\/documentation\/heapencoding\/heapbatchencoder\/outcome(of:for:)","abstract":[{"type":"text","text":"Every 2xx answer counts as delivered: Heap answers 200 only to a request it takes, and one it can’t with 400."}],"title":"outcome(of:for:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResp