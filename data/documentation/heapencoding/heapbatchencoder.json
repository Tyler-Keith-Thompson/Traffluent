ports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapEncodingError"}],"type":"topic","title":"HeapEncodingError","navigatorTitle":[{"kind":"identifier","text":"HeapEncodingError"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","role":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"title":"BatchEncoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" sends.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},"doc://HeapEncoding/documentation/HeapEncoding":{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","role":"collection","url":"\/documentation\/heapencoding","abstract":[{"text":"Send records to Heap as custom events, through its server-side bulk track API.","type":"text"}],"kind":"symbol","type":"topic","title":"HeapEncoding"},"doc://HeapEncoding/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/HeapEncoding\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://Events/documentation/Events/Sensitive":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"type":"topic","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at al