{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"HeapEncoding"}],"role":"symbol","symbolKind":"struct","externalID":"s:12HeapEncoding0A12BatchEncoderV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"HeapBatchEncoder","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HeapEncoding\/HeapBatchEncoder.swift#L67","fileName":"HeapBatchEncoder.swift"},"roleHeading":"Structure","title":"HeapBatchEncoder"},"kind":"symbol","topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)"],"anchor":"Initializers"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"],"anchor":"Instance-Methods"},{"title":"Type Aliases","generated":true,"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/Failure"],"anchor":"Type-Aliases"},{"title":"Type Properties","generated":true,"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit"],"anchor":"Type-Properties"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapBatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with "},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}]},{"syntax":"swift","type":"codeListing","code":["let heap = try HTTPDestination.heap(","    appID: appID,  \/\/ the environment's ID, from Heap's project settings","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with two members: ","type":"text"},{"code":"app_id","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"app ID the encoder is made with, without leading or trailing whitespace, and ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", an array","type":"text"},{"text":" ","type":"text"},{"text":"of one track event per record, oldest first. Each event is an object of these members:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"event"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"identity","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"idempotency_key","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"properties"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s stored properties, flattened; left out when there are none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"timestamp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601, in UTC with milliseconds"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", which is Heap’s own ID of a"},{"type":"text","text":" "},{"type":"text","text":"user, and no "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":". Heap makes a user for each identity it hasn’t seen, so its users are"},{"type":"text","text":" "},{"type":"text","text":"sessions. A record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"text","text":"one a store recovered after a relaunch, which keeps no context) is its own user of one event,"},{"type":"text","text":" "},{"type":"text","text":"linked to nothing: Heap takes no event without an identity. The record’s vendor identifier,"},{"type":"text","text":" "},{"type":"text","text":"trace context and standard context, and any other context value, aren’t sent: Heap keeps no"},{"type":"text","text":" "},{"type":"text","text":"built-in property of a server-side event, so they would sit among the event’s own properties,"},{"type":"text","text":" "},{"type":"text","text":"under names of the encoder’s choosing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. Heap takes a number or a string as a property’s value,"},{"type":"text","text":" "},{"type":"text","text":"so an object or array is spread into a property per value it holds, named after its path,"},{"type":"text","text":" "},{"type":"text","text":"joined by "},{"code":".","type":"codeVoice"},{"type":"text","text":" ("},{"code":"cart.size","type":"codeVoice"},{"type":"text","text":", "},{"code":"tags.0","type":"codeVoice"},{"type":"text","text":"), a boolean is sent as the string "},{"code":"true","type":"codeVoice"},{"type":"text","text":" or "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"code":"null","type":"codeVoice"},{"type":"text","text":" is left out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event name is over 1,024"},{"type":"text","text":" "},{"type":"text","text":"characters, one with a property Heap reserves or a property name or string value of"},{"type":"text","text":" "},{"type":"text","text":"1,024 characters or more, one whose values flatten to one name, one whose event isn’t"},{"type":"text","text":" "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is outside the years 1 to"},{"type":"text","text":" "},{"type":"text","text":"9999, and one too large for a request ("},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","isActive":true},{"type":"text","text":"). "},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them"},{"type":"text","text":" "},{"type":"text","text":"as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","isActive":true},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","isActive":true},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Heap answers a request it takes with 200 and one it can’t with 400, which","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" drops and reports with every record of the request. Heap stores an event","type":"text"},{"text":" ","type":"text"},{"text":"once per ","type":"text"},{"type":"codeVoice","code":"idempotency_key"},{"text":" within one identity, so a record sent again under the same session","type":"text"},{"text":" ","type":"text"},{"text":"is stored once. A record a store recovers after a relaunch keeps no context, so it is sent","type":"text"},{"text":" ","type":"text"},{"text":"under its own identifier, not its session’s, and Heap may store it twice. The bytes are the same for","type":"text"},{"text":" ","type":"text"},{"text":"the same records on every run and platform: no whitespace, object members in the order of their","type":"text"},{"text":" ","type":"text"},{"text":"names’ UTF-8 bytes.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/HeapEncoding\/documentation\/HeapEncoding"]]},"abstract":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of Heap’s server-side bulk track API, so an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can send events to a Heap environment’s ","type":"text"},{"type":"codeVoice","code":"POST \/api\/track"},{"text":".","type":"text"}],"sections":[],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HeapEncoding\/s8SendableP","doc:\/\/HeapEncoding\/s16SendableMetatypeP"],"kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/heapencoding\/heapbatchencoder"]}],"references":{"doc://HeapEncoding/documentation/HeapEncoding":{"type":"topic","role":"collection","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","kind":"symbol","url":"\/documentation\/heapencoding","title":"HeapEncoding","abstract":[{"type":"text","text":"Send records to Heap as custom events, through its server-side bulk track API."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"kind":"symbol","type":"topic","role":"symbol","title":"BatchEncoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"type":"text","text":" sends."}],"url":"\/documentation\/httpdestinations\/batchencoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/requests(for:)":{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"HeapEncodingError","preciseIdentifier":"s:12HeapEncoding0aB5ErrorO","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","type":"topic","role":"symbol","title":"requests(for:)","abstract":[{"type":"codeVoice","code":"batch"},{"text":" as the requests Heap takes, each within the encoder’s limit, with the records left","type":"text"},{"text":" ","type":"text"},{"text":"out of them.","type":"text"}],"url":"\/documentation\/heapencoding\/heapbatchencoder\/requests(for:)"},"doc://HeapEncoding/s8SendableP":{"identifier":"doc:\/\/HeapEncoding\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://HeapEncoding/s16SendableMetatypeP":{"identifier":"doc:\/\/HeapEncoding\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/batchLimit":{"abstract":[{"type":"text","text":"Heap’s limits on one request: 1,000 events and 1,000,000 bytes of body, and 1,000,000 bytes"},{"type":"text","text":" "},{"type":"text","text":"of one event."}],"title":"batchLimit","url":"\/documentation\/heapencoding\/heapbatchencoder\/batchlimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier","text":"BatchLimit"}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","kind":"symbol","type":"topic","role":"symbol"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/Failure":{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/Failure","url":"\/documentation\/heapencoding\/heapbatchencoder\/failure","navigatorTitle":[{"kind":"identifier","text":"Failure"}],"title":"HeapBatchEncoder.Failure","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"type":"topic","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"role":"symbol","title":"HTTPDestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"url":"\/documentation\/httpdestinations\/httpdestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","kind":"symbol","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"type":"topic"},"doc://HeapEncoding/documentation/HeapEncoding/HeapEncodingError":{"identifier":