s":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"}],"role":"symbol"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/Failure":{"url":"\/documentation\/heapencoding\/heapbatchencoder\/failure","role":"symbol","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/Failure","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"type":"topic","title":"HeapBatchEncoder.Failure","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"kind":"symbol"},"doc://HeapEncoding/documentation/HeapEncoding":{"url":"\/documentation\/heapencoding","kind":"symbol","abstract":[{"text":"Send records to Heap as custom events, through its server-side bulk track API.","type":"text"}],"role":"collection","type":"topic","title":"HeapEncoding","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/requests(for:)":{"url":"\/documentation\/heapencoding\/heapbatchencoder\/requests(for:)","role":"symbol","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","abstract":[{"code":"batch","type":"codeVoice"},{"text":" as the requests Heap takes, each within the encoder’s limit, with the records left","type":"text"},{"text":" ","type":"text"},{"text":"out of them.","type":"text"}],"type":"topic","title":"requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","kind":"typeIdentifier","text":"BatchRequests"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:12HeapEncoding0aB5ErrorO","kind":"typeIdentifier","text":"HeapEncodingError"},{"kind":"text","text":">"}],"kind":"symbol"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/transientStatuses":{"title":"transientStatuses","url":"\/documentation\/heapencoding\/heapbatchencoder\/transientstatuses","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/transientStatuses","type":"topic","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientStatuses","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"TransientStatus","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"No status beyond the 408, 429 and 5xx that "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries for every encoder."}]},"doc://HeapEncoding/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/HeapEncoding\/s8SendableP","type":"unresolvable"},"doc://HeapEncoding/documentation/HeapEncoding/HeapEncodingError":{"url":"\/documentation\/heapencoding\/heapencodingerror","role":"symbol","navigatorTitle":[{"text":"HeapEncodingError","kind":"identifier"}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests as"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"type":"topic","title":"HeapEncodingError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapEncodingError","kind":"identifier"}],"kind":"symbol"}}}