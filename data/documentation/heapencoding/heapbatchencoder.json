TTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"url":"\/documentation\/httpdestinations\/httpdestination","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"topic","role":"symbol"},"doc://HeapEncoding/documentation/HeapEncoding/HeapEncodingError":{"type":"topic","navigatorTitle":[{"text":"HeapEncodingError","kind":"identifier"}],"url":"\/documentation\/heapencoding\/heapencodingerror","title":"HeapEncodingError","abstract":[{"text":"Why ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s requests as","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no record of a","type":"text"},{"text":" ","type":"text"},{"text":"batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapEncodingError","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://HeapEncoding/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/HeapEncoding\/s8SendableP"},"doc://HeapEncoding/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/HeapEncoding\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/Failure":{"kind":"symbol","url":"\/documentation\/heapencoding\/heapbatchencoder\/failure","type":"topic","title":"HeapBatchEncoder.Failur