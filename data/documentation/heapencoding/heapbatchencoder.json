{"kind":"symbol","metadata":{"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapBatchEncoder"}],"remoteSource":{"fileName":"HeapBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HeapEncoding\/HeapBatchEncoder.swift#L66"},"externalID":"s:12HeapEncoding0A12BatchEncoderV","modules":[{"name":"HeapEncoding"}],"navigatorTitle":[{"text":"HeapBatchEncoder","kind":"identifier"}],"title":"HeapBatchEncoder","role":"symbol","symbolKind":"struct"},"identifier":{"url":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/HeapEncoding\/documentation\/HeapEncoding"]]},"abstract":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"text":" of Heap’s server-side bulk track API, so an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can send events to a Heap environment’s ","type":"text"},{"type":"codeVoice","code":"POST \/api\/track"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Type Aliases","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/Failure"],"anchor":"Type-Aliases"},{"generated":true,"title":"Type Properties","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/transientStatuses"],"anchor":"Type-Properties"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapBatchEncoder","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Make the destination with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}],"type":"paragraph"},{"code":["let heap = try HTTPDestination.heap(","    appID: appID,  \/\/ the environment's ID, from Heap's project settings","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":" with two members: "},{"type":"codeVoice","code":"app_id"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"app ID the encoder is made with, without leading or trailing whitespace, and "},{"type":"codeVoice","code":"events"},{"type":"text","text":", an array"},{"type":"text","text":" "},{"type":"text","text":"of one track event per record, oldest first. Each event is an object of these members:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"identity"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"idempotency_key","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, flattened; left out when there are none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", which is Heap’s own ID of a"},{"type":"text","text":" "},{"type":"text","text":"user, and no "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":". Heap makes a user for each identity it hasn’t seen, so its users are"},{"type":"text","text":" "},{"type":"text","text":"sessions. A record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"its own user of one event, linked to nothing: Heap takes no event without an identity. The record’s vendor identifier,"},{"type":"text","text":" "},{"type":"text","text":"trace context and standard context, and any other context value, aren’t sent: Heap keeps no"},{"type":"text","text":" "},{"type":"text","text":"built-in property of a server-side event, so they would sit among the event’s own properties,"},{"type":"text","text":" "},{"type":"text","text":"under names of the encoder’s choosing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. Heap takes a number or a string as a property’s value,"},{"type":"text","text":" "},{"type":"text","text":"so an object or array is spread into a property per value it holds, named after its path,"},{"type":"text","text":" "},{"type":"text","text":"joined by "},{"code":".","type":"codeVoice"},{"type":"text","text":" ("},{"code":"cart.size","type":"codeVoice"},{"type":"text","text":", "},{"code":"tags.0","type":"codeVoice"},{"type":"text","text":"), a boolean is sent as the string "},{"code":"true","type":"codeVoice"},{"type":"text","text":" or "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"code":"null","type":"codeVoice"},{"type":"text","text":" is left out."}],"type":"paragraph"},{"inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name is over 1,024","type":"text"},{"text":" ","type":"text"},{"text":"characters, one with a property Heap reserves or a property name or string value of","type":"text"},{"text":" ","type":"text"},{"text":"1,024 characters or more, one whose values flatten to one name, one whose event isn’t","type":"text"},{"text":" ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp is outside the years 1 to","type":"text"},{"text":" ","type":"text"},{"text":"9999, and one too large for a request (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError"},{"text":"). ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"},{"text":" returns them","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. Heap answers a request it takes with 200 and one it can’t with 400, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops and reports with every record of the request. Heap stores an event"},{"type":"text","text":" "},{"type":"text","text":"once per "},{"type":"codeVoice","code":"idempotency_key"},{"type":"text","text":" within one identity, so a record sent again under the same session"},{"type":"text","text":" "},{"type":"text","text":"is stored once. A record a store recovers after a relaunch keeps its session, so it is sent"},{"type":"text","text":" "},{"type":"text","text":"under the identity of its first send, and Heap stores it once. The bytes are the same for the"},{"type":"text","text":" "},{"type":"text","text":"same records on every run and platform: no whitespace, object members in the order of their"},{"type":"text","text":" "},{"type":"text","text":"names’ UTF-8 bytes."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/heapencoding\/heapbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HeapEncoding\/s8SendableP","doc:\/\/HeapEncoding\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"references":{"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/requests(for:)":{"title":"requests(for:)","url":"\/documentation\/heapencoding\/heapbatchencoder\/requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","text":"BatchRequests"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12HeapEncoding0aB5ErrorO","text":"HeapEncodingError"},{"kind":"text","text":">"}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","abstract":[{"type":"codeVoice","code":"batch"},{"type":"text","text":" as the requests Heap takes, each within the encoder’s limit, with the records left"},{"type":"text","text":" "},{"type":"text","text":"out of them."}]},"doc://HeapEncoding/documentation/HeapEncoding/HTTPDestinations/HTTPDestination/heap(appID:region:plan:backoff:clock:)":{"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"URLSessionTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"HeapBatchEncoder","type":"codeVoice"},{"text":".","type":"text"}]},"title":"heap(appID:region:plan:backoff:clock:)","url":"\/documentation\/heapencoding\/httpdestinations\/httpdestination\/heap(appid:region:plan:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"heap","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12HeapEncoding0A6RegionO","text":"HeapRegion","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:12HeapEncoding0A10SetupErrorO","text":"HeapSetupError","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:12HeapEncoding0A12BatchEncoderV","text":"HeapBatchEncoder","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A destination that sends batches to the Heap environment "},{"type":"codeVoice","code":"appID"},{"type":"text","text":", whose data resides in"},{"type":"text","text":" "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)","type":"topic"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/transientStatuses":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{