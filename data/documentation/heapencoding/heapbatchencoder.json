{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"}],"title":"batchLimit","role":"symbol"},"doc://HeapEncoding/documentation/HeapEncoding/HeapEncodingError":{"url":"\/documentation\/heapencoding\/heapencodingerror","type":"topic","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","kind":"symbol","abstract":[{"type":"text","text":"Why "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests as"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapEncodingError","kind":"identifier"}],"title":"HeapEncodingError","role":"symbol","navigatorTitle":[{"text":"HeapEncodingError","kind":"identifier"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/outcome(of:for:)":{"title":"outcome(of:for:)","url":"\/documentation\/heapencoding\/heapbatchencoder\/outcome(of:for:)","type":"topic","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/outcome(of:for:)","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind"