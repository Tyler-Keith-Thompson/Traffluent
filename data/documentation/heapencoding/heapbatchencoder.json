atchEncoder"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/init(appID:plan:limit:)":{"type":"topic","url":"\/documentation\/heapencoding\/heapbatchencoder\/init(appid:plan:limit:)","title":"init(appID:plan:limit:)","abstract":[{"type":"text","text":"An encoder of the events "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, for the Heap environment "},{"type":"codeVoice","code":"appID"},{"type":"text","text":", splitting each"},{"type":"text","text":" "},{"type":"text","text":"batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":"."}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"appID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"limit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:12HeapEncoding0A10SetupErrorO","text":"HeapSetupError"},{"kind":"text","text":")"}],"role":"symbol","kind":"symbol"},"doc://Events/documentation/Events/Sensitive":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"title":"Sensitive","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the 