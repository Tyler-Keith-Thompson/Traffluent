{"kind":"symbol","topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"]},{"anchor":"Type-Aliases","title":"Type Aliases","generated":true,"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/Failure"]},{"anchor":"Type-Properties","title":"Type Properties","generated":true,"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/transientStatuses"]},{"anchor":"Type-Methods","title":"Type Methods","generated":true,"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/outcome(of:for:)"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/heapencoding\/heapbatchencoder"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HeapEncoding\/s8SendableP","doc:\/\/HeapEncoding\/s16SendableMetatypeP"],"type":"conformsTo"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapBatchEncoder","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}]},{"type":"codeListing","code":["let heap = try HTTPDestination.heap(","    appID: appID,  \/\/ the environment's ID, from Heap's project settings","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with two members: ","type":"text"},{"code":"app_id","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"app ID the encoder is made with, without leading or trailing whitespace, and ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", an array","type":"text"},{"text":" ","type":"text"},{"text":"of one track event per record, oldest first. Each event is an object of these members:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"identity","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"idempotency_key"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, flattened; left out when there are none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601, in UTC with milliseconds"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"type":"codeVoice","code":"user_id"},{"text":", which is Heap’s own ID of a","type":"text"},{"text":" ","type":"text"},{"text":"user, and no ","type":"text"},{"type":"codeVoice","code":"session_id"},{"text":". Heap makes a user for each identity it hasn’t seen, so its users are","type":"text"},{"text":" ","type":"text"},{"text":"sessions. A record with no session (one tracked by a tracker without ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":") is","type":"text"},{"text":" ","type":"text"},{"text":"its own user of one event, linked to nothing: Heap takes no event without an identity. The record’s vendor identifier,","type":"text"},{"text":" ","type":"text"},{"text":"trace context and standard context, and any other context value, aren’t sent: Heap keeps no","type":"text"},{"text":" ","type":"text"},{"text":"built-in property of a server-side event, so they would sit among the event’s own properties,","type":"text"},{"text":" ","type":"text"},{"text":"under names of the encoder’s choosing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":", as ","type":"text"},{"type":"codeVoice","code":"PropertyReader"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, and so is an element of an array. Heap takes a number or a string as a property’s value,","type":"text"},{"text":" ","type":"text"},{"text":"so an object or array is spread into a property per value it holds, named after its path,","type":"text"},{"text":" ","type":"text"},{"text":"joined by ","type":"text"},{"type":"codeVoice","code":"."},{"text":" (","type":"text"},{"type":"codeVoice","code":"cart.size"},{"text":", ","type":"text"},{"type":"codeVoice","code":"tags.0"},{"text":"), a boolean is sent as the string ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"null"},{"text":" is left out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name is over 1,024"},{"type":"text","text":" "},{"type":"text","text":"characters, one with a property Heap reserves or a property name or string value of"},{"type":"text","text":" "},{"type":"text","text":"1,024 characters or more, one whose values flatten to one name, one whose event isn’t"},{"type":"text","text":" "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is outside the years 1 to"},{"type":"text","text":" "},{"type":"text","text":"9999, and one too large for a request ("},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","isActive":true},{"type":"text","text":"). "},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. Heap answers a request it takes with 200 and one it can’t with 400, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops and reports with every record of the request. Heap stores an event"},{"type":"text","text":" "},{"type":"text","text":"once per "},{"type":"codeVoice","code":"idempotency_key"},{"type":"text","text":" within one identity, so a record sent again under the same session"},{"type":"text","text":" "},{"type":"text","text":"is stored once. A record a store recovers after a relaunch keeps its session, so it is sent"},{"type":"text","text":" "},{"type":"text","text":"under the identity of its first send, and Heap stores it once. The bytes are the same for the"},{"type":"text","text":" "},{"type":"text","text":"same records on every run and platform: no whitespace, object members in the order of their"},{"type":"text","text":" "},{"type":"text","text":"names’ UTF-8 bytes."}]}]}],"identifier":{"url":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/HeapEncoding\/documentation\/HeapEncoding"]]},"sections":[],"metadata":{"symbolKind":"struct","externalID":"s:12HeapEncoding0A12BatchEncoderV","remoteSource":{"fileName":"HeapBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HeapEncoding\/HeapBatchEncoder.swift#L66"},"role":"symbol","title":"HeapBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapBatchEncoder","kind":"identifier"}],"modules":[{"name":"HeapEncoding"}],"roleHeading":"Structure","navigatorTitle":[{"text":"HeapBatchEncoder","kind":"identifier"}]},"abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" of Heap’s server-side bulk track API, so an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can send events to a Heap environment’s ","type":"text"},{"code":"POST \/api\/track","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"text":" sends.","type":"text"}],"kind":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"t