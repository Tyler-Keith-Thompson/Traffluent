ts/Sensitive":{"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","url":"\/documentation\/events\/sensitive","kind":"symbol","type":"topic","title":"Sensitive","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"title":"BatchEncoder","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","kind":"symbol","type":"topic","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":" sends.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}]},"doc://HeapEncoding/documentation/HeapEncoding":{"abstract":[{"text":"Send records to Heap as custom events, through its server-side bulk track API.","type":"text"}],"kind":"symbol","title":"HeapEncoding","url":"\/documentation\/heapencoding","role":"collection","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","type":"topic"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/transientStatuses":{"url":"\/documentation\/heapencoding\/heapbatchencoder\/transientstatuses","kind":"symbol","abstract":[{"text":"No status beyond the 408, 429 and 5xx that ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries for every encoder.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientStatuses","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"TransientStatus","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV"},{"text":">","kind":"text"}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/transientStatuses","title":"transientStatuses"},"doc://HeapEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/HeapEncoding\/s16SendableMetatypeP"},"doc://HeapEncoding/s8SendableP":{"identifier":"doc:\/\/HeapEncoding\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://HeapEncoding/documentation/HeapEncoding/HeapEncodingError":{"navigatorTitle":[{"text":"HeapEncodingError","kind":"identifier"}],"abstract":[{"text":"Why ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s requests as","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no record of a","type":"text"},{"text":" ","type":"text"},{"text":"batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"title":"HeapEncodingError","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapEncodingError","kind":"identifier"}],"url":"\/documentation\/heapencoding\/heapencodingerror","role":"symbol","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","type":"topic"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/Failure":{"title":"HeapBatchEncoder.Failure","navigatorTitle":[{"kind":"identifier","text":"Failure"}],"role":"symbol","url":"\/documentation\/heapencoding\/heapbatchencoder\/failure","kind":"symbol","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"type":"topic","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/Failure","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"title":"HTTPDestination","navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"role":"symbol","url":"\/documentation\/httpdestinations\/httpdestination","kind":"symbol","abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/requests(for:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","kind":"typeIdentifier","text":"BatchRequests"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:12HeapEncoding0aB5ErrorO","kind":"typeIdentifier","text":"HeapEncodingError"},{"kind":"text","text":">"}],"role":"symbol","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","kind":"symbol","url":"\/documentation\/heapencoding\/heapbatchencoder\/requests(for:)","type":"topic","title":"requests(for:)","abstract":[{"code":"batch","type":"codeVoice"},{"text":" as the requests Heap takes, each within the encoder’s limit, with the records left","type":"text"},{"text":" ","type":"text"},{"text":"out of them.","type":"text"}]}}}