{"abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Heap’s server-side bulk track API, so an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send events to a Heap environment’s "},{"type":"codeVoice","code":"POST \/api\/track"},{"type":"text","text":"."}],"kind":"symbol","sections":[],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"],"generated":true},{"title":"Type Aliases","anchor":"Type-Aliases","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/Failure"],"generated":true},{"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/transientStatuses"],"generated":true},{"title":"Type Methods","anchor":"Type-Methods","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/outcome(of:for:)"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapBatchEncoder","kind":"identifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with "},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}]},{"type":"codeListing","code":["let heap = try HTTPDestination.heap(","    appID: appID,  \/\/ the environment's ID, from Heap's project settings","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":" with two members: "},{"type":"codeVoice","code":"app_id"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"app ID the encoder is made with, without leading or trailing whitespace, and "},{"type":"codeVoice","code":"events"},{"type":"text","text":", an array"},{"type":"text","text":" "},{"type":"text","text":"of one track event per record, oldest first. Each event is an object of these members:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"identity","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"idempotency_key","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, flattened; left out when there are none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601, in UTC with milliseconds"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", which is Heap’s own ID of a"},{"type":"text","text":" "},{"type":"text","text":"user, and no "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":". Heap makes a user for each identity it hasn’t seen, so its users are"},{"type":"text","text":" "},{"type":"text","text":"sessions. A record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"its own user of one event, linked to nothing: Heap takes no event without an identity. The record’s vendor identifier,"},{"type":"text","text":" "},{"type":"text","text":"trace context and standard context, and any other context value, aren’t sent: Heap keeps no"},{"type":"text","text":" "},{"type":"text","text":"built-in property of a server-side event, so they would sit among the event’s own properties,"},{"type":"text","text":" "},{"type":"text","text":"under names of the encoder’s choosing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. Heap takes a number or a string as a property’s value,"},{"type":"text","text":" "},{"type":"text","text":"so an object or array is spread into a property per value it holds, named after its path,"},{"type":"text","text":" "},{"type":"text","text":"joined by "},{"type":"codeVoice","code":"."},{"type":"text","text":" ("},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":"), a boolean is sent as the string "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is left out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event name is over 1,024"},{"type":"text","text":" "},{"type":"text","text":"characters, one with a property Heap reserves or a property name or string value of"},{"type":"text","text":" "},{"type":"text","text":"1,024 characters or more, one whose values flatten to one name, one whose event isn’t"},{"type":"text","text":" "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is outside the years 1 to"},{"type":"text","text":" "},{"type":"text","text":"9999, and one too large for a request ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError"},{"type":"text","text":"). "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"},{"type":"text","text":" returns them"},{"type":"text","text":" "},{"type":"text","text":"as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Heap answers a request it takes with 200 and one it can’t with 400, which","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops and reports with every record of the request. Heap stores an event","type":"text"},{"text":" ","type":"text"},{"text":"once per ","type":"text"},{"code":"idempotency_key","type":"codeVoice"},{"text":" within one identity, so a record sent again under the same session","type":"text"},{"text":" ","type":"text"},{"text":"is stored once. A record a store recovers after a relaunch keeps its session, so it is sent","type":"text"},{"text":" ","type":"text"},{"text":"under the identity of its first send, and Heap stores it once. The bytes are the same for the","type":"text"},{"text":" ","type":"text"},{"text":"same records on every run and platform: no whitespace, object members in the order of their","type":"text"},{"text":" ","type":"text"},{"text":"names’ UTF-8 bytes.","type":"text"}]}]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HeapEncoding\/s8SendableP","doc:\/\/HeapEncoding\/s16SendableMetatypeP"]}],"variants":[{"paths":["\/documentation\/heapencoding\/heapbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/HeapEncoding\/documentation\/HeapEncoding"]]},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapBatchEncoder"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HeapEncoding\/HeapBatchEncoder.swift#L66","fileName":"HeapBatchEncoder.swift"},"symbolKind":"struct","externalID":"s:12HeapEncoding0A12BatchEncoderV","roleHeading":"Structure","navigatorTitle":[{"text":"HeapBatchEncoder","kind":"identifier"}],"modules":[{"name":"HeapEncoding"}],"role":"symbol","title":"HeapBatchEncoder"},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://HeapEncoding/documentation/HeapEncoding":{"abstract":[{"text":"Send records to Heap as custom events, through its server-side bulk track API.","type":"text"}],"type":"topic","url":"\/documentation\/heapencoding","kind":"symbol","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","title":"HeapEncoding","role":"collection"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder":{"title":"HeapBatchEncoder","url":"\/documentation\/heapencoding\/heapbatchencoder","type":"topic","identifier":"doc:\/\/HeapEncoding\/documentation