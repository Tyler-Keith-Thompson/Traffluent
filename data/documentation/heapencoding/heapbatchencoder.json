{"kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Heap’s server-side bulk track API, so an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send events to a Heap environment’s "},{"type":"codeVoice","code":"POST \/api\/track"},{"type":"text","text":"."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/Failure"],"anchor":"Type-Aliases","generated":true,"title":"Type Aliases"},{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/transientStatuses"],"anchor":"Type-Properties","generated":true,"title":"Type Properties"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/heapencoding\/heapbatchencoder"]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HeapEncoding\/s8SendableP","doc:\/\/HeapEncoding\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapBatchEncoder","kind":"identifier"}]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Make the destination with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let heap = try HTTPDestination.heap(","    appID: appID,  \/\/ the environment's ID, from Heap's project settings","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)"]},{"inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"type":"codeVoice","code":"application\/json"},{"text":" with two members: ","type":"text"},{"type":"codeVoice","code":"app_id"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"app ID the encoder is made with, without leading or trailing whitespace, and ","type":"text"},{"type":"codeVoice","code":"events"},{"text":", an array","type":"text"},{"text":" ","type":"text"},{"text":"of one track event per record, oldest first. Each event is an object of these members:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"identity"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":" the same way when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"idempotency_key","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, flattened; left out when there are none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":", which is Heap’s own ID of a","type":"text"},{"text":" ","type":"text"},{"text":"user, and no ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":". Heap makes a user for each identity it hasn’t seen, so its users are","type":"text"},{"text":" ","type":"text"},{"text":"sessions. A record with no session (one tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"text":"one a store recovered after a relaunch, which keeps no context) is its own user of one event,","type":"text"},{"text":" ","type":"text"},{"text":"linked to nothing: Heap takes no event without an identity. The record’s vendor identifier,","type":"text"},{"text":" ","type":"text"},{"text":"trace context and standard context, and any other context value, aren’t sent: Heap keeps no","type":"text"},{"text":" ","type":"text"},{"text":"built-in property of a server-side event, so they would sit among the event’s own properties,","type":"text"},{"text":" ","type":"text"},{"text":"under names of the encoder’s choosing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, and so is an element of an array. Heap takes a number or a string as a property’s value,","type":"text"},{"text":" ","type":"text"},{"text":"so an object or array is spread into a property per value it holds, named after its path,","type":"text"},{"text":" ","type":"text"},{"text":"joined by ","type":"text"},{"code":".","type":"codeVoice"},{"text":" (","type":"text"},{"code":"cart.size","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tags.0","type":"codeVoice"},{"text":"), a boolean is sent as the string ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" is left out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event name is over 1,024","type":"text"},{"text":" ","type":"text"},{"text":"characters, one with a property Heap reserves or a property name or string value of","type":"text"},{"text":" ","type":"text"},{"text":"1,024 characters or more, one whose values flatten to one name, one whose event isn’t","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds a value JSON can’t, one whose timestamp is outside the years 1 to","type":"text"},{"text":" ","type":"text"},{"text":"9999, and one too large for a request (","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError"},{"text":"). ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"},{"text":" returns them","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Heap answers a request it takes with 200 and one it can’t with 400, which","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops and reports with every record of the request. Heap stores an event","type":"text"},{"text":" ","type":"text"},{"text":"once per ","type":"text"},{"code":"idempotency_key","type":"codeVoice"},{"text":" within one identity, so a record sent again under the same session","type":"text"},{"text":" ","type":"text"},{"text":"is stored once. A record a store recovers after a relaunch keeps no context, so it is sent","type":"text"},{"text":" ","type":"text"},{"text":"under its own identifier, not its session’s, and Heap may store it twice. The bytes are the same for","type":"text"},{"text":" ","type":"text"},{"text":"the same records on every run and platform: no whitespace, object members in the order of their","type":"text"},{"text":" ","type":"text"},{"text":"names’ UTF-8 bytes.","type":"text"}],"type":"paragraph"}]}],"sections":[],"metadata":{"symbolKind":"struct","modules":[{"name":"HeapEncoding"}],"externalID":"s:12HeapEncoding0A12BatchEncoderV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapBatchEncoder"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HeapEncoding\/HeapBatchEncoder.swift#L67","fileName":"HeapBatchEncoder.swift"},"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"HeapBatchEncoder"}],"role":"symbol","title":"HeapBatchEncoder"},"hierarchy":{"paths":[["doc:\/\/HeapEncoding\/documentation\/HeapEncoding"]]},"identifier":{"url":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","interfaceLanguage":"swift"},"references":{"doc://Events/documentation/Events/Sensitive":{"role":"symbol","title":"Sensitive","url":"\/documentation\/events\/sensitive","type":"topic","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"title":"HTTPDestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"kind":"symbol","url":"\/documentation\/httpdestinations\/httpdestination","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder":{"kind":"symbol","abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" of Heap’s server-side bulk track API, so an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can send events to a Heap environment’s ","type":"text"},{"code":"POST \/api\/track","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","navigatorTitle":[{"text":"HeapBatchEncoder","kind":"identifier"}],"url":"\/documentation\/heapencoding\/heapbatchencoder","title":"HeapBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapBatchEncoder","kind":"identifier"}],"role":"symbol"},"doc://HeapEncoding/documentation/HeapEncoding/HTTPDestinations/HTTPDestination/heap(appID:region:plan:backoff:clock:)":{"kind":"symbol","url":"\/documentation\/heapencoding\/httpdestinations\/httpdestination\/heap(appid:region:plan:backoff:clock:)","abstract":[{"text":"A destination that sends batches to the Heap environment ","typ