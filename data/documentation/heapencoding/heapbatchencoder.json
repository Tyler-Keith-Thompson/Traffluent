estinations\/BatchEncoder","type":"reference","isActive":true},{"text":" of Heap’s server-side bulk track API, so an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can send events to a Heap environment’s ","type":"text"},{"type":"codeVoice","code":"POST \/api\/track"},{"text":".","type":"text"}],"role":"symbol"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/batchLimit":{"title":"batchLimit","type":"topic","url":"\/documentation\/heapencoding\/heapbatchencoder\/batchlimit","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Heap’s limits on one request: 1,000 events and 1,000,000 bytes of body, and 1,000,000 bytes"},{"type":"text","text":" "},{"type":"text","text":"of one event."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/init(appID:plan:limit:)":{"abstract":[{"type":"text","text":"An encoder of the events "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, for the Heap environment "},{"type":"codeVoice","code":"appID"},{"type":"text","text":", splitting each"},{"type":"text","text":" "},{"type":"text","text":"batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":"."}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A