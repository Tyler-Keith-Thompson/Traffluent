isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests as"},{"type":"text","text":" "},{"type":"text","text":"a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HeapEncodingError"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/requests(for:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"HeapEncodingError","preciseIdentifier":"s:12HeapEncoding0aB5ErrorO","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","abstract":[{"type":"codeVoice","code":"batch"},{"type":"text","text":" as the requests Heap takes, each within the encoder’s limit, with the records left"},{"type":"text","text":" "},{"type":"text","text":"out of them."}],"url":"\/documentation\/heapencoding\/heapbatchencoder\/requests(for:)","title":"requests(for:)","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"abstract":[{"type":"text","text":"What turns a batch of records into the request