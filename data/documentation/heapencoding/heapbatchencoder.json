{"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"]},{"title":"Type Aliases","generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/Failure"]},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/transientStatuses"]},{"title":"Type Methods","generated":true,"anchor":"Type-Methods","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/outcome(of:for:)"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HeapEncoding\/s8SendableP","doc:\/\/HeapEncoding\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapBatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Make the destination with ","type":"text"},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and its limits:","type":"text"}]},{"syntax":"swift","code":["let heap = try HTTPDestination.heap(","    appID: appID,  \/\/ the environment's ID, from Heap's project settings","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with two members: ","type":"text"},{"code":"app_id","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"app ID the encoder is made with, without leading or trailing whitespace, and ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", an array","type":"text"},{"text":" ","type":"text"},{"text":"of one track event per record, oldest first. Each event is an object of these members:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"event"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"identity","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"idempotency_key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"properties","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s stored properties, flattened; left out when there are none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"timestamp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601, in UTC with milliseconds"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", which is Heap’s own ID of a"},{"type":"text","text":" "},{"type":"text","text":"user, and no "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":". Heap makes a user for each identity it hasn’t seen, so its users are"},{"type":"text","text":" "},{"type":"text","text":"sessions. A record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"its own user of one event, linked to nothing: Heap takes no event without an identity. The record’s vendor identifier,"},{"type":"text","text":" "},{"type":"text","text":"trace context and standard context, and any other context value, aren’t sent: Heap keeps no"},{"type":"text","text":" "},{"type":"text","text":"built-in property of a server-side event, so they would sit among the event’s own properties,"},{"type":"text","text":" "},{"type":"text","text":"under names of the encoder’s choosing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. Heap takes a number or a string as a property’s value,"},{"type":"text","text":" "},{"type":"text","text":"so an object or array is spread into a property per value it holds, named after its path,"},{"type":"text","text":" "},{"type":"text","text":"joined by "},{"code":".","type":"codeVoice"},{"type":"text","text":" ("},{"code":"cart.size","type":"codeVoice"},{"type":"text","text":", "},{"code":"tags.0","type":"codeVoice"},{"type":"text","text":"), a boolean is sent as the string "},{"code":"true","type":"codeVoice"},{"type":"text","text":" or "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"code":"null","type":"codeVoice"},{"type":"text","text":" is left out."}]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name is over 1,024","type":"text"},{"text":" ","type":"text"},{"text":"characters, one with a property Heap reserves or a property name or string value of","type":"text"},{"text":" ","type":"text"},{"text":"1,024 characters or more, one whose values flatten to one name, one whose event isn’t","type":"text"},{"text":" ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp is outside the years 1 to","type":"text"},{"text":" ","type":"text"},{"text":"9999, and one too large for a request (","type":"text"},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","isActive":true,"type":"reference"},{"text":"). ","type":"text"},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" returns them","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. Heap answers a request it takes with 200 and one it can’t with 400, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops and reports with every record of the request. Heap stores an event"},{"type":"text","text":" "},{"type":"text","text":"once per "},{"type":"codeVoice","code":"idempotency_key"},{"type":"text","text":" within one identity, so a record sent again under the same session"},{"type":"text","text":" "},{"type":"text","text":"is stored once. A record a store recovers after a relaunch keeps its session, so it is sent"},{"type":"text","text":" "},{"type":"text","text":"under the identity of its first send, and Heap stores it once. The bytes are the same for the"},{"type":"text","text":" "},{"type":"text","text":"same records on every run and platform: no whitespace, object members in the order of their"},{"type":"text","text":" "},{"type":"text","text":"names’ UTF-8 bytes."}]}]}],"kind":"symbol","identifier":{"url":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","interfaceLanguage":"swift"},"metadata":{"externalID":"s:12HeapEncoding0A12BatchEncoderV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HeapEncoding\/HeapBatchEncoder.swift#L66","fileName":"HeapBatchEncoder.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapBatchEncoder","kind":"identifier"}],"roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"HeapEncoding"}],"role":"symbol","navigatorTitle":[{"text":"HeapBatchEncoder","kind":"identifier"}],"title":"HeapBatchEncoder"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" of Heap’s server-side bulk track API, so an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can send events to a Heap environment’s ","type":"text"},{"code":"POST \/api\/track","type":"codeVoice"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/HeapEncoding\/documentation\/HeapEncoding"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/heapencoding\/heapbatchencoder"]}],"sections":[],"references":{"doc://HeapEncoding/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/HeapEncoding\/s8SendableP","title":"Swift.Sendable"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/requests(for:)":{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","role":"symbol","url":"\/documentation\/heapencoding\/heapbatchencoder\/requests(for:)","abstract":[{"code":"batch","type":"codeVoice"},{"text":" as the requests Heap takes, each within the encoder’s limit, with the records left","type":"text"},{