{"topicSections":[{"anchor":"Stores","title":"Stores","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"]},{"anchor":"The-binary-encoding","title":"The binary encoding","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","doc:\/\/Persistence\/documentation\/Persistence\/BinaryEncoder","doc:\/\/Persistence\/documentation\/Persistence\/KeyedBinaryEncoder","doc:\/\/Persistence\/documentation\/Persistence\/BinaryDecoder","doc:\/\/Persistence\/documentation\/Persistence\/KeyedBinaryDecoder","doc:\/\/Persistence\/documentation\/Persistence\/BinaryDecodingError"]},{"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/Events","doc:\/\/Persistence\/documentation\/Persistence\/FoundationEssentials","doc:\/\/Persistence\/documentation\/Persistence\/Swift"],"generated":true}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a store, a tracker keeps its records in memory only. A tracker given a "},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"Tracker(store:)","type":"codeVoice"},{"type":"text","text":") appends each record to it as the tracker’s worker reaches the record, before"},{"type":"text","text":" "},{"type":"text","text":"publishing it, and starts its records with the ones the store kept from earlier runs."},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","type":"reference"},{"type":"text","text":" is the store this module ships: a directory of append-only segment files, bounded at 5 MiB unless you pass another "},{"code":"byteBound","type":"codeVoice"},{"type":"text","text":". A segment is"},{"type":"text","text":" "},{"type":"text","text":"deleted once every record in it is delivered."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A store keeps only the event types you list in "},{"type":"codeVoice","code":"events"},{"type":"text","text":", which conform to "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","type":"reference","isActive":true},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"CBOR (RFC 8949), each event a map of its properties under their names, written with a"},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryEncoder","type":"reference","isActive":true},{"type":"text","text":" and read with a "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryDecoder","type":"reference","isActive":true},{"type":"text","text":". "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"EventMacros"},{"type":"text","text":") writes the"},{"type":"text","text":" "},{"type":"text","text":"conformance for you; write it by hand for an event declared without the macro. Events of other"},{"type":"text","text":" "},{"type":"text","text":"types are delivered in this run but never written."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each drop is reported on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports"},{"type":"text","text":" as a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport"},{"type":"text","text":": the oldest segments"},{"type":"text","text":" "},{"type":"text","text":"deleted to stay under the bound, a write that failed, and records recovery couldn’t read or found"},{"type":"text","text":" "},{"type":"text","text":"at another "},{"code":"schemaVersion","type":"codeVoice"},{"type":"text","text":". A record whose delivery had started when the app ended comes back with"},{"type":"text","text":" "},{"code":"isRedelivered","type":"codeVoice"},{"type":"text","text":" set. Call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()"},{"type":"text","text":", after the tracker’s "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":", as the"},{"type":"text","text":" "},{"type":"text","text":"app moves to the background, so the records written so far survive power loss too."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An app on Apple platforms that already keeps a GRDB database can keep its records in a table of it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"DatabaseStore"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"GRDBPersistence"},{"type":"text","text":")."}]},{"type":"codeListing","syntax":"swift","code":["import Persistence","import Trackers","","extension SignedUp: BinaryCodable {","    func encode(to encoder: inout BinaryEncoder) {","        encoder.encodeMap { map in","            map.encode(plan, forKey: \"plan\")","            map.encode(seats, forKey: \"seats\")","        }","    }","","    init(from decoder: inout BinaryDecoder) throws(BinaryDecodingError) {","        var map = try decoder.decodeMap()","        plan = try map.decode(forKey: \"plan\")","        seats = try map.decode(forKey: \"seats\", default: 1)","    }","}","","let store = try SegmentStore(events: [SignedUp.self], directory: directory, byteBound: 1024 * 1024)","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)","tracker.track(SignedUp(plan: \"pro\", seats: 3))"]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"covers what the store writes, its bounds and recovery, and","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"covers which changes to an event’s type its stored records can be read through.","type":"text"}]}]}],"hierarchy":{"paths":[[]]},"abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistence"]}],"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence","interfaceLanguage":"swift"},"sections":[],"metadata":{"modules":[{"name":"Persistence"}],"roleHeading":"Framework","role":"collection","title":"Persistence","symbolKind":"module","externalID":"Persistence"},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/changingevents":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents","title":"Changing Events","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents","titleInlineContent":[{"type":"text","text":"Changing Events"}]},"doc://Persistence/documentation/Persistence/BinaryEncoder":{"url":"\/documentation\/persistence\/binaryencoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryEncoder","kind":"identifier"}],"abstract":[{"type":"text","text":"Writes values in their "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","isActive":true},{"type":"text","text":" f