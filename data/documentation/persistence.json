{"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"topicSections":[{"anchor":"Stores","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"],"title":"Stores"}],"variants":[{"paths":["\/documentation\/persistence"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"collection","title":"Persistence","externalID":"Persistence","symbolKind":"module","modules":[{"name":"Persistence"}],"roleHeading":"Framework"},"abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a store, a tracker keeps its records in memory only. A tracker given a "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Tracker(store:)"},{"type":"text","text":") appends each record to it as the tracker’s worker reaches the record, before"},{"type":"text","text":" "},{"type":"text","text":"publishing it, and starts its records with the ones the store kept from earlier runs."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","isActive":true},{"type":"text","text":" is the store this module ships: a directory of append-only segment files, bounded at 5 MiB unless you pass another "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":". A segment is"},{"type":"text","text":" "},{"type":"text","text":"deleted once every record in it is delivered."}]},{"type":"paragraph","inlineContent":[{"code":"SegmentStore()","type":"codeVoice"},{"text":" keeps every event type declared with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" in the program’s modules, and the","type":"text"},{"text":" ","type":"text"},{"text":"library’s own; ","type":"text"},{"code":"SegmentStore(events:)","type":"codeVoice"},{"text":" keeps only the ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" types it lists. Each record","type":"text"},{"text":" ","type":"text"},{"text":"is a CBOR (RFC 8949) map, its event a map of its properties under their names, written through the","type":"text"},{"text":" ","type":"text"},{"text":"event’s ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance. ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"EventMacros","type":"codeVoice"},{"text":", part of ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":") writes","type":"text"},{"text":" ","type":"text"},{"text":"the conformance, and Swift’s synthesized one works too. ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" writes a ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" property, and each","type":"text"},{"text":" ","type":"text"},{"text":"date in a ","type":"text"},{"code":"[Date]","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"[Date?]","type":"codeVoice"},{"text":", as the seconds since 2001 it stores, so it reads back exactly. A","type":"text"},{"text":" ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" written through the CBOR package’s own form, in a ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type of your own or in a","type":"text"},{"text":" ","type":"text"},{"text":"synthesized conformance, reads back to within a rounding of a microsecond’s scale. Events of other","type":"text"},{"text":" ","type":"text"},{"text":"types, such as one that conforms to ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" by hand without being listed, are delivered in this","type":"text"},{"text":" ","type":"text"},{"text":"run but never written, and reported once as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record keeps its session, sample rate, screen and standard context (app, device, operating"},{"type":"text","text":" "},{"type":"text","text":"system, locale and network) beside it, so a record recovered after a relaunch reaches destinations"},{"type":"text","text":" "},{"type":"text","text":"as it was tracked. No other key of its context is kept: not the identifier for vendor, a key of"},{"type":"text","text":" "},{"type":"text","text":"the app’s own, or the trace. "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","isActive":true},{"type":"text","text":" lists each key."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A store doesn’t read the records Traffluent 0.0.44 or earlier wrote, in an earlier format:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"},{"type":"text","text":" deletes their segments and reports each as a corruption."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each drop is reported on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports"},{"type":"text","text":" as a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport"},{"type":"text","text":": the oldest segments"},{"type":"text","text":" "},{"type":"text","text":"deleted to stay under the bound, a write that failed, and records recovery couldn’t read or found"},{"type":"text","text":" "},{"type":"text","text":"at another "},{"type":"codeVoice","code":"schemaVersion"},{"type":"text","text":". A record whose delivery had started when the app ended comes back with"},{"type":"text","text":" "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set. Call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()"},{"type":"text","text":", after the tracker’s "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":", as the"},{"type":"text","text":" "},{"type":"text","text":"app moves to the background, so the records written so far survive power loss too."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An app on Apple platforms that already keeps a GRDB database can keep its records in a table of it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"DatabaseStore"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"GRDBPersistence"},{"type":"text","text":")."}]},{"code":["import Traffluent","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var seats: Int = 1","}","","let store = try SegmentStore(directory: directory, byteBound: 1024 * 1024)","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)","tracker.track(SignedUp(plan: \"pro\", seats: 3))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers what the store writes, its bounds and recovery, and","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers which changes to an event’s type its stored records can be read through.","type":"text"}]}]}],"hierarchy":{"paths":[[]]},"references":{"doc://Persistence/documentation/Persistence/DropReport":{"kind":"symbol","type":"topic","navigatorTitle":[{"text":"DropReport","kind":"identifier"}],"abstract":[{"text":"Records a store dropped before they were delivered, and why.","type":"text"}],"url":"\/documentation\/persistence\/dropreport","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DropReport","kind":"identifier"}],"title":"DropReport","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport"},"doc://Persistence/documentation/Persistence/SegmentStoreError":{"abstract":[{"type":"text","text":"The error "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","isActive":true},{"type":"text","text":" throws: an"},{"type":"text","text":" "},{"type":"text","text":"argument it can’t open a store with, or the file system’s failure."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStoreError"}],"navigatorTitle":[{"kind":"identifier","text":"SegmentStoreError"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","kind":"symbol","title":"SegmentStoreError","url":"\/documentation\/persistence\/segmentstoreerror","role":"symbol"},"doc://Persistence/documentation/Persistence":{"kind":"symbol","type":"topic","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"url":"\/documentation\/persistence","role":"collection","title":"Persistence","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/changingevents":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents","title":"Changing Events","type":"link","titleInlineContent":[{"text":"Changing Events","type":"text"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents"},"doc://Persistence/documentation/Persistence/DropReport/notPersisted(event:)":{"abstract":[{"type":"text","text":"A record of the event named "},{"code":"event","type":"codeVoice"},{"type":"text","text":" was kept in memory only because its type isn’t one of"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"code":"events","type":"codeVoice"},{"type":"text","text":": its records are delivered in this run, but never written, so they are"},{"type":"text","text":" "},{"type":"text","text":"lost if the app ends first. Reported once per type, on its first record, for as long as the"},{"type":"text","text":" "},{"type":"text","text":"store lives; a type left out by mistake is added to "},{"code":"events","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notPersisted"},{"kind":"text","text":"("},{"kind":"externalParam","text":"event"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":")"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","kind":"symbol","title":"DropReport.notPersisted(event:)","url":"\/documentation\/persistence\/dropreport\/notpersisted(event:)","role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/init(events:directory:byteBound:segmentByteCount:)":{"kind":"symbol","type":"topic","abstract":[{"text":"A store keeping events of the types ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"directory","type":"codeVoice"},{"text":"; it recovers the records","type":"text"},{"text":" ","type":"text"},{"text":"already there.","type":"text"}],"url":"\/documentation\/persistence\/segmentstore\/init(events:directory:bytebound:segmentbytecount:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"events"},{"kind":"text","text":": [any ("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events5EventP","text":"Event"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7Codablea","text":"Codable"},{"kind":"text","text":").Type], "},{"kind":"externalParam","text":"directory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SystemPackage8FilePathV","text":"FilePath"},{"kind":"text","text":", "},{"kind":"externalParam","text":"byteBound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"segmentByteCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11Persistence17SegmentStoreErrorO","text":"SegmentStoreError"},{"kind":"text","text":")"}],"title":"init(events:directory:byteBound:segmentByteCount:)","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"},"doc://Persistence/documentation/Persistence/SegmentStore":{"abstract":[{"type":"text","text":"A "},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"reference"},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","kind":"symbol","title":"SegmentStore","url":"\/documentation\/persistence\/segmentstore","role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/synchronize()":{"abstract":[{"text":"Flushes every segment written since the last flush to storage (","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":"), so it survives","type":"text"},{"text":" ","type":"text"},{"text":"power loss.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"synchronize","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","title":"synchronize()","kind":"symbol","url":"\/documentation\/persistence\/segmentstore\/synchronize()","role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/dropReports":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A report of each drop, in the order they happen, from recovery onwards."}],"url":"\/documentation\/persistence\/segmentstore\/dropreports","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DropReport","preciseIdentifier":"s:11Persistence10DropReportO","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"dropReports","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports"},"doc://Persistence/documentation/Persistence/RecordStore":{"abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"navigatorTitle":[{"text":"RecordStore","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","title":"RecordStore","kind":"symbol","url":"\/documentation\/persistence\/recordstore","role":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/persistingrecords":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","type":"link","titleInlineContent":[{"text":"Persisting Records","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords"}}}