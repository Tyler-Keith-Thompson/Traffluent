{"sections":[],"hierarchy":{"paths":[[]]},"topicSections":[{"anchor":"Stores","title":"Stores","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"Without a store, a tracker keeps its records in memory only. A tracker given a ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Tracker(store:)","type":"codeVoice"},{"text":") appends each record to it as the tracker’s worker reaches the record, before","type":"text"},{"text":" ","type":"text"},{"text":"publishing it, and starts its records with the ones the store kept from earlier runs.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","isActive":true,"type":"reference"},{"text":" is the store this module ships: a directory of append-only segment files, bounded at 5 MiB unless you pass another ","type":"text"},{"code":"byteBound","type":"codeVoice"},{"text":". A segment is","type":"text"},{"text":" ","type":"text"},{"text":"deleted once every record in it is delivered.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"SegmentStore()"},{"type":"text","text":" keeps every event type declared with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" in the program’s modules, and the"},{"type":"text","text":" "},{"type":"text","text":"library’s own; "},{"type":"codeVoice","code":"SegmentStore(events:)"},{"type":"text","text":" keeps only the "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" types it lists. Each record"},{"type":"text","text":" "},{"type":"text","text":"is a CBOR (RFC 8949) map, its event a map of its properties under their names, written through the"},{"type":"text","text":" "},{"type":"text","text":"event’s "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance. "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"EventMacros"},{"type":"text","text":", part of "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":") writes"},{"type":"text","text":" "},{"type":"text","text":"the conformance, and Swift’s synthesized one works too. "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" writes a "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" property, and each"},{"type":"text","text":" "},{"type":"text","text":"date in a "},{"type":"codeVoice","code":"[Date]"},{"type":"text","text":" or "},{"type":"codeVoice","code":"[Date?]"},{"type":"text","text":", as the seconds since 2001 it stores, so it reads back exactly. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" written through the CBOR package’s own form, in a "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type of your own or in a"},{"type":"text","text":" "},{"type":"text","text":"synthesized conformance, reads back to within a rounding of a microsecond’s scale. Events of other"},{"type":"text","text":" "},{"type":"text","text":"types, such as one that conforms to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" by hand without being listed, are delivered in this"},{"type":"text","text":" "},{"type":"text","text":"run but never written, and reported once as "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A store doesn’t read the records Traffluent 0.0.44 or earlier wrote, in an earlier format:"},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","type":"reference","isActive":true},{"type":"text","text":" deletes their segments and reports each as a corruption."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each drop is reported on "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","isActive":true},{"type":"text","text":" as a "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","isActive":true},{"type":"text","text":": the oldest segments"},{"type":"text","text":" "},{"type":"text","text":"deleted to stay under the bound, a write that failed, and records recovery couldn’t read or found"},{"type":"text","text":" "},{"type":"text","text":"at another "},{"code":"schemaVersion","type":"codeVoice"},{"type":"text","text":". A record whose delivery had started when the app ended comes back with"},{"type":"text","text":" "},{"code":"isRedelivered","type":"codeVoice"},{"type":"text","text":" set. Call "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","isActive":true},{"type":"text","text":", after the tracker’s "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":", as the"},{"type":"text","text":" "},{"type":"text","text":"app moves to the background, so the records written so far survive power loss too."}],"type":"paragraph"},{"inlineContent":[{"text":"An app on Apple platforms that already keeps a GRDB database can keep its records in a table of it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"DatabaseStore","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"GRDBPersistence","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Traffluent","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var seats: Int = 1","}","","let store = try SegmentStore(directory: directory, byteBound: 1024 * 1024)","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)","tracker.track(SignedUp(plan: \"pro\", seats: 3))"],"type":"codeListing"},{"inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers what the store writes, its bounds and recovery, and","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers which changes to an event’s type its stored records can be read through.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence"},"metadata":{"externalID":"Persistence","modules":[{"name":"Persistence"}],"role":"collection","symbolKind":"module","roleHeading":"Framework","title":"Persistence"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistence"]}],"references":{"doc://Persistence/documentation/Persistence/SegmentStore/synchronize()":{"url":"\/documentation\/persistence\/segmentstore\/synchronize()","title":"synchronize()","kind":"symbol","abstract":[{"text":"Flushes every segment written since the last flush to storage (","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":"), so it survives","type":"text"},{"text":" ","type":"text"},{"text":"power loss.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"synchronize"},{"kind":"text","text":"()"}],"role":"symbol"},"doc://Persistence/documentation/Persistence":{"title":"Persistence","url":"\/documentation\/persistence","kind":"symbol","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"topic","role":"collection"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/persistingrecords":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","titleInlineContent":[{"type":"text","text":"Persisting Records"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/changingevents":{"titleInlineContent":[{"text":"Changing Events","type":"text"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents","type":"link","title":"Changing Events","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents"},"doc://Persistence/documentation/Persistence/SegmentStoreError":{"title":"SegmentStoreError","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStoreError"}],"navigatorTitle":[{"kind":"identifier","text":"SegmentStoreError"}],"url":"\/documentation\/persistence\/segmentstoreerror","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","role":"symbol","abstract":[{"text":"The error ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","isActive":true,"type":"reference"},{"text":" throws: an","type":"text"},{"text":" ","type":"text"},{"text":"argument it can’t open a store with, or the file system’s failure.","type":"text"}]},"doc://Persistence/documentation/Persistence/RecordStore":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"Where a tracker keeps each record until it is delivered, so records survive the app ending.","type":"text"}],"url":"\/documentation\/persistence\/recordstore","title":"RecordStore","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","navigatorTitle":[{"text":"RecordStore","kind":"identifier"}]},"doc://Persistence/documentation/Persistence/SegmentStore/dropReports":{"title":"dropReports","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"DropReport","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence10DropReportO"},{"text":">","kind":"text"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A report of each drop, in the order they happen, from recovery onwards."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","type":"topic","url":"\/documentation\/persistence\/segmentstore\/dropreports"},"doc://Persistence/documentation/Persistence/DropReport":{"title":"DropReport","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DropReport","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Records a store dropped before they were delivered, and why."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","navigatorTitle":[{"text":"DropReport","kind":"identifier"}],"type":"topic","url":"\/documentation\/persistence\/dropreport"},"doc://Persistence/documentation/Persistence/SegmentStore":{"title":"SegmentStore","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"type":"topic","url":"\/documentation\/persistence\/segmentstore"},"doc://Persistence/documentation/Persistence/SegmentStore/init(events:directory:byteBound:segmentByteCount:)":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","abstract":[{"type":"text","text":"A store keeping events of the types "},{"type":"codeVoice","code":"events"},{"type":"text","text":" in "},{"type":"codeVoice","code":"directory"},{"type":"text","text":"; it recovers the records"},{"type":"text","text":" "},{"type":"text","text":"already there."}],"url":"\/documentation\/persistence\/segmentstore\/init(events:directory:bytebound:segmentbytecount:)","role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"events"},{"kind":"text","text":": [any ("},{"preciseIdentifier":"s:6Events5EventP","kind":"typeIdentifier","text":"Event"},{"kind":"text","text":" & "},{"preciseIdentifier":"s:s7Codablea","kind":"typeIdentifier","t