xt"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"SegmentStoreError","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence17SegmentStoreErrorO"},{"text":")","kind":"text"}],"abstract":[{"text":"A store keeping events of the types ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"directory"},{"text":"; it recovers the records","type":"text"},{"text":" ","type":"text"},{"text":"already there.","type":"text"}]},"doc://Persistence/documentation/Persistence/SegmentStoreError":{"url":"\/documentation\/persistence\/segmentstoreerror","title":"SegmentStoreError","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SegmentStoreError"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStoreError"}],"abstract":[{"type":"text","text":"The error "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","isActive":true},{"type":"text","text":" throws: an"},{"type":"text","text":" "},{"type":"text","text":"argument it can’t open a store with, or the file system’s failure."}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/persistingrecords":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","titleInlineContent":[{"text":"Persisting Records","type":"text"}],"type":"link","title":"Persisting Records"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/changingevents":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents","identifier":"https:\/\/tyl