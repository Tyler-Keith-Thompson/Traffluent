{"hierarchy":{"paths":[[]]},"metadata":{"role":"collection","modules":[{"name":"Persistence"}],"title":"Persistence","externalID":"Persistence","roleHeading":"Framework","symbolKind":"module"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"],"anchor":"Stores","title":"Stores"}],"sections":[],"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a store, a tracker keeps its records in memory only. A tracker given a "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Tracker(store:)"},{"type":"text","text":") appends each record to it as the tracker’s worker reaches the record, before"},{"type":"text","text":" "},{"type":"text","text":"publishing it, and starts its records with the ones the store kept from earlier runs."},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","type":"reference","isActive":true},{"type":"text","text":" is the store this module ships: a directory of append-only segment files, bounded at 5 MiB unless you pass another "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":". A segment is"},{"type":"text","text":" "},{"type":"text","text":"deleted once every record in it is delivered."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A store keeps only the event types you list in "},{"type":"codeVoice","code":"events"},{"type":"text","text":", which conform to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":". Each record"},{"type":"text","text":" "},{"type":"text","text":"is a CBOR (RFC 8949) map, its event a map of its properties under their names, written through the"},{"type":"text","text":" "},{"type":"text","text":"event’s "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance. "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"EventMacros"},{"type":"text","text":", part of "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":") writes"},{"type":"text","text":" "},{"type":"text","text":"the conformance, and Swift’s synthesized one works too. "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" writes a "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" property, and each"},{"type":"text","text":" "},{"type":"text","text":"date in a "},{"type":"codeVoice","code":"[Date]"},{"type":"text","text":" or "},{"type":"codeVoice","code":"[Date?]"},{"type":"text","text":", as the seconds since 2001 it stores, so it reads back exactly. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" written through the CBOR package’s own form, in a "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type of your own or in a"},{"type":"text","text":" "},{"type":"text","text":"synthesized conformance, reads back to within a rounding of a microsecond’s scale. Events of other"},{"type":"text","text":" "},{"type":"text","text":"types are delivered in this run but never written."}]},{"type":"paragraph","inlineContent":[{"text":"A store doesn’t read the records Traffluent 0.0.44 or earlier wrote, in an earlier format:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"},{"text":" deletes their segments and reports each as a corruption.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each drop is reported on ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","isActive":true,"type":"reference"},{"text":" as a ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","isActive":true,"type":"reference"},{"text":": the oldest segments","type":"text"},{"text":" ","type":"text"},{"text":"deleted to stay under the bound, a write that failed, and records recovery couldn’t read or found","type":"text"},{"text":" ","type":"text"},{"text":"at another ","type":"text"},{"code":"schemaVersion","type":"codeVoice"},{"text":". A record whose delivery had started when the app ended comes back with","type":"text"},{"text":" ","type":"text"},{"code":"isRedelivered","type":"codeVoice"},{"text":" set. Call ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","isActive":true,"type":"reference"},{"text":", after the tracker’s ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":", as the","type":"text"},{"text":" ","type":"text"},{"text":"app moves to the background, so the records written so far survive power loss too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An app on Apple platforms that already keeps a GRDB database can keep its records in a table of it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"DatabaseStore"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"GRDBPersistence"},{"text":").","type":"text"}]},{"syntax":"swift","code":["import Traffluent","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var seats: Int = 1","}","","let store = try SegmentStore(events: [SignedUp.self], directory: directory, byteBound: 1024 * 1024)","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)","tracker.track(SignedUp(plan: \"pro\", seats: 3))"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords"},{"text":" ","type":"text"},{"text":"covers what the store writes, its bounds and recovery, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents"},{"text":" ","type":"text"},{"text":"covers which changes to an event’s type its stored records can be read through.","type":"text"}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistence"]}],"references":{"doc://Persistence/documentation/Persistence/SegmentStoreError":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","url":"\/documentation\/persistence\/segmentstoreerror","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStoreError"}],"navigatorTitle":[{"kind":"identifier","text":"SegmentStoreError"}],"title":"SegmentStoreError","abstract":[{"type":"text","text":"The error "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"},{"type":"text","text":" throws: an"},{"type":"text","text":" "},{"type":"text","text":"argument it can’t open a store with, or the file system’s failure."}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/persistingrecords":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","type":"link","titleInlineContent":[{"text":"Persisting Records","type":"text"}],"title":"Persisting Records","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords"},"doc://Persistence/documentation/Persistence/SegmentStore/init(events:directory:byteBound:segmentByteCount:)":{"title":"init(events:directory:byteBound:segmentByteCount:)","url":"\/documentation\/persistence\/segmentstore\/init(events:directory:bytebound:segmentbytecount:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"events"},{"kind":"text","text":": [any ("},{"kind":"typeIdentifier","text":"Event","preciseIdentifier":"s:6Events5EventP"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","text":"Codable","preciseIdentifier":"s:s7Codablea"},{"kind":"text","text":").Type], "},{"kind":"externalParam","text":"directory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"FilePath","preciseIdentifier":"s:13SystemPackage8FilePathV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"byteBound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"segmentByteCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"SegmentStoreError","preciseIdentifier":"s:11Persistence17SegmentStoreErrorO"},{"kind":"text","text":")"}],"role":"symbol","abstract":[{"type":"text","text":"A store keeping events of the types "},{"type":"codeVoice","code":"events"},{"type":"text","text":" in "},{"type":"codeVoice","code":"directory"},{"type":"text","text":"; it recovers the records"},{"type":"text","text":" "},{"type":"text","text":"already there."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","kind":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore":{"type":"topic","abstract":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"reference"},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"url":"\/documentation\/persistence\/segmentstore","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","title":"SegmentStore","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/dropReports":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"DropReport","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence10DropReportO"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A report of each drop, in the order they happen, from recovery onwards."}],"kind":"symbol","title":"dropReports","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","type":"topic","url":"\/documentation\/persistence\/segmentstore\/dropreports","role":"symbol"},"doc://Persistence/documentation/Persistence":{"type":"topic","url":"\/documentation\/persistence","title":"Persistence","role":"collection","identifier":"doc:\/\/Persistence\/documentation\/Persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"kind":"symbol"},"doc://Persistence/documentation/Persistence/RecordStore":{"navigatorTitle":[{"text":"RecordStore","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"abstract":[{"text":"Where a tracker keeps each record until it is delivered, so records survive the app ending.","type":"text"}],"title":"RecordStore","kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"topic","url":"\/documentation\/persistence\/recordstore","role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/synchronize()":{"type":"topic","abstract":[{"text":"Flushes every segment written since the last flush to storage (","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":"), so it survives","type":"text"},{"text":" ","type":"text"},{"text":"power loss.","type":"text"}],"url":"\/documentation\/persistence\/segmentstore\/synchronize()","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","title":"synchronize()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"synchronize","kind":"identifier"},{"text":"()","kind":"text"}],"kind":"symbol","role":"symbol"},"doc://Persistence/documentation/Persistence/DropReport":{"navigatorTitle":[{"text":"DropReport","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DropReport","kind":"identifier"}],"abstract":[{"type":"text","text":"Records a store dropped before they were delivered, and why."}],"kind":"symbol","title":"DropReport","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","type":"topic","url":"\/documentation\/persistence\/dropreport","role":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/changingevents":{"identifier":"https:\/\/tyler-kei