{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/persistence"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"Persistence"}],"roleHeading":"Framework","role":"collection","symbolKind":"module","externalID":"Persistence","title":"Persistence"},"sections":[],"abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"topicSections":[{"anchor":"Stores","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"],"title":"Stores"},{"anchor":"The-binary-encoding","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","doc:\/\/Persistence\/documentation\/Persistence\/BinaryEncoder","doc:\/\/Persistence\/documentation\/Persistence\/KeyedBinaryEncoder","doc:\/\/Persistence\/documentation\/Persistence\/BinaryDecoder","doc:\/\/Persistence\/documentation\/Persistence\/KeyedBinaryDecoder","doc:\/\/Persistence\/documentation\/Persistence\/BinaryDecodingError"],"title":"The binary encoding"},{"anchor":"Extended-Modules","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/Events","doc:\/\/Persistence\/documentation\/Persistence\/FoundationEssentials","doc:\/\/Persistence\/documentation\/Persistence\/Swift"],"title":"Extended Modules","generated":true}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a store, a tracker keeps its records in memory only. A tracker given a "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Tracker(store:)"},{"type":"text","text":") appends each record to it as the tracker’s worker reaches the record, before"},{"type":"text","text":" "},{"type":"text","text":"publishing it, and starts its records with the ones the store kept from earlier runs."},{"type":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","type":"reference","isActive":true},{"type":"text","text":" is the store this module ships: a directory of append-only segment files, bounded at 5 MiB unless you pass another "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":". A segment is"},{"type":"text","text":" "},{"type":"text","text":"deleted once every record in it is delivered."}]},{"type":"paragraph","inlineContent":[{"text":"A store keeps only the event types you list in ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", which conform to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"CBOR (RFC 8949), each event a map of its properties under their names, written with a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryEncoder"},{"text":" and read with a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryDecoder"},{"text":". ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"EventMacros","type":"codeVoice"},{"text":", part of","type":"text"},{"text":" ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":") writes the conformance; ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable"},{"text":" shows one written by hand. Events of","type":"text"},{"text":" ","type":"text"},{"text":"other types are delivered in this run but never written.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each drop is reported on "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","isActive":true},{"type":"text","text":" as a "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","isActive":true},{"type":"text","text":": the oldest segments"},{"type":"text","text":" "},{"type":"text","text":"deleted to stay under the bound, a write that failed, and records recovery couldn’t read or found"},{"type":"text","text":" "},{"type":"text","text":"at another "},{"type":"codeVoice","code":"schemaVersion"},{"type":"text","text":". A record whose delivery had started when the app ended comes back with"},{"type":"text","text":" "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set. Call "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","isActive":true},{"type":"text","text":", after the tracker’s "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":", as the"},{"type":"text","text":" "},{"type":"text","text":"app moves to the background, so the records written so far survive power loss too."}]},{"type":"paragraph","inlineContent":[{"text":"An app on Apple platforms that already keeps a GRDB database can keep its records in a table of it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"DatabaseStore"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"GRDBPersistence"},{"text":").","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Traffluent","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","    var seats: Int = 1","}","","let store = try SegmentStore(events: [SignedUp.self], directory: directory, byteBound: 1024 * 1024)","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)","tracker.track(SignedUp(plan: \"pro\", seats: 3))"]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords"},{"text":" ","type":"text"},{"text":"covers what the store writes, its bounds and recovery, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents"},{"text":" ","type":"text"},{"text":"covers which changes to an event’s type its stored records can be read through.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://Persistence/documentation/Persistence/BinaryDecoder":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryDecoder","title":"BinaryDecoder","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryDecoder"}],"navigatorTitle":[{"kind":"identifier","text":"BinaryDecoder"}],"kind":"symbol","abstract":[{"type":"text","text":"Reads values in their "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","isActive":true},{"type":"text","text":" form, CBOR (RFC 8949), one data item after another,"},{"type":"text","text":" "},{"type":"text","text":"from bytes in memory."}],"role":"symbol","url":"\/documentation\/persistence\/binarydecoder","type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/changingevents":{"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents","title":"Changing Events","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traff