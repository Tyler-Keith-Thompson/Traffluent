ce"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeEncodingError","kind":"identifier"}],"title":"AmplitudeEncodingError","url":"\/documentation\/amplitudeencoding\/amplitudeencodingerror","role":"symbol","navigatorTitle":[{"text":"AmplitudeEncodingError","kind":"identifier"}],"kind":"symbol"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeRegion":{"title":"AmplitudeRegion","type":"topic","kind":"symbol","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","abstract":[{"type":"text","text":"The data center an Amplitude project’s data resides in, which decides the HTTP V2 endpoint its"},{"type":"text","text":" "},{"type":"text","text":"events are posted to."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AmplitudeRegion"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeRegion"}],"url":"\/documentation\/amplitudeencoding\/amplituderegion"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeBatchEncoder","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" of Amplitude’s HTTP V2 API, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"t