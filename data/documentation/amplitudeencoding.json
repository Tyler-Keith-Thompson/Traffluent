{"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError"],"title":"Sending to Amplitude","anchor":"Sending-to-Amplitude"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError"],"title":"Records left out","anchor":"Records-left-out"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","type":"reference"},{"text":" makes an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference"},{"text":") for your Amplitude project in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the API key, posts to the HTTP V2 endpoint of the project’s data residency (","type":"text"},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"with an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","type":"reference"},{"text":", and splits each batch to Amplitude’s limits","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","type":"reference"},{"text":"): 10 events and 1 MB a request, which a project on any plan","type":"text"},{"text":" ","type":"text"},{"text":"accepts. A batch with no record the encoder can write, an empty one included, makes no request. It","type":"text"},{"text":" ","type":"text"},{"text":"retries no response, a 5xx, 408 and 429, and drops and reports any other status. The API key goes","type":"text"},{"text":" ","type":"text"},{"text":"in the body, so no header field is needed, and no trace context is sent. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" ","type":"text"},{"text":"leaves this module out; import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The region has no default. A project’s data resides in Amplitude’s default data center or its EU"},{"type":"text","text":" "},{"type":"text","text":"one, and an event posted to the other doesn’t reach it, so you pick the region on purpose. The"},{"type":"text","text":" "},{"type":"text","text":"factory throws "},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError","isActive":true},{"type":"text","text":" for an empty key, and for an Amplitude Experiment deployment"},{"type":"text","text":" "},{"type":"text","text":"key, which isn’t the project’s API key."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each record becomes an event of an anonymous device. Its "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":" is the record’s session,"},{"type":"text","text":" "},{"type":"text","text":"from the sessions enricher, and its "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":" that session’s start in Unix milliseconds; a"},{"type":"text","text":" "},{"type":"text","text":"record with no session is sent under its own record identifier, with no "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":". No "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":" "},{"type":"text","text":"is sent. Its "},{"type":"codeVoice","code":"insert_id"},{"type":"text","text":" is the record’s identifier, which a redelivered record keeps, and its"},{"type":"text","text":" "},{"type":"codeVoice","code":"time"},{"type":"text","text":" the record’s timestamp in epoch milliseconds. The record’s vendor identifier and trace"},{"type":"text","text":" "},{"type":"text","text":"context aren’t sent, nor is an "},{"type":"codeVoice","code":"ip"},{"type":"text","text":", and the standard context is sent as Amplitude’s own fields"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"app_version"},{"type":"text","text":", "},{"type":"codeVoice","code":"device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"language"},{"type":"text","text":", "},{"type":"codeVoice","code":"platform"},{"type":"text","text":", "},{"type":"codeVoice","code":"os_name"},{"type":"text","text":" and "},{"type":"codeVoice","code":"os_version"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Amplitude counts a user per "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":" and bills by monthly tracked users, so each session counts"},{"type":"text","text":" "},{"type":"text","text":"as one tracked user, and so does each record sent without a session."}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in the ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":" the encoder is made with, into","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"event_properties"},{"text":". A ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value is never sent, whatever the record reveals. A record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder can’t write is left out and the rest of the batch is sent: one the plan doesn’t describe,","type":"text"},{"text":" ","type":"text"},{"text":"one whose event name Amplitude keeps for its own (","type":"text"},{"type":"codeVoice","code":"[Amplitude] …"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$identify"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$groupidentify"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one holding a value JSON can’t, one whose timestamp has no","type":"text"},{"text":" ","type":"text"},{"text":"epoch-milliseconds form, and one too large for a request. The destination reports each as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"text":", a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":" whose reason is an ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to PostHog, use "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":" instead."}]},{"type":"codeListing","syntax":"swift","code":["import AmplitudeEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: amplitude)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"covers what Amplitude receives, and why, in more detail."}]}]}],"metadata":{"modules":[{"name":"AmplitudeEncoding"}],"title":"AmplitudeEncoding","role":"collection","roleHeading":"Framework","externalID":"AmplitudeEncoding","symbolKind":"module"},"abstract":[{"text":"Send records to an Amplitude project through its HTTP V2 API.","type":"text"}],"variants":[{"paths":["\/documentation\/amplitudeencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"type":"topic","url":"\/documentation\/httpdestinations\/batchencoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"text":" sends.","type":"text"}],"role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"title":"BatchEncoder"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder/batchLimit":{"abstract":[{"type":"text","text":"Amplitude’s limits on one request: 10 events and 1,000,000 bytes of body, an event’s"},{"type":"text","text":" "},{"type":"text","text":"included."}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","type":"topic","fra