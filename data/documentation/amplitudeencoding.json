 in"},{"type":"text","text":" "},{"code":"region","type":"codeVoice"},{"type":"text","text":", with "},{"code":"URLSession.shared","type":"codeVoice"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" on "},{"code":"clock","type":"codeVoice"},{"type":"text","text":"."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"title":"BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"type":"text","text":" sends."}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","kind":"symbol","abstract":[{"type":"text","text":"Send records to an Amplitude project through its HTTP V2 API."}],"type":"topic","title":"AmplitudeEncoding","role":"collection","url":"\/documentation\/amplitudeencoding"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder/batchLimit":{"kind":"symbol","type":"topic","title":"batchLimit","role":"symbol","url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder\/batchlimit","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","abstract":[{"type":"text","text":"Amplitude’s limits on one request: 10 events and 1,000,000 bytes of body, an event’s"},{"type":"text","text":" "},{"type":"text","text":"included."}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder":{"title":"AmplitudeBatchEncoder","url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder","type":"topic","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeBatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"AmplitudeBatchEncoder"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Amplitude’s HTTP V2 API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to an Amplitude project’s "},{"type":"codeVoice","code":"POST \/2\/httpapi"},{"type":"text","text":"."}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","url":"\/documentation\/httpdestinations","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","role":"collection","kind":"symbol","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeSetupError":{"type":"topic","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError","url":"\/documentation\/amplitudeencoding\/amplitudesetuperror","abstract":[{"text":"Why ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)","type":"reference"},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AmplitudeSetupError"}],"title":"AmplitudeSetupError","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeSetupError"}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeEncodingError":{"title":"AmplitudeEncodingError","url":"\/documentation\/amplitudeencoding\/amplitudeencodingerror","type":"topic","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeEncodingError","kind":"identifier"}],"navigatorTitle":[{"text":"AmplitudeEncodingError","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for the batch.","type":"text"}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeRegion":{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","type":"topic","url":"\/documentation\/amplitudeencoding\/amplituderegion","a