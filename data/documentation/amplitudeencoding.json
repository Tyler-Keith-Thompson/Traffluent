ialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier","text":"Clock"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:17AmplitudeEncoding0A10SetupErrorO","kind":"typeIdentifier","text":"AmplitudeSetupError"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","kind":"typeIdentifier","text":"URLSessionTransport"},{"kind":"text","text":", "},{"preciseIdentifier":"s:17AmplitudeEncoding0A12BatchEncoderV","kind":"typeIdentifier","text":"AmplitudeBatchEncoder"},{"kind":"text","text":">"}],"kind":"symbol","title":"amplitude(apiKey:region:plan:backoff:clock:)","url":"\/documentation\/amplitudeencoding\/httpdestinations\/httpdestination\/amplitude(apikey:region:plan:backoff:clock:)"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/HTTPDestinations/HTTPDestination/amplitude(apiKey:region:plan:transport:backoff:clock:)":{"url":"\/documentation\/amplitudeencoding\/httpdestinations\/httpdestination\/amplitude(apikey:region:plan:transport:backoff:clock:)","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)","type":"topic","abstract":[{"type":"text","text":"A destination that sends batches to the Amplitude project of "},{"code":"apiKey","type":"codeVoice"},{"type":"text","text":", whose data resides in"},{"type":"text","text":" "},{"code":"region","type":"codeVoice"},{"type":"text","text":", through "},{"code":"transport","type