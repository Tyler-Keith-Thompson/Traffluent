pe":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"url":"\/documentation\/amplitudeencoding\/httpdestinations\/httpdestination\/amplitude(apikey:region:plan:transport:backoff:clock:)","role":"symbol"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"kind":"symbol","abstract":[{"type":"text","text":"Send records to an Amplitude project through its HTTP V2 API."}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","title":"AmplitudeEncoding","type":"topic","url":"\/documentation\/amplitudeencoding","role":"collection"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeSetupError":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeSetupError","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError","kind":"symbol","navigatorTitle":[{"text":"AmplitudeSetupError","kind":"identifier"}],"url":"\/documentation\/amplitudeencoding\/amplitudesetuperror","abstract":[{"type":"text","text":"Why "},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"role":"symbol","title":"AmplitudeSetupError"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeRegion":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeRegion","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","kind":"symbol","navigatorTitle":[{"text":"AmplitudeRegion","kind":"identifier"}],"url":"\/documentation\/amplitudeencoding\/amplituderegion","abstract":[{"type":"text","text":"The data center an Amplitude project’s data resides in, which decides the HTTP V2 endpoint its"},{"type":"text","text":" "},{"type":"text","text":"events are posted to."}],"role":"symbol","title":"AmplitudeRegion"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","kind":"symbol","url":"\/documentation\/httpdestinations","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"role":"collection","title":"HTTPDestinations"}}}