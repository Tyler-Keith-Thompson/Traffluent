{"hierarchy":{"paths":[[]]},"kind":"symbol","abstract":[{"type":"text","text":"Send records to an Amplitude project through its HTTP V2 API."}],"metadata":{"modules":[{"name":"AmplitudeEncoding"}],"symbolKind":"module","title":"AmplitudeEncoding","roleHeading":"Framework","role":"collection","externalID":"AmplitudeEncoding"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError"],"title":"Sending to Amplitude","anchor":"Sending-to-Amplitude"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError"],"title":"Records left out","anchor":"Records-left-out"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)"},{"type":"text","text":" makes an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":") for your Amplitude project in one call. It checks"},{"type":"text","text":" "},{"type":"text","text":"the API key, posts to the HTTP V2 endpoint of the project’s data residency ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"with an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"},{"type":"text","text":", and splits each batch to Amplitude’s limits"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit"},{"type":"text","text":"): 10 events and 1 MB a request, which a project on any plan"},{"type":"text","text":" "},{"type":"text","text":"accepts. A batch with no record the encoder can write, an empty one included, makes no request. It"},{"type":"text","text":" "},{"type":"text","text":"retries no response, a 5xx, 408 and 429, and drops and reports any other status. The API key goes"},{"type":"text","text":" "},{"type":"text","text":"in the body, so no header field is needed, and no trace context is sent. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" "},{"type":"text","text":"leaves this module out; import it on its own."}],"type":"paragraph"},{"inlineContent":[{"text":"The region has no default. A project’s data resides in Amplitude’s default data center or its EU","type":"text"},{"text":" ","type":"text"},{"text":"one, and an event posted to the other doesn’t reach it, so you pick the region on purpose. The","type":"text"},{"text":" ","type":"text"},{"text":"factory throws ","type":"text"},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError","isActive":true},{"text":" for an empty key, and for an Amplitude Experiment deployment","type":"text"},{"text":" ","type":"text"},{"text":"key, which isn’t the project’s API key.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each record becomes an event of an anonymous device. Its "},{"code":"device_id","type":"codeVoice"},{"type":"text","text":" is the record’s session,"},{"type":"text","text":" "},{"type":"text","text":"from the sessions enricher, and its "},{"code":"session_id","type":"codeVoice"},{"type":"text","text":" that session’s start in Unix milliseconds; a"},{"type":"text","text":" "},{"type":"text","text":"record with no session is sent under its own record identifier, with no "},{"code":"session_id","type":"codeVoice"},{"type":"text","text":". No "},{"code":"user_id","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is sent. Its "},{"code":"insert_id","type":"codeVoice"},{"type":"text","text":" is the record’s identifier, which a redelivered record keeps, and its"},{"type":"text","text":" "},{"code":"time","type":"codeVoice"},{"type":"text","text":" the record’s timestamp in epoch milliseconds. The record’s vendor identifier and trace"},{"type":"text","text":" "},{"type":"text","text":"context aren’t sent, nor is an "},{"code":"ip","type":"codeVoice"},{"type":"text","text":", and the standard context is sent as Amplitude’s own fields"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"app_version","type":"codeVoice"},{"type":"text","text":", "},{"code":"device_model","type":"codeVoice"},{"type":"text","text":", "},{"code":"language","type":"codeVoice"},{"type":"text","text":", "},{"code":"platform","type":"codeVoice"},{"type":"text","text":", "},{"code":"os_name","type":"codeVoice"},{"type":"text","text":" and "},{"code":"os_version","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"Amplitude counts a user per ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":" and bills by monthly tracked users, so each session counts","type":"text"},{"text":" ","type":"text"},{"text":"as one tracked user, and so does each record sent without a session.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is made with, into","type":"text"},{"text":" ","type":"text"},{"code":"event_properties","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is never sent, whatever the record reveals. A record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder can’t write is left out and the rest of the batch is sent: one the plan doesn’t describe,","type":"text"},{"text":" ","type":"text"},{"text":"one whose event name Amplitude keeps for its own (","type":"text"},{"code":"[Amplitude] …","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$identify","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$groupidentify","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one holding a value JSON can’t, one whose timestamp has no","type":"text"},{"text":" ","type":"text"},{"text":"epoch-milliseconds form, and one too large for a request. The destination reports each as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" whose reason is an ","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To send to PostHog, use "},{"code":"PostHogEncoding","type":"codeVoice"},{"type":"text","text":" instead."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import AmplitudeEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: amplitude)"]},{"inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers what Amplitude receives, and why, in more detail."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/amplitudeencoding"]}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations":{"url":"\/documentation\/httpdestinations","role":"collection","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","title":"HTTPDestinations","type":"topic"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeSetupError":{"abstract":[{"type":"text","text":"Why "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)"},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"AmplitudeSetupError"}],"url":"\/documentation\/amplitudeencoding\/amplitudesetuperror","title":"AmplitudeSetupError","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeSetupError"}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeRegion":{"title":"AmplitudeRegion","url":"\/documentation\/amplitudeencoding\/amplituderegion","navigatorTitle":[{"text":"AmplitudeRegion","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"text":"The data center an Amplitude project’s data resides in, which decides the HTTP V2 endpoint its","type":"text"},{"text":" ","type":"text"},{"text":"events are posted to.","type":"text"}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeRegion","kind":"identifier"}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/HTTPDestinations/HTTPDestination/amplitude(apiKey:region:plan:transport:backoff:clock:)":{"url":"\/documentation\/amplitudeencoding\/httpdestinations\/httpdestination\/amplitude(apikey:region:plan:transport:backoff:clock:)","role":"symbol","abstract":[{"type":"text","text":"A destination that sends batches to the Amplitude project of "},{"type":"codeVoice","code":"apiKey"},{"type":"text","text":", whose data resides in"},{"type":"text","text":" "},{"type":"codeVoice","code":"region"},{"type":"text","text":", through "},{"type":"codeVoice","code":"transport"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"amplitude","kind":"identifier"},{"text":"(","kind":"text"},{"text":"apiKey","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ",