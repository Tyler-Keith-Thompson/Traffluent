{"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","abstract":[{"text":"Send records to an Amplitude project through its HTTP V2 API.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError"],"title":"Sending to Amplitude","anchor":"Sending-to-Amplitude"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError"],"title":"Records left out","anchor":"Records-left-out"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)"},{"text":" makes an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"text":") for your Amplitude project in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the API key, posts to the HTTP V2 endpoint of the project’s data residency (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"with an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"},{"text":", and splits each batch to Amplitude’s limits","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit"},{"text":"): 10 events and 1 MB a request, which a project on any plan","type":"text"},{"text":" ","type":"text"},{"text":"accepts. A batch with no record the encoder can write, an empty one included, makes no request. It","type":"text"},{"text":" ","type":"text"},{"text":"retries no response, a 5xx, 408 and 429, and drops and reports any other status. The API key goes","type":"text"},{"text":" ","type":"text"},{"text":"in the body, so no header field is needed, and no trace context is sent. ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" ","type":"text"},{"text":"leaves this module out; import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The region has no default. A project’s data resides in Amplitude’s default data center or its EU","type":"text"},{"text":" ","type":"text"},{"text":"one, and an event posted to the other doesn’t reach it, so you pick the region on purpose. The","type":"text"},{"text":" ","type":"text"},{"text":"factory throws ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError","type":"reference"},{"text":" for an empty key, and for an Amplitude Experiment deployment","type":"text"},{"text":" ","type":"text"},{"text":"key, which isn’t the project’s API key.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each record becomes an event of an anonymous device. Its "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":" is the record’s session,"},{"type":"text","text":" "},{"type":"text","text":"from the sessions enricher, and its "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":" that session’s start in Unix milliseconds; a"},{"type":"text","text":" "},{"type":"text","text":"record with no session is sent under its own record identifier, with no "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":". No "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":" "},{"type":"text","text":"is sent. Its "},{"type":"codeVoice","code":"insert_id"},{"type":"text","text":" is the record’s identifier, which a redelivered record keeps, and its"},{"type":"text","text":" "},{"type":"codeVoice","code":"time"},{"type":"text","text":" the record’s timestamp in epoch milliseconds. The record’s vendor identifier and trace"},{"type":"text","text":" "},{"type":"text","text":"context aren’t sent, nor is an "},{"type":"codeVoice","code":"ip"},{"type":"text","text":", and the standard context is sent as Amplitude’s own fields"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"app_version"},{"type":"text","text":", "},{"type":"codeVoice","code":"device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"language"},{"type":"text","text":", "},{"type":"codeVoice","code":"platform"},{"type":"text","text":", "},{"type":"codeVoice","code":"os_name"},{"type":"text","text":" and "},{"type":"codeVoice","code":"os_version"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"text":"Amplitude counts a user per ","type":"text"},{"type":"codeVoice","code":"device_id"},{"text":" and bills by monthly tracked users, so each session counts","type":"text"},{"text":" ","type":"text"},{"text":"as one tracked user, and so does each record sent without a session.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with, into"},{"type":"text","text":" "},{"type":"codeVoice","code":"event_properties"},{"type":"text","text":". A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals. A record the"},{"type":"text","text":" "},{"type":"text","text":"encoder can’t write is left out and the rest of the batch is sent: one the plan doesn’t describe,"},{"type":"text","text":" "},{"type":"text","text":"one whose event name Amplitude keeps for its own ("},{"type":"codeVoice","code":"[Amplitude] …"},{"type":"text","text":", "},{"type":"codeVoice","code":"$identify"},{"type":"text","text":", "},{"type":"codeVoice","code":"$groupidentify"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one holding a value JSON can’t, one whose timestamp has no"},{"type":"text","text":" "},{"type":"text","text":"epoch-milliseconds form, and one too large for a request. The destination reports each as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" whose reason is an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to PostHog, use "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":" instead."}]},{"code":["import AmplitudeEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: amplitude)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what Amplitude receives, and why, in more detail."}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/amplitudeencoding"]}],"metadata":{"symbolKind":"module","title":"AmplitudeEncoding","roleHeading":"Framework","role":"collection","externalID":"AmplitudeEncoding","modules":[{"name":"AmplitudeEncoding"}]},"references":{"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeEncodingError":{"role":"symbol","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeEncodingError"}],"navigatorTitle":[{"kind":"identifier","text":"AmplitudeEncodingError"}],"abstract":[{"text":"Why ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for the batch.","type":"text"}],"type":"topic","kind":"symbol","title":"AmplitudeEncodingError","url":"\/documentation\/amplitudeencoding\/amplitudeencodingerror"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"text":" sends.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","role":"symbol","title":"BatchEncoder","type":"topic","url":"\/documentation\/httpdestinations\/batchencoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/HTTPDestinations/HTTPDestination/amplitude(apiKey:region:plan:transport:backoff:clock:)":{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)","url":"\/documentation\/amplitudeencoding\/httpdestinations\/httpdestination\/amplitude(apikey:region:plan:transport:backoff:clock:)","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"HTTPTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"AmplitudeBatchEncoder","type":"codeVoice"},{"text":".","type":"text"}]},"type":"topic","kind":"symbol","abstract":[{"text":"A destination that sends batches to the Amplitude project of ","type":"text"},{"code":"apiKey","type":"codeVoice"},{"text":", whose data resides in","type":"text"},{"text":" ","type":"text"},{"code":"region","type":"codeVoice"},{"text":", through ","type":"text"},{"code":"transport","type":"codeVoice"},{"text":", retrying a send that fails for now with the waits of","type":"text"},{"text":" ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"title":"amplitude(apiKey:region:plan:transport:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"amplitude","kind":"identifier"},{"text":"(","kind":"text"},{"text":"apiKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AmplitudeRegion","kind":"typeIdentifier","preciseIdentifier":"s:17AmplitudeEncoding0A6RegionO"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"AmplitudeSetupError","kind":"typeIdentifier","pre