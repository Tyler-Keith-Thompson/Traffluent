plitude’s HTTP V2 API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to an Amplitude project’s "},{"type":"codeVoice","code":"POST \/2\/httpapi"},{"type":"text","text":"."}],"url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"AmplitudeBatchEncoder","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"type":"topic","url":"\/documentation\/amplitudeencoding","kind":"symbol","role":"collection","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","title":"AmplitudeEncoding","abstract":[{"type":"text","text":"Send records to an Amplitude project through its HTTP V2 API."}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/HTTPDestinations/HTTPDestination/amplitude(apiKey:region:plan:backoff:clock:)":{"kind":"symbol","abstract":[{"type":"text","text":"A destination that sends batches to the Amplitude project of "},{"type":"codeVoice","code":"apiKey"},{"type":"text","text":", whose data resides in"},{"type":"text","text":" "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"title":"amplitude(apiKey:region:plan:backoff:clock:)","conformance":{"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" is "},{"type":"codeVoice","code":"URLSessionTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code"