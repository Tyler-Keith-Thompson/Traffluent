{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"},"topicSections":[{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError"],"anchor":"Sending-to-Amplitude","title":"Sending to Amplitude"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"],"anchor":"Encoding-batches","title":"Encoding batches"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError"],"anchor":"Records-left-out","title":"Records left out"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","isActive":true},{"type":"text","text":" makes an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":") for your Amplitude project in one call. It checks"},{"type":"text","text":" "},{"type":"text","text":"the API key, posts to the HTTP V2 endpoint of the project’s data residency ("},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","isActive":true},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"with an "},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","isActive":true},{"type":"text","text":", and splits each batch to Amplitude’s limits"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":"): 10 events and 1 MB a request, which a project on any plan"},{"type":"text","text":" "},{"type":"text","text":"accepts. A batch with no record the encoder can write, an empty one included, makes no request. It"},{"type":"text","text":" "},{"type":"text","text":"retries no response, a 5xx, 408 and 429, and drops and reports any other status. The API key goes"},{"type":"text","text":" "},{"type":"text","text":"in the body, so no header field is needed, and no trace context is sent. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" "},{"type":"text","text":"leaves this module out; import it on its own."}]},{"type":"paragraph","inlineContent":[{"text":"The region has no default. A project’s data resides in Amplitude’s default data center or its EU","type":"text"},{"text":" ","type":"text"},{"text":"one, and an event posted to the other doesn’t reach it, so you pick the region on purpose. The","type":"text"},{"text":" ","type":"text"},{"text":"factory throws ","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError","isActive":true,"type":"reference"},{"text":" for an empty key, and for an Amplitude Experiment deployment","type":"text"},{"text":" ","type":"text"},{"text":"key, which isn’t the project’s API key.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each record becomes an event of an anonymous device. Its "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":" is the record’s session,"},{"type":"text","text":" "},{"type":"text","text":"from the sessions enricher, and its "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":" that session’s start in Unix milliseconds; a"},{"type":"text","text":" "},{"type":"text","text":"record with no session is sent under its own record identifier, with no "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":". No "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":" "},{"type":"text","text":"is sent. Its "},{"type":"codeVoice","code":"insert_id"},{"type":"text","text":" is the record’s identifier, which a redelivered record keeps, and its"},{"type":"text","text":" "},{"type":"codeVoice","code":"time"},{"type":"text","text":" the record’s timestamp in epoch milliseconds. The record’s vendor identifier and trace"},{"type":"text","text":" "},{"type":"text","text":"context aren’t sent, nor is an "},{"type":"codeVoice","code":"ip"},{"type":"text","text":", and the standard context is sent as Amplitude’s own fields"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"app_version"},{"type":"text","text":", "},{"type":"codeVoice","code":"device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"language"},{"type":"text","text":", "},{"type":"codeVoice","code":"platform"},{"type":"text","text":", "},{"type":"codeVoice","code":"os_name"},{"type":"text","text":" and "},{"type":"codeVoice","code":"os_version"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Amplitude counts a user per "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":" and bills by monthly tracked users, so each session counts"},{"type":"text","text":" "},{"type":"text","text":"as one tracked user, and so does each record sent without a session."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with, into"},{"type":"text","text":" "},{"type":"codeVoice","code":"event_properties"},{"type":"text","text":". A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals. A record the"},{"type":"text","text":" "},{"type":"text","text":"encoder can’t write is left out and the rest of the batch is sent: one the plan doesn’t describe,"},{"type":"text","text":" "},{"type":"text","text":"one whose event name Amplitude keeps for its own ("},{"type":"codeVoice","code":"[Amplitude] …"},{"type":"text","text":", "},{"type":"codeVoice","code":"$identify"},{"type":"text","text":", "},{"type":"codeVoice","code":"$groupidentify"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one holding a value JSON can’t, one whose timestamp has no"},{"type":"text","text":" "},{"type":"text","text":"epoch-milliseconds form, and one too large for a request. The destination reports each as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" whose reason is an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to PostHog, use "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":" instead."}]},{"type":"codeListing","syntax":"swift","code":["import AmplitudeEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: amplitude)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers what Amplitude receives, and why, in more detail."}]}]}],"variants":[{"paths":["\/documentation\/amplitudeencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","abstract":[{"type":"text","text":"Send records to an Amplitude project through its HTTP V2 API."}],"metadata":{"symbolKind":"module","roleHeading":"Framework","role":"collection","externalID":"AmplitudeEncoding","modules":[{"name":"AmplitudeEncoding"}],"title":"AmplitudeEncoding"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder/batchLimit":{"abstract":[{"text":"Amplitude’s limits on one request: 10 events and 1,000,000 bytes of body, an event’s","type":"text"},{"text":" ","type":"text"},{"text":"included.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"}],"kind":"symbol","title":"batchLimit","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder\/batchlimit","type":"topic","role":"symbol"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/HTTPDestinations/HTTPDestination/amplitude(apiKey:region:plan:transport:backoff:clock:)":{"type":"topic","title":"amplitude(apiKey:region:plan:transport:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" 