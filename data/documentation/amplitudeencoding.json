,{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"URLSessionTransport"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Encoding"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"AmplitudeBatchEncoder"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"url":"\/documentation\/amplitudeencoding\/httpdestinations\/httpdestination\/amplitude(apikey:region:plan:backoff:clock:)","kind":"symbol","type":"topic","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","role":"symbol","title":"amplitude(apiKey:region:plan:backoff:clock:)"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeBatchEncoder"}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder","navigatorTitle":[{"kind":"identifier","text":"AmplitudeBatchEncoder"}],"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of Amplitude’s HTTP V2 API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to an Amplitude project’s ","type":"text"},{"type":"codeVoice","code":"POST \/2\/httpapi"},{"text":".","type":"text"}],"title":"AmplitudeBatchEncoder","kind":"symbol","type":"topic","role":"symbol"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeEncodingError":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeEncodingError","kind":"identifier"}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","url":"\/documentation\/amplitudeencoding\/amplitudeencodingerror","navigatorTitle":[{"text":"AmplitudeEncodingError","kind":"identifier"}],"abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"title":"AmplitudeEncodingError","kind":"symbol","type":"topic","role":"symbol"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder/batchLimit":{"kind":"symbol","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","role":"symbol","abstract":[{"type":"text","text":"Amplitude’s limits on one request: 10 events and 1,000,000 bytes of body, an event’s"},{"type":"text","text":" "},{"type":"text","text":"included."}],"title":"batchLimit","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier","text":"BatchLimit"}],"url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder\/batchlimit"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"role":"collection","type":"topic","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","title":"AmplitudeEncoding","url":"\/documentation\/amplitudeencoding","abstract":[{"text":"Send records to an Amplitude project through its HTTP V2 API.","type":"text"}],"kind":"symbol"}}}