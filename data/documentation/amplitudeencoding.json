ext"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for the batch.","type":"text"}],"url":"\/documentation\/amplitudeencoding\/amplitudeencodingerror","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeEncodingError"}],"navigatorTitle":[{"kind":"identifier","text":"AmplitudeEncodingError"}],"kind":"symbol","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"url":"\/documentation\/httpdestinations","title":"HTTPDestinations","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","role":"collection","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"kind":"symbol"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/HTTPDestinations/HTTPDestination/amplitude(apiKey:region:plan:transport:backoff:clock:)":{"kind":"symbol","title":"amplitude(apiKey:region:plan:transport:backoff:clock:)","abstract":[{"type":"text","text":"A destination that sends batches to the Amplitude project of "},{"code":"apiKey","type":"codeVoice"},{"type":"text","text":", whose data resides in"},{"type":"text","text":" "},{"code":"region","type":"codeVoice"},{"type":"text","text":", through "},{"code":"transport","type":"codeVoice"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" on "},{"code":"clock","type":"codeVoice"},{"type":"text","text":"."}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"HTTPTransport"},{"type":"text","text":" and "},{"type