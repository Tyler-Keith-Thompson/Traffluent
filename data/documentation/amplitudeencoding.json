xt":"A destination that sends batches to the Amplitude project of "},{"type":"codeVoice","code":"apiKey"},{"type":"text","text":", whose data resides in"},{"type":"text","text":" "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeRegion":{"title":"AmplitudeRegion","url":"\/documentation\/amplitudeencoding\/amplituderegion","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeRegion","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The data center an Amplitude project’s data resides in, which decides the HTTP V2 endpoint its"},{"type":"text","text":" "},{"type":"text","text":"events are posted to."}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","navigatorTitle":[{"text":"AmplitudeRegion","kind":"identifier"}],"type":"topic"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder/batchLimit":{"kind":"symbol","role":"symbol","url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder\/batchlimit","abstract":[{"type":"text","text":"Amplitude’s limits on one request: 10 events and 1,000,000 bytes of body, an event’s"},{"type":"text","text":" "},{"type":"text","text":"included."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/