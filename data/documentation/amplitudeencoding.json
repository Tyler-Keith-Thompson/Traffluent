{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/amplitudeencoding"]}],"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"AmplitudeEncoding"}],"title":"AmplitudeEncoding","symbolKind":"module","role":"collection","externalID":"AmplitudeEncoding","roleHeading":"Framework"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)"},{"type":"text","text":" makes an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":") for your Amplitude project in one call. It checks"},{"type":"text","text":" "},{"type":"text","text":"the API key, posts to the HTTP V2 endpoint of the project’s data residency ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"with an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"},{"type":"text","text":", and splits each batch to Amplitude’s limits"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit"},{"type":"text","text":"): 10 events and 1 MB a request, which a project on any plan"},{"type":"text","text":" "},{"type":"text","text":"accepts. A batch with no record the encoder can write, an empty one included, makes no request. It"},{"type":"text","text":" "},{"type":"text","text":"retries no response, a 5xx, 408 and 429, and drops and reports any other status. The API key goes"},{"type":"text","text":" "},{"type":"text","text":"in the body, so no header field is needed, and no trace context is sent. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" "},{"type":"text","text":"leaves this module out; import it on its own."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The region has no default. A project’s data resides in Amplitude’s default data center or its EU"},{"type":"text","text":" "},{"type":"text","text":"one, and an event posted to the other doesn’t reach it, so you pick the region on purpose. The"},{"type":"text","text":" "},{"type":"text","text":"factory throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError"},{"type":"text","text":" for an empty key, and for an Amplitude Experiment deployment"},{"type":"text","text":" "},{"type":"text","text":"key, which isn’t the project’s API key."}],"type":"paragraph"},{"inlineContent":[{"text":"Each record becomes an event of an anonymous device. Its ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":" is the record’s session,","type":"text"},{"text":" ","type":"text"},{"text":"from the sessions enricher, and its ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":" that session’s start in Unix milliseconds; a","type":"text"},{"text":" ","type":"text"},{"text":"record with no session is sent under its own record identifier, with no ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":". No ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is sent. Its ","type":"text"},{"code":"insert_id","type":"codeVoice"},{"text":" is the record’s identifier, which a redelivered record keeps, and its","type":"text"},{"text":" ","type":"text"},{"code":"time","type":"codeVoice"},{"text":" the record’s timestamp in epoch milliseconds. The record’s vendor identifier and trace","type":"text"},{"text":" ","type":"text"},{"text":"context aren’t sent, nor is an ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":", and the standard context is sent as Amplitude’s own fields","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device_model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"language","type":"codeVoice"},{"text":", ","type":"text"},{"code":"platform","type":"codeVoice"},{"text":", ","type":"text"},{"code":"os_name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"os_version","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Amplitude counts a user per "},{"code":"device_id","type":"codeVoice"},{"type":"text","text":" and bills by monthly tracked users, so each session counts"},{"type":"text","text":" "},{"type":"text","text":"as one tracked user, and so does each record sent without a session."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" the encoder is made with, into"},{"type":"text","text":" "},{"code":"event_properties","type":"codeVoice"},{"type":"text","text":". A "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is never sent, whatever the record reveals. A record the"},{"type":"text","text":" "},{"type":"text","text":"encoder can’t write is left out and the rest of the batch is sent: one the plan doesn’t describe,"},{"type":"text","text":" "},{"type":"text","text":"one whose event name Amplitude keeps for its own ("},{"code":"[Amplitude] …","type":"codeVoice"},{"type":"text","text":", "},{"code":"$identify","type":"codeVoice"},{"type":"text","text":", "},{"code":"$groupidentify","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"one whose event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one holding a value JSON can’t, one whose timestamp has no"},{"type":"text","text":" "},{"type":"text","text":"epoch-milliseconds form, and one too large for a request. The destination reports each as"},{"type":"text","text":" "},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"type":"text","text":", a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" whose reason is an "},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To send to PostHog, use "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":" instead."}],"type":"paragraph"},{"code":["import AmplitudeEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: amplitude)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers what Amplitude receives, and why, in more detail."}],"type":"paragraph"}]}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","interfaceLanguage":"swift"},"abstract":[{"text":"Send records to an Amplitude project through its HTTP V2 API.","type":"text"}],"topicSect