,"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AmplitudeBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:17AmplitudeEncoding0A12BatchEncoderV"},{"text":">","kind":"text"}],"title":"amplitude(apiKey:region:plan:transport:backoff:clock:)","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"url":"\/documentation\/httpdestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","role":"collection","kind":"symbol","title":"HTTPDestinations"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeEncodingError":{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","title":"AmplitudeEncodingError","role":"symbol","navigatorTitle":[{"text":"AmplitudeEncodingError","kind":"identifier"}],"url":"\/documentation\/amplitudeencoding\/amplitudeencodingerror","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeEncodingError","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","type":"reference","isActive":true},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for the batch.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"title":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","role":"symbol","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"url":"\/documentation\/httpdestinations\/batchencoder","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" sends.","type":"text"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeRegion":{"role":"symbol","abstract":[{"text":"The data center an Amplitude project’s data resides in, which decides the HTTP V2 endpoint its","type":"text"},{"text":" ","type":"text"},{"text":"events are posted to.","type":"text"}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AmplitudeRegion"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeRegion"}],"kind":"symbol","title":"AmplitudeRegion","url":"\/documentation\/amplitudeencoding\/amplituderegion"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeSetupError":{"url":"\/documentation\/amplitudeencoding\/amplitudesetu