"text"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"url":"\/documentation\/amplitudeencoding","title":"AmplitudeEncoding","role":"collection","abstract":[{"text":"Send records to an Amplitude project through its HTTP V2 API.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeEncodingError":{"type":"topic","navigatorTitle":[{"text":"AmplitudeEncodingError","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","title":"AmplitudeEncodingError","kind":"symbol","url":"\/documentation\/amplitudeencoding\/amplitudeencodingerror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeEncodingError","kind":"identifier"}],"abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}]}}}