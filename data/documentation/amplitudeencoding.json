}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","title":"batchLimit","type":"topic","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"url":"\/documentation\/httpdestinations\/batchencoder","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","title":"BatchEncoder","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeSetupError":{"role":"symbol","type":"topic","title":"AmplitudeSetupError","navigatorTitle":[{"text":"AmplitudeSetupError","kind":"identifier"}],"url":"\/documentation\/amplitudeencoding\/amplitudesetuperror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeSetupError","kind":"identifier"}],"abstract":[{"type":"text","text":"Why "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)"},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"kind":"symbol","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"kind":"symbol","title":"HTTPDestinations","role":"collection","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"url":"\/documentation\/httpdestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"abstract":[{"text":"Send records to an Amplitude project through its HTTP V2 API.","type":"text"}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","role":"collection","type":"topic","url":"\/documentation\/amplitudeencoding","kind":"symbol","title":"AmplitudeEncoding"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/HTTPDestinations/HTTPDestination/amplitude(apiKey:region:plan:transport:backoff:clock:)":{"abstract":[{"type":"text","text":"A destination that sends batches to the Amplitude project of "},{"code":"apiKey","type":"codeVoice"},{"type":"text","text":", whose data resides in"},{"type":"text","text":" "},{"code":"region","type":"codeVoice"},{"type":"text","text":", through "},{"code":"transport","type":"codeVoice"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" on "},{"code":"clock","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)","role":"symbol","url":"\/documentation\/amplitudeencoding\/httpdestinations\/httpdestination\/amplitude(apikey:region:plan:transport:backoff:clock:)","type":"topic","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"amplitude","kind":"identifier"},{"text":"(","kind":"text"},{"text":"apiKey","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17AmplitudeEncoding0A6RegionO","text":"AmplitudeRegion","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:17AmplitudeEncoding0A10SetupErrorO","text":"AmplitudeSetupError","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:17AmplitudeEncoding0A12BatchEncoderV","text":"AmplitudeBatchEncoder","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"