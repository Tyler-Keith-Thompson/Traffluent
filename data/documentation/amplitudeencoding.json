{"hierarchy":{"paths":[[]]},"kind":"symbol","identifier":{"url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError"],"title":"Sending to Amplitude","anchor":"Sending-to-Amplitude"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError"],"title":"Records left out","anchor":"Records-left-out"}],"abstract":[{"text":"Send records to an Amplitude project through its HTTP V2 API.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/amplitudeencoding"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":" makes an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"text":") for your Amplitude project in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the API key, posts to the HTTP V2 endpoint of the project’s data residency (","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","isActive":true,"type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"with an ","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","isActive":true,"type":"reference"},{"text":", and splits each batch to Amplitude’s limits","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":"): 10 events and 1 MB a request, which a project on any plan","type":"text"},{"text":" ","type":"text"},{"text":"accepts. A batch with no record the encoder can write, an empty one included, makes no request. It","type":"text"},{"text":" ","type":"text"},{"text":"retries no response, a 5xx, 408 and 429, and drops and reports any other status. The API key goes","type":"text"},{"text":" ","type":"text"},{"text":"in the body, so no header field is needed, and no trace context is sent. ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" ","type":"text"},{"text":"leaves this module out; import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The region has no default. A project’s data resides in Amplitude’s default data center or its EU"},{"type":"text","text":" "},{"type":"text","text":"one, and an event posted to the other doesn’t reach it, so you pick the region on purpose. The"},{"type":"text","text":" "},{"type":"text","text":"factory throws "},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError","isActive":true},{"type":"text","text":" for an empty key, and for an Amplitude Experiment deployment"},{"type":"text","text":" "},{"type":"text","text":"key, which isn’t the project’s API key."}]},{"type":"paragraph","inlineContent":[{"text":"Each record becomes an event of an anonymous device. Its ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":" is the record’s session,","type":"text"},{"text":" ","type":"text"},{"text":"from the sessions enricher, and its ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":" that session’s start in Unix milliseconds; a","type":"text"},{"text":" ","type":"text"},{"text":"record with no session is sent under its own record identifier, with no ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":". No ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is sent. Its ","type":"text"},{"code":"insert_id","type":"codeVoice"},{"text":" is the record’s identifier, which a redelivered record keeps, and its","type":"text"},{"text":" ","type":"text"},{"code":"time","type":"codeVoice"},{"text":" the record’s timestamp in epoch milliseconds. The record’s vendor identifier and trace","type":"text"},{"text":" ","type":"text"},{"text":"context aren’t sent, nor is an ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":", and the standard context is sent as Amplitude’s own fields","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device_model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"language","type":"codeVoice"},{"text":", ","type":"text"},{"code":"platform","type":"codeVoice"},{"text":", ","type":"text"},{"code":"os_name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"os_version","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Amplitude counts a user per ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":" and bills by monthly tracked users, so each session counts","type":"text"},{"text":" ","type":"text"},{"text":"as one tracked user, and so does each record sent without a session.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is made with, into","type":"text"},{"text":" ","type":"text"},{"code":"event_properties","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is never sent, whatever the record reveals. A record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder can’t write is left out and the rest of the batch is sent: one the plan doesn’t describe,","type":"text"},{"text":" ","type":"text"},{"text":"one whose event name Amplitude keeps for its own (","type":"text"},{"code":"[Amplitude] …","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$identify","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$groupidentify","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one holding a value JSON can’t, one whose timestamp has no","type":"text"},{"text":" ","type":"text"},{"text":"epoch-milliseconds form, and one too large for a request. The destination reports each as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" whose reason is an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To send to PostHog, use ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":" instead.","type":"text"}]},{"syntax":"swift","code":["import AmplitudeEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: amplitude)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers what Amplitude receives, and why, in more detail.","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"role":"collection","modules":[{"name":"AmplitudeEncoding"}],"title":"AmplitudeEncoding","externalID":"AmplitudeEncoding","symbolKind":"module","roleHeading":"Framework"},"references":{"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder":{"role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeBatchEncoder","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"AmplitudeBatchEncoder","kind":"identifier"}],"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" of Amplitude’s HTTP V2 API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to an Amplitude project’s ","type":"text"},{"code":"POST \/2\/httpapi","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","title":"AmplitudeBatchEncoder"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeSetupError":{"abstract":[{"type":"text","text":"Why "},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"title":"AmplitudeSetupError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeSetupError"}],"url":"\/documentation\/amplitudeencoding\/amplitudesetuperror","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AmplitudeSetupError"}],"role":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"title":"Choosing Destinations","type":"link"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"role":"collection","type":"topic","kind":"symbol","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","url":"\/documentation\/httpdestinations","title":"HTTPDestinations"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"kind":"symbol","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","url":"\/documentation\/amplitudeencoding","title":"AmplitudeEncoding","abstract":[{"type":"text","text":"Send records to an Amplitude project through its HTTP V2 API."}],"role":"collection","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"kind":"symbol","fragments":[{"text":"protoc