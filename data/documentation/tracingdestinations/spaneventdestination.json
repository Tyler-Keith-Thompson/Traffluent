ribute names.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A record tracked outside any span, or whose span has ended by the time it is delivered, has no","type":"text"},{"text":" ","type":"text"},{"text":"span to join and is left out: span events can’t be added to a finished span. Batch tightly","type":"text"},{"text":" ","type":"text"},{"text":"enough for spans to outlive their batches, or deliver to another destination as well.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/TracingDestinations\/documentation\/TracingDestinations"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"},"topicSections":[{"identifiers":["doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination\/init(tracer:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination\/receive(_:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination\/Destination-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"sections":[],"metadata":{"externalID":"s:19TracingDestinations20SpanEventDestinationV","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SpanEventDestination"}],"title":"SpanEventDestination","roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"TracingDestinations"}],"remoteSource":{"fileName":"SpanEventDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TracingDestinations\/SpanEventDestination.swift#L16"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanEventDestination","kind":"identifier"}]},"references":{"doc://TracingDestinations/doc