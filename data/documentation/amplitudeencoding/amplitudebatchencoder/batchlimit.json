{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Amplitude’s limits on one request: 10 events and 1,000,000 bytes of body, an event’s"},{"type":"text","text":" "},{"type":"text","text":"included."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/amplitudeencoding\/amplitudebatchencoder\/batchlimit"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BatchLimit","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Amplitude takes up to 2,000 events in one request, but asks a project on its Free plan to","type":"text"},{"text":" ","type":"text"},{"text":"send no more than 10, so a request of 10 reaches a project on any plan. It asks every","type":"text"},{"text":" ","type":"text"},{"text":"request’s body to stay under 1 MB, and answers a larger one with 413. It documents no limit","type":"text"},{"text":" ","type":"text"},{"text":"on one event beyond what a request holds.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"]]},"identifier":{"url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","interfaceLanguage":"swift"},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AmplitudeEncoding\/AmplitudeBatchEncoder.swi