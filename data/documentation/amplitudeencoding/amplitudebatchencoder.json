"code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"event_properties"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s stored properties, by name"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"event_type","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"insert_id"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"session_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The session’s start in Unix milliseconds, the first 48 bits of its version 7 ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":"; left out for a record with no session, or a session key of another version","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"time"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in whole milliseconds since 1970"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":", and no ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":", ","type":"text"},{"code":"idfv","type":"codeVoice"},{"text":" or other","type":"text"},{"text":" ","type":"text"},{"text":"device identifier. Amplitude counts a user per ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":", so its unique users are sessions. A","type":"text"},{"text":" ","type":"text"},{"text":"record with no session (one tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":") is its own","type":"text"},{"text":" ","type":"text"},{"text":"anonymous user, linked to nothing: Amplitude rejects an event with neither a ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":" nor a","type":"text"},{"text":" ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":". Amplitude drops a second copy of an event with the same ","type":"text"},{"code":"insert_id","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A record a store recovers after a relaunch keeps its session, so it goes out with the","type":"text"},{"text":" ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":" of its first send, and Amplitude drops it if it had already stored","type":"text"},{"text":" ","type":"text"},{"text":"it before the app ended. The","type":"text"},{"text":" ","type":"text"},{"text":"record’s vendor identifier and trace context, and any other context value, aren’t sent. Nor is","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":": neither an address nor ","type":"text"},{"code":"$remote","type":"codeVoice"},{"text":", which asks Amplitude to look the user’s location up","type":"text"},{"text":" ","type":"text"},{"text":"from the request’s address.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Amplitude limits each string value to 1,024 characters; the encoder sends longer ones as they"},{"type":"text","text":" "},{"type":"text","text":"are."}]},{"type":"paragraph","inlineContent":[{"text":"Each event also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"app_version","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The version, left out when "},{"type":"codeVoice","code":"nil"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"device_model","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"language","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"LocaleKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"code":"en-US","type":"codeVoice"},{"text":", which Amplitude stores as the language’s name","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"platform"},{"text":", ","type":"text"},{"type":"codeVoice","code":"os_name"},{"text":", ","type":"text"},{"type":"codeVoice","code":"os_version"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The operating system’s name, its name again, and its version","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name Amplitude keeps"},{"type":"text","text":" "},{"type":"text","text":"for its own events, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one"},{"type":"text","text":" "},{"type":"text","text":"whose timestamp has no epoch-milliseconds form, and one too large for a request"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError"},{"type":"text","text":"). "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)"},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","i