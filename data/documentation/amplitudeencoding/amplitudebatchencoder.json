stract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"url":"\/documentation\/httpdestinations\/httpdestination","type":"topic","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeEncodingError":{"title":"AmplitudeEncodingError","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","role":"symbol","kind":"symbol","abstract":[{"text":"Why ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for the batch.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeEncodingError","kind":"identifier"}],"url":"\/documentation\/amplitudeencoding\/amplitudeencodingerror","type":"topic","navigatorTitle":[{"text":"AmplitudeEncodingError","kind":"identifier"}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder/Failure":{"navigatorTitle":[{"text":"Failure","kind":"identifier"}],"title":"AmplitudeBatchEncoder.Failure","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder\/failure","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/Failure","type":"topic","abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"role":"symbol"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder/batchLimit":{"title":"batchLimit","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Amplitude’s limits on one request: 10 events and 1,000,000 bytes of body, an event’s"},{"type":"text","text":" "},{"type":"text","text":"included."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder\/batchlimit","type":"topic"}}}