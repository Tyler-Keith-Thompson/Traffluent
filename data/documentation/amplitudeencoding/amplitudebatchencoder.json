{"abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" of Amplitude’s HTTP V2 API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to an Amplitude project’s ","type":"text"},{"code":"POST \/2\/httpapi","type":"codeVoice"},{"text":".","type":"text"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/AmplitudeEncoding\/s8SendableP","doc:\/\/AmplitudeEncoding\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeBatchEncoder","kind":"identifier"}]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"Make the destination with ","type":"text"},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and Amplitude’s limits:","type":"text"}],"type":"paragraph"},{"code":["let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .eu,  \/\/ or .us, where the project's data resides","    plan: plan)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":" with two members: "},{"code":"api_key","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"project’s API key, and "},{"code":"events","type":"codeVoice"},{"type":"text","text":", one object per record, oldest first, with these members:"}],"type":"paragraph"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"device_id"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"event_properties"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s stored properties, by name","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"event_type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"insert_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"session_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The session’s start in Unix milliseconds, the first 48 bits of its version 7 "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":"; left out for a record with no session, or a session key of another version"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"time"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in whole milliseconds since 1970"}],"type":"paragraph"}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", and no "},{"type":"codeVoice","code":"ip"},{"type":"text","text":", "},{"type":"codeVoice","code":"idfv"},{"type":"text","text":" or other"},{"type":"text","text":" "},{"type":"text","text":"device identifier. Amplitude counts a user per "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":", so its unique users are sessions. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store"},{"type":"text","text":" "},{"type":"text","text":"recovered after a relaunch, which keeps no context) is its own anonymous user, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing: Amplitude rejects an event with neither a "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":" nor a "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":". Amplitude drops"},{"type":"text","text":" "},{"type":"text","text":"a second copy of an event with the same "},{"type":"codeVoice","code":"insert_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":", so a recovered record that"},{"type":"text","text":" "},{"type":"text","text":"Amplitude had already stored under its session, before the app ended, is stored again. The"},{"type":"text","text":" "},{"type":"text","text":"record’s vendor identifier and trace context, and any other context value, aren’t sent. Nor is"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"ip"},{"type":"text","text":": neither an address nor "},{"type":"codeVoice","code":"$remote"},{"type":"text","text":", which asks Amplitude to look the user’s location up"},{"type":"text","text":" "},{"type":"text","text":"from the request’s address."}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Amplitude limits each string value to 1,024 characters; the encoder sends longer ones as they","type":"text"},{"text":" ","type":"text"},{"text":"are.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each event also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"app_version"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The version, left out when "},{"type":"codeVoice","code":"nil"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"device_model"}]}],[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"language"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"type":"codeVoice","code":"en-US"},{"text":", which Amplitude stores as the language’s name","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"platform","type":"codeVoice"},{"text":", ","type":"text"},{"code":"os_name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"os_version","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The operating system’s name, its name again, and its version"}]}]]],"header":"row"},{"inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event name Amplitude keeps","type":"text"},{"text":" ","type":"text"},{"text":"for its own events, one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds a value JSON can’t, one","type":"text"},{"text":" ","type":"text"},{"text":"whose timestamp has no epoch-milliseconds form, and one too large for a request","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","type":"reference","isActive":true},{"text":"). ","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" returns them as ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. Amplitude answers a request it takes with 200, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" retries"},{"type":"text","text":" "},{"type":"text","text":"one that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400 or"},{"type":"text","text":" "},{"type":"text","text":"413. A record sent again keeps its "},{"code":"insert_id","type":"codeVoice"},{"type":"text","text":". The bytes are the same for the same records on"},{"type":"text","text":" "},{"type":"text","text":"every run and platform: no whitespace, object members in the order of their names’ UTF-8"},{"type":"text","text":" "},{"type":"text","text":"bytes."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/amplitudeencoding\/amplitudebatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","interfaceLanguage":"swift"},"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/Amplitud