se timestamp has no epoch-milliseconds form, and one too large for a request","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","type":"reference"},{"text":"). ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","type":"reference"},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Amplitude answers a request it takes with 200, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" retries","type":"text"},{"text":" ","type":"text"},{"text":"one that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400 or","type":"text"},{"text":" ","type":"text"},{"text":"413. A record sent again keeps its ","type":"text"},{"type":"codeVoice","code":"insert_id"},{"text":". The bytes are the same for the same records on","type":"text"},{"text":" ","type":"text"},{"text":"every run and platform: no whitespace, object members in the order of their names’ UTF-8","type":"text"},{"text":" ","type":"text"},{"text":"bytes.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" of Amplitude’s HTTP V2 API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to an Amplitude project’s ","type":"text"},{"type":"codeVoice","code":"POST \/2\/httpapi"},{"text":".","type":"text"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"},"metadata":{"role":"symbol","roleHeading":"Structure","externalID":"s:17AmplitudeEncoding0A12BatchEncoderV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeBatchEncoder","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AmplitudeEncoding\/AmplitudeBatchEncoder.swift#L74","fileName":"AmplitudeBatchEncoder.swift"},"navigatorTitle":[{"text":"AmplitudeBatchEncoder","kind":"identifier"}],"title":"AmplitudeBatchEncoder","symbolKind":"struct","modules":[{"name":"AmplitudeEncoding"}]},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"url":"\/documentation\/httpdestinations\/httpdestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},