{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/amplitudeencoding\/amplitudebatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/init(apiKey:plan:limit:)"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)"]},{"generated":true,"anchor":"Type-Aliases","title":"Type Aliases","identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/Failure"]},{"generated":true,"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit"]}],"metadata":{"symbolKind":"struct","modules":[{"name":"AmplitudeEncoding"}],"roleHeading":"Structure","role":"symbol","navigatorTitle":[{"text":"AmplitudeBatchEncoder","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeBatchEncoder"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AmplitudeEncoding\/AmplitudeBatchEncoder.swift#L74","fileName":"AmplitudeBatchEncoder.swift"},"title":"AmplitudeBatchEncoder","externalID":"s:17AmplitudeEncoding0A12BatchEncoderV"},"hierarchy":{"paths":[["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"]]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/AmplitudeEncoding\/s8SendableP","doc:\/\/AmplitudeEncoding\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeBatchEncoder"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Make the destination with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and Amplitude’s limits:","type":"text"}]},{"type":"codeListing","code":["let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .eu,  \/\/ or .us, where the project's data resides","    plan: plan)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"type":"codeVoice","code":"application\/json"},{"text":" with two members: ","type":"text"},{"type":"codeVoice","code":"api_key"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"project’s API key, and ","type":"text"},{"type":"codeVoice","code":"events"},{"text":", one object per record, oldest first, with these members:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"device_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event_properties"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, by name"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event_type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"insert_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"session_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The session’s start in Unix milliseconds, the first 48 bits of its version 7 ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":"; left out for a record with no session, or a session key of another version","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"time"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in whole milliseconds since 1970"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"code":"user_id","type":"codeVoice"},{"type":"text","text":", and no "},{"code":"ip","type":"codeVoice"},{"type":"text","text":", "},{"code":"idfv","type":"codeVoice"},{"type":"text","text":" or other"},{"type":"text","text":" "},{"type":"text","text":"device identifier. Amplitude counts a user per "},{"code":"device_id","type":"codeVoice"},{"type":"text","text":", so its unique users are sessions. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":", or one a store"},{"type":"text","text":" "},{"type":"text","text":"recovered after a relaunch, which keeps no context) is its own anonymous user, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing: Amplitude rejects an event with neither a "},{"code":"device_id","type":"codeVoice"},{"type":"text","text":" nor a "},{"code":"user_id","type":"codeVoice"},{"type":"text","text":". Amplitude drops"},{"type":"text","text":" "},{"type":"text","text":"a second copy of an event with the same "},{"code":"insert_id","type":"codeVoice"},{"type":"text","text":" and "},{"code":"device_id","type":"codeVoice"},{"type":"text","text":", so a recovered record that"},{"type":"text","text":" "},{"type":"text","text":"Amplitude had already stored under its session, before the app ended, is stored again. The"},{"type":"text","text":" "},{"type":"text","text":"record’s vendor identifier and trace context, and any other context value, aren’t sent. Nor is"},{"type":"text","text":" "},{"type":"text","text":"an "},{"code":"ip","type":"codeVoice"},{"type":"text","text":": neither an address nor "},{"code":"$remote","type":"codeVoice"},{"type":"text","text":", which asks Amplitude to look the user’s location up"},{"type":"text","text":" "},{"type":"text","text":"from the request’s address."}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":", as ","type":"text"},{"type":"codeVoice","code":"PropertyReader"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Amplitude limits each string value to 1,024 characters; the encoder sends longer ones as they","type":"text"},{"text":" ","type":"text"},{"text":"are.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each event also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}]},{"rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"app_version","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The version, left out when "},{"type":"codeVoice","code":"nil"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"device_model","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The model","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"language"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"code":"en-US","type":"codeVoice"},{"text":", which Amplitude stores as the language’s name","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"platform","type":"codeVoice"},{"type":"text","text":", "},{"code":"os_name","type":"codeVoice"},{"type":"text","text":", "},{"code":"os_version","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The operating system’s name, its name again, and its version"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event name Amplitude keeps","type":"text"},{"text":" ","type":"text"},{"text":"for its own events, one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds a value JSON can’t, one","type":"text"},{"text":" ","type":"text"},{"text":"whose timestamp has no epoch-milliseconds form, and one too large for a request","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","isActive":true},{"text":"). ","type":"text"},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","isActive":true},{"text":" returns them as ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. Amplitude answers a request it takes with 200, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries"},{"type":"text","text":" "},{"type":"text","text":"one that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400 or"},{"type":"text","text":" "},{"type":"text","text":"413. A record sent again keeps its "},{"type":"codeVoice","code":"insert_id"},{"type":"text","text":". The bytes are the same for the same records on"},{"type":"text","text":" "},{"type":"text","text":"every run and platform: no whitespace, object members in the order of their names’ UTF-8"},{"type":"text","text":" "},{"type":"text","text":"bytes."}]}]}],"sections":[],"identifier":{"url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","interfaceLanguage":"swift"},"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" of Amplitude’s HTTP V2 API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to an Amplitude project’s ","type":"text"},{"code":"POST \/2\/httpapi","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"text":" sends.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","role":"symbol","title":"Batch