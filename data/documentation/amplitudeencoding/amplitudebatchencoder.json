":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"TransientStatus","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV"},{"text":">","kind":"text"}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder":{"abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Amplitude’s HTTP V2 API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to an Amplitude project’s "},{"type":"codeVoice","code":"POST \/2\/httpapi"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeBatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"AmplitudeBatchEncoder"}],"role":"symbol","url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder","kind":"symbol","type":"topic","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","title":"AmplitudeBatchEncoder"}}}