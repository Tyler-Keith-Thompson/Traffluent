{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"]]},"topicSections":[{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/init(apiKey:plan:limit:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/Failure"],"title":"Type Aliases","generated":true,"anchor":"Type-Aliases"},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/AmplitudeEncoding\/s8SendableP","doc:\/\/AmplitudeEncoding\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeBatchEncoder"}]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with "},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and Amplitude’s limits:"}]},{"type":"codeListing","syntax":"swift","code":["let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .eu,  \/\/ or .us, where the project's data resides","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":" with two members: "},{"type":"codeVoice","code":"api_key"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"project’s API key, and "},{"type":"codeVoice","code":"events"},{"type":"text","text":", one object per record, oldest first, with these members:"}]},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"device_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"event_properties"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s stored properties, by name"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"event_type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"insert_id"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"session_id"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The session’s start in Unix milliseconds, the first 48 bits of its version 7 ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":"; left out for a record with no session, or a session key of another version","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"time"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in whole milliseconds since 1970"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"type":"codeVoice","code":"user_id"},{"text":", and no ","type":"text"},{"type":"codeVoice","code":"ip"},{"text":", ","type":"text"},{"type":"codeVoice","code":"idfv"},{"text":" or other","type":"text"},{"text":" ","type":"text"},{"text":"device identifier. Amplitude counts a user per ","type":"text"},{"type":"codeVoice","code":"device_id"},{"text":", so its unique users are sessions. A","type":"text"},{"text":" ","type":"text"},{"text":"record with no session (one tracked by a tracker without ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":", or one a store","type":"text"},{"text":" ","type":"text"},{"text":"recovered after a relaunch, which keeps no context) is its own anonymous user, linked to","type":"text"},{"text":" ","type":"text"},{"text":"nothing: Amplitude rejects an event with neither a ","type":"text"},{"type":"codeVoice","code":"device_id"},{"text":" nor a ","type":"text"},{"type":"codeVoice","code":"user_id"},{"text":". Amplitude drops","type":"text"},{"text":" ","type":"text"},{"text":"a second copy of an event with the same ","type":"text"},{"type":"codeVoice","code":"insert_id"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"device_id"},{"text":", so a recovered record that","type":"text"},{"text":" ","type":"text"},{"text":"Amplitude had already stored under its session, before the app ended, is stored again. The","type":"text"},{"text":" ","type":"text"},{"text":"record’s vendor identifier and trace context, and any other context value, aren’t sent. Nor is","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"ip"},{"text":": neither an address nor ","type":"text"},{"type":"codeVoice","code":"$remote"},{"text":", which asks Amplitude to look the user’s location up","type":"text"},{"text":" ","type":"text"},{"text":"from the request’s address.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Amplitude limits each string value to 1,024 characters; the encoder sends longer ones as they","type":"text"},{"text":" ","type":"text"},{"text":"are.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event also holds these members, for each of the keys the record’s context has a value"},{"type":"text","text":" "},{"type":"text","text":"for:"}]},{"header":"row","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"app_version"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The version, left out when "},{"type":"codeVoice","code":"nil"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"device_model"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The model"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"language"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"type":"codeVoice","code":"en-US"},{"type":"text","text":", which Amplitude stores as the language’s name"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"platform"},{"type":"text","text":", "},{"type":"codeVoice","code":"os_name"},{"type":"text","text":", "},{"type":"codeVoice","code":"os_version"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The operating system’s name, its name again, and its version","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event name Amplitude keeps","type":"text"},{"text":" ","type":"text"},{"text":"for its own events, one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds a value JSON can’t, one","type":"text"},{"text":" ","type":"text"},{"text":"whose timestamp has no epoch-milliseconds form, and one too large for a request","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","isActive":true},{"text":"). ","type":"text"},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","isActive":true},{"text":" returns them as ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. Amplitude answers a request it takes with 200, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries"},{"type":"text","text":" "},{"type":"text","text":"one that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400 or"},{"type":"text","text":" "},{"type":"text","text":"413. A record sent again keeps its "},{"type":"codeVoice","code":"insert_id"},{"type":"text","text":". The bytes are the same for the same records on"},{"type":"text","text":" "},{"type":"text","text":"every run and platform: no whitespace, object members in the order of their names’ UTF-8"},{"type":"text","text":" "},{"type":"text","text":"bytes."}]}]}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeBatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"AmplitudeBatchEncoder"}],"roleHeading":"Structure","symbolKind":"struct","title":"AmplitudeBatchEncoder","remoteSource":{"fileName":"AmplitudeBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AmplitudeEncoding\/AmplitudeBatchEncoder.swift#L74"},"role":"symbol","externalID":"s:17AmplitudeEncoding0A12BatchEncoderV","modules":[{"name":"AmplitudeEncoding"}]},"variants":[{"paths":["\/documentation\/amplitudeencoding\/amplitudebatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Amplitude’s HTTP V2 API, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to an Amplitude project’s "},{"code":"POST \/2\/httpapi","type":"codeVoice"},{"type":"text","text":"."}],"references":{"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeBatchEncoder"}],"abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Amplitude’s HTTP V2 API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send even