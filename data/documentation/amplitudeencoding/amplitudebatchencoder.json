{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"},"hierarchy":{"paths":[["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"]]},"abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Amplitude’s HTTP V2 API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to an Amplitude project’s "},{"type":"codeVoice","code":"POST \/2\/httpapi"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeBatchEncoder","kind":"identifier"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Make the destination with ","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and Amplitude’s limits:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .eu,  \/\/ or .us, where the project's data resides","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with two members: ","type":"text"},{"code":"api_key","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"project’s API key, and ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", one object per record, oldest first, with these members:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"device_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event_properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, by name"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event_type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"insert_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"session_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The session’s start in Unix milliseconds, the first 48 bits of its version 7 "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":"; left out for a record with no session, or a session key of another version"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"time","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in whole milliseconds since 1970","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":", and no ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":", ","type":"text"},{"code":"idfv","type":"codeVoice"},{"text":" or other","type":"text"},{"text":" ","type":"text"},{"text":"device identifier. Amplitude counts a user per ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":", so its unique users are sessions. A","type":"text"},{"text":" ","type":"text"},{"text":"record with no session (one tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":") is its own","type":"text"},{"text":" ","type":"text"},{"text":"anonymous user, linked to nothing: Amplitude rejects an event with neither a ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":" nor a","type":"text"},{"text":" ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":". Amplitude drops a second copy of an event with the same ","type":"text"},{"code":"insert_id","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A record a store recovers after a relaunch keeps its session, so it goes out with the","type":"text"},{"text":" ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":" of its first send, and Amplitude drops it if it had already stored","type":"text"},{"text":" ","type":"text"},{"text":"it before the app ended. The","type":"text"},{"text":" ","type":"text"},{"text":"record’s vendor identifier and trace context, and any other context value, aren’t sent. Nor is","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":": neither an address nor ","type":"text"},{"code":"$remote","type":"codeVoice"},{"text":", which asks Amplitude to look the user’s location up","type":"text"},{"text":" ","type":"text"},{"text":"from the request’s address.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Amplitude limits each string value to 1,024 characters; the encoder sends longer ones as they","type":"text"},{"text":" ","type":"text"},{"text":"are.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each event also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"app_version"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The version, left out when ","type":"text"},{"code":"nil","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"device_model"}]}],[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The model","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"language","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"type":"codeVoice","code":"en-US"},{"type":"text","text":", which Amplitude stores as the language’s name"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"platform","type":"codeVoice"},{"text":", ","type":"text"},{"code":"os_name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"os_version","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The operating system’s name, its name again, and its version"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name Amplitude keeps"},{"type":"text","text":" "},{"type":"text","text":"for its own events, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one"},{"type":"text","text":" "},{"type":"text","text":"whose timestamp has no epoch-milliseconds form, and one too large for a request"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","type":"reference","isActive":true},{"type":"text","text":"). "},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Amplitude answers a request it takes with 200, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries","type":"text"},{"text":" ","type":"text"},{"text":"one that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400 or","type":"text"},{"text":" ","type":"text"},{"text":"413. A record sent again keeps its ","type":"text"},{"code":"insert_id","type":"codeVoice"},{"text":". The bytes are the same for the same records on","type":"text"},{"text":" ","type":"text"},{"text":"every run and platform: no whitespace, object members in the order of their names’ UTF-8","type":"text"},{"text":" ","type":"text"},{"text":"bytes.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/amplitudeencoding\/amplitudebatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"struct","roleHeading":"Structure","remoteSource":{"fileName":"AmplitudeBatchEncoder.swift"