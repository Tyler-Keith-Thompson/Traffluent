lan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"AmplitudeSetupError","preciseIdentifier":"s:17AmplitudeEncoding0A10SetupErrorO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"URLSessionTransport","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AmplitudeBatchEncoder","preciseIdentifier":"s:17AmplitudeEncoding0A12BatchEncoderV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"A destination that sends batches to the Amplitude project of ","type":"text"},{"code":"apiKey","type":"codeVoice"},{"text":", whose data resides in","type":"text"},{"text":" ","type":"text"},{"code":"region","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"URLSession.shared","type":"codeVoice"},{"text":", retrying a send that fails for now with the waits of","type":"text"},{"text":" ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","title":"amplitude(apiKey:region:plan:backoff:clock:)","url":"\/documentation\/amplitudeencoding\/http