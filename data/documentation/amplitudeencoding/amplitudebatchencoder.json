{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeBatchEncoder","kind":"identifier"}]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Make the destination with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and Amplitude’s limits:","type":"text"}]},{"code":["let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .eu,  \/\/ or .us, where the project's data resides","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with two members: ","type":"text"},{"code":"api_key","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"project’s API key, and ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", one object per record, oldest first, with these members:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"device_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event_properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event_type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"insert_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"session_id"}]}],[{"type":"paragraph","inlineContent":[{"text":"The session’s start in Unix milliseconds, the first 48 bits of its version 7 ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":"; left out for a record with no session, or a session key of another version","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"time"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in whole milliseconds since 1970","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", and no "},{"type":"codeVoice","code":"ip"},{"type":"text","text":", "},{"type":"codeVoice","code":"idfv"},{"type":"text","text":" or other"},{"type":"text","text":" "},{"type":"text","text":"device identifier. Amplitude counts a user per "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":", so its unique users are sessions. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store"},{"type":"text","text":" "},{"type":"text","text":"recovered after a relaunch, which keeps no context) is its own anonymous user, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing: Amplitude rejects an event with neither a "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":" nor a "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":". Amplitude drops"},{"type":"text","text":" "},{"type":"text","text":"a second copy of an event with the same "},{"type":"codeVoice","code":"insert_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":", so a recovered record that"},{"type":"text","text":" "},{"type":"text","text":"Amplitude had already stored under its session, before the app ended, is stored again. The"},{"type":"text","text":" "},{"type":"text","text":"record’s vendor identifier and trace context, and any other context value, aren’t sent. Nor is"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"ip"},{"type":"text","text":": neither an address nor "},{"type":"codeVoice","code":"$remote"},{"type":"text","text":", which asks Amplitude to look the user’s location up"},{"type":"text","text":" "},{"type":"text","text":"from the request’s address."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Amplitude limits each string value to 1,024 characters; the encoder sends longer ones as they"},{"type":"text","text":" "},{"type":"text","text":"are."}]},{"type":"paragraph","inlineContent":[{"text":"Each event also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"app_version","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The version, left out when "},{"type":"codeVoice","code":"nil"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"device_model","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The model"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"language","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"type":"codeVoice","code":"en-US"},{"type":"text","text":", which Amplitude stores as the language’s name"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"platform","type":"codeVoice"},{"type":"text","text":", "},{"code":"os_name","type":"codeVoice"},{"type":"text","text":", "},{"code":"os_version","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The operating system’s name, its name again, and its version","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name Amplitude keeps","type":"text"},{"text":" ","type":"text"},{"text":"for its own events, one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one","type":"text"},{"text":" ","type":"text"},{"text":"whose timestamp has no epoch-milliseconds form, and one too large for a request","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","type":"reference"},{"text":"). ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","type":"reference"},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Amplitude answers a request it takes with 200, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries","type":"text"},{"text":" ","type":"text"},{"text":"one that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400 or","type":"text"},{"text":" ","type":"text"},{"text":"413. A record sent again keeps its ","type":"text"},{"code":"insert_id","type":"codeVoice"},{"text":". The bytes are the same for the same records on","type":"text"},{"text":" ","type":"text"},{"text":"every run and platform: no whitespace, object members in the order of their names’ UTF-8","type":"text"},{"text":" ","type":"text"},{"text":"bytes.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"]]},"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/AmplitudeEncoding\/s8SendableP","doc:\/\/AmplitudeEncoding\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"sections":[],"abstract":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of Amplitude’s HTTP V2 API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to an Amplitude project’s ","type":"text"},{"type":"codeVoice","code":"POST \/2\/httpapi"},{"text":".","type":"text"}],"metadata":{"externalID":"s:17AmplitudeEncoding0A12BatchEncoderV","symbolKind":"struct","modules":[{"name":"AmplitudeEncoding"}],"remoteSo