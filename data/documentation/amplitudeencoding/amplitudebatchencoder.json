{"sections":[],"hierarchy":{"paths":[["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/init(apiKey:plan:limit:)"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)"]},{"anchor":"Type-Aliases","generated":true,"title":"Type Aliases","identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/Failure"]},{"anchor":"Type-Properties","generated":true,"title":"Type Properties","identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit"]}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/AmplitudeEncoding\/s8SendableP","doc:\/\/AmplitudeEncoding\/s16SendableMetatypeP"]}],"variants":[{"paths":["\/documentation\/amplitudeencoding\/amplitudebatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeBatchEncoder","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Make the destination with "},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and Amplitude’s limits:"}],"type":"paragraph"},{"code":["let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .eu,  \/\/ or .us, where the project's data resides","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":" with two members: "},{"code":"api_key","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"project’s API key, and "},{"code":"events","type":"codeVoice"},{"type":"text","text":", one object per record, oldest first, with these members:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"device_id"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event_properties"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event_type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"insert_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"session_id"}]}],[{"type":"paragraph","inlineContent":[{"text":"The session’s start in Unix milliseconds, the first 48 bits of its version 7 ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":"; left out for a record with no session, or a session key of another version","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"time","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in whole milliseconds since 1970"}]}]]]},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", and no "},{"type":"codeVoice","code":"ip"},{"type":"text","text":", "},{"type":"codeVoice","code":"idfv"},{"type":"text","text":" or other"},{"type":"text","text":" "},{"type":"text","text":"device identifier. Amplitude counts a user per "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":", so its unique users are sessions. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store"},{"type":"text","text":" "},{"type":"text","text":"recovered after a relaunch, which keeps no context) is its own anonymous user, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing: Amplitude rejects an event with neither a "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":" nor a "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":". Amplitude drops"},{"type":"text","text":" "},{"type":"text","text":"a second copy of an event with the same "},{"type":"codeVoice","code":"insert_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":", so a recovered record that"},{"type":"text","text":" "},{"type":"text","text":"Amplitude had already stored under its session, before the app ended, is stored again. The"},{"type":"text","text":" "},{"type":"text","text":"record’s vendor identifier and trace context, and any other context value, aren’t sent. Nor is"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"ip"},{"type":"text","text":": neither an address nor "},{"type":"codeVoice","code":"$remote"},{"type":"text","text":", which asks Amplitude to look the user’s location up"},{"type":"text","text":" "},{"type":"text","text":"from the request’s address."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Amplitude limits each string value to 1,024 characters; the encoder sends longer ones as they"},{"type":"text","text":" "},{"type":"text","text":"are."}],"type":"paragraph"},{"inlineContent":[{"text":"Each event also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineCo