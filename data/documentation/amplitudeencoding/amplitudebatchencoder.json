throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:17AmplitudeEncoding0A10SetupErrorO","text":"AmplitudeSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:17AmplitudeEncoding0A12BatchEncoderV","text":"AmplitudeBatchEncoder"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"A destination that sends batches to the Amplitude project of "},{"type":"codeVoice","code":"apiKey"},{"type":"text","text":", whose data resides in"},{"type":"text","text":" "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"URLSessionTransport"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Encoding"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"AmplitudeBatchEncoder"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"url":"\/documentation\/amplitudeencoding\/httpdestinations\/httpdestination\/amplitude(apikey:region:plan:backoff:clock:)","kind":"symbol","type":"topic","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","role":"symbol","title":"amplitude(apiKey:region:pl