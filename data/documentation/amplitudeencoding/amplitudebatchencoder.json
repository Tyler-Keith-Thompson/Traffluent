"text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Amplitude limits each string value to 1,024 characters; the encoder sends longer ones as they"},{"type":"text","text":" "},{"type":"text","text":"are."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each event also holds these members, for each of the keys the record’s context has a value"},{"type":"text","text":" "},{"type":"text","text":"for:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"app_version","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The version, left out when "},{"code":"nil","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"device_model"}]}],[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"language"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"code":"en-US","type":"codeVoice"},{"type":"text","text":", which 