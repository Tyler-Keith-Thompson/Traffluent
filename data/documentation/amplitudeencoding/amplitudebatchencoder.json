oding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder/Failure":{"role":"symbol","type":"topic","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/Failure","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"title":"AmplitudeBatchEncoder.Failure","kind":"symbol","url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder\/failure"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeEncodingError":{"title":"AmplitudeEncodingError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeEncodingError"}],"navigatorTitle":[{"kind":"identifier","text":"AmplitudeEncodingError"}],"role":"symbol","url":"\/documentation\/amplitudeencoding\/amplitudeencodingerror","kind":"symbol","type":"topic","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","abstract":[{"type":"text","text":"Why "},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","type":"reference","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"title":"AmplitudeEncoding","type":"topic","kind":"symbol","role":"collection","url":"\/d