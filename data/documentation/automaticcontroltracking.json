{"variants":[{"paths":["\/documentation\/automaticcontroltracking"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"AutomaticControlTracking","modules":[{"name":"AutomaticControlTracking"}],"role":"collection","title":"AutomaticControlTracking","symbolKind":"module","roleHeading":"Framework"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Use this module when an app’s UIKit controls should track their own activations, such as a button","type":"text"},{"text":" ","type":"text"},{"text":"tapped or a switch flipped. The discovery runs on iOS, iPadOS, tvOS, visionOS and Mac","type":"text"},{"text":" ","type":"text"},{"text":"Catalyst, through a ","type":"text"},{"code":"UIWindowScene","type":"codeVoice"},{"text":". ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","type":"reference"},{"text":", the event it tracks, builds on every","type":"text"},{"text":" ","type":"text"},{"text":"platform, so a tracking plan or a server can name it. SwiftUI’s controls are never tracked","type":"text"},{"text":" ","type":"text"},{"text":"automatically: give them ","type":"text"},{"code":"trackOnTap(_:)","type":"codeVoice"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"macOS has no equivalent; give an ","type":"text"},{"code":"NSControl","type":"codeVoice"},{"text":" ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing is tracked until a window scene turns it on with "},{"type":"codeVoice","code":"trackControlsAutomatically"},{"type":"text","text":". Each"},{"type":"text","text":" "},{"type":"text","text":"control is named after its "},{"type":"codeVoice","code":"accessibilityIdentifier"},{"type":"text","text":", never its title or other text, which may be"},{"type":"text","text":" "},{"type":"text","text":"a person’s data, and carries its kind, the first public UIKit class it is ("},{"type":"codeVoice","code":"\"UIButton\""},{"type":"text","text":"). By"},{"type":"text","text":" "},{"type":"text","text":"default a control without an identifier is skipped:"}]},{"type":"codeListing","code":["import UIKit","","final class CartViewController: UIViewController {","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        checkOut.accessibilityIdentifier = \"checkout-button\"  \/\/ tracked as ControlActivated(control: \"checkout-button\", kind: \"UIButton\")","        view.addSubview(checkOut)","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackControlsAutomatically()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give "},{"type":"codeVoice","code":"trackControlsAutomatically"},{"type":"text","text":" a closure to rename a control or skip it: it gets each"},{"type":"text","text":" "},{"type":"codeVoice","code":"DiscoveredControl"},{"type":"text","text":", with its identifier, kind and screen, and returns the event, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Each"},{"type":"text","text":" "},{"type":"text","text":"record’s context carries the control’s screen, the type of the view controller it is in, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":", unless the tracker’s enrichers set one."}]},{"type":"paragraph","inlineContent":[{"text":"A touch that ends off the control tracks nothing, and neither do activations","type":"text"},{"text":" ","type":"text"},{"text":"without a touch, such as VoiceOver’s, or actions the app sends itself with ","type":"text"},{"code":"sendActions(for:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"except to a control the last touch was on and didn’t activate. Each activation goes","type":"text"},{"text":" ","type":"text"},{"text":"through the tracker the control’s traits hold, so each scene keeps its own. The scene adds a","type":"text"},{"text":" ","type":"text"},{"text":"gesture recognizer to each of its windows that never recognizes, so it holds up no touch, and","type":"text"},{"text":" ","type":"text"},{"text":"swizzles nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This documentation is built on macOS, so "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"stopTrackingControlsAutomatically()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"DiscoveredControl"},{"type":"text","text":", have no pages here; their doc"},{"type":"text","text":" "},{"type":"text","text":"comments are in the sources."}]},{"type":"paragraph","inlineContent":[{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"also covers screen views and the app’s lifecycle.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"topicSections":[{"title":"The event","identifiers":["doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"],"anchor":"The-event"}],"kind":"symbol","references":{"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated/control":{"kind":"symbol","title":"control","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","role":"symbol","url":"\/documentation\/automaticcontroltracking\/controlactivated\/control","abstract":[{"type":"text","text":"The activated control’s name: its accessibility identifier, unless the predicate given to"},{"type":"text","text":" "},{"code":"trackControlsAutomatically(_:)","type":"codeVoice"},{"type":"text","text":" named it otherwise."}],"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"control","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/automatictracking":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking","titleInlineContent":[{"type":"text","text":"Automatic Tracking"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"link","title":"SwiftUITracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","titleInlineContent":[{"type":"codeVoice","code":"SwiftUITracking"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","title":"AppKitTracking","titleInlineContent":[{"type":"codeVoice","code":"AppKitTracking"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated":{"role":"symbol","navigatorTitle":[{"text":"ControlActivated","kind":"identifier"}],"title":"ControlActivated","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ControlActivated","kind":"identifier"}],"url":"\/documentation\/automaticcontroltracking\/controlactivated","abstract":[{"type":"text","text":"Someone activated the control named "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control"},{"type":"text","text":", such as by tapping a button or flipping a"},{"type":"text","text":" "},{"type":"text","text":"switch: what "},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"type":"text","text":" tracks for each activation it discovers."}],"kind":"symbol"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"kind":"symbol","title":"AutomaticControlTracking","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","role":"collection","url":"\/documentation\/automaticcontroltracking","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}],"type":"topic"}}}