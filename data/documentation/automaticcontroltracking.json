{"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use this module when an app’s UIKit controls should track their own activations, such as a button","type":"text"},{"text":" ","type":"text"},{"text":"tapped or a switch flipped. The discovery runs on iOS, iPadOS, tvOS, visionOS and Mac","type":"text"},{"text":" ","type":"text"},{"text":"Catalyst, through a ","type":"text"},{"type":"codeVoice","code":"UIWindowScene"},{"text":". ","type":"text"},{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","isActive":true,"type":"reference"},{"text":", the event it tracks, builds on every","type":"text"},{"text":" ","type":"text"},{"text":"platform, so a tracking plan or a server can name it. SwiftUI’s controls are never tracked","type":"text"},{"text":" ","type":"text"},{"text":"automatically: give them ","type":"text"},{"type":"codeVoice","code":"trackOnTap(_:)"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"macOS has no equivalent; give an ","type":"text"},{"type":"codeVoice","code":"NSControl"},{"text":" ","type":"text"},{"type":"codeVoice","code":"track(_:)"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing is tracked until a window scene turns it on with "},{"code":"trackControlsAutomatically","type":"codeVoice"},{"type":"text","text":". Each"},{"type":"text","text":" "},{"type":"text","text":"control is named after its "},{"code":"accessibilityIdentifier","type":"codeVoice"},{"type":"text","text":", never its title or other text, which may be"},{"type":"text","text":" "},{"type":"text","text":"a person’s data, and carries its kind, the first public UIKit class it is ("},{"code":"\"UIButton\"","type":"codeVoice"},{"type":"text","text":"). By"},{"type":"text","text":" "},{"type":"text","text":"default a control without an identifier is skipped:"}]},{"syntax":"swift","code":["import UIKit","","final class CartViewController: UIViewController {","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        checkOut.accessibilityIdentifier = \"checkout-button\"  \/\/ tracked as ControlActivated(control: \"checkout-button\", kind: \"UIButton\")","        view.addSubview(checkOut)","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackControlsAutomatically()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give "},{"type":"codeVoice","code":"trackControlsAutomatically"},{"type":"text","text":" a closure to rename a control or skip it: it gets each"},{"type":"text","text":" "},{"type":"codeVoice","code":"DiscoveredControl"},{"type":"text","text":", with its identifier, kind and screen, and returns the event, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Each"},{"type":"text","text":" "},{"type":"text","text":"record’s context carries the control’s screen, the type of the view controller it is in, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":", unless the tracker’s enrichers set one."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A touch that ends off the control tracks nothing, and neither do activations"},{"type":"text","text":" "},{"type":"text","text":"without a touch, such as VoiceOver’s, or actions the app sends itself with "},{"type":"codeVoice","code":"sendActions(for:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"except to a control the last touch was on and didn’t activate. Each activation goes"},{"type":"text","text":" "},{"type":"text","text":"through the tracker the control’s traits hold, so each scene keeps its own. The scene adds a"},{"type":"text","text":" "},{"type":"text","text":"gesture recognizer to each of its windows that never recognizes, so it holds up no touch, and"},{"type":"text","text":" "},{"type":"text","text":"swizzles nothing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This documentation is built on macOS, so "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"stopTrackingControlsAutomatically()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"DiscoveredControl"},{"type":"text","text":", have no pages here; their doc"},{"type":"text","text":" "},{"type":"text","text":"comments are in the sources."}]},{"type":"paragraph","inlineContent":[{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","isActive":true},{"text":" ","type":"text"},{"text":"also covers screen views and the app’s lifecycle.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[[]]},"metadata":{"role":"collection","externalID":"AutomaticControlTracking","modules":[{"name":"AutomaticControlTracking"}],"symbolKind":"module","title":"AutomaticControlTracking","roleHeading":"Framework"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/automaticcontroltracking"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking"},"abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"anchor":"The-event","identifiers":["doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"],"title":"The event"}],"references":{"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated":{"title":"ControlActivated","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ControlActivated"}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","abstract":[{"type":"text","text":"Someone activated the control named "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control"},{"type":"text","text":", such as by tapping a button or flipping a"},{"type":"text","text":" "},{"type":"text","text":"switch: what "},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"type":"text","text":" tracks for each activation it discovers."}],"url":"\/documentation\/automaticcontroltracking\/controlactivated","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ControlActivated"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/automatictracking":{"title":"Automatic Tracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","titleInlineContent":[{"type":"text","text":"Automatic Tracking"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"title":"AppKitTracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"link","titleInlineContent":[{"type":"codeVoice","code":"AppKitTracking"}]},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated/control":{"kind":"symbol","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","title":"control","url":"\/documentation\/automaticcontroltracking\/controlactivated\/control","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"control"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"abstract":[{"text":"The activated control’s name: its accessibility identifier, unless the predicate given to","type":"text"},{"text":" ","type":"text"},{"code":"trackControlsAutomatically(_:)","type":"codeVoice"},{"text":" named it otherwise.","type":"text"}],"role":"symbol"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"title":"AutomaticControlTracking","kind":"symbol","role":"collection","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","title":"SwiftUITracking","titleInlineContent":[{"code":"SwiftUITracking","type":"codeVoice"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"}}}