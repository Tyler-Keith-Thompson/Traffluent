{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/automaticcontroltracking"]}],"sections":[],"topicSections":[{"anchor":"The-event","title":"The event","identifiers":["doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"]}],"metadata":{"title":"AutomaticControlTracking","externalID":"AutomaticControlTracking","roleHeading":"Framework","role":"collection","symbolKind":"module","modules":[{"name":"AutomaticControlTracking"}]},"abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use this module when an app’s UIKit controls should track their own activations, such as a button","type":"text"},{"text":" ","type":"text"},{"text":"tapped or a switch flipped. The discovery runs on iOS, iPadOS, tvOS, visionOS and Mac","type":"text"},{"text":" ","type":"text"},{"text":"Catalyst, through a ","type":"text"},{"type":"codeVoice","code":"UIWindowScene"},{"text":". ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"},{"text":", the event it tracks, builds on every","type":"text"},{"text":" ","type":"text"},{"text":"platform, so a tracking plan or a server can name it. SwiftUI’s controls are never tracked","type":"text"},{"text":" ","type":"text"},{"text":"automatically: give them ","type":"text"},{"type":"codeVoice","code":"trackOnTap(_:)"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"macOS has no equivalent; give an ","type":"text"},{"type":"codeVoice","code":"NSControl"},{"text":" ","type":"text"},{"type":"codeVoice","code":"track(_:)"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing is tracked until a window scene turns it on with "},{"type":"codeVoice","code":"trackControlsAutomatically"},{"type":"text","text":". Each"},{"type":"text","text":" "},{"type":"text","text":"control is named after its "},{"type":"codeVoice","code":"accessibilityIdentifier"},{"type":"text","text":", never its title or other text, which may be"},{"type":"text","text":" "},{"type":"text","text":"a person’s data, and carries its kind, the first public UIKit class it is ("},{"type":"codeVoice","code":"\"UIButton\""},{"type":"text","text":"). By"},{"type":"text","text":" "},{"type":"text","text":"default a control without an identifier is skipped:"}]},{"type":"codeListing","code":["import UIKit","","final class CartViewController: UIViewController {","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        checkOut.accessibilityIdentifier = \"checkout-button\"  \/\/ tracked as ControlActivated(control: \"checkout-button\", kind: \"UIButton\")","        view.addSubview(checkOut)","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackControlsAutomatically()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Give ","type":"text"},{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":" a closure to rename a control or skip it: it gets each","type":"text"},{"text":" ","type":"text"},{"code":"DiscoveredControl","type":"codeVoice"},{"text":", with its identifier, kind and screen, and returns the event, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". Each","type":"text"},{"text":" ","type":"text"},{"text":"record’s context carries the control’s screen, the type of the view controller it is in, as","type":"text"},{"text":" ","type":"text"},{"code":"ScreenKey","type":"codeVoice"},{"text":", unless the tracker’s enrichers set one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A touch that ends off the control tracks nothing, and neither do activations","type":"text"},{"text":" ","type":"text"},{"text":"without a touch, such as VoiceOver’s, or actions the app sends itself with ","type":"text"},{"code":"sendActions(for:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"except to a control the last touch was on and didn’t activate. Each activation goes","type":"text"},{"text":" ","type":"text"},{"text":"through the tracker the control’s traits hold, so each scene keeps its own. The scene adds a","type":"text"},{"text":" ","type":"text"},{"text":"gesture recognizer to each of its windows that never recognizes, so it holds up no touch, and","type":"text"},{"text":" ","type":"text"},{"text":"swizzles nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This documentation is built on macOS, so ","type":"text"},{"code":"UIWindowScene","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"trackControlsAutomatically(_:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"stopTrackingControlsAutomatically()","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"DiscoveredControl","type":"codeVoice"},{"text":", have no pages here; their doc","type":"text"},{"text":" ","type":"text"},{"text":"comments are in the sources.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"also covers screen views and the app’s lifecycle."}]}],"kind":"content"}],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","titleInlineContent":[{"code":"AppKitTracking","type":"codeVoice"}],"title":"AppKitTracking"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated":{"url":"\/documentation\/automaticcontroltracking\/controlactivated","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ControlActivated","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"ControlActivated","kind":"identifier"}],"abstract":[{"text":"Someone activated the control named ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control"},{"text":", such as by tapping a button or flipping a","type":"text"},{"text":" ","type":"text"},{"text":"switch: what ","type":"text"},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"text":" tracks for each activation it discovers.","type":"text"}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","title":"ControlActivated","role":"symbol","type":"topic"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated/control":{"role":"symbol","abstract":[{"type":"text","text":"The activated control’s name: its accessibility identifier, unless the predicate given to"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"type":"text","text":" named it otherwise."}],"type":"topic","kind":"symbol","title":"control","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"control"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","url":"\/documentation\/automaticcontroltracking\/controlactivated\/control"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/automatictracking":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking","titleInlineContent":[{"type":"text","text":"Automatic Tracking"}]},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"role":"collection","type":"topic","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"title":"AutomaticControlTracking","kind":"symbol","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","titleInlineContent":[{"type":"codeVoice","code":"SwiftUITracking"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","title":"SwiftUITracking"}}}