":"link","title":"SwiftUITracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated/control":{"abstract":[{"type":"text","text":"The activated control’s name: its accessibility identifier, unless the predicate given to"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"type":"text","text":" named it otherwise."}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","role":"symbol","kind":"symbol","title":"control","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"control","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/automaticcontroltracking\/controlactivated\/control"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ControlActivated","kind":"identifier"}],"type":"topic","title":"ControlActivated","navigatorTitle":[{"text":"ControlActivated","kind":"identifier"}],"url":"\/documentation\/automaticcontroltracking\/controlactivated","abstract":[{"text":"Someone activated the control named ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","type":"reference"},{"text":", such as by tapping a button or flipping a","type":"text"},{"text":" ","type":"text"},{"text":"switch: what ","type":"text"},{"code":"trackControlsAutomatically(_:)","type":"codeVoice"},{"text":" tracks for each activation it discovers.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"}}}