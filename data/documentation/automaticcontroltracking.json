{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this module when an app’s UIKit controls should track their own activations, such as a button"},{"type":"text","text":" "},{"type":"text","text":"tapped or a switch flipped. The discovery runs on iOS, iPadOS, tvOS, visionOS and Mac"},{"type":"text","text":" "},{"type":"text","text":"Catalyst, through a "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":". "},{"type":"reference","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","isActive":true},{"type":"text","text":", the event it tracks, builds on every"},{"type":"text","text":" "},{"type":"text","text":"platform, so a tracking plan or a server can name it. SwiftUI’s controls are never tracked"},{"type":"text","text":" "},{"type":"text","text":"automatically: give them "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"macOS has no equivalent; give an "},{"type":"codeVoice","code":"NSControl"},{"type":"text","text":" "},{"type":"codeVoice","code":"track(_:)"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Nothing is tracked until a window scene turns it on with ","type":"text"},{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":". Each","type":"text"},{"text":" ","type":"text"},{"text":"control is named after its ","type":"text"},{"code":"accessibilityIdentifier","type":"codeVoice"},{"text":", never its title or other text, which may be","type":"text"},{"text":" ","type":"text"},{"text":"a person’s data, and carries its kind, the first public UIKit class it is (","type":"text"},{"code":"\"UIButton\"","type":"codeVoice"},{"text":"). By","type":"text"},{"text":" ","type":"text"},{"text":"default a control without an identifier is skipped:","type":"text"}]},{"code":["import UIKit","","final class CartViewController: UIViewController {","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        checkOut.accessibilityIdentifier = \"checkout-button\"  \/\/ tracked as ControlActivated(control: \"checkout-button\", kind: \"UIButton\")","        view.addSubview(checkOut)","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackControlsAutomatically()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Give ","type":"text"},{"type":"codeVoice","code":"trackControlsAutomatically"},{"text":" a closure to rename a control or skip it: it gets each","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DiscoveredControl"},{"text":", with its identifier, kind and screen, and returns the event, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". Each","type":"text"},{"text":" ","type":"text"},{"text":"record’s context carries the control’s screen, the type of the view controller it is in, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ScreenKey"},{"text":", unless the tracker’s enrichers set one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A touch that ends off the control tracks nothing, and neither do activations"},{"type":"text","text":" "},{"type":"text","text":"without a touch, such as VoiceOver’s, or actions the app sends itself with "},{"type":"codeVoice","code":"sendActions(for:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"except to a control the last touch was on and didn’t activate. Each activation goes"},{"type":"text","text":" "},{"type":"text","text":"through the tracker the control’s traits hold, so each scene keeps its own. The scene adds a"},{"type":"text","text":" "},{"type":"text","text":"gesture recognizer to each of its windows that never recognizes, so it holds up no touch, and"},{"type":"text","text":" "},{"type":"text","text":"swizzles nothing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This documentation is built on macOS, so "},{"code":"UIWindowScene","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"trackControlsAutomatically(_:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"stopTrackingControlsAutomatically()","type":"codeVoice"},{"type":"text","text":", and "},{"code":"DiscoveredControl","type":"codeVoice"},{"type":"text","text":", have no pages here; their doc"},{"type":"text","text":" "},{"type":"text","text":"comments are in the sources."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking"},{"type":"text","text":" "},{"type":"text","text":"also covers screen views and the app’s lifecycle."}]}]}],"abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"kind":"symbol","hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/automaticcontroltracking"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Framework","title":"AutomaticControlTracking","externalID":"AutomaticControlTracking","role":"collection","symbolKind":"module","modules":[{"name":"AutomaticControlTracking"}]},"topicSections":[{"identifiers":["doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"],"anchor":"The-event","title":"The event"}],"references":{"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated/control":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"control"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","url":"\/documentation\/automaticcontroltracking\/controlactivated\/control","abstract":[{"text":"The activated control’s name: its accessibility identifier, unless the predicate given to","type":"text"},{"text":" ","type":"text"},{"code":"trackControlsAutomatically(_:)","type":"codeVoice"},{"text":" named it otherwise.","type":"text"}],"title":"control","kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/automatictracking":{"titleInlineContent":[{"type":"text","text":"Automatic Tracking"}],"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"url":"\/documentation\/automaticcontroltracking","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"type":"topic","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","role":"collection","kind":"symbol","title":"AutomaticControlTracking"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated":{"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ControlActivated","kind":"identifier"}],"navigatorTitle":[{"text":"ControlActivated","kind":"identifier"}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","url":"\/documentation\/automaticcontroltracking\/controlactivated","abstract":[{"text":"Someone activated the control named ","type":"text"},{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","type":"reference","isActive":true},{"text":", such as by tapping a button or flipping a","type":"text"},{"text":" ","type":"text"},{"text":"switch: what ","type":"text"},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"text":" tracks for each activation it discovers.","type":"text"}],"title":"ControlActivated","kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","title":"SwiftUITracking","titleInlineContent":[{"code":"SwiftUITracking","type":"codeVoice"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"titleInlineContent":[{"type":"codeVoice","code":"AppKitTracking"}],"title":"AppKitTracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"}}}