{"topicSections":[{"title":"The event","identifiers":["doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"],"anchor":"The-event"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/automaticcontroltracking"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[[]]},"abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}],"sections":[],"metadata":{"role":"collection","title":"AutomaticControlTracking","modules":[{"name":"AutomaticControlTracking"}],"externalID":"AutomaticControlTracking","roleHeading":"Framework","symbolKind":"module"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this module when an app’s UIKit controls should track their own activations, such as a button"},{"type":"text","text":" "},{"type":"text","text":"tapped or a switch flipped. The discovery runs on iOS, iPadOS, tvOS, visionOS and Mac"},{"type":"text","text":" "},{"type":"text","text":"Catalyst, through a "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":". "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"},{"type":"text","text":", the event it tracks, builds on every"},{"type":"text","text":" "},{"type":"text","text":"platform, so a tracking plan or a server can name it. SwiftUI’s controls are never tracked"},{"type":"text","text":" "},{"type":"text","text":"automatically: give them "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"macOS has no equivalent; give an "},{"type":"codeVoice","code":"NSControl"},{"type":"text","text":" "},{"type":"codeVoice","code":"track(_:)"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Nothing is tracked until a window scene turns it on with ","type":"text"},{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":". Each","type":"text"},{"text":" ","type":"text"},{"text":"control is named after its ","type":"text"},{"code":"accessibilityIdentifier","type":"codeVoice"},{"text":", never its title or other text, which may be","type":"text"},{"text":" ","type":"text"},{"text":"a person’s data, and carries its kind, the first public UIKit class it is (","type":"text"},{"code":"\"UIButton\"","type":"codeVoice"},{"text":"). By","type":"text"},{"text":" ","type":"text"},{"text":"default a control without an identifier is skipped:","type":"text"}]},{"syntax":"swift","code":["import UIKit","","final class CartViewController: UIViewController {","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        checkOut.accessibilityIdentifier = \"checkout-button\"  \/\/ tracked as ControlActivated(control: \"checkout-button\", kind: \"UIButton\")","        view.addSubview(checkOut)","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackControlsAutomatically()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Give ","type":"text"},{"type":"codeVoice","code":"trackControlsAutomatically"},{"text":" a closure to rename a control or skip it: it gets each","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DiscoveredControl"},{"text":", with its identifier, kind and screen, and returns the event, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". Each","type":"text"},{"text":" ","type":"text"},{"text":"record’s context carries the control’s screen, the type of the view controller it is in, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ScreenKey"},{"text":", unless the tracker’s enrichers set one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A touch that ends off the control tracks nothing, and neither do activations"},{"type":"text","text":" "},{"type":"text","text":"without a touch, such as VoiceOver’s, or actions the app sends itself with "},{"type":"codeVoice","code":"sendActions(for:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"except to a control the last touch was on and didn’t activate. Each activation goes"},{"type":"text","text":" "},{"type":"text","text":"through the tracker the control’s traits hold, so each scene keeps its own. The scene adds a"},{"type":"text","text":" "},{"type":"text","text":"gesture recognizer to each of its windows that never recognizes, so it holds up no touch, and"},{"type":"text","text":" "},{"type":"text","text":"swizzles nothing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This documentation is built on macOS, so "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"stopTrackingControlsAutomatically()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"DiscoveredControl"},{"type":"text","text":", have no pages here; their doc"},{"type":"text","text":" "},{"type":"text","text":"comments are in the sources."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","isActive":true},{"type":"text","text":" "},{"type":"text","text":"also covers screen views and the app’s lifecycle."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking"},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"title":"AppKitTracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"link","titleInlineContent":[{"code":"AppKitTracking","type":"codeVoice"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/automatictracking":{"titleInlineContent":[{"text":"Automatic Tracking","type":"text"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking","type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"title":"SwiftUITracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","titleInlineContent":[{"type":"codeVoice","code":"SwiftUITracking"}],"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ControlActivated"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ControlActivated"}],"kind":"symbol","identifier":"doc:\/\/AutomaticControlTrackin