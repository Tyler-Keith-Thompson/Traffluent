{"metadata":{"role":"collection","title":"AutomaticControlTracking","modules":[{"name":"AutomaticControlTracking"}],"symbolKind":"module","roleHeading":"Framework","externalID":"AutomaticControlTracking"},"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"],"anchor":"The-event","title":"The event"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this module when an app’s UIKit controls should track their own activations, such as a button"},{"type":"text","text":" "},{"type":"text","text":"tapped or a switch flipped. The discovery runs on iOS, iPadOS, tvOS, visionOS and Mac"},{"type":"text","text":" "},{"type":"text","text":"Catalyst, through a "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":". "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"},{"type":"text","text":", the event it tracks, builds on every"},{"type":"text","text":" "},{"type":"text","text":"platform, so a tracking plan or a server can name it. SwiftUI’s controls are never tracked"},{"type":"text","text":" "},{"type":"text","text":"automatically: give them "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"macOS has no equivalent; give an "},{"type":"codeVoice","code":"NSControl"},{"type":"text","text":" "},{"type":"codeVoice","code":"track(_:)"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Nothing is tracked until a window scene turns it on with ","type":"text"},{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":". Each","type":"text"},{"text":" ","type":"text"},{"text":"control is named after its ","type":"text"},{"code":"accessibilityIdentifier","type":"codeVoice"},{"text":", never its title or other text, which may be","type":"text"},{"text":" ","type":"text"},{"text":"a person’s data, and carries its kind, the first public UIKit class it is (","type":"text"},{"code":"\"UIButton\"","type":"codeVoice"},{"text":"). By","type":"text"},{"text":" ","type":"text"},{"text":"default a control without an identifier is skipped:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import UIKit","","final class CartViewController: UIViewController {","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        checkOut.accessibilityIdentifier = \"checkout-button\"  \/\/ tracked as ControlActivated(control: \"checkout-button\", kind: \"UIButton\")","        view.addSubview(checkOut)","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackControlsAutomatically()"]},{"type":"paragraph","inlineContent":[{"text":"Give ","type":"text"},{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":" a closure to rename a control or skip it: it gets each","type":"text"},{"text":" ","type":"text"},{"code":"DiscoveredControl","type":"codeVoice"},{"text":", with its identifier, kind and screen, and returns the event, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". Each","type":"text"},{"text":" ","type":"text"},{"text":"record’s context carries the control’s screen, the type of the view controller it is in, as","type":"text"},{"text":" ","type":"text"},{"code":"ScreenKey","type":"codeVoice"},{"text":", unless the tracker’s enrichers set one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A touch that ends off the control tracks nothing, and neither do activations","type":"text"},{"text":" ","type":"text"},{"text":"without a touch, such as VoiceOver’s, or actions the app sends itself with ","type":"text"},{"code":"sendActions(for:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"except to a control the last touch was on and didn’t activate. Each activation goes","type":"text"},{"text":" ","type":"text"},{"text":"through the tracker the control’s traits hold, so each scene keeps its own. The scene adds a","type":"text"},{"text":" ","type":"text"},{"text":"gesture recognizer to each of its windows that never recognizes, so it holds up no touch, and","type":"text"},{"text":" ","type":"text"},{"text":"swizzles nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This documentation is built on macOS, so "},{"code":"UIWindowScene","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"trackControlsAutomatically(_:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"stopTrackingControlsAutomatically()","type":"codeVoice"},{"type":"text","text":", and "},{"code":"DiscoveredControl","type":"codeVoice"},{"type":"text","text":", have no pages here; their doc"},{"type":"text","text":" "},{"type":"text","text":"comments are in the sources."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","isActive":true},{"type":"text","text":" "},{"type":"text","text":"also covers screen views and the app’s lifecycle."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/automaticcontroltracking"]}],"identifier":{"url":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"sections":[],"kind":"symbol","references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/automatictracking":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking","titleInlineContent":[{"type":"text","text":"Automatic Tracking"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","titleInlineContent":[{"type":"codeVoice","code":"AppKitTracking"}],"title":"AppKitTracking"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"role":"collection","title":"AutomaticControlTracking","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"topic","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}],"url":"\/documentation\/automaticcontroltracking","kind":"symbol"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ControlActivated"}],"title":"ControlActivated","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","type":"topic","abstract":[{"text":"Someone activated the control named ","type":"text"},{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","isActive":true,"type":"reference"},{"text":", such as by tapping a button or flipping a","type":"text"},{"text":" ","type":"text"},{"text":"switch: what ","type":"text"},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"text":" tracks for each activation it discovers.","type":"text"}],"url":"\/documentation\/automaticcontroltracking\/controlactivated","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ControlActivated"}]},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated/control":{"url":"\/documentation\/automaticcontroltracking\/controlactivated\/control","type":"topic","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"control"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"title":"control","abstract":[{"text":"The activated control’s name: its accessibility identifier, unless the predicate given to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"text":" named it otherwise.","type":"text"}],"role":"symbol","kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","titleInlineContent":[{"type":"codeVoice","code":"SwiftUITracking"}],"title":"SwiftUITracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"}}}