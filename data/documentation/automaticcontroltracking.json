{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"Use this module when an app’s UIKit controls should track their own activations, such as a button","type":"text"},{"text":" ","type":"text"},{"text":"tapped or a switch flipped. The discovery runs on iOS, iPadOS, tvOS, visionOS and Mac","type":"text"},{"text":" ","type":"text"},{"text":"Catalyst, through a ","type":"text"},{"code":"UIWindowScene","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","isActive":true,"type":"reference"},{"text":", the event it tracks, builds on every","type":"text"},{"text":" ","type":"text"},{"text":"platform, so a tracking plan or a server can name it. SwiftUI’s controls are never tracked","type":"text"},{"text":" ","type":"text"},{"text":"automatically: give them ","type":"text"},{"code":"trackOnTap(_:)","type":"codeVoice"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"macOS has no equivalent; give an ","type":"text"},{"code":"NSControl","type":"codeVoice"},{"text":" ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Nothing is tracked until a window scene turns it on with "},{"type":"codeVoice","code":"trackControlsAutomatically"},{"type":"text","text":". Each"},{"type":"text","text":" "},{"type":"text","text":"control is named after its "},{"type":"codeVoice","code":"accessibilityIdentifier"},{"type":"text","text":", never its title or other text, which may be"},{"type":"text","text":" "},{"type":"text","text":"a person’s data, and carries its kind, the first public UIKit class it is ("},{"type":"codeVoice","code":"\"UIButton\""},{"type":"text","text":"). By"},{"type":"text","text":" "},{"type":"text","text":"default a control without an identifier is skipped:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import UIKit","","final class CartViewController: UIViewController {","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        checkOut.accessibilityIdentifier = \"checkout-button\"  \/\/ tracked as ControlActivated(control: \"checkout-button\", kind: \"UIButton\")","        view.addSubview(checkOut)","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackControlsAutomatically()"]},{"inlineContent":[{"text":"Give ","type":"text"},{"type":"codeVoice","code":"trackControlsAutomatically"},{"text":" a closure to rename a control or skip it: it gets each","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DiscoveredControl"},{"text":", with its identifier, kind and screen, and returns the event, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". Each","type":"text"},{"text":" ","type":"text"},{"text":"record’s context carries the control’s screen, the type of the view controller it is in, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ScreenKey"},{"text":", unless the tracker’s enrichers set one.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A touch that ends off the control tracks nothing, and neither do activations"},{"type":"text","text":" "},{"type":"text","text":"without a touch, such as VoiceOver’s, or actions the app sends itself with "},{"type":"codeVoice","code":"sendActions(for:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"except to a control the last touch was on and didn’t activate. Each activation goes"},{"type":"text","text":" "},{"type":"text","text":"through the tracker the control’s traits hold, so each scene keeps its own. The scene adds a"},{"type":"text","text":" "},{"type":"text","text":"gesture recognizer to each of its windows that never recognizes, so it holds up no touch, and"},{"type":"text","text":" "},{"type":"text","text":"swizzles nothing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This documentation is built on macOS, so "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"stopTrackingControlsAutomatically()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"DiscoveredControl"},{"type":"text","text":", have no pages here; their doc"},{"type":"text","text":" "},{"type":"text","text":"comments are in the sources."}],"type":"paragraph"},{"inlineContent":[{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking"},{"text":" ","type":"text"},{"text":"also covers screen views and the app’s lifecycle.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[[]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/automaticcontroltracking"]}],"metadata":{"externalID":"AutomaticControlTracking","symbolKind":"module","roleHeading":"Framework","role":"collection","title":"AutomaticControlTracking","modules":[{"name":"AutomaticControlTracking"}]},"topicSections":[{"identifiers":["doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"],"title":"The event","anchor":"The-event"}],"abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/automatictracking":{"title":"Automatic Tracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","titleInlineContent":[{"text":"Automatic Tracking","type":"text"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","title":"AppKitTracking","titleInlineContent":[{"code":"AppKitTracking","type":"codeVoice"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"title":"SwiftUITracking","titleInlineContent":[{"code":"SwiftUITracking","type":"codeVoice"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated/control":{"type":"topic","kind":"symbol","title":"control","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"control","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","url":"\/documentation\/automaticcontroltracking\/controlactivated\/control","abstract":[{"text":"The activated control’s name: its accessibility identifier, unless the predicate given to","type":"text"},{"text":" ","type":"text"},{"code":"trackControlsAutomatically(_:)","type":"codeVoice"},{"text":" named it otherwise.","type":"text"}]},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ControlActivated"}],"title":"ControlActivated","abstract":[{"text":"Someone activated the control named ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","type":"reference"},{"text":", such as by tapping a button or flipping a","type":"text"},{"text":" ","type":"text"},{"text":"switch: what ","type":"text"},{"code":"trackControlsAutomatically(_:)","type":"codeVoice"},{"text":" tracks for each activation it discovers.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"ControlActivated"}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","role":"symbol","url":"\/documentation\/automaticcontroltracking\/controlactivated"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"type":"topic","kind":"symbol","title":"AutomaticControlTracking","role":"collection","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}]}}}