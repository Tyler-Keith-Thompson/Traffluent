{"identifier":{"url":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","interfaceLanguage":"swift"},"sections":[],"metadata":{"modules":[{"name":"AutomaticControlTracking"}],"title":"AutomaticControlTracking","externalID":"AutomaticControlTracking","symbolKind":"module","roleHeading":"Framework","role":"collection"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Use this module when an app’s UIKit controls should track their own activations, such as a button","type":"text"},{"text":" ","type":"text"},{"text":"tapped or a switch flipped. The discovery runs on iOS, iPadOS, tvOS, visionOS and Mac","type":"text"},{"text":" ","type":"text"},{"text":"Catalyst, through a ","type":"text"},{"code":"UIWindowScene","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","isActive":true,"type":"reference"},{"text":", the event it tracks, builds on every","type":"text"},{"text":" ","type":"text"},{"text":"platform, so a tracking plan or a server can name it. SwiftUI’s controls are never tracked","type":"text"},{"text":" ","type":"text"},{"text":"automatically: give them ","type":"text"},{"code":"trackOnTap(_:)","type":"codeVoice"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"macOS has no equivalent; give an ","type":"text"},{"code":"NSControl","type":"codeVoice"},{"text":" ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Nothing is tracked until a window scene turns it on with ","type":"text"},{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":". Each","type":"text"},{"text":" ","type":"text"},{"text":"control is named after its ","type":"text"},{"code":"accessibilityIdentifier","type":"codeVoice"},{"text":", never its title or other text, which may be","type":"text"},{"text":" ","type":"text"},{"text":"a person’s data, and carries its kind, the first public UIKit class it is (","type":"text"},{"code":"\"UIButton\"","type":"codeVoice"},{"text":"). By","type":"text"},{"text":" ","type":"text"},{"text":"default a control without an identifier is skipped:","type":"text"}],"type":"paragraph"},{"code":["import UIKit","","final class CartViewController: UIViewController {","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        checkOut.accessibilityIdentifier = \"checkout-button\"  \/\/ tracked as ControlActivated(control: \"checkout-button\", kind: \"UIButton\")","        view.addSubview(checkOut)","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackControlsAutomatically()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Give "},{"code":"trackControlsAutomatically","type":"codeVoice"},{"type":"text","text":" a closure to rename a control or skip it: it gets each"},{"type":"text","text":" "},{"code":"DiscoveredControl","type":"codeVoice"},{"type":"text","text":", with its identifier, kind and screen, and returns the event, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". Each"},{"type":"text","text":" "},{"type":"text","text":"record’s context carries the control’s screen, the type of the view controller it is in, as"},{"type":"text","text":" "},{"code":"ScreenKey","type":"codeVoice"},{"type":"text","text":", unless the tracker’s enrichers set one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A touch that ends off the control tracks nothing, and neither do activations"},{"type":"text","text":" "},{"type":"text","text":"without a touch, such as VoiceOver’s, or actions the app sends itself with "},{"code":"sendActions(for:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"except to a control the last touch was on and didn’t activate. Each activation goes"},{"type":"text","text":" "},{"type":"text","text":"through the tracker the control’s traits hold, so each scene keeps its own. The scene adds a"},{"type":"text","text":" "},{"type":"text","text":"gesture recognizer to each of its windows that never recognizes, so it holds up no touch, and"},{"type":"text","text":" "},{"type":"text","text":"swizzles nothing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This documentation is built on macOS, so "},{"code":"UIWindowScene","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"trackControlsAutomatically(_:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"stopTrackingControlsAutomatically()","type":"codeVoice"},{"type":"text","text":", and "},{"code":"DiscoveredControl","type":"codeVoice"},{"type":"text","text":", have no pages here; their doc"},{"type":"text","text":" "},{"type":"text","text":"comments are in the sources."}],"type":"paragraph"},{"inlineContent":[{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"also covers screen views and the app’s lifecycle.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/automaticcontroltracking"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"topicSections":[{"title":"The event","anchor":"The-event","identifiers":["doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"]}],"kind":"symbol","references":{"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"role":"collection","url":"\/documentation\/automaticcontroltracking","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"topic","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}],"title":"AutomaticControlTracking","kind":"symbol"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated":{"url":"\/documentation\/automaticcontroltracking\/controlactivated","type":"topic","navigatorTitle":[{"text":"ControlActivated","kind":"identifier"}],"title":"ControlActivated","abstract":[{"text":"Someone activated the control named ","type":"text"},{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","isActive":true,"type":"reference"},{"text":", such as by tapping a button or flipping a","type":"text"},{"text":" ","type":"text"},{"text":"switch: what ","type":"text"},{"code":"trackControlsAutomatically(_:)","type":"codeVoice"},{"text":" tracks for each activation it discovers.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ControlActivated","kind":"identifier"}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"},"https://tyler-keith-thompson.github.