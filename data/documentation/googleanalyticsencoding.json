{"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/googleanalyticsencoding"]}],"metadata":{"modules":[{"name":"GoogleAnalyticsEncoding"}],"roleHeading":"Framework","role":"collection","title":"GoogleAnalyticsEncoding","externalID":"GoogleAnalyticsEncoding","symbolKind":"module"},"identifier":{"url":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:transport:backoff:clock:now:)","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError"],"title":"Sending to Google Analytics","anchor":"Sending-to-Google-Analytics"},{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError"],"title":"Records left out","anchor":"Records-left-out"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"makes an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"text":") for a Google Analytics 4 stream in one","type":"text"},{"text":" ","type":"text"},{"text":"call. It checks the measurement ID and the API secret, and posts to the Measurement Protocol’s","type":"text"},{"text":" ","type":"text"},{"code":"\/mp\/collect","type":"codeVoice"},{"text":" endpoint of the region (","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","type":"reference","isActive":true},{"text":") with a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","type":"reference","isActive":true},{"text":". It splits each batch to the Measurement Protocol’s limits","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":"): 25 events and 100 KB a request. A batch with no","type":"text"},{"text":" ","type":"text"},{"text":"record the encoder can write, an empty one included, makes no request. The destination retries no","type":"text"},{"text":" ","type":"text"},{"text":"response, a 5xx, 408 and 429, and drops and reports any other status. No trace context is sent.","type":"text"},{"text":" ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves this module out; import it on its own.","type":"text"}]},{"level":3,"text":"The API secret stays on a server","type":"heading","anchor":"The-API-secret-stays-on-a-server"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Measurement Protocol takes only requests that carry one of the stream’s API secrets, and"},{"type":"text","text":" "},{"type":"text","text":"anyone holding that secret can send events to the property. Google’s docs say not to expose it in"},{"type":"text","text":" "},{"type":"text","text":"an app, and an app’s binary can be read by anyone who installs it."}]},{"type":"paragraph","inlineContent":[{"text":"So the whole module is compiled for macOS and Linux alone, where a server runs. An app for iOS,","type":"text"},{"text":" ","type":"text"},{"text":"iPadOS, tvOS, watchOS, visionOS or Mac Catalyst that calls the factory, or names the encoder, fails","type":"text"},{"text":" ","type":"text"},{"text":"to compile. A Mac app, AppKit or SwiftUI, compiles the factory as a Mac server does, but the","type":"text"},{"text":" ","type":"text"},{"text":"factory refuses it at run time: it throws ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","type":"reference"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"process’s main bundle is an ","type":"text"},{"code":".app","type":"codeVoice"},{"text":" or an ","type":"text"},{"code":".appex","type":"codeVoice"},{"text":". Nothing stops a Mac app from building an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" with this encoder and an endpoint it writes itself, secret and all, so don’t.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The secret is also in the query of every request’s URL. Don’t log the destination, its requests or","type":"text"},{"text":" ","type":"text"},{"text":"a transport’s URLs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The factory throws "},{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError","type":"reference"},{"type":"text","text":" for an empty measurement ID, for one that isn’t"},{"type":"text","text":" "},{"code":"G-","type":"codeVoice"},{"type":"text","text":" followed by uppercase letters and digits, and for an empty API secret. The region has no"},{"type":"text","text":" "},{"type":"text","text":"default: "},{"code":".global","type":"codeVoice"},{"type":"text","text":" is Google’s default endpoint, and "},{"code":".eu","type":"codeVoice"},{"type":"text","text":" has Google collect the data in the EU."}]},{"level":3,"text":"Getting an app’s events to Google Analytics","type":"heading","anchor":"Getting-an-apps-events-to-Google-Analytics"},{"type":"paragraph","inlineContent":[{"text":"An app’s events reach Google Analytics through a server of yours: the app sends them there, and","type":"text"},{"text":" ","type":"text"},{"text":"the server makes this destination and hands it the records. Traffluent doesn’t provide that server","type":"text"},{"text":" ","type":"text"},{"text":"yet. TraffluentCollector receives an app’s batches, but it doesn’t forward them to Google","type":"text"},{"text":" ","type":"text"},{"text":"Analytics, and Traffluent has no decoder that turns a collector batch back into records.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Until it does, the server’s job is:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Read each event the app sent (its name, version, identifier, timestamp, properties and session)"},{"type":"text","text":" "},{"type":"text","text":"and decode it into the same "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" type the app tracked, from a module the app and the server"},{"type":"text","text":" "},{"type":"text","text":"share."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remake its "},{"type":"codeVoice","code":"EventRecord"},{"type":"text","text":" with "},{"type":"codeVoice","code":"EventRecord(id:event:timestamp:sourceLocation:context:)"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"app’s identifier and timestamp, and a context whose "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" is the app’s session."}]}]},{"content":[{"inlineContent":[{"text":"Hand each batch of records to the destination’s ","type":"text"},{"type":"codeVoice","code":"receive(_:)"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Don’t track the events again through a ","type":"text"},{"type":"codeVoice","code":"Tracker"},{"text":" with ","type":"text"},{"type":"codeVoice","code":".sessions()"},{"text":" on the server. That tracker","type":"text"},{"text":" ","type":"text"},{"text":"would give every event the server’s own session, so every user of the app would arrive in Google","type":"text"},{"text":" ","type":"text"},{"text":"Analytics as one ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A server that tracks its own events, rather than an app’s, uses a tracker as any app does:"}]},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","import GoogleAnalyticsEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let googleAnalytics = try HTTPDestination.googleAnalytics(","    measurementID: measurementID,  \/\/ the web or data stream's, G-…","    apiSecret: apiSecret,  \/\/ from the server's configuration, never an app's","    region: .global,  \/\/ or .eu, to have Google collect the data in the EU","    plan: plan)","\/\/ A server tracking its own events: its sessions are the server's.","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: googleAnalytics)"]},{"level":3,"text":"What Google Analytics receives","type":"heading","anchor":"What-Google-Analytics-receives"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each request holds one client’s events, as the Measurement Protocol takes one "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"request. The "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" is the record’s session, from the sessions enricher, written as the two"},{"type":"text","text":" "},{"type":"text","text":"halves of its UUID in decimal, joined by a period, the form the Measurement Protocol asks for. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session is sent under its own record identifier, in a request of its own. Each"},{"type":"text","text":" "},{"type":"text","text":"event’s "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":" parameter is the session’s start in Unix milliseconds, so Google Analytics"},{"type":"text","text":" "},{"type":"text","text":"groups the session’s events, and its "},{"type":"codeVoice","code":"timestamp_micros"},{"type":"text","text":" is the record’s timestamp. Every request"},{"type":"text","text":" "},{"type":"text","text":"sends ad consent as denied, so Google uses none of the events for advertising."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", user properties, location, IP address, device or user agent is sent, and no"},{"type":"text","text":" "},{"type":"text","text":"advertising identifier. The record’s vendor identifier, trace context and standard context aren’t"},{"type":"text","text":" "},{"type":"text","text":"sent either. Google Analytics counts a user per "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":", so each session is one user in its"},{"type":"text","text":" "},{"type":"text","text":"reports, and so is each record sent without a session."}]},{"type":"paragraph","inlineContent":[{"text":"No ","type":"text"},{"code":"engagement_time_msec","type":"codeVoice"},{"text":" is sent, as Traffluent doesn’t measure engagement. Without it the events","type":"text"},{"text":" ","type":"text"},{"text":"don’t count toward engagement time or engaged sessions, and the Realtime and Users reports can show","type":"text"},{"text":" ","type":"text"},{"text":"no users while events arrive. Check the event counts, not the user counts, to see that the","type":"text"},{"text":" ","type":"text"},{"text":"destination works.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with,"},{"type":"text","text":" "},{"type":"text","text":"and become the event’s "},{"type":"codeVoice","code":"params"},{"type":"text","text":". A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals."},{"type":"text","text":" "},{"type":"text","text":"Google Analytics takes only strings, numbers and booleans, so a nested value is spread into a"},{"type":"text","text":" "},{"type":"text","text":"parameter for each value it holds, named after its path joined by "},{"type":"codeVoice","code":"_"},{"type":"text","text":" ("},{"type":"codeVoice","code":"cart_size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags_0"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is left out."}]},{"level":3,"text":"Records sent twice","type":"heading","anchor":"Records-sent-twice"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Measurement Protocol has no field that identifies an event, so Google Analytics can’t tell a"},{"type":"text","text":" "},{"type":"text","text":"repeat from a new event, and counts every one it receives. A record is sent more than once when a"},{"type":"text","text":" "},{"type":"text","text":"request is retried after Google stored it but the answer was lost, when a delivery sends a"},{"type":"text","text":" "},{"type":"text","text":"cancelled batch again, and when a store redelivers records after a relaunch. Each such record is"},{"type":"text","text":" "},{"type":"text","text":"counted twice in Google Analytics."}]},{"level":3,"text":"Records left out","type":"heading","anchor":"Records-left-out"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"one the plan doesn’t describe, whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", or that holds a value JSON can’t;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose event name, or a parameter’s name, is longer than 40 bytes, doesn’t start with a","type":"text"},{"text":" ","type":"text"},{"text":"letter, or holds anything but letters, numbers and ","type":"text"},{"code":"_","type":"codeVoice"},{"text":";","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"one whose event name Google Analytics keeps (","type":"text"},{"code":"session_start","type":"codeVoice"},{"text":", ","type":"text"},{"code":"first_visit","type":"codeVoice"},{"text":", ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" and the rest","type":"text"},{"text":" ","type":"text"},{"text":"of its reserved names), or takes only from an app stream (","type":"text"},{"code":"screen_view","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ad_impression","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"in_app_purchase","type":"codeVoice"},{"text":");","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one with a parameter Google Analytics keeps (a ","type":"text"},{"code":"firebase_","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ga_","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"google_","type":"codeVoice"},{"text":" prefix) or named","type":"text"},{"text":" ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":", which the encoder writes;","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"one of more than 25 parameters, counting ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":", or with a string longer than 100 bytes;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"one tracked more than 72 hours before the batch is encoded, or more than 15 minutes after it,"},{"type":"text","text":" "},{"type":"text","text":"and one whose timestamp has no microseconds form;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"one too large for a request."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Google Analytics wouldn’t refuse such an event: it answers 2xx either way. Under its default,","type":"text"},{"text":" ","type":"text"},{"text":"relaxed validation it stores the event without the parameter that breaks a rule, or under a name","type":"text"},{"text":" ","type":"text"},{"text":"it never checked, so the report would hold an event other than the one tracked. The encoder leaves","type":"text"},{"text":" ","type":"text"},{"text":"the record out and reports it instead. A Google Analytics 360 property takes values of up to 500","type":"text"},{"text":" ","type":"text"},{"text":"characters, but the encoder holds every property to the standard 100 bytes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The destination reports each as ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"text":", a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":" whose reason is a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","type":"reference","isActive":true},{"text":". The encoder logs a notice for each event and property of the plan","type":"text"},{"text":" ","type":"text"},{"text":"named as Google Analytics refuses when the destination is made; rename such an event or property,","type":"text"},{"text":" ","type":"text"},{"text":"raising the event’s version, to send it.","type":"text"}]},{"level":3,"text":"What the Measurement Protocol doesn’t report","type":"heading","anchor":"What-the-Measurement-Protocol-doesnt-report"},{"type":"paragraph","inlineContent":[{"text":"The Measurement Protocol answers 2xx to every request it receives, including one it can’t read and","type":"text"},{"text":" ","type":"text"},{"text":"one whose events it doesn’t store. A wrong measurement ID or API secret is answered 2xx with nothing","type":"text"},{"text":" ","type":"text"},{"text":"stored, so check the property’s Realtime event counts after setting the destination up. Google’s","type":"text"},{"text":" ","type":"text"},{"text":"validation server, ","type":"text"},{"type":"codeVoice","code":"\/debug\/mp\/collect"},{"text":", checks a body’s shape but not the measurement ID or the API","type":"text"},{"text":" ","type":"text"},{"text":"secret, so a body it accepts can still be stored nowhere. A record older than 72 hours is stored as","type":"text"},{"text":" ","type":"text"},{"text":"if it happened 72 hours ago, so the encoder leaves those out too; a request retried for long after","type":"text"},{"text":" ","type":"text"},{"text":"its batch was encoded can still arrive past that window.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to PostHog, Amplitude, Mixpanel or Segment, use "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":", "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"MixpanelEncoding"},{"type":"text","text":" or "},{"type":"codeVoice","code":"SegmentSpecEncoding"},{"type":"text","text":" instead."}]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"text":" ","type":"text"},{"text":"covers what Google Analytics receives, and why, in more detail.","type":"text"}]}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol."}],"references":{"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsEncodingError":{"title":"GoogleAnalyticsEncodingError","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","navigatorTitle":[{"text":"GoogleAnalyticsEncodingError","kind":"identifier"}],"type":"topic","abstract":[{"text":"Why ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsEncodingError","kind":"identifier"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsencodingerror","kind":"symbol","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"text":" sends.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"title":"BatchEncoder","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/appBundle":{"type":"topic","title":"GoogleAnalyticsSetupError.appBundle","kind":"symbol","abstract":[{"type":"text","text":"The process is an app or an app extension: its main bundle is an "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or "},{"type":"codeVoice","code":".appex"},{"type":"text","text":" "},{"type":"text","text":"directory. The factory is compiled for macOS so a server written for it can run there, and a"},{"type":"text","text":" "},{"type":"text","text":"Mac app compiles it too, but an app ships the API secret to everyone who installs it, and"},{"type":"text","text":" "},{"type":"text","text":"anyone holding the secret can send events to the property. Send the app’s events to a relay"},{"type":"text","text":" "},{"type":"text","text":"of yours instead, which forwards them to Google Analytics."}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"appBundle"}],"role":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/appbundle"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsRegion":{"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsregion","abstract":[{"type":"text","text":"Where Google Analytics collects a stream’s events, which decides the Measurement Protocol"},{"type":"text","text":" "},{"type":"text","text":"endpoint they are posted to."}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsRegion","kind":"identifier"}],"navigatorTitle":[{"text":"GoogleAnalyticsRegion","kind":"identifier"}],"title":"GoogleAnalyticsRegion"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","url":"\/documentation\/googleanalyticsencoding","role":"collection","kind":"symbol","type":"topic","title":"GoogleAnalyticsEncoding","abstract":[{"type":"text","text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol."}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/HTTPDestinations/HTTPDestination/googleAnalytics(measurementID:apiSecret:region:plan:transport:backoff:clock:now:)":{"abstract":[{"type":"text","text":"A destination on a server that sends batches to the Google Analytics web or data stream of"},{"type":"text","text":" "},{"type":"codeVoice","code":"measurementID"},{"type":"text","text":", authenticated by its "},{"type":"codeVoice","code":"apiSecret"},{"type":"text","