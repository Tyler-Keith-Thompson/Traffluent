ithub.io/Traffluent/documentation/traffluent/choosingdestinations":{"title":"Choosing Destinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/appBundle":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The process is an app or an app extension: its main bundle is an "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or "},{"type":"codeVoice","code":".appex"},{"type":"text","text":" "},{"type":"text","text":"directory. The factory is compiled for macOS so a server written for it can run there, and a"},{"type":"text","text":" "},{"type":"text","text":"Mac app compiles it too, but an app ships the API secret to everyone who installs it, and"},{"type":"text","text":" "},{"type":"text","text":"anyone holding the secret can send events to the property. Send the app’s events to a relay"},{"type":"text","text":" "},{"type":"text","text":"of yours instead, which forwards them to Google Analytics."}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","role":"symbol","title":"GoogleAnalyticsSetupError.appBundle","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/appbundle","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"appBundle"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"type":"topic","kind":"symbol","url":"\/documentation\/googleanalyticsencoding","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","abstract":[{"text":"Send records from a server to a Google Analytics 4 we