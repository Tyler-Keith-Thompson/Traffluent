{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"SwiftUITracking"}],"title":"SwiftUITracking","role":"collection","symbolKind":"module","externalID":"SwiftUITracking","roleHeading":"Framework"},"kind":"symbol","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this module to track events from SwiftUI views on Apple platforms; elsewhere it builds empty."},{"type":"text","text":" "},{"type":"text","text":"Set a tracker once, at the root of the views, with "},{"code":"tracker(_:)","type":"codeVoice"},{"type":"text","text":", and read it in any view below"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"@Environment(\\.tracker)","type":"codeVoice"},{"type":"text","text":". A button’s action can track through it, which a "},{"code":"withTracker","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"binding can’t reach, since SwiftUI runs actions on tasks of its own. Until a tracker is set, the"},{"type":"text","text":" "},{"type":"text","text":"environment holds "},{"code":"Tracker.noOp","type":"codeVoice"},{"type":"text","text":", so a preview tracks nothing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifiers track through the environment’s tracker, once per trigger, and record the place"},{"type":"text","text":" "},{"type":"text","text":"they are applied as the call site. "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":" tracks each time a view appears,"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" each tap beside the view’s own action, and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" each new value."},{"type":"text","text":" "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time the view appears, and puts a tracker enriched"},{"type":"text","text":" "},{"type":"text","text":"with the screen’s "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" in the environment inside it, so every event tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen carries its name:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","import Traffluent","","@Event","struct CartOpened {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        List {","            Button(\"Check out\") {","                tracker.track(CheckoutStarted(cartSize: 3))  \/\/ its record's context[ScreenKey.self] is \"Cart\"","            }","        }","        .trackOnAppear(CartOpened())","    }","}","","let tracker = Tracker()","let root = CartView()","    .trackScreen(\"Cart\")  \/\/ tracks ScreenViewed(screen: \"Cart\") each time it appears","    .tracker(tracker)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" where the screen’s view is placed, as above, not in the view’s own "},{"type":"codeVoice","code":"body"},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"a view’s "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" reads the environment around it, which its own body’s modifiers don’t"},{"type":"text","text":" "},{"type":"text","text":"change."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where UIKit has traits, the environment’s tracker is the same value as UIKit’s trait"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":"), so SwiftUI views hosted in UIKit read the scene’s tracker. For UIKit and"},{"type":"text","text":" "},{"type":"text","text":"AppKit views, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"To track screens without a modifier on each, see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}]},{"type":"heading","level":2,"text":"API","anchor":"API"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s views aren’t there, so their"},{"type":"text","text":" "},{"type":"text","text":"symbols have no pages of their own here. Their doc comments are in the sources, and Xcode shows"},{"type":"text","text":" "},{"type":"text","text":"them for an Apple target. "},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","isActive":true},{"type":"text","text":" build on every platform, so a"},{"type":"text","text":" "},{"type":"text","text":"tracking plan or a collector off Apple platforms can name them."}]},{"type":"heading","level":3,"text":"Setting the tracker","anchor":"Setting-the-tracker"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EnvironmentValues.tracker"}]}]},{"content":[{"inlineContent":[{"code":"View.tracker(_:)","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Tracking from views","anchor":"Tracking-from-views"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"View.trackOnAppear(_:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackOnTap(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackChange(of:_:)"}]}]}]},{"type":"heading","level":3,"text":"Screens","anchor":"Screens"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackScreen(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","type":"reference","isActive":true}]}]}]}],"kind":"content"}],"hierarchy":{"paths":[[]]},"sections":[],"identifier":{"url":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiftuitracking"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"],"anchor":"Structures","generated":true},{"title":"Enumerations","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"],"anchor":"Enumerations","generated":true}],"references":{"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenViewed/screen":{"title":"screen","role":"symbol","type":"topic","abstract":[{"type":"text","text":"The viewed screen’s name."}],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed\/screen","url":"\/documentation\/swiftuitracking\/screenviewed\/screen","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"screen","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"kind":"symbol"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenViewed":{"title":"ScreenViewed","role":"symbol","type":"topic","abstract":[{"text":"Someone viewed the screen named ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed\/screen"},{"text":": what ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":" tracks each time its view","type":"text"},{"text":" ","type":"text"},{"text":"appears.","type":"text"}],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","navigatorTitle":[{"kind":"identifier","text":"ScreenViewed"}],"url":"\/documentation\/swiftuitracking\/screenviewed","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenViewed"}],"kind":"symbol"},"doc://UIKitTracking/documentation/UIKitTracking":{"title":"UIKitTracking","role":"collection","type":"topic","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","url":"\/documentation\/uikittracking","kind":"symbol"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenKey":{"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" key of the screen an event was tracked from: the name give