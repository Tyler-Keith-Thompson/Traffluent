{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},"abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftuitracking"]}],"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"SwiftUITracking"}],"title":"SwiftUITracking","externalID":"SwiftUITracking","roleHeading":"Framework","role":"collection","symbolKind":"module"},"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"],"title":"Structures","generated":true},{"anchor":"Enumerations","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"],"title":"Enumerations","generated":true}],"kind":"symbol","primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this module to track events from SwiftUI views on Apple platforms; elsewhere it builds empty."},{"type":"text","text":" "},{"type":"text","text":"Set a tracker once, at the root of the views, with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", and read it in any view below"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"@Environment(\\.tracker)"},{"type":"text","text":". A button’s action can track through it, which a "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" "},{"type":"text","text":"binding can’t reach, since SwiftUI runs actions on tasks of its own. Until a tracker is set, the"},{"type":"text","text":" "},{"type":"text","text":"environment holds "},{"type":"codeVoice","code":"Tracker.noOp"},{"type":"text","text":", so a preview tracks nothing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifiers track through the environment’s tracker, once per trigger, and record the place"},{"type":"text","text":" "},{"type":"text","text":"they are applied as the call site. "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":" tracks each time a view appears,"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" each tap beside the view’s own action, and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" each new value."},{"type":"text","text":" "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time the view appears, and puts a tracker enriched"},{"type":"text","text":" "},{"type":"text","text":"with the screen’s "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" in the environment inside it, so every event tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen carries its name:"}]},{"code":["import SwiftUI","import Traffluent","","@Event","struct CartOpened {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        List {","            Button(\"Check out\") {","                tracker.track(CheckoutStarted(cartSize: 3))  \/\/ its record's context[ScreenKey.self] is \"Cart\"","            }","        }","        .trackOnAppear(CartOpened())","    }","}","","let tracker = Tracker()","let root = CartView()","    .trackScreen(\"Cart\")  \/\/ tracks ScreenViewed(screen: \"Cart\") each time it appears","    .tracker(tracker)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"code":"trackScreen(_:)","type":"codeVoice"},{"type":"text","text":" where the screen’s view is placed, as above, not in the view’s own "},{"code":"body","type":"codeVoice"},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"a view’s "},{"code":"@Environment","type":"codeVoice"},{"type":"text","text":" reads the environment around it, which its own body’s modifiers don’t"},{"type":"text","text":" "},{"type":"text","text":"change."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where UIKit has traits, the environment’s tracker is the same value as UIKit’s trait"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":"), so SwiftUI views hosted in UIKit read the scene’s tracker. For UIKit and"},{"type":"text","text":" "},{"type":"text","text":"AppKit views, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"To track screens without a modifier on each, see"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The guide"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}]},{"type":"heading","anchor":"API","text":"API","level":2},{"type":"paragraph","inlineContent":[{"text":"The documentation site is built on Linux, where this module’s views aren’t there, so their","type":"text"},{"text":" ","type":"text"},{"text":"symbols have no pages of their own here. Their doc comments are in the sources, and Xcode shows","type":"text"},{"text":" ","type":"text"},{"text":"them for an Apple target. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","type":"reference"},{"text":" build on every platform, so a","type":"text"},{"text":" ","type":"text"},{"text":"tracking plan or a collector off Apple platforms can name them.","type":"text"}]},{"type":"heading","anchor":"Setting-the-tracker","text":"Setting the tracker","level":3},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"EnvironmentValues.tracker"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.tracker(_:)"}]}]}],"type":"unorderedList"},{"type":"heading","anchor":"Tracking-from-views","text":"Tracking from views","level":3},{"items":[{"content":[{"inlineContent":[{"code":"View.trackOnAppear(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"View.trackOnTap(_:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackChange(of:_:)"}]}]}],"type":"unorderedList"},{"type":"heading","anchor":"Screens","text":"Screens","level":3},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"View.trackScreen(_:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","isActive":true}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"titleInlineContent":[{"code":"AppKitTracking","type":"codeVoice"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","title":"AppKitTracking","type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},"doc://UIKitTracking/documentation/UIKitTracking":{"abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"url":"\/documentation\/uikittracking","kind":"symbol","title":"UIKitTracking","type":"topic","role":"collection","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenKey":{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","abstract":[{"text":"The ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" key of the screen an event was tracked from: the name given to","type":"text"},{"text":" ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/swiftuitracking\/screenkey","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenKey","kind":"identifier"}],"navigatorTitle":[{"text":"ScreenKey","kind":"identifier"}],"role":"symbol","kind":"symbol","type":"topic","title":"ScreenKey"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenViewed":{"navigatorTitle":[{"text":"ScreenViewed","kind":"identifier"}],"abstract":[{"type":"text","text":"Someone viewed the screen named "},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed\/screen","type":"reference","isActive":true},{"type":"text","text":": what "},{"code":"trackScreen(_:)","type":"codeVoice"},{"type":"text","text":" tracks each time its view"},{"type":"text","text":" "},{"type":"text","text":"appears."}],"url":"\/documentation\/swiftuitracking\/screenviewed","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenViewed","kind":"identifier"}],"type":"topic","title":"ScreenViewed","role":"symbol","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"title":"Tracking from SwiftUI, UIKit and AppKit","titleInlineContent":[{"type":"text","text":"Tracking from SwiftUI, UIKit and AppKit"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"url":"\/documentation\/swiftuitracking","kind":"symbol","type":"topic","title":"SwiftUITracking","role":"collection","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenViewed/screen":{"abstract":[{"type":"text","text":"The viewed screen’s name."}],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed\/screen","url":"\/documentation\/swiftuitracking\/screenviewed\/screen","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"screen","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"role":"symbol","kind":"symbol","type":"topic","title":"screen"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/automaticscreentracking":{"type":"link","title":"AutomaticScreenTracking","titleInlineContent":[{"code":"AutomaticScreenTracking","type":"codeVoice"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking"}}}