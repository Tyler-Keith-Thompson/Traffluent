ages of their own here. Their doc comments are in the sources, and Xcode shows"},{"type":"text","text":" "},{"type":"text","text":"them for an Apple target. "},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","isActive":true},{"type":"text","text":" build on every platform, so a"},{"type":"text","text":" "},{"type":"text","text":"tracking plan or a collector off Apple platforms can name them."}]},{"anchor":"Setting-the-tracker","text":"Setting the tracker","type":"heading","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EnvironmentValues.tracker"}]}]},{"content":[{"inlineContent":[{"code":"View.tracker(_:)","type":"codeVoice"}],"type":"paragraph"}]}]},{"anchor":"Tracking-from-views","text":"Tracking from views","type":"heading","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackOnAppear(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"View.trackOnTap(_:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackChange(of:_:)"}]}]}]},{"anchor":"Screens","text":"Screens","type":"heading","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"View.trackScreen(_:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","isActive":true}]}]}]}],"kind":"content"}],"kind":"symbol","references":{"https://tyler-keith