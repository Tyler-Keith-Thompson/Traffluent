{"metadata":{"roleHeading":"Framework","title":"SwiftUITracking","modules":[{"name":"SwiftUITracking"}],"role":"collection","externalID":"SwiftUITracking","symbolKind":"module"},"identifier":{"url":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Use this module to track events from SwiftUI views on Apple platforms; elsewhere it builds empty."},{"type":"text","text":" "},{"type":"text","text":"Set a tracker once, at the root of the views, with "},{"code":"tracker(_:)","type":"codeVoice"},{"type":"text","text":", and read it in any view below"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"@Environment(\\.tracker)","type":"codeVoice"},{"type":"text","text":". A button’s action can track through it, which a "},{"code":"withTracker","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"binding can’t reach, since SwiftUI runs actions on tasks of its own. Until a tracker is set, the"},{"type":"text","text":" "},{"type":"text","text":"environment’s tracker tracks through the one "},{"code":"Tracker.bootstrap","type":"codeVoice"},{"type":"text","text":" made the process’s default, and"},{"type":"text","text":" "},{"type":"text","text":"with none it drops each event, warning once per call site. In a preview it is "},{"code":"Tracker.noOp","type":"codeVoice"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"a preview tracks nothing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The modifiers track through the environment’s tracker, once per trigger, and record the place"},{"type":"text","text":" "},{"type":"text","text":"they are applied as the call site. "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":" tracks each time a view appears,"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" each tap beside the view’s own action, and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" each new value."},{"type":"text","text":" "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time the view appears, and puts a tracker enriched"},{"type":"text","text":" "},{"type":"text","text":"with the screen’s "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" in the environment inside it, so every event tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen carries its name:"}],"type":"paragraph"},{"code":["import SwiftUI","import Traffluent","","@Event","struct CartOpened {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        List {","            Button(\"Check out\") {","                tracker.track(CheckoutStarted(cartSize: 3))  \/\/ its record's context[ScreenKey.self] is \"Cart\"","            }","        }","        .trackOnAppear(CartOpened())","    }","}","","let tracker = Tracker()","let root = CartView()","    .trackScreen(\"Cart\")  \/\/ tracks ScreenViewed(screen: \"Cart\") each time it appears","    .tracker(tracker)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Apply "},{"code":"trackScreen(_:)","type":"codeVoice"},{"type":"text","text":" where the screen’s view is placed, as above, not in the view’s own "},{"code":"body","type":"codeVoice"},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"a view’s "},{"code":"@Environment","type":"codeVoice"},{"type":"text","text":" reads the environment around it, which its own body’s modifiers don’t"},{"type":"text","text":" "},{"type":"text","text":"change."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Where UIKit has traits, the environment’s tracker is the same value as UIKit’s trait"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":"), so SwiftUI views hosted in UIKit read the scene’s tracker. For UIKit and"},{"type":"text","text":" "},{"type":"text","text":"AppKit views, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"To track screens without a modifier on each, see"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The guide"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}],"type":"paragraph"},{"text":"API","type":"heading","level":2,"anchor":"API"},{"inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s views aren’t there, so their"},{"type":"text","text":" "},{"type":"text","text":"symbols have no pages of their own here. Their doc comments are in the sources, and Xcode shows"},{"type":"text","text":" "},{"type":"text","text":"them for an Apple target. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"},{"type":"text","text":" build on every platform, so a"},{"type":"text","text":" "},{"type":"text","text":"tracking plan or a collector off Apple platforms can name them."}],"type":"paragraph"},{"text":"Setting the tracker","type":"heading","level":3,"anchor":"Setting-the-tracker"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"EnvironmentValues.tracker"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"View.tracker(_:)","type":"codeVoice"}]}]}],"type":"unorderedList"},{"text":"Tracking from views","type":"heading","level":3,"anchor":"Tracking-from-views"},{"items":[{"content":[{"inlineContent":[{"code":"View.trackOnAppear(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"View.trackOnTap(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackChange(of:_:)"}]}]}],"type":"unorderedList"},{"text":"Screens","type":"heading","level":3,"anchor":"Screens"},{"items":[{"content":[{"inlineContent":[{"code":"View.trackScreen(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","isActive":true,"type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"],"generated":true,"anchor":"Structures"},{"title":"Enumerations","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"],"generated":true,"anchor":"Enumerations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftuitracking"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[[]]},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/automaticscreentracking":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","title":"AutomaticScreenTracking","titleInlineContent":[{"type":"codeVoice","code":"AutomaticScreenTracking"}],"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenViewed/screen":{"role":"symbol","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed\/screen","title":"screen","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"screen","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/swiftuitracking\/screenviewed\/screen","abstract":[{"text":"The viewed screen’s name.","type":"text"}]},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenKey":{"kind":"symbol","type":"topic","url":"\/documentation\/swiftuitracking\/screenkey","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","abstract":[{"text":"The ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" key of the screen an event was tracked from: the name given to","type":"text"},{"text":" ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":".","type":"text"}],"title":"ScreenKey","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenKey","kind":"identifier"}],"navigatorTitle":[{"text":"ScreenKey","kind":"identi