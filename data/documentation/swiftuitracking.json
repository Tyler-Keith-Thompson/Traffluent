{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftuitracking"]}],"identifier":{"url":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","interfaceLanguage":"swift"},"metadata":{"title":"SwiftUITracking","roleHeading":"Framework","externalID":"SwiftUITracking","role":"collection","symbolKind":"module","modules":[{"name":"SwiftUITracking"}]},"abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"sections":[],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"],"generated":true,"anchor":"Structures"},{"title":"Enumerations","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"],"generated":true,"anchor":"Enumerations"}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"Use this module to track events from SwiftUI views on Apple platforms; elsewhere it builds empty.","type":"text"},{"text":" ","type":"text"},{"text":"Set a tracker once, at the root of the views, with ","type":"text"},{"code":"tracker(_:)","type":"codeVoice"},{"text":", and read it in any view below","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"@Environment(\\.tracker)","type":"codeVoice"},{"text":". A button’s action can track through it, which a ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":" ","type":"text"},{"text":"binding can’t reach, since SwiftUI runs actions on tasks of its own. Until a tracker is set, the","type":"text"},{"text":" ","type":"text"},{"text":"environment’s tracker tracks through the one ","type":"text"},{"code":"Tracker.bootstrap","type":"codeVoice"},{"text":" made the process’s default, and","type":"text"},{"text":" ","type":"text"},{"text":"with none it drops each event, warning once per call site. In a preview it is ","type":"text"},{"code":"Tracker.noOp","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"a preview tracks nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The modifiers track through the environment’s tracker, once per trigger, and record the place"},{"type":"text","text":" "},{"type":"text","text":"they are applied as the call site. "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":" tracks each time a view appears,"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" each tap beside the view’s own action, and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" each new value."},{"type":"text","text":" "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time the view appears, and puts a tracker enriched"},{"type":"text","text":" "},{"type":"text","text":"with the screen’s "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" in the environment inside it, so every event tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen carries its name:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","import Traffluent","","@Event","struct CartOpened {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        List {","            Button(\"Check out\") {","                tracker.track(CheckoutStarted(cartSize: 3))  \/\/ its record's context[ScreenKey.self] is \"Cart\"","            }","        }","        .trackOnAppear(CartOpened())","    }","}","","let tracker = Tracker()","let root = CartView()","    .trackScreen(\"Cart\")  \/\/ tracks ScreenViewed(screen: \"Cart\") each time it appears","    .tracker(tracker)"]},{"inlineContent":[{"text":"Apply ","type":"text"},{"type":"codeVoice","code":"trackScreen(_:)"},{"text":" where the screen’s view is placed, as above, not in the view’s own ","type":"text"},{"type":"codeVoice","code":"body"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"a view’s ","type":"text"},{"type":"codeVoice","code":"@Environment"},{"text":" reads the environment around it, which its own body’s modifiers don’t","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Where UIKit has traits, the environment’s tracker is the same value as UIKit’s trait","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true},{"text":"), so SwiftUI views hosted in UIKit read the scene’s tracker. For UIKit and","type":"text"},{"text":" ","type":"text"},{"text":"AppKit views, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"To track screens without a modifier on each, see","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","isActive":true},{"text":" ","type":"text"},{"text":"covers all three frameworks.","type":"text"}],"type":"paragraph"},{"level":2,"text":"API","type":"heading","anchor":"API"},{"inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s views aren’t there, so their"},{"type":"text","text":" "},{"type":"text","text":"symbols have no pages of their own here. Their doc comments are in the sources, and Xcode shows"},{"type":"text","text":" "},{"type":"text","text":"them for an Apple target. "},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","type":"reference","isActive":true},{"type":"text","text":" build on every platform, so a"},{"type":"text","text":" "},{"type":"text","text":"tracking plan or a collector off Apple platforms can name them."}],"type":"paragraph"},{"level":3,"text":"Setting the tracker","type":"heading","anchor":"Setting-the-tracker"},{"items":[{"content":[{"inlineContent":[{"code":"EnvironmentValues.tracker","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.tracker(_:)"}]}]}],"type":"unorderedList"},{"level":3,"text":"Tracking from views","type":"heading","anchor":"Tracking-from-views"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackOnAppear(_:)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"View.trackOnTap(_:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackChange(of:_:)"}]}]}],"type":"unorderedList"},{"level":3,"text":"Screens","type":"heading","anchor":"Screens"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"View.trackScreen(_:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","isActive":true,"type":"reference"}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/automaticscreentracking":{"title":"AutomaticScreenTracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","titleInlineContent":[{"type":"codeVoice","code":"AutomaticScreenTracking"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenKey":{"abstract":[{"type":"text","text":"The "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":" key of the screen an event was tracked from: the name given to"},{"type":"text","text":" "},{"code":"trackScreen(_:)","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/swiftuitracking\/screenkey","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenKey"}],"title":"ScreenKey","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScreenKey"}],"type":"topic"},"doc://UIKitTracking/documentation/UIKitTracking":{"kind":"symbol","url":"\/documentation\/uikittracking","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"title":"UIKitTracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","role":"collection","type":"topic"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenViewed":{"kind":"symbol","url":"\/documentation\/swiftuitracking\/screenviewed","abstract":[{"text":"Someone viewed the screen named ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed\/screen","type":"reference"},{"text":": what ","type":"text"},{"type":"codeVoice","code":"trackScreen(_:)"},{"text":" tracks each time its view","type":"text"},{"text":" ","type":"text"},{"text":"appears.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenViewed"}],"title":"ScreenViewed","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScreenViewed"}],"type":"topic"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenViewed/screen":{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed\/screen","type":"topic","abstract":[{"type":"text","text":"The viewed screen’s name."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"screen"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"role":"symbol","url":"\/documentation\/swiftuitracking\/screenviewed\/screen","title":"screen","kind":"symbol"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"kind":"symbol","url":"\/documentation\/swiftuitracking","title":"SwiftUITracking","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","role":"collection","type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"title":"AppKitTracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","titleInlineContent":[{"type":"codeVoice","code":"AppKitTracking"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},"https://ty