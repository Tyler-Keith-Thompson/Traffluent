{"kind":"symbol","sections":[],"metadata":{"roleHeading":"Framework","role":"collection","externalID":"SwiftUITracking","symbolKind":"module","title":"SwiftUITracking","modules":[{"name":"SwiftUITracking"}]},"topicSections":[{"generated":true,"anchor":"Structures","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"],"title":"Structures"},{"generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"],"title":"Enumerations"}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this module to track events from SwiftUI views on Apple platforms; elsewhere it builds empty."},{"type":"text","text":" "},{"type":"text","text":"Set a tracker once, at the root of the views, with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", and read it in any view below"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"@Environment(\\.tracker)"},{"type":"text","text":". A button’s action can track through it, which a "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" "},{"type":"text","text":"binding can’t reach, since SwiftUI runs actions on tasks of its own. Until a tracker is set, the"},{"type":"text","text":" "},{"type":"text","text":"environment’s tracker tracks through the one "},{"type":"codeVoice","code":"Tracker.bootstrap"},{"type":"text","text":" made the process’s default, and"},{"type":"text","text":" "},{"type":"text","text":"with none it drops each event, warning once per call site. In a preview it is "},{"type":"codeVoice","code":"Tracker.noOp"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"a preview tracks nothing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The modifiers track through the environment’s tracker, once per trigger, and record the place"},{"type":"text","text":" "},{"type":"text","text":"they are applied as the call site. "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":" tracks each time a view appears,"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" each tap beside the view’s own action, and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" each new value."},{"type":"text","text":" "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time the view appears, and puts a tracker enriched"},{"type":"text","text":" "},{"type":"text","text":"with the screen’s "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" in the environment inside it, so every event tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen carries its name:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import Traffluent","","@Event","struct CartOpened {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        List {","            Button(\"Check out\") {","                tracker.track(CheckoutStarted(cartSize: 3))  \/\/ its record's context[ScreenKey.self] is \"Cart\"","            }","        }","        .trackOnAppear(CartOpened())","    }","}","","let tracker = Tracker()","let root = CartView()","    .trackScreen(\"Cart\")  \/\/ tracks ScreenViewed(screen: \"Cart\") each time it appears","    .tracker(tracker)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Apply "},{"code":"trackScreen(_:)","type":"codeVoice"},{"type":"text","text":" where the screen’s view is placed, as above, not in the view’s own "},{"code":"body","type":"codeVoice"},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"a view’s "},{"code":"@Environment","type":"codeVoice"},{"type":"text","text":" reads the environment around it, which its own body’s modifiers don’t"},{"type":"text","text":" "},{"type":"text","text":"change."}],"type":"paragraph"},{"inlineContent":[{"text":"Where UIKit has traits, the environment’s tracker is the same value as UIKit’s trait","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true,"type":"reference"},{"text":"), so SwiftUI views hosted in UIKit read the scene’s tracker. For UIKit and","type":"text"},{"text":" ","type":"text"},{"text":"AppKit views, see ","type":"text"},{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"To track screens without a modifier on each, see","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers all three frameworks.","type":"text"}],"type":"paragraph"},{"anchor":"API","level":2,"text":"API","type":"heading"},{"inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s views aren’t there, so their"},{"type":"text","text":" "},{"type":"text","text":"symbols have no pages of their own here. Their doc comments are in the sources, and Xcode shows"},{"type":"text","text":" "},{"type":"text","text":"them for an Apple target. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"},{"type":"text","text":" build on every platform, so a"},{"type":"text","text":" "},{"type":"text","text":"tracking plan or a collector off Apple platforms can name them."}],"type":"paragraph"},{"anchor":"Setting-the-tracker","level":3,"text":"Setting the tracker","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EnvironmentValues.tracker"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.tracker(_:)"}]}]}],"type":"unorderedList"},{"anchor":"Tracking-from-views","level":3,"text":"Tracking from views","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"View.trackOnAppear(_:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackOnTap(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackChange(of:_:)"}]}]}],"type":"unorderedList"},{"anchor":"Screens","level":3,"text":"Screens","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackScreen(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","type":"reference"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","type":"reference","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/swiftuitracking"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"references":{"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenViewed":{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScreenViewed"}],"url":"\/documentation\/swiftuitracking\/screenviewed","title":"ScreenViewed","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenViewed"}],"abstract":[{"type":"text","text":"Someone viewed the screen named "},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed\/screen","isActive":true},{"type":"text","text":": what "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks each time its view"},{"type":"text","text":" "},{"type":"text","text":"appears."}],"kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/automaticscreentracking":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","title":"AutomaticScreenTracking","titleInlineContent":[{"type":"codeVoice","code":"AutomaticScreenTracking"}],"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"topic","role":"collection","url":"\/documentation\/swiftuitracking","title":"SwiftUITracking","abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"kind":"symbol"},"doc://SwiftUITracking/documentation/Swift