{"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"],"anchor":"Structures"},{"generated":true,"title":"Enumerations","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"],"anchor":"Enumerations"}],"abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},"metadata":{"modules":[{"name":"SwiftUITracking"}],"roleHeading":"Framework","externalID":"SwiftUITracking","role":"collection","title":"SwiftUITracking","symbolKind":"module"},"hierarchy":{"paths":[[]]},"kind":"symbol","primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Use this module to track events from SwiftUI views on Apple platforms; elsewhere it builds empty.","type":"text"},{"text":" ","type":"text"},{"text":"Set a tracker once, at the root of the views, with ","type":"text"},{"code":"tracker(_:)","type":"codeVoice"},{"text":", and read it in any view below","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"@Environment(\\.tracker)","type":"codeVoice"},{"text":". A button’s action can track through it, which a ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":" ","type":"text"},{"text":"binding can’t reach, since SwiftUI runs actions on tasks of its own. Until a tracker is set, the","type":"text"},{"text":" ","type":"text"},{"text":"environment holds ","type":"text"},{"code":"Tracker.noOp","type":"codeVoice"},{"text":", so a preview tracks nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The modifiers track through the environment’s tracker, once per trigger, and record the place"},{"type":"text","text":" "},{"type":"text","text":"they are applied as the call site. "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":" tracks each time a view appears,"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" each tap beside the view’s own action, and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" each new value."},{"type":"text","text":" "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time the view appears, and puts a tracker enriched"},{"type":"text","text":" "},{"type":"text","text":"with the screen’s "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" in the environment inside it, so every event tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen carries its name:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import Traffluent","","@Event","struct CartOpened {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        List {","            Button(\"Check out\") {","                tracker.track(CheckoutStarted(cartSize: 3))  \/\/ its record's context[ScreenKey.self] is \"Cart\"","            }","        }","        .trackOnAppear(CartOpened())","    }","}","","let tracker = Tracker()","let root = CartView()","    .trackScreen(\"Cart\")  \/\/ tracks ScreenViewed(screen: \"Cart\") each time it appears","    .tracker(tracker)"],"type":"codeListing"},{"inlineContent":[{"text":"Apply ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":" where the screen’s view is placed, as above, not in the view’s own ","type":"text"},{"code":"body","type":"codeVoice"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"a view’s ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" reads the environment around it, which its own body’s modifiers don’t","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Where UIKit has traits, the environment’s tracker is the same value as UIKit’s trait"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true},{"type":"text","text":"), so SwiftUI views hosted in UIKit read the scene’s tracker. For UIKit and"},{"type":"text","text":" "},{"type":"text","text":"AppKit views, see "},{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"To track screens without a modifier on each, see"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}],"type":"paragraph"},{"level":2,"text":"API","anchor":"API","type":"heading"},{"inlineContent":[{"text":"The documentation site is built on Linux, where this module’s views aren’t there, so their","type":"text"},{"text":" ","type":"text"},{"text":"symbols have no pages of their own here. Their doc comments are in the sources, and Xcode shows","type":"text"},{"text":" ","type":"text"},{"text":"them for an Apple target. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"},{"text":" build on every platform, so a","type":"text"},{"text":" ","type":"text"},{"text":"tracking plan or a collector off Apple platforms can name them.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Setting the tracker","anchor":"Setting-the-tracker","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"EnvironmentValues.tracker"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"View.tracker(_:)","type":"codeVoice"}]}]}],"type":"unorderedList"},{"level":3,"text":"Tracking from views","anchor":"Tracking-from-views","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"View.trackOnAppear(_:)","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"View.trackOnTap(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackChange(of:_:)"}]}]}],"type":"unorderedList"},{"level":3,"text":"Screens","anchor":"Screens","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackScreen(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"}]}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/swiftuitracking"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftUITracki