{"kind":"symbol","identifier":{"url":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use this module to track events from SwiftUI views on Apple platforms; elsewhere it builds empty.","type":"text"},{"text":" ","type":"text"},{"text":"Set a tracker once, at the root of the views, with ","type":"text"},{"code":"tracker(_:)","type":"codeVoice"},{"text":", and read it in any view below","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"@Environment(\\.tracker)","type":"codeVoice"},{"text":". A button’s action can track through it, which a ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":" ","type":"text"},{"text":"binding can’t reach, since SwiftUI runs actions on tasks of its own. Until a tracker is set, the","type":"text"},{"text":" ","type":"text"},{"text":"environment holds ","type":"text"},{"code":"Tracker.noOp","type":"codeVoice"},{"text":", so a preview tracks nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifiers track through the environment’s tracker, once per trigger, and record the place"},{"type":"text","text":" "},{"type":"text","text":"they are applied as the call site. "},{"code":"trackOnAppear(_:)","type":"codeVoice"},{"type":"text","text":" tracks each time a view appears,"},{"type":"text","text":" "},{"code":"trackOnTap(_:)","type":"codeVoice"},{"type":"text","text":" each tap beside the view’s own action, and "},{"code":"trackChange(of:_:)","type":"codeVoice"},{"type":"text","text":" each new value."},{"type":"text","text":" "},{"code":"trackScreen(_:)","type":"codeVoice"},{"type":"text","text":" tracks "},{"code":"ScreenViewed","type":"codeVoice"},{"type":"text","text":" each time the view appears, and puts a tracker enriched"},{"type":"text","text":" "},{"type":"text","text":"with the screen’s "},{"code":"ScreenKey","type":"codeVoice"},{"type":"text","text":" in the environment inside it, so every event tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen carries its name:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","","struct CartOpened: Event {}","","struct CheckoutStarted: Event {","    var cartSize: Int","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        List {","            Button(\"Check out\") {","                tracker.track(CheckoutStarted(cartSize: 3))  \/\/ its record's context[ScreenKey.self] is \"Cart\"","            }","        }","        .trackOnAppear(CartOpened())","    }","}","","let tracker = Tracker()","let root = CartView()","    .trackScreen(\"Cart\")  \/\/ tracks ScreenViewed(screen: \"Cart\") each time it appears","    .tracker(tracker)"]},{"type":"paragraph","inlineContent":[{"text":"Apply ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":" where the screen’s view is placed, as above, not in the view’s own ","type":"text"},{"code":"body","type":"codeVoice"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"a view’s ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" reads the environment around it, which its own body’s modifiers don’t","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where UIKit has traits, the environment’s tracker is the same value as UIKit’s trait"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true},{"type":"text","text":"), so SwiftUI views hosted in UIKit read the scene’s tracker. For UIKit and"},{"type":"text","text":" "},{"type":"text","text":"AppKit views, see "},{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"To track screens without a modifier on each, see"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}]},{"text":"API","type":"heading","level":2,"anchor":"API"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols"},{"type":"text","text":" "},{"type":"text","text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them"},{"type":"text","text":" "},{"type":"text","text":"for an Apple target."}]},{"text":"Setting the tracker","type":"heading","level":3,"anchor":"Setting-the-tracker"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"EnvironmentValues.tracker","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"View.tracker(_:)"}],"type":"paragraph"}]}]},{"text":"Tracking from views","type":"heading","level":3,"anchor":"Tracking-from-views"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"View.trackOnAppear(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"View.trackOnTap(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"View.trackChange(of:_:)","type":"codeVoice"}]}]}]},{"text":"Screens","type":"heading","level":3,"anchor":"Screens"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackScreen(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ScreenViewed","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ScreenKey"}],"type":"paragraph"}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftuitracking"]}],"sections":[],"metadata":{"roleHeading":"Framework","symbolKind":"module","modules":[{"name":"SwiftUITracking"}],"role":"collection","title":"SwiftUITracking","externalID":"SwiftUITracking"},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"titleInlineContent":[{"type":"text","text":"Tracking from SwiftUI, UIKit and AppKit"}],"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","title":"Tracking from SwiftUI, UIKit and AppKit","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"url":"\/documentation\/swiftuitracking","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","title":"SwiftUITracking","type":"topic","kind":"symbol","role":"collection"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"titleInlineContent":[{"code":"AppKitTracking","type":"codeVoice"}],"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","title":"AppKitTracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},"doc://UIKitTracking/documentation/UIKitTracking":{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","title":"UIKitTracking","role":"collection","type":"topic","url":"\/documentation\/uikittracking","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/automaticscreentracking":{"titleInlineContent":[{"code":"AutomaticScreenTracking","type":"codeVoice"}],"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","title":"AutomaticScreenTracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking"}}}