{"metadata":{"modules":[{"name":"SwiftUITracking"}],"externalID":"SwiftUITracking","role":"collection","roleHeading":"Framework","symbolKind":"module","title":"SwiftUITracking"},"variants":[{"paths":["\/documentation\/swiftuitracking"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use this module to track events from SwiftUI views on Apple platforms; elsewhere it builds empty.","type":"text"},{"text":" ","type":"text"},{"text":"Set a tracker once, at the root of the views, with ","type":"text"},{"type":"codeVoice","code":"tracker(_:)"},{"text":", and read it in any view below","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"@Environment(\\.tracker)"},{"text":". A button’s action can track through it, which a ","type":"text"},{"type":"codeVoice","code":"withTracker"},{"text":" ","type":"text"},{"text":"binding can’t reach, since SwiftUI runs actions on tasks of its own. Until a tracker is set, the","type":"text"},{"text":" ","type":"text"},{"text":"environment holds ","type":"text"},{"type":"codeVoice","code":"Tracker.noOp"},{"text":", so a preview tracks nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The modifiers track through the environment’s tracker, once per trigger, and record the place","type":"text"},{"text":" ","type":"text"},{"text":"they are applied as the call site. ","type":"text"},{"code":"trackOnAppear(_:)","type":"codeVoice"},{"text":" tracks each time a view appears,","type":"text"},{"text":" ","type":"text"},{"code":"trackOnTap(_:)","type":"codeVoice"},{"text":" each tap beside the view’s own action, and ","type":"text"},{"code":"trackChange(of:_:)","type":"codeVoice"},{"text":" each new value.","type":"text"},{"text":" ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":" tracks ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" each time the view appears, and puts a tracker enriched","type":"text"},{"text":" ","type":"text"},{"text":"with the screen’s ","type":"text"},{"code":"ScreenKey","type":"codeVoice"},{"text":" in the environment inside it, so every event tracked from the","type":"text"},{"text":" ","type":"text"},{"text":"screen carries its name:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","import Traffluent","","@Event","struct CartOpened {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        List {","            Button(\"Check out\") {","                tracker.track(CheckoutStarted(cartSize: 3))  \/\/ its record's context[ScreenKey.self] is \"Cart\"","            }","        }","        .trackOnAppear(CartOpened())","    }","}","","let tracker = Tracker()","let root = CartView()","    .trackScreen(\"Cart\")  \/\/ tracks ScreenViewed(screen: \"Cart\") each time it appears","    .tracker(tracker)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" where the screen’s view is placed, as above, not in the view’s own "},{"type":"codeVoice","code":"body"},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"a view’s "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" reads the environment around it, which its own body’s modifiers don’t"},{"type":"text","text":" "},{"type":"text","text":"change."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where UIKit has traits, the environment’s tracker is the same value as UIKit’s trait"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true},{"type":"text","text":"), so SwiftUI views hosted in UIKit read the scene’s tracker. For UIKit and"},{"type":"text","text":" "},{"type":"text","text":"AppKit views, see "},{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"To track screens without a modifier on each, see"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}]},{"type":"heading","level":2,"anchor":"API","text":"API"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols"},{"type":"text","text":" "},{"type":"text","text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them"},{"type":"text","text":" "},{"type":"text","text":"for an Apple target."}]},{"type":"heading","level":3,"anchor":"Setting-the-tracker","text":"Setting the tracker"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EnvironmentValues.tracker"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"View.tracker(_:)","type":"codeVoice"}]}]}]},{"type":"heading","level":3,"anchor":"Tracking-from-views","text":"Tracking from views"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"View.trackOnAppear(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"View.trackOnTap(_:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackChange(of:_:)"}]}]}]},{"type":"heading","level":3,"anchor":"Screens","text":"Screens"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"View.trackScreen(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ScreenViewed","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"ScreenKey","type":"codeVoice"}],"type":"paragraph"}]}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"references":{"doc://UIKitTracking/documentation/UIKitTracking":{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"topic","role":"collection","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"kind":"symbol","title":"UIKitTracking","url":"\/documentation\/uikittracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"titleInlineContent":[{"type":"text","text":"Tracking from SwiftUI, UIKit and AppKit"}],"type":"link","title":"Tracking from SwiftUI, UIKit and AppKit","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"title":"AppKitTracking","identi