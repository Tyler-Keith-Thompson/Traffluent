{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","interfaceLanguage":"swift"},"metadata":{"symbolKind":"module","externalID":"SwiftUITracking","roleHeading":"Framework","title":"SwiftUITracking","modules":[{"name":"SwiftUITracking"}],"role":"collection"},"topicSections":[{"generated":true,"anchor":"Structures","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"],"title":"Structures"},{"generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"],"title":"Enumerations"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this module to track events from SwiftUI views on Apple platforms; elsewhere it builds empty."},{"type":"text","text":" "},{"type":"text","text":"Set a tracker once, at the root of the views, with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", and read it in any view below"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"@Environment(\\.tracker)"},{"type":"text","text":". A button’s action can track through it, which a "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" "},{"type":"text","text":"binding can’t reach, since SwiftUI runs actions on tasks of its own. Until a tracker is set, the"},{"type":"text","text":" "},{"type":"text","text":"environment’s tracker tracks through the one "},{"type":"codeVoice","code":"Tracker.bootstrap"},{"type":"text","text":" made the process’s default, and"},{"type":"text","text":" "},{"type":"text","text":"with none it drops each event, warning once per call site. In a preview it is "},{"type":"codeVoice","code":"Tracker.noOp"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"a preview tracks nothing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifiers track through the environment’s tracker, once per trigger, and record the place"},{"type":"text","text":" "},{"type":"text","text":"they are applied as the call site. "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":" tracks each time a view appears,"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" each tap beside the view’s own action, and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" each new value."},{"type":"text","text":" "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time the view appears, and puts a tracker enriched"},{"type":"text","text":" "},{"type":"text","text":"with the screen’s "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" in the environment inside it, so every event tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen carries its name:"}]},{"type":"codeListing","code":["import SwiftUI","import Traffluent","","@Event","struct CartOpened {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        List {","            Button(\"Check out\") {","                tracker.track(CheckoutStarted(cartSize: 3))  \/\/ its record's context[ScreenKey.self] is \"Cart\"","            }","        }","        .trackOnAppear(CartOpened())","    }","}","","let tracker = Tracker()","let root = CartView()","    .trackScreen(\"Cart\")  \/\/ tracks ScreenViewed(screen: \"Cart\") each time it appears","    .tracker(tracker)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Apply ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":" where the screen’s view is placed, as above, not in the view’s own ","type":"text"},{"code":"body","type":"codeVoice"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"a view’s ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" reads the environment around it, which its own body’s modifiers don’t","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Where UIKit has traits, the environment’s tracker is the same value as UIKit’s trait","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"reference"},{"text":"), so SwiftUI views hosted in UIKit read the scene’s tracker. For UIKit and","type":"text"},{"text":" ","type":"text"},{"text":"AppKit views, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"To track screens without a modifier on each, see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","type":"reference"},{"text":" ","type":"text"},{"text":"covers all three frameworks.","type":"text"}]},{"text":"API","level":2,"anchor":"API","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s views aren’t there, so their"},{"type":"text","text":" "},{"type":"text","text":"symbols have no pages of their own here. Their doc comments are in the sources, and Xcode shows"},{"type":"text","text":" "},{"type":"text","text":"them for an Apple target. "},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","isActive":true},{"type":"text","text":" build on every platform, so a"},{"type":"text","text":" "},{"type":"text","text":"tracking plan or a collector off Apple platforms can name them."}]},{"text":"Setting the tracker","level":3,"anchor":"Setting-the-tracker","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"EnvironmentValues.tracker"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.tracker(_:)"}]}]}],"type":"unorderedList"},{"text":"Tracking from views","level":3,"anchor":"Tracking-from-views","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"View.trackOnAppear(_:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackOnTap(_:)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"View.trackChange(of:_:)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Screens","level":3,"anchor":"Screens","type":"heading"},{"items":[{"content":[{"inlineContent":[{"code":"View.trackScreen(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","isActive":true,"type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[[]]},"kind":"symbol","abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftuitracking"]}],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/automaticscreentracking":{"titleInlineContent":[{"type":"codeVoice","code":"AutomaticScreenTracking"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","type":"link","title":"AutomaticScreenTracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"type":"topic","abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"role":"collection","url":"\/documentation\/swiftuitracking","title":"SwiftUITracking","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","kind":"symbol"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenKey":{"type":"topic","navigatorTitle":[{"text":"ScreenKey","kind":"identifier"}],"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" key of the screen an event was tracked from: the name given to"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":"."}],"role":"symbol","url":"\/documentation\/swiftuitracking\/screenkey","title":"ScreenKey","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenKey","kind":"identifier"}],"kind":"symbol"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenViewed":{"type":"topic","navigatorTitle":[{"text":"ScreenViewed","kind":"identifier"}],"abstract":[{"type":"text","text":"Someone viewed the screen named "},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed\/screen","isActive":true},{"type":"text","text":": what "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks each time its view"},{"type":"text","text":" "},{"type":"text","text":"appears."}],"role":"symbol","url":"\/documentation\/swiftuitracking\/screenviewed","title":"ScreenViewed","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenViewed","kind":"identifier"}],"kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","titleInlineContent":[{"type":"codeVoice","code":"AppKitTracking"}],"title":"AppKitTracking"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenViewed/screen":{"url":"\/documentation\/swiftuitracking\/screenviewed\/screen","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"screen"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"title":"screen","abstract":[{"type":"text","text":"The viewed screen’s name."}],"role":"symbol","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed\/screen","type":"topic"},"doc://UIKitTracking/documentation/UIKitTracking":{"type":"topic","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"role":"collection","url":"\/documentation\/uikittracking","title":"UIKitTracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","kind":"symbol"},"https://ty