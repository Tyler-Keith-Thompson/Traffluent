{"identifier":{"url":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","interfaceLanguage":"swift"},"abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Use this module to track events from SwiftUI views on Apple platforms; elsewhere it builds empty."},{"type":"text","text":" "},{"type":"text","text":"Set a tracker once, at the root of the views, with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", and read it in any view below"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"@Environment(\\.tracker)"},{"type":"text","text":". A button’s action can track through it, which a "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" "},{"type":"text","text":"binding can’t reach, since SwiftUI runs actions on tasks of its own. Until a tracker is set, the"},{"type":"text","text":" "},{"type":"text","text":"environment holds "},{"type":"codeVoice","code":"Tracker.noOp"},{"type":"text","text":", so a preview tracks nothing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The modifiers track through the environment’s tracker, once per trigger, and record the place"},{"type":"text","text":" "},{"type":"text","text":"they are applied as the call site. "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":" tracks each time a view appears,"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" each tap beside the view’s own action, and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" each new value."},{"type":"text","text":" "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time the view appears, and puts a tracker enriched"},{"type":"text","text":" "},{"type":"text","text":"with the screen’s "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" in the environment inside it, so every event tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen carries its name:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import Traffluent","","@Event","struct CartOpened {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        List {","            Button(\"Check out\") {","                tracker.track(CheckoutStarted(cartSize: 3))  \/\/ its record's context[ScreenKey.self] is \"Cart\"","            }","        }","        .trackOnAppear(CartOpened())","    }","}","","let tracker = Tracker()","let root = CartView()","    .trackScreen(\"Cart\")  \/\/ tracks ScreenViewed(screen: \"Cart\") each time it appears","    .tracker(tracker)"]},{"inlineContent":[{"text":"Apply ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":" where the screen’s view is placed, as above, not in the view’s own ","type":"text"},{"code":"body","type":"codeVoice"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"a view’s ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" reads the environment around it, which its own body’s modifiers don’t","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Where UIKit has traits, the environment’s tracker is the same value as UIKit’s trait","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"text":"), so SwiftUI views hosted in UIKit read the scene’s tracker. For UIKit and","type":"text"},{"text":" ","type":"text"},{"text":"AppKit views, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"To track screens without a modifier on each, see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},{"text":" ","type":"text"},{"text":"covers all three frameworks.","type":"text"}],"type":"paragraph"},{"level":2,"text":"API","type":"heading","anchor":"API"},{"inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s views aren’t there, so their"},{"type":"text","text":" "},{"type":"text","text":"symbols have no pages of their own here. Their doc comments are in the sources, and Xcode shows"},{"type":"text","text":" "},{"type":"text","text":"them for an Apple target. "},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","type":"reference","isActive":true},{"type":"text","text":" build on every platform, so a"},{"type":"text","text":" "},{"type":"text","text":"tracking plan or a collector off Apple platforms can name them."}],"type":"paragraph"},{"level":3,"text":"Setting the tracker","type":"heading","anchor":"Setting-the-tracker"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EnvironmentValues.tracker"}]}]},{"content":[{"inlineContent":[{"code":"View.tracker(_:)","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Tracking from views","type":"heading","anchor":"Tracking-from-views"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackOnAppear(_:)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"View.trackOnTap(_:)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"View.trackChange(of:_:)","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Screens","type":"heading","anchor":"Screens"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.trackScreen(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","isActive":true,"type":"reference"}]}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"symbol","topicSections":[{"generated":true,"identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"],"anchor":"Structures","title":"Structures"},{"generated":true,"identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"],"anchor":"Enumerations","title":"Enumerations"}],"sections":[],"variants":[{"paths":["\/documentation\/swiftuitracking"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"collection","externalID":"SwiftUITracking","symbolKind":"module","title":"SwiftUITracking","modules":[{"name":"SwiftUITracking"}],"roleHeading":"Framework"},"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenKey":{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenKey","kind":"identifier"}],"abstract":[{"text":"The ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" key of the screen an event was tracked from: the name given to","type":"text"},{"text":" ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":".","type":"text"}],"title":"ScreenKey","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"ScreenKey","kind":"identifier"}],"url":"\/documentation\/swiftuitracking\/screenkey"},"doc://UIKitTracking/documentation/UIKitTracking":{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","title":"UIKitTracking","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/uikittracking"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"kind":"symbol","title":"SwiftUITracking","type":"topic","role":"collection","url":"\/documentation\/swiftuitracking"},"doc://SwiftUITracking/documentation/SwiftUITracking/ScreenViewed/screen":{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed\/screen","abstract":[{"text":"The viewed screen’s name.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"screen"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"kind":"symbol","title":"screen","type":"topic","role":"symbol","url":"\/documentation\/swiftuitracking\/screenviewed