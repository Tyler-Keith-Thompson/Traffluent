{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed"]},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"]}],"variants":[{"paths":["\/documentation\/swiftuitracking"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this module to track events from SwiftUI views on Apple platforms; elsewhere it builds empty."},{"type":"text","text":" "},{"type":"text","text":"Set a tracker once, at the root of the views, with "},{"code":"tracker(_:)","type":"codeVoice"},{"type":"text","text":", and read it in any view below"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"@Environment(\\.tracker)","type":"codeVoice"},{"type":"text","text":". A button’s action can track through it, which a "},{"code":"withTracker","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"binding can’t reach, since SwiftUI runs actions on tasks of its own. Until a tracker is set, the"},{"type":"text","text":" "},{"type":"text","text":"environment holds "},{"code":"Tracker.noOp","type":"codeVoice"},{"type":"text","text":", so a preview tracks nothing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifiers track through the environment’s tracker, once per trigger, and record the place"},{"type":"text","text":" "},{"type":"text","text":"they are applied as the call site. "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":" tracks each time a view appears,"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" each tap beside the view’s own action, and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" each new value."},{"type":"text","text":" "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time the view appears, and puts a tracker enriched"},{"type":"text","text":" "},{"type":"text","text":"with the screen’s "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" in the environment inside it, so every event tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen carries its name:"}]},{"code":["import SwiftUI","import Traffluent","","@Event","struct CartOpened {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","struct CartView: View {","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        List {","            Button(\"Check out\") {","                tracker.track(CheckoutStarted(cartSize: 3))  \/\/ its record's context[ScreenKey.self] is \"Cart\"","            }","        }","        .trackOnAppear(CartOpened())","    }","}","","let tracker = Tracker()","let root = CartView()","    .trackScreen(\"Cart\")  \/\/ tracks ScreenViewed(screen: \"Cart\") each time it appears","    .tracker(tracker)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" where the screen’s view is placed, as above, not in the view’s own "},{"type":"codeVoice","code":"body"},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"a view’s "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" reads the environment around it, which its own body’s modifiers don’t"},{"type":"text","text":" "},{"type":"text","text":"change."}]},{"type":"paragraph","inlineContent":[{"text":"Where UIKit has traits, the environment’s tracker is the same value as UIKit’s trait","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"reference"},{"text":"), so SwiftUI views hosted in UIKit read the scene’s tracker. For UIKit and","type":"text"},{"text":" ","type":"text"},{"text":"AppKit views, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"To track screens without a modifier on each, see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/automaticscreentracking","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","type":"reference"},{"text":" ","type":"text"},{"text":"covers all three frameworks.","type":"text"}]},{"anchor":"API","text":"API","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The documentation site is built on Linux, where this module’s views aren’t there, so their","type":"text"},{"text":" ","type":"text"},{"text":"symbols have no pages of their own here. Their doc comments are in the sources, and Xcode shows","type":"text"},{"text":" ","type":"text"},{"text":"them for an Apple target. ","type":"text"},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey","type":"reference","isActive":true},{"text":" build on every platform, so a","type":"text"},{"text":" ","type":"text"},{"text":"tracking plan or a collector off Apple platforms can name them.","type":"text"}]},{"anchor":"Setting-the-tracker","text":"Setting the tracker","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"code":"EnvironmentValues.tracker","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.tracker(_:)"}]}]}],"type":"unorderedList"},{"anchor":"Tracking-from-views","text":"Tracking from views","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"View.trackOnAppear(_:)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"View.trackOnTap(_:)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"View.trackChange(of:_:)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Screens","text":"Screens","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"View.trackScreen(_:)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenViewed","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking\/ScreenKey"}]}]}],"type":"unorderedList"}]}],"metadata":{"modules":[{"name":"SwiftUITracking"}],"title":"SwiftUITracking","externalID":"SwiftUITracking","roleHeading":"Framework","role":"collection","symbolKind":"module"},"references":{"https://tyler-keith