{"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Type Aliases","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure"],"anchor":"Type-Aliases"},{"generated":true,"title":"Type Properties","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/transientStatuses"],"anchor":"Type-Properties"},{"generated":true,"title":"Type Methods","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/outcome(of:for:)"],"anchor":"Type-Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"On macOS and Linux, make the destination with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, the stream’s API secret, this encoder and the Measurement"},{"type":"text","text":" "},{"type":"text","text":"Protocol’s limits:"}],"type":"paragraph"},{"code":["let googleAnalytics = try HTTPDestination.googleAnalytics(","    measurementID: measurementID,  \/\/ the web or data stream's, G-…","    apiSecret: apiSecret,  \/\/ from the server's configuration, never an app's","    region: .global,  \/\/ or .eu, to have Google collect the data in the EU","    plan: plan)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The encoder is for a server, and is compiled for macOS and Linux alone, as the Measurement"},{"type":"text","text":" "},{"type":"text","text":"Protocol takes none of its requests without the stream’s API secret, which must stay on the"},{"type":"text","text":" "},{"type":"text","text":"server: anyone holding it can send events to the property. A server forwarding an app’s events"},{"type":"text","text":" "},{"type":"text","text":"remakes each "},{"code":"EventRecord","type":"codeVoice"},{"type":"text","text":" with the app’s identifier, timestamp and "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", and hands"},{"type":"text","text":" "},{"type":"text","text":"them to the destination; tracking them again through a tracker with "},{"code":".sessions()","type":"codeVoice"},{"type":"text","text":" would send"},{"type":"text","text":" "},{"type":"text","text":"every user as one "},{"code":"client_id","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Each request’s body is a JSON object of content type ","type":"text"},{"type":"codeVoice","code":"application\/json"},{"text":" holding one client’s","type":"text"},{"text":" ","type":"text"},{"text":"events, oldest first, as the Measurement Protocol takes one ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":" a request. A batch of","type":"text"},{"text":" ","type":"text"},{"text":"records from several sessions makes a request for each, in the order of each session’s first","type":"text"},{"text":" ","type":"text"},{"text":"record. The members are:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"client_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The records’ session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as the first and last 64 bits of the UUID in decimal, joined by a period; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session, so each such record is a request of its own","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"consent","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ad_user_data"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ad_personalization"},{"type":"text","text":", both "},{"type":"codeVoice","code":"DENIED"},{"type":"text","text":", so Google uses none of the events for advertising"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"events"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"One object per record: "},{"code":"name","type":"codeVoice"},{"type":"text","text":", the event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":" as it is; "},{"code":"params","type":"codeVoice"},{"type":"text","text":", the event’s stored properties by name; and "},{"code":"timestamp_micros","type":"codeVoice"},{"type":"text","text":", when it was tracked, in whole microseconds since 1970"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"codeVoice","code":"params"},{"text":" also holds ","type":"text"},{"type":"codeVoice","code":"session_id"},{"text":", the session’s start in Unix milliseconds, the first 48 bits of","type":"text"},{"text":" ","type":"text"},{"text":"its version 7 ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", so Google Analytics groups the session’s events; it is left out for a","type":"text"},{"text":" ","type":"text"},{"text":"record with no session, or a session key of another version.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", no user properties, and no"},{"type":"text","text":" "},{"type":"codeVoice","code":"user_location"},{"type":"text","text":", "},{"type":"codeVoice","code":"ip_override"},{"type":"text","text":", "},{"type":"codeVoice","code":"device"},{"type":"text","text":" or "},{"type":"codeVoice","code":"user_agent"},{"type":"text","text":", so Google Analytics records no"},{"type":"text","text":" "},{"type":"text","text":"location or device for the events. The record’s vendor identifier and trace context, the"},{"type":"text","text":" "},{"type":"text","text":"standard context, and any other context value, aren’t sent. Google Analytics counts a user per"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":", so its users are sessions. No "},{"type":"codeVoice","code":"engagement_time_msec"},{"type":"text","text":" is sent, as Traffluent doesn’t"},{"type":"text","text":" "},{"type":"text","text":"measure engagement, so the events don’t count toward Google Analytics’ engagement time or"},{"type":"text","text":" "},{"type":"text","text":"engaged sessions, and its Realtime and Users reports can show no users while events arrive:"},{"type":"text","text":" "},{"type":"text","text":"check the event counts instead."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out. Google Analytics takes only strings, numbers and booleans as parameters, so an object or"},{"type":"text","text":" "},{"type":"text","text":"array is spread into a parameter for each value it holds, named after its path joined by "},{"type":"codeVoice","code":"_"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"cart_size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags_0"},{"type":"text","text":"), and a "},{"type":"codeVoice","code":"null"},{"type":"text","text":", such as an optional without a value or a redacted"},{"type":"text","text":" "},{"type":"text","text":"element of an array, is left out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event or parameter name"},{"type":"text","text":" "},{"type":"text","text":"breaks Google Analytics’ naming rules or is one it keeps for itself, one of more than 25"},{"type":"text","text":" "},{"type":"text","text":"parameters, one with a string over 100 bytes, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds"},{"type":"text","text":" "},{"type":"text","text":"a value JSON can’t, one whose timestamp is more than 71 hours before or 15 minutes after the"},{"type":"text","text":" "},{"type":"text","text":"batch is encoded, or has no microseconds form, and one too large for a request"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError"},{"type":"text","text":"). "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)"},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":". Google Analytics would answer 2xx to"},{"type":"text","text":" "},{"type":"text","text":"such an event and, under its default, relaxed validation, store it without the parameter that"},{"type":"text","text":" "},{"type":"text","text":"breaks a rule, or under a name it never checked. A Google Analytics 360 property takes values of"},{"type":"text","text":" "},{"type":"text","text":"up to 500 characters, but the encoder holds every property to the standard 100 bytes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Google Analytics takes an event up to 72 hours old; the encoder holds records to 71, the hour to"},{"type":"text","text":" "},{"type":"text","text":"spare for the request to reach Google and for clocks that disagree. Each request’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"EncodedRequest\/deadline"},{"type":"text","text":" is 71 hours after its oldest record was tracked, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"drops a request still being retried by then, every record of it, the younger ones included, and"},{"type":"text","text":" "},{"type":"text","text":"reports it as "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":", rather than send records"},{"type":"text","text":" "},{"type":"text","text":"Google Analytics would store as 72 hours old."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The Measurement Protocol has no field that identifies an event, so Google Analytics counts each"},{"type":"text","text":" "},{"type":"text","text":"one it receives: a record sent again, by a retry after Google stored it, by a delivery that"},{"type":"text","text":" "},{"type":"text","text":"sends a cancelled batch again, or by a store’s redelivery after a relaunch, is counted twice. A"},{"type":"text","text":" "},{"type":"text","text":"record a store recovers keeps its session, so it is counted under the "},{"code":"client_id","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"session_id","type":"codeVoice"},{"type":"text","text":" of its first send."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits each client’s records into requests within the encoder’s limit,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","type":"reference"},{"text":" by default, and makes none for a batch with no record it can write, so","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for it. The Measurement Protocol answers 2xx to every request it","type":"text"},{"text":" ","type":"text"},{"text":"receives, a malformed one or one whose events it doesn’t store included, so a record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder sends is counted as delivered whatever Google Analytics makes of it, and a wrong","type":"text"},{"text":" ","type":"text"},{"text":"measurement ID or API secret is answered 2xx with nothing stored: check the property’s","type":"text"},{"text":" ","type":"text"},{"text":"Realtime event counts after setting the destination up. The bytes are the same for the same records,","type":"text"},{"text":" ","type":"text"},{"text":"and the same time, on every run and platform: no whitespace, object members in the order of","type":"text"},{"text":" ","type":"text"},{"text":"their names’ UTF-8 bytes.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"]]},"abstract":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of Google Analytics 4’s Measurement Protocol, so an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" on a server can send events to a web or data stream’s ","type":"text"},{"type":"codeVoice","code":"POST \/mp\/collect"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder"]}],"sections":[],"kind":"symbol","metadata":{"roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"modules":[{"name":"GoogleAnalyticsEncoding"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"role":"symbol","externalID":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","title":"GoogleAnalyticsBatchEncoder","remoteSource":{"fileName":"GoogleAnalyticsBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder.swift#L101"}},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"},"references":{"doc://Events/documentation/Events/Sensitive":{"kind":"symbol","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"title":"Sensitive","url":"\/documentation\/events\/sensitive","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"role":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/transientStatuses":{"type":"topic","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/transientstatuses","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/transientStatuses","abstract":[{"type":"text","text":"No status beyond the 408, 429 and 5xx that "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries for every encoder."}],"title":"transientStatuses","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientStatuses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"TransientStatus","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV"},{"kind":"text","text":">"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/init(plan:limit:now:)":{"abstract":[{"text":"An encoder of the events ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" describes, splitting each batch to ","type":"text"},{"code":"limit","type":"codeVoice"},{"text":", and leaving out","type":"text"},{"text":" ","type":"text"},{"text":"the records tracked too long before, or too far after, the time ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" gives.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":")","kind":"text"}],"title":"init(plan:limit:now:)","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/init(plan:limit:now:)","role":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsEncodingError":{"type":"topic","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsencodingerror","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"title":"GoogleAnalyticsEncodingError","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}]},"doc://GoogleAnalyticsEncoding/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s8SendableP"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/outcome(of:for:)":{"kind":"symbol","abstract":[{"type":"text","text":"Every 2xx answer counts as delivered: the Measurement Protocol answers 2xx to every request it receives, with no body that"},{"type":"text","text":" "},{"type":"text","text":"says whether it stored the events."}],"type":"topic","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/outcome(of:for:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","text":"HTTPTransportResponse","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","text":"EncodedRequest","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","text":"ResponseOutcome","kind":"typeIdentifier"}],"title":"outcome(of:for:)","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/outcome(of:for:)","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"type":"topic","kind":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"text":" sends.","type":"text"}],"title":"BatchEncoder","role":"symbol","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}]},"doc://GoogleAnalyticsEncoding/s16SendableMetatypeP":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"type":"topic","kind":"symbol","url":"\/documentation\/googleanalyticsencoding","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","abstract":[{"text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol.","type":"text"}],"title":"GoogleAnalyticsEncoding","role":"collection"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/requests(for:)":{"type":"topic","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/requests(for:)","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","abstract":[{"code":"batch","type":"codeVoice"},{"type":"text","text":" as the requests the Measurement Protocol takes, a client’s records in each, within"},{"type":"text","text":" "},{"type":"text","text":"the encoder’s limit, with the records left out of them."}],"title":"requests(for:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"text":"<","kind":"text"},{"text":"GoogleAnalyticsEncodingError","kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0abC5ErrorO"},{"text":">","kind":"text"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder":{"type":"topic","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Google Analytics 4’s Measurement Protocol, so an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" on a server can send events to a web or data stream’s "},{"type":"codeVoice","code":"POST \/mp\/collect"},{"type":"text","text":"."}],"title":"GoogleAnalyticsBatchEncoder","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"fragments":[{"kind":"keyword","text":"struct