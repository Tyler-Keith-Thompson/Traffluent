{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of Google Analytics 4’s Measurement Protocol, so an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" on a server can send events to a web or data stream’s ","type":"text"},{"type":"codeVoice","code":"POST \/mp\/collect"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder"]}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"kind":"symbol","sections":[],"metadata":{"symbolKind":"struct","title":"GoogleAnalyticsBatchEncoder","externalID":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","role":"symbol","remoteSource":{"fileName":"GoogleAnalyticsBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder.swift#L101"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"modules":[{"name":"GoogleAnalyticsEncoding"}],"roleHeading":"Structure","navigatorTitle":[{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"On macOS and Linux, make the destination with","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, the stream’s API secret, this encoder and the Measurement","type":"text"},{"text":" ","type":"text"},{"text":"Protocol’s limits:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let googleAnalytics = try HTTPDestination.googleAnalytics(","    measurementID: measurementID,  \/\/ the web or data stream's, G-…","    apiSecret: apiSecret,  \/\/ from the server's configuration, never an app's","    region: .global,  \/\/ or .eu, to have Google collect the data in the EU","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"text":"The encoder is for a server, and is compiled for macOS and Linux alone, as the Measurement","type":"text"},{"text":" ","type":"text"},{"text":"Protocol takes none of its requests without the stream’s API secret, which must stay on the","type":"text"},{"text":" ","type":"text"},{"text":"server: anyone holding it can send events to the property. A server forwarding an app’s events","type":"text"},{"text":" ","type":"text"},{"text":"remakes each ","type":"text"},{"code":"EventRecord","type":"codeVoice"},{"text":" with the app’s identifier, timestamp and ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", and hands","type":"text"},{"text":" ","type":"text"},{"text":"them to the destination; tracking them again through a tracker with ","type":"text"},{"code":".sessions()","type":"codeVoice"},{"text":" would send","type":"text"},{"text":" ","type":"text"},{"text":"every user as one ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each request’s body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" holding one client’s","type":"text"},{"text":" ","type":"text"},{"text":"events, oldest first, as the Measurement Protocol takes one ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" a request. A batch of","type":"text"},{"text":" ","type":"text"},{"text":"records from several sessions makes a request for each, in the order of each session’s first","type":"text"},{"text":" ","type":"text"},{"text":"record. The members are:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"client_id"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The records’ session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as the first and last 64 bits of the UUID in decimal, joined by a period; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session, so each such record is a request of its own"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"consent"}]}],[{"type":"paragraph","inlineContent":[{"code":"ad_user_data","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ad_personalization","type":"codeVoice"},{"text":", both ","type":"text"},{"code":"DENIED","type":"codeVoice"},{"text":", so Google uses none of the events for advertising","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"events","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"One object per record: "},{"type":"codeVoice","code":"name"},{"type":"text","text":", the event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":" as it is; "},{"type":"codeVoice","code":"params"},{"type":"text","text":", the event’s stored properties by name; and "},{"type":"codeVoice","code":"timestamp_micros"},{"type":"text","text":", when it was tracked, in whole microseconds since 1970"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"params"},{"type":"text","text":" also holds "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":", the session’s start in Unix milliseconds, the first 48 bits of"},{"type":"text","text":" "},{"type":"text","text":"its version 7 "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", so Google Analytics groups the session’s events; it is left out for a"},{"type":"text","text":" "},{"type":"text","text":"record with no session, or a session key of another version."}]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":", no user properties, and no","type":"text"},{"text":" ","type":"text"},{"code":"user_location","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ip_override","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"user_agent","type":"codeVoice"},{"text":", so Google Analytics records no","type":"text"},{"text":" ","type":"text"},{"text":"location or device for the events. The record’s vendor identifier and trace context, the","type":"text"},{"text":" ","type":"text"},{"text":"standard context, and any other context value, aren’t sent. Google Analytics counts a user per","type":"text"},{"text":" ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":", so its users are sessions. No ","type":"text"},{"code":"engagement_time_msec","type":"codeVoice"},{"text":" is sent, as Traffluent doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"measure engagement, so the events don’t count toward Google Analytics’ engagement time or","type":"text"},{"text":" ","type":"text"},{"text":"engaged sessions, and its Realtime and Users reports can show no users while events arrive:","type":"text"},{"text":" ","type":"text"},{"text":"check the event counts instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out. Google Analytics takes only strings, numbers and booleans as parameters, so an object or"},{"type":"text","text":" "},{"type":"text","text":"array is spread into a parameter for each value it holds, named after its path joined by "},{"type":"codeVoice","code":"_"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"cart_size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags_0"},{"type":"text","text":"), and a "},{"type":"codeVoice","code":"null"},{"type":"text","text":", such as an optional without a value or a redacted"},{"type":"text","text":" "},{"type":"text","text":"element of an array, is left out."}]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event or parameter name","type":"text"},{"text":" ","type":"text"},{"text":"breaks Google Analytics’ naming rules or is one it keeps for itself, one of more than 25","type":"text"},{"text":" ","type":"text"},{"text":"parameters, one with a string over 100 bytes, one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds","type":"text"},{"text":" ","type":"text"},{"text":"a value JSON can’t, one whose timestamp is more than 71 hours before or 15 minutes after the","type":"text"},{"text":" ","type":"text"},{"text":"batch is encoded, or has no microseconds form, and one too large for a request","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","isActive":true,"type":"reference"},{"text":"). ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" returns them as ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":". Google Analytics would answer 2xx to","type":"text"},{"text":" ","type":"text"},{"text":"such an event and, under its default, relaxed validation, store it without the parameter that","type":"text"},{"text":" ","type":"text"},{"text":"breaks a rule, or under a name it never checked. A Google Analytics 360 property takes values of","type":"text"},{"text":" ","type":"text"},{"text":"up to 500 characters, but the encoder holds every property to the standard 100 bytes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Google Analytics takes an event up to 72 hours old; the encoder holds records to 71, the hour to","type":"text"},{"text":" ","type":"text"},{"text":"spare for the request to reach Google and for clocks that disagree. Each request’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"EncodedRequest\/deadline"},{"text":" is 71 hours after its oldest record was tracked, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" ","type":"text"},{"text":"drops a request still being retried by then, every record of it, the younger ones included, and","type":"text"},{"text":" ","type":"text"},{"text":"reports it as ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"text":", rather than send records","type":"text"},{"text":" ","type":"text"},{"text":"Google Analytics would store as 72 hours old.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The Measurement Protocol has no field that identifies an event, so Google Analytics counts each","type":"text"},{"text":" ","type":"text"},{"text":"one it receives: a record sent again, by a retry after Google stored it, by a delivery that","type":"text"},{"text":" ","type":"text"},{"text":"sends a cancelled batch again, or by a store’s redelivery after a relaunch, is counted twice. A","type":"text"},{"text":" ","type":"text"},{"text":"record a store recovers keeps its session, so it is counted under the ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":" of its first send.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" splits each client’s records into requests within the encoder’s limit,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":" by default, and makes none for a batch with no record it can write, so","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for it. The Measurement Protocol answers 2xx to every request it","type":"text"},{"text":" ","type":"text"},{"text":"receives, a malformed one or one whose events it doesn’t store included, so a record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder sends is counted as delivered whatever Google Analytics makes of it, and a wrong","type":"text"},{"text":" ","type":"text"},{"text":"measurement ID or API secret is answered 2xx with nothing stored: check the property’s","type":"text"},{"text":" ","type":"text"},{"text":"Realtime event counts after setting the destination up. The bytes are the same for the same records,","type":"text"},{"text":" ","type":"text"},{"text":"and the same time, on every run and platform: no whitespace, object members in the order of","type":"text"},{"text":" ","type":"text"},{"text":"their names’ UTF-8 bytes.","type":"text"}]}]}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)"],"generated":true},{"anchor":"Type-Aliases","title":"Type Aliases","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/transientStatuses"],"generated":true},{"anchor":"Type-Methods","title":"Type Methods","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/outcome(of:for:)"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/BatchEncoder-Implementations"],"generated":true}],"references":{"doc://GoogleAnalyticsEncoding/s8SendableP":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/transientStatuses":{"title":"transientStatuses","type":"topic","kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/transientStatuses","role":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/transientstatuses","abstract":[{"text":"No status beyond the 408, 429 and 5xx that ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" retries for every encoder.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientStatuses"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","kind":"typeIdentifier","text":"TransientStatus"},{"kind":"text","text":">"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of Google Analytics 4’s Measurement Protocol, so an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" on a server can send events to a web or data stream’s ","type":"text"},{"code":"POST \/mp\/collect","type":"codeVoice"},{"text":".","type":"text"}],"title":"GoogleAnalyticsBatchEncoder","type":"topic","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"title":"HTTPDestination","type":"topic","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","role":"symbol","abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"url":"\/documentation\/httpdestinations\/httpdestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/HTTPDestinations/HTTPDestination/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)":{"title":"googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","abstract":[{"type":"text","text":"A destination on a server that sends batches to the Google Analytics web or data stream of"},{"type":"text","text":" "},{"type":"codeVoice","code":"measurementID"},{"type":"text","text":", authenticated by its "},{"type":"codeVoice","code":"apiSecret"},{"type":"text","text":", with "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a"},{"type":"text","text":" "},{"type":"text","text":"send that fails for now with the waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/googleanalyticsencoding\/httpdestinations\/httpdestination\/googleanalytics(measurementid:apisecret:region:plan:backoff:clock:now:)","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"googleAnalytics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"measurementID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"apiSecret","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GoogleAnalyticsRegion","kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":">, ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"GoogleAnalyticsSetupError","kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"URLSessionTransport","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV"},{"text":", ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV"},{"text":">","kind":"text"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"type":"text","text":" is "},{"code":"URLSessionTransport","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Encoding","type":"codeVoice"},{"type":"text","text":" is "},{"code":"GoogleAnalyticsBatchEncoder","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]}},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsEncodingError":{"navigatorTitle":[{"text":"GoogleAnalyticsEncodingError","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsEncodingError","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsencodingerror","type":"topic","abstract":[{"text":"Why ","type":"text"},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","isActive":true},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for the batch.","type":"text"}],"role":"symbol","title":"GoogleAnalyticsEncodingError","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/outcome(of:for:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","kind":"typeIdentifier"}],"kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/outcome(of:for:)","type":"topi