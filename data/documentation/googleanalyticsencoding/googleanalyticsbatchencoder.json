{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"On macOS and Linux, make the destination with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, the stream’s API secret, this encoder and the Measurement"},{"type":"text","text":" "},{"type":"text","text":"Protocol’s limits:"}],"type":"paragraph"},{"code":["let googleAnalytics = try HTTPDestination.googleAnalytics(","    measurementID: measurementID,  \/\/ the web or data stream's, G-…","    apiSecret: apiSecret,  \/\/ from the server's configuration, never an app's","    region: .global,  \/\/ or .eu, to have Google collect the data in the EU","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The encoder is for a server, and is compiled for macOS and Linux alone, as the Measurement","type":"text"},{"text":" ","type":"text"},{"text":"Protocol takes none of its requests without the stream’s API secret, which must stay on the","type":"text"},{"text":" ","type":"text"},{"text":"server: anyone holding it can send events to the property. A server forwarding an app’s events","type":"text"},{"text":" ","type":"text"},{"text":"remakes each ","type":"text"},{"type":"codeVoice","code":"EventRecord"},{"text":" with the app’s identifier, timestamp and ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", and hands","type":"text"},{"text":" ","type":"text"},{"text":"them to the destination; tracking them again through a tracker with ","type":"text"},{"type":"codeVoice","code":".sessions()"},{"text":" would send","type":"text"},{"text":" ","type":"text"},{"text":"every user as one ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each request’s body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":" holding one client’s"},{"type":"text","text":" "},{"type":"text","text":"events, oldest first, as the Measurement Protocol takes one "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" a request. A batch of"},{"type":"text","text":" "},{"type":"text","text":"records from several sessions makes a request for each, in the order of each session’s first"},{"type":"text","text":" "},{"type":"text","text":"record. The members are:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"client_id"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The records’ session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as the first and last 64 bits of the UUID in decimal, joined by a period; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session, so each such record is a request of its own"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"consent"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ad_user_data"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ad_personalization"},{"type":"text","text":", both "},{"type":"codeVoice","code":"DENIED"},{"type":"text","text":", so Google uses none of the events for advertising"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"events","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"One object per record: ","type":"text"},{"type":"codeVoice","code":"name"},{"text":", the event’s ","type":"text"},{"type":"codeVoice","code":"Event\/name"},{"text":" as it is; ","type":"text"},{"type":"codeVoice","code":"params"},{"text":", the event’s stored properties by name; and ","type":"text"},{"type":"codeVoice","code":"timestamp_micros"},{"text":", when it was tracked, in whole microseconds since 1970","type":"text"}]}]]]},{"inlineContent":[{"type":"codeVoice","code":"params"},{"type":"text","text":" also holds "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":", the session’s start in Unix milliseconds, the first 48 bits of"},{"type":"text","text":" "},{"type":"text","text":"its version 7 "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", so Google Analytics groups the session’s events; it is left out for a"},{"type":"text","text":" "},{"type":"text","text":"record with no session, or a session key of another version."}],"type":"paragraph"},{"inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":", no user properties, and no","type":"text"},{"text":" ","type":"text"},{"code":"user_location","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ip_override","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"user_agent","type":"codeVoice"},{"text":", so Google Analytics records no","type":"text"},{"text":" ","type":"text"},{"text":"location or device for the events. The record’s vendor identifier and trace context, the","type":"text"},{"text":" ","type":"text"},{"text":"standard context, and any other context value, aren’t sent. Google Analytics counts a user per","type":"text"},{"text":" ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":", so its users are sessions. No ","type":"text"},{"code":"engagement_time_msec","type":"codeVoice"},{"text":" is sent, as Traffluent doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"measure engagement, so the events don’t count toward Google Analytics’ engagement time or","type":"text"},{"text":" ","type":"text"},{"text":"engaged sessions, and its Realtime and Users reports can show no users while events arrive:","type":"text"},{"text":" ","type":"text"},{"text":"check the event counts instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out. Google Analytics takes only strings, numbers and booleans as parameters, so an object or"},{"type":"text","text":" "},{"type":"text","text":"array is spread into a parameter for each value it holds, named after its path joined by "},{"code":"_","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"cart_size","type":"codeVoice"},{"type":"text","text":", "},{"code":"tags_0","type":"codeVoice"},{"type":"text","text":"), and a "},{"code":"null","type":"codeVoice"},{"type":"text","text":", such as an optional without a value or a redacted"},{"type":"text","text":" "},{"type":"text","text":"element of an array, is left out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event or parameter name"},{"type":"text","text":" "},{"type":"text","text":"breaks Google Analytics’ naming rules or is one it keeps for itself, one of more than 25"},{"type":"text","text":" "},{"type":"text","text":"parameters, one with a string over 100 bytes, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds"},{"type":"text","text":" "},{"type":"text","text":"a value JSON can’t, one whose timestamp is more than 71 hours before or 15 minutes after the"},{"type":"text","text":" "},{"type":"text","text":"batch is encoded, or has no microseconds form, and one too large for a request"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","isActive":true},{"type":"text","text":"). "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":". Google Analytics would answer 2xx to"},{"type":"text","text":" "},{"type":"text","text":"such an event and, under its default, relaxed validation, store it without the parameter that"},{"type":"text","text":" "},{"type":"text","text":"breaks a rule, or under a name it never checked. A Google Analytics 360 property takes values of"},{"type":"text","text":" "},{"type":"text","text":"up to 500 characters, but the encoder holds every property to the standard 100 bytes."}],"type":"paragraph"},{"inlineContent":[{"text":"Google Analytics takes an event up to 72 hours old; the encoder holds records to 71, the hour to","type":"text"},{"text":" ","type":"text"},{"text":"spare for the request to reach Google and for clocks that disagree. Each request’s","type":"text"},{"text":" ","type":"text"},{"code":"EncodedRequest\/deadline","type":"codeVoice"},{"text":" is 71 hours after its oldest record was tracked, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"drops a request still being retried by then, every record of it, the younger ones included, and","type":"text"},{"text":" ","type":"text"},{"text":"reports it as ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":", rather than send records","type":"text"},{"text":" ","type":"text"},{"text":"Google Analytics would store as 72 hours old.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The Measurement Protocol has no field that identifies an event, so Google Analytics counts each"},{"type":"text","text":" "},{"type":"text","text":"one it receives: a record sent again, by a retry after Google stored it, by a delivery that"},{"type":"text","text":" "},{"type":"text","text":"sends a cancelled batch again, or by a store’s redelivery after a relaunch, is counted twice. A"},{"type":"text","text":" "},{"type":"text","text":"record a store recovers keeps its session, so it is counted under the "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":" of its first send."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" splits each client’s records into requests within the encoder’s limit,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":" by default, and makes none for a batch with no record it can write, so","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for it. The Measurement Protocol answers 2xx to every request it","type":"text"},{"text":" ","type":"text"},{"text":"receives, a malformed one or one whose events it doesn’t store included, so a record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder sends is counted as delivered whatever Google Analytics makes of it, and a wrong","type":"text"},{"text":" ","type":"text"},{"text":"measurement ID or API secret is answered 2xx with nothing stored: check the property’s","type":"text"},{"text":" ","type":"text"},{"text":"Realtime event counts after setting the destination up. The bytes are the same for the same records,","type":"text"},{"text":" ","type":"text"},{"text":"and the same time, on every run and platform: no whitespace, object members in the order of","type":"text"},{"text":" ","type":"text"},{"text":"their names’ UTF-8 bytes.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" of Google Analytics 4’s Measurement Protocol, so an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" on a server can send events to a web or data stream’s ","type":"text"},{"code":"POST \/mp\/collect","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)"]},{"generated":true,"anchor":"Type-Aliases","title":"Type Aliases","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure"]},{"generated":true,"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/transientStatuses"]},{"generated":true,"anchor":"Type-Methods","title":"Type Methods","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/outcome(of:for:)"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/BatchEncoder-Implementations"]}],"hierarchy":{"paths":[["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"]]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP"]}],"kind":"symbol","metadata":{"title":"GoogleAnalyticsBatchEncoder","modules":[{"name":"GoogleAnalyticsEncoding"}],"roleHeading":"Structure","role":"symbol","symbolKind":"struct","externalID":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder.swift#L101","fileName":"GoogleAnalyticsBatchEncoder.swift"}},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"},"sections":[],"references":{"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/init(plan:limit:now:)":{"type":"topic","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/init(plan:limit:now:)","title":"init(plan:limit:now:)","kind":"symbol","abstract":[{"text":"An encoder of the events ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" describes, splitting each batch to ","type":"text"},{"type":"codeVoice","code":"limit"},{"text":", and leaving out","type":"text"},{"text":" ","type":"text"},{"text":"the records tracked too long before, or too far after, the time ","type":"text"},{"type":"codeVoice","code":"now"},{"text":" gives.","type":"text"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"limit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":")"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"title":"GoogleAnalyticsEncoding","kind":"symbol","url":"\/documentation\/googleanalyticsencoding","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","type":"topic","abstract":[{"text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol.","type":"text"}],"role":"collection"},"doc://Events/documentation/Events/Sensitive":{"kind":"symbol","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"type":"topic","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"role":"symbol","title":"Sensitive","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","url":"\/documentation\/events\/sensitive"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/batchLimit":{"type":"topic","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/batchlimit","title":"batchLimit","kind":"symbol","abstract":[{"text":"The Measurement Protocol’s limits on one request: 25 events and 100,000 bytes of body, an","type":"text"},{"text":" ","type":"text"},{"text":"event’s included.","type":"text"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsEncodingError":{"title":"GoogleAnalyticsEncodingError","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"abstract":[{"type":"text","text":"Why "},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","type":"reference","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"type":"topic","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsencodingerror","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"role":"symbol","title":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder"},"doc://GoogleAnalyticsEncoding/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","title":"Swift.Sendable"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/requests(for:)":{"type":"topic","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/requests(for:)","title":"requests(for:)","kind":"symbol","abstract":[{"type":"codeVoice","code":"batch"},{"text":" as the requests the Measurement Protocol takes, a client’s records in each, within","type":"text"},{"text":" ","type":"text"},{"text":"the encoder’s limit, with the records left out of them.","type":"text"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"GoogleAnalyticsEncodingError","preciseIdentifier":"s:23GoogleAnalyticsEncoding0abC5ErrorO","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/HTTPDestinations/HTTPDestination/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)":{"kind":"symbol","type":"topic","abstract":[{"text":"A destination on a server that sends batches to the Google Analytics web or data stream of","type":"text"},{"text":" ","type":"text"},{"code":"measurementID","type":"codeVoice"},{"text":", authenticated by its ","type":"text"},{"code":"apiSecret","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"URLSession.shared","type":"codeVoice"},{"text":", retrying a","type":"text"},{"text":" ","type":"text"},{"text":"send that fails for now with the waits of ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"URLSessionTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"GoogleAnalyticsBatchEncoder","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"googleAnalytics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"measurementID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"apiSecret","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GoogleAnalyticsRegion","kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"