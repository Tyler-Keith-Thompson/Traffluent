{"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"]]},"metadata":{"role":"symbol","navigatorTitle":[{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder.swift#L101","fileName":"GoogleAnalyticsBatchEncoder.swift"},"roleHeading":"Structure","externalID":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","symbolKind":"struct","modules":[{"name":"GoogleAnalyticsEncoding"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"title":"GoogleAnalyticsBatchEncoder"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" of Google Analytics 4’s Measurement Protocol, so an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" on a server can send events to a web or data stream’s ","type":"text"},{"type":"codeVoice","code":"POST \/mp\/collect"},{"text":".","type":"text"}],"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)"]},{"title":"Type Aliases","generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure"]},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/transientStatuses"]},{"title":"Type Methods","generated":true,"anchor":"Type-Methods","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/outcome(of:for:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"On macOS and Linux, make the destination with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, the stream’s API secret, this encoder and the Measurement","type":"text"},{"text":" ","type":"text"},{"text":"Protocol’s limits:","type":"text"}]},{"code":["let googleAnalytics = try HTTPDestination.googleAnalytics(","    measurementID: measurementID,  \/\/ the web or data stream's, G-…","    apiSecret: apiSecret,  \/\/ from the server's configuration, never an app's","    region: .global,  \/\/ or .eu, to have Google collect the data in the EU","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The encoder is for a server, and is compiled for macOS and Linux alone, as the Measurement","type":"text"},{"text":" ","type":"text"},{"text":"Protocol takes none of its requests without the stream’s API secret, which must stay on the","type":"text"},{"text":" ","type":"text"},{"text":"server: anyone holding it can send events to the property. A server forwarding an app’s events","type":"text"},{"text":" ","type":"text"},{"text":"remakes each ","type":"text"},{"code":"EventRecord","type":"codeVoice"},{"text":" with the app’s identifier, timestamp and ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", and hands","type":"text"},{"text":" ","type":"text"},{"text":"them to the destination; tracking them again through a tracker with ","type":"text"},{"code":".sessions()","type":"codeVoice"},{"text":" would send","type":"text"},{"text":" ","type":"text"},{"text":"every user as one ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each request’s body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" holding one client’s","type":"text"},{"text":" ","type":"text"},{"text":"events, oldest first, as the Measurement Protocol takes one ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" a request. A batch of","type":"text"},{"text":" ","type":"text"},{"text":"records from several sessions makes a request for each, in the order of each session’s first","type":"text"},{"text":" ","type":"text"},{"text":"record. The members are:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"client_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The records’ session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as the first and last 64 bits of the UUID in decimal, joined by a period; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session, so each such record is a request of its own","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"consent"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ad_user_data"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ad_personalization"},{"type":"text","text":", both "},{"type":"codeVoice","code":"DENIED"},{"type":"text","text":", so Google uses none of the events for advertising"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"events","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"One object per record: ","type":"text"},{"code":"name","type":"codeVoice"},{"text":", the event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":" as it is; ","type":"text"},{"code":"params","type":"codeVoice"},{"text":", the event’s stored properties by name; and ","type":"text"},{"code":"timestamp_micros","type":"codeVoice"},{"text":", when it was tracked, in whole microseconds since 1970","type":"text"}]}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"code":"params","type":"codeVoice"},{"text":" also holds ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":", the session’s start in Unix milliseconds, the first 48 bits of","type":"text"},{"text":" ","type":"text"},{"text":"its version 7 ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", so Google Analytics groups the session’s events; it is left out for a","type":"text"},{"text":" ","type":"text"},{"text":"record with no session, or a session key of another version.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":", no user properties, and no","type":"text"},{"text":" ","type":"text"},{"code":"user_location","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ip_override","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"user_agent","type":"codeVoice"},{"text":", so Google Analytics records no","type":"text"},{"text":" ","type":"text"},{"text":"location or device for the events. The record’s vendor identifier and trace context, the","type":"text"},{"text":" ","type":"text"},{"text":"standard context, and any other context value, aren’t sent. Google Analytics counts a user per","type":"text"},{"text":" ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":", so its users are sessions. No ","type":"text"},{"code":"engagement_time_msec","type":"codeVoice"},{"text":" is sent, as Traffluent doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"measure engagement, so the events don’t count toward Google Analytics’ engagement time or","type":"text"},{"text":" ","type":"text"},{"text":"engaged sessions, and its Realtime and Users reports can show no users while events arrive:","type":"text"},{"text":" ","type":"text"},{"text":"check the event counts instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out. Google Analytics takes only strings, numbers and booleans as parameters, so an object or"},{"type":"text","text":" "},{"type":"text","text":"array is spread into a parameter for each value it holds, named after its path joined by "},{"type":"codeVoice","code":"_"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"cart_size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags_0"},{"type":"text","text":"), and a "},{"type":"codeVoice","code":"null"},{"type":"text","text":", such as an optional without a value or a redacted"},{"type":"text","text":" "},{"type":"text","text":"element of an array, is left out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event or parameter name"},{"type":"text","text":" "},{"type":"text","text":"breaks Google Analytics’ naming rules or is one it keeps for itself, one of more than 25"},{"type":"text","text":" "},{"type":"text","text":"parameters, one with a string over 100 bytes, one whose event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds"},{"type":"text","text":" "},{"type":"text","text":"a value JSON can’t, one whose timestamp is more than 71 hours before or 15 minutes after the"},{"type":"text","text":" "},{"type":"text","text":"batch is encoded, or has no microseconds form, and one too large for a request"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError"},{"type":"text","text":"). "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)"},{"type":"text","text":" returns them as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":". Google Analytics would answer 2xx to"},{"type":"text","text":" "},{"type":"text","text":"such an event and, under its default, relaxed validation, store it without the parameter that"},{"type":"text","text":" "},{"type":"text","text":"breaks a rule, or under a name it never checked. A Google Analytics 360 property takes values of"},{"type":"text","text":" "},{"type":"text","text":"up to 500 characters, but the encoder holds every property to the standard 100 bytes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Google Analytics takes an event up to 72 hours old; the encoder holds records to 71, the hour to"},{"type":"text","text":" "},{"type":"text","text":"spare for the request to reach Google and for clocks that disagree. Each request’s"},{"type":"text","text":" "},{"code":"EncodedRequest\/deadline","type":"codeVoice"},{"type":"text","text":" is 71 hours after its oldest record was tracked, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"drops a request still being retried by then, every record of it, the younger ones included, and"},{"type":"text","text":" "},{"type":"text","text":"reports it as "},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"type":"text","text":", rather than send records"},{"type":"text","text":" "},{"type":"text","text":"Google Analytics would store as 72 hours old."}]},{"type":"paragraph","inlineContent":[{"text":"The Measurement Protocol has no field that identifies an event, so Google Analytics counts each","type":"text"},{"text":" ","type":"text"},{"text":"one it receives: a record sent again, by a retry after Google stored it, by a delivery that","type":"text"},{"text":" ","type":"text"},{"text":"sends a cancelled batch again, or by a store’s redelivery after a relaunch, is counted twice. A","type":"text"},{"text":" ","type":"text"},{"text":"record a store recovers keeps its session, so it is counted under the ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":" of its first send.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" splits each client’s records into requests within the encoder’s limit,"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" by default, and makes none for a batch with no record it can write, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for it. The Measurement Protocol answers 2xx to every request it"},{"type":"text","text":" "},{"type":"text","text":"receives, a malformed one or one whose events it doesn’t store included, so a record the"},{"type":"text","text":" "},{"type":"text","text":"encoder sends is counted as delivered whatever Google Analytics makes of it, and a wrong"},{"type":"text","text":" "},{"type":"text","text":"measurement ID or API secret is answered 2xx with nothing stored: check the property’s"},{"type":"text","text":" "},{"type":"text","text":"Realtime event counts after setting the destination up. The bytes are the same for the same records,"},{"type":"text","text":" "},{"type":"text","text":"and the same time, on every run and platform: no whitespace, object members in the order of"},{"type":"text","text":" "},{"type":"text","text":"their names’ UTF-8 bytes."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/Failure":{"title":"GoogleAnalyticsBatchEncoder.Failure","abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Failure"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/failure","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/HTTPDestinations/HTTPDestination/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)":{"url":"\/documentation\/googleanalyticsencoding\/httpdestinations\/httpdestination\/googleanalytics(measurementid:apisecret:region:plan:backoff:clock:now:)","conformance":{"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" is "},{"type":"codeVoice","code":"URLSessionTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"GoogleAnalyticsBatchEncoder"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"role":"symbol","kind":"symbol","type":"topic","title":"googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","abstract":[{"type":"text","text":"A destination on a server that sends batches to the Google Analytics web or data stream of"},{"type":"text","text":" "},{"type":"codeVoice","code":"measurementID"},{"type":"text","text":", authenticated by its "},{"type":"codeVoice","code":"apiSecret"},{"type":"text","text":", with "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a"},{"type":"text","text":" "},{"type":"text","text":"send that fails for now with the waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"googleAnalytics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"measurementID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"apiSecret"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GoogleAnalyticsRegion","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"GoogleAnalyticsSetupError","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"URLSessionTransport","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"GoogleAnalyticsBatchEncoder","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV"},{"kind":"text","text":">"}]},"doc://GoogleAnalyticsEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP","type":"unresolvable"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/init(plan:limit:now:)":{"title":"init(plan:limit:now:)","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/init(plan:limit:now:)","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)","type":"topic","kind":"symbol","role":"symbol","abstract":[{"text":"An encoder of the events ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" describes, splitting each batch to ","type":"text"},{"type":"codeVoice","code":"limit"},{"text":", and leaving out","type":"text"},{"text":" ","type":"text"},{"text":"the records tracked too long before, or too far after, the time ","type":"text"},{"type":"codeVoice","code":"now"},{"text":" gives.","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"limit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":")"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"kind":"symbol","type":"topic","url":"\/documentation\/googleanalyticsencoding","abstract":[{"text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol.","type":"text"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","title":"GoogleAnalyticsEncoding","role":"collection"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsEncodingError":{"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsencodingerror","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","title":"GoogleAnalyticsEncodingError","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","type":"reference","isActive":true},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/transientStatuses":{"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"No status beyond the 408, 429 and 5xx that "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries for every encoder."}],"type":"topic","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/transientstatuses","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/transientStatuses","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientStatuses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","text":"TransientStatus"},{"kind":"text","text":">"}],"title":"transientStatuses"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/outcome(of:for:)":{"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/outcome(of:for:)","abstract":[{"text":"Every 2xx answer counts as delivered: the Measurement Protocol answers 2xx to every request it receives, with no body 