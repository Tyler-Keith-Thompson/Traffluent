{"variants":[{"paths":["\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"type":"text","text":" of Google Analytics 4’s Measurement Protocol, so an"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" on a server can send events to a web or data stream’s "},{"code":"POST \/mp\/collect","type":"codeVoice"},{"type":"text","text":"."}],"topicSections":[{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure"],"title":"Type Aliases","generated":true,"anchor":"Type-Aliases"},{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/transientStatuses"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"},{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/outcome(of:for:)"],"title":"Type Methods","generated":true,"anchor":"Type-Methods"}],"hierarchy":{"paths":[["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS and Linux, make the destination with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, the stream’s API secret, this encoder and the Measurement"},{"type":"text","text":" "},{"type":"text","text":"Protocol’s limits:"}]},{"type":"codeListing","syntax":"swift","code":["let googleAnalytics = try HTTPDestination.googleAnalytics(","    measurementID: measurementID,  \/\/ the web or data stream's, G-…","    apiSecret: apiSecret,  \/\/ from the server's configuration, never an app's","    region: .global,  \/\/ or .eu, to have Google collect the data in the EU","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The encoder is for a server, and is compiled for macOS and Linux alone, as the Measurement"},{"type":"text","text":" "},{"type":"text","text":"Protocol takes none of its requests without the stream’s API secret, which must stay on the"},{"type":"text","text":" "},{"type":"text","text":"server: anyone holding it can send events to the property. A server forwarding an app’s events"},{"type":"text","text":" "},{"type":"text","text":"remakes each "},{"type":"codeVoice","code":"EventRecord"},{"type":"text","text":" with the app’s identifier, timestamp and "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", and hands"},{"type":"text","text":" "},{"type":"text","text":"them to the destination; tracking them again through a tracker with "},{"type":"codeVoice","code":".sessions()"},{"type":"text","text":" would send"},{"type":"text","text":" "},{"type":"text","text":"every user as one "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each request’s body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":" holding one client’s"},{"type":"text","text":" "},{"type":"text","text":"events, oldest first, as the Measurement Protocol takes one "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" a request. A batch of"},{"type":"text","text":" "},{"type":"text","text":"records from several sessions makes a request for each, in the order of each session’s first"},{"type":"text","text":" "},{"type":"text","text":"record. The members are:"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"client_id"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The records’ session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as the first and last 64 bits of the UUID in decimal, joined by a period; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session, so each such record is a request of its own"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"consent","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ad_user_data"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ad_personalization"},{"type":"text","text":", both "},{"type":"codeVoice","code":"DENIED"},{"type":"text","text":", so Google uses none of the events for advertising"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"events","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"One object per record: ","type":"text"},{"type":"codeVoice","code":"name"},{"text":", the event’s ","type":"text"},{"type":"codeVoice","code":"Event\/name"},{"text":" as it is; ","type":"text"},{"type":"codeVoice","code":"params"},{"text":", the event’s stored properties by name; and ","type":"text"},{"type":"codeVoice","code":"timestamp_micros"},{"text":", when it was tracked, in whole microseconds since 1970","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"params"},{"text":" also holds ","type":"text"},{"type":"codeVoice","code":"session_id"},{"text":", the session’s start in Unix milliseconds, the first 48 bits of","type":"text"},{"text":" ","type":"text"},{"text":"its version 7 ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", so Google Analytics groups the session’s events; it is left out for a","type":"text"},{"text":" ","type":"text"},{"text":"record with no session, or a session key of another version.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", no user properties, and no"},{"type":"text","text":" "},{"type":"codeVoice","code":"user_location"},{"type":"text","text":", "},{"type":"codeVoice","code":"ip_override"},{"type":"text","text":", "},{"type":"codeVoice","code":"device"},{"type":"text","text":" or "},{"type":"codeVoice","code":"user_agent"},{"type":"text","text":", so Google Analytics records no"},{"type":"text","text":" "},{"type":"text","text":"location or device for the events. The record’s vendor identifier and trace context, the"},{"type":"text","text":" "},{"type":"text","text":"standard context, and any other context value, aren’t sent. Google Analytics counts a user per"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":", so its users are sessions. No "},{"type":"codeVoice","code":"engagement_time_msec"},{"type":"text","text":" is sent, as Traffluent doesn’t"},{"type":"text","text":" "},{"type":"text","text":"measure engagement, so the events don’t count toward Google Analytics’ engagement time or"},{"type":"text","text":" "},{"type":"text","text":"engaged sessions, and its Realtime and Users reports can show no users while events arrive:"},{"type":"text","text":" "},{"type":"text","text":"check the event counts instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out. Google Analytics takes only strings, numbers and booleans as parameters, so an object or"},{"type":"text","text":" "},{"type":"text","text":"array is spread into a parameter for each value it holds, named after its path joined by "},{"type":"codeVoice","code":"_"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"cart_size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags_0"},{"type":"text","text":"), and a "},{"type":"codeVoice","code":"null"},{"type":"text","text":", such as an optional without a value or a redacted"},{"type":"text","text":" "},{"type":"text","text":"element of an array, is left out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event or parameter name"},{"type":"text","text":" "},{"type":"text","text":"breaks Google Analytics’ naming rules or is one it keeps for itself, one of more than 25"},{"type":"text","text":" "},{"type":"text","text":"parameters, one with a string over 100 bytes, one whose event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds"},{"type":"text","text":" "},{"type":"text","text":"a value JSON can’t, one whose timestamp is more than 71 hours before or 15 minutes after the"},{"type":"text","text":" "},{"type":"text","text":"batch is encoded, or has no microseconds form, and one too large for a request"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","type":"reference"},{"type":"text","text":"). "},{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","type":"reference"},{"type":"text","text":" returns them as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":". Google Analytics would answer 2xx to"},{"type":"text","text":" "},{"type":"text","text":"such an event and, under its default, relaxed validation, store it without the parameter that"},{"type":"text","text":" "},{"type":"text","text":"breaks a rule, or under a name it never checked. A Google Analytics 360 property takes values of"},{"type":"text","text":" "},{"type":"text","text":"up to 500 characters, but the encoder holds every property to the standard 100 bytes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Google Analytics takes an event up to 72 hours old; the encoder holds records to 71, the hour to"},{"type":"text","text":" "},{"type":"text","text":"spare for the request to reach Google and for clocks that disagree. Each request’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"EncodedRequest\/deadline"},{"type":"text","text":" is 71 hours after its oldest record was tracked, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"drops a request still being retried by then, every record of it, the younger ones included, and"},{"type":"text","text":" "},{"type":"text","text":"reports it as "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":", rather than send records"},{"type":"text","text":" "},{"type":"text","text":"Google Analytics would store as 72 hours old."}]},{"type":"paragraph","inlineContent":[{"text":"The Measurement Protocol has no field that identifies an event, so Google Analytics counts each","type":"text"},{"text":" ","type":"text"},{"text":"one it receives: a record sent again, by a retry after Google stored it, by a delivery that","type":"text"},{"text":" ","type":"text"},{"text":"sends a cancelled batch again, or by a store’s redelivery after a relaunch, is counted twice. A","type":"text"},{"text":" ","type":"text"},{"text":"record a store recovers keeps its session, so it is counted under the ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":" of its first send.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" splits each client’s records into requests within the encoder’s limit,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":" by default, and makes none for a batch with no record it can write, so","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for it. The Measurement Protocol answers 2xx to every request it","type":"text"},{"text":" ","type":"text"},{"text":"receives, a malformed one or one whose events it doesn’t store included, so a record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder sends is counted as delivered whatever Google Analytics makes of it, and a wrong","type":"text"},{"text":" ","type":"text"},{"text":"measurement ID or API secret is answered 2xx with nothing stored: check the property’s","type":"text"},{"text":" ","type":"text"},{"text":"Realtime event counts after setting the destination up. The bytes are the same for the same records,","type":"text"},{"text":" ","type":"text"},{"text":"and the same time, on every run and platform: no whitespace, object members in the order of","type":"text"},{"text":" ","type":"text"},{"text":"their names’ UTF-8 bytes.","type":"text"}]}],"kind":"content"}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder.swift#L101","fileName":"GoogleAnalyticsBatchEncoder.swift"},"externalID":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","symbolKind":"struct","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"title":"GoogleAnalyticsBatchEncoder","modules":[{"name":"GoogleAnalyticsEncoding"}],"role":"symbol"},"kind":"symbol","sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"identifier":{"url":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","interfaceLanguage":"swift"},"references":{"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"abstract":[{"text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","role":"collection","title":"GoogleAnalyticsEncoding","url":"\/documentation\/googleanalyticsencoding","type":"topic"},"doc://GoogleAnalyticsEncoding/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://Events/documentation/Events/Sensitive":{"abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"type":"topic","title":"Sensitive","role":"symbol","url":"\/documentation\/events\/sensitive","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/HTTPDestinations/HTTPDestination/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)":{"abstract":[{"type":"text","text":"A destination on a server that sends batches to the Google Analytics web or data stream of"},{"type":"text","text":" "},{"code":"measurementID","type":"codeVoice"},{"type":"text","text":", authenticated by its "},{"code":"apiSecret","type":"codeVoice"},{"type":"text","text":", with "},{"code":"URLSession.shared","type":"codeVoice"},{"type":"text","text":", retrying a"},{"type":"text","text":" "},{"type":"text","text":"send that fails for now with the waits of "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" on "},{"code":"clock","type":"codeVoice"},{"type":"text","text":"."}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" is "},{"type":"codeVoice","code":"URLSessionTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"GoogleAnalyticsBatchEncoder"},{"type":"text","text":"."}]},"type":"topic","title":"googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","role":"symbol","url":"\/documentation\/googleanalyticsencoding\/httpdestinations\/httpdestination\/googleanalytics(measurementid:apisecret:region:plan:backoff:clock:now:)","kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"googleAnalytics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"measurementID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"apiSecret"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO","text":"GoogleAnalyticsRegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO","text":"GoogleAnalyticsSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","text":"GoogleAnalyticsBatchEncoder"},{"kind":"text","text":">"}]},"doc://GoogleAnalyticsEncoding/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","title":"Swift.Sendable"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/transientStatuses":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientStatuses","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","text":"TransientStatus","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/transientstatuses","kind":"symbol","abstract":[{"type":"text","text":"No status beyond the 408, 429 and 5xx that "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries for every encoder."}],"role":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/transientStatuses","title":"transientStatuses"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/requests(for:)":{"role":"symbol","title":"requests(for:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"GoogleAnalyticsEncodingError","preciseIdentifier":"s:23GoogleAnalyticsEncoding0abC5ErrorO","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"code":"batch","type":"codeVoice"},{"text":" as the requests the Measurement Protocol takes, a client’s records in each, within","type":"text"},{"text":" ","type":"text"},{"text":"the encoder’s limit, with the records left out of them.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/requests(for:)"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder":{"navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"kind":"symbol","abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Google Analytics 4’s Measurement Protocol, so an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" on a server can send events to a web or data stream’s "},{"type":"codeVoice","code":"POST \/mp\/collect"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","title":"GoogleAnalyticsBatchEncoder","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/Failure":{"abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"type":"topic","title":"GoogleAnalyticsBatchEncoder.Failure","role":"symbol","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/failure","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"type":"topic","url":"\/documentation\/httpdestinations\/httpdestination","kind":"symbol","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"role":"symbol","navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","title":"HTTPDestination"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsEncodingError":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","abstract":[{"type":"text","text":"Why "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"title":"GoogleAnalyticsEncodingError","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsencodingerror","navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"type":"topic"},"doc://HTT