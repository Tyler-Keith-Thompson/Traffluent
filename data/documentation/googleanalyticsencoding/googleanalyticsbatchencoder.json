records left out of them."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","text":"BatchRequests","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:23GoogleAnalyticsEncoding0abC5ErrorO","text":"GoogleAnalyticsEncodingError","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/requests(for:)"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/batchLimit":{"type":"topic","abstract":[{"text":"The Measurement Protocol’s limits on one request: 25 events and 100,000 bytes of body, an","type":"text"},{"text":" ","type":"text"},{"text":"event’s included.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"title":"batchLimit","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/batchlimit"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/Failure":{"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/failure","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"role":"symbol","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"type":"topic","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure","title":"GoogleAnalyticsBatchEncoder.Failure","kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}]},"doc://GoogleAnalyticsEncoding/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","title":"Swift.Sendable"}}}