{"identifier":{"url":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of Google Analytics 4’s Measurement Protocol, so an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" on a server can send events to a web or data stream’s ","type":"text"},{"code":"POST \/mp\/collect","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS and Linux, make the destination with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, the stream’s API secret, this encoder and the Measurement"},{"type":"text","text":" "},{"type":"text","text":"Protocol’s limits:"}]},{"type":"codeListing","syntax":"swift","code":["let googleAnalytics = try HTTPDestination.googleAnalytics(","    measurementID: measurementID,  \/\/ the web or data stream's, G-…","    apiSecret: apiSecret,  \/\/ from the server's configuration, never an app's","    region: .global,  \/\/ or .eu, to have Google collect the data in the EU","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"text":"The encoder is for a server, and is compiled for macOS and Linux alone, as the Measurement","type":"text"},{"text":" ","type":"text"},{"text":"Protocol takes none of its requests without the stream’s API secret, which must stay on the","type":"text"},{"text":" ","type":"text"},{"text":"server: anyone holding it can send events to the property. A server forwarding an app’s events","type":"text"},{"text":" ","type":"text"},{"text":"remakes each ","type":"text"},{"type":"codeVoice","code":"EventRecord"},{"text":" with the app’s identifier, timestamp and ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", and hands","type":"text"},{"text":" ","type":"text"},{"text":"them to the destination; tracking them again through a tracker with ","type":"text"},{"type":"codeVoice","code":".sessions()"},{"text":" would send","type":"text"},{"text":" ","type":"text"},{"text":"every user as one ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each request’s body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" holding one client’s","type":"text"},{"text":" ","type":"text"},{"text":"events, oldest first, as the Measurement Protocol takes one ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" a request. A batch of","type":"text"},{"text":" ","type":"text"},{"text":"records from several sessions makes a request for each, in the order of each session’s first","type":"text"},{"text":" ","type":"text"},{"text":"record. The members are:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"client_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The records’ session, its ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", as the first and last 64 bits of the UUID in decimal, joined by a period; the record’s own ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":" the same way when its context has no session, so each such record is a request of its own","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"consent"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ad_user_data"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ad_personalization"},{"type":"text","text":", both "},{"type":"codeVoice","code":"DENIED"},{"type":"text","text":", so Google uses none of the events for advertising"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"events","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"One object per record: "},{"type":"codeVoice","code":"name"},{"type":"text","text":", the event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":" as it is; "},{"type":"codeVoice","code":"params"},{"type":"text","text":", the event’s stored properties by name; and "},{"type":"codeVoice","code":"timestamp_micros"},{"type":"text","text":", when it was tracked, in whole microseconds since 1970"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"params"},{"text":" also holds ","type":"text"},{"type":"codeVoice","code":"session_id"},{"text":", the session’s start in Unix milliseconds, the first 48 bits of","type":"text"},{"text":" ","type":"text"},{"text":"its version 7 ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", so Google Analytics groups the session’s events; it is left out for a","type":"text"},{"text":" ","type":"text"},{"text":"record with no session, or a session key of another version.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", no user properties, and no"},{"type":"text","text":" "},{"type":"codeVoice","code":"user_location"},{"type":"text","text":", "},{"type":"codeVoice","code":"ip_override"},{"type":"text","text":", "},{"type":"codeVoice","code":"device"},{"type":"text","text":" or "},{"type":"codeVoice","code":"user_agent"},{"type":"text","text":", so Google Analytics records no"},{"type":"text","text":" "},{"type":"text","text":"location or device for the events. The record’s vendor identifier and trace context, the"},{"type":"text","text":" "},{"type":"text","text":"standard context, and any other context value, aren’t sent. Google Analytics counts a user per"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":", so its users are sessions. No "},{"type":"codeVoice","code":"engagement_time_msec"},{"type":"text","text":" is sent, as Traffluent doesn’t"},{"type":"text","text":" "},{"type":"text","text":"measure engagement, so the events don’t count toward Google Analytics’ engagement time or"},{"type":"text","text":" "},{"type":"text","text":"engaged sessions, and its Realtime and Users reports can show no users while events arrive:"},{"type":"text","text":" "},{"type":"text","text":"check the event counts instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out. Google Analytics takes only strings, numbers and booleans as parameters, so an object or"},{"type":"text","text":" "},{"type":"text","text":"array is spread into a parameter for each value it holds, named after its path joined by "},{"type":"codeVoice","code":"_"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"cart_size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags_0"},{"type":"text","text":"), and a "},{"type":"codeVoice","code":"null"},{"type":"text","text":", such as an optional without a value or a redacted"},{"type":"text","text":" "},{"type":"text","text":"element of an array, is left out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event or parameter name"},{"type":"text","text":" "},{"type":"text","text":"breaks Google Analytics’ naming rules or is one it keeps for itself, one of more than 25"},{"type":"text","text":" "},{"type":"text","text":"parameters, one with a string over 100 bytes, one whose event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds"},{"type":"text","text":" "},{"type":"text","text":"a value JSON can’t, one whose timestamp is more than 72 hours before or 15 minutes after the"},{"type":"text","text":" "},{"type":"text","text":"batch is encoded, or has no microseconds form, and one too large for a request"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","isActive":true,"type":"reference"},{"type":"text","text":"). "},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"type":"text","text":" returns them as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":". Google Analytics would answer 2xx to"},{"type":"text","text":" "},{"type":"text","text":"such an event and, under its default, relaxed validation, store it without the parameter that"},{"type":"text","text":" "},{"type":"text","text":"breaks a rule, or under a name it never checked. A Google Analytics 360 property takes values of"},{"type":"text","text":" "},{"type":"text","text":"up to 500 characters, but the encoder holds every property to the standard 100 bytes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Measurement Protocol has no field that identifies an event, so Google Analytics counts each"},{"type":"text","text":" "},{"type":"text","text":"one it receives: a record sent again, by a retry after Google stored it, by a delivery that"},{"type":"text","text":" "},{"type":"text","text":"sends a cancelled batch again, or by a store’s redelivery after a relaunch, is counted twice."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" splits each client’s records into requests within the encoder’s limit,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":" by default, and makes none for a batch with no record it can write, so","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for it. The Measurement Protocol answers 2xx to every request it","type":"text"},{"text":" ","type":"text"},{"text":"receives, a malformed one or one whose events it doesn’t store included, so a record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder sends is counted as delivered whatever Google Analytics makes of it, and a wrong","type":"text"},{"text":" ","type":"text"},{"text":"measurement ID or API secret is answered 2xx with nothing stored: check the property’s","type":"text"},{"text":" ","type":"text"},{"text":"Realtime event counts after setting the destination up. The bytes are the same for the same records,","type":"text"},{"text":" ","type":"text"},{"text":"and the same time, on every run and platform: no whitespace, object members in the order of","type":"text"},{"text":" ","type":"text"},{"text":"their names’ UTF-8 bytes.","type":"text"}]}]}],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)"],"generated":true,"title":"Instance Methods"},{"anchor":"Type-Aliases","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure"],"generated":true,"title":"Type Aliases"},{"anchor":"Type-Properties","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit"],"generated":true,"title":"Type Properties"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"]]},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"navigatorTitle":[{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"remoteSource":{"fileName":"GoogleAnalyticsBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder.swift#L92"},"symbolKind":"struct","role":"symbol","externalID":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","roleHeading":"Structure","modules":[{"name":"GoogleAnalyticsEncoding"}],"title":"GoogleAnalyticsBatchEncoder"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP"],"title":"Conforms To"}],"references":{"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsEncodingError":{"type":"topic","abstract":[{"text":"Why ","type":"text"},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","isActive":true},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for the batch.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"title":"GoogleAnalyticsEncodingError","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsencodingerror","navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","title":"HTTPDestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"role":"symbol","url":"\/documentation\/httpdestinations\/httpdestination","kind":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"type":"topic","kind":"symbol","url":"\/documentation\/googleanalyticsencoding","abstract":[{"type":"text","text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol."}],"title":"GoogleAnalyticsEncoding","role":"collection","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","title":"BatchEncoder","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"type":"text","text":" sends."}],"role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","kind":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnal