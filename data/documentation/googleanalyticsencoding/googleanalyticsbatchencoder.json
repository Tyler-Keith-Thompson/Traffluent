{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)"],"title":"Instance Methods","generated":true},{"anchor":"Type-Aliases","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure"],"title":"Type Aliases","generated":true},{"anchor":"Type-Properties","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit"],"title":"Type Properties","generated":true}],"hierarchy":{"paths":[["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder"]}],"sections":[],"abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Google Analytics 4’s Measurement Protocol, so an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" on a server can send events to a web or data stream’s "},{"type":"codeVoice","code":"POST \/mp\/collect"},{"type":"text","text":"."}],"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS and Linux, make the destination with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, the stream’s API secret, this encoder and the Measurement"},{"type":"text","text":" "},{"type":"text","text":"Protocol’s limits:"}]},{"code":["let googleAnalytics = try HTTPDestination.googleAnalytics(","    measurementID: measurementID,  \/\/ the web or data stream's, G-…","    apiSecret: apiSecret,  \/\/ from the server's configuration, never an app's","    region: .global,  \/\/ or .eu, to have Google collect the data in the EU","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The encoder is for a server, and is compiled for macOS and Linux alone, as the Measurement"},{"type":"text","text":" "},{"type":"text","text":"Protocol takes none of its requests without the stream’s API secret, which must stay on the"},{"type":"text","text":" "},{"type":"text","text":"server: anyone holding it can send events to the property. A server forwarding an app’s events"},{"type":"text","text":" "},{"type":"text","text":"remakes each "},{"code":"EventRecord","type":"codeVoice"},{"type":"text","text":" with the app’s identifier, timestamp and "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", and hands"},{"type":"text","text":" "},{"type":"text","text":"them to the destination; tracking them again through a tracker with "},{"code":".sessions()","type":"codeVoice"},{"type":"text","text":" would send"},{"type":"text","text":" "},{"type":"text","text":"every user as one "},{"code":"client_id","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Each request’s body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" holding one client’s","type":"text"},{"text":" ","type":"text"},{"text":"events, oldest first, as the Measurement Protocol takes one ","type":"text"},{"code":"client_id","type":"codeVoice"},{"text":" a request. A batch of","type":"text"},{"text":" ","type":"text"},{"text":"records from several sessions makes a request for each, in the order of each session’s first","type":"text"},{"text":" ","type":"text"},{"text":"record. The members are:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"client_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The records’ session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as the first and last 64 bits of the UUID in decimal, joined by a period; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session, so each such record is a request of its own","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"consent","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ad_user_data"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ad_personalization"},{"text":", both ","type":"text"},{"type":"codeVoice","code":"DENIED"},{"text":", so Google uses none of the events for advertising","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"events","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"One object per record: "},{"code":"name","type":"codeVoice"},{"type":"text","text":", the event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":" as it is; "},{"code":"params","type":"codeVoice"},{"type":"text","text":", the event’s stored properties by name; and "},{"code":"timestamp_micros","type":"codeVoice"},{"type":"text","text":", when it was tracked, in whole microseconds since 1970"}]}]]]},{"type":"paragraph","inlineContent":[{"code":"params","type":"codeVoice"},{"type":"text","text":" also holds "},{"code":"session_id","type":"codeVoice"},{"type":"text","text":", the session’s start in Unix milliseconds, the first 48 bits of"},{"type":"text","text":" "},{"type":"text","text":"its version 7 "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", so Google Analytics groups the session’s events; it is left out for a"},{"type":"text","text":" "},{"type":"text","text":"record with no session, or a session key of another version."}]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"type":"codeVoice","code":"user_id"},{"text":", no user properties, and no","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"user_location"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ip_override"},{"text":", ","type":"text"},{"type":"codeVoice","code":"device"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"user_agent"},{"text":", so Google Analytics records no","type":"text"},{"text":" ","type":"text"},{"text":"location or device for the events. The record’s vendor identifier and trace context, the","type":"text"},{"text":" ","type":"text"},{"text":"standard context, and any other context value, aren’t sent. Google Analytics counts a user per","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":", so its users are sessions. No ","type":"text"},{"type":"codeVoice","code":"engagement_time_msec"},{"text":" is sent, as Traffluent doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"measure engagement, so the events don’t count toward Google Analytics’ engagement time or","type":"text"},{"text":" ","type":"text"},{"text":"engaged sessions, and its Realtime and Users reports can show no users while events arrive:","type":"text"},{"text":" ","type":"text"},{"text":"check the event counts instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out. Google Analytics takes only strings, numbers and booleans as parameters, so an object or"},{"type":"text","text":" "},{"type":"text","text":"array is spread into a parameter for each value it holds, named after its path joined by "},{"code":"_","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"cart_size","type":"codeVoice"},{"type":"text","text":", "},{"code":"tags_0","type":"codeVoice"},{"type":"text","text":"), and a "},{"code":"null","type":"codeVoice"},{"type":"text","text":", such as an optional without a value or a redacted"},{"type":"text","text":" "},{"type":"text","text":"element of an array, is left out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event or parameter name"},{"type":"text","text":" "},{"type":"text","text":"breaks Google Analytics’ naming rules or is one it keeps for itself, one of more than 25"},{"type":"text","text":" "},{"type":"text","text":"parameters, one with a string over 100 bytes, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds"},{"type":"text","text":" "},{"type":"text","text":"a value JSON can’t, one whose timestamp is more than 72 hours before or 15 minutes after the"},{"type":"text","text":" "},{"type":"text","text":"batch is encoded, or has no microseconds form, and one too large for a request"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","isActive":true,"type":"reference"},{"type":"text","text":"). "},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":". Google Analytics would answer 2xx to"},{"type":"text","text":" "},{"type":"text","text":"such an event and, under its default, relaxed validation, store it without the parameter that"},{"type":"text","text":" "},{"type":"text","text":"breaks a rule, or under a name it never checked. A Google Analytics 360 property takes values of"},{"type":"text","text":" "},{"type":"text","text":"up to 500 characters, but the encoder holds every property to the standard 100 bytes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Measurement Protocol has no field that identifies an event, so Google Analytics counts each"},{"type":"text","text":" "},{"type":"text","text":"one it receives: a record sent again, by a retry after Google stored it, by a delivery that"},{"type":"text","text":" "},{"type":"text","text":"sends a cancelled batch again, or by a store’s redelivery after a relaunch, is counted twice."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"type":"text","text":" splits each client’s records into requests within the encoder’s limit,"},{"type":"text","text":" "},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"type":"text","text":" by default, and makes none for a batch with no record it can write, so"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for it. The Measurement Protocol answers 2xx to every request it"},{"type":"text","text":" "},{"type":"text","text":"receives, a malformed one or one whose events it doesn’t store included, so a record the"},{"type":"text","text":" "},{"type":"text","text":"encoder sends is counted as delivered whatever Google Analytics makes of it, and a wrong"},{"type":"text","text":" "},{"type":"text","text":"measurement ID or API secret is answered 2xx with nothing stored: check the property’s"},{"type":"text","text":" "},{"type":"text","text":"Realtime event counts after setting the destination up. The bytes are the same for the same records,"},{"type":"text","text":" "},{"type":"text","text":"and the same time, on every run and platform: no whitespace, object members in the order of"},{"type":"text","text":" "},{"type":"text","text":"their names’ UTF-8 bytes."}]}],"kind":"content"}],"metadata":{"title":"GoogleAnalyticsBatchEncoder","remoteSource":{"fileName":"GoogleAnalyticsBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder.swift#L92"},"modules":[{"name":"GoogleAnalyticsEncoding"}],"symbolKind":"struct","roleHeading":"Structure","externalID":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"role":"symbol"},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"title":"BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"text":" sends.","type":"text"}]},"doc://GoogleAnalyticsEncoding/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/Failure":{"title":"GoogleAnalyticsBatchEncoder.Failure","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/failure","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"role":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure","type":"topic"},"doc://Events/documentation/Events/Sensitive":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"url":"\/documentation\/events\/sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"title":"Sensitive","kind":"symbol","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/init(plan:limit:now:)":{"role":"symbol","abstract":[{"type":"text","text":"An encoder of the events "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, splitting each batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":", and leaving out"},{"type":"text","text":" "},{"type":"text","text":"the records tracked too long before, or too far after, the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives."}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/init(plan:limit:now:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(plan:limit:now:)","kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"title":"HTTPDestination","kind":"symbol","url":"\/documentation\/httpdestinations\/httpdestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"topic"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsEncodingError":{"title":"GoogleAnalyticsEncodingError","type":"topic","navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsencodingerror"},"doc://GoogleAnalyticsEncoding/s8SendableP":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"abstract":[{"type":"text","text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol."}],"url":"\/documentation\/googleanalyticsencoding","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","title":"GoogleAnalyticsEncoding"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/requests(for:)":{"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/requests(for:)","abstract":[{"code":"batch","type":"codeVoice"},{"text":" as the requests the Measurement Protocol takes, a client’s records in each, within","type":"text"},{"text":" ","type":"text"},{"text":"the encoder’s limit, with the records left out of them.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"requests(for:)","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"GoogleAnalyticsEncodingError","preciseIdentifier":"s:23GoogleAnalyticsEncoding0abC5ErrorO","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/HTTPDestinations/HTTPDestination/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)":{"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"type":"text","text":" is "},{"code":"URLSessionTransport","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Encoding","type":"codeVoice"},{"type":"text","text":" is "},{"code":"GoogleAnalyticsBatchEncoder","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"googleAnalytics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"measurementID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"apiSecret"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO","text":"GoogleAnalyticsRegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO","text":"GoogleAnalyticsSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","text":"GoogleAnalyticsBatchEncoder"},{"kind":"text","text":">"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","type":"topic","role":"symbol","abstract":[{"text":"A destination on a server that sends batches to the Google Analytics web or data stream of","type":"text"},{"text":" ","type":"text"},{"code":"measurementID","type":"codeVoice"},{"text":", authenticated by its ","type":"text"},{"code":"apiSecret","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"URLSession.shared","type":"codeVoice"},{"text":", retrying a","type":"text"},{"text":" ","type":"text"},{"text":"send that fails for now with the waits of ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/httpdestinations\/httpdestination\/googleanalytics(measurementid:apisecret:region:plan:backoff:clock:now:)","title":"googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder":{"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder","abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"type":"text","text":" of Google Analytics 4’s Measurement Protocol, so an"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" on a server can send events to a web or data stream’s "},{"code":"POST \/mp\/collect","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","type":"topic","kind":"symbol","title":"GoogleAnalyticsBatchEncoder","navigatorTitle":[{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/batchLimit":{"title":"batchLimit","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/batchlimit","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"}],"kind":"symbol","role":"symbol","abstract":[{"text":"The Measurement Protocol’s limits on one request: 25 events and 100,000 bytes of body, an","type":"text"},{"text":" ","type":"text"},{"text":"event’s included.","type":"text"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit"}}}