{"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of Google Analytics 4’s Measurement Protocol, so an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" on a server can send events to a web or data stream’s ","type":"text"},{"code":"POST \/mp\/collect","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To"}],"metadata":{"modules":[{"name":"GoogleAnalyticsEncoding"}],"remoteSource":{"fileName":"GoogleAnalyticsBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder.swift#L99"},"role":"symbol","title":"GoogleAnalyticsBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"externalID":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","roleHeading":"Structure","symbolKind":"struct"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS and Linux, make the destination with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, the stream’s API secret, this encoder and the Measurement"},{"type":"text","text":" "},{"type":"text","text":"Protocol’s limits:"}]},{"type":"codeListing","syntax":"swift","code":["let googleAnalytics = try HTTPDestination.googleAnalytics(","    measurementID: measurementID,  \/\/ the web or data stream's, G-…","    apiSecret: apiSecret,  \/\/ from the server's configuration, never an app's","    region: .global,  \/\/ or .eu, to have Google collect the data in the EU","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The encoder is for a server, and is compiled for macOS and Linux alone, as the Measurement"},{"type":"text","text":" "},{"type":"text","text":"Protocol takes none of its requests without the stream’s API secret, which must stay on the"},{"type":"text","text":" "},{"type":"text","text":"server: anyone holding it can send events to the property. A server forwarding an app’s events"},{"type":"text","text":" "},{"type":"text","text":"remakes each "},{"type":"codeVoice","code":"EventRecord"},{"type":"text","text":" with the app’s identifier, timestamp and "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", and hands"},{"type":"text","text":" "},{"type":"text","text":"them to the destination; tracking them again through a tracker with "},{"type":"codeVoice","code":".sessions()"},{"type":"text","text":" would send"},{"type":"text","text":" "},{"type":"text","text":"every user as one "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each request’s body is a JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":" holding one client’s"},{"type":"text","text":" "},{"type":"text","text":"events, oldest first, as the Measurement Protocol takes one "},{"code":"client_id","type":"codeVoice"},{"type":"text","text":" a request. A batch of"},{"type":"text","text":" "},{"type":"text","text":"records from several sessions makes a request for each, in the order of each session’s first"},{"type":"text","text":" "},{"type":"text","text":"record. The members are:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"client_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The records’ session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as the first and last 64 bits of the UUID in decimal, joined by a period; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session, so each such record is a request of its own","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"consent"}]}],[{"type":"paragraph","inlineContent":[{"code":"ad_user_data","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ad_personalization","type":"codeVoice"},{"text":", both ","type":"text"},{"code":"DENIED","type":"codeVoice"},{"text":", so Google uses none of the events for advertising","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"events"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"One object per record: "},{"type":"codeVoice","code":"name"},{"type":"text","text":", the event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":" as it is; "},{"type":"codeVoice","code":"params"},{"type":"text","text":", the event’s stored properties by name; and "},{"type":"codeVoice","code":"timestamp_micros"},{"type":"text","text":", when it was tracked, in whole microseconds since 1970"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"params"},{"type":"text","text":" also holds "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":", the session’s start in Unix milliseconds, the first 48 bits of"},{"type":"text","text":" "},{"type":"text","text":"its version 7 "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", so Google Analytics groups the session’s events; it is left out for a"},{"type":"text","text":" "},{"type":"text","text":"record with no session, or a session key of another version."}]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"type":"codeVoice","code":"user_id"},{"text":", no user properties, and no","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"user_location"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ip_override"},{"text":", ","type":"text"},{"type":"codeVoice","code":"device"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"user_agent"},{"text":", so Google Analytics records no","type":"text"},{"text":" ","type":"text"},{"text":"location or device for the events. The record’s vendor identifier and trace context, the","type":"text"},{"text":" ","type":"text"},{"text":"standard context, and any other context value, aren’t sent. Google Analytics counts a user per","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":", so its users are sessions. No ","type":"text"},{"type":"codeVoice","code":"engagement_time_msec"},{"text":" is sent, as Traffluent doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"measure engagement, so the events don’t count toward Google Analytics’ engagement time or","type":"text"},{"text":" ","type":"text"},{"text":"engaged sessions, and its Realtime and Users reports can show no users while events arrive:","type":"text"},{"text":" ","type":"text"},{"text":"check the event counts instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out. Google Analytics takes only strings, numbers and booleans as parameters, so an object or","type":"text"},{"text":" ","type":"text"},{"text":"array is spread into a parameter for each value it holds, named after its path joined by ","type":"text"},{"code":"_","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"cart_size","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tags_0","type":"codeVoice"},{"text":"), and a ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", such as an optional without a value or a redacted","type":"text"},{"text":" ","type":"text"},{"text":"element of an array, is left out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event or parameter name","type":"text"},{"text":" ","type":"text"},{"text":"breaks Google Analytics’ naming rules or is one it keeps for itself, one of more than 25","type":"text"},{"text":" ","type":"text"},{"text":"parameters, one with a string over 100 bytes, one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds","type":"text"},{"text":" ","type":"text"},{"text":"a value JSON can’t, one whose timestamp is more than 71 hours before or 15 minutes after the","type":"text"},{"text":" ","type":"text"},{"text":"batch is encoded, or has no microseconds form, and one too large for a request","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","isActive":true,"type":"reference"},{"text":"). ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":". Google Analytics would answer 2xx to","type":"text"},{"text":" ","type":"text"},{"text":"such an event and, under its default, relaxed validation, store it without the parameter that","type":"text"},{"text":" ","type":"text"},{"text":"breaks a rule, or under a name it never checked. A Google Analytics 360 property takes values of","type":"text"},{"text":" ","type":"text"},{"text":"up to 500 characters, but the encoder holds every property to the standard 100 bytes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Google Analytics takes an event up to 72 hours old; the encoder holds records to 71, the hour to"},{"type":"text","text":" "},{"type":"text","text":"spare for the request to reach Google and for clocks that disagree. Each request’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"EncodedRequest\/deadline"},{"type":"text","text":" is 71 hours after its oldest record was tracked, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"drops a request still being retried by then, every record of it, the younger ones included, and"},{"type":"text","text":" "},{"type":"text","text":"reports it as "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":", rather than send records"},{"type":"text","text":" "},{"type":"text","text":"Google Analytics would store as 72 hours old."}]},{"type":"paragraph","inlineContent":[{"text":"The Measurement Protocol has no field that identifies an event, so Google Analytics counts each","type":"text"},{"text":" ","type":"text"},{"text":"one it receives: a record sent again, by a retry after Google stored it, by a delivery that","type":"text"},{"text":" ","type":"text"},{"text":"sends a cancelled batch again, or by a store’s redelivery after a relaunch, is counted twice.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits each client’s records into requests within the encoder’s limit,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","type":"reference"},{"text":" by default, and makes none for a batch with no record it can write, so","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for it. The Measurement Protocol answers 2xx to every request it","type":"text"},{"text":" ","type":"text"},{"text":"receives, a malformed one or one whose events it doesn’t store included, so a record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder sends is counted as delivered whatever Google Analytics makes of it, and a wrong","type":"text"},{"text":" ","type":"text"},{"text":"measurement ID or API secret is answered 2xx with nothing stored: check the property’s","type":"text"},{"text":" ","type":"text"},{"text":"Realtime event counts after setting the destination up. The bytes are the same for the same records,","type":"text"},{"text":" ","type":"text"},{"text":"and the same time, on every run and platform: no whitespace, object members in the order of","type":"text"},{"text":" ","type":"text"},{"text":"their names’ UTF-8 bytes.","type":"text"}]}]}],"sections":[],"identifier":{"url":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure"],"title":"Type Aliases","generated":true,"anchor":"Type-Aliases"},{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"}],"kind":"symbol","references":{"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/init(plan:limit:now:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":")","kind":"text"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/init(plan:limit:now:)","abstract":[{"type":"text","text":"An encoder of the events "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, splitting each batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":", and leaving out"},{"type":"text","text":" "},{"type":"text","text":"the records tracked too long before, or too far after, the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives."}],"type":"topic","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)","role":"symbol","title":"init(plan:limit:now:)","kind":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","abstract":[{"text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol.","type":"text"}],"role":"collection","type":"topic","kind":"symbol","title":"GoogleAnalyticsEncoding","url":"\/documentation\/googleanalyticsencoding"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsEncodingError":{"abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"role":"symbol","title":"GoogleAnalyticsEncodingError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"type":"topic","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsencodingerror","kind":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/batchLimit":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/batchlimit","abstract":[{"type":"text","text":"The Measurement Protocol’s limits on one request: 25 events and 100,000 bytes of body, an"},{"type":"text","text":" "},{"type":"text","text":"event’s included."}],"type":"topic","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","role":"symbol","title":"batchLimit","kind":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/HTTPDestinations/HTTPDestination/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","url":"\/documentation\/googleanalyticsencoding\/httpdestinations\/httpdestination\/googleanalytics(measurementid:apisecret:region:plan:backoff:clock:now:)","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A destination on a server that sends batches to the Google Analytics web or data stream of"},{"type":"text","text":" "},{"code":"measurementID","type":"codeVoice"},{"type":"text","text":", authenticated by its "},{"code":"apiSecret","type":"codeVoice"},{"type":"text","text":", with "},{"code":"URLSession.shared","type":"codeVoice"},{"type":"text","text":", retrying a"},{"type":"text","text":" "},{"type":"text","text":"send that fails for now with the waits of "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" on "},{"code":"clock","type":"codeVoice"},{"type":"text","text":"."}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"URLSessionTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"GoogleAnalyticsBatchEncoder","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"title":"googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"googleAnalytics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"measurementID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"apiSecret"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO","text":"GoogleAnalyticsRegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO","text":"GoogleAnalyticsSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","text":"GoogleAnalyticsBatchEncoder"},{"kind":"text","text":">"}]},"doc://GoogleAnalyticsEncoding/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s8SendableP"},"doc://GoogleAnalyticsEncoding/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","url":"\/documentation\/httpdestinations\/httpdestination","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"title":"HTTPDestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}]},"doc://Events/documentation/Events/Sensitive":{"navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","url":"\/documentation\/events\/sensitive","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"title":"Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/Failure":{"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/failure","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure","navigatorTitle":[{"kind":"identifier","text":"Failure"}],"role":"symbol","title":"GoogleAnalyticsBatchEncoder.Failure","kind":"symbol","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"url":"\/documentation\/httpdestinations\/batchencoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"text":" sends.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","role":"symbol","title":"BatchEncoder","kind":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/requests(for:)":{"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/requests(for:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"text":"<","kind":"text"},{"text":"GoogleAnalyticsEncodingError","kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0abC5ErrorO"},{"text":">","kind":"text"}],"abstract":[{"type":"codeVoice","code":"batch"},{"type":"text","text":" as the requests the Measurement Protocol takes, a client’s records in each, within"},{"type":"text","text":" "},{"type":"text","text":"the encoder’s limit, with the records left out of them."}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","role":"symbol","kind":"symbol","title":"requests(for:)","type":"topic"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder":{"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of Google Analytics 4’s Measurement Protocol, so an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" on a server can send events to a web or data stream’s ","type":"text"},{"code":"POST \/mp\/collect","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","title":"GoogleAnalyticsBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder","kind":"symbol"}}}