{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"On macOS and Linux, make the destination with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, the stream’s API secret, this encoder and the Measurement"},{"type":"text","text":" "},{"type":"text","text":"Protocol’s limits:"}],"type":"paragraph"},{"code":["let googleAnalytics = try HTTPDestination.googleAnalytics(","    measurementID: measurementID,  \/\/ the web or data stream's, G-…","    apiSecret: apiSecret,  \/\/ from the server's configuration, never an app's","    region: .global,  \/\/ or .eu, to have Google collect the data in the EU","    plan: plan)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The encoder is for a server, and is compiled for macOS and Linux alone, as the Measurement","type":"text"},{"text":" ","type":"text"},{"text":"Protocol takes none of its requests without the stream’s API secret, which must stay on the","type":"text"},{"text":" ","type":"text"},{"text":"server: anyone holding it can send events to the property. A server forwarding an app’s events","type":"text"},{"text":" ","type":"text"},{"text":"remakes each ","type":"text"},{"type":"codeVoice","code":"EventRecord"},{"text":" with the app’s identifier, timestamp and ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", and hands","type":"text"},{"text":" ","type":"text"},{"text":"them to the destination; tracking them again through a tracker with ","type":"text"},{"type":"codeVoice","code":".sessions()"},{"text":" would send","type":"text"},{"text":" ","type":"text"},{"text":"every user as one ","type":"text"},{"type":"codeVoice","code":"client_id"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each request’s body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":" holding one client’s"},{"type":"text","text":" "},{"type":"text","text":"events, oldest first, as the Measurement Protocol takes one "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" a request. A batch of"},{"type":"text","text":" "},{"type":"text","text":"records from several sessions makes a request for each, in the order of each session’s first"},{"type":"text","text":" "},{"type":"text","text":"record. The members are:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"client_id"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The records’ session, its "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", as the first and last 64 bits of the UUID in decimal, joined by a period; the record’s own "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":" the same way when its context has no session, so each such record is a request of its own"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"consent"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ad_user_data"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ad_personalization"},{"type":"text","text":", both "},{"type":"codeVoice","code":"DENIED"},{"type":"text","text":", so Google uses none of the events for advertising"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"events","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"One object per record: "},{"code":"name","type":"codeVoice"},{"type":"text","text":", the event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":" as it is; "},{"code":"params","type":"codeVoice"},{"type":"text","text":", the event’s stored properties by name; and "},{"code":"timestamp_micros","type":"codeVoice"},{"type":"text","text":", when it was tracked, in whole microseconds since 1970"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"code":"params","type":"codeVoice"},{"text":" also holds ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":", the session’s start in Unix milliseconds, the first 48 bits of","type":"text"},{"text":" ","type":"text"},{"text":"its version 7 ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", so Google Analytics groups the session’s events; it is left out for a","type":"text"},{"text":" ","type":"text"},{"text":"record with no session, or a session key of another version.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"code":"user_id","type":"codeVoice"},{"type":"text","text":", no user properties, and no"},{"type":"text","text":" "},{"code":"user_location","type":"codeVoice"},{"type":"text","text":", "},{"code":"ip_override","type":"codeVoice"},{"type":"text","text":", "},{"code":"device","type":"codeVoice"},{"type":"text","text":" or "},{"code":"user_agent","type":"codeVoice"},{"type":"text","text":", so Google Analytics records no"},{"type":"text","text":" "},{"type":"text","text":"location or device for the events. The record’s vendor identifier and trace context, the"},{"type":"text","text":" "},{"type":"text","text":"standard context, and any other context value, aren’t sent. Google Analytics counts a user per"},{"type":"text","text":" "},{"code":"client_id","type":"codeVoice"},{"type":"text","text":", so its users are sessions. No "},{"code":"engagement_time_msec","type":"codeVoice"},{"type":"text","text":" is sent, as Traffluent doesn’t"},{"type":"text","text":" "},{"type":"text","text":"measure engagement, so the events don’t count toward Google Analytics’ engagement time or"},{"type":"text","text":" "},{"type":"text","text":"engaged sessions, and its Realtime and Users reports can show no users while events arrive:"},{"type":"text","text":" "},{"type":"text","text":"check the event counts instead."}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out. Google Analytics takes only strings, numbers and booleans as parameters, so an object or","type":"text"},{"text":" ","type":"text"},{"text":"array is spread into a parameter for each value it holds, named after its path joined by ","type":"text"},{"code":"_","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"cart_size","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tags_0","type":"codeVoice"},{"text":"), and a ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", such as an optional without a value or a redacted","type":"text"},{"text":" ","type":"text"},{"text":"element of an array, is left out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event or parameter name"},{"type":"text","text":" "},{"type":"text","text":"breaks Google Analytics’ naming rules or is one it keeps for itself, one of more than 25"},{"type":"text","text":" "},{"type":"text","text":"parameters, one with a string over 100 bytes, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds"},{"type":"text","text":" "},{"type":"text","text":"a value JSON can’t, one whose timestamp is more than 72 hours before or 15 minutes after the"},{"type":"text","text":" "},{"type":"text","text":"batch is encoded, or has no microseconds form, and one too large for a request"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError"},{"type":"text","text":"). "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)"},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":". Google Analytics would answer 2xx to"},{"type":"text","text":" "},{"type":"text","text":"such an event and, under its default, relaxed validation, store it without the parameter that"},{"type":"text","text":" "},{"type":"text","text":"breaks a rule, or under a name it never checked. A Google Analytics 360 property takes values of"},{"type":"text","text":" "},{"type":"text","text":"up to 500 characters, but the encoder holds every property to the standard 100 bytes."}],"type":"paragraph"},{"inlineContent":[{"text":"The Measurement Protocol has no field that identifies an event, so Google Analytics counts each","type":"text"},{"text":" ","type":"text"},{"text":"one it receives: a record sent again, by a retry after Google stored it, by a delivery that","type":"text"},{"text":" ","type":"text"},{"text":"sends a cancelled batch again, or by a store’s redelivery after a relaunch, is counted twice.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits each client’s records into requests within the encoder’s limit,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","type":"reference"},{"text":" by default, and makes none for a batch with no record it can write, so","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for it. The Measurement Protocol answers 2xx to every request it","type":"text"},{"text":" ","type":"text"},{"text":"receives, a malformed one or one whose events it doesn’t store included, so a record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder sends is counted as delivered whatever Google Analytics makes of it, and a wrong","type":"text"},{"text":" ","type":"text"},{"text":"measurement ID or API secret is answered 2xx with nothing stored: check the property’s","type":"text"},{"text":" ","type":"text"},{"text":"Realtime event counts after setting the destination up. The bytes are the same for the same records,","type":"text"},{"text":" ","type":"text"},{"text":"and the same time, on every run and platform: no whitespace, object members in the order of","type":"text"},{"text":" ","type":"text"},{"text":"their names’ UTF-8 bytes.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding"]]},"abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" of Google Analytics 4’s Measurement Protocol, so an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" on a server can send events to a web or data stream’s ","type":"text"},{"code":"POST \/mp\/collect","type":"codeVoice"},{"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"},"metadata":{"roleHeading":"Structure","title":"GoogleAnalyticsBatchEncoder","symbolKind":"struct","modules":[{"name":"GoogleAnalyticsEncoding"}],"navigatorTitle":[{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"remoteSource":{"fileName":"GoogleAnalyticsBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder.swift#L92"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsBatchEncoder"}],"role":"symbol","externalID":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV"},"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)"]},{"title":"Type Aliases","generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure"]},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP"]}],"variants":[{"paths":["\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/Failure":{"abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Failure"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/failure","type":"topic","kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/Failure","title":"GoogleAnalyticsBatchEncoder.Failure","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"role":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","url":"\/documentation\/googleanalyticsencoding","role":"collection","kind":"symbol","type":"topic","title":"GoogleAnalyticsEncoding","abstract":[{"type":"text","text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol."}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder":{"abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Google Analytics 4’s Measurement Protocol, so an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" on a server can send events to a web or data stream’s "},{"type":"codeVoice","code":"POST \/mp\/collect"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"title":"GoogleAnalyticsBatchEncoder","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder","role":"symbol","type":"topic","navigatorTitle":[{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}]},"doc://GoogleAnalyticsEncoding/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s8SendableP"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"text":" sends.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"title":"BatchEncoder","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}]},"doc://GoogleAnalyticsEncoding/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsEncodingError":{"title":"GoogleAnalyticsEncodingError","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","navigatorTitle":[{"text":"GoogleAnalyticsEncodingError","kind":"identifier"}],"type":"topic","abstract":[{"text":"Why ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsEncodingError","kind":"identifier"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsencodingerror","kind":"symbol","role":"symbol"},"doc://Events/documentation/Events/Sensitive":{"title":"Sensitive","kind":"symbol","role":"symbol","url":"\/documentation\/events\/sensitive","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","kind":"symbol","url":"\/documentation\/httpdestinations\/httpdestination","role":"symbol","title":"HTTPDestination","type":"topic","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/init(plan:limit:now:)":{"abstract":[{"type":"text","text":"An encoder of the events "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, splitting each batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":", and leaving out"},{"type":"text","text":" "},{"type":"text","text":"the records tracked too long before, or too far after, the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives."}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/init(plan:limit:now:)","type":"topic","kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/init(plan:limit:now:)","title":"init(plan:limit:now:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":")","kind":"text"}],"role":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/requests(for:)":{"type":"topic","title":"requests(for:)","role":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/requests(for:)","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/requests(for:)","abstract":[{"code":"batch","type":"codeVoice"},{"type":"text","text":" as the requests the Measurement Protocol takes, a client’s records in each, within"},{"type":"text","text":" "},{"type":"text","text":"the encoder’s limit, with the records left out of them."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"GoogleAnalyticsEncodingError","preciseIdentifier":"s:23GoogleAnalyticsEncoding0abC5ErrorO","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/HTTPDestinations/HTTPDestination/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)":{"abstract":[{"text":"A destination on a server that sends batches to the Google Analytics web or data stream of","type":"text"},{"text":" ","type":"text"},{"code":"measurementID","type":"codeVoice"},{"text":", authenticated by its ","type":"text"},{"code":"apiSecret","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"URLSession.shared","type":"codeVoice"},{"text":", retrying a","type":"text"},{"text":" ","type":"text"},{"text":"send that fails for now with the waits of ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"googleAnalytics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"measurementID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"apiSecret","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GoogleAnalyticsRegion","kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":">, ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"GoogleAnalyticsSetupError","kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"URLSessionTransport","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV"},{"text":", ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV"},{"text":">","kind":"text"}],"title":"googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/httpdestinations\/httpdestination\/googleanalytics(measurementid:apisecret:region:plan:backoff:clock:now:)","role":"symbol","conformance":{"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"URLSessionTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"GoogleAnalyticsBatchEncoder","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"type":"topic"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/batchLimit":{"title":"batchLimit","kind":"symbol","role":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder\/batchlimit","abstract":[{"text":"The Measurement Protocol’s limits on one request: 25 events and 100,000 bytes of body, an","type":"text"},{"text":" ","type":"text"},{"text":"event’s included.","type":"text"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"type":"topic"}}}