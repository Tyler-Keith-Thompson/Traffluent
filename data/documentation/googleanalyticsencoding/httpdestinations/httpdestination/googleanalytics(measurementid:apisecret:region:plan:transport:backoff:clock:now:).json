ms to "},{"type":"codeVoice","code":"HTTPTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"GoogleAnalyticsBatchEncoder"},{"type":"text","text":"."}]},"extendedModule":"HTTPDestinations","symbolKind":"method","roleHeading":"Type Method"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"googleAnalytics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"measurementID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"apiSecret"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO","text":"GoogleAnalyticsRegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff"},{"kind":"text","text":" = ExponentialBackoff(), "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO","text":"GoogleAnalyticsSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","text":"GoogleAnalyticsBatchEncoder"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"measurementID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The web or data stream’s measurement ID, "},{"type":"codeVoice","code":"G-"},{"type":"text","text":" followed by letters and"},{"type":"text","text":" "},{"type":"text","text":"digits, from the stream’s details in Google Analytics’ Admin. Whitespace and newlines"},{"type":"text","text":" "},{"type":"text","text":"around it are trimmed off."}]}]},{"name":"apiSecret","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An API secret of the stream, from its Measurement Protocol API secrets in"},{"type":"text","text":" "},{"type":"text","text":"Google Analytics’ Admin. Whitespace and newlines around it are trimmed off."}]}]},{"name":"region","content":[{"inlineContent":[{"type":"text","text":"Where Google collects the data: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/global"},{"type":"text","text":", its default"},{"type":"text","text":" "},{"type":"text","text":"endpoint, or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/eu"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}]}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}]},{"name":"backoff","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}]}]},{"name":"clock","content":[{"inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}],"type":"paragraph"}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, and each request’s deadline is checked"},{"type":"text","text":" "},{"type":"text","text":"against before it is sent; the system’s clock by default."}]}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The destination posts to the Measurement Protocol’s "},{"type":"codeVoice","code":"\/mp\/collect"},{"type":"text","text":" endpoint of "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"the measurement ID and API secret in its query, encoded by a "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","isActive":true},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" within "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" that leaves out each record"},{"type":"text","text":" "},{"type":"text","text":"tracked more than 71 hours before, or more than 15 minutes after, the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives as a"},{"type":"text","text":" "},{"type":"text","text":"batch is encoded: Google Analytics takes 72, and the hour to spare is for the request to"},{"type":"text","text":" "},{"type":"text","text":"reach Google and clocks that disagree. It sends no trace context in its header fields. It"},{"type":"text","text":" "},{"type":"text","text":"retries no response, a 5xx, 408 or 429, and drops and reports any other status. A request"},{"type":"text","text":" "},{"type":"text","text":"still undelivered 71 hours after its oldest record was tracked, by the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives,"},{"type":"text","text":" "},{"type":"text","text":"isn’t sent again: the whole request is dropped, its younger records too, and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":", as Google Analytics would store its"},{"type":"text","text":" "},{"type":"text","text":"oldest records as 72 hours old. The Measurement Protocol answers"},{"type":"text","text":" "},{"type":"text","text":"2xx to every request it receives, so a wrong measurement ID or API secret, or a request it"},{"type":"text","text":" "},{"type":"text","text":"can’t read, is answered 2xx with nothing stored: check the property’s Realtime report after"},{"type":"text","text":" "},{"type":"text","text":"setting it up."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The API secret lets anyone holding it send events to the property, so this factory is"},{"type":"text","text":" "},{"type":"text","text":"for a server, and must never be given a secret in an app. It is compiled for macOS and"},{"type":"text","text":" "},{"type":"text","text":"Linux alone, so an app for iOS, iPadOS, tvOS, watchOS, visionOS or Mac Catalyst that calls"},{"type":"text","text":" "},{"type":"text","text":"it fails to compile. A Mac app (AppKit or SwiftUI) compiles it, but the factory refuses it"},{"type":"text","text":" "},{"type":"text","text":"at run time: it throws "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","isActive":true},{"type":"text","text":" when the main bundle is an"},{"type":"text","text":" "},{"code":".app","type":"codeVoice"},{"type":"text","text":" or an "},{"code":".appex","type":"codeVoice"},{"type":"text","text":". To get an app’s events here, send them to a server of yours that"},{"type":"text","text":" "},{"type":"text","text":"makes this destination; see the module’s article for what that server does."}],"type":"paragraph"},{"inlineContent":[{"text":"The secret is in the query of every request’s URL, so don’t log the destination, its","type":"text"},{"text":" ","type":"text"},{"text":"requests or a transport’s URLs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The encoder logs a notice for each event and property of ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" named as Google Analytics","type":"text"},{"text":" ","type":"text"},{"text":"refuses, or keeps for itself, as every record of that event will be skipped","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","isActive":true},{"type":"text","text":" in an app or an app extension,"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID","isActive":true},{"type":"text","text":" for a measurement ID that is empty or only"},{"type":"text","text":" "},{"type":"text","text":"whitespace, "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID","isActive":true},{"type":"text","text":" for one that isn’t "},{"type":"codeVoice","code":"G-"},{"type":"text","text":" "},{"type":"text","text":"followed by uppercase ASCII letters and digits, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret","isActive":true},{"type":"text","text":" for a secret that is empty or only"},{"type":"text","text":" "},{"type":"text","text":"whitespace."}],"type":"paragraph"}],"type":"aside"}]}],"kind":"symbol","abstract":[{"text":"A destination on a server that sends batches to the Google Analytics web or data stream of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"measurementID"},{"text":", authenticated by its ","type":"text"},{"type":"codeVoice","code":"apiSecret"},{"text":", through ","type":"text"},{"type":"codeVoice","code":"transport"},{"text":", retrying a send that","type":"text"},{"text":" ","type":"text"},{"text":"fails for now with the waits of ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"clock"},{"text":".","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError"],"title":"Sending to Google Analytics","anchor":"Sending-to-Google-Analytics","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/googleanalyticsencoding\/httpdestinations\/httpdestination\/googleanalytics(measurementid:apisecret:region:plan:transport:backoff:clock:now:)"]}],"references":{"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/appBundle":{"type":"topic","kind":"symbol","title":"GoogleAnalyticsSetupError.appBundle","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","abstract":[{"type":"text","text":"The process is an app or an app extension: its main bundle is an "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or "},{"type":"codeVoice","code":".appex"},{"type":"text","text":" "},{"type":"text","text":"directory. The factory is compiled for macOS so a server written for it can run there, and a"},{"type":"text","text":" "},{"type":"text","text":"Mac app compiles it too, but an app ships the API secret to everyone who installs it, and"},{"type":"text","text":" "},{"type":"text","text":"anyone holding the secret can send events to the property. Send the app’s events to a relay"},{"type":"text","text":" "},{"type":"text","text":"of yours instead, which forwards them to Google Analytics."}],"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"appBundle","kind":"identifier"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/appbundle"},"doc://Events/documentation/Events/EventSchema":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventSchema","kind":"identifier"}],"type":"topic","url":"\/documentation\/events\/eventschema","navigatorTitle":[{"text":"EventSchema","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"text":"The shape of an event type: its name, its schema version, its consent category and its stored","type":"text"},{"text":" ","type":"text"},{"text":"properties in declaration order, as a value tooling reads.","type":"text"}],"title":"EventSchema","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsRegion":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsRegion","kind":"identifier"}],"navigatorTitle":[{"text":"GoogleAnalyticsRegion","kind":"identifier"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","role":"symbol","title":"GoogleAnalyticsRegion","type":"topic","abstract":[{"text":"Where Google 