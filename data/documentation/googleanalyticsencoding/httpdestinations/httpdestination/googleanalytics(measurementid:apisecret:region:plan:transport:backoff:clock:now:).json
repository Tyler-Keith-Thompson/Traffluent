surementid","type":"topic","title":"GoogleAnalyticsSetupError.malformedMeasurementID","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"malformedMeasurementID","kind":"identifier"}],"abstract":[{"text":"The measurement ID isn’t ","type":"text"},{"type":"codeVoice","code":"G-"},{"text":" followed by uppercase ASCII letters and digits, the form of","type":"text"},{"text":" ","type":"text"},{"text":"every web stream’s ID (","type":"text"},{"type":"codeVoice","code":"G-1A2B3C4D5E"},{"text":"). The Measurement Protocol answers a request for a","type":"text"},{"text":" ","type":"text"},{"text":"stream it doesn’t know with 2xx and stores nothing, so the factory refuses a malformed ID","type":"text"},{"text":" ","type":"text"},{"text":"when the destination is made. A stream ID, an app stream’s Firebase app ID, a Universal","type":"text"},{"text":" ","type":"text"},{"text":"Analytics ID (","type":"text"},{"type":"codeVoice","code":"UA-…"},{"text":") or a Google tag ID (","type":"text"},{"type":"codeVoice","code":"GT-…"},{"text":") is refused as well.","type":"text"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror","type":"topic","title":"GoogleAnalyticsSetupError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsSetupError","kind":"identifier"}],"abstract":[{"type":"text","text":"Why "},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:transport:backoff:clock:now:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"navigatorTitle":[{"text"