 ","kind":"text"},{"text":"HTTPDestination","kind":"identifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"}],"type":"topic","navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"role":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"url":"\/documentation\/googleanalyticsencoding","type":"topic","title":"GoogleAnalyticsEncoding","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","kind":"symbol","abstract":[{"text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol.","type":"text"}],"role":"collection"},"doc://Events/documentation/Events/EventSchema":{"navigatorTitle":[{"kind":"identifier","text":"EventSchema"}],"url":"\/documentation\/events\/eventschema","abstract":[{"text":"The shape of an event type: its name, its schema version, its consent category and its stored","type":"text"},{"text":" ","type":"text"},{"text":"properties in declaration order, as a value tooling reads.","type":"text"}],"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventSchema"}],"type":"topic","role":"symbol","title":"EventSchema"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"url":"\/documentation\/httpdestinations\/batchencoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"type":"topic","role":"symbol","title":"BatchEncoder"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/malformedMeasurementID":{"type":"topic","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID","abstract":[{"type":"text","text":"The measurement ID isn’t "},{"code":"G-","type":"codeVoice"},{"type":"text","text":" followed by uppercase ASCII letters and digits, the form of"},{"type":"text","text":" "},{"type":"text","text":"every web stream’s ID ("},{"code":"G-1A2B3C4D5E","type":"codeVoice"},{"type":"text","text":"). The Measurement Protocol answers a request for a"},{"type":"text","text":" "},{"type":"text","text":"stream it doesn’t know with 2xx and stores nothing, so the factory refuses a malformed ID"},{"type":"text","text":" "},{"type":"text","text":"when the destination is made. A stream ID, an app stream’s Firebase app ID, a Universal"},{"type":"text","text":" "},{"type":"text","text":"Analytics ID ("},{"code":"UA-…","type":"codeVoice"},{"type":"text","text":") or a Google tag ID ("},{"code":"GT-…","type":"codeVoice"},{"type":"text","text":") is refused as well."}],"role":"symbol","kind":"symbol","title":"GoogleAnalyticsSetupError.malformedMeasurementID","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/malformedmeasurementid","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"malformedMeasurementID","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"title":"HTTPDestination","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","url":"\/documentation\/httpdestinati