D:apiSecret:region:plan:transport:backoff:clock:now:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"googleAnalytics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"measurementID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"apiSecret","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GoogleAnalyticsRegion","kind":"typeIdentifier","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":" = ExponentialBackoff(), ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":"> = ContinuousClock(), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":" = { Date.now }) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"GoogleAnalyticsSetupError","kind":"typeIdentifier","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"typeIdentifier","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV"},{"text":">","kind":"text"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The web or data stream’s measurement ID, "},{"code":"G-","type":"codeVoice"},{"type":"text","text":" followed by letters and"},{"type":"text","text":" "},{"type":"text","text":"digits, from the stream’s details in Google Analytics’ Admin. Whitespace and newlines"},{"type":"text","text":" "},{"type":"text","text":"around it are trimmed off."}]}],"name":"measurementID"},{"content":[{"type":"paragraph","inlineContent":[{"text":"An API secret of the stream, from its Measurement Protocol API secrets in","type":"text"},{"text":" ","type":"text"},{"text":"Google Analytics’ Admin. Whitespace and newlines around it are trimmed off.","type":"text"}]}],"name":"apiSecret"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Where Google collects the data: ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/global","isActive":true,"type":"reference"},{"text":", its default","type":"text"},{"text":" ","type":"text"},{"text":"endpoint, or ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/eu","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"name":"region"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}],"name":"plan"},{"content":[{"inlineContent":[{"type":"text","text":"What sends each request."}],"type":"paragraph"}],"name":"transport"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}]}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}],"name":"clock"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, and each request’s deadline is checked"},{"type":"text","text":" "},{"type":"text","text":"against before it is sent; the system’s clock by default."}]}],"name":"now"}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"The destination posts to the Measurement Protocol’s ","type":"text"},{"code":"\/mp\/collect","type":"codeVoice"},{"text":" endpoint of ","type":"text"},{"code":"region","type":"codeVoice"},{"text":", with","type":"text"},{"text":" ","type":"text"},{"text":"the measurement ID and API secret in its query, encoded by a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","type":"reference"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" within ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","type":"reference"},{"text":" that leaves out each record","type":"text"},{"text":" ","type":"text"},{"text":"tracked more than 71 hours before, or more than 15 minutes after, the time ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" gives as a","type":"text"},{"text":" ","type":"text"},{"text":"batch is encoded: Google Analytics takes 72, and the hour to spare is for the request to","type":"text"},{"text":" ","type":"text"},{"text":"reach Google and clocks that disagree. It sends no trace context in its header fields. It","type":"text"},{"text":" ","type":"text"},{"text":"retries no response, a 5xx, 408 or 429, and drops and reports any other status. A request","type":"text"},{"text":" ","type":"text"},{"text":"still undelivered 71 hours after its oldest record was tracked, by the time ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" gives,","type":"text"},{"text":" ","type":"text"},{"text":"isn’t sent again: the whole request is dropped, its younger records too, and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":", as Google Analytics would store its","type":"text"},{"text":" ","type":"text"},{"text":"oldest records as 72 hours old. The Measurement Protocol answers","type":"text"},{"text":" ","type":"text"},{"text":"2xx to every request it receives, so a wrong measurement ID or API secret, or a request it","type":"text"},{"text":" ","type":"text"},{"text":"can’t read, is answered 2xx with nothing stored: check the property’s Realtime report after","type":"text"},{"text":" ","type":"text"},{"text":"setting it up.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The API secret lets anyone holding it send events to the property, so this factory is"},{"type":"text","text":" "},{"type":"text","text":"for a server, and must never be given a secret in an app. It is compiled for macOS and"},{"type":"text","text":" "},{"type":"text","text":"Linux alone, so an app for iOS, iPadOS, tvOS, watchOS, visionOS or Mac Catalyst that calls"},{"type":"text","text":" "},{"type":"text","text":"it fails to compile. A Mac app (AppKit or SwiftUI) compiles it, but the factory refuses it"},{"type":"text","text":" "},{"type":"text","text":"at run time: it throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle"},{"type":"text","text":" when the main bundle is an"},{"type":"text","text":" "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".appex"},{"type":"text","text":". To get an app’s events here, send them to a server of yours that"},{"type":"text","text":" "},{"type":"text","text":"makes this destination; see the module’s article for what that server does."}],"type":"paragraph"},{"inlineContent":[{"text":"The secret is in the query of every request’s URL, so don’t log the destination, its","type":"text"},{"text":" ","type":"text"},{"text":"requests or a transport’s URLs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The encoder logs a notice for each event and property of "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" named as Google Analytics"},{"type":"text","text":" "},{"type":"text","text":"refuses, or keeps for itself, as every record of that event will be skipped"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","type":"reference"},{"type":"text","text":")."}],"type":"paragraph"},{"style":"note","name":"Throws","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle"},{"text":" in an app or an app extension,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID"},{"text":" for a measurement ID that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID"},{"text":" for one that isn’t ","type":"text"},{"code":"G-","type":"codeVoice"},{"text":" ","type":"text"},{"text":"followed by uppercase ASCII letters and digits, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret"},{"text":" for a secret that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace.","type":"text"}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/googleanalyticsencoding\/httpdestinations\/httpdestination\/googleanalytics(mea