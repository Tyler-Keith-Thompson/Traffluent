"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"googleAnalytics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"measurementID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"apiSecret"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GoogleAnalyticsRegion","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TrackingPlan","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ExponentialBackoff","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"kind":"text","text":" = ExponentialBackoff(), "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"GoogleAnalyticsSetupError","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"HTTPDestination","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"GoogleAnalyticsBatchEncoder","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The web or data stream’s measurement ID, "},{"type":"codeVoice","code":"G-"},{"type":"text","text":" followed by letters and"},{"type":"text","text":" "},{"type":"text","text":"digits, from the stream’s details in Google Analytics’ Admin. Whitespace and newlines"},{"type":"text","text":" "},{"type":"text","text":"around it are trimmed off."}]}],"name":"measurementID"},{"content":[{"type":"paragraph","inlineContent":[{"text":"An API secret of the stream, from its Measurement Protocol API secrets in","type":"text"},{"text":" ","type":"text"},{"text":"Google Analytics’ Admin. Whitespace and newlines around it are trimmed off.","type":"text"}]}],"name":"apiSecret"},{"content":[{"inlineContent":[{"type":"text","text":"Where Google collects the data: "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/global","isActive":true},{"type":"text","text":", its default"},{"type":"text","text":" "},{"type":"text","text":"endpoint, or "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/eu","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"name":"region"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}]}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}],"name":"transport"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}]}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}],"name":"clock"},{"content":[{"inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, and each request’s deadline is checked"},{"type":"text","text":" "},{"type":"text","text":"against before it is sent; the system’s clock by default."}],"type":"paragraph"}],"name":"now"}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"text":"The destination.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The destination posts to the Measurement Protocol’s ","type":"text"},{"code":"\/mp\/collect","type":"codeVoice"},{"text":" endpoint of ","type":"text"},{"code":"region","type":"codeVoice"},{"text":", with","type":"text"},{"text":" ","type":"text"},{"text":"the measurement ID and API secret in its query, encoded by a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" within ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit"},{"text":" that leaves out each record","type":"text"},{"text":" ","type":"text"},{"text":"tracked more than 71 hours before, or more than 15 minutes after, the time ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" gives as a","type":"text"},{"text":" ","type":"text"},{"text":"batch is encoded: Google Analytics takes 72, and the hour to spare is for the request to","type":"text"},{"text":" ","type":"text"},{"text":"reach Google and clocks that disagree. It sends no trace context in its header fields. It","type":"text"},{"text":" ","type":"text"},{"text":"retries no response, a 5xx, 408 or 429, and drops and reports any other status. A request","type":"text"},{"text":" ","type":"text"},{"text":"still undelivered 71 hours after its oldest record was tracked, by the time ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" gives,","type":"text"},{"text":" ","type":"text"},{"text":"isn’t sent again: the whole request is dropped, its younger records too, and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":", as Google Analytics would store its","type":"text"},{"text":" ","type":"text"},{"text":"oldest records as 72 hours old. The Measurement Protocol answers","type":"text"},{"text":" ","type":"text"},{"text":"2xx to every request it receives, so a wrong measurement ID or API secret, or a request it","type":"text"},{"text":" ","type":"text"},{"text":"can’t read, is answered 2xx with nothing stored: check the property’s Realtime report after","type":"text"},{"text":" ","type":"text"},{"text":"setting it up.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The API secret lets anyone holding it send events to the property, so this factory is"},{"type":"text","text":" "},{"type":"text","text":"for a server, and must never be given a secret in an app. It is compiled for macOS and"},{"type":"text","text":" "},{"type":"text","text":"Linux alone, so an app for iOS, iPadOS, tvOS, watchOS, visionOS or Mac Catalyst that calls"},{"type":"text","text":" "},{"type":"text","text":"it fails to compile. A Mac app (AppKit or SwiftUI) compiles it, but the factory refuses it"},{"type":"text","text":" "},{"type":"text","text":"at run time: it throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle"},{"type":"text","text":" when the main bundle is an"},{"type":"text","text":" "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".appex"},{"type":"text","text":". To get an app’s events here, send them to a server of yours that"},{"type":"text","text":" "},{"type":"text","text":"makes this destination; see the module’s article for what that server does."}]},{"type":"paragraph","inlineContent":[{"text":"The secret is in the query of every request’s URL, so don’t log the destination, its","type":"text"},{"text":" ","type":"text"},{"text":"requests or a transport’s URLs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The encoder logs a notice for each event and property of ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" named as Google Analytics","type":"text"},{"text":" ","type":"text"},{"text":"refuses, or keeps for itself, as every record of that event will be skipped","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError"},{"text":").","type":"text"}]},{"type":"aside","style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","isActive":true,"type":"reference"},{"text":" in an app or an app extension,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID","isActive":true,"type":"reference"},{"text":" for a measurement ID that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace, ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID","isActive":true,"type":"reference"},{"text":" for one that isn’t ","type":"text"},{"code":"G-","type":"codeVoice"},{"text":" ","type":"text"},{"text":"followed by uppercase ASCII letters and digits, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret","isActive":true,"type":"reference"},{"text":" for a secret that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace.","type":"text"}]}]}]}],"kind":"symbol","metadata":{"symbolKind":"method","modules":[{"name":"GoogleAnalyticsEncoding","relatedModules":["HTTPDestinations"]}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"