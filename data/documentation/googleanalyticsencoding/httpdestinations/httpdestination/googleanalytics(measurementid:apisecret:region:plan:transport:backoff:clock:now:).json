:"The JSON Schema (draft 2020-12) of every event an app tracks: one document per event and an"},{"type":"text","text":" "},{"type":"text","text":"index, exported from the events’ "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"type":"text","text":" values."}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/HTTPDestinations":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/httpdestinations","role":"collection","type":"topic","title":"HTTPDestinations","abstract":[]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","url":"\/documentation\/googleanalyticsencoding","role":"collection","kind":"symbol","type":"topic","title":"GoogleAnalyticsEncoding","abstract":[{"type":"text","text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExponentialBackoff"}],"navigatorTitle":[{"kind":"identifier","text":"ExponentialBackoff"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","kind":"symbol","url":"\/documentation\/httpdestinations\/exponentialbackoff","role":"symbol","title":"ExponentialBackoff","type":"topic","abstract":[{"type":"text","text":"How long "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" waits before each new attempt at a batch that wasn’t delivered:"},{"type":"text","text":" "},{"type":"text","text":"binary exponential backoff, each wait twice the one before, up to a maximum."}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/emptyAPISecret":{"kind":"symbol","title":"GoogleAnalyticsSetupError.emptyAPISecret","role":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/emptyapisecret","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret","abstract":[{"text":"The API secret is empty, or only whitespace. The Measurement Protocol stores nothing for a","type":"text"},{"text":" ","type":"text"},{"text":"request without one.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"emptyAPISecret"}],"type":"topic"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/malformedMeasurementID":{"title":"GoogleAnalyticsSetupError.malformedMeasurementID","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The measurement ID isn’t "},{"type":"codeVoice","code":"G-"},{"type":"text","text":" followed by uppercase ASCII letters and digits, the form of"},{"type":"text","text":" "},{"type":"text","text":"every web stream’s ID ("},{"type":"codeVoice","code":"G-1A2B3C4D5E"},{"type":"text","text":"). The Measurement Protocol answers a request for a"},{"type":"text","text":" "},{"type":"text","text":"stream it doesn’t know with 2xx and stores nothing, so the factory refuses a malformed ID"},{"type":"text","text":" "},{"type":"text","text":"when the destination is made. A stream ID, an app stream’s Firebase app ID, a Universal"},{"type":"text","text":" "},{"type":"text","text":"Analytics ID ("},{"type":"codeVoice","code":"UA-…"},{"type":"text","text":") or a Google tag ID ("},{"type":"codeVoice","code":"GT-…"},{"type":"text","text":") is refused as well."}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID