mentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/emptyMeasurementID":{"title":"GoogleAnalyticsSetupError.emptyMeasurementID","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID","abstract":[{"text":"The measurement ID is empty, or only whitespace.","type":"text"}],"kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/emptymeasurementid","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"emptyMeasurementID","kind":"identifier"}],"role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff":{"navigatorTitle":[{"text":"ExponentialBackoff","kind":"identifier"}],"url":"\/documentation\/httpdestinations\/exponentialbackoff","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExponentialBackoff","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","kind":"symbol","abstract":[{"text":"How long ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"text":" waits before each new attempt at a batch that wasn’t delivered:","type":"text"},{"text":" ","type":"text"},{"text":"binary exponential backoff, each nominal wait twice the one before, up to a maximum, with","type":"text"},{"text":" ","type":"text"},{"text":"jitter.","type":"text"}],"title":"ExponentialBackoff"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/malformedMeasurementID":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID","title":"GoogleAnalyticsSetupError.malformedMeasurementID","abstract":[{"type":"text","text":"The measurement ID isn’t "},{"type":"codeVoice","code":"G-"},{"type":"text","text":" followed by uppercase ASCII letters and digits, the form of"},{"type":"text","text":" "},{"type":"text","text":"every web stream’s ID ("},{"type":"codeVoice","code":"G-1A2B3C4D5E"},{"type":"text","text":"). The Measurement Protocol answers a request for a"},{"type":"text","text":" "},{"type":"text","text":"stream it doesn’t know with 2xx and stores nothing, so the factory refuses a malformed ID"},{"type":"text","text":" "},{"type":"text","text":"when the destination is made. A stream ID, an app stream’s Firebase app ID, a Universal"},{"type":"text","text":" "},{"type":"text","text":"Analytics ID ("},{"type":"codeVoice","code":"UA-…"},{"type":"text","text":") or a Google tag ID ("},{"type":"codeVoice","code":"GT-…"},{"type":"text","text":") is refused as well."}],"kind":"symbol","type":"topic","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/malformedmeasurementid","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"malformedMeasurementID"}],"role":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan":{"navigatorTitle":[{"text":"TrackingPlan","kind":"identifier"}],"url":"\/documentation\/trackingplans\/trackingplan","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlan","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","kind":"symbol","abstract":[{"type":"text","text":"The JSON Schema (draft 2020-12) of every event an app tracks: one document per event and an"},{"type":"text","text":" "},{"type":"text","text":"index, exported from the events’ "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true},{"type":"text","text":" values."}],"title":"TrackingPlan"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsRegion":{"identifier":"doc:\/\