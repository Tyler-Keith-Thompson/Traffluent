:"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"GoogleAnalyticsSetupError","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"HTTPDestination","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"GoogleAnalyticsBatchEncoder","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"measurementID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The web or data stream’s measurement ID, "},{"type":"codeVoice","code":"G-"},{"type":"text","text":" followed by letters and"},{"type":"text","text":" "},{"type":"text","text":"digits, from the stream’s details in Google Analytics’ Admin. Whitespace and newlines"},{"type":"text","text":" "},{"type":"text","text":"around it are trimmed off."}]}]},{"name":"apiSecret","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An API secret of the stream, from its Measurement Protocol API secrets in"},{"type":"text","text":" "},{"type":"text","text":"Google Analytics’ Admin. Whitespace and newlines around it are trimmed off."}]}]},{"name":"region","content":[{"type":"paragraph","inlineContent":[{"text":"Where Google collects the data: ","type":"text"},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/global","isActive":true},{"text":", its default","type":"text"},{"text":" ","type":"text"},{"text":"endpoint, or ","type":"text"},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/eu","isActive":true},{"text":".","type":"text"}]}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}]},{"name":"transport","content":[{"inlineContent":[{"text":"What sends each request.","type":"text"}],"type":"paragraph"}]},{"name":"backoff","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}]}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, and each request’s deadline is checked"},{"type":"text","text":" "},{"type":"text","text":"against before it is sent; the system’s clock by default."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"The destination.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The destination posts to the Measurement Protocol’s "},{"type":"codeVoice","code":"\/mp\/collect"},{"type":"text","text":" endpoint of "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"the measurement ID and API secret in its query, encoded by a "},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" within "},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"type":"text","text":" that leaves out each record"},{"type":"text","text":" "},{"type":"text","text":"tracked more than 71 hours before, or more than 15 minutes after, the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives as a"},{"type":"text","text":" "},{"type":"text","text":"batch is encoded: Google Analytics takes 72, and the hour to spare is for the request to"},{"type":"text","text":" "},{"type":"text","text":"reach Google and clocks that disagree. It sends no trace context in its header fields. It"},{"type":"text","text":" "},{"type":"text","text":"retries no response, a 5xx, 408 or 429, and drops and reports any other status. A request"},{"type":"text","text":" "},{"type":"text","text":"still undelivered 71 hours after its oldest record was tracked, by the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives,"},{"type":"text","text":" "},{"type":"text","text":"isn’t sent again: the whole request is dropped, its younger records too, and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":", as Google Analytics would store its"},{"type":"text","text":" "},{"type":"text","text":"oldest records as 72 hours old. The Measurement Protocol answers"},{"type":"text","text":" "},{"type":"text","text":"2xx to every request it receives, so a wrong measurement ID or API secret, or a request it"},{"type":"text","text":" "},{"type":"text","text":"can’t read, is answered 2xx with nothing stored: check the property’s Realtime report after"},{"type":"text","text":" "},{"type":"text","text":"setting it up."}],"type":"paragraph"},{"inlineContent":[{"text":"The API secret lets anyone holding it send events to the property, so this factory is","type":"text"},{"text":" ","type":"text"},{"text":"for a server, and must never be given a secret in an app. It is compiled for macOS and","type":"text"},{"text":" ","type":"text"},{"text":"Linux alone, so an app for iOS, iPadOS, tvOS, watchOS, visionOS or Mac Catalyst that calls","type":"text"},{"text":" ","type":"text"},{"text":"it fails to compile. A Mac app (AppKit or SwiftUI) compiles it, but the factory refuses it","type":"text"},{"text":" ","type":"text"},{"text":"at run time: it throws ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","isActive":true,"type":"reference"},{"text":" when the main bundle is an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".app"},{"text":" or an ","type":"text"},{"type":"codeVoice","code":".appex"},{"text":". To get an app’s events here, send them to a server of yours that","type":"text"},{"text":" ","type":"text"},{"text":"makes this destination; see the module’s article for what that server does.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The secret is in the query of every request’s URL, so don’t log the destination, its","type":"text"},{"text":" ","type":"text"},{"text":"requests or a transport’s URLs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The encoder logs a notice for each event and property of ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" named as Google Analytics","type":"text"},{"text":" ","type":"text"},{"text":"refuses, or keeps for itself, as every record of that event will be skipped","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError"},{"text":").","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","isActive":true},{"text":" in an app or an app extension,","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID","isActive":true},{"text":" for a measurement ID that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace, ","type":"text"},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID","isActive":true},{"text":" for one that isn’t ","type":"text"},{"type":"codeVoice","code":"G-"},{"text":" ","type":"text"},{"text":"followed by uppercase ASCII letters and digits, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret","isActive":true},{"text":" for a secret that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"}],"kind":"content"}],"metadata":{"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"text":