ntifier":"s:23GoogleAnalyticsEncoding0aB6RegionO","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff"},{"kind":"text","text":" = ExponentialBackoff(), "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"GoogleAnalyticsSetupError","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"GoogleAnalyticsBatchEncoder","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"},{"kind":"text","text":">"}]}]},{"kind":"parameters","parameters":[{"name":"measurementID","content":[{"inlineContent":[{"type":"text","text":"The web or data stream’s measurement ID, "},{"code":"G-","type":"codeVoice"},{"type":"text","text":" followed by letters and"},{"type":"text","text":" "},{"type":"text","text":"digits, from the stream’s details in Google Analytics’ Admin. Whitespace and newlines"},{"type":"text","text":" "},{"type":"text","text":"around it are trimmed off."}],"type":"paragraph"}]},{"name":"apiSecret","content":[{"inlineContent":[{"type":"text","text":"An API secret of the stream, from its Measurement Protocol API secrets in"},{"type":"text","text":" "},{"type":"text","text":"Google Analytics’ Admin. Whitespace and newlines around it are trimmed off."}],"type":"paragraph"}]},{"name":"region","content":[{"type":"paragraph","inlineContent":[{"text":"Where Google collects the data: ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/global","type":"reference","isActive":true},{"text":", its default","type":"text"},{"text":" ","type":"text"},{"text":"endpoint, or ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/eu","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}]},{"name":"backoff","content":[{"type":"paragraph","inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, with full jitter, by default.","type":"text"}]}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, and each request’s deadline is checked"},{"type":"text","text":" "},{"type":"text","text":"against before it is sent; the system’s clock by default."}]}]}]},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The destination.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination posts to the Measurement Protocol’s "},{"type":"codeVoice","code":"\/mp\/collect"},{"type":"text","text":" endpoint of "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"the measurement ID and API secret in its query, encoded by a "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","isActive":true},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" within "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" that leaves out each record"},{"type":"text","text":" "},{"type":"text","text":"tracked more than 71 hours before, or more than 15 minutes after, the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives as a"},{"type":"text","text":" "},{"type":"text","text":"batch is encoded: Google Analytics takes 72, and the hour to spare is for the request to"},{"type":"text","text":" "},{"type":"text","text":"reach Google and clocks that disagree. It sends no trace context in its header fields. It"},{"type":"text","text":" "},{"type":"text","text":"retries no response, a 5xx, 408 or 429, and drops and reports any other status. A request"},{"type":"text","text":" "},{"type":"text","text":"still undelivered 71 hours after its oldest record was tracked, by the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives,"},{"type":"text","text":" "},{"type":"text","text":"isn’t sent again: the whole request is dropped, its younger records too, and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":", as Google Analytics would store its"},{"type":"text","text":" "},{"type":"text","text":"oldest records as 72 hours old. The Measurement Protocol answers"},{"type":"text","text":" "},{"type":"text","text":"2xx to every request it receives, so a wrong measurement ID or API secret, or a request it"},{"type":"text","text":" "},{"type":"text","text":"can’t read, is answered 2xx with nothing stored: check the property’s Realtime report after"},{"type":"text","text":" "},{"type":"text","text":"setting it up."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The API secret lets anyone holding it send events to the property, so this factory is"},{"type":"text","text":" "},{"type":"text","text":"for a server, and must never be given a secret in an app. It is compiled for macOS and"},{"type":"text","text":" "},{"type":"text","text":"Linux alone, so an app for iOS, iPadOS, tvOS, watchOS, visionOS or Mac Catalyst that calls"},{"type":"text","text":" "},{"type":"text","text":"it fails to compile. A Mac app (AppKit or SwiftUI) compiles it, but the factory refuses it"},{"type":"text","text":" "},{"type":"text","text":"at run time: it throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle"},{"type":"text","text":" when the main bundle is an"},{"type":"text","text":" "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".appex"},{"type":"text","text":". To get an app’s events here, send them to a server of yours that"},{"type":"text","text":" "},{"type":"text","text":"makes this destination; see the module’s article for what that server does."}]},{"type":"paragraph","inlineContent":[{"text":"The secret is in the query of every request’s URL, so don’t log the destination, its","type":"text"},{"text":" ","type":"text"},{"text":"requests or a transport’s URLs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The encoder logs a notice for each event and property of "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" named as Google Analytics"},{"type":"text","text":" "},{"type":"text","text":"refuses, or keeps for itself, as every record of that event will be skipped"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError"},{"type":"text","text":")."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle"},{"text":" in an app or an app extension,","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID"},{"text":" for a measurement ID that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID"},{"text":" for one that isn’t ","type":"text"},{"code":"G-","type":"codeVoice"},{"text":" ","type":"text"},{"text":"followed by uppercase ASCII letters and digits, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret"},{"text":" for a secret that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace.","type":"text"}]}],"type":"aside","style":"note","name":"Throws"}],"kind":"content"}],"kind":"symbol","metadata":{"remoteSource":{"fileName":"HTTPDestination+GoogleAnalytics.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/GoogleAnalyticsEncoding\/HTTPDestination+GoogleAnalytics.swift#L70"},"externalID":"s:16HTTPDestinations15HTTPDestinationV23GoogleAnalyticsEncodingAD0cD12BatchEncoderVRs_rlE06googleD013measurementID9apiSecret6region4plan9transport7backoff5clock3nowACyxAFGSS_SSAD0cD6RegionO13TrackingPlans0T4PlanVxAA18ExponentialBackoffVqd__20FoundationEssentials4DateVyYbctAD0cD10SetupErrorOYK12_Concurrency5ClockRd__s8DurationVA3_Rtd__lFZ","extendedModule":"HTTPDestinations","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"HTTPTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"GoogleAnalyticsBatchEncoder"},{"type":"text","text":"."}]},"symbolKind":"method","roleHeading":"Type Method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"googleAnalytics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"measurementID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"apiSecret","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GoogleAnalyticsRegion","kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":">, ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"GoogleAnalyticsSetupError","kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV"},{"text":">","kind":"text"}],"title":"googleAnalytics(measurementID:apiSecret:region:plan:transport:backoff:clock:now:)","modules":[{"relatedModules":["HTTPDestinations"],"name":"GoogleAnalyticsEncoding"}],"role":"symbol"},"seeAlsoSections":[{"title":"Sending to Google Analytics","identifiers":["doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError"],"anchor":"Sending-to-Google-Analytics","generated":true}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HTTPDestination\/googleAnalytics(measurementID:apiSecret:region:plan:transport:backoff:clock:now:)"},"references":{"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsEncodingError":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","abstract":[{"type":"text","text":"Why "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"title":"GoogleAnalyticsEncodingError","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsencodingerror","navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsEncodingError"}],"type":"topic"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/HTTPDestinations/HTTPDestination/googleAnalytics(measurementID:apiSecret:region:plan:transport:backoff:clock:now:)":{"role":"symbol","title":"googleAnalytics(measurementID:apiSecret:region:plan:transport:backoff:clock:now:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"googleAnalytics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"measurementID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"apiSecret"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO","text":"GoogleAnalyticsRegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"}