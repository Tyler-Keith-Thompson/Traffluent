ind":"text"},{"text":"apiSecret","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"GoogleAnalyticsRegion","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO","kind":"typeIdentifier","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff"},{"text":" = ExponentialBackoff(), ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":"> = ContinuousClock(), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":" = { Date.now }) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"GoogleAnalyticsSetupError","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO","kind":"typeIdentifier","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","kind":"typeIdentifier","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"parameters":[{"name":"measurementID","content":[{"type":"paragraph","inlineContent":[{"text":"The web or data stream’s measurement ID, ","type":"text"},{"code":"G-","type":"codeVoice"},{"text":" followed by letters and","type":"text"},{"text":" ","type":"text"},{"text":"digits, from the stream’s details in Google Analytics’ Admin. Whitespace and newlines","type":"text"},{"text":" ","type":"text"},{"text":"around it are trimmed off.","type":"text"}]}]},{"name":"apiSecret","content":[{"inlineContent":[{"text":"An API secret of the stream, from its Measurement Protocol API secrets in","type":"text"},{"text":" ","type":"text"},{"text":"Google Analytics’ Admin. Whitespace and newlines around it are trimmed off.","type":"text"}],"type":"paragraph"}]},{"name":"region","content":[{"inlineContent":[{"type":"text","text":"Where Google collects the data: "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/global","isActive":true},{"type":"text","text":", its default"},{"type":"text","text":" "},{"type":"text","text":"endpoint, or "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/eu","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}]},{"name":"backoff","content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, by default."}],"type":"paragraph"}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, and each request’s deadline is checked"},{"type":"text","text":" "},{"type":"text","text":"against before it is sent; the system’s clock by default."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The destination posts to the Measurement Protocol’s ","type":"text"},{"code":"\/mp\/collect","type":"codeVoice"},{"text":" endpoint of ","type":"text"},{"code":"region","type":"codeVoice"},{"text":", with","type":"text"},{"text":" ","type":"text"},{"text":"the measurement ID and API secret in its query, encoded by a ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" within ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":" that leaves out each record","type":"text"},{"text":" ","type":"text"},{"text":"tracked more than 71 hours before, or more than 15 minutes after, the time ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" gives as a","type":"text"},{"text":" ","type":"text"},{"text":"batch is encoded: Google Analytics takes 72, and the hour to spare is for the request to","type":"text"},{"text":" ","type":"text"},{"text":"reach Google and clocks that disagree. It sends no trace context in its header fields. It","type":"text"},{"text":" ","type":"text"},{"text":"retries no response, a 5xx, 408 or 429, and drops and reports any other status. A request","type":"text"},{"text":" ","type":"text"},{"text":"still undelivered 71 hours after its oldest record was tracked, by the time ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" gives,","type":"text"},{"text":" ","type":"text"},{"text":"isn’t sent again: the whole request is dropped, its younger records too, and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":", as Google Analytics would store its","type":"text"},{"text":" ","type":"text"},{"text":"oldest records as 72 hours old. The Measurement Protocol answers","type":"text"},{"text":" ","type":"text"},{"text":"2xx to every request it receives, so a wrong measurement ID or API secret, or a request it","type":"text"},{"text":" ","type":"text"},{"text":"can’t read, is answered 2xx with nothing stored: check the property’s Realtime report after","type":"text"},{"text":" ","type":"text"},{"text":"setting it up.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The API secret lets anyone holding it send events to the property, so this factory is"},{"type":"text","text":" "},{"type":"text","text":"for a server, and must never be given a secret in an app. It is compiled for macOS and"},{"type":"text","text":" "},{"type":"text","text":"Linux alone, so an app for iOS, iPadOS, tvOS, watchOS, visionOS or Mac Catalyst that calls"},{"type":"text","text":" "},{"type":"text","text":"it fails to compile. A Mac app (AppKit or SwiftUI) compiles it, but the factory refuses it"},{"type":"text","text":" "},{"type":"text","text":"at run time: it throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle"},{"type":"text","text":" when the main bundle is an"},{"type":"text","text":" "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".appex"},{"type":"text","text":". To get an app’s events here, send them to a server of yours that"},{"type":"text","text":" "},{"type":"text","text":"makes this destination; see the module’s article for what that server does."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The secret is in the query of every request’s URL, so don’t log the destination, its"},{"type":"text","text":" "},{"type":"text","text":"requests or a transport’s URLs."}]},{"type":"paragraph","inlineContent":[{"text":"The encoder logs a notice for each event and property of ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" named as Google Analytics","type":"text"},{"text":" ","type":"text"},{"text":"refuses, or keeps for itself, as every record of that event will be skipped","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"type":"aside","name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle"},{"text":" in an app or an app extension,","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID"},{"text":" for a measurement ID that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID"},{"text":" for one that isn’t ","type":"text"},{"type":"codeVoice","code":"G-"},{"text":" ","type":"text"},{"text":"followed by uppercase ASCII letters and digits, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret"},{"text":" for a secret that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace.","type":"text"}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/googleanalyticsencoding\/httpdestinations\/httpdestination\/googleanalytics(measurementid:apisecret:region:plan:transport:backoff:clock:now:)"]}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff":{"url":"\/documentation\/httpdestinations\/exponentialbackoff","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ExponentialBackoff"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","abstract":[{"type":"text","text":"How long "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"type":"text","text":" waits before each new attempt at a batch that wasn’t delivered:"},{"type":"text","text":" "},{"type":"text","text":"binary exponential backoff, each wait twice the one before, up to a maximum."}],"kind":"symbol","type":"topic","title":"ExponentialBackoff","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExponentialBackoff"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsRegion":{"abstract":[{"type":"text","text":"Where Google Analytics collects a stream’s events, which decides the Measurement Protocol"},{"type":"text","text":" "},{"type":"text","text":"endpoint they are posted to."}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsregion","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GoogleAnalyticsRegion"}],"navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsRegion"}],"title":"GoogleAnalyticsRegion"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/emptyMeasurementID":{"url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/emptymeasurementid","role":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID","abstract":[{"text":"The measurement ID is empty, or only whitespace.","type":"text"}],"kind":"symbol","type":"topic","title":"GoogleAnalyticsSetupError.emptyMeasurementID","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"emptyMeasurementID","kind":"identifier"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/malformedMeasurementID":{"abstra