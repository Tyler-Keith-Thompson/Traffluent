xt":": "},{"kind":"typeIdentifier","text":"TrackingPlan","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ExponentialBackoff","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"kind":"text","text":" = ExponentialBackoff(), "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"GoogleAnalyticsSetupError","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"HTTPDestination","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"GoogleAnalyticsBatchEncoder","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"measurementID","content":[{"inlineContent":[{"text":"The web or data stream’s measurement ID, ","type":"text"},{"code":"G-","type":"codeVoice"},{"text":" followed by letters and","type":"text"},{"text":" ","type":"text"},{"text":"digits, from the stream’s details in Google Analytics’ Admin. Whitespace and newlines","type":"text"},{"text":" ","type":"text"},{"text":"around it are trimmed off.","type":"text"}],"type":"paragraph"}]},{"name":"apiSecret","content":[{"inlineContent":[{"type":"text","text":"An API secret of the stream, from its Measurement Protocol API secrets in"},{"type":"text","text":" "},{"type":"text","text":"Google Analytics’ Admin. Whitespace and newlines around it are trimmed off."}],"type":"paragraph"}]},{"name":"region","content":[{"inlineContent":[{"text":"Where Google collects the data: ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/global","isActive":true,"type":"reference"},{"text":", its default","type":"text"},{"text":" ","type":"text"},{"text":"endpoint, or ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/eu","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}]},{"name":"transport","content":[{"inlineContent":[{"type":"text","text":"What sends each request."}],"type":"paragraph"}]},{"name":"backoff","content":[{"type":"paragraph","inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, by default.","type":"text"}]}]},{"name":"clock","content":[{"inlineContent":[{"type":"text","text":"The clock the waits are measured on."}],"type":"paragraph"}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at; the system’s clock by default."}]}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination posts to the Measurement Protocol’s "},{"type":"codeVoice","code":"\/mp\/collect"},{"type":"text","text":" endpoint of "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"the measurement ID and API secret in its query, encoded by a "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","isActive":true},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" within "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" that leaves out each record"},{"type":"text","text":" "},{"type":"text","text":"tracked more than 72 hours before, or more than 15 minutes after, the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives as a"},{"type":"text","text":" "},{"type":"text","text":"batch is encoded. It sends no trace context in its header fields. It retries no response, a"},{"type":"text","text":" "},{"type":"text","text":"5xx, 408 or 429, and drops and reports any other status. The Measurement Protocol answers"},{"type":"text","text":" "},{"type":"text","text":"2xx to every request it receives, so a wrong measurement ID or API secret, or a request it"},{"type":"text","text":" "},{"type":"text","text":"can’t read, is answered 2xx with nothing stored: check the property’s Realtime report after"},{"type":"text","text":" "},{"type":"text","text":"setting it up."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The API secret lets anyone holding it send events to the property, so this factory is"},{"type":"text","text":" "},{"type":"text","text":"for a server, and must never be given a secret in an app. It is compiled for macOS and"},{"type":"text","text":" "},{"type":"text","text":"Linux alone, so an app for iOS, iPadOS, tvOS, watchOS, visionOS or Mac Catalyst that calls"},{"type":"text","text":" "},{"type":"text","text":"it fails to compile. A Mac app (AppKit or SwiftUI) compiles it, but the factory refuses it"},{"type":"text","text":" "},{"type":"text","text":"at run time: it throws "},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","isActive":true},{"type":"text","text":" when the main bundle is an"},{"type":"text","text":" "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".appex"},{"type":"text","text":". To get an app’s events here, send them to a server of yours that"},{"type":"text","text":" "},{"type":"text","text":"makes this destination; see the module’s article for what that server does."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The secret is in the query of every request’s URL, so don’t log the destination, its"},{"type":"text","text":" "},{"type":"text","text":"requests or a transport’s URLs."}]},{"type":"paragraph","inlineContent":[{"text":"The encoder logs a notice for each event and property of ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" named as Google Analytics","type":"text"},{"text":" ","type":"text"},{"text":"refuses, or keeps for itself, as every record of that event will be skipped","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError"},{"text":").","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle"},{"type":"text","text":" in an app or an app extension,"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID"},{"type":"text","text":" for a measurement ID that is empty or only"},{"type":"text","text":" "},{"type":"text","text":"whitespace, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID"},{"type":"text","text":" for one that isn’t "},{"code":"G-","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"followed by uppercase ASCII letters and digits, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret"},{"type":"text","text":" for a secret that is empty or only"},{"type":"text","text":" "},{"type":"text","text":"whitespace."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"}]}],"identifier":{"url":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations\/HT