"type":"codeVoice","code":"UA-…"},{"type":"text","text":") or a Google tag ID ("},{"type":"codeVoice","code":"GT-…"},{"type":"text","text":") is refused as well."}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/malformedmeasurementid","title":"GoogleAnalyticsSetupError.malformedMeasurementID","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/emptyMeasurementID":{"abstract":[{"text":"The measurement ID is empty, or only whitespace.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"emptyMeasurementID"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID","title":"GoogleAnalyticsSetupError.emptyMeasurementID","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/emptymeasurementid","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"type":"topic","role":"symbol","url":"\/documentation\/httpdestinations\/httpdestination","title":"HTTPDestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsRegion":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsRegion","kind":"identifier"}],"abstract":[{"text":"Where Google Analytics collects a stream’s events, which decides the Measurement Protocol","type":"text"},{"text":" ","type":"text"},{"text":"endpoint they are posted to.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsregion","navigatorTitle":[{"text":"GoogleAnalyticsRegion","kind":"identifier"}],"title":"GoogleAnalyticsRegion","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/HTTPDestinations":{"abstract":[],"role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/httpdestinations","title":"HTTPDestinations","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations"},"doc://Events/documentation/Events/EventSchema":{"abstract":[{"text":"The shape of an event type: its name, its schema version, its consent category and its stored","type":"text"},{"text":" ","type":"text"},{"text":"properties in declaration order, as a value tooling reads.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventSchema"}],"navigatorTitle":[{"kind":"identifier","text":"EventSchema"}],"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","title":"EventSchema","url":"\/documentation\/events\/eventschema","kind":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/appBundle":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"appBundle"}],"abstract":[{"type":"text","text":"The process is an app or an app extension: its main bundle is an "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or "},{"type":"codeVoice","code":".appex"},{"type":"text","text":" "},{"type":"text","text":"directory. The factory is compiled for macOS so a server written for it can run there, and a"},{"type":"text","text":" "},{"type":"text","text":"Mac app compiles it too, but an app ships the API secret to everyone who installs it, and"},{"type":"text","text":" "},{"type":"text","text":"anyone holding the secret can send events to the property. Send the app’s events to a relay"},{"type":"text","text":" "},{"type":"text","text":"of yours instead, which forwards them to Google Analytics."}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/appbundle","title":"GoogleAnalyticsSetupError.appBundle","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle"},"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExponentialBackoff"}],"abstract":[{"type":"text","text":"How long "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" waits before each new attempt at a batch that wasn’t delivered:"},{"type":"text","text":" "},{"type":"text","text":"binary exponential backoff, each wait twice the one before, up to a maximum."}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/httpdestinations\/exponentialbackoff","navigatorTitle":[{"kind":"identifier","text":"ExponentialBackoff"}],"title":"ExponentialBackoff","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder/batchLimit":{"abstract":[{"type":"text","text":"The Measurement