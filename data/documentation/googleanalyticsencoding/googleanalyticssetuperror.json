leAnalyticsEncoding/GoogleAnalyticsSetupError/appBundle":{"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"appBundle"}],"kind":"symbol","title":"GoogleAnalyticsSetupError.appBundle","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/appbundle","abstract":[{"text":"The process is an app or an app extension: its main bundle is an ","type":"text"},{"code":".app","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".appex","type":"codeVoice"},{"text":" ","type":"text"},{"text":"directory. The factory is compiled for macOS so a server written for it can run there, and a","type":"text"},{"text":" ","type":"text"},{"text":"Mac app compiles it too, but an app ships the API secret to everyone who installs it, and","type":"text"},{"text":" ","type":"text"},{"text":"anyone holding the secret can send events to the property. Send the app’s events to a relay","type":"text"},{"text":" ","type":"text"},{"text":"of yours instead, which forwards them to Google Analytics.","type":"text"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","role":"symbol"},"doc://GoogleAnalyticsEncoding/SH":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/emptyMeasurementID":{"role":"symbol","type":"topic","title":"GoogleAnalyticsSetupError.emptyMeasurementID","abstract":[{"type":"text","text":"The measurement ID is empty, or only whitespace."}],"kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/emptymeasurementid","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"emptyMeasurementID"}]},"doc://GoogleAnalyticsEncoding/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/SQ"},"doc://GoogleAnalyticsEncoding/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s8SendableP"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/malformedMeasurementID":{"abstract":[{"type":"text","text":"The measurement ID isn’t "},{"type":"codeVoice","code":"G-"},{"type":"text","text":" followed by uppercase ASCII letters and digits, the form of"},{"type":"text","text":" "},{"type":"text","text":"every web stream’s ID ("},{"type":"codeVoice","code":"G-1A2B3C4D5E"},{"type":"text","text":"). The Measurement Protocol answers a request for a"},{"type":"text","text":" "},{"type":"text","text":"stream it doesn’t know with 2xx and stores nothing, so the factory refuses a malformed ID"},{"type":"text","text":" "},{"type":"text","text":"when the destination is made. A stream ID, an app stream’s Firebase app ID, a Universal"},{"type":"text","text":" "},{"type":"text","text":"Analytics ID ("},{"type":"codeVoice","code":"UA-…"},{"type":"text","text":") or a Google tag ID ("},{"type":"codeVoice","code":"GT-…"},{"type":"text","text":") is refused as well."}],"kind":"symbol","role":"symbol","title":"GoogleAnalyticsSetupError.malformedMeasurementID","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"malformedMeasurementID","kind":"identifier"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/malformedmeasurementid"},"doc://GoogleAnalyticsEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP"}}}