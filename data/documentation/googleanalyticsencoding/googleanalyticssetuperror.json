"emptyAPISecret","kind":"identifier"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/emptyMeasurementID":{"title":"GoogleAnalyticsSetupError.emptyMeasurementID","abstract":[{"text":"The measurement ID is empty, or only whitespace.","type":"text"}],"type":"topic","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/emptymeasurementid","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID","kind":"symbol","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"emptyMeasurementID","kind":"identifier"}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/appBundle":{"abstract":[{"type":"text","text":"The process is an app or an app extension: its main bundle is an "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or "},{"type":"codeVoice","code":".appex"},{"type":"text","text":" "},{"type":"text","text":"directory. The factory is compiled for macOS so a server written for it can run there, and a"},{"type":"text","text":" "},{"type":"text","text":"Mac app compiles it too, but an app ships the API secret to everyone who installs it, and"},{"type":"text","text":" "},{"type":"text","text":"anyone holding the secret can send events to the property. Send the app’s events to a relay"},{"type":"text","text":" "},{"type":"text","text":"of yours instead, which forwards them to Google Analytics."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"appBundle","kind":"identifier"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/appbundle","title":"GoogleAnalyticsSetupError.appBundle"}}}