alyticsEncoding/GoogleAnalyticsSetupError/Equatable-Implementations":{"kind":"article","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/Equatable-Implementations","role":"collectionGroup","abstract":[],"type":"topic","title":"Equatable Implementations","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/equatable-implementations"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/malformedMeasurementID":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/malformedmeasurementid","type":"topic","abstract":[{"type":"text","text":"The measurement ID isn’t "},{"type":"codeVoice","code":"G-"},{"type":"text","text":" followed by uppercase ASCII letters and digits, the form of"},{"type":"text","text":" "},{"type":"text","text":"every web stream’s ID ("},{"type":"codeVoice","code":"G-1A2B3C4D5E"},{"type":"text","text":"). The Measurement Protocol answers a request for a"},{"type":"text","text":" "},{"type":"text","text":"stream it doesn’t know with 2xx and stores nothing, so the factory refuses a malformed ID"},{"type":"text","text":" "},{"type":"text","text":"when the destination is made. A stream ID, an app stream’s Firebase app ID, a Universal"},{"type":"text","text":" "},{"type":"text","text":"Analytics ID ("},{"type":"codeVoice","code":"UA-…"},{"type":"text","text":") or a Google tag ID ("},{"type":"codeVoice","code":"GT-…"},{"type":"text","text":") is refused as well."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"malformedMeasurementID"}],"title":"GoogleAnalyticsSetupError.malformedMeasurementID"},"doc://GoogleAnalyticsEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type