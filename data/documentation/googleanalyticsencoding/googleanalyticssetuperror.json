’s Firebase app ID, a Universal","type":"text"},{"text":" ","type":"text"},{"text":"Analytics ID (","type":"text"},{"code":"UA-…","type":"codeVoice"},{"text":") or a Google tag ID (","type":"text"},{"code":"GT-…","type":"codeVoice"},{"text":") is refused as well.","type":"text"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/malformedmeasurementid","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"malformedMeasurementID"}],"title":"GoogleAnalyticsSetupError.malformedMeasurementID"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/emptyAPISecret":{"abstract":[{"type":"text","text":"The API secret is empty, or only whitespace. The Measurement Protocol stores nothing for a"},{"type":"text","text":" "},{"type":"text","text":"request without one."}],"type":"topic","title":"GoogleAnalyticsSetupError.emptyAPISecret","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/emptyapisecret","kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"emptyAPISecret","kind":"identifier"}],"role":"symbol"},"doc://GoogleAnalyticsEncoding/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s8SendableP","title":"Swift.Sendable"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsRegion":{"title":"GoogleAnalyticsRegion","url":"\/documentation\/googleanalyticsencoding\/googleanalyticsregion","navigatorTitle":[{"kind":"identifier","text":"GoogleAnalyticsRegion"}],"type":"topic","abstract":[{"type":"text","text":"Where Google Analytics collects a stream’s events, which decides the Measurement Protocol"},{"type":"text","text":" "},{"type":"text","text":"endpoint they are posted to."}],"identifier":"