text":"emptyAPISecret"}],"type":"topic","role":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret","kind":"symbol","abstract":[{"type":"text","text":"The API secret is empty, or only whitespace. The Measurement Protocol stores nothing for a"},{"type":"text","text":" "},{"type":"text","text":"request without one."}],"title":"GoogleAnalyticsSetupError.emptyAPISecret"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/appBundle":{"url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/appbundle","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"appBundle","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","kind":"symbol","abstract":[{"type":"text","text":"The process is an app or an app extension: its main bundle is an "},{"code":".app","type":"codeVoice"},{"type":"text","text":" or "},{"code":".appex","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"directory. The factory is compiled for macOS so a server written for it can run there, and a"},{"type":"text","text":" "},{"type":"text","text":"Mac app compiles it too, but an app ships the API secret to everyone who installs it, and"},{"type":"text","text":" "},{"type":"text","text":"anyone holding the secret can send events to the property. Send the app’s events to a relay"},{"type":"text","text":" "},{"type":"text","text":"of yours instead, which forwards them to Google Analytics."}],"title":"GoogleAnalyticsSetupError.appBundle"},"doc://GoogleAnalyticsEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/malformedMeasurementID":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID","title":"GoogleAnalyticsSetupError.malformedMeasurementID","abstract":[{"type":"text","text":"The measurement ID isn’t "},{"type":"codeVoice","code":"G-"},{"type":"text","text":" followed by uppercase ASCII letters and digits, the form of"},{"type":"text","text":" "},{"type":"text","text":"every web stream’s ID ("},{"type":"codeVoice","code":"G-1A2B3C4D5E"},{"type":"text","text":"). The Measurement Protocol answers a request for a"},{"type":"text","text":" "},{"type":"text","text":"stream it doesn’t know with 2xx and stores nothing, so the factory refuses a malformed ID"},{"type":"text","text":" "},{"type":"text","text":"when the destination is made. A stream ID, an app stream’s Firebase app ID, a Universal"},{"type":"text","text":" "},{"type":"text","text":"Analytics ID ("},{"type":"codeVoice","code":"UA-…"},{"type":"text","text":") or a Google tag ID ("},{"type":"codeVoice","code":"GT-…"},{"type":"text","text":") is refused as well."}],"kind":"symbol","type":"topic","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/malformedmeasurementid","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"malformedMeasurementID"}],"role":"symbol"},"doc://GoogleAnalyticsEncoding/s5ErrorP":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/s5ErrorP","title":"Swift.Error","type":"unresolvable"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"title":"GoogleAnalyticsEncoding","kind":"symbol","url":"\/documentation\/googleanalyticsencoding","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","type":"topic","abstract":[{"text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol.","type":"text"}],"role":"collection"}}}