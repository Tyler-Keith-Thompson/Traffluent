{"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"positions","kind":"internalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:s6UInt64V","text":"UInt64","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"positions","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The positions of records in this store a delivery handed to"},{"type":"text","text":" "},{"type":"text","text":"destinations."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The records kept at those positions, each tagged with its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/DeliveryTag"},{"type":"text","text":" "},{"type":"text","text":"naming this store, in any order."}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"A delivery calls it once that destination has caught up, hands it the records returned,"},{"type":"text","text":" "},{"type":"text","text":"and counts its receipt towards "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/acknowledge(_:)"},{"type":"text","text":" for those records alone. A position the"},{"type":"text","text":" "},{"type":"text","text":"store no longer keeps (its bound dropped the record, which it reports) gives no record, and"},{"type":"text","text":" "},{"type":"text","text":"neither does any position when the store can’t read records back, as with the default"},{"type":"text","text":" "},{"type":"text","text":"implementation. The delivery never acknowledges a record it couldn’t hand to every"},{"type":"text","text":" "},{"type":"text","text":"destination, so a store that still keeps one delivers it on a later launch, with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered"},{"type":"text","text":" set."}],"type":"paragraph"},{"inlineContent":[{"text":"A store of your own should implement it. Without it, the default returns no records, so a","type":"text"},{"text":" ","type":"text"},{"text":"batch a full buffer dropped isn’t sent again in this run: the destination whose buffer","type":"text"},{"text":" ","type":"text"},{"text":"dropped it never gets it in this run, every destination gets it again on the next launch,","type":"text"},{"text":" ","type":"text"},{"text":"marked redelivered, and the store holds it until then, toward its bound.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The delivery gives each record returned the "},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","isActive":true,"type":"reference"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"sensitive-value visibility and the "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" the record had when the buffer dropped"},{"type":"text","text":" "},{"type":"text","text":"it, so a store needn’t keep them. A record tagged with another store is ignored."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/acknowledger\/records(at:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"The records this store still keeps at ","type":"text"},{"type":"codeVoice","code":"positions"},{"text":", read back for a destination whose","type":"text"},{"text":" ","type":"text"},{"text":"delivery buffer dropped them before it received them.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/Acknowledger"]]},"kind":"symbol","identifier":{"url":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"UInt64","preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"required":true,"symbolKind":"method","modules":[{"name":"Events"}],"title":"records(at:)","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DeliveryTag.swift#L77","fileName":"DeliveryTag.swift"},"externalID":"s:6Events12AcknowledgerP7records2atSayAA11EventRecordVGSays6UInt64VG_tF","role":"symbol"},"defaultImplementationsSections":[{"title":"Acknowledger Implementations","anchor":"Acknowledger-Implementations","identifiers":["doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)-4jg2u"]}],"references":{"doc://Events/documentation/Events/EventRecord":{"kind":"symbol","url":"\/documentation\/events\/eventrecord","role":"symbol","abstract":[{"text":"A tracked event: the event itself, when it was tracked, where, and the context it was tracked in.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"EventRecord"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventRecord"}],"iden