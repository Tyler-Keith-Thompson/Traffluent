{"metadata":{"roleHeading":"Instance Method","role":"symbol","modules":[{"name":"Events"}],"externalID":"s:6Events12AcknowledgerP7records2atSayAA11EventRecordVGSays6UInt64VG_tF","symbolKind":"method","required":true,"title":"records(at:)","remoteSource":{"fileName":"DeliveryTag.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DeliveryTag.swift#L77"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"UInt64","preciseIdentifier":"s:s6UInt64V"},{"kind":"text","text":"]) -> ["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"The records this store still keeps at ","type":"text"},{"code":"positions","type":"codeVoice"},{"text":", read back for a destination whose","type":"text"},{"text":" ","type":"text"},{"text":"delivery buffer dropped them before it received them.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/acknowledger\/records(at:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)"},"sections":[],"defaultImplementationsSections":[{"identifiers":["doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)-4jg2u"],"title":"Acknowledger Implementations","anchor":"Acknowledger-Implementations"}],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/Acknowledger"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at",