{"sections":[],"defaultImplementationsSections":[{"identifiers":["doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)-4jg2u"],"anchor":"Acknowledger-Implementations","title":"Acknowledger Implementations"}],"abstract":[{"type":"text","text":"The records this store still keeps at "},{"type":"codeVoice","code":"positions"},{"type":"text","text":", read back for a destination whose"},{"type":"text","text":" "},{"type":"text","text":"delivery buffer dropped them before it received them."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":" "},{"kind":"internalParam","text":"positions"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"UInt64","preciseIdentifier":"s:s6UInt64V"},{"kind":"text","text":"]) -> ["},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"positions","content":[{"inlineContent":[{"type":"text","text":"The positions of records in this store a delivery handed to"},{"type":"text","text":" "},{"type":"text","text":"destinations."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The records kept at those positions, each tagged with its "},{"identifier":"doc:\/\/Events\/documentation\/Events\/DeliveryTag","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"naming this store, in any order."}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A delivery calls it once that destination has caught up, hands it the records returned,"},{"type":"text","text":" "},{"type":"text","text":"and counts its receipt towards "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/acknowledge(_:)","isActive":true},{"type":"text","text":" for those records alone. A position the"},{"type":"text","text":" "},{"type":"text","text":"store no longer keeps (its bound dropped the record, which it reports) gives no record, and"},{"type":"text","text":" "},{"type":"text","text":"neither does any position when the store can’t read records back, as with the default"},{"type":"text","text":" "},{"type":"text","text":"implementation. The delivery never acknowledges a record it couldn’t hand to every"},{"type":"text","text":" "},{"type":"text","text":"destination, so a store that still keeps one delivers it on a later launch, with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","isActive":true},{"type":"text","text":" set."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A store of your own should implement it. Without it, the default returns no records, so a"},{"type":"text","text":" "},{"type":"text","text":"batch a full buffer dropped isn’t sent again in this run: the destination whose buffer"},{"type":"text","text":" "},{"type":"text","text":"dropped it never gets it in this run, every destination gets it again on the next launch,"},{"type":"text","text":" "},{"type":"text","text":"marked redelivered, and the store holds it until then, toward its bound."}]},{"type":"paragraph","inlineContent":[{"text":"The delivery gives each record returned the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","isActive":true},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"sensitive-value visibility and the ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":" the record had when the buffer dropped","type":"text"},{"text":" ","type":"text"},{"text":"it, so a store needn’t keep them. A record tagged with another store is ignored.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/acknowledger\/records(at:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/Acknowledger"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"required":true,"symbolKind":"method","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DeliveryTag.swift#L77","fileName":"DeliveryTag.swift"},"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"UInt64","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V"},{"text":"]) -> [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]","kind":"text"}],"title":"records(at:)","modules":[{"name":"Events"}],"externalID":"s:6Events12AcknowledgerP7records2atSayAA11EventRecordVGSays6UInt64VG_tF"},"identifier":{"url":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)","interfaceLanguage":"swift"},"references":{"doc://Events/documentation/Events/Acknowledger/records(at:)-4jg2u":{"abstract":[{"type":"text","text":"No records: a store that can’t read its records back keeps those of a batch a"},{"type":"text","text":" "},{"type":"text","text":"destination’s full buffer dropped for a later launch to deliver."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)-4jg2u","fragments":[{"text":"func","kind":"keywor