ents\/EventRecord\/isRedelivered"},{"type":"text","text":" set."}],"type":"paragraph"},{"inlineContent":[{"text":"A store of your own should implement it. Without it, the default returns no records, so a","type":"text"},{"text":" ","type":"text"},{"text":"batch a full buffer dropped isn’t sent again in this run: the destination whose buffer","type":"text"},{"text":" ","type":"text"},{"text":"dropped it never gets it in this run, every destination gets it again on the next launch,","type":"text"},{"text":" ","type":"text"},{"text":"marked redelivered, and the store holds it until then, toward its bound.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The delivery gives each record returned the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"sensitive-value visibility and the ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":" the record had when the buffer dropped","type":"text"},{"text":" ","type":"text"},{"text":"it, so a store needn’t keep them. A record tagged with another store is ignored.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"The records this store still keeps at "},{"type":"codeVoice","code":"positions"},{"type":"text","text":", read back for a destination whose"},{"type":"text","text":" "},{"type":"text","text":"delivery buffer dropped them before it received them."}],"references":{"doc://Events/documentation/Events":{"role":"collection","title":"Events","type":"topic","url":"\/documentation\/events","identifier":"doc:\/\/Events\/documentation\/Events","abstract":[],"kind":"symbol"},"doc://Events/documentation/Events/EventRecord":{"role":"symbol","title":"EventRecord","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventRecord"}],"abstract":[{"text":"A tracked event: the event itse