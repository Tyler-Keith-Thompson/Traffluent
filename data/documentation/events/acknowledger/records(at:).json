{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/Acknowledger"]]},"abstract":[{"type":"text","text":"The records this store still keeps at "},{"type":"codeVoice","code":"positions"},{"type":"text","text":", read back for a destination whose"},{"type":"text","text":" "},{"type":"text","text":"delivery buffer dropped them before it received them."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"positions","kind":"internalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:s6UInt64V","text":"UInt64","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The positions of records in this store a delivery handed to"},{"type":"text","text":" "},{"type":"text","text":"destinations."}]}],"name":"positions"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The records kept at those positions, each tagged with its "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/DeliveryTag","isActive":true},{"type":"text","text":" "},{"type":"text","text":"naming this store, in any order."}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A delivery calls it once that destination has caught up, hands it the records returned,","type":"text"},{"text":" ","type":"text"},{"text":"and counts its receipt towards ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/acknowledge(_:)","isActive":true,"type":"reference"},{"text":" for those records alone. A position the","type":"text"},{"text":" ","type":"text"},{"text":"store no longer keeps (its bound dropped the record, which it reports) gives no record, and","type":"text"},{"text":" ","type":"text"},{"text":"neither does any position when the store can’t read records back, as with the default","type":"text"},{"text":" ","type":"text"},{"text":"implementation. The delivery never acknowledges a record it couldn’t hand to every","type":"text"},{"text":" ","type":"text"},{"text":"destination, so a store that still keeps one delivers it on a later launch, with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","isActive":true,"type":"reference"},{"text":" set.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A store of your own should implement it. Without it, the default returns no records, so a"},{"type":"text","text":" "},{"type":"text","text":"batch a full buffer dropped isn’t sent again in this run: the destination whose buffer"},{"type":"text","text":" "},{"type":"text","text":"dropped it never gets it in this run, every destination gets it again on the next launch,"},{"type":"text","text":" "},{"type":"text","text":"marked redelivered, and the store holds it until then, toward its bound."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The delivery gives each record returned the "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","isActive":true},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"sensitive-value visibility and the "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" the record had when the buffer dropped"},{"type":"text","text":" "},{"type":"text","text":"it, so a store needn’t keep them. A record tagged with another store is ignored."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/acknowledger\/records(at:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"remoteSource":{"fileName":"DeliveryTag.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DeliveryTag.swift#L77"},"title":"records(at:)","role":"symbol","required":true,"modules":[{"name":"Events"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:s6UInt64V","text":"UInt64","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"symbolKind":"method","roleHeading":"Instance Method","externalID":"s:6Events12AcknowledgerP7records2atSayAA11EventRecordVGSays6UInt64VG_tF"},"defaultImplementationsSections":[{"identifiers":["doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)-4jg2u"],"title":"Acknowledger Implementations","anchor":"Acknowledger-Implementations"}],"kind":"symbol","references":{"doc://Events/documentation/Events/Acknowledger/records(at:)":{"url":"\/documentation\/events\/acknowledger\/records(at:)","abstract":[{"type":"text","text":"The records this store still keeps at "},{"type":"codeVoice","code":"positions"},{"type":"text","text":", read back for a destination whose"},{"type":"text","text":" "},{"type":"text","text":"delivery buffer dropped them before it received them."}],"kind":"symbol","required":true,"identifier":"doc:\/\/Ev