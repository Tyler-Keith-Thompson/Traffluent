{"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/acknowledger\/records(at:)"]}],"defaultImplementationsSections":[{"anchor":"Acknowledger-Implementations","title":"Acknowledger Implementations","identifiers":["doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)-4jg2u"]}],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/Acknowledger"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)"},"metadata":{"title":"records(at:)","modules":[{"name":"Events"}],"externalID":"s:6Events12AcknowledgerP7records2atSayAA11EventRecordVGSays6UInt64VG_tF","remoteSource":{"fileName":"DeliveryTag.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DeliveryTag.swift#L77"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:s6UInt64V","text":"UInt64","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"symbolKind":"method","role":"symbol","roleHeading":"Instance Method","required":true},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":" "},{"kind":"internalParam","text":"positions"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"UInt64","preciseIdentifier":"s:s6UInt64V"},{"kind":"text","text":"]) -> ["},{"kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]"}]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The positions of records in this store a delivery handed to"},{"type":"text","text":" "},{"type":"text","text":"destinations."}],"type":"paragraph"}],"name":"positions"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The records kept at those positions, each tagged with its "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/DeliveryTag","isActive":true},{"type":"text","text":" "},{"type":"text","text":"naming this store, in any order."}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A delivery calls it once that destination has caught up, hands it the records returned,"},{"type":"text","text":" "},{"type":"text","text":"and counts its receipt towards "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/acknowledge(_:)"},{"type":"text","text":" for those records alone. A position the"},{"type":"text","text":" "},{"type":"text","text":"store no longer keeps (its bound dropped the record, which it reports) gives no record, and"},{"type":"text","text":" "},{"type":"text","text":"neither does any position when the store can’t read records back, as with the default"},{"type":"text","text":" "},{"type":"text","text":"implementation. The delivery never acknowledges a record it couldn’t hand to every"},{"type":"text","text":" "},{"type":"text","text":"destination, so a store that still keeps one delivers it on a later launch, with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered"},{"type":"text","text":" set."}]},{"type":"paragraph","inlineContent":[{"text":"A store of your own should implement it. Without it, the default returns no records, so a","type":"text"},{"text":" ","type":"text"},{"text":"batch a full buffer dropped isn’t sent again in this run: the destination whose buffer","type":"text"},{"text":" ","type":"text"},{"text":"dropped it never gets it in this run, every destination gets it again on the next launch,","type":"text"},{"text":" ","type":"text"},{"text":"marked redelivered, and the store holds it until then, toward its bound.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The delivery gives each record returned the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","type":"reference"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"sensitive-value visibility and the ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" the record had when the buffer dropped","type":"text"},{"text":" ","type":"text"},{"text":"it, so a store needn’t keep them. A record tagged with another store is ignored.","type":"text"}]}]}],"abstract":[{"type":"text","text":"The records this store still keeps at "},{"code":"positions","type":"codeVoice"},{"type":"text","text":", read back for a destination whose"},{"type":"text","text":" "},{"type":"text","text":"delivery buffer dropped them before it received them."}],"references":{"doc://Events/documentation/Events/Acknowledger/acknowledge(_:)":{"abstract":[{"type":"text","text":"Every destination has received the records at "},{"type":"codeVoice","code":"positions"},{"type":"text","text":", so the store can forget them."}],"required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"acknowledge"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt6