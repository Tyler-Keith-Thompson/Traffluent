{"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/Acknowledger"]]},"sections":[],"abstract":[{"text":"The records this store still keeps at ","type":"text"},{"type":"codeVoice","code":"positions"},{"text":", read back for a destination whose","type":"text"},{"text":" ","type":"text"},{"text":"delivery buffer dropped them before it received them.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/acknowledger\/records(at:)"]}],"kind":"symbol","metadata":{"title":"records(at:)","symbolKind":"method","roleHeading":"Instance Method","externalID":"s:6Events12AcknowledgerP7records2atSayAA11EventRecordVGSays6UInt64VG_tF","required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"UInt64","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V"},{"text":"]) -> [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]","kind":"text"}],"remoteSource":{"fileName":"DeliveryTag.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DeliveryTag.swift#L77"},"role":"symbol","modules":[{"name":"Events"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"defaultImplementationsSections":[{"title":"Acknowledger Implementations","identifiers":["doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)-4jg2u"],"anchor":"Acknowledger-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"positions","kind":"internalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:s6UInt64V","text":"UInt64","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","text":"EventRecord","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"positions","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The positions of records in this store a delivery handed to"},{"type":"text","text":" "},{"type":"text","text":"destinations."}]}]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The records kept at those positions, each tagged with its "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/DeliveryTag","isActive":true},{"type":"text","text":" "},{"type":"text","text":"naming this store, in any order."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"A delivery calls it once that destination has caught up, hands it the records returned,","type":"text"},{"text":" ","type":"text"},{"text":"and counts its receipt towards ","type":"text"},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/acknowledge(_:)","isActive":true},{"text":" for those records alone. A position the","type":"text"},{"text":" ","type":"text"},{"text":"store no longer keeps (its bound dropped the record, which it reports) gives no record, and","type":"text"},{"text":" ","type":"text"},{"text":"neither does any position when the store can’t read records back, as with the default","type":"text"},{"text":" ","type":"text"},{"text":"implementation. The delivery never acknowledges a record it couldn’t hand to every","type":"text"},{"text":" ","type":"text"},{"text":"destination, so a store that still keeps one delivers it on a later launch, with","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","isActive":true},{"text":" set.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A store of your own should implement it. Without it, the default returns no records, so a","type":"text"},{"text":" ","type":"text"},{"text":"batch a full buffer dropped isn’t sent again in this run: the destination whose buffer","type":"text"},{"text":" ","type":"text"},{"text":"dropped it never gets it in this run, every destination gets it again on the next launch,","type":"text"},{"text":" ","type":"text"},{"text":"marked redelivered, and the store holds it until then, toward its bound.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The delivery gives each record returned the "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","isActive":true},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"sensitive-value visibility and the "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" the record had when the buffer dropped"},{"type":"text","text":" "},{"type":"text","text":"it, so a store needn’t keep them. A record tagged with another store is ignored."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)"},"references":{"doc://Events/documentation/Events/EventRecord/isRedelivered":{"role":"symbol","type":"topic","abstract":[{"text":"Whether the record may have reached a destination before: it was handed to a delivery in an","type":"text"},{"text":" ","type":"text"},{"text":"earlier run of the app, which ended before the delivery was acknowledged.","type":"text"}],"title":"isRedelivered","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","kind":"symbol","url":"\/documentation\/events\/eventrecord\/isredelivered","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isRedelivered","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://Events/documentation/Events/Acknowledger/records(at:)":{"kind":"symbol","role":"symbol","abstract":[{"text":"The records this store still keeps at ","type":"text"},{"code":"positions","type":"codeVoice"},{"text":", read back for a destination whose","type":"text"},{"text":" ","type":"text"},{"text":"delivery buffer dropped them before it received them.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"UInt64","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V"},{"text":"]) -> [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]","kind":"text"}],"url":"\/documentation\/events\/acknowledger\/records(at:)","title":"records(at:)","identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)","required":true,"defaultImplementations":1,"type":"topic"},"doc://Events/documentation/Events/EventRecord":{"kind":"symbol","role":"symbol","abstract":[{"text":"A tracked event: the event itself, when it was tracked, where, and the context it was tracked in.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventRecord","kind":"identifier"}],"url":"\/documentation\/events\/eventrecord","title":"EventRecord","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","navigatorTitle":[{"text":"EventRecord","kind":"identifier"}],"type":"topic"},"doc://Events/documentation/Events/Acknowledger/acknowledge(_:)":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Every destination has received the records at "},{"type":"codeVoice","code":"positions"},{"type":"text","text":", so the store can forget them."}],"required":true,"title":"acknowledge(_:)","identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/acknowledge(_:)","kind":"symbol","url":"\/documentation\/events\/acknowledger\/acknowledge(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"acknowledge"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V","text":"UInt64"},{"kind":"text","text":"])"}]},"doc://Events/documentation/Events":{"title":"Events","identifier":"doc:\/\/Events\/documentation\/Events","role":"collection","abstract":[{"type":"text","text":"The types every other module shares: the "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" protocol, the values its properties can hold, and the record a tracker makes of each event."}],"type":"topic","kind":"symbol","url":"\/documentation\/events"},"doc://Events/documentation/Events/DeliveryTag":{"title":"DeliveryTag","navigatorTitle":[{"text":"DeliveryTag","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/DeliveryTag","role":"symbol","abstract":[{"text":"Where a store keeps a record until it is delivered: the store, and the record’s position in it.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeliveryTag","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/events\/deliverytag"},"doc://Events/documentation/Events/Acknowledger/records(at:)-4jg2u":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"No records: a store that can’t read its records back keeps those of a batch a"},{"type":"text","text":" "},{"type":"text","text":"destination’s full buffer dropped for a later launch to deliver."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","t