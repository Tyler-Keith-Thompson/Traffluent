{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"The records this store still keeps at "},{"type":"codeVoice","code":"positions"},{"type":"text","text":", read back for a destination whose"},{"type":"text","text":" "},{"type":"text","text":"delivery buffer dropped them before it received them."}],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/Acknowledger"]]},"sections":[],"kind":"symbol","defaultImplementationsSections":[{"title":"Acknowledger Implementations","identifiers":["doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)-4jg2u"],"anchor":"Acknowledger-Implementations"}],"metadata":{"externalID":"s:6Events12AcknowledgerP7records2atSayAA11EventRecordVGSays6UInt64VG_tF","title":"records(at:)","modules":[{"name":"Events"}],"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"UInt64","preciseIdentifier":"s:s6UInt64V"},{"kind":"text","text":"]) -> ["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]"}],"symbolKind":"method","role":"symbol","remoteSource":{"fileName":"DeliveryTag.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DeliveryTag.swift#L77"},"required":true},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)"},"variants":[{"paths":["\/documentation\/events\/acknowledger\/records(at:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"