{"schemaVersion":{"patch":0,"minor":3,"major":0},"defaultImplementationsSections":[{"anchor":"Acknowledger-Implementations","identifiers":["doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)-4jg2u"],"title":"Acknowledger Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"positions","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"UInt64","preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The positions of records in this store a delivery handed to"},{"type":"text","text":" "},{"type":"text","text":"destinations."}],"type":"paragraph"}],"name":"positions"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"text":"The records kept at those positions, each tagged with its ","type":"text"},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/DeliveryTag","isActive":true},{"text":" ","type":"text"},{"text":"naming this store, in any order.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A delivery calls it once that destination has caught up, hands it the records returned,"},{"type":"text","text":" "},{"type":"text","text":"and counts its receipt towards "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/acknowledge(_:)","type":"reference","isActive":true},{"type":"text","text":" for those records alone. A position the"},{"type":"text","text":" "},{"type":"text","text":"store no longer keeps (its bound dropped the record, which it reports) gives no record, and"},{"type":"text","text":" "},{"type":"text","text":"neither does any position when the store can’t read records back, as with the default"},{"type":"text","text":" "},{"type":"text","text":"implementation. The delivery never acknowledges a record it couldn’t hand to every"},{"type":"text","text":" "},{"type":"text","text":"destination, so a store that still keeps one delivers it on a later launch, with"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","type":"reference","isActive":true},{"type":"text","text":" set."}],"type":"paragraph"},{"inlineContent":[{"text":"A store of your own should implement it. Without it, the default returns no records, so a","type":"text"},{"text":" ","type":"text"},{"text":"batch a full buffer dropped isn’t sent again in this run: the destination whose buffer","type":"text"},{"text":" ","type":"text"},{"text":"dropped it never gets it in this run, every destination gets it again on the next launch,","type":"text"},{"text":" ","type":"text"},{"text":"marked redelivered, and the store holds it until then, toward its bound.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The delivery gives each record returned the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","type":"reference"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"sensitive-value visibility and the ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" the record had when the buffer dropped","type":"text"},{"text":" ","type":"text"},{"text":"it, so a store needn’t keep them. A record tagged with another store is ignored.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/Acknowledger"]]},"abstract":[{"text":"The records this store still keeps at ","type":"text"},{"type":"codeVoice","code":"positions"},{"text":", read back for a destination whose","type":"text"},{"text":" ","type":"text"},{"text":"delivery buffer dropped them before it received them.","type":"text"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/acknowledger\/records(at:)"]}],"kind":"symbol","metadata":{"symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"Events"}],"role":"symbol","title":"records(at:)","externalID":"s:6Events12AcknowledgerP7records2atSayAA11EventRecordVGSays6UInt64VG_tF","remoteSource":{"fileName":"DeliveryTag.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DeliveryTag.swift#L77"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"UInt64","preciseIdentifier":"s:s6UInt64V"},{"kind":"text","text":"]) -> ["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]"}],"required":true},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)"},"references":{"doc://Events/documentation/Events/Acknowledger/acknowledge(_:)":{"url":"\/documentation\/events\/acknowledger\/acknowledge(_:)","required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"acknowledge"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V","text":"UInt64"},{"kind":"text","text":"])"}],"role":"symbol","title":"acknowledge(_:)","abstract":[{"text":"Every 