{"abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"Mark an event’s personal or secret properties sensitive by giving them this type:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct SignedUp: Event {","    var plan: String","    var email: Sensitive<String>","}","","tracker.track(SignedUp(plan: \"pro\", email: Sensitive(\"ada@example.com\")))"]},{"inlineContent":[{"type":"text","text":"The value has no public accessor. A destination that needs it asks the record for it with"},{"type":"text","text":" "},{"type":"codeVoice","code":"EventRecord.reveal(_:)"},{"type":"text","text":", which answers "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for a record a delivery redacted"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":" on the destination). Printing, interpolating, dumping or mirroring"},{"type":"text","text":" "},{"type":"text","text":"the value shows "},{"type":"codeVoice","code":"<redacted>"},{"type":"text","text":", so a destination that writes events out as text never writes it."}],"type":"paragraph"},{"inlineCo