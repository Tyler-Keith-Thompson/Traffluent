nedUp(plan: \"pro\", email: Sensitive(\"ada@example.com\")))"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The value has no public accessor. A destination that needs it asks the record for it with"},{"type":"text","text":" "},{"type":"codeVoice","code":"EventRecord.reveal(_:)"},{"type":"text","text":", which answers "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for a record a delivery redacted"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":" on the destination). Printing, interpolating, dumping or mirroring"},{"type":"text","text":" "},{"type":"text","text":"the value shows "},{"type":"codeVoice","code":"<redacted>"},{"type":"text","text":", so a destination that writes events out as text never writes it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It isn’t "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":": comparing it with a guess would reveal it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" when its value is, so a store can keep it, and only a library encoding reads or"},{"type":"text","text":" "},{"type":"text","text":"writes the value. Any other encoder, yours included, writes "},{"type":"codeVoice","code":"null"},{"type":"text","text":" in its place without an"},{"type":"text","text":" "},{"type":"text","text":"error, and any other decoder throws "},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"type":"text","text":". So don’t put a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"your own "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" models: what you encode loses the value, and nothing you encode decodes."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events"]]}