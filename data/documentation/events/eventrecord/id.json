{"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/EventRecord"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"The record’s identifier: a random (version 4) UUID drawn when the record is made. A tracker","type":"text"},{"text":" ","type":"text"},{"text":"draws it when its worker accepts the tracked event, before the record is enriched, stored","type":"text"},{"text":" ","type":"text"},{"text":"or delivered; a store keeps it with the record, so a redelivered record has the identifier","type":"text"},{"text":" ","type":"text"},{"text":"it had when first delivered.","type":"text"}],"sections":[],"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4UUIDV","text":"UUID","kind":"typeIdentifier"}],"symbolKind":"property","title":"id","roleHeading":"Instance Property","modules":[{"name":"Events"}],"remoteSource":{"fileName":"EventRecord.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/EventRecord.swift#L23"},"externalID":"s:6Events11EventRecordV2id20FoundationEssentials4UUIDVvp","role":"symbol"},"variants":[{"paths":["\/documentation\/events\/eventrecord\/id"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/EventRecord\/id"},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:20FoundationEssentials4UUIDV","kind":"typeIdentifier","text":"UUID"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"It identifies the record, not a person: it is drawn for this record alone, never derived"},{"type":"text","text":" "},{"type":"text","text":"from the device, the user, the session or another record, and two records never share one."},{"type":"text","text":" "},{"type":"text","text":"A collector that receives a record twice, as a redelivered record can be, keeps one copy by"},{"type":"text","text":" "},{"type":"text","text":"it."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Events/documentation/Events/EventRecord/id":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4UUIDV","text":"UUID","kind":"typeIdentifier"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/id","abstract":[{"type":"text","text":"The record’s identifier: a random (version 4) UUID drawn when the record is made. A tracker"},{"type":"text","text":" "},{"type":"text","text":"draws it when its worker accepts the tracked event, before the record is enriched, stored"},{"type":"text","text":" "},{"type":"text","text":"or delivered; a store keeps it with the record, so a redelivered record has the identifier"},{"type":"text","text":" "},{"type":"text","text":"it had when first delivered."}],"title":"id","url":"\/documentation\/events\/eventrecord\/id"},"doc://Events/documentation/Events/EventRecord":{"abstract":[{"type":"text","text":"A tracked event: the event itself, when it was tracked, where, and the context it was tracked in."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventRecord","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/events\/eventrecord","navigatorTitle":[{"text":"EventRecord","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","title":"EventRecord"},"doc://Events/documentation/Events":{"url":"