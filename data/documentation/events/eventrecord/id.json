{"abstract":[{"text":"The record’s identifier: a random (version 4) UUID drawn when the record is made. A tracker","type":"text"},{"text":" ","type":"text"},{"text":"draws it when its worker accepts the tracked event, before the record is enriched, stored","type":"text"},{"text":" ","type":"text"},{"text":"or delivered; a store keeps it with the record, so a redelivered record has the identifier","type":"text"},{"text":" ","type":"text"},{"text":"it had when first delivered.","type":"text"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UUID","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4UUIDV"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It identifies the record, not a person: it is drawn for this record alone, never derived"},{"type":"text","text":" "},{"type":"text","text":"from the device, the user, the session or another record, and two records never share one."},{"type":"text","text":" "},{"type":"text","text":"A collector that receives a record twice, as a redelivered record can be, keeps one copy by"},{"type":"text","text":" "},{"type":"text","text":"it."}]}]}],"variants":[{"paths":["\/documentation\/events\/eventrecord\/id"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/EventRecord\/id"},"metadata":{"remoteSource":{"fileName":"EventRecord.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/EventRecord.swift#L23"},"modules":[{"name":"Events"}],"title":"id","roleHeading":"Instance Property","symbolKind":"property","fragments":[