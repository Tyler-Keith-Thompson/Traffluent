{"abstract":[{"type":"text","text":"The record’s identifier: a random (version 4) UUID drawn when the record is made. A tracker"},{"type":"text","text":" "},{"type":"text","text":"draws it when its worker accepts the tracked event, before the record is enriched, stored"},{"type":"text","text":" "},{"type":"text","text":"or delivered; a store keeps it with the record, so a redelivered record has the identifier"},{"type":"text","text":" "},{"type":"text","text":"it had when first delivered."}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/EventRecord\/id"},"variants":[{"paths":["\/documentation\/events\/eventrecord\/id"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UUID","preciseIdentifier":"s:20FoundationEssentials4UUIDV","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"It identifies the record, not a person: it is drawn for this record alone, never derived","type":"text"},{"text":" ","type":"text"},{"text":"from the device, the user, the session or another record, and two records never share one.","type":"text"},{"text":" ","type":"text"},{"text":"A collector that receives a record twice, as a redelivered record can be, keeps one copy by","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/EventRecord"]]},"metadata":{"title":"id","modules":[{"name":"Events"}],"externalID":"s:6Events11EventRecordV2id20FoundationEssentials4UUIDVvp","symbolKind":"property","ro