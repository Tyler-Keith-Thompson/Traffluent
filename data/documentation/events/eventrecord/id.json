nd two records never share one."},{"type":"text","text":" "},{"type":"text","text":"A collector that receives a record twice, as a redelivered record can be, keeps one copy by"},{"type":"text","text":" "},{"type":"text","text":"it."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/EventRecord"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://Events/documentation/Events/EventRecord/id":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The record’s identifier: a random (version 4) UUID drawn when the record is made. A tracker"},{"type":"text","text":" "},{"type":"text","text":"draws it when its worker accepts the tracked event, before the record is enriched, stored"},{"type":"text","text":" "},{"type":"text","text":"or delivered; a store keeps it with the record, so a redelivered record has the identifier"},{"type":"text","text":" "},{"type":"text","text":"it had when first delivered."}],"title":"id","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/id","kind":"symbol","url":"\/documentation\/events\/eventrecord\/id","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UUID","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4UUIDV"}]},"doc://Events/documentation/Events/EventRecord":{"kind":"symbol","role":"symbol","abstract":[{"text":"A tracked event: the event itself, when it was tracked, where, and the context it was tracked in.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventRecord","kind":"identifier"}],"url":"\/documentation\/events\/eventrecord","title":"EventRecord","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","navigatorTitle":[{"text":"EventRecord","kind":"identifier"}],"type":"topic"},"doc://Events/documentation/Events":{"title"