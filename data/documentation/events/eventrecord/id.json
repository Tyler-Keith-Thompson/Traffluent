iched, stored","type":"text"},{"text":" ","type":"text"},{"text":"or delivered; a store keeps it with the record, so a redelivered record has the identifier","type":"text"},{"text":" ","type":"text"},{"text":"it had when first delivered.","type":"text"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/EventRecord\/id"},"kind":"symbol","references":{"doc://Events/documentation/Events/EventRecord":{"kind":"symbol","title":"EventRecord","navigatorTitle":[{"text":"EventRecord","kind":"identifier"}],"url":"\/documentation\/events\/eventrecord","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventRecord","kind":"identifier"}],"abstract":[{"type":"text","text":"A tracked event: the event itself, when it was tracked, where, and the context it was tracked in."}],"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord"},"doc://Events/documentation/Events/EventRecord/id":{"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/id","kind":"symbol","url":"\/documentation\/events\/eventrecord\/id","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UUID","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4UUIDV"}],"title":"id","abstract":[{"type":"text","text":"The record’s identifier: a random (version 4) UUID drawn when the record is made. A tracker"},{"type":"text","text":" "},{"type":"text","text":"draws it when its worker accepts the tracked event, before the record is enriched, stored"},{"type":"text","text":" "},{"type":"text","text":"or delivered; a store keeps it with the record, so a redelivered record has the identifier"},{"type":"text","text":" "},{"type":"text","text":"it had when first delivered."}],"type":"topic","role":"symbol"},"doc://Events/documentation/Events":{"title"