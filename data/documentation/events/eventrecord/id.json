{"sections":[],"abstract":[{"type":"text","text":"The record’s identifier: a random (version 4) UUID drawn when the record is made. A tracker"},{"type":"text","text":" "},{"type":"text","text":"draws it when its worker accepts the tracked event, before the record is enriched, stored"},{"type":"text","text":" "},{"type":"text","text":"or delivered; a store keeps it with the record, so a redelivered record has the identifier"},{"type":"text","text":" "},{"type":"text","text":"it had when first delivered."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4UUIDV","text":"UUID"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"It identifies the record, not a person: it is drawn for this record alone, never derived","type":"text"},{"text":" ","type":"text"},{"text":"from the device, the user, the session or another record, and two records never share one.","type":"text"},{"text":" ","type":"text"},{"text":"A collector that receives a record twice, as a redelivered record can be, keeps one copy by","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/EventRecord"]]},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/eventrecord\/id"]}],"identifier":{"url":"doc:\/\/Events\/documentation\/Events\/EventRecord\/id","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Events"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/Even