e session or another record, and two records never share one.","type":"text"},{"text":" ","type":"text"},{"text":"A collector that receives a record twice, as a redelivered record can be, keeps one copy by","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}]}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/eventrecord\/id"]}],"kind":"symbol","references":{"doc://Events/documentation/Events/EventRecord/id":{"abstract":[{"text":"The record’s identifier: a random (version 4) UUID drawn when the record is made. A tracker","type":"text"},{"text":" ","type":"text"},{"text":"draws it when its worker accepts the tracked event, before the record is enriched, stored","type":"text"},{"text":" ","type":"text"},{"text":"or delivered; a store keeps it with the record, so a redelivered record has the identifier","type":"text"},{"text":" ","type":"text"},{"text":"it had when first delivered.","type":"text"}],"title":"id","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/id","type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UUID","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4UUIDV"}],"url":"\/documentation\/events\/eventrecord\/id"},"doc://Events/documentation/Events":{"abstract":[{"text":"The types every other module shares: the ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"url":"\/documentation\/events","kind":"symbol","role":"collection","title":"Events","identifier":"doc:\/\/Events\/documentation\/Events","type":"topic"},"doc://Events/documentation/Events/EventRecord":{"title":"EventRecord","url":"\/documentation\/events\/eventrecord","navigatorTitle":[{"kind":"identifier","text":"Eve