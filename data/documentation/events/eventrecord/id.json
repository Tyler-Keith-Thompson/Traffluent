 record, not a person: it is drawn for this record alone, never derived"},{"type":"text","text":" "},{"type":"text","text":"from the device, the user, the session or another record, and two records never share one."},{"type":"text","text":" "},{"type":"text","text":"A collector that receives a record twice, as a redelivered record can be, keeps one copy by"},{"type":"text","text":" "},{"type":"text","text":"it."}]}],"kind":"content"}],"references":{"doc://Events/documentation/Events/EventRecord":{"title":"EventRecord","abstract":[{"text":"A tracked event: the event itself, when it was tracked, where, and the context it was tracked in.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventRecord","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","kind":"symbol","type":"topic","url":"\/documentation\/events\/eventrecord","navigatorTitle":[{"text":"EventRecord","kind":"identifier"}]},"doc://Events/documentation/Events/EventRecord/id":{"title":"id","abstract":[{"type":"text","text":"The record’s identifier: a random (version 4) UUID drawn when the record is made. A tracker"},{"type":"text","text":" "},{"type":"text","text":"draws it when its worker accepts the tracked event, before the record is enriched, stored"},{"type":"text","text":" "},{"type":"text","text":"or delivered; a store keeps it with the record, so a redelivered record has the identifier"},{"type":"text","text":" "},{"type":"text","text":"it had when first delivered."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4UUIDV","text":"UUID","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/id","kind":"symbol","type":"topic","url":"\/documentation\/events\/eventrecord\/id"},"doc://Events/documentation/Events":{"role":