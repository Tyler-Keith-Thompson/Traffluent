{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/EventRecord\/id"},"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/EventRecord"]]},"sections":[],"abstract":[{"type":"text","text":"The record’s identifier: a random (version 4) UUID drawn when the record is made. A tracker"},{"type":"text","text":" "},{"type":"text","text":"draws it when its worker accepts the tracked event, before the record is enriched, stored"},{"type":"text","text":" "},{"type":"text","text":"or delivered; a store keeps it with the record, so a redelivered record has the identifier"},{"type":"text","text":" "},{"type":"text","text":"it had when first delivered."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/eventrecord\/id"]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/EventRecord.swift#L23","fileName":"EventRecord.swift"},"title":"id","externalID":"s:6Events11EventRecordV2id20FoundationEssentials4UUIDVvp","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4UUIDV","text":"UUID","kind":"typeIdentifier"}],"modules":[{"name":"Events"}],"roleHeading":"Instance Property","role":"symbol"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UUID","preciseIdentifier":"s:20FoundationEssentials4UUIDV","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"It identifies the record, not a person: it is drawn for this record alone, never derived"},{"type":"text","text":" "},{"type":"text","text":"from the device, the user, the session or another record, and two records never share one."},{"type":"text","text":" "},{"type":"text","text":"A collector that receives a record twice, as a redelivered record can be, keeps one copy by"},{"type":"text","text":" "},{"type":"text","text":"it."}],"type":"paragraph"}]}],"references":{"doc://Events/documentation/Events":{"abstract":[],"role":"collection","url":"\/documentation\/events","type":"topic","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events","title":"Events"},"doc://Events/documentation/Events/EventRecord":{"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/events\/eventrecord","navigatorTitle":[{"text":"EventRecord","kind":"identifier"}],"title":"EventRecord","abstract":[{"type":"text","text":"A tracked event: the event itself, when it was tracked, where, and the context it was tracked in."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventRecord","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord"},"doc://Events/documentation/Events/EventRecord/id":{"type":"topic","abstract":[{"type":"text","text":"The record’s identifier: a random (version 4) UUID drawn when the record is made. A tracker"},{"type":"text","text":" "},{"type":"text","text":"draws it when its worker accepts the tracked event, before the record is enriched, stored"},{"type":"text","text":" "},{"type":"text","text":"or delivered; a store keeps it with the record, so a redelivered record has the identifier"},{"type":"text","text":" "},{"type":"text","text":"it had when first delivered."}],"url":"\/documentation\/events\/eventrecord\/id","kind":"symbol","title":"id","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/id","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"tex