iment = Enricher { context in","    context[ExperimentKey.self] = \"new-checkout\"","}","let tracker = Tracker(enrichers: [experiment])"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A tracker’s worker runs its enrichers in order, on the context ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" took from","type":"text"},{"text":" ","type":"text"},{"code":"ServiceContext.current","type":"codeVoice"},{"text":" when the event was tracked: an enricher sees what earlier ones set,","type":"text"},{"text":" ","type":"text"},{"text":"and may override a value the caller’s context already holds. It runs on the worker, not the","type":"text"},{"text":" ","type":"text"},{"text":"tracking caller’s thread, so it sees the caller’s context only, not its other task-local","type":"text"},{"text":" ","type":"text"},{"text":"values or its actor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Given to one destination instead, with ","type":"text"},{"code":"enriched(by:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"Destinations","type":"codeVoice"},{"text":"), an enricher","type":"text"},{"text":" ","type":"text"},{"text":"runs on the records that destination receives as the delivery hands it each batch, so the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s other destinations don’t see what it sets.","type":"text"}]}]}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Events\/documentation\/Events\/Enricher\/init(_:)"],"generated":true,"anchor":"Initializers"}],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events"]]},"references":{"doc://Events/documentation/Events/Enricher/init(_:)":{"title":"init(_:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"(("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:15Instrumentation14ServiceContexta","text":"ServiceContext"},{"kind":"text"