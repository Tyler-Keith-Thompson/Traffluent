eeps the one at the"},{"type":"text","text":" "},{"type":"text","text":"highest version of types that share a name and differ in version. The fully qualified name"},{"type":"text","text":" "},{"type":"text","text":"of a type in a private scope holds an address that changes between launches, so the order"},{"type":"text","text":" "},{"type":"text","text":"of such types of one name and version, and the names a store’s or plan’s error gives for"},{"type":"text","text":" "},{"type":"text","text":"them, can change too."}]},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") in the events, after a walk of the program’s loaded images."}],"type":"paragraph"}],"style":"note"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/discoveredevent\/all"]}],"sections":[],"abstract":[{"type":"text","text":"Every event type the program links, ordered by the UTF-8 bytes of their names, then by"},{"type":"text","text":" "},{"type":"text","text":"version, then by the types’ fully qualified names."}],"references":{"doc://Events/documentation/Events/DiscoveredEvent":{"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscoveredEvent"}],"url":"\/documentation\/events\/discoveredevent","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DiscoveredEvent"}],"title":"DiscoveredEvent","abstract":[{"type":"text","text":"An event type found in the running program: one declared with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", or one of the"},{"type":"text","text":" "},{"type":"text","text"