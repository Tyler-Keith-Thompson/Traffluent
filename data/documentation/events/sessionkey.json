{"topicSections":[{"title":"Type Aliases","identifiers":["doc:\/\/Events\/documentation\/Events\/SessionKey\/Value"],"generated":true,"anchor":"Type-Aliases"},{"title":"Default Implementations","identifiers":["doc:\/\/Events\/documentation\/Events\/SessionKey\/InstrumentationContextKey-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SessionKey","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A destination reads it from each record’s context:"}],"type":"paragraph"},{"syntax":"swift","code":["let session = record.context[SessionKey.self]  \/\/ a UUID"],"type":"codeListing"},{"inlineContent":[{"text":"The identifier is a version 7 UUID: its first 48 bits are the session’s start, the timestamp","type":"text"},{"text":" ","type":"text"},{"text":"of its first record, in Unix milliseconds, and the other 74 bits that aren’t the version and","type":"text"},{"text":" ","type":"text"},{"text":"variant are random, never derived from the device, the user or another identifier. The","type":"text"},{"text":" ","type":"text"},{"text":"enricher keeps it in memory only, so a new tracker, as on the next launch, starts a new session","type":"text"},{"text":" ","type":"text"},{"text":"with a new identifier.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A store keeps it beside each record of the session, as part of the record’s own bytes, and it"},{"type":"text","text":" "},{"type":"text","text":"is deleted when the store deletes the record’s bytes (a "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":": once its whole segment"},{"type":"text","text":" "},{"type":"text","text":"is delivered). So a record recovered after a relaunch carries the session it was tracked in,"},{"type":"text","text":" "},{"type":"text","text":"and a destination sends it under the same identifier as before. It is the only part of a record’s context a store keeps, and a store never keeps"},{"type":"text","text":" "},{"type":"text","text":"it apart from a record."}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Events\/15Instrumentation0A10ContextKeyP","doc:\/\/Events\/s8SendableP","doc:\/\/Events\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/sessionkey"]}],"metadata":{"roleHeading":"Enumeration","modules":[{"name":"Events"}],"externalID":"s:6Events10SessionKeyO","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SessionKey"}],"navigatorTitle":[{"kind":"identifier","text":"SessionKey"}],"symbolKind":"enum","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/SessionKey.swift#L24","fileName":"SessionKey.swift"},"title":"SessionKey"},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Records","identifiers":["doc:\/\/Events\/documentation\/Events\/EventRecord","doc:\/\/Events\/documentation\/Events\/SourceLocation","doc:\/\/Events\/documentation\/Events\/Enricher"],"generated":true,"anchor":"Records"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/SessionKey"},"abstract":[{"type":"text","text":"The "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":" key of the session an event was tracked in: a random identifier that"},{"type":"text","text":" "},{"code":"Enricher.sessions(timeout:kinds:)","type":"codeVoice"},{"type":"text","text":" (module "},{"code":"Sessions","type":"codeVoice"},{"type":"text","text":") sets on every record’s context."}],"references":{"doc://Events/15Instrumentation0A10ContextKeyP":{"title":"Instrumentation.InstrumentationContextKey","type":"unresolvable","identifier":"doc:\/\/Events\/15Instrumentation0A10ContextKeyP"},"doc://Events/documentation/Events/SessionKey/InstrumentationContextKey-Implementations":{"type":"topic","kind":"article","identifier":"doc:\/\/Events\/documentation\/Events\/SessionKey\/InstrumentationContextKey-Implementations","title":"InstrumentationContextKey Implementations","abstract":[],"role":"collectionGroup","url":"\/documentation\/events\/sessionkey\/instrumentationcontextkey-implementations"},"doc://Events/documentation/Events/SessionKey":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SessionKey"}],"url":"\/documentation\/events\/sessionkey","navigatorTitle":[{"kind":"identifier","text":"SessionKey"}],"kind":"symbol","abstract":[{"text":"The ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" key of the session an event was tracked in: a random identifier that","type":"text"},{"text":" ","type":"text"},{"code":"Enricher.sessions(timeout:kinds:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"Sessions","type":"codeVoice"},{"text":") sets on every record’s context.","type":"text"}],"title":"SessionKey","identifier":"doc:\/\/Events\/documentation\/Events\/SessionKey"},"doc://Events/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Events\/s8SendableP","title":"Swift.Sendable"},"doc://Events/documentation/Events/SourceLocation":{"identifier":"doc:\/\/Events\/documentation\/Events\/SourceLocation","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SourceLocation","kind":"identifier"}],"navigatorTitle":[{"text":"SourceLocation","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/docum