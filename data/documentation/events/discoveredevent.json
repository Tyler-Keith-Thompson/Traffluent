{"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscoveredEvent"}],"symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DiscoveredEvent.swift#L60","fileName":"DiscoveredEvent.swift"},"modules":[{"name":"Events"}],"role":"symbol","roleHeading":"Structure","title":"DiscoveredEvent","navigatorTitle":[{"kind":"identifier","text":"DiscoveredEvent"}],"externalID":"s:6Events15DiscoveredEventV"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscoveredEvent"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all"},{"type":"text","text":" lists every one the program links, from every module, so a store or a tracking plan"},{"type":"text","text":" "},{"type":"text","text":"can be built from it with no list to keep: "},{"type":"codeVoice","code":"SegmentStore()"},{"type":"text","text":", "},{"type":"codeVoice","code":"DatabaseStore(database:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"TrackingPlan()"},{"type":"text","text":" each use it."}]},{"type":"codeListing","syntax":"swift","code":["import Traffluent","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","}","","DiscoveredEvent.all.map { $0.type.name }","\/\/ [\"ApplicationBackgrounded\", ..., \"SessionStarted\", \"signed_up\"]"]},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct is discovered, wherever it is declared, unless it is generic or nested in","type":"text"},{"text":" ","type":"text"},{"text":"a generic type, as neither can hold the record ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" places in the binary; the macro notes","type":"text"},{"text":" ","type":"text"},{"text":"each one where it is declared. One declared in an extension of a generic type doesn’t compile.","type":"text"},{"text":" ","type":"text"},{"text":"The library’s own events are discovered too: ","type":"text"},{"code":"SessionStarted","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SessionEnded","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ControlActivated","type":"codeVoice"},{"text":" and the ","type":"text"},{"code":"Application","type":"codeVoice"},{"text":" events of ","type":"text"},{"code":"LifecycleTracking","type":"codeVoice"},{"text":", once","type":"text"},{"text":" ","type":"text"},{"text":"their modules are linked. An event that conforms to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Event"},{"text":" by hand, without ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", isn’t:","type":"text"},{"text":" ","type":"text"},{"text":"list it beside the discovered ones, ","type":"text"},{"code":"DiscoveredEvent.all.map(\\.type) + [Legacy.self]","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Limits","level":2,"type":"heading","text":"Limits"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An object file in a static archive that nothing references brings no record into the"},{"type":"text","text":" "},{"type":"text","text":"program: the linker leaves it out, the library’s own events’ files included. SwiftPM links"},{"type":"text","text":" "},{"type":"text","text":"every object file, and so does Bazel: from rules_swift 3.0, "},{"type":"codeVoice","code":"swift_library"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"alwayslink = True"},{"type":"text","text":" unless a target says otherwise, and rules_swift_package_manager sets it"},{"type":"text","text":" "},{"type":"text","text":"on every target of a package. Apple’s linker, given "},{"type":"codeVoice","code":"-ObjC"},{"type":"text","text":", also loads each member that"},{"type":"text","text":" "},{"type":"text","text":"declares a Swift type or a protocol conformance, though not one holding only an extension"},{"type":"text","text":" "},{"type":"text","text":"that adds members; every "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" declares a struct. A static library or static XCFramework"},{"type":"text","text":" "},{"type":"text","text":"linked without "},{"type":"codeVoice","code":"-ObjC"},{"type":"text","text":", or a Bazel library with "},{"type":"codeVoice","code":"alwayslink = False"},{"type":"text","text":" on Linux, leaves its"},{"type":"text","text":" "},{"type":"text","text":"unreferenced events out. Link such a library whole"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"-force_load"},{"type":"text","text":" on Apple platforms, "},{"type":"codeVoice","code":"--whole-archive"},{"type":"text","text":" on Linux) to have its events found."}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","type":"reference","isActive":true},{"type":"text","text":" holds the events of the images loaded when it is called: the program and the"},{"type":"text","text":" "},{"type":"text","text":"dynamic libraries it links. A library opened later with "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" adds its events from then on."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A library that loads or unloads while ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","type":"reference","isActive":true},{"text":" is read is either read whole or left out of","type":"text"},{"text":" ","type":"text"},{"text":"that read. On Apple platforms one that dyld adds before the read starts is found; on Linux a","type":"text"},{"text":" ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"dlclose","type":"codeVoice"},{"text":" waits for the read, so the library is missed. The next read sees it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Don’t "},{"type":"codeVoice","code":"dlclose"},{"type":"text","text":" a library that declares events while the process runs. On Apple platforms"},{"type":"text","text":" "},{"type":"text","text":"dyld keeps it mapped and its events are still found. On Linux the loader unmaps it while the"},{"type":"text","text":" "},{"type":"text","text":"Swift runtime keeps its types registered, and the process can crash later. Keep plug-ins"},{"type":"text","text":" "},{"type":"text","text":"open, or open them with "},{"type":"codeVoice","code":"RTLD_NODELETE"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A module that declares events, linked into two images, lists each of its events twice, and","type":"text"},{"text":" ","type":"text"},{"text":"stores and plans refuse the duplicate. Link each such module into one image.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Two events of one name in one linked image, the modules linked statically into one executable","type":"text"},{"text":" ","type":"text"},{"text":"or library, fail to build: ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" gives each record a symbol named for the event’s name,","type":"text"},{"text":" ","type":"text"},{"text":"which the compiler or the linker refuses to define twice. Separate images are never compared,","type":"text"},{"text":" ","type":"text"},{"text":"so a name shared with a dynamic library, a library opened with ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":", or a module linked","type":"text"},{"text":" ","type":"text"},{"text":"into two images is found only here: a store or plan built from ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","type":"reference","isActive":true},{"text":" refuses two of one","type":"text"},{"text":" ","type":"text"},{"text":"name and version, and a store keeps the highest of one name’s versions. So is one declared","type":"text"},{"text":" ","type":"text"},{"text":"inside a ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"fileprivate","type":"codeVoice"},{"text":" type, whose symbol is local to its file.","type":"text"}]}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/events\/discoveredevent"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Events\/s8SendableP","doc:\/\/Events\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events"]]},"kind":"symbol","seeAlsoSections":[{"anchor":"Events","title":"Events","generated":true,"identifiers":["doc:\/\/Events\/documentation\/Events\/Event","doc:\/\/Events\/documentation\/Events\/ConsentCategory","doc:\/\/Events\/documentation\/Events\/EventSchema","doc:\/\/Events\/documentation\/Events\/EventSchema\/Enumeration"]}],"topicSections":[{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/schema","doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/type"]},{"anchor":"Type-Properties","title":"Type Properties","generated":true,"identifiers":["doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all"]}],"identifier":{"url":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent","interfa