{"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events"]]},"sections":[],"abstract":[{"type":"text","text":"An event type found in the running program: one declared with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", or one of the"},{"type":"text","text":" "},{"type":"text","text":"library’s own events, with its schema."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"DiscoveredEvent"}],"externalID":"s:6Events15DiscoveredEventV","modules":[{"name":"Events"}],"symbolKind":"struct","role":"symbol","roleHeading":"Structure","title":"DiscoveredEvent","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscoveredEvent","kind":"identifier"}],"remoteSource":{"fileName":"DiscoveredEvent.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DiscoveredEvent.swift#L41"}},"seeAlsoSections":[{"title":"Events","generated":true,"anchor":"Events","identifiers":["doc:\/\/Events\/documentation\/Events\/Event","doc:\/\/Events\/documentation\/Events\/ConsentCategory","doc:\/\/Events\/documentation\/Events\/EventSchema","doc:\/\/Events\/documentation\/Events\/EventSchema\/Enumeration"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent"},"kind":"symbol","topicSections":[{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/schema","doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/type"]},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all"]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/Events\/s8SendableP","doc:\/\/Events\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscoveredEvent","kind":"identifier"}]}]},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","isActive":true,"type":"reference"},{"text":" lists every one the program links, from every module, so a store or a tracking plan","type":"text"},{"text":" ","type":"text"},{"text":"can be built from it with no list to keep: ","type":"text"},{"code":"SegmentStore()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DatabaseStore(database:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"TrackingPlan()","type":"codeVoice"},{"text":" each use it.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Traffluent","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","}","","DiscoveredEvent.all.map { $0.type.name }","\/\/ [\"ApplicationBackgrounded\", ..., \"SessionStarted\", \"signed_up\"]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct is discovered, wherever it is declared, unless it is generic or nested in"},{"type":"text","text":" "},{"type":"text","text":"a generic type, as neither can hold the record "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" places in the binary; the macro notes"},{"type":"text","text":" "},{"type":"text","text":"each one where it is declared. One declared in an extension of a generic type doesn’t compile."},{"type":"text","text":" "},{"type":"text","text":"The library’s own events are discovered too: "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":", "},{"type":"codeVoice","code":"SessionEnded"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":", "},{"type":"codeVoice","code":"ControlActivated"},{"type":"text","text":" and the "},{"type":"codeVoice","code":"Application"},{"type":"text","text":" events of "},{"type":"codeVoice","code":"LifecycleTracking"},{"type":"text","text":", once"},{"type":"text","text":" "},{"type":"text","text":"their modules are linked. An event that conforms to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Event"},{"type":"text","text":" by hand, without "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", isn’t:"},{"type":"text","text":" "},{"type":"text","text":"list it beside the discovered ones, "},{"type":"codeVoice","code":"DiscoveredEvent.all.map(\\.type) + [Legacy.self]"},{"type":"text","text":"."}]},{"anchor":"Limits","text":"Limits","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"An object file in a static archive that nothing references brings no record into the"},{"type":"text","text":" "},{"type":"text","text":"program: the linker leaves it out. That happens with CocoaPods’ static libraries, a static"},{"type":"text","text":" "},{"type":"text","text":"XCFramework, or a Bazel library with "},{"type":"codeVoice","code":"alwayslink = False"},{"type":"text","text":". SwiftPM, and Bazel’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"alwayslink = True"},{"type":"text","text":", link every object file. Link such a library whole ("},{"type":"codeVoice","code":"-force_load"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"text","text":"Apple platforms, "},{"type":"codeVoice","code":"--whole-archive"},{"type":"text","text":" on Linux) to have its events found."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","isActive":true,"type":"reference"},{"text":" holds the events of the images loaded when it is called: the program and the","type":"text"},{"text":" ","type":"text"},{"text":"dynamic libraries it links. A library opened later with ","type":"text"},{"type":"codeVoice","code":"dlopen"},{"text":" adds its events from then on.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A module that declares events, linked into two images, lists each of its events twice, and"},{"type":"text","text":" "},{"type":"text","text":"stores and plans refuse the duplicate. Link each such module into one image."}],"type":"paragraph"}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/discoveredevent"]}],"references":{"doc://Events/documentation/Events/Event":{"kind":"symbol","url":"\/documentation\/events\/event","role":"symbol","abstract":[{"type":"text","text":"Something that happened, recorded as a typed value."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Event"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Event","title":"Event"},"doc://Events/documentation/Events/DiscoveredEvent/schema":{"kind":"symbol","type":"topic","abstract":[{"text":"The event’s schema.","type":"text"}],"url":"\/documentation\/events\/discoveredevent\/schema","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"schema"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventSchemaV","text":"EventSchema"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/schema","title":"schema"},"doc://Events/documentation/Events/DiscoveredEvent/all":{"type":"topic","url":"\/documentation\/events\/discoveredevent\/all","kind":"symbol","title":"all","role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","fragments":[{"kind":"keywo