er"}],"url":"\/documentation\/events\/discoveredevent","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent","kind":"symbol","title":"DiscoveredEvent","type":"topic"},"doc://Events/documentation/Events":{"abstract":[{"text":"The types every other module shares: the ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"url":"\/documentation\/events","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events","title":"Events","type":"topic","role":"collection"},"doc://Events/documentation/Events/DiscoveredEvent/schema":{"role":"symbol","abstract":[{"text":"The event’s schema.","type":"text"}],"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/schema","url":"\/documentation\/events\/discoveredevent\/schema","type":"topic","title":"schema","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"schema","kind":"identifier"},{"text":": ","kind":"text"},{"text":"EventSchema","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventSchemaV"}]}}}