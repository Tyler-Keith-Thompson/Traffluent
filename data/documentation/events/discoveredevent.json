{"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events"]]},"topicSections":[{"identifiers":["doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/schema","doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/type"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all"],"generated":true,"anchor":"Type-Properties","title":"Type Properties"}],"kind":"symbol","abstract":[{"type":"text","text":"An event type found in the running program: one declared with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", or one of the"},{"type":"text","text":" "},{"type":"text","text":"library’s own events, with its schema."}],"variants":[{"paths":["\/documentation\/events\/discoveredevent"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"struct","modules":[{"name":"Events"}],"navigatorTitle":[{"kind":"identifier","text":"DiscoveredEvent"}],"externalID":"s:6Events15DiscoveredEventV","title":"DiscoveredEvent","roleHeading":"Structure","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscoveredEvent"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DiscoveredEvent.swift#L41","fileName":"DiscoveredEvent.swift"}},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Events\/s8SendableP","doc:\/\/Events\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscoveredEvent","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","type":"reference","isActive":true},{"type":"text","text":" lists every one the program links, from every module, so a store or a tracking plan"},{"type":"text","text":" "},{"type":"text","text":"can be built from it with no list to keep: "},{"code":"SegmentStore()","type":"codeVoice"},{"type":"text","text":", "},{"code":"DatabaseStore(database:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"TrackingPlan()","type":"codeVoice"},{"type":"text","text":" each use it."}],"type":"paragraph"},{"syntax":"swift","code":["import Traffluent","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","}","","DiscoveredEvent.all.map { $0.type.name }","\/\/ [\"ApplicationBackgrounded\", ..., \"SessionStarted\", \"signed_up\"]"],"type":"codeListing"},{"inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" struct is discovered, wherever it is declared, unless it is generic or nested in","type":"text"},{"text":" ","type":"text"},{"text":"a generic type, as neither can hold the record ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" places in the binary; the macro notes","type":"text"},{"text":" ","type":"text"},{"text":"each one where it is declared. One declared in an extension of a generic type doesn’t compile.","type":"text"},{"text":" ","type":"text"},{"text":"The library’s own events are discovered too: ","type":"text"},{"type":"codeVoice","code":"SessionStarted"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SessionEnded"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ScreenViewed"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ControlActivated"},{"text":" and the ","type":"text"},{"type":"codeVoice","code":"Application"},{"text":" events of ","type":"text"},{"type":"codeVoice","code":"LifecycleTracking"},{"text":", once","type":"text"},{"text":" ","type":"text"},{"text":"their modules are linked. An event that conforms to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Event","type":"reference"},{"text":" by hand, without ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":", isn’t:","type":"text"},{"text":" ","type":"text"},{"text":"list it beside the discovered ones, ","type":"text"},{"type":"codeVoice","code":"DiscoveredEvent.all.map(\\.type) + [Legacy.self]"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Limits","anchor":"Limits","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"An object file in a static archive that nothing references brings no record into the"},{"type":"text","text":" "},{"type":"text","text":"program: the linker leaves it out. That happens with CocoaPods’ static libraries, a static"},{"type":"text","text":" "},{"type":"text","text":"XCFramework, or a Bazel library with "},{"code":"alwayslink = False","type":"codeVoice"},{"type":"text","text":". SwiftPM, and Bazel’s"},{"type":"text","text":" "},{"code":"alwayslink = True","type":"codeVoice"},{"type":"text","text":", link every object file. Link such a library whole ("},{"code":"-force_load","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"text","text":"Apple platforms, "},{"code":"--whole-archive","type":"codeVoice"},{"type":"text","text":" on Linux) to have its events found."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","isActive":true},{"type":"text","text":" holds the events of the images loaded when it is called: the program and the"},{"type":"text","text":" "},{"type":"text","text":"dynamic libraries it links. A library opened later with "},{"code":"dlopen","type":"codeVoice"},{"type":"text","text":" adds its events from then on."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A module that declares events, linked into two images, lists each of its events twice, and","type":"text"},{"text":" ","type":"text"},{"text":"stores and plans refuse the duplicate. Link each such module into one image.","type":"text"}]}]}],"type":"unorderedList"}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/Events\/documentation\/Events\/Event","doc:\/\/Events\/documentation\/Events\/ConsentCategory","doc:\/\/Events\/documentation\/Events\/EventSchema","doc:\/\/Events\/documentation\/Events\/EventSchema\/Enumeration"],"generated":true,"anchor":"Events","title":"Events"}],"references":{"doc://Events/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/Events\/s16SendableMetatypeP","type":"unresolvable"},"doc://Events/documentation/Events/DiscoveredEvent/type":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"type","kind":"identifier"},{"text":": any (","kind":"text"},{"text":"Event","kind":"typeIdentifier","preciseIdentifier":"s:6Events5EventP"},{"text":" & ","kind":"text"},{"text":"Codable","kind":"typeIdentifier","preciseIdentifier":"s:s7Codablea"},{"text":").Type","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/type","title":"type","kind":"symbol","abstract":[{"text":"The event’s type.","type":"text"}],"type":"topic","url":"\/documentation\/events\/discoveredevent\/type"},"doc://Events/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/Events\/s8SendableP"},"doc://Events/documentation/Events/Event":{"identifier":"doc:\/\/Events\/documentation\/Events\/Event","type":"topic","url":"\/documentation\/events\/event","title":"Event","kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"}],"navigatorTitle":[{"text":"Event","kin