ifier":"s:Si"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#column"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"LifecycleObservation","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The kinds of event to track; every kind by default. Leaving one out doesn’t"},{"type":"text","text":" "},{"type":"text","text":"stop the rest of the work: the version is still saved, and the records still made"},{"type":"text","text":" "},{"type":"text","text":"durable on backgrounding."}]}],"name":"kinds"},{"content":[{"inlineContent":[{"text":"The version the app runs at now; the bundle’s ","type":"text"},{"type":"codeVoice","code":"CFBundleShortVersionString"},{"text":" ","type":"text"},{"text":"by default. ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" tracks neither installs nor updates, and saves nothing.","type":"text"}],"type":"paragraph"}],"name":"version"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Where the version is kept from one launch to the next; a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","type":"reference","isActive":true},{"text":" in ","type":"text"},{"code":"SegmentStore.defaultDirectory","type":"codeVoice"},{"text":" by default.","type":"text"}]}],"name":"versionStore"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the platform posts its lifecycle notifications; the default"},{"type":"text","text":" "},{"type":"text","text":"center by default."}]}],"name":"notificationCenter"},{"content":[{"inlineContent":[{"type":"text","text":"The caller’s file; leave it to its default."}],"type":"paragraph"}],"name":"file"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}]}],"name":"fileID"},{"content":[{"inlineContent":[{"type":"text","text":"The caller’s enclosing declaration; leave it to its default."}],"type":"paragraph"}],"name":"function"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}]}],"name":"line"},{"content":[{"inlineContent":[{"type":"text","text":"The caller’s column; leave it to its default."}],"type":"paragraph"}],"name":"column"}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The observation, which tracks until it is cancelled, finished or released."}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Nothing is tracked until this is called. Call it as the app launches, such as in its"},{"type":"text","text":" "},{"type":"text","text":"application delegate’s "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":", and keep what it"},{"type":"text","text":" "},{"type":"text","text":"returns:"}],"type":"paragraph"},{"syntax":"swift","code":["lifecycle = tracker.trackLifecycle()"],"type":"codeListing"},{"inlineContent":[{"text":"As it starts, it compares ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" with the one ","type":"text"},{"code":"versionStore","type":"codeVoice"},{"text":" saved: none tracks an","type":"text"},{"text":" ","type":"text"},{"text":"install, another an update, the same neither; it then saves ","type":"text"},{"code":"version","type":"codeVoice"},{"text":". Then it tracks an","type":"text"},{"text":" ","type":"text"},{"text":"open, not from the background. After that, each transition tracks once, however many times","type":"text"},{"text":" ","type":"text"},{"text":"it is reported:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s notifications. Entering"},{"type":"text","text":" "},{"type":"text","text":"the background tracks "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded"},{"type":"text","text":", returning to the foreground"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened"},{"type":"text","text":" from the background, and terminating "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A scene-based app gets them once for the whole app, not per scene."}]}]},{"content":[{"inlineContent":[{"text":"watchOS: ","type":"text"},{"code":"WKApplication","type":"codeVoice"},{"text":"‘s, without termination, which watchOS doesn’t report.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"macOS: "},{"type":"codeVoice","code":"NSApplication"},{"type":"text","text":"’s. Another app becoming active counts as the background, this"},{"type":"text","text":" "},{"type":"text","text":"one becoming active again as the foreground."}]}]},{"content":[{"inlineContent":[{"text":"Linux: no notifications; ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true,"type":"reference"},{"text":" tracks the termination.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls","type":"text"},{"text":" ","type":"text"},{"text":"the store’s ","type":"text"},{"type":"codeVoice","code":"synchronize()"},{"text":". A delivery batched with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy"},{"text":" sends what","type":"text"},{"text":" ","type":"text"},{"text":"is pending as it reads the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded"},{"text":" record. A notification’s handler only","type":"text"},{"text":" ","type":"text"},{"text":"hands the transition on; the tracking, the version store and the store’s work run on a","type":"text"},{"text":" ","type":"text"},{"text":"task of their own, never on the thread that posted it. Where the system suspends an app in the","type":"text"},{"text":" ","type":"text"},{"text":"background (all but macOS and Mac Catalyst), the handler asks it for background time","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"},{"text":"), held until the records are durable. A termination’s records are made durable the same way, without","type":"text"},{"text":" ","type":"text"},{"text":"holding the main thread up: what the process doesn’t finish before it exits is what the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s documented loss window takes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per","type":"text"},{"text":" ","type":"text"},{"text":"tracker.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleBatch