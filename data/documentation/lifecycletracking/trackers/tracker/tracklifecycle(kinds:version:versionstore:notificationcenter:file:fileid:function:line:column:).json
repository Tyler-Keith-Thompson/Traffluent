":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true},{"type":"text","text":" record, so what is pending goes out as the app leaves the foreground"},{"type":"text","text":" "},{"type":"text","text":"rather than waiting for its count or time."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LifecycleBatchStrategy"}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","title":"LifecycleBatchStrategy"},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationBackgrounded":{"url":"\/documentation\/lifecycletracking\/applicationbackgrounded","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ApplicationBackgrounded","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The app moved to the background: what "},{"code":"trackLifecycle","type":"codeVoice"},{"type":"text","text":" tracks each time the app leaves the"},{"type":"text","text":" "},{"type":"text","text":"foreground (on macOS, each time it stops being the active app)."}],"role":"symbol","navigatorTitle":[{"text":"ApplicationBackgrounded","kind":"identifier"}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","title":"ApplicationBackgrounded"},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationUpdated":{"role":"symbol","navigatorTitle":[{"text":"ApplicationUpdated","kind":"identifier"}],"url":"\/documentation\/lifecycletracking\/applicationupdated","type":"topic","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","kind":"symbol","abstract":[{"text":"The app ran for the first time at ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated\/version"},{"text":" after running at "