foDictionary?[\"CFBundleShortVersionString\"] as? String, "},{"kind":"externalParam","text":"versionStore"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:17LifecycleTracking12VersionStoreP","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","text":"VersionStore"},{"kind":"text","text":" = FileVersionStore(), "},{"kind":"externalParam","text":"notificationCenter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials18NotificationCenterC","text":"NotificationCenter"},{"kind":"text","text":" = .default, "},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#file"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#fileID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"function"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#function"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#line"},{"kind":"text","text":", "},{"kind":"externalParam","text":"column"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#column"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","text":"LifecycleObservation"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"kinds","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The kinds of event to track; every kind by default. Leaving one out doesn’t"},{"type":"text","text":" "},{"type":"text","text":"stop the rest of the work: the version is still saved, and the records still made"},{"type":"text","text":" "},{"type":"text","text":"durable on backgrounding."}]}]},{"name":"version","content":[{"inlineContent":[{"type":"text","text":"The version the app runs at now; the bundle’s "},{"type":"codeVoice","code":"CFBundleShortVersionString"},{"type":"text","text":" "},{"type":"text","text":"by default. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" tracks neither installs nor updates, and saves nothing."}],"type":"paragraph"}]},{"name":"versionStore","content":[{"inlineContent":[{"type":"text","text":"Where the version is kept from one launch to the next; a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","isActive":true},{"type":"text","text":" in "},{"code":"SegmentStore.defaultDirectory","type":"codeVoice"},{"type":"text","text":" by default."}],"type":"paragraph"}]},{"name":"notificationCenter","content":[{"inlineContent":[{"type":"text","text":"Where the platform posts its lifecycle notifications; the default"},{"type":"text","text":" "},{"type":"text","text":"center by default."}],"type":"paragraph"}]},{"name":"file","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s file; leave it to its default."}]}]},{"name":"fileID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}]}]},{"name":"function","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}]}]},{"name":"line","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s line; leave it to its default.","type":"text"}]}]},{"name":"column","content":[{"inlineContent":[{"type":"text","text":"The caller’s column; leave it to its default."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The observation, which tracks until it is cancelled, finished or released.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Nothing is tracked until this is called. Call it as the app launches, such as in its","type":"text"},{"text":" ","type":"text"},{"text":"application delegate’s ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":", and keep what it","type":"text"},{"text":" ","type":"text"},{"text":"returns:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["lifecycle = tracker.trackLifecycle()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"As it starts, it compares "},{"type":"codeVoice","code":"version"},{"type":"text","text":" with the one "},{"type":"codeVoice","code":"versionStore"},{"type":"text","text":" saved: none tracks an"},{"type":"text","text":" "},{"type":"text","text":"install, another an update, the same neither; it then saves "},{"type":"codeVoice","code":"version"},{"type":"text","text":". Then it tracks an"},{"type":"text","text":" "},{"type":"text","text":"open, not from the background. After that, each transition tracks once, however many times"},{"type":"text","text":" "},{"type":"text","text":"it is reported:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s notifications. Entering"},{"type":"text","text":" "},{"type":"text","text":"the background tracks "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":", returning to the foreground"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":" from the background, and terminating "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A scene-based app gets them once for the whole app, not per scene."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"watchOS: ","type":"text"},{"type":"codeVoice","code":"WKApplication"},{"text":"‘s, without termination, which watchOS doesn’t report.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"macOS: "},{"code":"NSApplication","type":"codeVoice"},{"type":"text","text":"’s. Another app becoming active counts as the background, this"},{"type":"text","text":" "},{"type":"text","text":"one becoming active again as the foreground."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Linux: no notifications; "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true,"type":"reference"},{"type":"text","text":" tracks the termination."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"code":"synchronize()","type":"codeVoice"},{"type":"text","text":". A delivery batched with "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","type":"reference","isActive":true},{"type":"text","text":" sends what"},{"type":"text","text":" "},{"type":"text","text":"is pending as it reads the "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"type":"text","text":" record. A notification’s handler only"},{"type":"text","text":" "},{"type":"text","text":"hands the transition on; the tracking, the version store and the store’s work run on a"},{"type":"text","text":" "},{"type":"text","text":"task of their own, never on the thread that posted it. Where the system suspends an app in the"},{"type":"text","text":" "},{"type":"text","text":"background (all but macOS and Mac Catalyst), the handler asks it for background time"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"ProcessInfo.performExpiringActivity","type":"codeVoice"},{"type":"text","text":"), held until the records are durable. A termination’s records are made durable the same way, without"},{"type":"text","text":" "},{"type":"text","text":"holding the main thread up: what the process doesn’t finish before it exits is what the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s documented loss window takes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per"},{"type":"text","text":" "},{"type":"text","text":"tracker."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"symbol","references":{"doc://LifecycleTracking/documentation/LifecycleTracking/FileVersionStore":{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","isActive":true},{"type":"text","text":" that keeps the version in a file named "},{"type":"codeVoice","code":"version"},{"type":"text","text":" in a directory."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FileVersionStore"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"FileVersionStore"}],"title":"FileVersionStore","url":"\/documentation\/lifecycletracking\/fileversionstore","role":"symbol","type":"topic"},"doc://LifecycleTracking/documentation/LifecycleTracking/Trackers":{"url":"\/documentation\/lifecycletracking\/trackers","type":"topic","abstract":[],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers","title":"Trackers","kind":"symbol","role":"collection"},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationInstalled/version":{"url":"\/documentation\/lifecycletracking\/applicationinstalled\/version","type":"topic","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled\/version","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"abstract":[{"text":"The version installed.","type":"text"}],"title":"version"},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation/finish()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"abstract":[{"text":"Ends the app’s lifecycle: stops observing it, then tracks ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"unless one was tracked already or ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/Kind\/terminated","isActive":true,"type":"reference"},{"text":" is off, and makes the tracker’s","type":"text"},{"text":" ","type":"text"},{"text":"records durable as on backgrounding. Returns once that is done, or at once if tracking","type":"text"},{"text":" ","type":"text"},{"text":"was cancelled.","type":"text"}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","role":"symbol","url":"\/documentation\/lifecycletracking\/lifecycleobservation\/finish()","type":"topic","title":"finish()","kind":"symbol"},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleBatchStrategy":{"title":"LifecycleBatchStrategy","url":"\/documentation\/lifecycletracking\/lifecyclebatchstrategy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LifecycleBatchStrategy"}],"kind":"symbol","abstract":[{"text":"A batch strategy that flushes as a delivery reads an ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true,"type":"reference"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true,"type":"reference"},{"text":" record, so what is pending goes out as the app leaves the foreground","type":"text"},{"text":" ","type":"text"},{"text":"rather than waiting for its count or time.","type":"text"}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","navigatorTitle":[{"kind":"identifier","text":"LifecycleBatchStrategy"}],"role":"symbol","type":"topic"},"doc://LifecycleTracking/documentation/LifecycleTracking/Trackers/Tracker/trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function: