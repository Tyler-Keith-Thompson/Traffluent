m one launch to the next, to tell an install","type":"text"},{"text":" ","type":"text"},{"text":"from an update.","type":"text"}],"title":"VersionStore","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"VersionStore"}],"kind":"symbol"},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation/cancel()":{"title":"cancel()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"()","kind":"text"}],"kind":"symbol","url":"\/documentation\/lifecycletracking\/lifecycleobservation\/cancel()","abstract":[{"type":"text","text":"Stops observing the app’s lifecycle, tracking nothing more; does nothing if it stopped"},{"type":"text","text":" "},{"type":"text","text":"already."}],"type":"topic","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/cancel()","role":"symbol"},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationTerminated":{"abstract":[{"type":"text","text":"The app is about to end: what "},{"type":"codeVoice","code":"trackLifecycle"},{"type":"text","text":" tracks where the platform reports it (on iOS,"},{"type":"text","text":" "},{"type":"text","text":"iPadOS, tvOS, visionOS and macOS, as the app terminates), and as its "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" is called."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ApplicationTerminated","kind":"identifier"}],"title":"ApplicationTerminated","kind":"symbol","url":"\/documentation\/lifecycletracking\/applicationterminated","role":"symbol","type":"topic","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","navigatorTitle":[{"text":"ApplicationTerminated","kind":"identifier"}]},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation":{"identifier":"doc:\/\/LifecycleTracking\/documentation