[{"type":"paragraph","inlineContent":[{"text":"The version the app runs at now; the bundle’s ","type":"text"},{"code":"CFBundleShortVersionString","type":"codeVoice"},{"text":" ","type":"text"},{"text":"by default. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" tracks neither installs nor updates, and saves nothing.","type":"text"}]}]},{"name":"versionStore","content":[{"inlineContent":[{"text":"Where the version is kept from one launch to the next; a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","isActive":true,"type":"reference"},{"text":" in ","type":"text"},{"code":"SegmentStore.defaultDirectory","type":"codeVoice"},{"text":" by default.","type":"text"}],"type":"paragraph"}]},{"name":"notificationCenter","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the platform posts its lifecycle notifications; the default"},{"type":"text","text":" "},{"type":"text","text":"center by default."}]}]},{"name":"file","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}]}]},{"name":"fileID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}]}]},{"name":"function","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}]}]},{"name":"line","content":[{"inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}],"type":"paragraph"}]},{"name":"column","content":[{"inlineContent":[{"text":"The caller’s column; leave it to its default.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The observation, which tracks until it is cancelled, finished or released.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Nothing is tracked until this is called. Call it as the app launches, such as in its"},{"type":"text","text":" "},{"type":"text","text":"application delegate’s "},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":", and keep what it"},{"type":"text","text":" "},{"type":"text","text":"returns:"}],"type":"paragraph"},{"code":["lifecycle = tracker.trackLifecycle()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"As it starts, it compares ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" with the one ","type":"text"},{"type":"codeVoice","code":"versionStore"},{"text":" saved: none tracks an","type":"text"},{"text":" ","type":"text"},{"text":"install, another an update, the same neither; it then saves ","type":"text"},{"type":"codeVoice","code":"version"},{"text":". Then it tracks an","type":"text"},{"text":" ","type":"text"},{"text":"open, not from the background. After that, each transition tracks once, however many times","type":"text"},{"text":" ","type":"text"},{"text":"it is reported:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":"’s notifications. Entering","type":"text"},{"text":" ","type":"text"},{"text":"the background tracks ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded"},{"text":", returning to the foreground","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened"},{"text":" from the background, and terminating ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A scene-based app gets them once for the whole app, not per scene.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"watchOS: ","type":"text"},{"code":"WKApplication","type":"codeVoice"},{"text":"‘s, without termination, which watchOS doesn’t report.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"macOS: ","type":"text"},{"code":"NSApplication","type":"codeVoice"},{"text":"’s. Another app becoming active counts as the background, this","type":"text"},{"text":" ","type":"text"},{"text":"one becoming active again as the foreground.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Linux: no notifications; "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true},{"type":"text","text":" tracks the termination."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":". A delivery batched with "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","isActive":true},{"type":"text","text":" sends what"},{"type":"text","text":" "},{"type":"text","text":"is pending as it reads the "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":" record. A notification’s handler only"},{"type":"text","text":" "},{"type":"text","text":"hands the transition on; the tracking, the version store and the store’s work run on a"},{"type":"text","text":" "},{"type":"text","text":"task of their own, never on the thread that posted it. Where the system suspends an app in the"},{"type":"text","text":" "},{"type":"text","text":"background (all but macOS and Mac Catalyst), the handler asks it for background time"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"},{"type":"text","text":"), held until the records are durable. A termination’s records are made durable the same way, without"},{"type":"text","text":" "},{"type":"text","text":"holding the main thread up: what the process doesn’t finish before it exits is what the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s documented loss window takes."}],"type":"paragraph"},{"inlineContent":[{"text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per","type":"text"},{"text":" ","type":"text"},{"text":"tracker.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"anchor":"Tracking-the-lifecycle","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"],"title":"Tracking the lifecycle"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker\/trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker"]]},"kind":"symbol","references":{"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationOpe