ht back to the foreground when ","type":"text"},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened\/fromBackground","isActive":true},{"text":". What","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"trackLifecycle"},{"text":" tracks as it starts, and each time the app returns from the background.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ApplicationOpened"}],"navigatorTitle":[{"kind":"identifier","text":"ApplicationOpened"}]},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation/Kind/terminated":{"abstract":[{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","type":"reference","isActive":true},{"type":"text","text":", as the app terminates where the platform reports it, and"},{"type":"text","text":" "},{"type":"text","text":"as "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","type":"reference","isActive":true},{"type":"text","text":" is called."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/Kind\/terminated","url":"\/documentation\/lifecycletracking\/lifecycleobservation\/kind\/terminated","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"terminated","kind":"identifier"}],"title":"LifecycleObservation.Kind.terminated","type":"topic"},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation/finish()":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","url":"\/documentation\/lifecycletracking\/lifecycleobservation\/finish()","abstract":[{"text":"Ends the app’s lifecycle: stops observing it, then tracks ","type":"text"},{"identifier":"doc:\/\/LifecycleTra