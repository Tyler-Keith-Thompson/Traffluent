ervation\/Kind\/terminated"},{"text":" is off, and makes the tracker’s","type":"text"},{"text":" ","type":"text"},{"text":"records durable as on backgrounding. Returns once that is done, or at once if tracking","type":"text"},{"text":" ","type":"text"},{"text":"was cancelled.","type":"text"}],"role":"symbol","url":"\/documentation\/lifecycletracking\/lifecycleobservation\/finish()","title":"finish()","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}]},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationTerminated":{"kind":"symbol","abstract":[{"type":"text","text":"The app is about to end: what "},{"code":"trackLifecycle","type":"codeVoice"},{"type":"text","text":" tracks where the platform reports it (on iOS,"},{"type":"text","text":" "},{"type":"text","text":"iPadOS, tvOS, visionOS and macOS, as the app terminates), and as its "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" is called."}],"title":"ApplicationTerminated","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ApplicationTerminated"}],"url":"\/documentation\/lifecycletracking\/applicationterminated","role":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","navigatorTitle":[{"kind":"identifier","text":"ApplicationTerminated"}]},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationInstalled":{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","abstract":[{"text":"The app ran for the first time on this device, at ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled\/version",