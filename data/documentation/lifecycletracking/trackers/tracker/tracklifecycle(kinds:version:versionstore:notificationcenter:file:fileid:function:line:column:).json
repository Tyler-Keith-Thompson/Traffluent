xt","text":"? = Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String, "},{"kind":"externalParam","text":"versionStore"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:17LifecycleTracking12VersionStoreP","kind":"typeIdentifier","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","text":"VersionStore"},{"kind":"text","text":" = FileVersionStore(), "},{"kind":"externalParam","text":"notificationCenter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:20FoundationEssentials18NotificationCenterC","kind":"typeIdentifier","text":"NotificationCenter"},{"kind":"text","text":" = .default, "},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#file"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#fileID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"function"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#function"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#line"},{"kind":"text","text":", "},{"kind":"externalParam","text":"column"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#column"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","kind":"typeIdentifier","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","text":"LifecycleObservation"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"kinds","content":[{"type":"paragraph","inlineContent":[{"text":"The kinds of event to track; every kind by default. Leaving one out doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"stop the rest of the work: the version is still saved, and the records still made","type":"text"},{"text":" ","type":"text"},{"text":"durable on backgrounding.","type":"text"}]}]},{"name":"version","content":[{"inlineContent":[{"type":"text","text":"The version the app runs at now; the bundle’s "},{"type":"codeVoice","code":"CFBundleShortVersionString"},{"type":"text","text":" "},{"type":"text","text":"by default. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" tracks neither installs nor updates, and saves nothing."}],"type":"paragraph"}]},{"name":"versionStore","content":[{"type":"paragraph","inlineContent":[{"text":"Where the version is kept from one launch to the next; a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","isActive":true,"type":"reference"},{"text":" in ","type":"text"},{"code":"SegmentStore.defaultDirectory","type":"codeVoice"},{"text":" by default.","type":"text"}]}]},{"name":"notificationCenter","content":[{"inlineContent":[{"type":"text","text":"Where the platform posts its lifecycle notifications; the default"},{"type":"text","text":" "},{"type":"text","text":"center by default."}],"type":"paragraph"}]},{"name":"file","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}]}]},{"name":"fileID","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s module and file name; leave it to its default.","type":"text"}]}]},{"name":"function","content":[{"inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}],"type":"paragraph"}]},{"name":"line","content":[{"inlineContent":[{"text":"The caller’s line; leave it to its default.","type":"text"}],"type":"paragraph"}]},{"name":"column","content":[{"inlineContent":[{"text":"The caller’s column; leave it to its default.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"The observation, which tracks until it is cancelled, finished or released.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing is tracked until this is called. Call it as the app launches, such as in its"},{"type":"text","text":" "},{"type":"text","text":"application delegate’s "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":", and keep what it"},{"type":"text","text":" "},{"type":"text","text":"returns:"}]},{"type":"codeListing","code":["lifecycle = tracker.trackLifecycle()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As it starts, it compares "},{"code":"version","type":"codeVoice"},{"type":"text","text":" with the one "},{"code":"versionStore","type":"codeVoice"},{"type":"text","text":" saved: none tracks an"},{"type":"text","text":" "},{"type":"text","text":"install, another an update, the same neither; it then saves "},{"code":"version","type":"codeVoice"},{"type":"text","text":". Then it tracks an"},{"type":"text","text":" "},{"type":"text","text":"open, not from the background. After that, each transition tracks once, however many times"},{"type":"text","text":" "},{"type":"text","text":"it is reported:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s notifications. Entering"},{"type":"text","text":" "},{"type":"text","text":"the background tracks "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":", returning to the foreground"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":" from the background, and terminating "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A scene-based app gets them once for the whole app, not per scene."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"watchOS: "},{"type":"codeVoice","code":"WKApplication"},{"type":"text","text":"‘s, without termination, which watchOS doesn’t report."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"macOS: "},{"type":"codeVoice","code":"NSApplication"},{"type":"text","text":"’s. Another app becoming active counts as the background, this"},{"type":"text","text":" "},{"type":"text","text":"one becoming active again as the foreground."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Linux: no notifications; ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true,"type":"reference"},{"text":" tracks the termination.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":". A delivery batched with "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","isActive":true},{"type":"text","text":" sends what"},{"type":"text","text":" "},{"type":"text","text":"is pending as it reads the "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":" record. A notification’s handler only"},{"type":"text","text":" "},{"type":"text","text":"hands the transition on; the tracking, the version store and the store’s work run on a"},{"type":"text","text":" "},{"type":"text","text":"task of their own, never on the thread that posted it. Where the system suspends an app in the"},{"type":"text","text":" "},{"type":"text","text":"background (all but macOS and Mac Catalyst), the handler asks it for background time"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"},{"type":"text","text":"), held until the records are durable. A termination’s records are made durable the same way, without"},{"type":"text","text":" "},{"type":"text","text":"holding the main thread up: what the process doesn’t finish before it exits is what the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s documented loss window takes."}]},{"type":"paragraph","inlineContent":[{"text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per","type":"text"},{"text":" ","type":"text"},{"text":"tracker.","type":"text"}]}]}],"references":{"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationInstalled/version":{"title":"version","kind":"symbol","abstract":[{"text":"The version installed.","type":"text"}],"role":"symbol","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled\/version","url":"\/documentation\/lifecycletracking\/applicationinstalled\/version","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"version"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"type":"topic"},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationBackgrounded":{"navigatorTitle":[{"kind":"identifier","text":"ApplicationBackgrounded"}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ApplicationBackgrounded"}],"title":"ApplicationBackgrounded","abstract":[{"type":"text","text":"The app moved to the background: what "},{"type":"codeVoice","code":"trackLifecycle"},{"type":"text","text":" tracks each time the app leaves the"},{"type":"text","text":" "},{"type":"text","text":"foreground (on macOS, each time it stops being the active app)."}],"type":"topic","kind":"symbol","url":"\/documentation\/lifecycletracking\/applicationbackgrounded","role":"symbol"},"doc://LifecycleTracking/documentation/LifecycleTracking/VersionStore":{"title":"VersionStore","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VersionStore","kind":"identifier"}],"role":"symbol","url":"\/documentation\/lifecycletracking\/versionstore","navigatorTitle":[{"text":"VersionStore","kind":"identifier"}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","abstract":[{"type":"text","text":"Where "},{"code":"trackLifecycle","type":"codeVoice"},{"type":"text","text":" keeps the app’s version from one launch to the next, to tell an install"},{"type":"text","text":" "},{"type":"text","text":"from an update."}],"kind":"symbol"},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationUpdated/previousVersion":{"title":"pr