ionString\"] as? String, ","kind":"text"},{"text":"versionStore","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:17LifecycleTracking12VersionStoreP","text":"VersionStore","kind":"typeIdentifier","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore"},{"text":" = FileVersionStore(), ","kind":"text"},{"text":"notificationCenter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials18NotificationCenterC","text":"NotificationCenter","kind":"typeIdentifier"},{"text":" = .default, ","kind":"text"},{"text":"file","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#file","kind":"keyword"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#fileID","kind":"keyword"},{"text":", ","kind":"text"},{"text":"function","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#function","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","text":"LifecycleObservation","kind":"typeIdentifier","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The kinds of event to track; every kind by default. Leaving one out doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"stop the rest of the work: the version is still saved, and the records still made","type":"text"},{"text":" ","type":"text"},{"text":"durable on backgrounding.","type":"text"}],"type":"paragraph"}],"name":"kinds"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The version the app runs at now; the bundle’s ","type":"text"},{"type":"codeVoice","code":"CFBundleShortVersionString"},{"text":" ","type":"text"},{"text":"by default. ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" tracks neither installs nor updates, and saves nothing.","type":"text"}]}],"name":"version"},{"content":[{"inlineContent":[{"text":"Where the version is kept from one launch to the next; a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","type":"reference","isActive":true},{"text":" in ","type":"text"},{"code":"SegmentStore.defaultDirectory","type":"codeVoice"},{"text":" by default.","type":"text"}],"type":"paragraph"}],"name":"versionStore"},{"content":[{"inlineContent":[{"type":"text","text":"Where the platform posts its lifecycle notifications; the default"},{"type":"text","text":" "},{"type":"text","text":"center by default."}],"type":"paragraph"}],"name":"notificationCenter"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s file; leave it to its default."}]}],"name":"file"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s module and file name; leave it to its default.","type":"text"}]}],"name":"fileID"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}]}],"name":"function"},{"content":[{"inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}],"type":"paragraph"}],"name":"line"},{"content":[{"inlineContent":[{"text":"The caller’s column; leave it to its default.","type":"text"}],"type":"paragraph"}],"name":"column"}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"The observation, which tracks until it is cancelled, finished or released.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Nothing is tracked until this is called. Call it as the app launches, such as in its","type":"text"},{"text":" ","type":"text"},{"text":"application delegate’s ","type":"text"},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"text":", and keep what it","type":"text"},{"text":" ","type":"text"},{"text":"returns:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["lifecycle = tracker.trackLifecycle()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"As it starts, it compares "},{"code":"version","type":"codeVoice"},{"type":"text","text":" with the one "},{"code":"versionStore","type":"codeVoice"},{"type":"text","text":" saved: none tracks an"},{"type":"text","text":" "},{"type":"text","text":"install, another an update, the same neither; it then saves "},{"code":"version","type":"codeVoice"},{"type":"text","text":". Then it tracks an"},{"type":"text","text":" "},{"type":"text","text":"open, not from the background. After that, each transition tracks once, however many times"},{"type":"text","text":" "},{"type":"text","text":"it is reported:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s notifications. Entering"},{"type":"text","text":" "},{"type":"text","text":"the background tracks "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded"},{"type":"text","text":", returning to the foreground"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened"},{"type":"text","text":" from the background, and terminating "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A scene-based app gets them once for the whole app, not per scene."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"watchOS: "},{"type":"codeVoice","code":"WKApplication"},{"type":"text","text":"‘s, without termination, which watchOS doesn’t report."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"macOS: "},{"type":"codeVoice","code":"NSApplication"},{"type":"text","text":"’s. Another app becoming active counts as the background, this"},{"type":"text","text":" "},{"type":"text","text":"one becoming active again as the foreground."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Linux: no notifications; ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true,"type":"reference"},{"text":" tracks the termination.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":". A delivery batched with "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","isActive":true},{"type":"text","text":" sends what"},{"type":"text","text":" "},{"type":"text","text":"is pending as it reads the "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":" record. A notification’s handler only"},{"type":"text","text":" "},{"type":"text","text":"hands the transition on; the tracking, the version store and the store’s work run on a"},{"type":"text","text":" "},{"type":"text","text":"task of their own, never on the thread that posted it. Where the system suspends an app in the"},{"type":"text","text":" "},{"type":"text","text":"background (all but macOS and Mac Catalyst), the handler asks it for background time"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"},{"type":"text","text":"), held until the records are durable. A termination’s records are made durable the same way, without"},{"type":"text","text":" "},{"type":"text","text":"holding the main thread up: what the process doesn’t finish before it exits is what the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s documented loss window takes."}],"type":"paragraph"},{"inlineContent":[{"text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per","type":"text"},{"text":" ","type":"text"},{"text":"tracker.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker"]]},"sections":[],"references":{"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationOpe