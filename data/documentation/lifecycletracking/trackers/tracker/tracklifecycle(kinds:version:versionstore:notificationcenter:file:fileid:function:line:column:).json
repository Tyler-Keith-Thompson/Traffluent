text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") -> ","kind":"text"},{"text":"LifecycleObservation","kind":"typeIdentifier","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"kinds","content":[{"type":"paragraph","inlineContent":[{"text":"The kinds of event to track; every kind by default. Leaving one out doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"stop the rest of the work: the version is still saved, and the records still made","type":"text"},{"text":" ","type":"text"},{"text":"durable on backgrounding.","type":"text"}]}]},{"name":"version","content":[{"inlineContent":[{"type":"text","text":"The version the app runs at now; the bundle’s "},{"code":"CFBundleShortVersionString","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"by default. "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" tracks neither installs nor updates, and saves nothing."}],"type":"paragraph"}]},{"name":"versionStore","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the version is kept from one launch to the next; a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","isActive":true},{"type":"text","text":" in "},{"type":"codeVoice","code":"SegmentStore.defaultDirectory"},{"type":"text","text":" by default."}]}]},{"name":"notificationCenter","content":[{"inlineContent":[{"type":"text","text":"Where the platform posts its lifecycle notifications; the default"},{"type":"text","text":" "},{"type":"text","text":"center by default."}],"type":"paragraph"}]},{"name":"file","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}]}]},{"name":"fileID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}]}]},{"name":"function","content":[{"inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}],"type":"paragraph"}]},{"name":"line","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}]}]},{"name":"column","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s column; leave it to its default.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The observation, which tracks until it is cancelled, finished or released."}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Nothing is tracked until this is called. Call it as the app launches, such as in its","type":"text"},{"text":" ","type":"text"},{"text":"application delegate’s ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":", and keep what it","type":"text"},{"text":" ","type":"text"},{"text":"returns:","type":"text"}]},{"code":["lifecycle = tracker.trackLifecycle()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"As it starts, it compares ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" with the one ","type":"text"},{"code":"versionStore","type":"codeVoice"},{"text":" saved: none tracks an","type":"text"},{"text":" ","type":"text"},{"text":"install, another an update, the same neither; it then saves ","type":"text"},{"code":"version","type":"codeVoice"},{"text":". Then it tracks an","type":"text"},{"text":" ","type":"text"},{"text":"open, not from the background. After that, each transition tracks once, however many times","type":"text"},{"text":" ","type":"text"},{"text":"it is reported:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":"’s notifications. Entering"},{"type":"text","text":" "},{"type":"text","text":"the background tracks "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true,"type":"reference"},{"type":"text","text":", returning to the foreground"},{"type":"text","text":" "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true,"type":"reference"},{"type":"text","text":" from the background, and terminating "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A scene-based app gets them once for the whole app, not per scene."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"watchOS: "},{"type":"codeVoice","code":"WKApplication"},{"type":"text","text":"‘s, without termination, which watchOS doesn’t report."}]}]},{"content":[{"inlineContent":[{"text":"macOS: ","type":"text"},{"code":"NSApplication","type":"codeVoice"},{"text":"’s. Another app becoming active counts as the background, this","type":"text"},{"text":" ","type":"text"},{"text":"one becoming active again as the foreground.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Linux: no notifications; ","type":"text"},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true},{"text":" tracks the termination.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":". A delivery batched with "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","isActive":true},{"type":"text","text":" sends what"},{"type":"text","text":" "},{"type":"text","text":"is pending as it reads the "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":" record. A notification’s handler only"},{"type":"text","text":" "},{"type":"text","text":"hands the transition on; the tracking, the version store and the store’s work run on a"},{"type":"text","text":" "},{"type":"text","text":"task of their own, never on the thread that posted it. Where the system suspends an app in the"},{"type":"text","text":" "},{"type":"text","text":"background (all but macOS and Mac Catalyst), the handler asks it for background time"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"},{"type":"text","text":"), held until the records are durable. A termination’s records are made durable the same way, without"},{"type":"text","text":" "},{"type":"text","text":"holding the main thread up: what the process doesn’t finish before it exits is what the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s documented loss window takes."}]},{"type":"paragraph","inlineContent":[{"text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per","type":"text"},{"text":" ","type":"text"},{"text":"tracker.","type":"text"}]}],"kind":"content"}],"metadata":{"modules":[{"relatedModules":["Trackers"],"name":"LifecycleTracking"}],"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trackLifecycle","kind":"identifier"},{"text":"(","kind":"text"},{"text":"kinds","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"LifecycleObservation","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Kind","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV4KindO","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"versionStore","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VersionStore","preciseIdentifier":"s:17LifecycleTracking12VersionStoreP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"notificationCenter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"NotificationCenter","preciseIdentifier":"s:20FoundationEssentials18NotificationCenterC","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"file","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":",