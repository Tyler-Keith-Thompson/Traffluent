{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"type":"text","text":"Tracks the app’s lifecycle through this tracker until the observation it returns is"},{"type":"text","text":" "},{"type":"text","text":"cancelled, finished or released: "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":" as it starts, then "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":" again and "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true},{"type":"text","text":" as the app moves."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker\/trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trackLifecycle","kind":"identifier"},{"text":"(","kind":"text"},{"text":"kinds","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","text":"LifecycleObservation","kind":"typeIdentifier","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"},{"text":".","kind":"text"},{"preciseIdentifier":"s:17LifecycleTracking0A11ObservationV4KindO","text":"Kind","kind":"typeIdentifier","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/Kind"},{"text":"> = Set(LifecycleObservation.Kind.allCases), ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String, ","kind":"text"},{"text":"versionStore","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:17LifecycleTracking12VersionStoreP","text":"VersionStore","kind":"typeIdentifier","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore"},{"text":" = FileVersionStore(), ","kind":"text"},{"text":"notificationCenter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials18NotificationCenterC","text":"NotificationCenter","kind":"typeIdentifier"},{"text":" = .default, ","kind":"text"},{"text":"file","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#file","kind":"keyword"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#fileID","kind":"keyword"},{"text":", ","kind":"text"},{"text":"function","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#function","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","text":"LifecycleObservation","kind":"typeIdentifier","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The kinds of event to track; every kind by default. Leaving one out doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"stop the rest of the work: the version is still saved, and the records still made","type":"text"},{"text":" ","type":"text"},{"text":"durable on backgrounding.","type":"text"}]}],"name":"kinds"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The version the app runs at now; the bundle’s "},{"type":"codeVoice","code":"CFBundleShortVersionString"},{"type":"text","text":" "},{"type":"text","text":"by default. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" tracks neither installs nor updates, and saves nothing."}]}],"name":"version"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the version is kept from one launch to the next; a"},{"type":"text","text":" "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","type":"reference","isActive":true},{"type":"text","text":" in "},{"type":"codeVoice","code":"SegmentStore.defaultDirectory"},{"type":"text","text":" by default."}]}],"name":"versionStore"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the platform posts its lifecycle notifications; the default"},{"type":"text","text":" "},{"type":"text","text":"center by default."}]}],"name":"notificationCenter"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s file; leave it to its default."}]}],"name":"file"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}]}],"name":"fileID"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s enclosing declaration; leave it to its default."}]}],"name":"function"},{"content":[{"inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}],"type":"paragraph"}],"name":"line"},{"content":[{"inlineContent":[{"type":"text","text":"The caller’s column; leave it to its default."}],"type":"paragraph"}],"name":"column"}]},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The observation, which tracks until it is cancelled, finished or released."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"Nothing is tracked until this is called. Call it as the app launches, such as in its","type":"text"},{"text":" ","type":"text"},{"text":"application delegate’s ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":", and keep what it","type":"text"},{"text":" ","type":"text"},{"text":"returns:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["lifecycle = tracker.trackLifecycle()"]},{"inlineContent":[{"type":"text","text":"As it starts, it compares "},{"type":"codeVoice","code":"version"},{"type":"text","text":" with the one "},{"type":"codeVoice","code":"versionStore"},{"type":"text","text":" saved: none tracks an"},{"type":"text","text":" "},{"type":"text","text":"install, another an update, the same neither; it then saves "},{"type":"codeVoice","code":"version"},{"type":"text","text":". Then it tracks an"},{"type":"text","text":" "},{"type":"text","text":"open, not from the background. After that, each transition tracks once, however many times"},{"type":"text","text":" "},{"type":"text","text":"it is reported:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":"’s notifications. Entering","type":"text"},{"text":" ","type":"text"},{"text":"the background tracks ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"text":", returning to the foreground","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference","isActive":true},{"text":" from the background, and terminating ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A scene-based app gets them once for the whole app, not per scene.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"watchOS: ","type":"text"},{"code":"WKApplication","type":"codeVoice"},{"text":"‘s, without termination, which watchOS doesn’t report.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"macOS: "},{"type":"codeVoice","code":"NSApplication"},{"type":"text","text":"’s. Another app becoming active counts as the background, this"},{"type":"text","text":" "},{"type":"text","text":"one becoming active again as the foreground."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Linux: no notifications; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()"},{"type":"text","text":" tracks the termination."}]}]}]},{"inlineContent":[{"type":"text","text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":". A delivery batched with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy"},{"type":"text","text":" sends what"},{"type":"text","text":" "},{"type":"text","text":"is pending as it reads the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded"},{"type":"text","text":" record. A notification’s handler only"},{"type":"text","text":" "},{"type":"text","text":"hands the transition on; the tracking, the version store and the store’s work run on a"},{"type":"text","text":" "},{"type":"text","text":"task of their own, never on the thread that posted it. Where the system suspends an app in the"},{"type":"text","text":" "},{"type":"text","text":"background (all but macOS and Mac Catalyst), the handler asks it for background time"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"},{"type":"text","text":"), held until the records are durable. A termination’s records are made durable the same way, without"},{"type":"text","text":" "},{"type":"text","text":"holding the main thread up: what the process doesn’t finish before it exits is what the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s documented loss window takes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per"},{"type":"text","text":" "},{"type":"text","text":"tracker."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/lifecycletracking\/trackers\/tracker\/tracklifecycle(kinds:version:versionstore:notificationcenter:file:fileid:function:line:column:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Method","role":"symbol","modules":[{"name":"LifecycleTracking","relatedModules":["Trackers"]}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trackLifecycle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kinds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","text":"LifecycleObservation"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV4KindO","text":"Kind"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"versionStore"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:17LifecycleTracking12VersionStoreP","text":"VersionStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"notificationCenter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials18NotificationCenterC","text":"NotificationCenter"},{"kind":"text","text":", "},{"kind":"externalParam","text":"file"},{"kind":"text","text