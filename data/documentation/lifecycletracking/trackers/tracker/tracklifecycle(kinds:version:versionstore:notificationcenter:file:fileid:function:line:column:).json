d":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#fileID","kind":"keyword"},{"text":", ","kind":"text"},{"text":"function","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#function","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") -> ","kind":"text"},{"text":"LifecycleObservation","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","kind":"typeIdentifier","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"kinds","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The kinds of event to track; every kind by default. Leaving one out doesn’t"},{"type":"text","text":" "},{"type":"text","text":"stop the rest of the work: the version is still saved, and the records still made"},{"type":"text","text":" "},{"type":"text","text":"durable on backgrounding."}]}]},{"name":"version","content":[{"type":"paragraph","inlineContent":[{"text":"The version the app runs at now; the bundle’s ","type":"text"},{"code":"CFBundleShortVersionString","type":"codeVoice"},{"text":" ","type":"text"},{"text":"by default. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" tracks neither installs nor updates, and saves nothing.","type":"text"}]}]},{"name":"versionStore","content":[{"inlineContent":[{"type":"text","text":"Where the version is kept from one launch to the next; a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore"},{"type":"text","text":" in "},{"code":"SegmentStore.defaultDirectory","type":"codeVoice"},{"type":"text","text":" by default."}],"type":"paragraph"}]},{"name":"notificationCenter","content":[{"type":"paragraph","inlineContent":[{"text":"Where the platform posts its lifecycle notifications; the default","type":"text"},{"text":" ","type":"text"},{"text":"center by default.","type":"text"}]}]},{"name":"file","content":[{"inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}],"type":"paragraph"}]},{"name":"fileID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}]}]},{"name":"function","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}]}]},{"name":"line","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}]}]},{"name":"column","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s column; leave it to its default.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The observation, which tracks until it is cancelled, finished or released.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Nothing is tracked until this is called. Call it as the app launches, such as in its","type":"text"},{"text":" ","type":"text"},{"text":"application delegate’s ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":", and keep what it","type":"text"},{"text":" ","type":"text"},{"text":"returns:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["lifecycle = tracker.trackLifecycle()"]},{"inlineContent":[{"text":"As it starts, it compares ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" with the one ","type":"text"},{"code":"versionStore","type":"codeVoice"},{"text":" saved: none tracks an","type":"text"},{"text":" ","type":"text"},{"text":"install, another an update, the same neither; it then saves ","type":"text"},{"code":"version","type":"codeVoice"},{"text":". Then it tracks an","type":"text"},{"text":" ","type":"text"},{"text":"open, not from the background. After that, each transition tracks once, however many times","type":"text"},{"text":" ","type":"text"},{"text":"it is reported:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s notifications. Entering"},{"type":"text","text":" "},{"type":"text","text":"the background tracks "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded"},{"type":"text","text":", returning to the foreground"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened"},{"type":"text","text":" from the background, and terminating "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A scene-based app gets them once for the whole app, not per scene."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"watchOS: ","type":"text"},{"code":"WKApplication","type":"codeVoice"},{"text":"‘s, without termination, which watchOS doesn’t report.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"macOS: ","type":"text"},{"code":"NSApplication","type":"codeVoice"},{"text":"’s. Another app becoming active counts as the background, this","type":"text"},{"text":" ","type":"text"},{"text":"one becoming active again as the foreground.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Linux: no notifications; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()"},{"type":"text","text":" tracks the termination."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls","type":"text"},{"text":" ","type":"text"},{"text":"the store’s ","type":"text"},{"type":"codeVoice","code":"synchronize()"},{"text":". A delivery batched with ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","type":"reference","isActive":true},{"text":" sends what","type":"text"},{"text":" ","type":"text"},{"text":"is pending as it reads the ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"text":" record. A notification’s handler only","type":"text"},{"text":" ","type":"text"},{"text":"hands the transition on; the tracking, the version store and the store’s work run on a","type":"text"},{"text":" ","type":"text"},{"text":"task of their own, never on the thread that posted it. Where the system suspends an app in the","type":"text"},{"text":" ","type":"text"},{"text":"background (all but macOS and Mac Catalyst), the handler asks it for background time","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"},{"text":"), held until the records are durable. A termination’s records are made durable the same way, without","type":"text"},{"text":" ","type":"text"},{"text":"holding the main thread up: what the process doesn’t finish before it exits is what the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s documented loss window takes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per","type":"text"},{"text":" ","type":"text"},{"text":"tracker.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/lifecycletracking\/trackers\/tracker\/tracklifecycle(kinds:version:versionstore:notificationcenter:file:fileid:function:line:column:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker"]]},"abstract":[{"text":"Tracks the app’s lifecycle through this tracker until the observation it returns is","type":"text"},{"text":" ","type":"text"},{"text":"cancelled, finished or released: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference"},{"text":" as it starts, then ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference"},{"text":" again and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","type":"reference"},{"text":" as the app moves.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker\/trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)"},"metadata":{"remoteSource":{"fileName":"Tracker+TrackLifecycle.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/LifecycleTracking\/Tracker+TrackLifecycle.swift#L63"},"roleHeading":"Instance Method","title":"trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)","modules":[{"relatedModules":["Trackers"],"name":"LifecycleTracking"}],"role":"symbol","externalID":"s:8Trackers7TrackerV17LifecycleTrackingE05trackC05kinds7version0G5Store18notificationCenter4file0K2ID8function4line6columnAD0C11ObservationVShyAP4KindOG_SSSgx20FoundationEssentials012NotificationJ0CS3SS2itAD07VersionH0RzlF","symbolKind":"method","extendedModule":"Trackers","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trackLifecycle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kinds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","text":"LifecycleObservation"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdent