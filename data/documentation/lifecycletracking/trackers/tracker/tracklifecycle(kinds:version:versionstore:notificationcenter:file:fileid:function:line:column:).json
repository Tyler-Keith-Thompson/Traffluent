g","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#function","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","text":"LifecycleObservation","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","kind":"typeIdentifier"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The kinds of event to track; every kind by default. Leaving one out doesn’t"},{"type":"text","text":" "},{"type":"text","text":"stop the rest of the work: the version is still saved, and the records still made"},{"type":"text","text":" "},{"type":"text","text":"durable on backgrounding."}]}],"name":"kinds"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The version the app runs at now; the bundle’s "},{"type":"codeVoice","code":"CFBundleShortVersionString"},{"type":"text","text":" "},{"type":"text","text":"by default. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" tracks neither installs nor updates, and saves nothing."}]}],"name":"version"},{"content":[{"inlineContent":[{"type":"text","text":"Where the version is kept from one launch to the next; a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","isActive":true},{"type":"text","text":" in "},{"type":"codeVoice","code":"SegmentStore.defaultDirectory"},{"type":"text","text":" by default."}],"type":"paragraph"}],"name":"versionStore"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Where the platform posts its lifecycle notifications; the default","type":"text"},{"text":" ","type":"text"},{"text":"center by default.","type":"text"}]}],"name":"notificationCenter"},{"content":[{"inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}],"type":"paragraph"}],"name":"file"},{"content":[{"inlineContent":[{"text":"The caller’s module and file name; leave it to its default.","type":"text"}],"type":"paragraph"}],"name":"fileID"},{"content":[{"inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}],"type":"paragraph"}],"name":"function"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}]}],"name":"line"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s column; leave it to its default.","type":"text"}]}],"name":"column"}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The observation, which tracks until it is cancelled, finished or released."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Nothing is tracked until this is called. Call it as the app launches, such as in its","type":"text"},{"text":" ","type":"text"},{"text":"application delegate’s ","type":"text"},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"text":", and keep what it","type":"text"},{"text":" ","type":"text"},{"text":"returns:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["lifecycle = tracker.trackLifecycle()"]},{"inlineContent":[{"type":"text","text":"As it starts, it compares "},{"code":"version","type":"codeVoice"},{"type":"text","text":" with the one "},{"code":"versionStore","type":"codeVoice"},{"type":"text","text":" saved: none tracks an"},{"type":"text","text":" "},{"type":"text","text":"install, another an update, the same neither; it then saves "},{"code":"version","type":"codeVoice"},{"type":"text","text":". Then it tracks an"},{"type":"text","text":" "},{"type":"text","text":"open, not from the background. After that, each transition tracks once, however many times"},{"type":"text","text":" "},{"type":"text","text":"it is reported:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":"’s notifications. Entering"},{"type":"text","text":" "},{"type":"text","text":"the background tracks "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"type":"text","text":", returning to the foreground"},{"type":"text","text":" "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference","isActive":true},{"type":"text","text":" from the background, and terminating "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A scene-based app gets them once for the whole app, not per scene."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"watchOS: "},{"code":"WKApplication","type":"codeVoice"},{"type":"text","text":"‘s, without termination, which watchOS doesn’t report."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"macOS: ","type":"text"},{"code":"NSApplication","type":"codeVoice"},{"text":"’s. Another app becoming active counts as the background, this","type":"text"},{"text":" ","type":"text"},{"text":"one becoming active again as the foreground.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Linux: no notifications; "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true},{"type":"text","text":" tracks the termination."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls","type":"text"},{"text":" ","type":"text"},{"text":"the store’s ","type":"text"},{"type":"codeVoice","code":"synchronize()"},{"text":". A delivery batched with ","type":"text"},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","isActive":true},{"text":" sends what","type":"text"},{"text":" ","type":"text"},{"text":"is pending as it reads the ","type":"text"},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"text":" record. A notification’s handler only","type":"text"},{"text":" ","type":"text"},{"text":"hands the transition on; the tracking, the version store and the store’s work run on a","type":"text"},{"text":" ","type":"text"},{"text":"task of their own, never on the thread that posted it. Where the system suspends an app in the","type":"text"},{"text":" ","type":"text"},{"text":"background (all but macOS and Mac Catalyst), the handler asks it for background time","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"},{"text":"), held until the records are durable. A termination’s records are made durable the same way, without","type":"text"},{"text":" ","type":"text"},{"text":"holding the main thread up: what the process doesn’t finish before it exits is what the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s documented loss window takes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per"},{"type":"text","text":" "},{"type":"text","text":"tracker."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/lifecycletracking\/trackers\/tracker\/tracklifecycle(kinds:version:versionstore:notificationcenter:file:fileid:function:line:column:)"]}],"kind":"symbol","abstract":[{"text":"Tracks the app’s lifecycle through this tracker until the observation it returns is","type":"text"},{"text":" ","type":"text"},{"text":"cancelled, finished or released: ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference","isActive":true},{"text":" as it starts, then ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference","isActive":true},{"text":" again and ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","type":"reference","isActive":true},{"text":" as the app moves.","type":"text"}],"references":{"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationUpd