yword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") -> ","kind":"text"},{"text":"LifecycleObservation","kind":"typeIdentifier","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"kinds","content":[{"inlineContent":[{"text":"The kinds of event to track; every kind by default. Leaving one out doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"stop the rest of the work: the version is still saved, and the records still made","type":"text"},{"text":" ","type":"text"},{"text":"durable on backgrounding.","type":"text"}],"type":"paragraph"}]},{"name":"version","content":[{"inlineContent":[{"text":"The version the app runs at now; the bundle’s ","type":"text"},{"code":"CFBundleShortVersionString","type":"codeVoice"},{"text":" ","type":"text"},{"text":"by default. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" tracks neither installs nor updates, and saves nothing.","type":"text"}],"type":"paragraph"}]},{"name":"versionStore","content":[{"type":"paragraph","inlineContent":[{"text":"Where the version is kept from one launch to the next; a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","type":"reference"},{"text":" in ","type":"text"},{"code":"SegmentStore.defaultDirectory","type":"codeVoice"},{"text":" by default.","type":"text"}]}]},{"name":"notificationCenter","content":[{"inlineContent":[{"type":"text","text":"Where the platform posts its lifecycle notifications; the default"},{"type":"text","text":" "},{"type":"text","text":"center by default."}],"type":"paragraph"}]},{"name":"file","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}]}]},{"name":"fileID","content":[{"inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}],"type":"paragraph"}]},{"name":"function","content":[{"inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}],"type":"paragraph"}]},{"name":"line","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}]}]},{"name":"column","content":[{"inlineContent":[{"text":"The caller’s column; leave it to its default.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The observation, which tracks until it is cancelled, finished or released."}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Nothing is tracked until this is called. Call it as the app launches, such as in its","type":"text"},{"text":" ","type":"text"},{"text":"application delegate’s ","type":"text"},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"text":", and keep what it","type":"text"},{"text":" ","type":"text"},{"text":"returns:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["lifecycle = tracker.trackLifecycle()"],"type":"codeListing"},{"inlineContent":[{"text":"As it starts, it compares ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" with the one ","type":"text"},{"code":"versionStore","type":"codeVoice"},{"text":" saved: none tracks an","type":"text"},{"text":" ","type":"text"},{"text":"install, another an update, the same neither; it then saves ","type":"text"},{"code":"version","type":"codeVoice"},{"text":". Then it tracks an","type":"text"},{"text":" ","type":"text"},{"text":"open, not from the background. After that, each transition tracks once, however many times","type":"text"},{"text":" ","type":"text"},{"text":"it is reported:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s notifications. Entering"},{"type":"text","text":" "},{"type":"text","text":"the background tracks "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":", returning to the foreground"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":" from the background, and terminating "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A scene-based app gets them once for the whole app, not per scene."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"watchOS: "},{"type":"codeVoice","code":"WKApplication"},{"type":"text","text":"‘s, without termination, which watchOS doesn’t report."}]}]},{"content":[{"inlineContent":[{"text":"macOS: ","type":"text"},{"code":"NSApplication","type":"codeVoice"},{"text":"’s. Another app becoming active counts as the background, this","type":"text"},{"text":" ","type":"text"},{"text":"one becoming active again as the foreground.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Linux: no notifications; ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()"},{"text":" tracks the termination.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":". A delivery batched with "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","isActive":true},{"type":"text","text":" sends what"},{"type":"text","text":" "},{"type":"text","text":"is pending as it reads the "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":" record. A notification’s handler only"},{"type":"text","text":" "},{"type":"text","text":"hands the transition on; the tracking, the version store and the store’s work run on a"},{"type":"text","text":" "},{"type":"text","text":"task of their own, never on the thread that posted it. Where the system suspends an app in the"},{"type":"text","text":" "},{"type":"text","text":"background (all but macOS and Mac Catalyst), the handler asks it for background time"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"},{"type":"text","text":"), held until the records are durable. A termination’s records are made durable the same way, without"},{"type":"text","text":" "},{"type":"text","text":"holding the main thread up: what the process doesn’t finish before it exits is what the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s documented loss window takes."}],"type":"paragraph"},{"inlineContent":[{"text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per","type":"text"},{"text":" ","type":"text"},{"text":"tracker.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker"]]},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker\/trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Tracks the app’s lifecycle through this tracker until the observation it returns is"},{"type":"text","text":" "},{"type":"text","text":"cancelled, finished or released: "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":" as it starts, then "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true},{"type":"text","text":" again and "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true},{"type":"text","text":" as the app moves."}],"references":{"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationUpd