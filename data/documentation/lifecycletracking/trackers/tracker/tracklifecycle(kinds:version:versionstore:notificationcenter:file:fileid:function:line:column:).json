{"abstract":[{"type":"text","text":"Tracks the app’s lifecycle through this tracker until the observation it returns is"},{"type":"text","text":" "},{"type":"text","text":"cancelled, finished or released: "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference","isActive":true},{"type":"text","text":" as it starts, then "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference","isActive":true},{"type":"text","text":" again and "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","type":"reference","isActive":true},{"type":"text","text":" as the app moves."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trackLifecycle","kind":"identifier"},{"text":"(","kind":"text"},{"text":"kinds","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","text":"LifecycleObservation","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/Kind","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV4KindO","text":"Kind","kind":"typeIdentifier"},{"text":"> = Set(LifecycleObservation.Kind.allCases), ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String, ","kind":"text"},{"text":"versionStore","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","preciseIdentifier":"s:17LifecycleTracking12VersionStoreP","text":"VersionStore","kind":"typeIdentifier"},{"text":" = FileVersionStore(), ","kind":"text"},{"text":"notificationCenter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials18NotificationCenterC","text":"NotificationCenter","kind":"typeIdentifier"},{"text":" = .default, ","kind":"text"},{"text":"file","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#file","kind":"keyword"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#fileID","kind":"keyword"},{"text":", ","kind":"text"},{"text":"function","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#function","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","text":"LifecycleObservation","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"kinds","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The kinds of event to track; every kind by default. Leaving one out doesn’t"},{"type":"text","text":" "},{"type":"text","text":"stop the rest of the work: the version is still saved, and the records still made"},{"type":"text","text":" "},{"type":"text","text":"durable on backgrounding."}]}]},{"name":"version","content":[{"inlineContent":[{"type":"text","text":"The version the app runs at now; the bundle’s "},{"code":"CFBundleShortVersionString","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"by default. "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" tracks neither installs nor updates, and saves nothing."}],"type":"paragraph"}]},{"name":"versionStore","content":[{"inlineContent":[{"type":"text","text":"Where the version is kept from one launch to the next; a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore"},{"type":"text","text":" in "},{"type":"codeVoice","code":"SegmentStore.defaultDirectory"},{"type":"text","text":" by default."}],"type":"paragraph"}]},{"name":"notificationCenter","content":[{"inlineContent":[{"type":"text","text":"Where the platform posts its lifecycle notifications; the default"},{"type":"text","text":" "},{"type":"text","text":"center by default."}],"type":"paragraph"}]},{"name":"file","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}]}]},{"name":"fileID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}]}]},{"name":"function","content":[{"inlineContent":[{"type":"text","text":"The caller’s enclosing declaration; leave it to its default."}],"type":"paragraph"}]},{"name":"line","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}]}]},{"name":"column","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s column; leave it to its default."}]}]}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The observation, which tracks until it is cancelled, finished or released."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"Nothing is tracked until this is called. Call it as the app launches, such as in its","type":"text"},{"text":" ","type":"text"},{"text":"application delegate’s ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":", and keep what it","type":"text"},{"text":" ","type":"text"},{"text":"returns:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["lifecycle = tracker.trackLifecycle()"]},{"inlineContent":[{"text":"As it starts, it compares ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" with the one ","type":"text"},{"code":"versionStore","type":"codeVoice"},{"text":" saved: none tracks an","type":"text"},{"text":" ","type":"text"},{"text":"install, another an update, the same neither; it then saves ","type":"text"},{"code":"version","type":"codeVoice"},{"text":". Then it tracks an","type":"text"},{"text":" ","type":"text"},{"text":"open, not from the background. After that, each transition tracks once, however many times","type":"text"},{"text":" ","type":"text"},{"text":"it is reported:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":"’s notifications. Entering","type":"text"},{"text":" ","type":"text"},{"text":"the background tracks ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true,"type":"reference"},{"text":", returning to the foreground","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true,"type":"reference"},{"text":" from the background, and terminating ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A scene-based app gets them once for the whole app, not per scene.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"watchOS: ","type":"text"},{"code":"WKApplication","type":"codeVoice"},{"text":"‘s, without termination, which watchOS doesn’t report.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"macOS: "},{"type":"codeVoice","code":"NSApplication"},{"type":"text","text":"’s. Another app becoming active counts as the background, this"},{"type":"text","text":" "},{"type":"text","text":"one becoming active again as the foreground."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Linux: no notifications; ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","type":"reference","isActive":true},{"text":" tracks the termination.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls","type":"text"},{"text":" ","type":"text"},{"text":"the store’s ","type":"text"},{"code":"synchronize()","type":"codeVoice"},{"text":". A delivery batched with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","type":"reference"},{"text":" sends what","type":"text"},{"text":" ","type":"text"},{"text":"is pending as it reads the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference"},{"text":" record. A notification’s handler only","type":"text"},{"text":" ","type":"text"},{"text":"hands the transition on; the tracking, the version store and the store’s work run on a","type":"text"},{"text":" ","type":"text"},{"text":"task of their own, never on the thread that posted it. Where the system suspends an app in the","type":"text"},{"text":" ","type":"text"},{"text":"background (all but macOS and Mac Catalyst), the handler asks it for background time","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"ProcessInfo.performExpiringActivity","type":"codeVoice"},{"text":"), held until the records are durable. A termination’s records are made durable the same way, without","type":"text"},{"text":" ","type":"text"},{"text":"holding the main thread up: what the process doesn’t finish before it exits is what the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s documented loss window takes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per"},{"type":"text","text":" "},{"type":"text","text":"tracker."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Instance Method","extendedModule":"Trackers","title":"trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)","role":"symbol","modules":[{"relatedModules":["Trackers"],"name":"LifecycleTracking"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trackLifecycle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kinds"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","kind":"typeIdentifier","text":"LifecycleObservation"},{"kind":"text","text":"."},{"preciseIdentifier":"s:17LifecycleTracking0A11ObservationV4KindO","kind":"typeIdentifier","text":"Kind"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"versionStore"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:17LifecycleTracking12VersionStoreP","kind":"typeIdentifier","text":"VersionStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"notificationCenter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:20FoundationEssentials18NotificationCenterC","kind":"typeIdentifier","text":"NotificationCenter"},{"kind":"text","text":", "},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"function"},{"kind":"tex