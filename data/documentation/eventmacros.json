{"metadata":{"role":"collection","roleHeading":"Framework","externalID":"EventMacros","title":"EventMacros","modules":[{"name":"EventMacros"}],"symbolKind":"module"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Event"},{"type":"text","text":" makes a struct an event. It adds the "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" conformance, the event’s name, consent"},{"type":"text","text":" "},{"type":"text","text":"category and schema version when you give them, a "},{"type":"codeVoice","code":"schema"},{"type":"text","text":" describing each stored property in"},{"type":"text","text":" "},{"type":"text","text":"declaration order, and "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Decodable"},{"type":"text","text":" conformances that write each stored property"},{"type":"text","text":" "},{"type":"text","text":"under its name. "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":" declares rules a plain "},{"type":"codeVoice","code":"String"},{"type":"text","text":", number or array can’t carry, such"},{"type":"text","text":" "},{"type":"text","text":"as a minimum length or a pattern; the macro checks each keyword as it expands, and a tracker rejects an"},{"type":"text","text":" "},{"type":"text","text":"event whose property breaks one."}]},{"type":"paragraph","inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" includes this module. It re-exports "},{"code":"Events","type":"codeVoice"},{"type":"text","text":", so a file that imports"},{"type":"text","text":" "},{"code":"EventMacros","type":"codeVoice"},{"type":"text","text":" alone can expand the macro too. The "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" protocol’s documentation, in that module,"},{"type":"text","text":" "},{"type":"text","text":"shows the conformance written by hand; any "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance, Swift’s synthesized one included,"},{"type":"text","text":" "},{"type":"text","text":"is one a store can write. To export the schemas as"},{"type":"text","text":" "},{"type":"text","text":"a JSON Schema tracking plan, pass them to "},{"code":"TrackingPlans","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["import EventMacros","","@Event(name: \"search_performed\", consent: .functional, version: 2)","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    var resultCount: Int","    var filter: String?","}","","let names = SearchPerformed.schema.properties.map(\\.name)  \/\/ [\"query\", \"resultCount\", \"filter\"]"]},{"type":"paragraph","inlineContent":[{"text":"Raise ","type":"text"},{"code":"version:","type":"codeVoice"},{"text":" only for a change that records stored at the earlier version can’t be read","type":"text"},{"text":" ","type":"text"},{"text":"through; a store drops those records rather than reading them as the new shape.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/definingevents"},{"type":"text","text":" "},{"type":"text","text":"covers both macros, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents"},{"type":"text","text":" "},{"type":"text","text":"shows which changes need a new version."}]}]}],"sections":[],"topicSections":[{"title":"Defining an event","anchor":"Defining-an-event","identifiers":["doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)"]},{"title":"Constraining properties","anchor":"Const