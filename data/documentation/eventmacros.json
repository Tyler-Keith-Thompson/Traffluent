{"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"@Event","type":"codeVoice"},{"type":"text","text":" makes a struct an event. It adds the "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" conformance, the event’s name, consent"},{"type":"text","text":" "},{"type":"text","text":"category and schema version when you give them, a "},{"code":"schema","type":"codeVoice"},{"type":"text","text":" describing each stored property in"},{"type":"text","text":" "},{"type":"text","text":"declaration order, and "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Decodable","type":"codeVoice"},{"type":"text","text":" conformances that write each stored property"},{"type":"text","text":" "},{"type":"text","text":"under its name. "},{"code":"@Constrained","type":"codeVoice"},{"type":"text","text":" declares rules a plain "},{"code":"String","type":"codeVoice"},{"type":"text","text":", number or array can’t carry, such"},{"type":"text","text":" "},{"type":"text","text":"as a minimum length or a pattern; the macro checks each keyword as it expands, and a tracker rejects an"},{"type":"text","text":" "},{"type":"text","text":"event whose property breaks one."}]},{"type":"paragraph","inlineContent":[{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" includes this module. It re-exports "},{"code":"Events","type":"codeVoice"},{"type":"text","text":", so a file that imports"},{"type":"text","text":" "},{"code":"EventMacros","type":"codeVoice"},{"type":"text","text":" alone can expand the macro too. The "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" protocol’s documentation, in that module,"},{"type":"text","text":" "},{"type":"text","text":"shows the conformance written by hand; any "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance, Swift’s synthesized one included,"},{"type":"text","text":" "},{"type":"text","text":"is one a store can write. To export the schemas as"},{"type":"text","text":" "},{"type":"text","text":"a JSON Schema tracking plan, pass them to "},{"code":"TrackingPlans","type":"codeVoice"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["import EventMacros","","@Event(name: \"search_performed\", consent: .functional, version: 2)","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    var resultCount: Int","    var filter: String?","}","","let names = SearchPerformed.schema.properties.map(\\.name)  \/\/ [\"query\", \"resultCount\", \"filter\"]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Raise "},{"type":"codeVoice","code":"version:"},{"type":"text","text":" only for a change that records stored at the earlier version can’t be read"},{"type":"text","text":" "},{"type":"text","text":"through; a store drops those records rather than reading them as the new shape."}]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/definingevents","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers both macros, and","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/changingevents","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"shows which changes need a new version.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros"]}],"metadata":{"symbolKind":"module","title":"EventMacros","roleHeading":"Framework","externalID":"EventMacros","modules":[{"name":"EventMacros"}],"role":"collection"},"kind":"symbol","identifier":{"url":"doc:\/\/EventMacros\/docume