{"topicSections":[{"title":"Sending batches","anchor":"Sending-batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"]},{"title":"Encoding a batch","anchor":"Encoding-a-batch","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"]},{"title":"Splitting a batch into requests","anchor":"Splitting-a-batch-into-requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchRequests","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/SkippedRecord"]},{"title":"Waiting between attempts","anchor":"Waiting-between-attempts","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"]},{"title":"Sending requests","anchor":"Sending-requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"collection","symbolKind":"module","modules":[{"name":"HTTPDestinations"}],"title":"HTTPDestinations","roleHeading":"Framework","externalID":"HTTPDestinations"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"type":"text","text":" is a destination that posts each batch it receives as the requests its"},{"type":"text","text":" "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"type":"text","text":" splits it into: one request for an endpoint without limits. Each body is whatever"},{"type":"text","text":" "},{"type":"text","text":"the encoder writes for its records, so events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance and the wire format is"},{"type":"text","text":" "},{"type":"text","text":"yours. It sends with "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" through"},{"type":"text","text":" "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","type":"reference","isActive":true},{"type":"text","text":" by default, or through any "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","type":"reference","isActive":true},{"type":"text","text":" you pass."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","isActive":true},{"type":"text","text":": 1 second, doubling up to 60 seconds, unless you pass another. The"},{"type":"text","text":" "},{"type":"text","text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store"},{"type":"text","text":" "},{"type":"text","text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose"},{"type":"text","text":" "},{"type":"text","text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true},{"type":"text","text":" as an "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","isActive":true},{"type":"text","text":", as is each record the encoder leaves out"},{"type":"text","text":" "},{"type":"text","text":"of its requests."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracing instrument injects the trace context of each request’s first record into its header"},{"type":"text","text":" "},{"type":"text","text":"fields, and "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" is always the encoder’s."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s"},{"type":"text","text":" "},{"type":"text","text":"format, give the destination a "},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"CollectorEncoding"},{"type":"text","text":"); for PostHog,"},{"type":"text","text":" "},{"type":"text","text":"make it with "},{"type":"codeVoice","code":"HTTPDestination.postHog(projectToken:host:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Amplitude, with "},{"type":"codeVoice","code":"HTTPDestination.amplitude(apiKey:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Mixpanel, with "},{"type":"codeVoice","code":"HTTPDestination.mixpanel(projectToken:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"MixpanelEncoding"},{"type":"text","text":");"},{"type":"text","text":" "},{"type":"text","text":"for Segment, RudderStack or Customer.io Data Pipelines, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.segment(writeKey:region:plan:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"rudderStack(writeKey:dataPlane:plan:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"customerIO(apiKey:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"SegmentSpecEncoding"},{"type":"text","text":"); for Google Analytics 4, from a"},{"type":"text","text":" "},{"type":"text","text":"server, with "},{"type":"codeVoice","code":"HTTPDestination.googleAnalytics(measurementID:apiSecret:region:plan:)"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"codeVoice","code":"GoogleAnalyticsEncoding"},{"type":"text","text":"); for Snowplow, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.snowplow(collector:vendor:appID:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"SnowplowEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck, with "},{"type":"codeVoice","code":"HTTPDestination.telemetryDeck(appID:namespace:testMode:plan:)"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"codeVoice","code":"TelemetryDeckEncoding"},{"type":"text","text":"). To read events inside the app or in a test, use"},{"type":"text","text":" "},{"type":"codeVoice","code":"InMemoryDestination"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"Destinations"},{"type":"text","text":") instead."}]},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    func requests(for batch: [EventRecord]) -> BatchRequests<Never> {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        let body = EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","        return BatchRequests(requests: [EncodedRequest(body: body, recordIDs: bat