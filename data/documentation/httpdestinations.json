{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":" is a destination that posts each batch it receives as one request. The body is","type":"text"},{"text":" ","type":"text"},{"text":"whatever its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" writes for the batch’s records, so events need no ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" ","type":"text"},{"text":"conformance and the wire format is yours. It sends with ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" through","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport"},{"text":" by default, or through any ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport"},{"text":" you pass.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","isActive":true},{"type":"text","text":": 1 second, doubling up to 60 seconds, unless you pass another. The"},{"type":"text","text":" "},{"type":"text","text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store"},{"type":"text","text":" "},{"type":"text","text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose"},{"type":"text","text":" "},{"type":"text","text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true},{"type":"text","text":" as an "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The tracing instrument injects the trace context of the batch’s first record into the request’s","type":"text"},{"text":" ","type":"text"},{"text":"header fields, and ","type":"text"},{"type":"codeVoice","code":"Content-Type"},{"text":" is always the encoder’s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"text":"format, give the destination a ","type":"text"},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"CollectorEncoding"},{"text":"); for PostHog, a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PostHogBatchEncoder"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"PostHogEncoding"},{"text":"). To read events inside the app or in a test, use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InMemoryDestination"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"Destinations"},{"text":") instead.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    func encode(_ batch: [EventRecord]) -> EncodedBatch {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        return EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: try ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"]},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference"},{"text":" ","type":"text"},{"text":"covers this destination beside the others, and what a delivery does while a batch is retried.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/httpdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"metadata":{"roleHeading":"Framework","externalID":"HTTPDestinations","symbolKind":"module","role":"collection","modules":[{"name":"HTTPDestinations"}],"title":"HTTPDestinations"},"topicSections":[{"title":"Sending batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"anchor":"Sending-batches"},{"title":"Encoding a batch","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"],"anchor":"Encoding-a-batch"},{"title":"Waiting between attempts","identifiers":["doc:\/\/HTTPD