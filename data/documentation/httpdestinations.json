{"metadata":{"role":"collection","externalID":"HTTPDestinations","title":"HTTPDestinations","symbolKind":"module","modules":[{"name":"HTTPDestinations"}],"roleHeading":"Framework"},"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/httpdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Sending batches","anchor":"Sending-batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"]},{"title":"Encoding a batch","anchor":"Encoding-a-batch","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"]},{"title":"Waiting between attempts","anchor":"Waiting-between-attempts","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"]},{"title":"Sending requests","anchor":"Sending-requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError"]}],"sections":[],"abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" is a destination that posts each batch it receives as one request. The body is"},{"type":"text","text":" "},{"type":"text","text":"whatever its "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" writes for the batch’s records, so events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" "},{"type":"text","text":"conformance and the wire format is yours. It sends with "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" through"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","isActive":true},{"type":"text","text":" by default, or through any "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","isActive":true},{"type":"text","text":" you pass."}]},{"type":"paragraph","inlineContent":[{"text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff"},{"text":": 1 second, doubling up to 60 seconds, unless you pass another. The","type":"text"},{"text":" ","type":"text"},{"text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store","type":"text"},{"text":" ","type":"text"},{"text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose","type":"text"},{"text":" ","type":"text"},{"text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"},{"text":" as an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracing instrument injects the trace context of the batch’s first record into the request’s"},{"type":"text","text":" "},{"type":"text","text":"header fields, and "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" is always the encoder’s."}]},{"type":"paragraph","inlineContent":[{"text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"text":"format, give the destination a ","type":"text"},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"CollectorEncoding","type":"codeVoice"},{"text":"); for PostHog, a","type":"text"},{"text":" ","type":"text"},{"code":"PostHogBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":"). To read events inside the app or in a test, use","type":"text"},{"text":" ","type":"text"},{"code":"InMemoryDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"Destinations","type":"codeVoice"},{"text":") instead.","type":"text"}]},{"code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    func encode(_ batch: [EventRecord]) -> EncodedBatch {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        return EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: try ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"covers this destination beside the others, and what a delivery does while a batch is retried."}]}]}],"kind":"symbol","references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransport":{"abstract":[{"text":"What sends an HTTP request and returns the server’s response: the seam between","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"text":" and the network.","type":"text"}],"url":"\/documentation\/httpdestinations\/httptransport","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPTransport"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HTTPTransport"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","title":"HTTPTransport"},"doc://HTTPDestinations/documentation/HTTPDestinations/InvalidBackoff":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InvalidBackoff","kind":"identifier"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"InvalidBackoff","kind":"identifier"}],"title":"InvalidBackoff","url":"\/documentation\/httpdestinations\/invalidbackoff","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","abstract":[{"text":"The error ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/init(ini