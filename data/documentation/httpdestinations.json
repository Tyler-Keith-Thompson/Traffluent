pe":"text","text":" drops the"},{"type":"text","text":" "},{"type":"text","text":"request and reports it as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/httpdestinations\/responseoutcome\/rejected(reason:)","title":"ResponseOutcome.rejected(reason:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport":{"url":"\/documentation\/httpdestinations\/httpdropreport","title":"HTTPDropReport","abstract":[{"type":"text","text":"A batch "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" dropped without delivering it, and why."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDropReport"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"HTTPDropReport"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"type":"topic","url":"\/documentation\/httpdestinations\/batchencoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"title":"BatchEncoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}],"kind":"symbol","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/TransientStatus":{"navigatorTitle":[{"kind":"identifier","text":"TransientStatus"}],"abstract":[{"text":"A failure status that ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":" retries, beside 408 Request Timeout, 429 Too Many","type":"text"},{"text":" ","type":"text"},{"text":"Requests and every 5xx, for an encoder that lists it in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses"},{"text":".","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/TransientStatus","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TransientStatus"}],"kind":"symbol","type":"topic","title":"TransientStatus","url":"\/documentation\/httpdestinations\/transientstatus","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff/delay(beforeRetry:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"delay","kind":"identifier"},{"text":"(","kind":"text"},{"text":"beforeRetry","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NonPositiveRetry","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations16NonPositiveRetryV"},{"text":") -> ","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/delay(beforeRetry:)","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The nominal wait before retry number "},{"type":"codeVoice","code":"retry"},{"type":"text","text":": "},{"type":"codeVoice","code":"initialDelay"},{"type":"text","text":" doubled "},{"type":"codeVoice","code":"retry - 1"},{"