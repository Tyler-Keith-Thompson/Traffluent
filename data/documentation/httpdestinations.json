{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"HTTPDestinations","modules":[{"name":"HTTPDestinations"}],"symbolKind":"module","roleHeading":"Framework","role":"collection","title":"HTTPDestinations"},"topicSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"anchor":"Sending-batches","title":"Sending batches"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"],"anchor":"Encoding-a-batch","title":"Encoding a batch"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"],"anchor":"Waiting-between-attempts","title":"Waiting between attempts"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError"],"anchor":"Sending-requests","title":"Sending requests"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"text":" is a destination that posts each batch it receives as one request. The body is","type":"text"},{"text":" ","type":"text"},{"text":"whatever its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" writes for the batch’s records, so events need no ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" ","type":"text"},{"text":"conformance and the wire format is yours. It sends with ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" through","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","type":"reference"},{"text":" by default, or through any ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","type":"reference"},{"text":" you pass.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","isActive":true,"type":"reference"},{"text":": 1 second, doubling up to 60 seconds, unless you pass another. The","type":"text"},{"text":" ","type":"text"},{"text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store","type":"text"},{"text":" ","type":"text"},{"text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose","type":"text"},{"text":" ","type":"text"},{"text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true,"type":"reference"},{"text":" as an ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tracing instrument injects the trace context of the batch’s first record into the request’s"},{"type":"text","text":" "},{"type":"text","text":"header fields, and "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" is always the encoder’s."}],"type":"paragraph"},{"inlineContent":[{"text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"text":"format, give the destination a ","type":"text"},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"CollectorEncoding","type":"codeVoice"},{"text":"); for PostHog, a","type":"text"},{"text":" ","type":"text"},{"code":"PostHogBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":"). To read events inside the app or in a test, use","type":"text"},{"text":" ","type":"text"},{"code":"InMemoryDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"Destinations","type":"codeVoice"},{"text":") instead.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    func encode(_ batch: [EventRecord]) -> EncodedBatch {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        return EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: try ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers this destination beside the others, and what a delivery does while a batch is retried."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations"]}],"sections":[],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/InvalidBackoff":{"type":"topic","kind":"symbol","navigatorTitle":[{"text":"InvalidBackoff","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InvalidBackoff","kind":"identifier"}],"url":"\/documentation\/httpdestinations\/invalidbackoff","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","title":"InvalidBackoff","abstract":[{"type":"text","text":"The error "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/init(initialDelay:maximumDelay:)","type":"reference","isActive":true},{"type":"text","text":" throws for an"},{"type":"text","text":" "},{"type":"text","text":"initial delay that isn’t positive, or a maximum delay less than it."}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"type":"link","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"title":"Choosing Destinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"type":"topic","kind":"symbol","role":"collection","url":"\/docume