{"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"title":"Sending batches","anchor":"Sending-batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"]},{"title":"Encoding a batch","anchor":"Encoding-a-batch","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"]},{"title":"Splitting a batch into requests","anchor":"Splitting-a-batch-into-requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchRequests","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/SkippedRecord"]},{"title":"Waiting between attempts","anchor":"Waiting-between-attempts","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"]},{"title":"Sending requests","anchor":"Sending-requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError"]}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" is a destination that posts each batch it receives as the requests its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" splits it into: one request for an endpoint without limits. Each body is whatever"},{"type":"text","text":" "},{"type":"text","text":"the encoder writes for its records, so events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance and the wire format is"},{"type":"text","text":" "},{"type":"text","text":"yours. It sends with "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" through"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport"},{"type":"text","text":" by default, or through any "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport"},{"type":"text","text":" you pass."}]},{"type":"paragraph","inlineContent":[{"text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","isActive":true},{"text":": 1 second, doubling up to 60 seconds, unless you pass another. The","type":"text"},{"text":" ","type":"text"},{"text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store","type":"text"},{"text":" ","type":"text"},{"text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose","type":"text"},{"text":" ","type":"text"},{"text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true},{"text":" as an ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","isActive":true},{"text":", as is each record the encoder leaves out","type":"text"},{"text":" ","type":"text"},{"text":"of its requests.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The tracing instrument injects the trace context of each request’s first record into its header","type":"text"},{"text":" ","type":"text"},{"text":"fields, and ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":" is always the encoder’s.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s"},{"type":"text","text":" "},{"type":"text","text":"format, give the destination a "},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"type":"text","text":" (module "},{"code":"CollectorEncoding","type":"codeVoice"},{"type":"text","text":"); for PostHog,"},{"type":"text","text":" "},{"type":"text","text":"make it with "},{"code":"HTTPDestination.postHog(projectToken:host:plan:)","type":"codeVoice"},{"type":"text","text":" (module "},{"code":"PostHogEncoding","type":"codeVoice"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Amplitude, with "},{"code":"HTTPDestination.amplitude(apiKey:region:plan:)","type":"codeVoice"},{"type":"text","text":" (module "},{"code":"AmplitudeEncoding","type":"codeVoice"},{"type":"text","text":"). To"},{"type":"text","text":" "},{"type":"text","text":"read events inside the app or in a test, use "},{"code":"InMemoryDestination","type":"codeVoice"},{"type":"text","text":" (module "},{"code":"Destinations","type":"codeVoice"},{"type":"text","text":") instead."}]},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    func requests(for batch: [EventRecord]) -> BatchRequests<Never> {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        let body = EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","        return BatchRequests(requests: [EncodedRequest(body: body, recordIDs: batch.map(\\.id))], skippedRecords: [])","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: try ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers this destination beside the others, and what a delivery does while a batch is retried."}]}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"variants":[{"paths":["\/documentation\/httpdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"HTTPDestinations"}],"roleHeading":"Framework","externalID":"HTTPDestinations","title":"HTTPDestinations","role":"collection","symbolKind":"module"},"abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"sections":[],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/NonPositiveRetry":{"title":"NonPositiveRetry","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NonPositiveRetry"}],"url":"\/documentation\/httpdestinations\/nonpositiveretry","navigatorTitle":[{"kind":"identifier","text":"NonPositiveRetry"}],"abstract":[