{"hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"roleHeading":"Framework","symbolKind":"module","role":"collection","title":"HTTPDestinations","externalID":"HTTPDestinations","modules":[{"name":"HTTPDestinations"}]},"abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" is a destination that posts each batch it receives as one request. The body is"},{"type":"text","text":" "},{"type":"text","text":"whatever its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" writes for the batch’s records, so events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" "},{"type":"text","text":"conformance and the wire format is yours. It sends with "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" through"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport"},{"type":"text","text":" by default, or through any "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport"},{"type":"text","text":" you pass."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff"},{"type":"text","text":": 1 second, doubling up to 60 seconds, unless you pass another. The"},{"type":"text","text":" "},{"type":"text","text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store"},{"type":"text","text":" "},{"type":"text","text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose"},{"type":"text","text":" "},{"type":"text","text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"},{"type":"text","text":" as an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The tracing instrument injects the trace context of the batch’s first record into the request’s","type":"text"},{"text":" ","type":"text"},{"text":"header fields, and ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":" is always the encoder’s.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"text":"format, give the destination a ","type":"text"},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"CollectorEncoding"},{"text":"); for PostHog, a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PostHogBatchEncoder"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"PostHogEncoding"},{"text":"). To read events inside the app or in a test, use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InMemoryDestination"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"Destinations"},{"text":") instead.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    func encode(_ batch: [EventRecord]) -> EncodedBatch {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        return EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers this destination beside the others, and what a delivery does while a batch is retried."}]}]}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations"]}],"topicSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"anchor":"Sending-batches","title":"Sending batches"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"],"anchor":"Encoding-a-batch","title":"Encoding a batch"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestina