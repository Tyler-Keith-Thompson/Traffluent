ch that wasn’t delivered:","type":"text"},{"text":" ","type":"text"},{"text":"binary exponential backoff, each wait twice the one before, up to a maximum.","type":"text"}],"url":"\/documentation\/httpdestinations\/exponentialbackoff","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/InvalidBackoff":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InvalidBackoff","kind":"identifier"}],"navigatorTitle":[{"text":"InvalidBackoff","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/httpdestinations\/invalidbackoff","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","title":"InvalidBackoff","abstract":[{"type":"text","text":"The error "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/init(checkedInitialDelay:maximumDelay:)"},{"type":"text","text":" throws for an"},{"type":"text","text":" "},{"type":"text","text":"initial delay that isn’t positive, or a maximum delay less than it."}],"role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedBatch":{"title":"EncodedBatch","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch","kind":"symbol","navigatorTitle":[{"text":"EncodedBatch","kind":"identifier"}],"role":"symbol","url":"\/documentation\/httpdestinations\/encodedbatch","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EncodedBatch","kind":"identifier"}],"abstract":[{"type":"text","text":"A batch encoded as a request body: its bytes, and the media type that says how to read them."}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransport":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPTransport"}],"type