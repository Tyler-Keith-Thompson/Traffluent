{"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"HTTPDestinations"}],"title":"HTTPDestinations","roleHeading":"Framework","role":"collection","externalID":"HTTPDestinations","symbolKind":"module"},"topicSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"anchor":"Sending-batches","title":"Sending batches"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"],"anchor":"Encoding-a-batch","title":"Encoding a batch"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchRequests","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/SkippedRecord"],"anchor":"Splitting-a-batch-into-requests","title":"Splitting a batch into requests"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"],"anchor":"Waiting-between-attempts","title":"Waiting between attempts"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError"],"anchor":"Sending-requests","title":"Sending requests"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations"]}],"hierarchy":{"paths":[[]]},"kind":"symbol","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" is a destination that posts each batch it receives as the requests its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" splits it into: one request for an endpoint without limits. Each body is whatever"},{"type":"text","text":" "},{"type":"text","text":"the encoder writes for its records, so events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance and the wire format is"},{"type":"text","text":" "},{"type":"text","text":"yours. It sends with "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" through"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","isActive":true},{"type":"text","text":" by default, or through any "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","isActive":true},{"type":"text","text":" you pass."}],"type":"paragraph"},{"inlineContent":[{"text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","isActive":true,"type":"reference"},{"text":": 1 second, doubling up to 60 seconds, unless you pass another. The","type":"text"},{"text":" ","type":"text"},{"text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store","type":"text"},{"text":" ","type":"text"},{"text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose","type":"text"},{"text":" ","type":"text"},{"text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true,"type":"reference"},{"text":" as an ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","isActive":true,"type":"reference"},{"text":", as is each record the encoder leaves out","type":"text"},{"text":" ","type":"text"},{"text":"of its requests.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tracing instrument injects the trace context of each request’s first record into its header"},{"type":"text","text":" "},{"type":"text","text":"fields, and "},{"code":"Content-Type","type":"codeVoice"},{"type":"text","text":" is always the encoder’s."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s"},{"type":"text","text":" "},{"type":"text","text":"format, give the destination a "},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"CollectorEncoding"},{"type":"text","text":"); for PostHog,"},{"type":"text","text":" "},{"type":"text","text":"make it with "},{"type":"codeVoice","code":"HTTPDestination.postHog(projectToken:host:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Amplitude, with "},{"type":"codeVoice","code":"HTTPDestination.amplitude(apiKey:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Mixpanel, with "},{"type":"codeVoice","code":"HTTPDestination.mixpanel(projectToken:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"MixpanelEncoding"},{"type":"text","text":"). To"},{"type":"text","text":" "},{"type":"text","text":"read events inside the app or in a test, use "},{"type":"codeVoice","code":"InMemoryDestination"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"Destinations"},{"type":"text","text":") instead."}],"type":"paragraph"},{"code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    func requests(for batch: [EventRecord]) -> BatchRequests<Never> {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        let body = EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","        return BatchRequests(requests: [EncodedRequest(body: body, recordIDs: batch.map(\\.id))], skippedRecords: [])","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: try ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers this destination beside the others, and what a delivery does while a batch is retried."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff":{"navigatorTitle":[{"kind":"identifier","text":"ExponentialBackoff"}],"title":"ExponentialBackoff","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","role":"symbol","url":"\/documentation\/httpdestinations\/exponentialbackoff","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExponentialBackoff"}],"kind":"symbol","abstract":[{"type":"text","text":"How long "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" waits before each new attempt at a batch that wasn’t delivered:"},{"type":"text","text":" "},{"type":"text","text":"binary exponential backoff, each wait twice the one before, up to a maximum."}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedRequest":{"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","kind":"symbol","title":"EncodedRequest","url":"\/documentation\/httpdestinations\/encodedrequest","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EncodedRequest"}],"abstract":[{"type":"text","text":"One request of a batch as a "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"type":"text","text":" splits it: its body, and the records it carries."}],"navigatorTitle":[{"kind":"identifier","text":"EncodedRequest"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDropReport"}],"abstract":[{"text":"A batch ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" dropped without delivering it, and why.","type":"text"}],"title":"HTTPDropReport","url":"\/documentation\/httpdestinations\/httpdropreport","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"HTTPDropReport"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"},"doc://HTTPDestinations/documentation/HTTPDestinations/URLSessionTransport":{"abstract":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport"},{"type":"text","text":" that sends each request with a "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":"."}],"url":"\/documentation\/httpdestinations\/urlsessiontransport","type":"topic","title":"URLSessionTransport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"URLSessionTransport","kind":"identifier"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"URLSessionTransport","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/SkippedRecord":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/SkippedRecord","url":"\/documentation\/httpdestinations\/skippedrecord","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkippedRecord"}],"abstract":[{"type":"text","text":"A record a "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" left out of a batch’s requests, and why."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"SkippedRecord"}],"kind":"symbol","title":"SkippedRecord","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/NonPositiveRetry":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry","url":"\/documentation\/httpdestinations\/nonpositiveretry","fragments":[{"t