{"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"externalID":"HTTPDestinations","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"HTTPDestinations"}],"role":"collection","title":"HTTPDestinations"},"sections":[],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"text":" is a destination that posts each batch it receives as the requests its","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"text":" splits it into: one request for an endpoint without limits. Each body is whatever","type":"text"},{"text":" ","type":"text"},{"text":"the encoder writes for its records, so events need no ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance and the wire format is","type":"text"},{"text":" ","type":"text"},{"text":"yours. It sends with ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" through","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","isActive":true},{"text":" by default, or through any ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","isActive":true},{"text":" you pass.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","type":"reference"},{"text":": 1 second, doubling up to 60 seconds, unless you pass another. The","type":"text"},{"text":" ","type":"text"},{"text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store","type":"text"},{"text":" ","type":"text"},{"text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose","type":"text"},{"text":" ","type":"text"},{"text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","type":"reference"},{"text":" as an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","type":"reference"},{"text":", as is each record the encoder leaves out","type":"text"},{"text":" ","type":"text"},{"text":"of its requests.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracing instrument injects the trace context of each request’s first record into its header"},{"type":"text","text":" "},{"type":"text","text":"fields, and "},{"code":"Content-Type","type":"codeVoice"},{"type":"text","text":" is always the encoder’s."}]},{"type":"paragraph","inlineContent":[{"text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"text":"format, give the destination a ","type":"text"},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"CollectorEncoding","type":"codeVoice"},{"text":"); for PostHog,","type":"text"},{"text":" ","type":"text"},{"text":"make it with ","type":"text"},{"code":"HTTPDestination.postHog(projectToken:host:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"Amplitude, with ","type":"text"},{"code":"HTTPDestination.amplitude(apiKey:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"AmplitudeEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"Mixpanel, with ","type":"text"},{"code":"HTTPDestination.mixpanel(projectToken:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"MixpanelEncoding","type":"codeVoice"},{"text":");","type":"text"},{"text":" ","type":"text"},{"text":"for Segment, RudderStack or Customer.io Data Pipelines, with","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination.segment(writeKey:region:plan:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"rudderStack(writeKey:dataPlane:plan:)","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"customerIO(apiKey:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"SegmentSpecEncoding","type":"codeVoice"},{"text":"); for Google Analytics 4, from a","type":"text"},{"text":" ","type":"text"},{"text":"server, with ","type":"text"},{"code":"HTTPDestination.googleAnalytics(measurementID:apiSecret:region:plan:)","type":"codeVoice"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"code":"GoogleAnalyticsEncoding","type":"codeVoice"},{"text":"); for Snowplow, with","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination.snowplow(collector:vendor:appID:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"SnowplowEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck, with ","type":"text"},{"code":"HTTPDestination.telemetryDeck(appID:namespace:testMode:plan:)","type":"codeVoice"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"code":"TelemetryDeckEncoding","type":"codeVoice"},{"text":"); for Matomo, with","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination.matomo(url:siteID:dimensions:category:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"MatomoEncoding","type":"codeVoice"},{"text":"). To read events inside the app or in a test, use","type":"text"},{"text":" ","type":"text"},{"code":"InMemoryDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"Destinations","type":"codeVoice"},{"text":") instead.","type":"text"}]},{"type":"codeListing","code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    func requests(for batch: [EventRecord]) -> BatchRequests<Never> {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        let body = EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","        return BatchRequests(requests: [EncodedRequest(body: body, recordIDs: batch.map(\\.id))], skippedRecords: [])","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: try ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers this destination beside the others, and what a delivery does while a batch is retried."}]}]}],"var