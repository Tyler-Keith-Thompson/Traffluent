er"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Failure","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","kind":"symbol","type":"topic","role":"symbol","abstract":[{"text":"A report of each batch dropped without being delivered, in the order they are dropped.","type":"text"}],"url":"\/documentation\/httpdestinations\/httpdestination\/dropreports"},"doc://HTTPDestinations/documentation/HTTPDestinations/NonPositiveRetry":{"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry","kind":"symbol","navigatorTitle":[{"text":"NonPositiveRetry","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NonPositiveRetry","kind":"identifier"}],"title":"NonPositiveRetry","url":"\/documentation\/httpdestinations\/nonpositiveretry","role":"symbol","abstract":[{"type":"text","text":"The error "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/delay(beforeRetry:)"},{"type":"text","text":" throws for a retry numbered below 1."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport":{"abstract":[{"type":"text","text":"A batch "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" dropped without delivering it, and why."}],"title":"HTTPDropReport","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDropReport"}],"role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","url":"\/documentation\/httpdestinations\/httpdropreport","kind":"symbol","type":"topic","nav