{"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"HTTPDestinations","modules":[{"name":"HTTPDestinations"}],"symbolKind":"module","role":"collection","roleHeading":"Framework","title":"HTTPDestinations"},"abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" is a destination that posts each batch it receives as the requests its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" splits it into: one request for an endpoint without limits. Each body is whatever"},{"type":"text","text":" "},{"type":"text","text":"the encoder writes for its records, so events need no "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance and the wire format is"},{"type":"text","text":" "},{"type":"text","text":"yours. It sends with "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" through"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","isActive":true},{"type":"text","text":" by default, or through any "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","isActive":true},{"type":"text","text":" you pass."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","isActive":true},{"type":"text","text":": nominally 1 second, doubling up to 60 seconds, unless you pass another. So"},{"type":"text","text":" "},{"type":"text","text":"is one answered with a status the encoder lists in "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","isActive":true},{"type":"text","text":", which every"},{"type":"text","text":" "},{"type":"text","text":"encoder declares: empty for most servers, or each other failure its vendor answers to a request"},{"type":"text","text":" "},{"type":"text","text":"worth sending again, such as Aptabase’s 418 for a slow upload."}]},{"type":"paragraph","inlineContent":[{"text":"A 2xx counts as delivered unless the encoder’s ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","isActive":true,"type":"reference"},{"text":" reads its body and","type":"text"},{"text":" ","type":"text"},{"text":"says otherwise. Some vendors answer 200 to a request they didn’t store, and say so only in the","type":"text"},{"text":" ","type":"text"},{"text":"body: Mixpanel’s ","type":"text"},{"code":"{\"status\": 0}","type":"codeVoice"},{"text":", or Aptabase’s ","type":"text"},{"code":"{\"error\": ...}","type":"codeVoice"},{"text":" for an unknown key. A 2xx the","type":"text"},{"text":" ","type":"text"},{"text":"encoder reads as ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)","isActive":true,"type":"reference"},{"text":" is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)","isActive":true,"type":"reference"},{"text":". One it reads as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)","isActive":true,"type":"reference"},{"text":" is sent again under the same backoff and deadline as a 5xx.","type":"text"},{"text":" ","type":"text"},{"text":"An encoder should count an empty body, or one it can’t read, as delivered, so an answer it","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t recognize never sends a request again and again; the DestinationTesting conformance kit","type":"text"},{"text":" ","type":"text"},{"text":"checks that it does. A transient answer is retried until the request’s deadline, so an encoder","type":"text"},{"text":" ","type":"text"},{"text":"whose requests have none should return rejected instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each wait has full jitter by default: a random wait shorter than the nominal one, so apps refused"},{"type":"text","text":" "},{"type":"text","text":"at the same moment retry at different moments. Pass "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/none","isActive":true},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"nominal waits. In tests, pass a seeded generator as "},{"type":"codeVoice","code":"randomNumberGenerator:"},{"type":"text","text":" for jittered waits"},{"type":"text","text":" "},{"type":"text","text":"that repeat from one run to the next, as long as one request retries at a time: copies of a"},{"type":"text","text":" "},{"type":"text","text":"destination retrying at once share the generator’s draws in the order they ask for them. Never"},{"type":"text","text":" "},{"type":"text","text":"seed it in production, where every device would then wait the same, which defeats the jitter. The"},{"type":"text","text":" "},{"type":"text","text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store"},{"type":"text","text":" "},{"type":"text","text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose"},{"type":"text","text":" "},{"type":"text","text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true},{"type":"text","text":" as an "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","isActive":true},{"type":"text","text":", as is each record the encoder leaves out"},{"type":"text","text":" "},{"type":"text","text":"of its requests. So is a request still undelivered at its "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","isActive":true},{"type":"text","text":", which an"},{"type":"text","text":" "},{"type":"text","text":"encoder sets for a vendor that misdates or ignores old events: the destination checks it on its"},{"type":"text","text":" "},{"type":"codeVoice","code":"now:"},{"type":"text","text":" clock before every attempt and sends nothing more once it has passed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracing instrument injects the trace context of each request’s first record into its header"},{"type":"text","text":" "},{"type":"text","text":"fields, and "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" is always the encoder’s."}]},{"type":"paragraph","inlineContent":[{"text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"text":"format, give the destination a ","type":"text"},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"CollectorEncoding","type":"codeVoice"},{"text":"); for PostHog,","type":"text"},{"text":" ","type":"text"},{"text":"make it with ","type":"text"},{"code":"HTTPDestination.postHog(projectToken:host:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"Amplitude, with ","type":"text"},{"code":"HTTPDestination.amplitude(apiKey:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"AmplitudeEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"Mixpanel, with ","type":"text"},{"code":"HTTPDestination.mixpanel(projectToken:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"MixpanelEncoding","type":"codeVoice"},{"text":");","type":"text"},{"text":" ","type":"text"},{"text":"for Segment, RudderStack or Customer.io Data Pipelines, with","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination.segment(writeKey:region:plan:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"rudderStack(writeKey:dataPlane:plan:)","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"customerIO(apiKey:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"SegmentSpecEncoding","type":"codeVoice"},{"text":"); for Google Analytics 4, from a","type":"text"},{"text":" ","type":"text"},{"text":"server, with ","type":"text"},{"code":"HTTPDestination.googleAnalytics(measurementID:apiSecret:region:plan:)","type":"codeVoice"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"code":"GoogleAnalyticsEncoding","type":"codeVoice"},{"text":"); for Snowplow, with","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination.snowplow(collector:vendor:appID:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"SnowplowEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck, with ","type":"text"},{"code":"HTTPDestination.telemetryDeck(appID:namespace:testMode:plan:)","type":"codeVoice"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"code":"TelemetryDeckEncoding","type":"codeVoice"},{"text":"); for Matomo, with","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination.matomo(url:siteID:dimensions:category:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"MatomoEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"Heap, with ","type":"text"},{"code":"HTTPDestination.heap(appID:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"HeapEncoding","type":"codeVoice"},{"text":"); for Aptabase, with","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination.aptabase(appKey:host:isDebug:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"AptabaseEncoding","type":"codeVoice"},{"text":"). To read events","type":"text"},{"text":" ","type":"text"},{"text":"inside the app or in a test, use","type":"text"},{"text":" ","type":"text"},{"code":"InMemoryDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"Destinations","type":"codeVoice"},{"text":") instead.","type":"text"}]},{"code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    static let transientStatuses: Set<TransientStatus> = []","","    static func outcome(of response: HTTPTransportResponse, for request: EncodedRequest) -> ResponseOutcome {","        .delivered","    }","","    func requests(for batch: [EventRecord]) -> BatchRequests<Never> {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        let body = EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","        return BatchRequests(requests: [EncodedRequest(body: body, recordIDs: batch.map(\\.id))], skippedRecords: [])","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: try ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers this destination beside the others, and what a delivery does while a batch is retried."}]}]}],"sections":[],"topicSections":[{"anchor":"Sending-batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"title":"Sending batches"},{"anchor":"Encoding-a-batch","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"],"title":"Encoding a batch"},{"anchor":"Reading-a-2xx-answer","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse"],"title":"Reading a 2xx answer"},{"anchor":"Splitting-a-batch-into-requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchRequests","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/SkippedRecord"],"title":"Splitting a batch into requests"},{"anchor":"Retrying-a-vendors-own-statuses","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/TransientStatus","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidTransientStatus"],"title":"Retrying a vendor’s own statuses"},{"anchor":"Waiting-between-attempts","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"],"title":"Waiting between attempts"},{"anchor":"Sending-requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError"],"title":"Sending requests"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"title":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"type":"topic","role":"symbol","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"text":" sends.","type":"text"}],"kind":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/ResponseOutcome/transient(reason:)":{"url":"\/documentation\/httpdestinations\/responseoutcome\/transient(reason:)","abstract":[{"text":"The vendor stored none of the request’s records for now, for ","type":"text"},{"type":"codeVoice","code":"reason"},{"text":", and may store them","type":"text"},{"text":" ","type":"text"},{"text":"if it is sent again: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":" sends it again as it does after a 5xx, with the","type":"text"},{"text":" ","type":"text"},{"text":"same backoff and the same deadline.","type":"text"}],"title":"ResponseOutcome.transient(reason:)","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"transient"},{"kind":"text","text":"("},{"kind":"externalParam","text":"reason"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/transientStatuses":{"url":"\/documentation\/httpdestinations\/batchencoder\/transientstatuses","abstract":[{"type":"text","text":"The failure statuses, beyond 408 Request Timeout, 429 Too Many Requests and every 5xx, that"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends a request of this encoder again after: "},{"code":"[]","type":"codeVoice"},{"type":"text","text":" for none."}],"required":true,"title":"transientStatuses","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","role":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientStatuses","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"TransientStatus","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/SkippedRecord":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A record a "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"type":"text","text":" left out of a batch’s requests, and why."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkippedRecord","kind":"identifier"}],"navigatorTitle":[{"text":"SkippedRecord","kind":"identifier"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/SkippedRecord","url":"\/documentation\/httpdestinations\/skippedrecord","title":"SkippedRecord"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport/rejectedInBody(status:reason:recordIDs:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectedInBody","kind":"identifier"},{"text":"(","kind":"text"},{"text":"status","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9HTTPTypes12HTTPResponseV","text":"HTTPResponse","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:9HTTPTypes12HTTPResponseV6StatusV","text":"Status","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"reason","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"recordIDs","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4UUIDV","text":"UUID","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)","type":"topic","title":"HTTPDropReport.rejectedInBody(status:reason:recordIDs:)","role":"symbol","url":"\/documentation\/httpdestinations\/httpdropreport\/rejectedinbody(status:reason:recordids:)","kind":"symbol","abstract":[{"text":"The endpoint answered with ","type":"text"},{"code":"status","type":"codeVoice"},{"text":", a 2xx, but the answer’s body says the vendor stored","type":"text"},{"text":" ","type":"text"},{"text":"none of the records and won’t if they are sent again (","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"returned ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)","isActive":true,"type":"reference"},{"text":"), for ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":", so the batch of the records","type":"text"},{"text":" ","type":"text"},{"text":"identified by ","type":"text"},{"code":"recordIDs","type":"codeVoice"},{"text":", oldest first, was dropped. Mixpanel’s track API, answering 200","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"{\"status\": 0, \"error\": ...}","type":"codeVoice"},{"text":", is one such vendor.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic","title":"HTTPDestinations","role":"collection","kind":"symbol","url":"\/documentation\/httpdestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/TransientStatus":{"url":"\/documentation\/httpdestinations\/transientstatus","abstract":[{"type":"text","text":"A failure status that "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" retries, beside 408 Request Timeout, 429 Too Many"},{"type":"text","text":" "},{"type":"text","text":"Requests and every 5xx, for an encoder that lists it in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses"},{"type":"text","text":"."}],"title":"TransientStatus","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/TransientStatus","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TransientStatus","kind":"identifier"}],"navigatorTitle":[{"text":"TransientStatus","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/URLSessionTransport":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"URLSessionTransport"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","type":"topic","title":"URLSessionTransport","navigatorTitle":[{"kind":"identifier","text":"URLSessionTransport"}],"role":"symbol","url":"\/documentation\/httpdestinations\/urlsessiontransport","kind":"symbol","abstract":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","type":"reference","isActive":true},{"text":" that sends each request with a ","type":"text"},{"type":"codeVoice","code":"URLSession"},{"text":".","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransportResponse":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPTransportResponse","kind":"identifier"}],"type":"topic","title":"HTTPTransportResponse","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse","url":"\/documentation\/httpdestinations\/httptransportresponse","abstract":[{"type":"text","text":"What an "},{"type":"reference","identifier"