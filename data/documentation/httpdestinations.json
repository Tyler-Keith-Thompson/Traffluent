{"abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"hierarchy":{"paths":[[]]},"sections":[],"topicSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"anchor":"Sending-batches","title":"Sending batches"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"],"anchor":"Encoding-a-batch","title":"Encoding a batch"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff"],"anchor":"Waiting-between-attempts","title":"Waiting between attempts"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError"],"anchor":"Sending-requests","title":"Sending requests"}],"variants":[{"paths":["\/documentation\/httpdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" is a destination that posts each batch it receives as one request. The body is"},{"type":"text","text":" "},{"type":"text","text":"whatever its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" writes for the batch’s records, so events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" "},{"type":"text","text":"conformance and the wire format is yours. It sends with "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" through"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport"},{"type":"text","text":" by default, or through any "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport"},{"type":"text","text":" you pass."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its"},{"type":"text","text":" "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","type":"reference","isActive":true},{"type":"text","text":": 1 second, doubling up to 60 seconds, unless you pass another. The"},{"type":"text","text":" "},{"type":"text","text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store"},{"type":"text","text":" "},{"type":"text","text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose"},{"type":"text","text":" "},{"type":"text","text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on"},{"type":"text","text":" "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","type":"reference","isActive":true},{"type":"text","text":" as an "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tracing instrument injects the trace context of the batch’s first record into the request’s"},{"type":"text","text":" "},{"type":"text","text":"header fields, and "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" is always the encoder’s."}],"type":"paragraph"},{"inlineContent":[{"text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"text":"format, give the destination a ","type":"text"},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"CollectorEncoding","type":"codeVoice"},{"text":"); for PostHog, a","type":"text"},{"text":" ","type":"text"},{"code":"PostHogBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":"). To read events inside the app or in a test, use","type":"text"},{"text":" ","type":"text"},{"code":"InMemoryDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"Destinations","type":"codeVoice"},{"text":") instead.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    func encode(_ batch: [EventRecord]) -> EncodedBatch {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        return EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"]},{"inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"covers this destination beside the others, and what a delivery does while a batch is retried."}],"type":"paragraph"}]}],"metadata":{"externalID":"HTTPDestinations","roleHeading":"Framework","modules":[{"name":"HTTPDestinations"}],"title":"HTTPDestinations","role":"collection","symbolKind":"module"},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransportError":{"title":"HTTPTransportError","type":"topic","url":"\/documentation\/httpdestinations\/httptransporterror","navigatorTitle":[{"kind":"identifier","text":"HTTPTransportError"}],"abstract":[{"text":"Why an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","type":"reference"},{"text":" returned no response.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPTransportError"}],"kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/httpdestinations\/batchencoder","title":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","fragme