{"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" is a destination that posts each batch it receives as the requests its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" splits it into: one request for an endpoint without limits. Each body is whatever","type":"text"},{"text":" ","type":"text"},{"text":"the encoder writes for its records, so events need no ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance and the wire format is","type":"text"},{"text":" ","type":"text"},{"text":"yours. It sends with ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" through","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","isActive":true,"type":"reference"},{"text":" by default, or through any ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","isActive":true,"type":"reference"},{"text":" you pass.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","type":"reference"},{"text":": 1 second, doubling up to 60 seconds, unless you pass another. The","type":"text"},{"text":" ","type":"text"},{"text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store","type":"text"},{"text":" ","type":"text"},{"text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose","type":"text"},{"text":" ","type":"text"},{"text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","type":"reference"},{"text":" as an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","type":"reference"},{"text":", as is each record the encoder leaves out","type":"text"},{"text":" ","type":"text"},{"text":"of its requests. So is a request still undelivered at its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","type":"reference"},{"text":", which an","type":"text"},{"text":" ","type":"text"},{"text":"encoder sets for a vendor that misdates or ignores old events: the destination checks it on its","type":"text"},{"text":" ","type":"text"},{"code":"now:","type":"codeVoice"},{"text":" clock before every attempt and sends nothing more once it has passed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tracing instrument injects the trace context of each request’s first record into its header"},{"type":"text","text":" "},{"type":"text","text":"fields, and "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" is always the encoder’s."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s"},{"type":"text","text":" "},{"type":"text","text":"format, give the destination a "},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"CollectorEncoding"},{"type":"text","text":"); for PostHog,"},{"type":"text","text":" "},{"type":"text","text":"make it with "},{"type":"codeVoice","code":"HTTPDestination.postHog(projectToken:host:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Amplitude, with "},{"type":"codeVoice","code":"HTTPDestination.amplitude(apiKey:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Mixpanel, with "},{"type":"codeVoice","code":"HTTPDestination.mixpanel(projectToken:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"MixpanelEncoding"},{"type":"text","text":");"},{"type":"text","text":" "},{"type":"text","text":"for Segment, RudderStack or Customer.io Data Pipelines, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.segment(writeKey:region:plan:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"rudderStack(writeKey:dataPlane:plan:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"customerIO(apiKey:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"SegmentSpecEncoding"},{"type":"text","text":"); for Google Analytics 4, from a"},{"type":"text","text":" "},{"type":"text","text":"server, with "},{"type":"codeVoice","code":"HTTPDestination.googleAnalytics(measurementID:apiSecret:region:plan:)"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"codeVoice","code":"GoogleAnalyticsEncoding"},{"type":"text","text":"); for Snowplow, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.snowplow(collector:vendor:appID:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"SnowplowEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck, with "},{"type":"codeVoice","code":"HTTPDestination.telemetryDeck(appID:namespace:testMode:plan:)"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"codeVoice","code":"TelemetryDeckEncoding"},{"type":"text","text":"); for Matomo, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.matomo(url:siteID:dimensions:category:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"MatomoEncoding"},{"type":"text","text":"). To read events inside the app or in a test, use"},{"type":"text","text":" "},{"type":"codeVoice","code":"InMemoryDestination"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"Destinations"},{"type":"text","text":") instead."}],"type":"paragraph"},{"type":"codeListing","code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    func requests(for batch: [EventRecord]) -> BatchRequests<Never> {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        let body = EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","        return BatchRequests(requests: [EncodedRequest(body: body, recordIDs: batch.map(\\.id))], skippedRecords: [])","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: try ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers this destination beside the others, and what a delivery does while a batch is retried."}],"type":"paragraph"}],"kind":"content"}],