{"topicSections":[{"anchor":"Sending-batches","title":"Sending batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"]},{"anchor":"Encoding-a-batch","title":"Encoding a batch","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"]},{"anchor":"Splitting-a-batch-into-requests","title":"Splitting a batch into requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchRequests","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/SkippedRecord"]},{"anchor":"Waiting-between-attempts","title":"Waiting between attempts","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"]},{"anchor":"Sending-requests","title":"Sending requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError"]}],"sections":[],"abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/httpdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"HTTPDestinations"}],"role":"collection","roleHeading":"Framework","title":"HTTPDestinations","externalID":"HTTPDestinations","symbolKind":"module"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" is a destination that posts each batch it receives as the requests its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" splits it into: one request for an endpoint without limits. Each body is whatever"},{"type":"text","text":" "},{"type":"text","text":"the encoder writes for its records, so events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance and the wire format is"},{"type":"text","text":" "},{"type":"text","text":"yours. It sends with "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" through"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport"},{"type":"text","text":" by default, or through any "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport"},{"type":"text","text":" you pass."}],"type":"paragraph"},{"inlineContent":[{"text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff"},{"text":": 1 second, doubling up to 60 seconds, unless you pass another. The","type":"text"},{"text":" ","type":"text"},{"text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store","type":"text"},{"text":" ","type":"text"},{"text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose","type":"text"},{"text":" ","type":"text"},{"text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"},{"text":" as an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"},{"text":", as is each record the encoder leaves out","type":"text"},{"text":" ","type":"text"},{"text":"of its requests.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tracing instrument injects the trace context of each request’s first record into its header"},{"type":"text","text":" "},{"type":"text","text":"fields, and "},{"code":"Content-Type","type":"codeVoice"},{"type":"text","text":" is always the encoder’s."}],"type":"paragraph"},{"inlineContent":[{"text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"text":"format, give the destination a ","type":"text"},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"CollectorEncoding","type":"codeVoice"},{"text":"); for PostHog,","type":"text"},{"text":" ","type":"text"},{"text":"make it with ","type":"text"},{"code":"HTTPDestination.postHog(projectToken:host:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"Amplitude, with ","type":"text"},{"code":"HTTPDestination.amplitude(apiKey:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"AmplitudeEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"Mixpanel, with ","type":"text"},{"code":"HTTPDestination.mixpanel(projectToken:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"MixpanelEncoding","type":"codeVoice"},{"text":");","type":"text"},{"text":" ","type":"text"},{"text":"for Segment, RudderStack or Customer.io Data Pipelines, with","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination.segment(writeKey:region:plan:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"rudderStack(writeKey:dataPlane:plan:)","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"customerIO(apiKey:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"SegmentSpecEncoding","type":"codeVoice"},{"text":"). To read events inside the app","type":"text"},{"text":" ","type":"text"},{"text":"or in a test, use ","type":"text"},{"code":"InMemoryDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"Destinations","type":"codeVoice"},{"text":") instead.","type":"text"}],"type":"paragraph"},{"code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    func requests(for batch: [EventRecord]) -> BatchRequests<Never> {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        let body = EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","        return BatchRequests(requests: [EncodedRequest(body: body, recordIDs: batch.map(\\.id))], skippedRecords: [])","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: try ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"text":" ","type":"text"},{"text":"covers this destination beside the others, and what a delivery does while a batch is retried.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransportError":{"role":"symbol","url":"\/documentation\/httpdestinations\/httptransporterror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPTransportError","kind":"identifier"}],"navigatorTitle":[{"text":"HTTPTransportError","kind":"identifier"}],"type":"topic","abstract":[{"text":"Why an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","type":"reference"},{"text":" returned no response.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError","title":"HTTPTransportError"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"type":"link"},"doc://HTTPDestinations/documentation/HTTPDestinations/URLSessionTransport":{"role":"symbol","url":"\/documentation\/httpdestinations\/urlsessiontransport","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"URLSessionTransport","kind":"identifier"}],"navigatorTitle":[{"text":"URLSessionTransport","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"An ","type":"text"}