{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations"]}],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"type":"text","text":" is a destination that posts each batch it receives as the requests its"},{"type":"text","text":" "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" splits it into: one request for an endpoint without limits. Each body is whatever"},{"type":"text","text":" "},{"type":"text","text":"the encoder writes for its records, so events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance and the wire format is"},{"type":"text","text":" "},{"type":"text","text":"yours. It sends with "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" through"},{"type":"text","text":" "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","isActive":true,"type":"reference"},{"type":"text","text":" by default, or through any "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","isActive":true,"type":"reference"},{"type":"text","text":" you pass."}]},{"type":"paragraph","inlineContent":[{"text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","type":"reference"},{"text":": nominally 1 second, doubling up to 60 seconds, unless you pass another. So","type":"text"},{"text":" ","type":"text"},{"text":"is one answered with a status the encoder lists in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","type":"reference"},{"text":", which every","type":"text"},{"text":" ","type":"text"},{"text":"encoder declares: empty for most servers, or each other failure its vendor answers to a request","type":"text"},{"text":" ","type":"text"},{"text":"worth sending again, such as Aptabase’s 418 for a slow upload.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A 2xx counts as delivered unless the encoder’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)"},{"text":" reads its body and","type":"text"},{"text":" ","type":"text"},{"text":"says otherwise. Some vendors answer 200 to a request they didn’t store, and say so only in the","type":"text"},{"text":" ","type":"text"},{"text":"body: Mixpanel’s ","type":"text"},{"type":"codeVoice","code":"{\"status\": 0}"},{"text":", or Aptabase’s ","type":"text"},{"type":"codeVoice","code":"{\"error\": ...}"},{"text":" for an unknown key. A 2xx the","type":"text"},{"text":" ","type":"text"},{"text":"encoder reads as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)"},{"text":" is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)"},{"text":". One it reads as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)"},{"text":" is sent again under the same backoff and deadline as a 5xx.","type":"text"},{"text":" ","type":"text"},{"text":"An encoder should count an empty body, or one it can’t read, as delivered, so an answer it","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t recognize never sends a request again and again; the DestinationTesting conformance kit","type":"text"},{"text":" ","type":"text"},{"text":"checks that it does. A transient answer is retried until the request’s deadline, so an encoder","type":"text"},{"text":" ","type":"text"},{"text":"whose requests have none should return rejected instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each wait has full jitter by default: a random wait shorter than the nominal one, so apps refused","type":"text"},{"text":" ","type":"text"},{"text":"at the same moment retry at different moments. Pass ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/none","type":"reference"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"nominal waits. In tests, pass a seeded generator as ","type":"text"},{"code":"randomNumberGenerator:","type":"codeVoice"},{"text":" for jittered waits","type":"text"},{"text":" ","type":"text"},{"text":"that repeat from one run to the next, as long as one request retries at a time: copies of a","type":"text"},{"text":" ","type":"text"},{"text":"destination retrying at once share the generator’s draws in the order they ask for them. Never","type":"text"},{"text":" ","type":"text"},{"text":"seed it in production, where every device would then wait the same, which defeats the jitter. The","type":"text"},{"text":" ","type":"text"},{"text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store","type":"text"},{"text":" ","type":"text"},{"text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose","type":"text"},{"text":" ","type":"text"},{"text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","type":"reference"},{"text":" as an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","type":"reference"},{"text":", as is each record the encoder leaves out","type":"text"},{"text":" ","type":"text"},{"text":"of its requests. So is a request still undelivered at its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","type":"reference"},{"text":", which an","type":"text"},{"text":" ","type":"text"},{"text":"encoder sets for a vendor that misdates or ignores old events: the destination checks it on its","type":"text"},{"text":" ","type":"text"},{"code":"now:","type":"codeVoice"},{"text":" clock before every attempt and sends nothing more once it has passed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracing instrument injects the trace context of each request’s first record into its header"},{"type":"text","text":" "},{"type":"text","text":"fields, and "},{"code":"Content-Type","type":"codeVoice"},{"type":"text","text":" is always the encoder’s."}]},{"type":"paragraph","inlineContent":[{"text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s","type":"text"},{"text":" ","type":"text"},{"text":"format, give the destination a ","type":"text"},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"CollectorEncoding","type":"codeVoice"},{"text":"); for PostHog,","type":"text"},{"text":" ","type":"text"},{"text":"make it with ","type":"text"},{"code":"HTTPDestination.postHog(projectToken:host:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"Amplitude, with ","type":"text"},{"code":"HTTPDestination.amplitude(apiKey:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"AmplitudeEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"Mixpanel, with ","type":"text"},{"code":"HTTPDestination.mixpanel(projectToken:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"MixpanelEncoding","type":"codeVoice"},{"text":");","type":"text"},{"text":" ","type":"text"},{"text":"for Segment, RudderStack or Customer.io Data Pipelines, with","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination.segment(writeKey:region:plan:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"rudderStack(writeKey:dataPlane:plan:)","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"customerIO(apiKey:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"SegmentSpecEncoding","type":"codeVoice"},{"text":"); for Google Analytics 4, from a","type":"text"},{"text":" ","type":"text"},{"text":"server, with ","type":"text"},{"code":"HTTPDestination.googleAnalytics(measurementID:apiSecret:region:plan:)","type":"codeVoice"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"code":"GoogleAnalyticsEncoding","type":"codeVoice"},{"text":"); for Snowplow, with","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination.snowplow(collector:vendor:appID:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"SnowplowEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck, with ","type":"text"},{"code":"HTTPDestination.telemetryDeck(appID:namespace:testMode:plan:)","type":"codeVoice"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"code":"TelemetryDeckEncoding","type":"codeVoice"},{"text":"); for Matomo, with","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination.matomo(url:siteID:dimensions:category:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"MatomoEncoding","type":"codeVoice"},{"text":"); for","type":"text"},{"text":" ","type":"text"},{"text":"Heap, with ","type":"text"},{"code":"HTTPDestination.heap(appID:region:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"HeapEncoding","type":"codeVoice"},{"text":"); for Aptabase, with","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination.aptabase(appKey:host:isDebug:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"AptabaseEncoding","type":"codeVoice"},{"text":"). To read events","type":"text"},{"text":" ","type":"text"},{"text":"inside the app or in a test, use","type":"text"},{"text":" ","type":"text"},{"code":"InMemoryDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"Destinations","type":"codeVoice"},{"text":") instead.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    static let transientStatuses: Set<TransientStatus> = []","","    static func outcome(of response: HTTPTransportResponse, for request: EncodedRequest) -> ResponseOutcome {","        .delivered","    }","","    func requests(for batch: [EventRecord]) -> BatchRequests<Never> {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        let body = EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","        return BatchRequests(requests: [EncodedRequest(body: body, recordIDs: batch.map(\\.id))], skippedRecords: [])","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: try ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers this destination beside the others, and what a delivery does while a batch is retried."}]}]}],"sections":[],"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Sending batches","anchor":"Sending-batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"]},{"title":"Encoding a batch","anchor":"Encoding-a-batch","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"]},{"title":"Reading a 2xx answer","anchor":"Reading-a-2xx-answer","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse"]},{"title":"Splitting a batch into requests","anchor":"Splitting-a-batch-into-requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchRequests","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/SkippedRecord"]},{"title":"Retrying a vendor’s own statuses","anchor":"Retrying-a-vendors-own-statuses","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/TransientStatus","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidTransientStatus"]},{"title":"Waiting between attempts","anchor":"Waiting-between-attempts","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"]},{"title":"Sending requests","anchor":"Sending-requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError"]}],"metadata":{"externalID":"HTTPDestinations","symbolKind":"module","role":"collection","title":"HTTPDestinations","modules":[{"name":"HTTPDestinations"}],"roleHeading":"Framework"},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExponentialBackoff","kind":"identifier"}],"navigatorTitle":[{"text":"ExponentialBackoff","kind":"identifier"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"How long "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" waits before each new attempt at a batch that wasn’t delivered:"},{"type":"text","text":" "},{"type":"text","text":"binary exponential backoff, each nominal wait twice the one before, up to a maximum, with"},{"type":"text","text":" "},{"type":"text","text":"jitter."}],"type":"topic","title":"ExponentialBackoff","url":"\/documentation\/httpdestinations\/exponentialbackoff"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/transientStatuses":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientStatuses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"TransientStatus","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV"},{"kind":"text","text":">"}],"required":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The failure statuses, beyond 408 Request Timeout, 429 Too Many Requests and every 5xx, that"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends a request of this encoder again after: "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" for none."}],"type":"topic","url":"\/documentation\/httpdestinations\/batchencoder\/transientstatuses","title":"transientStatuses"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"url":"\/documentation\/httpdestinations\/httpdestination","title":"HTTPDestination","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/TransientStatus/init(_:)":{"abstr