type":"codeVoice","code":"category"},{"type":"text","text":" and each property "},{"type":"codeVoice","code":"dimensions"},{"type":"text","text":" maps as its custom dimension, splitting each"},{"type":"text","text":" "},{"type":"text","text":"batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":", and leaving out the records tracked too long before, or after, the time"},{"type":"text","text":" "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"siteID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"dimensions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14MatomoEncoding0A10DimensionsV","text":"MatomoDimensions"},{"kind":"text","text":", "},{"kind":"externalParam","text":"category"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"limit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14MatomoEncoding0A10SetupErrorO","text":"MatomoSetupError"},{"kind":"text","text":")"}],"role":"symbol","type":"topic","title":"init(siteID:dimensions:category:plan:limit:now:)","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"text":" sends.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"role":"symbol","type":"topic","title":"BatchEncoder","kind":"symbol"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/batchLimit":{"url":"\/documentation\/matomoencoding\/matomobatchencoder\/batchlimit","type":"topic","title":"batchLimit","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"abstract":[{"type":"text","text":"The limits of one request: 20 tracking requests and 1,000,000 bytes of body, a tracking"},{"type":"text","text":" "},{"type":"text","text":"request’s included."}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","role":"symbol"},"doc://MatomoEncoding/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/MatomoEncoding\/s8SendableP","title":"Swift.Sendable"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/transientStatuses":{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/transientStatuses","url":"\/documentation\/matomoencoding\/matomobatchencoder\/transientstatuses","fragments":[{"kind":"keyword","text":"static"},{"kind":"text