"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of Matomo’s bulk tracking API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to a Matomo installation’s ","type":"text"},{"code":"POST \/matomo.php","type":"codeVoice"},{"text":".","type":"text"}],"title":"MatomoBatchEncoder","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MatomoBatchEncoder"}],"url":"\/documentation\/matomoencoding\/matomobatchencoder","navigatorTitle":[{"kind":"identifier","text":"MatomoBatchEncoder"}]},"doc://MatomoEncoding/documentation/MatomoEncoding":{"title":"MatomoEncoding","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","role":"collection","kind":"symbol","abstract":[{"text":"Send records to a Matomo installation as events, through its bulk tracking API.","type":"text"}],"url":"\/documentation\/matomoencoding","type":"topic"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/transientStatuses":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"No status beyond the 408, 429 and 5xx that "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries for every encoder."}],"title":"transientStatuses","type":"topic","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/transientStatuses","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientStatuses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","text":"TransientStatus"},{"kind":"text","text":">"}],"url":"\/documentation\/matomoencoding\/matomobatchencoder\/transientstatuses"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoEncodingError":{"title":"MatomoEncodingError","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError","role":"symbol","kind":"symbol","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s requests","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no record of a","type":"text"},{"text":" ","type":"text"},{"text":"batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoEncodingError","kind":"identifier"}],"url":"\/documentation\/matomoencoding\/matomoencodingerror","type":"topic","navigatorTitle":[{"text":"MatomoEncodingError","kind":"identifier"}]},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/Failure":{"title":"MatomoBatchEncoder.Failure","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/Failure","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"url":"\/documentation\/matomoencoding\/matomobatchencoder\/failure","type":"topic","navigatorTitle":[{"text":"Failure","kind":"identifier"}]},"doc://MatomoEncodin