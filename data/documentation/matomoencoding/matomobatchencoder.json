{"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding"]]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/MatomoEncoding\/s8SendableP","doc:\/\/MatomoEncoding\/s16SendableMetatypeP"]}],"metadata":{"roleHeading":"Structure","externalID":"s:14MatomoEncoding0A12BatchEncoderV","modules":[{"name":"MatomoEncoding"}],"remoteSource":{"fileName":"MatomoBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MatomoEncoding\/MatomoBatchEncoder.swift#L80"},"title":"MatomoBatchEncoder","symbolKind":"struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MatomoBatchEncoder"}]},"identifier":{"url":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/init(siteID:dimensions:category:plan:limit:now:)"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)"]},{"generated":true,"title":"Type Aliases","anchor":"Type-Aliases","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/Failure"]},{"generated":true,"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit"]}],"abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Matomo’s bulk tracking API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to a Matomo installation’s "},{"type":"codeVoice","code":"POST \/matomo.php"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoBatchEncoder","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/HTTPDestinations\/HTTPDestination\/matomo(url:siteID:dimensions:category:plan:backoff:clock:now:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}]},{"type":"codeListing","code":["let matomo = try HTTPDestination.matomo(","    url: url,  \/\/ where Matomo is installed: https:\/\/analytics.example.com","    siteID: 3,  \/\/ the app's site in Matomo","    dimensions: [\"plan\": 1, \"seats\": 2],  \/\/ custom dimensions made in Matomo","    category: \"Shop\",  \/\/ each event's category","    plan: plan)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":", "},{"code":"{\"requests\":[…]}","type":"codeVoice"},{"type":"text","text":", whose"},{"type":"text","text":" "},{"code":"requests","type":"codeVoice"},{"type":"text","text":" are one tracking request per record, oldest first, as Matomo asks for them: each a"},{"type":"text","text":" "},{"type":"text","text":"string, "},{"code":"?","type":"codeVoice"},{"type":"text","text":" and the request’s query, every value percent-encoded but for RFC 3986’s unreserved"},{"type":"text","text":" "},{"type":"text","text":"characters. Each request is a Matomo event, with these parameters in this order:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parameter"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"idsite"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The site ID the encoder is made with"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"rec"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"1"},{"type":"text","text":", without which Matomo records nothing"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"apiv","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"1","type":"codeVoice"},{"text":", the Tracking API’s version","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_id"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The visitor: the last 64 bits of the record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as 16 lowercase hexadecimal digits; of the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cdt"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in whole seconds since 1970, rounded down"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ca"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"1"},{"text":": the request is an event, not a page view, should Matomo’s Events plugin be turned off","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"e_c","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The category the encoder is made with"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"e_a"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"lang","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s locale’s BCP 47 identifier, "},{"code":"en-US","type":"codeVoice"},{"type":"text","text":", when its context has a "},{"code":"LocaleKey","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"dimension<ID>","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Each mapped property’s value, by the dimension’s ID, from lowest to highest","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent. Matomo counts a visitor per "},{"type":"codeVoice","code":"_id"},{"type":"text","text":", so its visitors are"},{"type":"text","text":" "},{"type":"text","text":"sessions, each a new visitor of one visit. A record with no session (one tracked by a tracker"},{"type":"text","text":" "},{"type":"text","text":"without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store recovered after a relaunch, which keeps no"},{"type":"text","text":" "},{"type":"text","text":"context) is its own visitor, linked to nothing. No "},{"type":"codeVoice","code":"uid"},{"type":"text","text":", "},{"type":"codeVoice","code":"cid"},{"type":"text","text":", "},{"type":"codeVoice","code":"token_auth"},{"type":"text","text":", "},{"type":"codeVoice","code":"cip"},{"type":"text","text":" or device"},{"type":"text","text":" "},{"type":"text","text":"identifier is sent, and nothing of the record’s context but its locale, nor its trace context."}]},{"type":"paragraph","inlineContent":[{"text":"A property reaches Matomo only as the custom dimension ","type":"text"},{"code":"dimensions","type":"codeVoice"},{"text":" maps it to, read through","type":"text"},{"text":" ","type":"text"},{"text":"the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads it: a string as it is, a number as JSON","type":"text"},{"text":" ","type":"text"},{"text":"writes it, a Boolean as ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and an array or object as its JSON. A ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" is left","type":"text"},{"text":" ","type":"text"},{"text":"out. A ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is","type":"text"},{"text":" ","type":"text"},{"text":"left out, and an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". Every other property is left out, and the","type":"text"},{"text":" ","type":"text"},{"text":"encoder logs a notice once, when it is made, for each event of the plan with properties no","type":"text"},{"text":" ","type":"text"},{"text":"dimension is mapped to (","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/unmappedProperties(in:)","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write, or that Matomo would refuse or store other than it is, is"},{"type":"text","text":" "},{"type":"text","text":"left out of the request, and the batch’s other records are sent: one whose event and version"},{"type":"text","text":" "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event name Matomo would empty or cut short, one whose event"},{"type":"text","text":" "},{"type":"text","text":"isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp has no whole seconds"},{"type":"text","text":" "},{"type":"text","text":"of "},{"code":"Int64","type":"codeVoice"},{"type":"text","text":" or is more than 23 hours before or after the batch is encoded, one with a dimension’s"},{"type":"text","text":" "},{"type":"text","text":"value longer than Matomo keeps, and one whose request is over 1,000,000 bytes"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError","type":"reference","isActive":true},{"type":"text","text":"). "},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"type":"text","text":" returns them as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Each request’s ","type":"text"},{"type":"codeVoice","code":"EncodedRequest\/deadline"},{"text":" is 23 hours after its oldest record was tracked, so","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" drops a request still being retried by then, every record of it, the younger","type":"text"},{"text":" ","type":"text"},{"text":"ones included, and reports it as ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"text":", rather","type":"text"},{"text":" ","type":"text"},{"text":"than send it to a Matomo that would answer 200 and store nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Matomo answers 200 to a bulk request it reads, counting the tracking requests","type":"text"},{"text":" ","type":"text"},{"text":"it refuses as ","type":"text"},{"code":"invalid","type":"codeVoice"},{"text":" in its answer without storing them; 400 to a body it can’t read, which","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops and reports with every record of the request; and 500 when its database","type":"text"},{"text":" ","type":"text"},{"text":"fails, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries. It doesn’t remove duplicates, so a record sent again is","type":"text"},{"text":" ","type":"text"},{"text":"counted again. The bytes are the same for the same records, time and configuration on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/matomoencoding\/matomobatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/batchLimit":{"kind":"symbol","abstract":[{"type":"text","text":"The limits of one request: 20 tracking requests and 1,000,000 bytes of body, a tracking"},{"type":