{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoBatchEncoder","kind":"identifier"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/HTTPDestinations\/HTTPDestination\/matomo(url:siteID:dimensions:category:plan:backoff:clock:now:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}]},{"code":["let matomo = try HTTPDestination.matomo(","    url: url,  \/\/ where Matomo is installed: https:\/\/analytics.example.com","    siteID: 3,  \/\/ the app's site in Matomo","    dimensions: [\"plan\": 1, \"seats\": 2],  \/\/ custom dimensions made in Matomo","    category: \"Shop\",  \/\/ each event's category","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":", ","type":"text"},{"code":"{\"requests\":[…]}","type":"codeVoice"},{"text":", whose","type":"text"},{"text":" ","type":"text"},{"code":"requests","type":"codeVoice"},{"text":" are one tracking request per record, oldest first, as Matomo asks for them: each a","type":"text"},{"text":" ","type":"text"},{"text":"string, ","type":"text"},{"code":"?","type":"codeVoice"},{"text":" and the request’s query, every value percent-encoded but for RFC 3986’s unreserved","type":"text"},{"text":" ","type":"text"},{"text":"characters. Each request is a Matomo event, with these parameters in this order:","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Parameter"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"idsite","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The site ID the encoder is made with","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"rec"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"1"},{"text":", without which Matomo records nothing","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"apiv"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"1"},{"type":"text","text":", the Tracking API’s version"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"_id"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The visitor: the last 64 bits of the record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as 16 lowercase hexadecimal digits; of the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"cdt"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked, in whole seconds since 1970, rounded down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"ca","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"1","type":"codeVoice"},{"type":"text","text":": the request is an event, not a page view, should Matomo’s Events plugin be turned off"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"e_c","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The category the encoder is made with","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"e_a"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"lang"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s locale’s BCP 47 identifier, "},{"code":"en-US","type":"codeVoice"},{"type":"text","text":", when its context has a "},{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"dimension<ID>","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Each mapped property’s value, by the dimension’s ID, from lowest to highest"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent. Matomo counts a visitor per ","type":"text"},{"type":"codeVoice","code":"_id"},{"text":", so its visitors are","type":"text"},{"text":" ","type":"text"},{"text":"sessions, each a new visitor of one visit. A record with no session (one tracked by a tracker","type":"text"},{"text":" ","type":"text"},{"text":"without ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":") is its own visitor, linked to nothing. A record a store recovers","type":"text"},{"text":" ","type":"text"},{"text":"after a relaunch keeps its session, so it goes out under the ","type":"text"},{"type":"codeVoice","code":"_id"},{"text":" of its first send. No ","type":"text"},{"type":"codeVoice","code":"uid"},{"text":", ","type":"text"},{"type":"codeVoice","code":"cid"},{"text":", ","type":"text"},{"type":"codeVoice","code":"token_auth"},{"text":", ","type":"text"},{"type":"codeVoice","code":"cip"},{"text":" or device","type":"text"},{"text":" ","type":"text"},{"text":"identifier is sent, and nothing of the record’s context but its locale, nor its trace context.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A property reaches Matomo only as the custom dimension "},{"code":"dimensions","type":"codeVoice"},{"type":"text","text":" maps it to, read through"},{"type":"text","text":" "},{"type":"text","text":"the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads it: a string as it is, a number as JSON"},{"type":"text","text":" "},{"type":"text","text":"writes it, a Boolean as "},{"code":"true","type":"codeVoice"},{"type":"text","text":" or "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and an array or object as its JSON. A "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" is left"},{"type":"text","text":" "},{"type":"text","text":"out. A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is"},{"type":"text","text":" "},{"type":"text","text":"left out, and an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":". Every other property is left out, and the"},{"type":"text","text":" "},{"type":"text","text":"encoder logs a notice once, when it is made, for each event of the plan with properties no"},{"type":"text","text":" "},{"type":"text","text":"dimension is mapped to ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/unmappedProperties(in:)"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write, or that Matomo would refuse or store other than it is, is"},{"type":"text","text":" "},{"type":"text","text":"left out of the request, and the batch’s other records are sent: one whose event and version"},{"type":"text","text":" "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name Matomo would empty or cut short, one whose event"},{"type":"text","text":" "},{"type":"text","text":"isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp has no whole seconds"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"Int64"},{"type":"text","text":" or is more than 23 hours before or after the batch is encoded, one with a dimension’s"},{"type":"text","text":" "},{"type":"text","text":"value longer than Matomo keeps, and one whose request is over 1,000,000 bytes"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError","isActive":true},{"type":"text","text":"). "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Each request’s ","type":"text"},{"code":"EncodedRequest\/deadline","type":"codeVoice"},{"text":" is 23 hours after its oldest record was tracked, so","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops a request still being retried by then, every record of it, the younger","type":"text"},{"text":" ","type":"text"},{"text":"ones included, and reports it as ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":", rather","type":"text"},{"text":" ","type":"text"},{"text":"than send it to a Matomo that would answer 200 and store nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. Matomo answers 200 to a bulk request it reads, counting the tracking requests"},{"type":"text","text":" "},{"type":"text","text":"it refuses as "},{"type":"codeVoice","code":"invalid"},{"type":"text","text":" in its answer without storing them; 400 to a body it can’t read, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops and reports with every record of the request; and 500 when its database"},{"type":"text","text":" "},{"type":"text","text":"fails, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries. A 200 that says Matomo tracked none of the request’s"},{"type":"text","text":" "},{"type":"text","text":"tracking requests is rejected ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/outcome(of:for:)"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops and reports it"},{"type":"text","text":" "},{"type":"text","text":"too; one that refused only some isn’t, as its answer doesn’t say which. It doesn’t remove duplicates, so a record sent again is"},{"type":"text","text":" "},{"type":"text","text":"counted again. The bytes are the same for the same records, time and configuration on every run"},{"type":"text","text":" "},{"type":"text","text":"and platform."}]}]}],"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of Matomo’s bulk tracking API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to a Matomo installation’s ","type":"text"},{"code":"POST \/matomo.php","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding"]]},"topicSections":[{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/init(siteID:dimensions:category:plan:limit:now:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/didReceive(_:for:)","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/Failure"],"title":"Type Aliases","anchor":"Type-Aliases","generated":true},{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/transientStatuses"],"title":"Type Properties","anchor":"Type-Properties","generated":true},{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/outcome(of:for:)"],"title":"Type Methods","anchor":"Type-Methods","generated":true}],"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/MatomoEncoding\/s8SendableP","doc:\/\/MatomoEncoding\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"metadata":{"externalID":"s:14MatomoEncoding0A12BatchEncoderV","modul