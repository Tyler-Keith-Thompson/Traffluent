{"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MatomoBatchEncoder"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Make the destination with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/HTTPDestinations\/HTTPDestination\/matomo(url:siteID:dimensions:category:plan:backoff:clock:now:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}],"type":"paragraph"},{"syntax":"swift","code":["let matomo = try HTTPDestination.matomo(","    url: url,  \/\/ where Matomo is installed: https:\/\/analytics.example.com","    siteID: 3,  \/\/ the app's site in Matomo","    dimensions: [\"plan\": 1, \"seats\": 2],  \/\/ custom dimensions made in Matomo","    category: \"Shop\",  \/\/ each event's category","    plan: plan)"],"type":"codeListing"},{"inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":", ","type":"text"},{"code":"{\"requests\":[…]}","type":"codeVoice"},{"text":", whose","type":"text"},{"text":" ","type":"text"},{"code":"requests","type":"codeVoice"},{"text":" are one tracking request per record, oldest first, as Matomo asks for them: each a","type":"text"},{"text":" ","type":"text"},{"text":"string, ","type":"text"},{"code":"?","type":"codeVoice"},{"text":" and the request’s query, every value percent-encoded but for RFC 3986’s unreserved","type":"text"},{"text":" ","type":"text"},{"text":"characters. Each request is a Matomo event, with these parameters in this order:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Parameter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"idsite"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The site ID the encoder is made with"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"rec"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"1"},{"text":", without which Matomo records nothing","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"apiv"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"1"},{"type":"text","text":", the Tracking API’s version"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"_id"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The visitor: the last 64 bits of the record’s session, its "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", as 16 lowercase hexadecimal digits; of the record’s own "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":" the same way when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"cdt"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked, in whole seconds since 1970, rounded down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"ca","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"1"},{"type":"text","text":": the request is an event, not a page view, should Matomo’s Events plugin be turned off"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"e_c","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The category the encoder is made with","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"e_a"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"lang","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s locale’s BCP 47 identifier, "},{"type":"codeVoice","code":"en-US"},{"type":"text","text":", when its context has a "},{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"dimension<ID>","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Each mapped property’s value, by the dimension’s ID, from lowest to highest"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent. Matomo counts a visitor per "},{"code":"_id","type":"codeVoice"},{"type":"text","text":", so its visitors are"},{"type":"text","text":" "},{"type":"text","text":"sessions, each a new visitor of one visit. A record with no session (one tracked by a tracker"},{"type":"text","text":" "},{"type":"text","text":"without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":", or one a store recovered after a relaunch, which keeps no"},{"type":"text","text":" "},{"type":"text","text":"context) is its own visitor, linked to nothing. No "},{"code":"uid","type":"codeVoice"},{"type":"text","text":", "},{"code":"cid","type":"codeVoice"},{"type":"text","text":", "},{"code":"token_auth","type":"codeVoice"},{"type":"text","text":", "},{"code":"cip","type":"codeVoice"},{"type":"text","text":" or device"},{"type":"text","text":" "},{"type":"text","text":"identifier is sent, and nothing of the record’s context but its locale, nor its trace context."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A property reaches Matomo only as the custom dimension "},{"code":"dimensions","type":"codeVoice"},{"type":"text","text":" maps it to, read through"},{"type":"text","text":" "},{"type":"text","text":"the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads it: a string as it is, a number as JSON"},{"type":"text","text":" "},{"type":"text","text":"writes it, a Boolean as "},{"code":"true","type":"codeVoice"},{"type":"text","text":" or "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and an array or object as its JSON. A "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" is left"},{"type":"text","text":" "},{"type":"text","text":"out. A "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is"},{"type":"text","text":" "},{"type":"text","text":"left out, and an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":". Every other property is left out, and the"},{"type":"text","text":" "},{"type":"text","text":"encoder logs a notice once, when it is made, for each event of the plan with properties no"},{"type":"text","text":" "},{"type":"text","text":"dimension is mapped to ("},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/unmappedProperties(in:)","isActive":true},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write, or that Matomo would refuse or store other than it is, is"},{"type":"text","text":" "},{"type":"text","text":"left out of the request, and the batch’s other records are sent: one whose event and version"},{"type":"text","text":" "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name Matomo would empty or cut short, one whose event"},{"type":"text","text":" "},{"type":"text","text":"isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp has no whole seconds"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"Int64"},{"type":"text","text":" or is more than 23 hours before or after the batch is encoded, one with a dimension’s"},{"type":"text","text":" "},{"type":"text","text":"value longer than Matomo keeps, and one whose request is over 1,000,000 bytes"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError"},{"type":"text","text":"). "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)"},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each request’s "},{"type":"codeVoice","code":"EncodedRequest\/deadline"},{"type":"text","text":" is 23 hours after its oldest record was tracked, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops a request still being retried by then, every record of it, the younger"},{"type":"text","text":" "},{"type":"text","text":"ones included, and reports it as "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":", rather"},{"type":"text","text":" "},{"type":"text","text":"than send it to a Matomo that would answer 200 and store nothing."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Matomo answers 200 to a bulk request it reads, counting the tracking requests","type":"text"},{"text":" ","type":"text"},{"text":"it refuses as ","type":"text"},{"code":"invalid","type":"codeVoice"},{"text":" in its answer without storing them; 400 to a body it can’t read, which","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops and reports with every record of the request; and 500 when its database","type":"text"},{"text":" ","type":"text"},{"text":"fails, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries. It doesn’t remove duplicates, so a record sent again is","type":"text"},{"text":" ","type":"text"},{"text":"counted again. The bytes are the same for the same records, time and configuration on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of Matomo’s bulk tracking API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to a Matomo installation’s ","type":"text"},{"type":"codeVoice","code":"POST \/matomo.php"},{"text":".","type":"text"}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/init(siteID:dimensions:category:plan:limit:now:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/Failure"],"title":"Type Aliases","anchor":"Type-Aliases","generated":true},{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/transientStatuses"],"title":"Type Properties","anchor":"Type-Properties","generated":true}],"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/MatomoEncoding\/s8SendableP","doc:\/\/MatomoEncoding\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"metadata":{"navigatorTitle":[{"text":"MatomoBatchEncoder","kind":"identifier"}],"externalID":"s:14MatomoEncoding0A12BatchEncoderV","symbolKind":"struct","remoteSource":{"fileName":"MatomoBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MatomoEncoding\/MatomoBatchEncoder.swift#L80"},"role":"symbol","roleHeading":"Structure","title":"MatomoBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoBatchEncoder","kind":"identifier"}],"modules":[{"name":"MatomoEncoding"}]},"variants":[{"paths":["\/documentation\/matomoencoding\/matomobatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoEncodingError":{"url":"\/documentation\/matomoencoding\/matomoencodingerror","abstract":[{"type":"text","text":"Why "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoEncodingError","kind":"identifier"}],"navigatorTitle":[{"text":"MatomoEncodingError","kind":"identifier"}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError","role":"symbol","type":"topic","kind":"symbol","title":"MatomoEncodingError"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/Failure":{"navigatorTitle":[{"kind":"identifier","text":"Failure"}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/Failure","kind":"symbol","url":"\/documentation\/matomoencoding\/matomobatchencoder\/failure","abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"role":"symbol","type":"topic","title":"MatomoBatchEncoder.Failure","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}]},"doc://MatomoEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/MatomoEncoding\/s16SendableMetatypeP"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/transientStatuses":{"url":"\/documentation\/matomoencoding\/matomobatchencoder\/transientstatuses","abst