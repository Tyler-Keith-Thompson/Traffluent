nsions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MatomoDimensions","kind":"typeIdentifier","preciseIdentifier":"s:14MatomoEncoding0A10DimensionsV"},{"text":", ","kind":"text"},{"text":"category","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"MatomoSetupError","kind":"typeIdentifier","preciseIdentifier":"s:14MatomoEncoding0A10SetupErrorO"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"An encoder of the events "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, for the Matomo site "},{"type":"codeVoice","code":"siteID"},{"type":"text","text":", sending each event"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"category"},{"type":"text","text":" and each property "},{"type":"codeVoice","code":"dimensions"},{"type":"text","text":" maps as its custom dimension, splitting each"},{"type":"text","text":" "},{"type":"text","text":"batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":", and leaving out the records tracked too long before, or after, the time"},{"type":"text","text":" "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives."}],"kind":"symbol","title":"init(siteID:dimensions:category:plan: