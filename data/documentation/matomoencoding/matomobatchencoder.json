t"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"type":"topic","title":"BatchEncoder"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"url":"\/documentation\/httpdestinations\/httpdestination","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","title":"HTTPDestination","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}]},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/batchLimit":{"url":"\/documentation\/matomoencoding\/matomobatchencoder\/batchlimit","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","title":"batchLimit","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","abstract":[{"text":"The limits of one request: 20 tracking requests and 1,000,000 bytes of body, a tracking","type":"text"},{"text":" ","type":"text"},{"text":"request’s included.","type":"text"}]},"doc://MatomoEncoding/documentation/MatomoEncoding/HTTPDestinations/HTTPDestination/matomo(url:siteID:dimensions:category:plan:backoff:clock:now:)":{"kind":"symbol","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"