":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"title":"Sensitive","url":"\/documentation\/events\/sensitive","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}]},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/outcome(of:for:)":{"type":"topic","abstract":[{"type":"text","text":"What Matomo’s 2xx answer to "},{"type":"codeVoice","code":"request"},{"type":"text","text":" means: transient when Matomo counted fewer of its"},{"type":"text","text":" "},{"type":"text","text":"tracking requests than were sent, rejected when it refused every one it counted, and"},{"type":"text","text":" "},{"type":"text","text":"delivered otherwise."}],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","kind":"typeIdentifier","text":"HTTPTransportResponse"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","kind":"typeIdentifier","text":"EncodedRequest"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","kind":"typeIdentifier","text":"ResponseOutcome"}],"url":"\/documentation\/matomoencoding\/matomobatchencoder\/outcome(of:for:)","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/outcome(of:for:)","title":"outcome(of:for:)","kind":"symbol"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoEncodingError":{"abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","type":"reference","isActive":true},{"text":" couldn’t send a record, which it leaves out of the batch’s requests","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" reports as a drop. When it can encode no record of a","type":"text"},{"text":" ","type":"text"},{"text":"batch, it makes no request, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for the batch.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"MatomoEncodingError","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoEncodingError","kind":"identifier"}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError","url":"\/documentation\/matomoencoding\/matomoencodingerror","type":"topic","title":"MatomoEncodingError","kind":"symbol"},"doc://MatomoEncoding/documentation/MatomoEncoding":{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","abstract":[{"type":"text","text":"Send records to a Matomo installation as events, through its bulk tracking API."}],"kind":"symbol","url":"\/documentation\/matomoencoding","role":"collection","type":"topic","title":"MatomoEncoding"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/batchLimit":{"abstract":[{"text":"The limits of one request: 20 tracking requests and 1,000,000 bytes of body, a tracking","type":"text"},{"text":" ","type":"text"},{"text":"request’s included.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"}