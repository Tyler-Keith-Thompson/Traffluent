{"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder"},"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding"]]},"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/init(siteID:dimensions:category:plan:limit:now:)"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)"]},{"anchor":"Type-Aliases","generated":true,"title":"Type Aliases","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/Failure"]},{"anchor":"Type-Properties","generated":true,"title":"Type Properties","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/transientStatuses"]},{"anchor":"Type-Methods","generated":true,"title":"Type Methods","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/outcome(of:for:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoBatchEncoder","kind":"identifier"}]}]},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/HTTPDestinations\/HTTPDestination\/matomo(url:siteID:dimensions:category:plan:backoff:clock:now:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and its limits:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let matomo = try HTTPDestination.matomo(","    url: url,  \/\/ where Matomo is installed: https:\/\/analytics.example.com","    siteID: 3,  \/\/ the app's site in Matomo","    dimensions: [\"plan\": 1, \"seats\": 2],  \/\/ custom dimensions made in Matomo","    category: \"Shop\",  \/\/ each event's category","    plan: plan)"]},{"inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", "},{"type":"codeVoice","code":"{\"requests\":[…]}"},{"type":"text","text":", whose"},{"type":"text","text":" "},{"type":"codeVoice","code":"requests"},{"type":"text","text":" are one tracking request per record, oldest first, as Matomo asks for them: each a"},{"type":"text","text":" "},{"type":"text","text":"string, "},{"type":"codeVoice","code":"?"},{"type":"text","text":" and the request’s query, every value percent-encoded but for RFC 3986’s unreserved"},{"type":"text","text":" "},{"type":"text","text":"characters. Each request is a Matomo event, with these parameters in this order:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Parameter"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"idsite","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The site ID the encoder is made with","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"rec","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"1"},{"type":"text","text":", without which Matomo records nothing"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"apiv"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"1"},{"text":", the Tracking API’s version","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"_id"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The visitor: the last 64 bits of the record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as 16 lowercase hexadecimal digits; of the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"cdt"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in whole seconds since 1970, rounded down"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"ca","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"1","type":"codeVoice"},{"type":"text","text":": the request is an event, not a page view, should Matomo’s Events plugin be turned off"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"e_c","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The category the encoder is made with"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"e_a","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"lang"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s locale’s BCP 47 identifier, "},{"type":"codeVoice","code":"en-US"},{"type":"text","text":", when its context has a "},{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"dimension<ID>"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Each mapped property’s value, by the dimension’s ID, from lowest to highest"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"The session is the only identifier sent. Matomo counts a visitor per ","type":"text"},{"type":"codeVoice","code":"_id"},{"text":", so its visitors are","type":"text"},{"text":" ","type":"text"},{"text":"sessions, each a new visitor of one visit. A record with no session (one tracked by a tracker","type":"text"},{"text":" ","type":"text"},{"text":"without ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":") is its own visitor, linked to nothing. A record a store recovers","type":"text"},{"text":" ","type":"text"},{"text":"after a relaunch keeps its session, so it goes out under the ","type":"text"},{"type":"codeVoice","code":"_id"},{"text":" of its first send. No ","type":"text"},{"type":"codeVoice","code":"uid"},{"text":", ","type":"text"},{"type":"codeVoice","code":"cid"},{"text":", ","type":"text"},{"type":"codeVoice","code":"token_auth"},{"text":", ","type":"text"},{"type":"codeVoice","code":"cip"},{"text":" or device","type":"text"},{"text":" ","type":"text"},{"text":"identifier is sent, and nothing of the record’s context but its locale, nor its trace context.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A property reaches Matomo only as the custom dimension "},{"type":"codeVoice","code":"dimensions"},{"type":"text","text":" maps it to, read through"},{"type":"text","text":" "},{"type":"text","text":"the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads it: a string as it is, a number as JSON"},{"type":"text","text":" "},{"type":"text","text":"writes it, a Boolean as "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and an array or object as its JSON. A "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" is left"},{"type":"text","text":" "},{"type":"text","text":"out. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is"},{"type":"text","text":" "},{"type":"text","text":"left out, and an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". Every other property is left out, and the"},{"type":"text","text":" "},{"type":"text","text":"encoder logs a notice once, when it is made, for each event of the plan with properties no"},{"type":"text","text":" "},{"type":"text","text":"dimension is mapped to ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/unmappedProperties(in:)"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"A record the encoder can’t write, or that Matomo would refuse or store other than it is, is","type":"text"},{"text":" ","type":"text"},{"text":"left out of the request, and the batch’s other records are sent: one whose event and version","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event name Matomo would empty or cut short, one whose event","type":"text"},{"text":" ","type":"text"},{"text":"isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds a value JSON can’t, one whose timestamp has no whole seconds","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"type":"codeVoice","code":"Int64"},{"text":" or is more than 23 hours before or after the batch is encoded, one with a dimension’s","type":"text"},{"text":" ","type":"text"},{"text":"value longer than Matomo keeps, and one whose request is over 1,000,000 bytes","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError"},{"text":"). ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)"},{"text":" returns them as ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each request’s ","type":"text"},{"code":"EncodedRequest\/deadline","type":"codeVoice"},{"text":" is 23 hours after its oldest record was tracked, so","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops a request still being retried by then, every record of it, the younger","type":"text"},{"text":" ","type":"text"},{"text":"ones included, and reports it as ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":", rather","type":"text"},{"text":" ","type":"text"},{"text":"than send it to a Matomo that would answer 200 and store nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Matomo answers 200 to a bulk request it reads, counting the tracking requests","type":"text"},{"text":" ","type":"text"},{"text":"it refuses as ","type":"text"},{"code":"invalid","type":"codeVoice"},{"text":" in its answer without storing them; 400 to a body it can’t read, which","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops and reports with every record of the request; and 500 when its database","type":"text"},{"text":" ","type":"text"},{"text":"fails, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries. A 200 that says Matomo tracked none of the request’s","type":"text"},{"text":" ","type":"text"},{"text":"tracking requests is rejected (","type":"text"},{"isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/outcome(of:for:)","type":"reference"},{"text":"), so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops and reports it","type":"text"},{"text":" ","type":"text"},{"text":"too; one that refused only some isn’t, as its answer doesn’t say which. It doesn’t remove duplicates, so a record sent again is","type":"text"},{"text":" ","type":"text"},{"text":"counted again. The bytes are the same for the same records, time and configuration on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/matomoencoding\/matomobatchencoder"]}],"metadata":{"title":"MatomoBatchEncoder","navigatorTitle":[{"text":"MatomoBatchEncoder","kind":"identifier"}],"modules":[{"name":"MatomoEncoding"}],"symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MatomoEncoding\/MatomoBatchEncoder.swift#L82","fileName":"MatomoBatchEncoder.swift"},"roleHeading":"Structure","role":"symbol","externalID":"s:14MatomoEncoding0A12BatchEncoderV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoBatchEncoder","kind":"identifier"}]},"abstract":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"text":" of Matomo’s bulk tracking API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to a Matomo installation’s ","type":"text"},{"type":"codeVoice","code":"POST \/matomo.php"},{"text":".","type":"text"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/MatomoEncoding\/s8SendableP","doc:\/\/MatomoEncoding\/s16SendableMetatypeP"]}],"references":{"doc://Events/documentation/Events/Sensitive":{"url":"\/documentation\/events\/sensitive","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"role":"symbol","title":"Sensitive","type":"topic","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"kind":"symbol"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/outcome(of:for:)":{"role":"symbol","type":"topic","url":"\/documentation\/matomoencoding\/matomobatchencoder\/outcome(of:for:)","abstract":[{"text":"What Matomo’s 2xx answer to ","type":"text"},{"type":"codeVoice","code":"request"},{"text":" means: transient when Matomo counted fewer of its","type":"text"},{"text":" ","type":"text"},{"text":"tracking requests than were sent, rejected when it refused every one it counted, and","type":"text"},{"text":" ","type":"text"},{"text":"delivered otherwise.","type":"text"}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/outcome(of:for:)","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO"}],"title":"outcome(of:for:)"},"doc://MatomoEncoding/documentation/MatomoEncoding":{"abstract":[{"text":"Send records to a Matomo installation as events, through its bulk tracking API.","type":"text"}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","url":"\/documentation\/matomoencoding","role":"collection","type":"topic","title":"MatomoEncoding","kind":"symbol"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoDimensions/unmappedProperties(in:)":{"abstract":[{"text":"The properties of ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":"’s events that no mapping names, and that Matomo is never sent.","type":"text"}],"url":"\/documentation\/matomoencoding\/matomodimensions\/unmappedproperties(in:)","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/unmappedProperties(in:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"unmappedProperties"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"MatomoUnmappedProperty","preciseIden