e","code":"category"},{"type":"text","text":" and each property "},{"type":"codeVoice","code":"dimensions"},{"type":"text","text":" maps as its custom dimension, splitting each"},{"type":"text","text":" "},{"type":"text","text":"batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":", and leaving out the records tracked too long before, or after, the time"},{"type":"text","text":" "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives."}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/init(siteID:dimensions:category:plan:limit:now:)","kind":"symbol","title":"init(siteID:dimensions:category:plan:limit:now:)"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoDimensions/unmappedProperties(in:)":{"kind":"symbol","title":"unmappedProperties(in:)","type":"topic","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/unmappedProperties(in:)","url":"\/documentation\/matomoencoding\/matomodimensions\/unmappedproperties(in:)","role":"symbol","abstract":[{"type":"text","text":"The properties of "},{"type":"codeVoice","code":"plan"},{"type":"text","text":"’s events that no mapping names, and that Matomo is never sent."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"unmappedProperties"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier","text":"TrackingPlan"},{"kind":"text","text":") -> ["},{"preciseIdentifier":"s:14MatomoEncoding0A16UnmappedPropertyV","kind":"typeIdentifier","text":"MatomoUnmappedProperty"},{"kind":"text","text":"]"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"url":"\/documentation\/httpdestinations\/httpdestination","title":"HTTPDestination","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","