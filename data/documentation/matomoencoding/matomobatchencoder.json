tomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"title":"MatomoEncodingError","role":"symbol"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MatomoBatchEncoder"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MatomoBatchEncoder"}],"url":"\/documentation\/matomoencoding\/matomobatchencoder","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" of Matomo’s bulk tracking API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to a Matomo installation’s ","type":"text"},{"code":"POST \/matomo.php","type":"codeVoice"},{"text":".","type":"text"}],"title":"MatomoBatchEncoder","role":"symbol"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoDimensions/unmappedProperties(in:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unmappedProperties","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":") -> [","kind":"text"},{"text":"MatomoUnmappedProperty","kind":"typeIdentifier","preciseIdentifier":"s:14MatomoEncoding0A16UnmappedPropertyV"},{"text":"]","kind":"text"}],"kind":"symbol","url":"\/documentation\/matomoencoding\/matomodimensions\/unmappedproperties(in:)","abstract":[{"type":"text","text":"The properties of "},{"type":"codeVoice","code":"plan"},{"type":"text","text":"’s events that no mapping names, and that Matomo is never sent."}],"title":"unmappedProperties(in:)","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/unmappedProperties(in:)","type":"topic"},"doc://MatomoEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/MatomoEncoding\/s16SendableMetatypeP","type":"unresolvable"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/Failure":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"url":"\/documentation\/matomoencoding\/matomobatchencoder\/failure","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/Failure","role":"symbol","kind":"symbol","title":"MatomoBatchEncoder.Failure","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Failure"}]},"doc://MatomoEncoding/s8SendableP":{"identifier":"doc:\/\/MatomoEncoding\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/transientStatuses":{"title":"transientStatuses","abstract":[{"type":"text","text":"No status beyond the 408, 429 and 5xx that "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries for every encoder."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","tex