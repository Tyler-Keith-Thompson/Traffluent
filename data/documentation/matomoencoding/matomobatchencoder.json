{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/matomoencoding\/matomobatchencoder"]}],"topicSections":[{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/init(siteID:dimensions:category:plan:limit:now:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/Failure"],"generated":true,"title":"Type Aliases","anchor":"Type-Aliases"},{"identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit"],"generated":true,"title":"Type Properties","anchor":"Type-Properties"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MatomoBatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/HTTPDestinations\/HTTPDestination\/matomo(url:siteID:dimensions:category:plan:backoff:clock:now:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and its limits:","type":"text"}],"type":"paragraph"},{"code":["let matomo = try HTTPDestination.matomo(","    url: url,  \/\/ where Matomo is installed: https:\/\/analytics.example.com","    siteID: 3,  \/\/ the app's site in Matomo","    dimensions: [\"plan\": 1, \"seats\": 2],  \/\/ custom dimensions made in Matomo","    category: \"Shop\",  \/\/ each event's category","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"type":"codeVoice","code":"application\/json"},{"text":", ","type":"text"},{"type":"codeVoice","code":"{\"requests\":[…]}"},{"text":", whose","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"requests"},{"text":" are one tracking request per record, oldest first, as Matomo asks for them: each a","type":"text"},{"text":" ","type":"text"},{"text":"string, ","type":"text"},{"type":"codeVoice","code":"?"},{"text":" and the request’s query, every value percent-encoded but for RFC 3986’s unreserved","type":"text"},{"text":" ","type":"text"},{"text":"characters. Each request is a Matomo event, with these parameters in this order:","type":"text"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parameter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"idsite","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The site ID the encoder is made with","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"rec","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"1","type":"codeVoice"},{"text":", without which Matomo records nothing","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"apiv","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"1","type":"codeVoice"},{"text":", the Tracking API’s version","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The visitor: the last 64 bits of the record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as 16 lowercase hexadecimal digits; of the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cdt"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in whole seconds since 1970, rounded down"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"ca","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"1","type":"codeVoice"},{"type":"text","text":": the request is an event, not a page view, should Matomo’s Events plugin be turned off"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"e_c"}]}],[{"type":"paragraph","inlineContent":[{"text":"The category the encoder is made with","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"e_a"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"lang"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s locale’s BCP 47 identifier, "},{"code":"en-US","type":"codeVoice"},{"type":"text","text":", when its context has a "},{"code":"LocaleKey","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dimension<ID>"}]}],[{"type":"paragraph","inlineContent":[{"text":"Each mapped property’s value, by the dimension’s ID, from lowest to highest","type":"text"}]}]]]},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent. Matomo counts a visitor per "},{"type":"codeVoice","code":"_id"},{"type":"text","text":", so its visitors are"},{"type":"text","text":" "},{"type":"text","text":"sessions, each a new visitor of one visit. A record with no session (one tracked by a tracker"},{"type":"text","text":" "},{"type":"text","text":"without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store recovered after a relaunch, which keeps no"},{"type":"text","text":" "},{"type":"text","text":"context) is its own visitor, linked to nothing. No "},{"type":"codeVoice","code":"uid"},{"type":"text","text":", "},{"type":"codeVoice","code":"cid"},{"type":"text","text":", "},{"type":"codeVoice","code":"token_auth"},{"type":"text","text":", "},{"type":"codeVoice","code":"cip"},{"type":"text","text":" or device"},{"type":"text","text":" "},{"type":"text","text":"identifier is sent, and nothing of the record’s context but its locale, nor its trace context."}],"type":"paragraph"},{"inlineContent":[{"text":"A property reaches Matomo only as the custom dimension ","type":"text"},{"code":"dimensions","type":"codeVoice"},{"text":" maps it to, read through","type":"text"},{"text":" ","type":"text"},{"text":"the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads it: a string as it is, a number as JSON","type":"text"},{"text":" ","type":"text"},{"text":"writes it, a Boolean as ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and an array or object as its JSON. A ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" is left","type":"text"},{"text":" ","type":"text"},{"text":"out. A ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is","type":"text"},{"text":" ","type":"text"},{"text":"left out, and an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". Every other property is left out, and the","type":"text"},{"text":" ","type":"text"},{"text":"encoder logs a notice once, when it is made, for each event of the plan with properties no","type":"text"},{"text":" ","type":"text"},{"text":"dimension is mapped to (","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/unmappedProperties(in:)","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write, or that Matomo would refuse or store other than it is, is"},{"type":"text","text":" "},{"type":"text","text":"left out of the request, and the batch’s other records are sent: one whose event and version"},{"type":"text","text":" "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name Matomo would empty or cut short, one whose event"},{"type":"text","text":" "},{"type":"text","text":"isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp has no whole seconds"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"Int64"},{"type":"text","text":" or is more than 23 hours before or after the batch is encoded, one with a dimension’s"},{"type":"text","text":" "},{"type":"text","text":"value longer than Matomo keeps, and one whose request is over 1,000,000 bytes"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError","isActive":true},{"type":"text","text":"). "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Each request’s ","type":"text"},{"type":"codeVoice","code":"EncodedRequest\/deadline"},{"text":" is 23 hours after its oldest record was tracked, so","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" drops a request still being retried by then, every record of it, the younger","type":"text"},{"text":" ","type":"text"},{"text":"ones included, and reports it as ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"text":", rather","type":"text"},{"text":" ","type":"text"},{"text":"than send it to a Matomo that would answer 200 and store nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Matomo answers 200 to a bulk request it reads, counting the tracking requests","type":"text"},{"text":" ","type":"text"},{"text":"it refuses as ","type":"text"},{"code":"invalid","type":"codeVoice"},{"text":" in its answer without storing them; 400 to a body it can’t read, which","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops and reports with every record of the request; and 500 when its database","type":"text"},{"text":" ","type":"text"},{"text":"fails, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries. It doesn’t remove duplicates, so a record sent again is","type":"text"},{"text":" ","type":"text"},{"text":"counted again. The bytes are the same for the same records, time and configuration on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder"},"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding"]]},"kind":"symbol","abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"type":"text","text":" of Matomo’s bulk tracking API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to a Matomo installation’s "},{"type":"codeVoice","code":"POST \/matomo.php"},{"type":"text","text":"."}],"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/MatomoEncoding\/s8SendableP","doc:\/\/MatomoEncoding\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"metadata":{"roleHeading":"Structure","symbolKind":"struct","title":"MatomoBatchEncoder","modules":[{"name":"MatomoEncoding"}],"externalID":"s:14MatomoEncoding0A12BatchEncoderV","role":"symbol","navigatorTitle":[{"text":"MatomoBatchEncoder","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MatomoEncoding\/MatomoBatchEncoder.swift#L80","fileName":"MatomoBatchEncoder.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoBatchEncoder","kind":"identifier"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"references":{"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder":{"navigatorTitle":[{"text":"MatomoBatchEncoder","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/matomoencoding\/matomobatchencoder",