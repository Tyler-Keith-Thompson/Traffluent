of the batch’s requests.","type":"text"}],"url":"\/documentation\/matomoencoding\/matomobatchencoder\/failure","type":"topic","title":"MatomoBatchEncoder.Failure","role":"symbol","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/Failure","kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}]},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoEncodingError":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MatomoEncodingError"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MatomoEncodingError"}],"type":"topic","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s requests","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no record of a","type":"text"},{"text":" ","type":"text"},{"text":"batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"title":"MatomoEncodingError","url":"\/documentation\/matomoencoding\/matomoencodingerror","kind":"symbol","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError"},"doc://MatomoEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/MatomoEncoding\/s16SendableMetatypeP","type":"unresolvable"},"doc://Events/documentation/Events/Sensitive":{"type":"topic","title":"Sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"role":"symbol","url":"\/documentation\/events\/sensitive","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/batchLimit":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The limits of one request: 20 tracking requests and 1,000,000 bytes of body, a tracking"},{"type":"text","text":" "},{"type":"text","text":"request’s included."}],"url":"\/documentation\/matomoencoding\/matomobatchencoder\/batchlimit","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","kind":"symbol","title":"batchLimit"},"doc://MatomoEncoding/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/MatomoEncoding\/s8SendableP","title":"Swift.Sendable"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder":{"navigatorTitle":[{"kind":"identifier","text":"MatomoBatchEncoder"}],"type":"topic","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" of Matomo’s bulk tracking API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"se