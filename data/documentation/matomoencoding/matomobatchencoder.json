stination"},{"type":"text","text":" retries for every encoder."}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/transientStatuses","title":"transientStatuses"},"doc://MatomoEncoding/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/MatomoEncoding\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://MatomoEncoding/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/MatomoEncoding\/s8SendableP","title":"Swift.Sendable"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoEncodingError":{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError","navigatorTitle":[{"text":"MatomoEncodingError","kind":"identifier"}],"role":"symbol","kind":"symbol","title":"MatomoEncodingError","type":"topic","abstract":[{"text":"Why ","type":"text"},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","isActive":true},{"text":" couldn’t send a record, which it leaves out of the batch’s requests","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no record of a","type":"text"},{"text":" ","type":"text"},{"text":"batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"url":"\/documentation\/matomoencoding\/matomoencodingerror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoEncodingError","kind":"identifier"}]},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder":{"title":"MatomoBatchEncoder","abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"type":"text","text":" of Matomo’s bulk tracking API, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to a Matomo installation’s "},{"code":"POST \/matomo.php","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/matomoencoding\/matomobatchencoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoBatchEncoder","kind":"identifier"}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","type":"topic","role":"symbol","navigatorTitle":[{"text":"MatomoBatchEncoder","kind":"identifier"}],"kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"url":"\/documentation\/httpdestinations\/httpdestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"type":"topic","navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","title":"HTTPDestination"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/requests(for:)":{"abstract":[{"type":"codeVoice","code":"batch"},{"type":"text","text":" as the bulk requests Matomo takes, each within the encoder’s limit, with the records"},{"type":"text","text":" "},{"type":"text","text":"left out of them."}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"i