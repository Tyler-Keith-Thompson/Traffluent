:"codeVoice","code":"dimensions"},{"type":"text","text":" maps as its custom dimension, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"title":"matomo(url:siteID:dimensions:category:plan:backoff:clock:now:)"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/Failure":{"abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/Failure","title":"MatomoBatchEncoder.Failure","kind":"symbol","url":"\/documentation\/matomoencoding\/matomobatchencoder\/failure","navigatorTitle":[{"kind":"identifier","text":"Failure"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"type":"topic","role":"symbol"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/transientStatuses":{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/transientStatuses","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientStatuses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","text":"TransientStatus"},{"kind":"text","text":">"}],"type":"topic","role":"symbol","url":"\/documentation\/matomoencoding\/matomobatchencoder\/transientstatuses","kind":"symbol","abstract":[{"type":"text","text":"No status beyond the 408, 429 and 5xx that "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" r