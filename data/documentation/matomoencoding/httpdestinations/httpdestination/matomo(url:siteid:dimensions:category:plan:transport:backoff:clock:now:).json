nd":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14MatomoEncoding0A10SetupErrorO","kind":"typeIdentifier","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError","text":"MatomoSetupError"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"preciseIdentifier":"s:14MatomoEncoding0A12BatchEncoderV","kind":"typeIdentifier","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","text":"MatomoBatchEncoder"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The URL Matomo is installed at ("},{"type":"codeVoice","code":"https:\/\/analytics.example.com"},{"type":"text","text":"), a path included"},{"type":"text","text":" "},{"type":"text","text":"where it is served under one ("},{"type":"codeVoice","code":"https:\/\/example.com\/matomo\/"},{"type":"text","text":"). Not the endpoint: the"},{"type":"text","text":" "},{"type":"text","text":"destination appends "},{"type":"codeVoice","code":"matomo.php"},{"type":"text","text":" itself."}]}],"name":"url"},{"content":[{"inlineContent":[{"type":"text","text":"The site’s ID in Matomo, from its Websites settings."}],"type":"paragraph"}],"name":"siteID"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The custom dimension each property is sent as, by the property’s name, as"},{"type":"text","text":" "},{"type":"text","text":"made in Matomo’s Custom Dimensions settings; a property it doesn’t name is never sent."}]}],"name":"dimensions"},{"content":[{"inlineContent":[{"type":"text","text":"Every event’s category, "},{"code":"e_c","type":"codeVoice"},{"type":"text","text":", such as the app’s name. Each event’s action,"},{"type":"text","text":" "},{"code":"e_a","type":"codeVoice"},{"type":"text","text":", is its name."}],"type":"paragraph"}],"name":"category"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}]}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}],"name":"transport"},{"content":[{"inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, with full jitter, by default.","type":"text"}],"type":"paragraph"}],"name":"backoff"},{"content":[{"inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}],"type":"paragraph"}],"name":"clock"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,","type":"text"},{"text":" ","type":"text"},{"text":"and each request’s deadline is checked against before it is sent; the system’s clock by","type":"text"},{"text":" ","type":"text"},{"text":"default. When it reads NaN or infinite, every record is left out.","type":"text"}]}],"name":"now"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"The destination posts bulk tracking requests to the installation’s ","type":"text"},{"code":"matomo.php","type":"codeVoice"},{"text":", encoded by","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","type":"reference"},{"text":" within ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","type":"reference"},{"text":", and sends no trace context","type":"text"},{"text":" ","type":"text"},{"text":"in its header fields. It retries no response, a 5xx, 408 or 429, and drops and reports any","type":"text"},{"text":" ","type":"text"},{"text":"other status, such as 400 for a body Matomo can’t read.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The destination sends no "},{"type":"codeVoice","code":"token_auth"},{"type":"text","text":", and takes none: a token is a secret, and any secret"},{"type":"text","text":" "},{"type":"text","text":"an app holds is public. Matomo takes events from anyone who can reach it, so the destination"},{"type":"text","text":" "},{"type":"text","text":"builds on every platform. Without a token, Matomo takes no event tracked more than a day"},{"type":"text","text":" "},{"type":"text","text":"before it arrives, so the encoder leaves out a record tracked more than 23 hours before it"},{"type":"text","text":" "},{"type":"text","text":"is encoded ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError\/timestampOutsideWindow"},{"type":"text","text":"). A request is encoded once and"},{"type":"text","text":" "},{"type":"text","text":"retried as it is, so one still undelivered 23 hours after its oldest record was tracked, by"},{"type":"text","text":" "},{"type":"text","text":"the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":", rather than reach Matomo too late to"},{"type":"text","text":" "},{"type":"text","text":"be stored."}],"type":"paragraph"},{"name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidURL"},{"type":"text","text":" for a URL that isn’t "},{"type":"codeVoice","code":"https"},{"type":"text","text":", has no host name,"},{"type":"text","text":" "},{"type":"text","text":"has a user name or password, a query or fragment, or a path ending in a "},{"type":"codeVoice","code":".php"},{"type":"text","text":" file, in"},{"type":"text","text":" "},{"type":"text","text":"any case; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidSiteID"},{"type":"text","text":" for a site ID below 1;"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidCategory"},{"type":"text","text":" for a category Matomo would empty or cut short; and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidDimension(property:dimension:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/duplicateProperty(_:)"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/unknownProperty(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/sensitiveProperty(event:version:property:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentatio