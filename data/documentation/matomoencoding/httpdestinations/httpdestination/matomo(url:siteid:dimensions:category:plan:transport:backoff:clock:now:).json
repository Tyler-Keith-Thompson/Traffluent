imestampOutsideWindow","isActive":true,"type":"reference"},{"text":"). A request is encoded once and","type":"text"},{"text":" ","type":"text"},{"text":"retried as it is, so one still undelivered 23 hours after its oldest record was tracked, by","type":"text"},{"text":" ","type":"text"},{"text":"the time ","type":"text"},{"type":"codeVoice","code":"now"},{"text":" gives, isn’t sent again: it is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"text":", rather than reach Matomo too late to","type":"text"},{"text":" ","type":"text"},{"text":"be stored.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidURL","isActive":true,"type":"reference"},{"text":" for a URL that isn’t ","type":"text"},{"code":"https","type":"codeVoice"},{"text":", has no host name,","type":"text"},{"text":" ","type":"text"},{"text":"has a user name or password, a query or fragment, or a path ending in a ","type":"text"},{"code":".php","type":"codeVoice"},{"text":" file, in","type":"text"},{"text":" ","type":"text"},{"text":"any case; ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidSiteID","isActive":true,"type":"reference"},{"text":" for a site ID below 1;","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidCategory","isActive":true,"type":"reference"},{"text":" for a category Matomo would empty or cut short; and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidDimension(property:dimension:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Matom