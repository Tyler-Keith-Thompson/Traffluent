dentifier","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","text":"MatomoBatchEncoder"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The URL Matomo is installed at (","type":"text"},{"code":"https:\/\/analytics.example.com","type":"codeVoice"},{"text":"), a path included","type":"text"},{"text":" ","type":"text"},{"text":"where it is served under one (","type":"text"},{"code":"https:\/\/example.com\/matomo\/","type":"codeVoice"},{"text":"). Not the endpoint: the","type":"text"},{"text":" ","type":"text"},{"text":"destination appends ","type":"text"},{"code":"matomo.php","type":"codeVoice"},{"text":" itself.","type":"text"}],"type":"paragraph"}],"name":"url"},{"content":[{"inlineContent":[{"type":"text","text":"The site’s ID in Matomo, from its Websites settings."}],"type":"paragraph"}],"name":"siteID"},{"content":[{"inlineContent":[{"type":"text","text":"The custom dimension each property is sent as, by the property’s name, as"},{"type":"text","text":" "},{"type":"text","text":"made in Matomo’s Custom Dimensions settings; a property it doesn’t name is never sent."}],"type":"paragraph"}],"name":"dimensions"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Every event’s category, ","type":"text"},{"type":"codeVoice","code":"e_c"},{"text":", such as the app’s name. Each event’s action,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"e_a"},{"text":", is its name.","type":"text"}]}],"name":"category"},{"content":[{"inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}],"type":"paragraph"}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}],"name":"transport"},{"content":[{"inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, by default.","type":"text"}],"type":"paragraph"}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}],"name":"clock"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from;","type":"text"},{"text":" ","type":"text"},{"text":"the system’s clock by default. When it reads NaN or infinite, every record is left out.","type":"text"}]}],"name":"now"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The destination.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The destination posts bulk tracking requests to the installation’s "},{"type":"codeVoice","code":"matomo.php"},{"type":"text","text":", encoded by"},{"type":"text","text":" "},{"type":"text","text":"a "},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","type":"reference","isActive":true},{"type":"text","text":" within "},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","type":"reference","isActive":true},{"type":"text","text":", and sends no trace context"},{"type":"text","text":" "},{"type":"text","text":"in its header fields. It retries no response, a 5xx, 408 or 429, and drops and reports any"},{"type":"text","text":" "},{"type":"text","text":"other status, such as 400 for a body Matomo can’t read."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The destination sends no "},{"type":"codeVoice","code":"token_auth"},{"type":"text","text":", and takes none: a token is a secret, and any secret"},{"type":"text","text":" "},{"type":"text","text":"an app holds is public. Matomo takes events from anyone who can reach it, so the destination"},{"type":"text","text":" "},{"type":"text","text":"builds on every platform. Without a token, Matomo takes no event tracked more than a day"},{"type":"text","text":" "},{"type":"text","text":"before it arrives, so the encoder leaves out a record tracked more than 23 hours before it"},{"type":"text","text":" "},{"type":"text","text":"is encoded ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError\/timestampOutsideWindow"},{"type":"text","text":"). A request is encoded once and"},{"type":"text","text":" "},{"type":"text","text":"retried as it is, so one still being retried when its oldest record is a day old is"},{"type":"text","text":" "},{"type":"text","text":"answered 200 by Matomo and lost without a report."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidURL"},{"type":"text","text":" for a URL that isn’t "},{"code":"https","type":"codeVoice"},{"type":"text","text":", has no host name,"},{"type":"text","text":" "},{"type":"text","text":"has a user name or password, a query or fragment, or a path ending in a "},{"code":".php","type":"codeVoice"},{"type":"text","text":" file, in"},{"type":"text","text":" "},{"type":"text","text":"any case; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidSiteID"},{"type":"text","text":" for a site ID below 1;"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidCategory"},{"type":"text","text":" for a category Matomo would empty or cut short; and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation