nd":"text","text":" "},{"preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier","text":"Clock"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError","preciseIdentifier":"s:14MatomoEncoding0A10SetupErrorO","kind":"typeIdentifier","text":"MatomoSetupError"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","preciseIdentifier":"s:14MatomoEncoding0A12BatchEncoderV","kind":"typeIdentifier","text":"MatomoBatchEncoder"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"url","content":[{"inlineContent":[{"text":"The URL Matomo is installed at (","type":"text"},{"type":"codeVoice","code":"https:\/\/analytics.example.com"},{"text":"), a path included","type":"text"},{"text":" ","type":"text"},{"text":"where it is served under one (","type":"text"},{"type":"codeVoice","code":"https:\/\/example.com\/matomo\/"},{"text":"). Not the endpoint: the","type":"text"},{"text":" ","type":"text"},{"text":"destination appends ","type":"text"},{"type":"codeVoice","code":"matomo.php"},{"text":" itself.","type":"text"}],"type":"paragraph"}]},{"name":"siteID","content":[{"inlineContent":[{"text":"The site’s ID in Matomo, from its Websites settings.","type":"text"}],"type":"paragraph"}]},{"name":"dimensions","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The custom dimension each property is sent as, by the property’s name, as"},{"type":"text","text":" "},{"type":"text","text":"made in Matomo’s Custom Dimensions settings; a property it doesn’t name is never sent."}]}]},{"name":"category","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every event’s category, "},{"type":"codeVoice","code":"e_c"},{"type":"text","text":", such as the app’s name. Each event’s action,"},{"type":"text","text":" "},{"type":"codeVoice","code":"e_a"},{"type":"text","text":", is its name."}]}]},{"name":"plan","content":[{"inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}],"type":"paragraph"}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}]},{"name":"backoff","content":[{"inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, with full jitter, by default.","type":"text"}],"type":"paragraph"}]},{"name":"clock","content":[{"inlineContent":[{"type":"text","text":"The clock the waits are measured on."}],"type":"paragraph"}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,"},{"type":"text","text":" "},{"type":"text","text":"and each request’s deadline is checked against before it is sent; the system’s clock by"},{"type":"text","text":" "},{"type":"text","text":"default. When it reads NaN or infinite, every record is left out."}]}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The destination posts bulk tracking requests to the installation’s ","type":"text"},{"type":"codeVoice","code":"matomo.php"},{"text":", encoded by","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder"},{"text":" within ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit"},{"text":", and sends no trace context","type":"text"},{"text":" ","type":"text"},{"text":"in its header fields. It retries no response, a 5xx, 408 or 429, and drops and reports any","type":"text"},{"text":" ","type":"text"},{"text":"other status, such as 400 for a body Matomo can’t read.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The destination sends no "},{"type":"codeVoice","code":"token_auth"},{"type":"text","text":", and takes none: a token is a secret, and any secret"},{"type":"text","text":" "},{"type":"text","text":"an app holds is public. Matomo takes events from anyone who can reach it, so the destination"},{"type":"text","text":" "},{"type":"text","text":"builds on every platform. Without a token, Matomo takes no event tracked more than a day"},{"type":"text","text":" "},{"type":"text","text":"before it arrives, so the encoder leaves out a record tracked more than 23 hours before it"},{"type":"text","text":" "},{"type":"text","text":"is encoded ("},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError\/timestampOutsideWindow","type":"reference","isActive":true},{"type":"text","text":"). A request is encoded once and"},{"type":"text","text":" "},{"type":"text","text":"retried as it is, so one still undelivered 23 hours after its oldest record was tracked, by"},{"type":"text","text":" "},{"type":"text","text":"the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":", rather than reach Matomo too late to"},{"type":"text","text":" "},{"type":"text","text":"be stored."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidURL","isActive":true},{"type":"text","text":" for a URL that isn’t "},{"type":"codeVoice","code":"https"},{"type":"text","text":", has no host name,"},{"type":"text","text":" "},{"type":"text","text":"has a user name or password, a query or fragment, or a path ending in a "},{"type":"codeVoice","code":".php"},{"type":"text","text":" file, in"},{"type":"text","text":" "},{"type":"text","text":"any case; "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidSiteID","isActive":true},{"type":"text","text":" for a site ID below 1;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidCategory","isActive":true},{"type":"text","text":" for a category Matomo would empty or cut short; and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidDimension(property:dimension:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/duplicateProperty(_:)","isActive":true},{"type":"text","text":", "},{"