"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","text":"MatomoBatchEncoder","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The URL Matomo is installed at (","type":"text"},{"type":"codeVoice","code":"https:\/\/analytics.example.com"},{"text":"), a path included","type":"text"},{"text":" ","type":"text"},{"text":"where it is served under one (","type":"text"},{"type":"codeVoice","code":"https:\/\/example.com\/matomo\/"},{"text":"). Not the endpoint: the","type":"text"},{"text":" ","type":"text"},{"text":"destination appends ","type":"text"},{"type":"codeVoice","code":"matomo.php"},{"text":" itself.","type":"text"}],"type":"paragraph"}],"name":"url"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The site’s ID in Matomo, from its Websites settings."}]}],"name":"siteID"},{"content":[{"inlineContent":[{"type":"text","text":"The custom dimension each property is sent as, by the property’s name, as"},{"type":"text","text":" "},{"type":"text","text":"made in Matomo’s Custom Dimensions settings; a property it doesn’t name is never sent."}],"type":"paragraph"}],"name":"dimensions"},{"content":[{"inlineContent":[{"text":"Every event’s category, ","type":"text"},{"type":"codeVoice","code":"e_c"},{"text":", such as the app’s name. Each event’s action,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"e_a"},{"text":", is its name.","type":"text"}],"type":"paragraph"}],"name":"category"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}]}],"name":"plan"},{"content":[{"inlineContent":[{"type":"text","text":"What sends each request."}],"type":"paragraph"}],"name":"transport"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 