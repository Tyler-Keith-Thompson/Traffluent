text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":" = ExponentialBackoff(), ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":"> = ContinuousClock(), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":" = { Date.now }) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"MatomoSetupError","kind":"typeIdentifier","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError","preciseIdentifier":"s:14MatomoEncoding0A10SetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"MatomoBatchEncoder","kind":"typeIdentifier","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","preciseIdentifier":"s:14MatomoEncoding0A12BatchEncoderV"},{"text":">","kind":"text"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The URL Matomo is installed at ("},{"type":"codeVoice","code":"https:\/\/analytics.example.com"},{"type":"text","text":"), a path included"},{"type":"text","text":" "},{"type":"text","text":"where it is served under one ("},{"type":"codeVoice","code":"https:\/\/example.com\/matomo\/"},{"type":"text","text":"). Not the endpoint: the"},{"type":"text","text":" "},{"type":"text","text":"destination appends "},{"type":"codeVoice","code":"matomo.php"},{"type":"text","text":" itself."}],"type":"paragraph"}],"name":"url"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The site’s ID in Matomo, from its Websites settings.","type":"text"}]}],"name":"siteID"},{"content":[{"inlineContent":[{"text":"The custom dimension each property is sent as, by the property’s name, as","type":"text"},{"text":" ","type":"text"},{"text":"made in Matomo’s Custom Dimensions settings; a property it doesn’t name is never sent.","type":"text"}],"type":"paragraph"}],"name":"dimensions"},{"content":[{"inlineContent":[{"text":"Every event’s category, ","type":"text"},{"code":"e_c","type":"codeVoice"},{"text":", such as the app’s name. Each event’s action,","type":"text"},{"text":" ","type":"text"},{"code":"e_a","type":"codeVoice"},{"text":", is its name.","type":"text"}],"type":"paragraph"}],"name":"category"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}],"name":"transport"},{"content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, by default."}],"type":"paragraph"}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}],"name":"clock"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,","type":"text"},{"text":" ","type":"text"},{"text":"and each request’s deadline is checked against before it is sent; the system’s clock by","type":"text"},{"text":" ","type":"text"},{"text":"default. When it reads NaN or infinite, every record is left out.","type":"text"}]}],"name":"now"}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination posts bulk tracking requests to the installation’s "},{"type":"codeVoice","code":"matomo.php"},{"type":"text","text":", encoded by"},{"type":"text","text":" "},{"type":"text","text":"a "},{"isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","type":"reference"},{"type":"text","text":" within "},{"isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","type":"reference"},{"type":"text","text":", and sends no trace context"},{"type":"text","text":" "},{"type":"text","text":"in its header fields. It retries no response, a 5xx, 408 or 429, and drops and reports any"},{"type":"text","text":" "},{"type":"text","text":"other status, such as 400 for a body Matomo can’t read."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination sends no "},{"type":"codeVoice","code":"token_auth"},{"type":"text","text":", and takes none: a token is a secret, and any secret"},{"type":"text","text":" "},{"type":"text","text":"an app holds is public. Matomo takes events from anyone who can reach it, so the destination"},{"type":"text","text":" "},{"type":"text","text":"builds on every platform. Without a token, Matomo takes no event tracked more than a day"},{"type":"text","text":" "},{"type":"text","text":"before it arrives, so the encoder leaves out a record tracked more than 23 hours before it"},{"type":"text","text":" "},{"type":"text","text":"is encoded ("},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError\/timestampOutsideWindow","isActive":true},{"type":"text","text":"). A request is encoded once and"},{"type":"text","text":" "},{"type":"text","text":"retried as it is, so one still undelivered 23 hours after its oldest record was tracked, by"},{"type":"text","text":" "},{"type":"text","text":"the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":", rather than reach Matomo too late to"},{"type":"text","text":" "},{"type":"text","text":"be stored."}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidURL","isActive":true},{"type":"text","text":" for a URL that isn’t "},{"type":"codeVoice","code":"https"},{"type":"text","text":", has no host name,"},{"type":"text","text":" "},{"type":"text","text":"has a user name or password, a query or fragment, or a path ending in a "},{"type":"codeVoice","code":".php"},{"type":"text","text":" file, in"},{"type":"text","text":" "},{"type":"text","text":"any case; "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidSiteID","isActive":true},{"type":"text","text":" for a site ID below 1;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidCategory","isActive":true},{"type":"text","text":" for a category Matomo would empty or cut short; and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidDimension(property:dimension:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/duplicateProperty(_:)","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/unknownProperty(_:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/sensitiveProperty(event:version:property:)","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/sharedDimension(event:version:dimension:)","isActive":true},{"type":"text","text":" for a mapping that breaks a"},{"type":"text","text":" "},{"type":"text","text":"rule against "},{"type":"codeVoice","code":"plan"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Throws"}]}],"abstract":[{"type":"text","text":"A destination that sends batches to the site "},{"code":"siteID","type":"codeVoice"},{"type":"text","text":" of the Matomo installation at "},{"code":"url","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"each event in "},{"code":"category","type":"codeVoice"},{"type":"text","text":" and each property "},{"code":"dimensions","type":"codeVoice"},{"type":"text","text":" maps as its custom dimension,"},{"type":"text","text":" "},{"type":"text","text":"through "},{"code":"transport","type":"codeVoice"},{"type":"text","text":", retrying a send that fails for now with the waits of "},{"code":"backoff","type":"codeVoice"}