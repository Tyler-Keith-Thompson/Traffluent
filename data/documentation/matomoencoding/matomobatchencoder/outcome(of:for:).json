eIdentifier":"s:9HTTPTypes12HTTPResponseV6StatusV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"reason","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"recordIDs","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"UUID","preciseIdentifier":"s:20FoundationEssentials4UUIDV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"kind":"symbol","url":"\/documentation\/httpdestinations\/httpdropreport\/rejectedinbody(status:reason:recordids:)","abstract":[{"type":"text","text":"The endpoint answered with "},{"type":"codeVoice","code":"status"},{"type":"text","text":", a 2xx, but the answer’s body says the vendor stored"},{"type":"text","text":" "},{"type":"text","text":"none of the records and won’t if they are sent again ("},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"returned "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)","isActive":true},{"type":"text","text":"), for "},{"type":"codeVoice","code":"reason"},{"type":"text","text":", so the batch of the records"},{"type":"text","text":" "},{"type":"text","text":"identified by "},{"type":"codeVoice","code":"recordIDs"},{"type":"text","text":", oldest first, was dropped. Mixpanel’s track API, answering 200"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"type":"text","text":", is one such vendor."}],"title":"HTTPDropReport.rejectedInBody(status:reason:recordIDs:)","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/ResponseOutcome/transient(reason:)":{"kind":"symbol","title":"ResponseOutcome.transient(reason:)","identifier":"doc:\/\/HTTPDestinations\/documentation\/