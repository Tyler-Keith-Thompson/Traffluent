":"reference"},{"type":"text","text":" and the network."}],"type":"topic","navigatorTitle":[{"text":"HTTPTransport","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPTransport","kind":"identifier"}],"url":"\/documentation\/httpdestinations\/httptransport","title":"HTTPTransport"},"doc://HTTPDestinations/documentation/HTTPDestinations/ResponseOutcome/rejected(reason:)":{"abstract":[{"type":"text","text":"The vendor stored none of the request’s records, and wouldn’t if it were sent again, for"},{"type":"text","text":" "},{"type":"codeVoice","code":"reason"},{"type":"text","text":", the vendor’s own words where its body has them: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" drops the"},{"type":"text","text":" "},{"type":"text","text":"request and reports it as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","url":"\/documentation\/httpdestinations\/responseoutcome\/rejected(reason:)","title":"ResponseOutcome.rejected(reason:)","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejected"},{"kind":"text","text":"("},{"kind":"externalParam","text":"reason"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":")"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport/rejectedInBody(status:reason:recordIDs:)":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)","role":"symbol","kind":"symbol","