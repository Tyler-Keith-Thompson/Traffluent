ns\/ResponseOutcome\/transient(reason:)","isActive":true,"type":"reference"},{"text":":","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends the request again until its deadline, 23 hours after its oldest","type":"text"},{"text":" ","type":"text"},{"text":"record, and Matomo, which removes no duplicates, counts the ones it tracked again. When it","type":"text"},{"text":" ","type":"text"},{"text":"tracked none and refused some, as for a site ID of no site, the answer is","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)","isActive":true,"type":"reference"},{"text":", so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops the","type":"text"},{"text":" ","type":"text"},{"text":"request and reports it. When it tracked some and refused others, the answer says how many","type":"text"},{"text":" ","type":"text"},{"text":"but not which, so the request is delivered, with a notice logged. A body that isn’t such an","type":"text"},{"text":" ","type":"text"},{"text":"answer, an empty one or one with a negative count included, is delivered.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/matomoencoding\/matomobatchencoder\/outcome(of:for:)"]}],"sections":[],"abstract":[{"type":"text","text":"What Matomo’s 2xx answer to "},{"type":"codeVoice","code":"request"},{"type":"text","text":" means: transient when Matomo counted fewer of its"},{"type":"text","text":" "},{"type":"text","text":"tracking requests than were sent, rejected when it refused every one it counted, and"},{"type":"text","text":" "},{"type":"text","text":"delivered otherwise."}],"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder"]]},"schemaVersion":{"major":0,"patch":0,