","text":"but not which, so the request is delivered, with a notice logged. A body that isn’t such an"},{"type":"text","text":" "},{"type":"text","text":"answer, an empty one or one with a negative count included, is delivered."}],"type":"paragraph"}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/matomoencoding\/matomobatchencoder\/outcome(of:for:)"]}],"metadata":{"title":"outcome(of:for:)","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MatomoEncoding\/MatomoBatchEncoder.swift#L116","fileName":"MatomoBatchEncoder.swift"},"modules":[{"name":"MatomoEncoding"}],"symbolKind":"method","role":"symbol","roleHeading":"Type Method","externalID":"s:14MatomoEncoding0A12BatchEncoderV7outcome2of3for16HTTPDestinations15ResponseOutcomeOAG013HTTPTransportI0V_AG14EncodedRequestVtFZ","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","text":"HTTPTransportResponse"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","text":"EncodedRequest"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","text":"ResponseOutcome"}]},"abstract":[{"text":"What Matomo’s 2xx answer to ","type":"text"},{"code":"request","type":"codeVoice"},{"text":" means: transient when Matomo counted fewer of its","type":"text"},{"text":" ","type":"text"},{"text":"tracking requests than were sent, rejected when it refused every one it counted, and","type":"text"},{"text":" ","type":"text"},{"text":"delivered otherwise.","type