{"abstract":[{"text":"Logs a notice the first time Matomo gives this encoder’s destination a 2xx answer that","type":"text"},{"text":" ","type":"text"},{"text":"isn’t a bulk answer with tracking counts, as a server with the QueuedTracking plugin’s","type":"text"},{"text":" ","type":"text"},{"text":"queue on answers every bulk request.","type":"text"}],"variants":[{"paths":["\/documentation\/matomoencoding\/matomobatchencoder\/didreceive(_:for:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"didReceive"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"response"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","kind":"typeIdentifier","text":"HTTPTransportResponse","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":" "},{"kind":"internalParam","text":"request"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","kind":"typeIdentifier","text":"EncodedRequest","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest"},{"kind":"text","text":")"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"response","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The 2xx answer."}]}]},{"name":"request","content":[{"inlineContent":[{"text":"The request it answers.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The notice says that tracking requests the server refuses won’t be reported. It is a hint,"},{"type":