{"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoDimensions","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Matomo numbers the custom dimensions of a site as they are made, in its settings (Administration,"},{"type":"text","text":" "},{"type":"text","text":"Websites, Custom Dimensions), and reads a request’s "},{"code":"dimension3","type":"codeVoice"},{"type":"text","text":" as the value of dimension 3, so"},{"type":"text","text":" "},{"type":"text","text":"the mapping comes from the app:"}]},{"syntax":"swift","code":["let dimensions: MatomoDimensions = [\"plan\": 1, \"seats\": 2]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A property is mapped by its name, the same in every event of the plan that has it. A property"},{"type":"text","text":" "},{"type":"text","text":"no mapping names is never sent, and "},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/unmappedProperties(in:)","type":"reference","isActive":true},{"type":"text","text":" lists those of a plan, which"},{"type":"text","text":" "},{"type":"text","text":"the encoder logs once when it is made."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A literal doesn’t check anything, so it can’t fail: the destination’s factory checks the"},{"type":"text","text":" "},{"type":"text","text":"mapping against the plan, and throws "},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError","type":"reference","isActive":true},{"type":"text","text":" for a dimension ID below 1, a"},{"type":"text","text":" "},{"type":"text","text":"property mapped twice, a property no event of the plan has, a property that is "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"an event, and two properties of one event mapped to one dimension."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/matomoencoding\/matomodimensions"]}],"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding"]]},"metadata":{"modules":[{"name":"MatomoEncoding"}],"title":"MatomoDimensions","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoDimensions","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MatomoDimensions"}],"symbolKind":"struct","roleHeading":"Structure","role":"symbol","externalID":"s:14MatomoEncoding0A10DimensionsV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MatomoEncoding\/MatomoDimensions.swift#L25","fileName":"MatomoDimensions.swift"}},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/MatomoEncoding\/s30ExpressibleByDictionaryLiteralP","doc:\/\/MatomoEncoding\/s8SendableP","doc:\/\/MatomoEncoding\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships"}],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/init(_:)","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/init(dictionaryLiteral:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/unmappedProperties(in:)"],"title":"Instance Methods","generated":true}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"seeAlsoSections":[{"anchor":"Custom-dimensions","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoUnmappedProperty"],"title":"Custom dimensions","generated":true}],"abstract":[{"text":"Which of Matomo’s custom dimensions each property o