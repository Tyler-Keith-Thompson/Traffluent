{"variants":[{"paths":["\/documentation\/trackers"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker"},{"type":"text","text":" is a value. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)"},{"type":"text","text":" only queues the"},{"type":"text","text":" "},{"type":"text","text":"event, from any thread. A worker the tracker owns, never on the main actor, does the rest in the"},{"type":"text","text":" "},{"type":"text","text":"order events were tracked: it makes the event’s "},{"code":"EventRecord","type":"codeVoice"},{"type":"text","text":", checks its constraints, runs the"},{"type":"text","text":" "},{"type":"text","text":"enrichers ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher"},{"type":"text","text":") on the context it was tracked in, applies the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"type":"text","text":"s and"},{"type":"text","text":" "},{"type":"text","text":"the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},{"type":"text","text":", writes the record to the tracker’s store if it has one, and publishes it to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":"."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()"},{"type":"text","text":" waits for the worker to catch up; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()"},{"type":"text","text":" does too, then ends the"},{"type":"text","text":" "},{"type":"text","text":"records."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Build one tracker where the app starts. Pass it down, or bind it to a task with"},{"type":"text","text":" "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/withTracker(_:_:)-7fax9","type":"reference","isActive":true},{"type":"text","text":" and read it anywhere inside with "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","type":"reference","isActive":true},{"type":"text","text":". With nothing"},{"type":"text","text":" "},{"type":"text","text":"bound, as in a detached task, it drops every event like "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","type":"reference","isActive":true},{"type":"text","text":" and logs a warning for"},{"type":"text","text":" "},{"type":"text","text":"the first one at each call site, so hand such a task a tracker value. "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"gives a copy that adds to the context of the events tracked through it alone, for code a"},{"type":"text","text":" "},{"type":"text","text":"task-local context doesn’t reach. To enrich only what one destination receives, apply"},{"type":"text","text":" "},{"type":"codeVoice","code":"enriched(by:)"},{"type":"text","text":" to that destination instead (module "},{"type":"codeVoice","code":"Destinations"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tracker reports every event it drops: one that breaks a declared constraint on"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","isActive":true},{"type":"text","text":", one a sampler leaves out on "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","isActive":true},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"text","text":"record a consent drops on "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Delivering a tracker’s records to destinations is "},{"type":"codeVoice","code":"batch()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"deliver(to:)"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Destinations"},{"type":"text","text":" module, and keeping them on disk is a "},{"type":"codeVoice","code":"RecordStore"},{"type":"text","text":" from "},{"type":"codeVoice","code":"Persistence"},{"type":"text","text":". For a"},{"type":"text","text":" "},{"type":"text","text":"test that checks what its code tracked, "},{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" in "},{"type":"codeVoice","code":"TrackerTesting"},{"type":"text","text":" does the setup."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["enum ExperimentKey: ServiceContextKey {","    typealias Value = String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(","    consent: consent,","    enrichers: [Enricher { $0[ExperimentKey.self] = \"new-checkout\" }]",")","withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","for await record in tracker.records {","    print(record.name, record.context[ExperimentKey.self] ?? \"none\")  \/\/ SignedUp new-checkout","}"]},{"inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/doc