:"codeVoice","code":"vendor"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"one file per event and version: the newest Iglu version of each in ","type":"text"},{"type":"codeVoice","code":"committed"},{"text":" while it","type":"text"},{"text":" ","type":"text"},{"text":"still describes the event, or the one to publish next.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"igluFiles"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vendor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"registry"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"IgluRegistry","preciseIdentifier":"s:13TrackingPlans12IgluRegistryO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"carryingForward"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"File","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"IgluExportError","preciseIdentifier":"s:13TrackingPlans15IgluExportErrorO"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"File","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"kind":"text","text":"]"}],"url":"\/documentation\/trackingplans\/trackingplan\/iglufiles(vendor:registry:carryingforward:)","title":"igluFiles(vendor:registry:carryingForward:)","kind":"symbol","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/igluFiles(vendor:registry:carryingForward:)","type":"topic","role":"symbol"},"doc://TrackingPlans/documentati