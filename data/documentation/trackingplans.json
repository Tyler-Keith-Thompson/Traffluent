":"EventSchema"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventSchema"}],"type":"topic"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/files(carryingForward:)":{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","url":"\/documentation\/trackingplans\/trackingplan\/files(carryingforward:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"files","kind":"identifier"},{"text":"(","kind":"text"},{"text":"carryingForward","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV","text":"File","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV","text":"File","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The plan’s files, as "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files","isActive":true},{"type":"text","text":" lists them, with each event’s document keeping the"},{"type":"text","text":" "},{"type":"text","text":"properties its document in "},{"type":"codeVoice","code":"committed"},{"type":"text","text":", at the same name and version, has that the event"},{"type":"text","text":" "},{"type":"text","text":"no longer declares: each with its schema there, marked "},{"type":"codeVoice","code":"deprecated: true"},{"type":"text","text":". The documents in"},{"type":"text","text":" "},{"type":"codeVoice","code":"committed"},{"type":"text","text":" of an event’s earlier versions, below the newest the plan lists, are kept too,"},{"type":"text","text":" "},{"type":"