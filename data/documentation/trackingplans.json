{"type":"text","text":"."}],"type":"topic","title":"files","kind":"symbol","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/write(to:)":{"kind":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/write(to:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"write"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials10CocoaErrorV","text":"CocoaError"},{"kind":"text","text":")"}],"title":"write(to:)","role":"symbol","abstract":[{"type":"text","text":"Writes the plan’s files into "},{"code":"directory","type":"codeVoice"},{"type":"text","text":", creating it if needed, and deletes the"},{"type":"text","text":" "},{"code":".schema.json","type":"codeVoice"},{"type":"text","text":" and "},{"code":".example.json","type":"codeVoice"},{"type":"text","text":" files there that the plan doesn’t hold, the documents and"},{"type":"text","text":" "},{"type":"text","text":"examples of events it no longer has."}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","type":"topic"}}}