text":"An executable that writes a tracking plan: the type marked ","type":"text"},{"type":"codeVoice","code":"@main"},{"text":" in a target of the app’s","type":"text"},{"text":" ","type":"text"},{"text":"package that links the modules declaring its events.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrackingPlanCommand"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand","title":"TrackingPlanCommand","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TrackingPlanCommand"}],"type":"topic"},"doc://TrackingPlans/documentation/TrackingPlans":{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","title":"TrackingPlans","url":"\/documentation\/trackingplans","abstract":[{"type":"text","text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it."}],"type":"topic","kind":"symbol","role":"collection"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan":{"type":"topic","role":"symbol","url":"\/documentation\/trackingplans\/trackingplan","abstract":[{"text":"The JSON Schema (draft 2020-12) of every event an app tracks: one document per event and an","type":"text"},{"text":" ","type":"text"},{"text":"index, exported from the events’ ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"text":" values.","type":"text"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","kind":"symbol","navigatorTitle":[{"text":"TrackingPlan","kind":"identifier"}],"title":"TrackingPlan","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlan","kind":"identifier"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(against:)":{"url":"\/documentation\/trackingplans\/track