{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackingplans"]}],"abstract":[{"type":"text","text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it."}],"metadata":{"externalID":"TrackingPlans","roleHeading":"Framework","role":"collection","modules":[{"name":"TrackingPlans"}],"title":"TrackingPlans","symbolKind":"module"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracking plan is the contract between an app and whoever reads its events: dashboards, a"},{"type":"text","text":" "},{"type":"text","text":"warehouse, a collector, another platform’s client. Each event’s document gives its version,"},{"type":"text","text":" "},{"type":"text","text":"consent category, properties and their JSON types, which ones every payload holds, and which are"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":", in a form that needs no Swift to read. Committed beside the events, it puts every"},{"type":"text","text":" "},{"type":"text","text":"change to them in the pull request as a JSON diff. Its check says which changes break what has"},{"type":"text","text":" "},{"type":"text","text":"already shipped: payloads from installed app versions that a validating collector would reject,"},{"type":"text","text":" "},{"type":"text","text":"and stored records the app could no longer decode."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","isActive":true},{"type":"text","text":" turns events’ schemas into files: an index, "},{"type":"codeVoice","code":"tracking-plan.json"},{"type":"text","text":", and for each"},{"type":"text","text":" "},{"type":"text","text":"event a JSON Schema (draft 2020-12) document and an example payload. The files are values, so the"},{"type":"text","text":" "},{"type":"text","text":"same schemas give the same bytes on every run and platform, ready to commit for the people and"},{"type":"text","text":" "},{"type":"text","text":"tools outside the app."}]},{"type":"paragraph","inlineContent":[{"text":"Checking compares the plan the events make now with the committed one by what the files mean. The","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCheck","isActive":true,"type":"reference"},{"text":" is a match, a plan that is only out of date, or one with a breaking","type":"text"},{"text":" ","type":"text"},{"text":"difference: a change that, at the same version, would leave a stored record or an","type":"text"},{"text":" ","type":"text"},{"text":"already-released app’s payload unable to decode or validate. Each ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference","isActive":true,"type":"reference"},{"text":" names","type":"text"},{"text":" ","type":"text"},{"text":"the event, the property and the change, and says whether it is breaking.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only code compiled against the app’s event types can read their schemas, so the app writes a small"},{"type":"text","text":" "},{"type":"text","text":"executable of its own: a type that conforms to "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand","isActive":true},{"type":"text","text":", marked "},{"type":"codeVoice","code":"@main"},{"type":"text","text":". It writes"},{"type":"text","text":" "},{"type":"text","text":"the plan to a directory, or checks it with "},{"type":"codeVoice","code":"check"},{"type":"text","text":". To run the check from the app’s tests instead,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"TrackingPlanTesting"},{"type":"text","text":". The schemas usually come from "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"EventMacros"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"text":"The module is a product of its own that ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves out.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import TrackingPlans","import Traffluent","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","}","","let plan = try TrackingPlan(schemas: [SignedUp.schema])","let check = plan.check(against: plan.files)  \/\/ .matches","let paths = plan.files.map(\\.path)","\/\/ [\"tracking-plan.json\", \"signed_up.v1.schema.json\", \"signed_up.v1.example.json\"]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow"},{"type":"text","text":" "},{"type":"text","text":"covers the executable, the command plugins and the test."}]}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/File","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanError"],"anchor":"Making-a-plan","title":"Making a plan"},{"identifiers":["doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand"],"anchor":"Writing-a-plan","title":"Writing a plan"},{"identifiers":["doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCheck","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference"],"anchor":"Checking-a-plan","title":"Checking a plan"}],"references":{"doc://TrackingPlans/documentation/TrackingPlans":{"url":"\/documentation\/trackingplans","title":"TrackingPlans","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","abstract":[{"text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it.","type":"text"}],"type":"topic","role":"collection","kind":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan":{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","url":"\/documentation\/trackingplans\/trackingplan","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlan","kind":"identifier"}],"abstract":[{"type":"text","text":"The JSON Schema (draft 2020-12) of every event an app tracks: one document per event and an"},{"type":"text","text":" "},{"type":"text","text":"index, exported from the events’ "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"type":"text","text":" values."}],"kind":"symbol","role":"symbol","title":"TrackingPlan","type":"topic","navigatorTitle":[{"text":"TrackingPlan","kind":"identifier"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/files":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"files","kind":"identifier"},{"text":": [","kind":"text"},{"t