{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/File","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanError"],"title":"Making a plan","anchor":"Making-a-plan"},{"identifiers":["doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand"],"title":"Writing a plan","anchor":"Writing-a-plan"},{"identifiers":["doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/igluFiles(vendor:registry:carryingForward:)","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/writeIgluRegistry(to:vendor:registry:)","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluRegistry","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError"],"title":"Exporting an Iglu registry","anchor":"Exporting-an-Iglu-registry"},{"identifiers":["doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCheck","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference"],"title":"Checking a plan","anchor":"Checking-a-plan"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackingplans"]}],"hierarchy":{"paths":[[]]},"kind":"symbol","metadata":{"modules":[{"name":"TrackingPlans"}],"externalID":"TrackingPlans","roleHeading":"Framework","role":"collection","title":"TrackingPlans","symbolKind":"module"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A tracking plan is the contract between an app and whoever reads its events: dashboards, a"},{"type":"text","text":" "},{"type":"text","text":"warehouse, a collector, another platform’s client. Each event’s document gives its version,"},{"type":"text","text":" "},{"type":"text","text":"consent category, properties and their JSON types, which ones every payload holds, and which are"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":", in a form that needs no Swift to read. Committed beside the events, it puts every"},{"type":"text","text":" "},{"type":"text","text":"change to them in the pull request as a JSON diff. Its check says which changes break what has"},{"type":"text","text":" "},{"type":"text","text":"already shipped: payloads from installed app versions that a validating collector would reject,"},{"type":"text","text":" "},{"type":"text","text":"and stored records the app could no longer decode."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan"},{"type":"text","text":" turns events’ schemas into files: an index, "},{"type":"codeVoice","code":"tracking-plan.json"},{"type":"text","text":", and for each"},{"type":"text","text":" "},{"type":"text","text":"event a JSON Schema (draft 2020-12) document and an example payload. The files are values, so the"},{"type":"text","text":" "},{"type":"text","text":"same schemas give the same bytes on every run and platform, ready to commit for the people and"},{"type":"text","text":" "},{"type":"text","text":"tools outside the app."}],"type":"paragraph"},{"inlineContent":[{"text":"Checking compares the plan the events make now with the committed one by what the files mean. The","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCheck","isActive":true,"type":"reference"},{"text":" is a match, a plan that is only out of date, or one with a breaking","type":"text"},{"text":" ","type":"text"},{"text":"difference: a change that, at the same version, would leave a stored record or an","type":"text"},{"text":" ","type":"text"},{"text":"already-released app’s payload unable to decode or validate. Each ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference","isActive":true,"type":"reference"},{"text":" names","type":"text"},{"text":" ","type":"text"},{"text":"the event, the property and the change, and says whether it is breaking.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only code compiled against the app’s event types can read their schemas, so the app writes a small"},{"type":"text","text":" "},{"type":"text","text":"executable of its own: a type that conforms to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand"},{"type":"text","text":", marked "},{"code":"@main","type":"codeVoice"},{"type":"text","text":". It writes"},{"type":"text","text":" "},{"type":"text","text":"the plan to a directory, or checks it with "},{"code":"check","type":"codeVoice"},{"type":"text","text":". To run the check from the app’s tests instead,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"code":"TrackingPlanTesting","type":"codeVoice"},{"type":"text","text":". The schemas usually come from "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" (module "},{"code":"EventMacros","type":"codeVoice"},{"type":"text","text":"):"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/init()"},{"type":"text","text":" takes every "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" in the program and the library’s own events, found at"},{"type":"text","text":" "},{"type":"text","text":"run time, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/init(schemas:)"},{"type":"text","text":" takes a list."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The module is a product of its own that "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" leaves out."}],"type":"paragraph"},{"code":["import TrackingPlans","import Traffluent","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","}","","let plan = try TrackingPlan()  \/\/ every @Event in the program, and the library's own","let check = plan.check(against: plan.files)  \/\/ .matches","let paths = plan.files.map(\\.path)","\/\/ [\"tracking-plan.json\", ..., \"signed_up.v1.schema.json\", \"signed_up.v1.example.json\"]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The plan also writes the schemas of an Iglu registry, which a Snowplow pipeline validates events","type":"text"},{"text":" ","type":"text"},{"text":"against (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/igluFiles(vendor:registry:carryingForward:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/writeIgluRegistry(to:vendor:registry:)"},{"text":"). Version N of an event is SchemaVer","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":". For Iglu Server, a compatible change at the same version is the next addition, ","type":"text"},{"type":"codeVoice","code":"N-0-1"},{"text":" ","type":"text"},{"text":"and on, superseding the earlier ones; a static repository doesn’t supersede, so there the export","type":"text"},{"text":" ","type":"text"},{"text":"refuses it, and so it does a breaking change for either kind: raise the event’s version.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","type":"reference"},{"text":" ","type":"text"},{"text":"covers the executable, the command plugins and the test.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it."}],"references":{"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan":{"navigatorTitle":[{"text":"TrackingPlan","kind":"identifier"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlan","kind":"identifier"}],"type":"topic","url":"\/documentation\/trackingplans\/trackingplan","role":"symbol","title":"TrackingPlan","abstract":[{"text":"The JSON Schema (draft 2020-12) of every event an app tracks: one document per event and an","type":"text"},{"text":" ","type":"text"},{"text":"index, exported from the events’ ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference"},{"text":" values.","type":"text"}],"kind":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/IgluRegistry":{"kind":"symbol","abstract":[{"type":"text","text":"The kind of Iglu registry a tracking plan’s schemas are published to, which decides whether a"},{"type":"text","text":" "},{"type":"text","text":"compatible change can be published at the same event version"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/igluFiles(vendor:registry:carryingForward:)","type":"reference","isActive":true},{"type":"text","text":")."}],"navigatorTitle":[{"kind":"identifier","text":"IgluRegistry"}],"role":"symbol","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluRegistry","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"IgluRegistry"}],"url":"\/documentation\/trackingplans\/igluregistry","title":"IgluRegistry"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/File":{"type":"topic","abstract":[{"type":"text","text":"One file of a tracking plan: its path within the plan’s directory and its bytes."}],"title":"TrackingPlan.File","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/File","kind":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/file","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"File","kind":"identifier"}],"navigatorTitle":[{"text":"File","kind":"identifier"}]},"doc://TrackingPlans/documentation/TrackingPlans":{"kind":"symbol","url":"\/documentation\/trackingplans","role":"collection","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","abstract":[{"type":"text","text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it."}],"type":"topic","title":"TrackingPlans"},"doc://TrackingPlans/documentation/TrackingPlans/IgluExportError":{"role":"symbol","abstract":[{"type":"text","text":"Why a tracking plan couldn’t be written as an Iglu registry"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/igluFiles(vendor:registry:carryingForward:)"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/writeIgluRegistry(to:vendor:registry:)"},{"type":"text","text":")."}],"url":"\/documentation\/trackingplans\/igluexporterror","title":"IgluExportError","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"IgluExportError"}],"navigatorTitle":[{"kind":"identifier","text":"IgluExportError"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/init(schemas:)":{"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"schemas"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventSchemaV","text":"EventSchema"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A9PlanErrorO","text":"TrackingPlanError"},{"kind":"text","text":")"}],"kind":"symbol","type":"topic","url":"\/documentation\/trackingplans\/trackingplan\/init(schemas:)","abstract":[{"type":"text","text":"The plan of the events "},{"type":"codeVoice","code":"schemas"},{"type":"text","text":" describe, in any order, or an error naming the first rule"},{"type":"text","text":" "},{"type":"text","text":"they break."}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/init(schemas:)","title":"init(schemas:)"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/files":{"type":"topic","abstract":[{"type":"text","text":"The plan’s files: the index, "},{"type":"codeVoice","code":"tracking-plan.json"},{"type":"text","text":", then each event’s document and its"},{"type":"text","text":" "},{"type":"text","text":"example, in the order of "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/schemas","isActive":true},{"type":"text","text":"."}],"title":"files","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files","kind":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/files","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"files","kind":"identifier"},{"text":": [","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":".","kind":"text"},{"text":"File","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"text":"]","kind":"text"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanError":{"abstract":[{"type":"text","text":"Why schemas can’t make a tracking plan."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlanError","kind":"identifier"}],"role":"symbol","url":"\/documentation\/trackingplans\/trackingplanerror","kind":"symbol","navigatorTitle":[{"text":"TrackingPlanError","kind":"identifier"}],"type":"topic","title":"TrackingPlanError","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanError"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingplanworkflow":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","titleInlineContent":[{"text":"Exporting and Checking a Tracking Plan","type":"text"}],"title":"Exporting and Checking a Tracking Plan"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCommand":{"navigatorTitle":[{"text":"TrackingPlanCommand","kind":"identifier"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlanCommand","kind":"identifier"}],"type":"topic","url":"\/documentation\/trackingplans\/trackingplancommand","role":"symbol","abstract":[{"text":"An executable that writes a tracking plan: the type marked ","type":"text"},{"code":"@main","type":"codeVoice"},{"text":" in a target of the app’s","type":"text"},{"text":" ","type":"text"},{"text":"package that links the modules declaring its events.","type":"text"}],"title":"TrackingPlanCommand","kind":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCheck":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlanCheck","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/trackingplans\/trackingplancheck","role":"symbol","navigatorTitle":[{"text":"TrackingPlanCheck","kind":"identifier"}],"abstract":[{"type":"text","text":"What checking a tracking plan against the committed one found: a match, a committed plan that"},{"type":"text","text":" "},{"type":"text","text":"is only out of date, or differences that break it."}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCheck","type":"topic","title":"TrackingPlanCheck"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/schemas":{"type":"topic","abstract":[{"text":"The plan’s event schemas, ordered by the UTF-8 bytes of their names and then by version.","type":"text"}],"title":"schemas","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/schemas","kind":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/schemas","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"schemas"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"EventSchema","preciseIdentifier":"s:6Events11EventSchemaV"},{"kind":"text","text":"]"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(againstDirectory:)":{"abstract":[{"type":"text","text":"Compares the plan with the one