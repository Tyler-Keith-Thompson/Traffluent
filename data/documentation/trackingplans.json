eVoice"},{"type":"text","text":" while it"},{"type":"text","text":" "},{"type":"text","text":"still describes the event, or the one to publish next."}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/igluFiles(vendor:registry:carryingForward:)","url":"\/documentation\/trackingplans\/trackingplan\/iglufiles(vendor:registry:carryingforward:)","kind":"symbol","title":"igluFiles(vendor:registry:carryingForward:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"igluFiles","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vendor","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"registry","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"IgluRegistry","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans12IgluRegistryO"},{"text":", ","kind":"text"},{"text":"carryingForward","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":".","kind":"text"},{"text":"File","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"text":"]) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"IgluExportError","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans15IgluExportErrorO"},{"text":") -> [","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":".","kind":"text"},{"text":"File","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"text":"]","kind":"text"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/files":{"url":"\/documentation\/trackingplans\/trackingplan\/files","abstract":[{"text":"The plan’s files: the index, ","type":"text"},{"type":"codeVoice","code":"tracking-plan.json"},{"text":", then each event’s document and its","type":"text"},{"text":" ","type":"text"},{"text":"example, in the order of ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/schemas","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"files"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"File","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"kind":"text","text":"]"}],"type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files","title":"files","role":"symbol","kind":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanDifference":{"abstract":[{"type":"text","text":"One way the plan an app’s events make now differs from the plan committed before them, as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)"},{"type":"text","text":" reports it."}],"title":"TrackingPlanDifference","navigatorTitle":[{"kind":"identifier","text":"TrackingPlanDifference"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference","role":"symbol","url":"\/documentation\/trackingplans\/trackingplandifference","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrackingPlanDifference"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingplanworkflow":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan","type":"link","titleInlineContent":[{"type":"text","text":"Exporting and Checking a Tracking Plan"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/File":{"title":"TrackingPlan.File","navigatorTitle":[{"kind":"identifier","text":"File"}],"abstract":[{"type":"text","text":"One file of a tracking plan: its path within the plan’s directory and its bytes."}],"kind":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/file","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"File"}],"type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/File"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(againstDirectory:)":{"title":"check(againstDirectory:)","abstract":[{"type":"text","text":"Compares the plan with the one committed in "},{"type":"codeVoice","code":"directory"},{"type":"text","text":", as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)"},{"type":"text","text":" does with"},{"type":"text","text":" "},{"type":"text","text":"the directory’s files."}],"kind":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/check(againstdirectory:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"check","kind":"identifier"},{"text":"(","kind":"text"},{"text":"againstDirectory","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO","text":"TrackingPlanCheck","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/write(to:)":{"url":"\/documentation\/trackingplans\/trackingplan\/write(to:)","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","title":"write(to:)","abstract":[{"type":"text","text":"Writes the plan’s files into "},{"code":"directory","type":"codeVoice"},{"type":"text","text":", creating it if needed, and deletes the"},{"type":"text","text":" "},{"code":".schema.json","type":"codeVoice"},{"type":"text","text":" and "},{"code":".example.json","type":"codeVoice"},{"type":"text","text":" files there that the plan doesn’t hold."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"write","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","preciseIdentifier":"s:20FoundationEssentials3URLV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"CocoaError","preciseIdentifier":"s:20FoundationEssentials10CocoaErrorV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","kind":"symbol","role":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(against:)":{"role":"symbol","kind":"symbol","type":"topic","title":"check(against:)","abstract":[{"type":"text","text":"Compares the plan with "},{"code":"committed","type":"codeVoice"},{"type":"text","text":", the files of a plan exported before, and reports every"},{"type":"text","text":" "},{"type":"text","text":"difference."}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)","url":"\/documentation\/trackingplans\/trackingplan\/check(against:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"check"},{"kind":"text","text":"("},{"kind":"externalParam","text":"against"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":