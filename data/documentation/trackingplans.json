 as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it."}],"url":"\/documentation\/trackingplans","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","type":"topic"},"doc://Events/documentation/Events/EventSchema":{"role":"symbol","abstract":[{"text":"The shape of an event type: its name, its schema version, its consent category and its stored","type":"text"},{"text":" ","type":"text"},{"text":"properties in declaration order, as a value tooling reads.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"topic","title":"EventSchema","navigatorTitle":[{"kind":"identifier","text":"EventSchema"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventSchema"}],"url":"\/documentation\/events\/eventschema"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingplanworkflow":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","titleInlineContent":[{"type":"text","text":"Exporting and Checking a Tracking Plan"}],"title":"Exporting and Checking a Tracking Plan"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/files(carryingForward:)":{"url":"\/documentation\/trackingplans\/trackingplan\/files(carryingforward:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"files"},{"kind":"text","text":"("},{"kind":"externalParam","text":"carryingForward"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier","text":"TrackingPlan"},{"kind":"text","text":"."},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV","kind":"typeIdentifier","text":"File"},{"