ck","kind":"symbol","type":"topic","role":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/files(carryingForward:)":{"url":"\/documentation\/trackingplans\/trackingplan\/files(carryingforward:)","abstract":[{"type":"text","text":"The plan’s files, as "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files","isActive":true},{"type":"text","text":" lists them, with each event’s document keeping the"},{"type":"text","text":" "},{"type":"text","text":"properties its document in "},{"type":"codeVoice","code":"committed"},{"type":"text","text":", at the same name and version, has that the event"},{"type":"text","text":" "},{"type":"text","text":"no longer declares: each with its schema there, marked "},{"type":"codeVoice","code":"deprecated: true"},{"type":"text","text":". The documents in"},{"type":"text","text":" "},{"type":"codeVoice","code":"committed"},{"type":"text","text":" of an event’s earlier versions, below the newest the plan lists, are kept too,"},{"type":"text","text":" "},{"type":"text","text":"with their examples, byte for byte, and listed in the index."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"files"},{"kind":"text","text":"("},{"kind":"externalParam","text":"carryingForward"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"File","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"kind":"text","text":"]) -> ["},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"File","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","type":"topic","title":