e":"codeVoice"},{"text":" in a target of the app’s","type":"text"},{"text":" ","type":"text"},{"text":"package that links the modules declaring its events.","type":"text"}],"url":"\/documentation\/trackingplans\/trackingplancommand","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TrackingPlanCommand"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand","title":"TrackingPlanCommand","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrackingPlanCommand"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/igluFiles(vendor:registry:carryingForward:)":{"kind":"symbol","type":"topic","url":"\/documentation\/trackingplans\/trackingplan\/iglufiles(vendor:registry:carryingforward:)","title":"igluFiles(vendor:registry:carryingForward:)","abstract":[{"text":"The plan’s events as the schemas of an Iglu registry of the kind ","type":"text"},{"type":"codeVoice","code":"registry"},{"text":" under ","type":"text"},{"type":"codeVoice","code":"vendor"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"one file per event and version: the newest Iglu version of each in ","type":"text"},{"type":"codeVoice","code":"committed"},{"text":" while it","type":"text"},{"text":" ","type":"text"},{"text":"still describes the event, or the one to publish next.","type":"text"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/igluFiles(vendor:registry:carryingForward:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"igluFiles","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vendor","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"registry","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"IgluRegistry","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans12IgluRegis