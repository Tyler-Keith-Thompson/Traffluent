:"codeVoice"},{"type":"text","text":" while it"},{"type":"text","text":" "},{"type":"text","text":"still describes the event, or the one to publish next."}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanDifference":{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference","role":"symbol","navigatorTitle":[{"text":"TrackingPlanDifference","kind":"identifier"}],"type":"topic","abstract":[{"text":"One way the plan an app’s events make now differs from the plan committed before them, as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)"},{"text":" reports it.","type":"text"}],"title":"TrackingPlanDifference","kind":"symbol","url":"\/documentation\/trackingplans\/trackingplandifference","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlanDifference","kind":"identifier"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan":{"type":"topic","kind":"symbol","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrackingPlan"}],"navigatorTitle":[{"kind":"identifier","text":"TrackingPlan"}],"title":"TrackingPlan","url":"\/documentation\/trackingplans\/trackingplan","abstract":[{"text":"The JSON Schema (draft 2020-12) of every event an app tracks: one document per event and an","type":"text"},{"text":" ","type":"text"},{"text":"index, exported from the events’ ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"text":" values.","type":"text"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/schemas":{"url":"\/documentation\/trackingplans\/trackingplan\/schemas","role":"symbol","title":"schemas","abstract":[{"text":"The plan’s