ode":".example.json"},{"type":"text","text":" files there that the plan doesn’t hold."}],"role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"write","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"CocoaError","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials10CocoaErrorV"},{"text":")","kind":"text"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(againstDirectory:)":{"abstract":[{"type":"text","text":"Compares the plan with the one committed in "},{"code":"directory","type":"codeVoice"},{"type":"text","text":", as "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)","type":"reference","isActive":true},{"type":"text","text":" does with"},{"type":"text","text":" "},{"type":"text","text":"the directory’s files."}],"role":"symbol","title":"check(againstDirectory:)","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"check"},{"kind":"text","text":"("},{"kind":"externalParam","text":"againstDirectory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO","text":"TrackingPlanCheck"}],"kind":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/check(againstdirectory:)","type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/t