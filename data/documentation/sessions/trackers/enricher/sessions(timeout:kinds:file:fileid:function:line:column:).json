{"identifier":{"url":"doc:\/\/Sessions\/documentation\/Sessions\/Trackers\/Enricher\/sessions(timeout:kinds:file:fileID:function:line:column:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sessions","kind":"identifier"},{"text":"(","kind":"text"},{"text":"timeout","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":" = .seconds(30 * 60), ","kind":"text"},{"text":"kinds","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:8Sessions16SessionEventKindO","text":"SessionEventKind","kind":"typeIdentifier","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEventKind"},{"text":"> = Set(SessionEventKind.allCases), ","kind":"text"},{"text":"file","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#file","kind":"keyword"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#fileID","kind":"keyword"},{"text":", ","kind":"text"},{"text":"function","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#function","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher","kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The inactivity after which the next event starts a new session; 30 minutes by","type":"text"},{"text":" ","type":"text"},{"text":"default.","type":"text"}]}],"name":"timeout"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The session events to track; both by default. Leaving one out, or both, tracks"},{"type":"text","text":" "},{"type":"text","text":"none of that kind, and every record still carries its session’s key."}]}],"name":"kinds"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s file; leave it to its default."}]}],"name":"file"},{"content":[{"inlineContent":[{"text":"The caller’s module and file name; leave it to its default.","type":"text"}],"type":"paragraph"}],"name":"fileID"},{"content":[{"inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}],"type":"paragraph"}],"name":"function"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s line; leave it to its default.","type":"text"}]}],"name":"line"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s column; leave it to its default.","type":"text"}]}],"name":"column"}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"text":"The enricher, which runs on the tracker’s worker like any other.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Nothing is put in a session until the app turns it on, among the enrichers it builds its","type":"text"},{"text":" ","type":"text"},{"text":"tracker with, so every event the tracker tracks carries the key, through any copy of it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker(enrichers: [.sessions()])"]},{"inlineContent":[{"type":"text","text":"Inactivity is measured between records’ timestamps, the time each event was tracked, and"},{"type":"text","text":" "},{"type":"text","text":"not when the tracker’s worker reaches it. So the app returning from the background past the"},{"type":"text","text":" "},{"type":"text","text":"timeout starts a new session with its first event, such as "},{"type":"codeVoice","code":"ApplicationOpened"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"codeVoice","code":"LifecycleTracking"},{"type":"text","text":"), and one returning sooner goes on with the same."}],"type":"paragraph"},{"inlineContent":[{"text":"The first event the tracker tracks starts the first session: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted"},{"text":" comes","type":"text"},{"text":" ","type":"text"},{"text":"before it, stamped with its time. A session ends only when an event comes after the","type":"text"},{"text":" ","type":"text"},{"text":"timeout: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded"},{"text":", stamped with the time of the session’s last event, then","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted"},{"text":", stamped with the new event’s, come before that event. So a run’s last","type":"text"},{"text":" ","type":"text"},{"text":"session ends with no ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded"},{"text":": a destination takes its end from its last event. Each","type":"text"},{"text":" ","type":"text"},{"text":"session event carries the key of the session it starts or ends, and the context the event","type":"text"},{"text":" ","type":"text"},{"text":"that ended the session had when this enricher reached it; the enrichers after this one run","type":"text"},{"text":" ","type":"text"},{"text":"on them too. Their call site is this call’s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A session’s identifier is a random UUID, never derived from anything, held in this","type":"text"},{"text":" ","type":"text"},{"text":"enricher’s memory and nowhere else: neither a store nor anything else writes it to disk,","type":"text"},{"text":" ","type":"text"},{"text":"and a new enricher, as on the next launch, starts with a new session. Records a store","type":"text"},{"text":" ","type":"text"},{"text":"kept from an earlier run aren’t enriched again, so they carry no key.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The enricher’s sessions are its own, created by this call: give each tracker its own call.","type":"text"}],"type":"paragraph"},{"name":"Precondition","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"timeout","type":"codeVoice"},{"text":" is more than zero.","type":"text"}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/sessions\/trackers\/enricher\/sessions(timeout:kinds:file:fileid:function:line:column:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/Sessions\/documentation\/Sessions\/Trackers","doc:\/\/Sessions\/documentation\/Sessions\/Trackers\/Enricher"]]},"metadata":{"symbolKind":"method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func