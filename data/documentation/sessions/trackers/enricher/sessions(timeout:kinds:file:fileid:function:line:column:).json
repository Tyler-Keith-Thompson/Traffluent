teSource":{"fileName":"Enricher+Sessions.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Sessions\/Enricher+Sessions.swift#L49"},"extendedModule":"Trackers"},"abstract":[{"text":"An enricher that puts every event in a session: it sets each record’s ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionKey","isActive":true,"type":"reference"},{"text":" to its","type":"text"},{"text":" ","type":"text"},{"text":"session’s identifier, and starts a new session when an event comes ","type":"text"},{"code":"timeout","type":"codeVoice"},{"text":" or more after","type":"text"},{"text":" ","type":"text"},{"text":"the one before it, tracking ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true,"type":"reference"},{"text":" before that event.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/Sessions\/documentation\/Sessions\/Trackers","doc:\/\/Sessions\/documentation\/Sessions\/Trackers\/Enricher"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sessions","kind":"identifier"},{"text":"(","kind":"text"},{"text":"timeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":" = .seconds(30 * 60), ","kind":"text"},{"text":"kinds","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEventKind","text":"SessionEventKind","kind":"typeIdentifier","preciseIdentifier":"s:8Sessions16SessionEventKindO"},{"text":"> = Set(SessionEventKind.allCases), ","kind":"text"},{"text":"file","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#file","kind":"keyword"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#fileID","kind":"keyword"},{"text":", ","kind":"text"},{"text":"function","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#function","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","text":"Enricher","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The inactivity after which the next event starts a new session; 30 minutes by"},{"type":"text","text":" "},{"type":"text","text":"default."}],"type":"paragraph"}],"name":"timeout"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The session events to track; both by default. Leaving one out, or both, tracks"},{"type":"text","text":" "},{"type":"text","text":"none of that kind, and every record still carries its session’s key."}]}],"name":"kinds"},{"content":[{"inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}],"type":"paragraph"}],"name":"file"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}]}],"name":"fileID"},{"content":[{"inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}],"type":"paragraph"}],"name":"function"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}]}],"name":"line"},{"content":[{"inlineContent":[{"text":"The caller’s column; leave it to its default.","type":"text"}],"type":"paragraph"}],"name":"column"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The enricher, which runs on the tracker’s worker like any other."}]}],"kind":"content"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Nothing is put in a session until the app turns it on, among the enrichers it builds its","type":"text"},{"text":" ","type":"text"},{"text":"tracker with, so every event the tracker tracks carries the key, through any copy of it:","type":"text"}]},{"type":"codeListing","code":["let tracker = Tracker(enrichers: [.sessions()])"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Inactivity is measured between records’ timestamps, the time each event was tracked, and","type":"text"},{"text":" ","type":"text"},{"text":"not when the tracker’s worker reaches it. So the app returning from the background past the","type":"text"},{"text":" ","type":"text"},{"text":"timeout starts a new session with its first event, such as ","type":"text"},{"type":"codeVoice","code":"ApplicationOpened"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LifecycleTracking"},{"text":"), and one returning sooner goes on with the same.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The first event the tracker tracks starts the first session: ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true,"type":"reference"},{"text":" comes","type":"text"},{"text":" ","type":"text"},{"text":"before it, stamped with its time. A session ends only when an event comes after the","type":"text"},{"text":" ","type":"text"},{"text":"timeout: ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","isActive":true,"type":"reference"},{"text":", stamped with the time of the session’s last event, then","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true,"type":"reference"},{"text":", stamped with the new event’s, come before that event. So a run’s last","type":"text"},{"text":" ","type":"text"},{"text":"session ends with no ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","isActive":true,"type":"reference"},{"text":": a destination takes its end from its last event. Each","type":"text"},{"text":" ","type":"text"},{"text":"session event carries the key of the session it starts or ends, and the context the event","type":"text"},{"text":" ","type":"text"},{"text":"that ended the session had when this enricher reached it; the enrichers after this one run","type":"text"},{"text":" ","type":"text"},{"text":"on them too. Their call site is this call’s.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A session’s identifier is a random UUID, never derived from anything, held in this","type":"text"},{"text":" ","type":"text"},{"text":"enricher’s memory and nowhere else: neither a store nor anything else writes it to disk,","type":"text"},{"text":" ","type":"text"},{"text":"and a new enricher, as on the next launch, starts with a new session. Records a store","type":"text"},{"text":" ","type":"text"},{"text":"kept from an earlier run aren’t enriched again, so they carry no key.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The enricher’s sessions are its own, created by this call: give each tracker its own call.","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"timeout"},{"type":"text","text":" is more than zero."}],"type":"paragraph"}],"name":"Precondition"}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/sessions\/trackers\/enricher\/sessions(timeout:kinds:file:fileid:function:line:column:)"]}],"identifier":{"url":"doc:\/\/Sessions\/documentation\/Sessions\/Trackers\/Enricher\/sessions(timeout:kinds:file:fileID:function:line:column:)","interfaceLanguage":"swift"},"references":{"doc://Sessions/documentation/Sessions":{"type":"topic","abstract":[],"url":"\/documentation\/sessions","role":"collection","kind":"symbol","identifier":"doc:\/\/Sessions\/documentation\/Sessions","title":"Sessions"},"doc://Sessions/documentation/Sessions/SessionEventKind":{"title":"SessionEventKind","url":"\/documentation\/sessions\/sessioneventkind","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SessionEventKind","kind":"identifier"}],"navigatorTitle":[{"text":"SessionEventKind","kind":"identifier"}],"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEventKind","abstract":[{"type":"text","text":"A kind of session event: pass the ones to track as "},{"type":"codeVoice","code":"Enricher.sessions(timeout:kinds:)"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"kinds"},{"type":"text","text":"."}],"type":"topic","kind":"symbol"},"doc://Sessions/documentation/Sessions/Trackers":{"type":"topic","abstract":[],"role":"collection","identifier":"doc:\/\/Sessions\/do