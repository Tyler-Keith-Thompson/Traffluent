{"sections":[],"abstract":[{"type":"text","text":"An enricher that puts every event in a session: it sets each record’s "},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionKey","isActive":true},{"type":"text","text":" to its"},{"type":"text","text":" "},{"type":"text","text":"session’s identifier, and starts a new session when an event comes "},{"type":"codeVoice","code":"timeout"},{"type":"text","text":" or more after"},{"type":"text","text":" "},{"type":"text","text":"the one before it, tracking "},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true},{"type":"text","text":" before that event."}],"variants":[{"paths":["\/documentation\/sessions\/trackers\/enricher\/sessions(timeout:kinds:file:fileid:function:line:column:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sessions","kind":"identifier"},{"text":"(","kind":"text"},{"text":"timeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":" = .seconds(30 * 60), ","kind":"text"},{"text":"kinds","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"SessionEventKind","kind":"typeIdentifier","preciseIdentifier":"s:8Sessions16SessionEventKindO","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEventKind"},{"text":"> = Set(SessionEventKind.allCases), ","kind":"text"},{"text":"file","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#file","kind":"keyword"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#fileID","kind":"keyword"},{"text":", ","kind":"text"},{"text":"function","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#function","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") -> ","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"timeout","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The inactivity after which the next event starts a new session; 30 minutes by"},{"type":"text","text":" "},{"type":"text","text":"default."}]}]},{"name":"kinds","content":[{"type":"paragraph","inlineContent":[{"text":"The session events to track; both by default. Leaving one out, or both, tracks","type":"text"},{"text":" ","type":"text"},{"text":"none of that kind, and every record still carries its session’s key.","type":"text"}]}]},{"name":"file","content":[{"inlineContent":[{"type":"text","text":"The caller’s file; leave it to its default."}],"type":"paragraph"}]},{"name":"fileID","content":[{"inlineContent":[{"text":"The caller’s module and file name; leave it to its default.","type":"text"}],"type":"paragraph"}]},{"name":"function","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s enclosing declaration; leave it to its default."}]}]},{"name":"line","content":[{"inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}],"type":"paragraph"}]},{"name":"column","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s column; leave it to its default."}]}]}]},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"The enricher, which runs on the tracker’s worker like any other."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"Nothing is put in a session until the app turns it on, among the enrichers it builds its","type":"text"},{"text":" ","type":"text"},{"text":"tracker with, so every event the tracker tracks carries the key, through any copy of it:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker(enrichers: [.sessions()])"]},{"inlineContent":[{"type":"text","text":"Inactivity is measured between records’ timestamps, the time each event was tracked, and"},{"type":"text","text":" "},{"type":"text","text":"not when the tracker’s worker reaches it. So the app returning from the background past the"},{"type":"text","text":" "},{"type":"text","text":"timeout starts a new session with its first event, such as "},{"code":"ApplicationOpened","type":"codeVoice"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"code":"LifecycleTracking","type":"codeVoice"},{"type":"text","text":"), and one returning sooner goes on with the same."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The first event the tracker tracks starts the first session: "},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true,"type":"reference"},{"type":"text","text":" comes"},{"type":"text","text":" "},{"type":"text","text":"before it, stamped with its time. A session ends only when an event comes after the"},{"type":"text","text":" "},{"type":"text","text":"timeout: "},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","isActive":true,"type":"reference"},{"type":"text","text":", stamped with the time of the session’s last event, then"},{"type":"text","text":" "},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true,"type":"reference"},{"type":"text","text":", stamped with the new event’s, come before that event. So a run’s last"},{"type":"text","text":" "},{"type":"text","text":"session ends with no "},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","isActive":true,"type":"reference"},{"type":"text","text":": a destination takes its end from its last event. Each"},{"type":"text","text":" "},{"type":"text","text":"session event carries the key of the session it starts or ends, and the context the event"},{"type":"text","text":" "},{"type":"text","text":"that ended the session had when this enricher reached it; the enrichers after this one run"},{"type":"text","text":" "},{"type":"text","text":"on them too. Their call site is this call’s."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A session’s identifier is a random UUID, never derived from anything, held in this"},{"type":"text","text":" "},{"type":"text","text":"enricher’s memory and nowhere else: neither a store nor anything else writes it to disk,"},{"type":"text","text":" "},{"type":"text","text":"and a new enricher, as on the next launch, starts with a new session. Records a store"},{"type":"text","text":" "},{"type":"text","text":"kept from an earlier run aren’t enriched again, so they carry no key."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The enricher’s sessions are its own, created by this call: give each tracker its own call."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"timeout"},{"text":" is more than zero.","type":"text"}],"type":"paragraph"}],"name":"Precondition","type":"aside","style":"note"}],"kind":"content"}],"metadata":{"modules":[{"name":"Sessions","relatedModules":["Trackers"]}],"title":"sessions(timeout:kinds:file:fileID:function:line:column:)","role":"symbol","roleHeading":"Type Method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sessions"},{"kind":"text","text":"("},{"kind":"externalParam","text":"timeout"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":", "},{"kind":"externalParam","text":"kinds"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:8Sessions16SessionEventKindO","kind":"typeIdentifier","text":"SessionEventKind"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"function"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"column"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:8Trackers8EnricherV","kind":"typeIdentifier","text":"Enricher"}],"extendedModule":"Trackers","externalID":"s:8Trackers8EnricherV8SessionsE8sessions7timeout5kinds4file0G2ID8function4line6columnACs8DurationV_ShyAD16SessionEventKindOGS3SS2itFZ","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Sessions\/Enricher+Sessions.swift#L49","fileName":"Enricher+Sessions.swift"},"symbolKind":"method"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Sessions\/documentation\/Sessions\/Trackers\/Enricher\/sessions(timeout:kinds:file:fileID:function:line:column:)","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/Sessions\/documentation\/Sessions\/Trackers","doc:\/\/Sessions\/documentation\/Sessions\/Trackers\/Enricher"]]},"references":{"doc://Sessions/documentation/Sessions/Trackers/Enricher/sessions(timeout:kinds:file:fileID:function:line:column:)":{"url":"\/documentation\/sessions\/trackers\/enricher\/sessions(timeout:kinds:file:fileid:function:line:column:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sessions","kind":"identifier"},{"text":"(","kind":"text"},{"text":"timeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":", ","kind":"text"},{"text":"kinds","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"SessionEventKind","kind":"typeIdentifier","preciseIdentifier":"s:8Sessions16SessionEventKindO"},{"text":">, ","kind":"text"},{"text":"file","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"