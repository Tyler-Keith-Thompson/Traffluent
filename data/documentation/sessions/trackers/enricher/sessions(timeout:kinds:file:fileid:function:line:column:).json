typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"column"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher"}]},"abstract":[{"type":"text","text":"An enricher that puts every event in a session: it sets each record’s "},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionKey","type":"reference","isActive":true},{"type":"text","text":" to its"},{"type":"text","text":" "},{"type":"text","text":"session’s identifier, and starts a new session when an event comes "},{"type":"codeVoice","code":"timeout"},{"type":"text","text":" or more after"},{"type":"text","text":" "},{"type":"text","text":"the one before it, tracking "},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","type":"reference","isActive":true},{"type":"text","text":" before that event."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sessions"},{"kind":"text","text":"("},{"kind":"externalParam","text":"timeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":" = .seconds(30 * 60), "},{"kind":"externalParam","text":"kinds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEventKind","preciseIdentifier":"s:8Sessions16SessionEventKindO","text":"SessionEventKind"},{"kind":"text","text":"> = Set(SessionEventKind.allCases), "},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#file"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#fileID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"function"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#function"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#line"},{"kind":"text","text":", "},{"kind":"externalParam","text":"column"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#column"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The inactivity after which the next event starts a new session; 30 minutes by"},{"type":"text","text":" "},{"type":"text","text":"default."}],"type":"paragraph"}],"name":"timeout"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The session events to track; both by default. Leaving one out, or both, tracks"},{"type":"text","text":" "},{"type":"text","text":"none of that kind, and every record still carries its session’s key."}]}],"name":"kinds"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}]}],"name":"file"},{"content":[{"inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}],"type":"paragraph"}],"name":"fileID"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}]}],"name":"function"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}]}],"name":"line"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s column; leave it to its default."}]}],"name":"column"}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"inlineContent":[{"type":"text","text":"The enricher, which runs on the tracker’s worker like any other."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Nothing is put in a session until the app turns it on, among the enrichers it builds its","type":"text"},{"text":" ","type":"text"},{"text":"tracker with, so every event the tracker tracks carries the key, through any copy of it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker(enrichers: [.sessions()])"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inactivity is measured between records’ timestamps, the time each event was tracked, and"},{"type":"text","text":" "},{"type":"text","text":"not when the tracker’s worker reaches it. So the app returning from the background past the"},{"type":"text","text":" "},{"type":"text","text":"timeout starts a new session with its first event, such as "},{"type":"codeVoice","code":"ApplicationOpened"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"codeVoice","code":"LifecycleTracking"},{"type":"text","text":"), and one returning sooner goes on with the same."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first event the tracker tracks starts the first session: "},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","type":"reference"},{"type":"text","text":" comes"},{"type":"text","text":" "},{"type":"text","text":"before it, stamped with its time. A session ends only when an event comes after the"},{"type":"text","text":" "},{"type":"text","text":"timeout: "},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","type":"reference"},{"type":"text","text":", stamped with the time of the session’s last event, then"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","type":"reference"},{"type":"text","text":", stamped with the new event’s, come before that event. So a run’s last"},{"type":"text","text":" "},{"type":"text","text":"session ends with no "},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","type":"reference"},{"type":"text","text":": a destination takes its end from its last event. Each"},{"type":"text","text":" "},{"type":"text","text":"session event carries the key of the session it starts or ends, and the context the event"},{"type":"text","text":" "},{"type":"text","text":"that ended the session had when this enricher reached it; the enrichers after this one run"},{"type":"text","text":" "},{"type":"text","text":"on them too. Their call site is this call’s."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A session’s identifier is a random UUID, never derived from anything, held in this"},{"type":"text","text":" "},{"type":"text","text":"enricher’s memory and nowhere else: neither a store nor anything else writes it to disk,"},{"type":"text","text":" "},{"type":"text","text":"and a new enricher, as on the next launch, starts with a new session. Records a store"},{"type":"text","text":" "},{"type":"text","text":"kept from an earlier run aren’t enriched again, so they carry no key."}]},{"type":"paragraph","inlineContent":[{"text":"The enricher’s sessions are its own, created by this call: give each tracker its own call.","type":"text"}]},{"type":"aside","name":"Precondition","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"code":"timeout","type":"codeVoice"},{"type":"text","text":" is more than zero."}],"type":"paragraph"}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Sessions\/documentation\/Sessions\/Trackers\/Enricher\/sessions(timeout:kinds:file:fileID:function:line:column:)"},"variants":[{"paths":["\/documentation\/sessions\/trackers\/enricher\/sessions(timeout:kinds:file:fileid:function:line:column:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Sessions/documentation/Sessions/Trackers/Enricher/sessions(timeout:kinds:file:fileID:function:line:column:)":{"type":"topic","kind":"symbol","abstract":[{"text":"An enricher that puts every event in a session: it sets each record’s ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionKey","type":"reference","isActive":true},{"text":" to its","type":"text"},{"text":" ","type":"text"},{"text":"session’s identifier, and starts a new session when an event comes ","type":"text"},{"code":"timeout","type":"codeVoice"},{"text":" or more after","type":"text"},{"text":" ","type":"text"},{"text":"the one before it, tracking ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","type":"reference","isActive":true},{"text":" before that event.","type":"text"}],"url":"\/documentation\/sessions\/trackers\/enricher\/sessions(timeout:kinds:file:fileid:function:line