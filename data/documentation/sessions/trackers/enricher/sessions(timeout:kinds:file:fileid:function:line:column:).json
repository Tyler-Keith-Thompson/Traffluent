":"<","kind":"text"},{"text":"SessionEventKind","kind":"typeIdentifier","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEventKind","preciseIdentifier":"s:8Sessions16SessionEventKindO"},{"text":"> = Set(SessionEventKind.allCases), ","kind":"text"},{"text":"file","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#file","kind":"keyword"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#fileID","kind":"keyword"},{"text":", ","kind":"text"},{"text":"function","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#function","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") -> ","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","preciseIdentifier":"s:8Trackers8EnricherV"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"timeout","content":[{"type":"paragraph","inlineContent":[{"text":"The inactivity after which the next event starts a new session; 30 minutes by","type":"text"},{"text":" ","type":"text"},{"text":"default.","type":"text"}]}]},{"name":"kinds","content":[{"inlineContent":[{"type":"text","text":"The session events to track; both by default. Leaving one out, or both, tracks"},{"type":"text","text":" "},{"type":"text","text":"none of that kind, and every record still carries its session’s key."}],"type":"paragraph"}]},{"name":"file","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}]}]},{"name":"fileID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}]}]},{"name":"function","content":[{"inlineContent":[{"type":"text","text":"The caller’s enclosing declaration; leave it to its default."}],"type":"paragraph"}]},{"name":"line","content":[{"inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}],"type":"paragraph"}]},{"name":"column","content":[{"inlineContent":[{"text":"The caller’s column; leave it to its default.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The enricher, which runs on the tracker’s worker like any other.","type":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Nothing is put in a session until the app turns it on, among the enrichers it builds its","type":"text"},{"text":" ","type":"text"},{"text":"tracker with, so every event the tracker tracks carries the key, through any copy of it:","type":"text"}],"type":"paragraph"},{"code":["let tracker = Tracker(enrichers: [.sessions()])"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Inactivity is measured between records’ timestamps, the time each event was tracked, and","type":"text"},{"text":" ","type":"text"},{"text":"not when the tracker’s worker reaches it. So the app returning from the background past the","type":"text"},{"text":" ","type":"text"},{"text":"timeout starts a new session with its first event, such as ","type":"text"},{"code":"ApplicationOpened","type":"codeVoice"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"code":"LifecycleTracking","type":"codeVoice"},{"text":"), and one returning sooner goes on with the same.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The first event the tracker tracks starts the first session: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","type":"reference"},{"text":" comes","type":"text"},{"text":" ","type":"text"},{"text":"before it, stamped with its time. A session ends only when an event comes after the","type":"text"},{"text":" ","type":"text"},{"text":"timeout: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","type":"reference"},{"text":", stamped with the time of the session’s last event, then","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","type":"reference"},{"text":", stamped with the new event’s, come before that event. So a run’s last","type":"text"},{"text":" ","type":"text"},{"text":"session ends with no ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","type":"reference"},{"text":": a destination takes its end from its last event. Each","type":"text"},{"text":" ","type":"text"},{"text":"session event carries the key of the session it starts or ends, and the context the event","type":"text"},{"text":" ","type":"text"},{"text":"that ended the session had when this enricher reached it; the enrichers after this one run","type":"text"},{"text":" ","type":"text"},{"text":"on them too. Their call site is this call’s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A session’s identifier is a random UUID, never derived from anything, held in this"},{"type":"text","text":" "},{"type":"text","text":"enricher’s memory and nowhere else: neither a store nor anything else writes it to disk,"},{"type":"text","text":" "},{"type":"text","text":"and a new enricher, as on the next launch, starts with a new session. Records a store"},{"type":"text","text":" "},{"type":"text","text":"kept from an earlier run aren’t enriched again, so they carry no key."}],"type":"paragraph"},{"inlineContent":[{"text":"The enricher’s sessions are its own, created by this call: give each tracker its own call.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"timeout"},{"type":"text","text":" is more than zero."}]}],"type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/Sessions\/documentation\/Sessions\/Trackers","doc:\/\/Sessions\/documentation\/Sessions\/Trackers\/Enricher"]]},"references":{"doc://Sessions/documentation/Sessions/SessionKey":{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionKey","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SessionKey"}],"abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":" key of the session an event was tracked in: a random identifier that","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions(timeout:kinds:)"},{"text":" sets on every record’s context.","type":"text"}],"title":"SessionKey","url":"\/documentation\/sessions\/sessionkey","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SessionKey"}]},"doc://Sessions/documentation/Sessions/Trackers":{"kind":"symbol","role":"collection","type":"topic","title":"Trackers","url":"\/documentation\/sessions\/trackers","abstract":[],"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/Trackers"},"doc://Sessions/documentation/Sessions/Trackers/Enricher/sessions(timeout:kinds: