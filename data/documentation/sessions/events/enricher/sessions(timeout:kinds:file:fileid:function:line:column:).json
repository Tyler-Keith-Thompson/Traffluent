{"identifier":{"url":"doc:\/\/Sessions\/documentation\/Sessions\/Events\/Enricher\/sessions(timeout:kinds:file:fileID:function:line:column:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"An enricher that puts every event in a session: it sets each record’s "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/SessionKey","isActive":true},{"type":"text","text":" to its"},{"type":"text","text":" "},{"type":"text","text":"session’s identifier, and starts a new session when an event comes "},{"type":"codeVoice","code":"timeout"},{"type":"text","text":" or more after"},{"type":"text","text":" "},{"type":"text","text":"the one before it, tracking "},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true},{"type":"text","text":" before that event."}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sessions"},{"kind":"text","text":"("},{"kind":"externalParam","text":"timeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"kinds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"SessionEventKind","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEventKind","preciseIdentifier":"s:8Sessions16SessionEventKindO"},{"kind":"text","text":"> = Set(SessionEventKind.allCases), "},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#file"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#fileID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"function"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#function"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#line"},{"kind":"text","text":", "},{"kind":"externalParam","text":"column"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#column"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NonPositiveSessionTimeout","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/NonPositiveSessionTimeout","preciseIdentifier":"s:8Sessions25NonPositiveSessionTimeoutV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Enricher","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","preciseIdentifier":"s:6Events8EnricherV"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"timeout","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The inactivity after which the next event starts a new session."}]}]},{"name":"kinds","content":[{"inlineContent":[{"type":"text","text":"The session events to track; both by default. Leaving one out, or both, tracks"},{"type":"text","text":" "},{"type":"text","text":"none of that kind, and every record still carries its session’s key."}],"type":"paragraph"}]},{"name":"file","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s file; leave it to its default."}]}]},{"name":"fileID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}]}]},{"name":"function","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s enclosing declaration; leave it to its default."}]}]},{"name":"line","content":[{"inlineContent":[{"text":"The caller’s line; leave it to its default.","type":"text"}],"type":"paragraph"}]},{"name":"column","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s column; leave it to its default.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The enricher, which runs on the tracker’s worker like any other."}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Nothing is put in a session until the app turns it on, among the enrichers it builds its","type":"text"},{"text":" ","type":"text"},{"text":"tracker with, so every event the tracker tracks carries the key, through any copy of it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker(enrichers: [.sessions()])"]},{"inlineContent":[{"type":"text","text":"Inactivity is measured between records’ timestamps, the time each event was tracked, and"},{"type":"text","text":" "},{"type":"text","text":"not when the tracker’s worker reaches it. So the app returning from the background past the"},{"type":"text","text":" "},{"type":"text","text":"timeout starts a new session with its first event, such as "},{"code":"ApplicationOpened","type":"codeVoice"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"code":"LifecycleTracking","type":"codeVoice"},{"type":"text","text":"), and one returning sooner goes on with the same."}],"type":"paragraph"},{"inlineContent":[{"text":"The first event the tracker tracks starts the first session: ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true,"type":"reference"},{"text":" comes","type":"text"},{"text":" ","type":"text"},{"text":"before it, stamped with its time. A session ends only when an event comes after the","type":"text"},{"text":" ","type":"text"},{"text":"timeout: ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","isActive":true,"type":"reference"},{"text":", stamped with the time of the session’s last event, then","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true,"type":"reference"},{"text":", stamped with the new event’s, come before that event. So a run’s last","type":"text"},{"text":" ","type":"text"},{"text":"session ends with no ","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","isActive":true,"type":"reference"},{"text":": a destination takes its end from its last event. Each","type":"text"},{"text":" ","type":"text"},{"text":"session event carries the key of the session it starts or ends, and the context the event","type":"text"},{"text":" ","type":"text"},{"text":"that ended the session had when this enricher reached it; the enrichers after this one run","type":"text"},{"text":" ","type":"text"},{"text":"on them too. Their call site is this call’s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A session’s identifier is a version 7 UUID: the session’s start in Unix milliseconds, then","type":"text"},{"text":" ","type":"text"},{"text":"random bits, never derived from the device, the user or another identifier. It is held in","type":"text"},{"text":" ","type":"text"},{"text":"this enricher’s memory and nowhere else: neither a store nor anything else writes it to disk,","type":"text"},{"text":" ","type":"text"},{"text":"and a new enricher, as on the next launch, starts with a new session. Records a store","type":"text"},{"text":" ","type":"text"},{"text":"kept from an earlier run aren’t enriched again, so they carry no key.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The enricher’s sessions are its own, created by this call: give each tracker its own call."}],"type":"paragraph"},{"name":"Throws","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/NonPositiveSessionTimeout","type":"reference"},{"text":" when ","type":"text"},{"code":"timeout","type":"codeVoice"},{"text":" is zero or less.","type":"text"}]}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/Sessions\/documentation\/Sessions\/Events","doc:\/\/Sessions\/documentation\/Sessions\/Events\/Enricher"]]},"metadata":{"title":"sessions(timeout:kinds:file:fileID:function:line:column:)","externalID":"s:6Events8EnricherV8SessionsE8sessions7timeout5kinds4file0G2ID8function4line6columnACs8DurationV_ShyAD16SessionEventKindOGS3SS2itAD011NonPositiveM7TimeoutVYKFZ","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sessions"},{"kind":"text","text":"("},{"kind":"externalParam","text":"timeout"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":", "},{"kind":"externalParam","text":"kinds"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:8Sessions16SessionEventKindO","kind":"typeIdentifier","text":"SessionEventKind"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"file"},{"k