ext":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NonPositiveSessionTimeout","preciseIdentifier":"s:8Sessions25NonPositiveSessionTimeoutV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Enricher","preciseIdentifier":"s:6Events8EnricherV","kind":"typeIdentifier"}],"remoteSource":{"fileName":"Enricher+Sessions.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Sessions\/Enricher+Sessions.swift#L48"},"extendedModule":"Events"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"An enricher that puts every event in a session: it sets each record’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionKey"},{"type":"text","text":" to its"},{"type":"text","text":" "},{"type":"text","text":"session’s identifier, and starts a new session when an event comes "},{"type":"codeVoice","code":"timeout"},{"type":"text","text":" or more after"},{"type":"text","text":" "},{"type":"text","text":"the one before it, tracking "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted"},{"type":"text","text":" before that event."}],"kind":"symbol","seeAlsoSections":[{"title":"Putting events in sessions","identifiers":["doc:\/\/Sessions\/documentation\/Sessions\/Events\/Enricher\/sessions(kinds:file:fileID:function:line:column:)","doc:\/\/Sessions\/documentation\/Sessions\/SessionEventKind","doc:\/\/Sessions\/documentation\/Sessions\/NonPositiveSessionTimeout"],"generated":true,"anchor":"Putting-events-in-sessions"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sessions","kind":"identifier"},{"text":"(","kind":"text"},{"text":"timeout","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"kinds","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEventKind","preciseIdentifier":"s:8Sessions16SessionEventKindO","text":"SessionEventKind","kind":"typeIdentifier"},{"text":"> = Set(SessionEventKind.allCases), ","kind":"text"},{"text":"file","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#file","kind":"keyword"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#fileID","kind":"keyword"},{"text":", ","kind":"text"},{"text":"function","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#function","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/NonPositiveSessionTimeout","preciseIdentifier":"s:8Sessions25NonPositiveSessionTimeoutV","text":"NonPositiveSessionTimeout","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"name":"timeout","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The inactivity after which the next event starts a new session."}]}]},{"name":"kinds","content":[{"type":"paragraph","inlineContent":[{"text":"The session events to track; both by default. Leaving one out, or both, tracks","type":"text"},{"text":" ","type":"text"},{"text":"none of that kind, and every record still carries its session’s key.","type":"text"}]}]},{"name":"file","content":[{"inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}],"type":"paragraph"}]},{"name":"fileID","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s module and file name; leave it to its default.","type":"text"}]}]},{"name":"function","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}]}]},{"name":"line","content":[{"inlineContent":[{"text":"The caller’s line; leave it to its default.","type":"text"}],"type":"paragraph"}]},{"name":"column","content":[{"inlineContent":[{"text":"The caller’s column; leave it to its default.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The enricher, which runs on the tracker’s worker like any other."}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing is put in a session until the app turns it on, among the enrichers it builds its"},{"type":"text","text":" "},{"type":"text","text":"tracker with, so every event the tracker tracks carries the key, through any copy of it:"}]},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker(enrichers: [.sessions()])"]},{"type":"paragraph","inlineContent":[{"text":"Inactivity is measured between records’ timestamps, the time each event was tracked, and","type":"text"},{"text":" ","type":"text"},{"text":"not when the tracker’s worker reaches it. So the app returning from the background past the","type":"text"},{"text":" ","type":"text"},{"text":"timeout starts a new session with its first event, such as ","type":"text"},{"code":"ApplicationOpened","type":"codeVoice"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"code":"LifecycleTracking","type":"codeVoice"},{"text":"), and one returning sooner goes on with the same.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first event the tracker tracks starts the first session: "},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true},{"type":"text","text":" comes"},{"type":"text","text":" "},{"type":"text","text":"before it, stamped with its time. A session ends only when an event comes after the"},{"type":"text","text":" "},{"type":"text","text":"timeout: "},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","isActive":true},{"type":"text","text":", stamped with the time of the session’s last event, then"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true},{"type":"text","text":", stamped with the new event’s, come before that event. So a run’s last"},{"type":"text","text":" "},{"type":"text","text":"session ends with no "},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","isActive":true},{"type":"text","text":": a destination takes its end from its last event. Each"},{"type":"text","text":" "},{"type":"text","text":"session event carries the key of the session it starts or ends, and the context the event"},{"type":"text","text":" "},{"type":"text","text":"that ended the session had when this enricher reached it; the enrichers after this one run"},{"type":"text","text":" "},{"type":"text","text":"on them too. Their call site is this call’s."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A session’s identifier is a version 7 UUID: the session’s start in Unix milliseconds, then"},{"type":"text","text":" "},{"type":"text","text":"random bits, never derived from the device, the user or another identifier. It is held in"},{"type":"text","text":" "},{"type":"text","text":"this enricher’s memory and nowhere else: neither a store nor anything else writes it to disk,"},{"type":"text","text":" "},{"type":"text","text":"and a new enricher, as on the next launch, starts with a new session. Records a store"},{"type":"text","text":" "},{"type":"text","text":"kept from an earlier run aren’t enriched again, so they carry no key."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The enricher’s sessions are its own, created by this call: give each tracker its own call."}]},{"style":"note","type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/NonPositiveSessionTimeout","isActive":true,"type":"reference"},{"text":" when ","type":"text"},{"code":"timeout","type":"codeVoice"},{"text":" is zero or less.","type":"te