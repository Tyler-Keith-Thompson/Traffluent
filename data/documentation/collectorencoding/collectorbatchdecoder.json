"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"Reads a body ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder"},{"text":" wrote back into the ","type":"text"},{"type":"codeVoice","code":"EventRecord"},{"text":"s it holds, so a server","type":"text"},{"text":" ","type":"text"},{"text":"that receives an app’s batches can hand them to another destination.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CollectorBatchDecoder","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"codeListing","code":["import CollectorEncoding","import TrackingPlans","","let decoder = try CollectorBatchDecoder(plan: try TrackingPlan())","let batch = try decoder.batch(from: body)  \/\/ the body of a POST \/v1\/batches","await destination.receive(batch.records)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each record keeps what the body holds of it:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"its "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"type":"text","text":";"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"its "},{"type":"codeVoice","code":"EventRecord\/timestamp"},{"type":"text","text":", to the millisecond the body holds;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"its event, a value of the decoder’s type of that "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", read through the type’s"},{"type":"text","text":" "},{"type":"text","text":"schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", its "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values included;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"the context the body’s ","type":"text"},{"code":"context","type":"codeVoice"},{"text":" holds: the session’s ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", the sample rate, the","type":"text"},{"text":" ","type":"text"},{"text":"standard context keys, and the trace context, which the decoder’s instrument extracts.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A record has no ","type":"text"},{"code":"EventRecord\/sourceLocation","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"EventRecord\/deliveryTag","type":"codeVoice"},{"text":", which the body","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t hold, and it reveals its sensitive values, as a tracked record does, so a destination","type":"text"},{"text":" ","type":"text"},{"text":"made with ","type":"text"},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"text":" still redacts them. Encoding the records again with a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","type":"reference","isActive":true},{"text":" of the same plan, and an instrument that injects what it extracts,","type":"text"},{"text":" ","type":"text"},{"text":"writes the same bytes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body names each record’s event but not its version, so a record is read at the version of"},{"type":"text","text":" "},{"type":"text","text":"the decoder’s type of that name, and the plan must hold a schema of that version. Deploy the"},{"type":"text","text":" "},{"type":"text","text":"decoder with the event types the apps send. Once a type’s version is raised, a record an older"},{"type":"text","text":" "},{"type":"text","text":"app sends at the earlier version is read as the newer one: it is reported as"},{"type":"text","text":" "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorDecodingError\/undecodableProperty(event:property:)","isActive":true,"type":"reference"},{"type":"text","text":" when its properties don’t fit"},{"type":"text","text":" "},{"type":"text","text":"the newer type, and read as the newer version when they do."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the decoder can’t read is left out and the batch’s other records are read: one whose"},{"type":"text","text":" "},{"type":"text","text":"event it has no type of, one whose type’s version the plan has no schema of, a member that is"},{"type":"text","text":" "},{"type":"text","text":"missing or holds what the encoder never writes, and a property the event’s type can’t read"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorDecodingError","type":"reference","isActive":true},{"type":"text","text":"). "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder\/batch(from:)","type":"reference","isActive":true},{"type":"text","text":" returns each as an "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/UndecodedRecord","type":"reference","isActive":true},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" property a delivery redacted is missing, so its record reads back only when the"},{"type":"text","text":" "},{"type":"text","text":"property is optional or has a default value; a redacted "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" element of an array is"},{"type":"text","text":" "},{"type":"codeVoice","code":"null"},{"type":"text","text":", so a record whose array of non-optional "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" elements was redacted is reported as"},{"type":"text","text":" "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorDecodingError\/undecodableProperty(event:property:)","type":"reference","isActive":true},{"type":"text","text":". An integer outside its"},{"type":"text","text":" "},{"type":"text","text":"property’s type, such as 300 for a "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":", is reported the same way. A property of a type the plan can’t map reads"},{"type":"text","text":" "},{"type":"text","text":"back only as far as its JSON holds what its "},{"type":"codeVoice","code":"Decodable"},{"type":"text","text":" conformance reads: a whole "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" "},{"type":"text","text":"inside it is written without a fraction, and a "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" inside it as a timestamp, neither of"},{"type":"text","text":" "},{"type":"text","text":"which it reads."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A body that isn’t a collector batch at all throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/NotACollectorBatch"},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchDecoder/init(plan:instrument:)":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder\/init(plan:instrument:)","abstract":[{"text":"A decoder of records of every ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" the program links (","type":"text"},{"type":"codeVoice","code":"DiscoveredEvent\/all"},{"text":"), whose","type":"text"},{"text":" ","type":"text"},{"text":"properties ","type":"text"},{"type":"codeVoice","code":"plan"},