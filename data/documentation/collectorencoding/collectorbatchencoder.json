:"a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" is a string; a "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" a boolean; an integer or a "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Float"},{"type":"text","text":" a number; a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" an ISO 8601 string, as "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":" is; a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" an uppercase UUID string; an array an"},{"type":"text","text":" "},{"type":"text","text":"array; and an optional’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". A "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value is its value. A type the plan can’t"},{"type":"text","text":" "},{"type":"text","text":"map is written as its encoding holds it: a map with text keys is an object."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is written as its value when the record reveals it"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EventRecord\/revealsSensitiveValues"},{"type":"text","text":"), as every destination may, and left out once a delivery"},{"type":"text","text":" "},{"type":"text","text":"redacts it ("},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":"): a redacted property is missing from "},{"type":"codeVoice","code":"properties"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and an element of an array, or a value inside a type the plan can’t map, is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". The plan’s"},{"type":"text","text":" "},{"type":"text","text"