syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object whose "},{"type":"codeVoice","code":"records"},{"type":"text","text":" member holds one object per record, oldest first,"},{"type":"text","text":" "},{"type":"text","text":"with these members, and its content type is "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":":"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a UUID string; a redelivered record keeps it"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"name"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s ","type":"text"},{"type":"codeVoice","code":"Event\/name"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"timestamp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked: ISO 8601 in UTC, with milliseconds ("},{"type":"codeVoice","code":"2026-11-23T14:03:27.512Z"},{"type":"text","text":")"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"properties"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s stored properties, by name","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"context"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The context values listed below that the record’s context holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"isRedelivered"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/isRedelivered"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragra