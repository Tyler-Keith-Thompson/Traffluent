{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","type":"reference"},{"type":"text","text":" turns each record into one log entry at the level you choose, "},{"type":"codeVoice","code":"info"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default. The message is the event’s name. The metadata holds the event’s description under"},{"type":"text","text":" "},{"type":"codeVoice","code":"event"},{"type":"text","text":", the time it was tracked under "},{"type":"codeVoice","code":"event.timestamp"},{"type":"text","text":", its call site under OpenTelemetry’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"code.*"},{"type":"text","text":" names, and every value of its "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" under the value’s key name. The entry’s"},{"type":"text","text":" "},{"type":"text","text":"own file, function and line are the event’s call site, so a handler that prints them points at"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"track"},{"type":"text","text":" call rather than at this module."}]},{"type":"paragraph","inlineContent":[{"text":"Use it to see what is tracked beside the rest of your logs, in development or in a log pipeline","type":"text"},{"text":" ","type":"text"},{"text":"you already run. It writes the event’s description, in which a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" property prints as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"<redacted>"},{"text":". To add events to traces instead, use ","type":"text"},{"type":"codeVoice","code":"SpanEventDestination"},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"TracingDestinations"},{"text":" module; to send them to a server, ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"HTTPDestinations"},{"text":".","type":"text"}]},{"code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: LoggerDestination(logger: logger, level: .debug)",")","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":"."}]}]}],"metadata":{"title":"LoggingDestinations","symbolKind":"module","externalID":"LoggingDestinations","roleHeading":"Framework","modules":[{"name":"LoggingDestinations"}],"role":"collection"},"sections":[],"topicSections":[{"anchor":"Destinations","title":"Destinations","identifiers":["doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination"]}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"variants":[{"paths":["\/documentation\/loggingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://LoggingDestinations/documentation/LoggingDestinations/LoggerDestination":{"navigatorTitle":[{"kind":"identifier","text":"LoggerDestination"}],"abstract":[{"type":"text","text":"A destination that writes each event to a swift-log "},{"code":"Logger","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","type"