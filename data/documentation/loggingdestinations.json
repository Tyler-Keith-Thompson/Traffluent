{"metadata":{"externalID":"LoggingDestinations","roleHeading":"Framework","modules":[{"name":"LoggingDestinations"}],"role":"collection","title":"LoggingDestinations","symbolKind":"module"},"abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"code":"Logger","type":"codeVoice"},{"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"sections":[],"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Destinations","identifiers":["doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination"],"anchor":"Destinations"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","type":"reference"},{"text":" turns each record into one log entry at the level you choose, ","type":"text"},{"code":"info","type":"codeVoice"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default. The message is the event’s name. The metadata holds the event’s description under","type":"text"},{"text":" ","type":"text"},{"code":"event","type":"codeVoice"},{"text":", the time it was tracked under ","type":"text"},{"code":"event.timestamp","type":"codeVoice"},{"text":", its call site under OpenTelemetry’s","type":"text"},{"text":" ","type":"text"},{"code":"code.*","type":"codeVoice"},{"text":" names, and every value of its ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" under the value’s key name. The entry’s","type":"text"},{"text":" ","type":"text"},{"text":"own file, function and line are the event’s call site, so a handler that prints them points at","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" call rather than at this module.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use it to see what is tracked beside the rest of your logs, in development or in a log pipeline"},{"type":"text","text":" "},{"type":"text","text":"you already run. It writes the event’s description, in which a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" property prints as"},{"type":"text","text":" "},{"type":"codeVoice","code":"<redacted>"},{"type":"text","text":". To add events to traces instead, use "},{"type":"codeVoice","code":"SpanEventDestination"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"TracingDestinations"},{"type":"text","text":" module; to send them to a server, "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" in "},{"type":"codeVoice","code":"HTTPDestinations"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: LoggerDestination(logger: logger, level: .debug)",")","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/loggingdestinations"]}],"references":{"doc://LoggingDestinations/documentation/LoggingDestinations":{"abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"code":"Logger","type":"codeVoice"},{"text":".","type":"text"}],"title":"LoggingDestinations","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDesti