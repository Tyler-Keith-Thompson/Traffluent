{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","isActive":true,"type":"reference"},{"text":" turns each record into one log entry at the level you choose, ","type":"text"},{"code":"info","type":"codeVoice"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default. The message is the event’s name. The metadata holds the event’s description under","type":"text"},{"text":" ","type":"text"},{"code":"event","type":"codeVoice"},{"text":", the time it was tracked under ","type":"text"},{"code":"event.timestamp","type":"codeVoice"},{"text":", its call site under OpenTelemetry’s","type":"text"},{"text":" ","type":"text"},{"code":"code.*","type":"codeVoice"},{"text":" names, and every value of its ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" under the value’s key name. The entry’s","type":"text"},{"text":" ","type":"text"},{"text":"own file, function and line are the event’s call site, so a handler that prints them points at","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" call rather than at this module.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use it to see what is tracked beside the rest of your logs, in development or in a log pipeline","type":"text"},{"text":" ","type":"text"},{"text":"you already run. It writes the event’s description, in which a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" property prints as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"<redacted>"},{"text":". To add events to traces instead, use ","type":"text"},{"type":"codeVoice","code":"SpanEventDestination"},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"TracingDestinations"},{"text":" module; to send them to a server, ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"HTTPDestinations"},{"text":".","type":"text"}]},{"type":"codeListing","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: LoggerDestination(logger: logger, level: .debug)",")","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference","isActive":true},{"type":"text","text":"."}]}]}],"variants":[{"paths":["\/documentation\/loggingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Framework","role":"collection","modules":[{"name":"LoggingDestinations"}],"title":"LoggingDestinations","externalID":"LoggingDestinations","symbolKind":"module"},"topicSections":[{"title":"Destinations","identifiers":["doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination"],"anchor":"Destinations"}],"sections":[],"kind":"symbol","abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"code":"Logger","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://LoggingDestinations/documentation/LoggingDestinations/LoggerDestination":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LoggerDestination","kind":"identifier"}],"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","type":"topic","url":"