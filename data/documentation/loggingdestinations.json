"type":"text","text":" property prints as"},{"type":"text","text":" "},{"type":"codeVoice","code":"<redacted>"},{"type":"text","text":". To add events to traces instead, use "},{"type":"codeVoice","code":"SpanEventDestination"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"TracingDestinations"},{"type":"text","text":" module; to send them to a server, "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" in "},{"type":"codeVoice","code":"HTTPDestinations"},{"type":"text","text":"."}]},{"type":"codeListing","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: LoggerDestination(logger: logger, level: .debug)",")","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"sections":[],"metadata":{"roleHeading":"Framework","externalID":"LoggingDestinations","modules":[{"name":"LoggingDestinations"}],"role":"collection","title":"LoggingDestinations","symbolKind":"module"},"identifier":{"url":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"code":"Logger","type":"codeVoice"},{"type":"text","text":"."}],"references":{"doc://LoggingDestinations/documentation/LoggingDestinations/LoggerDestination":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LoggerDestination","kind":"identifier"}],"role":"symbol","title":"LoggerDestination","navigatorTitle":[{"text":"LoggerDestination","kind":"identif