{"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Destinations","anchor":"Destinations","identifiers":["doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination"]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"metadata":{"role":"collection","title":"LoggingDestinations","roleHeading":"Framework","symbolKind":"module","externalID":"LoggingDestinations","modules":[{"name":"LoggingDestinations"}]},"abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"code":"Logger","type":"codeVoice"},{"type":"text","text":"."}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","type":"reference"},{"type":"text","text":" turns each record into one log entry at the level you choose, "},{"type":"codeVoice","code":"info"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default. The message is the event’s name. The metadata holds the event’s description under"},{"type":"text","text":" "},{"type":"codeVoice","code":"event"},{"type":"text","text":", the time it was tracked under "},{"type":"codeVoice","code":"event.timestamp"},{"type":"text","text":", its call site under OpenTelemetry’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"code.*"},{"type":"text","text":" names, and every value of its "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" under the value’s key name. The entry’s"},{"type":"text","text":" "},{"type":"text","text":"own file, function and line are the event’s call site, so a handler that prints them points at"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"track"},{"type":"text","text":" call rather than at this module."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use it to see what is tracked beside the rest of your logs, in development or in a log pipeline"},{"type":"text","text":" "},{"type":"text","text":"you already run. It writes the event’s description, in which a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" property prints as"},{"type":"text","text":" "},{"code":"<redacted>","type":"codeVoice"},{"type":"text","text":". To add events to traces instead, use "},{"code":"SpanEventDestination","type":"codeVoice"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"code":"TracingDestinations","type":"codeVoice"},{"type":"text","text":" module; to send them to a server, "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" in "},{"code":"HTTPDestinations","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: LoggerDestination(logger: logger, level: .debug)",")","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":"."}]}]}],"variants":[{"paths":["\/documentation\/loggingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://LoggingDestinations/documentation/LoggingDestinations":{"abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"code":"Logger","type":"codeVoice"},{"text":".","type":"text"}],"role":"collection","url":"\/documentation\/loggingdestinations","kind":"symbol","title":"LoggingDestinations","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","type":"topic"},"doc://LoggingDestinations/documentation/LoggingDestinations/LoggerDestination":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LoggerDestination"}],"navigatorTitle":[{"kind":"identifier","text":"LoggerDestination"}],"kind":"symbol","title":"LoggerDestination","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","role":"symbol","abstract":[{"type":"text","text":"A destination that writes each event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/loggingdestinations\/loggerdestination"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"type":"link","title":"Choosing Destinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"}}}