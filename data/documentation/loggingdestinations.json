{"identifier":{"url":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","isActive":true},{"type":"text","text":" turns each record into one log entry at the level you choose, "},{"code":"info","type":"codeVoice"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default. The message is the event’s name. The metadata holds the event’s description under"},{"type":"text","text":" "},{"code":"event","type":"codeVoice"},{"type":"text","text":", the time it was tracked under "},{"code":"event.timestamp","type":"codeVoice"},{"type":"text","text":", its call site under OpenTelemetry’s"},{"type":"text","text":" "},{"code":"code.*","type":"codeVoice"},{"type":"text","text":" names, and every value of its "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":" under the value’s key name. The entry’s"},{"type":"text","text":" "},{"type":"text","text":"own file, function and line are the event’s call site, so a handler that prints them points at"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"track","type":"codeVoice"},{"type":"text","text":" call rather than at this module."}],"type":"paragraph"},{"inlineContent":[{"text":"Use it to see what is tracked beside the rest of your logs, in development or in a log pipeline","type":"text"},{"text":" ","type":"text"},{"text":"you already run. It writes the event’s description, in which a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" property prints as","type":"text"},{"text":" ","type":"text"},{"code":"<redacted>","type":"codeVoice"},{"text":". To add events to traces instead, use ","type":"text"},{"code":"SpanEventDestination","type":"codeVoice"},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"code":"TracingDestinations","type":"codeVoice"},{"text":" module; to send them to a server, ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"HTTPDestinations","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: LoggerDestination(logger: logger, level: .debug)",")","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The umbrella guide on this area is","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"kind":"symbol","variants":[{"paths":["\/documentation\/loggingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination"],"anchor":"Destinations","title":"Destinations"}],"metadata":{"symbolKind":"module","externalID":"LoggingDestinations","modules":[{"name":"LoggingDestinations"}],"roleHeading":"Framework","role":"collection","title":"LoggingDestinations"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://LoggingDestinations/documentation/LoggingDestinations":{"abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"code":"Logger","type":"codeVoice"},{"type":"text","text":"."}],"title":"LoggingDestinations","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDesti