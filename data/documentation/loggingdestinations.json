{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","isActive":true},{"type":"text","text":" turns each record into one log entry at the level you choose, "},{"type":"codeVoice","code":"info"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default. The message is the event’s name. The metadata holds the event’s description under"},{"type":"text","text":" "},{"type":"codeVoice","code":"event"},{"type":"text","text":", the time it was tracked under "},{"type":"codeVoice","code":"event.timestamp"},{"type":"text","text":", its call site under OpenTelemetry’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"code.*"},{"type":"text","text":" names, and every value of its "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" under the value’s key name. The entry’s"},{"type":"text","text":" "},{"type":"text","text":"own file, function and line are the event’s call site, so a handler that prints them points at"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"track"},{"type":"text","text":" call rather than at this module."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use it to see what is tracked beside the rest of your logs, in development or in a log pipeline"},{"type":"text","text":" "},{"type":"text","text":"you already run. It writes the event’s description, in which a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" property prints as"},{"type":"text","text":" "},{"type":"codeVoice","code":"<redacted>"},{"type":"text","text":". To add events to traces instead, use "},{"type":"codeVoice","code":"SpanEventDestination"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"TracingDestinations"},{"type":"text","text":" module; to send them to a server, "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" in "},{"type":"codeVoice","code":"HTTPDestinations"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: LoggerDestination(logger: logger, level: .debug)",")","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"paths":["\/documentation\/loggingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Framework","title":"LoggingDestinations","symbolKind":"module","role":"collection","modules":[{"name":"LoggingDestinations"}],"externalID":"LoggingDestinations"},"topicSections":[{"anchor":"Destinations","identifiers":["doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination"],"title":"Destinations"}],"references":{"doc://LoggingDestinations/documentation/LoggingDestinations":{"abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"code":"Logger","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","type":"topic","title":"LoggingDestinations","role":"collection","kind":"symbol","url":"\/documentation\/loggingdestinations"},"doc://LoggingDestinations/documentation/LoggingDestinations/LoggerDestination":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LoggerDestination","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"A destination that writes each event to a swift-log ","type":"text"},{"code":"Logger","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","role":"symbol","url":"\/documentation\/loggingdestinations\/loggerdestination","navigatorTitle":[{"text":"LoggerDestination","kind":"identifier"}],"title":"LoggerDestination"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"}}}