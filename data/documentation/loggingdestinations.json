{"abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"code":"Logger","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"externalID":"LoggingDestinations","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"LoggingDestinations"}],"role":"collection","title":"LoggingDestinations"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","type":"reference","isActive":true},{"type":"text","text":" turns each record into one log entry at the level you choose, "},{"code":"info","type":"codeVoice"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default. The message is the event’s name. The metadata holds the event’s description under"},{"type":"text","text":" "},{"code":"event","type":"codeVoice"},{"type":"text","text":", the time it was tracked under "},{"code":"event.timestamp","type":"codeVoice"},{"type":"text","text":", its call site under OpenTelemetry’s"},{"type":"text","text":" "},{"code":"code.*","type":"codeVoice"},{"type":"text","text":" names, and every value of its "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":" under the value’s key name. The entry’s"},{"type":"text","text":" "},{"type":"text","text":"own file, function and line are the event’s call site, so a handler that prints them points at"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"track","type":"codeVoice"},{"type":"text","text":" call rather than at this module."}],"type":"paragraph"},{"inlineContent":[{"text":"Use it to see what is tracked beside the rest of your logs, in development or in a log pipeline","type":"text"},{"text":" ","type":"text"},{"text":"you already run. It writes the event’s description, in which a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" property prints as","type":"text"},{"text":" ","type":"text"},{"code":"<redacted>","type":"codeVoice"},{"text":". To add events to traces instead, use ","type":"text"},{"code":"SpanEventDestination","type":"codeVoice"},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"code":"TracingDestinations","type":"codeVoice"},{"text":" module; to send them to a server, ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"HTTPDestinations","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: LoggerDestination(logger: logger, level: .debug)",")","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"]},{"inlineContent":[{"text":"The umbrella guide on this area is","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"text":".","type":"text"}],"type":"paragraph"}]}],"sections":[],"variants":[{"paths":["\/documentation\/loggingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Destinations","identifiers":["doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination"],"anchor":"Destinations"}],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","interfaceLanguage":"swift"},"references":{"doc://LoggingDestinations/documentation/LoggingDestinations":{"role":"collection","abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"code":"Logger","type":"codeVoice"},{"type":"text","text":"."}],"title":"LoggingDestinations","url":"\/documentation\/loggingdestinations","kind":"symbol","type":"topic","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"type":"link","title":"Choosing Destinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://LoggingDestinations/documentation/LoggingDestinations/LoggerDestination":{"title":"LoggerDestination","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","navigatorTitle":[{"text":"LoggerDestination","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/loggingdestinations\/loggerdestination","abstract":[{"type":"text","text":"A destination that writes each event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LoggerDestination","kind":"identifier"}]}}}