{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","interfaceLanguage":"swift"},"topicSections":[{"title":"Destinations","anchor":"Destinations","identifiers":["doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination"]}],"kind":"symbol","abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"code":"Logger","type":"codeVoice"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/loggingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","isActive":true},{"text":" turns each record into one log entry at the level you choose, ","type":"text"},{"code":"info","type":"codeVoice"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default. The message is the event’s name. The metadata holds the event’s description under","type":"text"},{"text":" ","type":"text"},{"code":"event","type":"codeVoice"},{"text":", the time it was tracked under ","type":"text"},{"code":"event.timestamp","type":"codeVoice"},{"text":", its call site under OpenTelemetry’s","type":"text"},{"text":" ","type":"text"},{"code":"code.*","type":"codeVoice"},{"text":" names, and every value of its ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" under the value’s key name. The entry’s","type":"text"},{"text":" ","type":"text"},{"text":"own file, function and line are the event’s call site, so a handler that prints them points at","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" call rather than at this module.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use it 