{"metadata":{"modules":[{"name":"LoggingDestinations"}],"externalID":"LoggingDestinations","title":"LoggingDestinations","roleHeading":"Framework","role":"collection","symbolKind":"module"},"topicSections":[{"anchor":"Destinations","title":"Destinations","identifiers":["doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination"]}],"variants":[{"paths":["\/documentation\/loggingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","type":"reference"},{"type":"text","text":" turns each record into one log entry at the level you choose, "},{"type":"codeVoice","code":"info"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default. The message is the event’s name. The metadata holds the event’s description under"},{"type":"text","text":" "},{"type":"codeVoice","code":"event"},{"type":"text","text":", the time it was tracked under "},{"type":"codeVoice","code":"event.timestamp"},{"type":"text","text":", its call site under OpenTelemetry’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"code.*"},{"type":"text","text":" names, and every value of its "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" under the value’s key name. The entry’s"},{"type":"text","text":" "},{"type":"text","text":"own file, function and line are the event’s call site, so a handler that prints them points at"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"track"},{"type":"text","text":" call rather than at this module."}]},{"type":"paragraph","inlineContent":[{"text":"Use it to see what is tracked beside the rest of your logs, in development or in a log pipeline","type":"text"},{"text":" ","type":"text"},{"text":"you already run. It writes the event’s description, in which a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" property prints as","type":"text"},{"text":" ","type":"text"},{"code":"<redacted>","type":"codeVoice"},{"text":". To add events to traces instead, use ","type":"text"},{"code":"SpanEventDestination","type":"codeVoice"},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"code":"TracingDestinations","type":"codeVoice"},{"text":" module; to send them to a server, ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"HTTPDestinations","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: LoggerDestination(logger: logger, level: .debug)",")","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The umbrella guide on this area is","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[[]]},"abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"code":"Logger","type":"codeVoice"},{"text":".","type":"text"}],"sections":[],"references":{"doc://LoggingDestinations/documentation/LoggingDestinations":{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","kind":"symbol","abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"type":"codeVoice","code":"Logger"},{"text":".","type":"text"}],"type":"topic","title":"LoggingDestinations","url":"\/documentation\/loggingdestinations","role":"collection"},"doc://LoggingDestinations/documentation/LoggingDestinations/LoggerDestination":{"kind":"symbol","url":"\/documentation\/loggingdestinations\/loggerdestination","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LoggerDestination","kind":"identifier"}],"title":"LoggerDestination","abstract":[{"type":"text","text":"A destination that writes each event to a swift-log "},{"code":"Logger","type":"codeVoice"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"LoggerDestination","kind":"identifier"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"type":"link"}}}