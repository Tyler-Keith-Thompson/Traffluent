{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination"},{"type":"text","text":" turns each record into one log entry at the level you choose, "},{"code":"info","type":"codeVoice"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default. The message is the event’s name. The metadata holds the event’s description under"},{"type":"text","text":" "},{"code":"event","type":"codeVoice"},{"type":"text","text":", the time it was tracked under "},{"code":"event.timestamp","type":"codeVoice"},{"type":"text","text":", its call site under OpenTelemetry’s"},{"type":"text","text":" "},{"code":"code.*","type":"codeVoice"},{"type":"text","text":" names, and every value of its "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":" under the value’s key name. The entry’s"},{"type":"text","text":" "},{"type":"text","text":"own file, function and line are the event’s call site, so a handler that prints them points at"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"track","type":"codeVoice"},{"type":"text","text":" call rather than at this module."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use it to see what is tracked beside the rest of your logs, in development or in a log pipeline"},{"type":"text","text":" "},{"type":"text","text":"you already run. It writes the event’s description, in which a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" property prints as"},{"type":"text","text":" "},{"type":"codeVoice","code":"<redacted>"},{"type":"text","text":". To add events to traces instead, use "},{"type":"codeVoice","code":"SpanEventDestination"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"TracingDestinations"},{"type":"text","text":" module; to send them to a server, "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" in "},{"type":"codeVoice","code":"HTTPDestinations"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: LoggerDestination(logger: logger, level: .debug)",")","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/loggingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"sections":[],"hierarchy":{"paths":[[]]},"abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"type":"codeVoice","code":"Logger"},{"text":".","type":"text"}],"kind":"symbol","topicSections":[{"anchor":"Destinations","title":"Destinations","identifiers":["doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination"]}],"metadata":{"role":"collection","title":"LoggingDestinations","externalID":"LoggingDestinations","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"LoggingDestinations"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"url":"\/documentation\/loggingdestinations","abstract":[{"text":"A destination that writes each tracked event to a swift-log ","type":"text"},{"type":"codeVoice","code":"Logger"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","title":"LoggingDestinations","role":"collection","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"doc://LoggingDestinations/documentation/LoggingDestinations/LoggerDestination":{"url":"\/documentation\/loggingdestinations\/loggerdestination","kind":"symbol","abstract":[{"type":"text","text":"A destination that writes each event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"LoggerDestination"}],"title":"LoggerDestination","role":"symbol","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LoggerDestination"}]}}}