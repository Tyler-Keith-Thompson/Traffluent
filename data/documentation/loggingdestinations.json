{"abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"topicSections":[{"anchor":"Destinations","title":"Destinations","identifiers":["doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/loggingdestinations"]}],"metadata":{"title":"LoggingDestinations","externalID":"LoggingDestinations","symbolKind":"module","role":"collection","modules":[{"name":"LoggingDestinations"}],"roleHeading":"Framework"},"sections":[],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","isActive":true},{"text":" turns each record into one log entry at the level you choose, ","type":"text"},{"type":"codeVoice","code":"info"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default. The message is the event’s name. The metadata holds the event’s description under","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"event"},{"text":", the time it was tracked under ","type":"text"},{"type":"codeVoice","code":"event.timestamp"},{"text":", its call site under OpenTelemetry’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"code.*"},{"text":" names, and every value of its ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":" under the value’s key name. The entry’s","type":"text"},{"text":" ","type":"text"},{"text":"own file, function and line are the event’s call site, so a handler that prints them points at","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"codeVoice","code":"track"},{"text":" call rather than at this module.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use it to see what is tracked beside the rest of your logs, in development or in a log pipeline"},{"type":"text","text":" "},{"type":"text","text":"you already run. It writes the event’s description, in which a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" property prints as"},{"type":"text","text":" "},{"code":"<redacted>","type":"codeVoice"},{"type":"text","text":". To add events to traces instead, use "},{"code":"SpanEventDestination","type":"codeVoice"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"code":"TracingDestinations","type":"codeVoice"},{"type":"text","text":" module; to send them to a server, "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" in "},{"code":"HTTPDestinations","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: LoggerDestination(logger: logger, level: .debug)",")","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":"."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://LoggingDestinations/documentation/LoggingDestinations":{"abstract":[{"type":"text","text":"A destination that writes each tracked event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"url":"\/documentation\/loggingdestinations","role":"collection","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","type":"topic","title":"LoggingDestinations","kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","title":"Choosing Destinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}]},"doc://LoggingDestinations/documentation/LoggingDestinations/LoggerDestination":{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations\/LoggerDestination","navigatorTitle":[{"text":"LoggerDestination","kind":"identifier"}],"type":"topic","title":"LoggerDestination","role":"symbol","abstract":[{"type":"text","text":"A destination that writes each event to a swift-log "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LoggerDestination","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/loggingdestinations\/loggerdestination"}}}