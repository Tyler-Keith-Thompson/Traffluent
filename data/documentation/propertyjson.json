{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"A vendor destination’s encoder writes each record as the vendor’s JSON. This module has the parts","type":"text"},{"text":" ","type":"text"},{"text":"every such encoder needs, so each vendor module writes only its own format:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader","isActive":true},{"type":"text","text":" reads an event’s properties through its schema in a "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"writes a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value only when asked to and the record reveals it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EventRecord.standardContext"},{"text":" is the standard context (app, device, locale, network, operating","type":"text"},{"text":" ","type":"text"},{"text":"system) as JSON, and ","type":"text"},{"type":"codeVoice","code":"flattened(separator:)"},{"text":" turns nested JSON into one level of dotted keys.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Date.iso8601Timestamp"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Date.millisecondsSince1970()"},{"type":"text","text":" are the two timestamp formats vendors"},{"type":"text","text":" "},{"type":"text","text":"take, both rounded down to the millisecond. The ISO 8601 form uses the proleptic Gregorian"},{"type":"text","text":" "},{"type":"text","text":"calendar for every date, as the standard does, dates before the reform of 1582 included."}]}]},{"content":[{"inlineContent":[{"code":"EventRecord.pseudonymous