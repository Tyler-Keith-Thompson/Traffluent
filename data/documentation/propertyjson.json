{"topicSections":[{"anchor":"Reading-properties","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReadingError"],"title":"Reading properties"},{"anchor":"Context-and-identity","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PseudonymousIdentity","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/FlattenedKeyCollision"],"title":"Context and identity"},{"anchor":"Timestamps","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/UnrepresentableTimestamp"],"title":"Timestamps"},{"anchor":"Splitting-a-batch-into-requests","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/InvalidBatchLimit","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/NegativeMaximumAge","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/JSONEnvelope"],"title":"Splitting a batch into requests"},{"generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/Events","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/FoundationEssentials","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/Swift"],"title":"Extended Modules"}],"identifier":{"url":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"A vendor destination’s encoder writes each record as the vendor’s JSON. This module has the parts","type":"text"},{"text":" ","type":"text"},{"text":"every such encoder needs, so each vendor module writes only its own format:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader","type":"reference","isActive":true},{"type":"text","text":" reads an event’s pro