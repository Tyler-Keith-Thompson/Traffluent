{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A vendor destination’s encoder writes each record as the vendor’s JSON. This module has the parts","type":"text"},{"text":" ","type":"text"},{"text":"every such encoder needs, so each vendor module writes only its own format:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader","type":"reference","isActive":true},{"type":"text","text":" reads an event’s properties through its schema in a "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"writes a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value only when asked to and the record reveals it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"EventRecord.standardContext","type":"codeVoice"},{"type":"text","text":" is the standard context (app, device, locale, network, operating"},{"type":"text","text":" "},{"type":"text","text":"system) as JSON, and "},{"code":"flattened(separator:)","type":"codeVoice"},{"type":"text","text":" turns nested JSON into one level of dotted keys."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Date.iso8601Timestamp"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Date.millisecondsSince1970()"},{"text":" are the two timestamp formats vendors","type":"text"},{"text":" ","type":"text"},{"text":"take, both rounded down to the millisecond.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EventRecord.pseudonymousIdentity"},{"type":"text","text":" is the record’s session, or the record itself when it has"},{"type":"text","text":" "},{"type":"text","text":"none, and "},{"type":"codeVoice","code":"EventRecord.deduplicationID"},{"type":"text","text":" the identifier a vendor drops repeats by."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","isActive":true},{"type":"text","text":" splits a batch into requests of a "},{"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/JSONEnvelope","isActive":true},{"type":"text","text":" within a vendor’s limits on"},{"type":"text","text":" "},{"type":"text","text":"records and bytes, and leaves out a record that fits in none of them as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":")."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties, context and envelopes are "},{"type":"codeVoice","code":"JSON"},{"type":"text","text":" values, a type from "},{"identifier":"doc:\/\/JSONValues\/documentation\/JSONValues","type":"reference","isActive":true},{"type":"text","text":" that a vendor"},{"type":"text","text":" "},{"type":"text","text":"module imports beside this one. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves both modules out."}]},{"type":"codeListing","syntax":"swift","code":["import JSONValues","import PropertyJSON","import TrackingPlans","","let reader = PropertyReader(plan: plan)","let event: JSON = .object([","    \"name\": .string(record.name),","    \"id\": .string(record.deduplicationID),","    \"user\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","    \"at\": .integer(try record.timestamp.millisecondsSince1970()),","    \"properties\": .object(try reader.properties(of: record, includingSensitiveValues: false)),","    \"context\": .object(try record.standardContext.f