{"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"The vendor-neutral pieces a JSON "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" is built from: properties, context, timestamps, identity and batch splitting."}],"metadata":{"roleHeading":"Framework","symbolKind":"module","title":"PropertyJSON","modules":[{"name":"PropertyJSON"}],"externalID":"PropertyJSON","role":"collection"},"sections":[],"topicSections":[{"identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReadingError"],"title":"Reading properties","anchor":"Reading-properties"},{"identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PseudonymousIdentity","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/FlattenedKeyCollision"],"title":"Context and identity","anchor":"Context-and-identity"},{"identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/UnrepresentableTimestamp"],"title":"Timestamps","anchor":"Timestamps"},{"identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/InvalidBatchLimit","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/NegativeMaximumAge","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/JSONEnvelope"],"title":"Splitting a batch into requests","anchor":"Splitting-a-batch-into-requests"},{"identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/Events","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/FoundationEssentials","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/Swift"],"generated":true,"title":"Extended Modules","anchor":"Extended-Modules"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A vendor destination’s encoder writes each record as the vendor’s JSON. This module has the parts"},{"type":"text","text":" "},{"type":"text","text":"every such encoder needs, so each vendor module writes only its own format:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader"},{"type":"text","text":" reads an event’s properties through its schema in a "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"writes a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value only when asked to and the record reveals it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"EventRecord.standardContext","type":"codeVoice"},{"type":"text","text":" is the standard context (app, device, locale, network, operating"},{"type":"text","text":" "},{"type":"text","text":"system) as JSON, and "},{"code":"flattened(separator:)","type":"codeVoice"},{"type":"text","text":" turns nested JSON into one level of dotted keys."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Date.iso8601Timestamp"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Date.millisecondsSince1970()"},{"type":"text","text":" are the two timestamp formats vendors"},{"type":"text","text":" "},{"type":"text","text":"take, both rounded down to the millisecond. The ISO 8601 form uses the proleptic Gregorian"},{"type":"text","text":" "},{"type":"text","text":"calendar for every date, as the standard does, dates before the reform of 1582 included."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"EventRecord.pseudonymousIdentity","type":"codeVoice"},{"text":" is the record’s session, or the record itself when it has","type":"text"},{"text":" ","type":"text"},{"text":"none, and ","type":"text"},{"code":"EventRecord.deduplicationID","type":"codeVoice"},{"text":" the identifier a vendor drops repeats by.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit"},{"type":"text","text":" splits a batch into requests of a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/JSONEnvelope"},{"type":"text","text":" within a vendor’s limits on"},{"type":"text","text":" "},{"type":"text","text":"records and bytes, and leaves out a record that fits in none of them as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":")."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Properties, context and envelopes are "},{"code":"JSON","type":"codeVoice"},{"type":"text","text":" values, a type from "},{"type":"reference","identifier":"doc:\/\/JSONValues\/documentation\/JSONValues","isActive":true},{"type":"text","text":" that a vendor"},{"type":"text","text":" "},{"type":"text","text":"module imports beside this one. "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" leaves both modules out."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import JSONValues","import PropertyJSON","import TrackingPlans","","let reader = PropertyReader(plan: plan)","let event: JSON = .object([","    \"name\": .string(record.name),","    \"id\": .string(record.deduplicationID),","    \"user\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","    \"at\": .integer(try record.timestamp.millisecondsSince1970()),","    \"properties\": .object(try reader.properties(of: record, includingSensitiveValues: false)),","    \"context\": .object(try record.standardContext.flattened()),","])"]},{"inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyl