{"kind":"symbol","primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vendor destination’s encoder writes each record as the vendor’s JSON. This module has the parts"},{"type":"text","text":" "},{"type":"text","text":"every such encoder needs, so each vendor module writes only its own format:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader","isActive":true,"type":"reference"},{"text":" reads an event’s properties through its schema in a ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"writes a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value only when asked to and the record reveals it.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"EventRecord.standardContext","type":"codeVoice"},{"type":"text","text":" is the standard context (app, device, locale, network, operating"},{"type":"text","text":" "},{"type":"text","text":"system) as JSON, and "},{"code":"flattened(separator:)","type":"codeVoice"},{"type":"text","text":" turns nested JSON into one level of dotted keys."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Date.iso8601Timestamp","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Date.millisecondsSince1970()","type":"codeVoice"},{"type":"text","text":" are the two timestamp formats vendors"},{"type":"text","text":" "},{"type":"text","text":"take, both rounded down to the millisecond. The ISO 8601 form uses the proleptic Gregorian"},{"type":"text","text":" "},{"type":"text","text":"calendar for every date, as the standard does, dates before the reform of 1582 included."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"EventRecord.pseudonymousIdentity","type":"codeVoice"},{"text":" is the record’s session, or the record itself when it has","type":"text"},{"text":" ","type":"text"},{"text":"none, and ","type":"text"},{"code":"EventRecord.deduplicationID","type":"codeVoice"},{"text":" the identifier a vendor drops repeats by.","type":"text"}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit"},{"type":"text","text":" splits a batch into requests of a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/JSONEnvelope"},{"type":"text","text":" within a vendor’s limits on"},{"type":"text","text":" "},{"type":"text","text":"records and bytes, and leaves out a record that fits in none of them as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Properties, context and envelopes are ","type":"text"},{"code":"JSON","type":"codeVoice"},{"text":" values, a type from ","type":"text"},{"identifier":"doc:\/\/JSONValues\/documentation\/JSONValues","type":"reference","isActive":true},{"text":" that a vendor","type":"text"},{"text":" ","type":"text"},{"text":"module imports beside this one. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves both modules out.","type":"text"}]},{"syntax":"swift","code":["import JSONValues","import PropertyJSON","import TrackingPlans","","let reader = PropertyReader(plan: plan)","let event: JSON = .object([","    \"name\": .string(record.name),","    \"id\": .string(record.deduplicationID),","    \"user\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","    \"at\": .integer(try record.timestamp.millisecondsSince1970()),","    \"properties\": .object(try re