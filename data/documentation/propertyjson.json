ent":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader"},{"type":"text","text":" reads an event’s properties through its schema in a "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"writes a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value only when asked to and the record reveals it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"EventRecord.standardContext","type":"codeVoice"},{"type":"text","text":" is the standard context (app, device, locale, network, operating"},{"type":"text","text":" "},{"type":"text","text":"system) as JSON, and "},{"code":"flattened(separator:)","type":"codeVoice"},{"type":"text","text":" turns nested JSON into one level of dotted keys."}]}]},{"content":[{"inlineContent":[{"code":"Date.iso8601Timestamp","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Date.millisecondsSince1970()","type":"codeVoice"},{"type":"text","text":" are the two timestamp formats vendors"},{"type":"text","text":" "},{"type":"text","text":"take, both rounded down to the millisecond. The ISO 8601 form uses the proleptic Gregorian"},{"type":"text","text":" "},{"type":"text","text":"calendar for every date, as the standard does, dates before the reform of 1582 included."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EventRecord.pseudonymousIdentity"},{"type":"text","text":" is the record’s session, or the record itself when it has"},{"type":"text","text":" "},{"type":"text","text":"none, and "},{"type":"codeVoice","code":"EventRecord.deduplicationID"},{"type":"text","text":" the identifier a vendor drops repeats by."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit"},{"text":" splits a batch into requests of a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/JSONEnvelope"},{"text":" within a vendor’s limits on","type":"text"},{"text":" ","type":"text"},{"text":"records and bytes, and leaves out a record that fits in none of them as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":" ","type":"text"},{"text":"(module ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"text":").","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Properties, context and envelopes are "},{"type":"codeVoice","code":"JSON"},{"type":"text","text":" values, a type from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/JSONValues\/documentation\/JSONValues"},{"type":"text","text":" that a vendor"},{"type":"text","text":" "},{"type":"text","text":"module imports beside this one. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves both modules out."}],"type":"paragraph"},{"code":["import JSONValues","import PropertyJSON","import TrackingPlans","","let reader = PropertyReader(plan: plan)","let event: JSON = .object([","    \"name\": .string(record.name),","    \"id\": .string(record.deduplicationID),","    \"user\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","    \"at\": .integer(try record.timestamp.millisecondsSince1970()),","    \"properties\": .object(try reader.properties(of: record, includingSensitiveValues: false)),","    \"context\": .object(try record.standardContext.flattened()),","])"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination"},{"type":"text","text":" "},{"type":"text","text":"build