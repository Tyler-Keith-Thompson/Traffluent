"},{"text":" ","type":"text"},{"text":"records and bytes, and leaves out a record that fits in none of them as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":" ","type":"text"},{"text":"(module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Properties, context and envelopes are "},{"type":"codeVoice","code":"JSON"},{"type":"text","text":" values, a type from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/JSONValues\/documentation\/JSONValues"},{"type":"text","text":" that a vendor"},{"type":"text","text":" "},{"type":"text","text":"module imports beside this one. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves both modules out."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import JSONValues","import PropertyJSON","import TrackingPlans","","let reader = PropertyReader(plan: plan)","let event: JSON = .object([","    \"name\": .string(record.name),","    \"id\": .string(record.deduplicationID),","    \"user\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","    \"at\": .integer(try record.timestamp.millisecondsSince1970()),","    \"properties\": .object(try reader.properties(of: record, includingSensitiveValues: false)),","    \"context\": .object(try record.standardContext.flattened()),","])"]},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","type":"reference"},{"text":" ","type":"text"},{"text":"builds a whole encoder from these.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[[]]},"sections":[],"metadata":{"modules":[{"name":"PropertyJSON