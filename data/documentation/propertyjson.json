,"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A vendor destination’s encoder writes each record as the vendor’s JSON. This module has the parts"},{"type":"text","text":" "},{"type":"text","text":"every such encoder needs, so each vendor module writes only its own format:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader","isActive":true},{"type":"text","text":" reads an event’s properties through its schema in a "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"writes a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value only when asked to and the record reveals it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EventRecord.standardContext"},{"type":"text","text":" is the standard context (app, device, locale, network, operating"},{"type":"text","text":" "},{"type":"text","text":"system) as JSON, and "},{"type":"codeVoice","code":"flattened(separator:)"},{"type":"text","text":" turns nested JSON into one level of dotted keys."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Date.iso8601Timestamp"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Date.millisecondsSince1970()"},{"text":" are the two timestamp formats vendors","type":"text"},{"text":" ","type":"text"},{"text":"take, both rounded down to the millisecond. The ISO 8601 form uses the proleptic Gregorian","type":"text"},{"text":" ","type":"text"},{"text":"calendar for every date, as the standard does, dates before the reform of 1582 included.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"EventRecord.pseudonymousIdentity","type":"codeVoice"},{"text":" is the record’s session, or the record itself when it has","type":"text"},{"text":" ","type":"text"},{"text":"none, and ","type":"text"},{"code":"EventRecord.deduplicationID","type":"codeVoice"},{"text":" the identifier a vendor drops repeats by.","type":"text"}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit"},{"type":"text","text":" splits a batch into requests of a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/JSONEnvelope"},{"type":"text","text":" within a vendor’s limits on"},{"type":"text","text":" "},{"type":"text","text":"records and bytes, and leaves out a record that fits in none of them as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Properties, context and envelopes are "},{"code":"JSON","type":"codeVoice"},{"type":"text","text":" values, a type from "},{"identifier":"doc:\/\/JSONValues\/documentation\/JSONValues","type":"reference","isActive":true},{"type":"text","text":" that a vendor"},{"type":"text","text":" "},{"type":"text","text":"module imports beside this one. "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" leaves both modules out."}],"type":"paragraph"},{"code":["import JSONValues","import PropertyJSON","import TrackingPlans","","let reader = PropertyReader(plan: plan)","let event: JSON = .object([","    \"name\": .string(record.name),","    \"id\": .string(record.deduplicationID),","    \"user\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","    \"at\": .integer(try record.timestamp.millisecondsSince1970()),","    \"properties\": .object(try reader.properties(of: record, includingSensitiveValues: false)),","    \"context\": .object(try record.standardContext.flattened()),","])"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The guide ","type":"text"},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","isActive":true},{"text":" ","type":"text"},{"text":"builds a whole encoder from these.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://PropertyJSON/documentation/PropertyJSON/Events":{"role":"collection","title":"Events","kind":"symbol","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/Events","url":"\/documentation\/propertyjson\/events","type":"topic","abstract":[]},"doc://PropertyJSON/documentation/PropertyJSON/FoundationEssentials":{"role":"collection","title":"FoundationEssentials","kind":"symbol","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/FoundationEssentials","url":"\/documentation\/propertyjson\/foundationessentials","type":"topic","abstract":[]},"doc://PropertyJSON/documentation/PropertyJSON/UnrepresentableTimestamp":{"type":"topic","url":"\/documentation\/propertyjson\/unrepresentabletimestamp","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnrepresentableTimestamp"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"UnrepresentableTimestamp"}],"abstract":[{"type":"text","text":"A date that has no epoch-milliseconds or ISO 8601 timestamp: NaN, infinite, or further from"},{"type":"text","text":" "},{"type":"text","text":"1970 than "},{"type":"codeVoice","code":"Int64.max"},{"type":"text","text":" milliseconds (about 292 million years)."}],"title":"UnrepresentableTimestamp","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/UnrepresentableTimestamp"},"doc://PropertyJSON/documentation/PropertyJSON/InvalidBatchLimit":{"url":"\/documentation\/propertyjson\/invalidbatchlimit","navigatorTitle":[{"text":"Inva