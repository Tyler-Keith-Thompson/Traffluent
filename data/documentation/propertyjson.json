{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vendor destination’s encoder writes each record as the vendor’s JSON. This module has the parts"},{"type":"text","text":" "},{"type":"text","text":"every such encoder needs, so each vendor module writes only its own format:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader"},{"text":" reads an event’s properties through its schema in a ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"writes a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value only when asked to and the record reveals it.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"EventRecord.standardContext"},{"text":" is the standard context (app, device, locale, network, operating","type":"text"},{"text":" ","type":"text"},{"text":"system) as JSON, and ","type":"text"},{"type":"codeVoice","code":"flattened(separator:)"},{"text":" turns nested JSON into one level of dotted keys.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Date.iso8601Timestamp"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Date.millisecondsSince1970()"},{"text":" are the two timestamp formats vendors","type":"text"},{"text":" ","type":"text"},{"text":"take, both rounded down to the millisecond. The ISO 8601 form uses the proleptic Gregorian","type":"text"},{"text":" ","type":"text"},{"text":"calendar for every date, as the standard does, dates before the reform of 1582 included.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EventRecord.pseudonymousIdentity"},{"text":" is the record’s session, or the record itself when it has","type":"text"},{"text":" ","type":"text"},{"text":"none, and ","type":"text"},{"type":"codeVoice","code":"EventRecord.deduplicationID"},{"text":" the identifier a vendor drops repeats by.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","isActive":true},{"type":"text","text":" splits a batch into requests of a "},{"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/JSONEnvelope","isActive":true},{"type":"text","text":" within a vendor’s limits on"},{"type":"text","text":" "},{"type":"text","text":"records and bytes, and leaves out a record that fits in none of them as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":")."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties, context and envelopes are "},{"code":"JSON","type":"codeVoice"},{"type":"text","text":" values, a type from "},{"identifier":"doc:\/\/JSONValues\/documentation\/JSONValues","type":"reference","isActive":true},{"type":"text","text":" that a vendor"},{"type":"text","text":" "},{"type":"text","text":"module imports beside this one. "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" leaves both modules out."}]},{"type":"codeListing","syntax":"swift","code":["import JSONValues","import PropertyJSON","import TrackingPlans","","let reader = PropertyReader(plan: plan)","let event: JSON = .object([","    \"name\": .string(record.name),","    \"id\": .string(record.deduplicationID),","    \"user\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","    \"at\": .integer(try record.timestamp.millisecondsSince1970()),","    \"properties\": .object(try reader.properties(of: record, includingSensitiveValues: false)),","    \"context\": .object(try record.standardContext.flattened()),","])"]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","isActive":true},{"text":" ","type":"text"},{"text":"builds a whole encoder from these.","type":"text"}]}]}],"topicSections":[{"anchor":"Reading-properties","title":"Reading properties","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReadingError"]},{"anchor":"Context-and-identity","title":"Context and identity","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PseudonymousIdentity","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/FlattenedKeyCollision"]},{"anchor":"Timestamps","title":"Timestamps","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/UnrepresentableTimestamp"]},{"anchor":"Splitting-a-batch-into-requests","title":"Splitting a batch into requests","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/InvalidBatchLimit","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/JSONEnvelope"]},{"generated":true,"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/Events","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/FoundationEssentials","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/Swift"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON"},"kind":"symbol","abstract":[{"text":"The vendor-neutral pieces a JSON ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" is built from: properties, context, timestamps, identity and batch splitting.","t