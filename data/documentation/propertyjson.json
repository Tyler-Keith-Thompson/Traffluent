{"kind":"symbol","topicSections":[{"anchor":"Reading-properties","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReadingError"],"title":"Reading properties"},{"anchor":"Context-and-identity","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PseudonymousIdentity","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/FlattenedKeyCollision"],"title":"Context and identity"},{"anchor":"Timestamps","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/UnrepresentableTimestamp"],"title":"Timestamps"},{"anchor":"Splitting-a-batch-into-requests","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/InvalidBatchLimit","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/NegativeMaximumAge","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/JSONEnvelope"],"title":"Splitting a batch into requests"},{"generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/Events","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/FoundationEssentials","doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/Swift"],"title":"Extended Modules"}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A vendor destination’s encoder writes each record as the vendor’s JSON. This module has the parts"},{"type":"text","text":" "},{"type":"text","text":"every such encoder needs, so each vendor module writes only its own format:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader","type":"reference","isActive":true},{"type":"text","text":" reads an event’s properties through its schema in a "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"writes a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value only when asked to and the record reveals it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EventRecord.standardContext"},{"type":"text","text":" is the standard context (app, device, locale, network, operating"},{"type":"text","text":" "},{"type":"text","text":"system) as JSON, and "},{"type":"codeVoice","code":"flattened(separator:)"},{"type":"text","text":" turns nested JSON into one level of dotted keys."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Date.iso8601Timestamp"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Date.millisecondsSince1970()"},{"type":"text","text":" are the two timestamp formats vendors"},{"type":"text","text":" "},{"type":"text","text":"take, both rounded down to the millisecond. The ISO 8601 form uses the proleptic Gregorian"},{"type":"text","text":" "},{"type":"text","text":"calendar for every date, as the standard does, dates before the reform of 1582 included."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EventRecord.pseudonymousIdentity"},{"type":"text","text":" is the record’s session, or the record itself when it has"},{"type":"text","text":" "},{"type":"text","text":"none, and "},{"type":"codeVoice","code":"EventRecord.deduplicationID"},{"type":"text","text":" the identifier a vendor drops repeats by."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","isActive":true},{"type":"text","text":" splits a batch into requests of a "},{"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/JSONEnvelope","isActive":true},{"type":"text","text":" within a vendor’s limits on"},{"type":"text","text":" "},{"type":"text","text":"records and bytes, and leaves out a record that fits in none of them as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":")."}]}]}]},{"inlineContent":[{"type":"text","text":"Properties, context and envelopes are "},{"type":"codeVoice","code":"JSON"},{"type":"text","text":" values, a type from "},{"type":"reference","identifier":"doc:\/\/JSONValues\/documentation\/JSONValues","isActive":true},{"type":"text","text":" that a vendor"},{"type":"text","text":" "},{"type":"text","text":"module imports beside this one. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves both modules out."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import JSONValues","import PropertyJSON","import TrackingPlans","","let reader = PropertyReader(plan: plan)","let event: JSON = .object([","    \"name\": .string(record.name),","    \"id\": .string(record.deduplicationID),","    \"user\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","    \"at\": .integer(try record.timestamp.millisecondsSince1970()),","    \"properties\": .object(try reader.properties(of: record, includingSensitiveValues: false)),","    \"context\": .object(try record.standardContext.flattened()),","])"]},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination"},{"type":"text","text":" "},{"type":"text","text":"builds a whole encoder from these."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/propertyjson"]}],"section