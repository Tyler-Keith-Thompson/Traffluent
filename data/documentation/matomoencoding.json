{"topicSections":[{"title":"Sending to Matomo","anchor":"Sending-to-Matomo","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/HTTPDestinations\/HTTPDestination\/matomo(url:siteID:dimensions:category:plan:backoff:clock:now:)","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/HTTPDestinations\/HTTPDestination\/matomo(url:siteID:dimensions:category:plan:transport:backoff:clock:now:)","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError"]},{"title":"Custom dimensions","anchor":"Custom-dimensions","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoUnmappedProperty"]},{"title":"Encoding batches","anchor":"Encoding-batches","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder"]},{"title":"Records left out","anchor":"Records-left-out","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError"]}],"kind":"symbol","identifier":{"url":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/matomoencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/HTTPDestinations\/HTTPDestination\/matomo(url:siteID:dimensions:category:plan:backoff:clock:now:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"makes an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":") for one site of a Matomo installation in"},{"type":"text","text":" "},{"type":"text","text":"one call. It checks the installation’s URL, the site ID, the category and the custom dimensions,"},{"type":"text","text":" "},{"type":"text","text":"then posts bulk tracking requests to the installation’s "},{"code":"matomo.php","type":"codeVoice"},{"type":"text","text":" with a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","isActive":true},{"type":"text","text":". Each batch is split to "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":": 20 records a"},{"type":"text","text":" "},{"type":"text","text":"request, as Matomo’s iOS SDK sends them, and 1,000,000 bytes a request, under the 1 MiB that"},{"type":"text","text":" "},{"type":"text","text":"nginx takes in a body by default, as Matomo documents no limit. A batch with no record the encoder"},{"type":"text","text":" "},{"type":"text","text":"can write, an empty one included, makes no request. The destination retries no response, a 5xx,"},{"type":"text","text":" "},{"type":"text","text":"408 and 429, and drops and reports any other status. No trace context is sent. "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"leaves this module out, so import it on its own."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Matomo takes events from anyone who can reach it, so the destination needs no key, and builds on"},{"type":"text","text":" "},{"type":"text","text":"every platform: an app sends to Matomo directly."}]},{"type":"codeListing","code":["import HTTPDestinations","import MatomoEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let matomo = try HTTPDestination.matomo(","    url: url,  \/\/ where Matomo is installed: https:\/\/analytics.example.com","    siteID: 3,  \/\/ the app's site in Matomo","    dimensions: [\"plan\": 1],  \/\/ custom dimensions made in Matomo","    category: \"Shop\",  \/\/ each event's category","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: matomo)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"url","type":"codeVoice"},{"type":"text","text":" is where Matomo is installed, with its path if it has one"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"https:\/\/example.com\/matomo\/","type":"codeVoice"},{"type":"text","text":"), not the tracker’s endpoint: the destination appends "},{"code":"matomo.php","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"itself. The factory throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError"},{"type":"text","text":" for a URL that isn’t "},{"code":"https","type":"codeVoice"},{"type":"text","text":", has no host, holds a"},{"type":"text","text":" "},{"type":"text","text":"user name, password, query or fragment, or already ends in a "},{"code":".php","type":"codeVoice"},{"type":"text","text":" file such as "},{"code":"matomo.php","type":"codeVoice"},{"type":"text","text":"; for"},{"type":"text","text":" "},{"type":"text","text":"a site ID below 1; for a category that is empty once trimmed, or longer than the 4,096 characters"},{"type":"text","text":" "},{"type":"text","text":"Matomo stores; and for dimensions that break a rule, listed below."}]},{"type":"heading","text":"No token_auth","level":3,"anchor":"No-tokenauth"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination sends no "},{"type":"codeVoice","code":"token_auth"},{"type":"text","text":", and takes none. A token is a secret, and anything an app"},{"type":"text","text":" "},{"type":"text","text":"ships can be read out of it, so a token in an app gives anyone who has the app the token’s rights"},{"type":"text","text":" "},{"type":"text","text":"over your Matomo."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a token, Matomo takes an event’s time ("},{"code":"cdt","type":"codeVoice"},{"type":"text","text":") only when it is less than a day old, and"},{"type":"text","text":" "},{"type":"text","text":"refuses one more than a day ahead. It answers 200 to such a request all the same, and stores"},{"type":"text","text":" "},{"type":"text","text":"nothing, so the encoder leaves out every record tracked more than 23 hours before or after it"},{"type":"text","text":" "},{"type":"text","text":"encodes the batch, and the destination reports it, the hour to spare for a queue on the server and clocks that disagree. So a record that waits"},{"type":"text","text":" "},{"type":"text","text":"more than 23 hours to be encoded, kept by a store through a long time offline or waiting in the"},{"type":"text","text":" "},{"type":"text","text":"buffer behind a failing delivery, is reported as "},{"isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError\/timestampOutsideWindow","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"and never reaches Matomo."}]},{"type":"paragraph","inlineContent":[{"text":"A request is encoded once, and each retry sends the same bytes, so the encoder gives each request","type":"text"},{"text":" ","type":"text"},{"text":"a deadline 23 hours after its oldest record was tracked. A request still failing by then isn’t","type":"text"},{"text":" ","type":"text"},{"text":"sent again, as it would reach Matomo too late to be stored: the destination drops the whole","type":"text"},{"text":" ","type":"text"},{"text":"request, its younger records too, and reports it on ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":", with every one of its records’ identifiers. Only the past side of the window needs a deadline: a retry arrives later, never","type":"text"},{"text":" ","type":"text"},{"text":"earlier, so it can’t carry a record further ahead of Matomo’s clock than it was. The window is","type":"text"},{"text":" ","type":"text"},{"text":"measured with the device’s clock, which Matomo can’t see: a device whose clock is wrong by more","type":"text"},{"text":" ","type":"text"},{"text":"than a day has every record refused, without an error. A clock that reads NaN or infinite has","type":"text"},{"text":" ","type":"text"},{"text":"every record left out and reported.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To keep older records, send them to a server you run, such as a TraffluentCollector, and have"},{"type":"text","text":" "},{"type":"text","text":"that server forward them to Matomo with a token of a user who has write access to the site,"},{"type":"text","text":" "},{"type":"text","text":"added as "},{"type":"codeVoice","code":"token_auth"},{"type":"text","text":" to its bulk request’s JSON. A token on a server stays secret. This module"},{"type":"text","text":" "},{"type":"text","text":"doesn’t do that."}]},{"type":"heading","text":"Visitors are sessions","level":3,"anchor":"Visitors-are-sessions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Matomo counts a visitor per "},{"type":"codeVoice","code":"_id"},{"type":"text","text":", 16 hexadecimal digits. The destination sends the last 64 bits"},{"type":"text","text":" "},{"type":"text","text":"of the record’s session, from the sessions enricher, in lowercase hex. Nothing else identifies a"},{"type":"text","text":" "},{"type":"text","text":"record: no "},{"type":"codeVoice","code":"uid"},{"type":"text","text":", "},{"type":"codeVoice","code":"cid"},{"type":"text","text":", device identifier or account. So Matomo’s visitors are sessions, and"},{"type":"text","text":" "},{"type":"text","text":"its returning-visitor and visits-per-visitor reports say how long sessions last, not whether"},{"type":"text","text":" "},{"type":"text","text":"people come back. That is the library’s default, for privacy. Each session is one visit as long"},{"type":"text","text":" "},{"type":"text","text":"as the sessions enricher’s timeout is no longer than Matomo’s visit length, 30 minutes by default"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"visit_standard_length"},{"type":"text","text":"). With a longer timeout, a session that pauses for longer than Matomo’s"},{"type":"text","text":" "},{"type":"text","text":"visit length becomes two visits of one visitor."}]},{"type":"paragraph","inlineContent":[{"text":"A record with no session, such as one a store recovered after a relaunch, is its own visitor: its","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"_id"},{"text":" is the last 64 bits of the record’s identifier. Making up a session would join unrelated","type":"text"},{"text":" ","type":"text"},{"text":"records, and skipping the record would lose it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Matomo recognizes a visitor by "},{"code":"_id","type":"codeVoice"},{"type":"text","text":" and, failing that, by a fingerprint of the request’s IP"},{"type":"text","text":" "},{"type":"text","text":"address, User-Agent, language and a daily salt, within 30 minutes. A new session’s first event"},{"type":"text","text":" "},{"type":"text","text":"has an "},{"code":"_id","type":"codeVoice"},{"type":"text","text":" Matomo hasn’t seen, so Matomo may fold it into another visit from the same address"},{"type":"text","text":" "},{"type":"text","text":"and User-Agent: an earlier session on the same device, or a session of another person behind the"},{"type":"text","text":" "},{"type":"text","text":"same network. Set "},{"code":"trust_visitors_cookies = 1","type":"codeVoice"},{"type":"text","text":" under "},{"code":"[Tracker]","type":"codeVoice"},{"type":"text","text":" in Matomo’s "},{"code":"config.ini.php","type":"codeVoice"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"have Matomo match a request that has an "},{"code":"_id","type":"codeVoice"},{"type":"text","text":" by its "},{"code":"_id","type":"codeVoice"},{"type":"text","text":" alone, for every site of the"},{"type":"text","text":" "},{"type":"text","text":"installation. When Matomo’s privacy setting"},{"type":"text","text":" "},{"type":"text","text":"to force tracking without cookies is on, Matomo ignores "},{"code":"_id","type":"codeVoice"},{"type":"text","text":", and every visit is the"},{"type":"text","text":" "},{"type":"text","text":"fingerprint’s."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Matomo records the address each request comes from, as no app can override it without a token."},{"type":"text","text":" "},{"type":"text","text":"It masks part of the address before storing it when “Anonymize Visitors’ IP addresses” is on"},{"type":"text","text":" "},{"type":"text","text":"(Administration, Privacy, Anonymize data). In Matomo 5.14 and 6.0 it is on, masking 2 bytes, for"},{"type":"text","text":" "},{"type":"text","text":"an installation whose administrator has never changed it, so a fresh install has it on, and an"},{"type":"text","text":" "},{"type":"text","text":"older one keeps the setting it had. Matomo still uses the full address for geolocation and for"},{"type":"text","text":" "},{"type":"text","text":"the fingerprint above unless “Also use the Anonymized IP addresses when enriching visits” is on"},{"type":"text","text":" "},{"type":"text","text":"too, which is off by default. Check both settings before you send."}]},{"type":"heading","text":"What Matomo receives","level":3,"anchor":"What-Matomo-receives"},{"type":"paragraph","inlineContent":[{"text":"Each request is a JSON object, ","type":"text"},{"code":"{\"requests\":[…]}","type":"codeVoice"},{"text":", holding one tracking request per record, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first: ","type":"text"},{"code":"?","type":"codeVoice"},{"text":" and a query string, every value percent-encoded but for letters, digits, ","type":"text"},{"code":"-","type":"codeVoice"},{"text":", ","type":"text"},{"code":".","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"~","type":"codeVoice"},{"text":". Each tracking request is a Matomo event:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Parameter","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"idsite"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The site ID"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"rec","type":"codeVoice"},{"text":", ","type":"text"},{"code":"apiv","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"1"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The session’s last 64 bits, or the record’s"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cdt"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s time, in whole seconds since 1970"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ca"}]}],[{"type":"paragraph","inlineContent":[{"code":"1","type":"codeVoice"},{"type":"text","text":", so Matomo doesn’t take the request for a page view should its Events plugin be off"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"e_c","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The category you give, such as your app’s name","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"e_a","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s name"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"lang","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s locale, as a BCP 47 identifier, when it has ","type":"text"},{"code":"LocaleKey","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dimension<ID>"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value of each property the dimensions map"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Matomo’s Events reports group events by category, then action, then name. The category is the"},{"type":"text","text":" "},{"type":"text","text":"argument you give, as an app’s events have no grouping Matomo would show better, and the action is"},{"type":"text","text":" "},{"type":"text","text":"the event’s name, so the Event Actions report lists your events. No event name ("},{"type":"codeVoice","code":"e_n"},{"type":"text","text":") or value"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"e_v"},{"type":"text","text":") is sent."}]},{"type":"paragraph","inlineContent":[{"text":"The User-Agent is the one ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" sends, which Matomo reads for the device and operating","type":"text"},{"text":" ","type":"text"},{"text":"system. The rest of the standard context isn’t sent.","type":"text"}]},{"type":"heading","text":"Custom dimensions","level":3,"anchor":"Custom-dimensions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Matomo numbers each site’s custom dimensions as you make them (Administration, Websites, Custom"},{"type":"text","text":" "},{"type":"text","text":"Dimensions), so "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions","isActive":true},{"type":"text","text":" maps your plan’s property names to their IDs:"},{"type":"text","text":" "},{"type":"codeVoice","code":"[\"plan\": 1, \"seats\": 2]"},{"type":"text","text":". A property is mapped by name in every event that has it. Its value is"},{"type":"text","text":" "},{"type":"text","text":"read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":": a string as it is, a number as JSON writes"},{"type":"text","text":" "},{"type":"text","text":"it, a Boolean as "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and an array or object as its JSON. A "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" sends no value."},{"type":"text","text":" "},{"type":"text","text":"A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" property is never sent, whatever the record reveals, so it can’t be mapped."}]},{"type":"paragraph","inlineContent":[{"text":"A property no dimension is mapped to is never sent, and the record goes without it. When the","type":"text"},{"text":" ","type":"text"},{"text":"destination is made, it logs a notice for each event with such properties, once.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/unmappedProperties(in:)","isActive":true,"type":"reference"},{"text":" lists them, so a test can check that every property","type":"text"},{"text":" ","type":"text"},{"text":"you mean to send has a dimension.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The factory throws for a dimension ID below 1, a property mapped twice, a property no event of the"},{"type":"text","text":" "},{"type":"text","text":"plan has, a property that is "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" in an event, and two properties of one event mapped to"},{"type":"text","text":" "},{"type":"text","text":"one dimension, checked in that order."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make each dimension in Matomo with the Action scope, so each event keeps its own value. A"},{"type":"text","text":" "},{"type":"text","text":"dimension of the Visit scope holds one value a visit, the last one sent. Matomo ignores a"},{"type":"text","text":" "},{"type":"text","text":"dimension it has no dimension of that ID for, and stores at most 250 characters of a value."}]},{"type":"heading","text":"Records left out","level":3,"anchor":"Records-left-out"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write, or that Matomo would refuse or change, is left out and the rest"},{"type":"text","text":" "},{"type":"text","text":"of the batch is sent:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"one the plan doesn’t describe, whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", or that holds a value JSON can’t;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose event name is empty once Matomo removes line breaks and trims it, or longer than the","type":"text"},{"text":" ","type":"text"},{"text":"4,096 characters Matomo stores of an action;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose timestamp has no whole seconds of ","type":"text"},{"code":"Int64","type":"codeVoice"},{"text":", or is more than 23 hours from when the batch","type":"text"},{"text":" ","type":"text"},{"text":"is encoded;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one with a dimension’s value longer than 250 characters;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose tracking request is more than a request of 1,000,000 bytes can hold."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lengths are counted as Matomo stores the text: without line breaks or NUL characters, trimmed of"},{"type":"text","text":" "},{"type":"text","text":"spaces and tabs at either end, and with "},{"type":"codeVoice","code":"&"},{"type":"text","text":", "},{"type":"codeVoice","code":"<"},{"type":"text","text":", "},{"type":"codeVoice","code":">"},{"type":"text","text":", "},{"type":"codeVoice","code":"\""},{"type":"text","text":" and "},{"type":"codeVoice","code":"'"},{"type":"text","text":" written as the HTML entities"},{"type":"text","text":" "},{"type":"text","text":"Matomo stores them as, so "},{"type":"codeVoice","code":"&"},{"type":"text","text":" counts 5. Matomo removes the line breaks and trims the spaces of a"},{"type":"text","text":" "},{"type":"text","text":"name or value it keeps too."}]},{"type":"paragraph","inlineContent":[{"text":"The destination reports each as ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" whose reason is a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError","isActive":true,"type":"reference"},{"text":". When the destination is made, it logs a notice for each event of the plan","type":"text"},{"text":" ","type":"text"},{"text":"whose name would be left out.","type":"text"}]},{"type":"heading","text":"What Matomo doesn’t report","level":3,"anchor":"What-Matomo-doesnt-report"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Matomo answers 200 to a bulk request it can read, whatever its tracking requests hold. One it"},{"type":"text","text":" "},{"type":"text","text":"refuses is counted as "},{"code":"invalid","type":"codeVoice"},{"type":"text","text":" in the answer’s JSON and not stored, and only a request with a"},{"type":"text","text":" "},{"type":"text","text":"token learns which. So a wrong site ID, a site that doesn’t exist, and events of a time Matomo"},{"type":"text","text":" "},{"type":"text","text":"refuses are lost without an error. Check that the first events show up in the site’s Visits Log."},{"type":"text","text":" "},{"type":"text","text":"A server set to require a token for every bulk request ("},{"code":"bulk_requests_require_authentication","type":"codeVoice"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"refuses each one: Matomo 6.0 answers 400, which the destination drops and reports, and Matomo 5.14"},{"type":"text","text":" "},{"type":"text","text":"answers 500, which the destination retries until the request is cancelled. Leave that setting"},{"type":"text","text":" "},{"type":"text","text":"off."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Matomo doesn’t remove duplicates. A record is sent more than once when a request is retried after"},{"type":"text","text":" "},{"type":"text","text":"Matomo stored it but the answer was lost, when a delivery sends a cancelled batch again, and when"},{"type":"text","text":" "},{"type":"text","text":"a store redelivers records after a relaunch, and Matomo counts each copy."}]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"text":" ","type":"text"},{"text":"covers what Matomo receives, and why, in more detail.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"Send records to a Matomo installation as events, through its bulk tracking API.","type":"text"}],"metadata":{"roleHeading":"Framework","role":"collection","modules":[{"name":"MatomoEncoding"}],"externalID":"MatomoEncoding","title":"MatomoEncoding","symbolKind":"module"},"references":{"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MatomoBatchEncoder"}],"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","url":"\/documentation\/matomoencoding\/matomobatchencoder","abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Matomo’s bulk tracking API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to a Matomo installation’s "},{"type":"codeVoice","code":"POST \/matomo.php"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MatomoBatchEncoder"}],"type":"topic","title":"MatomoBatchEncoder"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoDimensions":{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions","abstract":[{"text":"Which of Matomo’s custom dimensions each property of a tracking plan is sent as, by the","type":"text"},{"text":" ","type":"text"},{"text":"property’s name and the dimension’s ID.","type":"text"}],"title":"MatomoDimensions","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MatomoDimensions"}],"url":"\/documentation\/matomoencoding\/matomodimensions","navigatorTitle":[{"kind":"identifier","text":"MatomoDimensions"}],"role":"symbol"},"doc://MatomoEncoding/documentation/MatomoEncoding/HTTPDestinations/HTTPDestination/matomo(url:siteID:dimensions:category:plan:backoff:clock:now:)":{"kind":"symbol","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"URLSessionTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"cod