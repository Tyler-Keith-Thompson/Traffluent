{"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:transport:backoff:clock:)","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapRegion","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapSetupError"],"title":"Sending to Heap","anchor":"Sending-to-Heap"},{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError"],"title":"Records left out","anchor":"Records-left-out"}],"metadata":{"modules":[{"name":"HeapEncoding"}],"roleHeading":"Framework","role":"collection","title":"HeapEncoding","externalID":"HeapEncoding","symbolKind":"module"},"variants":[{"paths":["\/documentation\/heapencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Send records to Heap as custom events, through its server-side bulk track API."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":" makes an"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"type":"text","text":") for Heap in one call. It checks your"},{"type":"text","text":" "},{"type":"text","text":"environment’s app ID, then posts to the track endpoint of your project’s data center,"},{"type":"text","text":" "},{"code":"https:\/\/heapanalytics.com\/api\/track","type":"codeVoice"},{"type":"text","text":" or, for the EU, "},{"code":"https:\/\/c.eu.heap-api.com\/api\/track","type":"codeVoice"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"a "},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","type":"reference","isActive":true},{"type":"text","text":". Each batch is split to "},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","type":"reference","isActive":true},{"type":"text","text":": 1,000 events a"},{"type":"text","text":" "},{"type":"text","text":"request, the most Heap’s bulk track API takes, and 1,000,000 bytes a request, the encoder’s own"},{"type":"text","text":" "},{"type":"text","text":"bound, as Heap documents none. A batch with no record the encoder can write, an empty one"},{"type":"text","text":" "},{"type":"text","text":"included, makes no request. The destination retries no response, a 5xx, 408 and 429, and drops and"},{"type":"text","text":" "},{"type":"text","text":"reports any other status. No trace context is sent. "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" leaves this module out, so"},{"type":"text","text":" "},{"type":"text","text":"import it on its own."}],"type":"paragraph"},{"inlineContent":[{"text":"Heap’s server-side API complements its SDKs: Heap says “you can only send events to identified","type":"text"},{"text":" ","type":"text"},{"text":"users”. Every user this destination makes has only server-side events, and Heap treats such a user","type":"text"},{"text":" ","type":"text"},{"text":"differently from one its SDKs capture:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"the user’s profile says its events are hidden, and Heap lists them under the Hidden Events"},{"type":"text","text":" "},{"type":"text","text":"category of its Events tab;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the events aren’t sessionized, so Heap’s Sessions list stays empty for them;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a session filter on a user property sees only SDK sessions, so it matches none of them."}]}]}]},{"inlineContent":[{"text":"So checking that events reach Heap’s Live data feed isn’t enough: after setting the destination","type":"text"},{"text":" ","type":"text"},{"text":"up, confirm that its events appear in the charts and reports you mean to use.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The track API takes the app ID alone, which Heap’s own SDKs ship inside every app, and no API key,","type":"text"},{"text":" ","type":"text"},{"text":"so the destination builds on every platform and an app sends to Heap directly. Heap’s API key is","type":"text"},{"text":" ","type":"text"},{"text":"for its user deletion API, which this module doesn’t call; don’t put one in an app.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import HTTPDestinations","import HeapEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let heap = try HTTPDestination.heap(","    appID: appID,  \/\/ the environment's ID, from Heap's project settings","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: heap)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The factory throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapSetupError"},{"type":"text","text":" for an app ID that is empty or only whitespace, and for one"},{"type":"text","text":" "},{"type":"text","text":"holding anything but ASCII digits: a Heap environment’s ID is a number, such as "},{"type":"codeVoice","code":"12343283"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"region"},{"type":"text","text":" has no default. Pass "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapRegion\/eu"},{"type":"text","text":" when your project’s data is in Heap’s EU data"},{"type":"text","text":" "},{"type":"text","text":"center."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Users are sessions","anchor":"Users-are-sessions"},{"inlineContent":[{"type":"text","text":"Heap files each event under its "},{"type":"codeVoice","code":"identity"},{"type":"text","text":", and makes a user for each identity it hasn’t seen. The"},{"type":"text","text":" "},{"type":"text","text":"destination sends the record’s session, from the sessions enricher, as the identity: its"},{"type":"text","text":" "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" as a lowercase UUID. Nothing else identifies a record: no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"vendor identifier, device identifier or account, and no trace context."}],"type":"paragraph"},{"inlineContent":[{"text":"So Heap’s users are sessions. A person who opens the app three times is three users, and Heap’s","type":"text"},{"text":" ","type":"text"},{"text":"retention and user counts describe sessions, not people. That is the library’s default, for","type":"text"},{"text":" ","type":"text"},{"text":"privacy. To count","type":"text"},{"text":" ","type":"text"},{"text":"devices or accounts instead, write your own enricher and encoder that send the identifier you","type":"text"},{"text":" ","type":"text"},{"text":"choose; this encoder sends the session alone.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A record with no session, such as one a store recovered after a relaunch, is its own user: its","type":"text"},{"text":" ","type":"text"},{"text":"identity is the record’s identifier. Making up a session would join unrelated records, skipping","type":"text"},{"text":" ","type":"text"},{"text":"the record would lose it, and Heap takes no event without an identity.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"What Heap receives","anchor":"What-Heap-receives"},{"inlineContent":[{"text":"Each request is a JSON object: ","type":"text"},{"type":"codeVoice","code":"app_id"},{"text":", as given, without surrounding whitespace, and ","type":"text"},{"type":"codeVoice","code":"events"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"one track event per record. Every event has:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"event","type":"codeVoice"},{"type":"text","text":", the event’s name;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"identity","type":"codeVoice"},{"text":", the session;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"idempotency_key"},{"text":", the record’s identifier, so Heap stores a record sent twice under the same","type":"text"},{"text":" ","type":"text"},{"text":"identity once. A record a store recovers after a relaunch keeps no context, so it goes under","type":"text"},{"text":" ","type":"text"},{"text":"its own identifier rather than its session, and Heap may store it twice;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"},{"type":"text","text":", the record’s timestamp in ISO 8601 with milliseconds, so an event sent late still"},{"type":"text","text":" "},{"type":"text","text":"counts at the time it was tracked;"}]}]},{"content":[{"inlineContent":[{"code":"properties","type":"codeVoice"},{"text":", when the event has any to send.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The record’s properties are read through the event’s schema in the ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":" the encoder is","type":"text"},{"text":" ","type":"text"},{"text":"made with. Heap takes a number or a string as a property’s value, so an object or array is","type":"text"},{"text":" ","type":"text"},{"text":"flattened into dotted names: a ","type":"text"},{"type":"codeVoice","code":"cart"},{"text":" holding ","type":"text"},{"type":"codeVoice","code":"size"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"cart.size"},{"text":", and the first element of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"tags"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"tags.0"},{"text":". A boolean is the string ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", a number keeps its JSON type, and a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" property is left out. A ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value is never sent, whatever the record reveals.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The standard context isn’t sent. Heap keeps no built-in property of an event sent through its"},{"type":"text","text":" "},{"type":"text","text":"server-side API, so the app’s version or the device’s model would sit among the event’s own"},{"type":"text","text":" "},{"type":"text","text":"properties, where they could collide with your own names."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Records left out","anchor":"Records-left-out"},{"inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"one the plan doesn’t describe, whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", or that holds a value JSON can’t;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose event name is longer than the 1,024 characters Heap takes;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one with a property named "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":" or "},{"type":"codeVoice","code":"screen_name"},{"type":"text","text":", which Heap reserves: the"},{"type":"text","text":" "},{"type":"text","text":"first two are fields of a track request, and the last is the screen name its mobile SDKs"},{"type":"text","text":" "},{"type":"text","text":"capture. A name like one, such as "},{"type":"codeVoice","code":"User_id"},{"type":"text","text":" or "},{"type":"codeVoice","code":"screen_name.0"},{"type":"text","text":", is sent."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one with a property, once flattened, whose name or string value is 1,024 characters or more:","type":"text"},{"text":" ","type":"text"},{"text":"Heap takes fewer. Characters are counted in UTF-16, as JavaScript counts them, so an emoji","type":"text"},{"text":" ","type":"text"},{"text":"counts two.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose values flatten to the same name twice;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose timestamp falls outside the years 1 to 9999, which have no four-digit ISO 8601 year;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one too large for a request of 1,000,000 bytes on its own.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The destination reports each as "},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"type":"text","text":", a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" whose reason is a"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","type":"reference"},{"type":"text","text":". When the destination is made, it logs a notice for each event and property"},{"type":"text","text":" "},{"type":"text","text":"of the plan whose name would be left out."}],"type":"paragraph"},{"type":"heading","level":3,"text":"What Heap doesn’t report","anchor":"What-Heap-doesnt-report"},{"inlineContent":[{"text":"Heap answers 200 to a request it takes and 400 to one it can’t, which the destination drops and","type":"text"},{"text":" ","type":"text"},{"text":"reports with every record of the request. Its docs don’t say what it answers to an app ID of no","type":"text"},{"text":" ","type":"text"},{"text":"environment, so confirm that the first events appear in your charts after setting it up.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Heap takes 15,000 events a minute from one environment, and every device sending to it shares"},{"type":"text","text":" "},{"type":"text","text":"that limit: at a steady rate it is about 21.6 million events a day across all your users, and a"},{"type":"text","text":" "},{"type":"text","text":"burst, such as many devices sending their backlogs at once, reaches it sooner. Heap’s docs don’t"},{"type":"text","text":" "},{"type":"text","text":"say what it answers past the limit. If it answers 429, the destination retries the request on its"},{"type":"text","text":" "},{"type":"text","text":"backoff, without jitter and without reading "},{"code":"Retry-After","type":"codeVoice"},{"type":"text","text":", so devices retry on the same schedule"},{"type":"text","text":" "},{"type":"text","text":"and a backlog can grow rather than shrink. If it answers 400, the destination drops the whole"},{"type":"text","text":" "},{"type":"text","text":"request and reports it as rejected, and its records are lost."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Heap also takes 30 requests in 30 seconds and 1,000 events a minute from one identity, which is"},{"type":"text","text":" "},{"type":"text","text":"one session here. A session whose own backlog holds more than 1,000 events, such as one that ran"},{"type":"text","text":" "},{"type":"text","text":"long offline, goes past it when it sends, with the same outcomes. A smaller batch wouldn’t avoid"},{"type":"text","text":" "},{"type":"text","text":"that, as the destination doesn’t pace its requests, so requests keep Heap’s bulk maximum of 1,000"},{"type":"text","text":" "},{"type":"text","text":"events."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Events sent through the server-side API carry only the properties sent with them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers what Heap receives, and why, in more detail."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://HeapEncoding/documentation/HeapEncoding/HTTPDestinations/HTTPDestination/heap(appID:region:plan:transport:backoff:clock:)":{"title":"heap(appID:region:plan:transport:backoff:clock:)","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/heapencoding\/httpdestinations\/httpdestination\/heap(appid:region:plan:transport:backoff:clock:)","abstract":[{"type":"text","text":"A destination that sends batches to the Heap environment "},{"code":"appID","type":"codeVoice"},{"type":"text","text":", whose data resides in"},{"type":"text","text":" "},{"code":"region","type":"codeVoice"},{"type":"text","text":", through "},{"code":"transport","type":"codeVoice"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" on "},{"code":"clock","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"heap"},{"kind":"text","text":"("},{"kind":"externalParam","text":"appID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"HeapRegion","preciseIdentifier":"s:12HeapEncoding0A6RegionO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"HeapSetupError","preciseIdentifier":"s:12HeapEncoding0A10SetupErrorO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"HeapBatchEncoder","preciseIdentifier":"s:12HeapEncoding0A12BatchEncoderV"},{"kind":"text","text":">"}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:transport:backoff:clock:)"},"doc://HeapEncoding/documentation/HeapEncoding/HeapEncodingError":{"role":"symbol","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s requests as","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no record of a","type":"text"},{"text":" ","type":"text"},{"text":"batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapEncodingError"}],"navigatorTitle":[{"kind":"identifier","text":"HeapEncodingError"}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","kind":"symbol","url":"\/documentation\/heapencoding\/heapencodingerror","type":"topic","title":"HeapEncodingError"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/httpdestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://HeapEncoding/documentation/HeapEncoding/HeapRegion":{"navigatorTitle":[{"text":"HeapRegion","kind":"identifier"}],"title":"HeapRegion","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapRegion","kind":"identifier"}],"type":"topic","url":"\/documentation\/heapencoding\/heapregion","abstract":[{"text":"The data center a Heap project’s data resides in, which decides the track endpoint its events","type":"text"},{"text":" ","type":"text"},{"text":"are posted to.","type":"text"}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapRegion","kind":"symbol","role":"symbol"},"doc://HeapEncoding/documentation/HeapEncoding/HeapRegion/eu":{"title":"HeapRegion.eu","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"eu"}],"type":"topic","abstract":[{"text":"Heap’s EU data center: ","type":"text"},{"code":"https:\/\/c.eu.heap-api.com","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/heapencoding\/heapregion\/eu","kind":"symbol","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapRegion\/eu","role":"symbol"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/init(appID:plan:limit:)":{"url":"\/documentation\/heapencoding\/heapbatchencoder\/init(appid:plan:limit:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"appID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"limit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"(