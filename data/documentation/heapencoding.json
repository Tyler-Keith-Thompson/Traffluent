{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Framework","modules":[{"name":"HeapEncoding"}],"externalID":"HeapEncoding","role":"collection","symbolKind":"module","title":"HeapEncoding"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/heapencoding"]}],"identifier":{"url":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[[]]},"sections":[],"topicSections":[{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:transport:backoff:clock:)","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapRegion","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapSetupError"],"title":"Sending to Heap","anchor":"Sending-to-Heap"},{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError"],"title":"Records left out","anchor":"Records-left-out"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)","isActive":true},{"text":" makes an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"text":") for Heap in one call. It checks your","type":"text"},{"text":" ","type":"text"},{"text":"environment’s app ID, then posts to the track endpoint of your project’s data center,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"https:\/\/heapanalytics.com\/api\/track"},{"text":" or, for the EU, ","type":"text"},{"type":"codeVoice","code":"https:\/\/c.eu.heap-api.com\/api\/track"},{"text":", with","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","isActive":true},{"text":". Each batch is split to ","type":"text"},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","isActive":true},{"text":": 1,000 events a","type":"text"},{"text":" ","type":"text"},{"text":"request, the most Heap’s bulk track API takes, and 1,000,000 bytes a request, the encoder’s own","type":"text"},{"text":" ","type":"text"},{"text":"bound, as Heap documents none. A batch with no record the encoder can write, an empty one","type":"text"},{"text":" ","type":"text"},{"text":"included, makes no request. The destination retries no response, a 5xx, 408 and 429, and drops and","type":"text"},{"text":" ","type":"text"},{"text":"reports any other status. No trace context is sent. ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves this module out, so","type":"text"},{"text":" ","type":"text"},{"text":"import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Heap’s server-side API complements its SDKs: Heap says “you can only send events to identified"},{"type":"text","text":" "},{"type":"text","text":"users”. Every user this destination makes has only server-side events, and Heap treats such a user"},{"type":"text","text":" "},{"type":"text","text":"differently from one its SDKs capture:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the user’s profile says its events are hidden, and Heap lists them under the Hidden Events"},{"type":"text","text":" "},{"type":"text","text":"category of its Events tab;"}]}]},{"content":[{"inlineContent":[{"text":"the events aren’t sessionized, so Heap’s Sessions list stays empty for them;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a session filter on a user property sees only SDK sessions, so it matches none of them.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"So checking that events reach Heap’s Live data feed isn’t enough: after setting the destination","type":"text"},{"text":" ","type":"text"},{"text":"up, confirm that its events appear in the charts and reports you mean to use.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The track API takes the app ID alone, which Heap’s own SDKs ship inside every app, and no API key,"},{"type":"text","text":" "},{"type":"text","text":"so the destination builds on every platform and an app sends to Heap directly. Heap’s API key is"},{"type":"text","text":" "},{"type":"text","text":"for its user deletion API, which this module doesn’t call; don’t put one in an app."}]},{"syntax":"swift","type":"codeListing","code":["import HTTPDestinations","import HeapEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let heap = try HTTPDestination.heap(","    appID: appID,  \/\/ the environment's ID, from Heap's project settings","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: heap)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The factory throws "},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapSetupError","type":"reference","isActive":true},{"type":"text","text":" for an app ID that is empty or only whitespace, and for one"},{"type":"text","text":" "},{"type":"text","text":"holding anything but ASCII digits: a Heap environment’s ID is a number, such as "},{"type":"codeVoice","code":"12343283"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"region"},{"type":"text","text":" has no default. Pass "},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapRegion\/eu","type":"reference","isActive":true},{"type":"text","text":" when your project’s data is in Heap’s EU data"},{"type":"text","text":" "},{"type":"text","text":"center."}]},{"type":"heading","text":"Users are sessions","level":3,"anchor":"Users-are-sessions"},{"type":"paragraph","inlineContent":[{"text":"Heap files each event under its ","type":"text"},{"code":"identity","type":"codeVoice"},{"text":", and makes a user for each identity it hasn’t seen. The","type":"text"},{"text":" ","type":"text"},{"text":"destination sends the record’s session, from the sessions enricher, as the identity: its","type":"text"},{"text":" ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":" as a lowercase UUID. Nothing else identifies a record: no ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"vendor identifier, device identifier or account, and no trace context.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"So Heap’s users are sessions. A person who opens the app three times is three users, and Heap’s"},{"type":"text","text":" "},{"type":"text","text":"retention and user counts describe sessions, not people. That is the library’s default, for"},{"type":"text","text":" "},{"type":"text","text":"privacy. To count"},{"type":"text","text":" "},{"type":"text","text":"devices or accounts instead, write your own enricher and encoder that send the identifier you"},{"type":"text","text":" "},{"type":"text","text":"choose; this encoder sends the session alone."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record with no session, from a tracker without the sessions enricher, is its own user: its"},{"type":"text","text":" "},{"type":"text","text":"identity is the record’s identifier. A record a store recovered after a relaunch keeps its session. Making up a session would join unrelated records, skipping"},{"type":"text","text":" "},{"type":"text","text":"the record would lose it, and Heap takes no event without an identity."}]},{"type":"heading","text":"What Heap receives","level":3,"anchor":"What-Heap-receives"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each request is a JSON object: "},{"code":"app_id","type":"codeVoice"},{"type":"text","text":", as given, without surrounding whitespace, and "},{"code":"events","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"one track event per record. Every event has:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"event"},{"type":"text","text":", the event’s name;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"identity"},{"type":"text","text":", the session;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"idempotency_key","type":"codeVoice"},{"type":"text","text":", the record’s identifier, so Heap stores a record sent twice under the same"},{"type":"text","text":" "},{"type":"text","text":"identity once. A record a store recovers after a relaunch keeps its session, so it goes under"},{"type":"text","text":" "},{"type":"text","text":"the identity of its first send, and Heap stores it once;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"},{"type":"text","text":", the record’s timestamp in ISO 8601 with milliseconds, so an event sent late still"},{"type":"text","text":" "},{"type":"text","text":"counts at the time it was tracked;"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"properties"},{"type":"text","text":", when the event has any to send."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The record’s properties are read through the event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is","type":"text"},{"text":" ","type":"text"},{"text":"made with. Heap takes a number or a string as a property’s value, so an object or array is","type":"text"},{"text":" ","type":"text"},{"text":"flattened into dotted names: a ","type":"text"},{"code":"cart","type":"codeVoice"},{"text":" holding ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"cart.size","type":"codeVoice"},{"text":", and the first element of","type":"text"},{"text":" ","type":"text"},{"code":"tags","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"tags.0","type":"codeVoice"},{"text":". A boolean is the string ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", a number keeps its JSON type, and a","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" property is left out. A ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is never sent, whatever the record reveals.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The standard context isn’t sent. Heap keeps no built-in property of an event sent through its","type":"text"},{"text":" ","type":"text"},{"text":"server-side API, so the app’s version or the device’s model would sit among the event’s own","type":"text"},{"text":" ","type":"text"},{"text":"properties, where they could collide with your own names.","type":"text"}]},{"type":"heading","text":"Records left out","level":3,"anchor":"Records-left-out"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"one the plan doesn’t describe, whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", or that holds a value JSON can’t;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one whose event name is longer than the 1,024 characters Heap takes;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one with a property named "},{"code":"user_id","type":"codeVoice"},{"type":"text","text":", "},{"code":"session_id","type":"codeVoice"},{"type":"text","text":" or "},{"code":"screen_name","type":"codeVoice"},{"type":"text","text":", which Heap reserves: the"},{"type":"text","text":" "},{"type":"text","text":"first two are fields of a track request, and the last is the screen name its mobile SDKs"},{"type":"text","text":" "},{"type":"text","text":"capture. A name like one, such as "},{"code":"User_id","type":"codeVoice"},{"type":"text","text":" or "},{"code":"screen_name.0","type":"codeVoice"},{"type":"text","text":", is sent."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one with a property, once flattened, whose name or string value is 1,024 characters or more:"},{"type":"text","text":" "},{"type":"text","text":"Heap takes fewer. Characters are counted in UTF-16, as JavaScript counts them, so an emoji"},{"type":"text","text":" "},{"type":"text","text":"counts two."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose values flatten to the same name twice;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose timestamp falls outside the years 1 to 9999, which have no four-digit ISO 8601 year;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one too large for a request of 1,000,000 bytes on its own."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination reports each as "},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"type":"text","text":", a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" whose reason is a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError"},{"type":"text","text":". When the destination is made, it logs a notice for each event and property"},{"type":"text","text":" "},{"type":"text","text":"of the plan whose name would be left out."}]},{"type":"heading","text":"What Heap doesn’t report","level":3,"anchor":"What-Heap-doesnt-report"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Heap answers 200 to a request it takes and 400 to one it can’t, which the destination drops and"},{"type":"text","text":" "},{"type":"text","text":"reports with every record of the request. Its docs don’t say what it answers to an app ID of no"},{"type":"text","text":" "},{"type":"text","text":"environment, so confirm that the first events appear in your charts after setting it up."}]},{"type":"paragraph","inlineContent":[{"text":"Heap takes 15,000 events a minute from one environment, and every device sending to it shares","type":"text"},{"text":" ","type":"text"},{"text":"that limit: at a steady rate it is about 21.6 million events a day across all your users, and a","type":"text"},{"text":" ","type":"text"},{"text":"burst, such as many devices sending their backlogs at once, reaches it sooner. Heap’s docs don’t","type":"text"},{"text":" ","type":"text"},{"text":"say what it answers past the limit. If it answers 429, the destination retries the request on its","type":"text"},{"text":" ","type":"text"},{"text":"backoff, with full jitter, so devices refused together retry at different moments. It doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"read ","type":"text"},{"code":"Retry-After","type":"codeVoice"},{"text":", though, so a backlog can still grow. If it answers 400, the destination drops","type":"text"},{"text":" ","type":"text"},{"text":"the whole request and reports it as rejected, and its records are lost.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Heap also takes 30 requests in 30 seconds and 1,000 events a minute from one identity, which is","type":"text"},{"text":" ","type":"text"},{"text":"one session here. A session whose own backlog holds more than 1,000 events, such as one that ran","type":"text"},{"text":" ","type":"text"},{"text":"long offline, goes past it when it sends, with the same outcomes. A smaller batch wouldn’t avoid","type":"text"},{"text":" ","type":"text"},{"text":"that, as the destination doesn’t pace its requests, so requests keep Heap’s bulk maximum of 1,000","type":"text"},{"text":" ","type":"text"},{"text":"events.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Events sent through the server-side API carry only the properties sent with them."}]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers what Heap receives, and why, in more detail.","type":"text"}]}]}],"abstract":[{"text":"Send records to Heap as custom events, through its server-side bulk track API.","type":"text"}],"references":{"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder":{"url":"\/documentation\/heapencoding\/heapbatchencoder","kind":"symbol","abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of Heap’s server-side bulk track API, so an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can send events to a Heap environment’s ","type":"text"},{"code":"POST \/api\/track","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapBatchEncoder"}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","title":"HeapBatchEncoder","navigatorTitle":[{"kind":"identifier","text":"HeapBatchEncoder"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://HeapEncoding/documentation/HeapEncoding":{"abstract":[{"text":"Send records to Heap as custom events, through its server-side bulk track API.","type":"text"}],"kind":"symbol","title":"HeapEncoding","url":"\/documentation\/heapencoding","role":"collection","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","type":"topic"},"doc://HeapEncoding/documentation/HeapEncoding/HeapSetupError":{"title":"HeapSetupError","navigatorTitle":[{"text":"HeapSetupError","kind":"identifier"}],"role":"symbol","url":"\/documentation\/heapencoding\/heapsetuperror","kind":"symbol","abstract":[{"type":"text","text":"Why "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:transport:backoff:clock:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)"},{"type":"text","text":" couldn’t be made."}],"type":"topic","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapSetupError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapSetupError","kind":"identifier"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapRegion":{"title":"HeapRegion","navigatorTitle":[{"kind":"identifier","text":"HeapRegion"}],"role":"symbol","url":"\/documentation\/heapencoding\/heapregion","kind":"symbol","abstract":[{"type":"text","text":"The data center a Heap project’s data resides in, which decides the track endpoint its events"},{"type":"text","text":" "},{"type":"text","text":"are posted to."}],"type":"topic","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapRegion","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapRegion"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapEncodingError":{"navigatorTitle":[{"text":"HeapEncodingError","kind":"identifier"}],"abstract":[{"text":"Why ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s requests as","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no record of a","type":"text"},{"text":" ","type":"text"},{"text":"batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"title":"HeapEncodingError","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapEncodingError","kind":"identifier"}],"url":"\/documentation\/heapencoding\/heapencodingerror","role":"symbol","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"title":"BatchEncoder","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","kind":"symbol","type":"topic","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":" sends.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","role":"collection","url":"\/documentation\/httpdestinations","kind":"symbol","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://HeapEncoding/documentation/HeapEncoding/HTTPDestinations/HTTPDestination/heap(appID:region:plan:backoff:clock:)":{"conformance":{"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"URLSessionTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"HeapBatchEncoder","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"heap","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"HeapRegion","preciseIdentif