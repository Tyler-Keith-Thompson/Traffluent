odeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"type":"topic","title":"HeapEncodingError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapEncodingError","kind":"identifier"}],"kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"role":"collection","title":"HTTPDestinations","type":"topic","url":"\/documentation\/httpdestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapRegion":{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapRegion","kind":"symbol","abstract":[{"type":"text","text":"The data center a Heap project’s data resides in, which decides the track endpoint its events"},{"type":"text","text":" "},{"type":"text","text":"are posted to."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapRegion","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"HeapRegion","kind":"identifier"}],"title":"HeapRegion","url":"\/documentation\/heapencoding\/heapregion"},"doc://HeapEncoding/documentation/HeapEncoding/HTTPDestinations/HTT