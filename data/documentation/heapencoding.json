{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Framework","externalID":"HeapEncoding","symbolKind":"module","modules":[{"name":"HeapEncoding"}],"role":"collection","title":"HeapEncoding"},"abstract":[{"type":"text","text":"Send records to Heap as custom events, through its server-side bulk track API."}],"topicSections":[{"anchor":"Sending-to-Heap","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:transport:backoff:clock:)","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapRegion","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapSetupError"],"title":"Sending to Heap"},{"anchor":"Encoding-batches","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder"],"title":"Encoding batches"},{"anchor":"Records-left-out","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError"],"title":"Records left out"}],"sections":[],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)","isActive":true},{"type":"text","text":" makes an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":") for Heap in one call. It checks your"},{"type":"text","text":" "},{"type":"text","text":"environment’s app ID, then posts to the track endpoint of your project’s data center,"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/heapanalytics.com\/api\/track"},{"type":"text","text":" or, for the EU, "},{"type":"codeVoice","code":"https:\/\/c.eu.heap-api.com\/api\/track"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","isActive":true},{"type":"text","text":". Each batch is split to "},{"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":": 1,000 events a"},{"type":"text","text":" "},{"type":"text","text":"request, the most Heap’s bulk track API takes, and 1,000,000 bytes a request, the encoder’s own"},{"type":"text","text":" "},{"type":"text","text":"bound, as Heap documents none. A batch with no record the encoder can write, an empty one"},{"type":"text","text":" "},{"type":"text","text":"included, makes no request. The destination retries no response, a 5xx, 408 and 429, and drops and"},{"type":"text","text":" "},{"type":"text","text":"reports any other status. No trace context is sent. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves this module out, so"},{"type":"text","text":" "},{"type":"text","text":"import it on its own."}],"type":"paragraph"},{"inlineContent":[{"text":"Heap’s server-side API complements its SDKs: Heap says “you can only send events to identified","type":"text"},{"text":" ","type":"text"},{"text":"users”. Every user this destination makes has only server-side events, and Heap treats such a user","type":"text"},{"text":" ","type":"text"},{"text":"differently from one its SDKs capture:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"the user’s profile says its events are hidden, and Heap lists them under the Hidden Events"},{"type":"text","text":" "},{"type":"text","text":"category of its Events tab;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the events aren’t sessionized, so Heap’s Sessions list stays empty for them;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a session filter on a user property sees only SDK sessions, so it matches none of them."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"So checking that events reach Heap’s Live data feed isn’t enough: after setting the destination"},{"type":"text","text":" "},{"type":"text","text":"up, confirm that its events appear in the charts and reports you mean to use."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The track API takes the app ID alone, which Heap’s own SDKs ship inside every app, and no API key,"},{"type":"text","text":" "},{"type":"text","text":"so the destination builds on every platform and an app sends to Heap directly. Heap’s API key is"},{"type":"text","text":" "},{"type":"text","text":"for its user deletion API, which this module doesn’t call; don’t put one in an app."}],"type":"paragraph"},{"syntax":"swift","code":["import HTTPDestinations","import HeapEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let heap = try HTTPDestination.heap(","    appID: appID,  \/\/ the environment's ID, from Heap's project settings","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: heap)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The factory throws "},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapSetupError","isActive":true,"type":"reference"},{"type":"text","text":" for an app ID that is empty or only whitespace, and for one"},{"type":"text","text":" "},{"type":"text","text":"holding anything but ASCII digits: a Heap environment’s ID is a number, such as "},{"type":"codeVoice","code":"12343283"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"region"},{"type":"text","text":" has no default. Pass "},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapRegion\/eu","isActive":true,"type":"reference"},{"type":"text","text":" when your project’s data is in Heap’s EU data"},{"type":"text","text":" "},{"type":"text","text":"center."}],"type":"paragraph"},{"level":3,"anchor":"Users-are-sessions","text":"Users are sessions","type":"heading"},{"inlineContent":[{"type":"text","text":"Heap files each event under its "},{"type":"codeVoice","code":"identity"},{"type":"text","text":", and makes a user for each identity it hasn’t seen. The"},{"type":"text","text":" "},{"type":"text","text":"destination sends the record’s session, from the sessions enricher, as the identity: its"},{"type":"text","text":" "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" as a lowercase UUID. Nothing else identifies a record: no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"vendor identifier, device identifier or account, and no trace context."}],"type":"paragraph"},{"inlineContent":[{"text":"So Heap’s users are sessions. A person who opens the app three times is three users, and Heap’s","type":"text"},{"text":" ","type":"text"},{"text":"retention and user counts describe sessions, not people. That is the library’s default, for","type":"text"},{"text":" ","type":"text"},{"text":"privacy. To count","type":"text"},{"text":" ","type":"text"},{"text":"devices or accounts instead, write your own enricher and encoder that send the identifier you","type":"text"},{"text":" ","type":"text"},{"text":"choose; this encoder sends the session alone.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A record with no session, from a tracker without the sessions enricher, is its own user: its","type":"text"},{"text":" ","type":"text"},{"text":"identity is the record’s identifier. A record a store recovered after a relaunch keeps its session. Making up a session would join unrelated records, skipping","type":"text"},{"text":" ","type":"text"},{"text":"the record would lose it, and Heap takes no event without an identity.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"What-Heap-receives","text":"What Heap receives","type":"heading"},{"inlineContent":[{"text":"Each request is a JSON object: ","type":"text"},{"code":"app_id","type":"codeVoice"},{"text":", as given, without surrounding whitespace, and ","type":"text"},{"code":"events","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"one track event per record. Every event has:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"},{"text":", the event’s name;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"identity"},{"type":"text","text":", the session;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"idempotency_key"},{"type":"text","text":", the record’s identifier, so Heap stores a record sent twice under the same"},{"type":"text","text":" "},{"type":"text","text":"identity once. A record a store recovers after a relaunch keeps its session, so it goes under"},{"type":"text","text":" "},{"type":"text","text":"the identity of its first send, and Heap stores it once;"}]}]},{"content":[{"inlineContent":[{"code":"timestamp","type":"codeVoice"},{"text":", the record’s timestamp in ISO 8601 with milliseconds, so an event sent late still","type":"text"},{"text":" ","type":"text"},{"text":"counts at the time it was tracked;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"properties"},{"type":"text","text":", when the event has any to send."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The record’s properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is"},{"type":"text","text":" "},{"type":"text","text":"made with. Heap takes a number or a string as a property’s value, so an object or array is"},{"type":"text","text":" "},{"type":"text","text":"flattened into dotted names: a "},{"type":"codeVoice","code":"cart"},{"type":"text","text":" holding "},{"type":"codeVoice","code":"size"},{"type":"text","text":" is "},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", and the first element of"},{"type":"text","text":" "},{"type":"codeVoice","code":"tags"},{"type":"text","text":" is "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":". A boolean is the string "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":", a number keeps its JSON type, and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" property is left out. A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals."}],"type":"paragraph"},{"inlineContent":[{"text":"The standard context isn’t sent. Heap keeps no built-in property of an event sent through its","type":"text"},{"text":" ","type":"text"},{"text":"server-side API, so the app’s version or the device’s model would sit among the event’s own","type":"text"},{"text":" ","type":"text"},{"text":"properties, where they could collide with your own names.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Records-left-out","text":"Records left out","type":"heading"},{"inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"one the plan doesn’t describe, whose event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", or that holds a value JSON can’t;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one whose event name is longer than the 1,024 characters Heap takes;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one with a property named "},{"code":"user_id","type":"codeVoice"},{"type":"text","text":", "},{"code":"session_id","type":"codeVoice"},{"type":"text","text":" or "},{"code":"screen_name","type":"codeVoice"},{"type":"text","text":", which Heap reserves: the"},{"type":"text","text":" "},{"type":"text","text":"first two are fields of a track request, and the last is the screen name its mobile SDKs"},{"type":"text","text":" "},{"type":"text","text":"capture. A name like one, such as "},{"code":"User_id","type":"codeVoice"},{"type":"text","text":" or "},{"code":"screen_name.0","type":"codeVoice"},{"type":"text","text":", is sent."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one with a property, once flattened, whose name or string value is 1,024 characters or more:"},{"type":"text","text":" "},{"type":"text","text":"Heap takes fewer. Characters are counted in UTF-16, as JavaScript counts them, so an emoji"},{"type":"text","text":" "},{"type":"text","text":"counts two."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose values flatten to the same name twice;"}]}]},{"content":[{"inlineContent":[{"text":"one whose timestamp falls outside the years 1 to 9999, which have no four-digit ISO 8601 year;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one too large for a request of 1,000,000 bytes on its own.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The destination reports each as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" whose reason is a"},{"type":"text","text":" "},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","isActive":true,"type":"reference"},{"type":"text","text":". When the destination is made, it logs a notice for each event and property"},{"type":"text","text":" "},{"type":"text","text":"of the plan whose name would be left out."}],"type":"paragraph"},{"level":3,"anchor":"What-Heap-doesnt-report","text":"What Heap doesn’t report","type":"heading"},{"inlineContent":[{"type":"text","text":"Heap answers 200 to a request it takes and 400 to one it can’t, which the destination drops and"},{"type":"text","text":" "},{"type":"text","text":"reports with every record of the request. Its docs don’t say what it answers to an app ID of no"},{"type":"text","text":" "},{"type":"text","text":"environment, so confirm that the first events appear in your charts after setting it up."}],"type":"paragraph"},{"inlineContent":[{"text":"Heap takes 15,000 events a minute from one environment, and every device sending to it shares","type":"text"},{"text":" ","type":"text"},{"text":"that limit: at a steady rate it is about 21.6 million events a day across all your users, and a","type":"text"},{"text":" ","type":"text"},{"text":"burst, such as many devices sending their backlogs at once, reaches it sooner. Heap’s docs don’t","type":"text"},{"text":" ","type":"text"},{"text":"say what it answers past the limit. If it answers 429, the destination retries the request on its","type":"text"},{"text":" ","type":"text"},{"text":"backoff, with full jitter, so devices refused together retry at different moments. It doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"read ","type":"text"},{"type":"codeVoice","code":"Retry-After"},{"text":", though, so a backlog can still grow. If it answers 400, the destination drops","type":"text"},{"text":" ","type":"text"},{"text":"the whole request and reports it as rejected, and its records are lost.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Heap also takes 30 requests in 30 seconds and 1,000 events a minute from one identity, which is","type":"text"},{"text":" ","type":"text"},{"text":"one session here. A session whose own backlog holds more than 1,000 events, such as one that ran","type":"text"},{"text":" ","type":"text"},{"text":"long offline, goes past it when it sends, with the same outcomes. A smaller batch wouldn’t avoid","type":"text"},{"text":" ","type":"text"},{"text":"that, as the destination doesn’t pace its requests, so requests keep Heap’s bulk maximum of 1,000","type":"text"},{"text":" ","type":"text"},{"text":"events.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Events sent through the server-side API carry only the properties sent with them."}],"type":"paragraph"},{"inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers what Heap receives, and why, in more detail.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/heapencoding"]}],"references":{"doc://HeapEncoding/documentation/HeapEncoding/HTTPDestinations/HTTPDestination/heap(appID:region:plan:transport:backoff:clock:)":{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:transport:backoff:clock:)","role":"symbol","abstract":[{"type":"text","text":"A destination that sends batches to the Heap environment "},{"code":"appID","type":"codeVoice"},{"type":"text","text":", whose data resides in"},{"type":"text","text":" "},{"code":"region","type":"codeVoice"},{"type":"text","text":", through "},{"code":"transport","type":"codeVoice"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" on "},{"code":"clock","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","url":"\/documentation\/heapencoding\/httpdestinations\/httpdestination\/heap(appid:region:plan:transport:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"heap","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"HeapRegion","preciseIdentifier":"s:12HeapEncoding0A6RegionO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"HeapSetupError","preciseIdentifier":"s:12HeapEncoding0A10SetupErrorO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"HeapBatchEncoder","preciseIdentifier":"s:12HeapEncoding0A12BatchEncoderV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"conformance":{"constraints":[{"code":"Transport","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"HTTPTransport","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Encoding","type":"codeVoice"},{"type":"text","text":" is "},{"code":"HeapBatchEncoder","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"title":"heap(appID:region:plan:transport:backoff:clock:)"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder":{"url":"\/documentation\/heapencoding\/heapbatchencoder","type":"topic","kind":"symbol","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapBatchEncoder","kind":"identifier"}],"abstract":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"type":"text","text":" of Heap’s server-side bulk track API, so an"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" can send events to a Heap environment’s "},{"code":"POST \/api\/track","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","title":"HeapBatchEncoder","navigatorTitle":[{"text":"HeapBatchEncoder","kind":"identifier"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/init(appID:plan:limit:)":{"title":"init(appID:plan:limit:)","role":"symbol","url":"\/documentation\/heapencoding\/heapbatchencoder\/init(appid:plan:limit:)","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"HeapSetupError","kind":"typeIdentifier","preciseIdentifier":"s:12HeapEncoding0A10SetupErrorO"},{"text":")","kind":"text"}],"abstract":[{"text":"An encoder of the events ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" describes, for the Heap environment ","type":"text"},{"code":"appID","type":"codeVoice"},{"text":", splitting each","type":"text"},{"text":" ","type":"text"},{"text":"batch to ","type":"text"},{"code":"limit","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)"},"doc://HeapEncoding/documentation/HeapEncoding/HTTPDestinations/HTTPDestination/heap(appID:region:plan:backoff:clock:)":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" is "},{"type":"codeVoice","code":"URLSessionTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"HeapBatchEncoder"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"title":"heap