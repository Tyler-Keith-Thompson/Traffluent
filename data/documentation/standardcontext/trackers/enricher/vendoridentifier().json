{"abstract":[{"type":"text","text":"An enricher that sets every record’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey"},{"type":"text","text":" to the platform’s identifier for"},{"type":"text","text":" "},{"type":"text","text":"vendor, where it has one."}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"s:8Trackers8EnricherV15StandardContextE16vendorIdentifierACyFZ","remoteSource":{"fileName":"Enricher+VendorIdentifier.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/StandardContext\/Enricher+VendorIdentifier.swift#L22"},"role":"symbol","title":"vendorIdentifier()","roleHeading":"Type Method","symbolKind":"method","extendedModule":"Trackers","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"vendorIdentifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Enricher","preciseIdentifier":"s:8Trackers8EnricherV"}],"modules":[{"name":"StandardContext","relatedModules":["Trackers"]}]},"hierarchy":{"paths":[["doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers","doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers\/Enricher"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vendorIdentifier","kind":"identifier"},{"text":"() -> ","kind":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","text":"Enricher","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The enricher, which runs on the tracker’s worker like any other.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker(enrichers: [.sessions(), .vendorIdentifier()])"]},{"inlineContent":[{"type":"text","text":"Nothing carries the identifier until the app adds this enricher, and the app owns that"},{"type":"text","text":" "},{"type":"text","text":"decision, the user’s consent to it included. The identifier is read once, from "},{"type":"codeVoice","code":"UIDevice"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"WKInterfaceDevice"},{"type":"text","text":" on the main actor, when this is called, and held in the enricher’s"},{"type":"text","text":" "},{"type":"text","text":"memory only: neither the tracker nor its store writes it to disk (a store keeps no"},{"type":"text","text":" "},{"type":"text","text":"record’s context). Where the system has none (macOS, Linux, a device not yet unlocked"},{"type":"text","text":" "},{"type":"text","text":"since it restarted) the enricher sets nothing; it never makes one up."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers\/Enricher\/vendorIdentifier()"},"variants":[{"paths":["\/documentation\/standardcontext\/trackers\/enricher\/vendoridentifier()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://StandardContext/documentation/StandardContext/Trackers/Enricher/vendorIdentifier()":{"url":"\/documentation\/standardcontext\/trackers\/enricher\/vendoridentifier()","kind":"symbol","abstract":[{"type":"text","text":"An enricher that sets every record’s "},{"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","isActive":true},{"type":"text","text":" to the platform’s identifier for"},{"type":"text","text":" "},{"type":"text","text":"vendor, where it has one."}],"role":"symbol","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers\/Enricher\/vendorIdentifier()","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"vendorIdentifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher"}],"title":"vendorIdentifier()"},"doc://StandardContext/documentation/StandardContext/Trackers":{"type":"topic","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers","role":"collection","url":"\/documentation\/standardcontext\/trackers","kind":"symbol","title":"Trackers","abstract":[]},"doc://StandardContext/documentation/StandardContext/VendorIdentifierKey":{"title":"VendorIdentifierKey","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","url":"\/documentation\/standardcontext\/vendoridentifierkey","navigatorTitle":[{"kind":"identifier","text":"VendorIdentifierKey"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"VendorIdentifierKey"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" key of the platform’s identifier for vendor, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":" sets on every record’s context: the one identifier that outlives"},{"type":"text","text":" "},{"type":"text","text":"a session that Traffluent offers, and only because the operating system owns it."}]},"doc://Trackers/documentation/Trackers/Enricher":{"title":"Enricher","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Enricher"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","kind":"symbol","type":"topic","abstract":[{"text":"Adds to the context of each event a tracker tracks, before the record is delivered.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Enricher"}],"role":"symbol","url":"\/documentation\/trackers\/enricher"},"doc://StandardContext/documentation/StandardContext":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","url":"\/documentation\/standardcontext","type":"topic","title":"StandardContext","role":"collection"},"doc://StandardContext/documentation/StandardContext/Trackers/Enricher":{"title":"Enricher","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Enricher","kind":"identifier","preciseIdentifier":"s:8Trackers8EnricherV"}],"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers\/Enricher","type":"topic","kind":"symbol","abstract":[],"navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"role":"symbol","url":"\/documentation\/standardcontext\/trackers\/enricher"}}}