{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"An enricher that sets every record’s "},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","type":"reference","isActive":true},{"type":"text","text":" to the platform’s identifier for"},{"type":"text","text":" "},{"type":"text","text":"vendor, where it has one."}],"sections":[],"metadata":{"roleHeading":"Type Method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"vendorIdentifier"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:8Trackers8EnricherV","kind":"typeIdentifier","text":"Enricher"}],"title":"vendorIdentifier()","extendedModule":"Trackers","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/StandardContext\/Enricher+VendorIdentifier.swift#L22","fileName":"Enricher+VendorIdentifier.swift"},"externalID":"s:8Trackers8EnricherV15StandardContextE16vendorIdentifierACyFZ","role":"symbol","modules":[{"name":"StandardContext","relatedModules":["Trackers"]}],"symbolKind":"method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"vendorIdentifier"},{"kind":"text","text":"() -> "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"The enricher, which runs on the tracker’s worker like any other.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker(enrichers: [.sessions(), .vendorIdentifier()])"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing carries the identifier until the app adds this enricher, and the app owns that"},{"type":"text","text":" "},{"type":"text","text":"decision, the user’s consent to it included. The identifier is read once, from "},{"type":"codeVoice","code":"UIDevice"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"WKInterfaceDevice"},{"type":"text","text":" on the main actor, when this is called, and held in the enricher’s"},{"type":"text","text":" "},{"type":"text","text":"memory only: neither the tracker nor its store writes it to disk (a store keeps no"},{"type":"text","text":" "},{"type":"text","text":"record’s context). Where the system has none (macOS, Linux, a device not yet unlocked"},{"type":"text","text":" "},{"type":"text","text":"since it restarted) the enricher sets nothing; it never makes one up."}]}]}],"identifier":{"url":"doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers\/Enricher\/vendorIdentifier()","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/standardcontext\/trackers\/enricher\/vendoridentifier()"]}],"hierarchy":{"paths":[["doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers","doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers\/Enricher"]]},"references":{"doc://StandardContext/documentation/StandardContext/Trackers/Enricher":{"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Enricher"}],"role":"symbol","url":"\/documentation\/standardcontext\/trackers\/enricher","fragments":[{"kind":"keyword","text":"e