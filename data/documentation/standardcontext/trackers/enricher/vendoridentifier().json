{"abstract":[{"type":"text","text":"An enricher that sets every record’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey"},{"type":"text","text":" to the platform’s identifier for"},{"type":"text","text":" "},{"type":"text","text":"vendor, where it has one."}],"hierarchy":{"paths":[["doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers","doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers\/Enricher"]]},"variants":[{"paths":["\/documentation\/standardcontext\/trackers\/enricher\/vendoridentifier()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers\/Enricher\/vendorIdentifier()","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"vendorIdentifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher"}],"title":"vendorIdentifier()","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/StandardContext\/Enricher+VendorIdentifier.swift#L22","fileName":"Enricher+VendorIdentifier.swift"},"roleHeading":"Type Method","extendedModule":"Trackers","modules":[{"name":"StandardContext","relatedModules":["Trackers"]}],"externalID":"s:8Trackers8EnricherV15StandardContextE16vendorIdentifierACyFZ","role":"symbol","symbolKind":"method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vendorIdentifier","kind":"identifier"},{"text":"() -> ","kind":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","text":"Enricher","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV"}]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"The enricher, which runs on the tracker’s worker like any other."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"syntax":"swift","code":["let tracker = Tracker(enrichers: [.sessions(), .vendorIdentifier()])"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Nothing carries the identifier until the app adds this enricher, and the app owns that"},{"type":"text","text":" "},{"type":"text","text":"decision, the user’s consent to it included. The identifier is read once, from "},{"type":"codeVoice","code":"UIDevice"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"WKInterfaceDevice"},{"type":"text","text":" on the main actor, when this is called, and held in the enricher’s"},{"type":"text","text":" "},{"type":"text","text":"memory only: neither the tracker nor its store writes it to disk (a store keeps no"},{"type":"text","text":" "},{"type":"text","text":"record’s context). Where the system has none (macOS, Linux, a device not yet unlocked"},{"type":"text","text":" "},{"type":"text","text":"since it restarted) the enricher sets nothing; it never makes one up."}],"type":"paragraph"}]}],"references":{"doc://StandardContext/documentation/StandardContext/VendorIdentifierKey":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VendorIdentifierKey","kind":"identifier"}],"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIde