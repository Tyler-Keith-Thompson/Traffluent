r","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","preciseIdentifier":"s:8Trackers8EnricherV"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"text":"The enricher, which runs on the tracker’s worker like any other.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"syntax":"swift","code":["let tracker = Tracker(enrichers: [.sessions(), .vendorIdentifier()])"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Nothing carries the identifier until the app adds this enricher, and the app owns that"},{"type":"text","text":" "},{"type":"text","text":"decision, the user’s consent to it included. The identifier is read once, from "},{"type":"codeVoice","code":"UIDevice"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"WKInterfaceDevice"},{"type":"text","text":" on the main actor, when this is called, and held in the enricher’s"},{"type":"text","text":" "},{"type":"text","text":"memory only: neither the tracker nor its store writes it to disk (a store keeps no"},{"type":"text","text":" "},{"type":"text","text":"record’s context). Where the system has none (macOS, Linux, a device not yet unlocked"},{"type":"text","text":" "},{"type":"text","text":"since it restarted) the enricher sets nothing; it never makes one up."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/standardcontext\/trackers\/enricher\/vendoridentifier()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"references":{"doc://StandardContext/documentation/StandardContext/VendorIdentifierKey":{"navigatorTitle":[{"text":"VendorIdentifierKey","kind":"identifier"}],"role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VendorIdentifierKey","