{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"An enricher that sets every record’s "},{"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","isActive":true},{"type":"text","text":" to the platform’s identifier for"},{"type":"text","text":" "},{"type":"text","text":"vendor, where it has one."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vendorIdentifier","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","preciseIdentifier":"s:8Trackers8EnricherV"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"text":"The enricher, which runs on the tracker’s worker like any other.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"syntax":"swift","code":["let tracker = Tracker(enrichers: [.sessions(), .vendorIdentifier()])"],"type":"codeListing"},{"inlineContent":[{"text":"Nothing carries the identifier until the app adds this enricher, and the app owns that","type":"text"},{"text":" ","type":"text"},{"text":"decision, the user’s consent to it included. The identifier is read once, from ","type":"text"},{"code":"UIDevice","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"WKInterfaceDevice","type":"codeVoice"},{"text":" on the main actor, when this is called, and held in the enricher’s","type":"text"},{"text":" ","type":"text"},{"text":