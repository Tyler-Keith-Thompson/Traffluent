acker nor its store writes it to disk (a store keeps no","type":"text"},{"text":" ","type":"text"},{"text":"record’s context). Where the system has none (macOS, Linux, a device not yet unlocked","type":"text"},{"text":" ","type":"text"},{"text":"since it restarted) the enricher sets nothing; it never makes one up.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/standardcontext\/trackers\/enricher\/vendoridentifier()"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/StandardContext\/documentation\/StandardContext","doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers","doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers\/Enricher"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/StandardContext\/documentation\/StandardContext\/Trackers\/Enricher\/vendorIdentifier()"},"metadata":{"externalID":"s:8Trackers8EnricherV15StandardContextE16vendorIdentifierACyFZ","title":"vendorIdentifier()","role":"symbol","symbolKind":"method","remoteSource":{"fileName":"Enricher+VendorIdentifier.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/StandardContext\/Enricher+VendorIdentifier.swift#L22"},"extendedModule":"Trackers","modules":[{"name":"StandardContext","relatedModules":["Trackers"]}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vendorIdentifier","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Enricher","preciseIdentifier":"s:8Trackers8EnricherV","kind":"typeIdentifier"}],"roleHeading":"Type Method"},"kind":"symbol","references":{"doc://StandardContext/documentation/StandardContext/Trackers/Enricher/vendorIdentifier()":{"title":"vendorIdentifier()","type":"topic","abstract":[{"text":"An enricher that sets every record’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation