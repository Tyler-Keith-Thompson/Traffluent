{"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"VendorIdentifierKey"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"The system gives the same identifier to every app of one vendor on one device, and a new one"},{"type":"text","text":" "},{"type":"text","text":"once all of them are removed. Traffluent reads it and never stores it, nor makes one up where"},{"type":"text","text":" "},{"type":"text","text":"the system has none: on macOS and Linux, and on a device whose system hasn’t one yet (just"},{"type":"text","text":" "},{"type":"text","text":"restarted, still locked), records carry no key. It is a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value, so a destination"},{"type":"text","text":" "},{"type":"text","text":"reads it only through the record it arrived in, and not at all once a delivery redacts it:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let vendorID = record.context[VendorIdentifierKey.self].flatMap(record.reveal)  \/\/ a UUID"]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","interfaceLanguage":"swift"},"sections":[],"metadata":{"symbolKind":"enum","title":"VendorIdentifierKey","role":"symbol","roleHeading":"Enumeration","remoteSource":{"fileName":"VendorIdentifierKey.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/StandardContext\/VendorIdentifierKey.swift#L23"},"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VendorIdentifierKey","kind":"identifier"}],"navigatorTitle":[{"text":"VendorIdentifierKey","kind":"identifier"}],"modules":[{"name":"StandardContext"}],