{"abstract":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":" key of the platform’s identifier for vendor, which","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"text":" sets on every record’s context: the one identifier that outlives","type":"text"},{"text":" ","type":"text"},{"text":"a session that Traffluent offers, and only because the operating system owns it.","type":"text"}],"variants":[{"paths":["\/documentation\/standardcontext\/vendoridentifierkey"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"VendorIdentifierKey"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The system gives the same identifier to every app of one vendor on one device, and a new one"},{"type":"text","text":" "},{"type":"text","text":"once all of them are removed. Traffluent reads it and never stores it, nor makes one up where"},{"type":"text","text":" "},{"type":"text","text":"the system has none: on macOS and Linux, and on a device whose system hasn’t one yet (just"},{"type":"text","text":" "},{"type":"text","text":"restarted, still locked), records carry no key. It is a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value, so a destination"},{"type":"text","text":" "},{"type":"text","text":"reads it only through the record it arrived in, and not at all once a delivery redacts it:"}],"type":"paragraph"},{"code":["let vendorID = record.context[VendorIdentifierKey.self].flatMap(record.reveal)  \/\/ a UUID"],"syntax":"swift","type":"codeListing"}]}],"metadata":{"symbolKind":"enum","title":"VendorIdentifierKey","roleHeading":"Enumeration","navigatorTitle":[{"text":"Vendo