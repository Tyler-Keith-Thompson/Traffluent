, and on a device whose system hasn’t one yet (just"},{"type":"text","text":" "},{"type":"text","text":"restarted, still locked), records carry no key. It is a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value, so a destination"},{"type":"text","text":" "},{"type":"text","text":"reads it only through the record it arrived in, and not at all once a delivery redacts it:"}]},{"type":"codeListing","code":["let vendorID = record.context[VendorIdentifierKey.self].flatMap(record.reveal)  \/\/ a UUID"],"syntax":"swift"}]}],"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" key of the platform’s identifier for vendor, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":" sets on every record’s context: the one identifier that outlives"},{"type":"text","text":" "},{"type":"text","text":"a session that Traffluent offers, and only because the operating system owns it."}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/standardcontext\/vendoridentifierkey"]}],"topicSections":[{"identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey\/Value"],"title":"Type Aliases","anchor":"Type-Aliases","generated":true},{"identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey\/InstrumentationContextKey-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"references":{"doc://StandardContext/documentation/StandardContext/VendorIdentifierKey/InstrumentationContextKey-Implementations":{"role":"collectionGroup","abstract":[],"kind":"article","type":"topic","title":"InstrumentationContextKey Implementations","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey\/InstrumentationContextKe