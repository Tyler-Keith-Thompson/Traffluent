{"hierarchy":{"paths":[["doc:\/\/StandardContext\/documentation\/StandardContext"]]},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"VendorIdentifierKey"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The system gives the same identifier to every app of one vendor on one device, and a new one"},{"type":"text","text":" "},{"type":"text","text":"once all of them are removed. Traffluent reads it and never stores it, nor makes one up where"},{"type":"text","text":" "},{"type":"text","text":"the system has none: on macOS and Linux, and on a device whose system hasn’t one yet (just"},{"type":"text","text":" "},{"type":"text","text":"restarted, still locked), records carry no key. It is a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value, so a destination"},{"type":"text","text":" "},{"type":"text","text":"reads it only through the record it arrived in, and not at all once a delivery redacts it:"}],"type":"paragraph"},{"code":["let vendorID = record.context[VendorIdentifierKey.self].flatMap(record.reveal)  \/\/ a UUID"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"identifier":{"url":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"The ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" key of the platform’s identifier for vendor, which","type":"text"},{"text":" ","type":"text"},{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"text":" sets on every record’s context: the one identifier that outlives","type":"text"},{"text":" ","type":"text"},{"text":"a session that Traffluent offers, and only because the operating system owns it.","t