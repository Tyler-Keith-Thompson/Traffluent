inux"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VendorIdentifierKey","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The system gives the same identifier to every app of one vendor on one device, and a new one"},{"type":"text","text":" "},{"type":"text","text":"once all of them are removed. Traffluent reads it and never stores it, nor makes one up where"},{"type":"text","text":" "},{"type":"text","text":"the system has none: on macOS and Linux, and on a device whose system hasn’t one yet (just"},{"type":"text","text":" "},{"type":"text","text":"restarted, still locked), records carry no key. It is a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value, so a destination"},{"type":"text","text":" "},{"type":"text","text":"reads it only through the record it arrived in, and not at all once a delivery redacts it:"}],"type":"paragraph"},{"code":["let vendorID = record.context[VendorIdentifierKey.self].flatMap(record.reveal)  \/\/ a UUID"],"syntax":"swift","type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/standardcontext\/vendoridentifierkey"]}],"hierarchy":{"paths":[["doc:\/\/StandardContext\/documentation\/StandardContext"]]},"kind":"symbol","references":{"doc://StandardContext/s8SendableP":{"identifier":"doc:\/\/StandardContext\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://StandardContext/15Instrumentation0A10ContextKeyP":{"type":"unresolvable","identifier":"doc:\/\/StandardContext\/15Instrumentation0A10ContextKeyP","title":"Instrumentation.InstrumentationContextKey"},"doc://StandardContext/s16SendableMetatypeP":{"identifier":"doc:\/\/StandardContext\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://StandardContext/documentation/StandardContext/VendorIdentifierKey":