,"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"The system gives the same identifier to every app of one vendor on one device, and a new one","type":"text"},{"text":" ","type":"text"},{"text":"once all of them are removed. Traffluent reads it and never stores it, nor makes one up where","type":"text"},{"text":" ","type":"text"},{"text":"the system has none: on macOS and Linux, and on a device whose system hasn’t one yet (just","type":"text"},{"text":" ","type":"text"},{"text":"restarted, still locked), records carry no key. It is a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value, so a destination","type":"text"},{"text":" ","type":"text"},{"text":"reads it only through the record it arrived in, and not at all once a delivery redacts it:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let vendorID = record.context[VendorIdentifierKey.self].flatMap(record.reveal)  \/\/ a UUID"],"syntax":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/standardcontext\/vendoridentifierkey"]}],"identifier":{"url":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","interfaceLanguage":"swift"},"references":{"doc://StandardContext/documentation/StandardContext":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","url":"\/documentation\/standardcontext","type":"topic","title":"StandardContext","role":"collection"},"doc://StandardContext/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/StandardContext\/s8SendableP","type":"unresolvable"},"doc://StandardContext/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/StandardContext\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://StandardContex