{"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use this module when an app’s screens should track their own views: on iOS, iPadOS, tvOS,","type":"text"},{"text":" ","type":"text"},{"text":"visionOS and Mac Catalyst through a ","type":"text"},{"type":"codeVoice","code":"UIWindowScene"},{"text":", and on macOS through an ","type":"text"},{"type":"codeVoice","code":"NSWindow"},{"text":". On","type":"text"},{"text":" ","type":"text"},{"text":"watchOS and Linux it builds empty. To track one screen by hand, or a view a macOS","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationStack"},{"text":" pushes, give it ","type":"text"},{"type":"codeVoice","code":"trackScreen(_:)"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Nothing is tracked until a window scene or a window turns it on with ","type":"text"},{"type":"codeVoice","code":"trackScreensAutomatically"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A screen is a view controller on screen none of whose children is: the one a navigation","type":"text"},{"text":" ","type":"text"},{"text":"controller shows, a tab’s, one presented. It tracks ","type":"text"},{"type":"codeVoice","code":"ScreenViewed"},{"text":" once as it appears, and again","type":"text"},{"text":" ","type":"text"},{"text":"when it reappears after being covered or hidden. The screen is named after its controller’s type,","type":"text"},{"text":" ","type":"text"},{"text":"or for a hosting controller after the type of the SwiftUI view it shows. The closure gets each","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DiscoveredScreen"},{"text":" and returns the event to track, renamed, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" to skip the screen:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackScreensAutomatically { screen in","    screen.name == \"DebugMenuViewController\" ? nil : ScreenViewed(screen: screen.name)","}"]},{"type":"paragraph","inlineContent":[{"text":"On macOS, a window turns it on, and each screen view goes through the tracker the screen’s view","type":"text"},{"text":" ","type":"text"},{"text":"finds up its responder chain (","type":"text"},{"type":"codeVoice","code":"NSView.tracker"},{"text":", from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"text":"):","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import AppKit","import SwiftUI","","struct PreferencesView: View {","    var body: some View {","        Text(\"Preferences\")","    }","}","","final class PreferencesWindowController: NSWindowController, TrackerProviding {","    let tracker: Tracker","","    init(tracker: Tracker) {","        self.tracker = tracker","        super.init(window: NSWindow(contentViewController: NSHostingController(rootView: PreferencesView())))","    }","","    required init?(coder: NSCoder) { nil }","}","","let controller = PreferencesWindowController(tracker: tracker)","controller.window?.trackScreensAutomatically()  \/\/ tracks ScreenViewed(screen: \"PreferencesView\")","controller.showWindow(nil)"]},{"type":"paragraph","inlineContent":[{"code":"kinds:","type":"codeVoice"},{"text":" limits tracking to UIKit’s (or AppKit’s) view controllers or to SwiftUI’s views. A","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI screen given ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":" is left to that modifier, so it isn’t tracked twice.","type":"text"},{"text":" ","type":"text"},{"text":"Discovery looks after each turn of the main run loop, swizzles nothing, and touches no other scene","type":"text"},{"text":" ","type":"text"},{"text":"or window. On a UIKit platform, each screen view goes through the tracker the screen’s traits","type":"text"},{"text":" ","type":"text"},{"text":"hold, so each scene keeps its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This documentation is built on macOS, so ","type":"text"},{"code":"UIWindowScene","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"trackScreensAutomatically(kinds:_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"stopTrackingScreensAutomatically()","type":"codeVoice"},{"text":" have no pages here; they take the same parameters as","type":"text"},{"text":" ","type":"text"},{"code":"NSWindow","type":"codeVoice"},{"text":"’s, with ","type":"text"},{"code":"kinds:","type":"codeVoice"},{"text":" defaulting to ","type":"text"},{"code":"[.uiKit, .swiftUI]","type":"codeVoice"},{"text":", and their doc comments are in the","type":"text"},{"text":" ","type":"text"},{"text":"sources.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"also covers control activations and the app’s lifecycle."}]},{"type":"heading","level":2,"text":"API","anchor":"API"},{"type":"paragraph","inlineContent":[{"text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols","type":"text"},{"text":" ","type":"text"},{"text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them","type":"text"},{"text":" ","type":"text"},{"text":"for an Apple target.","type":"text"}]},{"type":"heading","level":3,"text":"Tracking a window’s screens","anchor":"Tracking-a-windows-screens"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSWindow.trackScreensAutomatically(kinds:_:)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSWindow.stopTrackingScreensAutomatically()"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Naming screens","anchor":"Naming-screens"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"DiscoveredScreen","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"DiscoveredScreen.Kind","type":"codeVoice"}],"type":"paragraph"}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on"},{"type":"text","text":" "},{"type":"text","text":"each screen."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking"},"variants":[{"paths":["\/documentation\/automaticscreentracking"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","metadata":{"modules":[{"name":"AutomaticScreenTracking"}],"roleHeading":"Framework","title":"AutomaticScreenTracking","role":"collection","symbolKind":"module","externalID":"AutomaticScreenTracking"},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"link","titleInlineContent":[{"code":"SwiftUITracking","type":"codeVoice"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","title":"SwiftUITracking"},"https://tyler-keith-thompson.git