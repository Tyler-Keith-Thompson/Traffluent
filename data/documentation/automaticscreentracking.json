tab’s, one presented. It tracks ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" once as it appears, and again","type":"text"},{"text":" ","type":"text"},{"text":"when it reappears after being covered or hidden. The screen is named after its controller’s type,","type":"text"},{"text":" ","type":"text"},{"text":"or for a hosting controller after the type of the SwiftUI view it shows. The closure gets each","type":"text"},{"text":" ","type":"text"},{"code":"DiscoveredScreen","type":"codeVoice"},{"text":" and returns the event to track, renamed, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to skip the screen:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackScreensAutomatically { screen in","    screen.name == \"DebugMenuViewController\" ? nil : ScreenViewed(screen: screen.name)","}"]},{"inlineContent":[{"type":"text","text":"On macOS, a window turns it on, and each screen view goes through the tracker the screen’s view"},{"type":"text","text":" "},{"type":"text","text":"finds up its responder chain ("},{"code":"NSView.tracker","type":"codeVoice"},{"type":"text","text":", from"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"type":"text","text":"):"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import AppKit","import SwiftUI","","struct PreferencesView: View {","    var body: some View {","        Text(\"Preferences\")","    }","}","","final class PreferencesWindowController: NSWindowController, TrackerProviding {","    let tracker: Tracker","","    init(tracker: Tracker) {","        self.tracker = tracker","        super.init(window: NSWindow(contentViewController: NSHostingController(rootView: PreferencesView())))","    }","","    required init?(coder: NSCoder) { nil }","}","","let controller = PreferencesWindowController(tracker: tracker)","controller.window?.trackScreensAutomatically()  \/\/ tracks ScreenViewed(screen: \"PreferencesView\")","controller.showWindow(nil)"]},{"inlineContent":[{"code":"kinds:","type":"codeVoice"},{"type":"text","text":" limits tracking to UIKit’s (or AppKit’s) view controllers or to SwiftUI’s views. A"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI screen given "},{"code":"trackScreen(_:)","type":"codeVoice"},{"type":"text","text":" is left to that modifier, so it isn’t tracked twice."},{"type":"text","text":" "},{"type":"text","text":"Discovery looks after each turn of the main run loop, swizzles nothing, and touches no other scene"},{"type":"text","text":" "},{"type":"text","text":"or window. On a UIKit platform, each screen view goes through the tracker the screen’s traits"},{"type":"text","text":" "},{"type":"text","text":"hold, so each scene keeps its own."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This documentation is built on macOS, so "},{"code":"UIWindowScene","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"trackScreensAutomatically(kinds:_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"stopTrackingScreensAutomatically()","type":"codeVoice"},{"type":"text","text":" have no pages here; they take the same parameters as"},{"type":"text","text":" "},{"code":"NSWindow","type":"codeVoice"},{"type":"text","text":"’s, with "},{"code":"kinds:","type":"codeVoice"},{"type":"text","text":" defaulting to "},{"code":"[.uiKit, .swiftUI]","type":"codeVoice"},{"type":"text","text":", and their doc comments are in the"},{"type":"text","text":" "},{"type":"text","text":"sources."}],"type":"paragraph"},{"inlineContent":[{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/document