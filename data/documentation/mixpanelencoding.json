{"topicSections":[{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:now:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:now:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/ExponentialBackoff\/mixpanel","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"],"anchor":"Sending-to-Mixpanel","title":"Sending to Mixpanel"},{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"],"anchor":"Encoding-batches","title":"Encoding batches"},{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError"],"anchor":"Records-left-out","title":"Records left out"}],"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:now:)","type":"reference"},{"text":" makes an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference"},{"text":") for your Mixpanel project in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the project token, posts to the ","type":"text"},{"code":"\/track","type":"codeVoice"},{"text":" endpoint of the project’s data residency","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","type":"reference"},{"text":"), with ","type":"text"},{"code":"verbose=1","type":"codeVoice"},{"text":", through a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","type":"reference"},{"text":", and splits each batch to Mixpanel’s limits","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","type":"reference"},{"text":"): 2,000 events and 2 MB a request. A batch with no record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder can write, an empty one included, makes no request. It retries no response, a 5xx, 408","type":"text"},{"text":" ","type":"text"},{"text":"and 429, waiting ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/ExponentialBackoff\/mixpanel","type":"reference"},{"text":": Mixpanel’s recommended","type":"text"},{"text":" ","type":"text"},{"text":"schedule, 2 s doubling to 60 s. The full jitter on top is Traffluent’s own choice. It drops and","type":"text"},{"text":" ","type":"text"},{"text":"reports any other status. The token goes in each event, so no header field is needed, and no","type":"text"},{"text":" ","type":"text"},{"text":"trace context is sent. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves this module out; import it on its own.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The project token is public: Mixpanel’s own apps and web pages ship it. The destination takes"},{"type":"text","text":" "},{"type":"text","text":"nothing else. Never put the project’s secret or a service account’s credentials in an app; they"},{"type":"text","text":" "},{"type":"text","text":"belong to Mixpanel’s import API, for servers. The factory throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"},{"type":"text","text":" for an"},{"type":"text","text":" "},{"type":"text","text":"empty token, and for one with a character other than a letter or digit, which no project token"},{"type":"text","text":" "},{"type":"text","text":"has."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The region has no default. A project’s data resides in the US, the EU or India, and Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"ingests nothing for it from another residency’s endpoint, so you pick the region on purpose."}],"type":"paragraph"},{"inlineContent":[{"text":"Each record becomes an event of an anonymous user. Its ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":" is the record’s session,","type":"text"},{"text":" ","type":"text"},{"text":"from the sessions enricher, also sent as ","type":"text"},{"code":"$device_id","type":"codeVoice"},{"text":"; a record with no session is sent under its","type":"text"},{"text":" ","type":"text"},{"text":"own record identifier, with no ","type":"text"},{"code":"$device_id","type":"codeVoice"},{"text":". Under Simplified ID Merge, Mixpanel shows a","type":"text"},{"text":" ","type":"text"},{"text":"session’s events under ","type":"text"},{"code":"$device:<session>","type":"codeVoice"},{"text":", and a sessionless record’s under its bare record","type":"text"},{"text":" ","type":"text"},{"text":"identifier. No ","type":"text"},{"code":"$user_id","type":"codeVoice"},{"text":" is sent. Its ","type":"text"},{"code":"$insert_id","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"record’s identifier, which a redelivered record keeps, and its ","type":"text"},{"code":"time","type":"codeVoice"},{"text":" the record’s timestamp in","type":"text"},{"text":" ","type":"text"},{"text":"epoch milliseconds. The record’s vendor identifier and trace context aren’t sent. Each event’s","type":"text"},{"text":" ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"0","type":"codeVoice"},{"text":", as is the endpoint’s, so Mixpanel adds no location from the request’s address. The","type":"text"},{"text":" ","type":"text"},{"text":"standard context is sent as Mixpanel’s default properties (","type":"text"},{"code":"$app_version_string","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"$app_build_number","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$wifi","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"$os_version","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Mixpanel counts a user per "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", so each session is one user in its reports, and so is"},{"type":"text","text":" "},{"type":"text","text":"each record sent without a session. On a Mixpanel plan billed by monthly tracked users, each counts"},{"type":"text","text":" "},{"type":"text","text":"as one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" the encoder is made with. A"},{"type":"text","text":" "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is never sent, whatever the record reveals. A record the encoder can’t write is"},{"type":"text","text":" "},{"type":"text","text":"left out and the rest of the batch is sent: one the plan doesn’t describe, one whose event name"},{"type":"text","text":" "},{"type":"text","text":"starts with "},{"code":"$","type":"codeVoice"},{"type":"text","text":", as Mixpanel’s own events’ names do, one with a property Mixpanel reads for itself"},{"type":"text","text":" "},{"type":"text","text":"(a "},{"code":"$","type":"codeVoice"},{"type":"text","text":"-prefixed one, "},{"code":"token","type":"codeVoice"},{"type":"text","text":", "},{"code":"time","type":"codeVoice"},{"type":"text","text":", "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":", "},{"code":"ip","type":"codeVoice"},{"type":"text","text":" or "},{"code":"bucket","type":"codeVoice"},{"type":"text","text":"), one of 255 properties or"},{"type":"text","text":" "},{"type":"text","text":"more counting the encoder’s own, one holding an array of 255 elements or more, one whose property"},{"type":"text","text":" "},{"type":"text","text":"nests objects more than 3 deep, one whose event isn’t"},{"type":"text","text":" "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one holding a value JSON can’t, one whose timestamp is before 1971 or has no"},{"type":"text","text":" "},{"type":"text","text":"epoch-milliseconds form, one tracked more than 119 hours before its batch is encoded or more than"},{"type":"text","text":" "},{"type":"text","text":"an hour after, and one too large for Mixpanel. The destination reports each as"},{"type":"text","text":" "},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"type":"text","text":", a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" whose reason is a "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Mixpanel answers 200 even when it finds no valid event in a request. The endpoint asks for"},{"type":"text","text":" "},{"type":"codeVoice","code":"verbose=1"},{"type":"text","text":", so the answer’s body says so, "},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"type":"text","text":", and the destination"},{"type":"text","text":" "},{"type":"text","text":"drops the request and reports it as "},{"type":"codeVoice","code":"HTTPDropReport.rejectedInBody(status:reason:recordIDs:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"with Mixpanel’s error as the reason. A "},{"type":"codeVoice","code":"status"},{"type":"text","text":" of 1 means only that one event or more was well"},{"type":"text","text":" "},{"type":"text","text":"formed: it doesn’t confirm that the token names a project, so a wrong region, or a token of no"},{"type":"text","text":" "},{"type":"text","text":"project, may be answered 200 with nothing stored. Check the project’s Live View after setting the"},{"type":"text","text":" "},{"type":"text","text":"destination up."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Mixpanel’s track API ingests only events from the last 5 days, and answers 200 to an older one"},{"type":"text","text":" "},{"type":"text","text":"while storing nothing. So the destination drops and reports such a record rather than send it."},{"type":"text","text":" "},{"type":"text","text":"The encoder leaves out a record tracked more than 119 hours (5 days less an hour, for clocks that"},{"type":"text","text":" "},{"type":"text","text":"disagree) before its batch is encoded, as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow"},{"type":"text","text":". Each request has a deadline 119 hours after its"},{"type":"text","text":" "},{"type":"text","text":"oldest record was tracked, and a request still being retried when it passes isn’t sent again: it"},{"type":"text","text":" "},{"type":"text","text":"is reported as "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":". Pass the factory’s "},{"type":"codeVoice","code":"now:"},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"clock of your own to test this."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To send to PostHog or Amplitude, use "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":" instead."}],"type":"paragraph"},{"code":["import HTTPDestinations","import MixpanelEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let mixpanel = try HTTPDestination.mixpanel(","    projectToken: projectToken,","    region: .us,  \/\/ or .eu or .india, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: mixpanel)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"covers what Mixpanel receives, and why, in more detail."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mixpanelencoding"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"MixpanelEncoding","symbolKind":"module","title":"MixpanelEncoding","role":"collection","modules":[{"name":"MixpanelEncoding"}],"roleHeading":"Framework"},"sections":[],"kind":"symbol","references":{"doc://HTTPDestinations/documentation/HTTPDestinations":{"type":"topic","title":"HTTPDestinations","url":"\/documentation\/httpdestinations","role":"collection","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination/mixpanel(projectToken:region:plan:transport:backoff:clock:now:)":{"type":"topic","title":"mixpanel(projectToken:region:plan:transport:backoff:clock:now:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MixpanelRegion","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A6RegionO"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":">, ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"MixpanelSetupError","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV"},{"text":">","kind":"text"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"HTTPTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"MixpanelBatchEncoder"},{"type":"text","text":"."}]},"url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:transport:backoff:clock:now:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:now:)","abstract":[{"type":"text","text":"A destination that sends batches to the Mixpanel project of "},{"code":"projectToken","type":"codeVoice"},{"type":"text","text":", whose data"},{"type":"text","text":" "},{"type":"text","text":"resides in "},{"code":"region","type":"codeVoice"},{"type":"text","text":", through "},{"code":"transport","type":"codeVoice"},{"type":"text","text":", retrying a send that fails for now with the waits"},{"type":"text","text":" "},{"type":"text","text":"of "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" on "},{"code":"clock","type":"codeVoice"},{"type":"text","text":"."}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError/timestampOutsideWindow":{"role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror\/timestampoutsidewindow","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timestampOutsideWindow","kind":"identifier"}],"abstract":[{"type":"text","text":"The record was tracked more than 119 hours before the batch was encoded or more than an"},{"type":"text","text":" "},{"type":"text","text":"hour after it, or the clock the encoder reads gave a NaN or infinite time. Mixpanel’s track"},{"type":"text","text":" "},{"type":"text","text":"API drops an event more than 5 days old while answering 200, the hour to spare being for a"},{"type":"text","text":" "},{"type":"text","text":"queue on Mixpanel’s side and clocks that disagree, and rejects one more than an hour in the"},{"type":"text","text":" "},{"type":"text","text":"future."}],"title":"MixpanelEncodingError.timestampOutsideWindow","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"title":"BatchEncoder","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"topic","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","title":"Choosing Destinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelSetupError":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError","url":"\/documentation\/mixpanelencoding\/mixpanelsetuperror","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelSetupError"}],"navigatorTitle":[{"kind":"identifier","text":"MixpanelSetupError"}],"role":"symbol","abstract":[{"type":"text","text":"Why "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:now:)"},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"kind":"symbol","type":"topic","title":"MixpanelSetupError"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/batchLimit":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/batchlimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier","text":"BatchLimit"}],"role":"symbol","abstract":[{"type":"text","text":"Mixpanel’s limits on one request: 2,000 events, 2,000,000 bytes of body, and 999,999 bytes"},{"type":"text","text":" "},{"type":"text","text":"of one event."}],"kind":"symbol","type":"topic","title":"batchLimit"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/ExponentialBackoff/mixpanel":{"url":"\/documentation\/mixpanelencoding\/httpdestinations\/exponentialbackoff\/mixpanel","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/ExponentialBackoff\/mixpanel","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"mixpanel"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier","text":"ExponentialBackoff"}],"role":"symbol","abstract":[{"text":"Mixpanel’s recommended schedule, 2 s doubling to 60 s, with full jitter: a nominal wait of","type":"text"},{"text":" ","type":"text"},{"text":"2 seconds before the first retry, doubling up to 60 seconds. Mixpanel recommends the","type":"text"},{"text":" ","type":"text"},{"text":"schedule; the full jitter is Traffluent’s, as for every destination.","type":"text"}],"kind":"symbol","type":"topic","title":"mixpanel"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelRegion":{"role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelregion","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelRegion","kind":"identifier"}],"abstract":[{"text":"The data residency of a Mixpanel project, which decides the ","type":"text"},{"code":"\/track","type":"codeVoice"},{"text":" endpoint its events are","type":"text"},{"text":" ","type":"text"},{"text":"posted to.","type":"text"}],"title":"MixpanelRegion","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","type":"topic","navigatorTitle":[{"text":"MixpanelRegion","kind":"identifier"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"kind":"symbol","url":"\/documentation\/mixpanelencoding","role":"collection","type":"topic","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","title":"MixpanelEncoding","abst