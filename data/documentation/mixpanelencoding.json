{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","isActive":true},{"type":"text","text":" makes an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":") for your Mixpanel project in one call. It checks"},{"type":"text","text":" "},{"type":"text","text":"the project token, posts to the "},{"type":"codeVoice","code":"\/track"},{"type":"text","text":" endpoint of the project’s data residency"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","isActive":true},{"type":"text","text":") with a "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","isActive":true},{"type":"text","text":", and splits each batch to Mixpanel’s limits"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":"): 2,000 events and 2 MB a request. A batch with no record the"},{"type":"text","text":" "},{"type":"text","text":"encoder can write, an empty one included, makes no request. It retries no response, a 5xx, 408"},{"type":"text","text":" "},{"type":"text","text":"and 429, and drops and reports any other status. The token goes in each event, so no header field"},{"type":"text","text":" "},{"type":"text","text":"is needed, and no trace context is sent. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves this module out; import it on"},{"type":"text","text":" "},{"type":"text","text":"its own."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The project token is public: Mixpanel’s own apps and web pages ship it. The destination takes"},{"type":"text","text":" "},{"type":"text","text":"nothing else. Never put the project’s secret or a service account’s credentials in an app; they"},{"type":"text","text":" "},{"type":"text","text":"belong to Mixpanel’s import API, for servers. The factory throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"},{"type":"text","text":" for an"},{"type":"text","text":" "},{"type":"text","text":"empty token, and for one with a character other than a letter or digit, which no project token"},{"type":"text","text":" "},{"type":"text","text":"has."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The region has no default. A project’s data resides in the US, the EU or India, and Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"ingests nothing for it from another residency’s endpoint, so you pick the region on purpose."}],"type":"paragraph"},{"inlineContent":[{"text":"Each record becomes an event of an anonymous user. Its ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":" is the record’s session,","type":"text"},{"text":" ","type":"text"},{"text":"from the sessions enricher, also sent as ","type":"text"},{"code":"$device_id","type":"codeVoice"},{"text":"; a record with no session is sent under its","type":"text"},{"text":" ","type":"text"},{"text":"own record identifier, with no ","type":"text"},{"code":"$device_id","type":"codeVoice"},{"text":". Under Simplified ID Merge, Mixpanel shows a","type":"text"},{"text":" ","type":"text"},{"text":"session’s events under ","type":"text"},{"code":"$device:<session>","type":"codeVoice"},{"text":", and a sessionless record’s under its bare record","type":"text"},{"text":" ","type":"text"},{"text":"identifier. No ","type":"text"},{"code":"$user_id","type":"codeVoice"},{"text":" is sent. Its ","type":"text"},{"code":"$insert_id","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"record’s identifier, which a redelivered record keeps, and its ","type":"text"},{"code":"time","type":"codeVoice"},{"text":" the record’s timestamp in","type":"text"},{"text":" ","type":"text"},{"text":"epoch milliseconds. The record’s vendor identifier and trace context aren’t sent. Each event’s","type":"text"},{"text":" ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"0","type":"codeVoice"},{"text":", as is the endpoint’s, so Mixpanel adds no location from the request’s address. The","type":"text"},{"text":" ","type":"text"},{"text":"standard context is sent as Mixpanel’s default properties (","type":"text"},{"code":"$app_version_string","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"$app_build_number","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$wifi","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"$os_version","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Mixpanel counts a user per ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":", so each session is one user in its reports, and so is","type":"text"},{"text":" ","type":"text"},{"text":"each record sent without a session. On a Mixpanel plan billed by monthly tracked users, each counts","type":"text"},{"text":" ","type":"text"},{"text":"as one.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals. A record the encoder can’t write is"},{"type":"text","text":" "},{"type":"text","text":"left out and the rest of the batch is sent: one the plan doesn’t describe, one whose event name"},{"type":"text","text":" "},{"type":"text","text":"starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":", as Mixpanel’s own events’ names do, one with a property Mixpanel reads for itself"},{"type":"text","text":" "},{"type":"text","text":"(a "},{"type":"codeVoice","code":"$"},{"type":"text","text":"-prefixed one, "},{"type":"codeVoice","code":"token"},{"type":"text","text":", "},{"type":"codeVoice","code":"time"},{"type":"text","text":", "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", "},{"type":"codeVoice","code":"ip"},{"type":"text","text":" or "},{"type":"codeVoice","code":"bucket"},{"type":"text","text":"), one of 255 properties or"},{"type":"text","text":" "},{"type":"text","text":"more counting the encoder’s own, one holding an array of 255 elements or more, one whose property"},{"type":"text","text":" "},{"type":"text","text":"nests objects more than 3 deep, one whose event isn’t"},{"type":"text","text":" "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one holding a value JSON can’t, one whose timestamp is before 1971 or has no"},{"type":"text","text":" "},{"type":"text","text":"epoch-milliseconds form, and one too large for Mixpanel. The destination reports each as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" whose reason is a "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Mixpanel answers 200 even when it ingests none of a request’s events, and its track API ingests"},{"type":"text","text":" "},{"type":"text","text":"only events from the last 5 days, so a record older than that when it is sent is counted as"},{"type":"text","text":" "},{"type":"text","text":"delivered and not stored. A wrong region, or a token of no project, may be answered 200 with"},{"type":"text","text":" "},{"type":"text","text":"nothing stored too, so check the project’s Live View after setting the destination up."}],"type":"paragraph"},{"inlineContent":[{"text":"To send to PostHog or Amplitude, use ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"AmplitudeEncoding","type":"codeVoice"},{"text":" instead.","type":"text"}],"type":"paragraph"},{"code":["import HTTPDestinations","import MixpanelEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let mixpanel = try HTTPDestination.mixpanel(","    projectToken: projectToken,","    region: .us,  \/\/ or .eu or .india, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: mixpanel)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"text":" ","type":"text"},{"text":"covers what Mixpanel receives, and why, in more detail.","type":"text"}],"type":"paragraph"}]}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"],"anchor":"Sending-to-Mixpanel","title":"Sending to Mixpanel"},{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"],"anchor":"Encoding-batches","title":"Encoding batches"},{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError"],"anchor":"Records-left-out","title":"Records left out"}],"metadata":{"role":"collection","title":"MixpanelEncoding","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"MixpanelEncoding"}],"externalID":"MixpanelEncoding"},"kind":"symbol","hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"},"abstract":[{"text":"Send records to a Mixpanel project through its track API.","type":"text"}],"variants":[{"paths":["\/documentation\/mixpanelencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"url":"\/documentation\/httpdestinations\/batchencoder","type":"topic","title":"BatchEncoder","kind":"symbol","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"text":" sends.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination/mixpanel(projectToken:region:plan:backoff:clock:)":{"url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:backoff:clock:)","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" is "},{"type":"codeVoice","code":"URLSessionTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"MixpanelBatchEncoder"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"type":"topic","abstract":[{"text":"A destination that sends batches to the Mixpanel project of ","type":"text"},{"type":"codeVoice","code":"projectToken"},{"text":", whose data","type":"text"},{"text":" ","type":"text"},{"text":"resides in ","type":"text"},{"type":"codeVoice","code":"region"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"URLSession.shared"},{"text":", retrying a send that fails for now with the","type":"text"},{"text":" ","type":"text"},{"text":"waits of ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"clock"},{"text":".","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16MixpanelEncoding0A6RegionO","text":"MixpanelRegion","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO","text":"MixpanelSetupError","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV","text":"MixpanelBatchEncoder","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","title":"mixpanel(projectToken:region:plan:backoff:clock:)"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"title":"MixpanelEncodingError","url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelEncodingError"}],"type":"topic","abstract":[{"type":"text","text":"Why "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MixpanelEncodingError"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelRegion":{"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelRegion"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MixpanelRegion"}],"type":"topic","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","abstract":[{"text":"The data residency of a Mixpanel project, which decides the ","type":"text"},{"code":"\/track","type":"codeVoice"},{"text":" endpoint its events are","type":"text"},{"text":" ","type":"text"},{"text":"posted to.","type":"text"}],"url":"\/documentation\/mixpanelencoding\/mixpanelregion","title":"MixpanelRegion"},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"title":"MixpanelEncoding","url":"\/documentation\/mixpanelencoding","type":"topic","abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"kind":"symbol","role":"collection","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/batchLimit":{"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/batchlimit","type":"topic","title":"batchLimit","kind":"symbol","abstract":[{"text":"Mixpanel’s limits on one request: 2,000 events, 2,000,000 bytes of body, and 999,999 bytes","type":"text"},{"text":" ","type":"text"},{"text":"of one event.","type":"text"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination/mixpanel(projectToken:region:plan:transport:backoff:clock:)":{"url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:transport:backoff:clock:)","type":"topic","title":"mixpanel(projectToken:region:plan:transport:backoff:clock:)","kind":"symbol","abstract":[{"text":"A destination that sends batches to the Mixpanel project of ","type":"text"},{"code":"projectToken","type":"codeVoice"},{"text":", whose data","type":"text"},{"text":" ","type":"text"},{"text":"resides in ","type":"text"},{"code":"region","type":"codeVoice"},{"text":", through ","type":"text"},{"code":"transport","type":"codeVoice"},{"text":", retrying a send that fails for now with the waits","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)","role":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"HTTPTransport","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Encoding","type":"codeVoice"},{"type":"text","text":" is "},{"code":"MixpanelBatchEncoder","type":"codeVoice"},{"type":"text","text":"."}]},"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MixpanelRegion","preciseIdentifier":"s:16MixpanelEncoding0A6RegionO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"MixpanelSetupError","preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"MixpanelBatchEncoder","preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelSetupError":{"url":"\/documentation\/mixpanelencoding\/mixpanelsetuperror","type":"topic","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError","title":"MixpanelSetupError","abstract":[{"text":"Why ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)","type":"reference"},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"text"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"MixpanelSetupError","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelSetupError","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"url":"\/documentation\/httpdestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"role":"collection","title":"HTTPDestinations"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder":{"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Mixpanel’s track API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send"},{"type":"text","text":" "},{"type":"text","text":"events to a Mixpanel project’s "},{"type":"codeVoice","code":"POST \/track"},{"type":"text","text":"."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"MixpanelBatchEncoder","kind":"identifier"}],"title":"MixpanelBatchEncoder"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"title":"Choosing Destinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"}}}