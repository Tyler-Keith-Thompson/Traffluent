oder"},{"text":".","type":"text"}]},"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MixpanelRegion","preciseIdentifier":"s:16MixpanelEncoding0A6RegionO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"MixpanelSetupError","preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"URLSessionTransport","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"MixpanelBatchEncoder","preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"mixpanel(projectToken:region:plan:backoff:clock:)","url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:backoff:clock:)"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelSetupError":{"type":"topic","kind":"symbol","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"text"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelSetupError"}],"title":"MixpanelSetupError","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MixpanelSetupError"}],"url":"\/documentation\/mixpanelencoding\/mixpanelsetuperror"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"title":"HTTPDestinations","url":"\/documentation\/httpdestinations","role":"collection","kind":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelRegion":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelRegion"}],"url":"\/documentation\/mixpanelencoding\/mixpanelregion","title":"MixpanelRegion","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","abstract":[{"text":"The data residency of a Mixpanel project, which decides the ","type":"text"},{"code":"\/track","type":"codeVoice"},{"text":" endpoint its events are","type":"text"},{"text":" ","type":"text"},{"text":"posted to.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MixpanelRegion"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"title":"BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"}}}