{"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"anchor":"Sending-to-Mixpanel","title":"Sending to Mixpanel","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"]},{"anchor":"Encoding-batches","title":"Encoding batches","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"]},{"anchor":"Records-left-out","title":"Records left out","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError"]}],"identifier":{"url":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","interfaceLanguage":"swift"},"metadata":{"title":"MixpanelEncoding","modules":[{"name":"MixpanelEncoding"}],"role":"collection","roleHeading":"Framework","externalID":"MixpanelEncoding","symbolKind":"module"},"hierarchy":{"paths":[[]]},"sections":[],"abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":" makes an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"type":"text","text":") for your Mixpanel project in one call. It checks"},{"type":"text","text":" "},{"type":"text","text":"the project token, posts to the "},{"type":"codeVoice","code":"\/track"},{"type":"text","text":" endpoint of the project’s data residency"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","type":"reference","isActive":true},{"type":"text","text":") with a "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","type":"reference","isActive":true},{"type":"text","text":", and splits each batch to Mixpanel’s limits"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","type":"reference","isActive":true},{"type":"text","text":"): 2,000 events and 2 MB a request. A batch with no record the"},{"type":"text","text":" "},{"type":"text","text":"encoder can write, an empty one included, makes no request. It retries no response, a 5xx, 408"},{"type":"text","text":" "},{"type":"text","text":"and 429, and drops and reports any other status. The token goes in each event, so no header field"},{"type":"text","text":" "},{"type":"text","text":"is needed, and no trace context is sent. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves this module out; import it on"},{"type":"text","text":" "},{"type":"text","text":"its own."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The project token is public: Mixpanel’s own apps and web pages ship it. The destination takes"},{"type":"text","text":" "},{"type":"text","text":"nothing else. Never put the project’s secret or a service account’s credentials in an app; they"},{"type":"text","text":" "},{"type":"text","text":"belong to Mixpanel’s import API, for servers. The factory throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"},{"type":"text","text":" for an"},{"type":"text","text":" "},{"type":"text","text":"empty token, and for one with a character other than a letter or digit, which no project token"},{"type":"text","text":" "},{"type":"text","text":"has."}],"type":"paragraph"},{"inlineContent":[{"text":"The region has no default. A project’s data resides in the US, the EU or India, and Mixpanel","type":"text"},{"text":" ","type":"text"},{"text":"ingests nothing for it from another residency’s endpoint, so you pick the region on purpose.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each record becomes an event of an anonymous user. Its ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":" is the record’s session,","type":"text"},{"text":" ","type":"text"},{"text":"from the sessions enricher, also sent as ","type":"text"},{"type":"codeVoice","code":"$device_id"},{"text":"; a record with no session is sent under its","type":"text"},{"text":" ","type":"text"},{"text":"own record identifier, with no ","type":"text"},{"type":"codeVoice","code":"$device_id"},{"text":". Under Simplified ID Merge, Mixpanel shows a","type":"text"},{"text":" ","type":"text"},{"text":"session’s events under ","type":"text"},{"type":"codeVoice","code":"$device:<session>"},{"text":", and a sessionless record’s under its bare record","type":"text"},{"text":" ","type":"text"},{"text":"identifier. No ","type":"text"},{"type":"codeVoice","code":"$user_id"},{"text":" is sent. Its ","type":"text"},{"type":"codeVoice","code":"$insert_id"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"record’s identifier, which a redelivered record keeps, and its ","type":"text"},{"type":"codeVoice","code":"time"},{"text":" the record’s timestamp in","type":"text"},{"text":" ","type":"text"},{"text":"epoch milliseconds. The record’s vendor identifier and trace context aren’t sent. Each event’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ip"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"0"},{"text":", as is the endpoint’s, so Mixpanel adds no location from the request’s address. The","type":"text"},{"text":" ","type":"text"},{"text":"standard context is sent as Mixpanel’s default properties (","type":"text"},{"type":"codeVoice","code":"$app_version_string"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"$app_build_number"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$model"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$wifi"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$os"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"$os_version"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Mixpanel counts a user per ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":", so each session is one user in its reports, and so is","type":"text"},{"text":" ","type":"text"},{"text":"each record sent without a session. On a Mixpanel plan billed by monthly tracked users, each counts","type":"text"},{"text":" ","type":"text"},{"text":"as one.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" the encoder is made with. A"},{"type":"text","text":" "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is never sent, whatever the record reveals. A record the encoder can’t write is"},{"type":"text","text":" "},{"type":"text","text":"left out and the rest of the batch is sent: one the plan doesn’t describe, one whose event name"},{"type":"text","text":" "},{"type":"text","text":"starts with "},{"code":"$","type":"codeVoice"},{"type":"text","text":", as Mixpanel’s own events’ names do, one with a property Mixpanel reads for itself"},{"type":"text","text":" "},{"type":"text","text":"(a "},{"code":"$","type":"codeVoice"},{"type":"text","text":"-prefixed one, "},{"code":"token","type":"codeVoice"},{"type":"text","text":", "},{"code":"time","type":"codeVoice"},{"type":"text","text":", "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":", "},{"code":"ip","type":"codeVoice"},{"type":"text","text":" or "},{"code":"bucket","type":"codeVoice"},{"type":"text","text":"), one of 255 properties or"},{"type":"text","text":" "},{"type":"text","text":"more counting the encoder’s own, one holding an array of 255 elements or more, one whose property"},{"type":"text","text":" "},{"type":"text","text":"nests objects more than 3 deep, one whose event isn’t"},{"type":"text","text":" "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one holding a value JSON can’t, one whose timestamp is before 1971 or has no"},{"type":"text","text":" "},{"type":"text","text":"epoch-milliseconds form, and one too large for Mixpanel. The destination reports each as"},{"type":"text","text":" "},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"type":"text","text":", a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" whose reason is a "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Mixpanel answers 200 even when it ingests none of a request’s events, and its track API ingests"},{"type":"text","text":" "},{"type":"text","text":"only events from the last 5 days, so a record older than that when it is sent is counted as"},{"type":"text","text":" "},{"type":"text","text":"delivered and not stored. A wrong region, or a token of no project, may be answered 200 with"},{"type":"text","text":" "},{"type":"text","text":"nothing stored too, so check the project’s Live View after setting the destination up."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To send to PostHog or Amplitude, use "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":" instead."}],"type":"paragraph"},{"type":"codeListing","code":["import HTTPDestinations","import MixpanelEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let mixpanel = try HTTPDestination.mixpanel(","    projectToken: projectToken,","    region: .us,  \/\/ or .eu or .india, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: mixpanel)"],"syntax":"swift"},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"text":" ","type":"text"},{"text":"covers what Mixpanel receives, and why, in more detail.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mixpanelencoding"]}],"references":{"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination/mixpanel(projectToken:region:plan:backoff:clock:)":{"role":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mixpanel"},{"kind":"text","text":"("},{"kind":"externalParam","text":"projectToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A6RegionO","text":"MixpanelRegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO","text":"MixpanelSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV","text":"MixpanelBatchEncoder"},{"kind":"text","text":">"}],"title":"mixpanel(projectToken:region:plan:backoff:clock:)","type":"topic","url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:backoff:clock:)","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"URLSessionTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"MixpanelBatchEncoder","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"abstract":[{"text":"A destination that sends batches to the Mixpanel project of ","type":"text"},{"code":"projectToken","type":"codeVoice"},{"text":", whose data","type":"text"},{"text":" ","type":"text"},{"text":"resides in ","type":"text"},{"code":"region","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"URLSession.shared","type":"codeVoice"},{"text":", retrying a send that fails for now with the","type":"text"},{"text":" ","type":"text"},{"text":"waits of ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"abstract":[{"type":"text","text":"Why "},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","type":"reference"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"navigatorTitle":[{"text":"MixpanelEncodingError","kind":"identifier"}],"url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelEncodingError","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","title":"MixpanelEncodingError"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/batchLimit":{"kind":"symbol","abstract":[{"type":"text","text":"Mixpanel’s limits on one request: 2,000 events, 2,000,000 bytes of body, and 999,999 bytes"},{"type":"text","text":" "},{"type":"text","text":"of one event."}],"title":"batchLimit","type":"topic","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/batchlimit","role":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier","text":"BatchLimit"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelRegion":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","navigatorTitle":[{"kind":"identifier","text":"MixpanelRegion"}],"url":"\/documentation\/mixpanelencoding\/mixpanelregion","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelRegion"}],"kind":"symbol","title":"MixpanelRegion","abstract":[{"text":"The data residency of a Mixpanel project, which decides the ","type":"text"},{"code":"\/track","type":"codeVoice"},{"text":" endpoint its events are","type":"text"},{"text":" ","type":"text"},{"text":"posted to.","type":"text"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder":{"navigatorTitle":[{"text":"MixpanelBatchEncoder","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"title":"MixpanelBatchEncoder","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder","role":"symbol","abstract":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"text":" of Mixpanel’s track API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can send","type":"text"},{"text":" ","type":"text"},{"text":"events to a Mixpanel project’s ","type":"text"},{"type":"codeVoice","code":"POST \/track"},{"text":".","type":"text"}],"type":"topic"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelSetupError":{"navigatorTitle":[{"kind":"identifier","text":"MixpanelSetupError"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelSetupError"}],"title":"MixpanelSetupError","url":"\/documentation\/mixpanelencoding\/mixpanelsetuperror","role":"symbol","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"text"}],"type":"topic"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination/mixpanel(projectToken:region:plan:transport:backoff:clock:)":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MixpanelRegion","preciseIdentifier":"s:16MixpanelEncoding0A6RegionO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"MixpanelSetupError","preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"MixpanelBatchEncoder","preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"mixpanel(projectToken:region:plan:transport:backoff:clock:)","url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:transport:backoff:clock:)","role":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"HTTPTransport","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Encoding","type":"codeVoice"},{"type":"text","text":" is "},{"code":"MixpanelBatchEncoder","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"abstract":[{"type":"text","text":"A destination that sends batches to the Mixpanel project of "},{"type":"codeVoice","code":"projectToken"},{"type":"text","text":", whose data"},{"type":"text","text":" "},{"type":"text","text":"resides in "},{"type":"codeVoice","code":"region"},{"type":"text","text":", through "},{"type":"codeVoice","code":"transport"},{"type":"text","text":", retrying a send that fails for now with the waits"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"type":"topic"},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"url":"\/documentation\/mixpanelencoding","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","title":"MixpanelEncoding"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"title":"BatchEncoder","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"role":"collection","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","title":"HTTPDestinations","type":"topic","url":"\/documentation\/httpdestinations","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","title":"Choosing Destinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"}}}