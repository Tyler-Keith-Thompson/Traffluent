{"sections":[],"metadata":{"role":"collection","externalID":"MixpanelEncoding","title":"MixpanelEncoding","symbolKind":"module","modules":[{"name":"MixpanelEncoding"}],"roleHeading":"Framework"},"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Sending to Mixpanel","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"],"anchor":"Sending-to-Mixpanel"},{"title":"Encoding batches","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"],"anchor":"Encoding-batches"},{"title":"Records left out","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError"],"anchor":"Records-left-out"}],"identifier":{"url":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)"},{"text":" makes an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"text":") for your Mixpanel project in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the project token, posts to the ","type":"text"},{"code":"\/track","type":"codeVoice"},{"text":" endpoint of the project’s data residency","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion"},{"text":") with a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"},{"text":", and splits each batch to Mixpanel’s limits","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit"},{"text":"): 2,000 events and 2 MB a request. A batch with no record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder can write, an empty one included, makes no request. It retries no response, a 5xx, 408","type":"text"},{"text":" ","type":"text"},{"text":"and 429, and drops and reports any other status. The token goes in each event, so no header field","type":"text"},{"text":" ","type":"text"},{"text":"is needed, and no trace context is sent. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves this module out; import it on","type":"text"},{"text":" ","type":"text"},{"text":"its own.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The project token is public: Mixpanel’s own apps and web pages ship it. The destination takes","type":"text"},{"text":" ","type":"text"},{"text":"nothing else. Never put the project’s secret or a service account’s credentials in an app; they","type":"text"},{"text":" ","type":"text"},{"text":"belong to Mixpanel’s import API, for servers. The factory throws ","type":"text"},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError","isActive":true},{"text":" for an","type":"text"},{"text":" ","type":"text"},{"text":"empty token, and for one with a character other than a letter or digit, which no project token","type":"text"},{"text":" ","type":"text"},{"text":"has.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The region has no default. A project’s data resides in the US, the EU or India, and Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"ingests nothing for it from another residency’s endpoint, so you pick the region on purpose."}],"type":"paragraph"},{"inlineContent":[{"text":"Each record becomes an event of an anonymous user. Its ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":" is the record’s session,","type":"text"},{"text":" ","type":"text"},{"text":"from the sessions enricher, also sent as ","type":"text"},{"code":"$device_id","type":"codeVoice"},{"text":"; a record with no session is sent under its","type":"text"},{"text":" ","type":"text"},{"text":"own record identifier, with no ","type":"text"},{"code":"$device_id","type":"codeVoice"},{"text":". Under Simplified ID Merge, Mixpanel shows a","type":"text"},{"text":" ","type":"text"},{"text":"session’s events under ","type":"text"},{"code":"$device:<session>","type":"codeVoice"},{"text":", and a sessionless record’s under its bare record","type":"text"},{"text":" ","type":"text"},{"text":"identifier. No ","type":"text"},{"code":"$user_id","type":"codeVoice"},{"text":" is sent. Its ","type":"text"},{"code":"$insert_id","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"record’s identifier, which a redelivered record keeps, and its ","type":"text"},{"code":"time","type":"codeVoice"},{"text":" the record’s timestamp in","type":"text"},{"text":" ","type":"text"},{"text":"epoch milliseconds. The record’s vendor identifier and trace context aren’t sent. Each event’s","type":"text"},{"text":" ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"0","type":"codeVoice"},{"text":", as is the endpoint’s, so Mixpanel adds no location from the request’s address. The","type":"text"},{"text":" ","type":"text"},{"text":"standard context is sent as Mixpanel’s default properties (","type":"text"},{"code":"$app_version_string","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"$app_build_number","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$wifi","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"$os_version","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Mixpanel counts a user per ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":", so each session is one user in its reports, and so is","type":"text"},{"text":" ","type":"text"},{"text":"each record sent without a session. On a Mixpanel plan billed by monthly tracked users, each counts","type":"text"},{"text":" ","type":"text"},{"text":"as one.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is made with. A","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is never sent, whatever the record reveals. A record the encoder can’t write is","type":"text"},{"text":" ","type":"text"},{"text":"left out and the rest of the batch is sent: one the plan doesn’t describe, one whose event name","type":"text"},{"text":" ","type":"text"},{"text":"starts with ","type":"text"},{"code":"$","type":"codeVoice"},{"text":", as Mixpanel’s own events’ names do, one with a property Mixpanel reads for itself","type":"text"},{"text":" ","type":"text"},{"text":"(a ","type":"text"},{"code":"$","type":"codeVoice"},{"text":"-prefixed one, ","type":"text"},{"code":"token","type":"codeVoice"},{"text":", ","type":"text"},{"code":"time","type":"codeVoice"},{"text":", ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"bucket","type":"codeVoice"},{"text":"), one of 255 properties or","type":"text"},{"text":" ","type":"text"},{"text":"more counting the encoder’s own, one holding an array of 255 elements or more, one whose property","type":"text"},{"text":" ","type":"text"},{"text":"nests objects more than 3 deep, one whose event isn’t","type":"text"},{"text":" ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one holding a value JSON can’t, one whose timestamp is before 1971 or has no","type":"text"},{"text":" ","type":"text"},{"text":"epoch-milliseconds form, and one too large for Mixpanel. The destination reports each as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" whose reason is a ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Mixpanel answers 200 even when it ingests none of a request’s events, and its track API ingests","type":"text"},{"text":" ","type":"text"},{"text":"only events from the last 5 days, so a record older than that when it is sent is counted as","type":"text"},{"text":" ","type":"text"},{"text":"delivered and not stored. A wrong region, or a token of no project, may be answered 200 with","type":"text"},{"text":" ","type":"text"},{"text":"nothing stored too, so check the project’s Live View after setting the destination up.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To send to PostHog or Amplitude, use "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":" instead."}],"type":"paragraph"},{"syntax":"swift","code":["import HTTPDestinations","import MixpanelEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let mixpanel = try HTTPDestination.mixpanel(","    projectToken: projectToken,","    region: .us,  \/\/ or .eu or .india, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: mixpanel)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what Mixpanel receives, and why, in more detail."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mixpanelencoding"]}],"hierarchy":{"paths":[[]]},"references":{"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder":{"title":"MixpanelBatchEncoder","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","type":"topic","abstract":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of Mixpanel’s track API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can send","type":"text"},{"text":" ","type":"text"},{"text":"events to a Mixpanel project’s ","type":"text"},{"code":"POST \/track","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"MixpanelBatchEncoder","kind":"identifier"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"role":"collection","title":"MixpanelEncoding","type":"topic","url":"\/documentation\/mixpanelencoding","abstract":[{"text":"Send records to a Mixpanel project through its track API.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelSetupError":{"title":"MixpanelSetupError","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError","abstract":[{"text":"Why ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)"},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelsetuperror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelSetupError","kind":"identifier"}],"navigatorTitle":[{"text":"MixpanelSetupError","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" sends.","type":"text"}],"url":"\/documentation\/httpdestinations\/batchencoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"role":"symbol","title":"BatchEncoder","kind":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"title":"MixpanelEncodingError","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"topic","abstract":[{"type":"text","text":"Why "},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","type":"reference"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"kind":"symbol","role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelEncodingError","kind":"identifier"}],"navigatorTitle":[{"text":"MixpanelEncodingError","kind":"identifier"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination/mixpanel(projectToken:region:plan:backoff:clock:)":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:backoff:clock:)","abstract":[{"type":"text","text":"A destination that sends batches to the Mixpanel project of "},{"type":"codeVoice","code":"projectToken"},{"type":"text","text":", whose data"},{"type":"text","text":" "},{"type":"text","text":"resides in "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the"},{"type":"text","text":" "},{"type":"text","text":"waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" is "},{"type":"codeVoice","code":"URLSessionTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"MixpanelBatchEncoder"},{"type":"text","text":"."}]},"type":"topic","title":"mixpanel(projectToken:region:plan:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MixpanelRegion","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A6RegionO"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"MixpanelSetupError","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"URLSessionTransport","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV"},{"text":", ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV"},{"text":">","kind":"text"}],"kind":"symbol","role":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/batchLimit":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","type":"topic","abstract":[{"text":"Mixpanel’s limits on one request: 2,000 events, 2,000,000 bytes of body, and 999,999 bytes","type":"text"},{"text":" ","type":"text"},{"text":"of one event.","type":"text"}],"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/batchlimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"role":"symbol","title":"batchLimit","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"kind":"symbol","role":"collection","url":"\/documentation\/httpdestinations"},