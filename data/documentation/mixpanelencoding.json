>) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MixpanelSetupError","preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"MixpanelBatchEncoder","preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV"},{"kind":"text","text":">"}],"url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:transport:backoff:clock:)","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)","role":"symbol","title":"mixpanel(projectToken:region:plan:transport:backoff:clock:)","type":"topic"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelSetupError":{"navigatorTitle":[{"text":"MixpanelSetupError","kind":"identifier"}],"abstract":[{"text":"Why ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)"},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"text"}],"kind":"symbol","title":"MixpanelSetupError","type":"topic","role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelsetuperror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelSetupError","kind":"identifier"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"kind":"symbol","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"type":"topic","title":"HTTPDestinations","role":"collection","url":"\/documentation\/httpdestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelEncodingError","kind":"identifier"}],"navigatorTitle":[{"text":"MixpanelEncodingError","kind":"identifier"}],"role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","abstract":[{"type":"text","text":"Why "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"title":"MixpanelEncodingError","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"MixpanelBatchEncoder","kind":"identifier"}],"role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder","abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Mixpanel’s track API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send"},{"type":"text","text":" "},{"type":"text","text":"events to a Mixpanel project’s "},{"type":"codeVoice","code":"POST \/track"},{"type":"text","text":"."}],"title":"MixpanelBatchEncoder","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"}}}