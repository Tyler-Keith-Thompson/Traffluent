16MixpanelEncoding0A12BatchEncoderV","text":"MixpanelBatchEncoder","kind":"typeIdentifier"},{"text":">","kind":"text"}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"URLSessionTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"MixpanelBatchEncoder","type":"codeVoice"},{"text":".","type":"text"}]},"abstract":[{"text":"A destination that sends batches to the Mixpanel project of ","type":"text"},{"type":"codeVoice","code":"projectToken"},{"text":", whose data","type":"text"},{"text":" ","type":"text"},{"text":"resides in ","type":"text"},{"type":"codeVoice","code":"region"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"URLSession.shared"},{"text":", retrying a send that fails for now with the","type":"text"},{"text":" ","type":"text"},{"text":"waits of ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"clock"},{"text":".","type":"text"}],"title":"mixpanel(projectToken:region:plan:backoff:clock:)","kind":"symbol","type":"topic","url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:backoff:clock:)"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelRegion":{"role":"symbol","title":"MixpanelRegion","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The data residency of a Mixpanel project, which decides the "},{"code":"\/track","type":"codeVoice"},{"type":"text","text":" endpoint its events are"},{"type":"text","text":" "},{"type":"text","text":"posted to."}],"navigatorTitle":[{"text":"MixpanelRegion","kind":"identifier"}],"url":"\/documentation\/mixpanelencoding\/mixpanelregion","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelRegion","kind":"identifier"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"title":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"text":" sends.","type":"text"}],"url":"\/documentation\/httpdestinations\/batchencoder","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/ExponentialBackoff/mixpanel":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/ExponentialBackoff\/mixpanel","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Mixpanel’s recommended schedule, 2 s doubling to 60 s, with full jitter: a nominal wait of"},{"type":"text","text":" "},{"type":"text","text":"2 seconds before the first retry, doubling up to 60 seconds. Mixpanel recommends the"},{"type":"text","text":" "},{"type":"text","text":"schedule; the full jitter is Traffluent’s, as for every destination."}],"title":"mixpanel","kind":"symbol","type":"topic","url":"\/documentation\/mixpanelencoding\/httpdestinations\/exponentialbackoff\/mixpanel"}}}