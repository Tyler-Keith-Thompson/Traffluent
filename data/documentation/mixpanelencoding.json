{"identifier":{"url":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"],"title":"Sending to Mixpanel","anchor":"Sending-to-Mixpanel"},{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError"],"title":"Records left out","anchor":"Records-left-out"}],"metadata":{"title":"MixpanelEncoding","externalID":"MixpanelEncoding","symbolKind":"module","modules":[{"name":"MixpanelEncoding"}],"roleHeading":"Framework","role":"collection"},"variants":[{"paths":["\/documentation\/mixpanelencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","type":"reference","isActive":true},{"text":" makes an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"text":") for your Mixpanel project in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the project token, posts to the ","type":"text"},{"code":"\/track","type":"codeVoice"},{"text":" endpoint of the project’s data residency","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","type":"reference","isActive":true},{"text":") with a ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","type":"reference","isActive":true},{"text":", and splits each batch to Mixpanel’s limits","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":"): 2,000 events and 2 MB a request. A batch with no record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder can write, an empty one included, makes no request. It retries no response, a 5xx, 408","type":"text"},{"text":" ","type":"text"},{"text":"and 429, and drops and reports any other status. The token goes in each event, so no header field","type":"text"},{"text":" ","type":"text"},{"text":"is needed, and no trace context is sent. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves this module out; import it on","type":"text"},{"text":" ","type":"text"},{"text":"its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The project token is public: Mixpanel’s own apps and web pages ship it. The destination takes","type":"text"},{"text":" ","type":"text"},{"text":"nothing else. Never put the project’s secret or a service account’s credentials in an app; they","type":"text"},{"text":" ","type":"text"},{"text":"belong to Mixpanel’s import API, for servers. The factory throws ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError","type":"reference","isActive":true},{"text":" for an","type":"text"},{"text":" ","type":"text"},{"text":"empty token, and for one with a character other than a letter or digit, which no project token","type":"text"},{"text":" ","type":"text"},{"text":"has.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The region has no default. A project’s data resides in the US, the EU or India, and Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"ingests nothing for it from another residency’s endpoint, so you pick the region on purpose."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each record becomes an event of an anonymous user. Its "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" is the record’s session,"},{"type":"text","text":" "},{"type":"text","text":"from the sessions enricher, also sent as "},{"type":"codeVoice","code":"$device_id"},{"type":"text","text":"; a record with no session is sent under its"},{"type":"text","text":" "},{"type":"text","text":"own record identifier, with no "},{"type":"codeVoice","code":"$device_id"},{"type":"text","text":". Under Simplified ID Merge, Mixpanel shows a"},{"type":"text","text":" "},{"type":"text","text":"session’s events under "},{"type":"codeVoice","code":"$device:<session>"},{"type":"text","text":", and a sessionless record’s under its bare record"},{"type":"text","text":" "},{"type":"text","text":"identifier. No "},{"type":"codeVoice","code":"$user_id"},{"type":"text","text":" is sent. Its "},{"type":"codeVoice","code":"$insert_id"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"record’s identifier, which a redelivered record keeps, and its "},{"type":"codeVoice","code":"time"},{"type":"text","text":" the record’s timestamp in"},{"type":"text","text":" "},{"type":"text","text":"epoch milliseconds. The record’s vendor identifier and trace context aren’t sent. Each event’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"ip"},{"type":"text","text":" is "},{"type":"codeVoice","code":"0"},{"type":"text","text":", as is the endpoint’s, so Mixpanel adds no location from the request’s address. The"},{"type":"text","text":" "},{"type":"text","text":"standard context is sent as Mixpanel’s default properties ("},{"type":"codeVoice","code":"$app_version_string"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"$app_build_number"},{"type":"text","text":", "},{"type":"codeVoice","code":"$model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"$os"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$os_version"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mixpanel counts a user per "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", so each session is one user in its reports, and so is"},{"type":"text","text":" "},{"type":"text","text":"each record sent without a session. On a Mixpanel plan billed by monthly tracked users, each counts"},{"type":"text","text":" "},{"type":"text","text":"as one."}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is made with. A","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is never sent, whatever the record reveals. A record the encoder can’t write is","type":"text"},{"text":" ","type":"text"},{"text":"left out and the rest of the batch is sent: one the plan doesn’t describe, one whose event name","type":"text"},{"text":" ","type":"text"},{"text":"starts with ","type":"text"},{"code":"$","type":"codeVoice"},{"text":", as Mixpanel’s own events’ names do, one with a property Mixpanel reads for itself","type":"text"},{"text":" ","type":"text"},{"text":"(a ","type":"text"},{"code":"$","type":"codeVoice"},{"text":"-prefixed one, ","type":"text"},{"code":"token","type":"codeVoice"},{"text":", ","type":"text"},{"code":"time","type":"codeVoice"},{"text":", ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"bucket","type":"codeVoice"},{"text":"), one of 255 properties or","type":"text"},{"text":" ","type":"text"},{"text":"more counting the encoder’s own, one holding an array of 255 elements or more, one whose property","type":"text"},{"text":" ","type":"text"},{"text":"nests objects more than 3 deep, one whose event isn’t","type":"text"},{"text":" ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one holding a value JSON can’t, one whose timestamp is before 1971 or has no","type":"text"},{"text":" ","type":"text"},{"text":"epoch-milliseconds form, and one too large for Mixpanel. The destination reports each as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" whose reason is a ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mixpanel answers 200 even when it ingests none of a request’s events, and its track API ingests"},{"type":"text","text":" "},{"type":"text","text":"only events from the last 5 days, so a record older than that when it is sent is counted as"},{"type":"text","text":" "},{"type":"text","text":"delivered and not stored. A wrong region, or a token of no project, may be answered 200 with"},{"type":"text","text":" "},{"type":"text","text":"nothing stored too, so check the project’s Live View after setting the destination up."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to PostHog or Amplitude, use "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":" instead."}]},{"code":["import HTTPDestinations","import MixpanelEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let mixpanel = try HTTPDestination.mixpanel(","    projectToken: projectToken,","    region: .us,  \/\/ or .eu or .india, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: mixpanel)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what Mixpanel receives, and why, in more detail."}]}]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"title":"BatchEncoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}],"url":"\/documentation\/httpdestinations\/batchencoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination/mixpanel(projectToken:region:plan:backoff:clock:)":{"abstract":[{"type":"text","text":"A destination that sends batches to the Mixpanel project of "},{"type":"codeVoice","code":"projectToken"},{"type":"text","text":", whose data"},{"type":"text","text":" "},{"type":"text","text":"resides in "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the"},{"type":"text","text":" "},{"type":"text","text":"waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"kind":"symbol","title":"mixpanel(projectToken:region:plan:backoff:clock:)","type":"topic","role":"symbol","url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MixpanelRegion","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A6RegionO"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},