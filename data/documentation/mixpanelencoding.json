stination\/mixpanel(projectToken:region:plan:transport:backoff:clock:)"},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"text"}],"url":"\/documentation\/mixpanelencoding\/mixpanelsetuperror","navigatorTitle":[{"kind":"identifier","text":"MixpanelSetupError"}],"title":"MixpanelSetupError","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelSetupError"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"role":"symbol","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}],"title":"BatchEncoder","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelRegion":{"role":"symbol","abstract":[{"text":"The data residency of a Mixpanel project, which decides the ","type":"text"},{"type":"codeVoice","code":"\/track"},{"text":" endpoint its events are","type":"text"},{"text":" ","type":"text"},{"text":"posted to.","type":"text"}],"title":"MixpanelRegion","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MixpanelRegion"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","url":"\/documentation\/mixpanelencoding\/mixpanelregion","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelRegion"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelBatchEncoder"}],"kind":"symbol","type":"topic","abstract":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of Mixpanel’s track API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can send","type":"text"},{"text":" ","type":"text"},{"text":"events to a Mixpanel project’s ","type":"text"},{"type":"codeVoice","code":"POST \/track"},{"text":".","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MixpanelBatchEncoder"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","role":"symbol","title":"MixpanelBatchEncoder","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination/mixpanel(projectToken:region:plan:backoff:clock:)":{"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"URLSessionTransport"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Encoding"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"MixpanelBatchEncoder"},{"text":".","type":"text"}]},"type":"topic","role":"symbol","abstract":[{"text":"A destination that sends batches to the Mixpanel project of ","type":"text"},{"type":"codeVoice","code":"projectToken"},{"text":", whose data","type":"text"},{"text":" ","type":"text"},{"text":"resides in ","type":"text"},{"type":"codeVoice","code":"region"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"URLSession.shared"},{"text":", retrying a send that fails for now with the","type":"text"},{"text":" ","type":"text"},{"text":"waits of ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"clock"},{"text":".","type":"text"}],"kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","title":"mixpanel(projectToken:region:plan:backoff:clock:)","url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MixpanelRegion","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A6RegionO"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"MixpanelSetupError","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"URLSessionTransport","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV"},{"text":", ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV"},{"text":">","kind":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"url":"\/documentation\/httpdestinations","title":"HTTPDestinations","kind":"symbol","type":"topic","role":"collection"}}}