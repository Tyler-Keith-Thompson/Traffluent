{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","isActive":true},{"type":"text","text":" is a plain sink with one requirement, "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true},{"type":"text","text":", which is given"},{"type":"text","text":" "},{"type":"text","text":"a batch of records, oldest first. Delivering is a chain of operators over a tracker’s records:"},{"type":"text","text":" "},{"type":"codeVoice","code":"batch()"},{"type":"text","text":" gathers them into batches of 20, and every 30 seconds while any are pending, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"deliver(to:batchBufferLimit:)"},{"type":"text","text":" makes a "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","isActive":true},{"type":"text","text":", which hands each batch to every"},{"type":"text","text":" "},{"type":"text","text":"destination. It holds a lazy unit of work, "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/work","isActive":true},{"type":"text","text":", that runs once you call "},{"type":"codeVoice","code":"execute()"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each destination receives its batches in order, one at a time, from a buffer of its own, so a"},{"type":"text","text":" "},{"type":"text","text":"slow one delays only itself. A full buffer drops its oldest batch and reports it as a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","isActive":true},{"type":"text","text":" on the delivery’s "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","isActive":true},{"type":"text","text":", which one task reads at a"},{"type":"text","text":" "},{"type":"text","text":"time, as every report stream does. When the tracker has a store, the delivery reads the dropped"},{"type":"text","text":" "},{"type":"text","text":"batch’s records back for that destination once it catches up, and tells the store when each batch"},{"type":"text","text":" "},{"type":"text","text":"has reached every destination."}],"type":"paragraph"},{"inlineContent":[{"text":"What a destination receives is narrowed by modifiers: ","type":"text"},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","isActive":true},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"consent categories it serves, ","type":"text"},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","isActive":true},{"text":", and added to by ","type":"text"},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","isActive":true},{"text":", which runs an","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","isActive":true},{"text":" on the records that destination alone receives. ","type":"text"},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","isActive":true},{"text":" ","type":"text"},{"text":"prints each event, and ","type":"text"},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","isActive":true},{"text":" keeps the newest records it receives for the app to","type":"text"},{"text":" ","type":"text"},{"text":"read, in a debug view or a test.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Logs, traces and servers have destinations in modules of their own, so an app links only the ones"},{"type":"text","text":" "},{"type":"text","text":"it uses: "},{"type":"codeVoice","code":"LoggerDestination"},{"type":"text","text":" in "},{"type":"codeVoice","code":"LoggingDestinations"},{"type":"text","text":", "},{"type":"codeVoice","code":"SpanEventDestination"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"codeVoice","code":"TracingDestinations"},{"type":"text","text":" and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" in "},{"type":"codeVoice","code":"HTTPDestinations"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["struct Uploader: Destination {","    func receive(_ batch: [EventRecord]) async {","        \/\/ Send the batch, and return once it is somewhere it won't be lost.","    }","}","","let inspector = try InMemoryDestination(capacity: 500)","let tracker = Tracker()","let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(","        to: Uploader().accepting(.analytics).redactingSensitiveValues().droppingCallSite(),","        inspector","    )","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()","let received = inspector.events(of: SignedUp.self)  \/\/ [SignedUp(plan: \"pro\")]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"sections":[],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"metadata":{"modules":[{"name":"Destinations"}],"symbolKind":"module","roleHeading":"Framework","role":"collection","title":"Destinations","externalID":"Destinations"},"topicSections":[{"anchor":"Destinations","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","doc:\/\/Destinations\/documentation\/Destinations\/InvalidCapacity"],"title":"Destinations"},{"anchor":"Delivering","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)","doc:\/\/Destinations\/documentation\/Destinations\/Delivery","doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"],"title":"Delivering"}],"variants":[{"paths":["\/documentation\/destinations"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"references":{"doc://Destinations/documentation/Destinations/Destination/droppingCallSite()":{"abstract":[{"type":"text","text":"This destination, receiving each record without its call site: "},{"type":"codeVoice","code":"EventRecord.sourceLocation"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"url":"\/documentation\/destinations\/destination\/droppingcallsite()","fragments":[{"text":"func","kind":"keyword