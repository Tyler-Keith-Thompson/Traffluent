{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations"},"abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"hierarchy":{"paths":[[]]},"topicSections":[{"anchor":"Destinations","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","doc:\/\/Destinations\/documentation\/Destinations\/InvalidCapacity"],"title":"Destinations"},{"anchor":"Delivering","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)","doc:\/\/Destinations\/documentation\/Destinations\/Delivery","doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"],"title":"Delivering"}],"metadata":{"roleHeading":"Framework","externalID":"Destinations","modules":[{"name":"Destinations"}],"symbolKind":"module","role":"collection","title":"Destinations"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","type":"reference"},{"type":"text","text":" is a plain sink with one requirement, "},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference"},{"type":"text","text":", which is given"},{"type":"text","text":" "},{"type":"text","text":"a batch of records, oldest first. Delivering is a chain of operators over a tracker’s records:"},{"type":"text","text":" "},{"code":"batch()","type":"codeVoice"},{"type":"text","text":" gathers them into batches of 20, and every 30 seconds while any are pending, and"},{"type":"text","text":" "},{"code":"deliver(to:batchBufferLimit:)","type":"codeVoice"},{"type":"text","text":" makes a "},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","type":"reference"},{"type":"text","text":", which hands each batch to every"},{"type":"text","text":" "},{"type":"text","text":"destination. It holds a lazy unit of work, "},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/work","type":"reference"},{"type":"text","text":", that runs once you call "},{"code":"execute()","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each destination receives its batches in order, one at a time, from a buffer of its own, so a"},{"type":"text","text":" "},{"type":"text","text":"slow one delays only itself. A full buffer drops its oldest batch and reports it as a"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","type":"reference"},{"type":"text","text":" on the delivery’s "},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","type":"reference"},{"type":"text","text":", which one task reads at a"},{"type":"text","text":" "},{"type":"text","text":"time, as every report stream does. When the tracker has a store, the delivery reads the dropped"},{"type":"text","text":" "},{"type":"text","text":"batch’s records back for that destination once it catches up, and tells the store when each batch"},{"type":"text","text":" "},{"type":"text","text":"has reached every destination."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What a destination receives is narrowed by modifiers: "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","isActive":true},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"consent categories it serves, "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","isActive":true},{"type":"text","text":", and added to by "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","isActive":true},{"type":"text","text":", which runs an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","isActive":true},{"type":"text","text":" on the records that destination alone receives. "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","isActive":true},{"type":"text","text":" "},{"type":"text","text":"prints each event, and "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","isActive":true},{"type":"text","text":" keeps the newest records it receives for the app to"},{"type":"text","text":" "},{"type":"text","text":"read, in a debug view or a test."}]},{"type":"paragraph","inlineContent":[{"text":"Logs, traces and servers have destinations in modules of their own, so an app links only the ones","type":"text"},{"text":" ","type":"text"},{"text":"it uses: ","type":"text"},{"code":"LoggerDestination","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"LoggingDestinations","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SpanEventDestination","type":"codeVoice"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"code":"TracingDestinations","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"HTTPDestinations","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":["struct Uploader: Destination {","    func receive(_ batch: [EventRecord]) async {","        \/\/ Send the batch, and return once it is somewhere it won't be lost.","    }","}","","let inspector = try InMemoryDestination(capacity: 500)","let tracker = Tracker()","let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(","        to: Uploader().accepting(.analytics).redactingSensitiveValues().droppingCallSite(),","        inspector","    )","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()","let received = inspector.events(of: SignedUp.self)  \/\/ [SignedUp(plan: \"pro\")]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"kind":"symbol","references":{"doc://Destinations/documentation/Destinations/Destination/enriched(by:)":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","role":"symbol","url":"\/documentation\/destinations\/destination\/enriched(by:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},