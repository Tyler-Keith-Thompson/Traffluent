{"metadata":{"title":"Destinations","externalID":"Destinations","roleHeading":"Framework","modules":[{"name":"Destinations"}],"symbolKind":"module","role":"collection"},"topicSections":[{"title":"Destinations","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","doc:\/\/Destinations\/documentation\/Destinations\/InvalidCapacity"],"anchor":"Destinations"},{"title":"Delivering","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:bufferDropReporter:)","doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"],"anchor":"Delivering"}],"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations","interfaceLanguage":"swift"},"abstract":[{"text":"Where tracked events go: the ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/destinations"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","isActive":true},{"type":"text","text":" is a plain sink with one requirement, "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true},{"type":"text","text":", which is given"},{"type":"text","text":" "},{"type":"text","text":"a batch of records, oldest first. Delivering is a chain of operators over a tracker’s records:"},{"type":"text","text":" "},{"code":"batch()","type":"codeVoice"},{"type":"text","text":" gathers them into batches of 20, and every 30 seconds while any are pending, and"},{"type":"text","text":" "},{"code":"deliver(to:batchBufferLimit:bufferDropReporter:)","type":"codeVoice"},{"type":"text","text":" hands each batch to every destination as a"},{"type":"text","text":" "},{"type":"text","text":"lazy unit of work that runs once you call "},{"code":"execute()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Each destination receives its batches in order, one at a time, from a buffer of its own, so a","type":"text"},{"text":" ","type":"text"},{"text":"slow one delays only itself. A full buffer drops its oldest batch and reports it as a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","isActive":true,"type":"reference"},{"text":". When the tracker has a store, the delivery reads the dropped batch’s records","type":"text"},{"text":" ","type":"text"},{"text":"back for that destination once it catches up, and tells the store when each batch has reached","type":"text"},{"text":" ","type":"text"},{"text":"every destination.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What a destination receives is narrowed by modifiers: "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","type":"reference","isActive":true},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"consent categories it serves, "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","type":"reference","isActive":true},{"type":"text","text":", and added to by "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","type":"reference","isActive":true},{"type":"text","text":", which runs an"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","type":"reference","isActive":true},{"type":"text","text":" on the records that destination alone receives. "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"prints each event, and "},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","type":"reference","isActive":true},{"type":"text","text":" keeps the newest records it receives for the app to"},{"type":"text","text":" "},{"type":"text","text":"read, in a debug view or a test."}],"type":"paragraph"},{"inlineContent":[{"text":"Logs, traces and servers have destinations in modules of their own, so an app links only the ones","type":"text"},{"text":" ","type":"text"},{"text":"it uses: ","type":"text"},{"code":"LoggerDestination","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"LoggingDestinations","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SpanEventDestination","type":"codeVoice"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"code":"TracingDestinations","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"HTTPDestinations","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Uploader: Destination {","    func receive(_ batch: [EventRecord]) async {","        \/\/ Send the batch, and return once it is somewhere it won't be lost.","    }","}","","let inspector = InMemoryDestination(capacity: 500)","let tracker = Tracker()","let delivery = tracker.records","    .batch(s