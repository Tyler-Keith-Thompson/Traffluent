{"metadata":{"externalID":"Destinations","symbolKind":"module","modules":[{"name":"Destinations"}],"role":"collection","roleHeading":"Framework","title":"Destinations"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","type":"reference","isActive":true},{"text":" is a plain sink with one requirement, ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference","isActive":true},{"text":", which is given","type":"text"},{"text":" ","type":"text"},{"text":"a batch of records, oldest first. Delivering is a chain of operators over a tracker’s records:","type":"text"},{"text":" ","type":"text"},{"code":"batch()","type":"codeVoice"},{"text":" gathers them into batches of 20, and every 30 seconds while any are pending, and","type":"text"},{"text":" ","type":"text"},{"code":"deliver(to:batchBufferLimit:bufferDropReporter:)","type":"codeVoice"},{"text":" hands each batch to every destination as a","type":"text"},{"text":" ","type":"text"},{"text":"lazy unit of work that runs once you call ","type":"text"},{"code":"execute()","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each destination receives its batches in order, one at a time, from a buffer of its own, so a"},{"type":"text","text":" "},{"type":"text","text":"slow one delays only itself. A full buffer drops its oldest batch and reports it as a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","isActive":true},{"type":"text","text":". When the tracker has a store, the delivery reads the dropped batch’s records"},{"type":"text","text":" "},{"type":"text","text":"back for that destination once it catches up, and tells the store when each batch has reached"},{"type":"text","text":" "},{"type":"text","text":"every destination."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What a destination receives is narrowed by modifiers: "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","isActive":true},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"consent categories it serves, "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","isActive":true},{"type":"text","text":", and added to by "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","isActive":true},{"type":"text","text":", which runs an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","isActive":true},{"type":"text","text":" on the records that destination alone receives. "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","isActive":true},{"type":"text","text":" "},{"type":"text","text":"prints each event, and "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","isActive":true},{"type":"text","text":" keeps the newest records it receives for the app to"},{"type":"text","text":" "},{"type":"text","text":"read, in a debug view or a test."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Logs, traces and servers have destinations in modules of their own, so an app links only the ones"},{"type":"text","text":" "},{"type":"text","text":"it uses: "},{"type":"codeVoice","code":"LoggerDestination"},{"type":"text","text":" in "},{"type":"codeVoice","code":"LoggingDestinations"},{"type":"text","text":", "},{"type":"codeVoice","code":"SpanEventDestination"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"codeVoice","code":"TracingDestinations"},{"type":"text","text":" and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" in "},{"type":"codeVoice","code":"HTTPDestinations"},{"type":"text","text":"."}]},{"syntax":"swift","code":["struct Uploader: Destination {","    func receive(_ batch: [EventRecord]) async {","        \/\/ Send the batch, and return once it is somewhere it won't be lost.","    }","}","","let inspector = try InMemoryDestination(capacity: 500)","let tracker = Tracker()","let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(","        to: Uploader().accepting(.analytics).redactingSensitiveValues().droppingCallSite(),","        inspector","    )","tracker.track(SignedUp(plan: \"pro\"))","await tracker.finish()","try await delivery.execute()","let received = inspector.events(of: SignedUp.self)  \/\/ [SignedUp(plan: \"pro\")]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":"."}]}]}],"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations","interfaceLanguage":"swift"},"topicSections":[{"title":"Destinations","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","doc:\/\/Destinations\/documentation\/Destinations\/InvalidCapacity"],"anchor":"Destinations"},{"title":"Delivering","identifiers":["doc:\/\/Destinations\/documentation\/Desti