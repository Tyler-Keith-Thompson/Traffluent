{"abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/standardcontext"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Each standard value has an enricher of its own, and nothing is added to a record until the app"},{"type":"text","text":" "},{"type":"text","text":"builds its tracker with that enricher. Each one sets a typed "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":" key whose value a"},{"type":"text","text":" "},{"type":"text","text":"destination reads from the record’s context: "},{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/ApplicationKey","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/DeviceKey","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/OperatingSystemKey","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/LocaleKey","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/NetworkKey","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The app, device, operating system and locale are read once, when the enricher is made, never per"},{"type":"text","text":" "},{"type":"text","text":"event. The network connection changes while the app runs, so on Apple platforms "},{"type":"codeVoice","code":"network()"},{"type":"text","text":" starts"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"NWPathMonitor"},{"type":"text","text":" of its own and sets the latest connection on each record. Give each tracker its"},{"type":"text","text":" "},{"type":"text","text":"own call. Off Apple platforms there is no device and no path monitor, so those two enrichers set"},{"type":"text","text":" "},{"type":"text","text":"nothing, and a server or tool, whose process usually has no Info.plist, passes its own app to"},{"type":"text","text":" "},{"type":"codeVoice","code":"application(_:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"code":"vendorIdentifier()","type":"codeVoice"},{"type":"text","text":", made on the main actor, adds the platform’s identifier for vendor as a"},{"type":"text","text":" "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value. It is the one identifier here that outlives a session, so add it only when the"},{"type":"text","text":" "},{"type":"text","text":"app has decided to and has the user’s consent. It is never stored or made up: on macOS and Linux,"},{"type":"text","text":" "},{"type":"text","text":"which have none, records carry no key."}],"type":"paragraph"},{"inlineContent":[{"text":"For the session an event was tracked in, use ","type":"text"},{"code":"Sessions","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["import StandardContext","import Trackers","","let tracker = Tracker(enrichers: [.application(), .operatingSystem(), .locale(), .network()])","tracker.track(SignedUp(plan: \"pro\"))","\/\/ A destination reads each value from the record's context:","\/\/ record.context[ApplicationKey.self]?.version, record.context[OperatingSystemKey.self]?.name"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/sessionsandstandardcontext","type":"reference"},{"text":" ","type":"text"},{"text":"covers each value and the identifier for vendor in more detail.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"symbolKind":"module","title":"StandardContext","roleHeading":"Framework","role":"collection","externalID":"StandardContext","modules":[{"name":"StandardContext"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/StandardContext\/documentation\/StandardContext"},"sections":[],"topicSections":[{"title":"The app","anchor":"The-app","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/application(_:)","doc:\/\/StandardContext\/documentation\/StandardContext\/ApplicationKey"]},{"title":"The device","anchor":"The-device","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/device(_:)","doc:\/\/StandardContext\/documentation\/StandardContext\/DeviceKey"]},{"title":"The operating system","anchor":"The-operating-system","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/operatingSystem(_:)","doc:\/\/StandardContext\/documentation\/StandardContext\/OperatingSystemKey"]},{"title":"The locale","anchor":"The-locale","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/locale(_:)","doc:\/\/StandardContext\/documentation\/StandardContext\/LocaleKey"]},{"title":"The network connection","anchor":"The-network-connection","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/network()","doc:\/\/StandardContext\/documentation\/StandardContext\/NetworkKey"]},{"title":"The identifier for vendor","anchor":"The-identifier-for-vendor","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/vendorIdentifier()","doc: