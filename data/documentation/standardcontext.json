own app to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"application(_:)"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"vendorIdentifier()","type":"codeVoice"},{"text":", made on the main actor, adds the platform’s identifier for vendor as a","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value. It is the one identifier here that outlives a session, so add it only when the","type":"text"},{"text":" ","type":"text"},{"text":"app has decided to and has the user’s consent. It is never stored or made up: on macOS and Linux,","type":"text"},{"text":" ","type":"text"},{"text":"which have none, records carry no key.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For the session an event was tracked in, use ","type":"text"},{"code":"Sessions","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["import StandardContext","import Trackers","","let tracker = Tracker(enrichers: [.application(), .operatingSystem(), .locale(), .network()])","tracker.track(SignedUp(plan: \"pro\"))","\/\/ A destination reads each value from the record's context:","\/\/ record.context[ApplicationKey.self]?.version, record.context[OperatingSystemKey.self]?.name"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/sessionsandstandardcontext","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"covers each value and the identifier for vendor in more detail.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/standardcontext"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/