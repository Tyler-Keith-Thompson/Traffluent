{"metadata":{"externalID":"StandardContext","role":"collection","roleHeading":"Framework","modules":[{"name":"StandardContext"}],"title":"StandardContext","symbolKind":"module"},"hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","abstract":[{"type":"text","text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Each standard value has an enricher of its own, and nothing is added to a record until the app"},{"type":"text","text":" "},{"type":"text","text":"builds its tracker with that enricher. Each one sets a typed "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" key whose value a"},{"type":"text","text":" "},{"type":"text","text":"destination reads from the record’s context: "},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/ApplicationKey","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/DeviceKey","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/OperatingSystemKey","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/LocaleKey","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/NetworkKey","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The app, device, operating system and locale are read once, when the enricher is made, never per","type":"text"},{"text":" ","type":"text"},{"text":"event. The network connection changes while the app runs, so on Apple platforms ","type":"text"},{"type":"codeVoice","code":"network()"},{"text":" starts","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"NWPathMonitor"},{"text":" of its own and sets the latest connection on each record. Give each tracker its","type":"text"},{"text":" ","type":"text"},{"text":"own call. Off Apple platforms there is no device and no path monitor, so those two enrichers set","type":"text"},{"text":" ","type":"text"},{"text":"nothing, and a server or tool, whose process usually has no Info.plist, passes its own app to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"application(_:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"vendorIdentifier()"},{"type":"text","text":", made on the main actor, adds the platform’s identifier for vendor as a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value. It is the one identifier here that outlives a session, so add it only when the"},{"type":"text","text":" "},{"type":"text","text":"app has decided to and has the user’s consent. It is never stored or made up: on macOS and Linux,"},{"type":"text","text":" "},{"type":"text","text":"which have none, records carry no key."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For the session an event was tracked in, use "},{"type":"codeVoice","code":"Sessions"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["import StandardContext","import Trackers","","let tracker = Tracker(enrichers: [.application(), .operatingSystem(), .locale(), .network()])","tracker.track(SignedUp(plan: \"pro\"))","\/\/ A destination reads each value from the record's context:","\/\/ record.context[Applicatio