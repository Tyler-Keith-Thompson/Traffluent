{"variants":[{"paths":["\/documentation\/standardcontext"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each standard value has an enricher of its own, and nothing is added to a record until the app"},{"type":"text","text":" "},{"type":"text","text":"builds its tracker with that enricher. Each one sets a typed "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" key whose value a"},{"type":"text","text":" "},{"type":"text","text":"destination reads from the record’s context: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/ApplicationKey"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/DeviceKey"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/OperatingSystemKey"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/LocaleKey"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/NetworkKey"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The app, device, operating system and locale are read once, when the enricher is made, never per"},{"type":"text","text":" "},{"type":"text","text":"event. The network connection changes while the app runs, so on Apple platforms "},{"type":"codeVoice","code":"network()"},{"type":"text","text":" starts"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"NWPathMonitor"},{"type":"text","text":" of its own and sets the latest connection on each record. Give each tracker its"},{"type":"text","text":" "},{"type":"text","text":"own call. Off Apple platforms there is no device and no path monitor, so those two enrichers set"},{"type":"text","text":" "},{"type":"text","text":"nothing, and a server or tool, whose process usually has no Info.plist, passes its own app to"},{"type":"text","text":" "},{"type":"codeVoice","code":"application(_:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"code":"vendorIdentifier()","type":"codeVoice"},{"text":", made on the main actor, adds the platform’s identifier for vendor as a","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value. It is the one identifier here that outlives a session, so add it only when the","type":"text"},{"text":" ","type":"text"},{"text":"app has decided to and has the user’s consent. It is never stored or made up: on macOS and Linux,","type":"text"},{"text":" ","type":"text"},{"text":"which have none, records carry no key.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For the session an event was tracked in, use "},{"type":"codeVoice","code":"Sessions"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["import StandardContext","import Trackers","","let tracker = Tracker(enrichers: [.application(), .operatingSystem(), .locale(), .network()])","tracker.track(SignedUp(plan: \"pro\"))","\/\/ A destination reads each value from the record's context:","\/\/ record.context[ApplicationKey.self]?.version, record.context[OperatingSystemKey.self]?.name"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The guide ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/sessionsandstandardcontext"},{"text":" ","type":"t