{"identifier":{"url":"doc:\/\/StandardContext\/documentation\/StandardContext","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"title":"The app","anchor":"The-app","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/application(_:)","doc:\/\/StandardContext\/documentation\/StandardContext\/ApplicationKey"]},{"title":"The device","anchor":"The-device","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/device(_:)","doc:\/\/StandardContext\/documentation\/StandardContext\/DeviceKey"]},{"title":"The operating system","anchor":"The-operating-system","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/operatingSystem(_:)","doc:\/\/StandardContext\/documentation\/StandardContext\/OperatingSystemKey"]},{"title":"The locale","anchor":"The-locale","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/locale(_:)","doc:\/\/StandardContext\/documentation\/StandardContext\/LocaleKey"]},{"title":"The network connection","anchor":"The-network-connection","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/network()","doc:\/\/StandardContext\/documentation\/StandardContext\/NetworkKey"]},{"title":"The identifier for vendor","anchor":"The-identifier-for-vendor","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/vendorIdentifier()","doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey"]}],"sections":[],"hierarchy":{"paths":[[]]},"metadata":{"title":"StandardContext","role":"collection","modules":[{"name":"StandardContext"}],"roleHeading":"Framework","symbolKind":"module","externalID":"StandardContext"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/standardcontext"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each standard value has an enricher of its own, and nothing is added to a record until the app","type":"text"},{"text":" ","type":"text"},{"text":"builds its tracker with that enricher. Each one sets a typed ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":" key whose value a","type":"text"},{"text":" ","type":"text"},{"text":"destination reads from the record’s context: ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/ApplicationKey","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/DeviceKey","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/OperatingSystemKey","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/LocaleKey","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/NetworkKey","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app, device, operating system and locale are read once, when the enricher is made, never per"},{"type":"text","text":" "},{"type":"text","text":"event. The network connection changes while the app runs, so on Apple platforms "},{"type":"codeVoice","code":"network()"},{"type":"text","text":" starts"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"NWPathMonitor"},{"type":"text","text":" of its own and sets the latest connection on each record. Give each tracker its"},{"type":"text","text":" "},{"type":"text","text":"own call. Off Apple platforms there is no device and no path monitor, so those two enrichers set"},{"type":"text","text":" "},{"type":"text","text":"nothing, and a server or tool, whose process usually has no Info.plist, passes its own app to"},{"type":"text","text":" "},{"type":"codeVoice","code":"application(_:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"vendorIdentifier()"},{"type":"text","text":", made on the main actor, adds the platform’s identifier for vendor as a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value. It is the one identifier here that outlives a session, so add it only when the"},{"type":"text","text":" "},{"type":"text","text":"app has decided to and has the user’s consent. It is never stored or made up: on macOS and Linux,"},{"type":"text","text":" "},{"type":"text","text":"which have none, records carry no key."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the session an event was tracked in, use "},{"code":"Sessions","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["import StandardContext","import Trackers","","let tracker = Tracker(enrichers: [.application(), .operatingSystem(), .locale(), .network()])","tracker.track(SignedUp(plan: \"pro\"))","\/\/ A destination reads each value from the record's context:","\/\/ record.context[ApplicationKey.self]?.version, record.context[OperatingSystemKey.self]?.name"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/sessionsandstandardcontext"},{"type":"text","text":" "},{"type":"text","text":"covers each value and the identifier for vendor in more detail."}]}]}],"kind":"symbol","abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"references":{"doc://StandardContext/documentation/StandardContext/Events/Enricher/vendorIdentifier()":{"abstract":[{"text":"An enricher that sets every record’s ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","isActive":true,"type":"reference"},{"text":" to the platform’s identifier for","type":"text"},{"text":" ","type":"text"},{"text":"vendor, where it has one.","type":"text"}],"role":"symbol","url":"\/documentation\/standardcontext\/events\/enricher\/vendoridentifier()","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/vendorIdentifier()","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"vendorIdentifier"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:6Events8EnricherV","kind":"typeIdentifier","text":"Enricher"}],"title":"vendorIdentifier()"},"doc://StandardContext/documentation/StandardContext/Events/Enricher/network()":{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/network()","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"network"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"}],"abstract":[{"type":"text","text":"An enricher that sets every record’s "},{"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/NetworkKey","isActive":true},{"type":"text","text":" to the connection the device uses when"},{"type":"text","text":" "},{"type":"text","text":"the tracker’s worker reaches it, or, given to a destination with "},{"type":"codeVoice","code":"enriched(by:)"