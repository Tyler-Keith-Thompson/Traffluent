{"metadata":{"title":"batchLimit","remoteSource":{"fileName":"TelemetryDeckBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder.swift#L120"},"role":"symbol","roleHeading":"Type Property","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"}],"symbolKind":"property","externalID":"s:21TelemetryDeckEncoding0aB12BatchEncoderV10batchLimit12PropertyJSON0dG0VvpZ","modules":[{"name":"TelemetryDeckEncoding"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/batchlimit"]}],"hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"]]},"abstract":[{"type":"text","text":"TelemetryDeck’s limits on one request: 100 events and 1,000,000 bytes of body, and 333,333"},{"type":"text","text":" "},{"type":"text","text":"bytes of one event."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The 100 events are what TelemetryDeck’s SwiftSDK sends in a request. The 333,333 bytes of an"},{"type":"text","text":" "},{"type":"text","text":"event are a third of Ingest API v3’s limit: TelemetryDeck refuses a whole request when one"},{"type":"text","text":" "},{"type":"text","text":"event’s JSON is over 1,000,000 bytes as its server writes it, which may be larger than the"},{"type":"text","text":" "},{"type":"text","text":"encoder’s, and a third leaves room for the escapes a re-encoder commonly adds, such as "},{"type":"codeVoice","code":"\\u"},{"type":"text","text":" "},{"type":"text","text":"and four hex digits for a character outside ASCII, and a space after each "},{"type":"codeVoice","code":":"},{"type":"text","text":" and "},{"type":"codeVoice","code":","},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"larger event is left out as "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck documents no limit on a request; its 1,000,000 bytes are the encoder’s own"},{"type":"text","text":" "},{"type":"text","text":"bound, the most one event may be, which keeps a request to a size a retry can send again."}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of TelemetryDeck’s Ingest API v3, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to an organization’s "},{"type":"codeVoice","code":"POST \/v3\/<namespace>\/"},{"type":"text","text":"."}],"role":"symbol","title":"TelemetryDeckBatchEncoder","type":"topic","navigatorTitle":[{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"kind":"symbol","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","title":"BatchEncoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"type":"topic","role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckEncodingError/oversized(byteCount:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oversized","kind":"identifier"},{"text":"(","kind":"text"},{"text":"byteCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)","kind":"symbol","abstract":[{"type":"text","text":"The event’s JSON is "},{"type":"codeVoice","code":"byteCount"},{"type":"text","text":" bytes, more than the encoder’s limit lets one record hold:"},{"type":"text","text":" "},{"type":"text","text":"333,333 bytes by default ("},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":"), a third of"},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck’s 1,000,000. Only "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"leaves a record out for it."}],"role":"symbol","title":"TelemetryDeckEncodingError.oversized(byteCount:)","type":"topic","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckencodingerror\/oversized(bytecount:)"},"doc://PropertyJSON/documentation/PropertyJSON/BatchLimit":{"kind":"symbol","abstract":[{"type":"text","text":"The most an ingestion endpoint takes in one request: how many records, how many bytes of body,"},{"type":"text","text":" "},{"type":"text","text":"and how many bytes of one record’s JSON."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchLimit","kind":"identifier"}],"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","title":"BatchLimit","navigatorTitle":[{"text":"BatchLimit","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/propertyjson\/batchlimit"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding":{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","abstract":[{"type":"text","text":"Send records to TelemetryDeck as signals, through its Ingest API v3."}],"type":"topic","role":"collection","url":"\/documentation\/telemetrydeckencoding","title":"TelemetryDeckEncoding","kind":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/reque