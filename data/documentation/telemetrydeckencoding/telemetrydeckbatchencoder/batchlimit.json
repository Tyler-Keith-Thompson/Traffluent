{"abstract":[{"type":"text","text":"TelemetryDeck’s limits on one request: 100 events and 1,000,000 bytes of body, and 333,333"},{"type":"text","text":" "},{"type":"text","text":"bytes of one event."}],"sections":[],"metadata":{"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"modules":[{"name":"TelemetryDeckEncoding"}],"title":"batchLimit","externalID":"s:21TelemetryDeckEncoding0aB12BatchEncoderV10batchLimit12PropertyJSON0dG0VvpZ","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder.swift#L134","fileName":"TelemetryDeckBatchEncoder.swift"},"symbolKind":"property","roleHeading":"Type Property"},"variants":[{"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/batchlimit"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The 100 events are what TelemetryDeck’s SwiftSDK sends in a request. The 333,333 bytes of an"},{"type":"text","text":" "},{"type":"text","text":"event are a third of Ingest API v3’s limit: TelemetryDeck refuses a whole request when one"},{"type":"text","text":" "},{"type":"text","text":"event’s JSON is over 1,000,000 bytes as its server writes it, which may be larger than the"},{"type":"text","text":" "},{"type":"text","text":"encoder’s, and a third leaves room for the escapes a re-encoder commonly adds, such as "},{"type":"codeVoice","code":"\\u"},{"type":"text","text":" "},{"type":"text","text":"and four hex digits for a character outside ASCII, and a space after each "},{"type":"codeVoice","code":":"},{"type":"text","text":" and "},{"type":"codeVoice","code":","},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"larger event is left out as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck documents no limit on a request; its 1,000,000 bytes are the encoder’s own"},{"type":"text","text":" "},{"type":"text","text":"bound, the most one event may be, which keeps a request to a size a retry can send again."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://PropertyJSON/documentation/PropertyJSON/BatchLimit":{"url":"\/documentation\/propertyjson\/batchlimit","title":"BatchLimit","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchLimit","kind":"identifier"}],"navigatorTitle":[{"text":"BatchLimit","kind":"identifier"}],"abstract":[{"text":"The most an ingestion endpoint takes in one request: how many records, how many bytes of body,","type":"text"},{"text":" ","type":"text"},{"text":"and how many bytes of one record’s JSON.","type":"text"}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/requests(for:)":{"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/requests(for:)","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","title":"requests(for:)","abstract":[{"code":"batch","type":"codeVoice"},{"text":" as the requests TelemetryDeck takes, each within the encoder’s limit, with the","type":"text"},{"text":" ","type":"text"},{"text":"records left out of them.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"text":"<","kind":"text"},{"text":"TelemetryDeckEncodingError","kind":"typeIdentifier","preciseIdentifier":"s:21TelemetryDeckEncoding0abC5ErrorO"},{"text":">","kind":"text"}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckEncodingError/oversized(byteCount:)":{"title":"TelemetryDeckEncodingError.oversized(byteCount:)","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckencodingerror\/oversized(bytecount:)","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oversized","kind":"identifier"},{"text":"(","kind":"text"},{"text":"byteCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"The event’s JSON is "},{"type":"codeVoice","code":"byteCount"},{"type":"text","text":" bytes, more than the encoder’s limit lets one record hold:"},{"type":"text","text":" "},{"type":"text","text":"333,333 bytes by default ("},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":"), a third of"},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck’s 1,000,000. Only "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"leaves a record out for it."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"url":"\/documentation\/httpdestinations\/batchencoder","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","title":"BatchEncoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"role":"symbol","title":"TelemetryDeckBatchEncoder","kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of TelemetryDeck’s Ingest API v3, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to an organization’s "},{"type":"codeVoice","code":"POST \/v3\/<namespace>\/"},{"type":"text","text":"."}],"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder","type":"topic","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","navigatorTitle":[{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/batchLimit":{"title":"batchLimit","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/batchlimit","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"abstract":[{"text":"TelemetryDeck’s limits on one request: 100 events and 1,000,000 bytes of body, and 333,333","type":"text"},{"text":" ","type":"text"},{"text":"bytes of one event.","type":"text"}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding":{"title":"TelemetryDeckEncoding","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","role":"collection","url":"\/documentation\/telemetrydeckencoding","type":"topic","abstract":[{"type":"text","text":"Send records to TelemetryDeck as signals, through its I