{"identifier":{"url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"}],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"text":"The 100 events are what TelemetryDeck’s SwiftSDK sends in a request. The 333,333 bytes of an","type":"text"},{"text":" ","type":"text"},{"text":"event are a third of Ingest API v3’s limit: TelemetryDeck refuses a whole request when one","type":"text"},{"text":" ","type":"text"},{"text":"event’s JSON is over 1,000,000 bytes as its server writes it, which may be larger than the","type":"text"},{"text":" ","type":"text"},{"text":"encoder’s, and a third leaves room for the escapes a re-encoder commonly adds, such as ","type":"text"},{"code":"\\u","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and four hex digits for a character outside ASCII, and a space after each ","type":"text"},{"code":":","type":"codeVoice"},{"text":" and ","type":"text"},{"code":",","type":"codeVoice"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"larger event is left out as ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck documents no limit on a request; its 1,000,000 bytes are the encoder’s own","type":"text"},{"text":" ","type":"text"},{"text":"bound, the most one event may be, which keeps a request to a size a retry can send again.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/batchlimit"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"]]},"abstract":[{"type":"text","text":"TelemetryDeck’s limits on one request: 100 events and 1,000,000 bytes of body, and 333,333"},{"type":"text","text":" "},{"type":"text","text":"bytes of one event."}],"kind":"symbol","metadata":{"title":"batchLimit","role":"symbol","remoteSource":{"fileName":"TelemetryDeckBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder.swift#L116"},"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier","text":"BatchLimit"}],"roleHeading":"Type Property","externalID":"s:21TelemetryDeckEncoding0aB12BatchEncoderV10batchLimit12PropertyJSON0dG0VvpZ","modules":[{"name":"TelemetryDeckEncoding"}],"symbolKind":"property"},"sections":[],"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of TelemetryDeck’s Ingest API v3, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"can send events to an organization’s "},{"code":"POST \/v3\/<namespace>\/","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder","title":"TelemetryDeckBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","type":"topic","kind":"symbol","navigatorTitle":[{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding":{"role":"collection","title":"TelemetryDeckEncoding","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","url":"\/documentation\/telemetrydeckencoding","abstract":[{"type":"text","text":"Send records to TelemetryDeck as signals, through its Ingest API v3."}],"type":"topic","kind":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckEncodingError/oversized(byteCount:)":{"type":"topic","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oversized","kind":"identifier"},{"text":"(","kind":"text"},{"text":"byteCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"abstract":[{"text":"The event’s JSON is ","type":"text"},{"code":"byteCount","type":"codeVoice"},{"text":" bytes, more than the encoder’s limit lets one record hold:","type":"text"},{"text":" ","type":"text"},{"text":"333,333 bytes by default (","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":"), a third of","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck’s 1,000,000. Only ","type":"text"},{"identifier":"doc:\/\/Te