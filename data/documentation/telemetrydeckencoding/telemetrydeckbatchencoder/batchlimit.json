{"metadata":{"externalID":"s:21TelemetryDeckEncoding0aB12BatchEncoderV10batchLimit12PropertyJSON0dG0VvpZ","symbolKind":"property","remoteSource":{"fileName":"TelemetryDeckBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder.swift#L116"},"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"role":"symbol","modules":[{"name":"TelemetryDeckEncoding"}],"roleHeading":"Type Property","title":"batchLimit"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"The 100 events are what TelemetryDeck’s SwiftSDK sends in a request. The 333,333 bytes of an","type":"text"},{"text":" ","type":"text"},{"text":"event are a third of Ingest API v3’s limit: TelemetryDeck refuses a whole request when one","type":"text"},{"text":" ","type":"text"},{"text":"event’s JSON is over 1,000,000 bytes as its server writes it, which may be larger than the","type":"text"},{"text":" ","type":"text"},{"text":"encoder’s, and a third leaves room for the escapes a re-encoder commonly adds, such as ","type":"text"},{"code":"\\u","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and four hex digits for a character outside ASCII, and a space after each ","type":"text"},{"code":":","type":"codeVoice"},{"text":" and ","type":"text"},{"code":",","type":"codeVoice"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"larger event is left out as ","type":"text"},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck documents no limit on a request; its 1,000,000 bytes are the encoder’s own","type":"text"},{"text":" ","type":"text"},{"text":"bound, the most one event may be, which keeps a request to a size a retry can send again.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit"},"abstract":[{"type":"text","text":"TelemetryDeck’s limits on one request: 100 events and 1,000,000 bytes of body, and 333,333"},{"type":"text","text":" "},{"type":"text","text":"bytes of one event."}],"hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/batchlimit"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"references":{"doc://PropertyJSON/documentation/PropertyJSON/BatchLimit":{"url":"\/documentation\/propertyjson\/batchlimit","type":"topic","abstract":[{"type":"text","text":"The most an ingestion endpoint takes in one request: how many records, how many bytes of body,"},{"type":"text","text":" "},{"type":"text","text":"and how many bytes of one record’s JSON."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":