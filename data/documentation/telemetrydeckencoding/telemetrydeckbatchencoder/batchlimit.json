{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit"},"abstract":[{"text":"TelemetryDeck’s limits on one request: 100 events and 1,000,000 bytes of body, and 333,333","type":"text"},{"text":" ","type":"text"},{"text":"bytes of one event.","type":"text"}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/batchlimit"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"]]},"metadata":{"modules":[{"name":"TelemetryDeckEncoding"}],"remoteSource":{"fileName":"TelemetryDeckBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder.swift#L120"},"symbolKind":"property","roleHeading":"Type Property","role":"symbol","externalID":"s:21TelemetryDeckEncoding0aB12BatchEncoderV10batchLimit12PropertyJSON0dG0VvpZ","title":"batchLimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}]}]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The 100 events are what TelemetryDeck’s SwiftSDK sends in a request. The 333,333 bytes of an"},{"type":"text","text":" "},{"type":"text","text":"event are a third of Ingest API v3’s limit: TelemetryDeck refuses a whole request when one"},{"type":"text","text":" "},{"type":"text","text":"event’s JSON is over 1,000,000 bytes as its server writes it, which may be larger than the"},{"type":"text","text":" "},{"type":"text","text":"encoder’s, and a third leaves room for the escapes a re-encoder commonly adds, such as "},{"type":"codeVoice","code":"\\u"},{"type":"text","text":" "},{"type":"text","text":"and four hex digits for a character outside ASCII, and a space after each "},{"type":"codeVoice","code":":"},{"type":"text","text":" and "},{"type":"codeVoice","code":","},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"larger event is left out as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck documents no limit on a request; its 1,000,000 bytes are the encoder’s own"},{"type":"text","text":" "},{"type":"text","text":"bound, the most one event may be, which keeps a request to a size a retry can send again."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckEncodingError/oversized(byteCount:)":{"abstract":[{"type":"text","text":"The event’s JSON is "},{"type":"codeVoice","code":"byteCount"},{"type":"text","text":" bytes, more than the encoder’s limit lets one record hold:"},{"type":"text","text":" "},{"type":"text","text":"333,333 bytes by default ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit"},{"type":"text","text":"), a third of"},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck’s 1,000,000. Only "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"},{"type":"text","text":" "},{"type":"text","text":"leaves a record out for it."}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oversized","kind":"identifier"},{"text":"(","kind":"text"},{"text":"byteCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"title":"TelemetryDeckEncodingError.oversized(byteCount:)","type":"topic","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckencodingerror\/oversized(bytecount:)","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"type":"topic","kind":"symbol","role":"symbol","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":" sends.","type":"text"}],"url":"\/documentation\/httpdestinations\/batchencoder","title":"BatchEncoder"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"role":"symbol","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","type":"topic","abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" of TelemetryDeck’s Ingest API v3, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"can send events to an organization’s ","type":"text"},{"code":"POST \/v3\/<namespace>\/","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"kind":"symbol","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder","title":"TelemetryDeckBatchEncoder"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding":{"role":"collection","title":"TelemetryDeckEncoding","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","abstract":[{"text":"Send records to TelemetryDeck as signals, through its Ingest API v3.","type":"text"}],"url":"\/documentation\/telemetrydeckencoding","kind":"symbol","type":"topic"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/requests(for:)":{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"text":"<","kind":"text"},{"text":"TelemetryDeckEncodingError","kind":"typeIdentif