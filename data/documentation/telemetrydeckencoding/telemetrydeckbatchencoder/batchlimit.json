xt"},{"text":"333,333 bytes by default (","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":"), a third of","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck’s 1,000,000. Only ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"leaves a record out for it.","type":"text"}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)","type":"topic","kind":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/batchLimit":{"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/batchlimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","kind":"symbol","type":"topic","title":"batchLimit","abstract":[{"text":"TelemetryDeck’s limits on one request: 100 events and 1,000,000 bytes of body, and 333,333","type":"text"},{"text":" ","type":"text"},{"text":"bytes of one event.","type":"text"}],"role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"title":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text