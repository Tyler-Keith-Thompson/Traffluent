:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","type":"reference"},{"text":"), a third of","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck’s 1,000,000. Only ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","type":"reference"},{"text":" ","type":"text"},{"text":"leaves a record out for it.","type":"text"}],"title":"TelemetryDeckEncodingError.oversized(byteCount:)","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)","role":"symbol","type":"topic"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding":{"type":"topic","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","url":"\/documentation\/telemetrydeckencoding","kind":"symbol","role":"collection","title":"TelemetryDeckEncoding","abstract":[{"text":"Send records to TelemetryDeck as signals, through its Ingest API v3.","type":"text"}]},"doc://PropertyJSON/documentation/PropertyJSON/BatchLimit":{"navigatorTitle":[{"text":"BatchLimit","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","title":"BatchLimit","role":"symbol","abstract":[{"type":"text","text":"The most an ingestion endpoint takes in one request: how many records, how many bytes of body,"},{"type":"text","text":" "},{"type":"text","text":"and how many bytes of one record’s JSON."}],"url":"\/documentation\/propertyjson\/batchlimit","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchLimit","kind":"identifier"}],"kind":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEnc