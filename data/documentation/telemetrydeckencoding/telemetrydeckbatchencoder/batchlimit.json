{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/batchlimit"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:21TelemetryDeckEncoding0aB12BatchEncoderV10batchLimit12PropertyJSON0dG0VvpZ","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier","text":"BatchLimit"}],"remoteSource":{"fileName":"TelemetryDeckBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder.swift#L116"},"symbolKind":"property","roleHeading":"Type Property","title":"batchLimit","role":"symbol","modules":[{"name":"TelemetryDeckEncoding"}]},"hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","text":"BatchLimit"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The 100 events are what TelemetryDeck’s SwiftSDK sends in a request. The 333,333 bytes of an","type":"text"},{"text":" ","type":"text"},{"text":"event are a third of Ingest API v3’s limit: TelemetryDeck refuses a whole request when one","type":"text"},{"text":" ","type":"text"},{"text":"event’s JSON is over 1,000,000 bytes as its server writes it, which may be larger than the","type":"text"},{"text":" ","type":"text"},{"text":"encoder’s, and a third leaves room for the escapes a re-encoder commonly adds, such as ","type":"text"},{"code":"\\u","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and four hex digits for a character outside ASCII, and a space after each ","type":"text"},{"code":":","type":"codeVoice"},{"text":" and ","type":"text"},{"code":",","type":"codeVoice"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"larger event is left out as ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck documents no limit on a request; its 1,000,000 bytes are the encoder’s own","type":"text"},{"text":" ","type":"text"},{"text":"bound, the most one event may be, which keeps a request to a size a retry can send again.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"TelemetryDeck’s limits on one request: 100 events and 1,000,000 bytes of body, and 333,333"},{"type":"text","text":" "},{"type":"text","text":"bytes of one event."}],"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/requests(for:)":{"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","pre