{"hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"]]},"abstract":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"text":" of TelemetryDeck’s Ingest API v3, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" ","type":"text"},{"text":"can send events to an organization’s ","type":"text"},{"type":"codeVoice","code":"POST \/v3\/<namespace>\/"},{"text":".","type":"text"}],"sections":[],"metadata":{"modules":[{"name":"TelemetryDeckEncoding"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"externalID":"s:21TelemetryDeckEncoding0aB12BatchEncoderV","symbolKind":"struct","navigatorTitle":[{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"title":"TelemetryDeckBatchEncoder","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder.swift#L85","fileName":"TelemetryDeckBatchEncoder.swift"},"role":"symbol","roleHeading":"Structure"},"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/Failure"],"title":"Type Aliases","anchor":"Type-Aliases","generated":true},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/transientStatuses"],"title":"Type Properties","anchor":"Type-Properties","generated":true}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/TelemetryDeckEncoding\/s8SendableP","doc:\/\/TelemetryDeckEncoding\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships"}],"identifier":{"url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}]},{"syntax":"swift","type":"codeListing","code":["let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON array of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":", one event per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. Each event is a flat object of these members:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"appID"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The app ID the encoder is made with, without leading or trailing whitespace"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"clientUser"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The SHA256 of the record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" as a lowercase UUID string, as 64 lowercase hexadecimal digits; of the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"isTestMode","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"\"true\""},{"type":"text","text":" or "},{"type":"codeVoice","code":"\"false\""},{"type":"text","text":", as the encoder is made with"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"receivedAt","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionID"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, its ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", as a lowercase UUID string; left out when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"type","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.SDK.name"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Traffluent"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Each of the event’s stored properties","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Its value, read through the event’s schema in the plan; a nested value spread into one member per scalar it holds, named after its path, joined by "},{"type":"codeVoice","code":"."},{"type":"text","text":" ("},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":")"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent, hashed as TelemetryDeck’s SDKs hash a user’s"},{"type":"text","text":" "},{"type":"text","text":"identifier with their default, empty salt; TelemetryDeck salts and hashes it again before"},{"type":"text","text":" "},{"type":"text","text":"storing it. No salt of the app’s own is taken: "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":" sends the same session in the"},{"type":"text","text":" "},{"type":"text","text":"clear, so a salt would hide nothing. TelemetryDeck counts a user per "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":", so its users"},{"type":"text","text":" "},{"type":"text","text":"are sessions. A record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or one a store recovered after a relaunch, which keeps no context) is its own user of one event, with no "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":", linked to nothing: TelemetryDeck"},{"type":"text","text":" "},{"type":"text","text":"refuses an event without a "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":". The record’s vendor identifier and trace context, and"},{"type":"text","text":" "},{"type":"text","text":"any other context value, aren’t sent. Nor is a "},{"type":"codeVoice","code":"floatValue"},{"type":"text","text":": a number among the properties"},{"type":"text","text":" "},{"type":"text","text":"keeps its JSON type in Ingest API v3."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. A "},{"code":"null","type":"codeVoice"},{"type":"text","text":" is left out too, as TelemetryDeck stores no"},{"type":"text","text":" "},{"type":"text","text":"value for it. TelemetryDeck stores a nested object without indexing it and leaves arrays"},{"type":"text","text":" "},{"type":"text","text":"undefined, so the encoder spreads both into members of their own."}]},{"type":"paragraph","inlineContent":[{"text":"Each event also holds these of TelemetryDeck’s built-in parameters, for each of the keys the","type":"text"},{"text":" ","type":"text"},{"text":"record’s context has a value for:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parameter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.AppInfo.version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TelemetryDeck.AppInfo.buildNumber","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The version and the build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.versionAndBuildNumber"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"},{"type":"text","text":", with both a version and a build"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"2.4.1 (build 418)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.Device.modelName","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.operatingSystem"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.Device.platform"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The operating system’s name, ","type":"text"},{"type":"codeVoice","code":"iOS"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.Device.systemVersion","type":"codeVoice"},{"type":"text","text":", "},{"code":"TelemetryDeck.Device.systemMajorVersion","type":"codeVoice"},{"type":"text","text":", "},{"code":"TelemetryDeck.Device.systemMajorMinorVersion","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"},{"type":"text","text":", with a version"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name and the version, its first component and its first two: "},{"code":"iOS 26.1.0","type":"codeVoice"},{"type":"text","text":", "},{"code":"iOS 26","type":"codeVoice"},{"type":"text","text":", "},{"code":"iOS 26.1","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.RunContext.locale","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"LocaleKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The locale’s identifier, "},{"type":"codeVoice","code":"en_US"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.RunContext.language","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"LocaleKey","type":"codeVoice"},{"text":", with a language","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The language’s code, "},{"type":"codeVoice","code":"en"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.UserPreference.region","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"},{"text":", with a region","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The region’s code, "},{"code":"US","type":"codeVoice"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event name or parameter","type":"text"},{"text":" ","type":"text"},{"text":"name TelemetryDeck refuses or keeps for itself, one whose values flatten to one name, one whose","type":"text"},{"text":" ","type":"text"},{"text":"event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds a value JSON can’t, one whose timestamp is outside the","type":"text"},{"text":" ","type":"text"},{"text":"years 1 to 9999, and one whose JSON is over 333,333 bytes (","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","type":"reference","isActive":true},{"text":").","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" returns them as ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. TelemetryDeck answers a request it takes with 200, and checks every event of a","type":"text"},{"text":" ","type":"text"},{"text":"request before storing any: it answers 422 when one breaks a rule, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"drops and reports with every record of the request. It answers 503 when its queue is full,","type":"text"},{"text":" ","type":"text"},{"text":"which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries. It doesn’t remove duplicates, so a record sent again is","type":"text"},{"text":" ","type":"text"},{"text":"counted again. The bytes are the same for the same records on every run and platform: no","type":"text"},{"text":" ","type":"text"},{"text":"whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://TelemetryDeckEncoding/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/TelemetryDeckEncoding\/s8SendableP","type":"unresolvable"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/Failure":{"navigatorTitle":[{"kind":"identifier","text":"Failure"}],"type":"topic","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/Failure","title":"TelemetryDeckBatchEncoder.Failure","role":"symbol","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/failure","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"kind":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"title":"TelemetryDeckBatchEncoder","abstract":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of TelemetryDeck’s Ingest API v3, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"ca