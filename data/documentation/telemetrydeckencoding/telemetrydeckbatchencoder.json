{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}]},{"code":["let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON array of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", one event per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. Each event is a flat object of these members:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"appID","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The app ID the encoder is made with, without leading or trailing whitespace","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"clientUser","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SHA256 of the record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" as a lowercase UUID string, as 64 lowercase hexadecimal digits; of the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isTestMode"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"true\""},{"type":"text","text":" or "},{"type":"codeVoice","code":"\"false\""},{"type":"text","text":", as the encoder is made with"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"receivedAt","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601, in UTC with milliseconds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sessionID","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; left out when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.SDK.name"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Traffluent"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Each of the event’s stored properties","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its value, read through the event’s schema in the plan; a nested value spread into one member per scalar it holds, named after its path, joined by "},{"type":"codeVoice","code":"."},{"type":"text","text":" ("},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":")"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent, hashed as TelemetryDeck’s SDKs hash a user’s"},{"type":"text","text":" "},{"type":"text","text":"identifier with their default, empty salt; TelemetryDeck salts and hashes it again before"},{"type":"text","text":" "},{"type":"text","text":"storing it. No salt of the app’s own is taken: "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":" sends the same session in the"},{"type":"text","text":" "},{"type":"text","text":"clear, so a salt would hide nothing. TelemetryDeck counts a user per "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":", so its users"},{"type":"text","text":" "},{"type":"text","text":"are sessions. A record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or one a store recovered after a relaunch, which keeps no context) is its own user of one event, with no "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":", linked to nothing: TelemetryDeck"},{"type":"text","text":" "},{"type":"text","text":"refuses an event without a "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":". The record’s vendor identifier and trace context, and"},{"type":"text","text":" "},{"type":"text","text":"any other context value, aren’t sent. Nor is a "},{"type":"codeVoice","code":"floatValue"},{"type":"text","text":": a number among the properties"},{"type":"text","text":" "},{"type":"text","text":"keeps its JSON type in Ingest API v3."}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, and so is an element of an array. A ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" is left out too, as TelemetryDeck stores no","type":"text"},{"text":" ","type":"text"},{"text":"value for it. TelemetryDeck stores a nested object without indexing it and leaves arrays","type":"text"},{"text":" ","type":"text"},{"text":"undefined, so the encoder spreads both into members of their own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event also holds these of TelemetryDeck’s built-in parameters, for each of the keys the"},{"type":"text","text":" "},{"type":"text","text":"record’s context has a value for:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Parameter","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.version"},{"text":", ","type":"text"},{"type":"codeVoice","code":"TelemetryDeck.AppInfo.buildNumber"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The version and the build, each left out when "},{"code":"nil","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.versionAndBuildNumber"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"},{"text":", with both a version and a build","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"2.4.1 (build 418)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.modelName"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The model","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.operatingSystem"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.Device.platform"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The operating system’s name, "},{"type":"codeVoice","code":"iOS"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.Device.systemVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TelemetryDeck.Device.systemMajorVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TelemetryDeck.Device.systemMajorMinorVersion","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"},{"type":"text","text":", with a version"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The name and the version, its first component and its first two: "},{"type":"codeVoice","code":"iOS 26.1.0"},{"type":"text","text":", "},{"type":"codeVoice","code":"iOS 26"},{"type":"text","text":", "},{"type":"codeVoice","code":"iOS 26.1"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.locale"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The locale’s identifier, ","type":"text"},{"type":"codeVoice","code":"en_US"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.language"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":", with a language"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The language’s code, ","type":"text"},{"code":"en","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.UserPreference.region"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"},{"text":", with a region","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The region’s code, "},{"code":"US","type":"codeVoice"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name or parameter"},{"type":"text","text":" "},{"type":"text","text":"name TelemetryDeck refuses or keeps for itself, one whose values flatten to one name, one whose"},{"type":"text","text":" "},{"type":"text","text":"event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is outside the"},{"type":"text","text":" "},{"type":"text","text":"years 1 to 9999, and one whose JSON is over 333,333 bytes ("},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. TelemetryDeck answers a request it takes with 200, and checks every event of a"},{"type":"text","text":" "},{"type":"text","text":"request before storing any: it answers 422 when one breaks a rule, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"drops and reports with every record of the request. It answers 503 when its queue is full,"},{"type":"text","text":" "},{"type":"text","text":"which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" retries. It doesn’t remove duplicates, so a record sent again is"},{"type":"text","text":" "},{"type":"text","text":"counted again. The bytes are the same for the same records on every run and platform: no"},{"type":"text","text":" "},{"type":"text","text":"whitespace, object members in the order of their names’ UTF-8 bytes."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"]]},"topicSections":[{"gener