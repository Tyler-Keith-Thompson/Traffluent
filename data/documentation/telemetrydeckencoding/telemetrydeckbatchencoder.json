doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. TelemetryDeck answers a request it takes with 200, and checks every event of a","type":"text"},{"text":" ","type":"text"},{"text":"request before storing any: it answers 422 when one breaks a rule, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"drops and reports with every record of the request. It answers 503 when its queue is full,","type":"text"},{"text":" ","type":"text"},{"text":"which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries. It doesn’t remove duplicates, so a record sent again is","type":"text"},{"text":" ","type":"text"},{"text":"counted again. The bytes are the same for the same records on every run and platform: no","type":"text"},{"text":" ","type":"text"},{"text":"whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}]}]}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"externalID":"s:21TelemetryDeckEncoding0aB12BatchEncoderV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder.swift#L85","fileName":"TelemetryDeckBatchEncoder.swift"},"symbolKind":"struct","role":"symbol","title":"TelemetryDeckBatchEncoder","roleHeading":"Structure","modules":[{"name":"TelemetryDeckEncoding"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"