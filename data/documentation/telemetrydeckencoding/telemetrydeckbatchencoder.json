{"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/TelemetryDeckEncoding\/s8SendableP","doc:\/\/TelemetryDeckEncoding\/s16SendableMetatypeP"],"title":"Conforms To"}],"metadata":{"externalID":"s:21TelemetryDeckEncoding0aB12BatchEncoderV","role":"symbol","modules":[{"name":"TelemetryDeckEncoding"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"roleHeading":"Structure","title":"TelemetryDeckBatchEncoder","symbolKind":"struct","navigatorTitle":[{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"remoteSource":{"fileName":"TelemetryDeckBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder.swift#L86"}},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and its limits:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The body is a JSON array of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", one event per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. Each event is a flat object of these members:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"appID"}]}],[{"type":"paragraph","inlineContent":[{"text":"The app ID the encoder is made with, without leading or trailing whitespace","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"clientUser"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SHA256 of the record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" as a lowercase UUID string, as 64 lowercase hexadecimal digits; of the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isTestMode"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"true\""},{"type":"text","text":" or "},{"type":"codeVoice","code":"\"false\""},{"type":"text","text":", as the encoder is made with"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"receivedAt"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601, in UTC with milliseconds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sessionID"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; left out when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"type"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"type":"codeVoice","code":"Event\/name"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.SDK.name","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Traffluent"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Each of the event’s stored properties","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its value, read through the event’s schema in the plan; a nested value spread into one member per scalar it holds, named after its path, joined by "},{"type":"codeVoice","code":"."},{"type":"text","text":" ("},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":")"}]}]]],"type":"table"},{"inlineContent":[{"text":"The session is the only identifier sent, hashed as TelemetryDeck’s SDKs hash a user’s","type":"text"},{"text":" ","type":"text"},{"text":"identifier with their default, empty salt; TelemetryDeck salts and hashes it again before","type":"text"},{"text":" ","type":"text"},{"text":"storing it. No salt of the app’s own is taken: ","type":"text"},{"type":"codeVoice","code":"sessionID"},{"text":" sends the same session in the","type":"text"},{"text":" ","type":"text"},{"text":"clear, so a salt would hide nothing. TelemetryDeck counts a user per ","type":"text"},{"type":"codeVoice","code":"clientUser"},{"text":", so its users","type":"text"},{"text":" ","type":"text"},{"text":"are sessions. A record with no session (one tracked by a tracker without ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"is its own user of one event, with no ","type":"text"},{"type":"codeVoice","code":"sessionID"},{"text":", linked to nothing: TelemetryDeck refuses an","type":"text"},{"text":" ","type":"text"},{"text":"event without a ","type":"text"},{"type":"codeVoice","code":"clientUser"},{"text":". A record a store recovers after a relaunch keeps its session, so","type":"text"},{"text":" ","type":"text"},{"text":"it goes out with the ","type":"text"},{"type":"codeVoice","code":"clientUser"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"sessionID"},{"text":" of its first send. The record’s vendor identifier and trace context, and","type":"text"},{"text":" ","type":"text"},{"text":"any other context value, aren’t sent. Nor is a ","type":"text"},{"type":"codeVoice","code":"floatValue"},{"text":": a number among the properties","type":"text"},{"text":" ","type":"text"},{"text":"keeps its JSON type in Ingest API v3.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. A "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is left out too, as TelemetryDeck stores no"},{"type":"text","text":" "},{"type":"text","text":"value for it. TelemetryDeck stores a nested object without indexing it and leaves arrays"},{"type":"text","text":" "},{"type":"text","text":"undefined, so the encoder spreads both into members of their own."}],"type":"paragraph"},{"inlineContent":[{"text":"Each event also holds these of TelemetryDeck’s built-in parameters, for each of the keys the","type":"text"},{"text":" ","type":"text"},{"text":"record’s context has a value for:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Parameter","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.AppInfo.version","type":"codeVoice"},{"type":"text","text":", "},{"code":"TelemetryDeck.AppInfo.buildNumber","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The version and the build, each left out when "},{"code":"nil","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.versionAndBuildNumber"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"},{"text":", with both a version and a build","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"2.4.1 (build 418)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.modelName"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The model"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.Device.operatingSystem","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TelemetryDeck.Device.platform","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The operating system’s name, ","type":"text"},{"code":"iOS","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.Device.systemVersion","type":"codeVoice"},{"type":"text","text":", "},{"code":"TelemetryDeck.Device.systemMajorVersion","type":"codeVoice"},{"type":"text","text":", "},{"code":"TelemetryDeck.Device.systemMajorMinorVersion","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"},{"type":"text","text":", with a version"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The name and the version, its first component and its first two: ","type":"text"},{"type":"codeVoice","code":"iOS 26.1.0"},{"text":", ","type":"text"},{"type":"codeVoice","code":"iOS 26"},{"text":", ","type":"text"},{"type":"codeVoice","code":"iOS 26.1"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.RunContext.locale","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The locale’s identifier, "},{"code":"en_US","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.language"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":", with a language"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The language’s code, ","type":"text"},{"type":"codeVoice","code":"en"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.UserPreference.region"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"},{"text":", with a region","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The region’s code, ","type":"text"},{"code":"US","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name or parameter"},{"type":"text","text":" "},{"type":"text","text":"name TelemetryDeck refuses or keeps for itself, one whose values flatten to one name, one whose"},{"type":"text","text":" "},{"type":"text","text":"event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is outside the"},{"type":"text","text":" "},{"type":"text","text":"years 1 to 9999, and one whose JSON is over 333,333 bytes ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. TelemetryDeck answers a request it takes with 200, and checks every event of a"},{"type":"text","text":" "},{"type":"text","text":"request before storing any: it answers 422 when one breaks a rule, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"drops and reports with every record of the request. It answers 503 when its queue is full,"},{"type":"text","text":" "},{"type":"text","text":"which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries. It doesn’t remove duplicates, so a record sent again is"},{"type":"text","text":" "},{"type":"text","text":"counted again. The bytes are the same for the same records on every run and platform: no"},{"type":"text","text":" "},{"type":"text","text":"whitespace, object members in the order of their names’ UTF-8 bytes."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of TelemetryDeck’s Ingest API v3, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"can send events to an organization’s "},{"code":"POST \/v3\/<namespace>\/","type":"codeVoice"},{"type":"text","text":"."}],"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"],"title":"Instance Methods"},{"generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/Failure"],"title":"Type Aliases"},{"generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/transientStatuses"],"title":"Type Properties"},{"generated":true,"anchor":"Type-Methods","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/outcome(of:for:)"],"title":"Type Methods"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"},"sections":[],"variants":[{"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://TelemetryDeckEncoding/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/TelemetryDeckEncoding\/s8SendableP"},"doc://Events/documentation/Events/Sensitive":{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"url":"\/documentation\/events\/sensitive","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"title":"Sensitive","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding":{"title":"TelemetryDeckEncoding","abstract":[{"type":"text","text":"Send records to TelemetryDeck as signals, through its Ingest API v3."}],"url":"\/documentation\/telemetrydeckencoding","kind":"symbol","role":"collection","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","type":"topic"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/Failure":{"role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/failure","title":"TelemetryDeckBatchEncoder.Failure","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/Failure","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"type":"topic","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"type":"text","text":" sends."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"kind":"symbol","title":"BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckEncodingError":{"role":"symbol","title":"TelemetryDeckEncodingError","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","type":"topic","kind":"symbol","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckencodingerror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckEncodingError","kind":"identifier"}],"navigatorTitle":[{"text":"TelemetryDeckEncodingError","kind":"identifier"}],"abstract":[{"text":"Why ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}]},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"title":"TelemetryDeckBatchEncoder","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of TelemetryDeck’s Ingest API v3, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to an organization’s "},{"type":"codeVoice","code":"POST \/v3\/<namespace>\/"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","navigatorTitle":[{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"type":"topic"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/requests(for:)":{"type":"topic","abstract":[{"code":"batch","type":"codeVoice"},{"text":" as the requests TelemetryDeck takes, each within the encoder’s limit, with the","type":"text"},{"text":" ","type":"text"},{"text":"records left out of them.","type":"text"}],"role":"symbol","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","text":"BatchRequests","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"TelemetryDeckEncodingError","preciseIdentifier":"s:21TelemetryDeckEncoding0abC5ErrorO"},{"kind":"text","text":">"}],"kind":"symbol","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/requests(for:)","title":"requests(for:)"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/batchLimit":{"title":"batchLimit","abstract":[{"text":"TelemetryDeck’s limits on one request: 100 events and 1,000,000 bytes of body, and 333,333","type":"text"},{"text":" ","type":"text"},{"text":"bytes of one event.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/batchlimit","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit"},"doc://TelemetryDeckEncoding/s16SendableMetatypeP":{"identifier":"doc:\/\/TelemetryDeckEncoding\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/outcome(of:for:)":{"t