{"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder"]}],"hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"]]},"metadata":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"symbolKind":"struct","navigatorTitle":[{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"externalID":"s:21TelemetryDeckEncoding0aB12BatchEncoderV","modules":[{"name":"TelemetryDeckEncoding"}],"roleHeading":"Structure","remoteSource":{"fileName":"TelemetryDeckBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder.swift#L86"},"title":"TelemetryDeckBatchEncoder"},"sections":[],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/Failure"],"title":"Type Aliases","anchor":"Type-Aliases","generated":true},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/transientStatuses"],"title":"Type Properties","anchor":"Type-Properties","generated":true},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/outcome(of:for:)"],"title":"Type Methods","anchor":"Type-Methods","generated":true}],"abstract":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of TelemetryDeck’s Ingest API v3, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" ","type":"text"},{"text":"can send events to an organization’s ","type":"text"},{"type":"codeVoice","code":"POST \/v3\/<namespace>\/"},{"text":".","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/TelemetryDeckEncoding\/s8SendableP","doc:\/\/TelemetryDeckEncoding\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and its limits:","type":"text"}],"type":"paragraph"},{"code":["let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The body is a JSON array of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":", one event per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. Each event is a flat object of these members:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"appID","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The app ID the encoder is made with, without leading or trailing whitespace","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"clientUser"}]}],[{"type":"paragraph","inlineContent":[{"text":"The SHA256 of the record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":" as a lowercase UUID string, as 64 lowercase hexadecimal digits; of the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"isTestMode","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"true\"","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"\"false\"","type":"codeVoice"},{"text":", as the encoder is made with","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"receivedAt"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sessionID"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; left out when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.SDK.name","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Traffluent"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Each of the event’s stored properties","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its value, read through the event’s schema in the plan; a nested value spread into one member per scalar it holds, named after its path, joined by "},{"code":".","type":"codeVoice"},{"type":"text","text":" ("},{"code":"cart.size","type":"codeVoice"},{"type":"text","text":", "},{"code":"tags.0","type":"codeVoice"},{"type":"text","text":")"}]}]]],"type":"table"},{"inlineContent":[{"text":"The session is the only identifier sent, hashed as TelemetryDeck’s SDKs hash a user’s","type":"text"},{"text":" ","type":"text"},{"text":"identifier with their default, empty salt; TelemetryDeck salts and hashes it again before","type":"text"},{"text":" ","type":"text"},{"text":"storing it. No salt of the app’s own is taken: ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":" sends the same session in the","type":"text"},{"text":" ","type":"text"},{"text":"clear, so a salt would hide nothing. TelemetryDeck counts a user per ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":", so its users","type":"text"},{"text":" ","type":"text"},{"text":"are sessions. A record with no session (one tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"is its own user of one event, with no ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", linked to nothing: TelemetryDeck refuses an","type":"text"},{"text":" ","type":"text"},{"text":"event without a ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":". A record a store recovers after a relaunch keeps its session, so","type":"text"},{"text":" ","type":"text"},{"text":"it goes out with the ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":" of its first send. The record’s vendor identifier and trace context, and","type":"text"},{"text":" ","type":"text"},{"text":"any other context value, aren’t sent. Nor is a ","type":"text"},{"code":"floatValue","type":"codeVoice"},{"text":": a number among the properties","type":"text"},{"text":" ","type":"text"},{"text":"keeps its JSON type in Ingest API v3.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. A "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is left out too, as TelemetryDeck stores no"},{"type":"text","text":" "},{"type":"text","text":"value for it. TelemetryDeck stores a nested object without indexing it and leaves arrays"},{"type":"text","text":" "},{"type":"text","text":"undefined, so the encoder spreads both into members of their own."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each event also holds these of TelemetryDeck’s built-in parameters, for each of the keys the"},{"type":"text","text":" "},{"type":"text","text":"record’s context has a value for:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Parameter"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.version"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.AppInfo.buildNumber"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The version and the build, each left out when "},{"type":"codeVoice","code":"nil"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.AppInfo.versionAndBuildNumber","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"},{"type":"text","text":", with both a version and a build"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"2.4.1 (build 418)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.modelName"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The model","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.operatingSystem"},{"text":", ","type":"text"},{"type":"codeVoice","code":"TelemetryDeck.Device.platform"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The operating system’s name, ","type":"text"},{"code":"iOS","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.systemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.Device.systemMajorVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.Device.systemMajorMinorVersion"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"},{"type":"text","text":", with a version"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The name and the version, its first component and its first two: "},{"type":"codeVoice","code":"iOS 26.1.0"},{"type":"text","text":", "},{"type":"codeVoice","code":"iOS 26"},{"type":"text","text":", "},{"type":"codeVoice","code":"iOS 26.1"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.locale"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The locale’s identifier, ","type":"text"},{"code":"en_US","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.RunContext.language","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"},{"text":", with a language","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The language’s code, "},{"type":"codeVoice","code":"en"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.UserPreference.region"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"},{"text":", with a region","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The region’s code, ","type":"text"},{"type":"codeVoice","code":"US"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name or parameter","type":"text"},{"text":" ","type":"text"},{"text":"name TelemetryDeck refuses or keeps for itself, one whose values flatten to one name, one whose","type":"text"},{"text":" ","type":"text"},{"text":"event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp is outside the","type":"text"},{"text":" ","type":"text"},{"text":"years 1 to 9999, and one whose JSON is over 333,333 bytes (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"},{"text":").","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. TelemetryDeck answers a request it takes with 200, and checks every event of a"},{"type":"text","text":" "},{"type":"text","text":"request before storing any: it answers 422 when one breaks a rule, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"drops and reports with every record of the request. It answers 503 when its queue is full,"},{"type":"text","text":" "},{"type":"text","text":"which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" retries. It doesn’t remove duplicates, so a record sent again is"},{"type":"text","text":" "},{"type":"text","text":"counted again. The bytes are the same for the same records on every run and platform: no"},{"type":"text","text":" "},{"type":"text","text":"whitespace, object members in the order of their names’ UTF-8 bytes."}],"type":"paragraph"}]}],"references":{"doc://TelemetryDeckEncoding/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/TelemetryDeckEncoding\/s16SendableMetatypeP"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/Failure":{"navigatorTitle":[{"text":"Failure","kind":"identifier"}],"title":"TelemetryDeckBatchEncoder.Failure","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/Failure","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/failure","role":"symbol","type":"topic","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"kind":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/batchLimit":{"title":"batchLimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"}],"ident