ncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/transientStatuses"],"generated":true,"anchor":"Type-Properties","title":"Type Properties"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"]]},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Make the destination with"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and its limits:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)"]},{"inlineContent":[{"type":"text","text":"The body is a JSON array of content type "},{"code":"application\/json","type":"codeVoice"},{"text":", one event per record, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first. Each event is a flat object of these members:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"appID"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The app ID the encoder is made with, without leading or trailing whitespace"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"clientUser"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The SHA256 of the record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" as a lowercase UUID string, as 64 lowercase hexadecimal digits; of the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"isTestMode"}],"type":"paragraph"}],[{"inlineContent":[{"code":"\"true\"","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"\"false\"","type":"codeVoice"},{"text":", as the encoder is made with","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"receivedAt"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionID"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID string; left out when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"type"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.SDK.name"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Traffluent"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Each of the event’s stored properties"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Its value, read through the event’s schema in the plan; a nested value spread into one member per scalar it holds, named after its path, joined by ","type":"text"},{"code":".","type":"codeVoice"},{"text":" (","type":"text"},{"code":"cart.size","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tags.0","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"The session is the only identifier sent, hashed as TelemetryDeck’s SDKs hash a user’s","type":"text"},{"text":" ","type":"text"},{"text":"identifier with their default, empty salt; TelemetryDeck salts and hashes it again before","type":"text"},{"text":" ","type":"text"},{"text":"storing it. No salt of the app’s own is taken: ","type":"text"},{"type":"codeVoice","code":"sessionID"},{"text":" sends the same session in the","type":"text"},{"text":" ","type":"text"},{"text":"clear, so a salt would hide nothing. TelemetryDeck counts a user per ","type":"text"},{"type":"codeVoice","code":"clientUser"},{"text":", so its users","type":"text"},{"text":" ","type":"text"},{"text":"are sessions. A record with no session (one tracked by a tracker without ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"is its own user of one event, with no ","type":"text"},{"type":"codeVoice","code":"sessionID"},{"text":", linked to nothing: TelemetryDeck refuses an","type":"text"},{"text":" ","type":"text"},{"text":"event without a ","type":"text"},{"type":"codeVoice","code":"clientUser"},{"text":". A record a store recovers after a relaunch keeps its session, so","type":"text"},{"text":" ","type":"text"},{"text":"it goes out with the ","type":"text"},{"type":"codeVoice","code":"clientUser"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"sessionID"},{"text":" of its first send. The record’s vendor identifier and trace context, and","type":"text"},{"text":" ","type":"text"},{"text":"any other context value, aren’t sent. Nor is a ","type":"text"},{"type":"codeVoice","code":"floatValue"},{"text":": a number among the properties","type":"text"},{"text":" ","type":"text"},{"text":"keeps its JSON type in Ingest API v3.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. A "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is left out too, as TelemetryDeck stores no"},{"type":"text","text":" "},{"type":"text","text":"value for it. TelemetryDeck stores a nested object without indexing it and leaves arrays"},{"type":"text","text":" "},{"type":"text","text":"undefined, so the encoder spreads both into members of their own."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each event also holds these of TelemetryDeck’s built-in parameters, for each of the keys the"},{"type":"text","text":" "},{"type":"text","text":"record’s context has a value for:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Parameter","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.AppInfo.version","type":"codeVoice"},{"type":"text","text":", "},{"code":"TelemetryDeck.AppInfo.buildNumber","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The version and the build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.AppInfo.versionAndBuildNumber","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"},{"type":"text","text":", with both a version and a build"}]}],[{"type":"paragraph","inlineContent":[{"code":"2.4.1 (build 418)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.Device.modelName","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.Device.operatingSystem","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TelemetryDeck.Device.platform","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The operating system’s name, ","type":"text"},{"type":"codeVoice","code":"iOS"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.Device.systemVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TelemetryDeck.Device.systemMajorVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TelemetryDeck.Device.systemMajorMinorVersion","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"},{"type":"text","text":", with a version"}]}],[{"type":"paragraph","inlineContent":[{"text":"The name and the version, its first component and its first two: ","type":"text"},{"type":"codeVoice","code":"iOS 26.1.0"},{"text":", ","type":"text"},{"type":"codeVoice","code":"iOS 26"},{"text":", ","type":"text"},{"type":"codeVoice","code":"iOS 26.1"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.locale"}]}],[{"type":"paragraph","inlineContent":[{"code":"LocaleKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The locale’s identifier, ","type":"text"},{"code":"en_US","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.RunContext.language","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":", with a language"}]}],[{"type":"paragraph","inlineContent":[{"text":"The language’s code, ","type":"text"},{"type":"codeVoice","code":"en"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.UserPreference.region"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":", with a region"}]}],[{"type":"paragraph","inlineContent":[{"text":"The region’s code, ","type":"text"},{"type":"codeVoice","code":"US"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event name or parameter","type":"text"},{"text":" ","type":"text"},{"text":"name TelemetryDeck refuses or keeps for itself, one whose values flatten to one name, one whose","type":"text"},{"text":" ","type":"text"},{"text":"event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds a value JSON can’t, one whose timestamp is outside the","type":"text"},{"text":" ","type":"text"},{"text":"years 1 to 9999, and one whose JSON is over 333,333 bytes (","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","type":"reference"},{"text":" returns them as ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","type":"reference","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. TelemetryDeck answers a request it takes with 200, and checks every event of a"},{"type":"text","text":" "},{"type":"text","text":"request before storing any: it answers 422 when one breaks a rule, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"drops and reports with every record of the request. It answers 503 when its queue is full,"},{"type":"text","text":" "},{"type":"text","text":"which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" retries. It doesn’t remove duplicates, so a record sent again is"},{"type":"text","text":" "},{"type":"text","text":"counted again. The bytes are the same for the same records on every run and platform: no"},{"type":"text","text":" "},{"type":"text","text":"whitespa