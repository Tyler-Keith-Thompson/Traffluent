ind":"identifier","text":"Sensitive"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"kind":"symbol","type":"topic","title":"Sensitive","url":"\/documentation\/events\/sensitive"},"doc://TelemetryDeckEncoding/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/TelemetryDeckEncoding\/s8SendableP","type":"unresolvable"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/init(appID:testMode:plan:limit:)":{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"testMode","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"TelemetryDeckSetupError","kind":"typeIdentifier","preciseIdentifier":"s:21TelemetryDeckEncoding0aB10SetupErrorO"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"An encoder of the events "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" describes, for the Teleme