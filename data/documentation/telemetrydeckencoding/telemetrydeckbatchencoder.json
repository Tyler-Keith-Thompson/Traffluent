{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder"]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/TelemetryDeckEncoding\/s8SendableP","doc:\/\/TelemetryDeckEncoding\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" of TelemetryDeck’s Ingest API v3, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" ","type":"text"},{"text":"can send events to an organization’s ","type":"text"},{"type":"codeVoice","code":"POST \/v3\/<namespace>\/"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and its limits:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The body is a JSON array of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", one event per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. Each event is a flat object of these members:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"appID"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The app ID the encoder is made with, without leading or trailing whitespace"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"clientUser","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The SHA256 of the record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" as a lowercase UUID string, as 64 lowercase hexadecimal digits; of the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"isTestMode"}],"type":"paragraph"}],[{"inlineContent":[{"code":"\"true\"","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"\"false\"","type":"codeVoice"},{"text":", as the encoder is made with","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"receivedAt"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionID"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, its ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", as a lowercase UUID string; left out when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"type"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s ","type":"text"},{"type":"codeVoice","code":"Event\/name"},{"text":", as it is","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.SDK.name"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Traffluent"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Each of the event’s stored properties","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Its value, read through the event’s schema in the plan; a nested value spread into one member per scalar it holds, named after its path, joined by "},{"type":"codeVoice","code":"."},{"type":"text","text":" ("},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":")"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent, hashed as TelemetryDeck’s SDKs hash a user’s"},{"type":"text","text":" "},{"type":"text","text":"identifier with their default, empty salt; TelemetryDeck salts and hashes it again before"},{"type":"text","text":" "},{"type":"text","text":"storing it. No salt of the app’s own is taken: "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":" sends the same session in the"},{"type":"text","text":" "},{"type":"text","text":"clear, so a salt would hide nothing. TelemetryDeck counts a user per "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":", so its users"},{"type":"text","text":" "},{"type":"text","text":"are sessions. A record with no session (one tracked by a tracker without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"is its own user of one event, with no "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":", linked to nothing: TelemetryDeck refuses an"},{"type":"text","text":" "},{"type":"text","text":"event without a "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":". A record a store recovers after a relaunch keeps its session, so"},{"type":"text","text":" "},{"type":"text","text":"it goes out with the "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":" and "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":" of its first send. The record’s vendor identifier and trace context, and"},{"type":"text","text":" "},{"type":"text","text":"any other context value, aren’t sent. Nor is a "},{"code":"floatValue","type":"codeVoice"},{"type":"text","text":": a number among the properties"},{"type":"text","text":" "},{"type":"text","text":"keeps its JSON type in Ingest API v3."}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, and so is an element of an array. A ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" is left out too, as TelemetryDeck stores no","type":"text"},{"text":" ","type":"text"},{"text":"value for it. TelemetryDeck stores a nested object without indexing it and leaves arrays","type":"text"},{"text":" ","type":"text"},{"text":"undefined, so the encoder spreads both into members of their own.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each event also holds these of TelemetryDeck’s built-in parameters, for each of the keys the"},{"type":"text","text":" "},{"type":"text","text":"record’s context has a value for:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Parameter","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.AppInfo.version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TelemetryDeck.AppInfo.buildNumber","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The version and the build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.versionAndBuildNumber"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"},{"type":"text","text":", with both a version and a build"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"2.4.1 (build 418)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.Device.modelName","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The model","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.operatingSystem"},{"text":", ","type":"text"},{"type":"codeVoice","code":"TelemetryDeck.Device.platform"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The operating system’s name, ","type":"text"},{"code":"iOS","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.systemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.Device.systemMajorVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.Device.systemMajorMinorVersion"}]}],[{"type":"paragraph","inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"},{"type":"text","text":", with a version"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name and the version, its first component and its first two: "},{"type":"codeVoice","code":"iOS 26.1.0"},{"type":"text","text":", "},{"type":"codeVoice","code":"iOS 26"},{"type":"text","text":", "},{"type":"codeVoice","code":"iOS 26.1"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.RunContext.locale","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The locale’s identifier, ","type":"text"},{"code":"en_US","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.language"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":", with a language"}]}],[{"type":"paragraph","inlineContent":[{"text":"The language’s code, ","type":"text"},{"code":"en","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.UserPreference.region"}]}],[{"type":"paragraph","inlineContent":[{"code":"LocaleKey","type":"codeVoice"},{"text":", with a region","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The region’s code, ","type":"text"},{"type":"codeVoice","code":"US"}]}]]],"type":"table"},{"inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event name or parameter","type":"text"},{"text":" ","type":"text"},{"text":"name TelemetryDeck refuses or keeps for itself, one whose values flatten to one name, one whose","type":"text"},{"text":" ","type":"text"},{"text":"event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds a value JSON can’t, one whose timestamp is outside the","type":"text"},{"text":" ","type":"text"},{"text":"years 1 to 9999, and one whose JSON is over 333,333 bytes (","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" returns them as ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. TelemetryDeck answers a request it takes with 200, and checks every event of a"},{"type":"text","text":" "},{"type":"text","text":"request before storing any: it answers 422 when one breaks a rule, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"drops and reports with every record of the request. It answers 503 when its queue is full,"},{"type":"text","text":" "},{"type":"text","text":"which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries. It doesn’t remove duplicates, so a record sent again is"},{"type":"text","text":" "},{"type":"text","text":"counted again. The bytes are the same for the same records on every run and platform: no"},{"type":"text","text":" "},{"type":"text","text":"whitespace, object members in the order of their names’ UTF-8 bytes."}],"type":"paragraph"}]}],"sections":[],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"],"title":"Instance Methods","generated":true},{"anchor":"Type-Aliases","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/Failure"],"title":"Type Aliases","generated":true},{"anchor":"Type-Properties","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/transientStatuses"],"title":"Type Properties","generated":true},{"anchor":"Type-Methods","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/outcome(of:for:)"],"title":"Type Methods","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/Te