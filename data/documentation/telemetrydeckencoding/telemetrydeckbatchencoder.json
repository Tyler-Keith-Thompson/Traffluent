{"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"]},{"generated":true,"title":"Type Aliases","anchor":"Type-Aliases","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/Failure"]},{"generated":true,"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/transientStatuses"]},{"generated":true,"title":"Type Methods","anchor":"Type-Methods","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/outcome(of:for:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and its limits:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)"]},{"inlineContent":[{"text":"The body is a JSON array of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":", one event per record, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first. Each event is a flat object of these members:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"appID"}]}],[{"type":"paragraph","inlineContent":[{"text":"The app ID the encoder is made with, without leading or trailing whitespace","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"clientUser"}]}],[{"type":"paragraph","inlineContent":[{"text":"The SHA256 of the record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":" as a lowercase UUID string, as 64 lowercase hexadecimal digits; of the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isTestMode"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"true\"","type":"codeVoice"},{"type":"text","text":" or "},{"code":"\"false\"","type":"codeVoice"},{"type":"text","text":", as the encoder is made with"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"receivedAt"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sessionID","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; left out when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.SDK.name"}]}],[{"type":"paragraph","inlineContent":[{"code":"Traffluent","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Each of the event’s stored properties","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its value, read through the event’s schema in the plan; a nested value spread into one member per scalar it holds, named after its path, joined by "},{"type":"codeVoice","code":"."},{"type":"text","text":" ("},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":")"}]}]]]},{"inlineContent":[{"text":"The session is the only identifier sent, hashed as TelemetryDeck’s SDKs hash a user’s","type":"text"},{"text":" ","type":"text"},{"text":"identifier with their default, empty salt; TelemetryDeck salts and hashes it again before","type":"text"},{"text":" ","type":"text"},{"text":"storing it. No salt of the app’s own is taken: ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":" sends the same session in the","type":"text"},{"text":" ","type":"text"},{"text":"clear, so a salt would hide nothing. TelemetryDeck counts a user per ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":", so its users","type":"text"},{"text":" ","type":"text"},{"text":"are sessions. A record with no session (one tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"is its own user of one event, with no ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", linked to nothing: TelemetryDeck refuses an","type":"text"},{"text":" ","type":"text"},{"text":"event without a ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":". A record a store recovers after a relaunch keeps its session, so","type":"text"},{"text":" ","type":"text"},{"text":"it goes out with the ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":" of its first send. The record’s vendor identifier and trace context, and","type":"text"},{"text":" ","type":"text"},{"text":"any other context value, aren’t sent. Nor is a ","type":"text"},{"code":"floatValue","type":"codeVoice"},{"text":": a number among the properties","type":"text"},{"text":" ","type":"text"},{"text":"keeps its JSON type in Ingest API v3.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. A "},{"code":"null","type":"codeVoice"},{"type":"text","text":" is left out too, as TelemetryDeck stores no"},{"type":"text","text":" "},{"type":"text","text":"value for it. TelemetryDeck stores a nested object without indexing it and leaves arrays"},{"type":"text","text":" "},{"type":"text","text":"undefined, so the encoder spreads both into members of their own."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each event also holds these of TelemetryDeck’s built-in parameters, for each of the keys the"},{"type":"text","text":" "},{"type":"text","text":"record’s context has a value for:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Parameter","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.version"},{"text":", ","type":"text"},{"type":"codeVoice","code":"TelemetryDeck.AppInfo.buildNumber"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The version and the build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.versionAndBuildNumber"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"},{"type":"text","text":", with both a version and a build"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"2.4.1 (build 418)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.modelName"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The model","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.operatingSystem"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.Device.platform"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The operating system’s name, "},{"code":"iOS","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.systemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.Device.systemMajorVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.Device.systemMajorMinorVersion"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"},{"type":"text","text":", with a version"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The name and the version, its first component and its first two: ","type":"text"},{"type":"codeVoice","code":"iOS 26.1.0"},{"text":", ","type":"text"},{"type":"codeVoice","code":"iOS 26"},{"text":", ","type":"text"},{"type":"codeVoice","code":"iOS 26.1"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.RunContext.locale","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The locale’s identifier, ","type":"text"},{"code":"en_US","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.language"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":", with a language"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The language’s code, "},{"type":"codeVoice","code":"en"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.UserPreference.region"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"},{"text":", with a region","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The region’s code, "},{"code":"US","type":"codeVoice"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event name or parameter"},{"type":"text","text":" "},{"type":"text","text":"name TelemetryDeck refuses or keeps for itself, one whose values flatten to one name, one whose"},{"type":"text","text":" "},{"type":"text","text":"event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is outside the"},{"type":"text","text":" "},{"type":"text","text":"years 1 to 9999, and one whose JSON is over 333,333 bytes ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"},{"type":"text","text":")."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"},{"type":"text","text":" returns them as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. TelemetryDeck answers a request it takes with 200, and checks every event of a"},{"type":"text","text":" "},{"type":"text","text":"request before storing any: it answers 422 when one breaks a rule, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"drops and reports with every record of the request. It answers 503 when its queue is full,"},{"type":"text","text":" "},{"type":"text","text":"which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries. It doesn’t remove duplicates, so a record sent again is"},{"type":"text","text":" "},{"type":"text","text":"counted again. The bytes are the same for the same records on every run and platform: no"},{"type":"text","text":" "},{"type":"text","text":"whitespace, object members in the order of their names’ UTF-8 bytes."}],"type":"paragraph"}]}],"abstract":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of TelemetryDeck’s Ingest API v3, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"can send events to an organization’s ","type":"text"},{"code":"POST \/v3\/<namespace>\/","type":"codeVoice"},{"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/TelemetryDeckEncoding\/s8SendableP","doc:\/\/TelemetryDeckEncoding\/s16SendableMetatypeP"],"type":"conformsTo"}],"variants":[{"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["d