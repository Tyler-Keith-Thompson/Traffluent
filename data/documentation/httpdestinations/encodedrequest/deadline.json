" "},{"type":"text","text":"isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/deadlineExceeded(deadline:recordIDs:)","isActive":true},{"type":"text","text":". An encoder for a vendor that"},{"type":"text","text":" "},{"type":"text","text":"misdates or ignores an event older than some age, while still answering 2xx, sets it to its"},{"type":"text","text":" "},{"type":"text","text":"oldest record’s time plus that age, so a request retried past it is reported rather than"},{"type":"text","text":" "},{"type":"text","text":"counted as delivered."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations\/encodedrequest\/deadline"]}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport/deadlineExceeded(deadline:recordIDs:)":{"kind":"symbol","url":"\/documentation\/httpdestinations\/httpdropreport\/deadlineexceeded(deadline:recordids:)","type":"topic","role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/deadlineExceeded(deadline:recordIDs:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"deadlineExceeded"},{"kind":"text","text":"("},{"kind":"externalParam","text":"deadline"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"recordIDs"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:20FoundationEssentials4UUIDV"},{"kind":"text","text":"])"}],"abstract":[{"type":"text","text":"The request wasn’t delivered by "},{"type":"codeVoice","code":"deadline"},{"type":"text","text":" ("},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","isActive":true,"type":"reference"},{"type":"text","text":"), the latest moment"},{"type":"text","text":" "},{"type":"text","text":"it could be sent, so the whole request was dropped rather than sent again: every record it"},{"type":"text","text":" "},{"type":"text","text":"holds, identified by "},{"type":"codeVoice","code":"recordIDs"},{"type":"text","text":" in the request’s order, the younger ones whose own age"},{"type":"text","text":" "},{"type":"text","text":"was still within the vendor’s window included. The batch’s other requests are still"},{"type":"text","text":" "},{"type":"text","text":"sent."}],"title":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedRequest/deadline":{"url":"\/documentation\/httpdestinations\/encodedrequest\/deadline","abstract":[{"text":"The latest wall-clock time at which the request may be sent, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when it may be sent","type":"text"},{"text":" ","type":"text"},{"text":"at any time.","type":"text"}],"kind":"symbol","title":"deadline","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"deadline"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":"?"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic","title":"HTTPDestinations","role":"collection","kind":"symbol","url":"\/documentation\/httpdestinations","abstract":[{"text":"Send each batch of records to an HTTP 