"type":"reference","isActive":true},{"type":"text","text":" reads its clock before every attempt, the first included, and sends the"},{"type":"text","text":" "},{"type":"text","text":"request only while that time is at or before the deadline. Once it has passed, the request"},{"type":"text","text":" "},{"type":"text","text":"isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/deadlineExceeded(deadline:recordIDs:)","type":"reference","isActive":true},{"type":"text","text":". An encoder for a vendor that"},{"type":"text","text":" "},{"type":"text","text":"misdates or ignores an event older than some age, while still answering 2xx, sets it to its"},{"type":"text","text":" "},{"type":"text","text":"oldest record’s time plus that age, so a request retried past it is reported rather than"},{"type":"text","text":" "},{"type":"text","text":"counted as delivered."}]}],"kind":"content"}],"sections":[],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"title":"HTTPDestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"url":"\/documentation\/httpdestinations\/httpdestination"},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedRequest":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EncodedRequest","kind":"identifier"}],"url":"\/documentation\/httpdestinations\/encodedrequest","navigatorTitle":[{"text":"EncodedRequest","kind":"identifier"}],"abstract":[{"type":"text","text":"One request of a batch as a "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"type":"text","text":" splits it: its body, the records it carries, and"},{"type":"text","text":" "},{"type":"text","text":"the latest moment it may be sent."}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","title":"EncodedRequest"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"role":"symbol","type":"topic","url":"\/documentation\/httpdestinations\/batchencoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"type":"text","text":" sends."}],"title":"BatchEncoder","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","url":"\/documentation\/httpdestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport/deadlineExceeded(deadline:recordIDs:)":{"title":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deadlineExceeded","kind":"identifier"},{"text":"(","kind":"text"