":"reference","isActive":true},{"text":" reads its clock before every attempt, the first included, and sends the","type":"text"},{"text":" ","type":"text"},{"text":"request only while that time is at or before the deadline. Once it has passed, the request","type":"text"},{"text":" ","type":"text"},{"text":"isn’t sent again: it is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/deadlineExceeded(deadline:recordIDs:)","type":"reference","isActive":true},{"text":". An encoder for a vendor that","type":"text"},{"text":" ","type":"text"},{"text":"misdates or ignores an event older than some age, while still answering 2xx, sets it to its","type":"text"},{"text":" ","type":"text"},{"text":"oldest record’s time plus that age, so a request retried past it is reported rather than","type":"text"},{"text":" ","type":"text"},{"text":"counted as delivered.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport/deadlineExceeded(deadline:recordIDs:)":{"kind":"symbol","abstract":[{"type":"text","text":"The request wasn’t delivered by "},{"code":"deadline","type":"codeVoice"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline"},{"type":"text","text":"), the latest moment"},{"type":"text","text":" "},{"type":"text","text":"it could be sent, so the whole request was dropped rather than sent again: every record it"},{"type":"text","text":" "},{"type":"text","text":"holds, identified by "},{"code":"recordIDs","type":"codeVoice"},{"type":"text","text":" in the request’s order, the younger ones whose own age"},{"type":"text","text":" "},{"type":"text","text":"was still within the vendor’s window included. The batch’s other requests are still"},{"type":"text","text":" "},{"type":"text","text