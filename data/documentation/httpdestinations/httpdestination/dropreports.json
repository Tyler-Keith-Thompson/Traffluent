ed while it waits returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic","title":"HTTPDestinations","role":"collection","kind":"symbol","url":"\/documentation\/httpdestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport":{"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDropReport","kind":"identifier"}],"type":"topic","title":"HTTPDropReport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","url":"\/documentation\/httpdestinations\/httpdropreport","abstract":[{"type":"text","text":"A batch "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" dropped without delivering it, and why."}],"role":"symbol","navigatorTitle":[{"text":"HTTPDropReport","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"type":"topic","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"kind":"symbol","url":"\/documentation\/httpdestinations\/httpdestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","role":"symbol","title":"HTTPDestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestin