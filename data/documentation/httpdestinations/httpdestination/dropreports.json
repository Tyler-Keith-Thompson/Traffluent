","type":"codeVoice"},{"text":".","type":"text"}]}]}],"abstract":[{"type":"text","text":"A report of each batch dropped without being delivered, in the order they are dropped."}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/Failure":{"required":true,"abstract":[{"type":"text","text":"What "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/encode(_:)","isActive":true},{"type":"text","text":" throws; "},{"code":"Never","type":"codeVoice"},{"type":"text","text":" for an encoder that can’t fail."}],"role":"symbol","kind":"symbol","type":"topic","title":"Failure","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","text":"Error"},{"kind":"text","text":" = "},{"preciseIdentifier":"s:s5NeverO","kind":"typeIdentifier","text":"Never"}],"url":"\/documentation\/httpdestinations\/batchencoder\/failure","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/Failure"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"kind":"symbol","abstract":[{"type":"text","text":"The reports or deliveries a library type makes, in the order it makes them, kept until they"},{"type":"text","text":" "},{"type":"text","text":"are read; one reader at a time reads them."}],"title":"AsyncQueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"url":"\/documentation\/asyncqueues\/asyncqueue","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/httpdestinations","title":"HTTPDestinations","identifier":"do