eport in order."},{"type":"text","text":" "},{"type":"text","text":"A reader cancelled while it waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]}],"references":{"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}],"title":"AsyncQueue","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","url":"\/documentation\/asyncqueues\/asyncqueue","kind":"symbol","type":"topic","navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/Failure":{"title":"Failure","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","text":"Error"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/Failure","kind":"symbol","required":true,"type":"topic","role":"symbol","abstract":[{"text":"What ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)","type":"reference"},{"text":" throws, and why a record was left out; ","type":"text"},{"code":"Never","type":"codeVoice"},{"text":" for an encoder that","type":"text"},{"text":" ","type":"text"},{"text":"can’t fail.","type":"text"}],"url":"\/documentation\/httpdestinations\/batchencoder\/failure"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/requests(for:)":{"required":true,"abstract":[{"text":"The requests that carry ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":", which ","type":"text"},{"isActive"