{"sections":[],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"]]},"abstract":[{"text":"A report of each batch dropped without being delivered, in the order they are dropped.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations\/httpdestination\/dropreports"]}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"symbolKind":"property","modules":[{"name":"HTTPDestinations"}],"roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO","text":"HTTPDropReport","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa","text":"Failure","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"externalID":"s:16HTTPDestinations15HTTPDestinationV11dropReports11AsyncQueues0E5QueueVyAA14HTTPDropReportOy7FailureQy_GGvp","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L185","fileName":"HTTPDestination.swift"},"role":"symbol","title":"dropReports"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/Async