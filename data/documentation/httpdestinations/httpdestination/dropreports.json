aragraph"}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations\/httpdestination\/dropreports"]}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/dropReports":{"title":"dropReports","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"HTTPDropReport","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa"},{"text":">>","kind":"text"}],"url":"\/documentation\/httpdestinations\/httpdestination\/dropreports","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","abstract":[{"type":"text","text":"A report of each batch dropped without being delivered, in the order they are dropped."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/Failure":{"title":"Failure","required":true,"role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder\/failure","abstract":[{"type":"text","text":"What "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)","type":"reference","isActive":true},{"type":"text","text":" throws, and why a record was left out; "},{"type":"codeVoice","code":"Never"},{"type":"text","text":" for an encoder that"},{"type":"text","text":" "},{"type":"text","text":"can’t fail."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/Failure","type":"topic","kind":"symbol","fragments":[{"text":"ass