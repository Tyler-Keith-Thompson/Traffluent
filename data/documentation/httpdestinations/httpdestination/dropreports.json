{"abstract":[{"type":"text","text":"A report of each batch dropped without being delivered, in the order they are dropped."}],"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination\/dropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO","text":"HTTPDropReport"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/Failure","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa","text":"Failure"},{"kind":"text","text":">> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Reports wait, without a bound, until they are read, so none is missed by reading late."},{"type":"text","text":" "},{"type":"text","text":"The sequence ends once the destination and every copy of it are gone and every report has"},{"type":"text","text":" "},{"type":"text","text":"been read. Read the sequence into a constant before starting the task that reads it, so"},{"type":"text","text":" "},{"type":"text","text":"the task holds the sequence and not the destination:"}],"type":"paragraph"},{"syntax":"swift","code":["let reports = collector.dropReports","Task {","    for await report in reports {","        logger.warning(\"Dropped a batch: \\(report)\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Instance Property","symbolKind":"property","modules":[{"name":"HTTPDestinations"}],"title":"dropReports","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"HTTPDropReport","preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa"},{"kind":"text","text":">>"}],"externalID":"s:16HTTPDestinations15HTTPDestinationV11dropReports11AsyncQueues0E5QueueVyAA14HTTPDropReportOy7FailureQy_GGvp","remoteSource":{"url