{"abstract":[{"type":"text","text":"A report of each batch dropped without being delivered, in the order they are dropped."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue","kind":"typeIdentifier","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO","text":"HTTPDropReport","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa","text":"Failure","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/Failure"},{"text":">> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Reports wait, without a bound, until they are read, so none is missed by reading late."},{"type":"text","text":" "},{"type":"text","text":"The sequence ends once the destination and every copy of it are gone and every report has"},{"type":"text","text":" "},{"type":"text","text":"been read. Read the sequence into a constant before starting the task that reads it, so"},{"type":"text","text":" "},{"type":"text","text":"the task holds the sequence and not the destination:"}],"type":"paragraph"},{"code":["let