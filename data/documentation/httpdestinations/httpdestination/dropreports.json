,"type":"text"},{"text":" ","type":"text"},{"text":"the task holds the sequence and not the destination:","type":"text"}]},{"code":["let reports = collector.dropReports","Task {","    for await report in reports {","        logger.warning(\"Dropped a batch: \\(report)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination\/dropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"symbolKind":"property","remoteSource":{"fileName":"HTTPDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L144"},"externalID":"s:16HTTPDestinations15HTTPDestinationV11dropReports11AsyncQueues0E5QueueVyAA14HTTPDropReportOy7FailureQy_GGvp","role":"symbol","title":"dropReports","modules":[{"name":"HTTPDestinations"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO","text":"HTTPDropReport"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":"