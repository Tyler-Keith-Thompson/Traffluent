xt":" "},{"type":"text","text":"A reader cancelled while it waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/requests(for:)":{"type":"topic","abstract":[{"text":"The requests that carry ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":", which ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" sends one after another, and the","type":"text"},{"text":" ","type":"text"},{"text":"records left out of them.","type":"text"}],"kind":"symbol","url":"\/documentation\/httpdestinations\/batchencoder\/requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"BatchRequests","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa"},{"kind":"text","text":">"}],"title":"requests(for:)","required":true,"role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/Failure":{"role":"symbol","type":"topic","required":