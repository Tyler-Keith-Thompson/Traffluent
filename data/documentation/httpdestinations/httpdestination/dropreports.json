er"},{"text":">","kind":"text"}],"url":"\/documentation\/httpdestinations\/batchencoder\/requests(for:)","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)","abstract":[{"text":"The requests that carry ","type":"text"},{"type":"codeVoice","code":"batch"},{"text":", which ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"text":" sends one after another, and the","type":"text"},{"text":" ","type":"text"},{"text":"records left out of them.","type":"text"}]},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"role":"symbol","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","kind":"symbol","url":"\/documentation\/asyncqueues\/asyncqueue","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}],"navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"title":"AsyncQueue","abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"type":"topic","title":"HTTPDestination","role":"symbol","url":"\/documentation\/httpdestinations\/httpdestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},"doc://HTTPDestinations/documentation/HTTPDesti