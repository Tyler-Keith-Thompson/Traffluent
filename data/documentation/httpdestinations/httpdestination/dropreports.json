xt":" "},{"type":"text","text":"A reader cancelled while it waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/dropReports":{"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"HTTPDropReport","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa"},{"text":">>","kind":"text"}],"abstract":[{"type":"text","text":"A report of each batch dropped without being delivered, in the order they are dropped."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","kind":"symbol","role":"symbol","url":"\/documentation\/httpdestinations\/httpdestination\/dropreports","title":"dropReports"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/Failure":{"required":true,"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","text":"Error"}],"abstract":[{"text":"What ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" throws, and why a record was left out; ","type":"text"},{"code":"Never","type":"codeVoice"},{"text":" for an encoder that","type":"text"},{"text":" ","type":"text"},{"text":"can’t fail.","type":"text"}],"url":"\/documentation\/h