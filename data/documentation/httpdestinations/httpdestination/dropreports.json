type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations\/httpdestination\/dropreports"]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"]]},"abstract":[{"text":"A report of each batch dropped without being delivered, in the order they are dropped.","type":"text"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"},"metadata":{"title":"dropReports","role":"symbol","externalID":"s:16HTTPDestinations15HTTPDestinationV11dropReports11AsyncQueues0E5QueueVyAA14HTTPDropReportOy7FailureQy_GGvp","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"HTTPDropReport","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa"},{"text":">>","kind":"text"}],"remoteSource":{"fileName":"HTTPDestination.swift","url":"https:\/\/