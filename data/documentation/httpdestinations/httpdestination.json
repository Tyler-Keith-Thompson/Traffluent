{"kind":"symbol","abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:randomNumberGenerator:now:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:randomNumberGenerator:now:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"],"generated":true}],"metadata":{"externalID":"s:16HTTPDestinations15HTTPDestinationV","symbolKind":"struct","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"remoteSource":{"fileName":"HTTPDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L96"},"title":"HTTPDestination","modules":[{"name":"HTTPDestinations"}],"navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"role":"symbol"},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations\/httpdestination"]}],"seeAlsoSections":[{"anchor":"Sending-batches","title":"Sending batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Transport"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Encoding"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"HTTPTransport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"The wire shape, for a server that ingests these batches:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The requests the encoder splits each batch into (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)"},{"text":"), in the","type":"text"},{"text":" ","type":"text"},{"text":"order the delivery hands batches over, each request sent only once the previous one is","type":"text"},{"text":" ","type":"text"},{"text":"delivered or dropped.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The method is ","type":"text"},{"code":"POST","type":"codeVoice"},{"text":" and the URL is the configured endpoint.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The header fields are the configured ones, then the trace context of the request’s first"},{"type":"text","text":" "},{"type":"text","text":"record, then "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":", each replacing fields of the same name before it:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The instrument injects the first (oldest) record’s "},{"type":"codeVoice","code":"EventRecord\/context"},{"type":"text","text":", so a server"},{"type":"text","text":" "},{"type":"text","text":"extracting it joins the request, and the events, to the trace the app was in. Its field"},{"type":"text","text":" "},{"type":"text","text":"names are the instrument’s: "},{"type":"codeVoice","code":"traceparent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"tracestate"},{"type":"text","text":" for a W3C Trace Context tracer."},{"type":"text","text":" "},{"type":"text","text":"A record tracked outside any span, or an instrument that injects nothing (the default"},{"type":"text","text":" "},{"type":"codeVoice","code":"NoOpInstrument"},{"type":"text","text":" when none is bootstrapped), adds no fields."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Only the first record’s context travels in the header fields, though a request may hold"},{"type":"text","text":" "},{"type":"text","text":"records tracked in other traces. A server that needs each record’s context reads it from"},{"type":"text","text":" "},{"type":"text","text":"the body, where a "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" writes it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" is always the encoder’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType"},{"type":"text","text":", whatever a configured"},{"type":"text","text":" "},{"type":"text","text":"field or the instrument wrote."}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is exactly the encoder’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},{"type":"text","text":" for the request’s records, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. The format is the encoder’s; events need no "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A response with a 2xx status means the request arrived, and the encoder reads its body to","type":"text"},{"text":" ","type":"text"},{"text":"say whether the vendor stored it (","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","isActive":true,"type":"reference"},{"text":"): most vendors answer 2xx","type":"text"},{"text":" ","type":"text"},{"text":"only to what they store, and their encoders count every 2xx as delivered. A vendor that","type":"text"},{"text":" ","type":"text"},{"text":"answers 2xx to a request it stores nothing of, and says so in the body (Mixpanel’s","type":"text"},{"text":" ","type":"text"},{"code":"{\"status\": 0, \"error\": ...}","type":"codeVoice"},{"text":"), has the request dropped and reported","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)","isActive":true,"type":"reference"},{"text":"), or, for a refusal its vendor","type":"text"},{"text":" ","type":"text"},{"text":"says may pass, sent again as after a 5xx, until the request’s deadline. An encoder should","type":"text"},{"text":" ","type":"text"},{"text":"count a body it can’t read, an empty one included, as delivered, so an answer that changes","type":"text"},{"text":" ","type":"text"},{"text":"shape never makes the destination send the same request again and again; the","type":"text"},{"text":" ","type":"text"},{"text":"DestinationTesting conformance kit checks that it does.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"A request the transport can never send (","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","isActive":true,"type":"reference"},{"text":": a","type":"text"},{"text":" ","type":"text"},{"text":"malformed or unsupported URL, or an ","type":"text"},{"code":"http","type":"codeVoice"},{"text":" URL App Transport Security refuses) isn’t sent","type":"text"},{"text":" ","type":"text"},{"text":"again.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"No response, a 5xx status, 408 Request Timeout, 429 Too Many Requests, or a status the","type":"text"},{"text":" ","type":"text"},{"text":"encoder lists in ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","type":"reference","isActive":true},{"text":" means it didn’t arrive yet: the same","type":"text"},{"text":" ","type":"text"},{"text":"request is sent again after the backoff’s next wait, for as long as it takes. A","type":"text"},{"text":" ","type":"text"},{"code":"Retry-After","type":"codeVoice"},{"text":" field is not read; the backoff alone sets the wait.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any other status means the endpoint won’t take the request, and it isn’t sent again. The"},{"type":"text","text":" "},{"type":"text","text":"batch’s later requests are still sent."}]}]},{"content":[{"inlineContent":[{"text":"A request with a deadline (","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","isActive":true,"type":"reference"},{"text":") is sent only while the destination’s","type":"text"},{"text":" ","type":"text"},{"text":"wall clock reads that time or earlier, checked before every attempt, the first included, and","type":"text"},{"text":" ","type":"text"},{"text":"again when an attempt fails. One still undelivered once it has passed isn’t sent again, and","type":"text"},{"text":" ","type":"text"},{"text":"is reported without waiting out a backoff, so a vendor that would misdate or ignore records","type":"text"},{"text":" ","type":"text"},{"text":"that old never receives them. The whole request is dropped, its younger records too; the","type":"text"},{"text":" ","type":"text"},{"text":"batch’s later requests are still sent.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A record can arrive twice: a request the server took whose response was lost is sent"},{"type":"text","text":" "},{"type":"text","text":"again, and a record a store redelivers after the app was stopped mid-send"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"type":"text","text":") may have arrived before. Its "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" is the one it was"},{"type":"text","text":" "},{"type":"text","text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one"},{"type":"text","text":" "},{"type":"text","text":"copy."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A batch of several requests is acknowledged only once every request is delivered or dropped."},{"type":"text","text":" "},{"type":"text","text":"A delivery cancelled, or an app stopped, after some of its requests arrived hands the whole"},{"type":"text","text":" "},{"type":"text","text":"batch over again, so those requests are sent again too: a server that keeps one copy per"},{"type":"text","text":" "},{"type":"text","text":"record identifier absorbs them. The records the encoder leaves out are then reported again."}],"type":"paragraph"}]}]},{"inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","type":"reference","isActive":true},{"text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so","type":"text"},{"text":" ","type":"text"},{"text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being","type":"text"},{"text":" ","type":"text"},{"text":"retried when the app ends is delivered again on the next launch. A request the endpoint","type":"text"},{"text":" ","type":"text"},{"text":"rejects, by its status or in a 2xx answer’s body, that can’t be sent or that passed its","type":"text"},{"text":" ","type":"text"},{"text":"deadline, a batch the encoder can’t encode, and","type":"text"},{"text":" ","type":"text"},{"text":"a record the encoder leaves out of its requests are dropped: logged at error level and","type":"text"},{"text":" ","type":"text"},{"text":"reported on ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","type":"reference","isActive":true},{"text":". Each failed attempt that will be retried is logged at notice","type":"text"},{"text":" ","type":"text"},{"text":"level.","type":"text"},{"text":" ","type":"text"},{"text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","type":"reference","isActive":true},{"text":" returns without logging or reporting it, or sending the batch’s later","type":"text"},{"text":" ","type":"text"},{"text":"requests. A request whose wait before the next attempt throws something other than","type":"text"},{"text":" ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" (a custom clock’s failure) is given up on, logged at error level but not","type":"text"},{"text":" ","type":"text"},{"text":"reported, and the batch’s next request is sent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,"},{"type":"text","text":" "},{"type":"text","text":"which drops its oldest batch when full and reports it on the delivery’s "},{"code":"bufferDropReports","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"With a store, a dropped batch’s records aren’t lost: once this destination has caught up, the"},{"type":"text","text":" "},{"type":"text","text":"delivery reads them back from the store and hands them to it again, in the same run, so they"},{"type":"text","text":" "},{"type":"text","text":"are sent once the endpoint answers."},{"type":"text","text":" "},{"type":"text","text":"Without a store, the records of a dropped batch are lost."}],"type":"paragraph"},{"type":"codeListing","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"],"syntax":"swift"}]}],"references":{"doc://Destinations/documentation/Destinations/Destination":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","role":"symbol","title":"Destination","abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"navigatorTitle":[{"text":"Destination","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"url":"\/documentation\/destinations\/destination"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransportError/invalidRequest(reason:)":{"kind":"symbol","title":"HTTPTransportError.invalidRequest(reason:)","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"invalidRequest"},{"kind":"text","text":"("},{"kind":"externalParam","text":"reason"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}],"role":"symbol","url":"\/documentation\/httpdestinations\/httptransporterror\/invalidrequest(reason:)","abstract":[{"text":"The transport can never send the request as it is: its URL is malformed or of a scheme the","type":"text"},{"text":" ","type":"text"},{"text":"transport doesn’t support, or the platform refuses it, as App Transport Security refuses","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"http","type":"codeVoice"},{"text":" URL.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedBatch/contentType":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","type":"topic","title":"contentType","url":"\/documentation\/httpdestinations\/encodedbatch\/contenttype","abstract":[{"type":"text","text":"The body’s media type, sent as the request’s "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":": "},{"type":"codeVoice","code":"\"application\/json\""},{"type":"text","text":", say."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"contentType"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"url":"\/documentation\/httpdestinations","title":"HTTPDestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/dropReports":{"abstract":[{"type":"text","text":"A report of each batch dropped without being delivered, in the order they are dropped."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","title":"dropReports","kind":"symbol","url":"\/documentation\/httpdestinations\/httpdestination\/dropreports","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"HTTPDropReport","preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Failure","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa","kind":"typeIdentifier"},{"text":">>","kind":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:randomNumberGenerator:now:)":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:randomNumberGenerator:now:)","role":"symbol","title":"init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:randomNumberGenerator:now:)","abstract":[{"text":"A destination that sends batches to ","type":"text"},{"code":"endpoint","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"transport","type":"codeVoice"},{"text":", encoded by ","type":"text"},{"code":"encoder","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"retrying a send that fails for now with the waits of ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"endpoint"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL"},{"kind":"text","text":", "},{"kind":"externalParam","text":"headerFields"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:9HTTPTypes10HTTPFieldsV","text":"HTTPFields"},{"kind":"text","text":", "},{"kind":"externalParam","text":"instrument"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:15Instrumentation10InstrumentP","text":"Instrument"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"encoder"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"randomNumberGenerator"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:SG","text":"RandomNumberGenerator"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":")"}],"url":"\/documentation\/httpdestinations\/httpdestination\/init(endpoint:headerfields:instrument:transport:encoder:backoff:clock:randomnumbergenerator:now:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/receive(_:)":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Sends "},{"type":"codeVoice","code":"batch"},{"type":"text","text":" to the endpoint, as the requests its encoder splits it into, one after"},{"type":"text","text":" "},{"type":"text","text":"another; sends each again after each transient failure, and returns once every one is"},{"type":"text","text":" "},{"type":"text","text":"delivered or dropped, or the delivery is cancelled."}],"url":"\/documentation\/httpdestinations\/httpdestination\/receive(_:)","fragments":[{"text":"func","kind":"keyword"},{"