{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Transport"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Encoding"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP","kind":"typeIdentifier","text":"HTTPTransport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","kind":"typeIdentifier","text":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The wire shape, for a server that ingests these batches:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The requests the encoder splits each batch into ("},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":"), in the"},{"type":"text","text":" "},{"type":"text","text":"order the delivery hands batches over, each request sent only once the previous one is"},{"type":"text","text":" "},{"type":"text","text":"delivered or dropped."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The method is "},{"code":"POST","type":"codeVoice"},{"type":"text","text":" and the URL is the configured endpoint."}]}]},{"content":[{"inlineContent":[{"text":"The header fields are the configured ones, then the trace context of the request’s first","type":"text"},{"text":" ","type":"text"},{"text":"record, then ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":", each replacing fields of the same name before it:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The instrument injects the first (oldest) record’s ","type":"text"},{"code":"EventRecord\/context","type":"codeVoice"},{"text":", so a server","type":"text"},{"text":" ","type":"text"},{"text":"extracting it joins the request, and the events, to the trace the app was in. Its field","type":"text"},{"text":" ","type":"text"},{"text":"names are the instrument’s: ","type":"text"},{"code":"traceparent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"tracestate","type":"codeVoice"},{"text":" for a W3C Trace Context tracer.","type":"text"},{"text":" ","type":"text"},{"text":"A record tracked outside any span, or an instrument that injects nothing (the default","type":"text"},{"text":" ","type":"text"},{"code":"NoOpInstrument","type":"codeVoice"},{"text":" when none is bootstrapped), adds no fields.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Only the first record’s context travels in the header fields, though a request may hold","type":"text"},{"text":" ","type":"text"},{"text":"records tracked in other traces. A server that needs each record’s context reads it from","type":"text"},{"text":" ","type":"text"},{"text":"the body, where a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" writes it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Content-Type","type":"codeVoice"},{"type":"text","text":" is always the encoder’s "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","isActive":true},{"type":"text","text":", whatever a configured"},{"type":"text","text":" "},{"type":"text","text":"field or the instrument wrote."}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The body is exactly the encoder’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body","isActive":true},{"text":" for the request’s records, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first. The format is the encoder’s; events need no ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A response with a 2xx status means the request arrived, and the encoder reads its body to"},{"type":"text","text":" "},{"type":"text","text":"say whether the vendor stored it ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)"},{"type":"text","text":"): most vendors answer 2xx"},{"type":"text","text":" "},{"type":"text","text":"only to what they store, and their encoders count every 2xx as delivered. A vendor that"},{"type":"text","text":" "},{"type":"text","text":"answers 2xx to a request it stores nothing of, and says so in the body (Mixpanel’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"type":"text","text":"), has the request dropped and reported"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)"},{"type":"text","text":"), or, for a refusal its vendor"},{"type":"text","text":" "},{"type":"text","text":"says may pass, sent again as after a 5xx, until the request’s deadline. An encoder should"},{"type":"text","text":" "},{"type":"text","text":"count a body it can’t read, an empty one included, as delivered, so an answer that changes"},{"type":"text","text":" "},{"type":"text","text":"shape never makes the destination send the same request again and again; the"},{"type":"text","text":" "},{"type":"text","text":"DestinationTesting conformance kit checks that it does."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A request the transport can never send (","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","isActive":true,"type":"reference"},{"text":": a","type":"text"},{"text":" ","type":"text"},{"text":"malformed or unsupported URL, or an ","type":"text"},{"code":"http","type":"codeVoice"},{"text":" URL App Transport Security refuses) isn’t sent","type":"text"},{"text":" ","type":"text"},{"text":"again.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"No response, a 5xx status, 408 Request Timeout, 429 Too Many Requests, or a status the","type":"text"},{"text":" ","type":"text"},{"text":"encoder lists in ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","isActive":true,"type":"reference"},{"text":" means it didn’t arrive yet: the same","type":"text"},{"text":" ","type":"text"},{"text":"request is sent again after the backoff’s next wait, for as long as it takes. A","type":"text"},{"text":" ","type":"text"},{"code":"Retry-After","type":"codeVoice"},{"text":" field is not read; the backoff alone sets the wait.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Any other status means the endpoint won’t take the request, and it isn’t sent again. The","type":"text"},{"text":" ","type":"text"},{"text":"batch’s later requests are still sent.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A request with a deadline ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline"},{"type":"text","text":") is sent only while the destination’s"},{"type":"text","text":" "},{"type":"text","text":"wall clock reads that time or earlier, checked before every attempt, the first included, and"},{"type":"text","text":" "},{"type":"text","text":"again when an attempt fails. One still undelivered once it has passed isn’t sent again, and"},{"type":"text","text":" "},{"type":"text","text":"is reported without waiting out a backoff, so a vendor that would misdate or ignore records"},{"type":"text","text":" "},{"type":"text","text":"that old never receives them. The whole request is dropped, its younger records too; the"},{"type":"text","text":" "},{"type":"text","text":"batch’s later requests are still sent."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A record can arrive twice: a request the server took whose response was lost is sent"},{"type":"text","text":" "},{"type":"text","text":"again, and a record a store redelivers after the app was stopped mid-send"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"type":"text","text":") may have arrived before. Its "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" is the one it was"},{"type":"text","text":" "},{"type":"text","text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one"},{"type":"text","text":" "},{"type":"text","text":"copy."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A batch of several requests is acknowledged only once every request is delivered or dropped.","type":"text"},{"text":" ","type":"text"},{"text":"A delivery cancelled, or an app stopped, after some of its requests arrived hands the whole","type":"text"},{"text":" ","type":"text"},{"text":"batch over again, so those requests are sent again too: a server that keeps one copy per","type":"text"},{"text":" ","type":"text"},{"text":"record identifier absorbs them. The records the encoder leaves out are then reported again.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},{"text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so","type":"text"},{"text":" ","type":"text"},{"text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being","type":"text"},{"text":" ","type":"text"},{"text":"retried when the app ends is delivered again on the next launch. A request the endpoint","type":"text"},{"text":" ","type":"text"},{"text":"rejects, by its status or in a 2xx answer’s body, that can’t be sent or that passed its","type":"text"},{"text":" ","type":"text"},{"text":"deadline, a batch the encoder can’t encode, and","type":"text"},{"text":" ","type":"text"},{"text":"a record the encoder leaves out of its requests are dropped: logged at error level and","type":"text"},{"text":" ","type":"text"},{"text":"reported on ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"},{"text":". Each failed attempt that will be retried is logged at notice","type":"text"},{"text":" ","type":"text"},{"text":"level.","type":"text"},{"text":" ","type":"text"},{"text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},{"text":" returns without logging or reporting it, or sending the batch’s later","type":"text"},{"text":" ","type":"text"},{"text":"requests. A request whose wait before the next attempt throws something other than","type":"text"},{"text":" ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" (a custom clock’s failure) is given up on, logged at error level but not","type":"text"},{"text":" ","type":"text"},{"text":"reported, and the batch’s next request is sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,"},{"type":"text","text":" "},{"type":"text","text":"which drops its oldest batch when full and reports it on the delivery’s "},{"type":"codeVoice","code":"bufferDropReports"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"With a store, a dropped batch’s records aren’t lost: once this destination has caught up, the"},{"type":"text","text":" "},{"type":"text","text":"delivery reads them back from the store and hands them to it again, in the same run, so they"},{"type":"text","text":" "},{"type":"text","text":"are sent once the endpoint answers."},{"type":"text","text":" "},{"type":"text","text":"Without a store, the records of a dropped batch are lost."}]},{"type":"codeListing","syntax":"swift","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:randomNumberGenerator:now:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:randomNumberGenerator:now:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"],"anchor":"Default-Implementations"}],"seeAlsoSections":[{"generated":true,"title":"Sending batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"anchor":"Sending-batches"}],"metadata":{"navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"symbolKind":"struct","title":"HTTPDestination","roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestinatio