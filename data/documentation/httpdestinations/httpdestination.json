{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Transport"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Encoding"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"HTTPTransport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wire shape, for a server that ingests these batches:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"One request per batch, in the order the delivery hands them over, the next sent only once","type":"text"},{"text":" ","type":"text"},{"text":"the previous one has a response or has failed.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The method is "},{"code":"POST","type":"codeVoice"},{"type":"text","text":" and the URL is the configured endpoint."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The header fields are the configured ones, then the trace context of the batch’s first"},{"type":"text","text":" "},{"type":"text","text":"record, then "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":", each replacing fields of the same name before it:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The instrument injects the first (oldest) record’s "},{"type":"codeVoice","code":"EventRecord\/context"},{"type":"text","text":", so a server"},{"type":"text","text":" "},{"type":"text","text":"extracting it joins the request, and the events, to the trace the app was in. Its field"},{"type":"text","text":" "},{"type":"text","text":"names are the instrument’s: "},{"type":"codeVoice","code":"traceparent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"tracestate"},{"type":"text","text":" for a W3C Trace Context tracer."},{"type":"text","text":" "},{"type":"text","text":"A record tracked outside any span, or an instrument that injects nothing (the default"},{"type":"text","text":" "},{"type":"codeVoice","code":"NoOpInstrument"},{"type":"text","text":" when none is bootstrapped), adds no fields."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the first record’s context travels in the header fields, though a batch may hold"},{"type":"text","text":" "},{"type":"text","text":"records tracked in other traces. A server that needs each record’s context reads it from"},{"type":"text","text":" "},{"type":"text","text":"the body, where a "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"type":"text","text":" writes it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Content-Type","type":"codeVoice"},{"text":" is always the encoder’s ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","type":"reference","isActive":true},{"text":", whatever a configured","type":"text"},{"text":" ","type":"text"},{"text":"field or the instrument wrote.","type":"text"}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is exactly the encoder’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},{"type":"text","text":" for the batch’s records, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. The format is the encoder’s; events need no "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A response with a 2xx status means the batch arrived. Any other status, or no response,"},{"type":"text","text":" "},{"type":"text","text":"means it didn’t; either way the batch is not sent again."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A record can still arrive twice: one a store redelivers after the app was stopped mid-send","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"EventRecord\/isRedelivered","type":"codeVoice"},{"text":") may have arrived before. Its ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" is the one it was","type":"text"},{"text":" ","type":"text"},{"text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one","type":"text"},{"text":" ","type":"text"},{"text":"copy.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},{"type":"text","text":" handles its own failures: a batch the encoder can’t encode, a send that gets"},{"type":"text","text":" "},{"type":"text","text":"no response and a response that isn’t 2xx are each logged at error level and dropped, so"},{"type":"text","text":" "},{"type":"text","text":"the delivery and its other destinations carry on. A cancelled delivery cancels the send in"},{"type":"text","text":" "},{"type":"text","text":"flight, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},{"type":"text","text":" returns without logging it."}]},{"type":"codeListing","syntax":"swift","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"]}]}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"role":"symbol","title":"HTTPDestination","externalID":"s:16HTTPDestinations15HTTPDestinationV","remoteSource":{"fileName":"HTTPDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L48"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"modules":[{"name":"HTTPDestinations"}]},"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"],"anchor":"Instance-Methods"},{"generated":true,"