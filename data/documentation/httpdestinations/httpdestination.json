pe":"text"},{"text":"record, then ","type":"text"},{"type":"codeVoice","code":"Content-Type"},{"text":", each replacing fields of the same name before it:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The instrument injects the first (oldest) record’s "},{"code":"EventRecord\/context","type":"codeVoice"},{"type":"text","text":", so a server"},{"type":"text","text":" "},{"type":"text","text":"extracting it joins the request, and the events, to the trace the app was in. Its field"},{"type":"text","text":" "},{"type":"text","text":"names are the instrument’s: "},{"code":"traceparent","type":"codeVoice"},{"type":"text","text":" and "},{"code":"tracestate","type":"codeVoice"},{"type":"text","text":" for a W3C Trace Context tracer."},{"type":"text","text":" "},{"type":"text","text":"A record tracked outside any span, or an instrument that injects nothing (the default"},{"type":"text","text":" "},{"code":"NoOpInstrument","type":"codeVoice"},{"type":"text","text":" when none is bootstrapped), adds no fields."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the first record’s context travels in the header fields, though a batch may hold"},{"type":"text","text":" "},{"type":"text","text":"records tracked in other traces. A server that needs each record’s context reads it from"},{"type":"text","text":" "},{"type":"text","text":"the body, where a "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"type":"text","text":" writes it."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Content-Type"},{"text":" is always the encoder’s ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","type":"reference","isActive":true},{"text":", whatever a configured","type":"text"},{"text":" ","type":"text"},{"text":"field or the instrument wrote.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"text":"The body is exactly the encoder’s ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body","type":"reference","isActive":true},{"text":" for the batch’s records, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first. The format is the encoder’s; events need no ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" conformance.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A response with a 2xx status means the batch arrived. Any other status, or no response,"},{"type":"text","text":" "},{"type":"text","text":"means it didn’t; either way the batch is not sent again."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A record can still arrive twice: one a store redelivers after the app was stopped mid-send","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"EventRecord\/isRedelivered","type":"codeVoice"},{"text":") may have arrived before. Its ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" is the one it was","type":"text"},{"text":" ","type":"text"},{"text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one","type":"text"},{"text":" ","type":"text"},{"text":"copy.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","type":"reference"},{"text":" handles its own failures: a batch the encoder can’t encode, a send that gets","type":"text"},{"text":" ","type":"text"},{"text":"no response and a response that isn’t 2xx are each logged at error level and dropped, so","type":"text"},{"text":" ","type":"text"},{"text":"the delivery and its other destinations carry on. A cancelled delivery cancels 