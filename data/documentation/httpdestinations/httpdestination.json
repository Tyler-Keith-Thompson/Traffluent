{"abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as one request."}],"sections":[],"metadata":{"title":"HTTPDestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"remoteSource":{"fileName":"HTTPDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L44"},"roleHeading":"Structure","externalID":"s:16HTTPDestinations15HTTPDestinationV","modules":[{"name":"HTTPDestinations"}],"role":"symbol","symbolKind":"struct","navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"],"anchor":"Instance-Methods","title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP","text":"HTTPTransport","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","text":"BatchEncoder","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"The wire shape, for a server that ingests these batches:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"One request per batch, in the order the delivery hands them over, the next sent only once","type":"text"},{"text":" ","type":"text"},{"text":"the previous one has a response or has failed.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The method is ","type":"text"},{"code":"POST","type":"codeVoice"},{"text":" and the URL is the configured endpoint.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The header fields are the configured ones, then the trace context of the batch’s first"},{"type":"text","text":" "},{"type":"text","text":"record, then "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":", each replacing fields of the same name before it:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The instrument injects the first (oldest) record’s "},{"type":"codeVoice","code":"EventRecord\/context"},{"type":"text","text":", so a server"},{"type":"text","text":" "},{"type":"text","text":"extracting it joins the request, and the events, to the trace the app was in. Its field"},{"type":"text","text":" "},{"type":"text","text":"names are the instrument’s: "},{"type":"codeVoice","code":"traceparent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"tracestate"},{"type":"text","text":" for a W3C Trace Context tracer."},{"type":"text","text":" "},{"type":"text","text":"A record tracked outside any span, or an instrument that injects nothing (the default"},{"type":"text","text":" "},{"type":"codeVoice","code":"NoOpInstrument"},{"type":"text","text":" when none is bootstrapped), adds no fields."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Only the first record’s context travels in the header fields, though a batch may hold","type":"text"},{"text":" ","type":"text"},{"text":"records tracked in other traces. A server that needs each record’s context reads it from","type":"text"},{"text":" ","type":"text"},{"text":"the body, where a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" writes it.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Content-Type","type":"codeVoice"},{"text":" is always the encoder’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","isActive":true},{"text":", whatever a configured","type":"text"},{"text":" ","type":"text"},{"text":"field or the instrument wrote.","type":"text"}]}]}]}]},{"content":[{"inlineContent":[{"text":"The body is exactly the encoder’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body","type":"reference"},{"text":" for the batch’s records, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first. The format is the encoder’s; events need no ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A response with a 2xx status means the batch arrived. Any other status, or no response,"},{"type":"text","text":" "},{"type":"text","text":"means it didn’t; either way the batch is not sent again."}]}]}],"type":"unorderedList"},{"inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true,"type":"reference"},{"type":"text","text":" handles its own failures: a batch the encoder can’t encode, a send that gets"},{"type":"text","text":" "},{"type":"text","text":"no response and a response that isn’t 2xx are each logged at error level and dropped, so"},{"type":"text","text":" "},{"type":"text","text":"the delivery and its other destinations carry on. A cancelled delivery cancels the send in"},{"type":"text","text":" "},{"type":"text","text":"flight, and "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true,"type":"reference"},{"type":"text","text":" returns without logging it."}],"type":"paragraph"},{"syntax":"swift","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},"kind":"symbol","relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://HTTPDestinations/documentation/