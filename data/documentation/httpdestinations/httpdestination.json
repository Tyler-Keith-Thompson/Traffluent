{"sections":[],"metadata":{"modules":[{"name":"HTTPDestinations"}],"navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"title":"HTTPDestination","externalID":"s:16HTTPDestinations15HTTPDestinationV","symbolKind":"struct","role":"symbol","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L67","fileName":"HTTPDestination.swift"}},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Transport"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Encoding"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","text":"HTTPTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","text":"BatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"The wire shape, for a server that ingests these batches:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"One request per batch, in the order the delivery hands them over, the next batch sent only"},{"type":"text","text":" "},{"type":"text","text":"once the previous one is delivered or dropped."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The method is ","type":"text"},{"code":"POST","type":"codeVoice"},{"text":" and the URL is the configured endpoint.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The header fields are the configured ones, then the trace context of the batch’s first"},{"type":"text","text":" "},{"type":"text","text":"record, then "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":", each replacing fields of the same name before it:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The instrument injects the first (oldest) record’s ","type":"text"},{"code":"EventRecord\/context","type":"codeVoice"},{"text":", so a server","type":"text"},{"text":" ","type":"text"},{"text":"extracting it joins the request, and the events, to the trace the app was in. Its field","type":"text"},{"text":" ","type":"text"},{"text":"names are the instrument’s: ","type":"text"},{"code":"traceparent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"tracestate","type":"codeVoice"},{"text":" for a W3C Trace Context tracer.","type":"text"},{"text":" ","type":"text"},{"text":"A record tracked outside any span, or an instrument that injects nothing (the default","type":"text"},{"text":" ","type":"text"},{"code":"NoOpInstrument","type":"codeVoice"},{"text":" when none is bootstrapped), adds no fields.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Only the first record’s context travels in the header fields, though a batch may hold"},{"type":"text","text":" "},{"type":"text","text":"records tracked in other traces. A server that needs each record’s context reads it from"},{"type":"text","text":" "},{"type":"text","text":"the body, where a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" writes it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Content-Type","type":"codeVoice"},{"text":" is always the encoder’s ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType"},{"text":", whatever a configured","type":"text"},{"text":" ","type":"text"},{"text":"field or the instrument wrote.","type":"text"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is exactly the encoder’s "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body","isActive":true},{"type":"text","text":" for the batch’s records, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. The format is the encoder’s; events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A response with a 2xx status means the batch arrived."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A request the transport can never send ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"malformed or unsupported URL, or an "},{"type":"codeVoice","code":"http"},{"type":"text","text":" URL App Transport Security refuses) isn’t sent"},{"type":"text","text":" "},{"type":"text","text":"again."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No response, a 5xx status, 408 Request Timeout or 429 Too Many Requests means it didn’t"},{"type":"text","text":" "},{"type":"text","text":"arrive yet: the same request is sent again after the backoff’s next wait, for as long as it"},{"type":"text","text":" "},{"type":"text","text":"takes. A "},{"type":"codeVoice","code":"Retry-After"},{"type":"text","text":" field is not read; the backoff alone sets the wait."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Any other status means the endpoint won’t take the batch, and it isn’t sent again."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A record can arrive twice: a request the server took whose response was lost is sent"},{"type":"text","text":" "},{"type":"text","text":"again, and a record a store redelivers after the app was stopped mid-send"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"type":"text","text":") may have arrived before. Its "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" is the one it was"},{"type":"text","text":" "},{"type":"text","text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one"},{"type":"text","text":" "},{"type":"text","text":"copy."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},{"type":"text","text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so"},{"type":"text","text":" "},{"type":"text","text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being"},{"type":"text","text":" "},{"type":"text","text":"retried when the app ends is delivered again on the next launch. A batch the endpoint rejects,"},{"type":"text","text":" "},{"type":"text","text":"whose request can’t be sent, or that the encoder can’t encode is dropped: logged at error"},{"type":"text","text":" "},{"type":"text","text":"level and reported on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"},{"type":"text","text":". Each failed attempt that will be retried is logged at notice level."},{"type":"text","text":" "},{"type":"text","text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},{"type":"text","text":" returns without logging or reporting it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,"},{"type":"text","text":" "},{"type":"text","text":"which drops its oldest batch when full and reports it"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"deliver(to:batchBufferLimit:bufferDropReporter:)"},{"type":"text","text":"). With a store, a dropped batch’s records"},{"type":"text","text":" "},{"type":"text","text":"aren’t lost: once this destination has caught up, the delivery reads them back from the store"},{"type":"text","text":" "},{"type":"text","text":"and hands them to it again, in the same run, so they are sent once the endpoint answers."},{"type":"text","text":" "},{"type":"text","text":"Without a store, the records of a dropped batch are lost."}],"type":"paragraph"},{"syntax":"swift","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"],"type":"codeListing"}]}],"kind":"symbol","relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"]}],"seeAls