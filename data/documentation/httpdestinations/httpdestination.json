{"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:)"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"]}],"relationshipsSections":[{"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"symbolKind":"struct","roleHeading":"Structure","role":"symbol","navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"modules":[{"name":"HTTPDestinations"}],"remoteSource":{"fileName":"HTTPDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L67"},"externalID":"s:16HTTPDestinations15HTTPDestinationV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"title":"HTTPDestination"},"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"HTTPTransport","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BatchEncoder","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The wire shape, for a server that ingests these batches:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"One request per batch, in the order the delivery hands them over, the next batch sent only","type":"text"},{"text":" ","type":"text"},{"text":"once the previous one is delivered or dropped.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The method is ","type":"text"},{"code":"POST","type":"codeVoice"},{"text":" and the URL is the configured endpoint.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The header fields are the configured ones, then the trace context of the batch’s first","type":"text"},{"text":" ","type":"text"},{"text":"record, then ","type":"text"},{"type":"codeVoice","code":"Content-Type"},{"text":", each replacing fields of the same name before it:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The instrument injects the first (oldest) record’s "},{"type":"codeVoice","code":"EventRecord\/context"},{"type":"text","text":", so a server"},{"type":"text","text":" "},{"type":"text","text":"extracting it joins the request, and the events, to the trace the app was in. Its field"},{"type":"text","text":" "},{"type":"text","text":"names are the instrument’s: "},{"type":"codeVoice","code":"traceparent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"tracestate"},{"type":"text","text":" for a W3C Trace Context tracer."},{"type":"text","text":" "},{"type":"text","text":"A record tracked outside any span, or an instrument that injects nothing (the default"},{"type":"text","text":" "},{"type":"codeVoice","code":"NoOpInstrument"},{"type":"text","text":" when none is bootstrapped), adds no fields."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the first record’s context travels in the header fields, though a batch may hold"},{"type":"text","text":" "},{"type":"text","text":"records tracked in other traces. A server that needs each record’s context reads it from"},{"type":"text","text":" "},{"type":"text","text":"the body, where a "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"type":"text","text":" writes it."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" is always the encoder’s "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","isActive":true,"type":"reference"},{"type":"text","text":", whatever a configured"},{"type":"text","text":" "},{"type":"text","text":"field or the instrument wrote."}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is exactly the encoder’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},{"type":"text","text":" for the batch’s records, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. The format is the encoder’s; events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A response with a 2xx status means the batch arrived."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A request the transport can never send ("},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","isActive":true},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"malformed or unsupported URL, or an "},{"code":"http","type":"codeVoice"},{"type":"text","text":" URL App Transport Security refuses) isn’t sent"},{"type":"text","text":" "},{"type":"text","text":"again."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"No response, a 5xx status, 408 Request Timeout or 429 Too Many Requests means it didn’t"},{"type":"text","text":" "},{"type":"text","text":"arrive yet: the same request is sent again after the backoff’s next wait, for as long as it"},{"type":"text","text":" "},{"type":"text","text":"takes. A "},{"type":"codeVoice","code":"Retry-After"},{"type":"text","text":" field is not read; the backoff alone sets the wait."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Any other status means the endpoint won’t take the batch, and it isn’t sent again.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A record can arrive twice: a request the server took whose response was lost is sent"},{"type":"text","text":" "},{"type":"text","text":"again, and a record a store redelivers after the app was stopped mid-send"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"EventRecord\/isRedelivered","type":"codeVoice"},{"type":"text","text":") may have arrived before. Its "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":" is the one it was"},{"type":"text","text":" "},{"type":"text","text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one"},{"type":"text","text":" "},{"type":"text","text":"copy."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true},{"type":"text","text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so"},{"type":"text","text":" "},{"type":"text","text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being"},{"type":"text","text":" "},{"type":"text","text":"retried when the app ends is delivered again on the next launch. A batch the endpoint rejects,"},{"type":"text","text":" "},{"type":"text","text":"whose request can’t be sent, or that the encoder can’t encode is dropped: logged at error"},{"type":"text","text":" "},{"type":"text","text":"level and reported on "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true},{"type":"text","text":". Each failed attempt that will be retried is logged at notice level."},{"type":"text","text":" "},{"type":"text","text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true},{"type":"text","text":" returns without logging or reporting it."}]},{"type":"paragraph","inlineContent":[{"text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,","type":"text"},{"text":" ","type":"text"},{"text":"which drops its oldest batch when full and reports it","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"deliver(to:batchBufferLimit:bufferDropReporter:)"},{"text":"). With a store, a dropped batch’s records","type":"text"},{"text":" ","type":"text"},{"text":"aren’t lost: once this destination has caught up, the delivery reads them back from the store","type":"text"},{"text":" ","type":"text"},{"text":"and hands them to it again, in the same run, so they are sent once the endpoint answers.","type":"text"},{"text":" ","type":"text"},{"text":"Without a store, the records of a dropped batch are lost.","type":"text"}]},{"type":"codeListing","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"],"syntax":"swift"}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","interfaceLanguage":"swift"},"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as one request, and","type":"text"},{"text":" ","type":"text"},{"text":"sends it again until it arrives.","type":"text"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/receive(_:)":{"title":"receive(_:)","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","role":"symbol","url":"\/documentation\/httpdestinations\/httpdestination\/receive(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"receive","kind":"identifier"},{"text":"([","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"}],"abstract":[{"type":"text","text":"Sends "},{"type":"codeVoice","code":"batch"},{"type":"text","text":" to the endpoint as one request, sends it again after each transient"},{"type":"text","text":" "},{"type":"text","text":"failure, and returns once it is delivered, dropped or cancelled."}],"kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedBatch/body":{"abstract":[{"text":"The request body.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:20FoundationEssentials4DataV","kind":"typeIdentifier"}],"title":"body","url":"\/documentation\/httpdestinations\/encodedbatch\/body","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body","role":"symbol","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"title":"BatchEncoder","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"abstract":[{"type":"text","text":"What turns a batch of records into the body of the request "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"type":"text","text":" sends."}],"kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","kind":"symbol","title":"HTTPDestinations","role":"collection","abstract":[],"url":"\/documentation\/httpdestinations","type":"to