{"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Sending batches","anchor":"Sending-batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Transport"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Encoding"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","text":"HTTPTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","text":"BatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The wire shape, for a server that ingests these batches:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The requests the encoder splits each batch into ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)"},{"type":"text","text":"), in the"},{"type":"text","text":" "},{"type":"text","text":"order the delivery hands batches over, each request sent only once the previous one is"},{"type":"text","text":" "},{"type":"text","text":"delivered or dropped."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The method is "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" and the URL is the configured endpoint."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The header fields are the configured ones, then the trace context of the request’s first"},{"type":"text","text":" "},{"type":"text","text":"record, then "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":", each replacing fields of the same name before it:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The instrument injects the first (oldest) record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/context"},{"text":", so a server","type":"text"},{"text":" ","type":"text"},{"text":"extracting it joins the request, and the events, to the trace the app was in. Its field","type":"text"},{"text":" ","type":"text"},{"text":"names are the instrument’s: ","type":"text"},{"type":"codeVoice","code":"traceparent"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"tracestate"},{"text":" for a W3C Trace Context tracer.","type":"text"},{"text":" ","type":"text"},{"text":"A record tracked outside any span, or an instrument that injects nothing (the default","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NoOpInstrument"},{"text":" when none is bootstrapped), adds no fields.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Only the first record’s context travels in the header fields, though a request may hold","type":"text"},{"text":" ","type":"text"},{"text":"records tracked in other traces. A server that needs each record’s context reads it from","type":"text"},{"text":" ","type":"text"},{"text":"the body, where a ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" writes it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Content-Type"},{"text":" is always the encoder’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType"},{"text":", whatever a configured","type":"text"},{"text":" ","type":"text"},{"text":"field or the instrument wrote.","type":"text"}]}]}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The body is exactly the encoder’s "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body","isActive":true},{"type":"text","text":" for the request’s records, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. The format is the encoder’s; events need no "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A response with a 2xx status means the request arrived, and the encoder reads its body to"},{"type":"text","text":" "},{"type":"text","text":"say whether the vendor stored it ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)"},{"type":"text","text":"): most vendors answer 2xx"},{"type":"text","text":" "},{"type":"text","text":"only to what they store, and their encoders count every 2xx as delivered. A vendor that"},{"type":"text","text":" "},{"type":"text","text":"answers 2xx to a request it stores nothing of, and says so in the body (Mixpanel’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"type":"text","text":"), has the request dropped and reported"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)"},{"type":"text","text":"), or, for a refusal its vendor"},{"type":"text","text":" "},{"type":"text","text":"says may pass, sent again as after a 5xx, until the request’s deadline. An encoder should"},{"type":"text","text":" "},{"type":"text","text":"count a body it can’t read, an empty one included, as delivered, so an answer that changes"},{"type":"text","text":" "},{"type":"text","text":"shape never makes the destination send the same request again and again; the"},{"type":"text","text":" "},{"type":"text","text":"DestinationTesting conformance kit checks that it does."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A request the transport can never send ("},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","isActive":true},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"malformed or unsupported URL, or an "},{"type":"codeVoice","code":"http"},{"type":"text","text":" URL App Transport Security refuses) isn’t sent"},{"type":"text","text":" "},{"type":"text","text":"again."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No response, a 5xx status, 408 Request Timeout, 429 Too Many Requests, or a status the"},{"type":"text","text":" "},{"type":"text","text":"encoder lists in "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","isActive":true},{"type":"text","text":" means it didn’t arrive yet: the same"},{"type":"text","text":" "},{"type":"text","text":"request is sent again after the backoff’s next wait, for as long as it takes. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Retry-After"},{"type":"text","text":" field is not read; the backoff alone sets the wait."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Any other status means the endpoint won’t take the request, and it isn’t sent again. The"},{"type":"text","text":" "},{"type":"text","text":"batch’s later requests are still sent."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A request with a deadline (","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","isActive":true},{"text":") is sent only while the destination’s","type":"text"},{"text":" ","type":"text"},{"text":"wall clock reads that time or earlier, checked before every attempt, the first included, and","type":"text"},{"text":" ","type":"text"},{"text":"again when an attempt fails. One still undelivered once it has passed isn’t sent again, and","type":"text"},{"text":" ","type":"text"},{"text":"is reported without waiting out a backoff, so a vendor that would misdate or ignore records","type":"text"},{"text":" ","type":"text"},{"text":"that old never receives them. The whole request is dropped, its younger records too; the","type":"text"},{"text":" ","type":"text"},{"text":"batch’s later requests are still sent.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A record can arrive twice: a request the server took whose response was lost is sent"},{"type":"text","text":" "},{"type":"text","text":"again, and a record a store redelivers after the app was stopped mid-send"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"type":"text","text":") may have arrived before. Its "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" is the one it was"},{"type":"text","text":" "},{"type":"text","text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one"},{"type":"text","text":" "},{"type":"text","text":"copy."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A batch of several requests is acknowledged only once every request is delivered or dropped."},{"type":"text","text":" "},{"type":"text","text":"A delivery cancelled, or an app stopped, after some of its requests arrived hands the whole"},{"type":"text","text":" "},{"type":"text","text":"batch over again, so those requests are sent again too: a server that keeps one copy per"},{"type":"text","text":" "},{"type":"text","text":"record identifier absorbs them. The records the encoder leaves out are then reported again."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true,"type":"reference"},{"text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so","type":"text"},{"text":" ","type":"text"},{"text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being","type":"text"},{"text":" ","type":"text"},{"text":"retried when the app ends is delivered again on the next launch. A request the endpoint","type":"text"},{"text":" ","type":"text"},{"text":"rejects, by its status or in a 2xx answer’s body, that can’t be sent or that passed its","type":"text"},{"text":" ","type":"text"},{"text":"deadline, a batch the encoder can’t encode, and","type":"text"},{"text":" ","type":"text"},{"text":"a record the encoder leaves out of its requests are dropped: logged at error level and","type":"text"},{"text":" ","type":"text"},{"text":"reported on ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true,"type":"reference"},{"text":". Each failed attempt that will be retried is logged at notice","type":"text"},{"text":" ","type":"text"},{"text":"level.","type":"text"},{"text":" ","type":"text"},{"text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true,"type":"reference"},{"text":" returns without logging or reporting it, or sending the batch’s later","type":"text"},{"text":" ","type":"text"},{"text":"requests. A request whose wait before the next attempt throws something other than","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"CancellationError"},{"text":" (a custom clock’s failure) is given up on, logged at error level but not","type":"text"},{"text":" ","type":"text"},{"text":"reported, and the batch’s next request is sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,","type":"text"},{"text":" ","type":"text"},{"text":"which drops its oldest batch when full and reports it on the delivery’s ","type":"text"},{"type":"codeVoice","code":"bufferDropReports"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"With a store, a dropped batch’s records aren’t lost: once this destination has caught up, the","type":"text"},{"text":" ","type":"text"},{"text":"delivery reads them back from the store and hands them to it again, in the same run, so they","type":"text"},{"text":" ","type":"text"},{"text":"are sent once the endpoint answers.","type":"text"},{"text":" ","type":"text"},{"text":"Without a store, the records of a dropped batch are lost.","type":"text"}]},{"code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"],"syntax":"swift","type":"codeListing"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:randomNumberGenerator:now:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:randomNumberGenerator:now:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"],"generated":true}],"metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L96","fileName":"HTTPDestination.swift"},"navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"title":"HTTPDestination","externalID":"s:16HTTPDestinations15HTTPDestinationV","symbolKind":"struct","modules":[{"name":"HTTPDestinations"}]},"kind":"symbol","sections":[],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransport":{"navigatorTitle":[{"kind":"identifier","text":"HTTPTransport"}],"type":"topic","abstract":[{"text":"What sends an HTTP request and returns the server’s response: the seam between","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"text":" and the network.","type":"text"}],"role":"symbol","title":"HTTPTransport","url":"\/documentation\/httpdestinations\/httptransport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPTransport"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/requests(for:)":{"type":"topic","abstract":[{"text":"The requests that carry ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":", which ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" sends one after another, and the","type":"text"},{"text":" ","type":"text"},{"text":"records left out of them.","type":"text"}],"kind":"symbol","url":"\/documentation\/httpdestinations\/batchencoder\/requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"BatchRequests","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa"},{"kind":"text","text":">"}],"title":"requests(for:)","required":true,"role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/outcome(of:for:)":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","abstract":[{"type":"text","text":"What the successful (2xx) answer "},{"code":"response","type":"codeVoice"},{"type":"text","text":" to "},{"code":"request","type":"codeVoice"},{"type":"text","text":", one of this encoder’s requests,"},{"type":"text","text":" "},{"type":"text","text":"means: whether the vendor stored the request’s records."}],"url":"\/documentation\/httpdestinations\/batchencoder\/outcome(of:for:)","role":"symbol","type":"topic","required":true,"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO"}],"kind":"symbol","title":"outcome(of:for:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport/rejectedInBody(status:reason:recordIDs:)":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)","abstract":[{"type":"text","text":"The endpoint answered with "},{"type":"codeVoice","code":"status"},{"type":"text","text":", a 2xx, but the answer’s body says the vendor stored"},{"type":"text","text":" "},{"type":"text","text":"none of the records and won’t if they are sent again ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)"},{"type":"text","text":" "},{"type":"text","text":"returned "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)"},{"type":"text","text":"), for "},{"type":"codeVoice","code":"reason"},{"type":"text","text":", so the batch of the records"},{"type":"text","text":" "},{"type":"text","text":"identified by "},{"type":"codeVoice","code":"recordIDs"},{"type":"text","text":", oldest first, was dropped. Mixpanel’s track API, answering 200"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"type":"text","text":", is one such vendor."}],"url":"\/documentation\/httpdestinations\/httpdropreport\/rejectedinbody(status:reason:recordids:)","role":"symbol","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectedInBody","kind":"identifier"},{"text":"(","kind":"text"},{"text":"status","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:9HTTPTypes12HTTPResponseV","text":"HTTPResponse","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:9HTTPTypes12HTTPResponseV6StatusV","text":