{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations\/httpdestination"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"anchor":"Sending-batches","title":"Sending batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"generated":true}],"metadata":{"roleHeading":"Structure","navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L85","fileName":"HTTPDestination.swift"},"symbolKind":"struct","modules":[{"name":"HTTPDestinations"}],"externalID":"s:16HTTPDestinations15HTTPDestinationV","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"title":"HTTPDestination"},"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"sections":[],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","interfaceLanguage":"swift"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"HTTPTransport","preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BatchEncoder","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The wire shape, for a server that ingests these batches:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The requests the encoder splits each batch into ("},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":"), in the"},{"type":"text","text":" "},{"type":"text","text":"order the delivery hands batches over, each request sent only once the previous one is"},{"type":"text","text":" "},{"type":"text","text":"delivered or dropped."}]}]},{"content":[{"inlineContent":[{"text":"The method is ","type":"text"},{"code":"POST","type":"codeVoice"},{"text":" and the URL is the configured endpoint.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The header fields are the configured ones, then the trace context of the request’s first","type":"text"},{"text":" ","type":"text"},{"text":"record, then ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":", each replacing fields of the same name before it:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The instrument injects the first (oldest) record’s "},{"type":"codeVoice","code":"EventRecord\/context"},{"type":"text","text":", so a server"},{"type":"text","text":" "},{"type":"text","text":"extracting it joins the request, and the events, to the trace the app was in. Its field"},{"type":"text","text":" "},{"type":"text","text":"names are the instrument’s: "},{"type":"codeVoice","code":"traceparent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"tracestate"},{"type":"text","text":" for a W3C Trace Context tracer."},{"type":"text","text":" "},{"type":"text","text":"A record tracked outside any span, or an instrument that injects nothing (the default"},{"type":"text","text":" "},{"type":"codeVoice","code":"NoOpInstrument"},{"type":"text","text":" when none is bootstrapped), adds no fields."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Only the first record’s context travels in the header fields, though a request may hold","type":"text"},{"text":" ","type":"text"},{"text":"records tracked in other traces. A server that needs each record’s context reads it from","type":"text"},{"text":" ","type":"text"},{"text":"the body, where a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" writes it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Content-Type","type":"codeVoice"},{"text":" is always the encoder’s ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","type":"reference","isActive":true},{"text":", whatever a configured","type":"text"},{"text":" ","type":"text"},{"text":"field or the instrument wrote.","type":"text"}],"type":"paragraph"}]}]}]},{"content":[{"inlineContent":[{"text":"The body is exactly the encoder’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},{"text":" for the request’s records, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first. The format is the encoder’s; events need no ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A response with a 2xx status means the batch arrived."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A request the transport can never send ("},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","type":"reference","isActive":true},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"malformed or unsupported URL, or an "},{"code":"http","type":"codeVoice"},{"type":"text","text":" URL App Transport Security refuses) isn’t sent"},{"type":"text","text":" "},{"type":"text","text":"again."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"No response, a 5xx status, 408 Request Timeout or 429 Too Many Requests means it didn’t","type":"text"},{"text":" ","type":"text"},{"text":"arrive yet: the same request is sent again after the backoff’s next wait, for as long as it","type":"text"},{"text":" ","type":"text"},{"text":"takes. A ","type":"text"},{"code":"Retry-After","type":"codeVoice"},{"text":" field is not read; the backoff alone sets the wait.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Any other status means the endpoint won’t take the request, and it isn’t sent again. The","type":"text"},{"text":" ","type":"text"},{"text":"batch’s later requests are still sent.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A request with a deadline ("},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","isActive":true},{"type":"text","text":") is sent only while the destination’s"},{"type":"text","text":" "},{"type":"text","text":"wall clock reads that time or earlier, checked before every attempt, the first included, and"},{"type":"text","text":" "},{"type":"text","text":"again when an attempt fails. One still undelivered once it has passed isn’t sent again, and"},{"type":"text","text":" "},{"type":"text","text":"is reported without waiting out a backoff, so a vendor that would misdate or ignore records"},{"type":"text","text":" "},{"type":"text","text":"that old never receives them. The whole request is dropped, its younger records too; the"},{"type":"text","text":" "},{"type":"text","text":"batch’s later requests are still sent."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A record can arrive twice: a request the server took whose response was lost is sent","type":"text"},{"text":" ","type":"text"},{"text":"again, and a record a store redelivers after the app was stopped mid-send","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"text":") may have arrived before. Its ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":" is the one it was","type":"text"},{"text":" ","type":"text"},{"text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one","type":"text"},{"text":" ","type":"text"},{"text":"copy.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A batch of several requests is acknowledged only once every request is delivered or dropped."},{"type":"text","text":" "},{"type":"text","text":"A delivery cancelled, or an app stopped, after some of its requests arrived hands the whole"},{"type":"text","text":" "},{"type":"text","text":"batch over again, so those requests are sent again too: a server that keeps one copy per"},{"type":"text","text":" "},{"type":"text","text":"record identifier absorbs them. The records the encoder leaves out are then reported again."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true},{"type":"text","text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so"},{"type":"text","text":" "},{"type":"text","text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being"},{"type":"text","text":" "},{"type":"text","text":"retried when the app ends is delivered again on the next launch. A request the endpoint"},{"type":"text","text":" "},{"type":"text","text":"rejects, that can’t be sent or that passed its deadline, a batch the encoder can’t encode, and"},{"type":"text","text":" "},{"type":"text","text":"a record the encoder leaves out of its requests are dropped: logged at error level and"},{"type":"text","text":" "},{"type":"text","text":"reported on "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true},{"type":"text","text":". Each failed attempt that will be retried is logged at notice"},{"type":"text","text":" "},{"type":"text","text":"level."},{"type":"text","text":" "},{"type":"text","text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true},{"type":"text","text":" returns without logging or reporting it, or sending the batch’s later"},{"type":"text","text":" "},{"type":"text","text":"requests. A request whose wait before the next attempt throws something other than"},{"type":"text","text":" "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" (a custom clock’s failure) is given up on, logged at error level but not"},{"type":"text","text":" "},{"type":"text","text":"reported, and the batch’s next request is sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,"},{"type":"text","text":" "},{"type":"text","text":"which drops its oldest batch when full and reports it on the delivery’s "},{"type":"codeVoice","code":"bufferDropReports"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"With a store, a dropped batch’s records aren’t lost: once this destination has caught up, the"},{"type":"text","text":" "},{"type":"text","text":"delivery reads them back from the store and hands them to it again, in the same run, so they"},{"type":"text","text":" "},{"type":"text","text":"are sent once the endpoint answers."},{"type":"text","text":" "},{"type":"text","text":"Without a store, the records of a dropped batch are lost."}]},{"type":"codeListing","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"],"syntax":"swift"}],"kind":"content"}],"kind":"symbol","topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:now:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:now:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"],"generated":true}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/dropReports":{"abstract":[{"text":"A report of each batch dropped without being delivered, in the order they are dropped.","type":"text"}],"url":"\/documentation\/httpdestinations\/httpdestination\/dropreports","role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO","text":"HTTPDropReport","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa","text":"Failure","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"kind":"symbol","type":"topic","title":"dropReports"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","type":"topic","role":"collection","kind":"symbol","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"url":"\/documentation\/httpdestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/Destination-Implementations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations","abstract":[],"url":"\/documentation\/httpdestinations\/httpdestination\/destin