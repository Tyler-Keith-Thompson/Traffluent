{"sections":[],"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:)"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as one request."}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"title":"HTTPDestination","modules":[{"name":"HTTPDestinations"}],"symbolKind":"struct","role":"symbol","externalID":"s:16HTTPDestinations15HTTPDestinationV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L48","fileName":"HTTPDestination.swift"},"roleHeading":"Structure"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Transport"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Encoding"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","text":"HTTPTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","text":"BatchEncoder"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wire shape, for a server that ingests these batches:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One request per batch, in the order the delivery hands them over, the next sent only once"},{"type":"text","text":" "},{"type":"text","text":"the previous one has a response or has failed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The method is ","type":"text"},{"code":"POST","type":"codeVoice"},{"text":" and the URL is the configured endpoint.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The header fields are the configured ones, then the trace context of the batch’s first","type":"text"},{"text":" ","type":"text"},{"text":"record, then ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":", each replacing fields of the same name before it:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The instrument injects the first (oldest) record’s ","type":"text"},{"code":"EventRecord\/context","type":"codeVoice"},{"text":", so a server","type":"text"},{"text":" ","type":"text"},{"text":"extracting it joins the request, and the events, to the trace the app was in. Its field","type":"text"},{"text":" ","type":"text"},{"text":"names are the instrument’s: ","type":"text"},{"code":"traceparent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"tracestate","type":"codeVoice"},{"text":" for a W3C Trace Context tracer.","type":"text"},{"text":" ","type":"text"},{"text":"A record tracked outside any span, or an instrument that injects nothing (the default","type":"text"},{"text":" ","type":"text"},{"code":"NoOpInstrument","type":"codeVoice"},{"text":" when none is bootstrapped), adds no fields.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Only the first record’s context travels in the header fields, though a batch may hold","type":"text"},{"text":" ","type":"text"},{"text":"records tracked in other traces. A server that needs each record’s context reads it from","type":"text"},{"text":" ","type":"text"},{"text":"the body, where a ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" writes it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" is always the encoder’s "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","isActive":true},{"type":"text","text":", whatever a configured"},{"type":"text","text":" "},{"type":"text","text":"field or the instrument wrote."}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"type":"text","text":"The body is exactly the encoder’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},{"type":"text","text":" for the batch’s records, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. The format is the encoder’s; events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A response with a 2xx status means the batch arrived. Any other status, or no response,"},{"type":"text","text":" "},{"type":"text","text":"means it didn’t; either way the batch is not sent again."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A record can still arrive twice: one a store redelivers after the app was stopped mid-send"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"type":"text","text":") may have arrived before. Its "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" is the one it was"},{"type":"text","text":" "},{"type":"text","text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one"},{"type":"text","text":" "},{"type":"text","text":"copy."}]}]}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","type":"reference"},{"text":" handles its own failures: a batch the encoder can’t encode, a send that gets","type":"text"},{"text":" ","type":"text"},{"text":"no response and a response that isn’t 2xx are each logged at error level and dropped, so","type":"text"},{"text":" ","type":"text"},{"text":"the delivery and its other destinations carry on. A cancelled delivery cancels the send in","type":"text"},{"text":" ","type":"text"},{"text":"flight, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","type":"reference"},{"text":" returns without logging it.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"url":"\/documentation\/httpdestinations\/httpdestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"title":"HTTPDestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as one request."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/init(endpoint:headerFields:instrument:encoder:)":{"url":"\/documentation\/httpdestinations\/httpdestination\/init(endpoint:headerfields:instrument:encoder:)","role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"endpoint"},{"kind":"text","text":": "},{"preciseIdentifier":"s:20FoundationEssentials3URLV","kind":"typeIdentifier","text":"URL"},{"kind":"text","text":", "},{"kind":"externalParam","text":"headerFields"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9HTTPTypes10HTTPFieldsV","kind":"typeIdentifier","t