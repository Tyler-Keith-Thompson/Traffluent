er":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","type":"topic","abstract":[{"text":"Sends ","type":"text"},{"type":"codeVoice","code":"batch"},{"text":" to the endpoint, as the requests its encoder splits it into, one after","type":"text"},{"text":" ","type":"text"},{"text":"another; sends each again after each transient failure, and returns once every one is","type":"text"},{"text":" ","type":"text"},{"text":"delivered or dropped, or the delivery is cancelled.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransportError/invalidRequest(reason:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invalidRequest","kind":"identifier"},{"text":"(","kind":"text"},{"text":"reason","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"The transport can never send the request as it is: its URL is malformed or of a scheme the"},{"type":"text","text":" "},{"type":"text","text":"transport doesn’t support, or the platform refuses it, as App Transport Security refuses"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"http"},{"type":"text","text":" URL."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","type":"topic","kind":"symbol","title":"HTTPTransportError.invalidRequest(reason:)","url":"\/documentation\/httpdestinations\/httptransporterror\/invalidrequest(reason:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"role":"symbol","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"identifier":"doc:\/\/HTTPD