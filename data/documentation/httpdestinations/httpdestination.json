{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP","text":"HTTPTransport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","text":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The wire shape, for a server that ingests these batches:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The requests the encoder splits each batch into ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)"},{"type":"text","text":"), in the"},{"type":"text","text":" "},{"type":"text","text":"order the delivery hands batches over, each request sent only once the previous one is"},{"type":"text","text":" "},{"type":"text","text":"delivered or dropped."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The method is ","type":"text"},{"type":"codeVoice","code":"POST"},{"text":" and the URL is the configured endpoint.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The header fields are the configured ones, then the trace context of the request’s first"},{"type":"text","text":" "},{"type":"text","text":"record, then "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":", each replacing fields of the same name before it:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The instrument injects the first (oldest) record’s "},{"code":"EventRecord\/context","type":"codeVoice"},{"type":"text","text":", so a server"},{"type":"text","text":" "},{"type":"text","text":"extracting it joins the request, and the events, to the trace the app was in. Its field"},{"type":"text","text":" "},{"type":"text","text":"names are the instrument’s: "},{"code":"traceparent","type":"codeVoice"},{"type":"text","text":" and "},{"code":"tracestate","type":"codeVoice"},{"type":"text","text":" for a W3C Trace Context tracer."},{"type":"text","text":" "},{"type":"text","text":"A record tracked outside any span, or an instrument that injects nothing (the default"},{"type":"text","text":" "},{"code":"NoOpInstrument","type":"codeVoice"},{"type":"text","text":" when none is bootstrapped), adds no fields."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the first record’s context travels in the header fields, though a request may hold"},{"type":"text","text":" "},{"type":"text","text":"records tracked in other traces. A server that needs each record’s context reads it from"},{"type":"text","text":" "},{"type":"text","text":"the body, where a "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" writes it."}]}]},{"content":[{"inlineContent":[{"code":"Content-Type","type":"codeVoice"},{"text":" is always the encoder’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType"},{"text":", whatever a configured","type":"text"},{"text":" ","type":"text"},{"text":"field or the instrument wrote.","type":"text"}],"type":"paragraph"}]}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The body is exactly the encoder’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},{"type":"text","text":" for the request’s records, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. The format is the encoder’s; events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A response with a 2xx status means the request arrived, and the encoder reads its body to","type":"text"},{"text":" ","type":"text"},{"text":"say whether the vendor stored it (","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","isActive":true},{"text":"): most vendors answer 2xx","type":"text"},{"text":" ","type":"text"},{"text":"only to what they store, and their encoders count every 2xx as delivered. A vendor that","type":"text"},{"text":" ","type":"text"},{"text":"answers 2xx to a request it stores nothing of, and says so in the body (Mixpanel’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"text":"), has the request dropped and reported","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)","isActive":true},{"text":"), or, for a refusal its vendor","type":"text"},{"text":" ","type":"text"},{"text":"says may pass, sent again as after a 5xx, until the request’s deadline. An encoder should","type":"text"},{"text":" ","type":"text"},{"text":"count a body it can’t read, an empty one included, as delivered, so an answer that changes","type":"text"},{"text":" ","type":"text"},{"text":"shape never makes the destination send the same request again and again; the","type":"text"},{"text":" ","type":"text"},{"text":"DestinationTesting conformance kit checks that it does.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A request the transport can never send ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"malformed or unsupported URL, or an "},{"code":"http","type":"codeVoice"},{"type":"text","text":" URL App Transport Security refuses) isn’t sent"},{"type":"text","text":" "},{"type":"text","text":"again."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No response, a 5xx status, 408 Request Timeout, 429 Too Many Requests, or a status the","type":"text"},{"text":" ","type":"text"},{"text":"encoder lists in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","type":"reference"},{"text":" means it didn’t arrive yet: the same","type":"text"},{"text":" ","type":"text"},{"text":"request is sent again after the backoff’s next wait, for as long as it takes. A","type":"text"},{"text":" ","type":"text"},{"code":"Retry-After","type":"codeVoice"},{"text":" field is not read; the backoff alone sets the wait.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Any other status means the endpoint won’t take the request, and it isn’t sent again. The","type":"text"},{"text":" ","type":"text"},{"text":"batch’s later requests are still sent.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A request with a deadline ("},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","type":"reference","isActive":true},{"type":"text","text":") is sent only while the destination’s"},{"type":"text","text":" "},{"type":"text","text":"wall clock reads that time or earlier, checked before every attempt, the first included, and"},{"type":"text","text":" "},{"type":"text","text":"again when an attempt fails. One still undelivered once it has passed isn’t sent again, and"},{"type":"text","text":" "},{"type":"text","text":"is reported without waiting out a backoff, so a vendor that would misdate or ignore records"},{"type":"text","text":" "},{"type":"text","text":"that old never receives them. The whole request is dropped, its younger records too; the"},{"type":"text","text":" "},{"type":"text","text":"batch’s later requests are still sent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A record can arrive twice: a request the server took whose response was lost is sent"},{"type":"text","text":" "},{"type":"text","text":"again, and a record a store redelivers after the app was stopped mid-send"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"type":"text","text":") may have arrived before. Its "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" is the one it was"},{"type":"text","text":" "},{"type":"text","text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one"},{"type":"text","text":" "},{"type":"text","text":"copy."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A batch of several requests is acknowledged only once every request is delivered or dropped.","type":"text"},{"text":" ","type":"text"},{"text":"A delivery cancelled, or an app stopped, after some of its requests arrived hands the whole","type":"text"},{"text":" ","type":"text"},{"text":"batch over again, so those requests are sent again too: a server that keeps one copy per","type":"text"},{"text":" ","type":"text"},{"text":"record identifier absorbs them. The records the encoder leaves out are then reported again.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},{"type":"text","text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so"},{"type":"text","text":" "},{"type":"text","text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being"},{"type":"text","text":" "},{"type":"text","text":"retried when the app ends is delivered again on the next launch. A request the endpoint"},{"type":"text","text":" "},{"type":"text","text":"rejects, by its status or in a 2xx answer’s body, that can’t be sent or that passed its"},{"type":"text","text":" "},{"type":"text","text":"deadline, a batch the encoder can’t encode, and"},{"type":"text","text":" "},{"type":"text","text":"a record the encoder leaves out of its requests are dropped: logged at error level and"},{"type":"text","text":" "},{"type":"text","text":"reported on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"},{"type":"text","text":". Each failed attempt that will be retried is logged at notice"},{"type":"text","text":" "},{"type":"text","text":"level."},{"type":"text","text":" "},{"type":"text","text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},{"type":"text","text":" returns without logging or reporting it, or sending the batch’s later"},{"type":"text","text":" "},{"type":"text","text":"requests. A request whose wait before the next attempt throws something other than"},{"type":"text","text":" "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" (a custom clock’s failure) is given up on, logged at error level but not"},{"type":"text","text":" "},{"type":"text","text":"reported, and the batch’s next request is sent."}],"type":"paragraph"},{"inlineContent":[{"text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,","type":"text"},{"text":" ","type":"text"},{"text":"which drops its oldest batch when full and reports it on the delivery’s ","type":"text"},{"code":"bufferDropReports","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"With a store, a dropped batch’s records aren’t lost: once this destination has caught up, the","type":"text"},{"text":" ","type":"text"},{"text":"delivery reads them back from the store and hands them to it again, in the same run, so they","type":"text"},{"text":" ","type":"text"},{"text":"are sent once the endpoint answers.","type":"text"},{"text":" ","type":"text"},{"text":"Without a store, the records of a dropped batch are lost.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","modules":[{"name":"HTTPDestinations"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"symbolKind":"struct","title":"HTTPDestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L96","fileName":"HTTPDestination.swift"},"externalID":"s:16HTTPDestinations15HTTPDestinationV"},"abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:randomNumberGenerator:now:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:randomNumberGenerator:now:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"],"title":"Instance Properties"},{"anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"],"title":"Instance Methods"},{"anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"],"title":"Default Implementations"}],"relationshipsSections":[{"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"seeAlsoSections":[{"anchor":"Sending-batches","generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"title":"Sending batches"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},"kind":"symbol","references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/outcome(of:for:)":{"title":"outcome(of:for:)","required":true,"role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder\/outcome(of:for:)","abstract":[{"type":"text","text":"What the successful (2xx) answer "},{"code":"response","type":"codeVoice"},{"type":"text","text":" to "},{"code":"request","type":"codeVoice"},{"type":"text","text":", one of this encoder’s requests,"},{"type":"text","text":" "},{"type":"text","text":"means: whether the vendor stored the request’s records."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","type":"topic","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"HTTPTransportResponse","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EncodedRequest","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV"},{"text":") -> ","kind":"text"},{"text":"ResponseOutcome","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"type":"topic","title":"HTTPDestination","role":"symbol","url":"\/documentation\/httpdestinations\/httpdestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransportError/invalidRequest(reason:)":{"title":"HTTPTransportError.invalidRequest(reason:)","role":"symbol","url":"\/documentation\/httpdestinations\/httptransporterror\/invalidrequest(reason:)","abstract":[{"text":"The transport can never send the request as it is: its URL is malformed or of a scheme the","type":"text"},{"text":" ","type":"text"},{"text":"transport doesn’t support, or the platform refuses it, as App Transport Security refuses","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"http","type":"codeVoice"},{"text":" URL.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","kind":"symbol","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invalidRequest","kind":"identifier"},{"text":"(","kind":"text"},{"text":"reason","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"type":"topic","title":"HTTPDestinations","role":"collection","url":"\/documentation\/httpdestinations","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedRequest/deadline":{"type":"topic","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","url":"\/documentation\/httpdestinations\/encodedrequest\/deadline","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"deadline"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"The latest wall-clock time at which the request may be sent, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when it may be sent"},{"type":"text","text":" "},{"type":"text","text":"at any time."}],"role":"symbol","title":"deadline"},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedBatch/contentType":{"role":"symbol","url":"\/documentation\/httpdestinations\/encodedbatch\/contenttype","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contentType","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"title":"contentType","abstract":[{"text":"The body’s media type, sent as the request’s ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":": ","type":"text"},{"code":"\"application\/json\"","type":"codeVoice"},{"text":", say.","type":"text"}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","kind":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"role":"symbol","title":"BatchEncoder"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/transientStatuses":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientStatuses","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"TransientStatus","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV"},{"text":">","kind":"text"}],"required":true,"url":"\/documentation\/httpdestinations\/batchencoder\/transientstatuses","title":"transientStatuses","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","abstract":[{"type":"text","text":"The failure statuses, beyond 408 Request Timeout, 429 Too Many Requests and every 5xx, that"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"type":"text","text":" sends a request of this encoder again after: "},{"code":"[]","type":"codeVoice"},{"type":"text","text":" for none."}],"kind":"symbol","type":"topic","role":"symbol"},"doc://Destinations/documentation/Destinations/Destination":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"url":"\/documentation\/destinations\/destination","title":"Destination","abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"role":"symbol","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/dropReports":{"title":"dropReports","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"HTTPDropReport","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa"},{"text":">>","kind":"text"}],"url":"\/documentation\/httpdestinations\/httpdestination\/dropreports","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","abstract":[{"type":"text","text":"A report of each batch dropped without being delivered, in the order they are dropped."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDropReport"}],"url":"\/documentation\/httpdestinations\/httpdropreport","title":"HTTPDropReport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","navigatorTitle":[{"kind":"identifier","text":"HTTPDropReport"}],"abstract":[{"text":"A batch ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"text":" dropped without delivering it, and why.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/init(endpoint:headerFields:instrument:encoder:backoff:clock:randomNumberGenerator:now:)":{"role":"symbol","url":"\/documentation\/httpdestinations\/httpdestination\/init(endpoint:headerfields:instrument:encoder:back