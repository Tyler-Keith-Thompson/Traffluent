text","text":"Sends "},{"type":"codeVoice","code":"batch"},{"type":"text","text":" to the endpoint as one request, sends it again after each transient"},{"type":"text","text":" "},{"type":"text","text":"failure, and returns once it is delivered, dropped or cancelled."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedBatch/contentType":{"title":"contentType","kind":"symbol","abstract":[{"type":"text","text":"The body’s media type, sent as the request’s "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":": "},{"type":"codeVoice","code":"\"application\/json\""},{"type":"text","text":", say."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","role":"symbol","type":"topic","url":"\/documentation\/httpdestinations\/encodedbatch\/contenttype","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contentType","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}]},"doc://Destinations/documentation/Destinations/Destination":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","url":"\/documentation\/destinations\/destination","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"title":"Destination","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"url":"\/documentation\/httpdestinations\/batchencoder","identifier":"doc:\/\/HTTPDestinations\/documentat