{"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"kind":"symbol","sections":[],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"HTTPTransport","preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BatchEncoder","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wire shape, for a server that ingests these batches:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The requests the encoder splits each batch into ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)"},{"type":"text","text":"), in the"},{"type":"text","text":" "},{"type":"text","text":"order the delivery hands batches over, each request sent only once the previous one is"},{"type":"text","text":" "},{"type":"text","text":"delivered or dropped."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The method is "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" and the URL is the configured endpoint."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The header fields are the configured ones, then the trace context of the request’s first","type":"text"},{"text":" ","type":"text"},{"text":"record, then ","type":"text"},{"type":"codeVoice","code":"Content-Type"},{"text":", each replacing fields of the same name before it:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The instrument injects the first (oldest) record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/context"},{"text":", so a server","type":"text"},{"text":" ","type":"text"},{"text":"extracting it joins the request, and the events, to the trace the app was in. Its field","type":"text"},{"text":" ","type":"text"},{"text":"names are the instrument’s: ","type":"text"},{"type":"codeVoice","code":"traceparent"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"tracestate"},{"text":" for a W3C Trace Context tracer.","type":"text"},{"text":" ","type":"text"},{"text":"A record tracked outside any span, or an instrument that injects nothing (the default","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NoOpInstrument"},{"text":" when none is bootstrapped), adds no fields.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Only the first record’s context travels in the header fields, though a request may hold","type":"text"},{"text":" ","type":"text"},{"text":"records tracked in other traces. A server that needs each record’s context reads it from","type":"text"},{"text":" ","type":"text"},{"text":"the body, where a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" writes it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Content-Type"},{"text":" is always the encoder’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","isActive":true},{"text":", whatever a configured","type":"text"},{"text":" ","type":"text"},{"text":"field or the instrument wrote.","type":"text"}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The body is exactly the encoder’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},{"text":" for the request’s records, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first. The format is the encoder’s; events need no ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A response with a 2xx status means the batch arrived."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A request the transport can never send (","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","type":"reference","isActive":true},{"text":": a","type":"text"},{"text":" ","type":"text"},{"text":"malformed or unsupported URL, or an ","type":"text"},{"type":"codeVoice","code":"http"},{"text":" URL App Transport Security refuses) isn’t sent","type":"text"},{"text":" ","type":"text"},{"text":"again.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No response, a 5xx status, 408 Request Timeout or 429 Too Many Requests means it didn’t","type":"text"},{"text":" ","type":"text"},{"text":"arrive yet: the same request is sent again after the backoff’s next wait, for as long as it","type":"text"},{"text":" ","type":"text"},{"text":"takes. A ","type":"text"},{"code":"Retry-After","type":"codeVoice"},{"text":" field is not read; the backoff alone sets the wait.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Any other status means the endpoint won’t take the request, and it isn’t sent again. The","type":"text"},{"text":" ","type":"text"},{"text":"batch’s later requests are still sent.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A record can arrive twice: a request the server took whose response was lost is sent"},{"type":"text","text":" "},{"type":"text","text":"again, and a record a store redelivers after the app was stopped mid-send"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"type":"text","text":") may have arrived before. Its "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" is the one it was"},{"type":"text","text":" "},{"type":"text","text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one"},{"type":"text","text":" "},{"type":"text","text":"copy."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A batch of several requests is acknowledged only once every request is delivered or dropped."},{"type":"text","text":" "},{"type":"text","text":"A delivery cancelled, or an app stopped, after some of its requests arrived hands the whole"},{"type":"text","text":" "},{"type":"text","text":"batch over again, so those requests are sent again too: a server that keeps one copy per"},{"type":"text","text":" "},{"type":"text","text":"record identifier absorbs them. The records the encoder leaves out are then reported again."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true},{"text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so","type":"text"},{"text":" ","type":"text"},{"text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being","type":"text"},{"text":" ","type":"text"},{"text":"retried when the app ends is delivered again on the next launch. A request the endpoint","type":"text"},{"text":" ","type":"text"},{"text":"rejects or that can’t be sent, a batch the encoder can’t encode, and a record the encoder","type":"text"},{"text":" ","type":"text"},{"text":"leaves out of its requests are dropped: logged at error level and reported on","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true},{"text":". Each failed attempt that will be retried is logged at notice level.","type":"text"},{"text":" ","type":"text"},{"text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true},{"text":" returns without logging or reporting it, or sending the batch’s later","type":"text"},{"text":" ","type":"text"},{"text":"requests. A request whose wait before the next attempt throws something other than","type":"text"},{"text":" ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" (a custom clock’s failure) is given up on, logged at error level but not","type":"text"},{"text":" ","type":"text"},{"text":"reported, and the batch’s next request is sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,"},{"type":"text","text":" "},{"type":"text","text":"which drops its oldest batch when full and reports it on the delivery’s "},{"code":"bufferDropReports","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"With a store, a dropped batch’s records aren’t lost: once this destination has caught up, the"},{"type":"text","text":" "},{"type":"text","text":"delivery reads them back from the store and hands them to it again, in the same run, so they"},{"type":"text","text":" "},{"type":"text","text":"are sent once the endpoint answers."},{"type":"text","text":" "},{"type":"text","text":"Without a store, the records of a dropped batch are lost."}]},{"syntax":"swift","type":"codeListing","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"]}]}],"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"seeAlsoSections":[{"title":"Sending batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"generated":true,"anchor":"Sending-batches"}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:16HTTPDestinations15HTTPDestinationV","modules":[{"name":"HTTPDestinations"}],"role":"symbol","title":"HTTPDestination","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L78","fileName":"HTTPDestination.swift"}},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/requests(for:)":{"required":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)","url":"\/documentation\/httpdestinations\/batchencoder\/requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:16HTTPDestinations12Ba