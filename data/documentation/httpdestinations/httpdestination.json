{"kind":"symbol","abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:now:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:now:)"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"],"anchor":"Instance-Properties","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"],"anchor":"Instance-Methods","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"],"anchor":"Default-Implementations","generated":true}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"HTTPTransport","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BatchEncoder","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP"}],"platforms":["Linux"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"The wire shape, for a server that ingests these batches:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The requests the encoder splits each batch into (","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":"), in the","type":"text"},{"text":" ","type":"text"},{"text":"order the delivery hands batches over, each request sent only once the previous one is","type":"text"},{"text":" ","type":"text"},{"text":"delivered or dropped.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The method is "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" and the URL is the configured endpoint."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The header fields are the configured ones, then the trace context of the request’s first","type":"text"},{"text":" ","type":"text"},{"text":"record, then ","type":"text"},{"type":"codeVoice","code":"Content-Type"},{"text":", each replacing fields of the same name before it:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The instrument injects the first (oldest) record’s "},{"type":"codeVoice","code":"EventRecord\/context"},{"type":"text","text":", so a server"},{"type":"text","text":" "},{"type":"text","text":"extracting it joins the request, and the events, to the trace the app was in. Its field"},{"type":"text","text":" "},{"type":"text","text":"names are the instrument’s: "},{"type":"codeVoice","code":"traceparent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"tracestate"},{"type":"text","text":" for a W3C Trace Context tracer."},{"type":"text","text":" "},{"type":"text","text":"A record tracked outside any span, or an instrument that injects nothing (the default"},{"type":"text","text":" "},{"type":"codeVoice","code":"NoOpInstrument"},{"type":"text","text":" when none is bootstrapped), adds no fields."}]}]},{"content":[{"inlineContent":[{"text":"Only the first record’s context travels in the header fields, though a request may hold","type":"text"},{"text":" ","type":"text"},{"text":"records tracked in other traces. A server that needs each record’s context reads it from","type":"text"},{"text":" ","type":"text"},{"text":"the body, where a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" writes it.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Content-Type"},{"text":" is always the encoder’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType"},{"text":", whatever a configured","type":"text"},{"text":" ","type":"text"},{"text":"field or the instrument wrote.","type":"text"}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is exactly the encoder’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},{"type":"text","text":" for the request’s records, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. The format is the encoder’s; events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A response with a 2xx status means the batch arrived."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A request the transport can never send ("},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","isActive":true},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"malformed or unsupported URL, or an "},{"code":"http","type":"codeVoice"},{"type":"text","text":" URL App Transport Security refuses) isn’t sent"},{"type":"text","text":" "},{"type":"text","text":"again."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"No response, a 5xx status, 408 Request Timeout or 429 Too Many Requests means it didn’t","type":"text"},{"text":" ","type":"text"},{"text":"arrive yet: the same request is sent again after the backoff’s next wait, for as long as it","type":"text"},{"text":" ","type":"text"},{"text":"takes. A ","type":"text"},{"code":"Retry-After","type":"codeVoice"},{"text":" field is not read; the backoff alone sets the wait.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any other status means the endpoint won’t take the request, and it isn’t sent again. The"},{"type":"text","text":" "},{"type":"text","text":"batch’s later requests are still sent."}]}]},{"content":[{"inlineContent":[{"text":"A request with a deadline (","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","isActive":true,"type":"reference"},{"text":") is sent only while the destination’s","type":"text"},{"text":" ","type":"text"},{"text":"wall clock reads that time or earlier, checked before every attempt, the first included, and","type":"text"},{"text":" ","type":"text"},{"text":"again when an attempt fails. One still undelivered once it has passed isn’t sent again, and","type":"text"},{"text":" ","type":"text"},{"text":"is reported without waiting out a backoff, so a vendor that would misdate or ignore records","type":"text"},{"text":" ","type":"text"},{"text":"that old never receives them. The whole request is dropped, its younger records too; the","type":"text"},{"text":" ","type":"text"},{"text":"batch’s later requests are still sent.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A record can arrive twice: a request the server took whose response was lost is sent"},{"type":"text","text":" "},{"type":"text","text":"again, and a record a store redelivers after the app was stopped mid-send"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"type":"text","text":") may have arrived before. Its "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" is the one it was"},{"type":"text","text":" "},{"type":"text","text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one"},{"type":"text","text":" "},{"type":"text","text":"copy."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A batch of several requests is acknowledged only once every request is delivered or dropped.","type":"text"},{"text":" ","type":"text"},{"text":"A delivery cancelled, or an app stopped, after some of its requests arrived hands the whole","type":"text"},{"text":" ","type":"text"},{"text":"batch over again, so those requests are sent again too: a server that keeps one copy per","type":"text"},{"text":" ","type":"text"},{"text":"record identifier absorbs them. The records the encoder leaves out are then reported again.","type":"text"}]}]}]},{"inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","type":"reference","isActive":true},{"type":"text","text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so"},{"type":"text","text":" "},{"type":"text","text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being"},{"type":"text","text":" "},{"type":"text","text":"retried when the app ends is delivered again on the next launch. A request the endpoint"},{"type":"text","text":" "},{"type":"text","text":"rejects, that can’t be sent or that passed its deadline, a batch the encoder can’t encode, and"},{"type":"text","text":" "},{"type":"text","text":"a record the encoder leaves out of its requests are dropped: logged at error level and"},{"type":"text","text":" "},{"type":"text","text":"reported on "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","type":"reference","isActive":true},{"type":"text","text":". Each failed attempt that will be retried is logged at notice"},{"type":"text","text":" "},{"type":"text","text":"level."},{"type":"text","text":" "},{"type":"text","text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","type":"reference","isActive":true},{"type":"text","text":" returns without logging or reporting it, or sending the batch’s later"},{"type":"text","text":" "},{"type":"text","text":"requests. A request whose wait before the next attempt throws something other than"},{"type":"text","text":" "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" (a custom clock’s failure) is given up on, logged at error level but not"},{"type":"text","text":" "},{"type":"text","text":"reported, and the batch’s next request is sent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,"},{"type":"text","text":" "},{"type":"text","text":"which drops its oldest batch when full and reports it on the delivery’s "},{"type":"codeVoice","code":"bufferDropReports"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"With a store, a dropped batch’s records aren’t lost: once this destination has caught up, the"},{"type":"text","text":" "},{"type":"text","text":"delivery reads them back from the store and hands them to it again, in the same run, so they"},{"type":"text","text":" "},{"type":"text","text":"are sent once the endpoint answers."},{"type":"text","text":" "},{"type":"text","text":"Without a store, the records of a dropped batch are lost."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"]}],"kind":"content"}],"metadata":{"symbolKind":"struct","remoteSource":{"fileName":"HTTPDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L85"},"externalID":"s:16HTTPDestinations15HTTPDestinationV","roleHeading":"Structure","title":"HTTPDestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"role":"symbol","modules":[{"name":"HTTPDestinations"}]},"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Sending batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"anchor":"Sending-batches","generated":true}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/receive(_:)":{"url":"\/documentation\/httpdestinations\/httpdestination\/receive(_:)","title":"receive(_:)","abstract":[{"type":"text","text":"Sends "},{"type":"codeVoice","code":"batch"},{"type":"text","text":" to the endpoint, as the requests its encoder splits it into, one after"},{"type":"text","text":" "},{"type":"text","text":"another; sends each again after each transient failure, and returns once every one is"},{"type":"text","text":" "},{"type":"text","text":"delivered or dropped, or the delivery is cancelled."}],"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"receive"},{"kind":"text","text":"(["},{"preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier","text":"EventRecord"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"async"}],"role":"symbol"},"doc://HTTPDestinations/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/HTTPDestinations\/s8SendableP"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/init(endpoint:headerFields:instrument:encoder:backoff:clock:now:)":{"kind":"symbol","title":"init(endpoint:headerFields:instrument:encoder:backoff:clock:now:)","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:now:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"endpoint","kind":"externalParam"},{"text":": ","kind":"text"},{"