{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"metadata":{"role":"symbol","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"modules":[{"name":"HTTPDestinations"}],"roleHeading":"Structure","externalID":"s:16HTTPDestinations15HTTPDestinationV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L48","fileName":"HTTPDestination.swift"},"title":"HTTPDestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}]},"sections":[],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as one request."}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP","text":"HTTPTransport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","text":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wire shape, for a server that ingests these batches:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"One request per batch, in the order the delivery hands them over, the next sent only once","type":"text"},{"text":" ","type":"text"},{"text":"the previous one has a response or has failed.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The method is "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" and the URL is the configured endpoint."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The header fields are the configured ones, then the trace context of the batch’s first"},{"type":"text","text":" "},{"type":"text","text":"record, then "},{"code":"Content-Type","type":"codeVoice"},{"type":"text","text":", each replacing fields of the same name before it:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The instrument injects the first (oldest) record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/context"},{"text":", so a server","type":"text"},{"text":" ","type":"text"},{"text":"extracting it joins the request, and the events, to the trace the app was in. Its field","type":"text"},{"text":" ","type":"text"},{"text":"names are the instrument’s: ","type":"text"},{"type":"codeVoice","code":"traceparent"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"tracestate"},{"text":" for a W3C Trace Context tracer.","type":"text"},{"text":" ","type":"text"},{"text":"A record tracked outside any span, or an instrument that injects nothing (the default","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NoOpInstrument"},{"text":" when none is bootstrapped), adds no fields.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the first record’s context travels in the header fields, though a batch may hold"},{"type":"text","text":" "},{"type":"text","text":"records tracked in other traces. A server that needs each record’s context reads it from"},{"type":"text","text":" "},{"type":"text","text":"the body, where a "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" writes it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" is always the encoder’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType"},{"type":"text","text":", whatever a configured"},{"type":"text","text":" "},{"type":"text","text":"field or the instrument wrote."}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The body is exactly the encoder’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},{"text":" for the batch’s records, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first. The format is the encoder’s; events need no ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" conformance.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A response with a 2xx status means the batch arrived. Any other status, or no response,","type":"text"},{"text":" ","type":"text"},{"text":"means it didn’t; either way the batch is not sent again.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A record can still arrive twice: one a store redelivers after the app was stopped mid-send"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"type":"text","text":") may have arrived before. Its "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" is the one it was"},{"type":"text","text":" "},{"type":"text","text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one"},{"type":"text","text":" "},{"type":"text","text":"copy."}]}]}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","type":"reference","isActive":true},{"type":"text","text":" handles its own failures: a batch the encoder can’t encode, a send that gets"},{"type":"text","text":" "},{"type":"text","text":"no response and a response that isn’t 2xx are each logged at error level and dropped, so"},{"type":"text","text":" "},{"type":"text","text":"the delivery and its other destinations carry on. A cancelled delivery cancels the send in"},{"type":"text","text":" "},{"type":"text","text":"flight, and "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","type":"reference","isActive":true},{"type":"text","text":" returns without logging it."}]},{"type":"codeListing","syntax":"swift","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFiel