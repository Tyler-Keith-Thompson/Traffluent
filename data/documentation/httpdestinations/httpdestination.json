{"seeAlsoSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"generated":true,"title":"Sending batches","anchor":"Sending-batches"}],"kind":"symbol","metadata":{"navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"modules":[{"name":"HTTPDestinations"}],"roleHeading":"Structure","remoteSource":{"fileName":"HTTPDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L67"},"symbolKind":"struct","role":"symbol","title":"HTTPDestination","externalID":"s:16HTTPDestinations15HTTPDestinationV"},"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as one request, and","type":"text"},{"text":" ","type":"text"},{"text":"sends it again until it arrives.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"relationshipsSections":[{"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"HTTPTransport","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BatchEncoder","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wire shape, for a server that ingests these batches:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"One request per batch, in the order the delivery hands them over, the next batch sent only","type":"text"},{"text":" ","type":"text"},{"text":"once the previous one is delivered or dropped.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The method is ","type":"text"},{"type":"codeVoice","code":"POST"},{"text":" and the URL is the configured endpoint.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The header fields are the configured ones, then the trace context of the batch’s first","type":"text"},{"text":" ","type":"text"},{"text":"record, then ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":", each replacing fields of the same name before it:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The instrument injects the first (oldest) record’s "},{"code":"EventRecord\/context","type":"codeVoice"},{"type":"text","text":", so a server"},{"type":"text","text":" "},{"type":"text","text":"extracting it joins the request, and the events, to the trace the app was in. Its field"},{"type":"text","text":" "},{"type":"text","text":"names are the instrument’s: "},{"code":"traceparent","type":"codeVoice"},{"type":"text","text":" and "},{"code":"tracestate","type":"codeVoice"},{"type":"text","text":" for a W3C Trace Context tracer."},{"type":"text","text":" "},{"type":"text","text":"A record tracked outside any span, or an instrument that injects nothing (the default"},{"type":"text","text":" "},{"code":"NoOpInstrument","type":"codeVoice"},{"type":"text","text":" when none is bootstrapped), adds no fields."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the first record’s context travels in the header fields, though a batch may hold"},{"type":"text","text":" "},{"type":"text","text":"records tracked in other traces. A server that needs each record’s context reads it from"},{"type":"text","text":" "},{"type":"text","text":"the body, where a "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" writes it."}]}]},{"content":[{"inlineContent":[{"code":"Content-Type","type":"codeVoice"},{"text":" is always the encoder’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","type":"reference"},{"text":", whatever a configured","type":"text"},{"text":" ","type":"text"},{"text":"field or the instrument wrote.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is exactly the encoder’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},{"type":"text","text":" for the batch’s records, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. The format is the encoder’s; events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A response with a 2xx status means the batch arrived."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A request the transport can never send ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"malformed or unsupported URL, or an "},{"type":"codeVoice","code":"http"},{"type":"text","text":" URL App Transport Security refuses) isn’t sent"},{"type":"text","text":" "},{"type":"text","text":"again."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"No response, a 5xx status, 408 Request Timeout or 429 Too Many Requests means it didn’t"},{"type":"text","text":" "},{"type":"text","text":"arrive yet: the same request is sent again after the backoff’s next wait, for as long as it"},{"type":"text","text":" "},{"type":"text","text":"takes. A "},{"type":"codeVoice","code":"Retry-After"},{"type":"text","text":" field is not read; the backoff alone sets the wait."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Any other status means the endpoint won’t take the batch, and it isn’t sent again.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A record can arrive twice: a request the server took whose response was lost is sent","type":"text"},{"text":" ","type":"text"},{"text":"again, and a record a store redelivers after the app was stopped mid-send","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"EventRecord\/isRedelivered","type":"codeVoice"},{"text":") may have arrived before. Its ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" is the one it was","type":"text"},{"text":" ","type":"text"},{"text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one","type":"text"},{"text":" ","type":"text"},{"text":"copy.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true},{"type":"text","text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so"},{"type":"text","text":" "},{"type":"text","text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being"},{"type":"text","text":" "},{"type":"text","text":"retried when the app ends is delivered again on the next launch. A batch the endpoint rejects,"},{"type":"text","text":" "},{"type":"text","text":"whose request can’t be sent, or that the encoder can’t encode is dropped: logged at error"},{"type":"text","text":" "},{"type":"text","text":"level and reported on "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true},{"type":"text","text":". Each failed attempt that will be retried is logged at notice level."},{"type":"text","text":" "},{"type":"text","text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true},{"type":"text","text":" returns without logging or reporting it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,"},{"type":"text","text":" "},{"type":"text","text":"which drops its oldest batch when full and reports it"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"deliver(to:batchBufferLimit:bufferDropReporter:)"},{"type":"text","text":"). With a store, a dropped batch’s records"},{"type":"text","text":" "},{"type":"text","text":"aren’t lost: once this destination has caught up, the delivery reads them back from the store"},{"type":"text","text":" "},{"type":"text","text":"and hands them to it again, in the same run, so they are sent once the endpoint answers."},{"type":"text","text":" "},{"type":"text","text":"Without a store, the records of a dropped batch are lost."}]},{"code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations\/httpdestination"]}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","interfaceLanguage":"swift"},"sections":[],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransport":{"type":"topic","abstract":[{"type":"text","text":"What sends an HTTP request and returns the server’s response: the seam between"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" and the network."}],"title":"HTTPTransport","kind":"symbol","url":"\/documentation\/httpdestinations\/httptransport","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPTransport"}],"navigatorTitle":[{"kind":"identifier","text":"HTTPTransport"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","role":"symbol"},"doc://Destinations/documentation/Destinations/Destination":{"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"url":"\/documentation\/destinations\/destination","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"title":"Destination","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as one request, and","type":"text"},{"text":" ","type":"text"},{"text":"sends it again until it arrives.","type":"text"}],"type":"topic","url":"\/documentation\/httpdestinations\/httpdestination","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","title":"HTTPDestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}]},"doc://HTTPDestinations/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/HTTPDestinations\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/receive(_:)":{"