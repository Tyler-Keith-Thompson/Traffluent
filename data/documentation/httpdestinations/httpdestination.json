{"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as one request, and","type":"text"},{"text":" ","type":"text"},{"text":"sends it again until it arrives.","type":"text"}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"title":"HTTPDestination","role":"symbol","externalID":"s:16HTTPDestinations15HTTPDestinationV","symbolKind":"struct","modules":[{"name":"HTTPDestinations"}],"remoteSource":{"fileName":"HTTPDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L67"},"roleHeading":"Structure","navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}]},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo"}],"variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP","text":"HTTPTransport","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport"},{"text":", ","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","text":"BatchEncoder","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The wire shape, for a server that ingests these batches:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One request per batch, in the order the delivery hands them over, the next batch sent only"},{"type":"text","text":" "},{"type":"text","text":"once the previous one is delivered or dropped."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The method is "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" and the URL is the configured endpoint."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The header fields are the configured ones, then the trace context of the batch’s first","type":"text"},{"text":" ","type":"text"},{"text":"record, then ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":", each replacing fields of the same name before it:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The instrument injects the first (oldest) record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/context"},{"text":", so a server","type":"text"},{"text":" ","type":"text"},{"text":"extracting it joins the request, and the events, to the trace the app was in. Its field","type":"text"},{"text":" ","type":"text"},{"text":"names are the instrument’s: ","type":"text"},{"type":"codeVoice","code":"traceparent"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"tracestate"},{"text":" for a W3C Trace Context tracer.","type":"text"},{"text":" ","type":"text"},{"text":"A record tracked outside any span, or an instrument that injects nothing (the default","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NoOpInstrument"},{"text":" when none is bootstrapped), adds no fields.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Only the first record’s context travels in the header fields, though a batch may hold"},{"type":"text","text":" "},{"type":"text","text":"records tracked in other traces. A server that needs each record’s context reads it from"},{"type":"text","text":" "},{"type":"text","text":"the body, where a "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"type":"text","text":" writes it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Content-Type"},{"text":" is always the encoder’s ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","isActive":true,"type":"reference"},{"text":", whatever a configured","type":"text"},{"text":" ","type":"text"},{"text":"field or the instrument wrote.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"type":"text","text":"The body is exactly the encoder’s "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body","isActive":true,"type":"reference"},{"type":"text","text":" for the batch’s records, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. The format is the encoder’s; events need no "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A response with a 2xx status means the batch arrived."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A request the transport can never send (","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","isActive":true,"type":"reference"},{"text":": a","type":"text"},{"text":" ","type":"text"},{"text":"malformed or unsupported URL, or an ","type":"text"},{"code":"http","type":"codeVoice"},{"text":" URL App Transport Security refuses) isn’t sent","type":"text"},{"text":" ","type":"text"},{"text":"again.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No response, a 5xx status, 408 Request Timeout or 429 Too Many Requests means it didn’t","type":"text"},{"text":" ","type":"text"},{"text":"arrive yet: the same request is sent again after the backoff’s next wait, for as long as it","type":"text"},{"text":" ","type":"text"},{"text":"takes. A ","type":"text"},{"code":"Retry-After","type":"codeVoice"},{"text":" field is not read; the backoff alone sets the wait.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any other status means the endpoint won’t take the batch, and it isn’t sent again."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A record can arrive twice: a request the server took whose response was lost is sent"},{"type":"text","text":" "},{"type":"text","text":"again, and a record a store redelivers after the app was stopped mid-send"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"type":"text","text":") may have arrived before. Its "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" is the one it was"},{"type":"text","text":" "},{"type":"text","text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one"},{"type":"text","text":" "},{"type":"text","text":"copy."}]}]}],"type":"unorderedList"},{"inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true,"type":"reference"},{"text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so","type":"text"},{"text":" ","type":"text"},{"text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being","type":"text"},{"text":" ","type":"text"},{"text":"retried when the app ends is delivered again on the next launch. A batch the endpoint rejects,","type":"text"},{"text":" ","type":"text"},{"text":"whose request can’t be sent, or that the encoder can’t encode is dropped: logged at error","type":"text"},{"text":" ","type":"text"},{"text":"level and reported on ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true,"type":"reference"},{"text":". Each failed attempt that will be retried is logged at notice level.","type":"text"},{"text":" ","type":"text"},{"text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","isActive":true,"type":"reference"},{"text":" returns without logging or reporting it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,"},{"type":"text","text":" "},{"type":"text","text":"which drops its oldest batch when full and reports it"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"deliver(to:batchBufferLimit:bufferDropReporter:)"},{"type":"text","text":"). With a store, a dropped batch’s records"},{"type":"text","text":" "},{"type":"text","text":"aren’t lost: once this destination has caught up, the delivery reads them back from the store"},{"type":"text","text":" "},{"type":"text","text":"and hands them to it again, in the same run, so they are sent once the endpoint answers."},{"type":"text","text":" "},{"type":"text","text":"Without a store, the records of a dropped batch are lost."}],"type":"paragraph"},{"syntax":"swift","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"],"type":"codeListing"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransportError/invalidRequest(reason:)":{"type":"topic","abstract":[{"text":"The transport can never send the request as it is: its URL is malformed or of a scheme the","type":"text"},{"text":" ","type":"text"},{"text":"transport doesn’t support, or the platform refuses it, as App Transport Security refuses","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"http","type":"codeVoice"},{"text":" URL.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"invalidRequest"},{"kind":"text","text":"("},{"kind":"externalParam","text":"reason"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}],"title":"HTTPTransportError.invalidRequest(reason:)","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","url":"\/documentation\/httpdestinations\/httptransporterror\/invalidrequest(reason:)","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/init(endpoint:headerFields:instrument:encoder:backoff:clock:)":{"url":"\/documentation\/httpdestinations\/httpdestination\/init(endpoint:headerfields:instrument:encoder:backoff:clock:)","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:)","abstract":[{"text":"A destination that sends batches to ","type":"text"},{"code":"endpoint","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"URLSession.shared","type":"codeVoice"},{"text":", encoded by","type":"text"},{"text":" ","type":"text"},{"code":"encoder","type":"codeVoice"},{"text":", retrying a send that fails for now with the waits of ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"endpoint"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"URL","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"headerFields"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"HTTPFields","preciseIdentifier":"s:9HTTPTypes10HTT