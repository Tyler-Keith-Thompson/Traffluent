":"http","type":"codeVoice"},{"text":" URL.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","type":"topic","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invalidRequest","kind":"identifier"},{"text":"(","kind":"text"},{"text":"reason","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/httpdestinations\/httptransporterror\/invalidrequest(reason:)","role":"symbol"},"doc://HTTPDestinations/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/HTTPDestinations\/s16SendableMetatypeP","type":"unresolvable"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/receive(_:)":{"abstract":[{"type":"text","text":"Sends "},{"type":"codeVoice","code":"batch"},{"type":"text","text":" to the endpoint as one request, sends it again after each transient"},{"type":"text","text":" "},{"type":"text","text":"failure, and returns once it is delivered, dropped or cancelled."}],"title":"receive(_:)","url":"\/documentation\/httpdestinations\/httpdestination\/receive(_:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"receive","kind":"identifier"},{"text":"([","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"}],"type":"topic","role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},"doc://Destinations/documentation/Destinations/Destination":{"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"url":"\/documentation\/destinations\/destination","title":"Destination","kind":"symbol","fragments":[{"text"