{"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/init(initialDelay:maximumDelay:jitter:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/init(jitter:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/initialDelay","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/jitter-swift.property","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/maximumDelay"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/delay(beforeRetry:)"]},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Equatable-Implementations"]}],"abstract":[{"text":"How long ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" waits before each new attempt at a batch that wasn’t delivered:","type":"text"},{"text":" ","type":"text"},{"text":"binary exponential backoff, each nominal wait twice the one before, up to a maximum, with","type":"text"},{"text":" ","type":"text"},{"text":"jitter.","type":"text"}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Waiting between attempts","generated":true,"anchor":"Waiting-between-attempts","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/SQ","doc:\/\/HTTPDestinations\/SH","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExponentialBackoff","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"codeVoice","code":"ExponentialBackoff()"},{"text":" has nominal waits of 1, 2, 4, 8, 16 and 32 seconds, then 60 seconds for","type":"text"},{"text":" ","type":"text"},{"text":"every retry after that, with full jitter, as this one does:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let backoff = try ExponentialBackoff(initialDelay: .seconds(1), maximumDelay: .seconds(60), jitter: .full)"]},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/delay(beforeRetry:)","isActive":true},{"type":"text","text":" is the nominal wait. What "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sleeps before each retry"},{"type":"text","text":" "},{"type":"text","text":"depends on the backoff’s jitter:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/full"},{"type":"text","text":", the default: a random wait, at least zero and less than the nominal one,"},{"type":"text","text":" "},{"type":"text","text":"drawn afresh before each retry from the destination’s random number generator."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/none"},{"text":": the nominal wait. It is exact when both delays count their attoseconds in","type":"text"},{"text":" ","type":"text"},{"text":"53 significant bits or fewer, as any whole number of milliseconds under 295 seconds does;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise it is within about one part in 2⁵³ of it.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Jitter is on by default because apps tend to be refused all at once. A rate limiter’s window,"},{"type":"text","text":" "},{"type":"text","text":"or an outage ending, refuses many apps at the same moment. Without jitter they would all retry"},{"type":"text","text":" "},{"type":"text","text":"at the same moments too, and each wave would be refused like the one before. Full jitter"},{"type":"text","text":" "},{"type":"text","text":"spreads each wave over the whole wait. It also halves the average wait, so an app retries"},{"type":"text","text":" "},{"type":"text","text":"about twice as often during a long outage."}],"type":"paragraph"}]}],"metadata":{"externalID":"s:16HTTPDestinations18ExponentialBackoffV","symbolKind":"struct","title":"ExponentialBackoff","modules":[{"name":"HTTPDestinations"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExponentialBackoff","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"ExponentialBackoff"}],"role":"symbol","roleHeading":"Structure","remoteSource":{"fileName":"ExponentialBackoff.swift","url":"https:\/\/github.com\/Tyler-Ke