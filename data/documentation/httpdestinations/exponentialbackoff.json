itle":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/initialDelay","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/jitter-swift.property","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/maximumDelay"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/delay(beforeRetry:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum"],"title":"Enumerations","anchor":"Enumerations","generated":true},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Equatable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/SQ","doc:\/\/HTTPDestinations\/SH","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExponentialBackoff"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"inlineContent":[{"code":"ExponentialBackoff()","type":"codeVoice"},{"text":" has nominal waits of 1, 2, 4, 8, 16 and 32 seconds, then 60 seconds for","type":"text"},{"text":" ","type":"text"},{"text":"every retry after that, with full jitter, as this one does:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let backoff = try ExponentialBackoff(initialDelay: .seconds(1), maximumDelay: .seconds(60), jitter: .full)"]},{"inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/delay(beforeRetry:)","type":"reference","isActive":true},{"type":"text","text":" is the nominal wait. What "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"type":"text","text":" sleeps before each retry"},{"type":"text","text":" "},{"type":"text","text":"depends on the backoff’s jitter:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/full","isActive":true},{"type":"text","text":", the default: a random wait, at least zero and less than the nominal one,"},{"type":"text","text":" "},{"type":"text","text":"drawn afresh before each retry from the destination’s random number generator."}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/none"},{"text":": the nominal wait. It is exact when both delays count their attoseconds in","type":"text"},{"text":" ","type":"text"},{"text":"53 significant bits or fewer, as any whole number of milliseconds under 295 seconds does;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise it is within about one part in 2⁵³ of it.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Jitter is on by default because apps tend to be refused all at once. A rate limiter’s window,"},{"type":"text","text":" "},{"type":"text","text":"or an outage ending, refuses many apps at the same moment. Without jitter they would all retry"},{"type":"text","text":" "},{"type":"text","text":"at the same moments too, and each wave would be refused like the one before. Full jitter"},{"type":"text","text":" "},{"type":"text","text":"spreads each wave over the whole wait. It also halves the average wait, so an app retries"},{"type":"text","text":" "},{"type":"text","text":"about twice as often during a long outage."}],"type":"paragraph"}]}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff/Jitter-swift.enum/none":{"title":"ExponentialBackoff.Jitter.none","kind":"symbol","url":"\/documentation\/httpdestinations\/exponentialbackoff\/jitter-swift.enum\/none","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/none","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"none","kind":"identifier"}],"abstract":[{"type":"text","text":"The nominal wait, exactly."}],"role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff/jitter-swift.property":{"type":"topic","url":"\/documentation\/httpdestinations\/exponentialbackoff\/jitter-swift.property","title":"jitter","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"jitter","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":".","kind":"text"},{"text":"Jitter","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV6JitterO"}],"role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/jitter-swift.property","abstract":[{"type":"text","text":"How each nominal wait is randomized."}]},"doc://HTTPDestinations/SH":{"type":"unresolvable","identifier":"doc:\/\/HTTPDestinations\/SH","title":"Swift.Hashable"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDesti