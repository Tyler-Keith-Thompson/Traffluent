{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExponentialBackoff"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"With the defaults, the waits are 1, 2, 4, 8, 16 and 32 seconds, then 60 seconds for every"},{"type":"text","text":" "},{"type":"text","text":"retry after that:"}]},{"syntax":"swift","type":"codeListing","code":["let backoff = ExponentialBackoff(initialDelay: .seconds(1), maximumDelay: .seconds(60))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The waits have no jitter. Each device starts retrying when its own send fails, and its sends"},{"type":"text","text":" "},{"type":"text","text":"come at moments set by its own batches, so devices don’t retry in step; a fixed schedule also"},{"type":"text","text":" "},{"type":"text","text":"keeps the waits the same from one run to the next."}]}]}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/init(checkedInitialDelay:maximumDelay:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/init(initialDelay:maximumDelay:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/initialDelay","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/