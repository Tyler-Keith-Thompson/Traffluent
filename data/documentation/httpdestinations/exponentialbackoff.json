{"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"],"generated":true,"anchor":"Waiting-between-attempts","title":"Waiting between attempts"}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExponentialBackoff","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ExponentialBackoff()"},{"text":" has nominal waits of 1, 2, 4, 8, 16 and 32 seconds, then 60 seconds for","type":"text"},{"text":" ","type":"text"},{"text":"every retry after that, with full jitter, as this one does:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let backoff = try ExponentialBackoff(initialDelay: .seconds(1), maximumDelay: .seconds(60), jitter: .full)"]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/delay(beforeRetry:)","isActive":true},{"type":"text","text":" is the nominal wait. What "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sleeps before each retry"},{"type":"text","text":" "},{"type":"text","text":"depends on the backoff’s jitter:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/full","isActive":true},{"type":"text","text":", the default: a random wait, at least zero and less than the nominal one,"},{"type":"text","text":" "},{"type":"text","text":"drawn afresh before each retry from the destination’s random number generator."}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/none","type":"reference","isActive":true},{"text":": the nominal wait. It is exact when both delays count their attoseconds in","type":"text"},{"text":" ","type":"text"},{"text":"53 significant bits or fewer, as any whole number of milliseconds under 295 seconds does;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise it is within about one part in 2⁵³ of it.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Jitter is on by default because apps tend to be refused all at once. A rate limiter’s window,"},{"type":"text","text":" "},{"type":"text","text":"or an outage ending, refuses many apps at the same moment. Without jitter they would all retry"},{"type":"text","text":" "},{"type":"text","text":"at the same moments too, and each wave would be refused like the one before. Full jitter"},{"type":"text","text":" "},{"type":"text","text":"spreads each wave over the whole wait. It also halves the average wait, so an app retries"},{"type":"text","text":" "},{"type":"text","text":"about twice as often during a long outage."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"type":"text","text":"How long "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" waits before each new attempt at a batch that wasn’t delivered:"},{"type":"text","text":" "},{"type":"text","text":"binary exponential backoff, each nominal wait twice the one before, up to a maximum, with"},{"type":"text","text":" "},{"type":"text","text":"jitter."}],"topicSections":[{"identifiers":["