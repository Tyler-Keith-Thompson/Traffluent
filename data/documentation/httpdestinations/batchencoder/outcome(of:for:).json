erence","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)"},{"type":"text","text":" "},{"type":"text","text":"unless the vendor documents that the answer passes."}]},{"type":"paragraph","inlineContent":[{"text":"A vendor fact, as ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","isActive":true,"type":"reference"},{"text":" is, so it is static, with no default: a conformer","type":"text"},{"text":" ","type":"text"},{"text":"that leaves it out, or misspells it, doesn’t compile, rather than silently counting a","type":"text"},{"text":" ","type":"text"},{"text":"refused request as delivered.","type":"text"}]}],"kind":"content"}],"metadata":{"symbolKind":"method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","text":"HTTPTransportResponse","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","text":"EncodedRequest","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","text":"ResponseOutcome","kind":"typeIdentifier"}],"roleHeading":"Type Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/BatchEncoder.swift#L101","fileName":"BatchEncoder.swift"},"role":"symbol","title":"outcome(of:for:)","externalID":"s:16HTTPDestinations12BatchEncoderP7outcome2of3forAA15ResponseOutcomeOAA013HTTPTransportG0V_AA14EncodedRequestVtFZ","required":true,"modules":[{"name":"HTTPDestinations"}]},"references