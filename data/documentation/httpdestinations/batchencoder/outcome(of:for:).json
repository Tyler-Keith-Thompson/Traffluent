{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)"},"sections":[],"variants":[{"paths":["\/documentation\/httpdestinations\/batchencoder\/outcome(of:for:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"]]},"abstract":[{"text":"What the successful (2xx) answer ","type":"text"},{"code":"response","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"request","type":"codeVoice"},{"text":", one of this encoder’s requests,","type":"text"},{"text":" ","type":"text"},{"text":"means: whether the vendor stored the request’s records.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"response","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"HTTPTransportResponse","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"request","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"EncodedRequest","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest"},{"text":") -> ","kind":"text"},{"text":"ResponseOutcome","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15ResponseOutco