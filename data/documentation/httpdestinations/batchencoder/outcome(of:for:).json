{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"What the successful (2xx) answer ","type":"text"},{"code":"response","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"request","type":"codeVoice"},{"text":", one of this encoder’s requests,","type":"text"},{"text":" ","type":"text"},{"text":"means: whether the vendor stored the request’s records.","type":"text"}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/httpdestinations\/batchencoder\/outcome(of:for:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"response","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","text":"HTTPTransportResponse","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"request","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","text":"EncodedRequest","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","text":"ResponseOutcome","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome"}]}],"kind":"declarations"},{"parameters":[{"name":"response","content":[{"inlineContent":[{"text":"The answer: a 2xx status, its header fields and its body.","type":"text"}],"type":"paragraph"}]},{"name":"request","content":[{"type":"paragraph","inlineContent":[{"text":"The request it answers, as the encoder made it.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"Whether the request’s records were delivered, refused for good, or refused for","type":"text"},{"text":" ","type":"text"},{"text":"now.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" calls it for every 2xx answer, and only for those, with the answer’s"},{"type":"text","text":" "},{"type":"text","text":"status, header fields and body, and the request it answers, for a vendor whose answer is"},{"type":"text","text":" "},{"type":"text","text":"read against what was sent (a count of the records it took, say). An encoder for a vendor that stores what it answers 2xx to"},{"type":"text","text":" "},{"type":"text","text":"returns "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/delivered"},{"type":"text","text":". One for a vendor that answers 2xx to a request it"},{"type":"text","text":" "},{"type":"text","text":"stores nothing of, and says so in the body (Mixpanel’s "},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"returns "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)"},{"type":"text","text":", which drops and reports the request, or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)"},{"type":"text","text":", which sends it again. A body the vendor doesn’t"},{"type":"text","text":" "},{"type":"text","text":"document, an empty one or one that doesn’t parse included, is"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/delivered"},{"type":"text","text":": the request did arrive, and sending it again after an"},{"type":"text","text":" "},{"type":"text","text":"answer the encoder can’t read would repeat it for as long as the vendor keeps answering"},{"type":"text","text":" "},{"type":"text","text":"that way. The conformance kit’s "},{"type":"codeVoice","code":"unreadableSuccessDelivered"},{"type":"text","text":" check holds an encoder to"},{"type":"text","text":" "},{"type":"text","text":"this. An encoder that wraps another forwards the wrapped encoder’s outcome."}],"type":"paragraph"},{"inlineContent":[{"text":"A transient outcome is sent again until it is delivered, rejected, or past the request’s","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","isActive":true,"type":"reference"},{"text":". A request with no deadline is sent again for as long as the","type":"text"},{"text":" ","type":"text"},{"text":"vendor keeps answering that way, so an encoder whose requests have none returns","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)","isActive":true,"type":"reference"},{"text":" rather than ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"unless the vendor documents that the answer passes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A vendor fact, as ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","type":"reference","isActive":true},{"text":" is, so it is static, with no default: a conformer","type":"text"},{"text":" ","type":"text"},{"text":"that leaves it out, or misspells it, doesn’t compile, rather than silently counting a","type":"text"},{"text":" ","type":"text"},{"text":"refused request as delivered.","type":"text"}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"]]},"metadata":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO"}],"symbolKind":"method","title":"outcome(of:for:)","roleHeading":"Type Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/BatchEncoder.swift#L101","fileName":"BatchEncoder.swift"},"externalID":"s:16HTTPDestinations12BatchEncoderP7outcome2of3forAA15ResponseOutcomeOAA013HTTPTransportG0V_AA14EncodedRequestVtFZ","role":"symbol","required":true,"modules":[{"name":"HTTPDestinations"}]},"references