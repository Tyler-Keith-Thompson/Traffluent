{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"This walkthrough builds the analytics of a small store app, one step at a time. The code comes","type":"text"},{"text":" ","type":"text"},{"text":"from the store app in the package’s","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","isActive":true,"type":"reference"},{"text":", cut down","type":"text"},{"text":" ","type":"text"},{"text":"where the app does more than a step needs. Run that app to see every step working together","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"Examples\/README.md"},{"text":" says how). Each step links to the guide that covers it in full.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Add the package","anchor":"Add-the-package"},{"inlineContent":[{"text":"Add Traffluent to your package’s dependencies:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\", from: \"0.0.37\"),","],"]},{"inlineContent":[{"type":"text","text":"Then add products to your targets. "},{"code":"Traffluent","type":"codeVoice"},{"type":"text","text":" imports almost every module. "},{"code":"TrackingPlans","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which the delivery below needs, and "},{"code":"TrackerTesting","type":"codeVoice"},{"type":"text","text":", for tests, are products of their own:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".target(name: \"MyApp\", dependencies: [","    .product(name: \"Traffluent\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","]),",".testTarget(name: \"MyAppTests\", dependencies: [","    \"MyApp\",","    .product(name: \"TrackerTesting\", package: \"Traffluent\"),","]),"]},{"type":"heading","level":3,"text":"Declare the events","anchor":"Declare-the-events"},{"inlineContent":[{"text":"Declare each event as a struct marked ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", with a fixed name, which is what servers and","type":"text"},{"text":" ","type":"text"},{"text":"stored records know it by. A property can carry constraints the tracker checks before anything","type":"text"},{"text":" ","type":"text"},{"text":"else, and a personal value is ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":", which a destination can leave out with","type":"text"},{"text":" ","type":"text"},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import Traffluent","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart: Equatable {","    @Constrained(.pattern(\"^[a-z0-9]+(-[a-z0-9]+)*$\", example: \"canvas-tote\"))","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\", consent: .functional)","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","    var referrer: String?","}"]},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"ProductAddedToCart"},{"text":" with a quantity of 0 is rejected and never delivered. ","type":"text"},{"type":"codeVoice","code":"SignedUp"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"collected for the ","type":"text"},{"type":"codeVoice","code":"functional"},{"text":" consent category; events are ","type":"text"},{"type":"codeVoice","code":"analytics"},{"text":" unless they say otherwise.","type":"text"},{"text":" ","type":"text"},{"text":"Its email address is ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":", so the tracking plan never requires it, and a record whose email","type":"text"},{"text":" ","type":"text"},{"text":"a destination left out still matches the plan. The store app declares its events in a module of their own, ","type":"text"},{"type":"codeVoice","code":"StoreEvents"},{"text":". See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Build the tracker","anchor":"Build-the-tracker"},{"inlineContent":[{"text":"Build one tracker where the app starts. A ","type":"text"},{"code":"SegmentStore","type":"codeVoice"},{"text":" keeps each record on disk until it is","type":"text"},{"text":" ","type":"text"},{"text":"delivered, so events tracked just before the app ends are sent on the next launch. A ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":" ","type":"text"},{"text":"holds each event until the user grants its category. The enrichers stamp every event with its","type":"text"},{"text":" ","type":"text"},{"text":"session and with the app, device, operating system, locale and network it was tracked on:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let consent = Consent(savedDecisions)","let store = try SegmentStore()","let tracker = Tracker(","    store: store,","    consent: consent,","    enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()]",")"]},{"inlineContent":[{"type":"codeVoice","code":"Consent"},{"type":"text","text":" keeps decisions in memory only. "},{"type":"codeVoice","code":"savedDecisions"},{"type":"text","text":" is what the user chose at an earlier"},{"type":"text","text":" "},{"type":"text","text":"launch, which the app saved (the store app’s "},{"type":"codeVoice","code":"ConsentPreferences"},{"type":"text","text":" saves them to a file). The store"},{"type":"text","text":" "},{"type":"text","text":"keeps every event the app declares with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", in any of its modules, and the events the"},{"type":"text","text":" "},{"type":"text","text":"library tracks for it, such as screen views and the sessions’ start and end, with no list to keep"},{"type":"text","text":" "},{"type":"text","text":"up to date. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Make the tracker reachable","anchor":"Make-the-tracker-reachable"},{"inlineContent":[{"text":"Code that runs inside a task can read the tracker bound with ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"plus\", email: Sensitive(\"ada@example.com\"), referrer: nil))","}"]},{"inlineContent":[{"type":"text","text":"Code that no binding reaches, such as a detached task or a SwiftUI button’s action, finds the"},{"type":"text","text":" "},{"type":"text","text":"tracker through "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":" only once it is the process’s default. Make it the default once,"},{"type":"text","text":" "},{"type":"text","text":"as the app starts, in your "},{"type":"codeVoice","code":"App"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"init()"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["try Tracker.bootstrap(tracker)"]},{"inlineContent":[{"type":"text","text":"A second call throws "},{"code":"TrackerAlreadyBootstrapped","type":"codeVoice"},{"type":"text","text":" and leaves the first tracker in place, and a"},{"type":"text","text":" "},{"code":"withTracker","type":"codeVoice"},{"type":"text","text":" binding still wins inside its scope."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Views don’t read "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":". They read the tracker from the environment, where each screen"},{"type":"text","text":" "},{"type":"text","text":"adds its name to it, so set it at the root of the views, in your "},{"type":"codeVoice","code":"App"},{"type":"text","text":"’s body:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["WindowGroup {","    StoreView()","        .tracker(tracker)","}"]},{"inlineContent":[{"text":"The store app also turns on lifecycle tracking as it launches, which tracks opens and moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background (","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true,"type":"reference"},{"text":"). See ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Track from code and from views","anchor":"Track-from-code-and-from-views"},{"inlineContent":[{"text":"Code that changes something worth tracking tracks through ","type":"text"},{"type":"codeVoice","code":"Tracker.current"},{"text":". The store’s cart","type":"text"},{"text":" ","type":"text"},{"text":"tracks ","type":"text"},{"type":"codeVoice","code":"ProductAddedToCart"},{"text":" as a product goes in, and throws before tracking anything when the","type":"text"},{"text":" ","type":"text"},{"text":"quantity is out of range:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct Product: Identifiable, Hashable {","    var id: String","    var name: String","    var priceInCents: Int","","    static let catalog = [","        Product(id: \"canvas-tote\", name: \"Canvas Tote\", priceInCents: 2_400),","        Product(id: \"enamel-mug\", name: \"Enamel Mug\", priceInCents: 1_800),","    ]","}","","struct QuantityOutOfRange: Error, Equatable {}","","struct Cart {","    struct Line: Equatable {","        var product: Product","        var quantity: Int","    }","","    private(set) var lines: [Line] = []","","    static let quantities = 1...10","","    mutating func add(_ product: Product, quantity: Int = 1) throws(QuantityOutOfRange) {","        guard Self.quantities.contains(quantity) else { throw QuantityOutOfRange() }","        lines.append(Line(product: product, quantity: quantity))","        Tracker.current.track(ProductAddedToCart(productID: product.id, quantity: quantity))","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":", applied where a screen’s view is placed, tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time it"},{"type":"text","text":" "},{"type":"text","text":"appears and stamps the events tracked inside it with the screen’s name. "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":" works in"},{"type":"text","text":" "},{"type":"text","text":"a button’s action too, because the app bootstrapped its tracker, but that tracker doesn’t know"},{"type":"text","text":" "},{"type":"text","text":"which screen the button is on. So the view binds the environment’s tracker around the cart’s"},{"type":"text","text":" "},{"type":"text","text":"change with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":", and the event carries the screen’s name:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct StoreView: View {","    @State private var cart = Cart()","","    var body: some View {","        NavigationStack {","            List(Product.catalog) { product in","                NavigationLink(product.name) {","                    ProductView(product: product, cart: $cart)","                        .trackScreen(\"Product\")","                }","            }","            .trackScreen(\"Catalog\")","        }","    }","}","","struct ProductView: View {","    let product: Product","    @Binding var cart: Cart","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            \/\/ The default quantity, 1, is in range, so the cart never refuses it.","            try? withTracker(tracker) { try cart.add(product) }","        }","        .navigationTitle(product.name)","    }","}"]},{"inlineContent":[{"type":"text","text":"UIKit and AppKit find the tracker through a trait and the responder chain. See"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","isActive":true},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true},{"type":"text","text":" for screens and controls that track"},{"type":"text","text":" "},{"type":"text","text":"themselves."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Deliver to a server","anchor":"Deliver-to-a-server"},{"inlineContent":[{"type":"text","text":"A delivery batches the tracker’s records and hands each batch to its destinations. To send them"},{"type":"text","text":" "},{"type":"text","text":"to a TraffluentCollector, deliver to an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"writes each record’s properties through the event’s schema in a "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":". Like the store,"},{"type":"text","text":" "},{"type":"text","text":"the plan holds every event the app declares and the library’s own. "},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":" "},{"type":"text","text":"keeps the email address off this destination:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import TrackingPlans","","let plan = try TrackingPlan()","let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: CollectorBatchEncoder(plan: plan))","let delivery = tracker.records","    .batch()","    .deliver(to: collector.redactingSensitiveValues())","let delivering = Task { try await delivery.execute() }"]},{"inlineContent":[{"type":"codeVoice","code":"batch()"},{"text":" sends 20 records at a time, or every 30 seconds while any are waiting. Nothing runs until","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"execute()"},{"text":", and the delivery runs for as long as the tracker does, so start it once and keep the","type":"text"},{"text":" ","type":"text"},{"text":"task if the app needs to stop it. A send that gets no response, a 5xx, 408 or 429 is sent again with backoff","type":"text"},{"text":" ","type":"text"},{"text":"until it arrives, and the store keeps its records meanwhile. To send to PostHog instead, make the","type":"text"},{"text":" ","type":"text"},{"text":"destination with ","type":"text"},{"type":"codeVoice","code":"HTTPDestination.postHog(projectToken:host:plan:)"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Watch what is dropped","anchor":"Watch-what-is-dropped"},{"inlineContent":[{"type":"text","text":"Each event that doesn’t reach the server shows up in a report. The tracker reports a broken"},{"type":"text","text":" "},{"type":"text","text":"constraint, the consent a denied category, the store a record it couldn’t keep, the destination a"},{"type":"text","text":" "},{"type":"text","text":"batch the server refused, and the delivery a batch its full buffer dropped. Read every report in"},{"type":"text","text":" "},{"type":"text","text":"one task:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let rejections = tracker.rejectionReports","let consentDrops = consent.dropReports","let storeDrops = store.dropReports","let collectorDrops = collector.dropReports","let bufferDrops = delivery.bufferDropReports","Task {","    await withDiscardingTaskGroup { group in","        group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","        group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","        group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","        group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        group.addTask { for await report in bufferDrops { print(\"Buffer full: \\(report)\") } }","    }","}"]},{"inlineContent":[{"type":"text","text":"One task reads each stream at a time: a second reader waits, with a warning in the log, until the"},{"type":"text","text":" "},{"type":"text","text":"first one’s iteration ends or its iterator is released. A reader that stops calling "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" but"},{"type":"text","text":" "},{"type":"text","text":"keeps its iterator keeps the turn, so read each stream in one place and fan its reports out from"},{"type":"text","text":" "},{"type":"text","text":"there. The task"},{"type":"text","text":" "},{"type":"text","text":"reads the streams, not their owners, so it keeps no store, destination or delivery alive. The"},{"type":"text","text":" "},{"type":"text","text":"store app merges them into one "},{"type":"codeVoice","code":"AsyncQueue"},{"type":"text","text":" of its own type, "},{"type":"codeVoice","code":"AnalyticsDrop"},{"type":"text","text":", so a second reader"},{"type":"text","text":" "},{"type":"text","text":"of that waits its turn too, and logs each one."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Export and check the tracking plan","anchor":"Export-and-check-the-tracking-plan"},{"inlineContent":[{"text":"The tracking plan is a JSON Schema document for each event, committed beside the code, that the","type":"text"},{"text":" ","type":"text"},{"text":"people and services reading the events can review. A small executable that lists the plan above","type":"text"},{"text":" ","type":"text"},{"text":"writes it, and a check fails when the events no longer match it:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"sh","code":["swift package --allow-writing-to-package-directory export-tracking-plan","swift package check-tracking-plan"]},{"inlineContent":[{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},{"type":"text","text":" for the executable, the check from a test and catching breaking"},{"type":"text","text":" "},{"type":"text","text":"changes in CI."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Test what the code tracks","anchor":"Test-what-the-code-tracks"},{"inlineContent":[{"code":"withRecordingTracker","type":"codeVoice"},{"text":" binds a fresh tracker for the test’s body, which ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"text":"cart reaches in place of the app’s, and returns what it tracked, so tests running at the same time","type":"text"},{"text":" ","type":"text"},{"text":"never see each other’s events:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import Testing","import TrackerTesting","","@Test(\"Adding a product tracks ProductAddedToCart with its identifier and the quantity\")","func add() async throws {","    let tote = Product(id: \"canvas-tote\", name: \"Canvas Tote\", priceInCents: 2_400)","    var sut = Cart()","    let expectedEvents = [ProductAddedToCart(productID: \"canvas-tote\", quantity: 2)]","    let expectedLines = [Cart.Line(product: tote, quantity: 2)]","","    let tracked = try await withRecordingTracker { try sut.add(tote, quantity: 2) }","","    #expect(tracked.events(of: ProductAddedToCart.self) == expectedEvents)","    #expect(sut.lines == expectedLines)","}"]},{"inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"metadata":{"role":"article","modules":[{"name":"Traffluent"}],"title":"Getting Started","roleHeading":"Article"},"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"anchor":"Essentials","title":"Essentials","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/gettingstarted"]}],"references":{"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","kind":"article","title":"Automatic Tracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"type":"topic","role":"article"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"topic","url":"\/documentation\/traffluent\/choosingdestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent":{"url":"\/documentation\/traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","type":"topic","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"title":"Traffluent","role":"collection"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"url":"\/documentation\/traffluent\/sessionsandstandardcontext","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","kind":"article","title":"Sessions and Standard Context","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"type":"topic","role":"article"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"role":"article","kind":"article"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"title":"PostHogEncoding","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"topic","url":"\/documentation\/posthogencoding","abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}],"role":"collection","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"topic","url":"\/documentation\/traffluent\/trackingplanworkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"kind":"article","url":"\/documentation\/traffluent\/trackingfromviews","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"topic","title":"Tracking from SwiftUI, UIKit and AppKit","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"role":"article"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","url":"\/documentation\/traffluent\/trackingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"topic","title":"Tracking Events","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"role":"article"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"topic","url":"\/documentation\/traffluent\/consentgating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"role":"article","kind":"article"},"https://github.com/Tyler-Keith-Thompson/Traffluent/tree/main/Examples":{"type":"link","identifier":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","titleInlineContent":[{"code":"Examples","type":"codeVoice"}],"title":"Examples","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"title":"Defining Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","url":"\/documentation\/traffluent\/definingevents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"url":"\/documentation\/traffluent\/testingwhatyoutrack","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","title":"Testing What Your Code Tracks","type":"topic","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"role":"article"}}}