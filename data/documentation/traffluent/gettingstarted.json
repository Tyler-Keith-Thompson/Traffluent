{"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"metadata":{"role":"article","title":"Getting Started","roleHeading":"Article","modules":[{"name":"Traffluent"}]},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"This walkthrough builds the analytics of a small store app, one step at a time. The code comes","type":"text"},{"text":" ","type":"text"},{"text":"from the store app in the package’s","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","isActive":true,"type":"reference"},{"text":", cut down","type":"text"},{"text":" ","type":"text"},{"text":"where the app does more than a step needs. Run that app to see every step working together","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Examples\/README.md","type":"codeVoice"},{"text":" says how). Each step links to the guide that covers it in full.","type":"text"}]},{"anchor":"Add-the-package","text":"Add the package","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Add Traffluent to your package’s dependencies:","type":"text"}]},{"type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\", from: \"0.0.37\"),","],"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add products to your targets. "},{"type":"codeVoice","code":"Traffluent"},{"type":"text","text":" imports almost every module. "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which the delivery below needs, and "},{"type":"codeVoice","code":"TrackerTesting"},{"type":"text","text":", for tests, are products of their own:"}]},{"type":"codeListing","code":[".target(name: \"MyApp\", dependencies: [","    .product(name: \"Traffluent\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","]),",".testTarget(name: \"MyAppTests\", dependencies: [","    \"MyApp\",","    .product(name: \"TrackerTesting\", package: \"Traffluent\"),","]),"],"syntax":"swift"},{"anchor":"Declare-the-events","text":"Declare the events","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare each event as a struct marked "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", with a fixed name, which is what servers and"},{"type":"text","text":" "},{"type":"text","text":"stored records know it by. A property can carry constraints the tracker checks before anything"},{"type":"text","text":" "},{"type":"text","text":"else, and a personal value is "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":", which a destination can leave out with"},{"type":"text","text":" "},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":":"}]},{"type":"codeListing","code":["import Traffluent","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart: Equatable {","    @Constrained(.pattern(\"^[a-z0-9]+(-[a-z0-9]+)*$\", example: \"canvas-tote\"))","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\", consent: .functional)","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","    var referrer: String?","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"ProductAddedToCart"},{"text":" with a quantity of 0 is rejected and never delivered. ","type":"text"},{"type":"codeVoice","code":"SignedUp"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"collected for the ","type":"text"},{"type":"codeVoice","code":"functional"},{"text":" consent category; events are ","type":"text"},{"type":"codeVoice","code":"analytics"},{"text":" unless they say otherwise.","type":"text"},{"text":" ","type":"text"},{"text":"Its email address is ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":", so the tracking plan never requires it, and a record whose email","type":"text"},{"text":" ","type":"text"},{"text":"a destination left out still matches the plan. The store app declares its events in a module of their own, ","type":"text"},{"type":"codeVoice","code":"StoreEvents"},{"text":". See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},{"text":".","type":"text"}]},{"anchor":"Build-the-tracker","text":"Build the tracker","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build one tracker where the app starts. A "},{"code":"SegmentStore","type":"codeVoice"},{"type":"text","text":" keeps each record on disk until it is"},{"type":"text","text":" "},{"type":"text","text":"delivered, so events tracked just before the app ends are sent on the next launch. A "},{"code":"Consent","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"holds each event until the user grants its category. The enrichers stamp every event with its"},{"type":"text","text":" "},{"type":"text","text":"session and with the app, device, operating system, locale and network it was tracked on:"}]},{"type":"codeListing","code":["let consent = Consent(savedDecisions)","let store = try SegmentStore()","let tracker = Tracker(","    store: store,","    consent: consent,","    enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()]",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Consent","type":"codeVoice"},{"type":"text","text":" keeps decisions in memory only. "},{"code":"savedDecisions","type":"codeVoice"},{"type":"text","text":" is what the user chose at an earlier"},{"type":"text","text":" "},{"type":"text","text":"launch, which the app saved (the store app’s "},{"code":"ConsentPreferences","type":"codeVoice"},{"type":"text","text":" saves them to a file). The store"},{"type":"text","text":" "},{"type":"text","text":"keeps every event the app declares with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", in any of its modules, and the events the"},{"type":"text","text":" "},{"type":"text","text":"library tracks for it, such as screen views and the sessions’ start and end, with no list to keep"},{"type":"text","text":" "},{"type":"text","text":"up to date. See "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","type":"reference","isActive":true},{"type":"text","text":"."}]},{"anchor":"Make-the-tracker-reachable","text":"Make the tracker reachable","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Code that runs inside a task can read the tracker bound with ","type":"text"},{"type":"codeVoice","code":"withTracker"},{"text":":","type":"text"}]},{"type":"codeListing","code":["withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"plus\", email: Sensitive(\"ada@example.com\"), referrer: nil))","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Code that no binding reaches, such as a detached task or a SwiftUI button’s action, finds the"},{"type":"text","text":" "},{"type":"text","text":"tracker through "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":" only once it is the process’s default. Make it the default once,"},{"type":"text","text":" "},{"type":"text","text":"as the app starts, in your "},{"type":"codeVoice","code":"App"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"init()"},{"type":"text","text":":"}]},{"type":"codeListing","code":["try Tracker.bootstrap(tracker)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A second call throws ","type":"text"},{"code":"TrackerAlreadyBootstrapped","type":"codeVoice"},{"text":" and leaves the first tracker in place, and a","type":"text"},{"text":" ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":" binding still wins inside its scope.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views don’t read "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":". They read the tracker from the environment, where each screen"},{"type":"text","text":" "},{"type":"text","text":"adds its name to it, so set it at the root of the views, in your "},{"type":"codeVoice","code":"App"},{"type":"text","text":"’s body:"}]},{"type":"codeListing","code":["WindowGroup {","    StoreView()","        .tracker(tracker)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The store app also turns on lifecycle tracking as it launches, which tracks opens and moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"reference"},{"text":"). See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"reference"},{"text":".","type":"text"}]},{"anchor":"Track-from-code-and-from-views","text":"Track from code and from views","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Code that changes something worth tracking tracks through "},{"code":"Tracker.current","type":"codeVoice"},{"type":"text","text":". The store’s cart"},{"type":"text","text":" "},{"type":"text","text":"tracks "},{"code":"ProductAddedToCart","type":"codeVoice"},{"type":"text","text":" as a product goes in, and throws before tracking anything when the"},{"type":"text","text":" "},{"type":"text","text":"quantity is out of range:"}]},{"type":"codeListing","code":["struct Product: Identifiable, Hashable {","    var id: String","    var name: String","    var priceInCents: Int","","    static let catalog = [","        Product(id: \"canvas-tote\", name: \"Canvas Tote\", priceInCents: 2_400),","        Product(id: \"enamel-mug\", name: \"Enamel Mug\", priceInCents: 1_800),","    ]","}","","struct QuantityOutOfRange: Error, Equatable {}","","struct Cart {","    struct Line: Equatable {","        var product: Product","        var quantity: Int","    }","","    private(set) var lines: [Line] = []","","    static let quantities = 1...10","","    mutating func add(_ product: Product, quantity: Int = 1) throws(QuantityOutOfRange) {","        guard Self.quantities.contains(quantity) else { throw QuantityOutOfRange() }","        lines.append(Line(product: product, quantity: quantity))","        Tracker.current.track(ProductAddedToCart(productID: product.id, quantity: quantity))","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackScreen(_:)"},{"text":", applied where a screen’s view is placed, tracks ","type":"text"},{"type":"codeVoice","code":"ScreenViewed"},{"text":" each time it","type":"text"},{"text":" ","type":"text"},{"text":"appears and stamps the events tracked inside it with the screen’s name. ","type":"text"},{"type":"codeVoice","code":"Tracker.current"},{"text":" works in","type":"text"},{"text":" ","type":"text"},{"text":"a button’s action too, because the app bootstrapped its tracker, but that tracker doesn’t know","type":"text"},{"text":" ","type":"text"},{"text":"which screen the button is on. So the view binds the environment’s tracker around the cart’s","type":"text"},{"text":" ","type":"text"},{"text":"change with ","type":"text"},{"type":"codeVoice","code":"withTracker"},{"text":", and the event carries the screen’s name:","type":"text"}]},{"type":"codeListing","code":["struct StoreView: View {","    @State private var cart = Cart()","","    var body: some View {","        NavigationStack {","            List(Product.catalog) { product in","                NavigationLink(product.name) {","                    ProductView(product: product, cart: $cart)","                        .trackScreen(\"Product\")","                }","            }","            .trackScreen(\"Catalog\")","        }","    }","}","","struct ProductView: View {","    let product: Product","    @Binding var cart: Cart","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            \/\/ The default quantity, 1, is in range, so the cart never refuses it.","            try? withTracker(tracker) { try cart.add(product) }","        }","        .navigationTitle(product.name)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"UIKit and AppKit find the tracker through a trait and the responder chain. See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"reference","isActive":true},{"text":", and ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"reference","isActive":true},{"text":" for screens and controls that track","type":"text"},{"text":" ","type":"text"},{"text":"themselves.","type":"text"}]},{"anchor":"Deliver-to-a-server","text":"Deliver to a server","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A delivery batches the tracker’s records and hands each batch to its destinations. To send them"},{"type":"text","text":" "},{"type":"text","text":"to a TraffluentCollector, deliver to an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"writes each record’s properties through the event’s schema in a "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":". Like the store,"},{"type":"text","text":" "},{"type":"text","text":"the plan holds every event the app declares and the library’s own. "},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":" "},{"type":"text","text":"keeps the email address off this destination:"}]},{"type":"codeListing","code":["import TrackingPlans","","let plan = try TrackingPlan()","let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: CollectorBatchEncoder(plan: plan))","let delivery = tracker.records","    .batch()","    .deliver(to: collector.redactingSensitiveValues())","let delivering = Task { try await delivery.execute() }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"batch()","type":"codeVoice"},{"text":" sends 20 records at a time, or every 30 seconds while any are waiting. Nothing runs until","type":"text"},{"text":" ","type":"text"},{"code":"execute()","type":"codeVoice"},{"text":", and the delivery runs for as long as the tracker does, so start it once and keep the","type":"text"},{"text":" ","type":"text"},{"text":"task if the app needs to stop it. A send that gets no response, a 5xx, 408 or 429 is sent again with backoff","type":"text"},{"text":" ","type":"text"},{"text":"until it arrives, and the store keeps its records meanwhile. To send to PostHog instead, make the","type":"text"},{"text":" ","type":"text"},{"text":"destination with ","type":"text"},{"code":"HTTPDestination.postHog(projectToken:host:plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"reference"},{"text":".","type":"text"}]},{"anchor":"Watch-what-is-dropped","text":"Watch what is dropped","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event that doesn’t reach the server shows up in a report. The tracker reports a broken"},{"type":"text","text":" "},{"type":"text","text":"constraint, the consent a denied category, the store a record it couldn’t keep, the destination a"},{"type":"text","text":" "},{"type":"text","text":"batch the server refused, and the delivery a batch its full buffer dropped. Read every report in"},{"type":"text","text":" "},{"type":"text","text":"one task:"}]},{"type":"codeListing","code":["let rejections = tracker.rejectionReports","let consentDrops = consent.dropReports","let storeDrops = store.dropReports","let collectorDrops = collector.dropReports","let bufferDrops = delivery.bufferDropReports","Task {","    await withDiscardingTaskGroup { group in","        group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","        group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","        group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","        group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        group.addTask { for await report in bufferDrops { print(\"Buffer full: \\(report)\") } }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads each stream at a time: a second reader waits, with a warning in the log, until the"},{"type":"text","text":" "},{"type":"text","text":"first one’s iteration ends or its iterator is released. A reader that stops calling "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" but"},{"type":"text","text":" "},{"type":"text","text":"keeps its iterator keeps the turn, so read each stream in one place and fan its reports out from"},{"type":"text","text":" "},{"type":"text","text":"there. The task"},{"type":"text","text":" "},{"type":"text","text":"reads the streams, not their owners, so it keeps no store, destination or delivery alive. The"},{"type":"text","text":" "},{"type":"text","text":"store app merges them into one "},{"type":"codeVoice","code":"AsyncQueue"},{"type":"text","text":" of its own type, "},{"type":"codeVoice","code":"AnalyticsDrop"},{"type":"text","text":", so a second reader"},{"type":"text","text":" "},{"type":"text","text":"of that waits its turn too, and logs each one."}]},{"anchor":"Export-and-check-the-tracking-plan","text":"Export and check the tracking plan","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan is a JSON Schema document for each event, committed beside the code, that the"},{"type":"text","text":" "},{"type":"text","text":"people and services reading the events can review. A small executable that lists the plan above"},{"type":"text","text":" "},{"type":"text","text":"writes it, and a check fails when the events no longer match it:"}]},{"type":"codeListing","code":["swift package --allow-writing-to-package-directory export-tracking-plan","swift package check-tracking-plan"],"syntax":"sh"},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},{"text":" for the executable, the check from a test and catching breaking","type":"text"},{"text":" ","type":"text"},{"text":"changes in CI.","type":"text"}]},{"anchor":"Test-what-the-code-tracks","text":"Test what the code tracks","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" binds a fresh tracker for the test’s body, which "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"cart reaches in place of the app’s, and returns what it tracked, so tests running at the same time"},{"type":"text","text":" "},{"type":"text","text":"never see each other’s events:"}]},{"type":"codeListing","code":["import Testing","import TrackerTesting","","@Test(\"Adding a product tracks ProductAddedToCart with its identifier and the quantity\")","func add() async throws {","    let tote = Product(id: \"canvas-tote\", name: \"Canvas Tote\", priceInCents: 2_400)","    var sut = Cart()","    let expectedEvents = [ProductAddedToCart(productID: \"canvas-tote\", quantity: 2)]","    let expectedLines = [Cart.Line(product: tote, quantity: 2)]","","    let tracked = try await withRecordingTracker { try sut.add(tote, quantity: 2) }","","    #expect(tracked.events(of: ProductAddedToCart.self) == expectedEvents)","    #expect(sut.lines == expectedLines)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/traffluent\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://github.com/Tyler-Keith-Thompson/Traffluent/tree/main/Examples":{"titleInlineContent":[{"code":"Examples","type":"codeVoice"}],"title":"Examples","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","type":"link","identifier":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"role":"article","type":"topic","title":"Defining Events","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","url":"\/documentation\/traffluent\/definingevents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}]},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","title":"Tracking from SwiftUI, UIKit and AppKit","type":"topic","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/trackingfromviews"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"role":"article","title":"Choosing Destinations","type":"topic","kind":"article","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","url":"\/documentation\/traffluent\/choosingdestinations"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","title":"Persisting Records","type":"topic","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/persistingrecords"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"role":"article","type":"topic","title":"Automatic Tracking","kind":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","title":"Testing What Your Code Tracks","type":"topic","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","type":"topic","title":"Tracking Events","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","url":"\/documentation\/traffluent\/trackingevents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","title":"Exporting and Checking a Tracking Plan","type":"topic","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"role":"article","title":"Consent Gating","type":"topic","kind":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","url":"\/documentation\/traffluent\/consentgating"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","title":"PostHogEncoding","type":"topic","abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"kind":"symbol","role":"collection","url":"\/documentation\/posthogencoding"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"role":"article","type":"topic","title":"Sessions and Standard Context","kind":"article","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"url":"\/documentation\/traffluent\/sessionsandstandardcontext","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","type":"topic","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"kind":"symbol","role":"collection","url":"\/documentation\/traffluent"}}}