{"sections":[],"abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"variants":[{"paths":["\/documentation\/traffluent\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","interfaceLanguage":"swift"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"generated":true,"anchor":"Essentials"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This walkthrough builds the analytics of a small store app, one step at a time. The code comes","type":"text"},{"text":" ","type":"text"},{"text":"from the store app in the package’s","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","isActive":true,"type":"reference"},{"text":", cut down","type":"text"},{"text":" ","type":"text"},{"text":"where the app does more than a step needs. Run that app to see every step working together","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Examples\/README.md","type":"codeVoice"},{"text":" says how). Each step links to the guide that covers it in full.","type":"text"}]},{"type":"heading","level":3,"text":"Add the package","anchor":"Add-the-package"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add Traffluent to your package’s dependencies:"}]},{"syntax":"swift","type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\", from: \"0.0.37\"),","],"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add products to your targets. "},{"type":"codeVoice","code":"Traffluent"},{"type":"text","text":" imports almost every module. "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which the delivery below needs, and "},{"type":"codeVoice","code":"TrackerTesting"},{"type":"text","text":", for tests, are products of their own:"}]},{"syntax":"swift","type":"codeListing","code":[".target(name: \"MyApp\", dependencies: [","    .product(name: \"Traffluent\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","]),",".testTarget(name: \"MyAppTests\", dependencies: [","    \"MyApp\",","    .product(name: \"TrackerTesting\", package: \"Traffluent\"),","]),"]},{"type":"heading","level":3,"text":"Declare the events","anchor":"Declare-the-events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare each event as a struct marked "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", with a fixed name, which is what servers and"},{"type":"text","text":" "},{"type":"text","text":"stored records know it by. A property can carry constraints the tracker checks before anything"},{"type":"text","text":" "},{"type":"text","text":"else, and a personal value is "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":", which a destination can leave out with"},{"type":"text","text":" "},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["import Traffluent","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart: Equatable {","    @Constrained(.pattern(\"^[a-z0-9]+(-[a-z0-9]+)*$\", example: \"canvas-tote\"))","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\", consent: .functional)","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","    var referrer: String?","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"ProductAddedToCart","type":"codeVoice"},{"type":"text","text":" with a quantity of 0 is rejected and never delivered. "},{"code":"SignedUp","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"collected for the "},{"code":"functional","type":"codeVoice"},{"type":"text","text":" consent category; events are "},{"code":"analytics","type":"codeVoice"},{"type":"text","text":" unless they say otherwise."},{"type":"text","text":" "},{"type":"text","text":"Its email address is "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":", so the tracking plan never requires it, and a record whose email"},{"type":"text","text":" "},{"type":"text","text":"a destination left out still matches the plan. The store app declares its events in a module of their own, "},{"code":"StoreEvents","type":"codeVoice"},{"type":"text","text":". See"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"Build the tracker","anchor":"Build-the-tracker"},{"type":"paragraph","inlineContent":[{"text":"Build one tracker where the app starts. A ","type":"text"},{"type":"codeVoice","code":"SegmentStore"},{"text":" keeps each record on disk until it is","type":"text"},{"text":" ","type":"text"},{"text":"delivered, so events tracked just before the app ends are sent on the next launch. A ","type":"text"},{"type":"codeVoice","code":"Consent"},{"text":" ","type":"text"},{"text":"holds each event until the user grants its category. The enrichers stamp every event with its","type":"text"},{"text":" ","type":"text"},{"text":"session and with the app, device, operating system, locale and network it was tracked on:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let consent = Consent(savedDecisions)","let store = try SegmentStore(events: [","    ProductAddedToCart.self,","    SignedUp.self,","    ScreenViewed.self,","    SessionStarted.self,","    SessionEnded.self,","])","let tracker = Tracker(","    store: store,","    consent: consent,","    enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()]",")"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Consent"},{"text":" keeps decisions in memory only. ","type":"text"},{"type":"codeVoice","code":"savedDecisions"},{"text":" is what the user chose at an earlier","type":"text"},{"text":" ","type":"text"},{"text":"launch, which the app saved (the store app’s ","type":"text"},{"type":"codeVoice","code":"ConsentPreferences"},{"text":" saves them to a file). The store","type":"text"},{"text":" ","type":"text"},{"text":"lists the events the library tracks for the app too: screen views and the sessions’ start and end.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},{"text":".","type":"text"}]},{"type":"heading","level":3,"text":"Make the tracker reachable","anchor":"Make-the-tracker-reachable"},{"type":"paragraph","inlineContent":[{"text":"Code that runs inside a task can read the tracker bound with ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"plus\", email: Sensitive(\"ada@example.com\"), referrer: nil))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Code that no binding reaches, such as a detached task or a SwiftUI button’s action, finds the"},{"type":"text","text":" "},{"type":"text","text":"tracker through "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":" only once it is the process’s default. Make it the default once,"},{"type":"text","text":" "},{"type":"text","text":"as the app starts, in your "},{"type":"codeVoice","code":"App"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"init()"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["try Tracker.bootstrap(tracker)"]},{"type":"paragraph","inlineContent":[{"text":"A second call throws ","type":"text"},{"code":"TrackerAlreadyBootstrapped","type":"codeVoice"},{"text":" and leaves the first tracker in place, and a","type":"text"},{"text":" ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":" binding still wins inside its scope.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Views don’t read ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":". They read the tracker from the environment, where each screen","type":"text"},{"text":" ","type":"text"},{"text":"adds its name to it, so set it at the root of the views, in your ","type":"text"},{"code":"App","type":"codeVoice"},{"text":"’s body:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["WindowGroup {","    StoreView()","        .tracker(tracker)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The store app also turns on lifecycle tracking as it launches, which tracks opens and moves to the"},{"type":"text","text":" "},{"type":"text","text":"background ("},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true},{"type":"text","text":"). See "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"Track from code and from views","anchor":"Track-from-code-and-from-views"},{"type":"paragraph","inlineContent":[{"text":"Code that changes something worth tracking tracks through ","type":"text"},{"type":"codeVoice","code":"Tracker.current"},{"text":". The store’s cart","type":"text"},{"text":" ","type":"text"},{"text":"tracks ","type":"text"},{"type":"codeVoice","code":"ProductAddedToCart"},{"text":" as a product goes in, and throws before tracking anything when the","type":"text"},{"text":" ","type":"text"},{"text":"quantity is out of range:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct Product: Identifiable, Hashable {","    var id: String","    var name: String","    var priceInCents: Int","","    static let catalog = [","        Product(id: \"canvas-tote\", name: \"Canvas Tote\", priceInCents: 2_400),","        Product(id: \"enamel-mug\", name: \"Enamel Mug\", priceInCents: 1_800),","    ]","}","","struct QuantityOutOfRange: Error, Equatable {}","","struct Cart {","    struct Line: Equatable {","        var product: Product","        var quantity: Int","    }","","    private(set) var lines: [Line] = []","","    static let quantities = 1...10","","    mutating func add(_ product: Product, quantity: Int = 1) throws(QuantityOutOfRange) {","        guard Self.quantities.contains(quantity) else { throw QuantityOutOfRange() }","        lines.append(Line(product: product, quantity: quantity))","        Tracker.current.track(ProductAddedToCart(productID: product.id, quantity: quantity))","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"text":", applied where a screen’s view is placed, tracks ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" each time it","type":"text"},{"text":" ","type":"text"},{"text":"appears and stamps the events tracked inside it with the screen’s name. ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":" works in","type":"text"},{"text":" ","type":"text"},{"text":"a button’s action too, because the app bootstrapped its tracker, but that tracker doesn’t know","type":"text"},{"text":" ","type":"text"},{"text":"which screen the button is on. So the view binds the environment’s tracker around the cart’s","type":"text"},{"text":" ","type":"text"},{"text":"change with ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":", and the event carries the screen’s name:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct StoreView: View {","    @State private var cart = Cart()","","    var body: some View {","        NavigationStack {","            List(Product.catalog) { product in","                NavigationLink(product.name) {","                    ProductView(product: product, cart: $cart)","                        .trackScreen(\"Product\")","                }","            }","            .trackScreen(\"Catalog\")","        }","    }","}","","struct ProductView: View {","    let product: Product","    @Binding var cart: Cart","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            \/\/ The default quantity, 1, is in range, so the cart never refuses it.","            try? withTracker(tracker) { try cart.add(product) }","        }","        .navigationTitle(product.name)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"UIKit and AppKit find the tracker through a trait and the responder chain. See"},{"type":"text","text":" "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","isActive":true,"type":"reference"},{"type":"text","text":", and "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true,"type":"reference"},{"type":"text","text":" for screens and controls that track"},{"type":"text","text":" "},{"type":"text","text":"themselves."}]},{"type":"heading","level":3,"text":"Deliver to a server","anchor":"Deliver-to-a-server"},{"type":"paragraph","inlineContent":[{"text":"A delivery batches the tracker’s records and hands each batch to its destinations. To send them","type":"text"},{"text":" ","type":"text"},{"text":"to a TraffluentCollector, deliver to an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" with a ","type":"text"},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"writes each record’s properties through the event’s schema in a ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":". The plan lists","type":"text"},{"text":" ","type":"text"},{"text":"every event the tracker can see, the library’s included. ","type":"text"},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"text":" keeps the","type":"text"},{"text":" ","type":"text"},{"text":"email address off this destination:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import TrackingPlans","","let plan = try TrackingPlan(schemas: [","    ProductAddedToCart.schema,","    SignedUp.schema,","    ScreenViewed.schema,","    SessionStarted.schema,","    SessionEnded.schema,","])","let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: CollectorBatchEncoder(plan: plan))","let (bufferDrops, bufferDropReporter) = AsyncStream.makeStream(of: BufferDropReport.self)","let delivery = tracker.records","    .batch()","    .deliver(to: collector.redactingSensitiveValues(), bufferDropReporter: bufferDropReporter)","let delivering = Task { try await delivery.execute() }"]},{"type":"paragraph","inlineContent":[{"code":"batch()","type":"codeVoice"},{"text":" sends 20 records at a time, or every 30 seconds while any are waiting. Nothing runs until","type":"text"},{"text":" ","type":"text"},{"code":"execute()","type":"codeVoice"},{"text":", and the delivery runs for as long as the tracker does, so start it once and keep the","type":"text"},{"text":" ","type":"text"},{"text":"task if the app needs to stop it. A send that gets no response, a 5xx, 408 or 429 is sent again with backoff","type":"text"},{"text":" ","type":"text"},{"text":"until it arrives, and the store keeps its records meanwhile. To send to PostHog instead, give the","type":"text"},{"text":" ","type":"text"},{"text":"destination a ","type":"text"},{"code":"PostHogBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},{"text":"). See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},{"text":".","type":"text"}]},{"type":"heading","level":3,"text":"Watch what is dropped","anchor":"Watch-what-is-dropped"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event that doesn’t reach the server shows up in a report. The tracker reports a broken"},{"type":"text","text":" "},{"type":"text","text":"constraint, the consent a denied category, the store a record it couldn’t keep, the destination a"},{"type":"text","text":" "},{"type":"text","text":"batch the server refused, and the delivery a batch its full buffer dropped. Read every report in"},{"type":"text","text":" "},{"type":"text","text":"one task:"}]},{"syntax":"swift","type":"codeListing","code":["let rejections = tracker.rejectionReports","let consentDrops = consent.dropReports","let storeDrops = store.dropReports","let collectorDrops = collector.dropReports","Task {","    await withDiscardingTaskGroup { group in","        group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","        group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","        group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","        group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        group.addTask { for await report in bufferDrops { print(\"Buffer full: \\(report)\") } }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Each stream has one reader. The task reads the streams, not their owners, so it keeps no store or","type":"text"},{"text":" ","type":"text"},{"text":"destination alive. The store app merges them into one stream of its own type, ","type":"text"},{"type":"codeVoice","code":"AnalyticsDrop"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"logs each one.","type":"text"}]},{"type":"heading","level":3,"text":"Export and check the tracking plan","anchor":"Export-and-check-the-tracking-plan"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan is a JSON Schema document for each event, committed beside the code, that the"},{"type":"text","text":" "},{"type":"text","text":"people and services reading the events can review. A small executable that lists the plan above"},{"type":"text","text":" "},{"type":"text","text":"writes it, and a check fails when the events no longer match it:"}]},{"syntax":"sh","type":"codeListing","code":["swift package --allow-writing-to-package-directory export-tracking-plan","swift package check-tracking-plan"]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"reference","isActive":true},{"text":" for the executable, the check from a test and catching breaking","type":"text"},{"text":" ","type":"text"},{"text":"changes in CI.","type":"text"}]},{"type":"heading","level":3,"text":"Test what the code tracks","anchor":"Test-what-the-code-tracks"},{"type":"paragraph","inlineContent":[{"code":"withRecordingTracker","type":"codeVoice"},{"text":" binds a fresh tracker for the test’s body, which ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"text":"cart reaches in place of the app’s, and returns what it tracked, so tests running at the same time","type":"text"},{"text":" ","type":"text"},{"text":"never see each other’s events:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Testing","import TrackerTesting","","@Test(\"Adding a product tracks ProductAddedToCart with its identifier and the quantity\")","func add() async throws {","    let tote = Product(id: \"canvas-tote\", name: \"Canvas Tote\", priceInCents: 2_400)","    var sut = Cart()","    let expectedEvents = [ProductAddedToCart(productID: \"canvas-tote\", quantity: 2)]","    let expectedLines = [Cart.Line(product: tote, quantity: 2)]","","    let tracked = try await withRecordingTracker { try sut.add(tote, quantity: 2) }","","    #expect(tracked.events(of: ProductAddedToCart.self) == expectedEvents)","    #expect(sut.lines == expectedLines)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},{"type":"text","text":"."}]}],"kind":"content"}],"metadata":{"role":"article","title":"Getting Started","modules":[{"name":"Traffluent"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"references":{"doc://Traffluent/documentation/Traffluent/ConsentGating":{"type":"topic","kind":"article","url":"\/documentation\/traffluent\/consentgating","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"title":"Consent Gating"},"doc://Traffluent/documentation/Traffluent":{"role":"collection","url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"type":"topic","kind":"symbol","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"role":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"kind":"article","title":"Testing What Your Code Tracks"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"role":"article","url":"\/documentation\/traffluent\/trackingfromviews","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"type":"topic","kind":"article","title":"Tracking from SwiftUI, UIKit and AppKit"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"role":"article","url":"\/documentation\/traffluent\/automatictracking","type":"topic","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","kind":"article","title":"Automatic Tracking"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"type":"topic","kind":"article","url":"\/documentation\/traffluent\/choosingdestinations","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"title":"Choosing Destinations"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"role":"article","url":"\/documentation\/traffluent\/definingevents","type":"topic","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","kind":"article","title":"Defining Events"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","type":"topic","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","kind":"article","title":"Exporting and Checking a Tracking Plan"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"role":"article","url":"\/documentation\/traffluent\/persistingrecords","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"type":"topic","kind":"article","title":"Persisting Records"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"type":"topic","kind":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"title":"Sessions and Standard Context"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","url":"\/documentation\/traffluent\/trackingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"type":"topic","kind":"article","title":"Tracking Events"},"https://github.com/Tyler-Keith-Thompson/Traffluent/tree/main/Examples":{"type":"link","title":"Examples","titleInlineContent":[{"code":"Examples","type":"codeVoice"}],"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","identifier":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"kind":"symbol","url":"\/documentation\/posthogencoding","type":"topic","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","title":"PostHogEncoding","abstract":[{"text":"Write batches of records for PostHog’s batch capture API, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"role":"collection"}}}