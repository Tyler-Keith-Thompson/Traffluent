{"abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","interfaceLanguage":"swift"},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"This walkthrough builds the analytics of a small store app, one step at a time. The code comes","type":"text"},{"text":" ","type":"text"},{"text":"from the store app in the package’s","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","type":"reference"},{"text":", cut down","type":"text"},{"text":" ","type":"text"},{"text":"where the app does more than a step needs. Run that app to see every step working together","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"Examples\/README.md"},{"text":" says how). Each step links to the guide that covers it in full.","type":"text"}]},{"text":"Add the package","anchor":"Add-the-package","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Add Traffluent to your package’s dependencies:","type":"text"}]},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\", from: \"0.0.37\"),","],"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add products to your targets. "},{"type":"codeVoice","code":"Traffluent"},{"type":"text","text":" imports almost every module. "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which the delivery below needs, and "},{"type":"codeVoice","code":"TrackerTesting"},{"type":"text","text":", for tests, are products of their own:"}]},{"code":[".target(name: \"MyApp\", dependencies: [","    .product(name: \"Traffluent\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","]),",".testTarget(name: \"MyAppTests\", dependencies: [","    \"MyApp\",","    .product(name: \"TrackerTesting\", package: \"Traffluent\"),","]),"],"type":"codeListing","syntax":"swift"},{"text":"Declare the events","anchor":"Declare-the-events","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Declare each event as a struct marked ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", with a fixed name, which is what servers and","type":"text"},{"text":" ","type":"text"},{"text":"stored records know it by. A property can carry constraints the tracker checks before anything","type":"text"},{"text":" ","type":"text"},{"text":"else, and a personal value is ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":", which a destination can leave out with","type":"text"},{"text":" ","type":"text"},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["import Traffluent","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart: Equatable {","    @Constrained(.pattern(\"^[a-z0-9]+(-[a-z0-9]+)*$\", example: \"canvas-tote\"))","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\", consent: .functional)","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","    var referrer: String?","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"ProductAddedToCart"},{"type":"text","text":" with a quantity of 0 is rejected and never delivered. "},{"type":"codeVoice","code":"SignedUp"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"collected for the "},{"type":"codeVoice","code":"functional"},{"type":"text","text":" consent category; events are "},{"type":"codeVoice","code":"analytics"},{"type":"text","text":" unless they say otherwise."},{"type":"text","text":" "},{"type":"text","text":"Its email address is "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":", so the tracking plan never requires it, and a record whose email"},{"type":"text","text":" "},{"type":"text","text":"a destination left out still matches the plan. The store app declares its events in a module of their own, "},{"type":"codeVoice","code":"StoreEvents"},{"type":"text","text":". See"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","isActive":true},{"type":"text","text":"."}]},{"text":"Build the tracker","anchor":"Build-the-tracker","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Build one tracker where the app starts. A ","type":"text"},{"code":"SegmentStore","type":"codeVoice"},{"text":" keeps each record on disk until it is","type":"text"},{"text":" ","type":"text"},{"text":"delivered, so events tracked just before the app ends are sent on the next launch. A ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":" ","type":"text"},{"text":"holds each event until the user grants its category. The enrichers stamp every event with its","type":"text"},{"text":" ","type":"text"},{"text":"session and with the app, device, operating system, locale and network it was tracked on:","type":"text"}]},{"code":["let consent = Consent(savedDecisions)","let store = try SegmentStore(events: [","    ProductAddedToCart.self,","    SignedUp.self,","    ScreenViewed.self,","    SessionStarted.self,","    SessionEnded.self,","])","let tracker = Tracker(","    store: store,","    consent: consent,","    enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()]",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Consent"},{"type":"text","text":" keeps decisions in memory only. "},{"type":"codeVoice","code":"savedDecisions"},{"type":"text","text":" is what the user chose at an earlier"},{"type":"text","text":" "},{"type":"text","text":"launch, which the app saved (the store app’s "},{"type":"codeVoice","code":"ConsentPreferences"},{"type":"text","text":" saves them to a file). The store"},{"type":"text","text":" "},{"type":"text","text":"lists the events the library tracks for the app too: screen views and the sessions’ start and end."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","isActive":true},{"type":"text","text":"."}]},{"text":"Make the tracker reachable","anchor":"Make-the-tracker-reachable","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Code that runs inside a task can read the tracker bound with ","type":"text"},{"type":"codeVoice","code":"withTracker"},{"text":":","type":"text"}]},{"code":["withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"plus\", email: Sensitive(\"ada@example.com\"), referrer: nil))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Code that no binding reaches, such as a detached task, finds the tracker through","type":"text"},{"text":" ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":" only once it is the process’s default. Make it the default once, as the app","type":"text"},{"text":" ","type":"text"},{"text":"starts, in your ","type":"text"},{"code":"App","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["try Tracker.bootstrap(tracker)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A second call throws ","type":"text"},{"code":"TrackerAlreadyBootstrapped","type":"codeVoice"},{"text":" and leaves the first tracker in place, and a","type":"text"},{"text":" ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":" binding still wins inside its scope.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The binding doesn’t reach callbacks that a framework runs itself, such as a SwiftUI button’s"},{"type":"text","text":" "},{"type":"text","text":"action, and views don’t read "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":". They read the tracker from the environment"},{"type":"text","text":" "},{"type":"text","text":"instead, so set it at the root of the views, in your "},{"type":"codeVoice","code":"App"},{"type":"text","text":"’s body:"}]},{"code":["WindowGroup {","    StoreView()","        .tracker(tracker)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The store app also turns on lifecycle tracking as it launches, which tracks opens and moves to the"},{"type":"text","text":" "},{"type":"text","text":"background ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},{"type":"text","text":"). See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"},{"type":"text","text":"."}]},{"text":"Track from code and from views","anchor":"Track-from-code-and-from-views","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Code that changes something worth tracking takes the tracker it tracks through. The store’s cart","type":"text"},{"text":" ","type":"text"},{"text":"tracks ","type":"text"},{"code":"ProductAddedToCart","type":"codeVoice"},{"text":" as a product goes in, and throws before tracking anything when the","type":"text"},{"text":" ","type":"text"},{"text":"quantity is out of range:","type":"text"}]},{"code":["struct Product: Identifiable, Hashable {","    var id: String","    var name: String","    var priceInCents: Int","","    static let catalog = [","        Product(id: \"canvas-tote\", name: \"Canvas Tote\", priceInCents: 2_400),","        Product(id: \"enamel-mug\", name: \"Enamel Mug\", priceInCents: 1_800),","    ]","}","","struct QuantityOutOfRange: Error, Equatable {}","","struct Cart {","    struct Line: Equatable {","        var product: Product","        var quantity: Int","    }","","    private(set) var lines: [Line] = []","","    static let quantities = 1...10","","    mutating func add(_ product: Product, quantity: Int = 1, trackingWith tracker: Tracker) throws(QuantityOutOfRange) {","        guard Self.quantities.contains(quantity) else { throw QuantityOutOfRange() }","        lines.append(Line(product: product, quantity: quantity))","        tracker.track(ProductAddedToCart(productID: product.id, quantity: quantity))","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A view reads the tracker from the environment and hands it to the cart. ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":", applied","type":"text"},{"text":" ","type":"text"},{"text":"where a screen’s view is placed, tracks ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" each time it appears and stamps the events","type":"text"},{"text":" ","type":"text"},{"text":"tracked inside it with the screen’s name:","type":"text"}]},{"code":["struct StoreView: View {","    @State private var cart = Cart()","","    var body: some View {","        NavigationStack {","            List(Product.catalog) { product in","                NavigationLink(product.name) {","                    ProductView(product: product, cart: $cart)","                        .trackScreen(\"Product\")","                }","            }","            .trackScreen(\"Catalog\")","        }","    }","}","","struct ProductView: View {","    let product: Product","    @Binding var cart: Cart","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            \/\/ The default quantity, 1, is in range, so the cart never refuses it.","            try? cart.add(product, trackingWith: tracker)","        }","        .navigationTitle(product.name)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"UIKit and AppKit find the tracker through a trait and the responder chain. See"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},{"type":"text","text":" for screens and controls that track"},{"type":"text","text":" "},{"type":"text","text":"themselves."}]},{"text":"Deliver to a server","anchor":"Deliver-to-a-server","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A delivery batches the tracker’s records and hands each batch to its destinations. To send them"},{"type":"text","text":" "},{"type":"text","text":"to a TraffluentCollector, deliver to an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" with a "},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"writes each record’s properties through the event’s schema in a "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":". The plan lists"},{"type":"text","text":" "},{"type":"text","text":"every event the tracker can see, the library’s included. "},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"type":"text","text":" keeps the"},{"type":"text","text":" "},{"type":"text","text":"email address off this destination:"}]},{"code":["import TrackingPlans","","let plan = try TrackingPlan(schemas: [","    ProductAddedToCart.schema,","    SignedUp.schema,","    ScreenViewed.schema,","    SessionStarted.schema,","    SessionEnded.schema,","])","let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: CollectorBatchEncoder(plan: plan))","let (bufferDrops, bufferDropReporter) = AsyncStream.makeStream(of: BufferDropReport.self)","let delivery = tracker.records","    .batch()","    .deliver(to: collector.redactingSensitiveValues(), bufferDropReporter: bufferDropReporter)","let delivering = Task { try await delivery.execute() }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"batch()"},{"type":"text","text":" sends 20 records at a time, or every 30 seconds while any are waiting. Nothing runs until"},{"type":"text","text":" "},{"type":"codeVoice","code":"execute()"},{"type":"text","text":", and the delivery runs for as long as the tracker does, so start it once and keep the"},{"type":"text","text":" "},{"type":"text","text":"task if the app needs to stop it. A send that gets no response, a 5xx, 408 or 429 is sent again with backoff"},{"type":"text","text":" "},{"type":"text","text":"until it arrives, and the store keeps its records meanwhile. To send to PostHog instead, give the"},{"type":"text","text":" "},{"type":"text","text":"destination a "},{"type":"codeVoice","code":"PostHogBatchEncoder"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","isActive":true},{"type":"text","text":"). See "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","isActive":true},{"type":"text","text":"."}]},{"text":"Watch what is dropped","anchor":"Watch-what-is-dropped","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event that doesn’t reach the server shows up in a report. The tracker reports a broken"},{"type":"text","text":" "},{"type":"text","text":"constraint, the consent a denied category, the store a record it couldn’t keep, the destination a"},{"type":"text","text":" "},{"type":"text","text":"batch the server refused, and the delivery a batch its full buffer dropped. Read every report in"},{"type":"text","text":" "},{"type":"text","text":"one task:"}]},{"code":["let rejections = tracker.rejectionReports","let consentDrops = consent.dropReports","let storeDrops = store.dropReports","let collectorDrops = collector.dropReports","Task {","    await withDiscardingTaskGroup { group in","        group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","        group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","        group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","        group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        group.addTask { for await report in bufferDrops { print(\"Buffer full: \\(report)\") } }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each stream has one reader. The task reads the streams, not their owners, so it keeps no store or"},{"type":"text","text":" "},{"type":"text","text":"destination alive. The store app merges them into one stream of its own type, "},{"type":"codeVoice","code":"AnalyticsDrop"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"logs each one."}]},{"text":"Export and check the tracking plan","anchor":"Export-and-check-the-tracking-plan","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"The tracking plan is a JSON Schema document for each event, committed beside the code, that the","type":"text"},{"text":" ","type":"text"},{"text":"people and services reading the events can review. A small executable that lists the plan above","type":"text"},{"text":" ","type":"text"},{"text":"writes it, and a check fails when the events no longer match it:","type":"text"}]},{"code":["swift package --allow-writing-to-package-directory export-tracking-plan","swift package check-tracking-plan"],"type":"codeListing","syntax":"sh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","isActive":true},{"type":"text","text":" for the executable, the check from a test and catching breaking"},{"type":"text","text":" "},{"type":"text","text":"changes in CI."}]},{"text":"Test what the code tracks","anchor":"Test-what-the-code-tracks","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"withRecordingTracker"},{"text":" runs a test’s body with a fresh tracker and returns what it tracked, so","type":"text"},{"text":" ","type":"text"},{"text":"tests running at the same time never see each other’s events:","type":"text"}]},{"code":["import Testing","import TrackerTesting","","@Test(\"Adding a product tracks ProductAddedToCart with its identifier and the quantity\")","func add() async throws {","    let tote = Product(id: \"canvas-tote\", name: \"Canvas Tote\", priceInCents: 2_400)","    var sut = Cart()","    let expectedEvents = [ProductAddedToCart(productID: \"canvas-tote\", quantity: 2)]","    let expectedLines = [Cart.Line(product: tote, quantity: 2)]","","    let tracked = try await withRecordingTracker { tracker in","        try sut.add(tote, quantity: 2, trackingWith: tracker)","    }","","    #expect(tracked.events(of: ProductAddedToCart.self) == expectedEvents)","    #expect(sut.lines == expectedLines)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","type":"reference","isActive":true},{"type":"text","text":"."}]}]}],"variants":[{"paths":["\/documentation\/traffluent\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"metadata":{"roleHeading":"Article","role":"article","title":"Getting Started","modules":[{"name":"Traffluent"}]},"references":{"doc://Traffluent/documentation/Traffluent/ConsentGating":{"url":"\/documentation\/traffluent\/consentgating","title":"Consent Gating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"url":"\/documentation\/traffluent\/testingwhatyoutrack","title":"Testing What Your Code Tracks","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","role":"collection","url":"\/documentation\/traffluent","title":"Traffluent","kind":"symbol","type":"topic","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","role":"article","url":"\/documentation\/traffluent\/trackingevents","title":"Tracking Events","kind":"article","type":"topic","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"url":"\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","role":"article","url":"\/documentation\/traffluent\/trackingfromviews","title":"Tracking from SwiftUI, UIKit and AppKit","kind":"article","type":"topic","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","url":"\/documentation\/traffluent\/choosingdestinations","role":"article","kind":"article","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"url":"\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","role":"article","type":"topic"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"url":"\/documentation\/posthogencoding","title":"PostHogEncoding","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","abstract":[{"text":"Write batches of records for PostHog’s batch capture API, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"url":"\/documentation\/traffluent\/sessionsandstandardcontext","title":"Sessions and Standard Context","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"url":"\/documentation\/traffluent\/definingevents","title":"Defining Events","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","role":"article","type":"topic"},"https://github.com/Tyler-Keith-Thompson/Traffluent/tree/main/Examples":{"titleInlineContent":[{"code":"Examples","type":"codeVoice"}],"type":"link","title":"Examples","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","identifier":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples"}}}