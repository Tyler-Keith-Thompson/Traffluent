{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"Traffluent"}],"role":"article","title":"Getting Started"},"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"generated":true}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This walkthrough builds the analytics of a small store app, one step at a time. The code comes","type":"text"},{"text":" ","type":"text"},{"text":"from the store app in the package’s","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","type":"reference","isActive":true},{"text":", cut down","type":"text"},{"text":" ","type":"text"},{"text":"where the app does more than a step needs. Run that app to see every step working together","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Examples\/README.md","type":"codeVoice"},{"text":" says how). Each step links to the guide that covers it in full.","type":"text"}]},{"text":"Add the package","type":"heading","level":3,"anchor":"Add-the-package"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add Traffluent to your package’s dependencies:"}]},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\", from: \"0.0.37\"),","],"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Then add products to your targets. ","type":"text"},{"code":"Traffluent","type":"codeVoice"},{"text":" imports almost every module. ","type":"text"},{"code":"TrackingPlans","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which the delivery below needs, and ","type":"text"},{"code":"TrackerTesting","type":"codeVoice"},{"text":", for tests, are products of their own:","type":"text"}]},{"code":[".target(name: \"MyApp\", dependencies: [","    .product(name: \"Traffluent\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","]),",".testTarget(name: \"MyAppTests\", dependencies: [","    \"MyApp\",","    .product(name: \"TrackerTesting\", package: \"Traffluent\"),","]),"],"type":"codeListing","syntax":"swift"},{"text":"Declare the events","type":"heading","level":3,"anchor":"Declare-the-events"},{"type":"paragraph","inlineContent":[{"text":"Declare each event as a struct marked ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":", with a fixed name, which is what servers and","type":"text"},{"text":" ","type":"text"},{"text":"stored records know it by. A property can carry constraints the tracker checks before anything","type":"text"},{"text":" ","type":"text"},{"text":"else, and a personal value is ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":", which a destination can leave out with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"text":":","type":"text"}]},{"code":["import Traffluent","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart: Equatable {","    @Constrained(.pattern(\"^[a-z0-9]+(-[a-z0-9]+)*$\", example: \"canvas-tote\"))","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\", consent: .functional)","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","    var referrer: String?","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"ProductAddedToCart","type":"codeVoice"},{"text":" with a quantity of 0 is rejected and never delivered. ","type":"text"},{"code":"SignedUp","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"collected for the ","type":"text"},{"code":"functional","type":"codeVoice"},{"text":" consent category; events are ","type":"text"},{"code":"analytics","type":"codeVoice"},{"text":" unless they say otherwise.","type":"text"},{"text":" ","type":"text"},{"text":"Its email address is ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":", so the tracking plan never requires it, and a record whose email","type":"text"},{"text":" ","type":"text"},{"text":"a destination left out still matches the plan. The store app declares its events in a module of their own, ","type":"text"},{"code":"StoreEvents","type":"codeVoice"},{"text":". See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"reference"},{"text":".","type":"text"}]},{"text":"Build the tracker","type":"heading","level":3,"anchor":"Build-the-tracker"},{"type":"paragraph","inlineContent":[{"text":"Build one tracker where the app starts. A ","type":"text"},{"code":"SegmentStore","type":"codeVoice"},{"text":" keeps each record on disk until it is","type":"text"},{"text":" ","type":"text"},{"text":"delivered, so events tracked just before the app ends are sent on the next launch. A ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":" ","type":"text"},{"text":"holds each event until the user grants its category. The enrichers stamp every event with its","type":"text"},{"text":" ","type":"text"},{"text":"session and with the app, device, operating system, locale and network it was tracked on:","type":"text"}]},{"code":["let consent = Consent(savedDecisions)","let store = try SegmentStore(events: [","    ProductAddedToCart.self,","    SignedUp.self,","    ScreenViewed.self,","    SessionStarted.self,","    SessionEnded.self,","])","let tracker = Tracker(","    store: store,","    consent: consent,","    enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()]",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Consent"},{"type":"text","text":" keeps decisions in memory only. "},{"type":"codeVoice","code":"savedDecisions"},{"type":"text","text":" is what the user chose at an earlier"},{"type":"text","text":" "},{"type":"text","text":"launch, which the app saved (the store app’s "},{"type":"codeVoice","code":"ConsentPreferences"},{"type":"text","text":" saves them to a file). The store"},{"type":"text","text":" "},{"type":"text","text":"lists the events the library tracks for the app too: screen views and the sessions’ start and end."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","isActive":true},{"type":"text","text":"."}]},{"text":"Make the tracker reachable","type":"heading","level":3,"anchor":"Make-the-tracker-reachable"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Code that runs inside a task can read the tracker bound with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":":"}]},{"code":["withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"plus\", email: Sensitive(\"ada@example.com\"), referrer: nil))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Code that no binding reaches, such as a detached task, finds the tracker through"},{"type":"text","text":" "},{"code":"Tracker.current","type":"codeVoice"},{"type":"text","text":" only once it is the process’s default. Make it the default once, as the app"},{"type":"text","text":" "},{"type":"text","text":"starts, in your "},{"code":"App","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"init()","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["try Tracker.bootstrap(tracker)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A second call throws "},{"type":"codeVoice","code":"TrackerAlreadyBootstrapped"},{"type":"text","text":" and leaves the first tracker in place, and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" binding still wins inside its scope."}]},{"type":"paragraph","inlineContent":[{"text":"The binding doesn’t reach callbacks that a framework runs itself, such as a SwiftUI button’s","type":"text"},{"text":" ","type":"text"},{"text":"action, and views don’t read ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":". They read the tracker from the environment","type":"text"},{"text":" ","type":"text"},{"text":"instead, so set it at the root of the views, in your ","type":"text"},{"code":"App","type":"codeVoice"},{"text":"’s body:","type":"text"}]},{"code":["WindowGroup {","    StoreView()","        .tracker(tracker)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The store app also turns on lifecycle tracking as it launches, which tracks opens and moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"reference"},{"text":"). See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"reference"},{"text":".","type":"text"}]},{"text":"Track from code and from views","type":"heading","level":3,"anchor":"Track-from-code-and-from-views"},{"type":"paragraph","inlineContent":[{"text":"Code that changes something worth tracking takes the tracker it tracks through. The store’s cart","type":"text"},{"text":" ","type":"text"},{"text":"tracks ","type":"text"},{"code":"ProductAddedToCart","type":"codeVoice"},{"text":" as a product goes in, and throws before tracking anything when the","type":"text"},{"text":" ","type":"text"},{"text":"quantity is out of range:","type":"text"}]},{"code":["struct Product: Identifiable, Hashable {","    var id: String","    var name: String","    var priceInCents: Int","","    static let catalog = [","        Product(id: \"canvas-tote\", name: \"Canvas Tote\", priceInCents: 2_400),","        Product(id: \"enamel-mug\", name: \"Enamel Mug\", priceInCents: 1_800),","    ]","}","","struct QuantityOutOfRange: Error, Equatable {}","","struct Cart {","    struct Line: Equatable {","        var product: Product","        var quantity: Int","    }","","    private(set) var lines: [Line] = []","","    static let quantities = 1...10","","    mutating func add(_ product: Product, quantity: Int = 1, trackingWith tracker: Tracker) throws(QuantityOutOfRange) {","        guard Self.quantities.contains(quantity) else { throw QuantityOutOfRange() }","        lines.append(Line(product: product, quantity: quantity))","        tracker.track(ProductAddedToCart(productID: product.id, quantity: quantity))","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A view reads the tracker from the environment and hands it to the cart. ","type":"text"},{"type":"codeVoice","code":"trackScreen(_:)"},{"text":", applied","type":"text"},{"text":" ","type":"text"},{"text":"where a screen’s view is placed, tracks ","type":"text"},{"type":"codeVoice","code":"ScreenViewed"},{"text":" each time it appears and stamps the events","type":"text"},{"text":" ","type":"text"},{"text":"tracked inside it with the screen’s name:","type":"text"}]},{"code":["struct StoreView: View {","    @State private var cart = Cart()","","    var body: some View {","        NavigationStack {","            List(Product.catalog) { product in","                NavigationLink(product.name) {","                    ProductView(product: product, cart: $cart)","                        .trackScreen(\"Product\")","                }","            }","            .trackScreen(\"Catalog\")","        }","    }","}","","struct ProductView: View {","    let product: Product","    @Binding var cart: Cart","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            \/\/ The default quantity, 1, is in range, so the cart never refuses it.","            try? cart.add(product, trackingWith: tracker)","        }","        .navigationTitle(product.name)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"UIKit and AppKit find the tracker through a trait and the responder chain. See","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","isActive":true},{"text":", and ","type":"text"},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true},{"text":" for screens and controls that track","type":"text"},{"text":" ","type":"text"},{"text":"themselves.","type":"text"}]},{"text":"Deliver to a server","type":"heading","level":3,"anchor":"Deliver-to-a-server"},{"type":"paragraph","inlineContent":[{"text":"A delivery batches the tracker’s records and hands each batch to its destinations. To send them","type":"text"},{"text":" ","type":"text"},{"text":"to a TraffluentCollector, deliver to an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"writes each record’s properties through the event’s schema in a ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":". The plan lists","type":"text"},{"text":" ","type":"text"},{"text":"every event the tracker can see, the library’s included. ","type":"text"},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"text":" keeps the","type":"text"},{"text":" ","type":"text"},{"text":"email address off this destination:","type":"text"}]},{"code":["import TrackingPlans","","let plan = try TrackingPlan(schemas: [","    ProductAddedToCart.schema,","    SignedUp.schema,","    ScreenViewed.schema,","    SessionStarted.schema,","    SessionEnded.schema,","])","let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: CollectorBatchEncoder(plan: plan))","let (bufferDrops, bufferDropReporter) = AsyncStream.makeStream(of: BufferDropReport.self)","let delivery = tracker.records","    .batch()","    .deliver(to: collector.redactingSensitiveValues(), bufferDropReporter: bufferDropReporter)","let delivering = Task { try await delivery.execute() }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"batch()"},{"type":"text","text":" sends 20 records at a time, or every 30 seconds while any are waiting. Nothing runs until"},{"type":"text","text":" "},{"type":"codeVoice","code":"execute()"},{"type":"text","text":", and the delivery runs for as long as the tracker does, so start it once and keep the"},{"type":"text","text":" "},{"type":"text","text":"task if the app needs to stop it. A send that gets no response, a 5xx, 408 or 429 is sent again with backoff"},{"type":"text","text":" "},{"type":"text","text":"until it arrives, and the store keeps its records meanwhile. To send to PostHog instead, give the"},{"type":"text","text":" "},{"type":"text","text":"destination a "},{"type":"codeVoice","code":"PostHogBatchEncoder"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"reference","isActive":true},{"type":"text","text":"). See "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"reference","isActive":true},{"type":"text","text":"."}]},{"text":"Watch what is dropped","type":"heading","level":3,"anchor":"Watch-what-is-dropped"},{"type":"paragraph","inlineContent":[{"text":"Each event that doesn’t reach the server shows up in a report. The tracker reports a broken","type":"text"},{"text":" ","type":"text"},{"text":"constraint, the consent a denied category, the store a record it couldn’t keep, the destination a","type":"text"},{"text":" ","type":"text"},{"text":"batch the server refused, and the delivery a batch its full buffer dropped. Read every report in","type":"text"},{"text":" ","type":"text"},{"text":"one task:","type":"text"}]},{"code":["let rejections = tracker.rejectionReports","let consentDrops = consent.dropReports","let storeDrops = store.dropReports","let collectorDrops = collector.dropReports","Task {","    await withDiscardingTaskGroup { group in","        group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","        group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","        group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","        group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        group.addTask { for await report in bufferDrops { print(\"Buffer full: \\(report)\") } }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each stream has one reader. The task reads the streams, not their owners, so it keeps no store or"},{"type":"text","text":" "},{"type":"text","text":"destination alive. The store app merges them into one stream of its own type, "},{"type":"codeVoice","code":"AnalyticsDrop"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"logs each one."}]},{"text":"Export and check the tracking plan","type":"heading","level":3,"anchor":"Export-and-check-the-tracking-plan"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan is a JSON Schema document for each event, committed beside the code, that the"},{"type":"text","text":" "},{"type":"text","text":"people and services reading the events can review. A small executable that lists the plan above"},{"type":"text","text":" "},{"type":"text","text":"writes it, and a check fails when the events no longer match it:"}]},{"code":["swift package --allow-writing-to-package-directory export-tracking-plan","swift package check-tracking-plan"],"type":"codeListing","syntax":"sh"},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"reference"},{"text":" for the executable, the check from a test and catching breaking","type":"text"},{"text":" ","type":"text"},{"text":"changes in CI.","type":"text"}]},{"text":"Test what the code tracks","type":"heading","level":3,"anchor":"Test-what-the-code-tracks"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" runs a test’s body with a fresh tracker and returns what it tracked, so"},{"type":"text","text":" "},{"type":"text","text":"tests running at the same time never see each other’s events:"}]},{"code":["import Testing","import TrackerTesting","","@Test(\"Adding a product tracks ProductAddedToCart with its identifier and the quantity\")","func add() async throws {","    let tote = Product(id: \"canvas-tote\", name: \"Canvas Tote\", priceInCents: 2_400)","    var sut = Cart()","    let expectedEvents = [ProductAddedToCart(productID: \"canvas-tote\", quantity: 2)]","    let expectedLines = [Cart.Line(product: tote, quantity: 2)]","","    let tracked = try await withRecordingTracker { tracker in","        try sut.add(tote, quantity: 2, trackingWith: tracker)","    }","","    #expect(tracked.events(of: ProductAddedToCart.self) == expectedEvents)","    #expect(sut.lines == expectedLines)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},{"type":"text","text":"."}]}],"kind":"content"}],"sections":[],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/gettingstarted"]}],"abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"references":{"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"type":"topic","kind":"article","role":"article","title":"Sessions and Standard Context","url":"\/documentation\/traffluent\/sessionsandstandardcontext","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"type":"topic","kind":"article","role":"article","title":"Choosing Destinations","url":"\/documentation\/traffluent\/choosingdestinations","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"type":"topic","kind":"article","role":"article","title":"Persisting Records","url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"title":"Tracking Events","role":"article","type":"topic","url":"\/documentation\/traffluent\/trackingevents","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"title":"Testing What Your Code Tracks","role":"article","type":"topic","url":"\/documentation\/traffluent\/testingwhatyoutrack","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","kind":"article"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"type":"topic","kind":"article","role":"article","title":"Defining Events","url":"\/documentation\/traffluent\/definingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}]},"doc://PostHogEncoding/documentation/PostHogEncoding":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","url":"\/documentation\/posthogencoding","type":"topic","title":"PostHogEncoding","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Write batches of records for PostHog’s batch capture API, for an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" to send."}]},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"title":"Exporting and Checking a Tracking Plan","role":"article","type":"topic","url":"\/documentation\/traffluent\/trackingplanworkflow","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","kind":"article"},"https://github.com/Tyler-Keith-Thompson/Traffluent/tree/main/Examples":{"titleInlineContent":[{"code":"Examples","type":"codeVoice"}],"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","type":"link","identifier":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","title":"Examples"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"type":"topic","kind":"article","role":"article","title":"Consent Gating","url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","url":"\/documentation\/traffluent\/trackingfromviews","title":"Tracking from SwiftUI, UIKit and AppKit","type":"topic","kind":"article","role":"article","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}]},"doc://Traffluent/documentation/Traffluent":{"abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"title":"Traffluent","role":"collection","type":"topic","url":"\/documentation\/traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"type":"topic","kind":"article","role":"article","title":"Automatic Tracking","url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}]}}}