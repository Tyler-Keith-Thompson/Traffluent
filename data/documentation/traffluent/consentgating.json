{"variants":[{"paths":["\/documentation\/traffluent\/consentgating"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"title":"Guides","anchor":"Guides","generated":true}],"metadata":{"modules":[{"name":"Traffluent"}],"title":"Consent Gating","role":"article","roleHeading":"Article"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each event type names the purpose it is collected for, its ","type":"text"},{"code":"consentCategory","type":"codeVoice"},{"text":", which is ","type":"text"},{"code":".analytics","type":"codeVoice"},{"text":" ","type":"text"},{"text":"unless its ","type":"text"},{"code":"@Event(consent:)","type":"codeVoice"},{"text":" says otherwise. Give the tracker a ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":", which the app updates as the user","type":"text"},{"text":" ","type":"text"},{"text":"decides, and an event reaches a destination only once its category is granted:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Event(consent: .advertising)","struct AdClicked {","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"]},{"type":"paragraph","inlineContent":[{"text":"A tracker given no consent delivers every event.","type":"text"}]},{"text":"Undecided, granted and denied","type":"heading","level":3,"anchor":"Undecided-granted-and-denied"},{"type":"paragraph","inlineContent":[{"text":"A category is undecided until the app grants or denies it. While it is undecided, its events are","type":"text"},{"text":" ","type":"text"},{"text":"held in memory, not written to a store, up to ","type":"text"},{"type":"codeVoice","code":"heldRecordLimit"},{"text":" records (1,000 by default) across","type":"text"},{"text":" ","type":"text"},{"text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while","type":"text"},{"text":" ","type":"text"},{"text":"their category is denied are never collected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"grant"},{"type":"text","text":" and "},{"type":"codeVoice","code":"deny"},{"type":"text","text":" return at once: they record the decision, and the tracker’s worker releases or"},{"type":"text","text":" "},{"type":"text","text":"drops what it held. Every drop of a record that was held or kept is reported on"},{"type":"text","text":" "},{"type":"codeVoice","code":"consent.dropReports"},{"type":"text","text":" as a "},{"type":"codeVoice","code":"ConsentDropReport"},{"type":"text","text":" as it happens, so none is lost silently. Held"},{"type":"text","text":" "},{"type":"text","text":"records are lost if the app ends first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are"},{"type":"text","text":" "},{"type":"text","text":"held outside the bound, since the store still keeps them, and the store forgets each one that is"},{"type":"text","text":" "},{"type":"text","text":"denied."}]},{"text":"Destinations","type":"heading","level":3,"anchor":"Destinations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A destination receives every category the consent lets through, unless "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":" narrows it"},{"type":"text","text":" "},{"type":"text","text":"to the categories it serves, as the second destination above takes only advertising."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"references":{"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"kind":"article","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","url":"\/documentation\/traffluent\/samplingevents","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"type":"topic","title":"Sampling Events"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","url":"\/documentation\/traffluent\/definingevents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"type":"topic","title":"Defining Events","kind":"article","role":"article"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","url":"\/documentation\/traffluent\/sessionsandstandardcontext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"type":"topic","title":"Sessions and Standard Context","kind":"article","role":"article"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"type":"topic","title":"Persisting Records"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","url":"\/documentation\/traffluent\/automatictracking","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"type":"topic","title":"Automatic Tracking","kind":"article","role":"article"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"kind":"article","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","url":"\/documentation\/traffluent\/trackingplanworkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"type":"topic","title":"Exporting and Checking a Tracking Plan"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","role":"collection","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","url":"\/documentation\/traffluent","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"type":"topic","title":"Traffluent"}}}