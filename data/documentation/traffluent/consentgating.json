{"kind":"article","variants":[{"paths":["\/documentation\/traffluent\/consentgating"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Each event type names the purpose it is collected for, its ","type":"text"},{"code":"consentCategory","type":"codeVoice"},{"text":", which is ","type":"text"},{"code":".analytics","type":"codeVoice"},{"text":" ","type":"text"},{"text":"unless its ","type":"text"},{"code":"@Event(consent:)","type":"codeVoice"},{"text":" says otherwise. Give the tracker a ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":", which the app updates as the user","type":"text"},{"text":" ","type":"text"},{"text":"decides, and an event reaches a destination only once its category is granted:","type":"text"}],"type":"paragraph"},{"code":["@Event(consent: .advertising)","struct AdClicked {","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A tracker given no consent delivers every event."}],"type":"paragraph"},{"anchor":"Undecided-granted-and-denied","text":"Undecided, granted and denied","type":"heading","level":3},{"inlineContent":[{"text":"A category is undecided until the app grants or denies it. While it is undecided, its events are","type":"text"},{"text":" ","type":"text"},{"text":"held in memory, not written to a store, up to ","type":"text"},{"code":"heldRecordLimit","type":"codeVoice"},{"text":" records (1,000 by default) across","type":"text"},{"text":" ","type":"text"},{"text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while","type":"text"},{"text":" ","type":"text"},{"text":"their category is denied are never collected.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"grant","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"deny","type":"codeVoice"},{"text":" return at once: they record the decision, and the tracker’s worker releases or","type":"text"},{"text":" ","type":"text"},{"text":"drops what it held. Every drop of a record that was held or kept is reported on","type":"text"},{"text":" ","type":"text"},{"code":"consent.dropReports","type":"codeVoice"},{"text":" as a ","type":"text"},{"code":"ConsentDropReport","type":"codeVoice"},{"text":" as it happens, so none is lost silently. Held","type":"text"},{"text":" ","type":"text"},{"text":"records are lost if the app ends first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are"},{"type":"text","text":" "},{"type":"text","text":"held outside the bound, since the store still keeps them, and the store forgets each one that is"},{"type":"text","text":" "},{"type":"text","text":"denied."}],"type":"paragraph"},{"anchor":"Destinations","text":"Destinations","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A destination receives every category the consent lets through, unless "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":" narrows it"},{"type":"text","text":" "},{"type":"text","text":"to the categories it serves, as the second destination above takes only advertising."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","interfaceLanguage":"swift"},"metadata":{"role":"article","modules":[{"name":"Traffluent"}],"title":"Consent Gating","roleHeading":"Article"},"abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"]}],"sections":[],"references":{"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"kind":"article","type":"topic","url":"\/documentation\/traffluent\/definingevents","title":"Defining Events","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}]},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"type":"topic","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"kind":"article","url":"\/documentation\/traffluent\/samplingevents","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","title":"Sampling Events"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"url":"\/documentation\/traffluent\/trackingplanworkflow","kind":"article","type":"topic","title":"Exporting and Checking a Tracking Plan","role":"article","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"url":"\/documentation\/traffluent","role":"collection","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","type":"topic","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"url":"\/documentation\/traffluent\/persistingrecords","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","title":"Persisting Records"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"type":"topic","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"kind":"article","url":"\/documentation\/traffluent\/automatictracking","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","title":"Automatic Tracking"},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"url":"\/documentation\/traffluent\/writingavendordestination","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","title":"Writing a Vendor Destination"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"kind":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","type":"topic","title":"Sessions and Standard Context","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}]}}}