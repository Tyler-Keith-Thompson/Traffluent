{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"]}],"kind":"article","variants":[{"paths":["\/documentation\/traffluent\/consentgating"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event type names the purpose it is collected for, its "},{"code":"consentCategory","type":"codeVoice"},{"type":"text","text":", which is "},{"code":".analytics","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"unless its "},{"code":"@Event(consent:)","type":"codeVoice"},{"type":"text","text":" says otherwise. Give the tracker a "},{"code":"Consent","type":"codeVoice"},{"type":"text","text":", which the app updates as the user"},{"type":"text","text":" "},{"type":"text","text":"decides, and an event reaches a destination only once its category is granted:"}]},{"syntax":"swift","type":"codeListing","code":["@Event(consent: .advertising)","struct AdClicked {","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"]},{"type":"paragraph","inlineContent":[{"text":"A tracker given no consent delivers every event.","type":"text"}]},{"type":"heading","level":3,"text":"Undecided, granted and denied","anchor":"Undecided-granted-and-denied"},{"type":"paragraph","inlineContent":[{"text":"A category is undecided until the app grants or denies it. While it is undecided, its events are","type":"text"},{"text":" ","type":"text"},{"text":"held in memory, not written to a store, up to ","type":"text"},{"code":"heldRecordLimit","type":"codeVoice"},{"text":" records (1,000 by default) across","type":"text"},{"text":" ","type":"text"},{"text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while","type":"text"},{"text":" ","type":"text"},{"text":"their category is denied are never collected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"grant","type":"codeVoice"},{"type":"text","text":" and "},{"code":"deny","type":"codeVoice"},{"type":"text","text":" return at once: they record the decision, and the tracker’s worker releases or"},{"type":"text","text":" "},{"type":"text","text":"drops what it held. Every drop of a record that was held or kept is reported on"},{"type":"text","text":" "},{"code":"consent.dropReports","type":"codeVoice"},{"type":"text","text":" as a "},{"code":"ConsentDropReport","type":"codeVoice"},{"type":"text","text":" as it happens, so none is lost silently. Held"},{"type":"text","text":" "},{"type":"text","text":"records are lost if the app ends first."}]},{"type":"paragraph","inlineContent":[{"text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are","type":"text"},{"text":" ","type":"text"},{"text":"held outside the bound, since the store still keeps them, and the store forgets each one that is","type":"text"},{"text":" ","type":"text"},{"text":"denied.","type":"text"}]},{"type":"heading","level":3,"text":"Destinations","anchor":"Destinations"},{"type":"paragraph","inlineContent":[{"text":"A destination receives every category the consent lets through, unless ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":" narrows it","type":"text"},{"text":" ","type":"text"},{"text":"to the categories it serves, as the second destination above takes only advertising.","type":"text"}]}],"kind":"content"}],"metadata":{"roleHeading":"Article","title":"Consent Gating","role":"article","modules":[{"name":"Traffluent"}]},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"references":{"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"title":"Defining Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","url":"\/documentation\/traffluent\/definingevents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"url":"\/documentation\/traffluent\/writingavendordestination","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","title":"Writing a Vendor Destination","type":"topic","abstract":[{"text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships.","type":"text"}],"role":"article"},"doc://Traffluent/documentation/Traffluent":{"url":"\/documentation\/traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","type":"topic","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"title":"Traffluent","role":"collection"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"topic","url":"\/documentation\/traffluent\/trackingplanworkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"url":"\/documentation\/traffluent\/samplingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","kind":"article","title":"Sampling Events","type":"topic","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"role":"article"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"url":"\/documentation\/traffluent\/sessionsandstandardcontext","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","kind":"article","title":"Sessions and Standard Context","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"type":"topic","role":"article"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","kind":"article","title":"Automatic Tracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"type":"topic","role":"article"}}}