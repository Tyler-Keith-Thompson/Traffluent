{"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"],"anchor":"Guides","generated":true}],"metadata":{"role":"article","modules":[{"name":"Traffluent"}],"roleHeading":"Article","title":"Consent Gating"},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each event type names the purpose it is collected for, its "},{"type":"codeVoice","code":"consentCategory"},{"type":"text","text":", which is "},{"type":"codeVoice","code":".analytics"},{"type":"text","text":" "},{"type":"text","text":"unless its "},{"type":"codeVoice","code":"@Event(consent:)"},{"type":"text","text":" says otherwise. Give the tracker a "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":", which the app updates as the user"},{"type":"text","text":" "},{"type":"text","text":"decides, and an event reaches a destination only once its category is granted:"}],"type":"paragraph"},{"code":["@Event(consent: .advertising)","struct AdClicked {","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A tracker given no consent delivers every event."}],"type":"paragraph"},{"anchor":"Undecided-granted-and-denied","text":"Undecided, granted and denied","level":3,"type":"heading"},{"inlineContent":[{"text":"A category is undecided until the app grants or denies it. While it is undecided, its events are","type":"text"},{"text":" ","type":"text"},{"text":"held in memory, not written to a store, up to ","type":"text"},{"code":"heldRecordLimit","type":"codeVoice"},{"text":" records (1,000 by default) across","type":"text"},{"text":" ","type":"text"},{"text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while","type":"text"},{"text":" ","type":"text"},{"text":"their category is denied are never collected.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"grant","type":"codeVoice"},{"type":"text","text":" and "},{"code":"deny","type":"codeVoice"},{"type":"text","text":" return at once: they record the decision, and the tracker’s worker releases or"},{"type":"text","text":" "},{"type":"text","text":"drops what it held. Every drop of a record that was held or kept is reported on"},{"type":"text","text":" "},{"code":"consent.dropReports","type":"codeVoice"},{"type":"text","text":" as a "},{"code":"ConsentDropReport","type":"codeVoice"},{"type":"text","text":" as it happens, so none is lost silently. Held"},{"type":"text","text":" "},{"type":"text","text":"records are lost if the app ends first."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are"},{"type":"text","text":" "},{"type":"text","text":"held outside the bound, since the store still keeps them, and the store forgets each one that is"},{"type":"text","text":" "},{"type":"text","text":"denied."}],"type":"paragraph"},{"anchor":"Destinations","text":"Destinations","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A destination receives every category the consent lets through, unless "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":" narrows it"},{"type":"text","text":" "},{"type":"text","text":"to the categories it serves, as the second destination above takes only advertising."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"variants":[{"paths":["\/documentation\/traffluent\/consentgating"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"references":{"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"role":"article","title":"Sessions and Standard Context","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","url":"\/documentation\/traffluent\/sessionsandstandardcontext","kind":"article","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}]},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"type":"topic","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"url":"\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","kind":"article","role":"article"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","title":"Automatic Tracking","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"kind":"article","role":"article"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"role":"article","title":"Sampling Events","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"kind":"article","url":"\/documentation\/traffluent\/samplingevents"},"doc://Traffluent/documentation/Traffluent":{"role":"collection","title":"Traffluent","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","url":"\/documentation\/traffluent","kind":"symbol","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"role":"article","title":"Defining Events","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","url":"\/documentation\/traffluent\/definingevents","kind":"article","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}]},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"role":"article","type":"topic","title":"Writing a Vendor Destination","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"kind":"article","url":"\/documentation\/traffluent\/writingavendordestination"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"type":"topic","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"url":"\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","kind":"article","role":"article"}}}