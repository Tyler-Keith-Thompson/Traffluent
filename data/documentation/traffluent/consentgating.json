{"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event type names the purpose it is collected for, its "},{"type":"codeVoice","code":"consentCategory"},{"type":"text","text":", which is "},{"type":"codeVoice","code":".analytics"},{"type":"text","text":" "},{"type":"text","text":"unless its "},{"type":"codeVoice","code":"@Event(consent:)"},{"type":"text","text":" says otherwise. Give the tracker a "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":", which the app updates as the user"},{"type":"text","text":" "},{"type":"text","text":"decides, and an event reaches a destination only once its category is granted:"}]},{"syntax":"swift","code":["@Event(consent: .advertising)","struct AdClicked {","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracker given no consent delivers every event."}]},{"text":"Undecided, granted and denied","anchor":"Undecided-granted-and-denied","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A category is undecided until the app grants or denies it. While it is undecided, its events are"},{"type":"text","text":" "},{"type":"text","text":"held in memory, not written to a store, up to "},{"type":"codeVoice","code":"heldRecordLimit"},{"type":"text","text":" records (1,000 by default) across"},{"type":"text","text":" "},{"type":"text","text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order"},{"type":"text","text":" "},{"type":"text","text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while"},{"type":"text","text":" "},{"type":"text","text":"their category is denied are never collected."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"grant"},{"type":"text","text":" and "},{"type":"codeVoice","code":"deny"},{"type":"text","text":" return at once: they record the decision, and the tracker’s worker releases or"},{"type":"text","text":" "},{"type":"text","text":"drops what it held. Every drop of a record that was held or kept is reported on"},{"type":"text","text":" "},{"type":"codeVoice","code":"consent.dropReports"},{"type":"text","text":" as a "},{"type":"codeVoice","code":"ConsentDropReport"},{"type":"text","text":" as it happens, so none is lost silently. Held"},{"type":"text","text":" "},{"type":"text","text":"records are lost if the app ends first."}]},{"type":"paragraph","inlineContent":[{"text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are","type":"text"},{"text":" ","type":"text"},{"text":"held outside the bound, since the store still keeps them, and the store forgets each one that is","type":"text"},{"text":" ","type":"text"},{"text":"denied.","type":"text"}]},{"text":"Destinations","anchor":"Destinations","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A destination receives every category the consent lets through, unless "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":" narrows it"},{"type":"text","text":" "},{"type":"text","text":"to the categories it serves, as the second destination above takes only advertising."}]}]}],"sections":[],"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"],"generated":true}],"kind":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Article","role":"article","title":"Consent Gating"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/consentgating"]}],"references":{"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","kind":"symbol","role":"collection","url":"\/documentation\/traffluent","type":"topic","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"url":"\/documentation\/traffluent\/persistingrecords","role":"article","kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","title":"Persisting Records"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"url":"\/documentation\/traffluent\/automatictracking","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","title":"Automatic Tracking"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","kind":"article","role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","type":"topic","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"url":"\/documentation\/traffluent\/sessionsandstandardcontext","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","title":"Sessions and Standard Context"},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"url":"\/documentation\/traffluent\/writingavendordestination","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","title":"Writing a Vendor Destination"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"url":"\/documentation\/traffluent\/definingevents","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","title":"Defining Events"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","kind":"article","role":"article","url":"\/documentation\/traffluent\/samplingevents","type":"topic","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"}}}