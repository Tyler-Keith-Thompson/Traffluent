{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/traffluent\/consentgating"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Traffluent"}],"title":"Consent Gating","role":"article","roleHeading":"Article"},"abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"anchor":"Guides","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Each event type names the purpose it is collected for, its "},{"type":"codeVoice","code":"consentCategory"},{"type":"text","text":", which is "},{"type":"codeVoice","code":".analytics"},{"type":"text","text":" "},{"type":"text","text":"unless its "},{"type":"codeVoice","code":"@Event(consent:)"},{"type":"text","text":" says otherwise. Give the tracker a "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":", which the app updates as the user"},{"type":"text","text":" "},{"type":"text","text":"decides, and an event reaches a destination only once its category is granted:"}],"type":"paragraph"},{"code":["@Event(consent: .advertising)","struct AdClicked {","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A tracker given no consent delivers every event."}],"type":"paragraph"},{"level":3,"text":"Undecided, granted and denied","anchor":"Undecided-granted-and-denied","type":"heading"},{"inlineContent":[{"type":"text","text":"A category is undecided until the app grants or denies it. While it is undecided, its events are"},{"type":"text","text":" "},{"type":"text","text":"held in memory, not written to a store, up to "},{"type":"codeVoice","code":"heldRecordLimit"},{"type":"text","text":" records (1,000 by default) across"},{"type":"text","text":" "},{"type":"text","text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order"},{"type":"text","text":" "},{"type":"text","text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while"},{"type":"text","text":" "},{"type":"text","text":"their category is denied are never collected."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"grant"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"deny"},{"text":" return at once: they record the decision, and the tracker’s worker releases or","type":"text"},{"text":" ","type":"text"},{"text":"drops what it held. Every drop of a record that was held or kept is reported on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"consent.dropReports"},{"text":" as a ","type":"text"},{"type":"codeVoice","code":"ConsentDropReport"},{"text":" as it happens, so none is lost silently. Held","type":"text"},{"text":" ","type":"text"},{"text":"records are lost if the app ends first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are","type":"text"},{"text":" ","type":"text"},{"text":"held outside the bound, since the store still keeps them, and the store forgets each one that is","type":"text"},{"text":" ","type":"text"},{"text":"denied.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Destinations","anchor":"Destinations","type":"heading"},{"inlineContent":[{"text":"A destination receives every category the consent lets through, unless ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":" narrows it","type":"text"},{"text":" ","type":"text"},{"text":"to the categories it serves, as the second destination above takes only advertising.","type":"text"}],"type":"paragraph"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"sections":[],"references":{"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/persistingrecords"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"title":"Defining Events","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"url":"\/documentation\/traffluent\/definingevents","role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","kind":"article","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","role":"article","type":"topic","url":"\/documentation\/traffluent\/samplingevents"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"url":"\/documentation\/traffluent\/trackingplanworkflow","role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","kind":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"role":"article","type":"topic","url":"\/documentation\/traffluent\/automatictracking"},"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"url":"\/documentation\/traffluent","role":"collection","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"url":"\/documentation\/traffluent\/sessionsandstandardcontext","role":"article","kind":"article"}}}