{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/traffluent\/consentgating"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Traffluent"}],"title":"Consent Gating"},"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event type names the purpose it is collected for, its "},{"type":"codeVoice","code":"consentCategory"},{"type":"text","text":", which is "},{"type":"codeVoice","code":".analytics"},{"type":"text","text":" "},{"type":"text","text":"unless its "},{"type":"codeVoice","code":"@Event(consent:)"},{"type":"text","text":" says otherwise. Give the tracker a "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":", which the app updates as the user"},{"type":"text","text":" "},{"type":"text","text":"decides, and an event reaches a destination only once its category is granted:"}]},{"code":["@Event(consent: .advertising)","struct AdClicked {","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracker given no consent delivers every event."}]},{"text":"Undecided, granted and denied","type":"heading","level":3,"anchor":"Undecided-granted-and-denied"},{"type":"paragraph","inlineContent":[{"text":"A category is undecided until the app grants or denies it. While it is undecided, its events are","type":"text"},{"text":" ","type":"text"},{"text":"held in memory, not written to a store, up to ","type":"text"},{"code":"heldRecordLimit","type":"codeVoice"},{"text":" records (1,000 by default) across","type":"text"},{"text":" ","type":"text"},{"text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while","type":"text"},{"text":" ","type":"text"},{"text":"their category is denied are never collected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"grant"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"deny"},{"text":" return at once: they record the decision, and the tracker’s worker releases or","type":"text"},{"text":" ","type":"text"},{"text":"drops what it held. Every drop of a record that was held or kept is reported on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"consent.dropReports"},{"text":" as a ","type":"text"},{"type":"codeVoice","code":"ConsentDropReport"},{"text":" as it happens, so none is lost silently. Held","type":"text"},{"text":" ","type":"text"},{"text":"records are lost if the app ends first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are"},{"type":"text","text":" "},{"type":"text","text":"held outside the bound, since the store still keeps them, and the store forgets each one that is"},{"type":"text","text":" "},{"type":"text","text":"denied."}]},{"text":"Destinations","type":"heading","level":3,"anchor":"Destinations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A destination receives every category the consent lets through, unless "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":" narrows it"},{"type":"text","text":" "},{"type":"text","text":"to the categories it serves, as the second destination above takes only advertising."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"]}],"references":{"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","kind":"article","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"type":"topic","url":"\/documentation\/traffluent\/sessionsandstandardcontext","role":"article","title":"Sessions and Standard Context"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"role":"article","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"title":"Automatic Tracking","kind":"article","type":"topic","url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","kind":"article","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"type":"topic","url":"\/documentation\/traffluent\/persistingrecords","role":"article","title":"Persisting Records"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"role":"article","title":"Defining Events","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"kind":"article","type":"topic","url":"\/documentation\/traffluent\/definingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","kind":"symbol","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent","type":"topic","role":"collection","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"role":"article","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"title":"Sampling Events","kind":"article","type":"topic","url":"\/documentation\/traffluent\/samplingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","kind":"article","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"url":"\/documentation\/traffluent\/trackingplanworkflow","type":"topic","role":"article","title":"Exporting and Checking a Tracking Plan"}}}