{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/consentgating"]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"generated":true,"title":"Guides","anchor":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Each event type names the purpose it is collected for, its "},{"code":"consentCategory","type":"codeVoice"},{"type":"text","text":", which is "},{"code":".analytics","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"unless its "},{"code":"@Event(consent:)","type":"codeVoice"},{"type":"text","text":" says otherwise. Give the tracker a "},{"code":"Consent","type":"codeVoice"},{"type":"text","text":", which the app updates as the user"},{"type":"text","text":" "},{"type":"text","text":"decides, and an event reaches a destination only once its category is granted:"}],"type":"paragraph"},{"code":["@Event(consent: .advertising)","struct AdClicked {","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A tracker given no consent delivers every event."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Undecided, granted and denied","anchor":"Undecided-granted-and-denied"},{"inlineContent":[{"type":"text","text":"A category is undecided until the app grants or denies it. While it is undecided, its events are"},{"type":"text","text":" "},{"type":"text","text":"held in memory, not written to a store, up to "},{"type":"codeVoice","code":"heldRecordLimit"},{"type":"text","text":" records (1,000 by default) across"},{"type":"text","text":" "},{"type":"text","text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order"},{"type":"text","text":" "},{"type":"text","text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while"},{"type":"text","text":" "},{"type":"text","text":"their category is denied are never collected."}],"type":"paragraph"},{"inlineContent":[{"code":"grant","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"deny","type":"codeVoice"},{"text":" return at once: they record the decision, and the tracker’s worker releases or","type":"text"},{"text":" ","type":"text"},{"text":"drops what it held. Every drop of a record that was held or kept is reported on","type":"text"},{"text":" ","type":"text"},{"code":"consent.dropReports","type":"codeVoice"},{"text":" as a ","type":"text"},{"code":"ConsentDropReport","type":"codeVoice"},{"text":" as it happens, so none is lost silently. Held","type":"text"},{"text":" ","type":"text"},{"text":"records are lost if the app ends first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are","type":"text"},{"text":" ","type":"text"},{"text":"held outside the bound, since the store still keeps them, and the store forgets each one that is","type":"text"},{"text":" ","type":"text"},{"text":"denied.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Destinations","anchor":"Destinations"},{"inlineContent":[{"type":"text","text":"A destination receives every category the consent lets through, unless "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":" narrows it"},{"type":"text","text":" "},{"type":"text","text":"to the categories it serves, as the second destination above takes only advertising."}],"type":"paragraph"}]}],"metadata":{"title":"Consent Gating","modules":[{"name":"Traffluent"}],"role":"article","roleHeading":"Article"},"abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"kind":"article","references":{"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","url":"\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking","role":"article"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","url":"\/documentation\/traffluent\/definingevents","title":"Defining Events","role":"article"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","type":"topic","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"role":"article","url":"\/documentation\/traffluent\/samplingevents","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","type":"topic","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"role":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"type":"topic","kind":"article","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","url":"\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","role":"article"},"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","type":"topic","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"role":"collection","url":"\/documentation\/traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","type":"topic","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"}}}