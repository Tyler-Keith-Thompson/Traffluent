{"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"metadata":{"roleHeading":"Article","title":"Consent Gating","role":"article","modules":[{"name":"Traffluent"}]},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"generated":true,"title":"Guides","anchor":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each event type names the purpose it is collected for, its ","type":"text"},{"code":"consentCategory","type":"codeVoice"},{"text":", which is ","type":"text"},{"code":".analytics","type":"codeVoice"},{"text":" ","type":"text"},{"text":"unless the type says otherwise. Give the tracker a ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":", which the app updates as the user","type":"text"},{"text":" ","type":"text"},{"text":"decides, and an event reaches a destination only once its category is granted:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct AdClicked: Event {","    static let consentCategory = ConsentCategory.advertising","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracker given no consent delivers every event."}]},{"type":"heading","anchor":"Undecided-granted-and-denied","level":3,"text":"Undecided, granted and denied"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A category is undecided until the app grants or denies it. While it is undecided, its events are"},{"type":"text","text":" "},{"type":"text","text":"held in memory, not written to a store, up to "},{"type":"codeVoice","code":"heldRecordLimit"},{"type":"text","text":" records (1,000 by default) across"},{"type":"text","text":" "},{"type":"text","text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order"},{"type":"text","text":" "},{"type":"text","text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while"},{"type":"text","text":" "},{"type":"text","text":"their category is denied are never collected."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"grant"},{"type":"text","text":" and "},{"type":"codeVoice","code":"deny"},{"type":"text","text":" return at once: they record the decision, and the tracker’s worker releases or"},{"type":"text","text":" "},{"type":"text","text":"drops what it held. Every drop of a record that was held or kept is reported on"},{"type":"text","text":" "},{"type":"codeVoice","code":"consent.dropReports"},{"type":"text","text":" as a "},{"type":"codeVoice","code":"ConsentDropReport"},{"type":"text","text":" as it happens, so none is lost silently. Held"},{"type":"text","text":" "},{"type":"text","text":"records are lost if the app ends first."}]},{"type":"paragraph","inlineContent":[{"text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are","type":"text"},{"text":" ","type":"text"},{"text":"held outside the bound, since the store still keeps them, and the store forgets each one that is","type":"text"},{"text":" ","type":"text"},{"text":"denied.","type":"text"}]},{"type":"heading","anchor":"Destinations","level":3,"text":"Destinations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A destination receives every category the consent lets through, unless "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":" narrows it"},{"type":"text","text":" "},{"type":"text","text":"to the categories it serves, as the second destination above takes only advertising."}]}]}],"kind":"article","variants":[{"paths":["\/documentation\/traffluent\/consentgating"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"references":{"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","role":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","kind":"article","title":"Sessions and Standard Context","type":"topic","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}]},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"kind":"article","url":"\/documentation\/traffluent\/definingevents","type":"topic","role":"article","title":"Defining Events"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","role":"collection","url":"\/documentation\/traffluent","kind":"symbol","title":"Traffluent","type":"topic","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}]},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","kind":"article","title":"Exporting and Checking a Tracking Plan","type":"topic","abstract":[{"text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","url":"\/documentation\/traffluent\/persistingrecords","type":"topic","role":"article","title":"Persisting Records"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"kind":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","url":"\/documentation\/traffluent\/automatictracking","type":"topic","role":"article","title":"Automatic Tracking"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","role":"article","url":"\/documentation\/traffluent\/samplingevents","kind":"article","title":"Sampling Events","type":"topic","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}]}}}