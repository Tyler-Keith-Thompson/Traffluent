{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/traffluent\/consentgating"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Consent Gating","modules":[{"name":"Traffluent"}],"roleHeading":"Article","role":"article"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each event type names the purpose it is collected for, its ","type":"text"},{"code":"consentCategory","type":"codeVoice"},{"text":", which is ","type":"text"},{"code":".analytics","type":"codeVoice"},{"text":" ","type":"text"},{"text":"unless the type says otherwise. Give the tracker a ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":", which the app updates as the user","type":"text"},{"text":" ","type":"text"},{"text":"decides, and an event reaches a destination only once its category is granted:","type":"text"}]},{"code":["struct AdClicked: Event {","    static let consentCategory = ConsentCategory.advertising","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A tracker given no consent delivers every event.","type":"text"}]},{"level":3,"type":"heading","text":"Undecided, granted and denied","anchor":"Undecided-granted-and-denied"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A category is undecided until the app grants or denies it. While it is undecided, its events are"},{"type":"text","text":" "},{"type":"text","text":"held in memory, not written to a store, up to "},{"code":"heldRecordLimit","type":"codeVoice"},{"type":"text","text":" records (1,000 by default) across"},{"type":"text","text":" "},{"type":"text","text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order"},{"type":"text","text":" "},{"type":"text","text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while"},{"type":"text","text":" "},{"type":"text","text":"their category is denied are never collected."}]},{"type":"paragraph","inlineContent":[{"code":"grant","type":"codeVoice"},{"type":"text","text":" and "},{"code":"deny","type":"codeVoice"},{"type":"text","text":" return at once: they record the decision, and the tracker’s worker releases or"},{"type":"text","text":" "},{"type":"text","text":"drops what it held. Every drop of a record that was held or kept is reported on"},{"type":"text","text":" "},{"code":"consent.dropReports","type":"codeVoice"},{"type":"text","text":" as a "},{"code":"ConsentDropReport","type":"codeVoice"},{"type":"text","text":" as it happens, so none is lost silently. Held"},{"type":"text","text":" "},{"type":"text","text":"records are lost if the app ends first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are"},{"type":"text","text":" "},{"type":"text","text":"held outside the bound, since the store still keeps them, and the store forgets each one that is"},{"type":"text","text":" "},{"type":"text","text":"denied."}]},{"level":3,"type":"heading","text":"Destinations","anchor":"Destinations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A destination receives every category the consent lets through, unless "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":" narrows it"},{"type":"text","text":" "},{"type":"text","text":"to the categories it serves, as the second destination above takes only advertising."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"seeAlsoSections":[{"title":"Guides","anchor":"Guides","generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"]}],"kind":"article","references":{"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"type":"topic","url":"\/documentation\/traffluent\/samplingevents","kind":"article"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"type":"topic","url":"\/documentation\/traffluent\/trackingplanworkflow","kind":"article"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent","role":"collection","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","type":"topic","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"type":"topic","url":"\/documentation\/traffluent\/automatictracking","kind":"article"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"url":"\/documentation\/traffluent\/persistingrecords","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","title":"Persisting Records"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"type":"topic","url":"\/documentation\/traffluent\/sessionsandstandardcontext","kind":"article"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"title":"Defining Events","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"type":"topic","url":"\/documentation\/traffluent\/definingevents","kind":"article"}}}