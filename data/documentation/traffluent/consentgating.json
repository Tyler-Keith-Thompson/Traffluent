{"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","interfaceLanguage":"swift"},"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/consentgating"]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Traffluent"}],"title":"Consent Gating"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each event type names the purpose it is collected for, its "},{"type":"codeVoice","code":"consentCategory"},{"type":"text","text":", which is "},{"type":"codeVoice","code":".analytics"},{"type":"text","text":" "},{"type":"text","text":"unless its "},{"type":"codeVoice","code":"@Event(consent:)"},{"type":"text","text":" says otherwise. Give the tracker a "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":", which the app updates as the user"},{"type":"text","text":" "},{"type":"text","text":"decides, and an event reaches a destination only once its category is granted:"}],"type":"paragraph"},{"syntax":"swift","code":["@Event(consent: .advertising)","struct AdClicked {","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A tracker given no consent delivers every event."}],"type":"paragraph"},{"text":"Undecided, granted and denied","anchor":"Undecided-granted-and-denied","level":3,"type":"heading"},{"inlineContent":[{"text":"A category is undecided until the app grants or denies it. While it is undecided, its events are","type":"text"},{"text":" ","type":"text"},{"text":"held in memory, not written to a store, up to ","type":"text"},{"code":"heldRecordLimit","type":"codeVoice"},{"text":" records (1,000 by default) across","type":"text"},{"text":" ","type":"text"},{"text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while","type":"text"},{"text":" ","type":"text"},{"text":"their category is denied are never collected.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"grant","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"deny","type":"codeVoice"},{"text":" return at once: they record the decision, and the tracker’s worker releases or","type":"text"},{"text":" ","type":"text"},{"text":"drops what it held. Every drop of a record that was held or kept is reported on","type":"text"},{"text":" ","type":"text"},{"code":"consent.dropReports","type":"codeVoice"},{"text":" as a ","type":"text"},{"code":"ConsentDropReport","type":"codeVoice"},{"text":" as it happens, so none is lost silently. Held","type":"text"},{"text":" ","type":"text"},{"text":"records are lost if the app ends first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are","type":"text"},{"text":" ","type":"text"},{"text":"held outside the bound, since the store still keeps them, and the store forgets each one that is","type":"text"},{"text":" ","type":"text"},{"text":"denied.","type":"text"}],"type":"paragraph"},{"text":"Destinations","anchor":"Destinations","level":3,"type":"heading"},{"inlineContent":[{"text":"A destination receives every category the consent lets through, unless ","type":"text"},{"type":"codeVoice","code":"accepting(_:)"},{"text":" narrows it","type":"text"},{"text":" ","type":"text"},{"text":"to the categories it serves, as the second destination above takes only advertising.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"references":{"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"type":"topic","kind":"article","role":"article","title":"Sessions and Standard Context","url":"\/documentation\/traffluent\/sessionsandstandardcontext"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","kind":"article","type":"topic","title":"Sampling Events","url":"\/documentation\/traffluent\/samplingevents","role":"article","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":", and constrain which values its properties may hold.","type":"text"}],"type":"topic","kind":"article","role":"article","title":"Defining Events","url":"\/documentation\/traffluent\/definingevents"},"doc://Traffluent/documentation/Traffluent":{"url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","kind":"symbol","title":"Traffluent","type":"topic","role":"collection","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}]},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"type":"topic","kind":"article","role":"article","title":"Persisting Records","url":"\/documentation\/traffluent\/persistingrecords"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","title":"Automatic Tracking","role":"article","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"type":"topic","kind":"article","role":"article","title":"Exporting and Checking a Tracking Plan","url":"\/documentation\/traffluent\/trackingplanworkflow"}}}