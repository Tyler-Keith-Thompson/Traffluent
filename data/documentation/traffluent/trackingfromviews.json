{"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"None of these needs a global or swizzling. Each framework hands the tracker down its own view","type":"text"},{"text":" ","type":"text"},{"text":"hierarchy, so each scene or window can have a tracker of its own. In UIKit and AppKit the tracker is","type":"text"},{"text":" ","type":"text"},{"text":"found when an action fires, so a control moved to another window tracks through that window’s","type":"text"},{"text":" ","type":"text"},{"text":"tracker.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"SwiftUI","text":"SwiftUI"},{"inlineContent":[{"type":"text","text":"On Apple platforms, views read the tracker from the environment (module "},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"empty elsewhere). Set it at the root of the views with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", read it in any view with"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Environment(\\.tracker)"},{"type":"text","text":", and let modifiers track what views do:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","","struct PlanSelected: Event {","    var plan: String","}","","struct CheckoutView: View {","    @Environment(\\.tracker) private var tracker","    @State private var plan = \"free\"","","    var body: some View {","        Form {","            Picker(\"Plan\", selection: $plan) {","                Text(\"Free\").tag(\"free\")","                Text(\"Pro\").tag(\"pro\")","            }","            .trackChange(of: plan) { PlanSelected(plan: $0) }","            Button(\"Sign up\") {","                tracker.track(SignedUp(plan: plan))  \/\/ its record's context[ScreenKey.self] is \"Checkout\"","            }","        }","    }","}","","let tracker = Tracker()","let root = CheckoutView()","    .trackScreen(\"Checkout\")  \/\/ tracks ScreenViewed(screen: \"Checkout\") each time it appears","    .tracker(tracker)"]},{"inlineContent":[{"type":"text","text":"Each modifier tracks through the environment’s tracker, once per trigger, and records the place it"},{"type":"text","text":" "},{"type":"text","text":"is applied as the call site:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":" tracks its event each time the view appears, as "},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":" runs: again when a"},{"type":"text","text":" "},{"type":"text","text":"navigation stack pops back to it, but not when SwiftUI only redraws it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"trackOnTap(_:)","type":"codeVoice"},{"type":"text","text":" tracks each tap, beside the view’s own action."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" tracks the event it makes from each new value, but not from the first value"},{"type":"text","text":" "},{"type":"text","text":"or an equal one."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time the view appears. Inside the view, it puts a"},{"type":"text","text":" "},{"type":"text","text":"tracker enriched with the screen’s "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" in the environment, so the events tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen’s actions and modifiers carry its name."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Apply ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":" where the screen’s view is placed, as above. A view’s own ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" ","type":"text"},{"text":"reads the environment around the view, which the modifiers in its own body don’t change. Until a","type":"text"},{"text":" ","type":"text"},{"text":"tracker is set, the environment’s tracker is ","type":"text"},{"code":"Tracker.noOp","type":"codeVoice"},{"text":", so a preview tracks nothing.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"UIKit","text":"UIKit"},{"inlineContent":[{"type":"text","text":"In UIKit (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":": iOS, iPadOS, tvOS, visionOS and Mac Catalyst), the tracker is"},{"type":"text","text":" "},{"type":"text","text":"a trait. Set it on the window scene as it connects, and every view controller and view in the scene"},{"type":"text","text":" "},{"type":"text","text":"inherits it, as SwiftUI views inherit their environment. Read it in an action with"},{"type":"text","text":" "},{"type":"codeVoice","code":"traitCollection.tracker"},{"type":"text","text":", or let "},{"type":"codeVoice","code":"track(_:for:)"},{"type":"text","text":" track a control’s events:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import UIKit","","struct ShareTapped: Event {}","","final class CheckoutViewController: UIViewController {","    let share = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        share.addTarget(self, action: #selector(signUp(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","    }","","    @objc func signUp(_ sender: UIButton) {","        sender.traitCollection.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"]},{"inlineContent":[{"text":"A view controller can override the trait for the views below it, with a tracker ","type":"text"},{"code":"enriched(by:)","type":"codeVoice"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"screen’s name, say. ","type":"text"},{"code":"track(_:for:)","type":"codeVoice"},{"text":" adds a ","type":"text"},{"code":"UIAction","type":"codeVoice"},{"text":" beside the control’s other actions and","type":"text"},{"text":" ","type":"text"},{"text":"returns it, for ","type":"text"},{"code":"removeAction(_:for:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"AppKit","text":"AppKit"},{"inlineContent":[{"text":"In AppKit (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},{"text":", macOS), a view finds its tracker the way an action finds its","type":"text"},{"text":" ","type":"text"},{"text":"target. ","type":"text"},{"type":"codeVoice","code":"NSView.tracker"},{"text":" asks the view’s responder chain (its superviews and view controllers, its","type":"text"},{"text":" ","type":"text"},{"text":"window and window controller), then the window’s delegate and the application’s delegate, for the","type":"text"},{"text":" ","type":"text"},{"text":"first one that conforms to ","type":"text"},{"type":"codeVoice","code":"TrackerProviding"},{"text":". ","type":"text"},{"type":"codeVoice","code":"track(_:)"},{"text":" tracks an event each time a control","type":"text"},{"text":" ","type":"text"},{"text":"sends its action, just before the action:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import AppKit","","final class CheckoutWindowController: NSWindowController, TrackerProviding {","    let tracker: Tracker","","    init(window: NSWindow, tracker: Tracker) {","        self.tracker = tracker","        super.init(window: window)","    }","","    required init?(coder: NSCoder) { nil }","","    @objc func signUp(_ sender: NSButton) {","        sender.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","let share = NSButton(title: \"Share\", target: nil, action: nil)","share.track(ShareTapped())  \/\/ through the tracker of the window it is in when it is clicked"]},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"NSControl"},{"type":"text","text":" has one target and action, so "},{"type":"codeVoice","code":"track(_:)"},{"type":"text","text":" puts its own in their place and sends the"},{"type":"text","text":" "},{"type":"text","text":"control’s action on to its target, or up the responder chain when it had none. Call it after"},{"type":"text","text":" "},{"type":"text","text":"setting them."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Mixing-frameworks","text":"Mixing frameworks"},{"inlineContent":[{"text":"SwiftUI’s ","type":"text"},{"code":"\\.tracker","type":"codeVoice"},{"text":" and UIKit’s trait are one value. SwiftUI views hosted in UIKit read the","type":"text"},{"text":" ","type":"text"},{"text":"scene’s tracker, and UIKit views hosted in SwiftUI read the environment’s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To track screen views and control activations without a modifier or a call per control, see","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"variants":[{"paths":["\/documentation\/traffluent\/trackingfromviews"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"Traffluent"}],"role":"article","title":"Tracking from SwiftUI, UIKit and AppKit"},"kind":"article","references":{"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","role":"article","kind":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","url":"\/documentation\/traffluent\/automatictracking","type":"topic"},"doc://UIKitTracking/documentation/UIKitTracking":{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","kind":"symbol","type":"topic","abstract":[],"role":"collection","title":"UIKitTracking","url":"\/documentation\/uikittracking"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","kind":"article","type":"topic","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"role":"article","title":"Testing What Your Code Tracks","url":"\/documentation\/traffluent\/testingwhatyoutrack"},"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","role":"collection","kind":"symbol","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","url":"\/documentation\/traffluent","type":"topic"},"doc://AppKitTracking/documentation/AppKitTracking":{"title":"AppKitTracking","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","url":"\/documentation\/appkittracking","type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","kind":"article","type":"topic","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"role":"article","title":"Tracking Events","url":"\/documentation\/traffluent\/trackingevents"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","kind":"article","type":"topic","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"role":"article","title":"Choosing Destinations","url":"\/documentation\/traffluent\/choosingdestinations"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"title":"SwiftUITracking","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","url":"\/documentation\/swiftuitracking","type":"topic"}}}