{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/trackingfromviews"]}],"sections":[],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"None of these needs a global or swizzling. Each framework hands the tracker down its own view","type":"text"},{"text":" ","type":"text"},{"text":"hierarchy, so each scene or window can have a tracker of its own. In UIKit and AppKit the tracker is","type":"text"},{"text":" ","type":"text"},{"text":"found when an action fires, so a control moved to another window tracks through that window’s","type":"text"},{"text":" ","type":"text"},{"text":"tracker.","type":"text"}]},{"type":"heading","level":3,"anchor":"SwiftUI","text":"SwiftUI"},{"type":"paragraph","inlineContent":[{"text":"On Apple platforms, views read the tracker from the environment (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"empty elsewhere). Set it at the root of the views with ","type":"text"},{"type":"codeVoice","code":"tracker(_:)"},{"text":", read it in any view with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@Environment(\\.tracker)"},{"text":", and let modifiers track what views do:","type":"text"}]},{"type":"codeListing","code":["import SwiftUI","import Traffluent","","@Event","struct PlanSelected {","    var plan: String","}","","struct CheckoutView: View {","    @Environment(\\.tracker) private var tracker","    @State private var plan = \"free\"","","    var body: some View {","        Form {","            Picker(\"Plan\", selection: $plan) {","                Text(\"Free\").tag(\"free\")","                Text(\"Pro\").tag(\"pro\")","            }","            .trackChange(of: plan) { PlanSelected(plan: $0) }","            Button(\"Sign up\") {","                tracker.track(SignedUp(plan: plan))  \/\/ its record's context[ScreenKey.self] is \"Checkout\"","            }","        }","    }","}","","let tracker = Tracker()","let root = CheckoutView()","    .trackScreen(\"Checkout\")  \/\/ tracks ScreenViewed(screen: \"Checkout\") each time it appears","    .tracker(tracker)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each modifier tracks through the environment’s tracker, once per trigger, and records the place it","type":"text"},{"text":" ","type":"text"},{"text":"is applied as the call site:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackOnAppear(_:)"},{"text":" tracks its event each time the view appears, as ","type":"text"},{"type":"codeVoice","code":"onAppear"},{"text":" runs: again when a","type":"text"},{"text":" ","type":"text"},{"text":"navigation stack pops back to it, but not when SwiftUI only redraws it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" tracks each tap, beside the view’s own action."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"trackChange(of:_:)","type":"codeVoice"},{"text":" tracks the event it makes from each new value, but not from the first value","type":"text"},{"text":" ","type":"text"},{"text":"or an equal one.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"text":" tracks ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" each time the view appears. Inside the view, it puts a","type":"text"},{"text":" ","type":"text"},{"text":"tracker enriched with the screen’s ","type":"text"},{"code":"ScreenKey","type":"codeVoice"},{"text":" in the environment, so the events tracked from the","type":"text"},{"text":" ","type":"text"},{"text":"screen’s actions and modifiers carry its name.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" where the screen’s view is placed, as above. A view’s own "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" "},{"type":"text","text":"reads the environment around the view, which the modifiers in its own body don’t change. Until a"},{"type":"text","text":" "},{"type":"text","text":"tracker is set, the environment’s tracker is "},{"type":"codeVoice","code":"Tracker.noOp"},{"type":"text","text":", so a preview tracks nothing."}]},{"type":"heading","level":3,"anchor":"UIKit","text":"UIKit"},{"type":"paragraph","inlineContent":[{"text":"In UIKit (module ","type":"text"},{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"reference","isActive":true},{"text":": iOS, iPadOS, tvOS, visionOS and Mac Catalyst), the tracker is","type":"text"},{"text":" ","type":"text"},{"text":"a trait. Set it on the window scene as it connects, and every view controller and view in the scene","type":"text"},{"text":" ","type":"text"},{"text":"inherits it, as SwiftUI views inherit their environment. Read it in an action with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"traitCollection.tracker"},{"text":", or let ","type":"text"},{"type":"codeVoice","code":"track(_:for:)"},{"text":" track a control’s events:","type":"text"}]},{"type":"codeListing","code":["import Traffluent","import UIKit","","@Event","struct ShareTapped {}","","final class CheckoutViewController: UIViewController {","    let share = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        share.addTarget(self, action: #selector(signUp(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","    }","","    @objc func signUp(_ sender: UIButton) {","        sender.traitCollection.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A view controller can override the trait for the views below it, with a tracker "},{"type":"codeVoice","code":"enriched(by:)"},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"screen’s name, say. "},{"type":"codeVoice","code":"track(_:for:)"},{"type":"text","text":" adds a "},{"type":"codeVoice","code":"UIAction"},{"type":"text","text":" beside the control’s other actions and"},{"type":"text","text":" "},{"type":"text","text":"returns it, for "},{"type":"codeVoice","code":"removeAction(_:for:)"},{"type":"text","text":"."}]},{"type":"heading","level":3,"anchor":"AppKit","text":"AppKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In AppKit (module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},{"type":"text","text":", macOS), a view finds its tracker the way an action finds its"},{"type":"text","text":" "},{"type":"text","text":"target. "},{"type":"codeVoice","code":"NSView.tracker"},{"type":"text","text":" asks the view’s responder chain (its superviews and view controllers, its"},{"type":"text","text":" "},{"type":"text","text":"window and window controller), then the window’s delegate and the application’s delegate, for the"},{"type":"text","text":" "},{"type":"text","text":"first one that conforms to "},{"type":"codeVoice","code":"TrackerProviding"},{"type":"text","text":". "},{"type":"codeVoice","code":"track(_:)"},{"type":"text","text":" tracks an event each time a control"},{"type":"text","text":" "},{"type":"text","text":"sends its action, just before the action:"}]},{"type":"codeListing","code":["import AppKit","","final class CheckoutWindowController: NSWindowController, TrackerProviding {","    let tracker: Tracker","","    init(window: NSWindow, tracker: Tracker) {","        self.tracker = tracker","        super.init(window: window)","    }","","    required init?(coder: NSCoder) { nil }","","    @objc func signUp(_ sender: NSButton) {","        sender.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","let share = NSButton(title: \"Share\", target: nil, action: nil)","share.track(ShareTapped())  \/\/ through the tracker of the window it is in when it is clicked"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"NSControl"},{"text":" has one target and action, so ","type":"text"},{"type":"codeVoice","code":"track(_:)"},{"text":" puts its own in their place and sends the","type":"text"},{"text":" ","type":"text"},{"text":"control’s action on to its target, or up the responder chain when it had none. Call it after","type":"text"},{"text":" ","type":"text"},{"text":"setting them.","type":"text"}]},{"type":"heading","level":3,"anchor":"Mixing-frameworks","text":"Mixing frameworks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":"\\.tracker"},{"type":"text","text":" and UIKit’s trait are one value. SwiftUI views hosted in UIKit read the"},{"type":"text","text":" "},{"type":"text","text":"scene’s tracker, and UIKit views hosted in SwiftUI read the environment’s."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To track screen views and control activations without a modifier or a call per control, see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true},{"type":"text","text":"."}]}]}],"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Article","role":"article","title":"Tracking from SwiftUI, UIKit and AppKit"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"kind":"article","references":{"doc://Traffluent/documentation/Traffluent/GettingStarted":{"type":"topic","url":"\/documentation\/traffluent\/gettingstarted","role":"article","title":"Getting Started","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}]},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"type":"topic","url":"\/documentation\/traffluent\/trackingevents","role":"article","title":"Tracking Events","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}]},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"type":"topic","url":"\/documentation\/traffluent\/automatictracking","role":"article","kind":"article","title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}]},"doc://UIKitTracking/documentation/UIKitTracking":{"type":"topic","url":"\/documentation\/uikittracking","role":"collection","title":"UIKitTracking","kind":"symbol","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}]},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"type":"topic","url":"\/documentation\/traffluent\/choosingdestinations","role":"article","title":"Choosing Destinations","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"title":"Testing What Your Code Tracks","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","kind":"article","type":"topic","role":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack"},"doc://AppKitTracking/documentation/AppKitTracking":{"url":"\/documentation\/appkittracking","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","title":"AppKitTracking","role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent":{"url":"\/documentation\/traffluent","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","role":"collection","type":"topic","kind":"symbol"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"url":"\/documentation\/swiftuitracking","abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","title":"SwiftUITracking","role":"collection","type":"topic","kind":"symbol"}}}