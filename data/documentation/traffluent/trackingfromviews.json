{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"variants":[{"paths":["\/documentation\/traffluent\/trackingfromviews"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","title":"Tracking from SwiftUI, UIKit and AppKit","modules":[{"name":"Traffluent"}],"roleHeading":"Article"},"abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"None of these needs a global or swizzling. Each framework hands the tracker down its own view"},{"type":"text","text":" "},{"type":"text","text":"hierarchy, so each scene or window can have a tracker of its own. In UIKit and AppKit the tracker is"},{"type":"text","text":" "},{"type":"text","text":"found when an action fires, so a control moved to another window tracks through that window’s"},{"type":"text","text":" "},{"type":"text","text":"tracker."}]},{"text":"SwiftUI","type":"heading","anchor":"SwiftUI","level":3},{"type":"paragraph","inlineContent":[{"text":"On Apple platforms, views read the tracker from the environment (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"empty elsewhere). Set it at the root of the views with ","type":"text"},{"type":"codeVoice","code":"tracker(_:)"},{"text":", read it in any view with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@Environment(\\.tracker)"},{"text":", and let modifiers track what views do:","type":"text"}]},{"syntax":"swift","code":["import SwiftUI","","struct PlanSelected: Event {","    var plan: String","}","","struct CheckoutView: View {","    @Environment(\\.tracker) private var tracker","    @State private var plan = \"free\"","","    var body: some View {","        Form {","            Picker(\"Plan\", selection: $plan) {","                Text(\"Free\").tag(\"free\")","                Text(\"Pro\").tag(\"pro\")","            }","            .trackChange(of: plan) { PlanSelected(plan: $0) }","            Button(\"Sign up\") {","                tracker.track(SignedUp(plan: plan))  \/\/ its record's context[ScreenKey.self] is \"Checkout\"","            }","        }","    }","}","","let tracker = Tracker()","let root = CheckoutView()","    .trackScreen(\"Checkout\")  \/\/ tracks ScreenViewed(screen: \"Checkout\") each time it appears","    .tracker(tracker)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Each modifier tracks through the environment’s tracker, once per trigger, and records the place it","type":"text"},{"text":" ","type":"text"},{"text":"is applied as the call site:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"trackOnAppear(_:)","type":"codeVoice"},{"text":" tracks its event each time the view appears, as ","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":" runs: again when a","type":"text"},{"text":" ","type":"text"},{"text":"navigation stack pops back to it, but not when SwiftUI only redraws it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" tracks each tap, beside the view’s own action."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" tracks the event it makes from each new value, but not from the first value"},{"type":"text","text":" "},{"type":"text","text":"or an equal one."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"text":" tracks ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" each time the view appears. Inside the view, it puts a","type":"text"},{"text":" ","type":"text"},{"text":"tracker enriched with the screen’s ","type":"text"},{"code":"ScreenKey","type":"codeVoice"},{"text":" in the environment, so the events tracked from the","type":"text"},{"text":" ","type":"text"},{"text":"screen’s actions and modifiers carry its name.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Apply ","type":"text"},{"code":"trackScreen(_:)","type":"codeVoice"},{"text":" where the screen’s view is placed, as above. A view’s own ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" ","type":"text"},{"text":"reads the environment around the view, which the modifiers in its own body don’t change. Until a","type":"text"},{"text":" ","type":"text"},{"text":"tracker is set, the environment’s tracker is ","type":"text"},{"code":"Tracker.noOp","type":"codeVoice"},{"text":", so a preview tracks nothing.","type":"text"}]},{"text":"UIKit","type":"heading","anchor":"UIKit","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"In UIKit (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":": iOS, iPadOS, tvOS, visionOS and Mac Catalyst), the tracker is"},{"type":"text","text":" "},{"type":"text","text":"a trait. Set it on the window scene as it connects, and every view controller and view in the scene"},{"type":"text","text":" "},{"type":"text","text":"inherits it, as SwiftUI views inherit their environment. Read it in an action with"},{"type":"text","text":" "},{"type":"codeVoice","code":"traitCollection.tracker"},{"type":"text","text":", or let "},{"type":"codeVoice","code":"track(_:for:)"},{"type":"text","text":" track a control’s events:"}]},{"syntax":"swift","code":["import UIKit","","struct ShareTapped: Event {}","","final class CheckoutViewController: UIViewController {","    let share = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        share.addTarget(self, action: #selector(signUp(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","    }","","    @objc func signUp(_ sender: UIButton) {","        sender.traitCollection.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A view controller can override the trait for the views below it, with a tracker "},{"type":"codeVoice","code":"enriched(by:)"},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"screen’s name, say. "},{"type":"codeVoice","code":"track(_:for:)"},{"type":"text","text":" adds a "},{"type":"codeVoice","code":"UIAction"},{"type":"text","text":" beside the control’s other actions and"},{"type":"text","text":" "},{"type":"text","text":"returns it, for "},{"type":"codeVoice","code":"removeAction(_:for:)"},{"type":"text","text":"."}]},{"text":"AppKit","type":"heading","anchor":"AppKit","level":3},{"type":"paragraph","inlineContent":[{"text":"In AppKit (module ","type":"text"},{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"reference","isActive":true},{"text":", macOS), a view finds its tracker the way an action finds its","type":"text"},{"text":" ","type":"text"},{"text":"target. ","type":"text"},{"code":"NSView.tracker","type":"codeVoice"},{"text":" asks the view’s responder chain (its superviews and view controllers, its","type":"text"},{"text":" ","type":"text"},{"text":"window and window controller), then the window’s delegate and the application’s delegate, for the","type":"text"},{"text":" ","type":"text"},{"text":"first one that conforms to ","type":"text"},{"code":"TrackerProviding","type":"codeVoice"},{"text":". ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"text":" tracks an event each time a control","type":"text"},{"text":" ","type":"text"},{"text":"sends its action, just before the action:","type":"text"}]},{"syntax":"swift","code":["import AppKit","","final class CheckoutWindowController: NSWindowController, TrackerProviding {","    let tracker: Tracker","","    init(window: NSWindow, tracker: Tracker) {","        self.tracker = tracker","        super.init(window: window)","    }","","    required init?(coder: NSCoder) { nil }","","    @objc func signUp(_ sender: NSButton) {","        sender.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","let share = NSButton(title: \"Share\", target: nil, action: nil)","share.track(ShareTapped())  \/\/ through the tracker of the window it is in when it is clicked"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"NSControl","type":"codeVoice"},{"text":" has one target and action, so ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"text":" puts its own in their place and sends the","type":"text"},{"text":" ","type":"text"},{"text":"control’s action on to its target, or up the responder chain when it had none. Call it after","type":"text"},{"text":" ","type":"text"},{"text":"setting them.","type":"text"}]},{"text":"Mixing frameworks","type":"heading","anchor":"Mixing-frameworks","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":"\\.tracker"},{"type":"text","text":" and UIKit’s trait are one value. SwiftUI views hosted in UIKit read the"},{"type":"text","text":" "},{"type":"text","text":"scene’s tracker, and UIKit views hosted in SwiftUI read the environment’s."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To track screen views and control activations without a modifier or a call per control, see"},{"type":"text","text":" "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true,"type":"reference"},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"doc://AppKitTracking/documentation/AppKitTracking":{"kind":"symbol","url":"\/documentation\/appkittracking","role":"collection","abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}],"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"topic","title":"AppKitTracking"},"doc://UIKitTracking/documentation/UIKitTracking":{"url":"\/documentation\/uikittracking","type":"topic","role":"collection","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","kind":"symbol","title":"UIKitTracking","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"kind":"article","url":"\/documentation\/traffluent\/choosingdestinations","role":"article","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"topic","title":"Choosing Destinations"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","kind":"article","role":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","title":"Automatic Tracking"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"url":"\/documentation\/swiftuitracking","kind":"symbol","role":"collection","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"topic","title":"SwiftUITracking"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"url":"\/documentation\/traffluent\/testingwhatyoutrack","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","kind":"article","title":"Testing What Your Code Tracks","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}]},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","url":"\/documentation\/traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","role":"collection","title":"Traffluent","type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent\/trackingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","role":"article","title":"Tracking Events","type":"topic"}}}