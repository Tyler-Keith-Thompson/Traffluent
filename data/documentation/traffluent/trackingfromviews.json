{"metadata":{"role":"article","modules":[{"name":"Traffluent"}],"roleHeading":"Article","title":"Tracking from SwiftUI, UIKit and AppKit"},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"sections":[],"kind":"article","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"seeAlsoSections":[{"generated":true,"anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"title":"Essentials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/trackingfromviews"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"None of these needs a global or swizzling. Each framework hands the tracker down its own view","type":"text"},{"text":" ","type":"text"},{"text":"hierarchy, so each scene or window can have a tracker of its own. In UIKit and AppKit the tracker is","type":"text"},{"text":" ","type":"text"},{"text":"found when an action fires, so a control moved to another window tracks through that window’s","type":"text"},{"text":" ","type":"text"},{"text":"tracker.","type":"text"}],"type":"paragraph"},{"text":"SwiftUI","level":3,"type":"heading","anchor":"SwiftUI"},{"inlineContent":[{"type":"text","text":"On Apple platforms, views read the tracker from the environment (module "},{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"empty elsewhere). Set it at the root of the views with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", read it in any view with"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Environment(\\.tracker)"},{"type":"text","text":", and let modifiers track what views do:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import Traffluent","","@Event","struct PlanSelected {","    var plan: String","}","","struct CheckoutView: View {","    @Environment(\\.tracker) private var tracker","    @State private var plan = \"free\"","","    var body: some View {","        Form {","            Picker(\"Plan\", selection: $plan) {","                Text(\"Free\").tag(\"free\")","                Text(\"Pro\").tag(\"pro\")","            }","            .trackChange(of: plan) { PlanSelected(plan: $0) }","            Button(\"Sign up\") {","                tracker.track(SignedUp(plan: plan))  \/\/ its record's context[ScreenKey.self] is \"Checkout\"","            }","        }","    }","}","","let tracker = Tracker()","let root = CheckoutView()","    .trackScreen(\"Checkout\")  \/\/ tracks ScreenViewed(screen: \"Checkout\") each time it appears","    .tracker(tracker)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each modifier tracks through the environment’s tracker, once per trigger, and records the place it"},{"type":"text","text":" "},{"type":"text","text":"is applied as the call site:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":" tracks its event each time the view appears, as "},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":" runs: again when a"},{"type":"text","text":" "},{"type":"text","text":"navigation stack pops back to it, but not when SwiftUI only redraws it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" tracks each tap, beside the view’s own action."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" tracks the event it makes from each new value, but not from the first value"},{"type":"text","text":" "},{"type":"text","text":"or an equal one."}]}]},{"content":[{"inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"text":" tracks ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" each time the view appears. Inside the view, it puts a","type":"text"},{"text":" ","type":"text"},{"text":"tracker enriched with the screen’s ","type":"text"},{"code":"ScreenKey","type":"codeVoice"},{"text":" in the environment, so the events tracked from the","type":"text"},{"text":" ","type":"text"},{"text":"screen’s actions and modifiers carry its name.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Apply ","type":"text"},{"type":"codeVoice","code":"trackScreen(_:)"},{"text":" where the screen’s view is placed, as above. A view’s own ","type":"text"},{"type":"codeVoice","code":"@Environment"},{"text":" ","type":"text"},{"text":"reads the environment around the view, which the modifiers in its own body don’t change. Until a","type":"text"},{"text":" ","type":"text"},{"text":"tracker is set, the environment’s tracker is ","type":"text"},{"type":"codeVoice","code":"Tracker.noOp"},{"text":", so a preview tracks nothing.","type":"text"}],"type":"paragraph"},{"text":"UIKit","level":3,"type":"heading","anchor":"UIKit"},{"inlineContent":[{"type":"text","text":"In UIKit (module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":": iOS, iPadOS, tvOS, visionOS and Mac Catalyst), the tracker is"},{"type":"text","text":" "},{"type":"text","text":"a trait. Set it on the window scene as it connects, and every view controller and view in the scene"},{"type":"text","text":" "},{"type":"text","text":"inherits it, as SwiftUI views inherit their environment. Read it in an action with"},{"type":"text","text":" "},{"type":"codeVoice","code":"traitCollection.tracker"},{"type":"text","text":", or let "},{"type":"codeVoice","code":"track(_:for:)"},{"type":"text","text":" track a control’s events:"}],"type":"paragraph"},{"syntax":"swift","code":["import Traffluent","import UIKit","","@Event","struct ShareTapped {}","","final class CheckoutViewController: UIViewController {","    let share = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        share.addTarget(self, action: #selector(signUp(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","    }","","    @objc func signUp(_ sender: UIButton) {","        sender.traitCollection.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A view controller can override the trait for the views below it, with a tracker "},{"type":"codeVoice","code":"enriched(by:)"},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"screen’s name, say. "},{"type":"codeVoice","code":"track(_:for:)"},{"type":"text","text":" adds a "},{"type":"codeVoice","code":"UIAction"},{"type":"text","text":" beside the control’s other actions and"},{"type":"text","text":" "},{"type":"text","text":"returns it, for "},{"type":"codeVoice","code":"removeAction(_:for:)"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"AppKit","level":3,"type":"heading","anchor":"AppKit"},{"inlineContent":[{"text":"In AppKit (module ","type":"text"},{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","isActive":true,"type":"reference"},{"text":", macOS), a view finds its tracker the way an action finds its","type":"text"},{"text":" ","type":"text"},{"text":"target. ","type":"text"},{"code":"NSView.tracker","type":"codeVoice"},{"text":" asks the view’s responder chain (its superviews and view controllers, its","type":"text"},{"text":" ","type":"text"},{"text":"window and window controller), then the window’s delegate and the application’s delegate, for the","type":"text"},{"text":" ","type":"text"},{"text":"first one that conforms to ","type":"text"},{"code":"TrackerProviding","type":"codeVoice"},{"text":". ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"text":" tracks an event each time a control","type":"text"},{"text":" ","type":"text"},{"text":"sends its action, just before the action:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import AppKit","","final class CheckoutWindowController: NSWindowController, TrackerProviding {","    let tracker: Tracker","","    init(window: NSWindow, tracker: Tracker) {","        self.tracker = tracker","        super.init(window: window)","    }","","    required init?(coder: NSCoder) { nil }","","    @objc func signUp(_ sender: NSButton) {","        sender.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","let share = NSButton(title: \"Share\", target: nil, action: nil)","share.track(ShareTapped())  \/\/ through the tracker of the window it is in when it is clicked"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"An "},{"code":"NSControl","type":"codeVoice"},{"type":"text","text":" has one target and action, so "},{"code":"track(_:)","type":"codeVoice"},{"type":"text","text":" puts its own in their place and sends the"},{"type":"text","text":" "},{"type":"text","text":"control’s action on to its target, or up the responder chain when it had none. Call it after"},{"type":"text","text":" "},{"type":"text","text":"setting them."}],"type":"paragraph"},{"text":"Mixing frameworks","level":3,"type":"heading","anchor":"Mixing-frameworks"},{"inlineContent":[{"type":"text","text":"SwiftUI’s "},{"type":"codeVoice","code":"\\.tracker"},{"type":"text","text":" and UIKit’s trait are one value. SwiftUI views hosted in UIKit read the"},{"type":"text","text":" "},{"type":"text","text":"scene’s tracker, and UIKit views hosted in SwiftUI read the environment’s."}],"type":"paragraph"},{"inlineContent":[{"text":"To track screen views and control activations without a modifier or a call per control, see","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","kind":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"role":"article","type":"topic","url":"\/documentation\/traffluent\/automatictracking"},"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"url":"\/documentation\/traffluent","role":"collection","kind":"symbol"},"doc://UIKitTracking/documentation/UIKitTracking":{"title":"UIKitTracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","kind":"symbol","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"role":"collection","type":"topic","url":"\/documentation\/uikittracking"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"title":"SwiftUITracking","type":"topic","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","abstract":[{"text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers.","type":"text"}],"url":"\/documentation\/swiftuitracking","role":"collection","kind":"symbol"},"doc://AppKitTracking/documentation/AppKitTracking":{"title":"AppKitTracking","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/appkittracking"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"title":"Testing What Your Code Tracks","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"url":"\/documentation\/traffluent\/testingwhatyoutrack","role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"role":"article","type":"topic","url":"\/documentation\/traffluent\/choosingdestinations"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"title":"Tracking Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/trackingevents"}}}