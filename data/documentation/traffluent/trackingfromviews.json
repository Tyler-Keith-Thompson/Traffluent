{"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"anchor":"Essentials","generated":true,"title":"Essentials"}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","interfaceLanguage":"swift"},"kind":"article","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/trackingfromviews"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"role":"article","title":"Tracking from SwiftUI, UIKit and AppKit","roleHeading":"Article","modules":[{"name":"Traffluent"}]},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"None of these needs a global or swizzling. Each framework hands the tracker down its own view","type":"text"},{"text":" ","type":"text"},{"text":"hierarchy, so each scene or window can have a tracker of its own. In UIKit and AppKit the tracker is","type":"text"},{"text":" ","type":"text"},{"text":"found when an action fires, so a control moved to another window tracks through that window’s","type":"text"},{"text":" ","type":"text"},{"text":"tracker.","type":"text"}]},{"type":"heading","anchor":"SwiftUI","level":3,"text":"SwiftUI"},{"type":"paragraph","inlineContent":[{"text":"On Apple platforms, views read the tracker from the environment (module ","type":"text"},{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"empty elsewhere). Set it at the root of the views with ","type":"text"},{"code":"tracker(_:)","type":"codeVoice"},{"text":", read it in any view with","type":"text"},{"text":" ","type":"text"},{"code":"@Environment(\\.tracker)","type":"codeVoice"},{"text":", and let modifiers track what views do:","type":"text"}]},{"type":"codeListing","code":["import SwiftUI","import Traffluent","","@Event","struct PlanSelected {","    var plan: String","}","","struct CheckoutView: View {","    @Environment(\\.tracker) private var tracker","    @State private var plan = \"free\"","","    var body: some View {","        Form {","            Picker(\"Plan\", selection: $plan) {","                Text(\"Free\").tag(\"free\")","                Text(\"Pro\").tag(\"pro\")","            }","            .trackChange(of: plan) { PlanSelected(plan: $0) }","            Button(\"Sign up\") {","                tracker.track(SignedUp(plan: plan))  \/\/ its record's context[ScreenKey.self] is \"Checkout\"","            }","        }","    }","}","","let tracker = Tracker()","let root = CheckoutView()","    .trackScreen(\"Checkout\")  \/\/ tracks ScreenViewed(screen: \"Checkout\") each time it appears","    .tracker(tracker)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each modifier tracks through the environment’s tracker, once per trigger, and records the place it"},{"type":"text","text":" "},{"type":"text","text":"is applied as the call site:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":" tracks its event each time the view appears, as "},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":" runs: again when a"},{"type":"text","text":" "},{"type":"text","text":"navigation stack pops back to it, but not when SwiftUI only redraws it."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"trackOnTap(_:)"},{"text":" tracks each tap, beside the view’s own action.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" tracks the event it makes from each new value, but not from the first value"},{"type":"text","text":" "},{"type":"text","text":"or an equal one."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"type":"text","text":" tracks "},{"code":"ScreenViewed","type":"codeVoice"},{"type":"text","text":" each time the view appears. Inside the view, it puts a"},{"type":"text","text":" "},{"type":"text","text":"tracker enriched with the screen’s "},{"code":"ScreenKey","type":"codeVoice"},{"type":"text","text":" in the environment, so the events tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen’s actions and modifiers carry its name."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Apply ","type":"text"},{"type":"codeVoice","code":"trackScreen(_:)"},{"text":" where the screen’s view is placed, as above. A view’s own ","type":"text"},{"type":"codeVoice","code":"@Environment"},{"text":" ","type":"text"},{"text":"reads the environment around the view, which the modifiers in its own body don’t change. Until a","type":"text"},{"text":" ","type":"text"},{"text":"tracker is set, the environment’s tracker is ","type":"text"},{"type":"codeVoice","code":"Tracker.noOp"},{"text":", so a preview tracks nothing.","type":"text"}]},{"type":"heading","anchor":"UIKit","level":3,"text":"UIKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In UIKit (module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":": iOS, iPadOS, tvOS, visionOS and Mac Catalyst), the tracker is"},{"type":"text","text":" "},{"type":"text","text":"a trait. Set it on the window scene as it connects, and every view controller and view in the scene"},{"type":"text","text":" "},{"type":"text","text":"inherits it, as SwiftUI views inherit their environment. Read it in an action with"},{"type":"text","text":" "},{"code":"traitCollection.tracker","type":"codeVoice"},{"type":"text","text":", or let "},{"code":"track(_:for:)","type":"codeVoice"},{"type":"text","text":" track a control’s events:"}]},{"type":"codeListing","code":["import Traffluent","import UIKit","","@Event","struct ShareTapped {}","","final class CheckoutViewController: UIViewController {","    let share = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        share.addTarget(self, action: #selector(signUp(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","    }","","    @objc func signUp(_ sender: UIButton) {","        sender.traitCollection.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A view controller can override the trait for the views below it, with a tracker "},{"type":"codeVoice","code":"enriched(by:)"},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"screen’s name, say. "},{"type":"codeVoice","code":"track(_:for:)"},{"type":"text","text":" adds a "},{"type":"codeVoice","code":"UIAction"},{"type":"text","text":" beside the control’s other actions and"},{"type":"text","text":" "},{"type":"text","text":"returns it, for "},{"type":"codeVoice","code":"removeAction(_:for:)"},{"type":"text","text":"."}]},{"type":"heading","anchor":"AppKit","level":3,"text":"AppKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In AppKit (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},{"type":"text","text":", macOS), a view finds its tracker the way an action finds its"},{"type":"text","text":" "},{"type":"text","text":"target. "},{"code":"NSView.tracker","type":"codeVoice"},{"type":"text","text":" asks the view’s responder chain (its superviews and view controllers, its"},{"type":"text","text":" "},{"type":"text","text":"window and window controller), then the window’s delegate and the application’s delegate, for the"},{"type":"text","text":" "},{"type":"text","text":"first one that conforms to "},{"code":"TrackerProviding","type":"codeVoice"},{"type":"text","text":". "},{"code":"track(_:)","type":"codeVoice"},{"type":"text","text":" tracks an event each time a control"},{"type":"text","text":" "},{"type":"text","text":"sends its action, just before the action:"}]},{"type":"codeListing","code":["import AppKit","","final class CheckoutWindowController: NSWindowController, TrackerProviding {","    let tracker: Tracker","","    init(window: NSWindow, tracker: Tracker) {","        self.tracker = tracker","        super.init(window: window)","    }","","    required init?(coder: NSCoder) { nil }","","    @objc func signUp(_ sender: NSButton) {","        sender.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","let share = NSButton(title: \"Share\", target: nil, action: nil)","share.track(ShareTapped())  \/\/ through the tracker of the window it is in when it is clicked"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"NSControl","type":"codeVoice"},{"text":" has one target and action, so ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"text":" puts its own in their place and sends the","type":"text"},{"text":" ","type":"text"},{"text":"control’s action on to its target, or up the responder chain when it had none. Call it after","type":"text"},{"text":" ","type":"text"},{"text":"setting them.","type":"text"}]},{"type":"heading","anchor":"Mixing-frameworks","level":3,"text":"Mixing frameworks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI’s "},{"code":"\\.tracker","type":"codeVoice"},{"type":"text","text":" and UIKit’s trait are one value. SwiftUI views hosted in UIKit read the"},{"type":"text","text":" "},{"type":"text","text":"scene’s tracker, and UIKit views hosted in SwiftUI read the environment’s."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To track screen views and control activations without a modifier or a call per control, see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","role":"collection","type":"topic","title":"Traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"url":"\/documentation\/traffluent"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","role":"article","type":"topic","title":"Tracking Events","url":"\/documentation\/traffluent\/trackingevents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}]},"doc://SwiftUITracking/documentation/SwiftUITracking":{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","kind":"symbol","abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"title":"SwiftUITracking","url":"\/documentation\/swiftuitracking","role":"collection","type":"topic"},"doc://AppKitTracking/documentation/AppKitTracking":{"kind":"symbol","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","role":"collection","type":"topic","title":"AppKitTracking","url":"\/documentation\/appkittracking","abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","kind":"article","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"title":"Getting Started","url":"\/documentation\/traffluent\/gettingstarted","role":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","role":"article","type":"topic","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"title":"Automatic Tracking","url":"\/documentation\/traffluent\/automatictracking"},"doc://UIKitTracking/documentation/UIKitTracking":{"kind":"symbol","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","role":"collection","type":"topic","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"title":"UIKitTracking","url":"\/documentation\/uikittracking"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","kind":"article","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"title":"Choosing Destinations","url":"\/documentation\/traffluent\/choosingdestinations","role":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","kind":"article","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"url":"\/documentation\/traffluent\/testingwhatyoutrack","title":"Testing What Your Code Tracks","role":"article","type":"topic"}}}