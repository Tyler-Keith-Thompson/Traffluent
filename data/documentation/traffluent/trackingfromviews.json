{"kind":"article","variants":[{"paths":["\/documentation\/traffluent\/trackingfromviews"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"None of these needs a global or swizzling. Each framework hands the tracker down its own view"},{"type":"text","text":" "},{"type":"text","text":"hierarchy, so each scene or window can have a tracker of its own. In UIKit and AppKit the tracker is"},{"type":"text","text":" "},{"type":"text","text":"found when an action fires, so a control moved to another window tracks through that window’s"},{"type":"text","text":" "},{"type":"text","text":"tracker."}]},{"level":3,"text":"SwiftUI","type":"heading","anchor":"SwiftUI"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On Apple platforms, views read the tracker from the environment (module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"empty elsewhere). Set it at the root of the views with "},{"code":"tracker(_:)","type":"codeVoice"},{"type":"text","text":", read it in any view with"},{"type":"text","text":" "},{"code":"@Environment(\\.tracker)","type":"codeVoice"},{"type":"text","text":", and let modifiers track what views do:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","","struct PlanSelected: Event {","    var plan: String","}","","struct CheckoutView: View {","    @Environment(\\.tracker) private var tracker","    @State private var plan = \"free\"","","    var body: some View {","        Form {","            Picker(\"Plan\", selection: $plan) {","                Text(\"Free\").tag(\"free\")","                Text(\"Pro\").tag(\"pro\")","            }","            .trackChange(of: plan) { PlanSelected(plan: $0) }","            Button(\"Sign up\") {","                tracker.track(SignedUp(plan: plan))  \/\/ its record's context[ScreenKey.self] is \"Checkout\"","            }","        }","    }","}","","let tracker = Tracker()","let root = CheckoutView()","    .trackScreen(\"Checkout\")  \/\/ tracks ScreenViewed(screen: \"Checkout\") each time it appears","    .tracker(tracker)"]},{"type":"paragraph","inlineContent":[{"text":"Each modifier tracks through the environment’s tracker, once per trigger, and records the place it","type":"text"},{"text":" ","type":"text"},{"text":"is applied as the call site:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"code":"trackOnAppear(_:)","type":"codeVoice"},{"text":" tracks its event each time the view appears, as ","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":" runs: again when a","type":"text"},{"text":" ","type":"text"},{"text":"navigation stack pops back to it, but not when SwiftUI only redraws it.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" tracks each tap, beside the view’s own action."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" tracks the event it makes from each new value, but not from the first value"},{"type":"text","text":" "},{"type":"text","text":"or an equal one."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time the view appears. Inside the view, it puts a"},{"type":"text","text":" "},{"type":"text","text":"tracker enriched with the screen’s "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" in the environment, so the events tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen’s actions and modifiers carry its name."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Apply ","type":"text"},{"type":"codeVoice","code":"trackScreen(_:)"},{"text":" where the screen’s view is placed, as above. A view’s own ","type":"text"},{"type":"codeVoice","code":"@Environment"},{"text":" ","type":"text"},{"text":"reads the environment around the view, which the modifiers in its own body don’t change. Until a","type":"text"},{"text":" ","type":"text"},{"text":"tracker is set, the environment’s tracker is ","type":"text"},{"type":"codeVoice","code":"Tracker.noOp"},{"text":", so a preview tracks nothing.","type":"text"}]},{"level":3,"text":"UIKit","type":"heading","anchor":"UIKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In UIKit (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"type":"text","text":": iOS, iPadOS, tvOS, visionOS and Mac Catalyst), the tracker is"},{"type":"text","text":" "},{"type":"text","text":"a trait. Set it on the window scene as it connects, and every view controller and view in the scene"},{"type":"text","text":" "},{"type":"text","text":"inherits it, as SwiftUI views inherit their environment. Read it in an action with"},{"type":"text","text":" "},{"type":"codeVoice","code":"traitCollection.tracker"},{"type":"text","text":", or let "},{"type":"codeVoice","code":"track(_:for:)"},{"type":"text","text":" track a control’s events:"}]},{"type":"codeListing","syntax":"swift","code":["import UIKit","","struct ShareTapped: Event {}","","final class CheckoutViewController: UIViewController {","    let share = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        share.addTarget(self, action: #selector(signUp(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","    }","","    @objc func signUp(_ sender: UIButton) {","        sender.traitCollection.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"]},{"type":"paragraph","inlineContent":[{"text":"A view controller can override the trait for the views below it, with a tracker ","type":"text"},{"code":"enriched(by:)","type":"codeVoice"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"screen’s name, say. ","type":"text"},{"code":"track(_:for:)","type":"codeVoice"},{"text":" adds a ","type":"text"},{"code":"UIAction","type":"codeVoice"},{"text":" beside the control’s other actions and","type":"text"},{"text":" ","type":"text"},{"text":"returns it, for ","type":"text"},{"code":"removeAction(_:for:)","type":"codeVoice"},{"text":".","type":"text"}]},{"level":3,"text":"AppKit","type":"heading","anchor":"AppKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In AppKit (module "},{"type":"reference","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","isActive":true},{"type":"text","text":", macOS), a view finds its tracker the way an action finds its"},{"type":"text","text":" "},{"type":"text","text":"target. "},{"type":"codeVoice","code":"NSView.tracker"},{"type":"text","text":" asks the view’s responder chain (its superviews and view controllers, its"},{"type":"text","text":" "},{"type":"text","text":"window and window controller), then the window’s delegate and the application’s delegate, for the"},{"type":"text","text":" "},{"type":"text","text":"first one that conforms to "},{"type":"codeVoice","code":"TrackerProviding"},{"type":"text","text":". "},{"type":"codeVoice","code":"track(_:)"},{"type":"text","text":" tracks an event each time a control"},{"type":"text","text":" "},{"type":"text","text":"sends its action, just before the action:"}]},{"type":"codeListing","syntax":"swift","code":["import AppKit","","final class CheckoutWindowController: NSWindowController, TrackerProviding {","    let tracker: Tracker","","    init(window: NSWindow, tracker: Tracker) {","        self.tracker = tracker","        super.init(window: window)","    }","","    required init?(coder: NSCoder) { nil }","","    @objc func signUp(_ sender: NSButton) {","        sender.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","let share = NSButton(title: \"Share\", target: nil, action: nil)","share.track(ShareTapped())  \/\/ through the tracker of the window it is in when it is clicked"]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"NSControl"},{"text":" has one target and action, so ","type":"text"},{"type":"codeVoice","code":"track(_:)"},{"text":" puts its own in their place and sends the","type":"text"},{"text":" ","type":"text"},{"text":"control’s action on to its target, or up the responder chain when it had none. Call it after","type":"text"},{"text":" ","type":"text"},{"text":"setting them.","type":"text"}]},{"level":3,"text":"Mixing frameworks","type":"heading","anchor":"Mixing-frameworks"},{"type":"paragraph","inlineContent":[{"text":"SwiftUI’s ","type":"text"},{"type":"codeVoice","code":"\\.tracker"},{"text":" and UIKit’s trait are one value. SwiftUI views hosted in UIKit read the","type":"text"},{"text":" ","type":"text"},{"text":"scene’s tracker, and UIKit views hosted in SwiftUI read the environment’s.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To track screen views and control activations without a modifier or a call per control, see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"kind":"content"}],"sections":[],"metadata":{"modules":[{"name":"Traffluent"}],"role":"article","title":"Tracking from SwiftUI, UIKit and AppKit","roleHeading":"Article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"anchor":"Essentials","title":"Essentials","generated":true}],"references":{"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"type":"topic","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"role":"article","url":"\/documentation\/traffluent\/trackingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","title":"Tracking Events","kind":"article"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"type":"topic","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"role":"article","url":"\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","kind":"article"},"doc://AppKitTracking/documentation/AppKitTracking":{"kind":"symbol","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/appkittracking","title":"AppKitTracking","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"type":"topic","abstract":[],"role":"collection","url":"\/documentation\/swiftuitracking","title":"SwiftUITracking","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","kind":"symbol"},"doc://Traffluent/documentation/Traffluent":{"type":"topic","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"role":"collection","url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"role":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","title":"Testing What Your Code Tracks","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"doc://UIKitTracking/documentation/UIKitTracking":{"type":"topic","abstract":[],"role":"collection","url":"\/documentation\/uikittracking","title":"UIKitTracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"type":"topic","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"role":"article","url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","title":"Automatic Tracking","kind":"article"}}}