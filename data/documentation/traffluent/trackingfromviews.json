{"metadata":{"role":"article","title":"Tracking from SwiftUI, UIKit and AppKit","roleHeading":"Article","modules":[{"name":"Traffluent"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/trackingfromviews"]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"None of these needs a global or swizzling. Each framework hands the tracker down its own view"},{"type":"text","text":" "},{"type":"text","text":"hierarchy, so each scene or window can have a tracker of its own. In UIKit and AppKit the tracker is"},{"type":"text","text":" "},{"type":"text","text":"found when an action fires, so a control moved to another window tracks through that window’s"},{"type":"text","text":" "},{"type":"text","text":"tracker."}],"type":"paragraph"},{"anchor":"SwiftUI","text":"SwiftUI","type":"heading","level":3},{"inlineContent":[{"text":"On Apple platforms, views read the tracker from the environment (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"empty elsewhere). Set it at the root of the views with ","type":"text"},{"type":"codeVoice","code":"tracker(_:)"},{"text":", read it in any view with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@Environment(\\.tracker)"},{"text":", and let modifiers track what views do:","type":"text"}],"type":"paragraph"},{"code":["import SwiftUI","import Traffluent","","@Event","struct PlanSelected {","    var plan: String","}","","struct CheckoutView: View {","    @Environment(\\.tracker) private var tracker","    @State private var plan = \"free\"","","    var body: some View {","        Form {","            Picker(\"Plan\", selection: $plan) {","                Text(\"Free\").tag(\"free\")","                Text(\"Pro\").tag(\"pro\")","            }","            .trackChange(of: plan) { PlanSelected(plan: $0) }","            Button(\"Sign up\") {","                tracker.track(SignedUp(plan: plan))  \/\/ its record's context[ScreenKey.self] is \"Checkout\"","            }","        }","    }","}","","let tracker = Tracker()","let root = CheckoutView()","    .trackScreen(\"Checkout\")  \/\/ tracks ScreenViewed(screen: \"Checkout\") each time it appears","    .tracker(tracker)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each modifier tracks through the environment’s tracker, once per trigger, and records the place it"},{"type":"text","text":" "},{"type":"text","text":"is applied as the call site:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"trackOnAppear(_:)","type":"codeVoice"},{"type":"text","text":" tracks its event each time the view appears, as "},{"code":"onAppear","type":"codeVoice"},{"type":"text","text":" runs: again when a"},{"type":"text","text":" "},{"type":"text","text":"navigation stack pops back to it, but not when SwiftUI only redraws it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"trackOnTap(_:)","type":"codeVoice"},{"text":" tracks each tap, beside the view’s own action.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"trackChange(of:_:)","type":"codeVoice"},{"type":"text","text":" tracks the event it makes from each new value, but not from the first value"},{"type":"text","text":" "},{"type":"text","text":"or an equal one."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" tracks "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" each time the view appears. Inside the view, it puts a"},{"type":"text","text":" "},{"type":"text","text":"tracker enriched with the screen’s "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":" in the environment, so the events tracked from the"},{"type":"text","text":" "},{"type":"text","text":"screen’s actions and modifiers carry its name."}]}]}]},{"inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" where the screen’s view is placed, as above. A view’s own "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" "},{"type":"text","text":"reads the environment around the view, which the modifiers in its own body don’t change. Until a"},{"type":"text","text":" "},{"type":"text","text":"tracker is set, the environment’s tracker is "},{"type":"codeVoice","code":"Tracker.noOp"},{"type":"text","text":", so a preview tracks nothing."}],"type":"paragraph"},{"anchor":"UIKit","text":"UIKit","type":"heading","level":3},{"inlineContent":[{"text":"In UIKit (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},{"text":": iOS, iPadOS, tvOS, visionOS and Mac Catalyst), the tracker is","type":"text"},{"text":" ","type":"text"},{"text":"a trait. Set it on the window scene as it connects, and every view controller and view in the scene","type":"text"},{"text":" ","type":"text"},{"text":"inherits it, as SwiftUI views inherit their environment. Read it in an action with","type":"text"},{"text":" ","type":"text"},{"code":"traitCollection.tracker","type":"codeVoice"},{"text":", or let ","type":"text"},{"code":"track(_:for:)","type":"codeVoice"},{"text":" track a control’s events:","type":"text"}],"type":"paragraph"},{"code":["import Traffluent","import UIKit","","@Event","struct ShareTapped {}","","final class CheckoutViewController: UIViewController {","    let share = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        share.addTarget(self, action: #selector(signUp(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","    }","","    @objc func signUp(_ sender: UIButton) {","        sender.traitCollection.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A view controller can override the trait for the views below it, with a tracker ","type":"text"},{"type":"codeVoice","code":"enriched(by:)"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"screen’s name, say. ","type":"text"},{"type":"codeVoice","code":"track(_:for:)"},{"text":" adds a ","type":"text"},{"type":"codeVoice","code":"UIAction"},{"text":" beside the control’s other actions and","type":"text"},{"text":" ","type":"text"},{"text":"returns it, for ","type":"text"},{"type":"codeVoice","code":"removeAction(_:for:)"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"AppKit","text":"AppKit","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"In AppKit (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},{"type":"text","text":", macOS), a view finds its tracker the way an action finds its"},{"type":"text","text":" "},{"type":"text","text":"target. "},{"code":"NSView.tracker","type":"codeVoice"},{"type":"text","text":" asks the view’s responder chain (its superviews and view controllers, its"},{"type":"text","text":" "},{"type":"text","text":"window and window controller), then the window’s delegate and the application’s delegate, for the"},{"type":"text","text":" "},{"type":"text","text":"first one that conforms to "},{"code":"TrackerProviding","type":"codeVoice"},{"type":"text","text":". "},{"code":"track(_:)","type":"codeVoice"},{"type":"text","text":" tracks an event each time a control"},{"type":"text","text":" "},{"type":"text","text":"sends its action, just before the action:"}],"type":"paragraph"},{"code":["import AppKit","","final class CheckoutWindowController: NSWindowController, TrackerProviding {","    let tracker: Tracker","","    init(window: NSWindow, tracker: Tracker) {","        self.tracker = tracker","        super.init(window: window)","    }","","    required init?(coder: NSCoder) { nil }","","    @objc func signUp(_ sender: NSButton) {","        sender.tracker.track(SignedUp(plan: \"pro\"))","    }","}","","let share = NSButton(title: \"Share\", target: nil, action: nil)","share.track(ShareTapped())  \/\/ through the tracker of the window it is in when it is clicked"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"An ","type":"text"},{"code":"NSControl","type":"codeVoice"},{"text":" has one target and action, so ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"text":" puts its own in their place and sends the","type":"text"},{"text":" ","type":"text"},{"text":"control’s action on to its target, or up the responder chain when it had none. Call it after","type":"text"},{"text":" ","type":"text"},{"text":"setting them.","type":"text"}],"type":"paragraph"},{"anchor":"Mixing-frameworks","text":"Mixing frameworks","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"SwiftUI’s "},{"code":"\\.tracker","type":"codeVoice"},{"type":"text","text":" and UIKit’s trait are one value. SwiftUI views hosted in UIKit read the"},{"type":"text","text":" "},{"type":"text","text":"scene’s tracker, and UIKit views hosted in SwiftUI read the environment’s."}],"type":"paragraph"},{"inlineContent":[{"text":"To track screen views and control activations without a modifier or a call per control, see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},{"text":".","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"]}],"abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","title":"Automatic Tracking","role":"article","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}]},"doc://Traffluent/documentation/Traffluent":{"url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","kind":"symbol","title":"Traffluent","type":"topic","role":"collection","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}]},"doc://SwiftUITracking/documentation/SwiftUITracking":{"url":"\/documentation\/swiftuitracking","title":"SwiftUITracking","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"topic","role":"collection","abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"kind":"symbol"},"doc://AppKitTracking/documentation/AppKitTracking":{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","kind":"symbol","type":"topic","title":"AppKitTracking","url":"\/documentation\/appkittracking","role":"collection","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}]},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"type":"topic","kind":"article","role":"article","url":"\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations"},"doc://UIKitTracking/documentation/UIKitTracking":{"url":"\/documentation\/uikittracking","title":"UIKitTracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"topic","role":"collection","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"url":"\/documentation\/traffluent\/testingwhatyoutrack","kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","title":"Testing What Your Code Tracks","role":"article","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}]},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"url":"\/documentation\/traffluent\/trackingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","kind":"article","title":"Tracking Events","type":"topic","role":"article","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}]}}}