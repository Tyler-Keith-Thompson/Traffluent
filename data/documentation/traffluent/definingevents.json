{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Event"},{"text":" (module ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","type":"reference"},{"text":", part of ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":") makes a struct an event from its","type":"text"},{"text":" ","type":"text"},{"text":"declaration, and is how you declare one. It adds the ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"BinaryCodable"},{"text":" ","type":"text"},{"text":"conformances, the event’s name, consent category and schema version when you give them, and a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"schema"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"EventSchema"},{"text":" value that tooling reads:","type":"text"}]},{"syntax":"swift","code":["import Traffluent","","@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?","}","","let tracker = Tracker()","tracker.track(CheckoutStarted(cartSize: 3, coupon: nil))","let properties = CheckoutStarted.schema.properties.map(\\.name)  \/\/ [\"cartSize\", \"coupon\"]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The schema holds the name, the version, the consent category and each stored property’s name, its"},{"type":"text","text":" "},{"type":"text","text":"type as written, its optionality and whether it has a default value, in declaration order. The"},{"type":"text","text":" "},{"type":"text","text":"encoding writes each of those properties under its name ("},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"reference","isActive":true},{"type":"text","text":"), and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" property keeps its redaction. The "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" protocols’ documentation"},{"type":"text","text":" "},{"type":"text","text":"shows the same conformances written by hand. A record stored before a property with a default value"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"var currency: String = \"USD\""},{"type":"text","text":") was added reads it as its default."}]},{"type":"paragraph","inlineContent":[{"code":"version:","type":"codeVoice"},{"text":" counts breaking changes only, and is 1 when left out; ","type":"text"},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","isActive":true},{"text":" shows each","type":"text"},{"text":" ","type":"text"},{"text":"kind of change. ","type":"text"},{"code":"consent:","type":"codeVoice"},{"text":" sets the event’s ","type":"text"},{"code":"consentCategory","type":"codeVoice"},{"text":" (","type":"text"},{"code":"@Event(consent: .advertising)","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A stored property whose type isn’t ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" is a compile error that names it:","type":"text"},{"text":" ","type":"text"},{"code":"static method 'requireBinaryCodable(position:)' requires that 'Coordinate' conform to 'BinaryCodable'","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"So are ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" on anything but a struct, and a stored property without a type annotation. Static","type":"text"},{"text":" ","type":"text"},{"text":"and computed properties are left out. The struct keeps its memberwise initializer.","type":"text"}]},{"text":"Constraining properties","anchor":"Constraining-properties","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"A property’s type says what kind of value it holds; a constraint says which values of that kind","type":"text"},{"text":" ","type":"text"},{"text":"are valid. A rule the type can enforce belongs in the type: a ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" value satisfies every","type":"text"},{"text":" ","type":"text"},{"text":"constraint of its ","type":"text"},{"code":"Refinement","type":"codeVoice"},{"text":" from the moment it is made. Rules a plain ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" can’t","type":"text"},{"text":" ","type":"text"},{"text":"carry are declared beside the property with ","type":"text"},{"code":"@Constrained","type":"codeVoice"},{"text":" (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},{"text":"), and the","type":"text"},{"text":" ","type":"text"},{"text":"tracker checks them:","type":"text"}]},{"syntax":"swift","code":["enum CouponCode: Refinement {","    static let constraints: [Constraint<String>] = [.pattern(\"^[A-Z0-9]{6}$\", example: \"SPRING\")]","}","","@Event(name: \"search_performed\")","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0))","    var resultCount: Int","    var coupon: Refined<String, CouponCode>?","}","","let coupon = try? Refined<String, CouponCode>(checked: \"spring\")  \/\/ nil: UnsatisfiedConstraint.pattern","let tracker = Tracker()","tracker.track(SearchPerformed(query: \"\", resultCount: 3, coupon: Refined(\"SPRING\")))","await tracker.finish()","for await report in tracker.rejectionReports {","    print(report)  \/\/ search_performed: \"query\" breaks minLength 1 (1 rejected)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The keywords are JSON Schema’s: "},{"type":"codeVoice","code":"minLength"},{"type":"text","text":" and "},{"type":"codeVoice","code":"maxLength"},{"type":"text","text":" (in Unicode scalars) and "},{"type":"codeVoice","code":"pattern"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"a string, "},{"type":"codeVoice","code":"minimum"},{"type":"text","text":" and "},{"type":"codeVoice","code":"maximum"},{"type":"text","text":" for a number, "},{"type":"codeVoice","code":"minItems"},{"type":"text","text":" and "},{"type":"codeVoice","code":"maxItems"},{"type":"text","text":" for an array. Each is"},{"type":"text","text":" "},{"type":"text","text":"offered only for the types it applies to, with its bound in the property’s own type, so"},{"type":"text","text":" "},{"type":"codeVoice","code":".minLength"},{"type":"text","text":" on an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", or "},{"type":"codeVoice","code":".minimum(0.5)"},{"type":"text","text":" on an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", is a compile error. In "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so is a lower bound above its upper bound, a pattern that doesn’t compile, and a pattern whose"},{"type":"text","text":" "},{"type":"codeVoice","code":"example"},{"type":"text","text":" it, or another keyword of the property, rejects. In a "},{"type":"codeVoice","code":"Refinement"},{"type":"text","text":", those trap when its"},{"type":"text","text":" "},{"type":"text","text":"constraints are built. "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":"’s plain initializer traps on a value that breaks its rule, as an"},{"type":"text","text":" "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" subscript does out of range; "},{"type":"codeVoice","code":"init(checked:)"},{"type":"text","text":" throws the "},{"type":"codeVoice","code":"UnsatisfiedConstraint"},{"type":"text","text":" instead."}]},{"text":"Rejected events","anchor":"Rejected-events","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s worker checks each event’s declared constraints before anything else, never on the"},{"type":"text","text":" "},{"type":"text","text":"caller. An event that breaks one is rejected: never enriched, held by a consent, written to a store"},{"type":"text","text":" "},{"type":"text","text":"or delivered. Each rejection is reported on "},{"type":"codeVoice","code":"tracker.rejectionReports"},{"type":"text","text":" as a "},{"type":"codeVoice","code":"RejectionReport"},{"type":"text","text":" naming"},{"type":"text","text":" "},{"type":"text","text":"the event, the property and the keyword, and in debug builds it is logged at error level too."},{"type":"text","text":" "},{"type":"text","text":"Unread reports merge, one per event, property and keyword, counting the rejections and the range of"},{"type":"text","text":" "},{"type":"text","text":"times they were tracked, so a broken call site in a loop can’t fill memory."}]},{"type":"paragraph","inlineContent":[{"text":"A record that a store recovered from an earlier run is checked again, and the store forgets one","type":"text"},{"text":" ","type":"text"},{"text":"that a constraint added since rejects. A stored ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" value whose rule no longer accepts it","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t decode, and the store reports it. A ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" property takes no ","type":"text"},{"code":"@Constrained","type":"codeVoice"},{"text":" keywords,","type":"text"},{"text":" ","type":"text"},{"text":"since checking one would reveal it; a ","type":"text"},{"code":"Sensitive<Refined<…>>","type":"codeVoice"},{"text":" enforces its rule as it is made.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Both kinds of constraint are part of the event’s schema. The exported tracking plan lists them","type":"text"},{"text":" ","type":"text"},{"text":"beside each property’s type, and each example payload satisfies them, using a pattern’s ","type":"text"},{"code":"example","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"reference"},{"text":"). An array’s ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" elements are checked as they are made, but their","type":"text"},{"text":" ","type":"text"},{"text":"rules aren’t exported.","type":"text"}]}]}],"abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"generated":true,"title":"Guides"}],"metadata":{"title":"Defining Events","role":"article","roleHeading":"Article","modules":[{"name":"Traffluent"}]},"variants":[{"paths":["\/documentation\/traffluent\/definingevents"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EventMacros/documentation/EventMacros":{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","role":"collection","title":"EventMacros","kind":"symbol","url":"\/documentation\/eventmacros","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/persistingrecords"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","role":"article","title":"Changing an Event","kind":"article","url":"\/documentation\/traffluent\/changingevents","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/automatictracking"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","role":"collection","title":"Traffluent","kind":"symbol","url":"\/documentation\/traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"type":"topic","kind":"article","role":"article","url":"\/documentation\/traffluent\/consentgating"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","role":"article","title":"Exporting and Checking a Tracking Plan","kind":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","type":"topic","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","role":"article","title":"Sampling Events","kind":"article","url":"\/documentation\/traffluent\/samplingevents","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"type":"topic"}}}