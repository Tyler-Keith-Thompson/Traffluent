{"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/definingevents"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},"metadata":{"roleHeading":"Article","modules":[{"name":"Traffluent"}],"title":"Defining Events","role":"article"},"abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"title":"Guides","generated":true,"anchor":"Guides"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"@Event"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","type":"reference","isActive":true},{"type":"text","text":", part of "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":") makes a struct an event from its"},{"type":"text","text":" "},{"type":"text","text":"declaration, and is how you declare one. It adds the "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" "},{"type":"text","text":"conformances, the event’s name, consent category and schema version when you give them, and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"schema"},{"type":"text","text":", an "},{"type":"codeVoice","code":"EventSchema"},{"type":"text","text":" value that tooling reads:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Traffluent","","@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?","}","","let tracker = Tracker()","tracker.track(CheckoutStarted(cartSize: 3, coupon: nil))","let properties = CheckoutStarted.schema.properties.map(\\.name)  \/\/ [\"cartSize\", \"coupon\"]"]},{"inlineContent":[{"text":"The schema holds the name, the version, the consent category and each stored property’s name, its","type":"text"},{"text":" ","type":"text"},{"text":"type as written, its optionality and whether it has a default value, in declaration order. The","type":"text"},{"text":" ","type":"text"},{"text":"encoding writes each of those properties under its name (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"reference"},{"text":"), and a","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" property keeps its redaction. The ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" protocols’ documentation","type":"text"},{"text":" ","type":"text"},{"text":"shows the same conformances written by hand. A record stored before a property with a default value","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"var currency: String = \"USD\"","type":"codeVoice"},{"text":") was added reads it as its default.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"version:"},{"text":" counts breaking changes only, and is 1 when left out; ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"},{"text":" shows each","type":"text"},{"text":" ","type":"text"},{"text":"kind of change. ","type":"text"},{"type":"codeVoice","code":"consent:"},{"text":" sets the event’s ","type":"text"},{"type":"codeVoice","code":"consentCategory"},{"text":" (","type":"text"},{"type":"codeVoice","code":"@Event(consent: .advertising)"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A stored property whose type isn’t "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" is a compile error that names it:"},{"type":"text","text":" "},{"type":"codeVoice","code":"static method 'requireBinaryCodable(position:)' requires that 'Coordinate' conform to 'BinaryCodable'"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"So are "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" on anything but a struct, and a stored property without a type annotation. Static"},{"type":"text","text":" "},{"type":"text","text":"and computed properties are left out. The struct keeps its memberwise initializer."}],"type":"paragraph"},{"level":3,"text":"Constraining properties","type":"heading","anchor":"Constraining-properties"},{"inlineContent":[{"type":"text","text":"A property’s type says what kind of value it holds; a constraint says which values of that kind"},{"type":"text","text":" "},{"type":"text","text":"are valid. A rule the type can enforce belongs in the type: a "},{"code":"Refined","type":"codeVoice"},{"type":"text","text":" value satisfies every"},{"type":"text","text":" "},{"type":"text","text":"constraint of its "},{"code":"Refinement","type":"codeVoice"},{"type":"text","text":" from the moment it is made. Rules a plain "},{"code":"String","type":"codeVoice"},{"type":"text","text":" or "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" can’t"},{"type":"text","text":" "},{"type":"text","text":"carry are declared beside the property with "},{"code":"@Constrained","type":"codeVoice"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},{"type":"text","text":"), and the"},{"type":"text","text":" "},{"type":"text","text":"tracker checks them:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["enum CouponCode: Refinement {","    static let constraints: [Constraint<String>] = [.pattern(\"^[A-Z0-9]{6}$\", example: \"SPRING\")]","}","","@Event(name: \"search_performed\")","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0))","    var resultCount: Int","    var coupon: Refined<String, CouponCode>?","}","","let coupon = try? Refined<String, CouponCode>(checked: \"spring\")  \/\/ nil: UnsatisfiedConstraint.pattern","let tracker = Tracker()","tracker.track(SearchPerformed(query: \"\", resultCount: 3, coupon: Refined(\"SPRING\")))","await tracker.finish()","for await report in tracker.rejectionReports {","    print(report)  \/\/ search_performed: \"query\" breaks minLength 1 (1 rejected)","}"]},{"inlineContent":[{"text":"The keywords are JSON Schema’s: ","type":"text"},{"code":"minLength","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"maxLength","type":"codeVoice"},{"text":" (in Unicode scalars) and ","type":"text"},{"code":"pattern","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"a string, ","type":"text"},{"code":"minimum","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"maximum","type":"codeVoice"},{"text":" for a number, ","type":"text"},{"code":"minItems","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"maxItems","type":"codeVoice"},{"text":" for an array. Each is","type":"text"},{"text":" ","type":"text"},{"text":"offered only for the types it applies to, with its bound in the property’s own type, so","type":"text"},{"text":" ","type":"text"},{"code":".minLength","type":"codeVoice"},{"text":" on an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", or ","type":"text"},{"code":".minimum(0.5)","type":"codeVoice"},{"text":" on an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", is a compile error. In ","type":"text"},{"code":"@Constrained","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so is a lower bound above its upper bound, a pattern that doesn’t compile, and a pattern whose","type":"text"},{"text":" ","type":"text"},{"code":"example","type":"codeVoice"},{"text":" it, or another keyword of the property, rejects. In a ","type":"text"},{"code":"Refinement","type":"codeVoice"},{"text":", those trap when its","type":"text"},{"text":" ","type":"text"},{"text":"constraints are built. ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":"’s plain initializer traps on a value that breaks its rule, as an","type":"text"},{"text":" ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" subscript does out of range; ","type":"text"},{"code":"init(checked:)","type":"codeVoice"},{"text":" throws the ","type":"text"},{"code":"UnsatisfiedConstraint","type":"codeVoice"},{"text":" instead.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Rejected events","type":"heading","anchor":"Rejected-events"},{"inlineContent":[{"type":"text","text":"The tracker’s worker checks each event’s declared constraints before anything else, never on the"},{"type":"text","text":" "},{"type":"text","text":"caller. An event that breaks one is rejected: never enriched, held by a consent, written to a store"},{"type":"text","text":" "},{"type":"text","text":"or delivered. Each rejection is reported on "},{"code":"tracker.rejectionReports","type":"codeVoice"},{"type":"text","text":" as a "},{"code":"RejectionReport","type":"codeVoice"},{"type":"text","text":" naming"},{"type":"text","text":" "},{"type":"text","text":"the event, the property and the keyword, and in debug builds it is logged at error level too."},{"type":"text","text":" "},{"type":"text","text":"Unread reports merge, one per event, property and keyword, counting the rejections and the range of"},{"type":"text","text":" "},{"type":"text","text":"times they were tracked, so a broken call site in a loop can’t fill memory."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A record that a store recovered from an earlier run is checked again, and the store forgets one"},{"type":"text","text":" "},{"type":"text","text":"that a constraint added since rejects. A stored "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value whose rule no longer accepts it"},{"type":"text","text":" "},{"type":"text","text":"doesn’t decode, and the store reports it. A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" property takes no "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":" keywords,"},{"type":"text","text":" "},{"type":"text","text":"since checking one would reveal it; a "},{"type":"codeVoice","code":"Sensitive<Refined<…>>"},{"type":"text","text":" enforces its rule as it is made."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both kinds of constraint are part of the event’s schema. The exported tracking plan lists them"},{"type":"text","text":" "},{"type":"text","text":"beside each property’s type, and each example payload satisfies them, using a pattern’s "},{"code":"example","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},{"type":"text","text":"). An array’s "},{"code":"Refined","type":"codeVoice"},{"type":"text","text":" elements are checked as they are made, but their"},{"type":"text","text":" "},{"type":"text","text":"rules aren’t exported."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"sections":[],"references":{"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/consentgating"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/persistingrecords"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","kind":"article","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","role":"article","type":"topic","url":"\/documentation\/traffluent\/samplingevents"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"url":"\/documentation\/traffluent\/trackingplanworkflow","role":"article","kind":"article"},"doc://EventMacros/documentation/EventMacros":{"title":"EventMacros","type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"url":"\/documentation\/eventmacros","role":"collection","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","kind":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"role":"article","type":"topic","url":"\/documentation\/traffluent\/automatictracking"},"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"url":"\/documentation\/traffluent","role":"collection","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"title":"Changing an Event","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/changingevents"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"url":"\/documentation\/traffluent\/sessionsandstandardcontext","role":"article","kind":"article"}}}