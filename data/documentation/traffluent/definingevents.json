{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/definingevents"]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"title":"Guides","generated":true}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Event"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","type":"reference","isActive":true},{"text":", part of ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":") makes a struct an event from its","type":"text"},{"text":" ","type":"text"},{"text":"declaration, and is how you declare one. It adds the ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"BinaryCodable"},{"text":" ","type":"text"},{"text":"conformances, the event’s name, consent category and schema version when you give them, and a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"schema"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"EventSchema"},{"text":" value that tooling reads:","type":"text"}]},{"type":"codeListing","code":["import Traffluent","","@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?","}","","let tracker = Tracker()","tracker.track(CheckoutStarted(cartSize: 3, coupon: nil))","let properties = CheckoutStarted.schema.properties.map(\\.name)  \/\/ [\"cartSize\", \"coupon\"]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The schema holds the name, the version, the consent category and each stored property’s name, its"},{"type":"text","text":" "},{"type":"text","text":"type as written, its optionality and whether it has a default value, in declaration order. The"},{"type":"text","text":" "},{"type":"text","text":"encoding writes each of those properties under its name ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},{"type":"text","text":"), and a"},{"type":"text","text":" "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" property keeps its redaction. The "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" and "},{"code":"BinaryCodable","type":"codeVoice"},{"type":"text","text":" protocols’ documentation"},{"type":"text","text":" "},{"type":"text","text":"shows the same conformances written by hand. A record stored before a property with a default value"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"var currency: String = \"USD\"","type":"codeVoice"},{"type":"text","text":") was added reads it as its default."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"version:"},{"type":"text","text":" counts breaking changes only, and is 1 when left out; "},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","type":"reference","isActive":true},{"type":"text","text":" shows each"},{"type":"text","text":" "},{"type":"text","text":"kind of change. "},{"type":"codeVoice","code":"consent:"},{"type":"text","text":" sets the event’s "},{"type":"codeVoice","code":"consentCategory"},{"type":"text","text":" ("},{"type":"codeVoice","code":"@Event(consent: .advertising)"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"text":"A stored property whose type isn’t ","type":"text"},{"type":"codeVoice","code":"BinaryCodable"},{"text":" is a compile error that names it:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"static method 'requireBinaryCodable(position:)' requires that 'Coordinate' conform to 'BinaryCodable'"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"So are ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" on anything but a struct, and a stored property without a type annotation. Static","type":"text"},{"text":" ","type":"text"},{"text":"and computed properties are left out. The struct keeps its memberwise initializer.","type":"text"}]},{"type":"heading","level":3,"anchor":"Constraining-properties","text":"Constraining properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A property’s type says what kind of value it holds; a constraint says which values of that kind"},{"type":"text","text":" "},{"type":"text","text":"are valid. A rule the type can enforce belongs in the type: a "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value satisfies every"},{"type":"text","text":" "},{"type":"text","text":"constraint of its "},{"type":"codeVoice","code":"Refinement"},{"type":"text","text":" from the moment it is made. Rules a plain "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" can’t"},{"type":"text","text":" "},{"type":"text","text":"carry are declared beside the property with "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},{"type":"text","text":"), and the"},{"type":"text","text":" "},{"type":"text","text":"tracker checks them:"}]},{"type":"codeListing","code":["enum CouponCode: Refinement {","    static let constraints: [Constraint<String>] = [.pattern(\"^[A-Z0-9]{6}$\", example: \"SPRING\")]","}","","@Event(name: \"search_performed\")","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0))","    var resultCount: Int","    var coupon: Refined<String, CouponCode>?","}","","let coupon = try? Refined<String, CouponCode>(checked: \"spring\")  \/\/ nil: UnsatisfiedConstraint.pattern","let tracker = Tracker()","tracker.track(SearchPerformed(query: \"\", resultCount: 3, coupon: Refined(\"SPRING\")))","await tracker.finish()","for await report in tracker.rejectionReports {","    print(report)  \/\/ search_performed: \"query\" breaks minLength 1 (1 rejected)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The keywords are JSON Schema’s: "},{"code":"minLength","type":"codeVoice"},{"type":"text","text":" and "},{"code":"maxLength","type":"codeVoice"},{"type":"text","text":" (in Unicode scalars) and "},{"code":"pattern","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"a string, "},{"code":"minimum","type":"codeVoice"},{"type":"text","text":" and "},{"code":"maximum","type":"codeVoice"},{"type":"text","text":" for a number, "},{"code":"minItems","type":"codeVoice"},{"type":"text","text":" and "},{"code":"maxItems","type":"codeVoice"},{"type":"text","text":" for an array. Each is"},{"type":"text","text":" "},{"type":"text","text":"offered only for the types it applies to, with its bound in the property’s own type, so"},{"type":"text","text":" "},{"code":".minLength","type":"codeVoice"},{"type":"text","text":" on an "},{"code":"Int","type":"codeVoice"},{"type":"text","text":", or "},{"code":".minimum(0.5)","type":"codeVoice"},{"type":"text","text":" on an "},{"code":"Int","type":"codeVoice"},{"type":"text","text":", is a compile error. In "},{"code":"@Constrained","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so is a lower bound above its upper bound, a pattern that doesn’t compile, and a pattern whose"},{"type":"text","text":" "},{"code":"example","type":"codeVoice"},{"type":"text","text":" it, or another keyword of the property, rejects. In a "},{"code":"Refinement","type":"codeVoice"},{"type":"text","text":", those trap when its"},{"type":"text","text":" "},{"type":"text","text":"constraints are built. "},{"code":"Refined","type":"codeVoice"},{"type":"text","text":"’s plain initializer traps on a value that breaks its rule, as an"},{"type":"text","text":" "},{"code":"Array","type":"codeVoice"},{"type":"text","text":" subscript does out of range; "},{"code":"init(checked:)","type":"codeVoice"},{"type":"text","text":" throws the "},{"code":"UnsatisfiedConstraint","type":"codeVoice"},{"type":"text","text":" instead."}]},{"type":"heading","level":3,"anchor":"Rejected-events","text":"Rejected events"},{"type":"paragraph","inlineContent":[{"text":"The tracker’s worker checks each event’s declared constraints before anything else, never on the","type":"text"},{"text":" ","type":"text"},{"text":"caller. An event that breaks one is rejected: never enriched, held by a consent, written to a store","type":"text"},{"text":" ","type":"text"},{"text":"or delivered. Each rejection is reported on ","type":"text"},{"type":"codeVoice","code":"tracker.rejectionReports"},{"text":" as a ","type":"text"},{"type":"codeVoice","code":"RejectionReport"},{"text":" naming","type":"text"},{"text":" ","type":"text"},{"text":"the event, the property and the keyword, and in debug builds it is logged at error level too.","type":"text"},{"text":" ","type":"text"},{"text":"Unread reports merge, one per event, property and keyword, counting the rejections and the range of","type":"text"},{"text":" ","type":"text"},{"text":"times they were tracked, so a broken call site in a loop can’t fill memory.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A record that a store recovered from an earlier run is checked again, and the store forgets one","type":"text"},{"text":" ","type":"text"},{"text":"that a constraint added since rejects. A stored ","type":"text"},{"type":"codeVoice","code":"Refined"},{"text":" value whose rule no longer accepts it","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t decode, and the store reports it. A ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" property takes no ","type":"text"},{"type":"codeVoice","code":"@Constrained"},{"text":" keywords,","type":"text"},{"text":" ","type":"text"},{"text":"since checking one would reveal it; a ","type":"text"},{"type":"codeVoice","code":"Sensitive<Refined<…>>"},{"text":" enforces its rule as it is made.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Both kinds of constraint are part of the event’s schema. The exported tracking plan lists them","type":"text"},{"text":" ","type":"text"},{"text":"beside each property’s type, and each example payload satisfies them, using a pattern’s ","type":"text"},{"code":"example","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"reference"},{"text":"). An array’s ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" elements are checked as they are made, but their","type":"text"},{"text":" ","type":"text"},{"text":"rules aren’t exported.","type":"text"}]}],"kind":"content"}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Traffluent"}],"title":"Defining Events"},"abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"kind":"article","references":{"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","url":"\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking","role":"article"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","type":"topic","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"role":"article","url":"\/documentation\/traffluent\/samplingevents","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","type":"topic","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"role":"article","url":"\/documentation\/traffluent\/consentgating","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","type":"topic","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"role":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"type":"topic","kind":"article","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","url":"\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","role":"article"},"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","type":"topic","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"role":"collection","url":"\/documentation\/traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"title":"Changing an Event","type":"topic","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"role":"article","url":"\/documentation\/traffluent\/changingevents","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","type":"topic","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},"doc://EventMacros/documentation/EventMacros":{"title":"EventMacros","type":"topic","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"role":"collection","url":"\/documentation\/eventmacros","kind":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"}}}