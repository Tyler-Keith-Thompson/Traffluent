{"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","interfaceLanguage":"swift"},"sections":[],"metadata":{"roleHeading":"Article","role":"article","title":"Defining Events","modules":[{"name":"Traffluent"}]},"abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Event"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},{"type":"text","text":") makes a struct an event from its declaration. It is a product of"},{"type":"text","text":" "},{"type":"text","text":"its own that "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves out, so only apps that use it build swift-syntax. It adds"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" conformances, the event’s name, consent category and schema version"},{"type":"text","text":" "},{"type":"text","text":"when you give them, and a "},{"type":"codeVoice","code":"schema"},{"type":"text","text":", an "},{"type":"codeVoice","code":"EventSchema"},{"type":"text","text":" value that tooling reads:"}]},{"type":"codeListing","syntax":"swift","code":["import EventMacros","","@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?","}","","let tracker = Tracker()","tracker.track(CheckoutStarted(cartSize: 3, coupon: nil))","let properties = CheckoutStarted.schema.properties.map(\\.name)  \/\/ [\"cartSize\", \"coupon\"]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The schema holds the name, the version, the consent category and each stored property’s name, its"},{"type":"text","text":" "},{"type":"text","text":"type as written, its optionality and whether it has a default value, in declaration order. The"},{"type":"text","text":" "},{"type":"text","text":"encoding writes each of those properties under its name, as a hand-written conformance does"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"reference"},{"type":"text","text":"), and a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" property keeps its redaction. A record stored before"},{"type":"text","text":" "},{"type":"text","text":"a property with a default value ("},{"code":"var currency: String = \"USD\"","type":"codeVoice"},{"type":"text","text":") was added reads it as its default."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"version:"},{"type":"text","text":" counts breaking changes only, and is 1 when left out; "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","isActive":true},{"type":"text","text":" shows each"},{"type":"text","text":" "},{"type":"text","text":"kind of change. "},{"type":"codeVoice","code":"consent:"},{"type":"text","text":" sets the event’s "},{"type":"codeVoice","code":"consentCategory"},{"type":"text","text":" ("},{"type":"codeVoice","code":"@Event(consent: .advertising)"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"text":"A stored property whose type isn’t ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" is a compile error that names it:","type":"text"},{"text":" ","type":"text"},{"code":"static method 'requireBinaryCodable(position:)' requires that 'Coordinate' conform to 'BinaryCodable'","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"So are ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" on anything but a struct, and a stored property without a type annotation. Static","type":"text"},{"text":" ","type":"text"},{"text":"and computed properties are left out. The struct keeps its memberwise initializer.","type":"text"}]},{"type":"heading","level":3,"anchor":"Constraining-properties","text":"Constraining properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A property’s type says what kind of value it holds; a constraint says which values of that kind"},{"type":"text","text":" "},{"type":"text","text":"are valid. A rule the type can enforce belongs in the type: a "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value satisfies every"},{"type":"text","text":" "},{"type":"text","text":"constraint of its "},{"type":"codeVoice","code":"Refinement"},{"type":"text","text":" from the moment it is made. Rules a plain "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" can’t"},{"type":"text","text":" "},{"type":"text","text":"carry are declared beside the property with "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":" (module "},{"isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","type":"reference"},{"type":"text","text":"), and the"},{"type":"text","text":" "},{"type":"text","text":"tracker checks them:"}]},{"type":"codeListing","syntax":"swift","code":["enum CouponCode: Refinement {","    static let constraints: [Constraint<String>] = [.pattern(\"^[A-Z0-9]{6}$\", example: \"SPRING\")]","}","","@Event(name: \"search_performed\")","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0))","    var resultCount: Int","    var coupon: Refined<String, CouponCode>?","}","","let coupon = try? Refined<String, CouponCode>(checked: \"spring\")  \/\/ nil: UnsatisfiedConstraint.pattern","let tracker = Tracker()","tracker.track(SearchPerformed(query: \"\", resultCount: 3, coupon: Refined(\"SPRING\")))","await tracker.finish()","for await report in tracker.rejectionReports {","    print(report)  \/\/ search_performed: \"query\" breaks minLength 1 (1 rejected)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The keywords are JSON Schema’s: "},{"type":"codeVoice","code":"minLength"},{"type":"text","text":" and "},{"type":"codeVoice","code":"maxLength"},{"type":"text","text":" (in Unicode scalars) and "},{"type":"codeVoice","code":"pattern"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"a string, "},{"type":"codeVoice","code":"minimum"},{"type":"text","text":" and "},{"type":"codeVoice","code":"maximum"},{"type":"text","text":" for a number, "},{"type":"codeVoice","code":"minItems"},{"type":"text","text":" and "},{"type":"codeVoice","code":"maxItems"},{"type":"text","text":" for an array. Each is"},{"type":"text","text":" "},{"type":"text","text":"offered only for the types it applies to, with its bound in the property’s own type, so"},{"type":"text","text":" "},{"type":"codeVoice","code":".minLength"},{"type":"text","text":" on an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", or "},{"type":"codeVoice","code":".minimum(0.5)"},{"type":"text","text":" on an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", is a compile error. In "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so is a lower bound above its upper bound, a pattern that doesn’t compile, and a pattern whose"},{"type":"text","text":" "},{"type":"codeVoice","code":"example"},{"type":"text","text":" it, or another keyword of the property, rejects. In a "},{"type":"codeVoice","code":"Refinement"},{"type":"text","text":", those trap when its"},{"type":"text","text":" "},{"type":"text","text":"constraints are built. "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":"’s plain initializer traps on a value that breaks its rule, as an"},{"type":"text","text":" "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" subscript does out of range; "},{"type":"codeVoice","code":"init(checked:)"},{"type":"text","text":" throws the "},{"type":"codeVoice","code":"UnsatisfiedConstraint"},{"type":"text","text":" instead."}]},{"type":"heading","level":3,"anchor":"Rejected-events","text":"Rejected events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s worker checks each event’s declared constraints before anything else, never on the"},{"type":"text","text":" "},{"type":"text","text":"caller. An event that breaks one is rejected: never enriched, held by a consent, written to a store"},{"type":"text","text":" "},{"type":"text","text":"or delivered. Each rejection is reported on "},{"type":"codeVoice","code":"tracker.rejectionReports"},{"type":"text","text":" as a "},{"type":"codeVoice","code":"RejectionReport"},{"type":"text","text":" naming"},{"type":"text","text":" "},{"type":"text","text":"the event, the property and the keyword, and in debug builds it is logged at error level too."},{"type":"text","text":" "},{"type":"text","text":"Unread reports merge, one per event, property and keyword, counting the rejections and the range of"},{"type":"text","text":" "},{"type":"text","text":"times they were tracked, so a broken call site in a loop can’t fill memory."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record that a store recovered from an earlier run is checked again, and the store forgets one"},{"type":"text","text":" "},{"type":"text","text":"that a constraint added since rejects. A stored "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value whose rule no longer accepts it"},{"type":"text","text":" "},{"type":"text","text":"doesn’t decode, and the store reports it. A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" property takes no "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":" keywords,"},{"type":"text","text":" "},{"type":"text","text":"since checking one would reveal it; a "},{"type":"codeVoice","code":"Sensitive<Refined<…>>"},{"type":"text","text":" enforces its rule as it is made."}]},{"type":"paragraph","inlineContent":[{"text":"Both kinds of constraint are part of the event’s schema. The exported tracking plan lists them","type":"text"},{"text":" ","type":"text"},{"text":"beside each property’s type, and each example payload satisfies them, using a pattern’s ","type":"text"},{"code":"example","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"reference"},{"text":"). An array’s ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" elements are checked as they are made, but their","type":"text"},{"text":" ","type":"text"},{"text":"rules aren’t exported.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/traffluent\/definingevents"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"title":"Guides","anchor":"Guides"}],"references":{"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"url":"\/documentation\/traffluent\/persistingrecords","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","role":"article","title":"Persisting Records","type":"topic"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"url":"\/documentation\/traffluent\/samplingevents","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","kind":"article","title":"Sampling Events","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}]},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","kind":"article","role":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","title":"Automatic Tracking"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"kind":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","role":"article","title":"Consent Gating","type":"topic"},"doc://EventMacros/documentation/EventMacros":{"url":"\/documentation\/eventmacros","type":"topic","role":"collection","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","kind":"symbol","title":"EventMacros","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"url":"\/documentation\/traffluent\/changingevents","kind":"article","role":"article","abstract":[{"text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","type":"topic","title":"Changing an Event"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"url":"\/documentation\/traffluent\/trackingplanworkflow","kind":"article","role":"article","abstract":[{"text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"topic","title":"Exporting and Checking a Tracking Plan"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","url":"\/documentation\/traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","role":"collection","title":"Traffluent","type":"topic"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"url":"\/documentation\/traffluent\/sessionsandstandardcontext","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","kind":"article","title":"Sessions and Standard Context","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}]}}}