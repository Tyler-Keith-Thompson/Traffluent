{"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/traffluent\/definingevents"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","interfaceLanguage":"swift"},"metadata":{"role":"article","title":"Defining Events","modules":[{"name":"Traffluent"}],"roleHeading":"Article"},"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"anchor":"Guides"}],"abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"kind":"article","sections":[],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"@Event","type":"codeVoice"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","isActive":true,"type":"reference"},{"text":", part of ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":") makes a struct an event from its","type":"text"},{"text":" ","type":"text"},{"text":"declaration, and is how you declare one. It adds the ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" ","type":"text"},{"text":"conformances, the event’s name, consent category and schema version when you give them, and a","type":"text"},{"text":" ","type":"text"},{"code":"schema","type":"codeVoice"},{"text":", an ","type":"text"},{"code":"EventSchema","type":"codeVoice"},{"text":" value that tooling reads:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Traffluent","","@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?","}","","let tracker = Tracker()","tracker.track(CheckoutStarted(cartSize: 3, coupon: nil))","let properties = CheckoutStarted.schema.properties.map(\\.name)  \/\/ [\"cartSize\", \"coupon\"]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The schema holds the name, the version, the consent category and each stored property’s name, its"},{"type":"text","text":" "},{"type":"text","text":"type as written, its optionality and whether it has a default value, in declaration order. The"},{"type":"text","text":" "},{"type":"text","text":"encoding writes each of those properties under its name ("},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"reference","isActive":true},{"type":"text","text":"), and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" property keeps its redaction. The "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" protocols’ documentation"},{"type":"text","text":" "},{"type":"text","text":"shows the same conformances written by hand. A record stored before a property with a default value"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"var currency: String = \"USD\""},{"type":"text","text":") was added reads it as its default."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"version:"},{"text":" counts breaking changes only, and is 1 when left out; ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents"},{"text":" shows each","type":"text"},{"text":" ","type":"text"},{"text":"kind of change. ","type":"text"},{"type":"codeVoice","code":"consent:"},{"text":" sets the event’s ","type":"text"},{"type":"codeVoice","code":"consentCategory"},{"text":" (","type":"text"},{"type":"codeVoice","code":"@Event(consent: .advertising)"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A stored property whose type isn’t ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" is a compile error that names it:","type":"text"},{"text":" ","type":"text"},{"code":"static method 'requireBinaryCodable(position:)' requires that 'Coordinate' conform to 'BinaryCodable'","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"So are ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" on anything but a struct, and a stored property without a type annotation. Static","type":"text"},{"text":" ","type":"text"},{"text":"and computed properties are left out. The struct keeps its memberwise initializer.","type":"text"}]},{"level":3,"type":"heading","text":"Constraining properties","anchor":"Constraining-properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A property’s type says what kind of value it holds; a constraint says which values of that kind"},{"type":"text","text":" "},{"type":"text","text":"are valid. A rule the type can enforce belongs in the type: a "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value satisfies every"},{"type":"text","text":" "},{"type":"text","text":"constraint of its "},{"type":"codeVoice","code":"Refinement"},{"type":"text","text":" from the moment it is made. Rules a plain "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" can’t"},{"type":"text","text":" "},{"type":"text","text":"carry are declared beside the property with "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","isActive":true},{"type":"text","text":"), and the"},{"type":"text","text":" "},{"type":"text","text":"tracker checks them:"}]},{"type":"codeListing","syntax":"swift","code":["enum CouponCode: Refinement {","    static var constraints: [Constraint<String>] {","        get throws(InvalidConstraint) { try [.pattern(\"^[A-Z0-9]{6}$\", example: \"SPRING\")] }","    }","}","","@Event(name: \"search_performed\")","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0))","    var resultCount: Int","    var coupon: Refined<String, CouponCode>?","}","","let coupon = try? Refined<String, CouponCode>(\"spring\")  \/\/ nil: UnsatisfiedConstraint.pattern","let tracker = Tracker()","tracker.track(SearchPerformed(query: \"\", resultCount: 3, coupon: try Refined(\"SPRING\")))","await tracker.finish()","for await report in tracker.rejectionReports {","    print(report)  \/\/ search_performed: \"query\" breaks minLength 1 (1 rejected)","}"]},{"type":"paragraph","inlineContent":[{"text":"The keywords are JSON Schema’s: ","type":"text"},{"type":"codeVoice","code":"minLength"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"maxLength"},{"text":" (in Unicode scalars) and ","type":"text"},{"type":"codeVoice","code":"pattern"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"a string, ","type":"text"},{"type":"codeVoice","code":"minimum"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"maximum"},{"text":" for a number, ","type":"text"},{"type":"codeVoice","code":"minItems"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"maxItems"},{"text":" for an array. Each is","type":"text"},{"text":" ","type":"text"},{"text":"offered only for the types it applies to, with its bound in the property’s own type, so","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".minLength"},{"text":" on an ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":", or ","type":"text"},{"type":"codeVoice","code":".minimum(0.5)"},{"text":" on an ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":", is a compile error. In ","type":"text"},{"type":"codeVoice","code":"@Constrained"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so is a lower bound above its upper bound, a pattern that doesn’t compile, and a pattern whose","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"example"},{"text":" it, or another keyword of the property, rejects. Built at run time, as a ","type":"text"},{"type":"codeVoice","code":"Refinement"},{"text":"‘s","type":"text"},{"text":" ","type":"text"},{"text":"are, a constraint with an argument no JSON Schema could state (a negative length, a bound that","type":"text"},{"text":" ","type":"text"},{"text":"isn’t finite, a pattern that doesn’t compile or doesn’t match its example) throws","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InvalidConstraint"},{"text":". ","type":"text"},{"type":"codeVoice","code":"Refined"},{"text":"‘s initializer throws the ","type":"text"},{"type":"codeVoice","code":"UnsatisfiedConstraint"},{"text":" of the first","type":"text"},{"text":" ","type":"text"},{"text":"constraint a value breaks, or ","type":"text"},{"type":"codeVoice","code":"invalidConstraint"},{"text":" when the rule’s constraints throw.","type":"text"}]},{"level":3,"type":"heading","text":"Rejected events","anchor":"Rejected-events"},{"type":"paragraph","inlineContent":[{"text":"The tracker’s worker checks each event’s declared constraints before anything else, never on the","type":"text"},{"text":" ","type":"text"},{"text":"caller. An event that breaks one is rejected: never enriched, held by a consent, written to a store","type":"text"},{"text":" ","type":"text"},{"text":"or delivered. Each rejection is reported on ","type":"text"},{"code":"tracker.rejectionReports","type":"codeVoice"},{"text":" as a ","type":"text"},{"code":"RejectionReport","type":"codeVoice"},{"text":" naming","type":"text"},{"text":" ","type":"text"},{"text":"the event, the property and the keyword, and in debug builds it is logged at error level too.","type":"text"},{"text":" ","type":"text"},{"text":"Unread reports merge, one per event, property and keyword, counting the rejections and the range of","type":"text"},{"text":" ","type":"text"},{"text":"times they were tracked, so a broken call site in a loop can’t fill memory.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A record that a store recovered from an earlier run is checked again, and the store forgets one","type":"text"},{"text":" ","type":"text"},{"text":"that a constraint added since rejects. A stored ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" value whose rule no longer accepts it","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t decode, and the store reports it. A ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" property takes no ","type":"text"},{"code":"@Constrained","type":"codeVoice"},{"text":" keywords,","type":"text"},{"text":" ","type":"text"},{"text":"since checking one would reveal it; a ","type":"text"},{"code":"Sensitive<Refined<…>>","type":"codeVoice"},{"text":" enforces its rule as it is made.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both kinds of constraint are part of the event’s schema. The exported tracking plan lists them"},{"type":"text","text":" "},{"type":"text","text":"beside each property’s type, and each example payload satisfies them, using a pattern’s "},{"code":"example","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","isActive":true},{"type":"text","text":"). An array’s "},{"code":"Refined","type":"codeVoice"},{"type":"text","text":" elements are checked as they are made, but their"},{"type":"text","text":" "},{"type":"text","text":"rules aren’t exported."}]}],"kind":"content"}],"references":{"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","role":"article","type":"topic","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","url":"\/documentation\/traffluent\/trackingplanworkflow"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"role":"article","title":"Persisting Records","url":"\/documentation\/traffluent\/persistingrecords","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","type":"topic","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"role":"collection","url":"\/documentation\/traffluent","title":"Traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://EventMacros/documentation/EventMacros":{"url":"\/documentation\/eventmacros","role":"collection","type":"topic","kind":"symbol","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","title":"EventMacros"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"url":"\/documentation\/traffluent\/samplingevents","role":"article","type":"topic","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","title":"Sampling Events"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"kind":"article","type":"topic","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"role":"article","title":"Sessions and Standard Context","url":"\/documentation\/traffluent\/sessionsandstandardcontext","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"type":"topic","title":"Changing an Event","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"kind":"article","url":"\/documentation\/traffluent\/changingevents","role":"article"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"url":"\/documentation\/traffluent\/consentgating","role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","title":"Consent Gating"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","role":"article","type":"topic","kind":"article","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","url":"\/documentation\/traffluent\/automatictracking"}}}