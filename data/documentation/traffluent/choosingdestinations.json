{"metadata":{"role":"article","roleHeading":"Article","title":"Choosing Destinations","modules":[{"name":"Traffluent"}]},"sections":[],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","interfaceLanguage":"swift"},"kind":"article","seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"]}],"variants":[{"paths":["\/documentation\/traffluent\/choosingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A "},{"code":"Destination","type":"codeVoice"},{"type":"text","text":" is a plain sink: "},{"code":"deliver(to:)","type":"codeVoice"},{"type":"text","text":" hands it each batch of records. Traffluent ships a"},{"type":"text","text":" "},{"type":"text","text":"few, each in a module of its own, so an app links only the ones it uses."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Logs and traces","anchor":"Logs-and-traces"},{"inlineContent":[{"type":"text","text":"To see events beside your logs or traces, deliver to "},{"type":"codeVoice","code":"LoggerDestination(logger:)"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","type":"reference","isActive":true},{"type":"text","text":") or "},{"type":"codeVoice","code":"SpanEventDestination(tracer:)"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","type":"reference","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Only apps that use swift-log or swift-distributed-tracing this way link them. A span event joins"},{"type":"text","text":" "},{"type":"text","text":"the span that was active when the event was tracked, even if delivery runs later."}],"type":"paragraph"},{"level":3,"type":"heading","text":"A server","anchor":"A-server"},{"inlineContent":[{"text":"To send batches to a server, deliver to ","type":"text"},{"type":"codeVoice","code":"HTTPDestination(endpoint:headerFields:encoder:)"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"text":"). It posts each batch as one request whose body is what your ","type":"text"},{"type":"codeVoice","code":"BatchEncoder"},{"text":" ","type":"text"},{"text":"writes for it, so events need no ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" conformance and the wire format is yours. A failed send","type":"text"},{"text":" ","type":"text"},{"text":"is logged and dropped, without holding up the other destinations. It sends with ","type":"text"},{"type":"codeVoice","code":"URLSession"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, or through any ","type":"text"},{"type":"codeVoice","code":"HTTPTransport"},{"text":" you pass as ","type":"text"},{"type":"codeVoice","code":"transport:"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The bootstrapped tracing instrument, or the one you pass as ","type":"text"},{"code":"instrument:","type":"codeVoice"},{"text":", injects the trace","type":"text"},{"text":" ","type":"text"},{"text":"context of the batch’s first record into the request’s header fields, so a server that extracts it","type":"text"},{"text":" ","type":"text"},{"text":"joins the request to the app’s trace. The encoder’s ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":" always wins, and with no","type":"text"},{"text":" ","type":"text"},{"text":"instrument bootstrapped no header is added. Only the first record’s context travels in the header","type":"text"},{"text":" ","type":"text"},{"text":"fields; write each record’s context into the body if the server needs it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To send to a self-hosted TraffluentCollector, give "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" a"},{"type":"text","text":" "},{"code":"CollectorBatchEncoder(plan:)","type":"codeVoice"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","type":"reference","isActive":true},{"type":"text","text":") as its encoder, and the collector’s"},{"type":"text","text":" "},{"type":"text","text":"API key as an "},{"code":"Authorization: Bearer","type":"codeVoice"},{"type":"text","text":" header field. It writes the collector’s ingest format: each"},{"type":"text","text":" "},{"type":"text","text":"record’s identifier (which a redelivered record keeps), its name, timestamp and redelivery marker,"},{"type":"text","text":" "},{"type":"text","text":"its properties read through the event’s schema in your "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":", and its standard context and"},{"type":"text","text":" "},{"type":"text","text":"trace context. A "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is sent only while the record reveals it."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Memory","anchor":"Memory"},{"inlineContent":[{"text":"To read what was tracked inside the app, deliver to an ","type":"text"},{"type":"codeVoice","code":"InMemoryDestination"},{"text":" as well (module","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations"},{"text":"): for an event inspector in a debug build, a recent-activity view, a SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"preview, or a test of what your code tracks. It keeps the newest 1,000 records, or as many as you","type":"text"},{"text":" ","type":"text"},{"text":"pass as ","type":"text"},{"type":"codeVoice","code":"capacity:"},{"text":", dropping the oldest across batches; ","type":"text"},{"type":"codeVoice","code":"InMemoryDestination.unbounded()"},{"text":" keeps","type":"text"},{"text":" ","type":"text"},{"text":"every one. Read it with ","type":"text"},{"type":"codeVoice","code":"events(of: SignedUp.self)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"records"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"batches"},{"text":", or wait on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"deliveries"},{"text":", which announces each batch to one reader.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Sensitive values and call sites","anchor":"Sensitive-values-and-call-sites"},{"inlineContent":[{"type":"text","text":"A property that destinations shouldn’t see unless they must is a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value. A destination"},{"type":"text","text":" "},{"type":"text","text":"reads it only through the record, with "},{"type":"codeVoice","code":"reveal(_:)"},{"type":"text","text":", and printing or mirroring it shows"},{"type":"text","text":" "},{"type":"codeVoice","code":"<redacted>"},{"type":"text","text":". "},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":" makes a destination’s records reveal nothing, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"droppingCallSite()"},{"type":"text","text":" removes their call sites. Every other destination receives both:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SignedIn: Event {","    var email: Sensitive<String>","}","","let backend = InMemoryDestination()","let vendor = InMemoryDestination()","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: backend,","    vendor.redactingSensitiveValues().droppingCallSite()",")","tracker.track(SignedIn(email: Sensitive(\"ada@example.com\")))","await tracker.finish()","try await delivery.execute()","let event = backend.events(of: SignedIn.self)[0]","let email = backend.records[0].reveal(event.email)    \/\/ \"ada@example.com\"","let redacted = vendor.records[0].reveal(event.email)  \/\/ nil","let callSite = vendor.records[0].sourceLocation       \/\/ nil"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"accepting(_:)"},{"text":" narrows a destination to the consent categories it serves (","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},{"text":").","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","role":"article","url":"\/documentation\/traffluent\/trackingfromviews","kind":"article","title":"Tracking from SwiftUI, UIKit and AppKit","type":"topic","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}]},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"kind":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","type":"topic","role":"article","title":"Testing What Your Code Tracks"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/docume