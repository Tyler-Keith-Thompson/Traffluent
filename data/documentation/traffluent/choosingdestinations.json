{"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","interfaceLanguage":"swift"},"metadata":{"title":"Choosing Destinations","roleHeading":"Article","role":"article","modules":[{"name":"Traffluent"}]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Destination","type":"codeVoice"},{"text":" is a plain sink: ","type":"text"},{"code":"deliver(to:)","type":"codeVoice"},{"text":" hands it each batch of records. Traffluent ships a","type":"text"},{"text":" ","type":"text"},{"text":"few, each in a module of its own, so an app links only the ones it uses.","type":"text"}]},{"type":"heading","anchor":"Logs-and-traces","text":"Logs and traces","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To see events beside your logs or traces, deliver to "},{"type":"codeVoice","code":"LoggerDestination(logger:)"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","isActive":true},{"type":"text","text":") or "},{"type":"codeVoice","code":"SpanEventDestination(tracer:)"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Only apps that use swift-log or swift-distributed-tracing this way link them. A span event joins"},{"type":"text","text":" "},{"type":"text","text":"the span that was active when the event was tracked, even if delivery runs later."}]},{"type":"heading","anchor":"A-server","text":"A server","level":3},{"type":"paragraph","inlineContent":[{"text":"To send batches to a server, deliver to ","type":"text"},{"type":"codeVoice","code":"HTTPDestination(endpoint:headerFields:encoder:)"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"text":"). It posts each batch as one request whose body is what your ","type":"text"},{"type":"codeVoice","code":"BatchEncoder"},{"text":" ","type":"text"},{"text":"writes for it, so events need no ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" conformance and the wire format is yours. A failed send","type":"text"},{"text":" ","type":"text"},{"text":"is logged and dropped, without holding up the other destinations. It sends with ","type":"text"},{"type":"codeVoice","code":"URLSession"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, or through any ","type":"text"},{"type":"codeVoice","code":"HTTPTransport"},{"text":" you pass as ","type":"text"},{"type":"codeVoice","code":"transport:"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The bootstrapped tracing instrument, or the one you pass as "},{"type":"codeVoice","code":"instrument:"},{"type":"text","text":", injects the trace"},{"type":"text","text":" "},{"type":"text","text":"context of the batch’s first record into the request’s header fields, so a server that extracts it"},{"type":"text","text":" "},{"type":"text","text":"joins the request to the app’s trace. The encoder’s "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" always wins, and with no"},{"type":"text","text":" "},{"type":"text","text":"instrument bootstrapped no header is added. Only the first record’s context travels in the header"},{"type":"text","text":" "},{"type":"text","text":"fields; write each record’s context into the body if the server needs it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to a self-hosted TraffluentCollector, give "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"codeVoice","code":"CollectorBatchEncoder(plan:)"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},{"type":"text","text":") as its encoder, and the collector’s"},{"type":"text","text":" "},{"type":"text","text":"API key as an "},{"type":"codeVoice","code":"Authorization: Bearer"},{"type":"text","text":" header field. It writes the collector’s ingest format: each"},{"type":"text","text":" "},{"type":"text","text":"record’s identifier (which a redelivered record keeps), its name, timestamp and redelivery marker,"},{"type":"text","text":" "},{"type":"text","text":"its properties read through the event’s schema in your "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":", and its standard context and"},{"type":"text","text":" "},{"type":"text","text":"trace context. A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent only while the record reveals it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the rest of its batch is sent."},{"type":"text","text":" "},{"type":"text","text":"That happens when the plan has no schema for the record’s event at its version (an event the"},{"type":"text","text":" "},{"type":"text","text":"library tracks, such as "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":", that the plan doesn’t list), when the event isn’t"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":", or when a value has no JSON form, such as a NaN. The encoder logs each skipped"},{"type":"text","text":" "},{"type":"text","text":"record at error level, and "},{"type":"codeVoice","code":"batch(of:)"},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s. A batch with no record"},{"type":"text","text":" "},{"type":"text","text":"the encoder can write sends nothing."}]},{"type":"heading","anchor":"Memory","text":"Memory","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To read what was tracked inside the app, deliver to an "},{"type":"codeVoice","code":"InMemoryDestination"},{"type":"text","text":" as well (module"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations"},{"type":"text","text":"): for an event inspector in a debug build, a recent-activity view, a SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"preview, or a test of what your code tracks. It keeps the newest 1,000 records, or as many as you"},{"type":"text","text":" "},{"type":"text","text":"pass as "},{"type":"codeVoice","code":"capacity:"},{"type":"text","text":", dropping the oldest across batches; "},{"type":"codeVoice","code":"InMemoryDestination.unbounded()"},{"type":"text","text":" keeps"},{"type":"text","text":" "},{"type":"text","text":"every one. Read it with "},{"type":"codeVoice","code":"events(of: SignedUp.self)"},{"type":"text","text":", "},{"type":"codeVoice","code":"records"},{"type":"text","text":" or "},{"type":"codeVoice","code":"batches"},{"type":"text","text":", or wait on"},{"type":"text","text":" "},{"type":"codeVoice","code":"deliveries"},{"type":"text","text":", which announces each batch to one reader."}]},{"type":"heading","anchor":"Sensitive-values-and-call-sites","text":"Sensitive values and call sites","level":3},{"type":"paragraph","inlineContent":[{"text":"A property that destinations shouldn’t see unless they must is a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value. A destination","type":"text"},{"text":" ","type":"text"},{"text":"reads it only through the record, with ","type":"text"},{"type":"codeVoice","code":"reveal(_:)"},{"text":", and printing or mirroring it shows","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"<redacted>"},{"text":". ","type":"text"},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"text":" makes a destination’s records reveal nothing, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"droppingCallSite()"},{"text":" removes their call sites. Every other destination receives both:","type":"text"}]},{"type":"codeListing","code":["struct SignedIn: Event {","    var email: Sensitive<String>","}","","let backend = InMemoryDestination()","let vendor = InMemoryDestination()","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: backend,","    vendor.redactingSensitiveValues().droppingCallSite()",")","tracker.track(SignedIn(email: Sensitive(\"ada@example.com\")))","await tracker.finish()","try await delivery.execute()","let event = backend.events(of: SignedIn.self)[0]","let email = backend.records[0].reveal(event.email)    \/\/ \"ada@example.com\"","let redacted = vendor.records[0].reveal(event.email)  \/\/ nil","let callSite = vendor.records[0].sourceLocation       \/\/ nil"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":" narrows a destination to the consent categories it serves ("},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"reference","isActive":true},{"type":"text","text":")."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/choosingdestinations"]}],"abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"anchor":"Essentials","title":"Essentials"}],"references":{"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"url":"\/documentation\/traffluent\/trackingevents","role":"article","title":"Tracking Events","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","role":"collection","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/collectorencoding","title":"CollectorEncoding"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","role":"collection","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/httpdestinations","title":"HTTPDestinations"},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","role":"collection","title":"Destinations","abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","role":"article","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"type":"topic","kind":"article","url":"\/documentation\/traffluent\/testingwhatyoutrack","title":"Testing What Your Code Tracks"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"url":"\/documentation\/traffluent\/trackingfromviews","role":"article","title":"Tracking from SwiftUI, UIKit and AppKit","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","role":"collection","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/loggingdestinations","title":"LoggingDestinations"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","role":"collection","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/traffluent","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","role":"article","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"type":"topic","kind":"article","url":"\/documentation\/traffluent\/consentgating","title":"Consent Gating"},"doc://TracingDestinations/documentation/TracingDestinations":{"url":"\/documentation\/tracingdestinations","role":"collection","title":"TracingDestinations","abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations"}}}