{"variants":[{"paths":["\/documentation\/traffluent\/choosingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Article","title":"Choosing Destinations","role":"article"},"abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"kind":"article","sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"title":"Essentials"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"code":"Destination","type":"codeVoice"},{"type":"text","text":" is a plain sink: "},{"code":"deliver(to:)","type":"codeVoice"},{"type":"text","text":" hands it each batch of records. Traffluent ships a"},{"type":"text","text":" "},{"type":"text","text":"few, each in a module of its own, so an app links only the ones it uses."}],"type":"paragraph"},{"text":"Logs and traces","anchor":"Logs-and-traces","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"To see events beside your logs or traces, deliver to "},{"type":"codeVoice","code":"LoggerDestination(logger:)"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","isActive":true},{"type":"text","text":") or "},{"type":"codeVoice","code":"SpanEventDestination(tracer:)"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Only apps that use swift-log or swift-distributed-tracing this way link them. A span event joins"},{"type":"text","text":" "},{"type":"text","text":"the span that was active when the event was tracked, even if delivery runs later."}],"type":"paragraph"},{"text":"A server","anchor":"A-server","level":3,"type":"heading"},{"inlineContent":[{"text":"To send batches to a server, deliver to ","type":"text"},{"code":"HTTPDestination(endpoint:headerFields:encoder:)","type":"codeVoice"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"text":"). It posts each batch as one request whose body is what your ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" ","type":"text"},{"text":"writes for it, so events need no ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance and the wire format is yours. It sends with","type":"text"},{"text":" ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" by default, or through any ","type":"text"},{"code":"HTTPTransport","type":"codeVoice"},{"text":" you pass as ","type":"text"},{"code":"transport:","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after a wait, until it is"},{"type":"text","text":" "},{"type":"text","text":"answered with 2xx. The waits start at 1 second and double up to 60 seconds; pass an"},{"type":"text","text":" "},{"type":"codeVoice","code":"ExponentialBackoff"},{"type":"text","text":" as "},{"type":"codeVoice","code":"backoff:"},{"type":"text","text":" for others, and a test clock as "},{"type":"codeVoice","code":"clock:"},{"type":"text","text":" in tests. The"},{"type":"text","text":" "},{"type":"text","text":"destination takes the next batch only once this one arrives, so a tracker’s store keeps its records"},{"type":"text","text":" "},{"type":"text","text":"until then, and a batch still being retried when the app ends is sent again on the next launch."},{"type":"text","text":" "},{"type":"text","text":"Other destinations aren’t held up. Meanwhile the delivery’s later batches wait in this"},{"type":"text","text":" "},{"type":"text","text":"destination’s buffer of "},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" batches, which drops its oldest when full; a store keeps"},{"type":"text","text":" "},{"type":"text","text":"the records of a dropped batch for the next launch."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Some batches won’t succeed if sent again, so they are dropped: one the endpoint answers with any"},{"type":"text","text":" "},{"type":"text","text":"other status, one whose request the transport can never send (a malformed URL, a scheme it doesn’t"},{"type":"text","text":" "},{"type":"text","text":"support, or an "},{"code":"http","type":"codeVoice"},{"type":"text","text":" URL that App Transport Security refuses), and one the encoder can’t encode."},{"type":"text","text":" "},{"type":"text","text":"The destination logs each at error level and reports it on "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":", with the records’"},{"type":"text","text":" "},{"type":"text","text":"identifiers and the status, the transport’s reason or the encoder’s error. Cancelling the delivery"},{"type":"text","text":" "},{"type":"text","text":"stops the retries."}],"type":"paragraph"},{"inlineContent":[{"text":"The bootstrapped tracing instrument, or the one you pass as ","type":"text"},{"type":"codeVoice","code":"instrument:"},{"text":", injects the trace","type":"text"},{"text":" ","type":"text"},{"text":"context of the batch’s first record into the request’s header fields, so a server that extracts it","type":"text"},{"text":" ","type":"text"},{"text":"joins the request to the app’s trace. The encoder’s ","type":"text"},{"type":"codeVoice","code":"Content-Type"},{"text":" always wins, and with no","type":"text"},{"text":" ","type":"text"},{"text":"instrument bootstrapped no header is added. Only the first record’s context travels in the header","type":"text"},{"text":" ","type":"text"},{"text":"fields; write each record’s context into the body if the server needs it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To send to a self-hosted TraffluentCollector, give ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"code":"CollectorBatchEncoder(plan:)","type":"codeVoice"},{"text":" (module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},{"text":") as its encoder, and the collector’s","type":"text"},{"text":" ","type":"text"},{"text":"API key as an ","type":"text"},{"code":"Authorization: Bearer","type":"codeVoice"},{"text":" header field. It writes the collector’s ingest format: each","type":"text"},{"text":" ","type":"text"},{"text":"record’s identifier (which a redelivered record keeps), its name, timestamp and redelivery marker,","type":"text"},{"text":" ","type":"text"},{"text":"its properties read through the event’s schema in your ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":", and its standard context and","type":"text"},{"text":" ","type":"text"},{"text":"trace context. A ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is sent only while the record reveals it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the rest of its batch is sent."},{"type":"text","text":" "},{"type":"text","text":"That happens when the plan has no schema for the record’s event at its version (an event the"},{"type":"text","text":" "},{"type":"text","text":"library tracks, such as "},{"code":"SessionStarted","type":"codeVoice"},{"type":"text","text":", that the plan doesn’t list), when the event isn’t"},{"type":"text","text":" "},{"code":"BinaryCodable","type":"codeVoice"},{"type":"text","text":", or when a value has no JSON form, such as a NaN. The encoder logs each skipped"},{"type":"text","text":" "},{"type":"text","text":"record at error level, and "},{"code":"batch(of:)","type":"codeVoice"},{"type":"text","text":" returns them as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s. A batch with no record"},{"type":"text","text":" "},{"type":"text","text":"the encoder can write sends nothing."}],"type":"paragraph"},{"text":"Memory","anchor":"Memory","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"To read what was tracked inside the app, deliver to an "},{"type":"codeVoice","code":"InMemoryDestination"},{"type":"text","text":" as well (module"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations"},{"type":"text","text":"): for an event inspector in a debug build, a recent-activity view, a SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"preview, or a test of what your code tracks. It keeps the newest 1,000 records, or as many as you"},{"type":"text","text":" "},{"type":"text","text":"pass as "},{"type":"codeVoice","code":"capacity:"},{"type":"text","text":", dropping the oldest across batches; "},{"type":"codeVoice","code":"InMemoryDestination.unbounded()"},{"type":"text","text":" keeps"},{"type":"text","text":" "},{"type":"text","text":"every one. Read it with "},{"type":"codeVoice","code":"events(of: SignedUp.self)"},{"type":"text","text":", "},{"type":"codeVoice","code":"records"},{"type":"text","text":" or "},{"type":"codeVoice","code":"batches"},{"type":"text","text":", or wait on"},{"type":"text","text":" "},{"type":"codeVoice","code":"deliveries"},{"type":"text","text":", which announces each batch to one reader."}],"type":"paragraph"},{"text":"Sensitive values and call sites","anchor":"Sensitive-values-and-call-sites","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A property that destinations shouldn’t see unless they must is a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value. A destination"},{"type":"text","text":" "},{"type":"text","text":"reads it only through the record, with "},{"type":"codeVoice","code":"reveal(_:)"},{"type":"text","text":", and printing or mirroring it shows"},{"type":"text","text":" "},{"type":"codeVoice","code":"<redacted>"},{"type":"text","text":". "},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":" makes a destination’s records reveal nothing, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"droppingCallSite()"},{"type":"text","text":" removes their call sites. Every other destination receives both:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SignedIn: Event {","    var email: Sensitive<String>","}","","let backend = InMemoryDestination()","let vendor = InMemoryDestination()","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: backend,","    vendor.redactingSensitiveValues().droppingCallSite()",")","tracker.track(SignedIn(email: Sensitive(\"ada@example.com\")))","await tracker.finish()","try await delivery.execute()","let event = backend.events(of: SignedIn.self)[0]","let email = backend.records[0].reveal(event.email)    \/\/ \"ada@example.com\"","let redacted = vendor.records[0].reveal(event.email)  \/\/ nil","let callSite = vendor.records[0].sourceLocation       \/\/ nil"],"type":"codeListing"},{"inlineContent":[{"code":"accepting(_:)","type":"codeVoice"},{"text":" narrows a destination to the consent categories it serves (","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"reference","isActive":true},{"text":").","type":"text"}],"type":"paragraph"}]}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations":{"role":"collection","type":"topic","url":"\/documentation\/httpdestinations","abstract":[],"title":"HTTPDestinations","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"role":"collection","type":"topic","url":"\/documentation\/collectorencoding","abstract":[],"title":"CollectorEncoding","kind":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},"doc://Traffluent/documentation/Traffluent":{"role":"collection","type":"topic","url":"\/documentation\/traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"title":"Traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"role":"collection","type":"topic","url":"\/documentation\/loggingdestinations","abstract":[],"title":"LoggingDestinations","kind":"symbol","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"doc://TracingDestinations/documentation/TracingDestinations":{"role":"collection","type":"topic","url":"\/documentation\/tracingdestinations","abstract":[],"title":"TracingDestinations","kind":"symbol","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","type":"topic","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"url":"\/documentation\/traffluent\/trackingevents","title":"Tracking Events","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"type":"topic","title":"Tracking from SwiftUI, UIKit and AppKit","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"url":"\/documentation\/traffluent\/trackingfromviews","kind":"article"},"doc://Destinations/documentation/Destinations":{"role":"collection","type":"topic","url":"\/documentation\/destinations","abstract":[],"title":"Destinations","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"type":"topic","title":"Testing What Your Code Tracks","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","url":"\/documentation\/traffluent\/testingwhatyoutrack","kind":"article","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}]},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"type":"topic","title":"Consent Gating","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","url":"\/documentation\/traffluent\/consentgating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"kind":"article"}}}