{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/traffluent\/choosingdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"anchor":"Essentials","generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"title":"Essentials"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Destination"},{"text":" is a plain sink: ","type":"text"},{"type":"codeVoice","code":"deliver(to:)"},{"text":" hands it each batch of records. Traffluent ships a","type":"text"},{"text":" ","type":"text"},{"text":"few, each in a module of its own, so an app links only the ones it uses.","type":"text"}]},{"type":"heading","level":3,"text":"Logs and traces","anchor":"Logs-and-traces"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To see events beside your logs or traces, deliver to "},{"code":"LoggerDestination(logger:)","type":"codeVoice"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","isActive":true,"type":"reference"},{"type":"text","text":") or "},{"code":"SpanEventDestination(tracer:)","type":"codeVoice"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","isActive":true,"type":"reference"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Only apps that use swift-log or swift-distributed-tracing this way link them. A span event joins"},{"type":"text","text":" "},{"type":"text","text":"the span that was active when the event was tracked, even if delivery runs later."}]},{"type":"heading","level":3,"text":"A server","anchor":"A-server"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send batches to a server, deliver to "},{"type":"codeVoice","code":"HTTPDestination(endpoint:headerFields:encoder:)"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"type":"text","text":"). It posts each batch as one request whose body is what your "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" "},{"type":"text","text":"writes for it, so events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance and the wire format is yours. A failed send"},{"type":"text","text":" "},{"type":"text","text":"is logged and dropped, without holding up the other destinations. It sends with "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, or through any "},{"type":"codeVoice","code":"HTTPTransport"},{"type":"text","text":" you pass as "},{"type":"codeVoice","code":"transport:"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The bootstrapped tracing instrument, or the one you pass as "},{"type":"codeVoice","code":"instrument:"},{"type":"text","text":", injects the trace"},{"type":"text","text":" "},{"type":"text","text":"context of the batch’s first record into the request’s header fields, so a server that extracts it"},{"type":"text","text":" "},{"type":"text","text":"joins the request to the app’s trace. The encoder’s "},{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" always wins, and with no"},{"type":"text","text":" "},{"type":"text","text":"instrument bootstrapped no header is added. Only the first record’s context travels in the header"},{"type":"text","text":" "},{"type":"text","text":"fields; write each record’s context into the body if the server needs it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to a self-hosted TraffluentCollector, give "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" a"},{"type":"text","text":" "},{"code":"CollectorBatchEncoder(plan:)","type":"codeVoice"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","isActive":true},{"type":"text","text":") as its encoder, and the collector’s"},{"type":"text","text":" "},{"type":"text","text":"API key as an "},{"code":"Authorization: Bearer","type":"codeVoice"},{"type":"text","text":" header field. It writes the collector’s ingest format: each"},{"type":"text","text":" "},{"type":"text","text":"record’s identifier (which a redelivered record keeps), its name, timestamp and redelivery marker,"},{"type":"text","text":" "},{"type":"text","text":"its properties read through the event’s schema in your "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":", and its standard context and"},{"type":"text","text":" "},{"type":"text","text":"trace context. A "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is sent only while the record reveals it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the rest of its batch is sent."},{"type":"text","text":" "},{"type":"text","text":"That happens when the plan has no schema for the record’s event at its version (an event the"},{"type":"text","text":" "},{"type":"text","text":"library tracks, such as "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":", that the plan doesn’t list), when the event isn’t"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":", or when a value has no JSON form, such as a NaN. The encoder logs each skipped"},{"type":"text","text":" "},{"type":"text","text":"record at error level, and "},{"type":"codeVoice","code":"batch(of:)"},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s. A batch with no record"},{"type":"text","text":" "},{"type":"text","text":"the encoder can write sends nothing."}]},{"type":"heading","level":3,"text":"Memory","anchor":"Memory"},{"type":"paragraph","inlineContent":[{"text":"To read what was tracked inside the app, deliver to an ","type":"text"},{"type":"codeVoice","code":"InMemoryDestination"},{"text":" as well (module","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","isActive":true,"type":"reference"},{"text":"): for an event inspector in a debug build, a recent-activity view, a SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"preview, or a test of what your code tracks. It keeps the newest 1,000 records, or as many as you","type":"text"},{"text":" ","type":"text"},{"text":"pass as ","type":"text"},{"type":"codeVoice","code":"capacity:"},{"text":", dropping the oldest across batches; ","type":"text"},{"type":"codeVoice","code":"InMemoryDestination.unbounded()"},{"text":" keeps","type":"text"},{"text":" ","type":"text"},{"text":"every one. Read it with ","type":"text"},{"type":"codeVoice","code":"events(of: SignedUp.self)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"records"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"batches"},{"text":", or wait on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"deliveries"},{"text":", which announces each batch to one reader.","type":"text"}]},{"type":"heading","level":3,"text":"Sensitive values and call sites","anchor":"Sensitive-values-and-call-sites"},{"type":"paragraph","inlineContent":[{"text":"A property that destinations shouldn’t see unless they must is a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value. A destination","type":"text"},{"text":" ","type":"text"},{"text":"reads it only through the record, with ","type":"text"},{"code":"reveal(_:)","type":"codeVoice"},{"text":", and printing or mirroring it shows","type":"text"},{"text":" ","type":"text"},{"code":"<redacted>","type":"codeVoice"},{"text":". ","type":"text"},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"text":" makes a destination’s records reveal nothing, and","type":"text"},{"text":" ","type":"text"},{"code":"droppingCallSite()","type":"codeVoice"},{"text":" removes their call sites. Every other destination receives both:","type":"text"}]},{"code":["struct SignedIn: Event {","    var email: Sensitive<String>","}","","let backend = InMemoryDestination()","let vendor = InMemoryDestination()","let tracker = Tracker()","let delivery = tracker.records.batch().deliver(","    to: backend,","    vendor.redactingSensitiveValues().droppingCallSite()",")","tracker.track(SignedIn(email: Sensitive(\"ada@example.com\")))","await tracker.finish()","try await delivery.execute()","let event = backend.events(of: SignedIn.self)[0]","let email = backend.records[0].reveal(event.email)    \/\/ \"ada@example.com\"","let redacted = vendor.records[0].reveal(event.email)  \/\/ nil","let callSite = vendor.records[0].sourceLocation       \/\/ nil"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"accepting(_:)","type":"codeVoice"},{"text":" narrows a destination to the consent categories it serves (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"reference"},{"text":").","type":"text"}]}]}],"metadata":{"role":"article","modules":[{"name":"Traffluent"}],"title":"Choosing Destinations","roleHeading":"Article"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},"kind":"article","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"references":{"doc://Destinations/documentation/Destinations":{"kind":"symbol","role":"collection","title":"Destinations","abstract":[],"type":"topic","url":"\/documentation\/destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","title":"HTTPDestinations","url":"\/documentation\/httpdestinations","role":"collection"},"doc://Traffluent/documentation/Traffluent":{"type":"topic","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","url":"\/documentation\/traffluent","role":"collection"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"kind":"symbol","role":"collection","title":"LoggingDestinations","abstract":[],"type":"topic","url":"\/documentation\/loggingdestinations","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"title":"Consent Gating","type":"topic","url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},"doc://TracingDestinations/documentation/TracingDestinations":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","title":"TracingDestinations","url":"\/documentation\/tracingdestinations","role":"collection"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"type":"topic","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","title":"Testing What Your Code Tracks","url":"\/documentation\/traffluent\/testingwhatyoutrack","role":"article"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","role":"article","title":"Tracking Events","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"type":"topic","url":"\/documentation\/traffluent\/trackingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"type":"topic","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","title":"Tracking from SwiftUI, UIKit and AppKit","url":"\/documentation\/traffluent\/trackingfromviews","role":"article"},"doc://CollectorEncoding/documentation/CollectorEncoding":{"kind":"symbol","role":"collection","title":"CollectorEncoding","abstract":[],"type":"topic","url":"\/documentation\/collectorencoding","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"}}}