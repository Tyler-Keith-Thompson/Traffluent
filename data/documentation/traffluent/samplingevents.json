{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/samplingevents"]}],"abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"generated":true,"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"anchor":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Sampling lives in module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},{"type":"text","text":", and sampling by session uses "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"},{"type":"text","text":". Nothing is"},{"type":"text","text":" "},{"type":"text","text":"sampled until the app gives the tracker its samplers:"}],"type":"paragraph"},{"code":["import Sessions","","struct Scrolled: Event {","    var offset: Int","}","","let tracker = Tracker(","    enrichers: [.sessions()],","    samplers: [.events(of: Scrolled.self, rate: 0.1), .sessions(rate: 0.5)]",")","tracker.track(Scrolled(offset: 120))  \/\/ if kept, its record's context[SampleRateKey.self]?.value is 0.05"],"syntax":"swift","type":"codeListing"},{"text":"Samplers","anchor":"Samplers","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"code":".events(of:rate:)","type":"codeVoice"},{"text":" keeps each event of a type with the probability its ","type":"text"},{"code":"SampleRate","type":"codeVoice"},{"text":" gives.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".events(where:rate:)","type":"codeVoice"},{"type":"text","text":" does the same for each record a predicate selects. Both decide each event"},{"type":"text","text":" "},{"type":"text","text":"on its own."}]}]},{"content":[{"inlineContent":[{"code":".sessions(rate:)","type":"codeVoice"},{"text":" keeps or drops every record of a session alike, its ","type":"text"},{"code":"SessionStarted","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"SessionEnded","type":"codeVoice"},{"text":" with it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".grouped(by:rate:)","type":"codeVoice"},{"type":"text","text":" does the same for the groups that any context key’s values make."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A rate is in 0 … 1. A literal outside that range, or "},{"code":"SampleRate(_:)","type":"codeVoice"},{"type":"text","text":" given one, traps;"},{"type":"text","text":" "},{"code":"SampleRate(checked:)","type":"codeVoice"},{"type":"text","text":" throws "},{"code":"InvalidSampleRate","type":"codeVoice"},{"type":"text","text":" instead. A record is kept only if every sampler"},{"type":"text","text":" "},{"type":"text","text":"that applies to it keeps it. A kept record carries the product of their rates as its"},{"type":"text","text":" "},{"code":"SampleRateKey","type":"codeVoice"},{"type":"text","text":", so a destination can count it as "},{"code":"1 \/ value","type":"codeVoice"},{"type":"text","text":" records. A record that no sampler"},{"type":"text","text":" "},{"type":"text","text":"applies to is always kept and carries no key."}],"type":"paragraph"},{"text":"When sampling runs","anchor":"When-sampling-runs","level":3,"type":"heading"},{"inlineContent":[{"text":"The tracker’s worker samples each record after its enrichers, whose keys a sampler can read, and","type":"text"},{"text":" ","type":"text"},{"text":"before its consent and its store. So a dropped event is never held, written to disk or delivered.","type":"text"},{"text":" ","type":"text"},{"text":"Each drop is reported on ","type":"text"},{"type":"codeVoice","code":"samplingDropReports"},{"text":", merged into one report per event type while unread,","type":"text"},{"text":" ","type":"text"},{"text":"as rejections are.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The decisions come from the tracker’s "},{"type":"codeVoice","code":"samplingSeed"},{"type":"text","text":", drawn from the system’s random number"},{"type":"text","text":" "},{"type":"text","text":"generator once per tracker unless you pass one. They are the same on every platform and Swift"},{"type":"text","text":" "},{"type":"text","text":"release, so with the seed fixed, which events are kept is fixed too:"}],"type":"paragraph"},{"code":["let tracker = Tracker(samplers: [.events(of: Scrolled.self, rate: 0.1)], samplingSeed: 42)","for offset in 0 ..< 100 {","    tracker.track(Scrolled(offset: offset))","}","await tracker.finish()","for await report in tracker.samplingDropReports {","    print(report)  \/\/ Scrolled: 89 sampled out","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A session’s decision is made from the seed and the session’s identifier alone, so nothing records"},{"type":"text","text":" "},{"type":"text","text":"it. The sampler keeps only the current session’s decision, in memory, and never writes the"},{"type":"text","text":" "},{"type":"text","text":"identifier anywhere. Records that a store recovered from an earlier run were sampled in that run,"},{"type":"text","text":" "},{"type":"text","text":"and come back in the top-level context, without their rate."}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"kind":"article","metadata":{"title":"Sampling Events","modules":[{"name":"Traffluent"}],"roleHeading":"Article","role":"article"},"references":{"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"role":"article","url":"\/documentation\/traffluent\/definingevents","title":"Defining Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","type":"topic","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"role":"article","url":"\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},"doc://Trackers/documentation/Trackers":{"type":"topic","abstract":[],"role":"collection","url":"\/documentation\/trackers","title":"Trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol"},"doc://Traffluent/documentation/Traffluent":{"type":"topic","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"role":"collection","url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"type":"topic","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"role":"article","url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","title":"Consent Gating","kind":"article"},"doc://Sessions/documentation/Sessions":{"kind":"symbol","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/sessions","title":"Sessions","identifier":"doc:\/\/Sessions\/documentation\/Sessions"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"type":"topic","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"role":"article","url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","title":"Automatic Tracking","kind":"article"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"role":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","title":"Sessions and Standard Context","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"}}}