{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Sampling lives in module ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers","isActive":true},{"text":", and sampling by session uses ","type":"text"},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true},{"text":". Nothing is","type":"text"},{"text":" ","type":"text"},{"text":"sampled until the app gives the tracker its samplers:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Sessions","","struct Scrolled: Event {","    var offset: Int","}","","let tracker = Tracker(","    enrichers: [.sessions()],","    samplers: [.events(of: Scrolled.self, rate: 0.1), .sessions(rate: 0.5)]",")","tracker.track(Scrolled(offset: 120))  \/\/ if kept, its record's context[SampleRateKey.self]?.value is 0.05"]},{"level":3,"text":"Samplers","type":"heading","anchor":"Samplers"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".events(of:rate:)","type":"codeVoice"},{"text":" keeps each event of a type with the probability its ","type":"text"},{"code":"SampleRate","type":"codeVoice"},{"text":" gives.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":".events(where:rate:)","type":"codeVoice"},{"text":" does the same for each record a predicate selects. Both decide each event","type":"text"},{"text":" ","type":"text"},{"text":"on its own.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sessions(rate:)"},{"type":"text","text":" keeps or drops every record of a session alike, its "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"SessionEnded"},{"type":"text","text":" with it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".grouped(by:rate:)"},{"type":"text","text":" does the same for the groups that any context key’s values make."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A rate is in 0 … 1. A literal outside that range, or "},{"type":"codeVoice","code":"SampleRate(_:)"},{"type":"text","text":" given one, traps;"},{"type":"text","text":" "},{"type":"codeVoice","code":"SampleRate(checked:)"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"InvalidSampleRate"},{"type":"text","text":" instead. A record is kept only if every sampler"},{"type":"text","text":" "},{"type":"text","text":"that applies to it keeps it. A kept record carries the product of their rates as its"},{"type":"text","text":" "},{"type":"codeVoice","code":"SampleRateKey"},{"type":"text","text":", so a destination can count it as "},{"type":"codeVoice","code":"1 \/ value"},{"type":"text","text":" records. A record that no sampler"},{"type":"text","text":" "},{"type":"text","text":"applies to is always kept and carries no key."}]},{"level":3,"text":"When sampling runs","type":"heading","anchor":"When-sampling-runs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s worker samples each record after its enrichers, whose keys a sampler can read, and"},{"type":"text","text":" "},{"type":"text","text":"before its consent and its store. So a dropped event is never held, written to disk or delivered."},{"type":"text","text":" "},{"type":"text","text":"Each drop is reported on "},{"type":"codeVoice","code":"samplingDropReports"},{"type":"text","text":", merged into one report per event type while unread,"},{"type":"text","text":" "},{"type":"text","text":"as rejections are."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The decisions come from the tracker’s "},{"type":"codeVoice","code":"samplingSeed"},{"type":"text","text":", drawn from the system’s random number"},{"type":"text","text":" "},{"type":"text","text":"generator once per tracker unless you pass one. They are the same on every platform and Swift"},{"type":"text","text":" "},{"type":"text","text":"release, so with the seed fixed, which events are kept is fixed too:"}]},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker(samplers: [.events(of: Scrolled.self, rate: 0.1)], samplingSeed: 42)","for offset in 0 ..< 100 {","    tracker.track(Scrolled(offset: offset))","}","await tracker.finish()","for await report in tracker.samplingDropReports {","    print(report)  \/\/ Scrolled: 89 sampled out","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A session’s decision is made from the seed and the session’s identifier alone, so nothing records"},{"type":"text","text":" "},{"type":"text","text":"it. The sampler keeps only the current session’s decision, in memory, and never writes the"},{"type":"text","text":" "},{"type":"text","text":"identifier anywhere. Records that a store recovered from an earlier run were sampled in that run,"},{"type":"text","text":" "},{"type":"text","text":"and come back in the top-level context, without their rate."}]}],"kind":"content"}],"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Article","title":"Sampling Events","role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"seeAlsoSections":[{"title":"Guides","generated":true,"anchor":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/traffluent\/samplingevents"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"references":{"doc://Sessions/documentation/Sessions":{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"topic","abstract":[],"title":"Sessions","kind":"symbol","url":"\/documentation\/sessions","role":"collection"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent","role":"collection"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"title":"Automatic Tracking","kind":"article","url":"\/documentation\/traffluent\/automatictracking","role":"article"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","title":"Persisting Records","kind":"article","url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"role":"article"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"title":"Defining Events","kind":"article","url":"\/documentation\/traffluent\/definingevents","role":"article"},"doc://Trackers/documentation/Trackers":{"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers","type":"topic","url":"\/documentation\/trackers","abstract":[],"role":"collection"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"topic","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"title":"Consent Gating","kind":"article","url":"\/documentation\/traffluent\/consentgating","role":"article"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","title":"Exporting and Checking a Tracking Plan","abstract":[{"text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it.","type":"text"}],"url":"\/documentation\/traffluent\/trackingplanworkflow","role":"article"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","type":"topic","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"title":"Sessions and Standard Context","kind":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","role":"article"}}}