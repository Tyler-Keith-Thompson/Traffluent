{"abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/samplingevents"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sampling lives in module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},{"type":"text","text":", and sampling by session uses "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"},{"type":"text","text":". Nothing is"},{"type":"text","text":" "},{"type":"text","text":"sampled until the app gives the tracker its samplers:"}]},{"syntax":"swift","type":"codeListing","code":["import Sessions","","struct Scrolled: Event {","    var offset: Int","}","","let tracker = Tracker(","    enrichers: [.sessions()],","    samplers: [.events(of: Scrolled.self, rate: 0.1), .sessions(rate: 0.5)]",")","tracker.track(Scrolled(offset: 120))  \/\/ if kept, its record's context[SampleRateKey.self]?.value is 0.05"]},{"type":"heading","level":3,"text":"Samplers","anchor":"Samplers"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".events(of:rate:)"},{"text":" keeps each event of a type with the probability its ","type":"text"},{"type":"codeVoice","code":"SampleRate"},{"text":" gives.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".events(where:rate:)","type":"codeVoice"},{"type":"text","text":" does the same for each record a predicate selects. Both decide each event"},{"type":"text","text":" "},{"type":"text","text":"on its own."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".sessions(rate:)"},{"text":" keeps or drops every record of a session alike, its ","type":"text"},{"type":"codeVoice","code":"SessionStarted"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SessionEnded"},{"text":" with it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".grouped(by:rate:)"},{"text":" does the same for the groups that any context key’s values make.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A rate is in 0 … 1. A literal outside that range, or ","type":"text"},{"code":"SampleRate(_:)","type":"codeVoice"},{"text":" given one, traps;","type":"text"},{"text":" ","type":"text"},{"code":"SampleRate(checked:)","type":"codeVoice"},{"text":" throws ","type":"text"},{"code":"InvalidSampleRate","type":"codeVoice"},{"text":" instead. A record is kept only if every sampler","type":"text"},{"text":" ","type":"text"},{"text":"that applies to it keeps it. A kept record carries the product of their rates as its","type":"text"},{"text":" ","type":"text"},{"code":"SampleRateKey","type":"codeVoice"},{"text":", so a destination can count it as ","type":"text"},{"code":"1 \/ value","type":"codeVoice"},{"text":" records. A record that no sampler","type":"text"},{"text":" ","type":"text"},{"text":"applies to is always kept and carries no key.","type":"text"}]},{"type":"heading","level":3,"text":"When sampling runs","anchor":"When-sampling-runs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s worker samples each record after its enrichers, whose keys a sampler can read, and"},{"type":"text","text":" "},{"type":"text","text":"before its consent and its store. So a dropped event is never held, written to disk or delivered."},{"type":"text","text":" "},{"type":"text","text":"Each drop is reported on "},{"type":"codeVoice","code":"samplingDropReports"},{"type":"text","text":", merged into one report per event type while unread,"},{"type":"text","text":" "},{"type":"text","text":"as rejections are."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The decisions come from the tracker’s "},{"type":"codeVoice","code":"samplingSeed"},{"type":"text","text":", drawn from the system’s random number"},{"type":"text","text":" "},{"type":"text","text":"generator once per tracker unless you pass one. They are the same on every platform and Swift"},{"type":"text","text":" "},{"type":"text","text":"release, so with the seed fixed, which events are kept is fixed too:"}]},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker(samplers: [.events(of: Scrolled.self, rate: 0.1)], samplingSeed: 42)","for offset in 0 ..< 100 {","    tracker.track(Scrolled(offset: offset))","}","await tracker.finish()","for await report in tracker.samplingDropReports {","    print(report)  \/\/ Scrolled: 89 sampled out","}"]},{"type":"paragraph","inlineContent":[{"text":"A session’s decision is made from the seed and the session’s identifier alone, so nothing records","type":"text"},{"text":" ","type":"text"},{"text":"it. The sampler keeps only the current session’s decision, in memory, and never writes the","type":"text"},{"text":" ","type":"text"},{"text":"identifier anywhere. Records that a store recovered from an earlier run were sampled in that run,","type":"text"},{"text":" ","type":"text"},{"text":"and come back in the top-level context, without their rate.","type":"text"}]}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"kind":"article","metadata":{"roleHeading":"Article","modules":[{"name":"Traffluent"}],"role":"article","title":"Sampling Events"},"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"generated":true,"title":"Guides","anchor":"Guides"}],"references":{"doc://Traffluent/documentation/Traffluent/ConsentGating":{"url":"\/documentation\/traffluent\/consentgating","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"topic","title":"Consent Gating","kind":"article","role":"article"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it.","type":"text"}],"title":"Exporting and Checking a Tracking Plan","kind":"article"},"doc://Trackers/documentation/Trackers":{"abstract":[],"url":"\/documentation\/trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"topic","title":"Trackers","kind":"symbol","role":"collection"},"doc://Sessions/documentation/Sessions":{"url":"\/documentation\/sessions","abstract":[],"identifier":"doc:\/\/Sessions\/documentation\/Sessions","kind":"symbol","type":"topic","title":"Sessions","role":"collection"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"url":"\/documentation\/traffluent\/definingevents","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","kind":"article","type":"topic","title":"Defining Events","role":"article"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","kind":"article","title":"Automatic Tracking","role":"article"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"role":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","type":"topic","title":"Sessions and Standard Context","kind":"article"},"doc://Traffluent/documentation/Traffluent":{"abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","type":"topic","title":"Traffluent","kind":"symbol","role":"collection"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","kind":"article","title":"Persisting Records","type":"topic","role":"article"}}}