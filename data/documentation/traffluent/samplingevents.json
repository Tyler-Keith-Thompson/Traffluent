{"sections":[],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/traffluent\/samplingevents"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","title":"Sampling Events","role":"article","modules":[{"name":"Traffluent"}]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Sampling lives in module "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers","isActive":true},{"type":"text","text":", and sampling by session uses "},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true},{"type":"text","text":". Nothing is"},{"type":"text","text":" "},{"type":"text","text":"sampled until the app gives the tracker its samplers:"}],"type":"paragraph"},{"syntax":"swift","code":["import Sessions","","struct Scrolled: Event {","    var offset: Int","}","","let tracker = Tracker(","    enrichers: [.sessions()],","    samplers: [.events(of: Scrolled.self, rate: 0.1), .sessions(rate: 0.5)]",")","tracker.track(Scrolled(offset: 120))  \/\/ if kept, its record's context[SampleRateKey.self]?.value is 0.05"],"type":"codeListing"},{"text":"Samplers","anchor":"Samplers","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".events(of:rate:)","type":"codeVoice"},{"type":"text","text":" keeps each event of a type with the probability its "},{"code":"SampleRate","type":"codeVoice"},{"type":"text","text":" gives."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".events(where:rate:)","type":"codeVoice"},{"text":" does the same for each record a predicate selects. Both decide each event","type":"text"},{"text":" ","type":"text"},{"text":"on its own.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".sessions(rate:)","type":"codeVoice"},{"text":" keeps or drops every record of a session alike, its ","type":"text"},{"code":"SessionStarted","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"SessionEnded","type":"codeVoice"},{"text":" with it.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".grouped(by:rate:)"},{"type":"text","text":" does the same for the groups that any context key’s values make."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A rate is in 0 … 1. A literal outside that range, or ","type":"text"},{"code":"SampleRate(_:)","type":"codeVoice"},{"text":" given one, traps;","type":"text"},{"text":" ","type":"text"},{"code":"SampleRate(checked:)","type":"codeVoice"},{"text":" throws ","type":"text"},{"code":"InvalidSampleRate","type":"codeVoice"},{"text":" instead. A record is kept only if every sampler","type":"text"},{"text":" ","type":"text"},{"text":"that applies to it keeps it. A kept record carries the product of their rates as its","type":"text"},{"text":" ","type":"text"},{"code":"SampleRateKey","type":"codeVoice"},{"text":", so a destination can count it as ","type":"text"},{"code":"1 \/ value","type":"codeVoice"},{"text":" records. A record that no sampler","type":"text"},{"text":" ","type":"text"},{"text":"applies to is always kept and carries no key.","type":"text"}],"type":"paragraph"},{"text":"When sampling runs","anchor":"When-sampling-runs","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The tracker’s worker samples each record after its enrichers, whose keys a sampler can read, and"},{"type":"text","text":" "},{"type":"text","text":"before its consent and its store. So a dropped event is never held, written to disk or delivered."},{"type":"text","text":" "},{"type":"text","text":"Each drop is reported on "},{"code":"samplingDropReports","type":"codeVoice"},{"type":"text","text":", merged into one report per event type while unread,"},{"type":"text","text":" "},{"type":"text","text":"as rejections are."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The decisions come from the tracker’s "},{"type":"codeVoice","code":"samplingSeed"},{"type":"text","text":", drawn from the system’s random number"},{"type":"text","text":" "},{"type":"text","text":"generator once per tracker unless you pass one. They are the same on every platform and Swift"},{"type":"text","text":" "},{"type":"text","text":"release, so with the seed fixed, which events are kept is fixed too:"}],"type":"paragraph"},{"syntax":"swift","code":["let tracker = Tracker(samplers: [.events(of: Scrolled.self, rate: 0.1)], samplingSeed: 42)","for offset in 0 ..< 100 {","    tracker.track(Scrolled(offset: offset))","}","await tracker.finish()","for await report in tracker.samplingDropReports {","    print(report)  \/\/ Scrolled: 89 sampled out","}"],"type":"codeListing"},{"inlineContent":[{"text":"A session’s decision is made from the seed and the session’s identifier alone, so nothing records","type":"text"},{"text":" ","type":"text"},{"text":"it. The sampler keeps only the current session’s decision, in memory, and never writes the","type":"text"},{"text":" ","type":"text"},{"text":"identifier anywhere. Records that a store recovered from an earlier run were sampled in that run,","type":"text"},{"text":" ","type":"text"},{"text":"and come back in the top-level context, without their rate.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"generated":true,"title":"Guides"}],"kind":"article","references":{"doc://Traffluent/documentation/Traffluent/ConsentGating":{"kind":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"url":"\/documentation\/traffluent\/consentgating","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"topic","title":"Consent Gating"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"type":"topic","url":"\/documentation\/traffluent\/trackingplanworkflow","kind":"article"},"doc://Sessions/documentation/Sessions":{"kind":"symbol","abstract":[],"url":"\/documentation\/sessions","role":"collection","identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"topic","title":"Sessions"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent","role":"collection","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","type":"topic","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"url":"\/documentation\/traffluent\/persistingrecords","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","title":"Persisting Records"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"title":"Automatic Tracking","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"type":"topic","url":"\/documentation\/traffluent\/automatictracking","kind":"article"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"title":"Defining Events","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"type":"topic","url":"\/documentation\/traffluent\/definingevents","kind":"article"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"title":"Sessions and Standard Context","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"type":"topic","url":"\/documentation\/traffluent\/sessionsandstandardcontext","kind":"article"},"doc://Trackers/documentation/Trackers":{"kind":"symbol","abstract":[],"url":"\/documentation\/trackers","role":"collection","identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"topic","title":"Trackers"}}}