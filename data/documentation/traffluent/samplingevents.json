{"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"Traffluent"}],"title":"Sampling Events","role":"article"},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"generated":true,"title":"Guides","anchor":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Sampling lives in module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},{"type":"text","text":", and sampling by session uses "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"},{"type":"text","text":". Nothing is"},{"type":"text","text":" "},{"type":"text","text":"sampled until the app gives the tracker its samplers:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Sessions","","struct Scrolled: Event {","    var offset: Int","}","","let tracker = Tracker(","    enrichers: [.sessions()],","    samplers: [.events(of: Scrolled.self, rate: 0.1), .sessions(rate: 0.5)]",")","tracker.track(Scrolled(offset: 120))  \/\/ if kept, its record's context[SampleRateKey.self]?.value is 0.05"]},{"type":"heading","text":"Samplers","anchor":"Samplers","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".events(of:rate:)"},{"type":"text","text":" keeps each event of a type with the probability its "},{"type":"codeVoice","code":"SampleRate"},{"type":"text","text":" gives."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".events(where:rate:)"},{"type":"text","text":" does the same for each record a predicate selects. Both decide each event"},{"type":"text","text":" "},{"type":"text","text":"on its own."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".sessions(rate:)","type":"codeVoice"},{"text":" keeps or drops every record of a session alike, its ","type":"text"},{"code":"SessionStarted","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"SessionEnded","type":"codeVoice"},{"text":" with it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".grouped(by:rate:)"},{"text":" does the same for the groups that any context key’s values make.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"A rate is in 0 … 1. A literal outside that range, or "},{"type":"codeVoice","code":"SampleRate(_:)"},{"type":"text","text":" given one, traps;"},{"type":"text","text":" "},{"type":"codeVoice","code":"SampleRate(checked:)"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"InvalidSampleRate"},{"type":"text","text":" instead. A record is kept only if every sampler"},{"type":"text","text":" "},{"type":"text","text":"that applies to it keeps it. A kept record carries the product of their rates as its"},{"type":"text","text":" "},{"type":"codeVoice","code":"SampleRateKey"},{"type":"text","text":", so a destination can count it as "},{"type":"codeVoice","code":"1 \/ value"},{"type":"text","text":" records. A record that no sampler"},{"type":"text","text":" "},{"type":"text","text":"applies to is always kept and carries no key."}],"type":"paragraph"},{"type":"heading","text":"When sampling runs","anchor":"When-sampling-runs","level":3},{"inlineContent":[{"type":"text","text":"The tracker’s worker samples each record after its enrichers, whose keys a sampler can read, and"},{"type":"text","text":" "},{"type":"text","text":"before its consent and its store. So a dropped event is never held, written to disk or delivered."},{"type":"text","text":" "},{"type":"text","text":"Each drop is reported on "},{"code":"samplingDropReports","type":"codeVoice"},{"type":"text","text":", merged into one report per event type while unread,"},{"type":"text","text":" "},{"type":"text","text":"as rejections are."}],"type":"paragraph"},{"inlineContent":[{"text":"The decisions come from the tracker’s ","type":"text"},{"code":"samplingSeed","type":"codeVoice"},{"text":", drawn from the system’s random number","type":"text"},{"text":" ","type":"text"},{"text":"generator once per tracker unless you pass one. They are the same on every platform and Swift","type":"text"},{"text":" ","type":"text"},{"text":"release, so with the seed fixed, which events are kept is fixed too:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker(samplers: [.events(of: Scrolled.self, rate: 0.1)], samplingSeed: 42)","for offset in 0 ..< 100 {","    tracker.track(Scrolled(offset: offset))","}","await tracker.finish()","for await report in tracker.samplingDropReports {","    print(report)  \/\/ Scrolled: 89 sampled out","}"]},{"inlineContent":[{"type":"text","text":"A session’s decision is made from the seed and the session’s identifier alone, so nothing records"},{"type":"text","text":" "},{"type":"text","text":"it. The sampler keeps only the current session’s decision, in memory, and never writes the"},{"type":"text","text":" "},{"type":"text","text":"identifier anywhere. Records that a store recovered from an earlier run were sampled in that run,"},{"type":"text","text":" "},{"type":"text","text":"and come back in the top-level context, without their rate."}],"type":"paragraph"}]}],"kind":"article","variants":[{"paths":["\/documentation\/traffluent\/samplingevents"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"references":{"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"kind":"article","url":"\/documentation\/traffluent\/definingevents","type":"topic","role":"article","title":"Defining Events"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","role":"collection","url":"\/documentation\/traffluent","kind":"symbol","title":"Traffluent","type":"topic","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}]},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","kind":"article","title":"Exporting and Checking a Tracking Plan","type":"topic","abstract":[{"text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it.","type":"text"}]},"doc://Trackers/documentation/Trackers":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","role":"collection","url":"\/documentation\/trackers","kind":"symbol","title":"Trackers","type":"topic","abstract":[]},"doc://Sessions/documentation/Sessions":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/Sessions\/documentation\/Sessions","url":"\/documentation\/sessions","type":"topic","role":"collection","title":"Sessions"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"kind":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","url":"\/documentation\/traffluent\/automatictracking","type":"topic","role":"article","title":"Automatic Tracking"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","role":"article","url":"\/documentation\/traffluent\/consentgating","kind":"article","title":"Consent Gating","type":"topic","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","url":"\/documentation\/traffluent\/persistingrecords","type":"topic","role":"article","title":"Persisting Records"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","role":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","kind":"article","title":"Sessions and Standard Context","type":"topic","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}]}}}