{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"article","title":"Sampling Events","roleHeading":"Article","modules":[{"name":"Traffluent"}]},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Sampling lives in module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},{"text":", and sampling by session uses ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"},{"text":". Nothing is","type":"text"},{"text":" ","type":"text"},{"text":"sampled until the app gives the tracker its samplers:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import Sessions","","struct Scrolled: Event {","    var offset: Int","}","","let tracker = Tracker(","    enrichers: [.sessions()],","    samplers: [.events(of: Scrolled.self, rate: 0.1), .sessions(rate: 0.5)]",")","tracker.track(Scrolled(offset: 120))  \/\/ if kept, its record's context[SampleRateKey.self]?.value is 0.05"],"syntax":"swift"},{"anchor":"Samplers","text":"Samplers","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".events(of:rate:)"},{"type":"text","text":" keeps each event of a type with the probability its "},{"type":"codeVoice","code":"SampleRate"},{"type":"text","text":" gives."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".events(where:rate:)","type":"codeVoice"},{"type":"text","text":" does the same for each record a predicate selects. Both decide each event"},{"type":"text","text":" "},{"type":"text","text":"on its own."}]}]},{"content":[{"inlineContent":[{"code":".sessions(rate:)","type":"codeVoice"},{"type":"text","text":" keeps or drops every record of a session alike, its "},{"code":"SessionStarted","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"SessionEnded","type":"codeVoice"},{"type":"text","text":" with it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".grouped(by:rate:)"},{"type":"text","text":" does the same for the groups that any context key’s values make."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A rate is in 0 … 1. A literal outside that range, or ","type":"text"},{"code":"SampleRate(_:)","type":"codeVoice"},{"text":" given one, traps;","type":"text"},{"text":" ","type":"text"},{"code":"SampleRate(checked:)","type":"codeVoice"},{"text":" throws ","type":"text"},{"code":"InvalidSampleRate","type":"codeVoice"},{"text":" instead. A record is kept only if every sampler","type":"text"},{"text":" ","type":"text"},{"text":"that applies to it keeps it. A kept record carries the product of their rates as its","type":"text"},{"text":" ","type":"text"},{"code":"SampleRateKey","type":"codeVoice"},{"text":", so a destination can count it as ","type":"text"},{"code":"1 \/ value","type":"codeVoice"},{"text":" records. A record that no sampler","type":"text"},{"text":" ","type":"text"},{"text":"applies to is always kept and carries no key.","type":"text"}],"type":"paragraph"},{"anchor":"When-sampling-runs","text":"When sampling runs","type":"heading","level":3},{"inlineContent":[{"text":"The tracker’s worker samples each record after its enrichers, whose keys a sampler can read, and","type":"text"},{"text":" ","type":"text"},{"text":"before its consent and its store. So a dropped event is never held, written to disk or delivered.","type":"text"},{"text":" ","type":"text"},{"text":"Each drop is reported on ","type":"text"},{"code":"samplingDropReports","type":"codeVoice"},{"text":", merged into one report per event type while unread,","type":"text"},{"text":" ","type":"text"},{"text":"as rejections are.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The decisions come from the tracker’s "},{"type":"codeVoice","code":"samplingSeed"},{"type":"text","text":", drawn from the system’s random number"},{"type":"text","text":" "},{"type":"text","text":"generator once per tracker unless you pass one. They are the same on every platform and Swift"},{"type":"text","text":" "},{"type":"text","text":"release, so with the seed fixed, which events are kept is fixed too:"}],"type":"paragraph"},{"type":"codeListing","code":["let tracker = Tracker(samplers: [.events(of: Scrolled.self, rate: 0.1)], samplingSeed: 42)","for offset in 0 ..< 100 {","    tracker.track(Scrolled(offset: offset))","}","await tracker.finish()","for await report in tracker.samplingDropReports {","    print(report)  \/\/ Scrolled: 89 sampled out","}"],"syntax":"swift"},{"inlineContent":[{"text":"A session’s decision is made from the seed and the session’s identifier alone, so nothing records","type":"text"},{"text":" ","type":"text"},{"text":"it. The sampler keeps only the current session’s decision, in memory, and never writes the","type":"text"},{"text":" ","type":"text"},{"text":"identifier anywhere. Records that a store recovered from an earlier run were sampled in that run,","type":"text"},{"text":" ","type":"text"},{"text":"and come back in the top-level context, without their rate.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"article","identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/traffluent\/samplingevents"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"anchor":"Guides","generated":true}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"references":{"doc://Sessions/documentation/Sessions":{"abstract":[],"identifier":"doc:\/\/Sessions\/documentation\/Sessions","kind":"symbol","role":"collection","url":"\/documentation\/sessions","title":"Sessions","type":"topic"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","role":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"url":"\/documentation\/traffluent\/automatictracking","title":"Automatic Tracking"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","role":"article","title":"Persisting Records","url":"\/documentation\/traffluent\/persistingrecords","type":"topic"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"kind":"article","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":", and constrain which values its properties may hold.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","role":"article","title":"Defining Events","url":"\/documentation\/traffluent\/definingevents","type":"topic"},"doc://Traffluent/documentation/Traffluent":{"abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","kind":"symbol","role":"collection","url":"\/documentation\/traffluent","title":"Traffluent","type":"topic"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"kind":"article","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","role":"article","title":"Sessions and Standard Context","url":"\/documentation\/traffluent\/sessionsandstandardcontext","type":"topic"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"kind":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","role":"article","title":"Consent Gating","url":"\/documentation\/traffluent\/consentgating","type":"topic"},"doc://Trackers/documentation/Trackers":{"abstract":[],"identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol","role":"collection","url":"\/documentation\/trackers","title":"Trackers","type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","role":"article","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"url":"\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan"}}}