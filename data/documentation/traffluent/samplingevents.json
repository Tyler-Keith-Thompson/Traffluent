{"metadata":{"role":"article","modules":[{"name":"Traffluent"}],"roleHeading":"Article","title":"Sampling Events"},"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"generated":true}],"sections":[],"abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/samplingevents"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Sampling lives in module ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},{"text":", and sampling by session uses ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"},{"text":". Nothing is","type":"text"},{"text":" ","type":"text"},{"text":"sampled until the app gives the tracker its samplers:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Sessions","","struct Scrolled: Event {","    var offset: Int","}","","let tracker = Tracker(","    enrichers: [.sessions()],","    samplers: [.events(of: Scrolled.self, rate: 0.1), .sessions(rate: 0.5)]",")","tracker.track(Scrolled(offset: 120))  \/\/ if kept, its record's context[SampleRateKey.self]?.value is 0.05"]},{"type":"heading","level":3,"anchor":"Samplers","text":"Samplers"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".events(of:rate:)","type":"codeVoice"},{"type":"text","text":" keeps each event of a type with the probability its "},{"code":"SampleRate","type":"codeVoice"},{"type":"text","text":" gives."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".events(where:rate:)"},{"type":"text","text":" does the same for each record a predicate selects. Both decide each event"},{"type":"text","text":" "},{"type":"text","text":"on its own."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sessions(rate:)"},{"type":"text","text":" keeps or drops every record of a session alike, its "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"SessionEnded"},{"type":"text","text":" with it."}]}]},{"content":[{"inlineContent":[{"code":".grouped(by:rate:)","type":"codeVoice"},{"text":" does the same for the groups that any context key’s values make.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A rate is in 0 … 1. A literal outside that range, or ","type":"text"},{"type":"codeVoice","code":"SampleRate(_:)"},{"text":" given one, traps;","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SampleRate(checked:)"},{"text":" throws ","type":"text"},{"type":"codeVoice","code":"InvalidSampleRate"},{"text":" instead. A record is kept only if every sampler","type":"text"},{"text":" ","type":"text"},{"text":"that applies to it keeps it. A kept record carries the product of their rates as its","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SampleRateKey"},{"text":", so a destination can count it as ","type":"text"},{"type":"codeVoice","code":"1 \/ value"},{"text":" records. A record that no sampler","type":"text"},{"text":" ","type":"text"},{"text":"applies to is always kept and carries no key.","type":"text"}]},{"type":"heading","level":3,"anchor":"When-sampling-runs","text":"When sampling runs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s worker samples each record after its enrichers, whose keys a sampler can read, and"},{"type":"text","text":" "},{"type":"text","text":"before its consent and its store. So a dropped event is never held, written to disk or delivered."},{"type":"text","text":" "},{"type":"text","text":"Each drop is reported on "},{"type":"codeVoice","code":"samplingDropReports"},{"type":"text","text":", merged into one report per event type while unread,"},{"type":"text","text":" "},{"type":"text","text":"as rejections are."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The decisions come from the tracker’s "},{"type":"codeVoice","code":"samplingSeed"},{"type":"text","text":", drawn from the system’s random number"},{"type":"text","text":" "},{"type":"text","text":"generator once per tracker unless you pass one. They are the same on every platform and Swift"},{"type":"text","text":" "},{"type":"text","text":"release, so with the seed fixed, which events are kept is fixed too:"}]},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker(samplers: [.events(of: Scrolled.self, rate: 0.1)], samplingSeed: 42)","for offset in 0 ..< 100 {","    tracker.track(Scrolled(offset: offset))","}","await tracker.finish()","for await report in tracker.samplingDropReports {","    print(report)  \/\/ Scrolled: 89 sampled out","}"]},{"type":"paragraph","inlineContent":[{"text":"A session’s decision is made from the seed and the session’s identifier alone, so nothing records","type":"text"},{"text":" ","type":"text"},{"text":"it. The sampler keeps only the current session’s decision, in memory, and never writes the","type":"text"},{"text":" ","type":"text"},{"text":"identifier anywhere. Records that a store recovered from an earlier run were sampled in that run,","type":"text"},{"text":" ","type":"text"},{"text":"and come back in the top-level context, without their rate.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"references":{"doc://Sessions/documentation/Sessions":{"type":"topic","title":"Sessions","role":"collection","identifier":"doc:\/\/Sessions\/documentation\/Sessions","url":"\/documentation\/sessions","abstract":[],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"type":"topic","title":"Exporting and Checking a Tracking Plan","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","abstract":[{"type":"text","text":"Export the JSON Schema of every event an app tracks, commit it, and fail the build when the events stop matching it."}],"kind":"article","url":"\/documentation\/traffluent\/trackingplanworkflow"},"doc://Traffluent/documentation/Traffluent":{"role":"collection","type":"topic","url":"\/documentation\/traffluent","abstract":[{"type":"text","text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations."}],"title":"Traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"role":"article","type":"topic","url":"\/documentation\/traffluent\/definingevents","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"title":"Defining Events","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"type":"topic","title":"Automatic Tracking","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"kind":"article","url":"\/documentation\/traffluent\/automatictracking"},"doc://Trackers/documentation/Trackers":{"role":"collection","type":"topic","url":"\/documentation\/trackers","abstract":[],"title":"Trackers","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"role":"article","type":"topic","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"url":"\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"type":"topic","title":"Consent Gating","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","url":"\/documentation\/traffluent\/consentgating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"kind":"article"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"type":"topic","title":"Sessions and Standard Context","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","url":"\/documentation\/traffluent\/sessionsandstandardcontext","kind":"article","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}]}}}