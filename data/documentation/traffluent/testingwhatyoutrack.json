e":"tracker(_:)","type":"codeVoice"},{"text":", takes the one the body is given: ","type":"text"},{"code":"withRecordingTracker { tracker in … }","type":"codeVoice"},{"text":".","type":"text"}]}]}],"metadata":{"role":"article","modules":[{"name":"Traffluent"}],"title":"Testing What Your Code Tracks","roleHeading":"Article"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"variants":[{"paths":["\/documentation\/traffluent\/testingwhatyoutrack"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"references":{"doc://TrackerTesting/documentation/TrackerTesting":{"url":"\/documentation\/trackertesting","type":"topic","role":"collection","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","kind":"symbol","title":"TrackerTesting","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}]},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"url":"\/documentation\/traffluent\/trackingfromviews","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","kind":"article","title":"Tracking from SwiftUI, UIKit and AppKit","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}]},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","url":