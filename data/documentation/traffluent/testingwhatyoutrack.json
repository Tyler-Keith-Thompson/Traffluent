{"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"isActive":true,"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","type":"reference"},{"type":"text","text":" product to the test target. "},{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" binds a fresh"},{"type":"text","text":" "},{"type":"text","text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in"},{"type":"text","text":" "},{"type":"text","text":"order. Here "},{"type":"codeVoice","code":"SignedUp"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"]},{"type":"paragraph","inlineContent":[{"text":"Each call has a tracker of its own, so tests running at the same time never see each other’s","type":"text"},{"text":" ","type":"text"},{"text":"events. The body may be sync or async, and may return a value, read as ","type":"text"},{"code":"tracked.value","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"tracked.names","type":"codeVoice"},{"text":" lists every event’s name and ","type":"text"},{"code":"tracked.records","type":"codeVoice"},{"text":" every record.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most code needs nothing more: it tracks through "},{"code":"Tracker.current","type":"codeVoice"},{"type":"text","text":", which falls back to the tracker"},{"type":"text","text":" "},{"type":"text","text":"the app bootstrapped, and the test’s binding wins over that one. A view whose tracker was never set"},{"type":"text","text":" "},{"type":"text","text":"that binds its tracker with "},{"code":"withTracker","type":"codeVoice"},{"type":"text","text":" reaches the test’s tracker too. Pass a tracker instead where the"},{"type":"text","text":" "},{"type":"text","text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with "},{"code":"tracker(_:)","type":"codeVoice"},{"type":"text","text":", such as a preview’s,"},{"type":"text","text":" "},{"type":"text","text":"reaches the view’s environment but not code that reads "},{"code":"Tracker.current","type":"codeVoice"},{"type":"text","text":". Such a test takes the"},{"type":"text","text":" "},{"type":"text","text":"tracker the body is given and sets it on the view: "},{"code":"withRecordingTracker { tracker in … }","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"title":"Essentials","anchor":"Essentials","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/testingwhatyoutrack"]}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"sections":[],"kind":"article","metadata":{"role":"article","title":"Testing What Your Code Tracks","modules":[{"name":"Traffluent"}],"roleHeading":"Article"},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","interfaceLanguage":"swift"},"abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"title":"Tracking from SwiftUI, UIKit and AppKit","kind":"article","role":"article","url":"\/documentation\/traffluent\/trackingfromviews","type":"topic","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent\/trackingevents","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","title":"Tracking Events"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"title":"Getting Started","kind":"article","role":"article","url":"\/documentation\/traffluent\/gettingstarted","type":"topic","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted"},"doc://TrackerTesting/documentation/TrackerTesting":{"title":"TrackerTesting","kind":"symbol","role":"collection","url":"\/documentation\/trackertesting","type":"topic","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","kind":"article","role":"article","url":"\/documentation\/traffluent\/choosingdestinations","type":"topic","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","kind":"symbol","role":"collection","url":"\/documentation\/traffluent","type":"topic","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"}}}