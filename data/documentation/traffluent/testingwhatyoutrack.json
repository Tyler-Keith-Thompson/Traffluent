{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/traffluent\/testingwhatyoutrack"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"seeAlsoSections":[{"generated":true,"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","isActive":true,"type":"reference"},{"text":" product to the test target. ","type":"text"},{"code":"withRecordingTracker","type":"codeVoice"},{"text":" binds a fresh","type":"text"},{"text":" ","type":"text"},{"text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in","type":"text"},{"text":" ","type":"text"},{"text":"order. Here ","type":"text"},{"code":"SignedUp","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each call has a tracker of its own, so tests running at the same time never see each other’s","type":"text"},{"text":" ","type":"text"},{"text":"events. The body may be sync or async, and may return a value, read as ","type":"text"},{"type":"codeVoice","code":"tracked.value"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"tracked.names"},{"text":" lists every event’s name and ","type":"text"},{"type":"codeVoice","code":"tracked.records"},{"text":" every record.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most code needs nothing more: it tracks through "},{"code":"Tracker.current","type":"codeVoice"},{"type":"text","text":", which falls back to the tracker"},{"type":"text","text":" "},{"type":"text","text":"the app bootstrapped, and the test’s binding wins over that one. Pass a tracker instead where the"},{"type":"text","text":" "},{"type":"text","text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with "},{"code":"tracker(_:)","type":"codeVoice"},{"type":"text","text":", such as a preview’s,"},{"type":"text","text":" "},{"type":"text","text":"reaches the view’s environment but not code that reads "},{"code":"Tracker.current","type":"codeVoice"},{"type":"text","text":". Such a test takes the"},{"type":"text","text":" "},{"type":"text","text":"tracker the body is given and sets it on the view: "},{"code":"withRecordingTracker { tracker in … }","type":"codeVoice"},{"type":"text","text":"."}]}]}],"metadata":{"role":"article","roleHeading":"Article","title":"Testing What Your Code Tracks","modules":[{"name":"Traffluent"}]},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"kind":"article","references":{"doc://TrackerTesting/documentation/TrackerTesting":{"type":"topic","url":"\/documentation\/trackertesting","role":"collection","kind":"symbol","title":"TrackerTesting","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"title":"Tracking from SwiftUI, UIKit and AppKit","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","kind":"article","type":"topic","role":"article","url":"\/documentation\/traffluent\/trackingfromviews"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"type":"topic","url":"\/documentation\/traffluent\/choosingdestinations","role":"article","title":"Choosing Destinations","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"type":"topic","url":"\/documentation\/traffluent\/trackingevents","role":"article","title":"Tracking Events","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}]},"doc://Traffluent/documentation/Traffluent":{"url":"\/documentation\/traffluent","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","role":"collection","type":"topic","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"type":"topic","url":"\/documentation\/traffluent\/gettingstarted","role":"article","title":"Getting Started","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}]}}}