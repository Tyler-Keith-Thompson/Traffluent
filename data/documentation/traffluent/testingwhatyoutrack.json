pe":"text"},{"text":"one with ","type":"text"},{"type":"codeVoice","code":"tracker(_:)"},{"text":", takes the one the body is given: ","type":"text"},{"type":"codeVoice","code":"withRecordingTracker { tracker in … }"},{"text":".","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"kind":"article","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"metadata":{"roleHeading":"Article","role":"article","title":"Testing What Your Code Tracks","modules":[{"name":"Traffluent"}]},"variants":[{"paths":["\/documentation\/traffluent\/testingwhatyoutrack"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"title":"Essentials","generated":true}],"references":{"doc://TrackerTesting/documentation/TrackerTesting":{"kind":"symbol","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","url":"\/documentation\/trackertesting","role":"collection","type":"topic","abstract":[],"title":"TrackerTesting"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"url":"\/documentation\/traffluent\/trackingevents","type":"topic","role":"article","title":"Tracking Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","kind":"article","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"url":"\/documentation\/traffluent\/choosingdestinations","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","kind":"article","type