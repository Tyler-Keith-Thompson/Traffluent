{"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"title":"Essentials","generated":true}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","isActive":true,"type":"reference"},{"text":" product to the test target. ","type":"text"},{"code":"withRecordingTracker","type":"codeVoice"},{"text":" binds a fresh","type":"text"},{"text":" ","type":"text"},{"text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in","type":"text"},{"text":" ","type":"text"},{"text":"order. Here ","type":"text"},{"code":"SignedUp","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each call has a tracker of its own, so tests running at the same time never see each other’s","type":"text"},{"text":" ","type":"text"},{"text":"events. The body may be sync or async, and may return a value, read as ","type":"text"},{"type":"codeVoice","code":"tracked.value"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"tracked.names"},{"text":" lists every event’s name and ","type":"text"},{"type":"codeVoice","code":"tracked.records"},{"text":" every record.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Most code needs nothing more: it tracks through ","type":"text"},{"type":"codeVoice","code":"Tracker.current"},{"text":", which falls back to the tracker","type":"text"},{"text":" ","type":"text"},{"text":"the app bootstrapped, and the test’s binding wins over that one. Pass a tracker instead where the","type":"text"},{"text":" ","type":"text"},{"text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with ","type":"text"},{"type":"codeVoice","code":"tracker(_:)"},{"text":", such as a preview’s,","type":"text"},{"text":" ","type":"text"},{"text":"reaches the view’s environment but not code that reads ","type":"text"},{"type":"codeVoice","code":"Tracker.current"},{"text":". Such a test takes the","type":"text"},{"text":" ","type":"text"},{"text":"tracker the body is given and sets it on the view: ","type":"text"},{"type":"codeVoice","code":"withRecordingTracker { tracker in … }"},{"text":".","type":"text"}]}]}],"abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/testingwhatyoutrack"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"Traffluent"}],"role":"article","title":"Testing What Your Code Tracks"},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","interfaceLanguage":"swift"},"references":{"doc://Traffluent/documentation/Traffluent/GettingStarted":{"title":"Getting Started","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"kind":"article","url":"\/documentation\/traffluent\/gettingstarted","type"