{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/testingwhatyoutrack"]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Traffluent"}],"title":"Testing What Your Code Tracks"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"seeAlsoSections":[{"title":"Essentials","generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"anchor":"Essentials"}],"abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","type":"reference","isActive":true},{"type":"text","text":" product to the test target. "},{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" binds a fresh"},{"type":"text","text":" "},{"type":"text","text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in"},{"type":"text","text":" "},{"type":"text","text":"order. Here "},{"type":"codeVoice","code":"SignedUp"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"]},{"type":"paragraph","inlineContent":[{"text":"Each call has a tracker of its own, so tests running at the same time never see each other’s","type":"text"},{"text":" ","type":"text"},{"text":"events. The body may be sync or async, and may return a value, read as ","type":"text"},{"code":"tracked.value","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"tracked.names","type":"codeVoice"},{"text":" lists every event’s name and ","type":"text"},{"code":"tracked.records","type":"codeVoice"},{"text":" every record.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Most code needs nothing more: it tracks through ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":", which falls back to the tracker","type":"text"},{"text":" ","type":"text"},{"text":"the app bootstrapped, and the test’s binding wins over that one. A view whose tracker was never set","type":"text"},{"text":" ","type":"text"},{"text":"that binds its tracker with ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":" reaches the test’s tracker too. Pass a tracker instead where the","type":"text"},{"text":" ","type":"text"},{"text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with ","type":"text"},{"code":"tracker(_:)","type":"codeVoice"},{"text":", such as a preview’s,","type":"text"},{"text":" ","type":"text"},{"text":"reaches the view’s environment but not code that reads ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":". Such a test takes the","type":"text"},{"text":" ","type":"text"},{"text":"tracker the body is given and sets it on the view: ","type":"text"},{"code":"withRecordingTracker { tracker in … }","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"kind":"article","title":"Tracking from SwiftUI, UIKit and AppKit","url":"\/documentation\/traffluent\/trackingfromviews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"},"doc://TrackerTesting/documentation/TrackerTesting":{"role":"collection","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"title":"TrackerTesting","kind":"symbol","type":"topic","url":"\/documentation\/trackertesting","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"type":"topic","kind":"article","title":"Tracking Events","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent\/trackingevents"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"kind":"article","type":"topic","title":"Choosing Destinations","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"url":"\/documentation\/traffluent\/choosingdestinations"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"type":"topic","kind":"article","title":"Getting Started","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"url":"\/documentation\/traffluent\/gettingstarted"},"doc://Traffluent/documentation/Traffluent":{"url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","kind":"symbol","title":"Traffluent","type":"topic","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"role":"collection"}}}