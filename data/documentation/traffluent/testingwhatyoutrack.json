{"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"sections":[],"kind":"article","metadata":{"roleHeading":"Article","title":"Testing What Your Code Tracks","modules":[{"name":"Traffluent"}],"role":"article"},"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/testingwhatyoutrack"]}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","isActive":true,"type":"reference"},{"text":" product to the test target. ","type":"text"},{"code":"withRecordingTracker","type":"codeVoice"},{"text":" binds a fresh","type":"text"},{"text":" ","type":"text"},{"text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in","type":"text"},{"text":" ","type":"text"},{"text":"order. Here ","type":"text"},{"code":"SignedUp","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call has a tracker of its own, so tests running at the same time never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. The body may be sync or async, and may return a value, read as "},{"code":"tracked.value","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"code":"tracked.names","type":"codeVoice"},{"type":"text","text":" lists every event’s name and "},{"code":"tracked.records","type":"codeVoice"},{"type":"text","text":" every record."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most code needs nothing more: it tracks through "},{"code":"Tracker.current","type":"codeVoice"},{"type":"text","text":", which falls back to the tracker"},{"type":"text","text":" "},{"type":"text","text":"the app bootstrapped, and the test’s binding wins over that one. A view whose tracker was never set"},{"type":"text","text":" "},{"type":"text","text":"that binds its tracker with "},{"code":"withTracker","type":"codeVoice"},{"type":"text","text":" reaches the test’s tracker too. Pass a tracker instead where the"},{"type":"text","text":" "},{"type":"text","text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with "},{"code":"tracker(_:)","type":"codeVoice"},{"type":"text","text":", such as a preview’s,"},{"type":"text","text":" "},{"type":"text","text":"reaches the view’s environment but not code that reads "},{"code":"Tracker.current","type":"codeVoice"},{"type":"text","text":". Such a test takes the"},{"type":"text","text":" "},{"type":"text","text":"tracker the body is given and sets it on the view: "},{"code":"withRecordingTracker { tracker in … }","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","title":"Tracking Events","url":"\/documentation\/traffluent\/trackingevents","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"topic"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"type":"topic","role":"article","kind":"article","url":"\/documentation\/traffluent\/gettingstarted","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","title":"Getting Started"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"role":"article","title":"Choosing Destinations","url":"\/documentation\/traffluent\/choosingdestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"role":"article","title":"Tracking from SwiftUI, UIKit and AppKit","url":"\/documentation\/traffluent\/trackingfromviews","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"topic"},"doc://Traffluent/documentation/Traffluent":{"type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/traffluent","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent"},"doc://TrackerTesting/documentation/TrackerTesting":{"type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/trackertesting","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","title":"TrackerTesting"}}}