ather than reading ","type":"text"},{"type":"codeVoice","code":"Tracker.current"},{"text":", such as a SwiftUI view given","type":"text"},{"text":" ","type":"text"},{"text":"one with ","type":"text"},{"type":"codeVoice","code":"tracker(_:)"},{"text":", takes the one the body is given: ","type":"text"},{"type":"codeVoice","code":"withRecordingTracker { tracker in … }"},{"text":".","type":"text"}],"type":"paragraph"}]}],"seeAlsoSections":[{"generated":true,"anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"title":"Essentials"}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","interfaceLanguage":"swift"},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Article","title":"Testing What Your Code Tracks","role":"article"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"references":{"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"title":"Tracking Events","type":"topic","kind":"article","url":"\/documentation\/traffluent\/trackingevents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","role":"article"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","type":"topic","kind":"article","url":"\/documentation\/traffluent\/choosingdestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","role":"article"},"doc://Traffluent/documentation/Traffluent/Tracking