tracked.names","type":"codeVoice"},{"type":"text","text":" lists every event’s name and "},{"code":"tracked.records","type":"codeVoice"},{"type":"text","text":" every record."}],"type":"paragraph"},{"inlineContent":[{"text":"Code that is handed its tracker rather than reading ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":", such as a SwiftUI view given","type":"text"},{"text":" ","type":"text"},{"text":"one with ","type":"text"},{"code":"tracker(_:)","type":"codeVoice"},{"text":", takes the one the body is given: ","type":"text"},{"code":"withRecordingTracker { tracker in … }","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"seeAlsoSections":[{"title":"Essentials","generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"anchor":"Essentials"}],"kind":"article","references":{"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","abstract":[{"type":"text","text":"Track typed events with a tracker, then deliver them in batches to any number of destinations."}],"url":"\/documentation\/traffluent\/trackingevents","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"topic","title":"Tracking Events"},"doc://TrackerTesting/documentation/TrackerTesting":{"title":"TrackerTesting","role":"collection","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","abstract":[],"type":"topic","url":"\/documentation\/trackertesting","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"type":"topic","url":"\/documentation\/traffluent\/choosingdestinations","kind":"article"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","abstract":[{"text":"Vendor-neutral analytics for Swift: typed events, tracked by a tracker and delivered in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent","role":"collection","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","type":"topic","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"title":"Tracking from SwiftUI, UIKit and AppKit","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"type":"topic","url":"\/documentation\/traffluent\/trackingfromviews","kind":"article"}}}