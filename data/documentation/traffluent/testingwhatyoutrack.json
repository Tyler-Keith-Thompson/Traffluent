{"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"metadata":{"title":"Testing What Your Code Tracks","role":"article","modules":[{"name":"Traffluent"}],"roleHeading":"Article"},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Add the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},{"type":"text","text":" product to the test target. "},{"code":"withRecordingTracker","type":"codeVoice"},{"type":"text","text":" binds a fresh"},{"type":"text","text":" "},{"type":"text","text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in"},{"type":"text","text":" "},{"type":"text","text":"order. Here "},{"code":"SignedUp","type":"codeVoice"},{"type":"text","text":" is "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"]},{"inlineContent":[{"type":"text","text":"Each call has a tracker of its own, so tests running at the same time never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. The body may be sync or async, and may return a value, read as "},{"code":"tracked.value","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"code":"tracked.names","type":"codeVoice"},{"type":"text","text":" lists every event’s name and "},{"code":"tracked.records","type":"codeVoice"},{"type":"text","text":" every record."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Code that is handed its tracker rather than reading "},{"code":"Tracker.current","type":"codeVoice"},{"type":"text","text":", such as a SwiftUI view given"},{"type":"text","text":" "},{"type":"text","text":"one with "},{"code":"tracker(_:)","type":"codeVoice"},{"type":"text","text":", takes the one the body is given: "},{"code":"withRecordingTracker { tracker in … }","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"kind":"article","variants":[{"paths":["\/documentation\/traffluent\/testingwhatyoutrack"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Traffluent/documentation/Traffluent/GettingStarted":{"kind":"article","title":"Getting Started","role":"article","type":"topic","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","url":"\/documentation\/traffluent\/gettingstarted"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"type":"topic","title":"Tracking from SwiftUI, UIKit and AppKit","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"role":"article","url":"\/documentation\/trafflu