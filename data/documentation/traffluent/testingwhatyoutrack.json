{"metadata":{"role":"article","title":"Testing What Your Code Tracks","roleHeading":"Article","modules":[{"name":"Traffluent"}]},"kind":"article","sections":[],"abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","isActive":true},{"type":"text","text":" product to the test target. "},{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" binds a fresh"},{"type":"text","text":" "},{"type":"text","text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in"},{"type":"text","text":" "},{"type":"text","text":"order. Here "},{"type":"codeVoice","code":"SignedUp"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each call has a tracker of its own, so tests running at the same time never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. The body may be sync or async, and may return a value, read as "},{"type":"codeVoice","code":"tracked.value"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"tracked.names"},{"type":"text","text":" lists every event’s name and "},{"type":"codeVoice","code":"tracked.records"},{"type":"text","text":" every record."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Code that is handed its tracker rather than reading "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":", such as a SwiftUI view given"},{"type":"text","text":" "},{"type":"text","text":"one with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", takes the one the body is given: "},{"type":"codeVoice","code":"withRecordingTracker { tracker in … }"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"generated":true,"anchor":"Essentials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/testingwhatyoutrack"]}],"references":{"doc://TrackerTesting/documentation/TrackerTesting":{"role":"collection","title":"TrackerTesting","url":"\/documentation\/trackertesting","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"title":"Getting Started","type":"topic","kind":"article","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"url":"\/documentation\/traffluent\/gettingstarted","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted"},"doc://Traffluent/documentation/Traffluent":{"title":