{"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"Testing What Your Code Tracks","modules":[{"name":"Traffluent"}]},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/testingwhatyoutrack"]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","interfaceLanguage":"swift"},"abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},{"type":"text","text":" product to the test target. "},{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" binds a fresh"},{"type":"text","text":" "},{"type":"text","text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in"},{"type":"text","text":" "},{"type":"text","text":"order. Here "},{"type":"codeVoice","code":"SignedUp"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"]},{"inlineContent":[{"type":"text","text":"Each call has a tracker of its own, so tests running at the same time never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. The body may be sync or async, and may return a value, read as "},{"type":"codeVoice","code":"tracked.value"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"tracked.names"},{"type":"text","text":" lists every event’s name and "},{"type":"codeVoice","code":"tracked.records"},{"type":"text","text":" every record."}],"type":"paragraph"},{"inlineContent":[{"text":"Most code needs nothing more: it tracks through ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":", which falls back to the tracker","type":"text"},{"text":" ","type":"text"},{"text":"the app bootstrapped, and the test’s binding wins over that one. A view whose tracker was never set","type":"text"},{"text":" ","type":"text"},{"text":"that binds its tracker with ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":" reaches the test’s tracker too. Pass a tracker instead where the","type":"text"},{"text":" ","type":"text"},{"text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with ","type":"text"},{"code":"tracker(_:)","type":"codeVoice"},{"text":", such as a preview’s,","type":"text"},{"text":" ","type":"text"},{"text":"reaches the view’s environment but not code that reads ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":". Such a test takes the","type":"text"},{"text":" ","type":"text"},{"text":"tracker the body is given and sets it on the view: ","type":"text"},{"code":"withRecordingTracker { tracker in … }","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"generated":true,"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"]}],"references":{"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","title":"Tracking Events","type":"topic","role":"article","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent\/trackingevents"},"doc://Traffluent/documentation/Traffluent":{"title":"Traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/traffluent"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","title":"Choosing Destinations","type":"topic","role":"article","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"url":"\/documentation\/traffluent\/choosingdestinations"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"title":"Tracking from SwiftUI, UIKit and AppKit","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"kind":"article","role":"article","type":"topic","url":"\/documentation\/traffluent\/trackingfromviews"},"doc://TrackerTesting/documentation/TrackerTesting":{"url":"\/documentation\/trackertesting","kind":"symbol","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","role":"collection","title":"TrackerTesting","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"url":"\/documentation\/traffluent\/gettingstarted","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","role":"article","title":"Getting Started","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"type":"topic"}}}