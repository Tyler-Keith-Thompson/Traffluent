{"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},{"type":"text","text":" product to the test target. "},{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" binds a fresh"},{"type":"text","text":" "},{"type":"text","text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in"},{"type":"text","text":" "},{"type":"text","text":"order. Here "},{"type":"codeVoice","code":"SignedUp"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":":"}]},{"type":"codeListing","code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call has a tracker of its own, so tests running at the same time never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. The body may be sync or async, and may return a value, read as "},{"type":"codeVoice","code":"tracked.value"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"tracked.names"},{"type":"text","text":" lists every event’s name and "},{"type":"codeVoice","code":"tracked.records"},{"type":"text","text":" every record."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most code needs nothing more: it tracks through "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":", which falls back to the tracker"},{"type":"text","text":" "},{"type":"text","text":"the app bootstrapped, and the test’s binding wins over that one. A view whose tracker was never set"},{"type":"text","text":" "},{"type":"text","text":"that binds its tracker with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" reaches the test’s tracker too. Pass a tracker instead where the"},{"type":"text","text":" "},{"type":"text","text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", such as a preview’s,"},{"type":"text","text":" "},{"type":"text","text":"reaches the view’s environment but not code that reads "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":". Such a test takes the"},{"type":"text","text":" "},{"type":"text","text":"tracker the body is given and sets it on the view: "},{"type":"codeVoice","code":"withRecordingTracker { tracker in … }"},{"type":"text","text":"."}]}]}],"metadata":{"modules":[{"name":"Traffluent"}],"title":"Testing What Your Code Tracks","roleHeading":"Article","role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/testingwhatyoutrack"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"generated":true,"anchor":"Essentials"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"references":{"doc://Traffluent/documentation/Traffluent/GettingStarted":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","url":"\/documentation\/traffluent\/gettingstarted","kind":"article","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"type":"topic","role":"article","title":"Getting Started"},"doc://TrackerTesting/documentation/TrackerTesting":{"kind":"symbol","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"type":"topic","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","role":"collection","url":"\/documentation\/trackertesting","title":"TrackerTesting"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","url":"\/documentation\/traffluent","kind":"symbol","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"type":"topic","role":"collection","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"topic","role":"article","title":"Tracking Events","url":"\/documentation\/traffluent\/trackingevents"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","url":"\/documentation\/traffluent\/choosingdestinations","kind":"article","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"type":"topic","role":"article","title":"Choosing Destinations"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"title":"Tracking from SwiftUI, UIKit and AppKit","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"url":"\/documentation\/traffluent\/trackingfromviews","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"topic","kind":"article","role":"article"}}}