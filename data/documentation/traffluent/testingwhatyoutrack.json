{"abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Article","role":"article","title":"Testing What Your Code Tracks"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/testingwhatyoutrack"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"anchor":"Essentials","title":"Essentials","generated":true}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","isActive":true},{"type":"text","text":" product to the test target. "},{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" binds a fresh"},{"type":"text","text":" "},{"type":"text","text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in"},{"type":"text","text":" "},{"type":"text","text":"order. Here "},{"type":"codeVoice","code":"SignedUp"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"]},{"inlineContent":[{"text":"Each call has a tracker of its own, so tests running at the same time never see each other’s","type":"text"},{"text":" ","type":"text"},{"text":"events. The body may be sync or async, and may return a value, read as ","type":"text"},{"code":"tracked.value","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"tracked.names","type":"codeVoice"},{"text":" lists every event’s name and ","type":"text"},{"code":"tracked.records","type":"codeVoice"},{"text":" every record.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Most code needs nothing more: it tracks through "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":", which falls back to the tracker"},{"type":"text","text":" "},{"type":"text","text":"the app bootstrapped, and the test’s binding wins over that one. A view whose tracker was never set"},{"type":"text","text":" "},{"type":"text","text":"that binds its tracker with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" reaches the test’s tracker too. Pass a tracker instead where the"},{"type":"text","text":" "},{"type":"text","text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", such as a preview’s,"},{"type":"text","text":" "},{"type":"text","text":"reaches the view’s environment but not code that reads "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":". Such a test takes the"},{"type":"text","text":" "},{"type":"text","text":"tracker the body is given and sets it on the view: "},{"type":"codeVoice","code":"withRecordingTracker { tracker in … }"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"references":{"doc://Traffluent/documentation/Traffluent/GettingStarted":{"title":"Getting Started","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","type":"topic","url":"\/documentation\/traffluent\/gettingstarted","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","url":"\/documentation\/traffluent\/trackingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","type":"topic","title":"Tracking Events","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"role":"article"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"kind":"article","url":"\/documentation\/traffluent\/trackingfromviews","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","type":"topic","title":"Tracking from SwiftUI, UIKit and AppKit","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"role":"article"},"doc://TrackerTesting/documentation/TrackerTesting":{"url":"\/documentation\/trackertesting","kind":"symbol","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","title":"TrackerTesting","type":"topic","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"role":"collection"},"doc://Traffluent/documentation/Traffluent":{"url":"\/documentation\/traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","type":"topic","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"title":"Traffluent","role":"collection"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"title":"Choosing Destinations","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"topic","url":"\/documentation\/traffluent\/choosingdestinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"role":"article","kind":"article"}}}