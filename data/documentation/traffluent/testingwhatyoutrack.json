{"metadata":{"modules":[{"name":"Traffluent"}],"role":"article","title":"Testing What Your Code Tracks","roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"reference","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","isActive":true},{"type":"text","text":" product to the test target. "},{"code":"withRecordingTracker","type":"codeVoice"},{"type":"text","text":" binds a fresh"},{"type":"text","text":" "},{"type":"text","text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in"},{"type":"text","text":" "},{"type":"text","text":"order. Here "},{"code":"SignedUp","type":"codeVoice"},{"type":"text","text":" is "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each call has a tracker of its own, so tests running at the same time never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. The body may be sync or async, and may return a value, read as "},{"type":"codeVoice","code":"tracked.value"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"tracked.names"},{"type":"text","text":" lists every event’s name and "},{"type":"codeVoice","code":"tracked.records"},{"type":"text","text":" every record."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Most code needs nothing more: it tracks through "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":", which falls back to the tracker"},{"type":"text","text":" "},{"type":"text","text":"the app bootstrapped, and the test’s binding wins over that one. A view whose tracker was never set"},{"type":"text","text":" "},{"type":"text","text":"that binds its tracker with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" reaches the test’s tracker too. Pass a tracker instead where the"},{"type":"text","text":" "},{"type":"text","text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", such as a preview’s,"},{"type":"text","text":" "},{"type":"text","text":"reaches the view’s environment but not code that reads "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":". Such a test takes the"},{"type":"text","text":" "},{"type":"text","text":"tracker the body is given and sets it on the view: "},{"type":"codeVoice","code":"withRecordingTracker { tracker in … }"},{"type":"text","text":"."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/testingwhatyoutrack"]}],"sections":[],"kind":"article","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"generated":true}],"references":{"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","type":"topic","title":"Tracking Events","url":"\/documentation\/traffluent\/trackingevents","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"kind":"article","title":"Tracking from SwiftUI, UIKit and AppKit","url":"\/documentation\/traffluent\/trackingfromviews","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"role":"article"},"doc://TrackerTesting/documentation/TrackerTesting":{"role":"collection","type":"topic","title":"TrackerTesting","kind":"symbol","url":"\/documentation\/trackertesting","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked, in order.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"role":"article","type":"topic","title":"Getting Started","url":"\/documentation\/traffluent\/gettingstarted","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"role":"article","type":"topic","title":"Choosing Destinations","url":"\/documentation\/traffluent\/choosingdestinations","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}]},"doc://Traffluent/documentation/Traffluent":{"role":"collection","type":"topic","kind":"symbol","title":"Traffluent","url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}]}}}