{"variants":[{"paths":["\/documentation\/traffluent\/writingavendordestination"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Article","role":"article","title":"Writing a Vendor Destination"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"anchor":"Guides","generated":true}],"abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A vendor destination is an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" with an encoder that writes the vendor’s ingestion"},{"type":"text","text":" "},{"type":"text","text":"format. "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" already does the batching, retries, drop reports and trace context, so the"},{"type":"text","text":" "},{"type":"text","text":"vendor module adds three things:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"an encoder, a "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" that writes each record as the vendor’s JSON and splits a batch to"},{"type":"text","text":" "},{"type":"text","text":"the vendor’s limits;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a factory on ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" that checks what the adopter passes and fills in the endpoint, the","type":"text"},{"text":" ","type":"text"},{"text":"encoder and the limits, so setup is one call;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"tests that run "},{"code":"DestinationTesting","type":"codeVoice"},{"type":"text","text":"’s conformance checks and compare its requests with recorded"},{"type":"text","text":" "},{"type":"text","text":"fixtures."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Write the encoder against the vendor’s public HTTP API, not its SDK, so the app links nothing of"},{"type":"text","text":" "},{"type":"text","text":"the vendor’s. "},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","isActive":true,"type":"reference"},{"type":"text","text":" is built this way and is a full example to copy."}],"type":"paragraph"},{"text":"The module","anchor":"The-module","level":3,"type":"heading"},{"inlineContent":[{"text":"Make the module depend on ","type":"text"},{"code":"HTTPDestinations","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PropertyJSON","type":"codeVoice"},{"text":", ","type":"text"},{"code":"JSONValues","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"TrackingPlans","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and on swift-distributed-tracing’s ","type":"text"},{"code":"Instrumentation","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"NoOpInstrument","type":"codeVoice"},{"text":". Its tests depend on","type":"text"},{"text":" ","type":"text"},{"code":"DestinationTesting","type":"codeVoice"},{"text":" as well. ","type":"text"},{"code":"PropertyJSON","type":"codeVoice"},{"text":" holds the vendor-neutral pieces an encoder is built","type":"text"},{"text":" ","type":"text"},{"text":"from, ","type":"text"},{"code":"JSONValues","type":"codeVoice"},{"text":" the ","type":"text"},{"code":"JSON","type":"codeVoice"},{"text":" value it writes, and ","type":"text"},{"code":"TrackingPlans","type":"codeVoice"},{"text":" the app’s ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"the encoder reads properties through. ","type":"text"},{"code":"DestinationTesting","type":"codeVoice"},{"text":" imports Swift Testing, so it goes in","type":"text"},{"text":" ","type":"text"},{"text":"test targets only.","type":"text"}],"type":"paragraph"},{"code":[".target(name: \"AcmeEncoding\", dependencies: [","    .product(name: \"HTTPDestinations\", package: \"Traffluent\"),","    .product(name: \"PropertyJSON\", package: \"Traffluent\"),","    .product(name: \"JSONValues\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","    .product(name: \"Instrumentation\", package: \"swift-distributed-tracing\"),","]),",".testTarget(name: \"AcmeEncodingTests\", dependencies: [","    \"AcmeEncoding\",","    .product(name: \"DestinationTesting\", package: \"Traffluent\"),","], resources: [.copy(\"Fixtures\")]),"],"type":"codeListing","syntax":"swift"},{"text":"The encoder","anchor":"The-encoder","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The examples here are for Acme, a made-up vendor whose API takes"},{"type":"text","text":" "},{"code":"{\"api_key\": …, \"events\": [{\"event\", \"user_id\", \"insert_id\", \"time\", \"properties\", \"context\"}]}","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and allows at most 500 events and 1,000,000 bytes a request, and 32,000 bytes an event."},{"type":"text","text":" "},{"code":"PropertyJSON","type":"codeVoice"},{"type":"text","text":" supplies each piece of such a record:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"PropertyReader","type":"codeVoice"},{"text":" reads an event’s properties through its schema in the app’s ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"leaving out ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" values unless you ask for them and the record reveals them.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EventRecord.standardContext"},{"type":"text","text":" is the app, device, locale, network and operating system as JSON,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"flattened(separator:)"},{"type":"text","text":" turns it into the one level of dotted keys most vendors take."}]}]},{"content":[{"inlineContent":[{"code":"Date.iso8601Timestamp","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Date.millisecondsSince1970()","type":"codeVoice"},{"text":" are the two timestamp formats vendors","type":"text"},{"text":" ","type":"text"},{"text":"ask for.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"EventRecord.pseudonymousIdentity"},{"type":"text","text":" is who the event is about: the record’s session, or the record"},{"type":"text","text":" "},{"type":"text","text":"itself when it has none, and never a person ("},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","isActive":true},{"type":"text","text":"). "},{"type":"codeVoice","code":"deduplicationID"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"identifier a vendor drops repeats by, which a redelivered record keeps."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"BatchLimit.requests(for:in:encoding:oversized:)","type":"codeVoice"},{"text":" splits a batch into requests of a","type":"text"},{"text":" ","type":"text"},{"code":"JSONEnvelope","type":"codeVoice"},{"text":" within the vendor’s limits, and leaves out a record that fits in none of them.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["\/\/\/ Why the Acme encoder left a record out.","enum AcmeEncodingError: Error, Hashable {","    case unreadable(PropertyReadingError)","    case contextKeyCollision(key: String)","    case unrepresentableTimestamp","    case oversized(byteCount: Int)","}","","struct AcmeBatchEncoder: BatchEncoder {","    \/\/\/ Acme's limits on one request.","    static let batchLimit = (try? BatchLimit(maximumRecordCount: 500, maximumByteCount: 1_000_000, maximumRecordByteCount: 32_000)) ?? .unlimited","","    typealias Failure = AcmeEncodingError","","    private let reader: PropertyReader","    private let envelope: JSONEnvelope","","    init(apiKey: String, plan: TrackingPlan) {","        reader = PropertyReader(plan: plan)","        envelope = JSONEnvelope([\"api_key\": .string(apiKey)], arrayMember: \"events\")","    }","","    func requests(for batch: [EventRecord]) -> BatchRequests<AcmeEncodingError> {","        Self.batchLimit.requests(for: batch, in: envelope) { record throws(AcmeEncodingError) in","            try json(of: record)","        } oversized: { byteCount in","            .oversized(byteCount: byteCount)","        }","    }","","    private func json(of record: EventRecord) throws(AcmeEncodingError) -> JSON {","        let properties: [String: JSON]","        do {","            properties = try reader.properties(of: record, includingSensitiveValues: false)","        } catch {","            throw .unreadable(error)","        }","        let context: [String: JSON]","        do {","            context = try record.standardContext.flattened()","        } catch {","            throw .contextKeyCollision(key: error.key)","        }","        let time: Int64","        do {","            time = try record.timestamp.millisecondsSince1970()","        } catch {","            throw .unrepresentableTimestamp","        }","        return .object([","            \"event\": .string(record.name),","            \"user_id\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","            \"insert_id\": .string(record.deduplicationID),","            \"time\": .integer(time),","            \"properties\": .object(properties),","            \"context\": .object(context),","        ])","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"requests(for:)"},{"type":"text","text":" is all a "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" implements, and "},{"type":"codeVoice","code":"Failure"},{"type":"text","text":" names the reason a record is"},{"type":"text","text":" "},{"type":"text","text":"left out, as "},{"type":"codeVoice","code":"requests(for:)"},{"type":"text","text":" doesn’t throw. "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends the requests in order, and"},{"type":"text","text":" "},{"type":"text","text":"reports each record left out as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":". Pass "},{"type":"codeVoice","code":"includingSensitiveValues: true"},{"type":"text","text":" only if the"},{"type":"text","text":" "},{"type":"text","text":"vendor’s terms allow the values, and then only through a factory the adopter opts in with."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the vendor misdates or ignores an event past some age but still answers 2xx, pass an age a"},{"type":"text","text":" "},{"type":"text","text":"little short of it to "},{"type":"codeVoice","code":"limit.requests(for:in:maximumAge:encoding:oversized:)"},{"type":"text","text":", which throws"},{"type":"text","text":" "},{"type":"codeVoice","code":"NegativeMaximumAge"},{"type":"text","text":" for one below zero. The spare time covers a request’s trip to the vendor and"},{"type":"text","text":" "},{"type":"text","text":"clocks that disagree. Each request then has a deadline that long after its oldest record was"},{"type":"text","text":" "},{"type":"text","text":"tracked, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops a request still being retried by then, all of its records, and"},{"type":"text","text":" "},{"type":"text","text":"reports it as "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":", rather than send records the"},{"type":"text","text":" "},{"type":"text","text":"vendor would store wrongly. Have the factory pass its "},{"type":"codeVoice","code":"now:"},{"type":"text","text":" to both the encoder and the"},{"type":"text","text":" "},{"type":"text","text":"destination, so one clock decides what is encoded and what is sent."}],"type":"paragraph"},{"text":"The factory","anchor":"The-factory","level":3,"type":"heading"},{"inlineContent":[{"text":"The factory is a static method on ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" constrained to the encoder, so adopters write","type":"text"},{"text":" ","type":"text"},{"code":"try HTTPDestination.acme(...)","type":"codeVoice"},{"text":". It throws a typed error for input the vendor would refuse, so a","type":"text"},{"text":" ","type":"text"},{"text":"mistake shows up at launch, not later as a stream of rejected requests. It also takes a transport","type":"text"},{"text":" ","type":"text"},{"text":"and a backoff, which the conformance checks need. It passes ","type":"text"},{"code":"NoOpInstrument()","type":"codeVoice"},{"text":", so no request","type":"text"},{"text":" ","type":"text"},{"text":"carries the app’s trace context to the vendor, whatever tracer the app bootstraps.","type":"text"}],"type":"paragraph"},{"code":["\/\/\/ Why the Acme factory couldn't make a destination.","enum AcmeSetupError: Error, Hashable {","    case emptyAPIKey","    case invalidHost","}","","extension HTTPDestination where Encoding == AcmeBatchEncoder {","    static func acme(","        apiKey: String,","        host: URL,","        plan: TrackingPlan,","        transport: Transport,","        backoff: ExponentialBackoff = ExponentialBackoff()","    ) throws(AcmeSetupError) -> HTTPDestination<Transport, AcmeBatchEncoder> {","        guard !apiKey.isEmpty else { throw .emptyAPIKey }","        guard host.scheme == \"https\", host.host() != nil else { throw .invalidHost }","        return HTTPDestination(","            endpoint: host.appending(path: \"v1\/events\"),","            \/\/ Acme doesn't read a trace context, so the app's traces aren't sent to it.","            instrument: NoOpInstrument(),","            transport: transport,","            encoder: AcmeBatchEncoder(apiKey: apiKey, plan: plan),","            backoff: backoff)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Offer an overload without ","type":"text"},{"code":"transport:","type":"codeVoice"},{"text":" that passes ","type":"text"},{"code":"URLSessionTransport()","type":"codeVoice"},{"text":", as PostHog’s does, so","type":"text"},{"text":" ","type":"text"},{"text":"an app needn’t name one.","type":"text"}],"type":"paragraph"},{"text":"The conformance checks","anchor":"The-conformance-checks","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"DestinationConformance"},{"type":"text","text":" runs the checks every vendor destination must pass. Give it the vendor’s"},{"type":"text","text":" "},{"type":"text","text":"limit and a closure that calls the factory with the setup’s plan, transport and backoff:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted"},{"type":"text","text":": no "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent"},{"type":"text","text":" "},{"type":"text","text":"without the adopter’s opt-in."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","isActive":true,"type":"reference"},{"type":"text","text":": behind consent and "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"destination sends exactly the records it is handed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped"},{"text":": a record over the limit is","type":"text"},{"text":" ","type":"text"},{"text":"skipped and reported.","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","isActive":true,"type":"reference"},{"text":": failures are retried or dropped as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" classifies them.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld","type":"reference","isActive":true},{"text":": no request carries a trace context,","type":"text"},{"text":" ","type":"text"},{"text":"even while a tracer is active.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"expectRequests(of:plan:matchFixture:withExtension:subdirectory:in:sourceLocation:)"},{"type":"text","text":" compares the"},{"type":"text","text":" "},{"type":"text","text":"requests a hand-worked batch makes with a fixture in the test target’s resources, byte for byte."},{"type":"text","text":" "},{"type":"text","text":"When the fixture is missing, the issue it records holds the requests, so you can check them by hand"},{"type":"text","text":" "},{"type":"text","text":"against the vendor’s documentation and save them as the fixture."}],"type":"paragraph"},{"code":["@Test(arguments: ConformanceCheck.allCases)","func acmeConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/acme.example.com\"))","    let conformance = DestinationConformance(limit: AcmeBatchEncoder.batchLimit) { setup in","        try HTTPDestination.acme(apiKey: \"test-key\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for each rule the destination breaks. The kit is a"},{"type":"text","text":" "},{"type":"text","text":"shared assertion on purpose, so every vendor module runs the same checks. Every check’s records are"},{"type":"text","text":" "},{"type":"text","text":"tracked at "},{"code":"setup.timestamp","type":"codeVoice"},{"type":"text","text":"; if your encoder leaves out records older than the vendor takes, give"},{"type":"text","text":" "},{"type":"text","text":"it that as the time it encodes at, as "},{"code":"GoogleAnalyticsEncoding","type":"codeVoice"},{"type":"text","text":"’s tests do."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/transientFailuresRetried":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","abstract":[{"text":"A request that gets no response, a 5xx, 408 or 429 is sent again, byte for byte, until it is","type":"text"},{"text":" ","type":"text"},{"text":"delivered, and nothing is reported.","type":"text"}],"title":"ConformanceCheck.transientFailuresRetried","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/transientfailuresretried","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientFailuresRetried","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"url":"\/documentation\/traffluent\/sessionsandstandardcontext","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","kind":"article","title":"Sessions and Standard Context","type":"topic","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"role":"article"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"title":"Automatic Tracking","role":"article","url":"\/documentation\/traffluent\/automatictracking","kind":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"url":"\/documentation\/traffluent\/trackingplanworkflow","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","kind":"article","title":"Exporting and Checking a Tracking Plan","type":"topic","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"role":"article"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/sensitiveValuesRedacted":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","abstract":[{"type":"text","text":"A "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is never sent by the default destination, even by a record that reveals"},{"type":"text","text":" "},{"type":"text","text":"it. With the adopter’s opt-in, it is sent while the record reveals it, and not once the"},{"type":"text","text":" "},{"type":"text","text":"record is redacted."}],"title":"ConformanceCheck.sensitiveValuesRedacted","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/sensitivevaluesredacted","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sensitiveValuesRedacted","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/consentHolds":{"url":"\/documentation\/destinationtesting\/conformancecheck\/consentholds","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"consentHolds","kind":"identifier"}],"kind":"symbol","title":"ConformanceCheck.consentHolds","type":"topic","abstract":[{"type":"text","text":"Behind a tracker’s "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":" and the destination’s "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", the destination sends"},{"type":"text","text":" "},{"type":"text","text":"the event of a granted category it accepts, and not the event of a denied category or of"},{"type":"text","text":" "},{"type":"text","text":"one it doesn’t accept."}],"role":"symbol"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"url":"\/documentation\/traffluent\/identifyingpeople","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","kind":"article","title":"Identifying People","type":"topic","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"role":"article"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/traceContextWithheld":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld","abstract":[{"type":"text","text":"No request carries a trace context in its header fields ("},{"type":"codeVoice","code":"traceparent"},{"type":"text","text":", "},{"type":"codeVoice","code":"tracestate"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"text","text":"whatever the instrument injects), even while a tracer is active and the record was tracked"},{"type":"text","text":" "},{"type":"text","text":"in a span: a vendor’s destination passes "},{"type":"codeVoice","code":"NoOpInstrument()"},{"type":"text","text":", so the app’s traces stay in"},{"type":"text","text":" "},{"type":"text","text":"the app."}],"title":"ConformanceCheck.traceContextWithheld","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/tracecontextwithheld","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"traceContextWithheld","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/oversizedRecordSkipped":{"url":"\/documentation\/destinationtesting\/conformancecheck\/oversizedrecordskipped","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"oversizedRecordSkipped"}],"kind":"symbol","title":"ConformanceCheck.oversizedRecordSkipped","type":"topic","abstract":[{"text":"A record too large for the vendor’s limit is left out and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", and the batch’s other records are sent.","type":"text"}],"role":"symbol"},"doc://Traffluent/documentation/Traffluent":{"url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","kind":"symbol","title":"Traffluent","type":"topic","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"role":"collection"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/rejectionsDropped":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","abstract":[{"type":"text","text":"A request answered with a status retrying won’t change (400, 401, 403, 404, 413, 422) is"},{"type":"text","text":" "},{"type":"text","text":"sent once and reported as "},{"code":"HTTPDropReport.rejected(status:recordIDs:)","type":"codeVoice"},{"type":"text","text":"."}],"title":"ConformanceCheck.rejectionsDropped","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/rejectionsdropped","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionsDropped","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"url":"\/documentation\/traffluent\/persistingrecords","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","kind":"article","title":"Persisting Records","type":"topic","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"role":"article"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}],"title":"PostHogEncoding","role":"collection","url":"\/documentation\/posthogencoding","kind":"symbol","type":"topic"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"url":"\/documentation\/traffluent\/samplingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","kind":"article","title":"Sampling Events","type":"topic","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"role":"article"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"title":"Consent Gating","role":"article","url":"\/documentation\/traffluent\/consentgating","kind":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"url":"\/documentation\/traffluent\/definingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","kind":"article","title":"Defining Events","type":"topic","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"role":"article"}}}