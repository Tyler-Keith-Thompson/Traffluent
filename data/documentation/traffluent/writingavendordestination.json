{"kind":"article","primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vendor destination is an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" with an encoder that writes the vendor’s ingestion"},{"type":"text","text":" "},{"type":"text","text":"format. "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" already does the batching, retries, drop reports and trace context, so the"},{"type":"text","text":" "},{"type":"text","text":"vendor module adds three things:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"an encoder, a "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" that writes each record as the vendor’s JSON and splits a batch to"},{"type":"text","text":" "},{"type":"text","text":"the vendor’s limits;"}]}]},{"content":[{"inlineContent":[{"text":"a factory on ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" that checks what the adopter passes and fills in the endpoint, the","type":"text"},{"text":" ","type":"text"},{"text":"encoder and the limits, so setup is one call;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"tests that run "},{"type":"codeVoice","code":"DestinationTesting"},{"type":"text","text":"’s conformance checks and compare its requests with recorded"},{"type":"text","text":" "},{"type":"text","text":"fixtures."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Write the encoder against the vendor’s public HTTP API, not its SDK, so the app links nothing of"},{"type":"text","text":" "},{"type":"text","text":"the vendor’s. "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","isActive":true},{"type":"text","text":" is built this way and is a full example to copy."}]},{"level":3,"anchor":"The-module","type":"heading","text":"The module"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the module depend on "},{"type":"codeVoice","code":"HTTPDestinations"},{"type":"text","text":", "},{"type":"codeVoice","code":"PropertyJSON"},{"type":"text","text":", "},{"type":"codeVoice","code":"JSONValues"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and on swift-distributed-tracing’s "},{"type":"codeVoice","code":"Instrumentation"},{"type":"text","text":" for "},{"type":"codeVoice","code":"NoOpInstrument"},{"type":"text","text":". Its tests depend on"},{"type":"text","text":" "},{"type":"codeVoice","code":"DestinationTesting"},{"type":"text","text":" as well. "},{"type":"codeVoice","code":"PropertyJSON"},{"type":"text","text":" holds the vendor-neutral pieces an encoder is built"},{"type":"text","text":" "},{"type":"text","text":"from, "},{"type":"codeVoice","code":"JSONValues"},{"type":"text","text":" the "},{"type":"codeVoice","code":"JSON"},{"type":"text","text":" value it writes, and "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":" the app’s "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"the encoder reads properties through. "},{"type":"codeVoice","code":"DestinationTesting"},{"type":"text","text":" imports Swift Testing, so it goes in"},{"type":"text","text":" "},{"type":"text","text":"test targets only."}]},{"type":"codeListing","code":[".target(name: \"AcmeEncoding\", dependencies: [","    .product(name: \"HTTPDestinations\", package: \"Traffluent\"),","    .product(name: \"PropertyJSON\", package: \"Traffluent\"),","    .product(name: \"JSONValues\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","    .product(name: \"Instrumentation\", package: \"swift-distributed-tracing\"),","]),",".testTarget(name: \"AcmeEncodingTests\", dependencies: [","    \"AcmeEncoding\",","    .product(name: \"DestinationTesting\", package: \"Traffluent\"),","], resources: [.copy(\"Fixtures\")]),"],"syntax":"swift"},{"level":3,"anchor":"The-encoder","type":"heading","text":"The encoder"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The examples here are for Acme, a made-up vendor whose API takes"},{"type":"text","text":" "},{"type":"codeVoice","code":"{\"api_key\": …, \"events\": [{\"event\", \"user_id\", \"insert_id\", \"time\", \"properties\", \"context\"}]}"},{"type":"text","text":" "},{"type":"text","text":"and allows at most 500 events and 1,000,000 bytes a request, and 32,000 bytes an event."},{"type":"text","text":" "},{"type":"codeVoice","code":"PropertyJSON"},{"type":"text","text":" supplies each piece of such a record:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PropertyReader"},{"text":" reads an event’s properties through its schema in the app’s ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"leaving out ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" values unless you ask for them and the record reveals them.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"EventRecord.standardContext","type":"codeVoice"},{"type":"text","text":" is the app, device, locale, network and operating system as JSON,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"flattened(separator:)","type":"codeVoice"},{"type":"text","text":" turns it into the one level of dotted keys most vendors take."}]}]},{"content":[{"inlineContent":[{"code":"Date.iso8601Timestamp","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Date.millisecondsSince1970()","type":"codeVoice"},{"text":" are the two timestamp formats vendors","type":"text"},{"text":" ","type":"text"},{"text":"ask for.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"EventRecord.pseudonymousIdentity","type":"codeVoice"},{"type":"text","text":" is who the event is about: the record’s session, or the record"},{"type":"text","text":" "},{"type":"text","text":"itself when it has none, and never a person ("},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"reference","isActive":true},{"type":"text","text":"). "},{"code":"deduplicationID","type":"codeVoice"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"identifier a vendor drops repeats by, which a redelivered record keeps."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BatchLimit.requests(for:in:encoding:oversized:)"},{"type":"text","text":" splits a batch into requests of a"},{"type":"text","text":" "},{"type":"codeVoice","code":"JSONEnvelope"},{"type":"text","text":" within the vendor’s limits, and leaves out a record that fits in none of them."}]}]}],"type":"unorderedList"},{"type":"codeListing","code":["\/\/\/ Why the Acme encoder left a record out.","enum AcmeEncodingError: Error, Hashable {","    case unreadable(PropertyReadingError)","    case contextKeyCollision(key: String)","    case unrepresentableTimestamp","    case oversized(byteCount: Int)","}","","struct AcmeBatchEncoder: BatchEncoder {","    \/\/\/ Acme's limits on one request.","    static let batchLimit = (try? BatchLimit(maximumRecordCount: 500, maximumByteCount: 1_000_000, maximumRecordByteCount: 32_000)) ?? .unlimited","","    typealias Failure = AcmeEncodingError","","    private let reader: PropertyReader","    private let envelope: JSONEnvelope","","    init(apiKey: String, plan: TrackingPlan) {","        reader = PropertyReader(plan: plan)","        envelope = JSONEnvelope([\"api_key\": .string(apiKey)], arrayMember: \"events\")","    }","","    func requests(for batch: [EventRecord]) -> BatchRequests<AcmeEncodingError> {","        Self.batchLimit.requests(for: batch, in: envelope) { record throws(AcmeEncodingError) in","            try json(of: record)","        } oversized: { byteCount in","            .oversized(byteCount: byteCount)","        }","    }","","    private func json(of record: EventRecord) throws(AcmeEncodingError) -> JSON {","        let properties: [String: JSON]","        do {","            properties = try reader.properties(of: record, includingSensitiveValues: false)","        } catch {","            throw .unreadable(error)","        }","        let context: [String: JSON]","        do {","            context = try record.standardContext.flattened()","        } catch {","            throw .contextKeyCollision(key: error.key)","        }","        let time: Int64","        do {","            time = try record.timestamp.millisecondsSince1970()","        } catch {","            throw .unrepresentableTimestamp","        }","        return .object([","            \"event\": .string(record.name),","            \"user_id\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","            \"insert_id\": .string(record.deduplicationID),","            \"time\": .integer(time),","            \"properties\": .object(properties),","            \"context\": .object(context),","        ])","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" implements "},{"type":"codeVoice","code":"requests(for:)"},{"type":"text","text":" and declares "},{"type":"codeVoice","code":"transientStatuses"},{"type":"text","text":" and "},{"type":"codeVoice","code":"outcome(of:for:)"},{"type":"text","text":" (below), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Failure"},{"type":"text","text":" names the reason a record is left out, as "},{"type":"codeVoice","code":"requests(for:)"},{"type":"text","text":" doesn’t throw. "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends the requests in order, and"},{"type":"text","text":" "},{"type":"text","text":"reports each record left out as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":". Pass "},{"type":"codeVoice","code":"includingSensitiveValues: true"},{"type":"text","text":" only if the"},{"type":"text","text":" "},{"type":"text","text":"vendor’s terms allow the values, and then only through a factory the adopter opts in with."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the vendor misdates or ignores an event past some age but still answers 2xx, pass an age a"},{"type":"text","text":" "},{"type":"text","text":"little short of it to "},{"type":"codeVoice","code":"limit.requests(for:in:maximumAge:encoding:oversized:)"},{"type":"text","text":", which throws"},{"type":"text","text":" "},{"type":"codeVoice","code":"NegativeMaximumAge"},{"type":"text","text":" for one below zero. The spare time covers a request’s trip to the vendor and"},{"type":"text","text":" "},{"type":"text","text":"clocks that disagree. Each request then has a deadline that long after its oldest record was"},{"type":"text","text":" "},{"type":"text","text":"tracked, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops a request still being retried by then, all of its records, and"},{"type":"text","text":" "},{"type":"text","text":"reports it as "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":", rather than send records the"},{"type":"text","text":" "},{"type":"text","text":"vendor would store wrongly. Have the factory pass its "},{"type":"codeVoice","code":"now:"},{"type":"text","text":" to both the encoder and the"},{"type":"text","text":" "},{"type":"text","text":"destination, so one clock decides what is encoded and what is sent."}]},{"type":"paragraph","inlineContent":[{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries no response, a 5xx, 408 and 429, and drops a request answered with any","type":"text"},{"text":" ","type":"text"},{"text":"other status. Every encoder declares ","type":"text"},{"code":"transientStatuses","type":"codeVoice"},{"text":", as there is no default: ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"vendor answers only those to a request worth sending again. If it answers some other failure for","type":"text"},{"text":" ","type":"text"},{"text":"one, list that status, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries it too. A ","type":"text"},{"code":"TransientStatus","type":"codeVoice"},{"text":" is a client or server error (4xx or 5xx); any other status throws","type":"text"},{"text":" ","type":"text"},{"code":"InvalidTransientStatus","type":"codeVoice"},{"text":", as a 2xx is read by ","type":"text"},{"code":"outcome(of:for:)","type":"codeVoice"},{"text":" instead (below):","type":"text"}]},{"type":"codeListing","code":["extension AcmeBatchEncoder {","    \/\/\/ Acme answers 425 Too Early while a new region starts up, and takes the request later.","    static let transientStatuses: Set<TransientStatus> = (try? TransientStatus(425)).map { [$0] } ?? []","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The set belongs to the encoder’s type, so every destination made with that encoder retries those"},{"type":"text","text":" "},{"type":"text","text":"statuses, whether it comes from the factory or not. The conformance checks read it too. An encoder"},{"type":"text","text":" "},{"type":"text","text":"that wraps another, to filter or rename records, forwards the inner encoder’s set"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"static var transientStatuses: Set<TransientStatus> { Inner.transientStatuses }","type":"codeVoice"},{"type":"text","text":"), or the"},{"type":"text","text":" "},{"type":"text","text":"vendor’s retries are lost."}]},{"type":"paragraph","inlineContent":[{"text":"Every encoder implements ","type":"text"},{"type":"codeVoice","code":"outcome(of:for:)"},{"text":" too, which is called for every 2xx answer, with its status","type":"text"},{"text":" ","type":"text"},{"text":"and body. Return ","type":"text"},{"type":"codeVoice","code":".delivered"},{"text":" when the vendor documents no 2xx that means “not stored”. If the","type":"text"},{"text":" ","type":"text"},{"text":"vendor answers 200 and says in the body that it stored nothing, read that answer: return ","type":"text"},{"type":"codeVoice","code":".rejected(reason:)"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"one that will never be stored, which ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" drops and reports as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.rejectedInBody(status:reason:recordIDs:)"},{"text":", and ","type":"text"},{"type":"codeVoice","code":".transient(reason:)"},{"text":" for one worth","type":"text"},{"text":" ","type":"text"},{"text":"sending again, which it retries like a 5xx. Return ","type":"text"},{"type":"codeVoice","code":".delivered"},{"text":" for a body you can’t read, an","type":"text"},{"text":" ","type":"text"},{"text":"empty one included, as a proxy or a changed API might answer; otherwise the request would be","type":"text"},{"text":" ","type":"text"},{"text":"resent or dropped for an answer the vendor never documented. Cite the documentation the answer","type":"text"},{"text":" ","type":"text"},{"text":"comes from in a comment:","type":"text"}]},{"type":"codeListing","code":["extension AcmeBatchEncoder {","    private struct Answer: Decodable {","        let accepted: Bool","        let error: String?","    }","","    \/\/ Acme's ingestion reference answers 200 with {\"accepted\": false, \"error\": \"...\"} for an","    \/\/ unknown API key, and {\"accepted\": true} for a request it stored.","    static func outcome(of response: HTTPTransportResponse, for request: EncodedRequest) -> ResponseOutcome {","        guard let answer = try? JSONDecoder().decode(Answer.self, from: response.body), !answer.accepted else {","            return .delivered","        }","        return .rejected(reason: answer.error ?? \"Acme accepted none of the request\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An encoder that wraps another forwards its "},{"type":"codeVoice","code":"outcome(of:for:)"},{"type":"text","text":" the same way"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"static func outcome(of response: HTTPTransportResponse, for request: EncodedRequest) -> ResponseOutcome { Inner.outcome(of: response, for: request) }"},{"type":"text","text":")."}]},{"level":3,"anchor":"The-factory","type":"heading","text":"The factory"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The factory is a static method on "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" constrained to the encoder, so adopters write"},{"type":"text","text":" "},{"code":"try HTTPDestination.acme(...)","type":"codeVoice"},{"type":"text","text":". It throws a typed error for input the vendor would refuse, so a"},{"type":"text","text":" "},{"type":"text","text":"mistake shows up at launch, not later as a stream of rejected requests. It also takes a transport"},{"type":"text","text":" "},{"type":"text","text":"and a backoff, which the conformance checks need. It passes "},{"code":"NoOpInstrument()","type":"codeVoice"},{"type":"text","text":", so no request"},{"type":"text","text":" "},{"type":"text","text":"carries the app’s trace context to the vendor, whatever tracer the app bootstraps."}]},{"type":"codeListing","code":["\/\/\/ Why the Acme factory couldn't make a destination.","enum AcmeSetupError: Error, Hashable {","    case emptyAPIKey","    case invalidHost","}","","extension HTTPDestination where Encoding == AcmeBatchEncoder {","    static func acme(","        apiKey: String,","        host: URL,","        plan: TrackingPlan,","        transport: Transport,","        backoff: ExponentialBackoff = ExponentialBackoff()","    ) throws(AcmeSetupError) -> HTTPDestination<Transport, AcmeBatchEncoder> {","        guard !apiKey.isEmpty else { throw .emptyAPIKey }","        guard host.scheme == \"https\", host.host() != nil else { throw .invalidHost }","        return HTTPDestination(","            endpoint: host.appending(path: \"v1\/events\"),","            \/\/ Acme doesn't read a trace context, so the app's traces aren't sent to it.","            instrument: NoOpInstrument(),","            transport: transport,","            encoder: AcmeBatchEncoder(apiKey: apiKey, plan: plan),","            backoff: backoff)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Offer an overload without ","type":"text"},{"type":"codeVoice","code":"transport:"},{"text":" that passes ","type":"text"},{"type":"codeVoice","code":"URLSessionTransport()"},{"text":", as PostHog’s does, so","type":"text"},{"text":" ","type":"text"},{"text":"an app needn’t name one.","type":"text"}]},{"level":3,"anchor":"The-conformance-checks","type":"heading","text":"The conformance checks"},{"type":"paragraph","inlineContent":[{"code":"DestinationConformance","type":"codeVoice"},{"type":"text","text":" runs the checks every vendor destination must pass. Give it the vendor’s"},{"type":"text","text":" "},{"type":"text","text":"limit and a closure that calls the factory with the setup’s plan, transport and backoff:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","isActive":true,"type":"reference"},{"text":": no ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is sent","type":"text"},{"text":" ","type":"text"},{"text":"without the adopter’s opt-in.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds"},{"type":"text","text":": behind consent and "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"destination sends exactly the records it is handed."}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","isActive":true},{"text":": a record over the limit is","type":"text"},{"text":" ","type":"text"},{"text":"skipped and reported.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","isActive":true,"type":"reference"},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","isActive":true,"type":"reference"},{"type":"text","text":": failures are retried or dropped as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" classifies them, the encoder’s "},{"type":"codeVoice","code":"transientStatuses"},{"type":"text","text":" among the retried ones."}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/unreadableSuccessDelivered","type":"reference"},{"type":"text","text":": a 2xx whose body the"},{"type":"text","text":" "},{"type":"text","text":"encoder can’t read, an empty one included, counts as delivered: sent once, nothing reported."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld","isActive":true},{"text":": no request carries a trace context,","type":"text"},{"text":" ","type":"text"},{"text":"even while a tracer is active.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expectRequests(of:plan:matchFixture:withExtension:subdirectory:in:sourceLocation:)"},{"type":"text","text":" compares the"},{"type":"text","text":" "},{"type":"text","text":"requests a hand-worked batch makes with a fixture in the test target’s resources, byte for byte."},{"type":"text","text":" "},{"type":"text","text":"When the fixture is missing, the issue it records holds the requests, so you can check them by hand"},{"type":"text","text":" "},{"type":"text","text":"against the vendor’s documentation and save them as the fixture."}]},{"type":"codeListing","code":["@Test(arguments: ConformanceCheck.allCases)","func acmeConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/acme.example.com\"))","    let conformance = DestinationConformance(limit: AcmeBatchEncoder.batchLimit) { setup in","        try HTTPDestination.acme(apiKey: \"test-key\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for each rule the destination breaks. The kit is a"},{"type":"text","text":" "},{"type":"text","text":"shared assertion on purpose, so every vendor module runs the same checks. Every check’s records are"},{"type":"text","text":" "},{"type":"text","text":"tracked at "},{"type":"codeVoice","code":"setup.timestamp"},{"type":"text","text":"; if your encoder leaves out records older than the vendor takes, give"},{"type":"text","text":" "},{"type":"text","text":"it that as the time it encodes at, as "},{"type":"codeVoice","code":"GoogleAnalyticsEncoding"},{"type":"text","text":"’s tests do."}]}],"kind":"content"}],"metadata":{"roleHeading":"Article","title":"Writing a Vendor Destination","role":"article","modules":[{"name":"Traffluent"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/writingavendordestination"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"},"abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"generated":true,"title":"Guides"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"references":{"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/traceContextWithheld":{"kind":"symbol","abstract":[{"text":"No request carries a trace context in its header fields (","type":"text"},{"code":"traceparent","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tracestate","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"text":"whatever the instrument injects), even while a tracer is active and the record was tracked","type":"text"},{"text":" ","type":"text"},{"text":"in a span: a vendor’s destination passes ","type":"text"},{"code":"NoOpInstrument()","type":"codeVoice"},{"text":", so the app’s traces stay in","type":"text"},{"text":" ","type":"text"},{"text":"the app.","type":"text"}],"type":"topic","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"traceContextWithheld"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/tracecontextwithheld","title":"ConformanceCheck.traceContextWithheld"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"kind":"article","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","role":"article","title":"Defining Events","url":"\/documentation\/traffluent\/definingevents"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/oversizedRecordSkipped":{"kind":"symbol","abstract":[{"type":"text","text":"A record too large for the vendor’s limit is left out and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", and the batch’s other records are sent."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","type":"topic","role":"symbol","title":"ConformanceCheck.oversizedRecordSkipped","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oversizedRecordSkipped","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/oversizedrecordskipped"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"kind":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","role":"article","title":"Automatic Tracking","url":"\/documentation\/traffluent\/automatictracking"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/sensitiveValuesRedacted":{"kind":"symbol","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent by the default destination, even by a record that reveals"},{"type":"text","text":" "},{"type":"text","text":"it. With the adopter’s opt-in, it is sent while the record reveals it, and not once the"},{"type":"text","text":" "},{"type":"text","text":"record is redacted."}],"type":"topic","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"sensitiveValuesRedacted"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/sensitivevaluesredacted","title":"ConformanceCheck.sensitiveValuesRedacted"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/transientFailuresRetried":{"kind":"symbol","abstract":[{"type":"text","text":"A request that gets no response, a 5xx, 408, 429 or a status of the encoder’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"BatchEncoder.transientStatuses"},{"type":"text","text":" is sent again, byte for byte, until it is delivered, and"},{"type":"text","text":" "},{"type":"text","text":"nothing is reported."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","type":"topic","role":"symbol","title":"ConformanceCheck.transientFailuresRetried","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientFailuresRetried"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/transientfailuresretried"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/consentHolds":{"kind":"symbol","abstract":[{"text":"Behind a tracker’s ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":" and the destination’s ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":", the destination sends","type":"text"},{"text":" ","type":"text"},{"text":"the event of a granted category it accepts, and not the event of a denied category or of","type":"text"},{"text":" ","type":"text"},{"text":"one it doesn’t accept.","type":"text"}],"type":"topic","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"consentHolds","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/consentholds","title":"ConformanceCheck.consentHolds"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"kind":"article","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","role":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","title":"Sessions and Standard Context"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"kind":"article","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","type":"topic","role":"article","title":"Sampling Events","url":"\/documentation\/traffluent\/samplingevents"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/unreadableSuccessDelivered":{"kind":"symbol","abstract":[{"type":"text","text":"A request answered 2xx with a body no vendor writes, an empty one or one that isn’t JSON,"},{"type":"text","text":" "},{"type":"text","text":"is sent once and nothing is reported: the encoder’s "},{"type":"codeVoice","code":"BatchEncoder.outcome(of:for:)"},{"type":"text","text":" counts an"},{"type":"text","text":" "},{"type":"text","text":"answer it can’t read as delivered, so a vendor’s answer that changes shape never makes the"},{"type":"text","text":" "},{"type":"text","text":"destination send the same request again and again, or drop what the vendor stored."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/unreadableSuccessDelivered","type":"topic","role":"symbol","title":"ConformanceCheck.unreadableSuccessDelivered","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unreadableSuccessDelivered","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/unreadablesuccessdelivered"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"kind":"article","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"topic","role":"article","title":"Identifying People","url":"\/documentation\/traffluent\/identifyingpeople"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"kind":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","role":"article","url":"\/documentation\/traffluent\/consentgating","title":"Consent Gating"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"kind":"symbol","abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"topic","role":"collection","title":"PostHogEncoding","url":"\/documentation\/posthogencoding"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"kind":"article","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"url":"\/documentation\/traffluent\/persistingrecords","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","kind":"article","role":"article"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","url":"\/documentation\/traffluent","kind":"symbol","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"type":"topic","role":"collection","title":"Traffluent"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/rejectionsDropped":{"kind":"symbol","abstract":[{"type":"text","text":"A request answered with a status retrying won’t change (400, 401, 403, 404, 413, 422, less"},{"type":"text","text":" "},{"type":"text","text":"any the encoder lists in "},{"type":"codeVoice","code":"BatchEncoder.transientStatuses"},{"type":"text","text":") is sent once and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.rejected(status:recordIDs:)"},{"type":"text","text":". An encoder that lists all six is checked"},{"type":"text","text":" "},{"type":"text","text":"with the first client error (4xx) it doesn’t list; one that lists every client error"},{"type":"text","text":" "},{"type":"text","text":"records an issue, as no rejection is left to check."}],"type":"topic","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionsDropped","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/rejectionsdropped","title":"ConformanceCheck.rejectionsDropped"}}}