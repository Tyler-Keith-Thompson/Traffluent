{"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vendor destination is an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" with an encoder that writes the vendor’s ingestion"},{"type":"text","text":" "},{"type":"text","text":"format. "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" already does the batching, retries, drop reports and trace context, so the"},{"type":"text","text":" "},{"type":"text","text":"vendor module adds three things:"}]},{"items":[{"content":[{"inlineContent":[{"text":"an encoder, a ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" that writes each record as the vendor’s JSON and splits a batch to","type":"text"},{"text":" ","type":"text"},{"text":"the vendor’s limits;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a factory on "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" that checks what the adopter passes and fills in the endpoint, the"},{"type":"text","text":" "},{"type":"text","text":"encoder and the limits, so setup is one call;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"tests that run "},{"type":"codeVoice","code":"DestinationTesting"},{"type":"text","text":"’s conformance checks and compare its requests with recorded"},{"type":"text","text":" "},{"type":"text","text":"fixtures."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Write the encoder against the vendor’s public HTTP API, not its SDK, so the app links nothing of"},{"type":"text","text":" "},{"type":"text","text":"the vendor’s. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},{"type":"text","text":" is built this way and is a full example to copy."}]},{"level":3,"type":"heading","anchor":"The-module","text":"The module"},{"type":"paragraph","inlineContent":[{"text":"Make the module depend on ","type":"text"},{"type":"codeVoice","code":"HTTPDestinations"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PropertyJSON"},{"text":", ","type":"text"},{"type":"codeVoice","code":"JSONValues"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"TrackingPlans"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and on swift-distributed-tracing’s ","type":"text"},{"type":"codeVoice","code":"Instrumentation"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"NoOpInstrument"},{"text":". Its tests depend on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DestinationTesting"},{"text":" as well. ","type":"text"},{"type":"codeVoice","code":"PropertyJSON"},{"text":" holds the vendor-neutral pieces an encoder is built","type":"text"},{"text":" ","type":"text"},{"text":"from, ","type":"text"},{"type":"codeVoice","code":"JSONValues"},{"text":" the ","type":"text"},{"type":"codeVoice","code":"JSON"},{"text":" value it writes, and ","type":"text"},{"type":"codeVoice","code":"TrackingPlans"},{"text":" the app’s ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"the encoder reads properties through. ","type":"text"},{"type":"codeVoice","code":"DestinationTesting"},{"text":" imports Swift Testing, so it goes in","type":"text"},{"text":" ","type":"text"},{"text":"test targets only.","type":"text"}]},{"syntax":"swift","code":[".target(name: \"AcmeEncoding\", dependencies: [","    .product(name: \"HTTPDestinations\", package: \"Traffluent\"),","    .product(name: \"PropertyJSON\", package: \"Traffluent\"),","    .product(name: \"JSONValues\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","    .product(name: \"Instrumentation\", package: \"swift-distributed-tracing\"),","]),",".testTarget(name: \"AcmeEncodingTests\", dependencies: [","    \"AcmeEncoding\",","    .product(name: \"DestinationTesting\", package: \"Traffluent\"),","], resources: [.copy(\"Fixtures\")]),"],"type":"codeListing"},{"level":3,"type":"heading","anchor":"The-encoder","text":"The encoder"},{"type":"paragraph","inlineContent":[{"text":"The examples here are for Acme, a made-up vendor whose API takes","type":"text"},{"text":" ","type":"text"},{"code":"{\"api_key\": …, \"events\": [{\"event\", \"user_id\", \"insert_id\", \"time\", \"properties\", \"context\"}]}","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and allows at most 500 events and 1,000,000 bytes a request, and 32,000 bytes an event.","type":"text"},{"text":" ","type":"text"},{"code":"PropertyJSON","type":"codeVoice"},{"text":" supplies each piece of such a record:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"code":"PropertyReader","type":"codeVoice"},{"text":" reads an event’s properties through its schema in the app’s ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"leaving out ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" values unless you ask for them and the record reveals them.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"EventRecord.standardContext","type":"codeVoice"},{"text":" is the app, device, locale, network and operating system as JSON,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"flattened(separator:)","type":"codeVoice"},{"text":" turns it into the one level of dotted keys most vendors take.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Date.iso8601Timestamp"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Date.millisecondsSince1970()"},{"type":"text","text":" are the two timestamp formats vendors"},{"type":"text","text":" "},{"type":"text","text":"ask for."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"EventRecord.pseudonymousIdentity","type":"codeVoice"},{"type":"text","text":" is who the event is about: the record’s session, or the record"},{"type":"text","text":" "},{"type":"text","text":"itself when it has none, and never a person ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"},{"type":"text","text":"). "},{"code":"deduplicationID","type":"codeVoice"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"identifier a vendor drops repeats by, which a redelivered record keeps."}]}]},{"content":[{"inlineContent":[{"code":"BatchLimit.requests(for:in:encoding:oversized:)","type":"codeVoice"},{"text":" splits a batch into requests of a","type":"text"},{"text":" ","type":"text"},{"code":"JSONEnvelope","type":"codeVoice"},{"text":" within the vendor’s limits, and leaves out a record that fits in none of them.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","code":["\/\/\/ Why the Acme encoder left a record out.","enum AcmeEncodingError: Error, Hashable {","    case unreadable(PropertyReadingError)","    case contextKeyCollision(key: String)","    case unrepresentableTimestamp","    case oversized(byteCount: Int)","}","","struct AcmeBatchEncoder: BatchEncoder {","    \/\/\/ Acme's limits on one request.","    static let batchLimit = (try? BatchLimit(maximumRecordCount: 500, maximumByteCount: 1_000_000, maximumRecordByteCount: 32_000)) ?? .unlimited","","    typealias Failure = AcmeEncodingError","","    private let reader: PropertyReader","    private let envelope: JSONEnvelope","","    init(apiKey: String, plan: TrackingPlan) {","        reader = PropertyReader(plan: plan)","        envelope = JSONEnvelope([\"api_key\": .string(apiKey)], arrayMember: \"events\")","    }","","    func requests(for batch: [EventRecord]) -> BatchRequests<AcmeEncodingError> {","        Self.batchLimit.requests(for: batch, in: envelope) { record throws(AcmeEncodingError) in","            try json(of: record)","        } oversized: { byteCount in","            .oversized(byteCount: byteCount)","        }","    }","","    private func json(of record: EventRecord) throws(AcmeEncodingError) -> JSON {","        let properties: [String: JSON]","        do {","            properties = try reader.properties(of: record, includingSensitiveValues: false)","        } catch {","            throw .unreadable(error)","        }","        let context: [String: JSON]","        do {","            context = try record.standardContext.flattened()","        } catch {","            throw .contextKeyCollision(key: error.key)","        }","        let time: Int64","        do {","            time = try record.timestamp.millisecondsSince1970()","        } catch {","            throw .unrepresentableTimestamp","        }","        return .object([","            \"event\": .string(record.name),","            \"user_id\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","            \"insert_id\": .string(record.deduplicationID),","            \"time\": .integer(time),","            \"properties\": .object(properties),","            \"context\": .object(context),","        ])","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"requests(for:)"},{"type":"text","text":" is all a "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" implements, and "},{"type":"codeVoice","code":"Failure"},{"type":"text","text":" names the reason a record is"},{"type":"text","text":" "},{"type":"text","text":"left out, as "},{"type":"codeVoice","code":"requests(for:)"},{"type":"text","text":" doesn’t throw. "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends the requests in order, and"},{"type":"text","text":" "},{"type":"text","text":"reports each record left out as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":". Pass "},{"type":"codeVoice","code":"includingSensitiveValues: true"},{"type":"text","text":" only if the"},{"type":"text","text":" "},{"type":"text","text":"vendor’s terms allow the values, and then only through a factory the adopter opts in with."}]},{"level":3,"type":"heading","anchor":"The-factory","text":"The factory"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The factory is a static method on "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" constrained to the encoder, so adopters write"},{"type":"text","text":" "},{"type":"codeVoice","code":"try HTTPDestination.acme(...)"},{"type":"text","text":". It throws a typed error for input the vendor would refuse, so a"},{"type":"text","text":" "},{"type":"text","text":"mistake shows up at launch, not later as a stream of rejected requests. It also takes a transport"},{"type":"text","text":" "},{"type":"text","text":"and a backoff, which the conformance checks need. It passes "},{"type":"codeVoice","code":"NoOpInstrument()"},{"type":"text","text":", so no request"},{"type":"text","text":" "},{"type":"text","text":"carries the app’s trace context to the vendor, whatever tracer the app bootstraps."}]},{"syntax":"swift","code":["\/\/\/ Why the Acme factory couldn't make a destination.","enum AcmeSetupError: Error, Hashable {","    case emptyAPIKey","    case invalidHost","}","","extension HTTPDestination where Encoding == AcmeBatchEncoder {","    static func acme(","        apiKey: String,","        host: URL,","        plan: TrackingPlan,","        transport: Transport,","        backoff: ExponentialBackoff = ExponentialBackoff()","    ) throws(AcmeSetupError) -> HTTPDestination<Transport, AcmeBatchEncoder> {","        guard !apiKey.isEmpty else { throw .emptyAPIKey }","        guard host.scheme == \"https\", host.host() != nil else { throw .invalidHost }","        return HTTPDestination(","            endpoint: host.appending(path: \"v1\/events\"),","            \/\/ Acme doesn't read a trace context, so the app's traces aren't sent to it.","            instrument: NoOpInstrument(),","            transport: transport,","            encoder: AcmeBatchEncoder(apiKey: apiKey, plan: plan),","            backoff: backoff)","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Offer an overload without "},{"type":"codeVoice","code":"transport:"},{"type":"text","text":" that passes "},{"type":"codeVoice","code":"URLSessionTransport()"},{"type":"text","text":", as PostHog’s does, so"},{"type":"text","text":" "},{"type":"text","text":"an app needn’t name one."}]},{"level":3,"type":"heading","anchor":"The-conformance-checks","text":"The conformance checks"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DestinationConformance"},{"type":"text","text":" runs the checks every vendor destination must pass. Give it the vendor’s"},{"type":"text","text":" "},{"type":"text","text":"limit and a closure that calls the factory with the setup’s plan, transport and backoff:"}]},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","type":"reference"},{"text":": no ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value is sent","type":"text"},{"text":" ","type":"text"},{"text":"without the adopter’s opt-in.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","type":"reference","isActive":true},{"type":"text","text":": behind consent and "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"destination sends exactly the records it is handed."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","isActive":true,"type":"reference"},{"text":": a record over the limit is","type":"text"},{"text":" ","type":"text"},{"text":"skipped and reported.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped"},{"text":": failures are retried or dropped as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" classifies them.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld"},{"type":"text","text":": no request carries a trace context,"},{"type":"text","text":" "},{"type":"text","text":"even while a tracer is active."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expectRequests(of:plan:matchFixture:withExtension:subdirectory:in:sourceLocation:)"},{"text":" compares the","type":"text"},{"text":" ","type":"text"},{"text":"requests a hand-worked batch makes with a fixture in the test target’s resources, byte for byte.","type":"text"},{"text":" ","type":"text"},{"text":"When the fixture is missing, the issue it records holds the requests, so you can check them by hand","type":"text"},{"text":" ","type":"text"},{"text":"against the vendor’s documentation and save them as the fixture.","type":"text"}]},{"syntax":"swift","code":["@Test(arguments: ConformanceCheck.allCases)","func acmeConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/acme.example.com\"))","    let conformance = DestinationConformance(limit: AcmeBatchEncoder.batchLimit) { setup in","        try HTTPDestination.acme(apiKey: \"test-key\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Each check records a Swift Testing issue for each rule the destination breaks. The kit is a","type":"text"},{"text":" ","type":"text"},{"text":"shared assertion on purpose, so every vendor module runs the same checks. Every check’s records are","type":"text"},{"text":" ","type":"text"},{"text":"tracked at ","type":"text"},{"type":"codeVoice","code":"setup.timestamp"},{"text":"; if your encoder leaves out records older than the vendor takes, give","type":"text"},{"text":" ","type":"text"},{"text":"it that as the time it encodes at, as ","type":"text"},{"type":"codeVoice","code":"GoogleAnalyticsEncoding"},{"text":"’s tests do.","type":"text"}]}],"kind":"content"}],"kind":"article","variants":[{"paths":["\/documentation\/traffluent\/writingavendordestination"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"title":"Writing a Vendor Destination","role":"article","roleHeading":"Article","modules":[{"name":"Traffluent"}]},"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"seeAlsoSections":[{"generated":true,"title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"anchor":"Guides"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"references":{"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/oversizedRecordSkipped":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oversizedRecordSkipped","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/oversizedrecordskipped","abstract":[{"text":"A record too large for the vendor’s limit is left out and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", and the batch’s other records are sent.","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","title":"ConformanceCheck.oversizedRecordSkipped","type":"topic"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","kind":"symbol","type":"topic","url":"\/documentation\/posthogencoding","role":"collection","title":"PostHogEncoding"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"url":"\/documentation\/traffluent\/trackingplanworkflow","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"role":"article","title":"Exporting and Checking a Tracking Plan","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","kind":"article","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/transientFailuresRetried":{"kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientFailuresRetried"}],"role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/transientfailuresretried","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","type":"topic","abstract":[{"type":"text","text":"A request that gets no response, a 5xx, 408 or 429 is sent again, byte for byte, until it is"},{"type":"text","text":" "},{"type":"text","text":"delivered, and nothing is reported."}],"title":"ConformanceCheck.transientFailuresRetried"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/sensitiveValuesRedacted":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sensitiveValuesRedacted","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/sensitivevaluesredacted","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent by the default destination, even by a record that reveals"},{"type":"text","text":" "},{"type":"text","text":"it. With the adopter’s opt-in, it is sent while the record reveals it, and not once the"},{"type":"text","text":" "},{"type":"text","text":"record is redacted."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","title":"ConformanceCheck.sensitiveValuesRedacted","type":"topic"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"url":"\/documentation\/traffluent\/sessionsandstandardcontext","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"role":"article","kind":"article","title":"Sessions and Standard Context","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","type":"topic"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"url":"\/documentation\/traffluent\/definingevents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"role":"article","title":"Defining Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","kind":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","kind":"article","type":"topic","url":"\/documentation\/traffluent\/identifyingpeople","role":"article","title":"Identifying People"},"doc://Traffluent/documentation/Traffluent":{"abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","kind":"symbol","type":"topic","url":"\/documentation\/traffluent","role":"collection","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"role":"article","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","title":"Persisting Records","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/traceContextWithheld":{"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"traceContextWithheld","kind":"identifier"}],"role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/tracecontextwithheld","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld","type":"topic","abstract":[{"text":"No request carries a trace context in its header fields (","type":"text"},{"code":"traceparent","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tracestate","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"text":"whatever the instrument injects), even while a tracer is active and the record was tracked","type":"text"},{"text":" ","type":"text"},{"text":"in a span: a vendor’s destination passes ","type":"text"},{"code":"NoOpInstrument()","type":"codeVoice"},{"text":", so the app’s traces stay in","type":"text"},{"text":" ","type":"text"},{"text":"the app.","type":"text"}],"title":"ConformanceCheck.traceContextWithheld"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","kind":"article","type":"topic","url":"\/documentation\/traffluent\/samplingevents","role":"article","title":"Sampling Events"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","kind":"article","type":"topic","url":"\/documentation\/traffluent\/automatictracking","role":"article","title":"Automatic Tracking"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/rejectionsDropped":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionsDropped"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/rejectionsdropped","abstract":[{"type":"text","text":"A request answered with a status retrying won’t change (400, 401, 403, 404, 413, 422) is"},{"type":"text","text":" "},{"type":"text","text":"sent once and reported as "},{"type":"codeVoice","code":"HTTPDropReport.rejected(status:recordIDs:)"},{"type":"text","text":"."}],"role":"symbol","title":"ConformanceCheck.rejectionsDropped","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/consentHolds":{"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"consentHolds","kind":"identifier"}],"role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/consentholds","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","abstract":[{"type":"text","text":"Behind a tracker’s "},{"code":"Consent","type":"codeVoice"},{"type":"text","text":" and the destination’s "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":", the destination sends"},{"type":"text","text":" "},{"type":"text","text":"the event of a granted category it accepts, and not the event of a denied category or of"},{"type":"text","text":" "},{"type":"text","text":"one it doesn’t accept."}],"type":"topic","title":"ConformanceCheck.consentHolds"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"url":"\/documentation\/traffluent\/consentgating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"role":"article","title":"Consent Gating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","kind":"article","type":"topic"}}}