{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A vendor destination is an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" with an encoder that writes the vendor’s ingestion"},{"type":"text","text":" "},{"type":"text","text":"format. "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" already does the batching, retries, drop reports and trace context, so the"},{"type":"text","text":" "},{"type":"text","text":"vendor module adds three things:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"an encoder, a ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" that writes each record as the vendor’s JSON and splits a batch to","type":"text"},{"text":" ","type":"text"},{"text":"the vendor’s limits;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a factory on "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" that checks what the adopter passes and fills in the endpoint, the"},{"type":"text","text":" "},{"type":"text","text":"encoder and the limits, so setup is one call;"}]}]},{"content":[{"inlineContent":[{"text":"tests that run ","type":"text"},{"code":"DestinationTesting","type":"codeVoice"},{"text":"’s conformance checks and compare its requests with recorded","type":"text"},{"text":" ","type":"text"},{"text":"fixtures.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Write the encoder against the vendor’s public HTTP API, not its SDK, so the app links nothing of"},{"type":"text","text":" "},{"type":"text","text":"the vendor’s. "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","isActive":true},{"type":"text","text":" is built this way and is a full example to copy."}],"type":"paragraph"},{"level":3,"anchor":"The-module","type":"heading","text":"The module"},{"inlineContent":[{"type":"text","text":"Make the module depend on "},{"type":"codeVoice","code":"HTTPDestinations"},{"type":"text","text":", "},{"type":"codeVoice","code":"PropertyJSON"},{"type":"text","text":", "},{"type":"codeVoice","code":"JSONValues"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and on swift-distributed-tracing’s "},{"type":"codeVoice","code":"Instrumentation"},{"type":"text","text":" for "},{"type":"codeVoice","code":"NoOpInstrument"},{"type":"text","text":". Its tests depend on"},{"type":"text","text":" "},{"type":"codeVoice","code":"DestinationTesting"},{"type":"text","text":" as well. "},{"type":"codeVoice","code":"PropertyJSON"},{"type":"text","text":" holds the vendor-neutral pieces an encoder is built"},{"type":"text","text":" "},{"type":"text","text":"from, "},{"type":"codeVoice","code":"JSONValues"},{"type":"text","text":" the "},{"type":"codeVoice","code":"JSON"},{"type":"text","text":" value it writes, and "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":" the app’s "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"the encoder reads properties through. "},{"type":"codeVoice","code":"DestinationTesting"},{"type":"text","text":" imports Swift Testing, so it goes in"},{"type":"text","text":" "},{"type":"text","text":"test targets only."}],"type":"paragraph"},{"code":[".target(name: \"AcmeEncoding\", dependencies: [","    .product(name: \"HTTPDestinations\", package: \"Traffluent\"),","    .product(name: \"PropertyJSON\", package: \"Traffluent\"),","    .product(name: \"JSONValues\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","    .product(name: \"Instrumentation\", package: \"swift-distributed-tracing\"),","]),",".testTarget(name: \"AcmeEncodingTests\", dependencies: [","    \"AcmeEncoding\",","    .product(name: \"DestinationTesting\", package: \"Traffluent\"),","], resources: [.copy(\"Fixtures\")]),"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"The-encoder","type":"heading","text":"The encoder"},{"inlineContent":[{"type":"text","text":"The examples here are for Acme, a made-up vendor whose API takes"},{"type":"text","text":" "},{"type":"codeVoice","code":"{\"api_key\": …, \"events\": [{\"event\", \"user_id\", \"insert_id\", \"time\", \"properties\", \"context\"}]}"},{"type":"text","text":" "},{"type":"text","text":"and allows at most 500 events and 1,000,000 bytes a request, and 32,000 bytes an event."},{"type":"text","text":" "},{"type":"codeVoice","code":"PropertyJSON"},{"type":"text","text":" supplies each piece of such a record:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"PropertyReader","type":"codeVoice"},{"text":" reads an event’s properties through its schema in the app’s ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"leaving out ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" values unless you ask for them and the record reveals them.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"EventRecord.standardContext","type":"codeVoice"},{"type":"text","text":" is the app, device, locale, network and operating system as JSON,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"flattened(separator:)","type":"codeVoice"},{"type":"text","text":" turns it into the one level of dotted keys most vendors take."}]}]},{"content":[{"inlineContent":[{"code":"Date.iso8601Timestamp","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Date.millisecondsSince1970()","type":"codeVoice"},{"type":"text","text":" are the two timestamp formats vendors"},{"type":"text","text":" "},{"type":"text","text":"ask for."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"EventRecord.pseudonymousIdentity","type":"codeVoice"},{"text":" is who the event is about: the record’s session, or the record","type":"text"},{"text":" ","type":"text"},{"text":"itself when it has none, and never a person (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"},{"text":"). ","type":"text"},{"code":"deduplicationID","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"identifier a vendor drops repeats by, which a redelivered record keeps.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BatchLimit.requests(for:in:encoding:oversized:)"},{"text":" splits a batch into requests of a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"JSONEnvelope"},{"text":" within the vendor’s limits, and leaves out a record that fits in none of them.","type":"text"}]}]}],"type":"unorderedList"},{"code":["\/\/\/ Why the Acme encoder left a record out.","enum AcmeEncodingError: Error, Hashable {","    case unreadable(PropertyReadingError)","    case contextKeyCollision(key: String)","    case unrepresentableTimestamp","    case oversized(byteCount: Int)","}","","struct AcmeBatchEncoder: BatchEncoder {","    \/\/\/ Acme's limits on one request.","    static let batchLimit = (try? BatchLimit(maximumRecordCount: 500, maximumByteCount: 1_000_000, maximumRecordByteCount: 32_000)) ?? .unlimited","","    typealias Failure = AcmeEncodingError","","    private let reader: PropertyReader","    private let envelope: JSONEnvelope","","    init(apiKey: String, plan: TrackingPlan) {","        reader = PropertyReader(plan: plan)","        envelope = JSONEnvelope([\"api_key\": .string(apiKey)], arrayMember: \"events\")","    }","","    func requests(for batch: [EventRecord]) -> BatchRequests<AcmeEncodingError> {","        Self.batchLimit.requests(for: batch, in: envelope) { record throws(AcmeEncodingError) in","            try json(of: record)","        } oversized: { byteCount in","            .oversized(byteCount: byteCount)","        }","    }","","    private func json(of record: EventRecord) throws(AcmeEncodingError) -> JSON {","        let properties: [String: JSON]","        do {","            properties = try reader.properties(of: record, includingSensitiveValues: false)","        } catch {","            throw .unreadable(error)","        }","        let context: [String: JSON]","        do {","            context = try record.standardContext.flattened()","        } catch {","            throw .contextKeyCollision(key: error.key)","        }","        let time: Int64","        do {","            time = try record.timestamp.millisecondsSince1970()","        } catch {","            throw .unrepresentableTimestamp","        }","        return .object([","            \"event\": .string(record.name),","            \"user_id\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","            \"insert_id\": .string(record.deduplicationID),","            \"time\": .integer(time),","            \"properties\": .object(properties),","            \"context\": .object(context),","        ])","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"requests(for:)"},{"type":"text","text":" is all a "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" implements, and "},{"type":"codeVoice","code":"Failure"},{"type":"text","text":" names the reason a record is"},{"type":"text","text":" "},{"type":"text","text":"left out, as "},{"type":"codeVoice","code":"requests(for:)"},{"type":"text","text":" doesn’t throw. "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends the requests in order, and"},{"type":"text","text":" "},{"type":"text","text":"reports each record left out as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":". Pass "},{"type":"codeVoice","code":"includingSensitiveValues: true"},{"type":"text","text":" only if the"},{"type":"text","text":" "},{"type":"text","text":"vendor’s terms allow the values, and then only through a factory the adopter opts in with."}],"type":"paragraph"},{"level":3,"anchor":"The-factory","type":"heading","text":"The factory"},{"inlineContent":[{"text":"The factory is a static method on ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" constrained to the encoder, so adopters write","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"try HTTPDestination.acme(...)"},{"text":". It throws a typed error for input the vendor would refuse, so a","type":"text"},{"text":" ","type":"text"},{"text":"mistake shows up at launch, not later as a stream of rejected requests. It also takes a transport","type":"text"},{"text":" ","type":"text"},{"text":"and a backoff, which the conformance checks need. It passes ","type":"text"},{"type":"codeVoice","code":"NoOpInstrument()"},{"text":", so no request","type":"text"},{"text":" ","type":"text"},{"text":"carries the app’s trace context to the vendor, whatever tracer the app bootstraps.","type":"text"}],"type":"paragraph"},{"code":["\/\/\/ Why the Acme factory couldn't make a destination.","enum AcmeSetupError: Error, Hashable {","    case emptyAPIKey","    case invalidHost","}","","extension HTTPDestination where Encoding == AcmeBatchEncoder {","    static func acme(","        apiKey: String,","        host: URL,","        plan: TrackingPlan,","        transport: Transport,","        backoff: ExponentialBackoff = ExponentialBackoff()","    ) throws(AcmeSetupError) -> HTTPDestination<Transport, AcmeBatchEncoder> {","        guard !apiKey.isEmpty else { throw .emptyAPIKey }","        guard host.scheme == \"https\", host.host() != nil else { throw .invalidHost }","        return HTTPDestination(","            endpoint: host.appending(path: \"v1\/events\"),","            \/\/ Acme doesn't read a trace context, so the app's traces aren't sent to it.","            instrument: NoOpInstrument(),","            transport: transport,","            encoder: AcmeBatchEncoder(apiKey: apiKey, plan: plan),","            backoff: backoff)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Offer an overload without ","type":"text"},{"code":"transport:","type":"codeVoice"},{"text":" that passes ","type":"text"},{"code":"URLSessionTransport()","type":"codeVoice"},{"text":", as PostHog’s does, so","type":"text"},{"text":" ","type":"text"},{"text":"an app needn’t name one.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"The-conformance-checks","type":"heading","text":"The conformance checks"},{"inlineContent":[{"type":"codeVoice","code":"DestinationConformance"},{"type":"text","text":" runs the checks every vendor destination must pass. Give it the vendor’s"},{"type":"text","text":" "},{"type":"text","text":"limit and a closure that calls the factory with the setup’s plan, transport and backoff:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","isActive":true,"type":"reference"},{"text":": no ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is sent","type":"text"},{"text":" ","type":"text"},{"text":"without the adopter’s opt-in.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds"},{"type":"text","text":": behind consent and "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"destination sends exactly the records it is handed."}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","type":"reference"},{"type":"text","text":": a record over the limit is"},{"type":"text","text":" "},{"type":"text","text":"skipped and reported."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","type":"reference","isActive":true},{"text":": failures are retried or dropped as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" classifies them.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld"},{"type":"text","text":": no request carries a trace context,"},{"type":"text","text":" "},{"type":"text","text":"even while a tracer is active."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"code":"expectRequests(of:plan:matchFixture:withExtension:subdirectory:in:sourceLocation:)","type":"codeVoice"},{"type":"text","text":" compares the"},{"type":"text","text":" "},{"type":"text","text":"requests a hand-worked batch makes with a fixture in the test target’s resources, byte for byte."},{"type":"text","text":" "},{"type":"text","text":"When the fixture is missing, the issue it records holds the requests, so you can check them by hand"},{"type":"text","text":" "},{"type":"text","text":"against the vendor’s documentation and save them as the fixture."}],"type":"paragraph"},{"code":["@Test(arguments: ConformanceCheck.allCases)","func acmeConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/acme.example.com\"))","    let conformance = DestinationConformance(limit: AcmeBatchEncoder.batchLimit) { setup in","        try HTTPDestination.acme(apiKey: \"test-key\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for each rule the destination breaks. The kit is a"},{"type":"text","text":" "},{"type":"text","text":"shared assertion on purpose, so every vendor module runs the same checks."}],"type":"paragraph"}]}],"abstract":[{"text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"metadata":{"role":"article","modules":[{"name":"Traffluent"}],"roleHeading":"Article","title":"Writing a Vendor Destination"},"variants":[{"paths":["\/documentation\/traffluent\/writingavendordestination"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"title":"Guides","anchor":"Guides"}],"references":{"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","title":"Sampling Events","kind":"article","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"url":"\/documentation\/traffluent\/samplingevents","role":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","title":"Automatic Tracking","kind":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"url":"\/documentation\/traffluent\/automatictracking","role":"article","type":"topic"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"title":"PostHogEncoding","kind":"symbol","type":"topic","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","url":"\/documentation\/posthogencoding","role":"collection","abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}]},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","kind":"symbol","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent","role":"collection","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/traceContextWithheld":{"title":"ConformanceCheck.traceContextWithheld","type":"topic","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld","url":"\/documentation\/destinationtesting\/conformancecheck\/tracecontextwithheld","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"traceContextWithheld","kind":"identifier"}],"abstract":[{"type":"text","text":"No request carries a trace context in its header fields ("},{"type":"codeVoice","code":"traceparent"},{"type":"text","text":", "},{"type":"codeVoice","code":"tracestate"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"text","text":"whatever the instrument injects), even while a tracer is active and the record was tracked"},{"type":"text","text":" "},{"type":"text","text":"in a span: a vendor’s destination passes "},{"type":"codeVoice","code":"NoOpInstrument()"},{"type":"text","text":", so the app’s traces stay in"},{"type":"text","text":" "},{"type":"text","text":"the app."}]},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","title":"Defining Events","kind":"article","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"url":"\/documentation\/traffluent\/definingevents","role":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","url":"\/documentation\/traffluent\/trackingplanworkflow","role":"article","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}]},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/rejectionsDropped":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","title":"ConformanceCheck.rejectionsDropped","kind":"symbol","abstract":[{"type":"text","text":"A request answered with a status retrying won’t change (400, 401, 403, 404, 413, 422) is"},{"type":"text","text":" "},{"type":"text","text":"sent once and reported as "},{"type":"codeVoice","code":"HTTPDropReport.rejected(status:recordIDs:)"},{"type":"text","text":"."}],"url":"\/documentation\/destinationtesting\/conformancecheck\/rejectionsdropped","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionsDropped","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/transientFailuresRetried":{"title":"ConformanceCheck.transientFailuresRetried","type":"topic","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","url":"\/documentation\/destinationtesting\/conformancecheck\/transientfailuresretried","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientFailuresRetried","kind":"identifier"}],"abstract":[{"type":"text","text":"A request that gets no response, a 5xx, 408 or 429 is sent again, byte for byte, until it is"},{"type":"text","text":" "},{"type":"text","text":"delivered, and nothing is reported."}]},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","title":"Identifying People","kind":"article","abstract":[{"text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent.","type":"text"}],"url":"\/documentation\/traffluent\/identifyingpeople","role":"article","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/sensitiveValuesRedacted":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","title":"ConformanceCheck.sensitiveValuesRedacted","kind":"symbol","abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value is never sent by the default destination, even by a record that reveals","type":"text"},{"text":" ","type":"text"},{"text":"it. With the adopter’s opt-in, it is sent while the record reveals it, and not once the","type":"text"},{"text":" ","type":"text"},{"text":"record is redacted.","type":"text"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/sensitivevaluesredacted","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"sensitiveValuesRedacted"}],"role":"symbol","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/consentHolds":{"title":"ConformanceCheck.consentHolds","kind":"symbol","type":"topic","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","url":"\/documentation\/destinationtesting\/conformancecheck\/consentholds","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"consentHolds"}],"abstract":[{"text":"Behind a tracker’s ","type":"text"},{"type":"codeVoice","code":"Consent"},{"text":" and the destination’s ","type":"text"},{"type":"codeVoice","code":"accepting(_:)"},{"text":", the destination sends","type":"text"},{"text":" ","type":"text"},{"text":"the event of a granted category it accepts, and not the event of a denied category or of","type":"text"},{"text":" ","type":"text"},{"text":"one it doesn’t accept.","type":"text"}]},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","url":"\/documentation\/traffluent\/consentgating","role":"article","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}]},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","title":"Sessions and Standard Context","kind":"article","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"url":"\/documentation\/traffluent\/sessionsandstandardcontext","role":"article","type":"topic"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","type":"topic","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","url":"\/documentation\/traffluent\/persistingrecords","role":"article","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}]},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/oversizedRecordSkipped":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","title":"ConformanceCheck.oversizedRecordSkipped","kind":"symbol","abstract":[{"type":"text","text":"A record too large for the vendor’s limit is left out and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", and the batch’s other records are sent."}],"url":"\/documentation\/destinationtesting\/conformancecheck\/oversizedrecordskipped","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"oversizedRecordSkipped"}],"role":"symbol","type":"topic"}}}