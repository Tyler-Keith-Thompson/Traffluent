{"metadata":{"modules":[{"name":"Traffluent"}],"title":"Writing a Vendor Destination","roleHeading":"Article","role":"article"},"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"title":"Guides","generated":true,"anchor":"Guides"}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vendor destination is an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" with an encoder that writes the vendor’s ingestion"},{"type":"text","text":" "},{"type":"text","text":"format. "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" already does the batching, retries, drop reports and trace context, so the"},{"type":"text","text":" "},{"type":"text","text":"vendor module adds three things:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"an encoder, a ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" that writes each record as the vendor’s JSON and splits a batch to","type":"text"},{"text":" ","type":"text"},{"text":"the vendor’s limits;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a factory on ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" that checks what the adopter passes and fills in the endpoint, the","type":"text"},{"text":" ","type":"text"},{"text":"encoder and the limits, so setup is one call;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"tests that run ","type":"text"},{"type":"codeVoice","code":"DestinationTesting"},{"text":"’s conformance checks and compare its requests with recorded","type":"text"},{"text":" ","type":"text"},{"text":"fixtures.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Write the encoder against the vendor’s public HTTP API, not its SDK, so the app links nothing of","type":"text"},{"text":" ","type":"text"},{"text":"the vendor’s. ","type":"text"},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","isActive":true},{"text":" is built this way and is a full example to copy.","type":"text"}]},{"anchor":"The-module","level":3,"type":"heading","text":"The module"},{"type":"paragraph","inlineContent":[{"text":"Make the module depend on ","type":"text"},{"code":"HTTPDestinations","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PropertyJSON","type":"codeVoice"},{"text":", ","type":"text"},{"code":"JSONValues","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"TrackingPlans","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and on swift-distributed-tracing’s ","type":"text"},{"code":"Instrumentation","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"NoOpInstrument","type":"codeVoice"},{"text":". Its tests depend on","type":"text"},{"text":" ","type":"text"},{"code":"DestinationTesting","type":"codeVoice"},{"text":" as well. ","type":"text"},{"code":"PropertyJSON","type":"codeVoice"},{"text":" holds the vendor-neutral pieces an encoder is built","type":"text"},{"text":" ","type":"text"},{"text":"from, ","type":"text"},{"code":"JSONValues","type":"codeVoice"},{"text":" the ","type":"text"},{"code":"JSON","type":"codeVoice"},{"text":" value it writes, and ","type":"text"},{"code":"TrackingPlans","type":"codeVoice"},{"text":" the app’s ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"the encoder reads properties through. ","type":"text"},{"code":"DestinationTesting","type":"codeVoice"},{"text":" imports Swift Testing, so it goes in","type":"text"},{"text":" ","type":"text"},{"text":"test targets only.","type":"text"}]},{"code":[".target(name: \"AcmeEncoding\", dependencies: [","    .product(name: \"HTTPDestinations\", package: \"Traffluent\"),","    .product(name: \"PropertyJSON\", package: \"Traffluent\"),","    .product(name: \"JSONValues\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","    .product(name: \"Instrumentation\", package: \"swift-distributed-tracing\"),","]),",".testTarget(name: \"AcmeEncodingTests\", dependencies: [","    \"AcmeEncoding\",","    .product(name: \"DestinationTesting\", package: \"Traffluent\"),","], resources: [.copy(\"Fixtures\")]),"],"type":"codeListing","syntax":"swift"},{"anchor":"The-encoder","level":3,"type":"heading","text":"The encoder"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The examples here are for Acme, a made-up vendor whose API takes"},{"type":"text","text":" "},{"code":"{\"api_key\": …, \"events\": [{\"event\", \"user_id\", \"insert_id\", \"time\", \"properties\", \"context\"}]}","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and allows at most 500 events and 1,000,000 bytes a request, and 32,000 bytes an event."},{"type":"text","text":" "},{"code":"PropertyJSON","type":"codeVoice"},{"type":"text","text":" supplies each piece of such a record:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads an event’s properties through its schema in the app’s "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"leaving out "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values unless you ask for them and the record reveals them."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EventRecord.standardContext"},{"text":" is the app, device, locale, network and operating system as JSON,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"flattened(separator:)"},{"text":" turns it into the one level of dotted keys most vendors take.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"Date.iso8601Timestamp","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Date.millisecondsSince1970()","type":"codeVoice"},{"type":"text","text":" are the two timestamp formats vendors"},{"type":"text","text":" "},{"type":"text","text":"ask for."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"EventRecord.pseudonymousIdentity","type":"codeVoice"},{"type":"text","text":" is who the event is about: the record’s session, or the record"},{"type":"text","text":" "},{"type":"text","text":"itself when it has none, and never a person ("},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"reference","isActive":true},{"type":"text","text":"). "},{"code":"deduplicationID","type":"codeVoice"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"identifier a vendor drops repeats by, which a redelivered record keeps."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"BatchLimit.requests(for:in:encoding:oversized:)","type":"codeVoice"},{"type":"text","text":" splits a batch into requests of a"},{"type":"text","text":" "},{"code":"JSONEnvelope","type":"codeVoice"},{"type":"text","text":" within the vendor’s limits, and leaves out a record that fits in none of them."}],"type":"paragraph"}]}]},{"code":["\/\/\/ Why the Acme encoder left a record out.","enum AcmeEncodingError: Error, Hashable {","    case unreadable(PropertyReadingError)","    case contextKeyCollision(key: String)","    case unrepresentableTimestamp","    case oversized(byteCount: Int)","}","","struct AcmeBatchEncoder: BatchEncoder {","    \/\/\/ Acme's limits on one request.","    static let batchLimit = (try? BatchLimit(maximumRecordCount: 500, maximumByteCount: 1_000_000, maximumRecordByteCount: 32_000)) ?? .unlimited","","    typealias Failure = AcmeEncodingError","","    private let reader: PropertyReader","    private let envelope: JSONEnvelope","","    init(apiKey: String, plan: TrackingPlan) {","        reader = PropertyReader(plan: plan)","        envelope = JSONEnvelope([\"api_key\": .string(apiKey)], arrayMember: \"events\")","    }","","    func requests(for batch: [EventRecord]) -> BatchRequests<AcmeEncodingError> {","        Self.batchLimit.requests(for: batch, in: envelope) { record throws(AcmeEncodingError) in","            try json(of: record)","        } oversized: { byteCount in","            .oversized(byteCount: byteCount)","        }","    }","","    private func json(of record: EventRecord) throws(AcmeEncodingError) -> JSON {","        let properties: [String: JSON]","        do {","            properties = try reader.properties(of: record, includingSensitiveValues: false)","        } catch {","            throw .unreadable(error)","        }","        let context: [String: JSON]","        do {","            context = try record.standardContext.flattened()","        } catch {","            throw .contextKeyCollision(key: error.key)","        }","        let time: Int64","        do {","            time = try record.timestamp.millisecondsSince1970()","        } catch {","            throw .unrepresentableTimestamp","        }","        return .object([","            \"event\": .string(record.name),","            \"user_id\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","            \"insert_id\": .string(record.deduplicationID),","            \"time\": .integer(time),","            \"properties\": .object(properties),","            \"context\": .object(context),","        ])","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" implements "},{"type":"codeVoice","code":"requests(for:)"},{"type":"text","text":" and declares "},{"type":"codeVoice","code":"transientStatuses"},{"type":"text","text":" (below), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Failure"},{"type":"text","text":" names the reason a record is left out, as "},{"type":"codeVoice","code":"requests(for:)"},{"type":"text","text":" doesn’t throw. "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends the requests in order, and"},{"type":"text","text":" "},{"type":"text","text":"reports each record left out as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":". Pass "},{"type":"codeVoice","code":"includingSensitiveValues: true"},{"type":"text","text":" only if the"},{"type":"text","text":" "},{"type":"text","text":"vendor’s terms allow the values, and then only through a factory the adopter opts in with."}]},{"type":"paragraph","inlineContent":[{"text":"If the vendor misdates or ignores an event past some age but still answers 2xx, pass an age a","type":"text"},{"text":" ","type":"text"},{"text":"little short of it to ","type":"text"},{"type":"codeVoice","code":"limit.requests(for:in:maximumAge:encoding:oversized:)"},{"text":", which throws","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NegativeMaximumAge"},{"text":" for one below zero. The spare time covers a request’s trip to the vendor and","type":"text"},{"text":" ","type":"text"},{"text":"clocks that disagree. Each request then has a deadline that long after its oldest record was","type":"text"},{"text":" ","type":"text"},{"text":"tracked, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" drops a request still being retried by then, all of its records, and","type":"text"},{"text":" ","type":"text"},{"text":"reports it as ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"text":", rather than send records the","type":"text"},{"text":" ","type":"text"},{"text":"vendor would store wrongly. Have the factory pass its ","type":"text"},{"type":"codeVoice","code":"now:"},{"text":" to both the encoder and the","type":"text"},{"text":" ","type":"text"},{"text":"destination, so one clock decides what is encoded and what is sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries no response, a 5xx, 408 and 429, and drops a request answered with any","type":"text"},{"text":" ","type":"text"},{"text":"other status. Every encoder declares ","type":"text"},{"code":"transientStatuses","type":"codeVoice"},{"text":", as there is no default: ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"vendor answers only those to a request worth sending again. If it answers some other failure for","type":"text"},{"text":" ","type":"text"},{"text":"one, list that status, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries it too. A ","type":"text"},{"code":"TransientStatus","type":"codeVoice"},{"text":" is a client or server error (4xx or 5xx); any other status throws","type":"text"},{"text":" ","type":"text"},{"code":"InvalidTransientStatus","type":"codeVoice"},{"text":", as a 2xx is always delivered:","type":"text"}]},{"code":["extension AcmeBatchEncoder {","    \/\/\/ Acme answers 425 Too Early while a new region starts up, and takes the request later.","    static let transientStatuses: Set<TransientStatus> = (try? TransientStatus(425)).map { [$0] } ?? []","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The set belongs to the encoder’s type, so every destination made with that encoder retries those","type":"text"},{"text":" ","type":"text"},{"text":"statuses, whether it comes from the factory or not. The conformance checks read it too. An encoder","type":"text"},{"text":" ","type":"text"},{"text":"that wraps another, to filter or rename records, forwards the inner encoder’s set","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"static var transientStatuses: Set<TransientStatus> { Inner.transientStatuses }","type":"codeVoice"},{"text":"), or the","type":"text"},{"text":" ","type":"text"},{"text":"vendor’s retries are lost.","type":"text"}]},{"anchor":"The-factory","level":3,"type":"heading","text":"The factory"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The factory is a static method on "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" constrained to the encoder, so adopters write"},{"type":"text","text":" "},{"code":"try HTTPDestination.acme(...)","type":"codeVoice"},{"type":"text","text":". It throws a typed error for input the vendor would refuse, so a"},{"type":"text","text":" "},{"type":"text","text":"mistake shows up at launch, not later as a stream of rejected requests. It also takes a transport"},{"type":"text","text":" "},{"type":"text","text":"and a backoff, which the conformance checks need. It passes "},{"code":"NoOpInstrument()","type":"codeVoice"},{"type":"text","text":", so no request"},{"type":"text","text":" "},{"type":"text","text":"carries the app’s trace context to the vendor, whatever tracer the app bootstraps."}]},{"code":["\/\/\/ Why the Acme factory couldn't make a destination.","enum AcmeSetupError: Error, Hashable {","    case emptyAPIKey","    case invalidHost","}","","extension HTTPDestination where Encoding == AcmeBatchEncoder {","    static func acme(","        apiKey: String,","        host: URL,","        plan: TrackingPlan,","        transport: Transport,","        backoff: ExponentialBackoff = ExponentialBackoff()","    ) throws(AcmeSetupError) -> HTTPDestination<Transport, AcmeBatchEncoder> {","        guard !apiKey.isEmpty else { throw .emptyAPIKey }","        guard host.scheme == \"https\", host.host() != nil else { throw .invalidHost }","        return HTTPDestination(","            endpoint: host.appending(path: \"v1\/events\"),","            \/\/ Acme doesn't read a trace context, so the app's traces aren't sent to it.","            instrument: NoOpInstrument(),","            transport: transport,","            encoder: AcmeBatchEncoder(apiKey: apiKey, plan: plan),","            backoff: backoff)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Offer an overload without ","type":"text"},{"code":"transport:","type":"codeVoice"},{"text":" that passes ","type":"text"},{"code":"URLSessionTransport()","type":"codeVoice"},{"text":", as PostHog’s does, so","type":"text"},{"text":" ","type":"text"},{"text":"an app needn’t name one.","type":"text"}]},{"anchor":"The-conformance-checks","level":3,"type":"heading","text":"The conformance checks"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DestinationConformance"},{"type":"text","text":" runs the checks every vendor destination must pass. Give it the vendor’s"},{"type":"text","text":" "},{"type":"text","text":"limit and a closure that calls the factory with the setup’s plan, transport and backoff:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","isActive":true},{"type":"text","text":": no "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent"},{"type":"text","text":" "},{"type":"text","text":"without the adopter’s opt-in."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","type":"reference","isActive":true},{"type":"text","text":": behind consent and "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"destination sends exactly the records it is handed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","type":"reference"},{"type":"text","text":": a record over the limit is"},{"type":"text","text":" "},{"type":"text","text":"skipped and reported."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","isActive":true},{"type":"text","text":": failures are retried or dropped as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" classifies them, the encoder’s "},{"type":"codeVoice","code":"transientStatuses"},{"type":"text","text":" among the retried ones."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld"},{"type":"text","text":": no request carries a trace context,"},{"type":"text","text":" "},{"type":"text","text":"even while a tracer is active."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expectRequests(of:plan:matchFixture:withExtension:subdirectory:in:sourceLocation:)"},{"type":"text","text":" compares the"},{"type":"text","text":" "},{"type":"text","text":"requests a hand-worked batch makes with a fixture in the test target’s resources, byte for byte."},{"type":"text","text":" "},{"type":"text","text":"When the fixture is missing, the issue it records holds the requests, so you can check them by hand"},{"type":"text","text":" "},{"type":"text","text":"against the vendor’s documentation and save them as the fixture."}]},{"code":["@Test(arguments: ConformanceCheck.allCases)","func acmeConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/acme.example.com\"))","    let conformance = DestinationConformance(limit: AcmeBatchEncoder.batchLimit) { setup in","        try HTTPDestination.acme(apiKey: \"test-key\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for each rule the destination breaks. The kit is a"},{"type":"text","text":" "},{"type":"text","text":"shared assertion on purpose, so every vendor module runs the same checks. Every check’s records are"},{"type":"text","text":" "},{"type":"text","text":"tracked at "},{"code":"setup.timestamp","type":"codeVoice"},{"type":"text","text":"; if your encoder leaves out records older than the vendor takes, give"},{"type":"text","text":" "},{"type":"text","text":"it that as the time it encodes at, as "},{"code":"GoogleAnalyticsEncoding","type":"codeVoice"},{"type":"text","text":"’s tests do."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"kind":"article","abstract":[{"text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships.","type":"text"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/writingavendordestination"]}],"references":{"doc://Traffluent/documentation/Traffluent":{"abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"kind":"symbol","url":"\/documentation\/traffluent","type":"topic","role":"collection","title":"Traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/transientFailuresRetried":{"abstract":[{"type":"text","text":"A request that gets no response, a 5xx, 408, 429 or a status of the encoder’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"BatchEncoder.transientStatuses"},{"type":"text","text":" is sent again, byte for byte, until it is delivered, and"},{"type":"text","text":" "},{"type":"text","text":"nothing is reported."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientFailuresRetried","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/transientfailuresretried","type":"topic","role":"symbol","title":"ConformanceCheck.transientFailuresRetried","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"kind":"article","url":"\/documentation\/traffluent\/definingevents","type":"topic","role":"article","title":"Defining Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"kind":"article","url":"\/documentation\/traffluent\/automatictracking","type":"topic","role":"article","title":"Automatic Tracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"kind":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","type":"topic","role":"article","title":"Sessions and Standard Context","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"role":"article","title":"Persisting Records","type":"topic","url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","kind":"article"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/consentHolds":{"url":"\/documentation\/destinationtesting\/conformancecheck\/consentholds","title":"ConformanceCheck.consentHolds","type":"topic","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","abstract":[{"text":"Behind a tracker’s ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":" and the destination’s ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":", the destination sends","type":"text"},{"text":" ","type":"text"},{"text":"the event of a granted category it accepts, and not the event of a denied category or of","type":"text"},{"text":" ","type":"text"},{"text":"one it doesn’t accept.","type":"text"}],"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"consentHolds","kind":"identifier"}]},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"role":"article","title":"Consent Gating","type":"topic","url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"kind":"article"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/traceContextWithheld":{"abstract":[{"type":"text","text":"No request carries a trace context in its header fields ("},{"code":"traceparent","type":"codeVoice"},{"type":"text","text":", "},{"code":"tracestate","type":"codeVoice"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"text","text":"whatever the instrument injects), even while a tracer is active and the record was tracked"},{"type":"text","text":" "},{"type":"text","text":"in a span: a vendor’s destination passes "},{"code":"NoOpInstrument()","type":"codeVoice"},{"type":"text","text":", so the app’s traces stay in"},{"type":"text","text":" "},{"type":"text","text":"the app."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"traceContextWithheld","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/tracecontextwithheld","type":"topic","role":"symbol","title":"ConformanceCheck.traceContextWithheld","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"kind":"article","url":"\/documentation\/traffluent\/samplingevents","type":"topic","role":"article","title":"Sampling Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/sensitiveValuesRedacted":{"url":"\/documentation\/destinationtesting\/conformancecheck\/sensitivevaluesredacted","title":"ConformanceCheck.sensitiveValuesRedacted","type":"topic","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent by the default destination, even by a record that reveals"},{"type":"text","text":" "},{"type":"text","text":"it. With the adopter’s opt-in, it is sent while the record reveals it, and not once the"},{"type":"text","text":" "},{"type":"text","text":"record is redacted."}],"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sensitiveValuesRedacted","kind":"identifier"}]},"doc://PostHogEncoding/documentation/PostHogEncoding":{"abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"kind":"symbol","url":"\/documentation\/posthogencoding","type":"topic","role":"collection","title":"PostHogEncoding","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/oversizedRecordSkipped":{"abstract":[{"type":"text","text":"A record too large for the vendor’s limit is left out and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", and the batch’s other records are sent."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oversizedRecordSkipped","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/oversizedrecordskipped","type":"topic","role":"symbol","title":"ConformanceCheck.oversizedRecordSkipped","identifier":"doc:\/\/DestinationTesting