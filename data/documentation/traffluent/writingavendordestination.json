{"sections":[],"metadata":{"title":"Writing a Vendor Destination","roleHeading":"Article","modules":[{"name":"Traffluent"}],"role":"article"},"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"anchor":"Guides","generated":true,"title":"Guides"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vendor destination is an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" with an encoder that writes the vendor’s ingestion"},{"type":"text","text":" "},{"type":"text","text":"format. "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" already does the batching, retries, drop reports and trace context, so the"},{"type":"text","text":" "},{"type":"text","text":"vendor module adds three things:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"an encoder, a "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" that writes each record as the vendor’s JSON and splits a batch to"},{"type":"text","text":" "},{"type":"text","text":"the vendor’s limits;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a factory on ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" that checks what the adopter passes and fills in the endpoint, the","type":"text"},{"text":" ","type":"text"},{"text":"encoder and the limits, so setup is one call;","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"tests that run ","type":"text"},{"code":"DestinationTesting","type":"codeVoice"},{"text":"’s conformance checks and compare its requests with recorded","type":"text"},{"text":" ","type":"text"},{"text":"fixtures.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Write the encoder against the vendor’s public HTTP API, not its SDK, so the app links nothing of","type":"text"},{"text":" ","type":"text"},{"text":"the vendor’s. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"reference"},{"text":" is built this way and is a full example to copy.","type":"text"}]},{"type":"heading","level":3,"anchor":"The-module","text":"The module"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the module depend on "},{"type":"codeVoice","code":"HTTPDestinations"},{"type":"text","text":", "},{"type":"codeVoice","code":"PropertyJSON"},{"type":"text","text":", "},{"type":"codeVoice","code":"JSONValues"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and on swift-distributed-tracing’s "},{"type":"codeVoice","code":"Instrumentation"},{"type":"text","text":" for "},{"type":"codeVoice","code":"NoOpInstrument"},{"type":"text","text":". Its tests depend on"},{"type":"text","text":" "},{"type":"codeVoice","code":"DestinationTesting"},{"type":"text","text":" as well. "},{"type":"codeVoice","code":"PropertyJSON"},{"type":"text","text":" holds the vendor-neutral pieces an encoder is built"},{"type":"text","text":" "},{"type":"text","text":"from, "},{"type":"codeVoice","code":"JSONValues"},{"type":"text","text":" the "},{"type":"codeVoice","code":"JSON"},{"type":"text","text":" value it writes, and "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":" the app’s "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"the encoder reads properties through. "},{"type":"codeVoice","code":"DestinationTesting"},{"type":"text","text":" imports Swift Testing, so it goes in"},{"type":"text","text":" "},{"type":"text","text":"test targets only."}]},{"type":"codeListing","code":[".target(name: \"AcmeEncoding\", dependencies: [","    .product(name: \"HTTPDestinations\", package: \"Traffluent\"),","    .product(name: \"PropertyJSON\", package: \"Traffluent\"),","    .product(name: \"JSONValues\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","    .product(name: \"Instrumentation\", package: \"swift-distributed-tracing\"),","]),",".testTarget(name: \"AcmeEncodingTests\", dependencies: [","    \"AcmeEncoding\",","    .product(name: \"DestinationTesting\", package: \"Traffluent\"),","], resources: [.copy(\"Fixtures\")]),"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"The-encoder","text":"The encoder"},{"type":"paragraph","inlineContent":[{"text":"The examples here are for Acme, a made-up vendor whose API takes","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"{\"api_key\": …, \"events\": [{\"event\", \"user_id\", \"insert_id\", \"time\", \"properties\", \"context\"}]}"},{"text":" ","type":"text"},{"text":"and allows at most 500 events and 1,000,000 bytes a request, and 32,000 bytes an event.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PropertyJSON"},{"text":" supplies each piece of such a record:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads an event’s properties through its schema in the app’s "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"leaving out "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values unless you ask for them and the record reveals them."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"EventRecord.standardContext","type":"codeVoice"},{"type":"text","text":" is the app, device, locale, network and operating system as JSON,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"flattened(separator:)","type":"codeVoice"},{"type":"text","text":" turns it into the one level of dotted keys most vendors take."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Date.iso8601Timestamp"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Date.millisecondsSince1970()"},{"type":"text","text":" are the two timestamp formats vendors"},{"type":"text","text":" "},{"type":"text","text":"ask for."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"EventRecord.pseudonymousIdentity","type":"codeVoice"},{"text":" is who the event is about: the record’s session, or the record","type":"text"},{"text":" ","type":"text"},{"text":"itself when it has none, and never a person (","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"reference","isActive":true},{"text":"). ","type":"text"},{"code":"deduplicationID","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"identifier a vendor drops repeats by, which a redelivered record keeps.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BatchLimit.requests(for:in:encoding:oversized:)"},{"text":" splits a batch into requests of a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"JSONEnvelope"},{"text":" within the vendor’s limits, and leaves out a record that fits in none of them.","type":"text"}]}]}]},{"type":"codeListing","code":["\/\/\/ Why the Acme encoder left a record out.","enum AcmeEncodingError: Error, Hashable {","    case unreadable(PropertyReadingError)","    case contextKeyCollision(key: String)","    case unrepresentableTimestamp","    case oversized(byteCount: Int)","}","","struct AcmeBatchEncoder: BatchEncoder {","    \/\/\/ Acme's limits on one request.","    static let batchLimit = (try? BatchLimit(maximumRecordCount: 500, maximumByteCount: 1_000_000, maximumRecordByteCount: 32_000)) ?? .unlimited","","    typealias Failure = AcmeEncodingError","","    private let reader: PropertyReader","    private let envelope: JSONEnvelope","","    init(apiKey: String, plan: TrackingPlan) {","        reader = PropertyReader(plan: plan)","        envelope = JSONEnvelope([\"api_key\": .string(apiKey)], arrayMember: \"events\")","    }","","    func requests(for batch: [EventRecord]) -> BatchRequests<AcmeEncodingError> {","        Self.batchLimit.requests(for: batch, in: envelope) { record throws(AcmeEncodingError) in","            try json(of: record)","        } oversized: { byteCount in","            .oversized(byteCount: byteCount)","        }","    }","","    private func json(of record: EventRecord) throws(AcmeEncodingError) -> JSON {","        let properties: [String: JSON]","        do {","            properties = try reader.properties(of: record, includingSensitiveValues: false)","        } catch {","            throw .unreadable(error)","        }","        let context: [String: JSON]","        do {","            context = try record.standardContext.flattened()","        } catch {","            throw .contextKeyCollision(key: error.key)","        }","        let time: Int64","        do {","            time = try record.timestamp.millisecondsSince1970()","        } catch {","            throw .unrepresentableTimestamp","        }","        return .object([","            \"event\": .string(record.name),","            \"user_id\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","            \"insert_id\": .string(record.deduplicationID),","            \"time\": .integer(time),","            \"properties\": .object(properties),","            \"context\": .object(context),","        ])","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"requests(for:)"},{"text":" is all a ","type":"text"},{"type":"codeVoice","code":"BatchEncoder"},{"text":" implements, and ","type":"text"},{"type":"codeVoice","code":"Failure"},{"text":" names the reason a record is","type":"text"},{"text":" ","type":"text"},{"text":"left out, as ","type":"text"},{"type":"codeVoice","code":"requests(for:)"},{"text":" doesn’t throw. ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends the requests in order, and","type":"text"},{"text":" ","type":"text"},{"text":"reports each record left out as ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"text":". Pass ","type":"text"},{"type":"codeVoice","code":"includingSensitiveValues: true"},{"text":" only if the","type":"text"},{"text":" ","type":"text"},{"text":"vendor’s terms allow the values, and then only through a factory the adopter opts in with.","type":"text"}]},{"type":"heading","level":3,"anchor":"The-factory","text":"The factory"},{"type":"paragraph","inlineContent":[{"text":"The factory is a static method on ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" constrained to the encoder, so adopters write","type":"text"},{"text":" ","type":"text"},{"code":"try HTTPDestination.acme(...)","type":"codeVoice"},{"text":". It throws a typed error for input the vendor would refuse, so a","type":"text"},{"text":" ","type":"text"},{"text":"mistake shows up at launch, not later as a stream of rejected requests. It also takes a transport","type":"text"},{"text":" ","type":"text"},{"text":"and a backoff, which the conformance checks need. It passes ","type":"text"},{"code":"NoOpInstrument()","type":"codeVoice"},{"text":", so no request","type":"text"},{"text":" ","type":"text"},{"text":"carries the app’s trace context to the vendor, whatever tracer the app bootstraps.","type":"text"}]},{"type":"codeListing","code":["\/\/\/ Why the Acme factory couldn't make a destination.","enum AcmeSetupError: Error, Hashable {","    case emptyAPIKey","    case invalidHost","}","","extension HTTPDestination where Encoding == AcmeBatchEncoder {","    static func acme(","        apiKey: String,","        host: URL,","        plan: TrackingPlan,","        transport: Transport,","        backoff: ExponentialBackoff = ExponentialBackoff()","    ) throws(AcmeSetupError) -> HTTPDestination<Transport, AcmeBatchEncoder> {","        guard !apiKey.isEmpty else { throw .emptyAPIKey }","        guard host.scheme == \"https\", host.host() != nil else { throw .invalidHost }","        return HTTPDestination(","            endpoint: host.appending(path: \"v1\/events\"),","            \/\/ Acme doesn't read a trace context, so the app's traces aren't sent to it.","            instrument: NoOpInstrument(),","            transport: transport,","            encoder: AcmeBatchEncoder(apiKey: apiKey, plan: plan),","            backoff: backoff)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Offer an overload without "},{"type":"codeVoice","code":"transport:"},{"type":"text","text":" that passes "},{"type":"codeVoice","code":"URLSessionTransport()"},{"type":"text","text":", as PostHog’s does, so"},{"type":"text","text":" "},{"type":"text","text":"an app needn’t name one."}]},{"type":"heading","level":3,"anchor":"The-conformance-checks","text":"The conformance checks"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DestinationConformance"},{"type":"text","text":" runs the checks every vendor destination must pass. Give it the vendor’s"},{"type":"text","text":" "},{"type":"text","text":"limit and a closure that calls the factory with the setup’s plan, transport and backoff:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted"},{"type":"text","text":": no "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent"},{"type":"text","text":" "},{"type":"text","text":"without the adopter’s opt-in."}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","type":"reference","isActive":true},{"type":"text","text":": behind consent and "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"destination sends exactly the records it is handed."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped"},{"type":"text","text":": a record over the limit is"},{"type":"text","text":" "},{"type":"text","text":"skipped and reported."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped"},{"type":"text","text":": failures are retried or dropped as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" classifies them."}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld","isActive":true},{"type":"text","text":": no request carries a trace context,"},{"type":"text","text":" "},{"type":"text","text":"even while a tracer is active."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"expectRequests(of:plan:matchFixture:withExtension:subdirectory:in:sourceLocation:)","type":"codeVoice"},{"text":" compares the","type":"text"},{"text":" ","type":"text"},{"text":"requests a hand-worked batch makes with a fixture in the test target’s resources, byte for byte.","type":"text"},{"text":" ","type":"text"},{"text":"When the fixture is missing, the issue it records holds the requests, so you can check them by hand","type":"text"},{"text":" ","type":"text"},{"text":"against the vendor’s documentation and save them as the fixture.","type":"text"}]},{"type":"codeListing","code":["@Test(arguments: ConformanceCheck.allCases)","func acmeConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/acme.example.com\"))","    let conformance = DestinationConformance(limit: AcmeBatchEncoder.batchLimit) { setup in","        try HTTPDestination.acme(apiKey: \"test-key\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each check records a Swift Testing issue for each rule the destination breaks. The kit is a","type":"text"},{"text":" ","type":"text"},{"text":"shared assertion on purpose, so every vendor module runs the same checks. Every check’s records are","type":"text"},{"text":" ","type":"text"},{"text":"tracked at ","type":"text"},{"code":"setup.timestamp","type":"codeVoice"},{"text":"; if your encoder leaves out records older than the vendor takes, give","type":"text"},{"text":" ","type":"text"},{"text":"it that as the time it encodes at, as ","type":"text"},{"code":"GoogleAnalyticsEncoding","type":"codeVoice"},{"text":"’s tests do.","type":"text"}]}],"kind":"content"}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/writingavendordestination"]}],"references":{"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/oversizedRecordSkipped":{"kind":"symbol","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/oversizedrecordskipped","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","abstract":[{"text":"A record too large for the vendor’s limit is left out and reported as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"text":", and the batch’s other records are sent.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"oversizedRecordSkipped"}],"type":"topic","title":"ConformanceCheck.oversizedRecordSkipped"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","title":"Persisting Records","type":"topic","kind":"article","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"role":"article","url":"\/documentation\/traffluent\/persistingrecords"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"kind":"article","role":"article","url":"\/documentation\/traffluent\/definingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", and constrain which values its properties may hold.","type":"text"}],"type":"topic","title":"Defining Events"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"url":"\/documentation\/traffluent\/sessionsandstandardcontext","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","kind":"article","title":"Sessions and Standard Context"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","title":"Sampling Events","type":"topic","kind":"article","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"role":"article","url":"\/documentation\/traffluent\/samplingevents"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","title":"Exporting and Checking a Tracking Plan","type":"topic","kind":"article","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"kind":"article","role":"article","url":"\/documentation\/traffluent\/identifyingpeople","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"type":"topic","title":"Identifying People"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/sensitiveValuesRedacted":{"abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent by the default destination, even by a record that reveals"},{"type":"text","text":" "},{"type":"text","text":"it. With the adopter’s opt-in, it is sent while the record reveals it, and not once the"},{"type":"text","text":" "},{"type":"text","text":"record is redacted."}],"url":"\/documentation\/destinationtesting\/conformancecheck\/sensitivevaluesredacted","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sensitiveValuesRedacted","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","title":"ConformanceCheck.sensitiveValuesRedacted"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","role":"collection","url":"\/documentation\/traffluent","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"type":"topic","title":"Traffluent"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/consentHolds":{"kind":"symbol","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/consentholds","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","abstract":[{"type":"text","text":"Behind a tracker’s "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":" and the destination’s "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", the destination sends"},{"type":"text","text":" "},{"type":"text","text":"the event of a granted category it accepts, and not the event of a denied category or of"},{"type":"text","text":" "},{"type":"text","text":"one it doesn’t accept."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"consentHolds","kind":"identifier"}],"type":"topic","title":"ConformanceCheck.consentHolds"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"kind":"article","role":"article","url":"\/documentation\/traffluent\/consentgating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"type":"topic","title":"Consent Gating"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/traceContextWithheld":{"abstract":[{"type":"text","text":"No request carries a trace context in its header fields ("},{"type":"codeVoice","code":"traceparent"},{"type":"text","text":", "},{"type":"codeVoice","code":"tracestate"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"text","text":"whatever the instrument injects), even while a tracer is active and the record was tracked"},{"type":"text","text":" "},{"type":"text","text":"in a span: a vendor’s destination passes "},{"type":"codeVoice","code":"NoOpInstrument()"},{"type":"text","text":", so the app’s traces stay in"},{"type":"text","text":" "},{"type":"text","text":"the app."}],"url":"\/documentation\/destinationtesting\/conformancecheck\/tracecontextwithheld","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"traceContextWithheld"}],"type":"topic","role":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld","kind":"symbol","title":"ConformanceCheck.traceContextWithheld"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","title":"Automatic Tracking","type":"topic","kind":"article","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"role":"article","url":"\/documentation\/traffluent\/automatictracking"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","title":"PostHogEncoding","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}],"role":"collection","url":"\/documentation\/posthogencoding"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/transientFailuresRetried":{"kind":"symbol","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/transientfailuresretried","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","abstract":[{"text":"A request that gets no response, a 5xx, 408 or 429 is sent again, byte for byte, until it is","type":"text"},{"text":" ","type":"text"},{"text":"delivered, and nothing is reported.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientFailuresRetried"}],"type":"topic","title":"ConformanceCheck.transientFailuresRetried"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/rejectionsDropped":{"abstract":[{"text":"A request answered with a status retrying won’t change (400, 401, 403, 404, 413, 422) is","type":"text"},{"text":" ","type":"text"},{"text":"sent once and reported as ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.rejected(status:recordIDs:)"},{"text":".","type":"text"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/rejectionsdropped","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionsDropped","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","kind":"symbol","title":"ConformanceCheck.rejectionsDropped"}}}