de":"BatchEncoder.transientStatuses","type":"codeVoice"},{"type":"text","text":") is sent once and reported as"},{"type":"text","text":" "},{"code":"HTTPDropReport.rejected(status:recordIDs:)","type":"codeVoice"},{"type":"text","text":". An encoder that lists all six is checked"},{"type":"text","text":" "},{"type":"text","text":"with the first client error (4xx) it doesn’t list; one that lists every client error"},{"type":"text","text":" "},{"type":"text","text":"records an issue, as no rejection is left to check."}],"url":"\/documentation\/destinationtesting\/conformancecheck\/rejectionsdropped","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"kind":"article","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"url":"\/documentation\/traffluent\/identifyingpeople","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","role":"article","title":"Identifying People","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/traceContextWithheld":{"kind":"symbol","abstract":[{"text":"No request carries a trace context in its header fields (","type":"text"},{"code":"traceparent","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tracestate","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"text":"whatever the instrument injects), even while a tracer is active and the record was tracked","type":"text"},{"text":" ","type":"text"},{"text":"in a span: a vendor’s destination passes ","type":"text"},{"code":"NoOpInstrument()","type":"codeVoice"},{"text":", so the app’s traces stay in","type":"text"},{"text":" ","type":"text"},{"text":"the app.","type":"text"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/tracecontex