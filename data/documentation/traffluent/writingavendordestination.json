{"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"},"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"anchor":"Guides"}],"metadata":{"role":"article","roleHeading":"Article","title":"Writing a Vendor Destination","modules":[{"name":"Traffluent"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A vendor destination is an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" with an encoder that writes the vendor’s ingestion","type":"text"},{"text":" ","type":"text"},{"text":"format. ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" already does the batching, retries, drop reports and trace context, so the","type":"text"},{"text":" ","type":"text"},{"text":"vendor module adds three things:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"an encoder, a "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" that writes each record as the vendor’s JSON and splits a batch to"},{"type":"text","text":" "},{"type":"text","text":"the vendor’s limits;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a factory on "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" that checks what the adopter passes and fills in the endpoint, the"},{"type":"text","text":" "},{"type":"text","text":"encoder and the limits, so setup is one call;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"tests that run ","type":"text"},{"code":"DestinationTesting","type":"codeVoice"},{"text":"’s conformance checks and compare its requests with recorded","type":"text"},{"text":" ","type":"text"},{"text":"fixtures.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Write the encoder against the vendor’s public HTTP API, not its SDK, so the app links nothing of"},{"type":"text","text":" "},{"type":"text","text":"the vendor’s. "},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"reference","isActive":true},{"type":"text","text":" is built this way and is a full example to copy."}]},{"text":"The module","anchor":"The-module","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Make the module depend on ","type":"text"},{"code":"HTTPDestinations","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PropertyJSON","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"TrackingPlans","type":"codeVoice"},{"text":", and on","type":"text"},{"text":" ","type":"text"},{"text":"swift-distributed-tracing’s ","type":"text"},{"code":"Instrumentation","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"NoOpInstrument","type":"codeVoice"},{"text":". Its tests depend on","type":"text"},{"text":" ","type":"text"},{"code":"DestinationTesting","type":"codeVoice"},{"text":" as well. ","type":"text"},{"code":"PropertyJSON","type":"codeVoice"},{"text":" holds the vendor-neutral pieces an encoder is built","type":"text"},{"text":" ","type":"text"},{"text":"from, and ","type":"text"},{"code":"DestinationTesting","type":"codeVoice"},{"text":" imports Swift Testing, so it goes in test targets only.","type":"text"}]},{"code":[".target(name: \"AcmeEncoding\", dependencies: [","    .product(name: \"HTTPDestinations\", package: \"Traffluent\"),","    .product(name: \"PropertyJSON\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","    .product(name: \"Instrumentation\", package: \"swift-distributed-tracing\"),","]),",".testTarget(name: \"AcmeEncodingTests\", dependencies: [","    \"AcmeEncoding\",","    .product(name: \"DestinationTesting\", package: \"Traffluent\"),","], resources: [.copy(\"Fixtures\")]),"],"type":"codeListing","syntax":"swift"},{"text":"The encoder","anchor":"The-encoder","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The examples here are for Acme, a made-up vendor whose API takes","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"{\"api_key\": …, \"events\": [{\"event\", \"user_id\", \"insert_id\", \"time\", \"properties\", \"context\"}]}"},{"text":" ","type":"text"},{"text":"and allows at most 500 events and 1,000,000 bytes a request, and 32,000 bytes an event.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PropertyJSON"},{"text":" supplies each piece of such a record:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads an event’s properties through its schema in the app’s "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"leaving out "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values unless you ask for them and the record reveals them."}]}]},{"content":[{"inlineContent":[{"code":"EventRecord.standardContext","type":"codeVoice"},{"text":" is the app, device, locale, network and operating system as JSON,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"flattened(separator:)","type":"codeVoice"},{"text":" turns it into the one level of dotted keys most vendors take.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Date.iso8601Timestamp"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Date.millisecondsSince1970()"},{"type":"text","text":" are the two timestamp formats vendors"},{"type":"text","text":" "},{"type":"text","text":"ask for."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EventRecord.pseudonymousIdentity"},{"text":" is who the event is about: the record’s session, or the record","type":"text"},{"text":" ","type":"text"},{"text":"itself when it has none, and never a person (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"},{"text":"). ","type":"text"},{"type":"codeVoice","code":"deduplicationID"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"identifier a vendor drops repeats by, which a redelivered record keeps.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"BatchLimit.requests(for:in:encoding:oversized:)","type":"codeVoice"},{"text":" splits a batch into requests of a","type":"text"},{"text":" ","type":"text"},{"code":"JSONEnvelope","type":"codeVoice"},{"text":" within the vendor’s limits, and leaves out a record that fits in none of them.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["\/\/\/ Why the Acme encoder left a record out.","enum AcmeEncodingError: Error, Hashable {","    case unreadable(PropertyReadingError)","    case contextKeyCollision(key: String)","    case unrepresentableTimestamp","    case oversized(byteCount: Int)","}","","struct AcmeBatchEncoder: BatchEncoder {","    \/\/\/ Acme's limits on one request.","    static let batchLimit = (try? BatchLimit(maximumRecordCount: 500, maximumByteCount: 1_000_000, maximumRecordByteCount: 32_000)) ?? .unlimited","","    typealias Failure = AcmeEncodingError","","    private let reader: PropertyReader","    private let envelope: JSONEnvelope","","    init(apiKey: String, plan: TrackingPlan) {","        reader = PropertyReader(plan: plan)","        envelope = JSONEnvelope([\"api_key\": .string(apiKey)], arrayMember: \"events\")","    }","","    func requests(for batch: [EventRecord]) -> BatchRequests<AcmeEncodingError> {","        Self.batchLimit.requests(for: batch, in: envelope) { record throws(AcmeEncodingError) in","            try json(of: record)","        } oversized: { byteCount in","            .oversized(byteCount: byteCount)","        }","    }","","    private func json(of record: EventRecord) throws(AcmeEncodingError) -> JSON {","        let properties: [String: JSON]","        do {","            properties = try reader.properties(of: record, includingSensitiveValues: false)","        } catch {","            throw .unreadable(error)","        }","        let context: [String: JSON]","        do {","            context = try record.standardContext.flattened()","        } catch {","            throw .contextKeyCollision(key: error.key)","        }","        let time: Int64","        do {","            time = try record.timestamp.millisecondsSince1970()","        } catch {","            throw .unrepresentableTimestamp","        }","        return .object([","            \"event\": .string(record.name),","            \"user_id\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","            \"insert_id\": .string(record.deduplicationID),","            \"time\": .integer(time),","            \"properties\": .object(properties),","            \"context\": .object(context),","        ])","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"requests(for:)","type":"codeVoice"},{"text":" is all a ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" implements, and ","type":"text"},{"code":"Failure","type":"codeVoice"},{"text":" names the reason a record is","type":"text"},{"text":" ","type":"text"},{"text":"left out, as ","type":"text"},{"code":"requests(for:)","type":"codeVoice"},{"text":" doesn’t throw. ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends the requests in order, and","type":"text"},{"text":" ","type":"text"},{"text":"reports each record left out as ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":". Pass ","type":"text"},{"code":"includingSensitiveValues: true","type":"codeVoice"},{"text":" only if the","type":"text"},{"text":" ","type":"text"},{"text":"vendor’s terms allow the values, and then only through a factory the adopter opts in with.","type":"text"}]},{"text":"The factory","anchor":"The-factory","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The factory is a static method on "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" constrained to the encoder, so adopters write"},{"type":"text","text":" "},{"type":"codeVoice","code":"try HTTPDestination.acme(...)"},{"type":"text","text":". It throws a typed error for input the vendor would refuse, so a"},{"type":"text","text":" "},{"type":"text","text":"mistake shows up at launch, not later as a stream of rejected requests. It also takes a transport"},{"type":"text","text":" "},{"type":"text","text":"and a backoff, which the conformance checks need. It passes "},{"type":"codeVoice","code":"NoOpInstrument()"},{"type":"text","text":", so no request"},{"type":"text","text":" "},{"type":"text","text":"carries the app’s trace context to the vendor, whatever tracer the app bootstraps."}]},{"code":["\/\/\/ Why the Acme factory couldn't make a destination.","enum AcmeSetupError: Error, Hashable {","    case emptyAPIKey","    case invalidHost","}","","extension HTTPDestination where Encoding == AcmeBatchEncoder {","    static func acme(","        apiKey: String,","        host: URL,","        plan: TrackingPlan,","        transport: Transport,","        backoff: ExponentialBackoff = ExponentialBackoff()","    ) throws(AcmeSetupError) -> HTTPDestination<Transport, AcmeBatchEncoder> {","        guard !apiKey.isEmpty else { throw .emptyAPIKey }","        guard host.scheme == \"https\", host.host() != nil else { throw .invalidHost }","        return HTTPDestination(","            endpoint: host.appending(path: \"v1\/events\"),","            \/\/ Acme doesn't read a trace context, so the app's traces aren't sent to it.","            instrument: NoOpInstrument(),","            transport: transport,","            encoder: AcmeBatchEncoder(apiKey: apiKey, plan: plan),","            backoff: backoff)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Offer an overload without ","type":"text"},{"type":"codeVoice","code":"transport:"},{"text":" that passes ","type":"text"},{"type":"codeVoice","code":"URLSessionTransport()"},{"text":", as PostHog’s does, so","type":"text"},{"text":" ","type":"text"},{"text":"an app needn’t name one.","type":"text"}]},{"text":"The conformance checks","anchor":"The-conformance-checks","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DestinationConformance"},{"type":"text","text":" runs the checks every vendor destination must pass. Give it the vendor’s"},{"type":"text","text":" "},{"type":"text","text":"limit and a closure that calls the factory with the setup’s plan, transport and backoff:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","isActive":true,"type":"reference"},{"text":": no ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is sent","type":"text"},{"text":" ","type":"text"},{"text":"without the adopter’s opt-in.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","isActive":true},{"type":"text","text":": behind consent and "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"destination sends exactly the records it is handed."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","isActive":true},{"text":": a record over the limit is","type":"text"},{"text":" ","type":"text"},{"text":"skipped and reported.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","type":"reference","isActive":true},{"text":": failures are retried or dropped as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" classifies them.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld"},{"type":"text","text":": no request carries a trace context,"},{"type":"text","text":" "},{"type":"text","text":"even while a tracer is active."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expectRequests(of:plan:matchFixture:withExtension:subdirectory:in:sourceLocation:)"},{"type":"text","text":" compares the"},{"type":"text","text":" "},{"type":"text","text":"requests a hand-worked batch makes with a fixture in the test target’s resources, byte for byte."},{"type":"text","text":" "},{"type":"text","text":"When the fixture is missing, the issue it records holds the requests, so you can check them by hand"},{"type":"text","text":" "},{"type":"text","text":"against the vendor’s documentation and save them as the fixture."}]},{"code":["@Test(arguments: ConformanceCheck.allCases)","func acmeConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/acme.example.com\"))","    let conformance = DestinationConformance(limit: AcmeBatchEncoder.batchLimit) { setup in","        try HTTPDestination.acme(apiKey: \"test-key\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for each rule the destination breaks. The kit is a"},{"type":"text","text":" "},{"type":"text","text":"shared assertion on purpose, so every vendor module runs the same checks."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/traffluent\/writingavendordestination"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","references":{"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"url":"\/documentation\/traffluent\/sessionsandstandardcontext","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","kind":"article","title":"Sessions and Standard Context","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"type":"topic","role":"article"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"title":"Consent Gating","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","type":"topic","url":"\/documentation\/traffluent\/consentgating","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"role":"article","kind":"article"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/rejectionsDropped":{"url":"\/documentation\/destinationtesting\/conformancecheck\/rejectionsdropped","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionsDropped"}],"title":"ConformanceCheck.rejectionsDropped","type":"topic","abstract":[{"text":"A request answered with a status retrying won’t change (400, 401, 403, 404, 413, 422) is","type":"text"},{"text":" ","type":"text"},{"text":"sent once and reported as ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.rejected(status:recordIDs:)"},{"text":".","type":"text"}],"role":"symbol"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"title":"Persisting Records","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"role":"article","kind":"article"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/transientFailuresRetried":{"url":"\/documentation\/destinationtesting\/conformancecheck\/transientfailuresretried","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientFailuresRetried","kind":"identifier"}],"abstract":[{"text":"A request that gets no response, a 5xx, 408 or 429 is sent again, byte for byte, until it is","type":"text"},{"text":" ","type":"text"},{"text":"delivered, and nothing is reported.","type":"text"}],"title":"ConformanceCheck.transientFailuresRetried","type":"topic","role":"symbol"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"title":"PostHogEncoding","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"topic","url":"\/documentation\/posthogencoding","abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}],"role":"collection","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"url":"\/documentation\/traffluent\/samplingevents","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","kind":"article","title":"Sampling Events","type":"topic","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"role":"article"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/oversizedRecordSkipped":{"title":"ConformanceCheck.oversizedRecordSkipped","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"oversizedRecordSkipped"}],"type":"topic","url":"\/documentation\/destinationtesting\/conformancecheck\/oversizedrecordskipped","abstract":[{"type":"text","text":"A record too large for the vendor’s limit is left out and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", and the batch’s other records are sent."}],"role":"symbol","kind":"symbol"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/traceContextWithheld":{"url":"\/documentation\/destinationtesting\/conformancecheck\/tracecontextwithheld","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"traceContextWithheld","kind":"identifier"}],"title":"ConformanceCheck.traceContextWithheld","abstract":[{"type":"text","text":"No request carries a trace context in its header fields ("},{"type":"codeVoice","code":"traceparent"},{"type":"text","text":", "},{"type":"codeVoice","code":"tracestate"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"text","text":"whatever the instrument injects), even while a tracer is active and the record was tracked"},{"type":"text","text":" "},{"type":"text","text":"in a span: a vendor’s destination passes "},{"type":"codeVoice","code":"NoOpInstrument()"},{"type":"text","text":", so the app’s traces stay in"},{"type":"text","text":" "},{"type":"text","text":"the app."}],"type":"topic","role":"symbol"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/sensitiveValuesRedacted":{"title":"ConformanceCheck.sensitiveValuesRedacted","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sensitiveValuesRedacted","kind":"identifier"}],"type":"topic","url":"\/documentation\/destinationtesting\/conformancecheck\/sensitivevaluesredacted","abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value is never sent by the default destination, even by a record that reveals","type":"text"},{"text":" ","type":"text"},{"text":"it. With the adopter’s opt-in, it is sent while the record reveals it, and not once the","type":"text"},{"text":" ","type":"text"},{"text":"record is redacted.","type":"text"}],"role":"symbol","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","kind":"article","title":"Automatic Tracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"type":"topic","role":"article"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"title":"Identifying People","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"topic","url":"\/documentation\/traffluent\/identifyingpeople","abstract":[{"text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent.","type":"text"}],"role":"article","kind":"article"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/consentHolds":{"url":"\/documentation\/destinationtesting\/conformancecheck\/consentholds","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"consentHolds","kind":"identifier"}],"type":"topic","title":"ConformanceCheck.consentHolds","abstract":[{"type":"text","text":"Behind a tracker’s "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":" and the destination’s "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", the destination sends"},{"type":"text","text":" "},{"type":"text","text":"the event of a granted category it accepts, and not the event of a denied category or of"},{"type":"text","text":" "},{"type":"text","text":"one it doesn’t accept."}],"role":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"title":"Exporting and Checking a Tracking Plan","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"topic","url":"\/documentation\/traffluent\/trackingplanworkflow","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"role":"article","kind":"article"},"doc://Traffluent/documentation/Traffluent":{"url":"\/documentation\/traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","type":"topic","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"title":"Traffluent","role":"collection"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"title":"Defining Events","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","url":"\/documentation\/traffluent\/definingevents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"role":"article","kind":"article"}}}