tion","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"trackLifecycle"},{"text":": the app’s installs, updates (with the versions), opens, moves to the background and terminations.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.sessions(timeout:kinds:)"},{"type":"text","text":": a random session identifier held in memory only, and "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SessionEnded"},{"type":"text","text":" with the session’s duration."}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rest ship no manifest: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Checksums\/documentation\/Checksums"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/JSONValues\/documentation\/JSONValues"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},{"type":"text","text":" neither call a required-reason API"},{"type":"text","text":" "},{"type":"text","text":"nor make data of their own. They carry, store and send the events and context your app and the"},{"type":"text","text":" "},{"type":"text","text":"modules above make."}]},{"anchor":"Your-apps-manifest-and-privacy-labels","level":3,"type":"heading","text":"Your app’s manifest and privacy labels"},{"type":"pa