eVoice"},{"text":"; ","type":"text"},{"code":"ProcessInfo.performExpiringActivity","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"It reads and writes the version file’s contents, never its attributes.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"type":"text","text":" for "},{"type":"codeVoice","code":"hw.machine"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hw.model"},{"type":"text","text":", "},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"Locale.current"},{"type":"text","text":", "},{"type":"codeVoice","code":"NWPathMonitor"},{"type":"text","text":", "},{"type":"codeVoice","code":"identifierForVendor"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"None is on the list; "},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":" is declared as collected data below."}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"type":"codeVoice","code":"Date"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"Date.now","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wall-clock time, not boot t