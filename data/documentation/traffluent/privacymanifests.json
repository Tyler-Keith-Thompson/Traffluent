{"metadata":{"roleHeading":"Article","role":"article","title":"Privacy Manifests","modules":[{"name":"Traffluent"}]},"seeAlsoSections":[{"generated":true,"anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"],"title":"Essentials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/privacymanifests"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Traffluent collects nothing on its own. It records only the events your app tracks and the","type":"text"},{"text":" ","type":"text"},{"text":"context your app turns on: every kind of automatic instrumentation and every standard enricher is","type":"text"},{"text":" ","type":"text"},{"text":"opt in. It sends records only to the destinations your app gives a delivery, to endpoints your app","type":"text"},{"text":" ","type":"text"},{"text":"names. None of it is used for tracking as Apple defines it: no module links what it records with","type":"text"},{"text":" ","type":"text"},{"text":"other companies’ data, reads the advertising identifier, fingerprints the device, or works around","type":"text"},{"text":" ","type":"text"},{"text":"the user’s consent or App Tracking Transparency. Every manifest declares ","type":"text"},{"code":"NSPrivacyTracking","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" and lists no tracking domains.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each module that can produce data of one of Apple’s collected data types ships a"},{"type":"text","text":" "},{"type":"codeVoice","code":"PrivacyInfo.xcprivacy"},{"type":"text","text":" declaring it. SwiftPM and Bazel both put it in a resource bundle named"},{"type":"text","text":" "},{"type":"codeVoice","code":"Traffluent_<Module>.bundle"},{"type":"text","text":", which Xcode and rules_apple copy into your app, where Xcode’s privacy"},{"type":"text","text":" "},{"type":"text","text":"report finds it. A module your app doesn’t link adds nothing to the report."}]},{"anchor":"Required-reason-APIs","type":"heading","level":3,"text":"Required-reason APIs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No Traffluent module calls an API on Apple’s list of required-reason APIs, so every manifest’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSPrivacyAccessedAPITypes"},{"type":"text","text":" is empty. The list’s categories are file timestamps"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryFileTimestamp"},{"type":"text","text":"), system boot time"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategorySystemBootTime"},{"type":"text","text":"), disk space"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryDiskSpace"},{"type":"text","text":"), active keyboards"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryActiveKeyboards"},{"type":"text","text":") and user defaults"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryUserDefaults"