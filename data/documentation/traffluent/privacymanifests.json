e"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Wall-clock time, not boot time."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":", the default clock of "},{"type":"codeVoice","code":"batch()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The Swift runtime’s clock, which isn’t on the list.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"GRDB"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"GRDB ships a privacy manifest of its own."}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,","type":"text"},{"text":" ","type":"text"},{"text":"swift-system’s ","type":"text"},{"type":"codeVoice","code":"Stat"},{"text":" API (","type":"text"},{"type":"codeVoice","code":"FilePath.stat()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"FileDescriptor.stat()"},{"text":") calls ","type":"text"},{"type":"codeVoice","code":"stat"},{"text":", ","type":"text"},{"type":"codeVoice","code":"fstat"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lstat"},{"text":", ","type":"text"},{"type":"codeVoice","code":"fstatat"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"statfs"},{"text":". Traffluent calls none of it. If your app does, your manifest","type":"text"},{"text":" ","type":"text"},{"text":"declares the file timestamp or disk space reason it needs.","type":"text"}]},{"type":"heading","anchor":"Collected-data","level":3,"text":"Collected data"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every declaration below is "},{"code":"NSPrivacyCollectedDataTypeLinked","type":"codeVoice"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":" (Traffluent links nothing"},{"type":"text","text":" "},{"type":"text","text":"to the user’s identity), "},{"code":"NSPrivacyCollectedDataTypeTracking","type":"codeVoice"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and has the one purpose"},{"type":"text","text":" "},{"code":"NSPrivacyCollectedDataTypePurposeAnalytics","type":"codeVoice"},{"type":"text","text":". A module declares a type only when it makes data of"},{"type":"text","text":" "},{"type":"text","text":"that type itself; it is collected only once your app turns the module on and delivers the records"},{"type":"text","text":" "},{"type":"text","text":"off the device."}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Module"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Data type"}]}],[{"type":"paragraph","inlineContent":[{"text":"What it makes, once your app turns it on","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Device ID (","type":"text"},{"code":"NSPrivacyCollectedDataTypeDeviceID","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":": the platform’s "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":", as a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"codeVoice","code":"VendorIdentifierKey"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Other Diagnostic Data (","type":"text"},{"code":"NSPrivacyCollectedDataTypeOtherDiagnosticData","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.application()","type":"codeVoice"},{"type":"text","text":", "},{"code":"device()","type":"codeVoice"},{"type":"text","text":", "},{"code":"operatingSystem()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"network()","type":"codeVoice"},{"type":"text","text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other Data Types ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDataTypes"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.locale()","type":"codeVoice"},{"type":"text","text":": the user’s locale."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Product Interaction (","type":"text"},{"code":"NSPrivacyCollectedDataTypeProductInteraction","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":", and the events ","type":"text"},{"code":"trackOnAppear(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"trackOnTap(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"trackChange(of:_:)","type":"codeVoice"},{"text":" track as the user moves through the app.","type":"text"}]}]],[[{"type":"paragraph","inlin