es, your manifest"},{"type":"text","text":" "},{"type":"text","text":"declares the file timestamp or disk space reason it needs."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Collected data","anchor":"Collected-data"},{"inlineContent":[{"type":"text","text":"Every declaration below is "},{"code":"NSPrivacyCollectedDataTypeLinked","type":"codeVoice"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":" (Traffluent links nothing"},{"type":"text","text":" "},{"type":"text","text":"to the user’s identity), "},{"code":"NSPrivacyCollectedDataTypeTracking","type":"codeVoice"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and has the one purpose"},{"type":"text","text":" "},{"code":"NSPrivacyCollectedDataTypePurposeAnalytics","type":"codeVoice"},{"type":"text","text":". A module declares a type only when it makes data of"},{"type":"text","text":" "},{"type":"text","text":"that type itself; it is collected only once your app turns the module on and delivers the records"},{"type":"text","text":" "},{"type":"text","text":"off the device."}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Module","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Data type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"text":"Device ID (","type":"text"},{"code":"NSPrivacyCollectedDataTypeDeviceID","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"type":"text","text":": the platform’s "},{"code":"identifierForVendor","type":"codeVoice"},{"type":"text","text":", as a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" "},{"code":"VendorIdentifierKey","type":"codeVoice"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other Diagnostic Data ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.application()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"operatingSystem()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"network()","type":"codeVoice"},{"text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other Data Types ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDataTypes"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.locale()","type":"codeVoice"},{"type":"text","text":": the user’s locale."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product Interaction ("},{"code":"NSPrivacyCollectedDataTypeProductInteraction","type":"codeVoice"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackScreen(_:)"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"ScreenViewed"},{"text":", and the events ","type":"text"},{"type":"codeVoice","code