re"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"}],"type":"paragraph"}],[{"inlineContent":[{"text":"It reads and writes the version file’s contents, never its attributes.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"hw.machine"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hw.model"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Locale.current"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NWPathMonitor"},{"text":", ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"None is on the list; "},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":" is declared as collected data below."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The tracker’s record timestamps (","type":"text"},{"code":"Date","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Date.now","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Wall-clock time, not boot time.