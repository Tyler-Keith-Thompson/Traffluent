ectedDataTypeTracking"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and has the one purpose"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypePurposeAnalytics"},{"type":"text","text":". A module declares a type only when it makes data of"},{"type":"text","text":" "},{"type":"text","text":"that type itself; it is collected only once your app turns the module on and delivers the records"},{"type":"text","text":" "},{"type":"text","text":"off the device."}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Module"}]}],[{"type":"paragraph","inlineContent":[{"text":"Data type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"Device ID (","type":"text"},{"code":"NSPrivacyCollectedDataTypeDeviceID","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"type":"text","text":": the platform’s "},{"code":"identifierForVendor","type":"codeVoice"},{"type":"text","text":", as a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" "},{"code":"VendorIdentifierKey","type":"codeVoice"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other Diagnostic Data ("},{"code":"NSPrivacyCollectedDataTypeOtherDiagnosticData","type":"codeVoice"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":"