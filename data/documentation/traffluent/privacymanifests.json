tions\/documentation\/Destinations","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","type":"reference","isActive":true},{"text":" neither call a required-reason API nor make data of their own. They carry, store and send the events and","type":"text"},{"text":" ","type":"text"},{"text":"context your app and the modules above make.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Your app’s manifest and privacy labels","anchor":"Your-apps-manifest-and-privacy-labels"},{"inlineContent":[{"text":"Traffluent’s manifests cover what its modules make. Your app’s manifest and its App Store privacy","type":"text"},{"text":" ","type":"text"},{"text":"labels also cover what your app adds:","type":"text"}],"type":"paragraph"},{"type":"u