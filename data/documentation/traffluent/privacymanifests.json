odule but never turns it on, it collects nothing","type":"text"},{"text":" ","type":"text"},{"text":"through it, and your privacy labels can leave that data out.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"seeAlsoSections":[{"anchor":"Choosing-what-to-record","generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"],"title":"Choosing what to record"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"references":{"doc://Checksums/documentation/Checksums":{"url":"\/documentation\/checksums","role":"collection","identifier":"doc:\/\/Checksums\/documentation\/Checksums","abstract":[{"type":"text","text":"The CRC-32 checksum of raw bytes, as zlib, PNG, gzip and Ethernet compute it."}],"type":"topic","title":"Checksums","kind":"symbol"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"url":"\/documentation\/posthogencoding","role":"collection","kind":"symbol","type":"topic","abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","title":"PostHogEncoding"},"doc://EventMacros/documentation/EventMacros":{"url":"\/documentation\/eventmacros","role":"collection","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"type":"topic","title":"EventMacros","kind":"symbol"},"doc://PropertyJSON/documentation/PropertyJSON":{"url":"\/documentation\/propertyjson","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"The vendor-neutral pieces a JSON "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" is built from: propert