","code":"ControlActivated"},{"type":"text","text":" per touch that activates a control, named by its accessibility identifier, never its text."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction"}],"type":"paragraph"}],[{"inlineContent":[{"code":"trackLifecycle","type":"codeVoice"},{"text":": the app’s installs, updates (with the versions), opens, moves to the background and terminations.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Enricher.sessions(timeout:kinds:)","type":"codeVoice"},{"type":"text","text":": a random session identifier held in memory only, and "},{"code":"SessionStarted","type":"codeVoice"},{"type":"text","text":" and "},{"code":"SessionEnded","type":"codeVoice"},{"type":"text","text":" with the session’s duration."}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"The rest ship no manifest: "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Checksums\/documentation\/Checksums","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\