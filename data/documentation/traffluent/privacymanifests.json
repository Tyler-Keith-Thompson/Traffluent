), "},{"code":"NSPrivacyCollectedDataTypeTracking","type":"codeVoice"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and has the one purpose"},{"type":"text","text":" "},{"code":"NSPrivacyCollectedDataTypePurposeAnalytics","type":"codeVoice"},{"type":"text","text":". A module declares a type only when it makes data of"},{"type":"text","text":" "},{"type":"text","text":"that type itself; it is collected only once your app turns the module on and delivers the records"},{"type":"text","text":" "},{"type":"text","text":"off the device."}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Module","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Data type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Device ID (","type":"text"},{"code":"NSPrivacyCollectedDataTypeDeviceID","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"text":": the platform’s ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"},{"text":", as a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" ","type":"text"},{"type":"codeVoice","code":"VendorIdentifierKey"},{"text":".","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Other Diagnostic Data ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.application()"},{"type":"text"