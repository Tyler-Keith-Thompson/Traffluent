{"type":"codeVoice","code":"FileVersionStore"},{"type":"text","text":"; "},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"It reads and writes the version file’s contents, never its attributes."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"sysctlbyname","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"hw.machine","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"hw.model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ProcessInfo.operatingSystemVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Bundle.infoDictionary","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Locale.current","type":"codeVoice"},{"text":", ","type":"text"},{"code":"NWPathMonitor","type":"codeVoice"},{"text":", ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"None is on the list; ","type":"text"},{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"text":" is declared as collected data below.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"type":"codeVoice","code":"Date"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Date.now"}]}],[{"type":"paragraph","inlineContent":[{"text":"Wall-clock time, not boot time.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":", the default clock of "},{"code":"batch()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The Swift runtime’s clock, which isn’t on the list.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"GRDB","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"GRDB ships a privacy manifest of its own.","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,"},{"type":"text","text":" "},{"type":"text","text":"swift-system’s "},{"type":"codeVoice","code":"Stat"},{"type":"text","text":" API ("},{"type":"codeVoice","code":"FilePath.stat()"},{"type":"text","text":", "},{"type":"codeVoice","code":"FileDescriptor.stat()"},{"type":"text","text":") calls "},{"type":"codeVoice","code":"stat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstat"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"lstat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstatat"},{"type":"text","text":" and "},{"type":"codeVoice","code":"statfs"},{"type":"text","text":". Traffluent calls none of it. If your app does, your manifest"},{"type":"text","text":" "},{"type":"text","text":"declares the file timestamp or disk space reason it needs."}]},{"type":"heading","level":3,"text":"Collected data","anchor":"Collected-data"},{"type":"paragraph","inlineContent":[{"text":"Every declaration below is ","type":"text"},{"code":"NSPrivacyCollectedDataTypeLinked","t