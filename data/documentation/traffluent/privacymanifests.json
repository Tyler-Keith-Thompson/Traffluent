t. If your app does, your manifest"},{"type":"text","text":" "},{"type":"text","text":"declares the file timestamp or disk space reason it needs."}],"type":"paragraph"},{"text":"Collected data","level":3,"anchor":"Collected-data","type":"heading"},{"inlineContent":[{"text":"Every declaration below is ","type":"text"},{"code":"NSPrivacyCollectedDataTypeLinked","type":"codeVoice"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" (Traffluent links nothing","type":"text"},{"text":" ","type":"text"},{"text":"to the user’s identity), ","type":"text"},{"code":"NSPrivacyCollectedDataTypeTracking","type":"codeVoice"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and has the one purpose","type":"text"},{"text":" ","type":"text"},{"code":"NSPrivacyCollectedDataTypePurposeAnalytics","type":"codeVoice"},{"text":". A module declares a type only when it makes data of","type":"text"},{"text":" ","type":"text"},{"text":"that type itself; it is collected only once your app turns the module on and delivers the records","type":"text"},{"text":" ","type":"text"},{"text":"off the device.","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Module","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Data type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"What it makes, once your app turns it on","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Device ID (","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeDeviceID"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"text":": the platform’s ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":", as a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" ","type":"text"},{"code":"VendorIdentifierKey","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Other Diagnostic Data (","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":", "},{"type":"codeVoice","code":"device()"},{"type":"text","text":", "},{"type":"codeVoice","code":"operatingSystem()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"network()"},{"type":"text","text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Other Data Types (","type":"text"},{"code":"NSPrivacyCollectedDataTypeOtherDataTypes","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.locale()"},{"type":"text","text":": the user’s locale."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Product Interaction (","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeProductInteraction"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":", and the events "},{"type":"codeVoice","code":"trackOnAppear(