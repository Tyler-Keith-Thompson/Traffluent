{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/privacymanifests"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Traffluent collects nothing on its own. It records only the events your app tracks and the","type":"text"},{"text":" ","type":"text"},{"text":"context your app turns on: every kind of automatic instrumentation and every standard enricher is","type":"text"},{"text":" ","type":"text"},{"text":"opt in. It sends records only to the destinations your app gives a delivery, to endpoints your app","type":"text"},{"text":" ","type":"text"},{"text":"names. None of it is used for tracking as Apple defines it: no module links what it records with","type":"text"},{"text":" ","type":"text"},{"text":"other companies’ data, reads the advertising identifier, fingerprints the device, or works around","type":"text"},{"text":" ","type":"text"},{"text":"the user’s consent or App Tracking Transparency. Every manifest declares ","type":"text"},{"code":"NSPrivacyTracking","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" and lists no tracking domains.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each module that can produce data of one of Apple’s collected data types ships a"},{"type":"text","text":" "},{"type":"codeVoice","code":"PrivacyInfo.xcprivacy"},{"type":"text","text":" declaring it. SwiftPM and Bazel both put it in a resource bundle named"},{"type":"text","text":" "},{"type":"codeVoice","code":"Traffluent_<Module>.bundle"},{"type":"text","text":", which Xcode and rules_apple copy into your app, where Xcode’s privacy"},{"type":"text","text":" "},{"type":"text","text":"report finds it. A module your app doesn’t link adds nothing to the report."}]},{"text":"Required-reason APIs","type":"heading","level":3,"anchor":"Required-reason-APIs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No Traffluent module calls an API on Apple’s list of required-reason APIs, so every manifest’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSPrivacyAccessedAPITypes"},{"type":"text","text":" is empty. The list’s categories are file timestamps"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryFileTimestamp"},{"type":"text","text":"), system boot time"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategorySystemBootTime"},{"type":"text","text":"), disk space"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryDiskSpace"},{"type":"text","text":"), active keyboards"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryActiveKeyboards"},{"type":"text","text":") and user defaults"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryUserDefaults"},{"type":"text","text":"). The modules that come nearest:"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Module"}],"type":"paragraph"}],[{"inlineContent":[{"text":"What it calls","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Why none is a required-reason API"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"swift-system’s "},{"type":"codeVoice","code":"FileDescriptor"},{"type":"text","text":" ("},{"type":"codeVoice","code":"open"},{"type":"text","text":", "},{"type":"codeVoice","code":"read"},{"type":"text","text":", "},{"type":"codeVoice","code":"write"},{"type":"text","text":", "},{"type":"codeVoice","code":"seek"},{"type":"text","text":", "},{"type":"codeVoice","code":"resize"},{"type":"text","text":", "},{"type":"codeVoice","code":"close"},{"type":"text","text":"), "},{"type":"codeVoice","code":"fsync"},{"type":"text","text":", "},{"type":"codeVoice","code":"unlink"},{"type":"text","text":", and "},{"type":"codeVoice","code":"FileManager"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"createDirectory"},{"type":"text","text":", "},{"type":"codeVoice","code":"setAttributes"},{"type":"text","text":" (the file protection class), "},{"type":"codeVoice","code":"contentsOfDirectory"},{"type":"text","text":" and "},{"type":"codeVoice","code":"isExcludedFromBackup"}],"type":"paragraph"}],[{"inlineContent":[{"text":"It reads no file’s timestamps, size from ","type":"text"},{"code":"stat","type":"codeVoice"},{"text":", or the volume’s free space: a segment’s size is the offset ","type":"text"},{"code":"seek","type":"codeVoice"},{"text":" returns at its end, and the store bounds itself by the bytes it has written.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"FileManager.fileExists","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Data(contentsOf:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Data.write(to:options:)","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"FileVersionStore","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"ProcessInfo.performExpiringActivity","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"It reads and writes the version file’s contents, never its attributes.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"type":"text","text":" for "},{"type":"codeVoice","code":"hw.machine"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hw.model"},{"type":"text","text":", "},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"Locale.current"},{"type":"text","text":", "},{"type":"codeVoice","code":"NWPathMonitor"},{"type":"text","text":", "},{"type":"codeVoice","code":"identifierForVendor"}],"type":"paragraph"}],[{"inlineContent":[{"text":"None is on the list; ","type":"text"},{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"text":" is declared as collected data below.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"type":"codeVoice","code":"Date"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Date.now"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Wall-clock time, not boot time."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ContinuousClock"},{"text":", the default clock of ","type":"text"},{"type":"codeVoice","code":"batch()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The Swift runtime’s clock, which isn’t on the list.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"GRDB"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"GRDB ships a privacy manifest of its own."}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,"},{"type":"text","text":" "},{"type":"text","text":"swift-system’s "},{"type":"codeVoice","code":"Stat"},{"type":"text","text":" API ("},{"type":"codeVoice","code":"FilePath.stat()"},{"type":"text","text":", "},{"type":"codeVoice","code":"FileDescriptor.stat()"},{"type":"text","text":") calls "},{"type":"codeVoice","code":"stat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstat"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"lstat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstatat"},{"type":"text","text":" and "},{"type":"codeVoice","code":"statfs"},{"type":"text","text":". Traffluent calls none of it. If your app does, your manifest"},{"type":"text","text":" "},{"type":"text","text":"declares the file timestamp or disk space reason it needs."}]},{"text":"Collected data","type":"heading","level":3,"anchor":"Collected-data"},{"type":"paragraph","inlineContent":[{"text":"Every declaration below is ","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeLinked"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" (Traffluent links nothing","type":"text"},{"text":" ","type":"text"},{"text":"to the user’s identity), ","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeTracking"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", and has the one purpose","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypePurposeAnalytics"},{"text":". A module declares a type only when it makes data of","type":"text"},{"text":" ","type":"text"},{"text":"that type itself; it is collected only once your app turns the module on and delivers the records","type":"text"},{"text":" ","type":"text"},{"text":"off the device.","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Module"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Data type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Device ID ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeDeviceID"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":": the platform’s "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":", as a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"codeVoice","code":"VendorIdentifierKey"},{"type":"text","text":"."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Other Diagnostic Data ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Enricher.application()","type":"codeVoice"},{"type":"text","text":", "},{"code":"device()","type":"codeVoice"},{"type":"text","text":", "},{"code":"operatingSystem()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"network()","type":"codeVoice"},{"type":"text","text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Other Data Types ("},{"code":"NSPrivacyCollectedDataTypeOtherDataTypes","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Enricher.locale()","type":"codeVoice"},{"type":"text","text":": the user’s locale."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Product Interaction (","type":"text"},{"code":"NSPrivacyCollectedDataTypeProductInteraction","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":", and the events "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" track as the user moves through the app."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Product Interaction","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The events "},{"code":"UIControl.track(_:for:)","type":"codeVoice"},{"type":"text","text":" tracks when a control’s action fires."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Product Interaction","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The events "},{"type":"codeVoice","code":"NSControl.track(_:)"},{"type":"text","text":" tracks when a control sends its action."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"trackScreensAutomatically"},{"type":"text","text":": a "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" per screen, named after its view controller or SwiftUI view type."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction"}],"type":"paragraph"}],[{"inlineContent":[{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":": a ","type":"text"},{"code":"ControlActivated","type":"codeVoice"},{"text":" per touch that activates a control, named by its accessibility identifier, never its text.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Product Interaction","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"trackLifecycle","type":"codeVoice"},{"text":": the app’s installs, updates (with the versions), opens, moves to the background and terminations.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Enricher.sessions(timeout:kinds:)","type":"codeVoice"},{"type":"text","text":": a random session identifier held in memory only, and "},{"code":"SessionStarted","type":"codeVoice"},{"type":"text","text":" and "},{"code":"SessionEnded","type":"codeVoice"},{"type":"text","text":" with the session’s duration."}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The rest ship no manifest: ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Checksums\/documentation\/Checksums","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","isActive":true,"type":"reference"},{"text":" neither call a required-reason API nor make data of their own. They carry, store and send the events and","type":"text"},{"text":" ","type":"text"},{"text":"context your app and the modules above make.","type":"text"}]},{"text":"Your app’s manifest and privacy labels","type":"heading","level":3,"anchor":"Your-apps-manifest-and-privacy-labels"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Traffluent’s manifests cover what its modules make. Your app’s manifest and its App Store privacy"},{"type":"text","text":" "},{"type":"text","text":"labels also cover what your app adds:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Your events."}]},{"type":"text","text":" Each event type your app tracks is data your app collects: declare the type its"},{"type":"text","text":" "},{"type":"text","text":"properties hold (Product Interaction for taps and views, Purchase History for an order, and so"},{"type":"text","text":" "},{"type":"text","text":"on)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Your identifiers.","type":"text"}]},{"type":"text","text":" An identifier your app adds with an enricher of its own, such as an account"},{"type":"text","text":" "},{"type":"text","text":"identifier, is a User ID, linked to the user ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Your destinations.","type":"text"}],"type":"strong"},{"text":" Where your destinations send records decides whether the data leaves the","type":"text"},{"text":" ","type":"text"},{"text":"device, and whether a third party receives it. If an endpoint you send to uses the data for","type":"text"},{"text":" ","type":"text"},{"text":"tracking, your app’s manifest lists its domain under ","type":"text"},{"code":"NSPrivacyTrackingDomains","type":"codeVoice"},{"text":", and your app","type":"text"},{"text":" ","type":"text"},{"text":"asks for permission through App Tracking Transparency first.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Modules you turn off."}],"type":"strong"},{"text":" If your app links a module but never turns it on, it collects nothing","type":"text"},{"text":" ","type":"text"},{"text":"through it, and your privacy labels can leave that data out.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"kind":"article","identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Article","role":"article","title":"Privacy Manifests"},"sections":[],"seeAlsoSections":[{"anchor":"Choosing-what-to-record","generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"],"title":"Choosing what to record"}],"abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"references":{"doc://Traffluent/documentation/Traffluent/WhatGoesWhere":{"url":"\/documentation\/traffluent\/whatgoeswhere","abstract":[{"type":"text","text":"Four signals, four jobs. Decide which one a fact belongs to before you write the line that records it."}],"kind"