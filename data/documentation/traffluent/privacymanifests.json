nce","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"GRDB","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"GRDB ships a privacy manifest of its own."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"swift-crypto’s ","type":"text"},{"code":"SHA256","type":"codeVoice"},{"text":", which is CryptoKit’s on Apple platforms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Hashing is on no list. swift-crypto’s ","type":"text"},{"code":"Crypto","type":"codeVoice"},{"text":" bundles a privacy manifest of its own on Apple platforms, declaring no tracking, no required-reason API and no collected data.","type":"text"}]}]]]},{"inlineContent":[{"type":"text","text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,"},{"type":"text","text":" "},{"type":"text","text":"swift-system’s "},{"type":"codeVoice","code":"Stat"},{"type":"text","text":" API ("},{"type":"codeVoice","code":"FilePath.stat()"},{"type":"text","text":", "},{"type":"codeVoice","code":"FileDescriptor.stat()"},{"type":"text","text":") calls "},{"type":"codeVoice","code":"stat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstat"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"lstat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstatat"},{"type":"text","text":" and "},{"type":"codeVoice","code":"statfs"},{"type":"text","text":". Traffluent calls none of it. If your app does, your manifest"},{"type":"text","text":" "},{"type":"text","text":"declares the file timestamp or disk space reason it needs."}],"type":"paragraph"},{"anchor":"Collected-data","level":3,"text":"Collected data","type":"heading"},{"inlineContent":[{"text":"Every declaration below is ","type":"text"},{"code":"NSPrivacyCollectedD