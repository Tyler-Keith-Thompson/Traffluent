{"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"article","title":"Privacy Manifests","roleHeading":"Article","modules":[{"name":"Traffluent"}]},"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"],"title":"Choosing what to record","anchor":"Choosing-what-to-record","generated":true}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Traffluent collects nothing on its own. It records only the events your app tracks and the","type":"text"},{"text":" ","type":"text"},{"text":"context your app turns on: every kind of automatic instrumentation and every standard enricher is","type":"text"},{"text":" ","type":"text"},{"text":"opt in. It sends records only to the destinations your app gives a delivery, to endpoints your app","type":"text"},{"text":" ","type":"text"},{"text":"names. None of it is used for tracking as Apple defines it: no module links what it records with","type":"text"},{"text":" ","type":"text"},{"text":"other companies’ data, reads the advertising identifier, fingerprints the device, or works around","type":"text"},{"text":" ","type":"text"},{"text":"the user’s consent or App Tracking Transparency. Every manifest declares ","type":"text"},{"type":"codeVoice","code":"NSPrivacyTracking"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" and lists no tracking domains.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each module that can produce data of one of Apple’s collected data types ships a","type":"text"},{"text":" ","type":"text"},{"code":"PrivacyInfo.xcprivacy","type":"codeVoice"},{"text":" declar