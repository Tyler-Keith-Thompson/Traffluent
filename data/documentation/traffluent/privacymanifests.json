Voice"},{"type":"text","text":", which Xcode and rules_apple copy into your app, where Xcode’s privacy"},{"type":"text","text":" "},{"type":"text","text":"report finds it. A module your app doesn’t link adds nothing to the report."}],"type":"paragraph"},{"level":3,"text":"Required-reason APIs","anchor":"Required-reason-APIs","type":"heading"},{"inlineContent":[{"text":"No Traffluent module calls an API on Apple’s list of required-reason APIs, so every manifest’s","type":"text"},{"text":" ","type":"text"},{"code":"NSPrivacyAccessedAPITypes","type":"codeVoice"},{"text":" is empty. The list’s categories are file timestamps","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryFileTimestamp","type":"codeVoice"},{"text":"), system boot time","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategorySystemBootTime","type":"codeVoice"},{"text":"), disk space","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryDiskSpace","type":"codeVoice"},{"text":"), active keyboards","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryActiveKeyboards","type":"codeVoice"},{"text":") and user defaults","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryUserDefaults","type":"codeVoice"},{"text":"). The modules that come nearest:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Module"}]}],[{"type":"paragraph","inlineContent":[{"text":"What it calls","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Why none is a required-reason API"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text",