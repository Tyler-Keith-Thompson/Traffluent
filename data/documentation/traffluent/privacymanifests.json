e\/documentation\/Persistence","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"swift-system’s ","type":"text"},{"code":"FileDescriptor","type":"codeVoice"},{"text":" (","type":"text"},{"code":"open","type":"codeVoice"},{"text":", ","type":"text"},{"code":"read","type":"codeVoice"},{"text":", ","type":"text"},{"code":"write","type":"codeVoice"},{"text":", ","type":"text"},{"code":"seek","type":"codeVoice"},{"text":", ","type":"text"},{"code":"resize","type":"codeVoice"},{"text":", ","type":"text"},{"code":"close","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":", ","type":"text"},{"code":"unlink","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"FileManager","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"createDirectory","type":"codeVoice"},{"text":", ","type":"text"},{"code":"setAttributes","type":"codeVoice"},{"text":" (the file protection class), ","type":"text"},{"code":"contentsOfDirectory","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"isExcludedFromBackup","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"It reads no file’s timestamps, size from ","type":"text"},{"type":"codeVoice","code":"stat"},{"text":", or the volume’s free space: a segment’s size is the offset ","type":"text"},{"type":"codeVoice","code":"seek"},{"text":" returns at its end, and the store bounds itself by the bytes it has written.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking"}],"type":"paragraph"}],[{"inlineContent":[{"code":"FileManager.fileExists","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Data(contentsOf:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Data.write(to:options:)","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"FileVersionStore","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"ProcessInfo.performExpiringActivity","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"It reads and writes the version file’s contents, never its attributes.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"sysctlbyname","type":"codeVoice"},{"type":"text","text":" for "},{"code":"hw.machine","type":"codeVoice"},{"type":"text","text":" and "},{"code":"hw.model","type":"codeVoice"},{"type":"text","text":", "},{"code":"ProcessInfo.operatingSystemVersion","type":"codeVoice"},{"type":"text","text":", "},{"code":"Bundle.infoDictionary","type":"codeVoice"},{"type":"text","text":", "},{"code":"Locale.current","type":"codeVoice"},{"type":"text","text":", "},{"code":"NWPathMonitor","type":"codeVoice"},{"type":"text","text":", "},{"code":"identifierForVendor","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"None is on the list; "},{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"type":"text","text":" is declared as collected data below."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"The tracker’s record timestamps (","type":"text"},{"code":"Date","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Date.now"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Wall-clock time, not boot time.","type":"text"}],"type":"paragraph"}]],[[{"inlin