 your app does, your manifest","type":"text"},{"text":" ","type":"text"},{"text":"declares the file timestamp or disk space reason it needs.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Collected data","anchor":"Collected-data"},{"inlineContent":[{"type":"text","text":"Every declaration below is "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeLinked"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":" (Traffluent links nothing"},{"type":"text","text":" "},{"type":"text","text":"to the user’s identity), "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeTracking"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and has the one purpose"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypePurposeAnalytics"},{"type":"text","text":". A module declares a type only when it makes data of"},{"type":"text","text":" "},{"type":"text","text":"that type itself; it is collected only once your app turns the module on and delivers the records"},{"type":"text","text":" "},{"type":"text","text":"off the device."}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Module","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Data type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Device ID ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeDeviceID"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"text":": the platform’s ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"},{"text":", as a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" ","type":"text"},{"type":"codeVoice","code":"VendorIdentifierKey"},{"text":".","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"Other Diagnostic Data (","type":"text"},{"code":"NSPrivacyCollectedDataTypeOtherDiagnosticData","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Enricher.application()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"device()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"operatingSystem()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"network()"},{"text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other Data Types ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDataTypes"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.locale()","type":"codeVoice"},{"type":"text","text":": the user’s locale."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"}]}],[{"type":"paragraph","inlineContent":[{"text":"Product Interaction (","type":"text"},{"code":"NSPrivacyCollectedDataTypeProductInteraction","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":", and the events "