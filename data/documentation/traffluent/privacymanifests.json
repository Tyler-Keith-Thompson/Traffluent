":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Your identifiers.","type":"text"}],"type":"strong"},{"text":" An identifier your app adds with an enricher of its own, such as an account","type":"text"},{"text":" ","type":"text"},{"text":"identifier, is a User ID, linked to the user (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"reference"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Your destinations."}]},{"text":" Where your destinations send records decides whether the data leaves the","type":"text"},{"text":" ","type":"text"},{"text":"device, and whether a third party receives it. If an endpoint you send to uses the data for","type":"text"},{"text":" ","type":"text"},{"text":"tracking, your app’s manifest lists its domain under ","type":"text"},{"code":"NSPrivacyTrackingDomains","type":"codeVoice"},{"text":", and your app","type":"text"},{"text":" ","type":"text"},{"text":"asks for permission through App Tracking Transparency first.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modules you turn off."}]},{"type":"text","text":" If your app links a module but never turns it on, it collects nothing"},{"type":"text","text":" "},{"type":"text","text":"through it, and your privacy labels can leave that data out."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/traffluent\/privacymanifests"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}],"refe