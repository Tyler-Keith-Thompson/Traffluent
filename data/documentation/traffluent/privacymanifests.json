{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Article","role":"article","title":"Privacy Manifests"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Traffluent collects nothing on its own. It records only the events your app tracks and the"},{"type":"text","text":" "},{"type":"text","text":"context your app turns on: every kind of automatic instrumentation and every standard enricher is"},{"type":"text","text":" "},{"type":"text","text":"opt in. It sends records only to the destinations your app gives a delivery, to endpoints your app"},{"type":"text","text":" "},{"type":"text","text":"names. None of it is used for tracking as Apple defines it: no module links what it records with"},{"type":"text","text":" "},{"type":"text","text":"other companies’ data, reads the advertising identifier, fingerprints the device, or works around"},{"type":"text","text":" "},{"type":"text","text":"the user’s consent or App Tracking Transparency. Every manifest declares "},{"type":"codeVoice","code":"NSPrivacyTracking"},{"type":"text","text":" as"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":" and lists no tracking domains."}]},{"type":"paragraph","inlineContent":[{"text":"Each module that can produce data of one of Apple’s collected data types ships a","type":"text"},{"text":" ","type":"text"},{"code":"PrivacyInfo.xcprivacy","type":"codeVoice"},{"text":" declaring it. SwiftPM and Bazel both put it in a resource bundle named","type":"text"},{"text":" ","type":"text"},{"code":"Traffluent_<Module>.bundle","type":"codeVoice"},{"text":", which Xcode and rules_apple copy into your app, where Xcode’s privacy","type":"text"},{"text":" ","type":"text"},{"text":"report finds it. A module your app doesn’t link adds nothing to the report.","type":"text"}]},{"level":3,"type":"heading","anchor":"Required-reason-APIs","text":"Required-reason APIs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No Traffluent module calls an API on Apple’s list of required-reason APIs, so every manifest’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSPrivacyAccessedAPITypes"},{"type":"text","text":" is empty. The list’s categories are file timestamps"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryFileTimestamp"},{"type":"text","text":"), system boot time"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategorySystemBootTime"},{"type":"text","text":"), disk space"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryDiskSpace"},{"type":"text","text":"), active keyboards"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryActiveKeyboards"},{"type":"text","text":") and user defaults"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryUserDefaults"},{"type":"text","text":"). The modules that come nearest:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Module","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"What it calls","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Why none is a required-reason API"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"swift-system’s "},{"code":"FileDescriptor","type":"codeVoice"},{"type":"text","text":" ("},{"code":"open","type":"codeVoice"},{"type":"text","text":", "},{"code":"read","type":"codeVoice"},{"type":"text","text":", "},{"code":"write","type":"codeVoice"},{"type":"text","text":", "},{"code":"seek","type":"codeVoice"},{"type":"text","text":", "},{"code":"resize","type":"codeVoice"},{"type":"text","text":", "},{"code":"close","type":"codeVoice"},{"type":"text","text":"), "},{"code":"fsync","type":"codeVoice"},{"type":"text","text":", "},{"code":"unlink","type":"codeVoice"},{"type":"text","text":", and "},{"code":"FileManager","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"createDirectory","type":"codeVoice"},{"type":"text","text":", "},{"code":"setAttributes","type":"codeVoice"},{"type":"text","text":" (the file protection class), "},{"code":"contentsOfDirectory","type":"codeVoice"},{"type":"text","text":" and "},{"code":"isExcludedFromBackup","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"It reads no file’s timestamps, size from ","type":"text"},{"code":"stat","type":"codeVoice"},{"text":", or the volume’s free space: a segment’s size is the offset ","type":"text"},{"code":"seek","type":"codeVoice"},{"text":" returns at its end, and the store bounds itself by the bytes it has written.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FileManager.fileExists"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data(contentsOf:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Data.write(to:options:)"},{"type":"text","text":" in "},{"type":"codeVoice","code":"FileVersionStore"},{"type":"text","text":"; "},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"It reads and writes the version file’s contents, never its attributes."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"type":"text","text":" for "},{"type":"codeVoice","code":"hw.machine"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hw.model"},{"type":"text","text":", "},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"Locale.current"},{"type":"text","text":", "},{"type":"codeVoice","code":"NWPathMonitor"},{"type":"text","text":", "},{"type":"codeVoice","code":"identifierForVendor"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"None is on the list; "},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":" is declared as collected data below."}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"type":"codeVoice","code":"Date"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime."}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Date.now"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wall-clock time, not boot time."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":", the default clock of "},{"type":"codeVoice","code":"batch()"}]}],[{"type":"paragraph","inlineContent":[{"text":"The Swift runtime’s clock, which isn’t on the list.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"}]}],[{"type":"paragraph","inlineContent":[{"text":"GRDB","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"GRDB ships a privacy manifest of its own.","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,","type":"text"},{"text":" ","type":"text"},{"text":"swift-system’s ","type":"text"},{"code":"Stat","type":"codeVoice"},{"text":" API (","type":"text"},{"code":"FilePath.stat()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FileDescriptor.stat()","type":"codeVoice"},{"text":") calls ","type":"text"},{"code":"stat","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fstat","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"lstat","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fstatat","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"statfs","type":"codeVoice"},{"text":". Traffluent calls none of it. If your app does, your manifest","type":"text"},{"text":" ","type":"text"},{"text":"declares the file timestamp or disk space reason it needs.","type":"text"}]},{"level":3,"type":"heading","anchor":"Collected-data","text":"Collected data"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every declaration below is "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeLinked"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":" (Traffluent links nothing"},{"type":"text","text":" "},{"type":"text","text":"to the user’s identity), "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeTracking"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and has the one purpose"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypePurposeAnalytics"},{"type":"text","text":". A module declares a type only when it makes data of"},{"type":"text","text":" "},{"type":"text","text":"that type itself; it is collected only once your app turns the module on and delivers the records"},{"type":"text","text":" "},{"type":"text","text":"off the device."}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Module","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Data type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Device ID (","type":"text"},{"code":"NSPrivacyCollectedDataTypeDeviceID","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"type":"text","text":": the platform’s "},{"code":"identifierForVendor","type":"codeVoice"},{"type":"text","text":", as a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" "},{"code":"VendorIdentifierKey","type":"codeVoice"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other Diagnostic Data ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":", "},{"type":"codeVoice","code":"device()"},{"type":"text","text":", "},{"type":"codeVoice","code":"operatingSystem()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"network()"},{"type":"text","text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection."}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other Data Types ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDataTypes"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.locale()","type":"codeVoice"},{"text":": the user’s locale.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"Product Interaction (","type":"text"},{"code":"NSPrivacyCollectedDataTypeProductInteraction","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"ScreenViewed","type":"codeVoice"},{"type":"text","text":", and the events "},{"code":"trackOnAppear(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"trackOnTap(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"trackChange(of:_:)","type":"codeVoice"},{"type":"text","text":" track as the user moves through the app."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Product Interaction","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The events ","type":"text"},{"code":"UIControl.track(_:for:)","type":"codeVoice"},{"text":" tracks when a control’s action fires.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"reference","isActiv