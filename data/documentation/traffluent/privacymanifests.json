es the"},{"type":"text","text":" "},{"type":"text","text":"device, and whether a third party receives it. If an endpoint you send to uses the data for"},{"type":"text","text":" "},{"type":"text","text":"tracking, your app’s manifest lists its domain under "},{"code":"NSPrivacyTrackingDomains","type":"codeVoice"},{"type":"text","text":", and your app"},{"type":"text","text":" "},{"type":"text","text":"asks for permission through App Tracking Transparency first."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Modules you turn off.","type":"text"}],"type":"strong"},{"text":" If your app links a module but never turns it on, it collects nothing","type":"text"},{"text":" ","type":"text"},{"text":"through it, and your privacy labels can leave that data out.","type":"text"}]}]}],"type":"unorderedList"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"},"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"],"generated":true,"title":"Choosing what to record","anchor":"Choosing-what-to-record"}],"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Article","title":"Privacy Manifests","role":"article"},"abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/privacymanifests"]}],"sections":[],"references":{"doc://LoggingDestinations/documentation/LoggingDestinations":{"identifier":"doc:\/\/LoggingDestinations\/documentation\/Lo