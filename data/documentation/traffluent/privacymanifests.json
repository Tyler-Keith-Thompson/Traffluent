e":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FileManager.fileExists"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data(contentsOf:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Data.write(to:options:)"},{"type":"text","text":" in "},{"type":"codeVoice","code":"FileVersionStore"},{"type":"text","text":"; "},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"It reads and writes the version file’s contents, never its attributes."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"hw.machine"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hw.model"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Locale.current"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NWPathMonitor"},{"text":", ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"}]}],[{"type":"paragraph","inlineContent":[{"text":"None is on the list; ","type":"text"},{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"text":" is declared as collected data below.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"type":"codeVoice","code":"Date"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s 