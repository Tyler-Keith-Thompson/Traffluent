":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Traffluent_<Module>.bundle"},{"text":", which Xcode and rules_apple copy into your app, where Xcode’s privacy","type":"text"},{"text":" ","type":"text"},{"text":"report finds it. A module your app doesn’t link adds nothing to the report.","type":"text"}]},{"type":"heading","level":3,"text":"Required-reason APIs","anchor":"Required-reason-APIs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No Traffluent module calls an API on Apple’s list of required-reason APIs, so every manifest’s"},{"type":"text","text":" "},{"code":"NSPrivacyAccessedAPITypes","type":"codeVoice"},{"type":"text","text":" is empty. The list’s categories are file timestamps"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"NSPrivacyAccessedAPICategoryFileTimestamp","type":"codeVoice"},{"type":"text","text":"), system boot time"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"NSPrivacyAccessedAPICategorySystemBootTime","type":"codeVoice"},{"type":"text","text":"), disk space"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"NSPrivacyAccessedAPICategoryDiskSpace","type":"codeVoice"},{"type":"text","text":"), active keyboards"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"NSPrivacyAccessedAPICategoryActiveKeyboards","type":"codeVoice"},{"type":"text","text":") and user defaults"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"NSPrivacyAccessedAPICategoryUserDefaults","type":"codeVoice"},{"type":"text","text":"). The modules that come nearest:"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Module"}],"type":"paragraph"}],[{"inlineContent":[{"text":"What it calls","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Why none is a required-reason API","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence","isActive":true}],"type":