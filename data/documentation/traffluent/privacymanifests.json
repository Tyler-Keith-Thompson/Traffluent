{"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Traffluent collects nothing on its own. It records only the events your app tracks and the","type":"text"},{"text":" ","type":"text"},{"text":"context your app turns on: every kind of automatic instrumentation and every standard enricher is","type":"text"},{"text":" ","type":"text"},{"text":"opt in. It sends records only to the destinations your app gives a delivery, to endpoints your app","type":"text"},{"text":" ","type":"text"},{"text":"names. None of it is used for tracking as Apple defines it: no module links what it records with","type":"text"},{"text":" ","type":"text"},{"text":"other companies’ data, reads the advertising identifier, fingerprints the device, or works around","type":"text"},{"text":" ","type":"text"},{"text":"the user’s consent or App Tracking Transparency. Every manifest declares ","type":"text"},{"code":"NSPrivacyTracking","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" and lists no tracking domains.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each module that can produce data of one of Apple’s collected data types ships a","type":"text"},{"text":" ","type":"text"},{"code":"PrivacyInfo.xcprivacy","type":"codeVoice"},{"text":" declaring it. SwiftPM and Bazel both put it in a resource bundle named","type":"text"},{"text":" ","type":"text"},{"code":"Traffluent_<Module>.bundle","type":"codeVoice"},{"text":", which Xcode and rules_apple copy into your app, where Xcode’s privacy","type":"text"},{"text":" ","type":"text"},{"text":"report finds it. A module your app doesn’t link adds nothing to the report.","type":"text"}]},{"type":"heading","level":3,"text":"Required-reason APIs","anchor":"Required-reason-APIs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No Traffluent module calls an API on Apple’s list of required-reason APIs, so every manifest’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSPrivacyAccessedAPITypes"},{"type":"text","text":" is empty. The list’s categories are file timestamps"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryFileTimestamp"},{"type":"text","text":"), system boot time"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategorySystemBootTime"},{"type":"text","text":"), disk space"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryDiskSpace"},{"type":"text","text":"), active keyboards"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryActiveKeyboards"},{"type":"text","text":") and user defaults"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryUserDefaults"},{"type":"text","text":"). The modules that come nearest:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Module"}]}],[{"type":"paragraph","inlineContent":[{"text":"What it calls","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Why none is a required-reason API","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"swift-system’s ","type":"text"},{"type":"codeVoice","code":"FileDescriptor"},{"text":" (","type":"text"},{"type":"codeVoice","code":"open"},{"text":", ","type":"text"},{"type":"codeVoice","code":"read"},{"text":", ","type":"text"},{"type":"codeVoice","code":"write"},{"text":", ","type":"text"},{"type":"codeVoice","code":"seek"},{"text":", ","type":"text"},{"type":"codeVoice","code":"resize"},{"text":", ","type":"text"},{"type":"codeVoice","code":"close"},{"text":"), ","type":"text"},{"type":"codeVoice","code":"fsync"},{"text":", ","type":"text"},{"type":"codeVoice","code":"unlink"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"FileManager"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"createDirectory"},{"text":", ","type":"text"},{"type":"codeVoice","code":"setAttributes"},{"text":" (the file protection class), ","type":"text"},{"type":"codeVoice","code":"contentsOfDirectory"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"isExcludedFromBackup"}]}],[{"type":"paragraph","inlineContent":[{"text":"It reads no file’s timestamps, size from ","type":"text"},{"type":"codeVoice","code":"stat"},{"text":", or the volume’s free space: a segment’s size is the offset ","type":"text"},{"type":"codeVoice","code":"seek"},{"text":" returns at its end, and the store bounds itself by the bytes it has written.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"FileManager.fileExists","type":"codeVoice"},{"type":"text","text":", "},{"code":"Data(contentsOf:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Data.write(to:options:)","type":"codeVoice"},{"type":"text","text":" in "},{"code":"FileVersionStore","type":"codeVoice"},{"type":"text","text":"; "},{"code":"ProcessInfo.performExpiringActivity","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"It reads and writes the version file’s contents, never its attributes."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"type":"text","text":" for "},{"typ