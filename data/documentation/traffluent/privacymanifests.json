":"declares the file timestamp or disk space reason it needs.","type":"text"}]},{"level":3,"anchor":"Collected-data","type":"heading","text":"Collected data"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every declaration below is "},{"code":"NSPrivacyCollectedDataTypeLinked","type":"codeVoice"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":" (Traffluent links nothing"},{"type":"text","text":" "},{"type":"text","text":"to the user’s identity), "},{"code":"NSPrivacyCollectedDataTypeTracking","type":"codeVoice"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and has the one purpose"},{"type":"text","text":" "},{"code":"NSPrivacyCollectedDataTypePurposeAnalytics","type":"codeVoice"},{"type":"text","text":". A module declares a type only when it makes data of"},{"type":"text","text":" "},{"type":"text","text":"that type itself; it is collected only once your app turns the module on and delivers the records"},{"type":"text","text":" "},{"type":"text","text":"off the device."}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Module","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Data type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Device ID (","type":"text"},{"code":"NSPrivacyCollectedDataTypeDeviceID","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":": the platform’s "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":", as a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"codeVoice","code":"VendorIdentifierKey"},{"type":"text","text":"."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Other Diagnostic Data ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Enricher.application()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"operatingSystem()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"network()","type":"codeVoice"},{"text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Other Data Types ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDataTypes"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Enricher.locale()","type":"codeVoice"},{"text":": the user’s locale.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Product Interaction (","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeProductInteraction"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":", and the events ","type":"text"},{"code":"trackOnAppear(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"trackOnTap(_:)",