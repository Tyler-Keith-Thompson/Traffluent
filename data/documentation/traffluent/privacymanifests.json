ctedDataTypeTracking","type":"codeVoice"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and has the one purpose","type":"text"},{"text":" ","type":"text"},{"code":"NSPrivacyCollectedDataTypePurposeAnalytics","type":"codeVoice"},{"text":". A module declares a type only when it makes data of","type":"text"},{"text":" ","type":"text"},{"text":"that type itself; it is collected only once your app turns the module on and delivers the records","type":"text"},{"text":" ","type":"text"},{"text":"off the device.","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Module"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Data type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Device ID ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeDeviceID"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"text":": the platform’s ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"},{"text":", as a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" ","type":"text"},{"type":"codeVoice","code":"VendorIdentifierKey"},{"text":".","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Other Diagnostic Data ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":", "},{"type":"codeVoice","code":"device()"},{"type":"text","text":", "},{"type":"codeVoice","code":"operatingSystem()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"network()"},{"type":"text","text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Other Data Types ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDataTypes"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.locale()"},{"type":"text","text":": the user’s locale."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction ("},{"code":"NSPrivacyCollectedDataTypeProductInteraction","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":", and the events ","type":"text"},{"code":"trackOnAppear(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"trackOnTap(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"trackChange(of:_:)","type":"codeVoice"},{"text":" track as the user moves through the app.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Product Interaction","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The events "},{"type":"codeVoice","code":"UIControl.track(_:for:)"},{"type"