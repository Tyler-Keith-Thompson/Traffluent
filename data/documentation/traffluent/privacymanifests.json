ode":"hw.model"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Locale.current"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NWPathMonitor"},{"text":", ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"None is on the list; "},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":" is declared as collected data below."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"The tracker’s record timestamps (","type":"text"},{"type":"codeVoice","code":"Date"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"Date.now","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Wall-clock time, not boot time.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"ContinuousClock","type":"codeVoice"},{"text":", the default clock of ","type":"text"},{"code":"batch()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift runtime’s clock, which isn’t on the list."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"}]}],[{"type":"paragraph","inlineContent":[{"text":"GRDB","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"GRDB ships a privacy manifest of its own."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"swift-crypto’s "},{"type":"codeVoice","code":"SHA256"},{"type":"text","text":", which is CryptoKit’s on Apple platforms"}]}],[{"type":"paragraph","inlineContent":[{"text":"Hashing is on no list. swift-crypto’s ","type":"text"},{"type":"codeVoice","code":"Crypto"},{"text":" bundles a privacy manifest of its own on Apple platforms, declaring no tracking, no required-reason API and no collected data.","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,","type":"text"},{"text":" ","type":"text"},{"text":"swift-system’s ","type":"text"},{"type":"codeVoice","code":"Stat"},{"text":" API (","type":"text"},{"type":"codeVoice","code":"FilePath.stat()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"FileDescriptor.stat()"},{"text":") calls ","type":"text"},{"type":"codeVoice","code":"stat"},{"text":", ","type":"text"},{"type":"codeVoice","code":"fstat"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lstat"},{"text":", ","type":"text"},{"type":"codeVoice","code":"fstatat"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"statfs"},{"text":". Traffluent calls none of it. If your app does, your manifest","type":"text"},{"text":" ","type":"text"},{"text":"declares the file timestamp or disk space reason it needs.","type":"text"}]},{"level":3,"anchor":"Collected-data","type":"heading","text":"Collected data"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every declaration below is "},{"code":"