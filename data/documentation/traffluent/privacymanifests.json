{"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/traffluent\/privacymanifests"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Article","role":"article","title":"Privacy Manifests","modules":[{"name":"Traffluent"}]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"],"title":"Essentials","anchor":"Essentials"}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Traffluent collects nothing on its own. It records only the events your app tracks and the"},{"type":"text","text":" "},{"type":"text","text":"context your app turns on: every kind of automatic instrumentation and every standard enricher is"},{"type":"text","text":" "},{"type":"text","text":"opt in. It sends records only to the destinations your app gives a delivery, to endpoints your app"},{"type":"text","text":" "},{"type":"text","text":"names. None of it is used for tracking as Apple defines it: no module links what it records with"},{"type":"text","text":" "},{"type":"text","text":"other companies’ data, reads the advertising identifier, fingerprints the device, or works around"},{"type":"text","text":" "},{"type":"text","text":"the user’s consent or App Tracking Transparency. Every manifest declares "},{"code":"NSPrivacyTracking","type":"codeVoice"},{"type":"text","text":" as"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":" and lists no tracking domains."}]},{"type":"paragraph","inlineContent":[{"text":"Each module that can produce data of one of Apple’s collected data types ships a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PrivacyInfo.xcprivacy"},{"text":" declaring it. SwiftPM and Bazel both put it in a resource bundle named","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Traffluent_<Module>.bundle"},{"text":", which Xcode and rules_apple copy into your app, where Xcode’s privacy","type":"text"},{"text":" ","type":"text"},{"text":"report finds it. A module your app doesn’t link adds nothing to the report.","type":"text"}]},{"type":"heading","anchor":"Required-reason-APIs","level":3,"text":"Required-reason APIs"},{"type":"paragraph","inlineContent":[{"text":"No Traffluent module calls an API on Apple’s list of required-reason APIs, so every manifest’s","type":"text"},{"text":" ","type":"text"},{"code":"NSPrivacyAccessedAPITypes","type":"codeVoice"},{"text":" is empty. The list’s categories are file timestamps","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryFileTimestamp","type":"codeVoice"},{"text":"), system boot time","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategorySystemBootTime","type":"codeVoice"},{"text":"), disk space","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryDiskSpace","type":"codeVoice"},{"text":"), active keyboards","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryActiveKeyboards","type":"codeVoice"},{"text":") and user defaults","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryUserDefaults","type":"codeVoice"},{"text":"). The modules that come nearest:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Module"}],"type":"paragraph"}],[{"inlineContent":[{"text":"What it calls","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Why none is a required-reason API"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"swift-system’s "},{"type":"codeVoice","code":"FileDescriptor"},{"type":"text","text":" ("},{"type":"codeVoice","code":"open"},{"type":"text","text":", "},{"type":"codeVoice","code":"read"},{"type":"text","text":", "},{"type":"codeVoice","code":"write"},{"type":"text","text":", "},{"type":"codeVoice","code":"seek"},{"type":"text","text":", "},{"type":"codeVoice","code":"resize"},{"type":"text","text":", "},{"type":"codeVoice","code":"close"},{"type":"text","text":"), "},{"type":"codeVoice","code":"fsync"},{"type":"text","text":", "},{"type":"codeVoice","code":"unlink"},{"type":"text","text":", and "},{"type":"codeVoice","code":"FileManager"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"createDirectory"},{"type":"text","text":", "},{"type":"codeVoice","code":"setAttributes"},{"type":"text","text":" (the file protection class), "},{"type":"codeVoice","code":"contentsOfDirectory"},{"type":"text","text":" and "},{"type":"codeVoice","code":"isExcludedFromBackup"}],"type":"paragraph"}],[{"inlineContent":[{"text":"It reads no file’s timestamps, size from ","type":"text"},{"code":"stat","type":"codeVoice"},{"text":", or the volume’s free space: a segment’s size is the offset ","type":"text"},{"code":"seek","type":"codeVoice"},{"text":" returns at its end, and the store bounds itself by the bytes it has written.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"FileManager.fileExists","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Data(contentsOf:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Data.write(to:opti