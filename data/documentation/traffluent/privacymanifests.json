attributes."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"hw.machine"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hw.model"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Locale.current"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NWPathMonitor"},{"text":", ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"None is on the list; "},{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"type":"text","text":" is declared as collected data below."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"type":"codeVoice","code":"Date"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"Date.now","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Wall-clock time, not boot time."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Conti