{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"Traffluent"}],"role":"article","roleHeading":"Article","title":"Privacy Manifests"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/privacymanifests"]}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"Traffluent collects nothing on its own. It records only the events your app tracks and the","type":"text"},{"text":" ","type":"text"},{"text":"context your app turns on: every kind of automatic instrumentation and every standard enricher is","type":"text"},{"text":" ","type":"text"},{"text":"opt in. It sends records only to the destinations your app gives a delivery, to endpoints your app","type":"text"},{"text":" ","type":"text"},{"text":"names. None of it is used for tracking as Apple defines it: no module links what it records with","type":"text"},{"text":" ","type":"text"},{"text":"other companies’ data, reads the advertising identifier, fingerprints the device, or works around","type":"text"},{"text":" ","type":"text"},{"text":"the user’s consent or App Tracking Transparency. Every manifest declares ","type":"text"},{"type":"codeVoice","code":"NSPrivacyTracking"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" and lists no tracking domains.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each module that can produce data of one of Apple’s collected data types ships a","type":"text"},{"text":" ","type":"text"},{"code":"PrivacyInfo.xcprivacy","type":"codeVoice"},{"text":" declaring it. SwiftPM and Bazel both put it in a resource bundle named","type":"text"},{"text":" ","type":"text"},{"code":"Traffluent_<Module>.bundle","type":"codeVoice"},{"text":", which Xcode and rules_apple copy into your app, where Xcode’s privacy","type":"text"},{"text":" ","type":"text"},{"text":"report finds it. A module your app doesn’t link adds nothing to the report.","type":"text"}],"type":"paragraph"},{"text":"Required-reason APIs","type":"heading","level":3,"anchor":"Required-reason-APIs"},{"inlineContent":[{"text":"No Traffluent module calls an API on Apple’s list of required-reason APIs, so every manifest’s","type":"text"},{"text":" ","type":"text"},{"code":"NSPrivacyAccessedAPITypes","type":"codeVoice"},{"text":" is empty. The list’s categories are file timestamps","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryFileTimestamp","type":"codeVoice"},{"text":"), system boot time","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategorySystemBootTime","type":"codeVoice"},{"text":"), disk space","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryDiskSpace","type":"codeVoice"},{"text":"), active keyboards","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryActiveKeyboards","type":"codeVoice"},{"text":") and user defaults","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryUserDefaults","type":"codeVoice"},{"text":"). The modules that come nearest:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Module","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"What it calls","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Why none is a required-reason API","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"swift-system’s ","type":"text"},{"type":"codeVoice","code":"FileDescri