It reads and writes the version file’s contents, never its attributes."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"sysctlbyname","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"hw.machine","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"hw.model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ProcessInfo.operatingSystemVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Bundle.infoDictionary","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Locale.current","type":"codeVoice"},{"text":", ","type":"text"},{"code":"NWPathMonitor","type":"codeVoice"},{"text":", ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"None is on the list; ","type":"text"},{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"text":" is declared as collected data below.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"type":"codeVoice","code":"Date"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime."}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Date.now"}]}],[{"type":"paragraph","inlineContent":[{"text":"Wall-clock time, not boot time.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations"}]}],[{"type":"pa