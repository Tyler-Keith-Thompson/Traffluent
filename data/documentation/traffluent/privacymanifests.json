s:)","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"FileVersionStore","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"ProcessInfo.performExpiringActivity","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"It reads and writes the version file’s contents, never its attributes."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"type":"text","text":" for "},{"type":"codeVoice","code":"hw.machine"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hw.model"},{"type":"text","text":", "},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"Locale.current"},{"type":"text","text":", "},{"type":"codeVoice","code":"NWPathMonitor"},{"type":"text","text":", "},{"type":"codeVoice","code":"identifierForVendor"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"None is on the list; "},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":" is declared as collected data below."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"type":"codeVoice","code":"Date"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Date.now"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Wall-clock time, not boot time.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":", the default clock of "},{"type":"codeVoice","code":"batch()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The Swift runtime’s clock, which isn’t on the list."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"GRDB"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"GRDB ships a privacy manifest of its own."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"swift-crypto’s ","type":"text"},{"code":"SHA256","type":"codeVoice"},{"text":", which is CryptoKit’s on Apple platforms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Hashing is on no list. swift-crypto’s "},{"type":"codeVoice","code":"Crypto"},{"type":"text","text":" bundles a privacy manifest of its own on Apple platforms, declaring no tracking, no required-reason API and no collected data."}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,","type":"text"},{"text":" ","type":"text"},{"text":"swift-system’s ","type":"text"},{"code":"Stat","type":"codeVoice"},{"text":" API (","type":"text"},{"code":"FilePath.stat()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FileDescriptor.stat()","type":"codeVoice"},{"text":") calls ","type":"text"},{"code":"stat","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fstat","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"lstat","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fstatat","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"statfs","type":"codeVoice"},{"text":". Traffluent calls none of it. If your app does, your manifest","type":"text"},{"text":" ","type":"text"},{"text":"declares the file timestamp or disk space reason it needs.","type":"text"}]},{"type":"heading","text":"Collected data","level":3,"anchor":"Collected-data"},{"type":"paragraph","inlineContent":[{"text":"Every declaration below is ","type":"text"},{"code":"NSPrivacyCollectedDataTypeLinked","type":"codeVoice"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" (Traffluent links nothing","type":"text"},{"text":" ","type":"text"},{"text":"to the user’s identity), ","type":"text"},{"code":"NSPrivacyCollectedDataTypeTracking","type":"codeVoice"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and has the one purpose","type":"text"},{"text":" ","type":"text"},{"code":"NSPrivacyCollectedDataTypePurposeAnalytics","type":"codeVoice"},{"text":". A module declares a type only when it makes data of","type":"text"},{"text":" ","type":"text"},{"text":"that type itself; it is collected only once your app turns the module on and delivers the records","type":"text"},{"text":" ","type":"text"},{"text":"off the device.","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Module","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Data type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Device ID ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeDeviceID"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"text":": the platform’s ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":", as a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" ","type":"text"},{"code":"VendorIdentifierKey","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Other Diagnostic Data (","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":", "},{"type":"codeVoice","code":"device()"},{"type":"text","text":", "},{"type":"codeVoice","code":"operatingSystem()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"network()"},{"type":"text","text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Other Data Types ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDataTypes"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.locale()"},{"type":"text","text":": the user’s locale."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeProductInteraction"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":", and the events ","type":"text"},{"code":"trackOnAppear(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"trackOnTap(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"trackChange(of:_:)","type":"codeVoice"},{"text":" track as the user moves through the app.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Product Interaction","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The events "},{"code":"UIControl.track(_:for:)","type":"codeVoice"},{"type":"text","text":" tracks when a control’s action fires."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The events "},{"code":"NSControl.track(_:)","type":"codeVoice"},{"type":"text","text":" tracks when a control sends its action."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction"}],"type":"paragraph"}],[{"inlineContent":[{"code":"trackScreensAutomatically","type":"codeVoice"},{"text":": a ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" per screen, named after its view controller or SwiftUI view type.","type":"text"}],"type":"paragraph"}]],[[{"inlineCon