"},{"type":"text","text":"to the user’s identity), "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeTracking"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and has the one purpose"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypePurposeAnalytics"},{"type":"text","text":". A module declares a type only when it makes data of"},{"type":"text","text":" "},{"type":"text","text":"that type itself; it is collected only once your app turns the module on and delivers the records"},{"type":"text","text":" "},{"type":"text","text":"off the device."}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Module","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Data type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Device ID ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeDeviceID"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"text":": the platform’s ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":", as a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" ","type":"text"},{"code":"VendorIdentifierKey","type":"codeVoice"},{"text":".","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other Diagnostic Data ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineConten