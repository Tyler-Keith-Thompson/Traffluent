{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Traffluent collects nothing on its own. It records only the events your app tracks and the","type":"text"},{"text":" ","type":"text"},{"text":"context your app turns on: every kind of automatic instrumentation and every standard enricher is","type":"text"},{"text":" ","type":"text"},{"text":"opt in. It sends records only to the destinations your app gives a delivery, to endpoints your app","type":"text"},{"text":" ","type":"text"},{"text":"names. None of it is used for tracking as Apple defines it: no module links what it records with","type":"text"},{"text":" ","type":"text"},{"text":"other companies’ data, reads the advertising identifier, fingerprints the device, or works around","type":"text"},{"text":" ","type":"text"},{"text":"the user’s consent or App Tracking Transparency. Every manifest declares ","type":"text"},{"code":"NSPrivacyTracking","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" and lists no tracking domains.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each module that can produce data of one of Apple’s collected data types ships a","type":"text"},{"text":" ","type":"text"},{"code":"PrivacyInfo.xcprivacy","type":"codeVoice"},{"text":" declaring it. SwiftPM and Bazel both put it in a resource bundle named","type":"text"},{"text":" ","type":"text"},{"code":"Traffluent_<Module>.bundle","type":"codeVoice"},{"text":", which Xcode and rules_apple copy into your app, where Xcode’s privacy","type":"text"},{"text":" ","type":"text"},{"text":"report finds it. A module your app doesn’t link adds nothing to the report.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Required-reason-APIs","text":"Required-reason APIs","type":"heading"},{"inlineContent":[{"type":"text","text":"No Traffluent module calls an API on Apple’s list of required-reason APIs, so every manifest’s"},{"type":"text","text":" "},{"code":"NSPrivacyAccessedAPITypes","type":"codeVoice"},{"type":"text","text":" is empty. The list’s categories are file timestamps"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"NSPrivacyAccessedAPICategoryFileTimestamp","type":"codeVoice"},{"type":"text","text":"), system boot time"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"NSPrivacyAccessedAPICategorySystemBootTime","type":"codeVoice"},{"type":"text","text":"), disk space"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"NSPrivacyAccessedAPICategoryDiskSpace","type":"codeVoice"},{"type":"text","text":"), active keyboards"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"NSPrivacyAccessedAPICategoryActiveKeyboards","type":"codeVoice"},{"type":"text","text":") and user defaults"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"NSPrivacyAccessedAPICategoryUserDefaults","type":"codeVoice"},{"type":"text","text":"). The modules that come nearest:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Module"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What it calls"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Why none is a required-reason API"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"swift-system’s ","type":"text"},{"code":"FileDescriptor","type":"codeVoice"},{"text":" (","type":"text"},{"code":"open","type":"codeVoice"},{"text":", ","type":"text"},{"code":"read","type":"codeVoice"},{"text":", ","type":"text"},{"code":"write","type":"codeVoice"},{"text":", ","type":"text"},{"code":"seek","type":"codeVoice"},{"text":", ","type":"text"},{"code":"resize","type":"codeVoice"},{"text":", ","type":"text"},{"code":"close","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":", ","type":"text"},{"code":"unlink","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"FileManager","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"createDirectory","type":"codeVoice"},{"text":", ","type":"text"},{"code":"setAttributes","type":"codeVoice"},{"text":" (the file protection class), ","type":"text"},{"code":"contentsOfDirectory","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"isExcludedFromBackup","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"It reads no file’s timestamps, size from "},{"type":"codeVoice","code":"stat"},{"type":"text","text":", or the volume’s free space: a segment’s size is the offset "},{"type":"codeVoice","code":"seek"},{"type":"text","text":" returns at its end, and the store bounds itself by the bytes it has written."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"FileManager.fileExists"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data(contentsOf:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Data.write(to:options:)"},{"type":"text","text":" in "},{"type":"codeVoice","code":"FileVersionStore"},{"type":"text","text":"; "},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"}],"type":"paragraph"}],[{"inlineContent":[{"text":"It reads and writes the version file’s contents, never its attributes.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"hw.machine"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hw.model"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Locale.current"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NWPathMonitor"},{"text":", ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"}],"type":"paragraph"}],[{"inlineContent":[{"text":"None is on the list; ","type":"text"},{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"text":" is declared as collected data below.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"The tracker’s record timestamps (","type":"text"},{"type":"codeVoice","code":"Date"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"Date.now","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Wall-clock time, not boot time.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":", the default clock of "},{"type":"codeVoice","code":"batch()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The Swift runtime’s clock, which isn’t on the list."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"GRDB"}],"type":"paragraph"}],[{"inlineContent":[{"text":"GRDB ships a privacy manifest of its own.","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,"},{"type":"text","text":" "},{"type":"text","text":"swift-system’s "},{"type":"codeVoice","code":"Stat"},{"type":"text","text":" API ("},{"type":"codeVoice","code":"FilePath.stat()"},{"type":"text","text":", "},{"type":"codeVoice","code":"FileDescriptor.stat()"},{"type":"text","text":") calls "},{"type":"codeVoice","code":"stat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstat"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"lstat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstatat"},{"type":"text","text":" and "},{"type":"codeVoice","code":"statfs"},{"type":"text","text":". Traffluent calls none of it. If your app does, your manifest"},{"type":"text","text":" "},{"type":"text","text":"declares the file timestamp or disk space reason it needs."}],"type":"paragraph"},{"level":3,"anchor":"Collected-data","text":"Collected data","type":"heading"},{"inlineContent":[{"text":"Every declaration below is ","type":"text"},{"code":"NSPrivacyCollectedDataTypeLinked","type":"codeVoice"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" (Traffluent links nothing","type":"text"},{"text":" ","type":"text"},{"text":"to the user’s identity), ","type":"text"},{"code":"NSPrivacyCollectedDataTypeTracking","type":"codeVoice"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and has the one purpose","type":"text"},{"text":" ","type":"text"},{"code":"NSPrivacyCollectedDataTypePurposeAnalytics","type":"codeVoice"},{"text":". A module declares a type only when it makes data of","type":"text"},{"text":" ","type":"text"},{"text":"that type itself; it is collected only once your app turns the module on and delivers the records","type":"text"},{"text":" ","type":"text"},{"text":"off the device.","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Module","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Data type"}]}],[{"type":"paragraph","inlineContent":[{"text":"What it makes, once your app turns it on","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Device ID ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeDeviceID"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":": the platform’s "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":", as a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"codeVoice","code":"VendorIdentifierKey"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other Diagnostic Data ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":", "},{"type":"codeVoice","code":"device()"},{"type":"text","text":", "},{"type":"codeVoice","code":"operatingSystem()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"network()"},{"type":"text","text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other Data Types ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDataTypes"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Enricher.locale()"},{"text":": the user’s locale.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"Product Interaction (","type":"text"},{"code":"NSPrivacyCollectedDataTypeProductInteraction","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":", and the events "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" track as the user moves through the app."}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product Interaction"}]}],[{"type":"paragraph","inlineContent":[{"text":"The events ","type":"text"},{"type":"codeVoice","code":"UIControl.track(_:for:)"},{"text":" tracks when a control’s action fires.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product Interaction"}]}],[{"type":"para