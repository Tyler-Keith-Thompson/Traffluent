{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/privacymanifests"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"},"sections":[],"metadata":{"modules":[{"name":"Traffluent"}],"title":"Privacy Manifests","role":"article","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"abstract":[{"text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels.","type":"text"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/WhatGoesWhere","doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"],"title":"Essentials","anchor":"Essentials"}],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Traffluent collects nothing on its own. It records only the events your app tracks and the"},{"type":"text","text":" "},{"type":"text","text":"context your app turns on: every kind of automatic instrumentation and every standard enricher is"},{"type":"text","text":" "},{"type":"text","text":"opt in. It sends records only to the destinations your app gives a delivery, to endpoints your app"},{"type":"text","text":" "},{"type":"text","text":"names. None of it is used for tracking as Apple defines it: no module links what it records with"},{"type":"text","text":" "},{"type":"text","text":"other companies’ data, reads the advertising identifier, fingerprints the device, or works around"},{"type":"text","text":" "},{"type":"text","text":"the user’s consent or App Tracking Transparency. Every manifest declares "},{"type":"codeVoice","code":"NSPrivacyTracking"},{"type":"text","text":" as"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":" and lists no tracking domains."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each module that can produce data of one of Apple’s collected data types ships a"},{"type":"text","text":" "},{"type":"codeVoice","code":"PrivacyInfo.xcprivacy"},{"type":"text","text":" declaring it. SwiftPM and Bazel both put it in a resource bundle named"},{"type":"text","text":" "},{"type":"codeVoice","code":"Traffluent_<Module>.bundle"},{"type":"text","text":", which Xcode and rules_apple copy into your app, where Xcode’s privacy"},{"type":"text","text":" "},{"type":"text","text":"report finds it. A module your app doesn’t link adds nothing to the report."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Required-reason APIs","anchor":"Required-reason-APIs"},{"inlineContent":[{"text":"No Traffluent module calls an API on Apple’s list of required-reason APIs, so every manifest’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSPrivacyAccessedAPITypes"},{"text":" is empty. The list’s categories are file timestamps","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryFileTimestamp"},{"text":"), system boot time","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategorySystemBootTime"},{"text":"), disk space","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryDiskSpace"},{"text":"), active keyboards","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryActiveKeyboards"},{"text":") and user defaults","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryUserDefaults"},{"text":"). The modules that come nearest:","type":"text"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Module"}]}],[{"type":"paragraph","inlineContent":[{"text":"What it calls","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Why none is a required-reason API","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"swift-system’s "},{"type":"codeVoice","code":"FileDescriptor"},{"type":"text","text":" ("},{"type":"codeVoice","code":"open"},{"type":"text","text":", "},{"type":"codeVoice","code":"read"},{"type":"text","text":", "},{"type":"codeVoice","code":"write"},{"type":"text","text":", "},{"type":"codeVoice","code":"seek"},{"type":"text","text":", "},{"type":"codeVoice","code":"resize"},{"type":"text","text":", "},{"type":"codeVoice","code":"close"},{"type":"text","text":"), "},{"type":"codeVoice","code":"fsync"},{"type":"text","text":", "},{"type":"codeVoice","code":"unlink"},{"type":"text","text":", and "},{"type":"codeVoice","code":"FileManager"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"createDirectory"},{"type":"text","text":", "},{"type":"codeVoice","code":"setAttributes"},{"type":"text","text":" (the file protection class), "},{"type":"codeVoice","code":"contentsOfDirectory"},{"type":"text","text":" and "},{"type":"codeVoice","code":"isExcludedFromBackup"}]}],[{"type":"paragraph","inlineContent":[{"text":"It reads no file’s timestamps, size from ","type":"text"},{"type":"codeVoice","code":"stat"},{"text":", or the volume’s free space: a segment’s size is the offset ","type":"text"},{"type":"codeVoice","code":"seek"},{"text":" returns at its end, and the store bounds itself by the bytes it has written.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FileManager.fileExists"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Data(contentsOf:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Data.write(to:options:)"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"FileVersionStore"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"It reads and writes the version file’s contents, never its attributes."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"sysctlbyname","type":"codeVoice"},{"type":"text","text":" for "},{"code":"hw.machine","type":"codeVoice"},{"type":"text","text":" and "},{"code":"hw.model","type":"codeVoice"},{"type":"text","text":", "},{"code":"ProcessInfo.operatingSystemVersion","type":"codeVoice"},{"type":"text","text":", "},{"code":"Bundle.infoDictionary","type":"codeVoice"},{"type":"text","text":", "},{"code":"Locale.current","type":"codeVoice"},{"type":"text","text":", "},{"code":"NWPathMonitor","type":"codeVoice"},{"type":"text","text":", "},{"code":"identifierForVendor","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"None is on the list; "},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":" is declared as collected data below."}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"code":"Date","type":"codeVoice"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A session’s inactivity is 