e version file’s contents, never its attributes.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"sysctlbyname","type":"codeVoice"},{"type":"text","text":" for "},{"code":"hw.machine","type":"codeVoice"},{"type":"text","text":" and "},{"code":"hw.model","type":"codeVoice"},{"type":"text","text":", "},{"code":"ProcessInfo.operatingSystemVersion","type":"codeVoice"},{"type":"text","text":", "},{"code":"Bundle.infoDictionary","type":"codeVoice"},{"type":"text","text":", "},{"code":"Locale.current","type":"codeVoice"},{"type":"text","text":", "},{"code":"NWPathMonitor","type":"codeVoice"},{"type":"text","text":", "},{"code":"identifierForVendor","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"None is on the list; ","type":"text"},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"text":" is declared as collected data below.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The tracker’s record timestamps (","type":"text"},{"type":"codeVoice","code":"Date"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Date.now"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Wall-clock time, not boot time."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"reference"}],"type":"paragraph"}],[