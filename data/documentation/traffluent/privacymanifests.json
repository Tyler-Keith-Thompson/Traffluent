a.write(to:options:)","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"FileVersionStore","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"ProcessInfo.performExpiringActivity","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"It reads and writes the version file’s contents, never its attributes.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"type":"text","text":" for "},{"type":"codeVoice","code":"hw.machine"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hw.model"},{"type":"text","text":", "},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"Locale.current"},{"type":"text","text":", "},{"type":"codeVoice","code":"NWPathMonitor"},{"type":"text","text":", "},{"type":"codeVoice","code":"identifierForVendor"}],"type":"paragraph"}],[{"inlineContent":[{"text":"None is on the list; ","type":"text"},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"text":" is declared as collected data below.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"type":"codeVoice","code":"Date"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Date.now","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Wall-clock time, not boot time."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":", the default clock of "},{"code":"batch()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The Swift runtime’s clock, which isn’t on the list.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"}],"type":"paragraph"}],[{"inlineContent":[{"text":"GRDB","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"GRDB ships a privacy manifest of its own."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"}],"type":"paragraph"}],[{"inlineContent":[{"text":"swift-crypto’s ","type":"text"},{"code":"SHA256","type":"codeVoice"},{"text":", which is CryptoKit’s on Apple platforms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Hashing is on no list. swift-crypto’s "},{"code":"Crypto","type":"codeVoice"},{"type":"text","text":" bundles a privacy manifest of its own on Apple platforms, declaring no tracking, no required-reason API and no collected data."}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,","type":"text"},{"text":" ","type":"text"},{"text":"swift-system’s ","type":"text"},{"code":"Stat","type":"codeVoice"},{"text":" API (","type":"text"},{"code":"FilePath.stat()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FileDescriptor.stat()","type":"codeVoice"},{"text":") calls ","type":"text"},{"code":"stat","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fstat","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"lstat","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fstatat","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"statfs","type":"codeVoice"},{"text":". Traffluent calls none of it. If your app does, your manifest","type":"text"},{"text":" ","type":"text"},{"text":"declares the file timestamp or disk space reason it needs.","type":"text"}]},{"level":3,"type":"heading","text":"Collected data","anchor":"Collected-data"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every declaration below is "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeLinked"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":" (Traffluent links nothing"},{"type":"text","text":" "},{"type":"text","text":"to the user’s identity), "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeTracking"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and has the one purpose"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypePurposeAnalytics"},{"type":"text","text":". A module declares a type only when it makes data of"},{"type":"text","text":" "},{"type":"text","text":"that type itself; it is collected only once your app turns the module on and delivers the records"},{"type":"text","text":" "},{"type":"text","text":"off the device."}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Module"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Data type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Device ID (","type":"text"},{"code":"NSPrivacyCollectedDataTypeDeviceID","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"type":"text","text":": the platform’s "},{"code":"identifierForVendor","type":"codeVoice"},{"type":"text","text":", as a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" "},{"code":"VendorIdentifierKey","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Other Diagnostic Data ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":", "},{"type":"codeVoice","code":"device()"},{"type":"text","text":", "},{"type":"codeVoice","code":"operatingSystem()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"network()"},{"type":"text","text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Other Data Types (","type":"text"},{"code":"NSPrivacyCollectedDataTypeOtherDataTypes","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Enricher.locale()"},{"text":": the user’s locale.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction ("},{"code":"NSPrivacyCollectedDataTypeProductInteraction","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":", and the events "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" track as the user moves through the app."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The events "},{"code":"UIControl.track(_:for:)","type":"codeVoice"},{"type":"text","text":" tracks when a control’s action fires."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Product Interaction","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The events ","type":"text"},{"type":"codeVoice","code":"NSControl.track(_:)"},{"text":" tracks when a control sends its action.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Product Interaction"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"trackScreensAutomatically"},{"type":"text","text":": a "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":" per screen, named after its view controller or SwiftUI view type."}],"type":"paragraph"