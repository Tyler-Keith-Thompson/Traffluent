:"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lstat"},{"text":", ","type":"text"},{"type":"codeVoice","code":"fstatat"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"statfs"},{"text":". Traffluent calls none of it. If your app does, your manifest","type":"text"},{"text":" ","type":"text"},{"text":"declares the file timestamp or disk space reason it needs.","type":"text"}]},{"anchor":"Collected-data","level":3,"type":"heading","text":"Collected data"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every declaration below is "},{"code":"NSPrivacyCollectedDataTypeLinked","type":"codeVoice"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":" (Traffluent links nothing"},{"type":"text","text":" "},{"type":"text","text":"to the user’s identity), "},{"code":"NSPrivacyCollectedDataTypeTracking","type":"codeVoice"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and has the one purpose"},{"type":"text","text":" "},{"code":"NSPrivacyCollectedDataTypePurposeAnalytics","type":"codeVoice"},{"type":"text","text":". A module declares a type only when it makes data of"},{"type":"text","text":" "},{"type":"text","text":"that type itself; it is collected only once your app turns the module on and delivers the records"},{"type":"text","text":" "},{"type":"text","text":"off the device."}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Module"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Data type"}]}],[{"type":"paragraph","inlineContent":[{"text":"What it makes, once your app turns it on","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Device ID ("},{"code":"NSPrivacyCollectedDataTypeDeviceID","type":"codeVoice"},{"t