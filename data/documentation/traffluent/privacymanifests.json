type":"text","text":", "},{"type":"codeVoice","code":"resize"},{"type":"text","text":", "},{"type":"codeVoice","code":"close"},{"type":"text","text":"), "},{"type":"codeVoice","code":"fsync"},{"type":"text","text":", "},{"type":"codeVoice","code":"unlink"},{"type":"text","text":", and "},{"type":"codeVoice","code":"FileManager"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"createDirectory"},{"type":"text","text":", "},{"type":"codeVoice","code":"setAttributes"},{"type":"text","text":" (the file protection class), "},{"type":"codeVoice","code":"contentsOfDirectory"},{"type":"text","text":" and "},{"type":"codeVoice","code":"isExcludedFromBackup"}]}],[{"type":"paragraph","inlineContent":[{"text":"It reads no file’s timestamps, size from ","type":"text"},{"code":"stat","type":"codeVoice"},{"text":", or the volume’s free space: a segment’s size is the offset ","type":"text"},{"code":"seek","type":"codeVoice"},{"text":" returns at its end, and the store bounds itself by the bytes it has written.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FileManager.fileExists"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data(contentsOf:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Data.write(to:options:)"},{"type":"text","text":" in "},{"type":"codeVoice","code":"FileVersionStore"},{"type":"text","text":"; "},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"}]}],[{"type":"paragraph","inlineContent":[{"text":"It reads and writes the version file’s contents, never its attributes.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"type":"text","text":" for "},{"type":"codeVoice","code":"hw.machine"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hw.model"},{"type":"text","text":", "},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"Locale.current"},{"type":"text","text":", "},{"type":"codeVoice","code":"NWPathMonitor"},{"type":"text","text":", "},{"type":"codeVoice","code":"identifierForVendor"}]}],[{"type":"paragraph","inlineContent":[{"text":"None is on the list; ","type":"text"},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"text":" is declared as collected data below.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"code":"Date","type":"codeVoice"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime."}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Date.now"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wall-clock time, not boot time."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":", the default clock of "},{"type":"codeVoice","code":"batch()"}]}],[{"type":"paragraph","inlineContent":[{"text":"The Swift runtime’s clock, which isn’t on the list.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{