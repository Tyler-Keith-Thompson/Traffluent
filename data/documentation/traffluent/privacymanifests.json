{"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/traffluent\/privacymanifests"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Traffluent"}],"title":"Privacy Manifests"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Traffluent collects nothing on its own. It records only the events your app tracks and the"},{"type":"text","text":" "},{"type":"text","text":"context your app turns on: every kind of automatic instrumentation and every standard enricher is"},{"type":"text","text":" "},{"type":"text","text":"opt in. It sends records only to the destinations your app gives a delivery, to endpoints your app"},{"type":"text","text":" "},{"type":"text","text":"names. None of it is used for tracking as Apple defines it: no module links what it records with"},{"type":"text","text":" "},{"type":"text","text":"other companies’ data, reads the advertising identifier, fingerprints the device, or works around"},{"type":"text","text":" "},{"type":"text","text":"the user’s consent or App Tracking Transparency. Every manifest declares "},{"code":"NSPrivacyTracking","type":"codeVoice"},{"type":"text","text":" as"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":" and lists no tracking domains."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each module that can produce data of one of Apple’s collected data types ships a"},{"type":"text","text":" "},{"code":"PrivacyInfo.xcprivacy","type":"codeVoice"},{"type":"text","text":" declaring it. SwiftPM and Bazel both put it in a resource bundle named"},{"type":"text","text":" "},{"code":"Traffluent_<Module>.bundle","type":"codeVoice"},{"type":"text","text":", which Xcode and rules_apple copy into your app, where Xcode’s privacy"},{"type":"text","text":" "},{"type":"text","text":"report finds it. A module your app doesn’t link adds nothing to the report."}]},{"type":"heading","level":3,"text":"Required-reason APIs","anchor":"Required-reason-APIs"},{"type":"paragraph","inlineContent":[{"text":"No Traffluent module calls an API on Apple’s list of required-reason APIs, so every manifest’s","type":"text"},{"text":" ","type":"text"},{"code":"NSPrivacyAccessedAPITypes","type":"codeVoice"},{"text":" is empty. The list’s categories are file timestamps","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryFileTimestamp","type":"codeVoice"},{"text":"), system boot time","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategorySystemBootTime","type":"codeVoice"},{"text":"), disk space","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryDiskSpace","type":"codeVoice"},{"text":"), active keyboards","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryActiveKeyboards","type":"codeVoice"},{"text":") and user defaults","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"NSPrivacyAccessedAPICategoryUserDefaults","type":"codeVoice"},{"text":"). The modules that come nearest:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Module","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What it calls"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Why none is a required-reason API"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"swift-system’s "},{"type":"codeVoice","code":"FileDescriptor"},{"type":"text","text":" ("},{"type":"codeVoice","code":"open"},{"type":"text","text":", "},{"type":"codeVoice","code":"read"},{"type":"text","text":", "},{"type":"codeVoice","code":"write"},{"type":"text","text":", "},{"type":"codeVoice","code":"seek"},{"type":"text","text":", "},{"type":"codeVoice","code":"resize"},{"type":"text","text":", "},{"type":"codeVoice","code":"close"},{"type":"text","text":"), "},{"type":"codeVoice","code":"fsync"},{"type":"text","text":", "},{"type":"codeVoice","code":"unlink"},{"type":"text","text":", and "},{"type":"codeVoice","code":"FileManager"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"createDirectory"},{"type":"text","text":", "},{"type":"codeVoice","code":"setAttributes"},{"type":"text","text":" (the file protection class), "},{"type":"codeVoice","code":"contentsOfDirectory"},{"type":"text","text":" and "},{"type":"codeVoice","code":"isExcludedFromBackup"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"It reads no file’s timestamps, size from "},{"type":"codeVoice","code":"stat"},{"type":"text","text":", or the volume’s free space: a segment’s size is the offset "},{"type":"codeVoice","code":"seek"},{"type":"text","text":" returns at its end, and the store bounds itself by the bytes it has written."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"FileManager.fileExists"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data(contentsOf:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Data.write(to:options:)"},{"type":"text","text":" in "},{"type":"codeVoice","code":"FileVersionStore"},{"type":"text","text":"; "},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"It reads and writes the version file’s contents, never its attributes."}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"hw.machine"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hw.model"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Locale.current"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NWPathMonitor"},{"text":", ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"}],"type":"paragraph"}],[{"inlineContent":[{"text":"None is on the list; ","type":"text"},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"text":" is declared as collected data below.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"type":"codeVoice","code":"Date"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"Date.now","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Wall-clock time, not boot time."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ContinuousClock","type":"codeVoice"},{"text":", the default clock of ","type":"text"},{"code":"batch()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The Swift runtime’s clock, which isn’t on the list.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"GRDB"}],"type":"paragraph"}],[{"inlineContent":[{"text":"GRDB ships a privacy manifest of its own.","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,"},{"type":"text","text":" "},{"type":"text","text":"swift-system’s "},{"type":"codeVoice","code":"Stat"},{"type":"text","text":" API ("},{"type":"codeVoice","code":"FilePath.stat()"},{"type":"text","text":", "},{"type":"codeVoice","code":"FileDescriptor.stat()"},{"type":"text","text":") calls "},{"type":"codeVoice","code":"stat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstat"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"lstat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstatat"},{"type":"text","text":" and "},{"type":"codeVoice","code":"statfs"},{"type":"text","text":". Traffluent calls none of it. If your app does, your manifest"},{"type":"text","text":" "},{"type":"text","text":"declares the file timestamp or disk space reason it needs."}]},{"type":"heading","level":3,"text":"Collected data","anchor":"Collected-data"},{"type":"paragraph","inlineContent":[{"text":"Every declaration below is ","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeLinked"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" (Traffluent links nothing","type":"text"},{"text":" ","type":"text"},{"text":"to the user’s identity), ","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeTracking"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", and has the one purpose","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypePurposeAnalytics"},{"text":". A module declares a type only when it makes data of","type":"text"},{"text":" ","type":"text"},{"text":"that type itself; it is collected only once your app turns the module on and delivers the records","type":"text"},{"text":" ","type":"text"},{"text":"off the device.","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Module"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Data type"}]}],[{"type":"paragraph","inlineContent":[{"text":"What it makes, once your app turns it on","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Device ID ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeDeviceID"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"text":": the platform’s ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"},{"text":", as a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" ","type":"text"},{"type":"codeVoice","code":"VendorIdentifierKey"},{"text":".","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Other Diagnostic Data (","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.application()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"operatingSystem()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"network()","type":"codeVoice"},{"text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"Other Data Types (","type":"text"},{"code":"NSPrivacyCollectedDataTypeOtherDataTypes","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.locale()","type":"codeVoice"},{"text":": the user’s locale.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product Interaction ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeProductInteraction"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"ScreenViewed"},{"type":"text","text":", and the events "},{"type":"codeVoice","code":"trackOnAppear(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"trackChange(of:_:)"},{"type":"text","text":" track as the user moves through the app."}]}]],[[{"type":"paragraph","inlineC