{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Traffluent collects nothing on its own. It records only the events your app tracks and the"},{"type":"text","text":" "},{"type":"text","text":"context your app turns on: every kind of automatic instrumentation and every standard enricher is"},{"type":"text","text":" "},{"type":"text","text":"opt in. It sends records only to the destinations your app gives a delivery, to endpoints your app"},{"type":"text","text":" "},{"type":"text","text":"names. None of it is used for tracking as Apple defines it: no module links what it records with"},{"type":"text","text":" "},{"type":"text","text":"other companies’ data, reads the advertising identifier, fingerprints the device, or works around"},{"type":"text","text":" "},{"type":"text","text":"the user’s consent or App Tracking Transparency. Every manifest declares "},{"type":"codeVoice","code":"NSPrivacyTracking"},{"type":"text","text":" as"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":" and lists no tracking domains."}]},{"type":"paragraph","inlineContent":[{"text":"Each module that can produce data of one of Apple’s collected data types ships a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PrivacyInfo.xcprivacy"},{"text":" declaring it. SwiftPM and Bazel both put it in a resource bundle named","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Traffluent_<Module>.bundle"},{"text":", which Xcode and rules_apple copy into your app, where Xcode’s privacy","type":"text"},{"text":" ","type":"text"},{"text":"report finds it. A module your app doesn’t link adds nothing to the report.","type":"text"}]},{"text":"Required-reason APIs","anchor":"Required-reason-APIs","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"No Traffluent module calls an API on Apple’s list of required-reason APIs, so every manifest’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSPrivacyAccessedAPITypes"},{"text":" is empty. The list’s categories are file timestamps","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryFileTimestamp"},{"text":"), system boot time","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategorySystemBootTime"},{"text":"), disk space","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryDiskSpace"},{"text":"), active keyboards","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryActiveKeyboards"},{"text":") and user defaults","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"NSPrivacyAccessedAPICategoryUserDefaults"},{"text":"). The modules that come nearest:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Module"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What it calls"}]}],[{"type":"paragraph","inlineContent":[{"text":"Why none is a required-reason API","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"swift-system’s ","type":"text"},{"type":"codeVoice","code":"FileDescriptor"},{"text":" (","type":"text"},{"type":"codeVoice","code":"open"},{"text":", ","type":"text"},{"type":"codeVoice","code":"read"},{"text":", ","type":"text"},{"type":"codeVoice","code":"write"},{"text":", ","type":"text"},{"type":"codeVoice","code":"seek"},{"text":", ","type":"text"},{"type":"codeVoice","code":"resize"},{"text":", ","type":"text"},{"type":"codeVoice","code":"close"},{"text":"), ","type":"text"},{"type":"codeVoice","code":"fsync"},{"text":", ","type":"text"},{"type":"codeVoice","code":"unlink"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"FileManager"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"createDirectory"},{"text":", ","type":"text"},{"type":"codeVoice","code":"setAttributes"},{"text":" (the file protection class), ","type":"text"},{"type":"codeVoice","code":"contentsOfDirectory"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"isExcludedFromBackup"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"It reads no file’s timestamps, size from "},{"type":"codeVoice","code":"stat"},{"type":"text","text":", or the volume’s free space: a segment’s size is the offset "},{"type":"codeVoice","code":"seek"},{"type":"text","text":" returns at its end, and the store bounds itself by the bytes it has written."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FileManager.fileExists"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data(contentsOf:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Data.write(to:options:)"},{"type":"text","text":" in "},{"type":"codeVoice","code":"FileVersionStore"},{"type":"text","text":"; "},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"}]}],[{"type":"paragraph","inlineContent":[{"text":"It reads and writes the version file’s contents, never its attributes.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sysctlbyname"},{"type":"text","text":" for "},{"type":"codeVoice","code":"hw.machine"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hw.model"},{"type":"text","text":", "},{"type":"codeVoice","code":"ProcessInfo.operatingSystemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"Bundle.infoDictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"Locale.current"},{"type":"text","text":", "},{"type":"codeVoice","code":"NWPathMonitor"},{"type":"text","text":", "},{"type":"codeVoice","code":"identifierForVendor"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"None is on the list; "},{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":" is declared as collected data below."}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Sessions\/documentation\/Sessions","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s record timestamps ("},{"type":"codeVoice","code":"Date"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Date.now"}]}],[{"type":"paragraph","inlineContent":[{"text":"Wall-clock time, not boot time.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":", the default clock of "},{"code":"batch()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift runtime’s clock, which isn’t on the list."}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"GRDB"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"GRDB ships a privacy manifest of its own."}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,"},{"type":"text","text":" "},{"type":"text","text":"swift-system’s "},{"type":"codeVoice","code":"Stat"},{"type":"text","text":" API ("},{"type":"codeVoice","code":"FilePath.stat()"},{"type":"text","text":", "},{"type":"codeVoice","code":"FileDescriptor.stat()"},{"type":"text","text":") calls "},{"type":"codeVoice","code":"stat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstat"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"lstat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstatat"},{"type":"text","text":" and "},{"type":"codeVoice","code":"statfs"},{"type":"text","text":". Traffluent calls none of it. If your app does, your manifest"},{"type":"text","text":" "},{"type":"text","text":"declares the file timestamp or disk space reason it needs."}]},{"text":"Collected data","anchor":"Collected-data","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every declaration below is "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeLinked"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":" (Traffluent links nothing"},{"type":"text","text":" "},{"type":"text","text":"to the user’s identity), "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeTracking"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and has the one purpose"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypePurposeAnalytics"},{"type":"text","text":". A module declares a type only when it makes data of"},{"type":"text","text":" "},{"type":"text","text":"that type itself; it is collected only once your app turns the module on and delivers the records"},{"type":"text","text":" "},{"type":"text","text":"off the device."}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Module"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Data type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"text":"Device ID (","type":"text"},{"code":"NSPrivacyCollectedDataTypeDeviceID","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":": the platform’s "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":", as a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"codeVoice","code":"VendorIdentifierKey"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other Diagnostic Data ("},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDiagnosticData"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Enricher.application()"},{"type":"text","text":", "},{"type":"codeVoice","code":"device()"},{"type":"text","text":", "},{"type":"codeVoice","code":"operatingSystem()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"network()"},{"type":"text","text":": the app’s bundle identifier, version and build; the device’s model and form factor; the operating system’s name and version; and the kind of network connection."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"text":"Other Data Types (","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeOtherDataTypes"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.locale()","type":"codeVoice"},{"text":": the user’s locale.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking"}]}],[{"type":"paragraph","inlineContent":[{"text":"Product Interaction (","type":"text"},{"code":"NSPrivacyCollectedDataTypeProductInteraction","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"ScreenViewed","type":"codeVoice"},{"type":"text","text":", and the events "},{"code":"trackOnAppear(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"trackOnTap(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"trackChange(of:_:)","type":"codeVoice"},{"type":"text","text":" track as the user moves through the app."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product Interaction"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The events "},{"type":"codeVoice","code":"UIControl.track(_:for:)"},{"type":"text","text":" tracks when a control’s action fires."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product Interaction"}]}],[