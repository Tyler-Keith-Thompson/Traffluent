xt":", "},{"type":"codeVoice","code":"close"},{"type":"text","text":"), "},{"type":"codeVoice","code":"fsync"},{"type":"text","text":", "},{"type":"codeVoice","code":"unlink"},{"type":"text","text":", and "},{"type":"codeVoice","code":"FileManager"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"createDirectory"},{"type":"text","text":", "},{"type":"codeVoice","code":"setAttributes"},{"type":"text","text":" (the file protection class), "},{"type":"codeVoice","code":"contentsOfDirectory"},{"type":"text","text":" and "},{"type":"codeVoice","code":"isExcludedFromBackup"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"It reads no file’s timestamps, size from "},{"code":"stat","type":"codeVoice"},{"type":"text","text":", or the volume’s free space: a segment’s size is the offset "},{"code":"seek","type":"codeVoice"},{"type":"text","text":" returns at its end, and the store bounds itself by the bytes it has written."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FileManager.fileExists"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data(contentsOf:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Data.write(to:options:)"},{"type":"text","text":" in "},{"type":"codeVoice","code":"FileVersionStore"},{"type":"text","text":"; "},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"}]}],[{"type":"paragraph","inlineContent":[{"text":"It reads and writes the version file’s contents, never its attributes.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"code":"sysctlbyname","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"hw.machine","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"hw.model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ProcessInfo.operatingSystemVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Bundle.infoDictionary","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Locale.current","type":"codeVoice"},{"text":", ","type":"text"},{"code":"NWPathMonitor","type":"codeVoice"},{"text":", ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"None is on the list; "},{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"type":"text","text":" is declared as collected data below."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"The tracker’s record timestamps (","type":"text"},{"code":"Date","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"A session’s inactivity is measured between records’ wall-clock timestamps, not from the system’s uptime.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"code":"Date.now","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wall-clock time, not boot time."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":", the default clock of "},{"code":"batch()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift runtime’s clock, which isn’t on the list."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"GRDB"}]}],[{"type":"paragraph","inlineContent":[{"text":"GRDB ships a privacy manifest of its own.","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,","type":"text"},{"text":" ","type":"text"},{"text":"swift-system’s ","type":"text"},{"code":"Stat","type":"codeVoice"},{"text":" API (","type":"text"},{"code":"FilePath.stat()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FileDescriptor.stat()","type":"codeVoice"},{"text":") calls ","type":"text"},{"code":"stat","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fstat","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"lstat","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fstatat","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"statfs","type":"codeVoice"},{"text":". Traffluent calls none of it. If your app does, your manifest","type":"text"},{"text":" ","type":"text"},{"text":"declares the file timestamp or disk space reason it needs.","type":"text"}],"type":"paragraph"},{"text":"Collected data","anchor":"Collected-data","level":3,"type":"heading"},{"inlineContent":[{"text":"Every declaration below is ","type":"text"},{"code":"NSPrivacyCollectedDataTypeLinked","type":"codeVoice"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" (Traffluent links nothing","type":"text"},{"text":" ","type":"text"},{"text":"to the user’s identity), ","type":"text"},{"code":"NSPrivacyCollectedDataTypeTracking","type":"codeVoice"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and has the one purpose","type":"text"},{"text":" ","type":"text"},{"code":"NSPrivacyCollectedDataTypePurposeAnalytics","type":"codeVoice"},{"text":". A module declares a type only when it makes data of","type":"text"},{"text":" ","type":"text"},