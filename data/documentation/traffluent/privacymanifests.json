":"symbol","title":"Destinations","role":"collection"},"doc://Events/documentation/Events":{"role":"collection","title":"Events","abstract":[],"identifier":"doc:\/\/Events\/documentation\/Events","kind":"symbol","type":"topic","url":"\/documentation\/events"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"abstract":[],"url":"\/documentation\/lifecycletracking","type":"topic","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","kind":"symbol","title":"LifecycleTracking","role":"collection"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"role":"collection","title":"AutomaticScreenTracking","abstract":[],"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","kind":"symbol","type":"topic","url":"\/documentation\/automaticscreentracking"},"doc://Traffluent/documentation/Traffluent/ChangingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChangingEvents","role":"article","url":"\/documentation\/traffluent\/changingevents","abstract":[{"type":"text","text":"An event’s version counts the changes that records stored before them can’t be read through, and only those. A compatible change keeps the version; a breaking one raises it."}],"title":"Changing an Event","kind":"article","type":"topic"},"doc://Trackers/documentation/Trackers":{"abstract":[],"url":"\/documentation\/trackers","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol","title":"Trackers","role":"collection"},"doc://Persistence/documentation/Persistence":{"role":"collection","title":"Persistence","abstract":[],"identifier":"doc:\/\/Persistence\/documentation\/Persistence","kind":"symbol","type":"topic","url":"\/documentation\/persistence"},"doc://TrackingPlans/documentation/TrackingPlans":{"abstract":[],"url":"\/documentation\/trackingplans","type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","kind":"symbol","title":"TrackingPlans","role":"collection"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"abstract":[{"text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent.","type":"text"}],"url":"\/documentation\/traffluent\/identifyingpeople","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","kind":"article","title":"Identifying People","role":"article"},"doc://UIKitTracking/documentation/UIKitTracking":{"role":"collection","title":"UIKitTracking","abstract":[],"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","kind":"symbol","type":"topic","url":"\/documentation\/uikittracking"},"doc://Checksums/documentation/Checksums":{"abstract":[],"url":"\/documentation\/checksums","type":"topic","identifier":"doc:\/\/Checksums\/documentation\/Checksums","kind":"symbol","title":"Checksums","role":"collection"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"role":"collection","title":"TrackingPlanTesting","abstract":[],"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","kind":"symbol","type":"topic","url":"\/documentation\/trackingplantesting"},"doc://LoggingDestinations/documentation/LoggingDestinations":{"abstract":[],"url":"\/documentation\/loggingdestinations","type":"topic","identifier":"doc:\/\/LoggingDestinations\/documentation\/LoggingDestinations","kind":"symbol","title":"LoggingDestinations","role":"collection"},"doc://StandardContext/documentation/StandardContext":{"role":"collection","title":"StandardContext","abstract":[],"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","kind":"symbol","type":"topic","url":"\/documentation\/standardcontext"},"doc://AppKitTracking/documentation/AppKitTracking":{"abstract":[],"url":"\/documentation\/appkittracking","type":"topic","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","kind":"symbol","title":"AppKitTracking","