lose","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"fsync","type":"codeVoice"},{"text":", ","type":"text"},{"code":"unlink","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"FileManager","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"createDirectory","type":"codeVoice"},{"text":", ","type":"text"},{"code":"setAttributes","type":"codeVoice"},{"text":" (the file protection class), ","type":"text"},{"code":"contentsOfDirectory","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"isExcludedFromBackup","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"It reads no file’s timestamps, size from "},{"type":"codeVoice","code":"stat"},{"type":"text","text":", or the volume’s free space: a segment’s size is the offset "},{"type":"codeVoice","code":"seek"},{"type":"text","text":" returns at its end, and the store bounds itself by the bytes it has written."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking"}],"type":"paragraph"}],[{"inlineContent":[{"code":"FileManager.fileExists","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Data(contentsOf:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Data.write(to:options:)","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"FileVersionStore","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"ProcessInfo.performExpiringActivity","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"It reads and writes the version file’s contents, never its attributes."}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"code":"sysctlbyname","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"hw.machine","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"hw