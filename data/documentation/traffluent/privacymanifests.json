ragraph"}],[{"inlineContent":[{"text":"Wall-clock time, not boot time.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":", the default clock of "},{"code":"batch()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The Swift runtime’s clock, which isn’t on the list."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"}],"type":"paragraph"}],[{"inlineContent":[{"text":"GRDB","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"GRDB ships a privacy manifest of its own.","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"Every other module calls nothing near the list. Of the packages Traffluent depends on,"},{"type":"text","text":" "},{"type":"text","text":"swift-system’s "},{"type":"codeVoice","code":"Stat"},{"type":"text","text":" API ("},{"type":"codeVoice","code":"FilePath.stat()"},{"type":"text","text":", "},{"type":"codeVoice","code":"FileDescriptor.stat()"},{"type":"text","text":") calls "},{"type":"codeVoice","code":"stat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstat"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"lstat"},{"type":"text","text":", "},{"type":"codeVoice","code":"fstatat"},{"type":"text","text":" and "},{"type":"codeVoice","code":"statfs"},{"type":"text","text":". Traffluent calls none of it. If your app does, your manifest"},{"type":"text","text":" "},{"type":"text","text":"declares the file timestamp or disk space reason it needs."}],"type":"paragraph"},{"level":3,"text":"Collected data","anchor":"Collected-data","type":"heading"},{"inlineContent":[{"text":"Every declaration below is ","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeLinked"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" (Traffluent links nothing","type":"text"},{"text":" ","type":"text"},{"text":"to the user’s identity), ","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeTracking"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", and has the one purpose","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypePurposeAnalytics"},{"text":". A module declares a type only when it makes data of","type":"text"},{"text":" ","type":"text"},{"text":"that type itself; it is collected only once your app turns the module on and delivers the records","type":"text"},{"text":" ","type":"text"},{"text":"off the device.","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Module","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Data type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"What it makes, once your app turns it on","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"paragraph","inlineContent":[{"text":"Device ID (","type":"text"},{"code":"NSPrivacyCollectedDataTypeDeviceID","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"Enricher.vendorIdentifier()","type":"codeVoice"},{"text":": the platform’s ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":", as a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" ","type":"text"},{"code":"VendorIdentifierKey","type":"codeVoice"},{"text":".","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/StandardContext\/documentation\/StandardContext"}]}],[{"type":"par