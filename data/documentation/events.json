":"text","text":" "},{"type":"text","text":"record’s sensitive values are redacted ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/revealsSensitiveValues"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":")."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reveal"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"preciseIdentifier":"s:6Events9SensitiveV","kind":"typeIdentifier","text":"Sensitive"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/reveal(_:)","type":"topic","title":"reveal(_:)"},"doc://Events/documentation/Events/Refined":{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"type":"codeVoice","code":"Rule"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"role":"symbol","title":"Refined","kind":"symbol","type":"topic","url":"\/documentation\/events\/refined","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}],"navigatorTitle":[{"text":"Refined","kind":"identifier"}]},"doc://Events/documentation/Events/Constraint":{"kind":"symbol","role":"symbol","url":"\/documentation\/events\/constraint","abstract":[{"type":"text","text":"A rule a value of type "},{"type":"codeVoice","code":"Value"},{"type":"text","text":" must satisfy: one "},{"identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","type":"reference","isActive":true},{"type":"text","text":", offered only where it"},{"type":"text","tex