{"hierarchy":{"paths":[[]]},"metadata":{"role":"collection","symbolKind":"module","title":"Events","roleHeading":"Framework","externalID":"Events","modules":[{"name":"Events"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"url":"doc:\/\/Events\/documentation\/Events","interfaceLanguage":"swift"},"kind":"symbol","topicSections":[{"title":"Events","identifiers":["doc:\/\/Events\/documentation\/Events\/Event","doc:\/\/Events\/documentation\/Events\/ConsentCategory","doc:\/\/Events\/documentation\/Events\/EventSchema","doc:\/\/Events\/documentation\/Events\/EventSchema\/Enumeration","doc:\/\/Events\/documentation\/Events\/DiscoveredEvent"],"anchor":"Events"},{"title":"Property values","identifiers":["doc:\/\/Events\/documentation\/Events\/Sensitive","doc:\/\/Events\/documentation\/Events\/Refined","doc:\/\/Events\/documentation\/Events\/Refinement","doc:\/\/Events\/documentation\/Events\/Constraint","doc:\/\/Events\/documentation\/Events\/ValidationKeyword","doc:\/\/Events\/documentation\/Events\/UnsatisfiedConstraint","doc:\/\/Events\/documentation\/Events\/InvalidConstraint","doc:\/\/Events\/documentation\/Events\/ConstraintViolation"],"anchor":"Property-values"},{"title":"Records","identifiers":["doc:\/\/Events\/documentation\/Events\/EventRecord","doc:\/\/Events\/documentation\/Events\/SourceLocation","doc:\/\/Events\/documentation\/Events\/Enricher","doc:\/\/Events\/documentation\/Events\/SessionKey"],"anchor":"Records"},{"title":"Stores","identifiers":["doc:\/\/Events\/documentation\/Events\/DeliveryTag","doc:\/\/Events\/documentation\/Events\/Acknowledger"],"anchor":"Stores"}],"variants":[{"paths":["\/documentation\/events"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The types every other module shares: the ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An event is a value that conforms to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Event"},{"type":"text","text":", declared with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":". Its stored properties"},{"type":"text","text":" "},{"type":"text","text":"are its properties, so a misspelled or mistyped one is a compile error. Its type gives the name"},{"type":"text","text":" "},{"type":"text","text":"destinations record it under, the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory"},{"type":"text","text":" whose consent decides whether it is"},{"type":"text","text":" "},{"type":"text","text":"delivered, and the version of its shape. Each has a default: the type’s name,"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics"},{"type":"text","text":" and 1."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two property types carry rules of their own. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value, such as an email address,"},{"type":"text","text":" "},{"type":"text","text":"prints as "},{"type":"codeVoice","code":"<redacted>"},{"type":"text","text":" and has no public accessor: a destination reads it through"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/reveal(_:)"},{"type":"text","text":", which gives "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" once a delivery has redacted the record. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},{"type":"text","text":" value satisfies every "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Constraint"},{"type":"text","text":" its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Refinement"},{"type":"text","text":" lists, checked once as it is"},{"type":"text","text":" "},{"type":"text","text":"made: its initializer throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/UnsatisfiedConstraint"},{"type":"text","text":" for a value that breaks one. Each"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Constraint"},{"type":"text","text":" spelling throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/InvalidConstraint"},{"type":"text","text":" for an argument no schema can hold, such as"},{"type":"text","text":" "},{"type":"text","text":"a negative length."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracker (module "},{"type":"codeVoice","code":"Trackers"},{"type":"text","text":") makes an "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","isActive":true},{"type":"text","text":" of each event it tracks: the event, its own"},{"type":"text","text":" "},{"type":"text","text":"random identifier, when and where it was tracked, and the "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" it was tracked in."},{"type":"text","text":" "},{"type":"text","text":"Destinations receive batches of these records. An "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","isActive":true},{"type":"text","text":" adds to a record’s context: a"},{"type":"text","text":" "},{"type":"text","text":"tracker runs it on every record, or a destination’s "},{"type":"codeVoice","code":"enriched(by:)"},{"type":"text","text":" on the records it receives."}]},{"type":"paragraph","inlineContent":[{"text":"Declare an event with ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"EventMacros"},{"text":", part of ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":"). It derives","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Event","type":"reference","isActive":true},{"text":" conformance from the struct’s declaration and fills in its ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference","isActive":true},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@Constrained"},{"text":" beside a property fills in ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Event\/constraintViolation()","type":"reference","isActive":true},{"text":". To write the","type":"text"},{"text":" ","type":"text"},{"text":"conformance by hand instead, see ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Event","type":"reference","isActive":true},{"text":".","type":"text"}]},{"syntax":"swift","code":["import Traffluent","","enum PlanName: Refinement {","    static var constraints: [Constraint<String>] {","        get throws(InvalidConstraint) { try [.minLength(1), .maxLength(32)] }","    }","}","","@Event(consent: .functional)","struct SignedUp {","    var plan: Refined<String, PlanName>","    var email: Sensitive<String>","}","","let event = SignedUp(plan: try Refined(\"pro\"), email: Sensitive(\"ada@example.com\"))","let record = EventRecord(event: event, timestamp: .now, sourceLocation: nil)","let name = record.name  \/\/ \"SignedUp\"","let email = record.reveal(event.email)  \/\/ nil: a record made by hand keeps its sensitive values redacted","let empty = try? Refined<String, PlanName>(\"\")  \/\/ nil: it throws UnsatisfiedConstraint.minLength"],"type":"c