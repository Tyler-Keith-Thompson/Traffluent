lEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier","text":"TrackingPlan","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier","text":"ExponentialBackoff","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff"},{"kind":"text","text":" = .mixpanel, "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier","text":"Clock"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO","kind":"typeIdentifier","text":"MixpanelSetupError","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier","text":"HTTPDestination","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV","kind":"typeIdentifier","text":"MixpanelBatchEncoder","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"projectToken","content":[{"inlineContent":[{"type":"text","text":"The project’s token, from the project’s settings. Whitespace and newlines"},{"type":"text","text":" "},{"type":"text","text":"around it are trimmed off."}],"type":"paragraph"}]},{"name":"region","content":[{"type":"paragraph","inlineContent":[{"text":"Where the project’s data resides: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/us","type":"reference"},{"text":", Mixpanel’s default,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/eu","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/india","type":"reference"},{"text":".","type":"text"}]}]},{"name":"plan","content":[{"inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}],"type":"paragraph"}]},{"name":"transport","content":[{"inlineContent":[{"text":"What sends each request.","type":"text"}],"type":"paragraph"}]},{"name":"backoff","content":[{"inlineContent":[{"text":"How long to wait before each new attempt at a request; 2 seconds, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, with full jitter, by default.","type":"text"}],"type":"paragraph"}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 119 hours are measured from,","type":"text"},{"text":" ","type":"text"},{"text":"and each request’s deadline is checked against before it is sent; the system’s clock by","type":"text"},{"text":" ","type":"text"},{"text":"default. When it reads NaN or infinite, every record is left out.","type":"text"}]}]}]},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The destination posts to the "},{"type":"codeVoice","code":"\/track"},{"type":"text","text":" endpoint of "},{"type":"codeVoice","code":"region"},{"type":"text","text":", encoded by a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","isActive":true},{"type":"text","text":" of "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" within "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":", with "},{"type":"codeVoice","code":"ip=0"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so Mixpanel adds no location from the request’s address, and "},{"type":"codeVoice","code":"verbose=1"},{"type":"text","text":", so Mixpanel says"},{"type":"text","text":" "},{"type":"text","text":"in its answer whether it found a valid event, and sends no trace context in its header"},{"type":"text","text":" "},{"type":"text","text":"fields. It retries what Mixpanel says to retry, no response, a 5xx, 408 or 429, and drops"},{"type":"text","text":" "},{"type":"text","text":"and reports any other status, such as 400 for an invalid request, and a 200 whose body is"},{"type":"text","text":" "},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"type":"text","text":", reported as "},{"type":"codeVoice","code":"HTTPDropReport.rejectedInBody"},{"type":"text","text":" with Mixpanel’s"},{"type":"text","text":" "},{"type":"text","text":"error. A status of 1 doesn’t confirm the token names a project, so a wrong region, or a"},{"type":"text","text":" "},{"type":"text","text":"token of no project, may still be answered 200 with nothing stored: check the project’s"},{"type":"text","text":" "},{"type":"text","text":"Live View after setting it up."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Mixpanel’s track API takes no event tracked more than 5 days before it arrives, and answers"},{"type":"text","text":" "},{"type":"text","text":"200 while storing nothing for one, so the encoder leaves out a record tracked more than 119"},{"type":"text","text":" "},{"type":"text","text":"hours before it is encoded, or more than an hour after, which Mixpanel rejects too"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow"},{"type":"text","text":"). A request is"},{"type":"text","text":" "},{"type":"text","text":"encoded once and retried as it is, so one still undelivered 119 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record was tracked, by the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The encoder logs a notice for each property of ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" named as one Mixpanel reserves, as","type":"text"},{"text":" ","type":"text"},{"text":"every record of its event will be skipped","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/reservedPropertyName(event:property:)","type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The track API takes the project token, which is public, so the destination takes nothing"},{"type":"text","text":" "},{"type":"text","text":"else: never the project’s secret or a service account’s credentials, which Mixpanel’s"},{"type":"text","text":" "},{"type":"text","text":"import API takes and which must not ship in an app."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError\/emptyProjectToken","isActive":true,"type":"reference"},{"text":" for a token that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace, and ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError\/malformedProjectToken","isActive":true,"type":"reference"},{"text":" for one holding a character","type":"text"},{"text":" ","type":"text"},{"text":"other than an ASCII letter or digit.","type":"text"}],"type":"paragraph"}]}]}],"references":{"doc://Events/documentation/Events/EventSchema":{"title":"EventSchema","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The shape of an event type: its name, its schema version, its consent category and its stored"},{"type":"text","text":" "},{"type":"text","text":"properties in declaration order, as a value tooling reads."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventSchema","kind":"ide