t"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A property’s name is one Mixpanel reads for itself: one starting with "},{"type":"codeVoice","code":"$"},{"type":"text","text":" ("},{"type":"codeVoice","code":"$insert_id"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"$user_id"},{"type":"text","text":", "},{"type":"codeVoice","code":"$ignore"},{"type":"text","text":" and Mixpanel’s default properties), or "},{"type":"codeVoice","code":"token"},{"type":"text","text":", "},{"type":"codeVoice","code":"time"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", "},{"type":"codeVoice","code":"ip"},{"type":"text","text":" or "},{"type":"codeVoice","code":"bucket"},{"type":"text","text":". Sent, it would change how Mixpanel ingests the event, or be"},{"type":"text","text":" "},{"type":"text","text":"lost under a value the encoder writes. "},{"type":"codeVoice","code":"property"},{"type":"text","text":" is the first such name in the order of"},{"type":"text","text":" "},{"type":"text","text":"the names’ UTF-8 bytes. Rename the property, raising the event’s schema version, to send"},{"type":"text","text":" "},{"type":"text","text":"the event."}],"title":"MixpanelEncodingError.reservedPropertyName(event:property:)","role":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/reservedPropertyName(event:property:)"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelSetupError/malformedProjectToken":{"role":"symbol","kind":"symbol","type":"topic","title":"MixpanelSetupError.malformedProjectToken","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"malformedProjectToken","kind":"identifier"}],"url":"\/documentation\/mixpanelencoding\/mixpanelsetuperror\/malformedproject