text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","kind":"typeIdentifier","text":"ExponentialBackoff"},{"kind":"text","text":" = .mixpanel, "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier","text":"Clock"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError","kind":"typeIdentifier","text":"MixpanelSetupError"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","kind":"typeIdentifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","kind":"typeIdentifier","text":"MixpanelBatchEncoder"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The project’s token, from the project’s settings. Whitespace and newlines","type":"text"},{"text":" ","type":"text"},{"text":"around it are trimmed off.","type":"text"}]}],"name":"projectToken"},{"content":[{"inlineContent":[{"type":"text","text":"Where the project’s data resides: "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/us","isActive":true,"type":"reference"},{"type":"text","text":", Mixpanel’s default,"},{"type":"text","text":" "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/eu","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/india","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"region"},{"content":[{"inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}],"type":"paragraph"}],"name":"plan"},{"content":[{"inlineContent":[{"text":"What sends each request.","type":"text"}],"type":"paragraph"}],"name":"transport"},{"content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 2 seconds, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}],"name":"backoff"},{"content":[{"inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}],"type":"paragraph"}],"name":"clock"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 119 hours are measured from,","type":"text"},{"text":" ","type":"text"},{"text":"and each request’s deadline is checked against before it is sent; the system’s clock by","type":"text"},{"text":" ","type":"text"},{"text":"default. When it reads NaN or infinite, every record is left out.","type":"text"}]}],"name":"now"}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination posts to the "},{"type":"codeVoice","code":"\/track"},{"type":"text","text":" endpoint of "},{"type":"codeVoice","code":"region"},{"type":"text","text":", encoded by a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","isActive":true},{"type":"text","text":" of "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" within "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":", with "},{"type":"codeVoice","code":"ip=0"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so Mixpanel adds no location from the request’s address, and "},{"type":"codeVoice","code":"verbose=1"},{"type":"text","text":", so Mixpanel says"},{"type":"text","text":" "},{"type":"text","text":"in its answer whether it found a valid event, and sends no trace context in its header"},{"type":"text","text":" "},{"type":"text","text":"fields. It retries what Mixpanel says to retry, no response, a 5xx, 408 or 429, and drops"},{"type":"text","text":" "},{"type":"text","text":"and reports any other status, such as 400 for an invalid request, and a 200 whose body is"},{"type":"text","text":" "},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"type":"text","text":", reported as "},{"type":"codeVoice","code":"HTTPDropReport.rejectedInBody"},{"type":"text","text":" with Mixpanel’s"},{"type":"text","text":" "},{"type":"text","text":"error. A status of 1 doesn’t confirm the token names a project, so a wrong region, or a"},{"type":"text","text":" "},{"type":"text","text":"token of no project, may still be answered 200 with nothing stored: check the project’s"},{"type":"text","text":" "},{"type":"text","text":"Live View after setting it up."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mixpanel’s track API takes no event tracked more than 5 days before it arrives, and answers"},{"type":"text","text":" "},{"type":"text","text":"200 while storing nothing for one, so the encoder leaves out a record tracked more than 119"},{"type":"text","text":" "},{"type":"text","text":"hours before it is encoded, or more than an hour after, which Mixpanel rejects too"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow","type":"reference","isActive":true},{"type":"text","text":"). A request is"},{"type":"text","text":" "},{"type":"text","text":"encoded once and retried as it is, so one still undelivered 119 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record was tracked, by the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The encoder logs a notice for each property of ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" named as one Mixpanel reserves, as","type":"text"},{"text":" ","type":"text"},{"text":"every record of its event will be skipped","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/reservedPropertyName(event:property:)","type":"reference"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The track API takes the project token, which is public, so the destination takes nothing","type":"text"},{"text":" ","type":"text"},{"text":"else: never the project’s secret or a service account’s credentials, which Mixpanel’s","type":"text"},{"text":" ","type":"text"},{"text":"import API takes and which must not ship in an app.","type":"text"}]},{"type":"aside","name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError\/emptyProjectToken","isActive":true},{"text":" for a token that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace, and ","type":"text"},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError\/malformedProjectToken","isActive":true},{"text":" for one holding a character","type":"text"},{"text":" ","type":"text"},{"text":"other than an ASCII letter or digit.","type":"text"}]}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination"]]},"variants":[{"paths":["\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:transport:backoff:clock:now:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination":{"role":"symbol","title":"HTTPDestination","url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination","type":"topic","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"fragments":[{"kind":"keyword","text":"e