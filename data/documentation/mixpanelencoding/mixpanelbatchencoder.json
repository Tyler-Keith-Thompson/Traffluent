nelBatchEncoder\/requests(for:)","abstract":[{"code":"batch","type":"codeVoice"},{"type":"text","text":" as the requests Mixpanel takes, each within the encoder’s limit, with the records"},{"type":"text","text":" "},{"type":"text","text":"left out of them."}],"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","text":"BatchRequests"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0aB5ErrorO","text":"MixpanelEncodingError"},{"kind":"text","text":">"}],"role":"symbol","kind":"symbol","title":"requests(for:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" sends.","type":"text"}],"url":"\/documentation\/httpdestinations\/batchencoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"role":"symbol","title":"BatchEncoder","kind":"symbol"},"doc://Events/documentation/Events/Sensitive":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"title":"Sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"url":"\/documentation\/events\/sensitive","type":"topic","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"title":"MixpanelEncodingError","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"topic","abstract":[{"type":"text","text":"Why "},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","type":"reference"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"kind":"symbol","role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelEncodingError","kind":"identifier"}],"navigatorTitle":[{"text":"MixpanelEncodingError","kind":"identifier"}]},"doc://MixpanelEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/MixpanelEncoding\/s16SendableMetatypeP"},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"role":"collection","title":"MixpanelEncoding","type":"topic","url":"\/documentation\/mixpanelencoding","abstract":[{"text":"Send records to a Mixpanel project through its track API.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/batchLimit":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","type":"topic","abstract":[{"text":"Mixpanel’s limits on one request: 2,000 events, 2,000,000 bytes of body, and 999,999 bytes","type":"text"},{"text":" ","type":"text"},{"text":"of one event.","type":"text"}],"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/batchlimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"role":"symbol","title":"batchLimit","kind":"symbol"}}}