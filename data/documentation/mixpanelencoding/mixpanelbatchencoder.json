{"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/init(projectToken:plan:limit:)"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)"]},{"anchor":"Type-Aliases","generated":true,"title":"Type Aliases","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/Failure"]},{"anchor":"Type-Properties","generated":true,"title":"Type Properties","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/transientStatuses"]},{"anchor":"Type-Methods","generated":true,"title":"Type Methods","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)"]}],"hierarchy":{"paths":[["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"]]},"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of Mixpanel’s track API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can send","type":"text"},{"text":" ","type":"text"},{"text":"events to a Mixpanel project’s ","type":"text"},{"code":"POST \/track","type":"codeVoice"},{"text":".","type":"text"}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/MixpanelEncoding\/s8SendableP","doc:\/\/MixpanelEncoding\/s16SendableMetatypeP"],"kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mixpanelencoding\/mixpanelbatchencoder"]}],"kind":"symbol","identifier":{"url":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","interfaceLanguage":"swift"},"metadata":{"externalID":"s:16MixpanelEncoding0A12BatchEncoderV","symbolKind":"struct","role":"symbol","navigatorTitle":[{"text":"MixpanelBatchEncoder","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"roleHeading":"Structure","title":"MixpanelBatchEncoder","modules":[{"name":"MixpanelEncoding"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MixpanelEncoding\/MixpanelBatchEncoder.swift#L87","fileName":"MixpanelBatchEncoder.swift"}},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelBatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Make the destination with ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and Mixpanel’s limits:","type":"text"}]},{"code":["let mixpanel = try HTTPDestination.mixpanel(","    projectToken: projectToken,","    region: .eu,  \/\/ or .us or .india, where the project's data resides","    plan: plan)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON array of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", one object per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first, each with two members: "},{"type":"codeVoice","code":"event"},{"type":"text","text":", the event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":" as it is, and "},{"type":"codeVoice","code":"properties"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"event’s stored properties by name, then these members:"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$device_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; left out for a record with no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$insert_id"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"distinct_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, as ","type":"text"},{"code":"$device_id","type":"codeVoice"},{"text":" holds it; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ip"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"\"0\""},{"type":"text","text":", so Mixpanel adds no location from the request’s address"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"time","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in whole milliseconds since 1970"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"token"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The project token"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"$user_id"},{"type":"text","text":", and no other device"},{"type":"text","text":" "},{"type":"text","text":"identifier. Mixpanel counts a user per "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", so its unique users are sessions. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is its own"},{"type":"text","text":" "},{"type":"text","text":"anonymous user, linked to nothing, rather than an event with no "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", which Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"would attribute to no user, or to a hash of the request’s address. Mixpanel treats two events"},{"type":"text","text":" "},{"type":"text","text":"of the same "},{"type":"codeVoice","code":"event"},{"type":"text","text":", "},{"type":"codeVoice","code":"time"},{"type":"text","text":", "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$insert_id"},{"type":"text","text":" as one. A record a store recovers"},{"type":"text","text":" "},{"type":"text","text":"after a relaunch keeps its session, so it goes out with the "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$device_id"},{"type":"text","text":" of"},{"type":"text","text":" "},{"type":"text","text":"its first send, and Mixpanel treats it as the copy it had already stored, if it had. The record’s vendor identifier and"},{"type":"text","text":" "},{"type":"text","text":"trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Mixpanel cuts each string down to 255 characters. It drops an event of 255 properties or more,"},{"type":"text","text":" "},{"type":"text","text":"counting the members above and the default properties below, one holding an array of 255"},{"type":"text","text":" "},{"type":"text","text":"elements or more, and one whose property nests objects more than 3 deep, though it answers"},{"type":"text","text":" "},{"type":"text","text":"200: the encoder enforces these limits, leaving such a record out of the request."}]},{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"},{"type":"text","text":" also holds Mixpanel’s default properties, named as its Swift SDK names them, for"},{"type":"text","text":" "},{"type":"text","text":"each of the keys the record’s context has a value for:"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$app_version_string","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_build_number","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The version and build, each left out when "},{"type":"codeVoice","code":"nil"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$model","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The model","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$wifi","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NetworkKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether the connection is Wi-Fi"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$os"},{"type":"text","text":", "},{"type":"codeVoice","code":"$os_version"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The operating system’s name and version","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event name starts with"},{"type":"text","text":" "},{"code":"$","type":"codeVoice"},{"type":"text","text":", as Mixpanel’s own events’ do, one with a property named as one Mixpanel reads for itself,"},{"type":"text","text":" "},{"type":"text","text":"one past Mixpanel’s limits on properties, array elements or nesting, one whose event isn’t"},{"type":"text","text":" "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is no"},{"type":"text","text":" "},{"code":"time","type":"codeVoice"},{"type":"text","text":" Mixpanel takes, and one too large for Mixpanel ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError"},{"type":"text","text":")."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)"},{"type":"text","text":" returns them as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Mixpanel answers a request it reads with 200, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries one","type":"text"},{"text":" ","type":"text"},{"text":"that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400, 401 or","type":"text"},{"text":" ","type":"text"},{"text":"413. It answers 200 as well to a request in which it finds no valid event, and says so in the","type":"text"},{"text":" ","type":"text"},{"text":"body: with ","type":"text"},{"code":"verbose=1","type":"codeVoice"},{"text":", which the destination’s endpoint sets, ","type":"text"},{"code":"{\"status\": 0, \"error\": ...}","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)","isActive":true,"type":"reference"},{"text":" reads that as rejected, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops the request and reports it","type":"text"},{"text":" ","type":"text"},{"text":"with Mixpanel’s error. A ","type":"text"},{"code":"status","type":"codeVoice"},{"text":" of 1 means only that one event or more was well formed, not","type":"text"},{"text":" ","type":"text"},{"text":"that the token names a project, so a wrong region, or a token of no project, may still be","type":"text"},{"text":" ","type":"text"},{"text":"answered 200 with nothing stored: check the project’s Live View after setting it up. Its track","type":"text"},{"text":" ","type":"text"},{"text":"API ingests only events from the last 5 days: a record older than that when it is sent, such","type":"text"},{"text":" ","type":"text"},{"text":"as one a store kept through a long time offline, is not stored, and is reported only when no","type":"text"},{"text":" ","type":"text"},{"text":"event of its request was valid. A record sent again keeps its ","type":"text"},{"code":"$insert_id","type":"codeVoice"},{"text":". The bytes are","type":"text"},{"text":" ","type":"text"},{"text":"the same for the same records on every run and platform: no whitespace, object members in the","type":"text"},{"text":" ","type":"text"},{"text":"order of their names’ UTF-8 bytes.","type":"text"}]}],"kind":"content"}],"sections":[],"references":{"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/requests(for:)":{"type":"topic","kind":"symbol","abstract":[{"type":"codeVoice","code":"batch"},{"type":"text","text":" as the requests Mixpanel takes, each within the encoder’s limit, with the records"},{"type":"text","text":" "},{"type":"text","text":"left out of them."}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","text":"BatchRequests"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0aB5ErrorO","text":"MixpanelEncodingError"},{"kind":"text","text":">"}],"title":"requests(for:)","role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/requests(for:)"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/Failure":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/Failure","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"title":"MixpanelBatchEncoder.Failure","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/failure","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Failure","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"title":"BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/outcome(of:for:)":{"type":"topic","kind":"symbol","abstract":[{"text":"What Mixpanel’s 2xx answer means: rejected when it found no valid event in the request,","type":"text"},{"text":" ","type":"text"},{"text":"and delivered otherwise.","type":"text"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO"}],"title":"outcome(of:for:)","role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/outcome(of:for:)"},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","type":"topic","abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"title":"MixpanelEncoding","url":"\/documentation\/mixpanelencoding","role":"collection","kind":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/batchLimit":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"}],"type":"topic","abstract":[{"type":"text","text":"Mixpanel’s limits on one request: 2,000 events, 2,000,000 bytes of body, and 999,999 bytes"},{"type":"text","text":" "},{"type":"text","text":"of one event."}],"title":"batchLimit","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/batchlimit","role":"symbol","kind":"symbol"},"doc://Events/documentation/Events/Sensitive":{"type":"topic","kind":"symbol","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"title":"Sensitive","role":"symbol","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"url":"\/documentation\/events\/sensitive"},"doc://MixpanelEncoding/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/MixpanelEncoding\/s8SendableP"},"doc://MixpanelEncoding/s16SendableMetatypeP":{"identifier":"doc:\/\/MixpanelEncoding\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/init(projectToken:plan:limit:)":{"type":"topic","kind":"symbol","abstract":[{"text":"An encoder of the events ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" describes, for the Mixpanel project of ","type":"text"},{"code":"projectToken","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"splitting each batch to ","type":"text"},{"code":"limit","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/init(projectToken:plan:limit:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"},{"text":")","kind":"text"}],"title":"init(projectToken:plan:limit:)","role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/init(projecttoken:plan:limit:)"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder":{"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of Mixpanel’s track API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can send","type":"text"},{"text":" ","type":"text"},{"text":"events to a Mixpanel project’s ","type":"text"},{"code":"POST \/track","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","navigatorTitle":[{"text":"MixpanelBatchEncoder","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"title":"MixpanelBatchEncoder","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination/mixpanel(projectToken:region:plan:backoff:clock:)":{"type":"topic","abstract":[{"type":"text","text":"A destination that sends batches to the Mixpanel project of "},{"type":"codeVoice","code":"projectToken"},{"type":"text","text":", whose data"},{"type":"text","text":" "},{"type":"text","text":"resides in "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the"},{"type":"text","text":" "},{"type":"text","text":"waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"URLSessionTransport"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Encoding"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"MixpanelBatchEncoder"},{"text":".","type":"text"}]},"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MixpanelRegion","preciseIdentifier":"s:16MixpanelEncoding0A6RegionO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"MixpanelSetupError","preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"URLSessionTransport","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"MixpanelBatchEncoder","preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"mixpanel(projectToken:region:plan:backoff:clock:)","url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:backoff:clock:)"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/transientStatuses":{"type":"topic","abstract":[{"text":"No status beyond the 408, 429 and 5xx that ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" retries for every encoder.","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/transientStatuses","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientStatuses","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"TransientStatus","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"transientStatuses","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/transientstatuses"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelEncodingError","kind":"identifier"}],"url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","title":"MixpanelEncodingError","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"MixpanelEncodingError","kind":"identifier"}]}}}