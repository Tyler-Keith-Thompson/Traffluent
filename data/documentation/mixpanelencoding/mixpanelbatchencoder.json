{"metadata":{"roleHeading":"Structure","externalID":"s:16MixpanelEncoding0A12BatchEncoderV","role":"symbol","modules":[{"name":"MixpanelEncoding"}],"navigatorTitle":[{"kind":"identifier","text":"MixpanelBatchEncoder"}],"title":"MixpanelBatchEncoder","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"remoteSource":{"fileName":"MixpanelBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MixpanelEncoding\/MixpanelBatchEncoder.swift#L83"}},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelBatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Make the destination with "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and Mixpanel’s limits:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let mixpanel = try HTTPDestination.mixpanel(","    projectToken: projectToken,","    region: .eu,  \/\/ or .us or .india, where the project's data resides","    plan: plan)"]},{"inlineContent":[{"type":"text","text":"The body is a JSON array of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", one object per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first, each with two members: "},{"type":"codeVoice","code":"event"},{"type":"text","text":", the event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":" as it is, and "},{"type":"codeVoice","code":"properties"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"event’s stored properties by name, then these members:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$device_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; left out for a record with no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$insert_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"distinct_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, as ","type":"text"},{"code":"$device_id","type":"codeVoice"},{"text":" holds it; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ip"}],"type":"paragraph"}],[{"inlineContent":[{"code":"\"0\"","type":"codeVoice"},{"text":", so Mixpanel adds no location from the request’s address","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"time","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in whole milliseconds since 1970"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"token","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The project token"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"$user_id"},{"type":"text","text":", and no other device"},{"type":"text","text":" "},{"type":"text","text":"identifier. Mixpanel counts a user per "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", so its unique users are sessions. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store"},{"type":"text","text":" "},{"type":"text","text":"recovered after a relaunch, which keeps no context) is its own anonymous user, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing, rather than an event with no "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", which Mixpanel would attribute to no user,"},{"type":"text","text":" "},{"type":"text","text":"or to a hash of the request’s address. Mixpanel treats two events of the same "},{"type":"codeVoice","code":"event"},{"type":"text","text":", "},{"type":"codeVoice","code":"time"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$insert_id"},{"type":"text","text":" as one, so a recovered record that Mixpanel had already stored"},{"type":"text","text":" "},{"type":"text","text":"under its session, before the app ended, is stored again. The record’s vendor identifier and"},{"type":"text","text":" "},{"type":"text","text":"trace context, and any other context value, aren’t sent."}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Mixpanel cuts each string down to 255 characters. It drops an event of 255 properties or more,","type":"text"},{"text":" ","type":"text"},{"text":"counting the members above and the default properties below, one holding an array of 255","type":"text"},{"text":" ","type":"text"},{"text":"elements or more, and one whose property nests objects more than 3 deep, though it answers","type":"text"},{"text":" ","type":"text"},{"text":"200: the encoder enforces these limits, leaving such a record out of the request.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"properties"},{"type":"text","text":" also holds Mixpanel’s default properties, named as its Swift SDK names them, for"},{"type":"text","text":" "},{"type":"text","text":"each of the keys the record’s context has a value for:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$app_version_string","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_build_number","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The version and build, each left out when "},{"type":"codeVoice","code":"nil"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$model","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$wifi","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"Whether the connection is Wi-Fi","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$os","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_version","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The operating system’s name and version","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name starts with","type":"text"},{"text":" ","type":"text"},{"code":"$","type":"codeVoice"},{"text":", as Mixpanel’s own events’ do, one with a property named as one Mixpanel reads for itself,","type":"text"},{"text":" ","type":"text"},{"text":"one past Mixpanel’s limits on properties, array elements or nesting, one whose event isn’t","type":"text"},{"text":" ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp is no","type":"text"},{"text":" ","type":"text"},{"code":"time","type":"codeVoice"},{"text":" Mixpanel takes, and one too large for Mixpanel (","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","type":"reference"},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. Mixpanel answers a request it reads with 200, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries one"},{"type":"text","text":" "},{"type":"text","text":"that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400, 401 or"},{"type":"text","text":" "},{"type":"text","text":"413. Mixpanel answers 200 as well when it ingests none of a request’s events: a wrong region,"},{"type":"text","text":" "},{"type":"text","text":"or a token of no project, may be answered 200 with nothing stored, so check the project’s Live"},{"type":"text","text":" "},{"type":"text","text":"View after setting it up. Its track API ingests only events from the last 5 days: a record"},{"type":"text","text":" "},{"type":"text","text":"older than that when it is sent, such as one a store kept through a long time offline, is"},{"type":"text","text":" "},{"type":"text","text":"counted as delivered and not stored. A record sent again keeps its "},{"type":"codeVoice","code":"$insert_id"},{"type":"text","text":". The bytes are"},{"type":"text","text":" "},{"type":"text","text":"the same for the same records on every run and platform: no whitespace, object members in the"},{"type":"text","text":" "},{"type":"text","text":"order of their names’ UTF-8 bytes."}],"type":"paragraph"}]}],"topicSections":[{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/init(projectToken:plan:limit:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/Failure"],"title":"Type Aliases","generated":true,"anchor":"Type-Aliases"},{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/MixpanelEncoding\/s8SendableP","doc:\/\/MixpanelEncoding\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mixpanelencoding\/mixpanelbatchencoder"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of Mixpanel’s track API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can send","type":"text"},{"text":" ","type":"text"},{"text":"events to a Mixpanel project’s ","type":"text"},{"type":"codeVoice","code":"POST \/track"},{"text":".","type":"text"}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"]]},"references":{"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/batchLimit":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"title":"batchLimit","abstract":[{"text":"Mixpanel’s limits on one request: 2,000 events, 2,000,000 bytes of body, and 999,999 bytes","type":"text"},{"text":" ","type":"text"},{"text":"of one event.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","type":"topic","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/batchlimit","role":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","navigatorTitle":[{"text":"MixpanelEncodingError","kind":"identifier"}],"title":"MixpanelEncodingError","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelEncodingError","kind":"identifier"}],"kind":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"role":"collection","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","kind":"symbol","url":"\/documentation\/mixpanelencoding","abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"type":"topic","title":"MixpanelEncoding"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","kind":"symbol","url":"\/documentation\/httpdestinations\/httpdestination","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"type":"topic","title":"HTTPDestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/Failure":{"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"navigatorTitle":[{"text":"Failure","kind":"identifier"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/Failure","abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"kind":"symbol","type":"topic","url":"\/documentation