ata"},{"type":"text","text":" "},{"type":"text","text":"resides in "},{"code":"region","type":"codeVoice"},{"type":"text","text":", with "},{"code":"URLSession.shared","type":"codeVoice"},{"type":"text","text":", retrying a send that fails for now with the"},{"type":"text","text":" "},{"type":"text","text":"waits of "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" on "},{"code":"clock","type":"codeVoice"},{"type":"text","text":"."}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/outcome(of:for:)":{"type":"topic","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/outcome(of:for:)","abstract":[{"type":"text","text":"What Mixpanel’s 2xx answer means: rejected when it found no valid event in the request,"},{"type":"text","text":" "},{"type":"text","text":"and delivered otherwise."}],"kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"HTTPTransportResponse","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EncodedRequest","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV"},{"text":") -> ","kind":"text"},{"text":"ResponseOutcome","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)","title":"outcome(of:for:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"type":"topic","url":"\/documentation\/httpdestinations\/httpdestination","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP