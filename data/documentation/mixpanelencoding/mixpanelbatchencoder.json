{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelBatchEncoder"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Make the destination with "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and Mixpanel’s limits:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let mixpanel = try HTTPDestination.mixpanel(","    projectToken: projectToken,","    region: .eu,  \/\/ or .us or .india, where the project's data resides","    plan: plan)"]},{"inlineContent":[{"text":"The body is a JSON array of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":", one object per record, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first, each with two members: ","type":"text"},{"code":"event","type":"codeVoice"},{"text":", the event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":" as it is, and ","type":"text"},{"code":"properties","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"event’s stored properties by name, then these members:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$device_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; left out for a record with no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$insert_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"distinct_id"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, as ","type":"text"},{"type":"codeVoice","code":"$device_id"},{"text":" holds it; the record’s own ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":" when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ip"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"\"0\""},{"type":"text","text":", so Mixpanel adds no location from the request’s address"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"time","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in whole milliseconds since 1970"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"token","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The project token","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"$user_id"},{"type":"text","text":", and no other device"},{"type":"text","text":" "},{"type":"text","text":"identifier. Mixpanel counts a user per "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", so its unique users are sessions. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store"},{"type":"text","text":" "},{"type":"text","text":"recovered after a relaunch, which keeps no context) is its own anonymous user, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing, rather than an event with no "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", which Mixpanel would attribute to no user,"},{"type":"text","text":" "},{"type":"text","text":"or to a hash of the request’s address. Mixpanel treats two events of the same "},{"type":"codeVoice","code":"event"},{"type":"text","text":", "},{"type":"codeVoice","code":"time"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$insert_id"},{"type":"text","text":" as one, so a recovered record that Mixpanel had already stored"},{"type":"text","text":" "},{"type":"text","text":"under its session, before the app ended, is stored again. The record’s vendor identifier and"},{"type":"text","text":" "},{"type":"text","text":"trace context, and any other context value, aren’t sent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Mixpanel cuts each string down to 255 characters. It drops an event of 255 properties or more,"},{"type":"text","text":" "},{"type":"text","text":"counting the members above and the default properties below, one holding an array of 255"},{"type":"text","text":" "},{"type":"text","text":"elements or more, and one whose property nests objects more than 3 deep, though it answers"},{"type":"text","text":" "},{"type":"text","text":"200: the encoder enforces these limits, leaving such a record out of the request."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"properties"},{"text":" also holds Mixpanel’s default properties, named as its Swift SDK names them, for","type":"text"},{"text":" ","type":"text"},{"text":"each of the keys the record’s context has a value for:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$app_version_string"},{"type":"text","text":", "},{"type":"codeVoice","code":"$app_build_number"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The version and build, each left out when "},{"type":"codeVoice","code":"nil"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$model"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The model","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$wifi","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NetworkKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Whether the connection is Wi-Fi","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$os","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_version","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The operating system’s name and version","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name starts with"},{"type":"text","text":" "},{"type":"codeVoice","code":"$"},{"type":"text","text":", as Mixpanel’s own events’ do, one with a property named as one Mixpanel reads for itself,"},{"type":"text","text":" "},{"type":"text","text":"one past Mixpanel’s limits on properties, array elements or nesting, one whose event isn’t"},{"type":"text","text":" "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is no"},{"type":"text","text":" "},{"type":"codeVoice","code":"time"},{"type":"text","text":" Mixpanel takes, and one too large for Mixpanel ("},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"reference","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Mixpanel answers a request it reads with 200, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" retries one","type":"text"},{"text":" ","type":"text"},{"text":"that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400, 401 or","type":"text"},{"text":" ","type":"text"},{"text":"413. Mixpanel answers 200 as well when it ingests none of a request’s events: a wrong region,","type":"text"},{"text":" ","type":"text"},{"text":"or a token of no project, may be answered 200 with nothing stored, so check the project’s Live","type":"text"},{"text":" ","type":"text"},{"text":"View after setting it up. Its track API ingests only events from the last 5 days: a record","type":"text"},{"text":" ","type":"text"},{"text":"older than that when it is sent, such as one a store kept through a long time offline, is","type":"text"},{"text":" ","type":"text"},{"text":"counted as delivered and not stored. A record sent again keeps its ","type":"text"},{"type":"codeVoice","code":"$insert_id"},{"text":". The bytes are","type":"text"},{"text":" ","type":"text"},{"text":"the same for the same records on every run and platform: no whitespace, object members in the","type":"text"},{"text":" ","type":"text"},{"text":"order of their names’ UTF-8 bytes.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mixpanelencoding\/mixpanelbatchencoder"]}],"abstract":[{"text":"The ","type":"text"},{