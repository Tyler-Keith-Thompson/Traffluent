kind":"identifier"}],"type":"topic","role":"symbol","title":"MixpanelBatchEncoder"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","navigatorTitle":[{"text":"MixpanelEncodingError","kind":"identifier"}],"abstract":[{"text":"Why ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelEncodingError","kind":"identifier"}],"type":"topic","role":"symbol","title":"MixpanelEncodingError"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/requests(for:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"text":"<","kind":"text"},{"text":"MixpanelEncodingError","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0aB5ErrorO"},{"text":">","kind":"text"}],"abstract":[{"code":"batch","type":"codeVoice"},{"type":"text","text":" as the requests Mixpanel takes, each within the encoder’s limit, with the records"},{"type":"text","text":" "},{"type":"text","text":"left out of them."}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/requests(for:)","title":"requests(for:)","type":"topic","kind":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/transientStatuses":{"role":"symbol","title":"transientStatuses","type":"topic","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/transientstatuses","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientStatuses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"TransientStatus","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV"},{"kind":"text","text":">"}],"kind":"symbol","abstract":[{"text":"No status beyond the 408, 429 and 5xx that ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries for every encoder.","type":"text"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/transientStatuses"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/init(projectToken:plan:limit:)":{"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"projectToken"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typ