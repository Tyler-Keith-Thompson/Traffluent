n/MixpanelEncoding/MixpanelBatchEncoder/init(projectToken:plan:limit:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/init(projectToken:plan:limit:)","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/init(projecttoken:plan:limit:)","abstract":[{"text":"An encoder of the events ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" describes, for the Mixpanel project of ","type":"text"},{"code":"projectToken","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"splitting each batch to ","type":"text"},{"code":"limit","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","role":"symbol","title":"init(projectToken:plan:limit:)"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/Failure":{"title":"MixpanelBatchEncoder.Failure","role":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/Failure","type":"topic","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/failure","abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identif