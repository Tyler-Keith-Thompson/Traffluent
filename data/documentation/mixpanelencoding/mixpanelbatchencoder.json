:"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MixpanelEncodingError"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/init(projectToken:plan:limit:)":{"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"projectToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"limit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"},{"kind":"text","text":")"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/init(projectToken:plan:limit:)","abstract":[{"text":"An encoder of the events ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" describes, for the Mixpanel project of ","type":"text"},{"type":"codeVoice","code":"projectToken"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"splitting each batch to ","type":"text"},{"type":"codeVoice","code":"limit"},{"text":".","type":"text"}],"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencod