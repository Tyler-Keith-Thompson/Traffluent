 ","kind":"text"},{"text":"Failure","kind":"identifier"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/Failure","title":"MixpanelBatchEncoder.Failure","kind":"symbol","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"type":"topic"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"navigatorTitle":[{"text":"MixpanelEncodingError","kind":"identifier"}],"role":"symbol","title":"MixpanelEncodingError","url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelEncodingError","kind":"identifier"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder":{"abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" of Mixpanel’s track API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can send","type":"text"},{"text":" ","type":"text"},{"text":"events to a Mixpanel project’s ","type":"text"},{"code":"