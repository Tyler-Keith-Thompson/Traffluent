{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","type":"reference","isActive":true},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"kind":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelEncodingError","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"MixpanelEncodingError","kind":"identifier"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"topic"},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"url":"\/documentation\/mixpanelencoding","kind":"symbol","abstract":[{"text":"Send records to a Mixpanel project through its track API.","type":"text"}],"role":"collection","title":"MixpanelEncoding","type":"topic","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/transientStatuses":{"abstract":[{"type":"text","text":"No status beyond the 408, 429 and 5xx that "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries for every encoder."}],"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/transientstatuses","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/transientStatuses","title":"transientStatuses","fragments":[{"text":"st