/MixpanelBatchEncoder\/batchLimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"}],"role":"symbol","abstract":[{"text":"Mixpanel’s limits on one request: 2,000 events, 2,000,000 bytes of body, and 999,999 bytes","type":"text"},{"text":" ","type":"text"},{"text":"of one event.","type":"text"}],"title":"batchLimit"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/outcome(of:for:)":{"role":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/outcome(of:for:)","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","kind":"typeIdentifier","text":"HTTPTransportResponse"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","kind":"typeIdentifier","text":"EncodedRequest"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","kind":"typeIdentifier","text":"ResponseOutcome"}],"kind":"symbol","abstract":[{"type":"text","text":"What Mixpanel’s 2xx answer means: rejected when it found no valid event in the request,"},{"type":"text","text":" "},{"type":"text","text":"and delivered otherwise."}],"title":"outcome(of:for:)"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder":{"url":"\/documentation\/mixpanelencoding\/mix