ableMetatypeP":{"identifier":"doc:\/\/MixpanelEncoding\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"kind":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","title":"BatchEncoder","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/Failure":{"role":"symbol","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"type":"topic","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/failure","title":"MixpanelBatchEncoder.Failure","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/Failure","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"navigatorTitle":[{"kind":"identifier","text":"Failure"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/requests(for:)":{"type":"topic","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/requests(for:)","title":"requests(for:)","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","abstract":[{"code":"batch","type":"codeVoice"},{"text":" as the requests Mixpanel takes, each within the encoder’s limit and with a deadline","type":"text"},{"text":" ","type":"text"},{"text":"119 hours after i