{"kind":"symbol","metadata":{"modules":[{"name":"UIKitTracking"}],"roleHeading":"Framework","symbolKind":"module","title":"UIKitTracking","role":"collection","externalID":"UIKitTracking"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/uikittracking"]}],"abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this module to track events from UIKit views, view controllers and controls on iOS, iPadOS,"},{"type":"text","text":" "},{"type":"text","text":"tvOS, visionOS and Mac Catalyst; elsewhere it builds empty, and on macOS and watchOS its API isn’t"},{"type":"text","text":" "},{"type":"text","text":"there. SwiftUI views use"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and AppKit views on macOS use"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker is a UIKit trait, "},{"type":"codeVoice","code":"TrackerTrait"},{"type":"text","text":". Set it on a window scene’s "},{"type":"codeVoice","code":"traitOverrides"},{"type":"text","text":" as the"},{"type":"text","text":" "},{"type":"text","text":"scene connects, and every view controller and view in the scene’s windows inherits it, the way"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI views inherit their environment. Read it in any of them as "},{"type":"codeVoice","code":"traitCollection.tracker"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"view controller or view can set its own for everything below it, and each scene keeps its own, so"},{"type":"text","text":" "},{"type":"text","text":"two windows can track through two trackers. Until a tracker is set, the trait holds"},{"type":"text","text":" "},{"type":"codeVoice","code":"Tracker.noOp"},{"type":"text","text":", which drops every event."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UIControl.track(_:for:)"},{"type":"text","text":" tracks an event each time a control sends the given control events"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".primaryActionTriggered"},{"type":"text","text":" by default), through the tracker the control’s traits hold at that"},{"type":"text","text":" "},{"type":"text","text":"moment:"}]},{"type":"codeListing","syntax":"swift","code":["import Traffluent","import UIKit","","@Event","struct ShareTapped {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","final class CartViewController: UIViewController {","    let share = UIButton(configuration: .filled())","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        checkOut.addTarget(self, action: #selector(checkOut(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","        view.addSubview(checkOut)","    }","","    @objc func checkOut(_ sender: UIButton) {","        sender.traitCollection.tracker.track(CheckoutStarted(cartSize: 3))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"]},{"type":"paragraph","inlineContent":[{"code":"track(_:for:)","type":"codeVoice"},{"text":" adds a ","type":"text"},{"code":"UIAction","type":"codeVoice"},{"text":" beside the control’s other actions and targets, so they still","type":"text"},{"text":" ","type":"text"},{"text":"run, and returns it; pass it to ","type":"text"},{"code":"removeAction(_:for:)","type":"codeVoice"},{"text":" to stop tracking. Where SwiftUI hosts","type":"text"},{"text":" ","type":"text"},{"text":"UIKit, or UIKit hosts SwiftUI, the trait and SwiftUI’s ","type":"text"},{"code":"\\.tracker","type":"codeVoice"},{"text":" are one value.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}]},{"anchor":"API","level":2,"type":"heading","text":"API"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where the module is empty, so its symbols have no pages"},{"type":"text","text":" "},{"type":"text","text":"of their own here. Their doc comments are in the sources, and Xcode shows them for an iOS target."}]},{"items":[{"content":[{"inlineContent":[{"code":"TrackerTrait","type":"codeVoice"},{"text":": the trait holding the tracker, ","type":"text"},{"code":"Tracker.noOp","type":"codeVoice"},{"text":" until one is set.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UITraitCollection.tracker","type":"codeVoice"},{"text":": reads the trait.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UIMutableTraits.tracker","type":"codeVoice"},{"type":"text","text":": sets the trait on a window scene’s, view controller’s or view’s"},{"type":"text","text":" "},{"code":"traitOverrides","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UIControl.track(_:for:)","type":"codeVoice"},{"text":": tracks an event each time the control sends the given control events.","type":"text"}]}]}],"type":"unorderedList"}]}],"references":{"doc://UIKitTracking/documentation/UIKitTracking":{"kind":"symbol","title":"UIKitTracking","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","role":"collection","type":"topic","url":"\/documentation\/uikittracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","type":"link","title":"Tracking from SwiftUI, UIKit and AppKit","titleInlineContent":[{"type":"text","text":"Tracking from SwiftUI, UIKit and AppKit"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","title":"SwiftUITracking","titleInlineContent":[{"type":"codeVoice","code":"SwiftUITracking"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"type":"link","title":"AppKitTracking","titleInlineContent":[{"type":"codeVoice","code":"AppKitTracking"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"}}}