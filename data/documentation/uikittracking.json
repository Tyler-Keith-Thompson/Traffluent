{"abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/uikittracking"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},"hierarchy":{"paths":[[]]},"kind":"symbol","sections":[],"metadata":{"modules":[{"name":"UIKitTracking"}],"roleHeading":"Framework","role":"collection","title":"UIKitTracking","symbolKind":"module","externalID":"UIKitTracking"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Use this module to track events from UIKit views, view controllers and controls on iOS, iPadOS,","type":"text"},{"text":" ","type":"text"},{"text":"tvOS, visionOS and Mac Catalyst; elsewhere it builds empty, and on macOS and watchOS its API isn’t","type":"text"},{"text":" ","type":"text"},{"text":"there. SwiftUI views use","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and AppKit views on macOS use","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tracker is a UIKit trait, "},{"code":"TrackerTrait","type":"codeVoice"},{"type":"text","text":". Set it on a window scene’s "},{"code":"traitOverrides","type":"codeVoice"},{"type":"text","text":" as the"},{"type":"text","text":" "},{"type":"text","text":"scene connects, and every view controller and view in the scene’s windows inherits it, the way"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI views inherit their environment. Read it in any of them as "},{"code":"traitCollection.tracker","type":"codeVoice"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"view controller or view can set its own for everything below it, and each scene keeps its own, so"},{"type":"text","text":" "},{"type":"text","text":"two windows can track through two trackers. Until a tracker is set, the trait holds"},{"type":"text","text":" "},{"code":"Tracker.noOp","type":"codeVoice"},{"type":"text","text":", which drops every event."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"UIControl.track(_:for:)"},{"text":" tracks an event each time a control sends the given control events","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":".primaryActionTriggered"},{"text":" by default), through the tracker the control’s traits hold at that","type":"text"},{"text":" ","type":"text"},{"text":"moment:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Traffluent","import UIKit","","@Event","struct ShareTapped {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","final class CartViewController: UIViewController {","    let share = UIButton(configuration: .filled())","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        checkOut.addTarget(self, action: #selector(checkOut(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","        view.addSubview(checkOut)","    }","","    @objc func checkOut(_ sender: UIButton) {","        sender.traitCollection.tracker.track(CheckoutStarted(cartSize: 3))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"track(_:for:)"},{"type":"text","text":" adds a "},{"type":"codeVoice","code":"UIAction"},{"type":"text","text":" beside the control’s other actions and targets, so they still"},{"type":"text","text":" "},{"type":"text","text":"run, and returns it; pass it to "},{"type":"codeVoice","code":"removeAction(_:for:)"},{"type":"text","text":" to stop tracking. Where SwiftUI hosts"},{"type":"text","text":" "},{"type":"text","text":"UIKit, or UIKit hosts SwiftUI, the trait and SwiftUI’s "},{"type":"codeVoice","code":"\\.tracker"},{"type":"text","text":" are one value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}],"type":"paragraph"},{"level":2,"text":"API","anchor":"API","type":"heading"},{"inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where the module is empty, so its symbols have no pages"},{"type":"text","text":" "},{"type":"text","text":"of their own here. Their doc comments are in the sources, and Xcode shows them for an iOS target."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"TrackerTrait","type":"codeVoice"},{"text":": the trait holding the tracker, ","type":"text"},{"code":"Tracker.noOp","type":"codeVoice"},{"text":" until one is set.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UITraitCollection.tracker","type":"codeVoice"},{"type":"text","text":": reads the trait."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UIMutableTraits.tracker"},{"text":": sets the trait on a window scene’s, view controller’s or view’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"traitOverrides"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UIControl.track(_:for:)","type":"codeVoice"},{"type":"text","text":": tracks an event each time the control sends the given control events."}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","title":"AppKitTracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","titleInlineContent":[{"code":"AppKitTracking","type":"codeVoice"}]},"doc://UIKitTracking/documentation/UIKitTracking":{"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","url":"\/documentation\/uikittracking","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"kind":"symbol","title":"UIKitTracking","type":"topic","role":"collection"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","title":"Tracking from SwiftUI, UIKit and AppKit","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","titleInlineContent":[{"text":"Tracking from SwiftUI, UIKit and AppKit","type":"text"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"title":"SwiftUITracking","titleInlineContent":[{"code":"SwiftUITracking","type":"codeVoice"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"}}}