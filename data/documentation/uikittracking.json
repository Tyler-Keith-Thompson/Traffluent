{"sections":[],"identifier":{"url":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use this module to track events from UIKit views, view controllers and controls on iOS, iPadOS,","type":"text"},{"text":" ","type":"text"},{"text":"tvOS, visionOS and Mac Catalyst; elsewhere it builds empty, and on macOS and watchOS its API isn’t","type":"text"},{"text":" ","type":"text"},{"text":"there. SwiftUI views use","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and AppKit views on macOS use","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The tracker is a UIKit trait, ","type":"text"},{"type":"codeVoice","code":"TrackerTrait"},{"text":". Set it on a window scene’s ","type":"text"},{"type":"codeVoice","code":"traitOverrides"},{"text":" as the","type":"text"},{"text":" ","type":"text"},{"text":"scene connects, and every view controller and view in the scene’s windows inherits it, the way","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI views inherit their environment. Read it in any of them as ","type":"text"},{"type":"codeVoice","code":"traitCollection.tracker"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"view controller or view can set its own for everything below it, and each scene keeps its own, so","type":"text"},{"text":" ","type":"text"},{"text":"two windows can track through two trackers. Until a tracker is set, the trait’s tracker tracks","type":"text"},{"text":" ","type":"text"},{"text":"through the one ","type":"text"},{"type":"codeVoice","code":"Tracker.bootstrap"},{"text":" made the process’s default, and with none it drops each event,","type":"text"},{"text":" ","type":"text"},{"text":"warning once per call site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"UIControl.track(_:for:)","type":"codeVoice"},{"type":"text","text":" tracks an event each time a control sends the given control events"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":".primaryActionTriggered","type":"codeVoice"},{"type":"text","text":" by default), through the tracker the control’s traits hold at that"},{"type":"text","text":" "},{"type":"text","text":"moment:"}]},{"type":"codeListing","code":["import Traffluent","import UIKit","","@Event","struct ShareTapped {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","final class CartViewController: UIViewController {","    let share = UIButton(configuration: .filled())","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        checkOut.addTarget(self, action: #selector(checkOut(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","        view.addSubview(checkOut)","    }","","    @objc func checkOut(_ sender: UIButton) {","        sender.traitCollection.tracker.track(CheckoutStarted(cartSize: 3))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"track(_:for:)","type":"codeVoice"},{"text":" adds a ","type":"text"},{"code":"UIAction","type":"codeVoice"},{"text":" beside the control’s other actions and targets, so they still","type":"text"},{"text":" ","type":"text"},{"text":"run, and returns it; pass it to ","type":"text"},{"code":"removeAction(_:for:)","type":"codeVoice"},{"text":" to stop tracking. Where SwiftUI hosts","type":"text"},{"text":" ","type":"text"},{"text":"UIKit, or UIKit hosts SwiftUI, the trait and SwiftUI’s ","type":"text"},{"code":"\\.tracker","type":"codeVoice"},{"text":" are one value.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers all three frameworks.","type":"text"}]},{"type":"heading","level":2,"anchor":"API","text":"API"},{"type":"paragraph","inlineContent":[{"text":"The documentation site is built on Linux, where the module is empty, so its symbols have no pages","type":"text"},{"text":" ","type":"text"},{"text":"of their own here. Their doc comments are in the sources, and Xcode shows them for an iOS target.","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TrackerTrait"},{"type":"text","text":": the trait holding the tracker. Until one is set, it holds a stand-in that"},{"type":"text","text":" "},{"type":"text","text":"resolves when it tracks: to the bootstrapped tracker, or, with none, to a drop and a warning."}]}]},{"content":[{"inlineContent":[{"code":"UITraitCollection.tracker","type":"codeVoice"},{"type":"text","text":": reads the trait."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"UIMutableTraits.tracker"},{"type":"text","text":": sets the trait on a window scene’s, view controller’s or view’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"traitOverrides"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"UIControl.track(_:for:)","type":"codeVoice"},{"text":": tracks an event each time the control sends the given control events.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/uikittracking"]}],"metadata":{"title":"UIKitTracking","modules":[{"name":"UIKitTracking"}],"externalID":"UIKitTracking","roleHeading":"Framework","symbolKind":"module","role":"collection"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"title":"AppKitTracking","titleInlineContent":[{"code":"AppKitTracking","type":"codeVoice"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"link"},"doc://UIKitTracking/documentation/UIKitTracking":{"role":"collection","url":"\/documentation\/uikittracking","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"title":"UIKitTracking","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","kind":"symbol","type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"title":"Tracking from SwiftUI, UIKit and AppKit","titleInlineContent":[{"text":"Tracking from SwiftUI, UIKit and AppKit","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","type":"link"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"titleInlineContent":[{"type":"codeVoice","code":"SwiftUITracking"}],"title":"SwiftUITracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"}}}