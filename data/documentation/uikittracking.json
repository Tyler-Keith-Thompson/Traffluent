{"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Use this module to track events from UIKit views, view controllers and controls on iOS, iPadOS,","type":"text"},{"text":" ","type":"text"},{"text":"tvOS, visionOS and Mac Catalyst; elsewhere it builds empty, and on macOS and watchOS its API isn’t","type":"text"},{"text":" ","type":"text"},{"text":"there. SwiftUI views use","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and AppKit views on macOS use","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The tracker is a UIKit trait, ","type":"text"},{"code":"TrackerTrait","type":"codeVoice"},{"text":". Set it on a window scene’s ","type":"text"},{"code":"traitOverrides","type":"codeVoice"},{"text":" as the","type":"text"},{"text":" ","type":"text"},{"text":"scene connects, and every view controller and view in the scene’s windows inherits it, the way","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI views inherit their environment. Read it in any of them as ","type":"text"},{"code":"traitCollection.tracker","type":"codeVoice"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"view controller or view can set its own for everything below it, and each scene keeps its own, so","type":"text"},{"text":" ","type":"text"},{"text":"two windows can track through two trackers. Until a tracker is set, the trait’s tracker tracks","type":"text"},{"text":" ","type":"text"},{"text":"through the one ","type":"text"},{"code":"Tracker.bootstrap","type":"codeVoice"},{"text":" made the process’s default, and with none it drops each event,","type":"text"},{"text":" ","type":"text"},{"text":"warning once per call site.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"UIControl.track(_:for:)"},{"type":"text","text":" tracks an event each time a control sends the given control events"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".primaryActionTriggered"},{"type":"text","text":" by default), through the tracker the control’s traits hold at that"},{"type":"text","text":" "},{"type":"text","text":"moment:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import Traffluent","import UIKit","","@Event","struct ShareTapped {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","final class CartViewController: UIViewController {","    let share = UIButton(configuration: .filled())","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        checkOut.addTarget(self, action: #selector(checkOut(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","        view.addSubview(checkOut)","    }","","    @objc func checkOut(_ sender: UIButton) {","        sender.traitCollection.tracker.track(CheckoutStarted(cartSize: 3))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"]},{"inlineContent":[{"type":"codeVoice","code":"track(_:for:)"},{"type":"text","text":" adds a "},{"type":"codeVoice","code":"UIAction"},{"type":"text","text":" beside the control’s other actions and targets, so they still"},{"type":"text","text":" "},{"type":"text","text":"run, and returns it; pass it to "},{"type":"codeVoice","code":"removeAction(_:for:)"},{"type":"text","text":" to stop tracking. Where SwiftUI hosts"},{"type":"text","text":" "},{"type":"text","text":"UIKit, or UIKit hosts SwiftUI, the trait and SwiftUI’s "},{"type":"codeVoice","code":"\\.tracker"},{"type":"text","text":" are one value."}],"type":"paragraph"},{"inlineContent":[{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers all three frameworks.","type":"text"}],"type":"paragraph"},{"anchor":"API","text":"API","type":"heading","level":2},{"inlineContent":[{"text":"The documentation site is built on Linux, where the module is empty, so its symbols have no pages","type":"text"},{"text":" ","type":"text"},{"text":"of their own here. Their doc comments are in the sources, and Xcode shows them for an iOS target.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"TrackerTrait"},{"type":"text","text":": the trait holding the tracker. Until one is set, it holds a stand-in that"},{"type":"text","text":" "},{"type":"text","text":"resolves when it tracks: to the bootstrapped tracker, or, with none, to a drop and a warning."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"UITraitCollection.tracker","type":"codeVoice"},{"text":": reads the trait.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UIMutableTraits.tracker"},{"type":"text","text":": sets the trait on a window scene’s, view controller’s or view’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"traitOverrides"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"code":"UIControl.track(_:for:)","type":"codeVoice"},{"text":": tracks an event each time the control sends the given control events.","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/uikittracking"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},"metadata":{"symbolKind":"module","roleHeading":"Framework","title":"UIKitTracking","role":"collection","modules":[{"name":"UIKitTracking"}],"externalID":"UIKitTracking"},"hierarchy":{"paths":[[]]},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"titleInlineContent":[{"code":"SwiftUITracking","type":"codeVoice"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","title":"SwiftUITracking","type":"link"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"titleInlineContent":[{"type":"text","text":"Tracking from SwiftUI, UIKit and AppKit"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","type":"link","title":"Tracking from SwiftUI, UIKit and AppKit","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},"doc://UIKitTracking/documentation/UIKitTracking":{"type":"topic","role":"collection","kind":"symbol","title":"UIKitTracking","url":"\/documentation\/uikittracking","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"titleInlineContent":[{"type":"codeVoice","code":"AppKitTracking"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/T