{"metadata":{"roleHeading":"Structure","remoteSource":{"fileName":"PostHogBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/PostHogEncoding\/PostHogBatchEncoder.swift#L83"},"role":"symbol","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"modules":[{"name":"PostHogEncoding"}],"navigatorTitle":[{"text":"PostHogBatchEncoder","kind":"identifier"}],"title":"PostHogBatchEncoder","externalID":"s:15PostHogEncoding0aB12BatchEncoderV"},"seeAlsoSections":[{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatch"],"generated":true,"anchor":"Encoding-batches","title":"Encoding batches"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","import Instrumentation","import PostHogEncoding","import TrackingPlans","","let plan = try TrackingPlan(schemas: [SignedUp.schema, SessionStarted.schema, SessionEnded.schema])","let postHog = HTTPDestination(","    endpoint: batchURL,  \/\/ https:\/\/us.i.posthog.com\/batch\/, or your instance's","    instrument: NoOpInstrument(),  \/\/ no trace context in the request's header fields","    encoder: PostHogBatchEncoder(projectToken: projectToken, plan: plan))","let delivery = tracker.records.batch().deliver(to: postHog)"]},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"type":"codeVoice","code":"application\/json"},{"text":" with two members: ","type":"text"},{"type":"codeVoice","code":"api_key"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"project token, and ","type":"text"},{"type":"codeVoice","code":"batch"},{"text":", one object per record, oldest first, with these members:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"distinct_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":" when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"event"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"properties","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s stored properties, by name, then the members listed below"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"timestamp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked: ISO 8601 in UTC, with milliseconds (","type":"text"},{"code":"2026-11-23T14:03:27.512Z","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"uuid"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent, and every event is anonymous: "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" holds"},{"type":"text","text":" "},{"type":"codeVoice","code":"$process_person_profile: false"},{"type":"text","text":", so PostHog makes no person profile, and "},{"type":"codeVoice","code":"$geoip_disable: true"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one"},{"type":"text","text":" "},{"type":"text","text":"tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store recovered after a relaunch,"},{"type":"text","text":" "},{"type":"text","text":"which keeps no context) is its own anonymous person, linked to nothing: PostHog rejects a whole"},{"type":"text","text":" "},{"type":"text","text":"batch when one of its events has no "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":". PostHog counts a person per "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so its unique users are sessions. The session is also sent as "},{"type":"codeVoice","code":"$session_id"},{"type":"text","text":", which PostHog’s"},{"type":"text","text":" "},{"type":"text","text":"sessions and web analytics group events by ("},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" is the UUIDv7 they require); a record"},{"type":"text","text":" "},{"type":"text","text":"with no session has none. The record’s vendor identifier and trace context, and any other"},{"type":"text","text":" "},{"type":"text","text":"context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read from the event’s "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":" form, which "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"types its schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" lists: a "},{"code":"String","type":"codeVoice"},{"type":"text","text":" is a string; a "},{"code":"Bool","type":"codeVoice"},{"type":"text","text":" a boolean; an integer, a"},{"type":"text","text":" "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" or a "},{"code":"Float","type":"codeVoice"},{"type":"text","text":" a number; a "},{"code":"Date","type":"codeVoice"},{"type":"text","text":" an ISO 8601 string, as "},{"code":"timestamp","type":"codeVoice"},{"type":"text","text":" is; a "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":" an"},{"type":"text","text":" "},{"type":"text","text":"uppercase UUID string; an array an array; and an optional’s "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" is "},{"code":"null","type":"codeVoice"},{"type":"text","text":". A "},{"code":"Refined","type":"codeVoice"},{"type":"text","text":" value"},{"type":"text","text":" "},{"type":"text","text":"is its value. A type the plan can’t map is written as its encoding holds it. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"code":"null","type":"codeVoice"},{"type":"text","text":". A property whose name starts with"},{"type":"text","text":" "},{"code":"$","type":"codeVoice"},{"type":"text","text":", which only a hand-written "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":" conformance can write, or is "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":", is"},{"type":"text","text":" "},{"type":"text","text":"left out and logged at notice level, as PostHog reads those names as settings ("},{"code":"$set","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"$process_person_profile","type":"codeVoice"},{"type":"text","text":") or the identity."}]},{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"},{"type":"text","text":" also holds these members, for each of the keys the record’s context has a value"},{"type":"text","text":" "},{"type":"text","text":"for:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$app_namespace"},{"type":"text","text":", "},{"type":"codeVoice","code":"$app_version"},{"type":"text","text":", "},{"type":"codeVoice","code":"$app_build"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The bundle identifier, version and build, each left out when ","type":"text"},{"type":"codeVoice","code":"nil"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$device_type"}]}],[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model, and "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":", "},{"type":"codeVoice","code":"Tablet"},{"type":"text","text":", "},{"type":"codeVoice","code":"Desktop"},{"type":"text","text":", "},{"type":"codeVoice","code":"TV"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Vision"},{"type":"text","text":" for the form factor; no "},{"type":"codeVoice","code":"$device_type"},{"type":"text","text":" for a watch"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$locale"}]}],[{"type":"paragraph","inlineContent":[{"code":"LocaleKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"code":"en-US","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$network_wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"$network_cellular"}]}],[{"type":"paragraph","inlineContent":[{"code":"NetworkKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Whether the connection is Wi-Fi, and whether it is cellular","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$os_name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_version","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The operating system’s name and version"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the body, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name starts with ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(a name PostHog keeps for its own events), one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", or one that","type":"text"},{"text":" ","type":"text"},{"text":"holds a value JSON can’t (","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","type":"reference","isActive":true},{"text":"). Each is logged at error level;","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","type":"reference","isActive":true},{"text":" returns them as ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/docu