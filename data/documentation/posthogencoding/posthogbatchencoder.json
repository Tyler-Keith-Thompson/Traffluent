SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name, then the members listed below","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked: ISO 8601 in UTC, with milliseconds ("},{"code":"2026-11-23T14:03:27.512Z","type":"codeVoice"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"uuid"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent, and every event is anonymous: ","type":"text"},{"type":"codeVoice","code":"properties"},{"text":" holds","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"$process_person_profile: false"},{"text":", so PostHog makes no person profile, and ","type":"text"},{"type":"codeVoice","code":"$geoip_disable: true"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one","type":"text"},{"text":" ","type":"text"},{"text":"tracked by a tracker without ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":", or one a store recovered after a relaunch,","type":"text"},{"text":" ","type":"text"},{"text":"which keeps no context) is its own anonymous person, linked to nothing: PostHog rejects a whole","type":"text"},{"text":" ","type":"text"},{"text":"batch when one of its events has no ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":". PostHog counts a person per ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so its unique users are sessions. The session is also sent as ","type":"text"},{"type":"codeVoice","code":"$session_id"},{"text":", which PostHog’s","type":"text"},{"text":" ","type":"text"},{"text":"sessions and web analytics group events by (","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":" is the UUIDv7 they require); a record","type":"text"},{"text":" ","type":"text"},{"text":"with no session has none. The record’s vendor identifier and trace context, and any other","type":"text"},{"text":" ","type":"text"},{"text":"context value, aren’t sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"code":"null","type":"codeVoice"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"property whose name starts with "},{"code":"$","type":"codeVoice"},{"type":"text","text":", which only a hand-written "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":" conformance can"},{"type":"text","text":" "},{"type":"text","text":"write, or is "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":", is left out and logged at notice level, as PostHog reads those"},{"type":"text","text":" "},{"type":"text","text":"names as settings ("},{"code":"$set","type":"codeVoice"},{"type":"text","text":", "},{"code":"$process_person_profile","type":"codeVoice"},{"type":"text","text":") or the identity."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"},{"text":" also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$app_namespace","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_build","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The bundle identifier, version and build, each left out when "},{"code":"nil","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$device_type"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The model, and ","type":"text"},{"code":"Mobile","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Tablet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Desktop","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TV","type":"code