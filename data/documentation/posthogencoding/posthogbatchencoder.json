"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogEncodingError":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogEncodingError","kind":"identifier"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/posthogencoding\/posthogencodingerror","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","title":"PostHogEncodingError","abstract":[{"type":"text","text":"Why "},{"isActive":true,"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no record of"},{"type":"text","text":" "},{"type":"text","text":"a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"navigatorTitle":[{"text":"PostHogEncodingError","kind":"identifier"}]},"doc://PostHogEncoding/s16SendableMetatypeP":{"identifier":"doc:\/\/PostHogEncoding\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/Failure":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/Failure","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"type":"topic","url":"\/documentation\/posthogencoding\/posthogbatchencoder\/failure","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"kind":"symbol","title":"PostHogBatchEncoder.Failure","navigatorTitle":[{"kind":"identifier","text":"Failure"}],"role":"symbol"},"doc://HT