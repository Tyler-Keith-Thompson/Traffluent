text":"PostHog answers a batch it takes with 200, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries one that gets no"},{"type":"text","text":" "},{"type":"text","text":"response, a 5xx, 408 or 429, and drops one it rejects. A record sent again keeps its "},{"type":"codeVoice","code":"uuid"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The bytes are the same for the same records on every run and platform: no whitespace, object"},{"type":"text","text":" "},{"type":"text","text":"members in the order of their names’ UTF-8 bytes. PostHog takes a body of up to 20 MB, so keep"},{"type":"text","text":" "},{"type":"text","text":"batches far smaller ("},{"type":"codeVoice","code":"batch()"},{"type":"text","text":" sends 20 records at most)."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"},"references":{"doc://PostHogEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/PostHogEncoding\/s16SendableMetatypeP"},"doc://PostHogEncoding/s8SendableP":{"identifier":"doc:\/\/PostHogEncoding\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/encode(_:)":{"url":"\/documentation\/posthogencoding\/posthogbatchencoder\/encode(_:)","abstract":[{"type":"text","text":"The request body for "},{"code":"batch","type":"codeVoice"},{"type":"text","text":": its records as PostHog’s batch capture API takes them, but"},{"type":"text","text":" "},{"type":"text","text":"for those it can’t encode, which are logged at error level and left out."}],"kind":"symbol","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)","type":"topic","title":"encode(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"ident