yword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","url":"\/documentation\/events\/sensitive","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as one request, and"},{"type":"text","text":" "},{"type":"text","text":"sends it again until it arrives."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","role":"symbol","navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"url":"\/documentation\/httpdestinations\/httpdestination","title":"HTTPDestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}]},"doc://PostHogEncoding/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/PostHogEncoding\/s8SendableP","title":"Swift.Sendable"}}}