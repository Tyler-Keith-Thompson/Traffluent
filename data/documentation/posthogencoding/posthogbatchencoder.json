er","isActive":true},{"text":" couldn’t encode a record, which it leaves out of the batch’s body","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","isActive":true},{"text":". When it can encode no record of a batch,","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)","isActive":true},{"text":" throws the first one’s, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing","type":"text"},{"text":" ","type":"text"},{"text":"for the batch and logs the error.","type":"text"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","url":"\/documentation\/posthogencoding\/posthogencodingerror","role":"symbol"},"doc://Events/documentation/Events/Sensitive":{"role":"symbol","url":"\/documentation\/events\/sensitive","title":"Sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"}}}