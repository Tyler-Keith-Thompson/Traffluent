ch","type":"codeVoice"},{"text":" encoded as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)","type":"reference"},{"text":" encodes it, with the records left out of the body.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","title":"batch(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"PostHogBatch","kind":"typeIdentifier","preciseIdentifier":"s:15PostHogEncoding0aB5BatchV"}]},"doc://PostHogEncoding/s16SendableMetatypeP":{"identifier":"doc:\/\/PostHogEncoding\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatch":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatch","kind":"identifier"}],"title":"PostHogBatch","abstract":[{"type":"text","text":"A batch as "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","isActive":true},{"type":"text","text":" encodes it: the body of the records it could"},{"type":"text","text":" "},{"type":"text","text":"encode, and the records it left out."}],"navigatorTitle":[{"text":"PostHogBatch","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/posthogencoding\/posthogbatch","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatch","role":"symbol"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogEncodingError":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEnc