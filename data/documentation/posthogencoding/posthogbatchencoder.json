{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/posthogencoding\/posthogbatchencoder"]}],"sections":[],"topicSections":[{"generated":true,"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/init(projectToken:plan:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)"],"anchor":"Instance-Methods","title":"Instance Methods"}],"metadata":{"navigatorTitle":[{"text":"PostHogBatchEncoder","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:15PostHogEncoding0aB12BatchEncoderV","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"modules":[{"name":"PostHogEncoding"}],"role":"symbol","remoteSource":{"fileName":"PostHogBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/PostHogEncoding\/PostHogBatchEncoder.swift#L82"},"title":"PostHogBatchEncoder"},"abstract":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"text":" of PostHog’s batch capture API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" ","type":"text"},{"text":"can send events to PostHog Cloud or a self-hosted PostHog’s ","type":"text"},{"type":"codeVoice","code":"POST \/batch\/"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"]]},"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/PostHogEncoding\/s8SendableP","doc:\/\/PostHogEncoding\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"identifier":{"url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatch"],"anchor":"Encoding-batches","title":"Encoding batches"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"syntax":"swift","code":["import HTTPDestinations","import Instrumentation","import PostHogEncoding","import TrackingPlans","","let plan = TrackingPlan(schemas: [SignedUp.schema, SessionStarted.schema, SessionEnded.schema])","let postHog = HTTPDestination(","    endpoint: batchURL,  \/\/ https:\/\/us.i.posthog.com\/batch\/, or your instance's","    instrument: NoOpInstrument(),  \/\/ no trace context in the request's header fields","    encoder: PostHogBatchEncoder(projectToken: projectToken, plan: plan))","let delivery = tracker.records.batch().deliver(to: postHog)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":" with two members: "},{"code":"api_key","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"project token, and "},{"code":"batch","type":"codeVoice"},{"type":"text","text":", one object per record, oldest first, with these members:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"distinct_id"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, its ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":" when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"event"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"properties"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s stored properties, by name, then the members listed below","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"timestamp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked: ISO 8601 in UTC, with milliseconds ("},{"type":"codeVoice","code":"2026-11-23T14:03:27.512Z"},{"type":"text","text":")"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"uuid"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent, and every event is anonymous: "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" holds"},{"type":"text","text":" "},{"type":"codeVoice","code":"$process_person_profile: false"},{"type":"text","text":", so PostHog makes no person profile, and "},{"type":"codeVoice","code":"$geoip_disable: true"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one"},{"type":"text","text":" "},{"type":"text","text":"tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store recovered after a relaunch,"},{"type":"text","text":" "},{"type":"text","text":"which keeps no context) is its own anonymous person, linked to nothing: PostHog rejects a whole"},{"type":"text","text":" "},{"type":"text","text":"batch when one of its events has no "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":". PostHog counts a person per "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so its unique users are sessions. The session is also sent as "},{"type":"codeVoice","code":"$session_id"},{"type":"text","text":", which PostHog’s"},{"type":"text","text":" "},{"type":"text","text":"sessions and web analytics group events by ("},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" is the UUIDv7 they require); a record"},{"type":"text","text":" "},{"type":"text","text":"with no session has none. The record’s vendor identifier and trace context, and any other"},{"type":"text","text":" "},{"type":"text","text":"context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read from the event’s "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" form, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"types its schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" lists: a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" is a string; a "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" a boolean; an integer, a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"Float"},{"type":"text","text":" a number; a "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" an ISO 8601 string, as "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":" is; a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" an"},{"type":"text","text":" "},{"type":"text","text":"uppercase UUID string; an array an array; and an optional’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". A "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value"},{"type":"text","text":" "},{"type":"text","text":"is its value. A "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the"},{"type":"text","text":" "},{"type":"text","text":"property is left out, and an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". A property whose name starts with"},{"type":"text","text":" "},{"type":"codeVoice","code":"$"},{"type":"text","text":", which only a hand-written "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" conformance can write, or is "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", is"},{"type":"text","text":" "},{"type":"text","text":"left out and logged at notice level, as PostHog reads those names as settings ("},{"type":"codeVoice","code":"$set"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"$process_person_profile"},{"type":"text","text":") or the identity."}]},{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"},{"text":" also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$app_namespace"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$app_version"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$app_build"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The bundle identifier, version and build, each left out when "},{"type":"codeVoice","code":"nil"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$device_type"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model, and "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":", "},{"type":"codeVoice","code":"Tablet"},{"type":"text","text":", "},{"type":"codeVoice","code":"Desktop"},{"type":"text","text":", "},{"type":"codeVoice","code":"TV"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Vision"},{"type":"text","text":" for the form factor; no "},{"type":"codeVoice","code":"$device_type"},{"type":"text","text":" for a watch"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$locale"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"type":"codeVoice","code":"en-US"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$network_wifi","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$network_cellular","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"NetworkKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether the connection is Wi-Fi, and whether it is cellular"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$os_name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_version","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The operating system’s name and version"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the body, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":" "},{"type":"text","text":"(a name PostHog keeps for its own events), one whose event isn’t "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":", or one that"},{"type":"text","text":" "},{"type":"text","text":"holds a value JSON can’t ("},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","type":"reference","isActive":true},{"type":"text","text":"). Each is logged at error level;"},{"type":"text","text":" "},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","type":"reference","isActive":true},{"type":"text","text":" returns them as "},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","type":"reference","isActive":true},{"type":"text","text":"s. When every record of a batch is left"},{"type":"text","text":" "},{"type":"text","text":"out, "},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)","type":"reference","isActive":true},{"type":"text","text":" throws, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for it."}]},{"type":"paragraph","inlineContent":[{"text":"PostHog answers a batch it takes with 200, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries one that gets no","type":"text"},{"text":" ","type":"text"},{"text":"response, a 5xx, 408 or 429, and drops one it rejects. A record sent again keeps its ","type":"text"},{"code":"uuid","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The bytes are the same for the same records on every run and platform: no whitespace, object","type":"text"},{"text":" ","type":"text"},{"text":"members in the order of their names’ UTF-8 bytes. PostHog takes a body of up to 20 MB, so keep","type":"text"},{"text":" ","type":"text"},{"text":"batches far smaller (","type":"text"},{"code":"batch()","type":"codeVoice"},{"text":" sends 20 records at most).","type":"text"}]}],"kind":"content"}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://PostHogEncoding/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/PostHogEncoding\/s8SendableP","title":"Swift.Sendable"},"doc://PostHogEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/PostHogEncoding\/s16SendableMetatypeP"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/encode(_:)":{"type":"topic","title":"encode(_:)","role":"symbol","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)","url":"\/documentation\/posthogencoding\/posthogbatchencoder\/encode(_:)","abstract":[{"type":"text","text":"The request body for "},{"code":"batch","type":"codeVoice"},{"type":"text","text":": its records as PostHog’s batch capture API takes them, but"},{"type":"text","text":" "},{"type":"text","text":"for those it can’t encode, which are logged at error level and left out."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"encode"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]) "},{"kind":"k