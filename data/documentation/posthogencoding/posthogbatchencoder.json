{"identifier":{"url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and PostHog’s limits:"}]},{"type":"codeListing","code":["let postHog = try HTTPDestination.postHog(","    projectToken: projectToken,","    host: postHogHost,  \/\/ https:\/\/eu.i.posthog.com","    plan: plan)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":" with two members: "},{"type":"codeVoice","code":"api_key"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"project token, and "},{"type":"codeVoice","code":"batch"},{"type":"text","text":", one object per record, oldest first, with these members:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"distinct_id"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":" when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, by name, then the members listed below"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked: ISO 8601 in UTC, with milliseconds ("},{"type":"codeVoice","code":"2026-11-23T14:03:27.512Z"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"uuid"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent, and every event is anonymous: ","type":"text"},{"code":"properties","type":"codeVoice"},{"text":" holds","type":"text"},{"text":" ","type":"text"},{"code":"$process_person_profile: false","type":"codeVoice"},{"text":", so PostHog makes no person profile, and ","type":"text"},{"code":"$geoip_disable: true","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one","type":"text"},{"text":" ","type":"text"},{"text":"tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":", or one a store recovered after a relaunch,","type":"text"},{"text":" ","type":"text"},{"text":"which keeps no context) is its own anonymous person, linked to nothing: PostHog rejects a whole","type":"text"},{"text":" ","type":"text"},{"text":"batch when one of its events has no ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":". PostHog counts a person per ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so its unique users are sessions. The session is also sent as ","type":"text"},{"code":"$session_id","type":"codeVoice"},{"text":", which PostHog’s","type":"text"},{"text":" ","type":"text"},{"text":"sessions and web analytics group events by (","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":" is the UUIDv7 they require); a record","type":"text"},{"text":" ","type":"text"},{"text":"with no session has none. The record’s vendor identifier and trace context, and any other","type":"text"},{"text":" ","type":"text"},{"text":"context value, aren’t sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"property whose name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":", which only a hand-written "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" conformance can"},{"type":"text","text":" "},{"type":"text","text":"write, or is "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", is left out and logged at notice level, as PostHog reads those"},{"type":"text","text":" "},{"type":"text","text":"names as settings ("},{"type":"codeVoice","code":"$set"},{"type":"text","text":", "},{"type":"codeVoice","code":"$process_person_profile"},{"type":"text","text":") or the identity."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"},{"type":"text","text":" also holds these members, for each of the keys the record’s context has a value"},{"type":"text","text":" "},{"type":"text","text":"for:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$app_namespace","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_build","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The bundle identifier, version and build, each left out when "},{"code":"nil","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$device_type"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model, and "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":", "},{"type":"codeVoice","code":"Tablet"},{"type":"text","text":", "},{"type":"codeVoice","code":"Desktop"},{"type":"text","text":", "},{"type":"codeVoice","code":"TV"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Vision"},{"type":"text","text":" for the form factor; no "},{"type":"codeVoice","code":"$device_type"},{"type":"text","text":" for a watch"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$locale"}]}],[{"type":"paragraph","inlineContent":[{"code":"LocaleKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"code":"en-US","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$network_wifi"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$network_cellular"}]}],[{"type":"paragraph","inlineContent":[{"code":"NetworkKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Whether the connection is Wi-Fi, and whether it is cellular","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$os_name"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$os_version"}]}],[{"type":"paragraph","inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The operating system’s name and version","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":" "},{"type":"text","text":"(a name PostHog keeps for its own events), one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a"},{"type":"text","text":" "},{"type":"text","text":"value JSON can’t, and one too large for PostHog to store ("},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. PostHog answers a batch it takes with","type":"text"},{"text":" ","type":"text"},{"text":"200, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" retries one that gets no response, a 5xx, 408 or 429, and drops one","type":"text"},{"text":" ","type":"text"},{"text":"it rejects. A record sent again keeps its ","type":"text"},{"type":"codeVoice","code":"uuid"},{"text":". The bytes are the same for the same records","type":"text"},{"text":" ","type":"text"},{"text":"on every run and platform: no whitespace, object members in the order of their names’ UTF-8","type":"text"},{"text":" ","type":"text"},{"text":"bytes.","type":"text"}]}]}],"metadata":{"navigatorTitle":[{"text":"PostHogBatchEncoder","kind":"identifier"}],"r