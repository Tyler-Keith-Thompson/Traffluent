t","text":", one object per record, oldest first, with these members:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"distinct_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name, then the members listed below","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked: ISO 8601 in UTC, with milliseconds ("},{"type":"codeVoice","code":"2026-11-23T14:03:27.512Z"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"uuid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent, and every event is anonymous: ","type":"text"},{"code":"properties","type":"codeVoice"},{"text":" holds","type":"text"},{"text":" ","type":"text"},{"code":"$process_person_profile: false","type":"codeVoice"},{"text":", so PostHog makes no person profile, and ","type":"text"},{"code":"$geoip_disable: true","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one","type":"text"},{"text":" ","type":"text"},{"text":"tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":") is its own anonymous person, linked to","type":"text"},{"text":" ","type":"text"},{"text":"nothing: PostHog rejects a whole batch when one of its events has no ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":". A record a","type":"text"},{"text":" ","type":"text"},{"text":"store recovers after a relaunch keeps its session, so it goes out under the ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"$session_id","type":"codeVoice"},{"text":" of its first send. PostHog counts a person per ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":", so its unique users","type":"text"},{"text":" ","type":"text"},{"text":"are sessions. The session is also sent as ","type":"text"},{"code":"$session_id","type":"codeVoice"},{"text":", which PostHog’s","type":"text"},{"text":" ","type":"text"},{"text":"sessions and web analytics group events by (","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":" is the UUIDv7 they require); a record","type":"text"},{"text":" ","type":"text"},{"text":"with no session has none. The record’s vendor identifier and trace context, and any other","type":"text"},{"text":" ","type":"text"},{"text":"context value, aren’t sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"property whose name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":", which only a hand-written "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" conformance can"},{"type":"text","text":" "},{"type":"text","text":"write, or is "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", is left out and logged at notice level, as PostHog reads those"},{"type":"text","text":" "},{"type":"text","text":"names as settings ("},{"type":"codeVoice","code":"$set"},{"type":"text","text":", "},{"type":"codeVoice","code":"$process_person_profile"},{"type":"text","text":") or the identity."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"},{"type":"text","text":" also holds these members, for each of the keys the record’s context has a value"},{"type":"text","text":" "},{"type":"text","text":"for:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$app_namespace","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_build","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The bundle identifier, version and build, each left out when "},{"code":"nil","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$device_model","type":"codeVoice"},{"type":"text","text":", "},{"code":"$device_type","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The model, and ","type":"text"},{"code":"Mobile","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Tablet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Desktop","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TV","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Vision","type":"codeVoice"},{"text":" for the form factor; no ","type":"text"},{"code":"$device_type","type":"codeVoice"},{"text":" for a watch","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$locale","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"code":"en-US","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$network_wifi","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$network_cellular","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NetworkKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether the connection is Wi-Fi, and whether it is cellular"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$os_name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_version","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The operating system’s name and version"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":" "},{"type":"text","text":"(a name PostHog keeps for its own events), one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a"},{"type":"text","text":" "},{"type":"text","text":"value JSON can’t, one whose timestamp has no ISO 8601 form, and one too large for PostHog to"},{"type":"text","text":" "},{"type":"text","text":"store ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"},{"type":"text","text":")."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/requests(for:)"},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. PostHog answers a batch it takes with"},{"type":"text","text":" "},{"type":"text","text":"200, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries one that gets no response, a 5xx, 408 or 429, and drops one"},{"type":"text","text":" "},{"type":"text","text":"it rejects. A record sent again keeps its "},{"type":"codeVoice","code":"uuid"},{"type":"text","text":". The bytes are the same for the same records"},{"type":"text","text":" "},{"type":"text","text":"on every run and platform: no whitespace, object members in the order of their names’ UTF-8"},{"type":"text","text":" "},{"type":"text","text":"bytes."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"]]},"references":{"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/init(projectToken:plan:limit:)":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/init(projectToken:plan:limit:)","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"An encoder of the events "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" describes, for the PostHog project of "},{"code":"projectToken","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"splitting each batch to "},{"code":"limit","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/posthogencoding\/posthogbatchencoder\/init(projecttoken:plan:limit:)","title":"init(projectToken:plan:limit:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13Tr