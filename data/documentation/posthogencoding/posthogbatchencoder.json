{"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" of PostHog’s batch capture API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" ","type":"text"},{"text":"can send events to PostHog Cloud or a self-hosted PostHog’s ","type":"text"},{"type":"codeVoice","code":"POST \/batch\/"},{"text":".","type":"text"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/PostHogEncoding\/s8SendableP","doc:\/\/PostHogEncoding\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/posthogencoding\/posthogbatchencoder"]}],"hierarchy":{"paths":[["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"]]},"sections":[],"kind":"symbol","metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatchEncoder","kind":"identifier"}],"symbolKind":"struct","role":"symbol","remoteSource":{"fileName":"PostHogBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/PostHogEncoding\/PostHogBatchEncoder.swift#L82"},"externalID":"s:15PostHogEncoding0aB12BatchEncoderV","modules":[{"name":"PostHogEncoding"}],"title":"PostHogBatchEncoder","roleHeading":"Structure","navigatorTitle":[{"text":"PostHogBatchEncoder","kind":"identifier"}]},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/init(projectToken:plan:)"],"anchor":"Initializers"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","doc:\/\/PostHogEncoding\/documentation\/Po