{"hierarchy":{"paths":[["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatchEncoder","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","import Instrumentation","import PostHogEncoding","import TrackingPlans","","let plan = try TrackingPlan(schemas: [SignedUp.schema, SessionStarted.schema, SessionEnded.schema])","let postHog = HTTPDestination(","    endpoint: batchURL,  \/\/ https:\/\/us.i.posthog.com\/batch\/, or your instance's","    instrument: NoOpInstrument(),  \/\/ no trace context in the request's header fields","    encoder: PostHogBatchEncoder(projectToken: projectToken, plan: plan))","let delivery = tracker.records.batch().deliver(to: postHog)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":" with two members: "},{"code":"api_key","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"project token, and "},{"code":"batch","type":"codeVoice"},{"type":"text","text":", one object per record, oldest first, with these members:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"distinct_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"type":"codeVoice","code":"Event\/name"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name, then the members listed below","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked: ISO 8601 in UTC, with milliseconds (","type":"text"},{"code":"2026-11-23T14:03:27.512Z","type":"codeVoice"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"uuid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent, and every event is anonymous: ","type":"text"},{"type":"codeVoice","code":"properties"},{"text":" holds","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"$process_person_profile: false"},{"text":", so PostHog makes no person profile, and ","type":"text"},{"type":"codeVoice","code":"$geoip_disable: true"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one","type":"text"},{"text":" ","type":"text"},{"text":"tracked by a tracker without ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":", or one a store recovered after a relaunch,","type":"text"},{"text":" ","type":"text"},{"text":"which keeps no context) is its own anonymous person, linked to nothing: PostHog rejects a whole","type":"text"},{"text":" ","type":"text"},{"text":"batch when one of its events has no ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":". PostHog counts a person per ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so its unique users are sessions. The session is also sent as ","type":"text"},{"type":"codeVoice","code":"$session_id"},{"text":", which PostHog’s","type":"text"},{"text":" ","type":"text"},{"text":"sessions and web analytics group events by (","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":" is the UUIDv7 they require); a record","type":"text"},{"text":" ","type":"text"},{"text":"with no session has none. The record’s vendor identifier and trace context, and any other","type":"text"},{"text":" ","type":"text"},{"text":"context value, aren’t sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read from the event’s ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" form, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" derives, through the","type":"text"},{"text":" ","type":"text"},{"text":"types its schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" lists: a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" is a string; a ","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" a boolean; an integer, a","type":"text"},{"text":" ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" or a ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":" a number; a ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" an ISO 8601 string, as ","type":"text"},{"code":"timestamp","type":"codeVoice"},{"text":" is; a ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":" an","type":"text"},{"text":" ","type":"text"},{"text":"uppercase UUID string; an array an array; and an optional’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" value","type":"text"},{"text":" ","type":"text"},{"text":"is its value. A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"text":" value is never sent, whatever the record reveals: the","type":"text"},{"text":" ","type":"text"},{"text":"property is left out, and an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". A property whose name starts with","type":"text"},{"text":" ","type":"text"},{"code":"$","type":"codeVoice"},{"text":", which only a hand-written ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" conformance can write, or is ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":", is","type":"text"},{"text":" ","type":"text"},{"text":"left out and logged at notice level, as PostHog reads those names as settings (","type":"text"},{"code":"$set","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"$process_person_profile","type":"codeVoice"},{"text":") or the identity.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"},{"type":"text","text":" also holds these members, for each of the keys the record’s context has a value"},{"type":"text","text":" "},{"type":"text","text":"for:"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$app_namespace","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_build","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The bundle identifier, version and build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$device_type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The model, and "},{"code":"Mobile","type":"codeVoice"},{"type":"text","text":", "},{"code":"Tablet","type":"codeVoice"},{"type":"text","text":", "},{"code":"Desktop","type":"codeVoice"},{"type":"text","text":", "},{"code":"TV","type":"codeVoice"},{"type":"text","text":" or "},{"code":"Vision","type":"codeVoice"},{"type":"text","text":" for the form factor; no "},{"code":"$device_type","type":"codeVoice"},{"type":"text","text":" for a watch"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$locale","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"code":"en-US","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$network_wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"$network_cellular"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NetworkKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether the connection is Wi-Fi, and whether it is cellular"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$os_name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_version","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The operating system’s name and version"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the body, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":" "},{"type":"text","text":"(a name PostHog keeps for its own events), one whose event isn’t "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":", or one that"},{"type":"text","text":" "},{"type":"text","text":"holds a value JSON can’t ("},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","isActive":true},{"type":"text","text":"). Each is logged at error level;"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","isActive":true},{"type":"text","text":"s. When every record of a batch is left"},{"type":"text","text":" "},{"type":"text","text":"out, "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)","isActive":true},{"type":"text","text":" throws, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"PostHog answers a batch it takes with 200, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" retries one that gets no"},{"type":"text","text":" "},{"type":"text","text":"response, a 5xx, 408 or 429, and drops one it rejects. A record sent again keeps its "},{"code":"uuid","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The bytes are the same for the same records on every run and platform: no whitespace, object"},{"type":"text","text":" "},{"type":"text","text":"members in the order of their names’ UTF-8 bytes. PostHog takes a body of up to 20 MB, so keep"},{"type":"text","text":" "},{"type":"text","text":"batches far smaller ("},{"code":"batch()","type":"codeVoice"},{"type":"text","text":" sends 20 records at most)."}]}],"kind":"content"}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatchEncoder","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"PostHogEncoding"}],"roleHeading":"Structure","externalID":"s:15PostHogEncoding0aB12BatchEncoderV","navigatorTitle":[{"kind":"identifier","text":"PostHogBatchEncoder"}],"role":"symbol","remoteSource":{"fileName":"PostHogBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/PostHogEncoding\/PostHogBatchEncoder.swift#L82"},"title":"PostHogBatchEncoder"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/posthogencoding\/posthogbatchencoder"]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/PostHogEncoding\/s8SendableP","doc:\/\/PostHogEncoding\/s16SendableMetatypeP"]}],"abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of PostHog’s batch capture API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to PostHog Cloud or a self-hosted PostHog’s "},{"type":"codeVoice","code":"POST \/batch\/"},{"type":"text","text":"."}],"identifier":{"interfac