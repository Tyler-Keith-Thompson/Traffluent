{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Make the destination with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and PostHog’s limits:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let postHog = try HTTPDestination.postHog(","    projectToken: projectToken,","    host: postHogHost,  \/\/ https:\/\/eu.i.posthog.com","    plan: plan)"]},{"inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with two members: ","type":"text"},{"code":"api_key","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"project token, and ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":", one object per record, oldest first, with these members:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"distinct_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"event"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"properties"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s stored properties, by name, then the members listed below"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"timestamp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked: ISO 8601 in UTC, with milliseconds ("},{"type":"codeVoice","code":"2026-11-23T14:03:27.512Z"},{"type":"text","text":")"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"uuid"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent, and every event is anonymous: "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" holds"},{"type":"text","text":" "},{"type":"codeVoice","code":"$process_person_profile: false"},{"type":"text","text":", so PostHog makes no person profile, and "},{"type":"codeVoice","code":"$geoip_disable: true"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one"},{"type":"text","text":" "},{"type":"text","text":"tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store recovered after a relaunch,"},{"type":"text","text":" "},{"type":"text","text":"which keeps no context) is its own anonymous person, linked to nothing: PostHog rejects a whole"},{"type":"text","text":" "},{"type":"text","text":"batch when one of its events has no "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":". PostHog counts a person per "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so its unique users are sessions. The session is also sent as "},{"type":"codeVoice","code":"$session_id"},{"type":"text","text":", which PostHog’s"},{"type":"text","text":" "},{"type":"text","text":"sessions and web analytics group events by ("},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" is the UUIDv7 they require); a record"},{"type":"text","text":" "},{"type":"text","text":"with no session has none. The record’s vendor identifier and trace context, and any other"},{"type":"text","text":" "},{"type":"text","text":"context value, aren’t sent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"property whose name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":", which only a hand-written "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" conformance can"},{"type":"text","text":" "},{"type":"text","text":"write, or is "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", is left out and logged at notice level, as PostHog reads those"},{"type":"text","text":" "},{"type":"text","text":"names as settings ("},{"type":"codeVoice","code":"$set"},{"type":"text","text":", "},{"type":"codeVoice","code":"$process_person_profile"},{"type":"text","text":") or the identity."}],"type":"paragraph"},{"inlineContent":[{"code":"properties","type":"codeVoice"},{"text":" also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$app_namespace"},{"type":"text","text":", "},{"type":"codeVoice","code":"$app_version"},{"type":"text","text":", "},{"type":"codeVoice","code":"$app_build"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The bundle identifier, version and build, each left out when "},{"code":"nil","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$device_type"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The model, and "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":", "},{"type":"codeVoice","code":"Tablet"},{"type":"text","text":", "},{"type":"codeVoice","code":"Desktop"},{"type":"text","text":", "},{"type":"codeVoice","code":"TV"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Vision"},{"type":"text","text":" for the form factor; no "},{"type":"codeVoice","code":"$device_type"},{"type":"text","text":" for a watch"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$locale"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"type":"codeVoice","code":"en-US"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$network_wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"$network_cellular"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NetworkKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether the connection is Wi-Fi, and whether it is cellular"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$os_name"},{"type":"text","text":", "},{"type":"codeVoice","code":"$os_version"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The operating system’s name and version"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":" "},{"type":"text","text":"(a name PostHog keeps for its own events), one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a"},{"type":"text","text":" "},{"type":"text","text":"value JSON can’t, and one too large for PostHog to store ("},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","type":"reference"},{"type":"text","text":")."},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/requests(for:)","type":"reference"},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. PostHog answers a batch it takes with"},{"type":"text","text":" "},{"type":"text","text":"200, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries one that gets no response, a 5xx, 408 or 429, and drops one"},{"type":"text","text":" "},{"type":"text","text":"it rejects. A record sent again keeps its "},{"type":"codeVoice","code":"uuid"},{"type":"text","text":". The bytes are the same for the same records"},{"type":"text","text":" "},{"type":"text","text":"on every run and platform: no whitespace, object members in the order of their names’ UTF-8"},{"type":"text","text":" "},{"type":"text","text":"bytes."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/PostHogEn