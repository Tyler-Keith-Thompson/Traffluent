true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s requests","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no record of","type":"text"},{"text":" ","type":"text"},{"text":"a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"title":"PostHogEncodingError","type":"topic","url":"\/documentation\/posthogencoding\/posthogencodingerror","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogEncodingError","kind":"identifier"}],"navigatorTitle":[{"text":"PostHogEncodingError","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"kind":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","title":"BatchEncoder","type":"topic","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}]},"doc://PostHogEncoding/documentation/PostHogEncoding":{"kind":"symbol","title":"PostHogEncoding","role":"collection","url":"\/documentation\/posthogencoding","type":"topic","abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/requests(for:)":{"type":"topic","abstract":[{"code":"batch","type":"codeVoice"},{"type":"text","text":" as the requests PostHog takes, each within the encoder’s limit, with the records"},{"type":"text","text":" "},{"type":"text","text":"left out of them."}],"title":"requests(for:)","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/requests(for:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"text":"<","kind":"text"},{"text":"PostHogEncodingError","kind":"typeIdentifier","preciseIdentifier":"s:15PostHogEncoding0abC5ErrorO"},{"text":">","kind":"text"}],"role":"symbol","url":"\/documentation\/posthogencoding\/posthogbatchencoder\/requests(for:)"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/batchLimit":{"type":"topic","abstract":[{"text":"PostHog’s limits on one request: 10,000,000 bytes of body and 1,000,000 bytes of one event,","type":"text"},{"text":" ","type":"text"},{"text":"with no limit on the count of events.","type":"text"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit","title":"batchLimit","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIden