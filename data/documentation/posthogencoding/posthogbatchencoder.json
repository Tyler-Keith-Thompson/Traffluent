d","type":"codeVoice"},{"text":" when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, by name, then the members listed below"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked: ISO 8601 in UTC, with milliseconds (","type":"text"},{"type":"codeVoice","code":"2026-11-23T14:03:27.512Z"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"uuid"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent, and every event is anonymous: ","type":"text"},{"type":"codeVoice","code":"properties"},{"text":" holds","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"$process_person_profile: false"},{"text":", so PostHog makes no person profile, and ","type":"text"},{"type":"codeVoice","code":"$geoip_disable: true"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one","type":"text"},{"text":" ","type":"text"},{"text":"tracked by a tracker without ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":", or one a store recovered after a relaunch,","type":"text"},{"text":" ","type":"text"},{"text":"which keeps no context) is its own anonymous person, linked to nothing: PostHog rejects a whole","type":"text"},{"text":" ","type":"text"},{"text":"batch when one of its events has no ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":". PostHog counts a person per ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so its unique users are sessions. The session is also sent as ","type":"text"},{"type":"codeVoice","code":"$session_id"},{"text":", which PostHog’s","type":"text"},{"text":" ","type":"text"},{"text":"sessions and web analytics group events by (","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":" is the UUIDv7 they require); a record","type":"text"},{"text":" ","type":"text"},{"text":"with no session has none. The record’s vendor identifier and trace context, and any other","type":"text"},{"text":" ","type":"text"},{"text":"context value, aren’t sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read from the event’s ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":" form, which ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" derives, through the","type":"text"},{"text":" ","type":"text"},{"text":"types its schema in ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" lists: a ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" is a string; a ","type":"text"},{"type":"codeVoice","code":"Bool"},{"text":" a boolean; an integer, a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":" or a ","type":"text"},{"type":"codeVoice","code":"Float"},{"text":" a number; a ","type":"text"},{"type":"codeVoice","code":"Date"},{"text":" an ISO 8601 string, as ","type":"text"},{"type":"codeVoice","code":"timestamp"},{"text":" is; a ","type":"text"},{"type":"codeVoice","code":"UUID"},{"text":" an","type":"text"},{"text":" ","type":"text"},{"text":"uppercase UUID string; an array an array; and an optional’s ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":". A ","type":"text"},{"type":"codeVoice","code":"Refined"},{"text":" value","type":"text"},{"text":" ","type":"text"},{"text":"is its value. A type the plan can’t map is written as its encoding holds it. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":". A property whose name starts with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"$"},{"text":", which only a hand-written ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":" conformance can write, or is ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":", is","type":"text"},{"text":" ","type":"text"},{"text":"left out and logged at notice level, as PostHog reads those names as settings (","type":"text"},{"type":"codeVoice","code":"$set"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"$process_person_profile"},{"text":") or the identity.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"},{"text":" also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$app_namespace"},{"type":"text","text":", "},{"type":"codeVoice","code":"$app_version"},{"type":"text","text":", "},{"type":"codeVoice","code":"$app_build"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The bundle identifier, version and build, each left out when "},{"type":"codeVoice","code":"nil"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$device_model"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$device_type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The model, and "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":", "},{"type":"codeVoice","code":"Tablet"},{"type":"text","text":", "},{"type":"codeVoice","code":"Desktop"},{"type":"text","text":", "},{"type":"codeVoice","code":"TV"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Vision"},{"type":"text","text":" for the form factor; no "},{"type":"codeVoice","code":"$device_type"},{"type":"text","text":" for a watch"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$locale"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"code":"en-US","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$network_wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"$network_cellular"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NetworkKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether the connection is Wi-Fi, and whether it is cellular"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$os_name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_version","type":"codeVoice"}],