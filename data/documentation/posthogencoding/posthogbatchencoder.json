ey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, by name, then the members listed below"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked: ISO 8601 in UTC, with milliseconds (","type":"text"},{"code":"2026-11-23T14:03:27.512Z","type":"codeVoice"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"uuid"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"The session is the only identifier sent, and every event is anonymous: ","type":"text"},{"code":"properties","type":"codeVoice"},{"text":" holds","type":"text"},{"text":" ","type":"text"},{"code":"$process_person_profile: false","type":"codeVoice"},{"text":", so PostHog makes no person profile, and ","type":"text"},{"code":"$geoip_disable: true","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one","type":"text"},{"text":" ","type":"text"},{"text":"tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":", or one a store recovered after a relaunch,","type":"text"},{"text":" ","type":"text"},{"text":"which keeps no context) is its own anonymous person, linked to nothing: PostHog rejects a whole","type":"text"},{"text":" ","type":"text"},{"text":"batch when one of its events has no ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":". PostHog counts a person per ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so its unique users are sessions. The session is also sent as ","type":"text"},{"code":"$session_id","type":"codeVoice"},{"text":", which PostHog’s","type":"text"},{"text":" ","type":"text"},{"text":"sessions and web analytics group events by (","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":" is the UUIDv7 they require); a record","type":"text"},{"text":" ","type":"text"},{"text":"with no session has none. The record’s vendor identifier and trace context, and any other","type":"text"},{"text":" ","type":"text"},{"text":"context value, aren’t sent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read from the event’s "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" form, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"types its schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" lists: a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" is a string; a "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" a boolean; an integer, a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"Float"},{"type":"text","text":" a number; a "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" an ISO 8601 string, as "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":" is; a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" an"},{"type":"text","text":" "},{"type":"text","text":"uppercase UUID string; an array an array; and an optional’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". A "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value"},{"type":"text","text":" "},{"type":"text","text":"is its value. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the"},{"type":"text","text":" "},{"type":"text","text":"property is left out, and an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". A property whose name starts with"},{"type":"text","text":" "},{"type":"codeVoice","code":"$"},{"type":"text","text":", which only a hand-written "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" conformance can write, or is "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", is"},{"type":"text","text":" "},{"type":"text","text":"left out and logged at notice level, as PostHog reads those names as settings ("},{"type":"codeVoice","code":"$set"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"$process_person_profile"},{"type":"text","text":") or the identity."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"properties"},{"type":"text","text":" also holds these members, for each of the keys the record’s context has a value"},{"type":"text","text":" "},{"type":"text","text":"for:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$app_namespace","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_build","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The bundle identifier, version and build, each left out when "},{"type":"codeVoice","code":"nil"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$device_model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$device_type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The model, and ","type":"text"},{"code":"Mobile","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Tablet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Desktop","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TV","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Vision","type":"codeVoice"},{"text":" for the form factor; no ","type":"text"},{"code":"$device_type","type":"codeVoice"},{"text":" for a watch","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$locale"}]}],[{"type":"paragraph","inlineContent":[{"code":"LocaleKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"type":"codeVoice","code":"en-US"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$network_wifi"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$network_cellular"}]}],[{"type":"paragraph","inlineContent":[{"code":"NetworkKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether the connection is Wi-Fi, and whether it is cellular"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$os_name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_version","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"typ