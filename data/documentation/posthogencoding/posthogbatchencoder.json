 that gets no"},{"type":"text","text":" "},{"type":"text","text":"response, a 5xx, 408 or 429, and drops one it rejects. A record sent again keeps its "},{"type":"codeVoice","code":"uuid"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The bytes are the same for the same records on every run and platform: no whitespace, object"},{"type":"text","text":" "},{"type":"text","text":"members in the order of their names’ UTF-8 bytes. PostHog takes a body of up to 20 MB, so keep"},{"type":"text","text":" "},{"type":"text","text":"batches far smaller ("},{"type":"codeVoice","code":"batch()"},{"type":"text","text":" sends 20 records at most)."}]}]}],"kind":"symbol","seeAlsoSections":[{"anchor":"Encoding-batches","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatch"],"title":"Encoding batches","generated":true}],"hierarchy":{"paths":[["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"]]},"references":{"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/encode(_:)":{"title":"encode(_:)","kind":"symbol","role":"symbol","type":"topic","abstract":[{"text":"The request body for ","type":"text"},{"type":"codeVoice","code":"batch"},{"text":": its records as PostHog’s batch capture API takes them, but","type":"text"},{"text":" ","type":"text"},{"text":"for those it can’t encode, which are logged at error level and left out.","type":"text"}],"url":"\/documentation\/posthogencoding\/posthogbatchencoder\/encode(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"encode"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"PostHogEncodingError","preciseIdentifier":"s:15PostHogEncoding0abC5ErrorO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","te