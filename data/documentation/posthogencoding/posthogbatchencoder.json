"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name, then the members listed below","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked: ISO 8601 in UTC, with milliseconds ("},{"type":"codeVoice","code":"2026-11-23T14:03:27.512Z"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"uuid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent, and every event is anonymous: "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" holds"},{"type":"text","text":" "},{"type":"codeVoice","code":"$process_person_profile: false"},{"type":"text","text":", so PostHog makes no person profile, and "},{"type":"codeVoice","code":"$geoip_disable: true"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one"},{"type":"text","text":" "},{"type":"text","text":"tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store recovered after a relaunch,"},{"type":"text","text":" "},{"type":"text","text":"which keeps no context) is its own anonymous person, linked to nothing: PostHog rejects a whole"},{"type":"text","text":" "},{"type":"text","text":"batch when one of its events has no "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":". PostHog counts a person per "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so its unique users are sessions. The session is also sent as "},{"type":"codeVoice","code":"$session_id"},{"type":"text","text":", which PostHog’s"},{"type":"text","text":" "},{"type":"text","text":"sessions and web analytics group events by ("},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" is the UUIDv7 they require); a record"},{"type":"text","text":" "},{"type":"text","text":"with no session has none. The record’s vendor identifier and trace context, and any other"},{"type":"text","text":" "},{"type":"text","text":"context value, aren’t sent."}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read from the event’s ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":" form, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" derives, through the","type":"text"},{"text":" ","type":"text"},{"text":"types its schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" lists: a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" is a string; a ","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" a boolean; an integer, a","type":"text"},{"text":" ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" or a ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":" a number; a ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" an ISO 8601 string, as ","type":"text"},{"code":"timestamp","type":"codeVoice"},{"text":" is; a ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":" an","type":"text"},{"text":" ","type":"text"},{"text":"uppercase UUID string; an array an array; and an optional’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" value","type":"text"},{"text":" ","type":"text"},{"text":"is its value. A type the plan can’t map is written as its encoding holds it. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". A property whose name starts with","type":"text"},{"text":" ","type":"text"},{"code":"$","type":"codeVoice"},{"text":", which only a hand-written ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":" conformance can write, or is ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":", is","type":"text"},{"text":" ","type":"text"},{"text":"left out and logged at notice level, as PostHog reads those names as settings (","type":"text"},{"code":"$set","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"$process_person_profile","type":"codeVoice"},{"text":") or the identity.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"properties","type":"codeVoice"},{"type":"text","text":" also holds these members, for each of the keys the record’s context has a value"},{"type":"text","text":" "},{"type":"text","text":"for:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$app_namespace","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_build","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The bundle identifier, version and build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$device_model","type":"codeVoice"},{"type":"text","text":", "},{"code":"$device_type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The model, and ","type":"text"},{"code":"Mobile","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Tablet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Desktop","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TV","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Vision","type":"codeVoice"},{"text":" for the form factor; no ","type":"text"},{"code":"$device_type","type":"codeVoice"},{"text":" for a watch","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$locale","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"type":"codeVoice","code":"en-US"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$network_wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"$network_cellular"}]}],[{"type":"paragraph","inlineContent":[{"code":"NetworkKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether the connection is Wi-Fi, and whether it is cellular"}]}]],[[{"type":"paragraph","inlineCo