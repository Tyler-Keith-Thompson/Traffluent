{"abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of PostHog’s batch capture API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to PostHog Cloud or a self-hosted PostHog’s "},{"type":"codeVoice","code":"POST \/batch\/"},{"type":"text","text":"."}],"kind":"symbol","identifier":{"url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"PostHogBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"PostHogBatchEncoder","kind":"identifier"}],"roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/PostHogEncoding\/PostHogBatchEncoder.swift#L81","fileName":"PostHogBatchEncoder.swift"},"externalID":"s:15PostHogEncoding0aB12BatchEncoderV","modules":[{"name":"PostHogEncoding"}],"symbolKind":"struct","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"]]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/PostHogEncoding\/s8SendableP","doc:\/\/PostHogEncoding\/s16SendableMetatypeP"],"type":"conformsTo"}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"syntax":"swift","code":["import HTTPDestinations","import Instrumentation","import PostHogEncoding","import TrackingPlans","","let plan = TrackingPlan(schemas: [SignedUp.schema, SessionStarted.schema, SessionEnded.schema])","let postHog = HTTPDestination(","    endpoint: batchURL,  \/\/ https:\/\/us.i.posthog.com\/batch\/, or your instance's","    instrument: NoOpInstrument(),  \/\/ no trace context in the request's header fields","    encoder: PostHogBatchEncoder(projectToken: projectToken, plan: plan))","let delivery = tracker.records.batch().deliver(to: postHog)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":" with two members: "},{"type":"codeVoice","code":"api_key"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"project token, and "},{"type":"codeVoice","code":"batch"},{"type":"text","text":", one object per record, oldest first, with these members:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"distinct_id"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name, then the members listed below","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked: ISO 8601 in UTC, with milliseconds (","type":"text"},{"code":"2026-11-23T14:03:27.512Z","type":"codeVoice"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"uuid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent, and every event is anonymous: "},{"code":"properties","type":"codeVoice"},{"type":"text","text":" holds"},{"type":"text","text":" "},{"code":"$process_person_profile: false","type":"codeVoice"},{"type":"text","text":", so PostHog makes no person profile, and "},{"code":"$geoip_disable: true","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one"},{"type":"text","text":" "},{"type":"text","text":"tracked by a tracker without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":", or one a store recovered after a relaunch,"},{"type":"text","text":" "},{"type":"text","text":"which keeps no context) is its own anonymous person, linked to nothing: PostHog rejects a whole"},{"type":"text","text":" "},{"type":"text","text":"batch when one of its events has no "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":". PostHog counts a person per "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so its unique users are sessions. "},{"code":"$session_id","type":"codeVoice"},{"type":"text","text":" isn’t sent: PostHog’s sessions take only a"},{"type":"text","text":" "},{"type":"text","text":"UUIDv7, and "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":" is a random UUID. The record’s vendor identifier and trace context, and"},{"type":"text","text":" "},{"type":"text","text":"any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read from the event’s ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" form, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" derives, through the","type":"text"},{"text":" ","type":"text"},{"text":"types its schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" lists: a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" is a string; a ","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" a boolean; an integer, a","type":"text"},{"text":" ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" or a ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":" a number; a ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" an ISO 8601 string, as ","type":"text"},{"code":"timestamp","type":"codeVoice"},{"text":" is; a ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":" an","type":"text"},{"text":" ","type":"text"},{"text":"uppercase UUID string; an array an array; and an optional’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" value","type":"text"},{"text":" ","type":"text"},{"text":"is its value. A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"text":" value is never sent, whatever the record reveals: the","type":"text"},{"text":" ","type":"text"},{"text":"property is left out, and an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". A property whose name starts with","type":"text"},{"text":" ","type":"text"},{"code":"$","type":"codeVoice"},{"text":", which only a hand-written ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" conformance can write, or is ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":", is","type":"text"},{"text":" ","type":"text"},{"text":"left out and logged at notice level, as PostHog reads those names as settings (","type":"text"},{"code":"$set","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"$process_person_profile","type":"codeVoice"},{"text":") or the identity.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"},{"type":"text","text":" also holds these members, for each of the keys the record’s context has a value"},{"type":"text","text":" "},{"type":"text","text":"for:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$app_namespace","type":"codeVoice"},{"type":"text","text":", "},{"code":"$app_version","type":"codeVoice"},{"type":"text","text":", "},{"code":"$app_build","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The bundle identifier, version and build, each left out when "},{"type":"codeVoice","code":"nil"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$device_type"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model, and "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":", "},{"type":"codeVoice","code":"Tablet"},{"type":"text","text":", "},{"type":"codeVoice","code":"Desktop"},{"type":"text","text":", "},{"type":"codeVoice","code":"TV"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Vision"},{"type":"text","text":" for the form factor; no "},{"type":"codeVoice","code":"$device_type"},{"type":"text","text":" for a watch"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$locale","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"type":"codeVoice","code":"en-US"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$network_wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"$network_cellular"}]}],[{"type":"paragraph","inlineContent":[{"code":"NetworkKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Whether the connection is Wi-Fi, and whether it is cellular","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$os_name"},{"type":"text","text":", "},{"type":"codeVoice","code":"$os_version"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The operating system’s name and version"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the body, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name starts with ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(a name PostHog keeps for its own events), one whose event isn’t ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":", or one that","type":"text"},{"text":" ","type":"text"},{"text":"holds a value JSON can’t (","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","type":"reference"},{"text":"). Each is logged at error level;","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","type":"reference"},{"text":" returns them as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","type":"reference"},{"text":"s. When every record of a batch is left","type":"text"},{"text":" ","type":"text"},{"text":"out, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)","type":"reference"},{"text":" throws, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"PostHog answers a batch it takes with 200, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" retries one that gets no","type":"text"},{"text":" ","type":"text"},{"text":"response, a 5xx, 408 or 429, and drops one it rejects. A record sent again keeps its ","type":"text"},{"type":"codeVoice","code":"uuid"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The bytes are the same for the same records on every run and platform: no whitespace, object","type":"text"},{"text":" ","type":"text"},{"text":"members in the order of their names’ UTF-8 bytes. PostHog takes a body of up to 20 MB, so keep","type":"text"},{"text":" ","type":"text"},{"text":"batches far smaller (","type":"text"},{"type":"codeVoice","code":"batch()"},{"text":" sends 20 records at most).","type":"text"}]}]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/init(pro