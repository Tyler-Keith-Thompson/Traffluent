{"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatchEncoder","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"syntax":"swift","type":"codeListing","code":["import HTTPDestinations","import Instrumentation","import PostHogEncoding","import TrackingPlans","","let plan = TrackingPlan(schemas: [SignedUp.schema, SessionStarted.schema, SessionEnded.schema])","let postHog = HTTPDestination(","    endpoint: batchURL,  \/\/ https:\/\/us.i.posthog.com\/batch\/, or your instance's","    instrument: NoOpInstrument(),  \/\/ no trace context in the request's header fields","    encoder: PostHogBatchEncoder(projectToken: projectToken, plan: plan))","let delivery = tracker.records.batch().deliver(to: postHog)"]},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"type":"codeVoice","code":"application\/json"},{"text":" with two members: ","type":"text"},{"type":"codeVoice","code":"api_key"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"project token, and ","type":"text"},{"type":"codeVoice","code":"batch"},{"text":", one object per record, oldest first, with these members:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"distinct_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name, then the members listed below","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked: ISO 8601 in UTC, with milliseconds ("},{"code":"2026-11-23T14:03:27.512Z","type":"codeVoice"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"uuid"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent, and every event is anonymous: "},{"code":"properties","type":"codeVoice"},{"type":"text","text":" holds"},{"type":"text","text":" "},{"code":"$process_person_profile: false","type":"codeVoice"},{"type":"text","text":", so PostHog makes no person profile, and "},{"code":"$geoip_disable: true","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one"},{"type":"text","text":" "},{"type":"text","text":"tracked by a tracker without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":", or one a store recovered after a relaunch,"},{"type":"text","text":" "},{"type":"text","text":"which keeps no context) is its own anonymous person, linked to nothing: PostHog rejects a whole"},{"type":"text","text":" "},{"type":"text","text":"batch when one of its events has no "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":". PostHog counts a person per "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so its unique users are sessions. The session is also sent as "},{"code":"$session_id","type":"codeVoice"},{"type":"text","text":", which PostHog’s"},{"type":"text","text":" "},{"type":"text","text":"sessions and web analytics group events by ("},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":" is the UUIDv7 they require); a record"},{"type":"text","text":" "},{"type":"text","text":"with no session has none. The record’s vendor identifier and trace context, and any other"},{"type":"text","text":" "},{"type":"text","text":"context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read from the event’s "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" form, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"types its schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" lists: a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" is a string; a "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" a boolean; an integer, a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"Float"},{"type":"text","text":" a number; a "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" an ISO 8601 string, as "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":" is; a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" an"},{"type":"text","text":" "},{"type":"text","text":"uppercase UUID string; an array an array; and an optional’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". A "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" value"},{"type":"text","text":" "},{"type":"text","text":"is its value. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the"},{"type":"text","text":" "},{"type":"text","text":"property is left out, and an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". A property whose name starts with"},{"type":"text","text":" "},{"type":"codeVoice","code":"$"},{"type":"text","text":", which only a hand-written "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" conformance can write, or is "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", is"},{"type":"text","text":" "},{"type":"text","text":"left out and logged at notice level, as PostHog reads those names as settings ("},{"type":"codeVoice","code":"$set"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"$process_person_profile"},{"type":"text","text":") or the identity."}]},{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"},{"text":" also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}]},{"rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$app_namespace"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$app_version"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$app_build"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The bundle identifier, version and build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$device_model"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$device_type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The model, and "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":", "},{"type":"codeVoice","code":"Tablet"},{"type":"text","text":", "},{"type":"codeVoice","code":"Desktop"},{"type":"text","text":", "},{"type":"codeVoice","code":"TV"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Vision"},{"type":"text","text":" for the form factor; no "},{"type":"codeVoice","code":"$device_type"},{"type":"text","text":" for a watch"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$locale"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"type":"codeVoice","code":"en-US"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$network_wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"$network_cellular"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NetworkKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether the connection is Wi-Fi, and whether it is cellular"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$os_name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_version","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The operating system’s name and version","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the body, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name starts with ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(a name PostHog keeps for its own events), one whose event isn’t ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":", or one that","type":"text"},{"text":" ","type":"text"},{"text":"holds a value JSON can’t (","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","type":"reference"},{"text":"). Each is logged at error level;","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","type":"reference"},{"text":" returns them as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","type":"reference"},{"text":"s. When every record of a batch is left","type":"text"},{"text":" ","type":"text"},{"text":"out, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)","type":"reference"},{"text":" throws, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"PostHog answers a batch it takes with 200, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" retries one that gets no","type":"text"},{"text":" ","type":"text"},{"text":"response, a 5xx, 408 or 429, and drops one it rejects. A record sent again keeps its ","type":"text"},{"type":"codeVoice","code":"uuid"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The bytes are the same for the same records on every run and platform: no whitespace, object","type":"text"},{"text":" ","type":"text"},{"text":"members in the order of their names’ UTF-8 bytes. PostHog takes a body of up to 20 MB, so keep","type":"text"},{"text":" ","type":"text"},{"text":"batches far smaller (","type":"text"},{"type":"codeVoice","code":"batch()"},{"text":" sends 20 records at most).","type":"text"}]}]}],"identifier":{"url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of PostHog’s batch capture API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to PostHog Cloud or a self-hosted PostHog’s "},{"type":"codeVoice","code":"POST \/batch\/"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"]]},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"symbolKind":"struct","modules":[{"name":"PostHogEncoding"}],"roleHeading":"Structure","remoteSource":{"fileName":"PostHogBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/PostHogEncoding\/PostHogBatchEncoder.swift#L82"},"externalID":"s:15PostHogEncoding0aB12BatchEncoderV","role":"symbol","title":"PostHogBatchEncoder","navigatorTitle":[{"text":"PostHogBatchEncoder","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatchEncoder","kind":"identifier"}]},"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/PostHogEncoding\/s8SendableP","doc:\/\/PostHogEncoding\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"topi