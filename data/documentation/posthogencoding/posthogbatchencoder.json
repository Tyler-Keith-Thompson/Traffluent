{"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/PostHogEncoding\/s8SendableP","doc:\/\/PostHogEncoding\/s16SendableMetatypeP"],"title":"Conforms To"}],"metadata":{"modules":[{"name":"PostHogEncoding"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"PostHogBatchEncoder"}],"symbolKind":"struct","remoteSource":{"fileName":"PostHogBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/PostHogEncoding\/PostHogBatchEncoder.swift#L78"},"title":"PostHogBatchEncoder","externalID":"s:15PostHogEncoding0aB12BatchEncoderV"},"hierarchy":{"paths":[["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"]]},"abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" of PostHog’s batch capture API, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"can send events to PostHog Cloud or a self-hosted PostHog’s "},{"code":"POST \/batch\/","type":"codeVoice"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatchEncoder","kind":"identifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Make the destination with ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and PostHog’s limits:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let postHog = try HTTPDestination.postHog(","    projectToken: projectToken,","    host: postHogHost,  \/\/ https:\/\/eu.i.posthog.com","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with two members: ","type":"text"},{"code":"api_key","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"project token, and ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":", one object per record, oldest first, with these members:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"distinct_id"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"event"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"properties","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s stored properties, by name, then the members listed below"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"timestamp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked: ISO 8601 in UTC, with milliseconds (","type":"text"},{"type":"codeVoice","code":"2026-11-23T14:03:27.512Z"},{"text":")","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"uuid"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent, and every event is anonymous: "},{"type":"codeVoice","code":"properties"},{"type":"text","text":" holds"},{"type":"text","text":" "},{"type":"codeVoice","code":"$process_person_profile: false"},{"type":"text","text":", so PostHog makes no person profile, and "},{"type":"codeVoice","code":"$geoip_disable: true"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one"},{"type":"text","text":" "},{"type":"text","text":"tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is its own anonymous person, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing: PostHog rejects a whole batch when one of its events has no "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":". A record a"},{"type":"text","text":" "},{"type":"text","text":"store recovers after a relaunch keeps its session, so it goes out under the "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"$session_id"},{"type":"text","text":" of its first send. PostHog counts a person per "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", so its unique users"},{"type":"text","text":" "},{"type":"text","text":"are sessions. The session is also sent as "},{"type":"codeVoice","code":"$session_id"},{"type":"text","text":", which PostHog’s"},{"type":"text","text":" "},{"type":"text","text":"sessions and web analytics group events by ("},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" is the UUIDv7 they require); a record"},{"type":"text","text":" "},{"type":"text","text":"with no session has none. The record’s vendor identifier and trace context, and any other"},{"type":"text","text":" "},{"type":"text","text":"context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"property whose name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":", which only a hand-written "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" conformance can"},{"type":"text","text":" "},{"type":"text","text":"write, or is "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", is left out and logged at notice level, as PostHog reads those"},{"type":"text","text":" "},{"type":"text","text":"names as settings ("},{"type":"codeVoice","code":"$set"},{"type":"text","text":", "},{"type":"codeVoice","code":"$process_person_profile"},{"type":"text","text":") or the identity."}]},{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"},{"type":"text","text":" also holds these members, for each of the keys the record’s context has a value"},{"type":"text","text":" "},{"type":"text","text":"for:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$app_namespace","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_build","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The bundle identifier, version and build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$device_model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$device_type","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The model, and "},{"code":"Mobile","type":"codeVoice"},{"type":"text","text":", "},{"code":"Tablet","type":"codeVoice"},{"type":"text","text":", "},{"code":"Desktop","type":"codeVoice"},{"type":"text","text":", "},{"code":"TV","type":"codeVoice"},{"type":"text","text":" or "},{"code":"Vision","type":"codeVoice"},{"type":"text","text":" for the form factor; no "},{"code":"$device_type","type":"codeVoice"},{"type":"text","text":" for a watch"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$locale","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"type":"codeVoice","code":"en-US"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$network_wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"$network_cellular"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NetworkKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether the connection is Wi-Fi, and whether it is cellular"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$os_name"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$os_version"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The operating system’s name and version"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event name starts with "},{"code":"$","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(a name PostHog keeps for its own events), one whose event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds a"},{"type":"text","text":" "},{"type":"text","text":"value JSON can’t, one whose timestamp has no ISO 8601 form, and one too large for PostHog to"},{"type":"text","text":" "},{"type":"text","text":"store ("},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/requests(for:)","isActive":true},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit","isActive":true},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. PostHog answers a batch it takes with","type":"text"},{"text":" ","type":"text"},{"text":"200, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" retries one that gets no response, a 5xx, 408 or 429, and drops one","type":"text"},{"text":" ","type":"text"},{"text":"it rejects. A record sent again keeps its ","type":"text"},{"type":"codeVoice","code":"uuid"},{"text":". The bytes are the same for the same records","type":"text"},{"text":" ","type":"text"},{"text":"on every run and platform: no whitespace, object members in the order of their names’ UTF-8","type":"text"},{"text":" ","type":"text"},{"text":"bytes.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/posthogencoding\/posthogbatchencoder"]}],"identifier":{"url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/init(projectToken:plan:limit:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/PostHogEn