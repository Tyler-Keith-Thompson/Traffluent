stHogBatchEncoder\/batch(of:)","type":"reference","isActive":true},{"text":" encodes it: the body of the records it could","type":"text"},{"text":" ","type":"text"},{"text":"encode, and the records it left out.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"PostHogBatch"}],"kind":"symbol","url":"\/documentation\/posthogencoding\/posthogbatch","title":"PostHogBatch","type":"topic"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogEncodingError":{"abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t encode a record, which it leaves out of the batch’s body","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","isActive":true,"type":"reference"},{"text":". When it can encode no record of a batch,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)","isActive":true,"type":"reference"},{"text":" throws the first one’s, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing","type":"text"},{"text":" ","type":"text"},{"text":"for the batch and logs the error.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogEncodingError"}],"url":"\/documentation\/posthogencoding\/posthogencodingerror","type":"topic","navigatorTitle":[{"kind":"identifier","text":"PostHogEncodingError"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","title":"PostHogEncodingError","kind":"symbol","role":"symbol"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/encode(_:)":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder