{"hierarchy":{"paths":[["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"]]},"topicSections":[{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/init(projectToken:plan:limit:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/requests(for:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/Failure"],"title":"Type Aliases","generated":true,"anchor":"Type-Aliases"},{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"}],"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/PostHogEncoding\/s8SendableP","doc:\/\/PostHogEncoding\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Make the destination with "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and PostHog’s limits:"}],"type":"paragraph"},{"syntax":"swift","code":["let postHog = try HTTPDestination.postHog(","    projectToken: projectToken,","    host: postHogHost,  \/\/ https:\/\/eu.i.posthog.com","    plan: plan)"],"type":"codeListing"},{"inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with two members: ","type":"text"},{"code":"api_key","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"project token, and ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":", one object per record, oldest first, with these members:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"distinct_id"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name, then the members listed below","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked: ISO 8601 in UTC, with milliseconds ("},{"code":"2026-11-23T14:03:27.512Z","type":"codeVoice"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"uuid"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"The session is the only identifier sent, and every event is anonymous: ","type":"text"},{"code":"properties","type":"codeVoice"},{"text":" holds","type":"text"},{"text":" ","type":"text"},{"code":"$process_person_profile: false","type":"codeVoice"},{"text":", so PostHog makes no person profile, and ","type":"text"},{"code":"$geoip_disable: true","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so PostHog doesn’t add a location from the request’s IP address. A record with no session (one","type":"text"},{"text":" ","type":"text"},{"text":"tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":", or one a store recovered after a relaunch,","type":"text"},{"text":" ","type":"text"},{"text":"which keeps no context) is its own anonymous person, linked to nothing: PostHog rejects a whole","type":"text"},{"text":" ","type":"text"},{"text":"batch when one of its events has no ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":". PostHog counts a person per ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so its unique users are sessions. The session is also sent as ","type":"text"},{"code":"$session_id","type":"codeVoice"},{"text":", which PostHog’s","type":"text"},{"text":" ","type":"text"},{"text":"sessions and web analytics group events by (","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":" is the UUIDv7 they require); a record","type":"text"},{"text":" ","type":"text"},{"text":"with no session has none. The record’s vendor identifier and trace context, and any other","type":"text"},{"text":" ","type":"text"},{"text":"context value, aren’t sent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"property whose name starts with ","type":"text"},{"code":"$","type":"codeVoice"},{"text":", which only a hand-written ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":" conformance can","type":"text"},{"text":" ","type":"text"},{"text":"write, or is ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":", is left out and logged at notice level, as PostHog reads those","type":"text"},{"text":" ","type":"text"},{"text":"names as settings (","type":"text"},{"code":"$set","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$process_person_profile","type":"codeVoice"},{"text":") or the identity.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"properties","type":"codeVoice"},{"text":" also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$app_namespace","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$app_build","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The bundle identifier, version and build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$device_type"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model, and "},{"type":"codeVoice","code":"Mobile"},{"type":"text","text":", "},{"type":"codeVoice","code":"Tablet"},{"type":"text","text":", "},{"type":"codeVoice","code":"Desktop"},{"type":"text","text":", "},{"type":"codeVoice","code":"TV"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Vision"},{"type":"text","text":" for the form factor; no "},{"type":"codeVoice","code":"$device_type"},{"type":"text","text":" for a watch"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$locale","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"LocaleKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"code":"en-US","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$network_wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"$network_cellular"}]}],[{"type":"paragraph","inlineContent":[{"code":"NetworkKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether the connection is Wi-Fi, and whether it is cellular"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$os_name"},{"type":"text","text":", "},{"type":"codeVoice","code":"$os_version"}]}],[{"type":"paragraph","inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The operating system’s name and version","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name starts with ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(a name PostHog keeps for its own events), one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a","type":"text"},{"text":" ","type":"text"},{"text":"value JSON can’t, one whose timestamp has no ISO 8601 form, and one too large for PostHog to","type":"text"},{"text":" ","type":"text"},{"text":"store (","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit","type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. PostHog answers a batch it takes with","type":"text"},{"text":" ","type":"text"},{"text":"200, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries one that gets no response, a 5xx, 408 or 429, and drops one","type":"text"},{"text":" ","type":"text"},{"text":"it rejects. A record sent again keeps its ","type":"text"},{"code":"uuid","type":"codeVoice"},{"text":". The bytes are the same for the same records","type":"text"},{"text":" ","type":"text"},{"text":"on every run and platform: no whitespace, object members in the order of their names’ UTF-8","type":"text"},{"text":" ","type":"text"},{"text":"bytes.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/posthogencoding\/posthogbatchencoder"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"},"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of PostHog’s batch capture API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"can send events to PostHog Cloud or a self-hosted PostHog’s ","type":"text"},{"code":"POST \/batch\/","type":"codeVoice"},{"text":".","type":"text"}],"metadata":{"title":"PostHogBatchEncoder","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"PostHogBatchEncoder"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"externalID":"s:15PostHogEncoding0aB12BatchEn