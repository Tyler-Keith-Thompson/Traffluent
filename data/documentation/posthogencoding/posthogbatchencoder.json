s ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"property whose name starts with ","type":"text"},{"code":"$","type":"codeVoice"},{"text":", which only a hand-written ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":" conformance can","type":"text"},{"text":" ","type":"text"},{"text":"write, or is ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":", is left out and logged at notice level, as PostHog reads those","type":"text"},{"text":" ","type":"text"},{"text":"names as settings (","type":"text"},{"code":"$set","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$process_person_profile","type":"codeVoice"},{"text":") or the identity.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"properties"},{"type":"text","text":" also holds these members, for each of the keys the record’s context has a value"},{"type":"text","text":" "},{"type":"text","text":"for:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$app_namespace"},{"type":"text","text":", "},{"type":"codeVoice","code":"$app_version"},{"type":"text","text":", "},{"type":"codeVoice","code":"$app_build"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The bundle identifier, version and build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$device_type"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"para