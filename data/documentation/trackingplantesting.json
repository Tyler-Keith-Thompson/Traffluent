{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"The tracking plan is how the people and services that read an app’s events learn what each event","type":"text"},{"text":" ","type":"text"},{"text":"holds, so it is only useful while it matches the events. With this test, a change to an event","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t pass the app’s tests until the plan is exported again, and reviewers see the change as a","type":"text"},{"text":" ","type":"text"},{"text":"JSON diff of the plan. The test’s report also says which changes would break payloads from released","type":"text"},{"text":" ","type":"text"},{"text":"app versions or records already stored.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"},{"text":" checks a ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":" against the plan","type":"text"},{"text":" ","type":"text"},{"text":"committed in a directory, as ","type":"text"},{"type":"codeVoice","code":"TrackingPlan.check(againstDirectory:)"},{"text":" does. When they differ, it","type":"text"},{"text":" ","type":"text"},{"text":"records a Swift Testing issue whose comment is the check’s report, the same text the ","type":"text"},{"type":"codeVoice","code":"check"},{"text":" ","type":"text"},{"text":"command prints, and it returns the check either way. A plan that is only out of date fails the test","type":"text"},{"text":" ","type":"text"},{"text":"as a breaking one does: in both cases the committed plan isn’t what exporting the events writes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Add the product to an app’s test target, so the check runs wherever the app’s tests do. It imports"},{"type":"text","text":" "},{"type":"text","text":"Swift Testing, so it belongs in test targets only. To run the check from the command line or CI"},{"type":"text","text":" "},{"type":"text","text":"without a test, use the app’s own "},{"type":"codeVoice","code":"TrackingPlanCommand"},{"type":"text","text":" executable from "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["import Foundation","import Testing","import TrackingPlanTesting","","@Test func eventsMatchTheTrackingPlan() throws {","    let directory = URL(fileURLWithPath: #filePath)","        .deletingLastPathComponent()","        .appendingPathComponent(\"TrackingPlan\")","    expectTrackingPlan(try AppTrackingPlan.trackingPlan, matches: directory)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The guide ","type":"text"},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","isActive":true},{"text":" ","type":"text"},{"text":"covers exporting the plan this test checks.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","role":"collection","externalID":"TrackingPlanTesting","modules":[{"name":"TrackingPlanTesting"}],"symbolKind":"module","title":"TrackingPlanTesting"},"kind":"symbol","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"],"title":"Checking from a test","anchor":"Checking-from-a-test"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackingplantesting"]}],"references":{"doc://TrackingPlanTesting/documentation/TrackingPlanTesting/expectTrackingPlan(_:matches:sourceLocation:)":{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","role":"symbol","title":"expectTrackingPlan(_:matches:sourceLocation:)","kind":"symbol","abstract":[{"text":"Records a Swift Testing issue when ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" no longer matches the plan committed in","type":"text"},{"text":" ","type":"text"},{"code":"directory","type":"codeVoice"},{"text":", its comment the check’s report, as the ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" command prints it.","type":"text"}],"type":"topic","url":"\/documentation\/trackingplantesting\/expecttrackingplan(_:matches:sourcelocation:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expectTrackingPlan","kind":"identifier"},{"text":"(","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"matches","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","preciseIdentifier":"s:20FoundationEssentials3URLV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"sourceLocation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SourceLocation","preciseIdentifier":"s:7Testing14SourceLocationV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"TrackingPlanCheck","preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO","kind":"typeIdentifier"}]},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","role":"collection","title":"TrackingPlanTesting","abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"url":"\/documentation\/trackingplantesting","kind":"symbol","type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingplanworkflow":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan","titleInlineContent":[{"text":"Exporting and Checking a Tracking Plan","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow"}}}