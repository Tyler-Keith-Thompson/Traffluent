{"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"The tracking plan is how the people and services that read an app’s events learn what each event"},{"type":"text","text":" "},{"type":"text","text":"holds, so it is only useful while it matches the events. With this test, a change to an event"},{"type":"text","text":" "},{"type":"text","text":"doesn’t pass the app’s tests until the plan is exported again, and reviewers see the change as a"},{"type":"text","text":" "},{"type":"text","text":"JSON diff of the plan. The test’s report also says which changes would break payloads from released"},{"type":"text","text":" "},{"type":"text","text":"app versions or records already stored."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","type":"reference","isActive":true},{"text":" checks a ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" against the plan","type":"text"},{"text":" ","type":"text"},{"text":"committed in a directory, as ","type":"text"},{"code":"TrackingPlan.check(againstDirectory:)","type":"codeVoice"},{"text":" does. When they differ, it","type":"text"},{"text":" ","type":"text"},{"text":"records a Swift Testing issue whose comment is the check’s report, the same text the ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" ","type":"text"},{"text":"command prints, and it returns the check either way. A plan that is only out of date fails the test","type":"text"},{"text":" ","type":"text"},{"text":"as a breaking one does: in both cases the committed plan isn’t what exporting the events writes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Add the product to an app’s test target, so the check runs wherever the app’s tests do. It imports","type":"text"},{"text":" ","type":"text"},{"text":"Swift Testing, so it belongs in test targets only. To run the check from the command line or CI","type":"text"},{"text":" ","type":"text"},{"text":"without a test, use the app’s own ","type":"text"},{"code":"TrackingPlanCommand","type":"codeVoice"},{"text":" executable from ","type":"text"},{"code":"TrackingPlans","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import Testing","import TrackingPlanTesting","","@Test func eventsMatchTheTrackingPlan() {","    let directory = URL(fileURLWithPath: #filePath)","        .deletingLastPathComponent()","        .appendingPathComponent(\"TrackingPlan\")","    expectTrackingPlan(AppTrackingPlan.trackingPlan, matches: directory)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow"},{"type":"text","text":" "},{"type":"text","text":"covers exporting the plan this test checks."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/trackingplantesting"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"metadata":{"title":"TrackingPlanTesting","modules":[{"name":"TrackingPlanTesting"}],"role":"collection","externalID":"TrackingPlanTesting","symbolKind":"module","roleHeading":"Framework"},"identifier":{"url":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"topicSections":[{"anchor":"Checking-from-a-test","title":"Checking from a test","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"]}],"references":{"doc://TrackingPlanTesting/documentation/TrackingPlanTesting/expectTrackingPlan(_:matches:sourceLocation:)":{"role":"symbol","abstract":[{"type":"text","text":"Records a Swift Testing issue when "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" no longer matches the plan committed in"},{"type":"text","text":" "},{"type":"codeVoice","code":"directory"},{"type":"text","text":", its comment the check’s report, as the "},{"type":"codeVoice","code":"check"},{"type":"text","text":" command prints it."}],"type":"topic","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","kind":"symbol","title":"expectTrackingPlan(_:matches:sourceLocation:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expectTrackingPlan"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"matches"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"URL","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SourceLocation","preciseIdentifier":"s:7Testing14SourceLocationV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"TrackingPlanCheck","preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO"}],"url":"\/documentation\/trackingplantesting\/expecttrackingplan(_:matches:sourcelocation:)"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingplanworkflow":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","titleInlineContent":[{"type":"text","text":"Exporting and Checking a Tracking Plan"}],"title":"Exporting and Checking a Tracking Plan"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"kind":"symbol","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"role":"collection","title":"TrackingPlanTesting","url":"\/documentation\/trackingplantesting","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","type":"topic"}}}