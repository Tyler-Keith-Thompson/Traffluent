{"hierarchy":{"paths":[[]]},"topicSections":[{"anchor":"Checking-from-a-test","title":"Checking from a test","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"sections":[],"abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan."}],"kind":"symbol","variants":[{"paths":["\/documentation\/trackingplantesting"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","isActive":true},{"text":" checks a ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":" against the plan","type":"text"},{"text":" ","type":"text"},{"text":"committed in a directory, as ","type":"text"},{"type":"codeVoice","code":"TrackingPlan.check(againstDirectory:)"},{"text":" does. When they differ, it","type":"text"},{"text":" ","type":"text"},{"text":"records a Swift Testing issue whose comment is the check’s report, the same text the ","type":"text"},{"type":"codeVoice","code":"check"},{"text":" ","type":"text"},{"text":"command prints, and it returns the check either way. A plan that is only out of date fails the test","type":"text"},{"text":" ","type":"text"},{"text":"as a breaking one does: in both cases the committed plan isn’t what exporting the events writes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Add the product to an app’s test target, so the check runs wherever the app’s tests do. It imports","type":"text"},{"text":" ","type":"text"},{"text":"Swift Testing, so it belongs in test targets only. To run the check from the command line or CI","type":"text"},{"text":" ","type":"text"},{"text":"without a test, use the app’s own ","type":"text"},{"code":"TrackingPlanCommand","type":"codeVoice"},{"text":" executable from ","type":"text"},{"code":"TrackingPlans","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["import Foundation","import Testing","import TrackingPlanTesting","","@Test func eventsMatchTheTrackingPlan() {","    let directory = URL(fileURLWithPath: #filePath)","        .deletingLastPathComponent()","        .appendingPathComponent(\"TrackingPlan\")","    expectTrackingPlan(AppTrackingPlan.trackingPlan, matches: directory)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers exporting the plan this test checks."}]}]}],"metadata":{"symbolKind":"module","title":"TrackingPlanTesting","roleHeading":"Framework","modules":[{"name":"TrackingPlanTesting"}],"externalID":"TrackingPlanTesting","role":"collection"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"kind":"symbol","title":"TrackingPlanTesting","url":"\/documentation\/trackingplantesting","type":"topic","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan.","type":"text"}],"role":"collection","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting/expectTrackingPlan(_:matches:sourceLocation:)":{"role":"symbol","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","abstract":[{"text":"Records a Swift Testing issue when ","type":"text"},{"type