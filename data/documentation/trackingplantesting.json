{"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"metadata":{"roleHeading":"Framework","role":"collection","externalID":"TrackingPlanTesting","symbolKind":"module","title":"TrackingPlanTesting","modules":[{"name":"TrackingPlanTesting"}]},"kind":"symbol","abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"topicSections":[{"title":"Checking from a test","anchor":"Checking-from-a-test","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan is how the people and services that read an app’s events learn what each event"},{"type":"text","text":" "},{"type":"text","text":"holds, so it is only useful while it matches the events. With this test, a change to an event"},{"type":"text","text":" "},{"type":"text","text":"doesn’t pass the app’s tests until the plan is exported again, and reviewers see the change as a"},{"type":"text","text":" "},{"type":"text","text":"JSON diff of the plan. The test’s report also says which changes would break payloads from released"},{"type":"text","text":" "},{"type":"text","text":"app versions or records already stored."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","isActive":true},{"type":"text","text":" checks a "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" against the plan"},{"type":"text","text":" "},{"type":"text","text":"committed in a directory, as "},{"code":"TrackingPlan.check(againstDirectory:)","type":"codeVoice"},{"type":"text","text":" does. When they differ, it"},{"type":"text","text":" "},{"type":"text","text":"records a Swift Testing issue whose comment is the check’s report, the same text the "},{"code":"check","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"command prints, and it returns the check either way. A plan that is only out of date fails the test"},{"type":"text","text":" "},{"type":"text","text":"as a breaking one does: in both cases the committed plan isn’t what exporting the events writes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to an app’s test target, so the check runs wherever the app’s tests do. It imports"},{"type":"text","text":" "},{"type":"text","text":"Swift Testing, so it belongs in test targets only. To run the check from the command line or CI"},{"type":"text","text":" "},{"type":"text","text":"without a test, use the app’s own "},{"type":"codeVoice","code":"TrackingPlanCommand"},{"type":"text","text":" executable from "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":"."}]},{"type":"codeListing","code":["import Foundation","import Testing","import TrackingPlanTesting","","@Test func eventsMatchTheTrackingPlan() throws {","    let directory = URL(fileURLWithPath: #filePath)","        .deletingLastPathComponent()","        .appendingPathComponent(\"TrackingPlan\")","    expectTrackingPlan(try AppTrackingPlan.trackingPlan, matches: directory)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers exporting the plan this test checks.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackingplantesting"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"references":{"doc://TrackingPlanTesting/documentation/TrackingPlanTesting/expectTrackingPlan(_:matches:sourceLocation:)":{"title":"expectTrackingPlan(_:matches:sourceLocation:)","url":"\/documentation\/trackingplantesting\/expecttrackingplan(_:matches:sourcelocation:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expectTrackingPlan"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"matches"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"URL","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SourceLocation","preciseIdentifier":"s:7Testing14SourceLocationV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"TrackingPlanCheck","preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO"}],"abstract":[{"text":"Records a Swift Testing issue when ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" no longer matches the plan committed in","type":"text"},{"text":" ","type":"text"},{"code":"directory","type":"codeVoice"},{"text":", its comment the check’s report, as the ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" command prints it.","type":"text"}],"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","kind":"symbol","type":"topic","role":"symbol"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"url":"\/documentation\/trackingplantesting","type":"topic","kind":"symbol","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"role":"collection","title":"TrackingPlanTesting"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingplanworkflow":{"title":"Exporting and Checking a Tracking Plan","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","titleInlineContent":[{"type":"text","text":"Exporting and Checking a Tracking Plan"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow"}}}