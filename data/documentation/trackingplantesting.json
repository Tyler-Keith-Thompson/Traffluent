{"abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"],"title":"Checking from a test","anchor":"Checking-from-a-test"}],"sections":[],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"metadata":{"roleHeading":"Framework","title":"TrackingPlanTesting","externalID":"TrackingPlanTesting","role":"collection","modules":[{"name":"TrackingPlanTesting"}],"symbolKind":"module"},"kind":"symbol","primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"The tracking plan is how the people and services that read an app’s events learn what each event","type":"text"},{"text":" ","type":"text"},{"text":"holds, so it is only useful while it matches the events. With this test, a change to an event","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t pass the app’s tests until the plan is exported again, and reviewers see the change as a","type":"text"},{"text":" ","type":"text"},{"text":"JSON diff of the plan. The test’s report also says which changes would break payloads from released","type":"text"},{"text":" ","type":"text"},{"text":"app versions or records already stored.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","isActive":true,"type":"reference"},{"type":"text","text":" checks a "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" against the plan"},{"type":"text","text":" "},{"type":"text","text":"committed in a directory, as "},{"code":"TrackingPlan.check(againstDirectory:)","type":"codeVoice"},{"type":"text","text":" does. When they differ, it"},{"type":"text","text":" "},{"type":"text","text":"records a Swift Testing issue whose comment is the check’s report, the same text the "},{"code":"check","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"command prints, and it returns the check either way. A plan that is only out of date fails the test"},{"type":"text","text":" "},{"type":"text","text":"as a breaking one does: in both cases the committed plan isn’t what exporting the events writes."}],"type":"paragraph"},{"inlineContent":[{"text":"Add the product to an app’s test target, so the check runs wherever the app’s tests do. It imports","type":"text"},{"text":" ","type":"text"},{"text":"Swift Testing, so it belongs in test targets only. To run the check from the command line or CI","type":"text"},{"text":" ","type":"text"},{"text":"without a test, use the app’s own ","type":"text"},{"type":"codeVoice","code":"TrackingPlanCommand"},{"text":" executable from ","type":"text"},{"type":"codeVoice","code":"TrackingPlans"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import Testing","import TrackingPlanTesting","","@Test func eventsMatchTheTrackingPlan() throws {","    let directory = URL(fileURLWithPath: #filePath)","        .deletingLastPathComponent()","        .appendingPathComponent(\"TrackingPlan\")","    expectTrackingPlan(try AppTrackingPlan.trackingPlan, matches: directory)","}"]},{"inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"covers exporting the plan this test checks."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/trackingplantesting"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"kind":"symbol","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"title":"TrackingPlanTesting","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","url":"\/documentation\/trackingplantesting","type":"topic","role":"collection"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting/expectTrackingPlan(_:matches:sourceLocation:)":{"type":"topic","abstract":[{"type":"text","text":"Records a Swift Testing issue when "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" no longer matches the plan committed in"},{"type":"text","text":" "},{"code":"directory","type":"codeVoice"},{"type":"text","text":", its comment the check’s report, as the "},{"code":"check","type":"codeVoice"},{"type":"text","text":" command prints it."}],"url":"\/documentation\/trackingplantesting\/expecttrackingplan(_:matches:sourcelocation:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expectTrackingPlan"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"matches"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Testing14SourceLocationV","text":"SourceLocation"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO","text":"TrackingPlanCheck"}],"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","kind":"symbol","title":"expectTrackingPlan(_:matches:sourceLocation:)","role":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingplanworkflow":{"titleInlineContent":[{"text":"Exporting and Checking a Tracking Plan","type":"text"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","type":"link","title":"Exporting and Checking a Tracking Plan","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow"}}}