{"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The tracking plan is how the people and services that read an app’s events learn what each event","type":"text"},{"text":" ","type":"text"},{"text":"holds, so it is only useful while it matches the events. With this test, a change to an event","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t pass the app’s tests until the plan is exported again, and reviewers see the change as a","type":"text"},{"text":" ","type":"text"},{"text":"JSON diff of the plan. The test’s report also says which changes would break payloads from released","type":"text"},{"text":" ","type":"text"},{"text":"app versions or records already stored.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","isActive":true},{"type":"text","text":" checks a "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" against the plan"},{"type":"text","text":" "},{"type":"text","text":"committed in a directory, as "},{"type":"codeVoice","code":"TrackingPlan.check(againstDirectory:)"},{"type":"text","text":" does. When they differ, it"},{"type":"text","text":" "},{"type":"text","text":"records a Swift Testing issue whose comment is the check’s report, the same text the "},{"type":"codeVoice","code":"check"},{"type":"text","text":" "},{"type":"text","text":"command prints, and it returns the check either way. A plan that is only out of date fails the test"},{"type":"text","text":" "},{"type":"text","text":"as a breaking one does: in both cases the committed plan isn’t what exporting the events writes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to an app’s test target, so the check runs wherever the app’s tests do. It imports"},{"type":"text","text":" "},{"type":"text","text":"Swift Testing, so it belongs in test targets only. To run the check from the command line or CI"},{"type":"text","text":" "},{"type":"text","text":"without a test, use the app’s own "},{"code":"TrackingPlanCommand","type":"codeVoice"},{"type":"text","text":" executable from "},{"code":"TrackingPlans","type":"codeVoice"},{"type":"text","text":"."}]},{"code":["import Foundation","import Testing","import TrackingPlanTesting","","@Test func eventsMatchTheTrackingPlan() {","    let directory = URL(fileURLWithPath: #filePath)","        .deletingLastPathComponent()","        .appendingPathComponent(\"TrackingPlan\")","    expectTrackingPlan(AppTrackingPlan.trackingPlan, matches: directory)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow"},{"type":"text","text":" "},{"type":"text","text":"covers exporting the plan this test checks."}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/trackingplantesting"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"TrackingPlanTesting","modules":[{"name":"TrackingPlanTesting"}],"roleHeading":"Framework","externalID":"TrackingPlanTesting","role":"collection","symbolKind":"module"},"topicSections":[{"title":"Checking from a test","anchor":"Checking-from-a-test","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"]}],"abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"kind":"symbol","references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingplanworkflow":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","titleInlineContent":[{"text":"Exporting and Checking a Tracking Plan","type":"text"}],"type":"link"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","url":"\/documentation\/trackingplantesting","role":"collection","type":"topic","title":"TrackingPlanTesting","abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"kind":"symbol"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting/expectTrackingPlan(_:matches:sourceLocation:)":{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","url":"\/documentation\/trackingplantesting\/expecttrackingplan(_:matches:sourcelocation:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expectTrackingPlan","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"matches","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"sourceLocation","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7Testing14SourceLocationV","text":"SourceLocation","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO","text":"TrackingPlanCheck","kind":"typeIdentifier"}],"role":"symbol","abstract":[{"type":"text","text":"Records a Swift Testing issue when "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" no longer matches the plan committed in"},{"type":"text","text":" "},{"type":"codeVoice","code":"directory"},{"type":"text","text":", its comment the check’s report, as the "},{"type":"codeVoice","code":"check"},{"type":"text","text":" command prints it."}],"type":"topic","title":"expectTrackingPlan(_:matches:sourceLocation:)","kind":"symbol"}}}