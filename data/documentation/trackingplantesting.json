{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"},{"text":" checks a ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":" against the plan","type":"text"},{"text":" ","type":"text"},{"text":"committed in a directory, as ","type":"text"},{"type":"codeVoice","code":"TrackingPlan.check(againstDirectory:)"},{"text":" does. When they differ, it","type":"text"},{"text":" ","type":"text"},{"text":"records a Swift Testing issue whose comment is the check’s report, the same text the ","type":"text"},{"type":"codeVoice","code":"check"},{"text":" ","type":"text"},{"text":"command prints, and it returns the check either way. A plan that is only out of date fails the test","type":"text"},{"text":" ","type":"text"},{"text":"as a breaking one does: in both cases the committed plan isn’t what exporting the events writes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Add the product to an app’s test target, so the check runs wherever the app’s tests do. It imports","type":"text"},{"text":" ","type":"text"},{"text":"Swift Testing, so it belongs in test targets only. To run the check from the command line or CI","type":"text"},{"text":" ","type":"text"},{"text":"without a test, use the app’s own ","type":"text"},{"type":"codeVoice","code":"TrackingPlanCommand"},{"text":" executable from ","type":"text"},{"type":"codeVoice","code":"TrackingPlans"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import Foundation","import Testing","import TrackingPlanTesting","","@Test func eventsMatchTheTrackingPlan() {","    let directory = URL(fileURLWithPath: #filePath)","        .deletingLastPathComponent()","        .appendingPathComponent(\"TrackingPlan\")","    expectTrackingPlan(AppTrackingPlan.trackingPlan, matches: directory)","}"]},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","type":"reference"},{"text":" ","type":"text"},{"text":"covers exporting the plan this test checks.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/trackingplantesting"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"module","role":"collection","modules":[{"name":"TrackingPlanTesting"}],"title":"TrackingPlanTesting","roleHeading":"Framework","externalID":"TrackingPlanTesting"},"sections":[],"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"],"anchor":"Checking-from-a-test","title":"Checking from a test"}],"references":{"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"url":"\/documentation\/trackingplantesting","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","kind":"symbol","title":"TrackingPlanTesting","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan.","type":"text"}],"role":"collection","type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingplanworkflow":{"title":"Exporting and Checking a Tracking Plan","titleInlineContent":[{"type":"text","text":"Exporting and Checking a Tracking Plan"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/