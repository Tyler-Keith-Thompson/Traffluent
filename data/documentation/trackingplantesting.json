{"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"anchor":"Checking-from-a-test","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"],"title":"Checking from a test"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The tracking plan is how the people and services that read an app’s events learn what each event","type":"text"},{"text":" ","type":"text"},{"text":"holds, so it is only useful while it matches the events. With this test, a change to an event","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t pass the app’s tests until the plan is exported again, and reviewers see the change as a","type":"text"},{"text":" ","type":"text"},{"text":"JSON diff of the plan. The test’s report also says which changes would break payloads from released","type":"text"},{"text":" ","type":"text"},{"text":"app versions or records already stored.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","isActive":true,"type":"reference"},{"text":" checks a ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" against the plan","type":"text"},{"text":" ","type":"text"},{"text":"committed in a directory, as ","type":"text"},{"code":"TrackingPlan.check(againstDirectory:)","type":"codeVoice"},{"text":" does. When they differ, it","type":"text"},{"text":" ","type":"text"},{"text":"records a Swift Testing issue whose comment is the check’s report, the same text the ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" ","type":"text"},{"text":"command prints, and it returns the check either way. A plan that is only out of date fails the test","type":"text"},{"text":" ","type":"text"},{"text":"as a breaking one does: in both cases the committed plan isn’t what exporting the events writes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to an app’s test target, so the check runs wherever the app’s tests do. It imports"},{"type":"text","text":" "},{"type":"text","text":"Swift Testing, so it belongs in test targets only. To run the check from the command line or CI"},{"type":"text","text":" "},{"type":"text","text":"without a test, use the app’s own "},{"type":"codeVoice","code":"TrackingPlanCommand"},{"type":"text","text":" executable from "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import Testing","import TrackingPlanTesting","","@Test func eventsMatchTheTrackingPlan() throws {","    let directory = URL(fileURLWithPath: #filePath)","        .deletingLastPathComponent()","        .appendingPathComponent(\"TrackingPlan\")","    expectTrackingPlan(try AppTrackingPlan.trackingPlan, matches: directory)","}"]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow"},{"text":" ","type":"text"},{"text":"covers exporting the plan this test checks.","type":"text"}]}],"kind":"content"}],"metadata":{"role":"collection","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"TrackingPlanTesting"}],"externalID":"TrackingPlanTesting","title":"TrackingPlanTesting"},"hierarchy":{"paths":[[]]},"kind":"symbol","sections":[],"abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"variants":[{"paths":["\/documentation\/trackingplantesting"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingplanworkflow":{"type":"link","title":"Exporting and Checking a Tracking Plan","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","titleInlineContent":[{"type":"text","text":"Exporting and Checking a Tracking Plan"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"kind":"symbol","role":"collection","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","url":"\/documentation\/trackingplantesting","type":"topic","title":"TrackingPlanTesting"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting/expectTrackingPlan(_:matches:sourceLocation:)":{"type":"topic","url":"\/documentation\/trackingplantesting\/expecttrackingplan(_:matches:sourcelocation:)","abstract":[{"type":"text","text":"Records a Swift Testing issue when "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" no longer matches the plan committed in"},{"type":"text","text":" "},{"type":"codeVoice","code":"directory"},{"type":"text","text":", its comment the check’s report, as the "},{"type":"codeVoice","code":"check"},{"type":"text","text":" command prints it."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expectTrackingPlan"},{"kind":"text","text":"("},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"matches"},{"kind":"text","text":": "},{"preciseIdentifier":"s:20FoundationEssentials3URLV","kind":"typeIdentifier","text":"URL"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7Testing14SourceLocationV","kind":"typeIdentifier","text":"SourceLocation"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO","kind":"typeIdentifier","text":"TrackingPlanCheck"}],"role":"symbol","title":"expectTrackingPlan(_:matches:sourceLocation:)","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"}}}