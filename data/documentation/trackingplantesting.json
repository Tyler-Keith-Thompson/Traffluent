{"metadata":{"modules":[{"name":"TrackingPlanTesting"}],"roleHeading":"Framework","role":"collection","title":"TrackingPlanTesting","externalID":"TrackingPlanTesting","symbolKind":"module"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"topicSections":[{"anchor":"Checking-from-a-test","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"],"title":"Checking from a test"}],"variants":[{"paths":["\/documentation\/trackingplantesting"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"The tracking plan is how the people and services that read an app’s events learn what each event","type":"text"},{"text":" ","type":"text"},{"text":"holds, so it is only useful while it matches the events. With this test, a change to an event","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t pass the app’s tests until the plan is exported again, and reviewers see the change as a","type":"text"},{"text":" ","type":"text"},{"text":"JSON diff of the plan. The test’s report also says which changes would break payloads from released","type":"text"},{"text":" ","type":"text"},{"text":"app versions or records already stored.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","type":"reference","isActive":true},{"text":" checks a ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" against the plan","type":"text"},{"text":" ","type":"text"},{"text":"committed in a directory, as ","type":"text"},{"code":"TrackingPlan.check(againstDirectory:)","type":"codeVoice"},{"text":" does. When they differ, it","type":"text"},{"text":" ","type":"text"},{"text":"records a Swift Testing issue whose comment is the check’s report, the same text the ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" ","type":"text"},{"text":"command prints, and it returns the check either way. A plan that is only out of date fails the test","type":"text"},{"text":" ","type":"text"},{"text":"as a breaking one does: in both cases the committed plan isn’t what exporting the events writes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Add the product to an app’s test target, so the check runs wherever the app’s tests do. It imports"},{"type":"text","text":" "},{"type":"text","text":"Swift Testing, so it belongs in test targets only. To run the check from the command line or CI"},{"type":"text","text":" "},{"type":"text","text":"without a test, use the app’s own "},{"code":"TrackingPlanCommand","type":"codeVoice"},{"type":"text","text":" executable from "},{"code":"TrackingPlans","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import Testing","import TrackingPlanTesting","","@Test func eventsMatchTheTrackingPlan() {","    let directory = URL(fileURLWithPath: #filePath)","        .deletingLastPathComponent()","        .appendingPathComponent(\"TrackingPlan\")","    expectTrackingPlan(AppTrackingPlan.trackingPlan, matches: directory)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"covers exporting the plan this test checks."}],"type":"paragraph"}]}],"references":{"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","kind":"symbol","type":"topic","title":"TrackingPlanTesting","abstract":[{"text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan.","type":"text"}],"url":"\/documentation\/trackingplantesting","role":"collection"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting/expectTrackingPlan(_:matches:sourceLocation:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expectTrackingPlan","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"matches","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"sourceLocation","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7Testing14SourceLocationV","text":"SourceLocation","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO","text":"TrackingPlanCheck","kind":"typeIdentifier"}],"url":"\/documentation\/trackingplantesting\/expecttrackingplan(_:matches:sourcelocation:)","title":"expectTrackingPlan(_:matches:sourceLocation:)","abstract":[{"text":"Records a Swift Testing issue when ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" no longer matches the plan committed in","type":"text"},{"text":" ","type":"text"},{"code":"directory","type":"codeVoice"},{"text":", its comment the check’s report, as the ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" command prints it.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","type":"topic","role":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingplanworkflow":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan","titleInlineContent":[{"text":"Exporting and Checking a Tracking Plan","type":"text"}],"type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow"}}}