{"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"topicSections":[{"title":"Checking from a test","identifiers":["doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)"],"anchor":"Checking-from-a-test"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackingplantesting"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The tracking plan is how the people and services that read an app’s events learn what each event"},{"type":"text","text":" "},{"type":"text","text":"holds, so it is only useful while it matches the events. With this test, a change to an event"},{"type":"text","text":" "},{"type":"text","text":"doesn’t pass the app’s tests until the plan is exported again, and reviewers see the change as a"},{"type":"text","text":" "},{"type":"text","text":"JSON diff of the plan. The test’s report also says which changes would break payloads from released"},{"type":"text","text":" "},{"type":"text","text":"app versions or records already stored."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","type":"reference","isActive":true},{"text":" checks a ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":" against the plan","type":"text"},{"text":" ","type":"text"},{"text":"committed in a directory, as ","type":"text"},{"type":"codeVoice","code":"TrackingPlan.check(againstDirectory:)"},{"text":" does. When they differ, it","type":"text"},{"text":" ","type":"text"},{"text":"records a Swift Testing issue whose comment is the check’s report, the same text the ","type":"text"},{"type":"codeVoice","code":"check"},{"text":" ","type":"text"},{"text":"command prints, and it returns the check either way. A plan that is only out of date fails the test","type":"text"},{"text":" ","type":"text"},{"text":"as a breaking one does: in both cases the committed plan isn’t what exporting the events writes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Add the product to an app’s test target, so the check runs wherever the app’s tests do. It imports"},{"type":"text","text":" "},{"type":"text","text":"Swift Testing, so it belongs in test targets only. To run the check from the command line or CI"},{"type":"text","text":" "},{"type":"text","text":"without a test, use the app’s own "},{"type":"codeVoice","code":"TrackingPlanCommand"},{"type":"text","text":" executable from "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import Testing","import TrackingPlanTesting","","@Test func eventsMatchTheTrackingPlan() throws {","    let directory = URL(fileURLWithPath: #filePath)","        .deletingLastPathComponent()","        .appendingPathComponent(\"TrackingPlan\")","    expectTrackingPlan(try AppTrackingPlan.trackingPlan, matches: directory)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers exporting the plan this test checks."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"sections":[],"metadata":{"roleHeading":"Framework","role":"collection","modules":[{"name":"TrackingPlanTesting"}],"externalID":"TrackingPlanTesting","title":"TrackingPlanTesting","symbolKind":"module"},"kind":"symbol","references":{"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting","title":"TrackingPlanTesting","kind":"symbol","url":"\/documentation\/trackingplantesting","type":"topic","role":"collection"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingplanworkflow":{"type":"link","title":"Exporting and Checking a Tracking Plan","titleInlineContent":[{"type":"text","text":"Exporting and Checking a Tracking Plan"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingplanworkflow"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting/expectTrackingPlan(_:matches:sourceLocation:)":{"kind":"symbol","abstract":[{"type":"text","text":"Records a Swift Testing issue when "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" no longer matches the plan committed in"},{"type":"text","text":" "},{"type":"codeVoice","code":"directory"},{"type":"text","text":", its comment the check’s report, as the "},{"type":"codeVoice","code":"check"},{"type":"text","text":" command prints it."}],"title":"expectTrackingPlan(_:matches:sourceLocation:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expectTrackingPlan"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"matches"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"URL","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SourceLocation","preciseIdentifier":"s:7Testing14SourceLocationV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"TrackingPlanCheck","preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO"}],"identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting\/expectTrackingPlan(_:matches:sourceLocation:)","url":"\/documentation\/trackingplantesting\/expecttrackingplan(_:matches:sourcelocation:)","type":"topic"}}}