ntifier":"s:15Instrumentation0A10ContextKeyP5ValueQa","text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The context key whose value names a record’s group."}]}],"name":"key"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether the sampler applies to a record; every record by default."}]}],"name":"selects"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The fraction of the groups to keep."}]}],"name":"rate"}]},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sampler."}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Every record of a group gets the same decision, made from the tracker’s sampling seed and"},{"type":"text","text":" "},{"type":"text","text":"the value’s "},{"type":"codeVoice","code":"description"},{"type":"text","text":", so values with equal descriptions make one group. Use a key whose"},{"type":"text","text":" "},{"type":"text","text":"value describes itself stably and consistently with "},{"type":"codeVoice","code":"=="},{"type":"text","text":", such as a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"type described by reflection changes group, and so decision, when its fields change. Nothing is"},{"type":"text","text":" "},{"type":"text","text":"remembered: the decision is made again for each group, from the seed alone, and a sampler"},{"type":"text","text":" "},{"type":"text","text":"keeps only the latest group’s to skip making it again for the next record of that group."},{"type":"text","text":" "},{"type":"text","text":"A record whose context holds no value of "},{"type":"codeVoice","code":"key"},{"type":"text","text":" belongs to no group, so the sampler doesn’t"},{"type":"text","text":" "},{"type":"text","text":"apply to it."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker(enrichers: [experiment], samplers: [.grouped(by: ExperimentKey.self, rate: 0.5)])"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/trackers\/sampler\/grouped(by:where:rate:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A sampler that keeps or drops whole groups of records, those whose contexts hold one value","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"type":"codeVoice","code":"key"},{"text":", keeping each group with probability ","type":"text"},{"type":"codeVoice","code":"rate"},{"text":".","type":"text"}],"references":{"doc://Events/documentation/Events/EventRecord":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventRecord","kind":"identifier"}],"navigatorTitle":[{"text":"EventRecord","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A tracked event: the event itself, when it was tracked, where, and the context it was tracked in."}],"type":"topic","url":"\/documentation\/events\/eventrecord","title":"EventRecord","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord"},"doc://Trackers/documentation/Trackers":{"url":"\/documentation\/trackers","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"topic","title":"Trackers","abstract":[],"role":"collection"},"doc://Trackers/documentation/Trackers/Sampler":{"title":"Sampler","type":"topic","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"url":"\/documenta