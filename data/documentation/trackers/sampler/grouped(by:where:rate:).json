ge. Nothing is"},{"type":"text","text":" "},{"type":"text","text":"remembered: the decision is made again for each group, from the seed alone, and a sampler"},{"type":"text","text":" "},{"type":"text","text":"keeps only the latest group’s to skip making it again for the next record of that group."},{"type":"text","text":" "},{"type":"text","text":"A record whose context holds no value of "},{"code":"key","type":"codeVoice"},{"type":"text","text":" belongs to no group, so the sampler doesn’t"},{"type":"text","text":" "},{"type":"text","text":"apply to it."}]},{"syntax":"swift","code":["let tracker = Tracker(enrichers: [experiment], samplers: [.grouped(by: ExperimentKey.self, rate: 0.5)])"],"type":"codeListing"}],"kind":"content"}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/trackers\/sampler\/grouped(by:where:rate:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"Trackers"}],"role":"symbol","roleHeading":"Type Method","symbolKind":"method","externalID":"s:8Trackers7SamplerV7grouped2by5where4rateACxm_Sb6Events11EventRecordVYbcAA10SampleRateVt15Instrumentation0L10ContextKeyRzs23CustomStringConvertible5ValueRpzSHAQRQlFZ","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"grouped","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Key","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"where","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"rate","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SampleR