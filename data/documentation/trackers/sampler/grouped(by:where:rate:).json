hose context holds no value of "},{"type":"codeVoice","code":"key"},{"type":"text","text":" belongs to no group, so the sampler doesn’t"},{"type":"text","text":" "},{"type":"text","text":"apply to it."}],"type":"paragraph"},{"code":["let tracker = Tracker(enrichers: [experiment], samplers: [.grouped(by: ExperimentKey.self, rate: 0.5)])"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)"},"abstract":[{"type":"text","text":"A sampler that keeps or drops whole groups of records, those whose contexts hold one value"},{"type":"text","text":" "},{"type":"text","text":"of "},{"code":"key","type":"codeVoice"},{"type":"text","text":", keeping each group with probability "},{"code":"rate","type":"codeVoice"},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/sampler\/grouped(by:where:rate:)"]}],"references":{"doc://Trackers/documentation/Trackers/SampleRate":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SampleRate","kind":"identifier"}],"title":"SampleRate","navigatorTitle":[{"text":"SampleRate","kind":"identifier"}],"abstract":[{"text":"The fraction of events, or of groups of events, a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"text":" keeps: a probability from 0, none,","type":"text"},{"text":" ","type":"text"},{"text":"to 1, every one.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/trackers\/samplerate","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRate","type":"topic"},"doc://Trackers/documentation/Trackers":{"kind":"symbol","role":"collection","url":"\/documentation\/trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers","abstract":[],"title":"Trackers","type":"topic"},"doc://Events/documentation/Events/EventRecord":{"