text"},{"text":" ","type":"text"},{"text":"remembered: the decision is made again for each group, from the seed alone, and a sampler","type":"text"},{"text":" ","type":"text"},{"text":"keeps only the latest group’s to skip making it again for the next record of that group.","type":"text"},{"text":" ","type":"text"},{"text":"A record whose context holds no value of ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" belongs to no group, so the sampler doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"apply to it.","type":"text"}]},{"type":"codeListing","code":["let tracker = Tracker(enrichers: [experiment], samplers: [.grouped(by: ExperimentKey.self, rate: 0.5)])"],"syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/trackers\/sampler\/grouped(by:where:rate:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)"},"sections":[],"references":{"doc://Trackers/documentation/Trackers":{"kind":"symbol","url":"\/documentation\/trackers","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"title":"Trackers","role":"collection"},"doc://Trackers/documentation/Trackers/Sampler":{"abstract":[{"text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written","type":"text"},{"text":" ","type":"text"},{"text":"or delivered: event by event, or a whole group of events, such as a session, at once.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"role":"symbol","url":"\/documentation\/trackers\/sampler","kind":"symbol","title":"Sampler","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"type":"topic","identifier":"doc:\/\/Trackers