xt":" or a "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"type described by reflection changes group, and so decision, when its fields change. Nothing is"},{"type":"text","text":" "},{"type":"text","text":"remembered: the decision is made again for each group, from the seed alone, and a sampler"},{"type":"text","text":" "},{"type":"text","text":"keeps only the latest group’s to skip making it again for the next record of that group."},{"type":"text","text":" "},{"type":"text","text":"A record whose context holds no value of "},{"code":"key","type":"codeVoice"},{"type":"text","text":" belongs to no group, so the sampler doesn’t"},{"type":"text","text":" "},{"type":"text","text":"apply to it."}],"type":"paragraph"},{"syntax":"swift","code":["let tracker = Tracker(enrichers: [experiment], samplers: [.grouped(by: ExperimentKey.self, rate: 0.5)])"],"type":"codeListing"}],"kind":"content"}],"sections":[],"references":{"doc://Trackers/documentation/Trackers":{"type":"topic","title":"Trackers","kind":"symbol","role":"collection","identifier":"doc:\/\/Trackers\/documentation\/Trackers","abstract":[],"url":"\/documentation\/trackers"},"doc://Events/documentation/Events/EventRecord":{"kind":"symbol","url":"\/documentation\/events\/eventrecord","title":"EventRecord","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventRecord","kind":"identifier"}],"abstract":[{"text":"A tracked event: the event itself, when it was tracked, where, and the context it was tracked in.","type":"text"}],"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","navigatorTitle":[{"text":"EventRecord","kind":"identifier"}],"role":"symbol"},"doc://Trackers/documentation/Trackers/SampleRate":{"title":"SampleRate","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SampleRate"}],"url":"\/documentation\/trackers\/samplerate","id