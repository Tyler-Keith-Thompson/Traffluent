 itself stably and consistently with "},{"type":"codeVoice","code":"=="},{"type":"text","text":", such as a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"type described by reflection changes group, and so decision, when its fields change. Nothing is"},{"type":"text","text":" "},{"type":"text","text":"remembered: the decision is made again for each group, from the seed alone, and a sampler"},{"type":"text","text":" "},{"type":"text","text":"keeps only the latest group’s to skip making it again for the next record of that group."},{"type":"text","text":" "},{"type":"text","text":"A record whose context holds no value of "},{"type":"codeVoice","code":"key"},{"type":"text","text":" belongs to no group, so the sampler doesn’t"},{"type":"text","text":" "},{"type":"text","text":"apply to it."}],"type":"paragraph"},{"syntax":"swift","code":["let tracker = Tracker(enrichers: [experiment], samplers: [.grouped(by: ExperimentKey.self, rate: try SampleRate(0.5))])"],"type":"codeListing"}]}],"variants":[{"paths":["\/documentation\/trackers\/sampler\/grouped(by:where:rate:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:8Trackers7SamplerV7grouped2by5where4rateACxm_Sb6Events11EventRecordVYbcAA10SampleRateVt15Instrumentation0L10ContextKeyRzs23CustomStringConvertible5ValueRpzSHAQRQlFZ","title":"grouped(by:where:rate:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"grouped"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Key"},{"kind":"text","text":">("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"where"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","preciseId