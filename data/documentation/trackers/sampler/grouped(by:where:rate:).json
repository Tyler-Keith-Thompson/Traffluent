f a group gets the same decision, made from the tracker’s sampling seed and"},{"type":"text","text":" "},{"type":"text","text":"the value’s "},{"type":"codeVoice","code":"description"},{"type":"text","text":", so values with equal descriptions make one group. Use a key whose"},{"type":"text","text":" "},{"type":"text","text":"value describes itself stably and consistently with "},{"type":"codeVoice","code":"=="},{"type":"text","text":", such as a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"type described by reflection changes group, and so decision, when its fields change. Nothing is"},{"type":"text","text":" "},{"type":"text","text":"remembered: the decision is made again for each group, from the seed alone, and a sampler"},{"type":"text","text":" "},{"type":"text","text":"keeps only the latest group’s to skip making it again for the next record of that group."},{"type":"text","text":" "},{"type":"text","text":"A record whose context holds no value of "},{"type":"codeVoice","code":"key"},{"type":"text","text":" belongs to no group, so the sampler doesn’t"},{"type":"text","text":" "},{"type":"text","text":"apply to it."}],"type":"paragraph"},{"code":["let tracker = Tracker(enrichers: [experiment], samplers: [.grouped(by: ExperimentKey.self, rate: 0.5)])"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Type Method","modules":[{"name":"Trackers"}],"title":"grouped(by:where:rate:)","externalID":"s:8Trackers7SamplerV7grouped2by5where4rateACxm_Sb6Events11EventRecordVYbcAA10SampleRateVt15Instrumentation0L10ContextKeyRzs23CustomStringConvertible5ValueRpzSHAQRQlFZ","symbolKind":"method","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"ident