pe":"text","text":" or a "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"type described by reflection changes group, and so decision, when its fields change. Nothing is"},{"type":"text","text":" "},{"type":"text","text":"remembered: the decision is made again for each group, from the seed alone, and a sampler"},{"type":"text","text":" "},{"type":"text","text":"keeps only the latest group’s to skip making it again for the next record of that group."},{"type":"text","text":" "},{"type":"text","text":"A record whose context holds no value of "},{"code":"key","type":"codeVoice"},{"type":"text","text":" belongs to no group, so the sampler doesn’t"},{"type":"text","text":" "},{"type":"text","text":"apply to it."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker(enrichers: [experiment], samplers: [.grouped(by: ExperimentKey.self, rate: try SampleRate(0.5))])"]}],"kind":"content"}],"references":{"doc://Trackers/documentation/Trackers/SampleRate":{"role":"symbol","url":"\/documentation\/trackers\/samplerate","title":"SampleRate","abstract":[{"text":"The fraction of events, or of groups of events, a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true},{"text":" keeps: a probability from 0, none,","type":"text"},{"text":" ","type":"text"},{"text":"to 1, every one.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SampleRate","kind":"identifier"}],"navigatorTitle":[{"text":"SampleRate","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRate"},"doc://Trackers/documentation/Trackers/Sampler/grouped(by:where:rate:)":{"kind":"symbol","url":"\/documentation\/trackers\/sampler\/grouped(by:where:rate:)","abstract":[{"text":"A sampler that keeps or drops whole groups of records, those whose contex