n its fields change. Nothing is"},{"type":"text","text":" "},{"type":"text","text":"remembered: the decision is made again for each group, from the seed alone, and a sampler"},{"type":"text","text":" "},{"type":"text","text":"keeps only the latest group’s to skip making it again for the next record of that group."},{"type":"text","text":" "},{"type":"text","text":"A record whose context holds no value of "},{"code":"key","type":"codeVoice"},{"type":"text","text":" belongs to no group, so the sampler doesn’t"},{"type":"text","text":" "},{"type":"text","text":"apply to it."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker(enrichers: [experiment], samplers: [.grouped(by: ExperimentKey.self, rate: 0.5)])"]}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/sampler\/grouped(by:where:rate:)"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","references":{"doc://Trackers/documentation/Trackers/Sampler":{"kind":"symbol","role":"symbol","title":"Sampler","url":"\/documentation\/trackers\/sampler","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"topic"},"doc://Events/documentation/Events/EventRecord":{"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventRecord"}],"url":"\/documentation\/events\/eventrecord","role":"symbol","type":"topic","abstract":[{"text":"A tra