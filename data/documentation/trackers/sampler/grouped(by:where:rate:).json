r a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"type described by reflection changes group, and so decision, when its fields change. Nothing is"},{"type":"text","text":" "},{"type":"text","text":"remembered: the decision is made again for each group, from the seed alone, and a sampler"},{"type":"text","text":" "},{"type":"text","text":"keeps only the latest group’s to skip making it again for the next record of that group."},{"type":"text","text":" "},{"type":"text","text":"A record whose context holds no value of "},{"type":"codeVoice","code":"key"},{"type":"text","text":" belongs to no group, so the sampler doesn’t"},{"type":"text","text":" "},{"type":"text","text":"apply to it."}]},{"code":["let tracker = Tracker(enrichers: [experiment], samplers: [.grouped(by: ExperimentKey.self, rate: 0.5)])"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)"},"metadata":{"title":"grouped(by:where:rate:)","role":"symbol","remoteSource":{"fileName":"Sampler.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Sampler.swift#L79"},"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"grouped","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Key","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"where","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"rate","kind":"externalPar