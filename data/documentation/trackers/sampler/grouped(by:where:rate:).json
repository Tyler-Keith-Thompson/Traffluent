":"text","text":", such as a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"type described by reflection changes group, and so decision, when its fields change. Nothing is"},{"type":"text","text":" "},{"type":"text","text":"remembered: the decision is made again for each group, from the seed alone, and a sampler"},{"type":"text","text":" "},{"type":"text","text":"keeps only the latest group’s to skip making it again for the next record of that group."},{"type":"text","text":" "},{"type":"text","text":"A record whose context holds no value of "},{"type":"codeVoice","code":"key"},{"type":"text","text":" belongs to no group, so the sampler doesn’t"},{"type":"text","text":" "},{"type":"text","text":"apply to it."}]},{"syntax":"swift","code":["let tracker = Tracker(enrichers: [experiment], samplers: [.grouped(by: ExperimentKey.self, rate: try SampleRate(0.5))])"],"type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"A sampler that keeps or drops whole groups of records, those whose contexts hold one value","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"key","type":"codeVoice"},{"text":", keeping each group with probability ","type":"text"},{"code":"rate","type":"codeVoice"},{"text":".","type":"text"}],"metadata":{"externalID":"s:8Trackers7SamplerV7grouped2by5where4rateACxm_Sb6Events11EventRecordVYbcAA10SampleRateVt15Instrumentation0L10ContextKeyRzs23CustomStringConvertible5ValueRpzSHAQRQlFZ","modules":[{"name":"Trackers"}],"remoteSource":{"fileName":"Sampler.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Sampler.swift#L79"},"roleHeading":"Type Method","symbolKind":"method","role":"symbol","title":"grouped(by:where:rate:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"tex