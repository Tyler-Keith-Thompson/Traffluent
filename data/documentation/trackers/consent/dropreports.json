{"abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Consent"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read. A record dropped for room is reported as it is"},{"type":"text","text":" "},{"type":"text","text":"dropped; while that report waits unread, later ones merge into it, one report counting"},{"type":"text","text":" "},{"type":"text","text":"them all across their timestamps. So the reports waiting unread hold at most one overflow"},{"type":"text","text":" "},{"type":"text","text":"report between any two others (denials and finished trackers), however many events"},{"type":"text","text":" "},{"type":"text","text":"overflow. The sequence has one"},{"type":"text","text":" "},{"type":"text","text":"consumer, and ends once the consent is gone."}]}],"kind":"content"}],"metadata":{"roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream