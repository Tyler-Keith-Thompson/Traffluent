{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"Trackers"}],"symbolKind":"property","role":"symbol","externalID":"s:8Trackers7ConsentV11dropReportsScSyAA0B10DropReportOGvp","title":"dropReports","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"ConsentDropReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},{"text":">","kind":"text"}],"remoteSource":{"fileName":"Consent.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L116"}},"abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Consent"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},"sections":[],"variants":[{"paths":["\/documentation\/trackers\/consent\/dropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers17ConsentDropReportO","text":"ConsentDropReport","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read. A record dropped for room is reported as it is"},{"type":"text","text":" "},{"type":"text","text":"dropped; while that report waits unread, later ones merge into it, one report counting"},{"type":"text","text":" "},{"type":"text","text":"them all across their timestamps. So the reports waiting unread hold at most one overflow"},{"type":"text","text":" "},{"type":"text","text":"report between any two others (denials and finished trackers), however many events"},{"type":"text","text":" "},{"type":"text","text":"overflow. The sequence has one"},{"type":"text","text":" "},{"type":"text","text":"consumer, and ends once the consent is gone."}]}],"kind":"content"}],"references":{"doc://Trackers/documentation/Trackers":{"title":"Trackers","abstract":[],"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","role":"collection","url":"\/documentation\/trackers","kind":"symbol"},"doc://Trackers/documentation/Trackers/ConsentDropReport":{"abstract":[{"type":"text","text":"Records a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},{"type":"text","text":" dropped before they were delivered, and why."}],"type":"topic","role":"symbol","kind":"symbol","title":"ConsentDropReport","url":"\/documentation\/trackers\/consentdropreport","navigatorTitle":[{"text":"ConsentDropReport","kind":"identifier"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsentDropReport","kind":"identifier"}]},"doc://Trackers/documentation/Trackers/Consent/dropReports":{"title":"dropReports","url":"\/documentation\/trackers\/consent\/dropreports","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream