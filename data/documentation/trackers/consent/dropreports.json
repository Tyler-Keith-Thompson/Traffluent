{"abstract":[{"text":"A report of each drop of held or recovered records, in the order they happen.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","kind":"typeIdentifier","text":"AsyncQueue"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:8Trackers17ConsentDropReportO","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","kind":"typeIdentifier","text":"ConsentDropReport"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Reports wait until they are read. A record dropped for room is reported as it is","type":"text"},{"text":" ","type":"text"},{"text":"dropped; while that report waits unread, later ones merge into it, one report counting","type":"text"},{"text":" ","type":"text"},{"text":"them all across their timestamps. So the reports waiting unread hold at most one overflow","type":"text"},{"text":" ","type":"text"},{"text":"report between any two others (denials and finished trackers), however many events","type":"text"},{"text":" ","type":"text"},{"text":"overflow. The sequence ends once the consent is gone and every report has been read.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads the reports at a time. The first iterator to read holds them until its"},{"type":"text","text":" "},{"type":"text","text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a"},{"type":"text","text":" "},{"type":"text","text":"warning once, then reads on from the next report, so the first gets every report in order."},{"type":"text","text":" "},{"type":"text","text":"A reader cancelled while it waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","interfaceLanguage":"swift"},"metadata":{"symbolKind":"property","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},{"kind":"text","text":">"}],"remoteSource":{"fileName":"Consent.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L117"},"title":"dropReports","externalID":"s:8Trackers7ConsentV11dropReports11AsyncQueues0E5QueueVyAA0B10DropReportOGvp","modules":[{"name":"Trackers"}],"roleHeading":"Instance Property"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/consent\/dropreports"]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Consent"]]},"references":{"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"type":"topic","navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}],"url":"\/documentation\/asyncqueues\/asyncqueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","title":"AsyncQueue","fragments":[{"text":"struct","kind":