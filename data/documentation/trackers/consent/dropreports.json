":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Reports wait until they are read. A record dropped for room is reported as it is","type":"text"},{"text":" ","type":"text"},{"text":"dropped; while that report waits unread, later ones merge into it, one report counting","type":"text"},{"text":" ","type":"text"},{"text":"them all across their timestamps. So the reports waiting unread hold at most one overflow","type":"text"},{"text":" ","type":"text"},{"text":"report between any two others (denials and finished trackers), however many events","type":"text"},{"text":" ","type":"text"},{"text":"overflow. The sequence has one","type":"text"},{"text":" ","type":"text"},{"text":"consumer, and ends once the consent is gone.","type":"text"}]}]}],"sections":[],"references":{"doc://Trackers/documentation/Trackers/Consent/dropReports":{"abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"dropReports","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","url":"\/documentation\/trackers\/consent\/dropreports"},"doc://Trackers/documentation/Trackers/ConsentDropReport":{"abstract":[{"text":"Records a ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","isActive":true,"type":"reference"},{"text":" dropped before they were delivered, and why.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsentDropReport","kind":"identifier"}],"title":"ConsentDropReport","kind":"symbol","