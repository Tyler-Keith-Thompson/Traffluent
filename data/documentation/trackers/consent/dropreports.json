{"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Consent"]]},"abstract":[{"text":"A report of each drop of held or recovered records, in the order they happen.","type":"text"}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"ConsentDropReport","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read. A record dropped for room is reported as it is"},{"type":"text","text":" "},{"type":"text","text":"dropped; while that report waits unread, later ones merge into it, one report counting"},{"type":"text","text":" "},{"type":"text","text":"them all across their timestamps. So the reports waiting unread hold at most one overflow"},{"type":"text","text":" "},{"type":"text","text":"report between any two others (denials and finished trackers), however many events"},{"type":"text","text":" "},{"type":"text","text":"overflow. The sequence has one"},{"type":"text","text":" "},{"type":"text","text":"consumer, and ends once the consent is gone."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blo