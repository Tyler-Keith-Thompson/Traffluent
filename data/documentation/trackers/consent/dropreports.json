{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},"metadata":{"remoteSource":{"fileName":"Consent.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L117"},"symbolKind":"property","roleHeading":"Instance Property","modules":[{"name":"Trackers"}],"externalID":"s:8Trackers7ConsentV11dropReports11AsyncQueues0E5QueueVyAA0B10DropReportOGvp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},{"kind":"text","text":">"}],"role":"symbol","title":"dropReports"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Consent"]]},"abstract":[{"text":"A report of each drop of held or recovered records, in the order they happen.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue","kind":"typeIdentifier","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:8Trackers17ConsentDropReportO","text":"ConsentDropReport","kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read. A record dropped for room is reported as it is"},{"type":"text","text":" "},{"type":"text","text":"dropped; while that report waits unread, later ones merge into it, one report counting"},{"type":"text","text":" "},{"type":"text","text":"them all across their timestamps. So the reports waiting unread hold at most one overflow"},{"type":"text","text":" "},{"type":"text","text":"report between any two others (denials and finished trackers), however many events"},{"type":"text","text":" "},{"type":"text","text":"overflow. The sequence ends once the consent is gone and every report has been read."}]},{"type":"paragraph","inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/trackers\/consent\/dropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://Trackers/documentation/Trackers/Consent/dropReports":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:8Trackers17ConsentDropReportO","text":"ConsentDropReport","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/trackers\/consent\/dropreports","type":