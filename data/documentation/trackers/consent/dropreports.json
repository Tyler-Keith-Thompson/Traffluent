{"abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"ConsentDropReport","kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read. A record dropped for room is reported as it is"},{"type":"text","text":" "},{"type":"text","text":"dropped; while that report waits unread, later ones merge into it, one report counting"},{"type":"text","text":" "},{"type":"text","text":"them all across their timestamps. So the reports waiting unread hold at most one overflow"},{"type":"text","text":" "},{"type":"text","text":"report between any two others (denials and finished trackers), however many events"},{"type":"text","text":" "},{"type":"text","text":"overflow. The sequence ends once the consent is gone and every report has been read."}]},{"type":"paragraph","inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"externalID":"s:8Trackers7ConsentV11dropReports11AsyncQueues0E5QueueVyAA0B10DropReportOGvp","roleHeading":"Instance Property","title":"dropReports","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L117","fileName":"Consent.swift"},"modules":[{"name":"Trackers"}],"symbolKind":"property","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"ConsentDropReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},{"text":">","kind":"text"}]},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Consent"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/trackers\/consent\/dropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","title":"AsyncQueue","type":"topic","role":"symbol","navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"url":"\/documentation\/asyncqueues\/asyncqueue","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}],"abstract":[{"type":"text","text":"The reports or deliveries a library type makes, in the order it makes them, kept until they"},{"type":"text","text":" "},{"type":"text","text":"are read; one reader at a time reads them."}],"kind":"symbol"},"doc://Trackers/documentation/Trackers/Consent":{"role":"symbol","title":"Consent","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Consent"}],"url":"\/documentation\/trackers\/consent","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}]},"doc://Trackers/documentation/Trackers/ConsentDropReport":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsentDropReport"}],"abstract":[{"type":"text","text":"Records a "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","isActive":true},{"type":"text","text":" dropped before they were delivered, and why."}],"title":"ConsentDropReport","navigatorTitle":[{"kind":"identifier","text":"ConsentDropReport"}],"url":"\/documentation\/trackers\/consentdropreport","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","kind":"symbol","role":"symbol","type":"topic"},"doc://Trackers/documentation/Trackers/Consent/dropReports":{"role":"symbol","title":"dropReports","abstract":[{"text":"A report of each drop of held or recovered records, in the order they happen.","type":"text"}],"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},