{"abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","text":"ConsentDropReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Reports wait until they are read. A record dropped for room is reported as it is","type":"text"},{"text":" ","type":"text"},{"text":"dropped; while that report waits unread, later ones merge into it, one report counting","type":"text"},{"text":" ","type":"text"},{"text":"them all across their timestamps. So the reports waiting unread hold at most one overflow","type":"text"},{"text":" ","type":"text"},{"text":"report between any two others (denials and finished trackers), however many events","type":"text"},{"text":" ","type":"text"},{"text":"overflow. The sequence has one","type":"text"},{"text":" ","type":"text"},{"text":"consumer, and ends once the consent is gone.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/consent\/dropreports"]}],"kind":"symbol","metadata":{"title":"dropReports","modules":[{"name":"Trackers"}],"symbolKind":"property","role":"symbol","externalID":"s:8Trackers7ConsentV11dropReportsScSyAA0B10DropReportOGvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind