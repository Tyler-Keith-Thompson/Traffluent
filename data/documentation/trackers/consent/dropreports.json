{"kind":"symbol","abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","text":"ConsentDropReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Reports wait until they are read. A record dropped for room is reported as it is"},{"type":"text","text":" "},{"type":"text","text":"dropped; while that report waits unread, later ones merge into it, one report counting"},{"type":"text","text":" "},{"type":"text","text":"them all across their timestamps. So the reports waiting unread hold at most one overflow"},{"type":"text","text":" "},{"type":"text","text":"report between any two others (denials and finished trackers), however many events"},{"type":"text","text":" "},{"type":"text","text":"overflow. The sequence has one"},{"type":"text","text":" "},{"type":"text","text":"consumer, and ends once the consent is gone."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/consent\/dropreports"]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Consent"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropRe