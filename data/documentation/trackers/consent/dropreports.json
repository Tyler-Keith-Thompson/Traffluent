discussion","type":"heading"},{"inlineContent":[{"text":"Reports wait until they are read. A record dropped for room is reported as it is","type":"text"},{"text":" ","type":"text"},{"text":"dropped; while that report waits unread, later ones merge into it, one report counting","type":"text"},{"text":" ","type":"text"},{"text":"them all across their timestamps. So the reports waiting unread hold at most one overflow","type":"text"},{"text":" ","type":"text"},{"text":"report between any two others (denials and finished trackers), however many events","type":"text"},{"text":" ","type":"text"},{"text":"overflow. The sequence has one","type":"text"},{"text":" ","type":"text"},{"text":"consumer, and ends once the consent is gone.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://Trackers/documentation/Trackers":{"title":"Trackers","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/trackers"},"doc://Trackers/documentation/Trackers/ConsentDropReport":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsentDropReport"}],"abstract":[{"text":"Records a ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","isActive":true,"type":"reference"},{"text":" dropped before they were delivered, and why.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ConsentDropReport"}],"role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","title":"ConsentDropReport","url":"\/documentation\/trackers\/consentdropreport"},"doc://Trackers/documentation/Trackers/Consent/dropReports":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIden