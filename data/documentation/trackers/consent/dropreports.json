{"abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Consent"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue"},{"text":"<","kind":"text"},{"text":"ConsentDropReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers17ConsentDropReportO","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Reports wait until they are read. A record dropped for room is reported as it is","type":"text"},{"text":" ","type":"text"},{"text":"dropped; while that report waits unread, later ones merge into it, one report counting","type":"text"},{"text":" ","type":"text"},{"text":"them all across their timestamps. So the reports waiting unread hold at most one overflow","type":"text"},{"text":" ","type":"text"},{"text":"report between any two others (denials and finished trackers), however many events","type":"text"},{"text":" ","type":"text"},{"text":"overflow. The sequence ends once the consent is gone and every report has been read.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"One task reads the reports at a time. The first iterator to read holds them until its"},{"type":"text","text":" "},{"type":"text","text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a"},{"type":"text","text":" "},{"type":"text","text":"warning once, then reads on from the next report, so the first gets every report in order."},{"type":"text","text":" "},{"type":"text","text":"A reader cancelled while it waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/trackers\/consent\/dropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"Trackers"}],"title":"dropReports","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},{"kind":"text","text":">"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L117","fileName":"Consent.swift"},"roleHeading":"Instance Property","externalID":"s:8Trackers7ConsentV11dropReports11AsyncQueues0E5QueueVyAA0B10DropReportOGvp","role":"symbol","symbolKind":"property"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},"references":{"doc://Trackers/documentation/Trackers":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","role":"collection","title":"Trackers","kind":"symbol","abstract":[{"text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent.","type":"text"}],"type":"topic","url":"\/documentation\/trackers"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"role":"symbol","type":"topic","title":"AsyncQueue","url":"\/documentation\/asyncqueues\/asyncqueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}]},"doc://Trackers/documentation/Trackers/Consent/dropReports":{"title":"dropReports","url":"\/documentation\/trackers\/consent\/dropreports","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"ConsentDropReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},{"text":">","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}]},"doc://Trackers/documentation/Trackers/Consent":{"navigatorTitle":[{"kind":"identifier","text":"Consent"}],"role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","type":"topic","url":"\/documentation\/trackers\/consent","kind":"symbol","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"title":"Consent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}]},"doc://Trackers/documentation/Trackers/ConsentDropReport":{"navigatorTitle":[{"text":"ConsentDropReport","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","kind":"symbol","title":"ConsentDropReport","url":"\/documentation\/trackers\/consentdropreport","abstract":[{"type":"text","text":"Records a "},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","type":"reference"},{"type":"text","text":" dropped before they were delivered, and why."}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsentDropReport","kind":"identifier"}]}}}