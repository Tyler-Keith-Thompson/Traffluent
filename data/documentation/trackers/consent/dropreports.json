er ones merge into it, one report counting"},{"type":"text","text":" "},{"type":"text","text":"them all across their timestamps. So the reports waiting unread hold at most one overflow"},{"type":"text","text":" "},{"type":"text","text":"report between any two others (denials and finished trackers), however many events"},{"type":"text","text":" "},{"type":"text","text":"overflow. The sequence has one"},{"type":"text","text":" "},{"type":"text","text":"consumer, and ends once the consent is gone."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","interfaceLanguage":"swift"},"abstract":[{"text":"A report of each drop of held or recovered records, in the order they happen.","type":"text"}],"references":{"doc://Trackers/documentation/Trackers/Consent/dropReports":{"abstract":[{"text":"A report of each drop of held or recovered records, in the order they happen.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},{"kind":"text","text":">"}],"url":"\/documentation\/trackers\/consent\/dropreports","title":"dropReports","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","type":"topic"},"doc://Trackers/documentation/Trackers/Consent":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","kind":"symbol","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"navigatorTitle":[{"kind":"identifier","text