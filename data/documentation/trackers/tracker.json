":"text","text":" "},{"type":"text","text":"on it, in the order the rejections happen."}],"title":"rejectionReports","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","kind":"symbol","url":"\/documentation\/trackers\/tracker\/rejectionreports","type":"topic"},"doc://Trackers/documentation/Trackers/Tracker/flush()":{"url":"\/documentation\/trackers\/tracker\/flush()","abstract":[{"text":"Waits until the tracker’s worker has handled every event tracked, and every consent","type":"text"},{"text":" ","type":"text"},{"text":"decision made, before the call: each record is written to the store, if any, and","type":"text"},{"text":" ","type":"text"},{"text":"published to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"text":", or held or dropped by the consent.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","role":"symbol","type":"topic","kind":"symbol","title":"flush()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"flush","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}]},"doc://Trackers/documentation/Trackers/Tracker/current":{"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"current"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV"}],"abstract":[{"text":"The tracker bound to the current task by the nearest enclosing ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true,"type":"reference"},{"text":" when none is.","type":"text"}],"title":"current","identifier":"doc:\/\/Trackers\/documentati