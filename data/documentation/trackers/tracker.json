{"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":"."}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/withTracker(_:_:)-7fax9","doc:\/\/Trackers\/documentation\/Trackers\/withTracker(_:_:)-24yuc","doc:\/\/Trackers\/documentation\/Trackers\/TrackerAlreadyBootstrapped"],"title":"Tracking","generated":true,"anchor":"Tracking"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"topicSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/bootstrap(_:)"],"title":"Type Methods","generated":true,"anchor":"Type-Methods"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A tracker is a value. Build one where the app starts, start delivering its records, and either","type":"text"},{"text":" ","type":"text"},{"text":"pass the tracker down or bind it to a task with ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":" and read it anywhere inside with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Copies share one stream of records. A binding reaches the work run inside ","type":"text"},{"type":"codeVoice","code":"withTracker"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"the child tasks it starts, but not a detached task or callbacks a framework runs on tasks of","type":"text"},{"text":" ","type":"text"},{"text":"its own, such as a UI framework’s button actions: pass those a tracker, or make the app’s","type":"text"},{"text":" ","type":"text"},{"text":"tracker the process’s default once, at launch, with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/bootstrap(_:)"},{"text":", which ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current"},{"text":" falls","type":"text"},{"text":" ","type":"text"},{"text":"back to wherever no tracker is bound.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)","isActive":true,"type":"reference"},{"text":" does nothing but accept the event, from any","type":"text"},{"text":" ","type":"text"},{"text":"thread: it reads the clock, captures the call site and the task’s ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":", and queues","type":"text"},{"text":" ","type":"text"},{"text":"them. A worker the tracker owns, which never runs on the main actor, does everything else, in","type":"text"},{"text":" ","type":"text"},{"text":"the order events were tracked: the constraints’ check, the enrichers, the samplers, the consent,","type":"text"},{"text":" ","type":"text"},{"text":"a store’s writes, and publishing to ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"text":". No API runs that work on a caller’s thread. ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","isActive":true,"type":"reference"},{"text":" waits for the worker to","type":"text"},{"text":" ","type":"text"},{"text":"catch up; ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","isActive":true,"type":"reference"},{"text":" does too, then ends the records.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tracked events wait in memory, without a bound, until the worker reaches them. The queue"},{"type":"text","text":" "},{"type":"text","text":"can’t be bounded without losing something it mustn’t: it also carries consent decisions and"},{"type":"text","text":" "},{"type":"text","text":"the waits of "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","type":"reference","isActive":true},{"type":"text","text":", and "},{"type":"codeVoice","code":"track"},{"type":"text","text":" can’t wait for room without blocking its caller."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a store, records live in memory only, and records not yet delivered are lost if the"},{"type":"text","text":" "},{"type":"text","text":"process exits. A tracker given a "},{"type":"codeVoice","code":"RecordStore"},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","isActive":true},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"delivers what the store kept from earlier runs first, and writes each record to it once the"},{"type":"text","text":" "},{"type":"text","text":"worker reaches it: a record is durable from then on, and one tracked moments before the"},{"type":"text","text":" "},{"type":"text","text":"process is killed, not yet reached, is lost."}]},{"type":"paragraph","inlineContent":[{"text":"A tracker given ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true,"type":"reference"},{"text":"s keeps a seeded fraction of the events they apply to, dropping the","type":"text"},{"text":" ","type":"text"},{"text":"rest before they are held, written or delivered and reporting them on","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracker given a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},{"type":"text","text":" delivers an event only once its category is granted, holding it"},{"type":"text","text":" "},{"type":"text","text":"while undecided and dropping it when denied; one given none delivers every event."}]}]}],"metadata":{"roleHeading":"Structure","externalID":"s:8Trackers7TrackerV","role":"symbol","modules":[{"name":"Trackers"}],"title":"Tracker","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L55"},"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Tracker"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Trackers/documentation/Trackers/Tracker/rejectionReports":{"type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A report of each event the tracker rejected because a property broke a constraint declared"},{"type":"text","text":" "},{"type":"text","text":"on it, in the order the rejections happen."}],"url":"\/documentation\/trackers\/tracker\/rejectionreports","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","title":"rejectionReports","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQu