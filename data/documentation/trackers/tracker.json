lush()":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"flush"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"title":"flush()","abstract":[{"type":"text","text":"Waits until the tracker’s worker has handled every event tracked, and every consent"},{"type":"text","text":" "},{"type":"text","text":"decision made, before the call: each record is written to the store, if any, and"},{"type":"text","text":" "},{"type":"text","text":"published to "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":", or held or dropped by the consent."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","url":"\/documentation\/trackers\/tracker\/flush()"},"doc://Trackers/documentation/Trackers":{"role":"collection","title":"Trackers","abstract":[],"url":"\/documentation\/trackers","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol"},"doc://Trackers/documentation/Trackers/Consent":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","navigatorTitle":[{"text":"Consent","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"type":"topic","title":"Consent","role":"symbol","kind":"symbol","url":"\/documentation\/trackers\/consent"},"doc://Trackers/documentation/Trackers/Sampler":{"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"abstract":[{"text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written","type":"text"},{"text":" ","type":"text"},{"text":"or delivered: event by event, or a whole group of events, such as a session, at once.","type":"text"}],"type":"topic","title":"Sampler","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"url":"\/documentation\/trackers\/sampler"},"doc://Trackers/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/Trackers\/s16SendableMetatypeP"},"doc://Trackers/documentation/Trackers/Tracker/finish()":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"title":"finish()","abstract":[{"text":"Ends tracking: waits for the worker to handle every event already tracked, then ends","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":" after them, so a delivery sends what is still pending and completes. Events","type":"text"},{"text":" ","type":"text"},{"text":"tracked afterwards are dropped.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","url":"\/documentation\/trackers\/tracker\/finish()"},"doc://Trackers/documentation/Trackers/Tracker/enriched(by:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers8EnricherV","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier","text":"Tracker"}],"type":"topic","title":"enriched(by:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)","abstract":[{"text":"A copy of this tracker whose events’ contexts "