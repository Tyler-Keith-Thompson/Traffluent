onsent"},{"type":"text","text":" "},{"type":"text","text":"decision made, before the call: each record is written to the store, if any, and"},{"type":"text","text":" "},{"type":"text","text":"published to "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":", or held or dropped by the consent."}],"type":"topic","kind":"symbol","role":"symbol"},"doc://Trackers/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/Trackers\/s8SendableP"},"doc://Trackers/documentation/Trackers/Tracker":{"role":"symbol","title":"Tracker","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","url":"\/documentation\/trackers\/tracker","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"kind":"symbol","abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"topic"},"doc://Trackers/documentation/Trackers/Consent":{"role":"symbol","title":"Consent","abstract":[{"text":"The user’s consent, category by category, which a tracker given it applies to every event.","type":"text"}],"url":"\/documentation\/trackers\/consent","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","navigatorTitle":[{"text":"Consent","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Trackers/documentation/Trackers/Sampler":{"kind":"symbol","role":"symbol","title":"Sampler","url":"\/documentation\/t