{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A tracker is a value. Build one where the app starts, start delivering its records, and either","type":"text"},{"text":" ","type":"text"},{"text":"pass the tracker down or bind it to a task with ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":" and read it anywhere inside with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()"]},{"type":"paragraph","inlineContent":[{"text":"Copies share one stream of records. A binding reaches the work run inside ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"the child tasks it starts, but not callbacks a framework runs on tasks of its own, such as a","type":"text"},{"text":" ","type":"text"},{"text":"UI framework’s button actions: pass those a tracker.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)","isActive":true,"type":"reference"},{"text":" does nothing but accept the event, from any","type":"text"},{"text":" ","type":"text"},{"text":"thread: it reads the clock, captures the call site and the task’s ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":", and queues","type":"text"},{"text":" ","type":"text"},{"text":"them. A worker the tracker owns, which never runs on the main actor, does everything else, in","type":"text"},{"text":" ","type":"text"},{"text":"the order events were tracked: the constraints’ check, the enrichers, the samplers, the consent,","type":"text"},{"text":" ","type":"text"},{"text":"a store’s writes, and publishing to ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"text":". No API runs that work on a caller’s thread. ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","isActive":true,"type":"reference"},{"text":" waits for the worker to","type":"text"},{"text":" ","type":"text"},{"text":"catch up; ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","isActive":true,"type":"reference"},{"text":" does too, then ends the records.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tracked events wait in memory, without a bound, until the worker reaches them. The queue"},{"type":"text","text":" "},{"type":"text","text":"can’t be bounded without losing something it mustn’t: it also carries consent decisions and"},{"type":"text","text":" "},{"type":"text","text":"the waits of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"track"},{"type":"text","text":" can’t wait for room without blocking its caller."}]},{"type":"paragraph","inlineContent":[{"text":"Without a store, records live in memory only, and records not yet delivered are lost if the","type":"text"},{"text":" ","type":"text"},{"text":"process exits. A tracker given a ","type":"text"},{"code":"RecordStore","type":"codeVoice"},{"text":" (","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","isActive":true,"type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"delivers what the store kept from earlier runs first, and writes each record to it once the","type":"text"},{"text":" ","type":"text"},{"text":"worker reaches it: a record is durable from then on, and one tracked moments before the","type":"text"},{"text":" ","type":"text"},{"text":"process is killed, not yet reached, is lost.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A tracker given ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"text":"s keeps a seeded fraction of the events they apply to, dropping the","type":"text"},{"text":" ","type":"text"},{"text":"rest before they are held, written or delivered and reporting them on","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A tracker given a ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","type":"reference","isActive":true},{"text":" delivers an event only once its category is granted, holding it","type":"text"},{"text":" ","type":"text"},{"text":"while undecided and dropping it when denied; one given none delivers every event.","type":"text"}]}]}],"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":"."}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"type":"conformsTo"}],"metadata":{"externalID":"s:8Trackers7TrackerV","modules":[{"name":"Trackers"}],"navigatorTitle":[{"text":"Tracker","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L51","fileName":"Tracker.swift"},"role":"symbol","symbolKind":"struct","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"title":"Tracker"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct"],"generated":true,"anchor":"Structures"},{"title":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Type Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"],"generated":true,"anchor":"Type-Properties"}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","interfaceLanguage":"swift"},"references":{"doc://Trackers/documentation/Trackers/Sampler":{"url":"\/documentation\/trackers\/sampler","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"abstract":[{"text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written","type":"text"},{"text":" ","type":"text"},{"text":"or delivered: event by event, or a whole group of events, such as a session, at once.","type":"text"}],"kind":"symbol","title":"Sampler","navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","kind":"symbol","abstract":[{"type":"text","text":"The records of the events this tracker tracks, for a delivery to read."}],"type":"topic","url":"\/documentation\/trackers\/tracker\/records-swift.property","role":"symbol","title":"records","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Tracker","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV"},{"text":".","kind":"text"},{"text":"Records","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV7RecordsV"}]},"doc://Trackers/documentation/Trackers":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers","url":"\/documentation\/trackers","type":"topic","kind":"symbol","abstract":[],"role":"collection"},"doc://Trackers/documentation/Trackers/Tracker/enriched(by:)":{"type":"topic","abstract":[{"text":"A copy of this tracker whose events’ contexts ","type":"text"},{"code":"enricher","type":"codeVoice"},{"text":" also changes, for the code it is","type":"text"},{"text":" ","type":"text"},{"text":"handed to.","type":"text"}],"url":"\/documentation\/trackers\/tracker\/enriched(by:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Enricher","preciseIdentifier":"s:8Trackers8EnricherV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier"}],"kind":"symbol","role":"symbol","title":"enriched(by:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)"},"doc://Trackers/documentation/Trackers/Tracker/init(consent:enrichers:samplers:samplingSeed:now:)":{"abstract":[{"type":"text","text":"A tracker recording every event it tracks, or, given "},{"type":"codeVoice","code":"consent"},{"type":"text","text":", every event it consents to,"},{"type":"text","text":" "},{"type":"text","text":"and, given "},{"type":"codeVoice","code":"samplers"},{"type":"text","text":", the fraction of them they keep."}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/trackers\/tracker\/init(consent:enrichers:samplers:samplingseed:now:)","title":"init(consent:enrichers:samplers:samplingSeed:now:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Consent","preciseIdentifier":"s:8Trackers7ConsentV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Enricher","preciseIdentifier":"s:8Trackers8EnricherV"},{"kind":"text","text":"], "},{"k