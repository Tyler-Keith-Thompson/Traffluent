},{"type":"codeVoice","code":"enricher"},{"type":"text","text":" also changes, for the code it is"},{"type":"text","text":" "},{"type":"text","text":"handed to."}],"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)","url":"\/documentation\/trackers\/tracker\/enriched(by:)","kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker/finish()":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"kind":"symbol","url":"\/documentation\/trackers\/tracker\/finish()","abstract":[{"text":"Ends tracking: waits for the worker to handle every event already tracked, then ends","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":" after them, so a delivery sends what is still pending and completes. Events","type":"text"},{"text":" ","type":"text"},{"text":"tracked afterwards are dropped.","type":"text"}],"title":"finish()","type":"topic"},"doc://Trackers/documentation/Trackers/Tracker/track(_:file:fileID:function:line:column:)":{"title":"track(_:file:fileID:function:line:column:)","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Records "},{"type":"codeVoice","code":"event"},{"type":"text","text":", with the current wall-clock time, the caller’s source location and the"},{"type":"text","text":" "},{"type":"text","text":"task’s "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" as the enrichers extend it."}],"url":"\/documentation\/trackers\/tracker\/track(_:file:fileid:function:line:column:)","fragments":[{"kind":"keyword","text":"func"