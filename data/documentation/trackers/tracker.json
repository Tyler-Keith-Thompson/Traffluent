{"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct"],"generated":true,"anchor":"Structures"},{"title":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Type Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"],"generated":true,"anchor":"Type-Properties"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"type":"conformsTo"}],"sections":[],"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference","isActive":true},{"type":"text","text":"."}],"seeAlsoSections":[{"title":"Tracking","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/withTracker(_:_:)-7fax9","doc:\/\/Trackers\/documentation\/Trackers\/withTracker(_:_:)-24yuc"],"generated":true,"anchor":"Tracking"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A tracker is a value. Build one where the app starts, start delivering its records, and either"},{"type":"text","text":" "},{"type":"text","text":"pass the tracker down or bind it to a task with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" and read it anywhere inside with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()"]},{"inlineContent":[{"text":"Copies share one stream of records. A binding reaches the work run inside ","type":"text"},{"type":"codeVoice","code":"withTracker"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"the child tasks it starts, but not callbacks a framework runs on tasks of its own, such as a","type":"text"},{"text":" ","type":"text"},{"text":"UI framework’s button actions: pass those a tracker.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)","isActive":true},{"text":" does nothing but accept the event, from any","type":"text"},{"text":" ","type":"text"},{"text":"thread: it reads the clock, captures the call site and the task’s ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":", and queues","type":"text"},{"text":" ","type":"text"},{"text":"them. A worker the tracker owns, which never runs on the main actor, does everything else, in","type":"text"},{"text":" ","type":"text"},{"text":"the order events were tracked: the constraints’ check, the enrichers, the samplers, the consent,","type":"text"},{"text":" ","type":"text"},{"text":"a store’s writes, and publishing to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"text":". No API runs that work on a caller’s thread. ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","isActive":true},{"text":" waits for the worker to","type":"text"},{"text":" ","type":"text"},{"text":"catch up; ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","isActive":true},{"text":" does too, then ends the records.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Tracked events wait in memory, without a bound, until the worker reaches them. The queue","type":"text"},{"text":" ","type":"text"},{"text":"can’t be bounded without losing something it mustn’t: it also carries consent decisions and","type":"text"},{"text":" ","type":"text"},{"text":"the waits of ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","type":"reference","isActive":true},{"text":", and ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" can’t wait for room without blocking its caller.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Without a store, records live in memory only, and records not yet delivered are lost if the","type":"text"},{"text":" ","type":"text"},{"text":"process exits. A tracker given a ","type":"text"},{"code":"RecordStore","type":"codeVoice"},{"text":" (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"delivers what the store kept from earlier runs first, and writes each record to it once the","type":"text"},{"text":" ","type":"text"},{"text":"worker reaches it: a record is durable from then on, and one tracked moments before the","type":"text"},{"text":" ","type":"text"},{"text":"process is killed, not yet reached, is lost.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tracker given "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"reference","isActive":true},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, dropping the"},{"type":"text","text":" "},{"type":"text","text":"rest before they are held, written or delivered and reporting them on"},{"type":"text","text":" "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tracker given a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},{"type":"text","text":" delivers an event only once its category is granted, holding it"},{"type":"text","text":" "},{"type":"text","text":"while undecided and dropping it when denied; one given none delivers every event."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker"]}],"metadata":{"roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"title":"Tracker","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"modules":[{"name":"Trackers"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L52","fileName":"Tracker.swift"},"role":"symbol","externalID":"s:8Trackers7TrackerV"},"references":{"doc://Trackers/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/Trackers\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://Trackers/documentation/Trackers/Tracker/rejectionReports":{"kind":"symbol","type":"topic","role":"symbol","title":"rejectionReports","url":"\/documentation\/trackers\/tracker\/rejectionreports","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"RejectionReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers15RejectionReportV"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","abstract":[{"text":"A report of each event the tracker rejected because a property broke a constraint declared","type":"text"},{"text":" ","type":"text"},{"text":"on it, in the order the rejections happen.","type":"text"}]},"doc://Trackers/documentation/Trackers/withTracker(_:_:)-7fax9":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/withTracker(_:_:)-7fax9","url":"\/documentation\/trackers\/withtracker(_:_:)-7fax9","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTracker","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Result","kind":"genericParameter"},{"text"