"kind":"text","text":")"}],"title":"init(store:consent:enrichers:samplers:samplingSeed:now:)","role":"symbol","abstract":[{"text":"A tracker that writes every record to ","type":"text"},{"type":"codeVoice","code":"store"},{"text":", so records survive the app ending, and","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference","isActive":true},{"text":" start with the ones ","type":"text"},{"type":"codeVoice","code":"store"},{"text":" kept from earlier runs.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker/finish()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"abstract":[{"type":"text","text":"Ends tracking: waits for the worker to handle every event already tracked, then ends"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" after them, so a delivery sends what is still pending and completes. Events"},{"type":"text","text":" "},{"type":"text","text":"tracked afterwards are dropped."}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","type":"topic","url":"\/documentation\/trackers\/tracker\/finish()","title":"finish()","kind":"symbol","role":"symbol"},"doc://Trackers/documentation/Trackers":{"kind":"symbol","role":"collection","abstract":[],"identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers","type":"topic","url":"\/documentation\/trackers"},"doc://Trackers/documentation/Trackers/Tracker/flush()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"ide