{"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference","isActive":true},{"type":"text","text":"."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct"]},{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)"]},{"generated":true,"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"]}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/trackers\/tracker"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"kind":"symbol","metadata":{"navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"title":"Tracker","roleHeading":"Structure","modules":[{"name":"Trackers"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L51","fileName":"Tracker.swift"},"externalID":"s:8Trackers7TrackerV","symbolKind":"struct"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A tracker is a value. Build one where the app starts, start delivering its records, and either"},{"type":"text","text":" "},{"type":"text","text":"pass the tracker down or bind it to a task with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" and read it anywhere inside with"},{"type":"text","text":" "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()"]},{"inlineContent":[{"text":"Copies share one stream of records. A binding reaches the work run inside ","type":"text"},{"type":"codeVoice","code":"withTracker"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"the child tasks it starts, but not callbacks a framework runs on tasks of its own, such as a","type":"text"},{"text":" ","type":"text"},{"text":"UI framework’s button actions: pass those a tracker.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)","isActive":true},{"type":"text","text":" does nothing but accept the event, from any"},{"type":"text","text":" "},{"type":"text","text":"thread: it reads the clock, captures the call site and the task’s "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":", and queues"},{"type":"text","text":" "},{"type":"text","text":"them. A worker the tracker owns, which never runs on the main actor, does everything else, in"},{"type":"text","text":" "},{"type":"text","text":"the order events were tracked: the constraints’ check, the enrichers, the samplers, the consent,"},{"type":"text","text":" "},{"type":"text","text":"a store’s writes, and publishing to "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":". No API runs that work on a caller’s thread. "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","isActive":true},{"type":"text","text":" waits for the worker to"},{"type":"text","text":" "},{"type":"text","text":"catch up; "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","isActive":true},{"type":"text","text":" does too, then ends the records."}],"type":"paragraph"},{"inlineContent":[{"text":"Tracked events wait in memory, without a bound, until the worker reaches them. The queue","type":"text"},{"text":" ","type":"text"},{"text":"can’t be bounded without losing something it mustn’t: it also carries consent decisions and","type":"text"},{"text":" ","type":"text"},{"text":"the waits of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","type":"reference"},{"text":", and ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" can’t wait for room without blocking its caller.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Without a store, records live in memory only, and records not yet delivered are lost if the","type":"text"},{"text":" ","type":"text"},{"text":"process exits. A tracker given a ","type":"text"},{"code":"RecordStore","type":"codeVoice"},{"text":" (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"delivers what the store kept from earlier runs first, and writes each record to it once the","type":"text"},{"text":" ","type":"text"},{"text":"worker reaches it: a record is durable from then on, and one tracked moments before the","type":"text"},{"text":" ","type":"text"},{"text":"process is killed, not yet reached, is lost.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tracker given "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, dropping the"},{"type":"text","text":" "},{"type":"text","text":"rest before they are held, written or delivered and reporting them on"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tracker given a "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","isActive":true},{"type":"text","text":" delivers an event only once its category is granted, holding it"},{"type":"text","text":" "},{"type":"text","text":"while undecided and dropping it when denied; one given none delivers every event."}],"type":"paragraph"}]}],"references":{"doc://Trackers/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/Trackers\/s16SendableMetatypeP"},"doc://Trackers/documentation/Trackers/Tracker/Records-swift.struct":{"url":"\/documentation\/trackers\/tracker\/records-swift.struct","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct","abstract":[{"type":"text","text":"The records of the events a tracker tracks, in the order tracked: what a delivery reads."}],"type":"topic","kind":"symbol","title":"Tracker.Records","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Records"}],"navigatorTitle":[{"kind":"identifier","text":"Records"}]},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"kind":"symbol","abstract":[{"type":"text","text":"The records of the events this tracker tracks, for a delivery to read."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier","text":"Tracker"},{"kind":"text","text":"."},{"preciseIdentifier":"s:8Trackers7TrackerV7RecordsV","kind":"typeIdentifier","text":"Records"}],"role":"symbol","url":"\/documentation\/trackers\/tracker\/records-swift.property","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"topic","title":"records"},"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true,"type":"reference"},{"text":"s dropped, in the order the drops happen.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","url":"\/documentation\/trackers\/tracker\/samplingdropreports","role":"symbol","kind":"symbol","type":"topic","title":"samplingDropReports","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:8Trackers18SamplingDropReportV","text":"SamplingDropReport","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Trackers/documentation/Trackers/Sampler":{"role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","url":"\/documentation\/trackers\/sampler","navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"title":"Sampler"},"doc://Trackers/documentation/Trackers/Tracker/finish()":{"url":"\/documentation\/trackers\/tracker\/finish()","type":"topic","title":"finish()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","role":"symbol","abstract":[{"type":"text","text":"Ends tracking: waits for the worker to handle every event already tracked, then ends"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" after them, so a delivery sends what is still pending and completes. Events"},{"type":"text","text":" "},{"type":"text","text":"tracked afterwards are dropped."}]},"doc://Trackers/documentation/Trackers/Tracker/flush()":{"abstract":[{"text":"Waits until the tracker’s worker has handled every event tracked, and every consent","type":"text"},{"text":" ","type":"text"},{"text":"decision made, before the call: each record is written to the store, if any, and","type":"text"},{"text":" ","type":"text"},{"text":"published to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":", or held or dropped by the consent.","type":"text"}],"type":"topic","title":"flush()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"flush","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","role":"symbol","url":"\/documentation\/trackers\/tracker\/flush()"},"doc://Trackers/documentation/Trackers/Tracker/rejectionReports":{"title":"rejectionReports","role":"symbol","abstract":[{"type":"text","text":"A report of each event the tracker rejected because a property broke a constraint declared"},{"type":"text","text":" "},{"type":"text","text":"on it, in the order the rejections happen."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:8Trackers15RejectionReportV","text":"RejectionReport","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","url":"\/documen