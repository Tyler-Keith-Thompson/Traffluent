":"Sampler"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"type":"topic","title":"Sampler"},"doc://Trackers/documentation/Trackers":{"url":"\/documentation\/trackers","kind":"symbol","role":"collection","identifier":"doc:\/\/Trackers\/documentation\/Trackers","abstract":[],"type":"topic","title":"Trackers"},"doc://Trackers/documentation/Trackers/Tracker/finish()":{"url":"\/documentation\/trackers\/tracker\/finish()","abstract":[{"type":"text","text":"Ends tracking: waits for the worker to handle every event already tracked, then ends"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" after them, so a delivery sends what is still pending and completes. Events"},{"type":"text","text":" "},{"type":"text","text":"tracked afterwards are dropped."}],"role":"symbol","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","title":"finish()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}]},"doc://Trackers/s8SendableP":{"identifier":"doc:\/\/Trackers\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","title":"samplingDropReports","abstract":[{"type":"text","text":"A report of each event the tracker’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"ty