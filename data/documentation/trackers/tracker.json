{"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"variants":[{"paths":["\/documentation\/trackers\/tracker"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"topicSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct"],"title":"Structures","anchor":"Structures","generated":true},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"],"title":"Type Properties","anchor":"Type-Properties","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"platforms":["Linux"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A tracker is a value. Build one where the app starts, start delivering its records, and either"},{"type":"text","text":" "},{"type":"text","text":"pass the tracker down or bind it to a task with "},{"code":"withTracker","type":"codeVoice"},{"type":"text","text":" and read it anywhere inside with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()"],"type":"codeListing"},{"inlineContent":[{"text":"Copies share one stream of records. A binding reaches the work run inside ","type":"text"},{"type":"codeVoice","code":"withTracker"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"the child tasks it starts, but not callbacks a framework runs on tasks of its own, such as a","type":"text"},{"text":" ","type":"text"},{"text":"UI framework’s button actions: pass those a tracker.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)"},{"type":"text","text":" does nothing but accept the event, from any"},{"type":"text","text":" "},{"type":"text","text":"thread: it reads the clock, captures the call site and the task’s "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":", and queues"},{"type":"text","text":" "},{"type":"text","text":"them. A worker the tracker owns, which never runs on the main actor, does everything else, in"},{"type":"text","text":" "},{"type":"text","text":"the order events were tracked: the constraints’ check, the enrichers, the samplers, the consent,"},{"type":"text","text":" "},{"type":"text","text":"a store’s writes, and publishing to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":". No API runs that work on a caller’s thread. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()"},{"type":"text","text":" waits for the worker to"},{"type":"text","text":" "},{"type":"text","text":"catch up; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()"},{"type":"text","text":" does too, then ends the records."}],"type":"paragraph"},{"inlineContent":[{"text":"Tracked events wait in memory, without a bound, until the worker reaches them. The queue","type":"text"},{"text":" ","type":"text"},{"text":"can’t be bounded without losing something it mustn’t: it also carries consent decisions and","type":"text"},{"text":" ","type":"text"},{"text":"the waits of ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" can’t wait for room without blocking its caller.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Without a store, records live in memory only, and records not yet delivered are lost if the"},{"type":"text","text":" "},{"type":"text","text":"process exits. A tracker given a "},{"type":"codeVoice","code":"RecordStore"},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","isActive":true},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"delivers what the store kept from earlier runs first, and writes each record to it once the"},{"type":"text","text":" "},{"type":"text","text":"worker reaches it: a record is durable from then on, and one tracked moments before the"},{"type":"text","text":" "},{"type":"text","text":"process is killed, not yet reached, is lost."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tracker given "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, dropping the"},{"type":"text","text":" "},{"type":"text","text":"rest before they are held, written or delivered and reporting them on"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"A tracker given a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},{"text":" delivers an event only once its category is granted, holding it","type":"text"},{"text":" ","type":"text"},{"text":"while undecided and dropping it when denied; one given none delivers every event.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"navigatorTitle":[{"text":"Tracker","kind":"identifier"}],"externalID":"s:8Trackers7TrackerV","symbolKind":"struct","title":"Tracker","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L51"},"roleHeading":"Structure","modules":[{"name":"Trackers"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}]},"kind":"symbol","abstract":[{"text":"What app code tracks events with: it records each event, with the time, the caller’s source","type":"text"},{"text":" ","type":"text"},{"text":"location and the task’s context, as one of its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":".","type":"text"}],"references":{"doc://Trackers/documentation/Trackers/Tracker/finish()":{"abstract":[{"text":"Ends tracking: waits for the worker to handle every event already tracked, then ends","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":" after them, so a delivery sends what is still pending and completes. Events","type":"text"},{"text":" ","type":"text"},{"text":"tracked afterwards are dropped.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","url":"\/documentation\/trackers\/tracker\/finish()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"title":"finish()","type":"topic","kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker/current":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"current"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The tracker bound to the current task by the nearest enclosing "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},{"type":"text","text":" when none is."}],"role":"symbol","title":"current","url":"\/documentation\/trackers\/tracker\/current"},"doc://Trackers/documentation/Trackers/Tracker/init(store:consent:enrichers:samplers:samplingSeed:now:)":{"abstract":[{"text":"A tracker that writes every record to ","type":"text"},{"type":"codeVoice","code":"store"},{"text":", so records survive the app ending, and","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"text":" start with the ones ","type":"text"},{"type":"codeVoice","code":"store"},{"text":" kept from earlier runs.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","url":"\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Persistence11RecordStoreP","text":"RecordStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7ConsentV","text":"Consent"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"samplers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7SamplerV","text":"Sampler"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V","text":"UInt64"},{"k