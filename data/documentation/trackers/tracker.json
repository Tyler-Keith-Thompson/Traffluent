{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"title":"Tracker","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L51"},"role":"symbol","externalID":"s:8Trackers7TrackerV","symbolKind":"struct","modules":[{"name":"Trackers"}],"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"Tracker"}]},"abstract":[{"text":"What app code tracks events with: it records each event, with the time, the caller’s source","type":"text"},{"text":" ","type":"text"},{"text":"location and the task’s context, as one of its ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/trackers\/tracker"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker"},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A tracker is a value. Build one where the app starts, start delivering its records, and either"},{"type":"text","text":" "},{"type":"text","text":"pass the tracker down or bind it to a task with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" and read it anywhere inside with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Copies share one stream of records. A binding reaches the work run inside ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"the child tasks it starts, but not callbacks a framework runs on tasks of its own, such as a","type":"text"},{"text":" ","type":"text"},{"text":"UI framework’s button actions: pass those a tracker.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)","type":"reference"},{"type":"text","text":" does nothing but accept the event, from any"},{"type":"text","text":" "},{"type":"text","text":"thread: it reads the clock, captures the call site and the task’s "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":", and queues"},{"type":"text","text":" "},{"type":"text","text":"them. A worker the tracker owns, which never runs on the main actor, does everything else, in"},{"type":"text","text":" "},{"type":"text","text":"the order events were tracked: the constraints’ check, the enrichers, the samplers, the consent,"},{"type":"text","text":" "},{"type":"text","text":"a store’s writes, and publishing to "},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference"},{"type":"text","text":". No API runs that work on a caller’s thread. "},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","type":"reference"},{"type":"text","text":" waits for the worker to"},{"type":"text","text":" "},{"type":"text","text":"catch up; "},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","type":"reference"},{"type":"text","text":" does too, then ends the records."}],"type":"paragraph"},{"inlineContent":[{"text":"Tracked events wait in memory, without a bound, until the worker reaches them. The queue","type":"text"},{"text":" ","type":"text"},{"text":"can’t be bounded without losing something it mustn’t: it also carries consent decisions and","type":"text"},{"text":" ","type":"text"},{"text":"the waits of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"track"},{"text":" can’t wait for room without blocking its caller.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Without a store, records live in memory only, and records not yet delivered are lost if the"},{"type":"text","text":" "},{"type":"text","text":"process exits. A tracker given a "},{"type":"codeVoice","code":"RecordStore"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"delivers what the store kept from earlier runs first, and writes each record to it once the"},{"type":"text","text":" "},{"type":"text","text":"worker reaches it: a record is durable from then on, and one tracked moments before the"},{"type":"text","text":" "},{"type":"text","text":"process is killed, not yet reached, is lost."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tracker given "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true,"type":"reference"},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, dropping the"},{"type":"text","text":" "},{"type":"text","text":"rest before they are held, written or delivered and reporting them on"},{"type":"text","text":" "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"A tracker given a ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","isActive":true,"type":"reference"},{"text":" delivers an event only once its category is granted, holding it","type":"text"},{"text":" ","type":"text"},{"text":"while undecided and dropping it when denied; one given none delivers every event.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct"]},{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)"]},{"anchor":"Type-Properties","title":"Type Properties","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"]}],"references":{"doc://Trackers/documentation/Trackers/Tracker/init(consent:enrichers:samplers:samplingSeed:now:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8Trackers7ConsentV","text":"Consent","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"enrichers","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"samplers","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:8Trackers7SamplerV","text":"Sampler","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"samplingSeed","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s6UInt64V","text":"UInt64","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(consent:enrichers:samplers:samplingSeed:now:)","role":"symbol","kind":"symbol","abstract":[{"text":"A tracker recording every event it tracks, or, given ","type":"text"},{"code":"consent","type":"codeVoice"},{"text":", every event it consents to,","type":"text"},{"text":" ","type":"text"},{"text":"and, given ","type":"text"},{"code":"samplers","type":"codeVoice"},{"text":", the fraction of them they keep.","type":"text"}],"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)","url":"\/documentation\/trackers\/tracker\/init(consent:enrichers:samplers:samplingseed:now:)"},"doc://Trackers/documentation/Trackers/Tracker/track(_:file:fileID:function:line:column:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"track"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":", "},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"function"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"column"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"type":"topic","url":"\/documentation\/trackers\/tracker\/track(_:file:fileid:function:line:column:)","abstract":[{"type":"text","text":"Records "},{"type":"codeVoice","code":"event"},{"type":"text","text":", with the current wall-clock time, the caller’s source location and the"},{"type":"text","text":" "},{"type":"text","text":"task’s "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" as the enrichers extend it."}],"title":"track(_:file:fileID:function:line:column:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)"},"doc://Trackers/documentation/Trackers/Tracker/Records-swift.struct":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct","navigatorTitle":[{"text":"Records","kind":"identifier"}],"abstract":[{"type":"text","text":"The records of the events a tracker tracks, in the order tracked: what a delivery reads."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Records","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/trackers\/tracker\/records-swift.struct","title":"Tracker.Records"},"doc://Trackers/documentation/Trackers/Consent":{"type":"topic","navigatorTitle":[{"text":"Consent","kind":"identifier"}],"title":"Consent","role":"symbol","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","kind":"symbol","url":"\/documentation\/trackers\/consent","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}]},"doc://Trackers/documentation/Trackers/Tracker/noOp":{"type":"topic","title":"noOp","role":"symbol","abstract":[{"type":"text","text":"A tracker that drops every event, logging each one at debug level. Its "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"empty."}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","kind":"symbol","url":"\/documentation\/trackers\/tracker\/noop","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noOp","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier"}]},"doc://Trackers/documentation/Trackers/Sampler":{"abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"title":"Sampler","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"topic","role":"symbol","navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"url":"\/documentation\/trackers\/sampler","kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker/rejectionReports":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers15RejectionReportV","text":"RejectionReport"},{"kind":"text","text":">"}],"title":"rejectionReports","role":"symbol","kind":"symbol","abstract":[{"text":"A report of each event the tracker rejected because a property broke a constraint declared","type":"text"},{"text":" ","type":"text"},{"text":"on it, in the order the rejections happen.","type":"text"}],"type":"topic","url":"\/documentation\/trackers\/tracker\/rejectionreports","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports"},"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"abstract":[{"type":"text","text":"A report of each event the tracker’s "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true},{"type":"text","text":"s dropped, in the order the drops happen."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},