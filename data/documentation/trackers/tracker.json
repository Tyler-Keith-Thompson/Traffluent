er"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier","text":"UInt64"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":")"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)","role":"symbol","abstract":[{"type":"text","text":"A tracker recording every event it tracks, or, given "},{"type":"codeVoice","code":"consent"},{"type":"text","text":", every event it consents to,"},{"type":"text","text":" "},{"type":"text","text":"and, given "},{"type":"codeVoice","code":"samplers"},{"type":"text","text":", the fraction of them they keep."}]},"doc://Trackers/documentation/Trackers/Consent":{"title":"Consent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"navigatorTitle":[{"kind":"identifier","text":"Consent"}],"role":"symbol","abstract":[{"text":"The user’s consent, category by category, which a tracker given it applies to every event.","type":"text"}],"kind":"symbol","url":"\/documentation\/trackers\/consent","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","type":"topic"},"doc://Trackers/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/Trackers\/s8SendableP"},"doc://Trackers/documentation/Trackers/Tracker/finish()":{"kind":"symbol","url":"\/documentation\/trackers\/tracker\/finish()","type":"topic","title":"finish()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","role":"symbol","abstract":[{"type":"text","text":"Ends tracking: waits for the worker to handle every event already tracked, then ends"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":" after them, so a delivery sends what is still pending and completes. Events"},{"type":"text","text":" "},{"type":"text","text":"tracked afterwards are dropped."}]},"doc://Trackers/documentation/Trackers/Tracker/current":{"title":"current","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"current","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8Trackers7TrackerV","text":"Tracker","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","abstract":[{"type":"text","text":"The tracker bound to the current task by the nearest enclosing "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"type":"text","text":" when none is."}],"url":"\/documentation\/trackers\/tracker\/current","kind":"symbol","type":"topic"},"doc://Trackers/documentation/Trackers/Tracker/rejectionReports":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","kind":"symbol","type":"topic","title":"rejectionReports","role":"symbol","abstract":[{"text":"A report of each event the tracker rejected because a property broke a constraint declared","type":"text"},{"text":" ","type":"text"},{"text":"on it, in the order the rejections happen.","type":"text"}],"url":"\/documentation\/trackers\/tracker\/rejectionreports","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","