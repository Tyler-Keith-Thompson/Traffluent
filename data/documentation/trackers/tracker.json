{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","interfaceLanguage":"swift"},"metadata":{"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"modules":[{"name":"Trackers"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L51","fileName":"Tracker.swift"},"title":"Tracker","roleHeading":"Structure","externalID":"s:8Trackers7TrackerV"},"abstract":[{"text":"What app code tracks events with: it records each event, with the time, the caller’s source","type":"text"},{"text":" ","type":"text"},{"text":"location and the task’s context, as one of its ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"text":".","type":"text"}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct"],"generated":true,"anchor":"Structures"},{"title":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Type Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"],"generated":true,"anchor":"Type-Properties"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A tracker is a value. Build one where the app starts, start delivering its records, and either","type":"text"},{"type":"text","text":" "},{"type":"text","text":"pass the tracker down or bind it to a task with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" and read it anywhere inside with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Copies share one stream of records. A binding reaches the work run inside ","type":"text"},{"type":"codeVoice","code":"withTracker"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"the child tasks it starts, but not callbacks a framework runs on tasks of its own, such as a","type":"text"},{"text":" ","type":"text"},{"text":"UI framework’s button actions: pass those a tracker.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)","isActive":true,"type":"reference"},{"text":" does nothing but accept the event, from any","type":"text"},{"text":" ","type":"text"},{"text":"thread: it reads the clock, captures the call site and the task’s ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":", and queues","type":"text"},{"text":" ","type":"text"},{"text":"them. A worker the tracker owns, which never runs on the main actor, does everything else, in","type":"text"},{"text":" ","type":"text"},{"text":"the order events were tracked: the constraints’ check, the enrichers, the samplers, the consent,","type":"text"},{"text":" ","type":"text"},{"text":"a store’s writes, and publishing to ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"text":". No API runs that work on a caller’s thread. ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","isActive":true,"type":"reference"},{"text":" waits for the worker to","type":"text"},{"text":" ","type":"text"},{"text":"catch up; ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","isActive":true,"type":"reference"},{"text":" does too, then ends the records.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Tracked events wait in memory, without a bound, until the worker reaches them. The queue","type":"text"},{"text":" ","type":"text"},{"text":"can’t be bounded without losing something it mustn’t: it also carries consent decisions and","type":"text"},{"text":" ","type":"text"},{"text":"the waits of ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" can’t wait for room without blocking its caller.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a store, records live in memory only, and records not yet delivered are lost if the"},{"type":"text","text":" "},{"type":"text","text":"process exits. A tracker given a "},{"type":"codeVoice","code":"RecordStore"},{"type":"text","text":" ("},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","type":"reference","isActive":true},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"delivers what the store kept from earlier runs first, and writes each record to it once the"},{"type":"text","text":" "},{"type":"text","text":"worker reaches it: a record is durable from then on, and one tracked moments before the"},{"type":"text","text":" "},{"type":"text","text":"process is killed, not yet reached, is lost."}]},{"type":"paragraph","inlineContent":[{"text":"A tracker given ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true},{"text":"s keeps a seeded fraction of the events they apply to, dropping the","type":"text"},{"text":" ","type":"text"},{"text":"rest before they are held, written or delivered and reporting them on","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A tracker given a ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","isActive":true,"type":"reference"},{"text":" delivers an event only once its category is granted, holding it","type":"text"},{"text":" ","type":"text"},{"text":"while undecided and dropping it when denied; one given none delivers every event.","type":"text"}]}],"kind":"content"}],"references":{"doc://Trackers/documentation/Trackers/Consent":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","abstract":[{"text":"The user’s consent, category by category, which a tracker given it applies to every event.","type":"text"}],"kind":"symbol","url":"\/documentation\/trackers\/consent","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"navigatorTitle":[{"kind":"identifier","text":"Consent"}],"role":"symbol","title":"Consent"},"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true,"type":"reference"},{"text":"s dropped, in the order the drops happen.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"SamplingDropReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"text":">","kind":"text"}],"title":"samplingDropReports","url":"\/documentation\/trackers\/tracker\/samplingdropreports"},"doc://Trackers/documentation/Trackers":{"title":"Trackers","kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/trackers","abstract":[],"identifier":"doc:\/\/Trackers\/documentation\/Tracke