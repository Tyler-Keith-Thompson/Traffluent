erty","isActive":true,"type":"reference"},{"text":", or held or dropped by the consent.","type":"text"}],"title":"flush()"},"doc://Trackers/documentation/Trackers/Tracker/init(consent:enrichers:samplers:samplingSeed:now:)":{"role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Consent","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7ConsentV"},{"text":"?, ","kind":"text"},{"text":"enrichers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV"},{"text":"], ","kind":"text"},{"text":"samplers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Sampler","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7SamplerV"},{"text":"], ","kind":"text"},{"text":"samplingSeed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt64","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":")","kind":"text"}],"url":"\/documentation\/trackers\/tracker\/init(consent:enrichers:samplers:samplingseed:now:)","title":"init(consent:enrichers:samplers:samplingSeed:now:)","abstract":[{"type":"text","text":"A tracker recording every event it tracks, or, given "},{"code":"consent","type":"codeVoice"},{"type":"text","text":", every event it consents to,"},{"type":"text","text":" "},{"type":"text","text":"and, given "},{"code":"samplers","type":"codeVoice"},{"type":"text","text":", the fraction of them they keep."}],"kind":"symbol","type":"topic"},"doc://Trackers/documentation/Trackers":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Tra