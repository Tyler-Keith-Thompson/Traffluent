rrent","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"],"title":"Type Properties","anchor":"Type-Properties"}],"kind":"symbol","identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A tracker is a value. Build one where the app starts, start delivering its records, and either"},{"type":"text","text":" "},{"type":"text","text":"pass the tracker down or bind it to a task with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" and read it anywhere inside with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()"]},{"inlineContent":[{"text":"Copies share one stream of records. A binding reaches the work run inside ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"the child tasks it starts, but not callbacks a framework runs on tasks of its own, such as a","type":"text"},{"text":" ","type":"text"},{"text":"UI framework’s button actions: pass those a tracker.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)","isActive":true,"type":"reference"},{"text":" does nothing but accept the event, from any","type":"text"},{"text":" ","type":"text"},{"text":"thread: it reads the clock, captures the call site and the task’s ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":", and queues","type":"text"},{"text":" ","type":"text"},{"text":"them. A worker the tracker owns, which never runs on the main actor, does everything else, in","type":"text"},{"text":" ","type":"text"},{"text":"the order events were tracked: the constraints’ check, the enrichers, the samplers, the consent,","type":"text"},{"text":" ","type":"text"},{"text":"a store’s writes, and publishing to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":". No API runs that work on a caller’s thread. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()"},{"text":" waits for the worker to","type":"text"},{"text":" ","type":"text"},{"text":"catch up; ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()"},{"text":" does too, then ends the records.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Tracked events wait in memory, without a bound, until the worker reaches them. The queue"},{"type":"text","text":" "},{"type":"text","text":"can’t be bounded without losing something it mustn’t: it also carries consent decisions and"},{"type":"text","text":" "},{"type":"text","text":"the waits of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"track"},{"type":"text","text":" can’t wait for room without blocking its caller."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Without a store, records live in memory only, and records not yet delivered are lost if the"},{"type":"text","text":" "},{"type":"text","text":"process exits. A tracker given a "},{"type":"codeVoice","code":"RecordStore"},{"type":"text","text":" ("},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","type":"reference","isActive":true},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"delivers what the store kept from earlier runs first, and writes each record to it once the"},{"type":"text","text":" "},{"type":"text","text":"worker reaches it: a record is durable from then on, and one tracked moments before the"},{"type":"text","text":" "},{"type":"text","text":"process is killed, not yet reached, is lost."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tracker given "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"reference","isActive":true},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, dropping the"},{"type":"text","text":" "},{"type":"text","text":"rest before they are held, written or delivered and reporting them on"},{"type":"text","text":" "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tracker given a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},{"type":"text","text":" delivers an event only once its category is granted, holding it"},{"type":"text","text":" "},{"type":"text","text":"while undecided and dropping it when denied; one given none delivers every event."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker"]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"What app code tracks events with: i