ller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":"."}]},"doc://Trackers/documentation/Trackers":{"title":"Trackers","role":"collection","url":"\/documentation\/trackers","kind":"symbol","type":"topic","abstract":[],"identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://Trackers/documentation/Trackers/Tracker/finish()":{"title":"finish()","role":"symbol","url":"\/documentation\/trackers\/tracker\/finish()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"kind":"symbol","type":"topic","abstract":[{"text":"Ends tracking: waits for the worker to handle every event already tracked, then ends","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"text":" after them, so a delivery sends what is still pending and completes. Events","type":"text"},{"text":" ","type":"text"},{"text":"tracked afterwards are dropped.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()"},"doc://Trackers/documentation/Trackers/Tracker/current":{"kind":"symbol","type":"topic","abstract":[{"text":"The tracker bound to the current task by the nearest enclosing ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","type":"reference"},{"text":" when none is.","type":"text"}],"url":"\/documentation\/trackers\/tracker\/current","title":"current","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind"