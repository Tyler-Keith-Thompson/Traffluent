{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"externalID":"s:8Trackers7TrackerV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L51","fileName":"Tracker.swift"},"title":"Tracker","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"roleHeading":"Structure","role":"symbol","modules":[{"name":"Trackers"}]},"abstract":[{"text":"What app code tracks events with: it records each event, with the time, the caller’s source","type":"text"},{"text":" ","type":"text"},{"text":"location and the task’s context, as one of its ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","interfaceLanguage":"swift"},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"],"generated":true,"title":"Type Properties","anchor":"Type-Properties"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"A tracker is a value. Build one where the app starts, start delivering its records, and either"},{"type":"text","text":" "},{"type":"text","text":"pass the tracker down or bind it to a task with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" and read it anywhere inside with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()"]},{"inlineContent":[{"text":"Copies share one stream of records. A binding reaches the work run inside ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"the child tasks it starts, but not callbacks a framework runs on tasks of its own, such as a","type":"text"},{"text":" ","type":"text"},{"text":"UI framework’s button actions: pass those a tracker.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)"},{"text":" does nothing but accept the event, from any","type":"text"},{"text":" ","type":"text"},{"text":"thread: it reads the clock, captures the call site and the task’s ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":", and queues","type":"text"},{"text":" ","type":"text"},{"text":"them. A worker the tracker owns, which never runs on the main actor, does everything else, in","type":"text"},{"text":" ","type":"text"},{"text":"the order events were tracked: the constraints’ check, the enrichers, the samplers, the consent,","type":"text"},{"text":" ","type":"text"},{"text":"a store’s writes, and publishing to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":". No API runs that work on a caller’s thread. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()"},{"text":" waits for the worker to","type":"text"},{"text":" ","type":"text"},{"text":"catch up; ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()"},{"text":" does too, then ends the records.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Tracked events wait in memory, without a bound, until the worker reaches them. The queue"},{"type":"text","text":" "},{"type":"text","text":"can’t be bounded without losing something it mustn’t: it also carries consent decisions and"},{"type":"text","text":" "},{"type":"text","text":"the waits of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"track"},{"type":"text","text":" can’t wait for room without blocking its caller."}],"type":"paragraph"},{"inlineContent":[{"text":"Without a store, records live in memory only, and records not yet delivered are lost if the","type":"text"},{"text":" ","type":"text"},{"text":"process exits. A tracker given a ","type":"text"},{"code":"RecordStore","type":"codeVoice"},{"text":" (","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","isActive":true,"type":"reference"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"delivers what the store kept from earlier runs first, and writes each record to it once the","type":"text"},{"text":" ","type":"text"},{"text":"worker reaches it: a record is durable from then on, and one tracked moments before the","type":"text"},{"text":" ","type":"text"},{"text":"process is killed, not yet reached, is lost.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A tracker given ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"reference","isActive":true},{"text":"s keeps a seeded fraction of the events they apply to, dropping the","type":"text"},{"text":" ","type":"text"},{"text":"rest before they are held, written or delivered and reporting them on","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A tracker given a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","type":"reference"},{"text":" delivers an event only once its category is granted, holding it","type":"text"},{"text":" ","type":"text"},{"text":"while undecided and dropping it when denied; one given none delivers every event.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"variants":[{"paths":["\/documentation\/trackers\/tracker"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","url":"\/documentation\/trackers\/tracker\/samplingdropreports","abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"reference"},{"text":"s dropped, in the order the drops happen.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers18SamplingDropReportV","text":"SamplingDropReport"},{"kind":"text","text":">"}],"title":"samplingDropReports","kind":"symbol","type":"topic","role":"symbol"},"doc://Trackers/documentation/Trackers/Tracker/track(_:file:fileID:function:line:column:)":{"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)","kind":"symbol","url":"\/documentation\/trackers\/tracker\/track(_:file:fileid:function:line:column:)","abstract":[{"type":"text","text":"Records "},{"type":"codeVoice","code":"event"},{"type":"text","text":", with the current wall-clock time, the caller’s source location and the"},{"type":"text","text":" "},{"type":"text","text":"task’s "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" as the enrichers extend it."}],"title":"track(_:file:fileID:function:line:column:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"track"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":", "},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"function"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"column"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":")"}]},"doc://Trackers/s8SendableP":{"identifier":"doc:\/\/Trackers\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Trackers/documentation/Trackers/Tracker/current":{"abstract":[{"type":"text","text":"The tracker bound to the current task by the nearest enclosing "},{"code":"withTracker","type":"codeVoice"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"type":"text","text":" when none is."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"current"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier","text":"Tracker"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","title":"current","url":