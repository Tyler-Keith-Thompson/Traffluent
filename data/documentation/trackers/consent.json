xt","text":"ones are not collected."}],"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","role":"symbol","type":"topic","url":"\/documentation\/trackers\/consent\/deny(_:)","title":"deny(_:)"},"doc://Trackers/documentation/Trackers/Consent/init(_:checkedHeldRecordLimit:)":{"title":"init(_:checkedHeldRecordLimit:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"(["},{"preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","text":"ConsentCategory"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:8Trackers13ConsentStatusO","kind":"typeIdentifier","text":"ConsentStatus"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"checkedHeldRecordLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8Trackers23NegativeHeldRecordLimitV","kind":"typeIdentifier","text":"NegativeHeldRecordLimit"},{"kind":"text","text":")"}],"role":"symbol","abstract":[{"text":"A consent with the categories in ","type":"text"},{"type":"codeVoice","code":"statuses"},{"text":" decided, and every other undecided, holding","type":"text"},{"text":" ","type":"text"},{"text":"at most ","type":"text"},{"type":"codeVoice","code":"checkedHeldRecordLimit"},{"text":" records while undecided.","type":"text"}],"kind":"symbol","url":"\/documentation\/trackers\/consent\/init(_:checkedheldrecordlimit:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","type":"topic"},"doc://Trackers/s16SendableMetatypeP":{"identifier":"doc:\/\/Trackers\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://Trackers/documentation/Trackers":{"title":"Trackers","role":"collection","identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol","url":"\/documentation\/trackers","abstract":[],