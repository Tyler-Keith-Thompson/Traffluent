{"abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"kind":"symbol","identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"symbolKind":"struct","title":"Consent","modules":[{"name":"Trackers"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"navigatorTitle":[{"text":"Consent","kind":"identifier"}],"externalID":"s:8Trackers7ConsentV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L42","fileName":"Consent.swift"},"role":"symbol"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"seeAlsoSections":[{"generated":true,"anchor":"Consent","title":"Consent","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/ConsentStatus","doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","doc:\/\/Trackers\/documentation\/Trackers\/NegativeHeldRecordLimit"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and","type":"text"},{"text":" ","type":"text"},{"text":"updates it as the user decides:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"]},{"type":"paragraph","inlineContent":[{"text":"Each event is gated by its type’s ","type":"text"},{"code":"Event.consentCategory","type":"codeVoice"},{"text":", by the decisions made before it was","type":"text"},{"text":" ","type":"text"},{"text":"tracked:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Granted:","type":"text"}],"type":"strong"},{"text":" delivered as any event is, written to the tracker’s store first if it has one.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Undecided:"}]},{"type":"text","text":" held in memory, and not written to the store, until the category is decided."},{"type":"text","text":" "},{"type":"text","text":"Granting it delivers its held events in the order they were tracked, before any event"},{"type":"text","text":" "},{"type":"text","text":"tracked after the grant; denying it drops them, reported on "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","isActive":true},{"type":"text","text":". The hold keeps"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"type":"codeVoice","code":"heldRecordLimit"},{"type":"text","text":" events across every category and tracker: when it is full, its"},{"type":"text","text":" "},{"type":"text","text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports"},{"type":"text","text":" "},{"type":"text","text":"not yet read). Held events are lost if the app"},{"type":"text","text":" "},{"type":"text","text":"ends first."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Denied:"}]},{"text":" dropped, and not collected at all, so not reported.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records a store recovered from an earlier run are gated again as the tracker starts, as"},{"type":"text","text":" "},{"type":"text","text":"consent may have changed since. One whose category is now denied is dropped, reported and"},{"type":"text","text":" "},{"type":"text","text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept"},{"type":"text","text":" "},{"type":"text","text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the"},{"type":"text","text":" "},{"type":"text","text":"next launch. One the store drops for its own byte bound while held is reported by the store"},{"type":"text","text":" "},{"type":"text","text":"and still delivered if granted in this run, as a record a delivery has already read is."}]},{"type":"paragraph","inlineContent":[{"text":"A category not given a status is undecided. Withdrawing consent is a denial: records the","type":"text"},{"text":" ","type":"text"},{"text":"tracker had already let through when it was granted are still delivered.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:"},{"type":"text","text":" "},{"type":"text","text":"it records the status, which "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)","type":"reference","isActive":true},{"type":"text","text":" returns from then on, and queues the decision"},{"type":"text","text":" "},{"type":"text","text":"for each tracker given the consent, whose own worker releases or drops what it held. Each"},{"type":"text","text":" "},{"type":"text","text":"tracker reports its own drops."}]}]}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/in