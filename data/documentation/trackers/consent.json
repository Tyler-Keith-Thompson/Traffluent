gories in ","type":"text"},{"code":"statuses","type":"codeVoice"},{"text":" decided, and every other undecided, holding","type":"text"},{"text":" ","type":"text"},{"text":"at most ","type":"text"},{"code":"heldRecordLimit","type":"codeVoice"},{"text":" records while undecided.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/trackers\/consent\/init(_:heldrecordlimit:)","title":"init(_:heldRecordLimit:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:8Trackers13ConsentStatusO","text":"ConsentStatus","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"heldRecordLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:8Trackers23NegativeHeldRecordLimitV","text":"NegativeHeldRecordLimit","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://Trackers/documentation/Trackers/Consent/dropReports":{"role":"symbol","title":"dropReports","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","url":"\/documentation\/trackers\/consent\/dropreports","kind":"symbol","abstract":[{"text":"A report of each drop of held or recovered records, in the order they happen.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:8Trackers17ConsentDropReportO","text":"ConsentDropReport","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Trackers/documentation/Trackers/ConsentDropReport":{"identifier":"do