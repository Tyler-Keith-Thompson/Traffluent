{"sections":[],"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"],"title":"Instance Methods"},{"generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"],"title":"Type Properties"}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"kind":"relationships"}],"variants":[{"paths":["\/documentation\/trackers\/consent"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","interfaceLanguage":"swift"},"abstract":[{"text":"The user’s consent, category by category, which a tracker given it applies to every event.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and","type":"text"},{"text":" ","type":"text"},{"text":"updates it as the user decides:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"]},{"inlineContent":[{"type":"text","text":"Each event is gated by its type’s "},{"code":"Event.consentCategory","type":"codeVoice"},{"type":"text","text":", by the decisions made before it was"},{"type":"text","text":" "},{"type":"text","text":"tracked:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Granted:","type":"text"}]},{"type":"text","text":" delivered as any event is, written to the tracker’s store first if it has one."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Undecided:"}]},{"text":" held in memory, and not written to the store, until the category is decided.","type":"text"},{"text":" ","type":"text"},{"text":"Granting it delivers its held events in the order they were tracked, before any event","type":"text"},{"text":" ","type":"text"},{"text":"tracked after the grant; denying it drops them, reported on ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","isActive":true,"type":"reference"},{"text":". The hold keeps","type":"text"},{"text":" ","type":"text"},{"text":"at most ","type":"text"},{"code":"heldRecordLimit","type":"codeVoice"},{"text":" events across every category and tracker: when it is full, its","type":"text"},{"text":" ","type":"text"},{"text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports","type":"text"},{"text":" ","type":"text"},{"text":"not yet read). Held events are lost if the app","type":"text"},{"text":" ","type":"text"},{"text":"ends first.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Denied:"}],"type":"strong"},{"text":" dropped, and not collected at all, so not reported.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Records a store recovered from an earlier run are gated again as the tracker starts, as"},{"type":"text","text":" "},{"type":"text","text":"consent may have changed since. One whose category is now denied is dropped, reported and"},{"type":"text","text":" "},{"type":"text","text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept"},{"type":"text","text":" "},{"type":"text","text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the"},{"type":"text","text":" "},{"type":"text","text":"next launch. One the store drops for its own byte bound while held is reported by the store"},{"type":"text","text":" "},{"type":"text","text":"and still delivered if granted in this run, as a record a delivery has already read is."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A category not given a status is undecided. Withdrawing consent is a denial: records the"},{"type":"text","text":" "},{"type":"text","text":"tracker had already let through when it was granted are still delivered."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:"},{"type":"text","text":" "},{"type":"text","text":"it records the status, which "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)","type":"reference","isActive":true},{"type":"text","text":" returns from then on, and queues the decision"},{"type":"text","text":" "},{"type":"text","text":"for each tracker given the consent, whose own worker releases or drops what it held. Each"},{"type":"text","text":" "},{"type":"text","text":"tracker reports its own drops."}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"anchor":"Consent","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/ConsentStatus","doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","doc:\/\/Trackers\/documentation\/Trackers\/NegativeHeldRecordLimit"],"title":"Consent"}],"kind":"symbol","metadata":{"navigatorTitle":[{"text":"Consent","kind":"identifier"}],"remoteSource":{"fileName":"Consent.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L42"},"title":"Consent","role":"symbol","roleHeading":"Structure","externalID":"s:8Trackers7ConsentV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"symbolKind":"struct","modules":[{"name":"Trackers"}]},"references":{"doc://Trackers/documentation/Trackers/Consent/defaultHeldRecordLimit":{"url":"\/documentation\/trackers\/consent\/defaultheldrecordlimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultHeldRecordLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit","title":"defaultHeldRecordLimit","abstract":[{"text":"The most records a consent holds unless it is given another bound: 1,000.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://Trackers/documentation/Trackers/ConsentDropReport":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsentDropReport","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","url":"\/documentation\/trackers\/consentdropreport","type":"topic","navigatorTitle":[{"text":"ConsentDropReport","kind":"identifier"}],"role":"symbol","abstract":[{"text":"Records a ","type":"text