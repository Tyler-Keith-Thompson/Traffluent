{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and","type":"text"},{"text":" ","type":"text"},{"text":"updates it as the user decides:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event is gated by its type’s "},{"type":"codeVoice","code":"Event.consentCategory"},{"type":"text","text":", by the decisions made before it was"},{"type":"text","text":" "},{"type":"text","text":"tracked:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Granted:","type":"text"}]},{"type":"text","text":" delivered as any event is, written to the tracker’s store first if it has one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Undecided:","type":"text"}]},{"type":"text","text":" held in memory, and not written to the store, until the category is decided."},{"type":"text","text":" "},{"type":"text","text":"Granting it delivers its held events in the order they were tracked, before any event"},{"type":"text","text":" "},{"type":"text","text":"tracked after the grant; denying it drops them, reported on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},{"type":"text","text":". The hold keeps"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"type":"codeVoice","code":"heldRecordLimit"},{"type":"text","text":" events across every category and tracker: when it is full, its"},{"type":"text","text":" "},{"type":"text","text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports"},{"type":"text","text":" "},{"type":"text","text":"not yet read). Held events are lost if the app"},{"type":"text","text":" "},{"type":"text","text":"ends first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Denied:"}],"type":"strong"},{"text":" dropped, and not collected at all, so not reported.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records a store recovered from an earlier run are gated again as the tracker starts, as"},{"type":"text","text":" "},{"type":"text","text":"consent may have changed since. One whose category is now denied is dropped, reported and"},{"type":"text","text":" "},{"type":"text","text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept"},{"type":"text","text":" "},{"type":"text","text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the"},{"type":"text","text":" "},{"type":"text","text":"next launch. One the store drops for its own byte bound while held is reported by the store"},{"type":"text","text":" "},{"type":"text","text":"and still delivered if granted in this run, as a record a delivery has already read is."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A category not given a status is undecided. Withdrawing consent is a denial: records the"},{"type":"text","text":" "},{"type":"text","text":"tracker had already let through when it was granted are still delivered."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:"},{"type":"text","text":" "},{"type":"text","text":"it records the status, which "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"},{"type":"text","text":" returns from then on, and queues the decision"},{"type":"text","text":" "},{"type":"text","text":"for each tracker given the consent, whose own worker releases or drops what it held. Each"},{"type":"text","text":" "},{"type":"text","text":"tracker reports its own drops."}]}]}],"metadata":{"symbolKind":"struct","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L42","fileName":"Consent.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"externalID":"s:8Trackers7ConsentV","navigatorTitle":[{"kind":"identifier","text":"Consent"}],"title":"Consent","modules":[{"name":"Trackers"}],"roleHeading":"Structure"},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"sections":[],"variants":[{"paths":["\/documentation\/trackers\/consent"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","interfaceLanguage":"swift"},"abstract":[{"text":"The user’s consent, category by category, which a tracker given it applies to every event.","type":"text"}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"],"anchor":"Instance-Properties","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"],"anchor":"Instance-Methods","generated":true},{"title":"Type Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"],"anchor":"Type-Properties","generated":true}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"type":"conformsTo"}],"references":{"doc://Trackers/documentation/Trackers":{"type":"topic","role":"collection","identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers","kind":"symbol","url":"\/documentation\/trackers","abstract":[]},"doc://Trackers/documentation/Trackers/Consent/status(of:)":{"type":"topic","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)","title":"status(of:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"status"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers13ConsentStatusO","text":"ConsentStatus"}],"abstract":[{"text":"The status of ","type":"text"},{"code":"category","type":"codeVoice"},{"text":": undecided unless given or decided.","type":"text"}],"kind":"symbol","url":"\/documentation\/trackers\/consent\/status(of:)"},"doc://Trackers/documentation/Trackers/Consent/init(_:heldRecordLimit:)":{"kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"ConsentStatus","preciseIdentifier":"s:8Trackers13ConsentStatusO"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"heldRecordLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"type":"topic","title":"init(_:heldRecordLimit:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)","url":"\/documentation\/trackers\/consent\/init(_:heldrecordlimit:)","abstract":[{"type":"text","text":"A consent with the categories in "},{"type":"codeVoice","code":"statuses"},{"type":"text","text":" decided, and every other undecided."}]},"doc://Trackers/documentation/Trackers/Consent/init(_:checkedHeldRecordLimit:)":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","title":"init(_:checkedHeldRecordLimit:)","abstract":[{"type":"text","text":"A consent with the categories in "},{"type":"codeVoice","code":"statuses"},{"type":"text","text":" decided, and every other undecided, holding"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"type":"codeVoice","code":"checkedHeldRecordLimit"},{"type":"text","text":" records while undecided."}],"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"text":" : ","kind":"text"},{"text":"ConsentStatus","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers13ConsentStatusO"},{"text":"], ","kind":"text"},{"text":"checkedHeldRecordLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NegativeHeldRecordLimit","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers23NegativeHeldRecordLimitV"},{"text":")","kind":"text"}],"url":"\/documentation\/trackers\/consent\/init(_:checkedheldrecordlimit:)","type":"topic","kind":"symbol"},"doc://Trackers/documentation/Trackers/Consent/heldRecordCount":{"kind":"symbol","type":"topic","title":"heldRecordCount","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"heldRecordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"url":"\/documentation\/trackers\/consent\/heldrecordcount","role":"symbol","abstract":[{"text":"How many records are held, waiting for their category to be decided: those held in memory","type":"text"},{"text":" ","type":"text"},{"text":"only and those a store recovered.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"},"doc://Trackers/documentation/Trackers/Consent/defaultHeldRecordLimit":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultHeldRecordLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","url":"\/documentation\/trackers\/consent\/defaultheldrecordlimit","title":"defaultHeldRecordLimit","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit","abstract":[{"text":"The most records a consent holds unless it is given another bound: 1,000.","type":"text"}]},"doc://Trackers/documentation/Trackers/Consent":{"type":"topic","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"url":"\/documentation\/trackers\/consent","kind":"symbol","title":"Consent","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"navigatorTitle":[{"text":"Consent","kind":"identifier"}],"role":"symbol"},"doc://Trackers/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Trackers\/s8SendableP","title":"Swift.Sendable"},"doc://Trackers/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/Trackers\/s16SendableMetatypeP"},"doc://Trackers/documentation/Trackers/Consent/deny(_:)":{"type":"topic","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","title":"deny(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deny"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":"...)"}],"abstract":[{"type":"text","text":"Denies "},{"type":"codeVoice","code":"categories"},{"type":"text","text":": their held events are dropped, reported on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},{"type":"text","text":", and later"},{"type":"text","text":" "},{"type":"text","text":"ones are not collected."}],"url":"\/documentation\/trackers\/consent\/deny(_:)","kind":"symbol"},"doc://Trackers/documentation/Trackers/Consent/dropReports":{"url":"\/documentation\/trackers\/consent\/dropreports","type":"topic","abstract":[{"text":"A report of each drop of held or recovered records, in the order they happen.","type":"text"}],"title":"dropReports","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers17ConsentDropReportO","text":"ConsentDropReport"},{"kind":"text","text":">"}],"role":"symbol"},"doc://Trackers/documentation/Trackers/Consent/grant(_:)":{"role":"