{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/consent"]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L42","fileName":"Consent.swift"},"navigatorTitle":[{"text":"Consent","kind":"identifier"}],"title":"Consent","externalID":"s:8Trackers7ConsentV","symbolKind":"struct","modules":[{"name":"Trackers"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"roleHeading":"Structure","role":"symbol"},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and"},{"type":"text","text":" "},{"type":"text","text":"updates it as the user decides:"}],"type":"paragraph"},{"code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each event is gated by its type’s "},{"code":"Event.consentCategory","type":"codeVoice"},{"type":"text","text":", by the decisions made before it was"},{"type":"text","text":" "},{"type":"text","text":"tracked:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Granted:"}],"type":"strong"},{"text":" delivered as any event is, written to the tracker’s store first if it has one.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Undecided:"}]},{"type":"text","text":" held in memory, and not written to the store, until the category is decided."},{"type":"text","text":" "},{"type":"text","text":"Granting it delivers its held events in the order they were tracked, before any event"},{"type":"text","text":" "},{"type":"text","text":"tracked after the grant; denying it drops them, reported on "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","type":"reference","isActive":true},{"type":"text","text":". The hold keeps"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"code":"heldRecordLimit","type":"codeVoice"},{"type":"text","text":" events across every category and tracker: when it is full, its"},{"type":"text","text":" "},{"type":"text","text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports"},{"type":"text","text":" "},{"type":"text","text":"not yet read). Held events are lost if the app"},{"type":"text","text":" "},{"type":"text","text":"ends first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Denied:"}],"type":"strong"},{"type":"text","text":" dropped, and not collected at all, so not reported."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Records a store recovered from an earlier run are gated again as the tracker starts, as","type":"text"},{"text":" ","type":"text"},{"text":"consent may have changed since. One whose category is now denied is dropped, reported and","type":"text"},{"text":" ","type":"text"},{"text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept","type":"text"},{"text":" ","type":"text"},{"text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the","type":"text"},{"text":" ","type":"text"},{"text":"next launch. One the store drops for its own byte bound while held is reported by the store","type":"text"},{"text":" ","type":"text"},{"text":"and still delivered if granted in this run, as a record a delivery has already read is.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A category not given a status is undecided. Withdrawing consent is a denial: records the"},{"type":"text","text":" "},{"type":"text","text":"tracker had already let through when it was granted are still delivered."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:"},{"type":"text","text":" "},{"type":"text","text":"it records the status, which "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)","isActive":true},{"type":"text","text":" returns from then on, and queues the decision"},{"type":"text","text":" "},{"type":"text","text":"for each tracker given the consent, whose own worker releases or drops what it held. Each"},{"type":"text","text":" "},{"type":"text","text":"tracker reports its own drops."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"references":{"doc://Trackers/documentation/Trackers/Consent/init(_:checkedHeldRecordLimit:)":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","abstract":[{"type":"text","text":"A consent with the categories in "},{"type":"codeVoice","code":"statuses"},{"type":"text","text":" decided, and every other undecided, holding"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"type":"codeVoice","code":"checkedHeldRecordLimit"},{"type":"text","text":" records while undecided."}],"url":"\/documentation\/trackers\/consent\/init(_:checkedheldrecordlimit:)","role":"symbol","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"ConsentStatus","preciseIdentifier":"s:8Trackers13ConsentStatusO","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"checkedHeldRecordLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NegativeHeldRecordLimit","preciseIdentifier":"s:8Trackers23NegativeHeldRecordLimitV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","title":"init(_:checkedHeldRecordLimit:)"},"doc://Trackers/documentation/Trackers/Consent/defaultHeldRecordLimit":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit","url":"\/documentation\/trackers\/consent\/defaultheldrecordlimit","abstract":[{"type":"text","text":"The most records a consent holds unless it is given another bound: 1,000."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultHeldRecordLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"kind":"symbol","title":"defaultHeldRecordLimit"},"doc://Trackers/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Trackers\/s8SendableP","title":"Swift.Sendable"},"doc://Trackers/documentation/Trackers/Consent/status(of:)":{"role":"symbol","abstract":[{"text":"The status of ","type":"text"},{"code":"category","type":"codeVoice"},{"text":": undecided unless given or decided.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"status"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers13ConsentStatusO","text":"ConsentStatus"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)","title":"status(of:)","url":"\/documentation\/trackers\/consent\/status(of:)","kind":"symbol","type":"topic"},"doc://Trackers/documentation/Trackers/Consent/heldRecordCount":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount","abstract":[{"text":"How many records are held, waiting for their category to be decided: those held in memory","type":"text"},{"text":" ","type":"text"},{"text":"only and those a store recovered.","type":"text"}],"url":"\/documentation\/trackers\/consent\/heldrecordcount","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"heldRecordCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"kind":"symbol","title":"heldRecordCount"},"doc://Trackers/documentation/Trackers/Consent/deny(_:)":{"role":"symbol","abstract":[{"type":"text","text":"Denies "},{"code":"categories","type":"codeVoice"},{"type":"text","text":": their held events are dropped, reported on "},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","type":"reference"},{"type":"text","text":", and later"},{"type":"text","text":" "},{"type":"text","text":"ones are not collected."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deny"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":"...)"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","title":"deny(_:)","url":"\/documentation\/trackers\/consent\/deny(_:)","kind":"symbol","type":"topic"},"doc://Trackers/documentation/Trackers/Consent/dropReports":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","url":"\/documentation\/trackers\/consent\/dropreports","abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}],"role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO","kind":"typeIdentifier"},{"text":">","kind":"text