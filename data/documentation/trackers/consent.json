{"metadata":{"title":"Consent","externalID":"s:8Trackers7ConsentV","symbolKind":"struct","modules":[{"name":"Trackers"}],"roleHeading":"Structure","remoteSource":{"fileName":"Consent.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L43"},"navigatorTitle":[{"kind":"identifier","text":"Consent"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}]},"sections":[],"abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and","type":"text"},{"text":" ","type":"text"},{"text":"updates it as the user decides:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"]},{"type":"paragraph","inlineContent":[{"text":"Each event is gated by its type’s ","type":"text"},{"code":"Event.consentCategory","type":"codeVoice"},{"text":", by the decisions made before it was","type":"text"},{"text":" ","type":"text"},{"text":"tracked:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Granted:"}]},{"type":"text","text":" delivered as any event is, written to the tracker’s store first if it has one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Undecided:"}],"type":"strong"},{"text":" held in memory, and not written to the store, until the category is decided.","type":"text"},{"text":" ","type":"text"},{"text":"Granting it delivers its held events in the order they were tracked, before any event","type":"text"},{"text":" ","type":"text"},{"text":"tracked after the grant; denying it drops them, reported on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","type":"reference"},{"text":". The hold keeps","type":"text"},{"text":" ","type":"text"},{"text":"at most ","type":"text"},{"type":"codeVoice","code":"heldRecordLimit"},{"text":" events across every category and tracker: when it is full, its","type":"text"},{"text":" ","type":"text"},{"text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports","type":"text"},{"text":" ","type":"text"},{"text":"not yet read). Held events are lost if the app","type":"text"},{"text":" ","type":"text"},{"text":"ends first.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Denied:","type":"text"}]},{"text":" dropped, and not collected at all, so not reported.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Records a store recovered from an earlier run are gated again as the tracker starts, as","type":"text"},{"text":" ","type":"text"},{"text":"consent may have changed since. One whose category is now denied is dropped, reported and","type":"text"},{"text":" ","type":"text"},{"text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept","type":"text"},{"text":" ","type":"text"},{"text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the","type":"text"},{"text":" ","type":"text"},{"text":"next launch. One the store drops for its own byte bound while held is reported by the store","type":"text"},{"text":" ","type":"text"},{"text":"and still delivered if granted in this run, as a record a delivery has already read is.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A category not given a status is undecided. Withdrawing consent is a denial: records the"},{"type":"text","text":" "},{"type":"text","text":"tracker had already let through when it was granted are still delivered."}]},{"type":"paragraph","inlineContent":[{"text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:","type":"text"},{"text":" ","type":"text"},{"text":"it records the status, which ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)","isActive":true},{"text":" returns from then on, and queues the decision","type":"text"},{"text":" ","type":"text"},{"text":"for each tracker given the consent, whose own worker releases or drops what it held. Each","type":"text"},{"text":" ","type":"text"},{"text":"tracker reports its own drops.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/trackers\/consent"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"]},{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"type":"conformsTo"}],"seeAlsoSections":[{"title":"Consent","anchor":"Consent","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/ConsentStatus","doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","doc:\/\/Trackers\/documentation\/Trackers\/NegativeHeldRecordLimit"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","interfaceLanguage":"swift"},"references":{"doc://Trackers/documentation/Trackers/ConsentStatus":{"navigatorTitle":[{"kind":"identifier","text":"ConsentStatus"}],"title":"ConsentStatus","abstract":[{"type":"text","text":"Where the user stands on one consent category."}],"url":"\/documentation\/trackers\/consentstatus","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentStatus","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsentStatus"}],"kind":"symbol","role":"symbol"},"doc://Trackers/documentation/Trackers/ConsentDropReport":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsentDropReport"}],"abstract":[{"type":"text","text":"Records a "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","isActive":true},{"type":"text","text":" dropped before they were delivered, and why."}],"title":"ConsentDropReport","navigatorTitle":[{"kind":"identifier","text":"ConsentDropReport"}],"url":"\/documentation\/trackers\/consentdropreport","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/ConsentDropReport","kind":"symbol","role":"symbol