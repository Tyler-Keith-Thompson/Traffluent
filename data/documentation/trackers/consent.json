{"abstract":[{"text":"The user’s consent, category by category, which a tracker given it applies to every event.","type":"text"}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"metadata":{"role":"symbol","modules":[{"name":"Trackers"}],"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Consent"}],"title":"Consent","externalID":"s:8Trackers7ConsentV","roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L42","fileName":"Consent.swift"}},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/consent"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"],"generated":true,"anchor":"Type-Properties","title":"Type Properties"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and"},{"type":"text","text":" "},{"type":"text","text":"updates it as the user decides:"}]},{"type":"codeListing","syntax":"swift","code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"]},{"type":"paragraph","inlineContent":[{"text":"Each event is gated by its type’s ","type":"text"},{"code":"Event.consentCategory","type":"codeVoice"},{"text":", by the decisions made before it was","type":"text"},{"text":" ","type":"text"},{"text":"tracked:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Granted:","type":"text"}]},{"type":"text","text":" delivered as any event is, written to the tracker’s store first if it has one."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Undecided:"}]},{"type":"text","text":" held in memory, and not written to the store, until the category is decided."},{"type":"text","text":" "},{"type":"text","text":"Granting it delivers its held events in the order they were tracked, before any event"},{"type":"text","text":" "},{"type":"text","text":"tracked after the grant; denying it drops them, reported on "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","isActive":true,"type":"reference"},{"type":"text","text":". The hold keeps"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"code":"heldRecordLimit","type":"codeVoice"},{"type":"text","text":" events across every category and tracker: when it is full, its"},{"type":"text","text":" "},{"type":"text","text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports"},{"type":"text","text":" "},{"type":"text","text":"not yet read). Held events are lost if the app"},{"type":"text","text":" "},{"type":"text","text":"ends first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Denied:","type":"text"}],"type":"strong"},{"text":" dropped, and not collected at all, so not reported.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Records a store recovered from an earlier run are gated again as the tracker starts, as","type":"text"},{"text":" ","type":"text"},{"text":"consent may have changed since. One whose category is now denied is dropped, reported and","type":"text"},{"text":" ","type":"text"},{"text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept","type":"text"},{"text":" ","type":"text"},{"text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the","type":"text"},{"text":" ","type":"text"},{"text":"next launch. One the store drops for its own byte bound while held is reported by the store","type":"text"},{"text":" ","type":"text"},{"text":"and still delivered if granted in this run, as a record a delivery has already read is.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A category not given a status is undecided. Withdrawing consent is a denial: records the"},{"type":"text","text":" "},{"type":"text","text":"tracker had already let through when it was granted are still delivered."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:"},{"type":"text","text":" "},{"type":"text","text":"it records the status, which "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"},{"type":"text","text":" returns from then on, and queues the decision"},{"type":"text","text":" "},{"type":"text","text":"for each tracker given the consent, whose own worker releases or drops what it held. Each"},{"type":"text","text":" "},{"type":"text","text":"tracker reports its own drops."}]}]}],"references":{"doc://Trackers/documentation/Trackers/Consent/status(of:)":{"abstract":[{"type":"text","text":"The status of "},{"type":"codeVoice","code":"category"},{"type":"text","text":": undecided unless given or decided."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"status","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ConsentStatus","preciseIdentifier":"s:8Trackers13ConsentStatusO","kind":"typeIdentifier"}],"title":"status(of:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)","kind":"symbol","url":"\/documentation\/trackers\/consent\/status(of:)","role":"symbol","type":"topic"},"doc://Trackers/documentation/Trackers/Consent/dropReports":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"ConsentDropReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers17ConsentDropReportO"},{"text":">","kind":"text"}],"kind":"symbol","url":"\/documentation\/trackers\/consent\/dropreports","type":"topic","title":"dropReports","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}]},"doc://Trackers/documentation/Trackers/Consent/grant(_:)":{"role":"symbol","kind":"symbol","url":"\/documentation\/trackers\/consent\/grant(_:)","title":"grant(_:)","abstract":[{"text":"Grants ","type":"text"},{"code":"categories","type":"codeVoice"},{"text":": their held events are delivered, oldest first, and later ones as they","type":"text"},{"text":" ","type":"text"},{"text":"are tracked.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"grant"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":"...)"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)"},"doc://Trackers/documentation/Trackers/Consent/init(_:checkedHeldRecordLimit:)":{"url":"\/documentation\/trackers\/consent\/init(_:checkedheldrecordlimit:)","fragments":[{"text":"init","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:8Trackers13ConsentStatusO","text":"ConsentStatus","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"checkedHeldRecordLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:8Trackers23NegativeHeldRecordLimitV","text":"NegativeHeldRecordLimit","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(_:checkedHeldRecordLimit:)","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:c