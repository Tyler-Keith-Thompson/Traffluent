{"metadata":{"symbolKind":"struct","title":"Consent","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"modules":[{"name":"Trackers"}],"navigatorTitle":[{"kind":"identifier","text":"Consent"}],"role":"symbol","externalID":"s:8Trackers7ConsentV","remoteSource":{"fileName":"Consent.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L42"}},"abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"variants":[{"paths":["\/documentation\/trackers\/consent"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and","type":"text"},{"text":" ","type":"text"},{"text":"updates it as the user decides:","type":"text"}]},{"type":"codeListing","code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event is gated by its type’s "},{"code":"Event.consentCategory","type":"codeVoice"},{"type":"text","text":", by the decisions made before it was"},{"type":"text","text":" "},{"type":"text","text":"tracked:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Granted:","type":"text"}],"type":"strong"},{"type":"text","text":" delivered as any event is, written to the tracker’s store first if it has one."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Undecided:"}],"type":"strong"},{"type":"text","text":" held in memory, and not written to the store, until the category is decided."},{"type":"text","text":" "},{"type":"text","text":"Granting it delivers its held events in the order they were tracked, before any event"},{"type":"text","text":" "},{"type":"text","text":"tracked after the grant; denying it drops them, reported on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},{"type":"text","text":". The hold keeps"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"type":"codeVoice","code":"heldRecordLimit"},{"type":"text","text":" events across every category and tracker: when it is full, its"},{"type":"text","text":" "},{"type":"text","text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports"},{"type":"text","text":" "},{"type":"text","text":"not yet read). Held events are lost if the app"},{"type":"text","text":" "},{"type":"text","text":"ends first."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Denied:","type":"text"}]},{"type":"text","text":" dropped, and not collected at all, so not reported."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records a store recovered from an earlier run are gated again as the tracker starts, as"},{"type":"text","text":" "},{"type":"text","text":"consent may have changed since. One whose category is now denied is dropped, reported and"},{"type":"text","text":" "},{"type":"text","text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept"},{"type":"text","text":" "},{"type":"text","text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the"},{"type":"text","text":" "},{"type":"text","text":"next launch. One the store drops for its own byte bound while held is reported by the store"},{"type":"text","text":" "},{"type":"text","text":"and still delivered if granted in this run, as a record a delivery has already read is."}]},{"type":"paragraph","inlineContent":[{"text":"A category not given a status is undecided. Withdrawing consent is a denial: records the","type":"text"},{"text":" ","type":"text"},{"text":"tracker had already let through when it was granted are still delivered.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:","type":"text"},{"text":" ","type":"text"},{"text":"it records the status, which ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)","type":"reference","isActive":true},{"text":" returns from then on, and queues the decision","type":"text"},{"text":" ","type":"text"},{"text":"for each tracker given the consent, whose own worker releases or drops what it held. Each","type":"text"},{"text":" ","type":"text"},{"text":"tracker reports its own drops.","type":"text"}]}]}],"kind":"symbol","relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"sections":[],"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"]},{