{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and"},{"type":"text","text":" "},{"type":"text","text":"updates it as the user decides:"}]},{"syntax":"swift","code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event is gated by its type’s "},{"type":"codeVoice","code":"Event.consentCategory"},{"type":"text","text":", by the decisions made before it was"},{"type":"text","text":" "},{"type":"text","text":"tracked:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Granted:","type":"text"}]},{"text":" delivered as any event is, written to the tracker’s store first if it has one.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Undecided:","type":"text"}]},{"text":" held in memory, and not written to the store, until the category is decided.","type":"text"},{"text":" ","type":"text"},{"text":"Granting it delivers its held events in the order they were tracked, before any event","type":"text"},{"text":" ","type":"text"},{"text":"tracked after the grant; denying it drops them, reported on ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},{"text":". The hold keeps","type":"text"},{"text":" ","type":"text"},{"text":"at most ","type":"text"},{"code":"heldRecordLimit","type":"codeVoice"},{"text":" events across every category and tracker: when it is full, its","type":"text"},{"text":" ","type":"text"},{"text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports","type":"text"},{"text":" ","type":"text"},{"text":"not yet read). Held events are lost if the app","type":"text"},{"text":" ","type":"text"},{"text":"ends first.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Denied:"}],"type":"strong"},{"text":" dropped, and not collected at all, so not reported.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records a store recovered from an earlier run are gated again as the tracker starts, as"},{"type":"text","text":" "},{"type":"text","text":"consent may have changed since. One whose category is now denied is dropped, reported and"},{"type":"text","text":" "},{"type":"text","text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept"},{"type":"text","text":" "},{"type":"text","text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the"},{"type":"text","text":" "},{"type":"text","text":"next launch. One the store drops for its own byte bound while held is reported by the store"},{"type":"text","text":" "},{"type":"text","text":"and still delivered if granted in this run, as a record a delivery has already read is."}]},{"type":"paragraph","inlineContent":[{"text":"A category not given a status is undecided. Withdrawing consent is a denial: records the","type":"text"},{"text":" ","type":"text"},{"text":"tracker had already let through when it was granted are still delivered.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:"},{"type":"text","text":" "},{"type":"text","text":"it records the status, which "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"},{"type":"text","text":" returns from then on, and queues the decision"},{"type":"text","text":" "},{"type":"text","text":"for each tracker given the consent, whose own worker releases or drops what it held. Each"},{"type":"text","text":" "},{"type":"text","text":"tracker reports its own drops."}]}]}],"variants":[{"paths":["\/documentation\/trackers\/consent"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"],"generated":true,"title":"Instance Properties"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"],"generated":true,"title":"Instance Methods"},{"anchor":"Type-Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"],"generated":true,"title":"Type Properties"}],"metadata":{"modules":[{"name":"Trackers"}],"role":"symbol","title":"Consent","roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L42","fileName":"Consent.swift"},"external