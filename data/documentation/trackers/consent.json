mit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NegativeHeldRecordLimit","preciseIdentifier":"s:8Trackers23NegativeHeldRecordLimitV"},{"kind":"text","text":")"}]},"doc://Trackers/documentation/Trackers/Consent/heldRecordCount":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"heldRecordCount","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"title":"heldRecordCount","type":"topic","kind":"symbol","url":"\/documentation\/trackers\/consent\/heldrecordcount","role":"symbol","abstract":[{"type":"text","text":"How many records are held, waiting for their category to be decided: those held in memory"},{"type":"text","text":" "},{"type":"text","text":"only and those a store recovered."}]},"doc://Trackers/documentation/Trackers/Consent/dropReports":{"kind":"symbol","url":"\/documentation\/trackers\/consent\/dropreports","type":"topic","abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","title":"dropReports","role":"symbol"},"doc://Trackers/documentation/Trackers/Consent/grant(_:)":{"url":"\/documentation\/trackers\/consent\/grant(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"ki