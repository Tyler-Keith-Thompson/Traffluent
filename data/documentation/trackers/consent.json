{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and"},{"type":"text","text":" "},{"type":"text","text":"updates it as the user decides:"}],"type":"paragraph"},{"syntax":"swift","code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each event is gated by its type’s "},{"type":"codeVoice","code":"Event.consentCategory"},{"type":"text","text":", by the decisions made before it was"},{"type":"text","text":" "},{"type":"text","text":"tracked:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Granted:","type":"text"}]},{"text":" delivered as any event is, written to the tracker’s store first if it has one.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Undecided:"}]},{"text":" held in memory, and not written to the store, until the category is decided.","type":"text"},{"text":" ","type":"text"},{"text":"Granting it delivers its held events in the order they were tracked, before any event","type":"text"},{"text":" ","type":"text"},{"text":"tracked after the grant; denying it drops them, reported on ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},{"text":". The hold keeps","type":"text"},{"text":" ","type":"text"},{"text":"at most ","type":"text"},{"code":"heldRecordLimit","type":"codeVoice"},{"text":" events across every category and tracker: when it is full, its","type":"text"},{"text":" ","type":"text"},{"text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports","type":"text"},{"text":" ","type":"text"},{"text":"not yet read). Held events are lost if the app","type":"text"},{"text":" ","type":"text"},{"text":"ends first.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Denied:"}]},{"text":" dropped, and not collected at all, so not reported.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Records a store recovered from an earlier run are gated again as the tracker starts, as","type":"text"},{"text":" ","type":"text"},{"text":"consent may have changed since. One whose category is now denied is dropped, reported and","type":"text"},{"text":" ","type":"text"},{"text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept","type":"text"},{"text":" ","type":"text"},{"text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the","type":"text"},{"text":" ","type":"text"},{"text":"next launch. One the store drops for its own byte bound while held is reported by the store","type":"text"},{"text":" ","type":"text"},{"text":"and still delivered if granted in this run, as a record a delivery has already read is.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A category not given a status is undecided. Withdrawing consent is a denial: records the"},{"type":"text","text":" "},{"type":"text","text":"tracker had already let through when it was granted are still delivered."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:"},{"type":"text","text":" "},{"type":"text","text":"it records the status, which "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"},{"type":"text","text":" returns from then on, and queues the decision"},{"type":"text","text":" "},{"type":"text","text":"for each tracker given the consent, whose own worker releases or drops what it held. Each"},{"type":"text","text":" "},{"type":"text","text":"tracker reports its own drops."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/consent"]}],"abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Type Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"],"anchor":"Type-Properties"}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","interfaceLanguage":"swift"},"metadata":{"remoteSource":{"fileName":"Consent.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L42"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"title":"Consent","navigatorTitle":[{"kind":"identifier","text":"Consent"}],"modules":[{"name":"Trackers"}],"roleHeading":"Structure","role":"symbol","externalID":"s:8Trackers7ConsentV","symbolKind":"struct"},"kind":"symbol","references":{"doc://Trackers/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/Trackers\/s8SendableP"},"doc://Trackers/documentation/Trackers/Consent/status(of:)":{"type":"topic","abstract":[{"type":"text","text":"The status of "},{"type":"codeVoice","code":"category"},{"type":"text","text":": undecided unless given or decided."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"status"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","text":"ConsentCategory"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:8Trackers13ConsentStatusO","kind":"typeIdentifier","text":"ConsentStatus"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)","title":"status(of:)","url":"\/documentation\/trackers\/consent\/status(of:)"},"doc://Trackers/documentation/Trackers/Consent/init(_:checkedHeldRecordLimit:)":{"url":"\/documentation\/trackers\/consent\/init(_:checkedheldrecordlimit:)","title":"init(_:checkedHeldRecordLimit:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"ConsentStatus","preciseIdentifier":"s:8Trackers13ConsentStatusO","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"checkedHeldRecordLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NegativeHeldRecordLimit","preciseIdentifier":"s:8Trackers23NegativeHeldRecordLimitV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A consent with the categories in "},{"type":"codeVoice","code":"statuses"},{"type":"text","text":" decided, and every other undecided, holding"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"type":"codeVoice","code":"checkedHeldRecordLimit"},{"type":"text","text":" records while undecided."}]},"doc://Trackers/documentation/Trackers/Consent/deny(_:)":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","url":"\/documentation\/trackers\/consent\/deny(_:)","abstract":[{"type":"text","text":"Denies "},{"type":"codeVoice","code":"categories"},{"type":"text","text":": their held events are dropped, reported on "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","type":"reference","isActive":true},{"type":"text","text":", and later"},{"type":"text","text":" "},{"type":"text","text":"ones are not collected."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deny"},{"kind":"text","text":"("},{"preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","text":"ConsentCategory"},{"kind":"text","text":"...)"}],"kind":"symbol","type":"topic","role":"symbol","title":"deny(_:)"},"doc://Trackers/documentation/Trackers/Consent/heldRecordCount":{"url":"\/documentation\/trackers\/consent\/heldrecordcount","title":"heldRecordCount","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"heldRecordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","role":"symbol","abstract":[{"text":"How many records are held, waiting for their category to be decided: those held in memory","type":"text"},{"text":" ","type":"text"},{"text":"only and those a store recovered.","type":"text"}]},"doc://Trackers/documentation/Trackers/Consent/dropReports":{"type":"topic","url":"\/documentation\/trackers\/consent\/dropreports","role":"symbol","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","title":"dropReports","abstract":[{"text":"A report of each drop of held or recovered records, in the order they happen.","type":"text"}]},"doc://Trackers/documentation/Trackers/Consent":{"url":"\/documentation\/trackers\/consent","type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Consent","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","title":"Consent","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}]},"doc://Trackers/documentation/Trackers/Consent/grant(_:)":{"url":"\/documentation\/trackers\/consent\/grant(_:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","abstract":[{"type":"text","text":"Grants "},{"type":"codeVoice","code":"categories"},{"type":"text","text":": their held events are delivered, oldest first, and later ones as they"},{"type":"text","text":" "},{"type":"text","text":"are tracked."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"grant"},{"kind":"text","text":"("},{"preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","text":"ConsentCategory"},{"kind":"text","text":"...)"}],"type":"topic","kind":"symbol","role":"symbol","title":"grant(_:)"},"doc://Trackers/documentation/Trackers/Consent/defaultHeldRecordLimit":{"url":"\/documentation\/trackers\/consent\/defaultheldrecordlimit","title":"defaultHeldRecordLimit","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultHeldRecordLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The most records a consent holds unless it is given another bound: 1,000."}]},"doc://Trackers/documentation/Trackers/Consent/init(_:heldRecordLimit:)":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)","url":"\/documentation\/trackers\/consent\/init(_:heldrecordlimit:)","abstract":[{"type":"text","text":"A consent with the categories in "},{"type":"codeVoice","code":"statuses"},{"type":"text","text":" decided, and every other undecided."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers13ConsentStatusO","text":"ConsentStatus"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"heldRecordLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"type":"topic","kind":"symbol","role":"symbol","title":"init(_:heldRecordLimit:)"},"doc://Trackers/documentation/Trackers":{"kind":"symbol","role":"collection","url":"\/documentation\/trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers","abstract":[],"title":"Trackers","type":"topic"},"doc://Trackers/s16SendableMetatypeP":{"identifier":"doc:\/\/Trackers\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"}}}