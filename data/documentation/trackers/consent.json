dCount","abstract":[{"type":"text","text":"How many records are held, waiting for their category to be decided: those held in memory"},{"type":"text","text":" "},{"type":"text","text":"only and those a store recovered."}],"kind":"symbol","role":"symbol"},"doc://Trackers/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Trackers\/s8SendableP","title":"Swift.Sendable"},"doc://Trackers/documentation/Trackers/Consent":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"navigatorTitle":[{"text":"Consent","kind":"identifier"}],"type":"topic","role":"symbol","title":"Consent","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","url":"\/documentation\/trackers\/consent","kind":"symbol","abstract":[{"text":"The user’s consent, category by category, which a tracker given it applies to every event.","type":"text"}]},"doc://Trackers/documentation/Trackers/Consent/init(_:checkedHeldRecordLimit:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"(["},{"preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","text":"ConsentCategory"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:8Trackers13ConsentStatusO","kind":"typeIdentifier","text":"ConsentStatus"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"checkedHeldRecordLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:8Trackers23NegativeHeldRecordLimitV","kind":"typeIdentifier","text":"NegativeHeldRecordLimit"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"A consent with the categories in "},{"type":"codeVoice","code":"statuses"},{"type":"text","text":" decided, and every other undecided, holding"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"type":"codeVoice","code":"checkedHeldRecordLimit"