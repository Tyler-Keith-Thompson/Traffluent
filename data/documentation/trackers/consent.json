{"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L42","fileName":"Consent.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"role":"symbol","externalID":"s:8Trackers7ConsentV","title":"Consent","modules":[{"name":"Trackers"}],"navigatorTitle":[{"kind":"identifier","text":"Consent"}],"symbolKind":"struct"},"kind":"symbol","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"variants":[{"paths":["\/documentation\/trackers\/consent"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"],"title":"Instance Properties","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"],"title":"Instance Methods","generated":true},{"anchor":"Type-Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"],"title":"Type Properties","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}]}]},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and"},{"type":"text","text":" "},{"type":"text","text":"updates it as the user decides:"}],"type":"paragraph"},{"code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each event is gated by its type’s "},{"type":"codeVoice","code":"Event.consentCategory"},{"type":"text","text":", by the decisions made before it was"},{"type":"text","text":" "},{"type":"text","text":"tracked:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Granted:"}],"type":"strong"},{"type":"text","text":" delivered as any event is, written to the tracker’s store first if it has one."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Undecided:","type":"text"}],"type":"strong"},{"type":"text","text":" held in memory, and not written to the store, until the category is decided."},{"type":"text","text":" "},{"type":"text","text":"Granting it delivers its held events in the order they were tracked, before any event"},{"type":"text","text":" "},{"type":"text","text":"tracked after the grant; denying it drops them, reported on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},{"type":"text","text":". The hold keeps"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"type":"codeVoice","code":"heldRecordLimit"},{"type":"text","text":" events across every category and tracker: when it is full, its"},{"type":"text","text":" "},{"type":"text","text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports"},{"type":"text","text":" "},{"type":"text","text":"not yet read). Held events are lost if the app"},{"type":"text","text":" "},{"type":"text","text":"ends first."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Denied:","type":"text"}],"type":"strong"},{"text":" dropped, and not collected at all, so not reported.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Records a store recovered from an earlier run are gated again as the tracker starts, as"},{"type":"text","text":" "},{"type":"text","text":"consent may have changed since. One whose category is now denied is dropped, reported and"},{"type":"text","text":" "},{"type":"text","text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept"},{"type":"text","text":" "},{"type":"text","text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the"},{"type":"text","text":" "},{"type":"text","text":"next launch. One the store drops for its own byte bound while held is reported by the store"},{"type":"text","text":" "},{"type":"text","text":"and still delivered if granted in this run, as a record a delivery has already read is."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A category not given a status is undecided. Withdrawing consent is a denial: records the"},{"type":"text","text":" "},{"type":"text","text":"tracker had already let through when it was granted are still delivered."}],"type":"paragraph"},{"inlineContent":[{"text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:","type":"text"},{"text":" ","type":"text"},{"text":"it records the status, which ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"},{"text":" returns from then on, and queues the decision","type":"text"},{"text":" ","type":"text"},{"text":"for each tracker given the consent, whose own worker releases or drops what it held. Each","type":"text"},{"text":" ","type":"text"},{"text":"tracker reports its own drops.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"references":{"doc://Trackers/documentation/Trackers/Consent":{"role":"symbol","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Consent"}],"url":"\/documentation\/trackers\/consent","title":"Consent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},"doc://Trackers/documentation/Trackers/Consent/heldRecordCount":{"kind":"symbol","type":"topic","url":"\/documentation\/trackers\/consent\/heldrecordcount","abstract":[{"type":"text","text":"How many records are held, waiting for their category to be decided: those held in memory"},{"type":"text","text":" "},{"type":"text","text":"only and those a store recovered."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"heldRecordCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"title":"heldRecordCount","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"},"doc://Trackers/documentation/Trackers":{"title":"Trackers","abstract":[],"identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol","url":"\/documentation\/trackers","type":"topic","role":"collection"},"doc://Trackers/documentation/Trackers/Consent/status(of:)":{"abstract":[{"type":"text","text":"The status of "},{"type":"codeVoice","code":"category"},{"type":"text","text":": undecided unless given or decided."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"status"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ConsentStatus","preciseIdentifier":"s:8Trackers13ConsentStatusO"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)","title":"status(of:)","url":"\/documentation\/trackers\/consent\/status(of:)","type":"topic","role":"symbol","kind":"symbol"},"doc://Trackers/documentation/Trackers/Consent/grant(_:)":{"title":"grant(_:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"grant","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"text":"...)","kind":"text"}],"url":"\/documentation\/trackers\/consent\/grant(_:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","abstract":[{"type":"text","text":"Grants "},{"type":"codeVoice","code":"categories"},{"type":"text","text":": their held events are delivered, oldest first, and later ones as they"},{"type":"text","text":" "},{"type":"text","text":"are tracked."}]},"doc://Trackers/documentation/Trackers/Consent/defaultHeldRecordLimit":{"kind":"symbol","url":"\/documentation\/trackers\/consent\/defaultheldrecordlimit","type":"topic","abstract":[{"type":"text","text":"The most records a consent holds unless it is given another bound: 1,000."}],"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultHeldRecordLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"title":"defaultHeldRecordLimit","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"},"doc://Trackers/documentation/Trackers/Consent/init(_:checkedHeldRecordLimit:)":{"type":"topic","title":"init(_:checkedHeldRecordLimit:)","abstract":[{"type":"text","text":"A consent with the categories in "},{"type":"codeVoice","code":"statuses"},{"type":"text","text":" decided, and every other undecided, holding"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"type":"codeVoice","code":"checkedHeldRecordLimit"},{"type":"text","text":" records while undecided."}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers13ConsentStatusO","text":"ConsentStatus"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"checkedHeldRecordLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers23NegativeHeldRecordLimitV","text":"NegativeHeldRecordLimit"},{"kind":"text","text":")"}],"url":"\/documentation\/trackers\/consent\/init(_:checkedheldrecordlimit:)","role":"symbol"},"doc://Trackers/s8SendableP":{"identifier":"doc:\/\/Trackers\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Trackers/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"d