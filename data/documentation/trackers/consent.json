ue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"ConsentDropReport","preciseIdentifier":"s:8Trackers17ConsentDropReportO","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}],"type":"topic","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},"doc://Trackers/documentation/Trackers/Consent/init(_:)":{"abstract":[{"type":"text","text":"A consent with the categories in "},{"code":"statuses","type":"codeVoice"},{"type":"text","text":" decided, and every other undecided, holding"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit","type":"reference","isActive":true},{"type":"text","text":" records while undecided."}],"title":"init(_:)","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:)","url":"\/documentation\/trackers\/consent\/init(_:)","kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:8Trackers13ConsentStatusO","text":"ConsentStatus","kind":"typeIdentifier"},{"text":"])","kind":"text"}]},"doc://Trackers/documentation/Trackers/Consent/grant(_:)":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"grant","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"text":"...)","kind":"text"}],"role":"symbol","url":"\/documentation\/trackers\/consent\/grant(_:)","title":"grant(_:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","abstract":[{"te