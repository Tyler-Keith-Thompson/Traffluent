{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/consent"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"abstract":[{"text":"The user’s consent, category by category, which a tracker given it applies to every event.","type":"text"}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"]},{"generated":true,"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and"},{"type":"text","text":" "},{"type":"text","text":"updates it as the user decides:"}]},{"type":"codeListing","syntax":"swift","code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"]},{"type":"paragraph","inlineContent":[{"text":"Each event is gated by its type’s ","type":"text"},{"code":"Event.consentCategory","type":"codeVoice"},{"text":", by the decisions made before it was","type":"text"},{"text":" ","type":"text"},{"text":"tracked:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Granted:","type":"text"}]},{"type":"text","text":" delivered as any event is, written to the tracker’s store first if it has one."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Undecided:","type":"text"}]},{"type":"text","text":" held in memory, and not written to the store, until the category is decided."},{"type":"text","text":" "},{"type":"text","text":"Granting it delivers its held events in the order they were tracked, before any event"},{"type":"text","text":" "},{"type":"text","text":"tracked after the grant; denying it drops them, reported on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},{"type":"text","text":". The hold keeps"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"type":"codeVoice","code":"heldRecordLimit"},{"type":"text","text":" events across every category and tracker: when it is full, its"},{"type":"text","text":" "},{"type":"text","text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports"},{"type":"text","text":" "},{"type":"text","text":"not yet read). Held events are lost if the app"},{"type":"text","text":" "},{"type":"text","text":"ends first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Denied:","type":"text"}],"type":"strong"},{"type":"text","text":" dropped, and not collected at all, so not reported."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Records a store recovered from an earlier run are gated again as the tracker starts, as","type":"text"},{"text":" ","type":"text"},{"text":"consent may have changed since. One whose category is now denied is dropped, reported and","type":"text"},{"text":" ","type":"text"},{"text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept","type":"text"},{"text":" ","type":"text"},{"text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the","type":"text"},{"text":" ","type":"text"},{"text":"next launch. One the store drops for its own byte bound while held is reported by the store","type":"text"},{"text":" ","type":"text"},{"text":"and still delivered if granted in this run, as a record a delivery has already read is.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A category not given a status is undecided. Withdrawing consent is a denial: records the"},{"type":"text","text":" "},{"type":"text","text":"tracker had already let through when it was granted are still delivered."}]},{"type":"paragraph","inlineContent":[{"text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:","type":"text"},{"text":" ","type":"text"},{"text":"it records the status, which ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"},{"text":" returns from then on, and queues the decision","type":"text"},{"text":" ","type":"text"},{"text":"for each tracker given the consent, whose own worker releases or drops what it held. Each","type":"text"},{"text":" ","type":"text"},{"text":"tracker reports its own drops.","type":"text"}]}]}],"kind":"symbol","metadata":{"modules":[{"name":"Trackers"}],"externalID":"s:8Trackers7ConsentV","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L42","fileName":"Consent.swift"},"roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Consent"}],"title":"Consent"},"references":{"doc://Trackers/documentation/Trackers":{"title":"Trackers","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/trackers"},"doc://Trackers/documentation/Trackers/Consent/defaultHeldRecordLimit":{"kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultHeldRecordLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"abstract":[{"text":"The most records a consent holds unless it is given another bound: 1,000.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/trackers\/consent\/defaultheldrecordlimit","title":"defaultHeldRecordLimit","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"},"doc://Trackers/documentation/Trackers/Consent/heldRecordCount":{"url":"\/documentation\/trackers\/consent\/heldrecordcount","title":"heldRecordCount","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"heldRecordCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"role":"symbol","abstract":[{"type":"text","text":