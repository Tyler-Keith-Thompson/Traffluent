goryV"},{"text":" : ","kind":"text"},{"text":"ConsentStatus","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers13ConsentStatusO"},{"text":"], ","kind":"text"},{"text":"heldRecordLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}]},"doc://Trackers/documentation/Trackers/Consent/deny(_:)":{"url":"\/documentation\/trackers\/consent\/deny(_:)","abstract":[{"type":"text","text":"Denies "},{"type":"codeVoice","code":"categories"},{"type":"text","text":": their held events are dropped, reported on "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","type":"reference","isActive":true},{"type":"text","text":", and later"},{"type":"text","text":" "},{"type":"text","text":"ones are not collected."}],"role":"symbol","kind":"symbol","type":"topic","title":"deny(_:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deny","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"text":"...)","kind":"text"}]},"doc://Trackers/documentation/Trackers":{"type":"topic","role":"collection","identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers","url":"\/documentation\/trackers","kind":"symbol","abstract":[]},"doc://Trackers/documentation/Trackers/Consent/dropReports":{"type":"topic","title":"dropReports","url":"\/documentation\/trackers\/consent\/dropreports","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","kind":"symbol","abstract":[{"type":"text","text":"A report of each drop of held or recovered records, in the order they happen."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Asy