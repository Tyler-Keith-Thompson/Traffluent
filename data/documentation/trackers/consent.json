{"sections":[],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"abstract":[{"text":"The user’s consent, category by category, which a tracker given it applies to every event.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Structure","externalID":"s:8Trackers7ConsentV","modules":[{"name":"Trackers"}],"remoteSource":{"fileName":"Consent.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L42"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"title":"Consent","navigatorTitle":[{"text":"Consent","kind":"identifier"}],"role":"symbol","symbolKind":"struct"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"],"title":"Type Properties","anchor":"Type-Properties"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/consent"]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and"},{"type":"text","text":" "},{"type":"text","text":"updates it as the user decides:"}]},{"type":"codeListing","code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each event is gated by its type’s ","type":"text"},{"code":"Event.consentCategory","type":"codeVoice"},{"text":", by the decisions made before it was","type":"text"},{"text":" ","type":"text"},{"text":"tracked:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Granted:","type":"text"}],"type":"strong"},{"type":"text","text":" delivered as any event is, written to the tracker’s store first if it has one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Undecided:"}]},{"type":"text","text":" held in memory, and not written to the store, until the category is decided."},{"type":"text","text":" "},{"type":"text","text":"Granting it delivers its held events in the order they were tracked, before any event"},{"type":"text","text":" "},{"type":"text","text":"tracked after the grant; denying it drops them, reported on "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","isActive":true},{"type":"text","text":". The hold keeps"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"type":"codeVoice","code":"heldRecordLimit"},{"type":"text","text":" events across every category and tracker: when it is full, its"},{"type":"text","text":" "},{"type":"text","text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports"},{"type":"text","text":" "},{"type":"text","text":"not yet read). Held events are lost if the app"},{"type":"text","text":" "},{"type":"text","text":"ends first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Denied:","type":"text"}]},{"text":" dropped, and not collected at all, so not reported.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records a store recovered from an earlier run are gated again as the tracker starts, as"},{"type":"text","text":" "},{"type":"text","text":"consent may have changed since. One whose category is now denied is dropped, reported and"},{"type":"text","text":" "},{"type":"text","text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept"},{"type":"text","text":" "},{"type":"text","text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the"},{"type":"text","text":" "},{"type":"text","text":"next launch. One the store drops for its own byte bound while held is reported by the store"},{"type":"text","text":" "},{"type":"text","text":"and still delivered if granted in this run, as a record a delivery has already read is."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A category not given a status is undecided. Withdrawing consent is a denial: records the"},{"type":"text","text":" "},{"type":"text","text":"tracker had already let through when it was granted are still delivered."}]},{"type":"paragraph","inlineContent":[{"text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:","type":"text"},{"text":" ","type":"text"},{"text":"it records the status, which ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"},{"text":" returns from then on, and queues the decision","type":"text"},{"text":" ","type":"text"},{"text":"for each tracker given the consent, whose own worker releases or drops what it held. Each","type":"text"},{"text":" ","type":"text"},{"text":"tracker reports its own drops.","type":"text"}]}],"kind":"content"}],"references":{"doc://Trackers/documentation/Trackers/Consent/init(_:heldRecordLimit:)":{"abstract":[{"text":"A consent with the categories in ","type":"text"},{"code":"statuses","type":"codeVoice"},{"text":" decided, and every other undecided.","type":"text"}],"url":"\/documentation\/trackers\/consent\/init(_:heldrecordlimit:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers13ConsentStatusO","text":"ConsentStatus"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"heldRecordLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"kind":"symbol","type":"topic","title":"init(_:heldRecordLimit:)","role":"symbol"},"doc://Trackers/documentation/Trackers/Consent":{"kind":"symbol","url":"\/documentation\/trackers\/consent","role":"symbol","type":"topic","abstract":[{"text":"The user’s consent, category by category, which a tracker given it applies to every event.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers