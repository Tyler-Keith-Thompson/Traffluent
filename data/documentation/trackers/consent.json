{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"sections":[],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Consent.swift#L42","fileName":"Consent.swift"},"role":"symbol","navigatorTitle":[{"text":"Consent","kind":"identifier"}],"externalID":"s:8Trackers7ConsentV","title":"Consent","symbolKind":"struct","roleHeading":"Structure","modules":[{"name":"Trackers"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}]},"abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:checkedHeldRecordLimit:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Type Properties","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit"],"generated":true,"anchor":"Type-Properties"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The app makes one where it starts, from the decisions it saved, gives it to its tracker, and","type":"text"},{"text":" ","type":"text"},{"text":"updates it as the user decides:","type":"text"}]},{"type":"codeListing","code":["let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","\/\/ Later, from the consent prompt:","consent.grant(.advertising)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event is gated by its type’s "},{"type":"codeVoice","code":"Event.consentCategory"},{"type":"text","text":", by the decisions made before it was"},{"type":"text","text":" "},{"type":"text","text":"tracked:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Granted:","type":"text"}],"type":"strong"},{"text":" delivered as any event is, written to the tracker’s store first if it has one.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Undecided:","type":"text"}]},{"type":"text","text":" held in memory, and not written to the store, until the category is decided."},{"type":"text","text":" "},{"type":"text","text":"Granting it delivers its held events in the order they were tracked, before any event"},{"type":"text","text":" "},{"type":"text","text":"tracked after the grant; denying it drops them, reported on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},{"type":"text","text":". The hold keeps"},{"type":"text","text":" "},{"type":"text","text":"at most "},{"type":"codeVoice","code":"heldRecordLimit"},{"type":"text","text":" events across every category and tracker: when it is full, its"},{"type":"text","text":" "},{"type":"text","text":"oldest is dropped to make room, reported as it happens (merged with the overflow reports"},{"type":"text","text":" "},{"type":"text","text":"not yet read). Held events are lost if the app"},{"type":"text","text":" "},{"type":"text","text":"ends first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Denied:"}],"type":"strong"},{"type":"text","text":" dropped, and not collected at all, so not reported."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Records a store recovered from an earlier run are gated again as the tracker starts, as","type":"text"},{"text":" ","type":"text"},{"text":"consent may have changed since. One whose category is now denied is dropped, reported and","type":"text"},{"text":" ","type":"text"},{"text":"forgotten by the store. One whose category is undecided is held outside the bound, still kept","type":"text"},{"text":" ","type":"text"},{"text":"by the store, so a full hold never drops it; if the app ends first, it is gated again on the","type":"text"},{"text":" ","type":"text"},{"text":"next launch. One the store drops for its own byte bound while held is reported by the store","type":"text"},{"text":" ","type":"text"},{"text":"and still delivered if granted in this run, as a record a delivery has already read is.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A category not given a status is undecided. Withdrawing consent is a denial: records the","type":"text"},{"text":" ","type":"text"},{"text":"tracker had already let through when it was granted are still delivered.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Copies share one set of decisions and one hold. A decision returns at once, from any thread:"},{"type":"text","text":" "},{"type":"text","text":"it records the status, which "},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)","type":"reference"},{"type":"text","text":" returns from then on, and queues the decision"},{"type":"text","text":" "},{"type":"text","text":"for each tracker given the consent, whose own worker releases or drops what it held. Each"},{"type":"text","text":" "},{"type":"text","text":"tracker reports its own drops."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"variants":[{"paths":["\/documentation\/trackers\/consent"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Trackers/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/Trackers\/s16SendableMetatypeP"},"doc://Trackers/documentation/Trackers/Consent/defaultHeldRecordLimit":{"abstract":[{"text":"The most records a consent holds unless it is given another bound: 1,000.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/defaultHeldRecordLimit","role":"symbol","kind":"symbol","title":"defaultHeldRecordLimit","url":"\/documentation\/trackers\/consent\/defaultheldrecordlimit","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultHeldRecordLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"type":"topic"},"doc://Trackers/documentation/Trackers/Consent/grant(_:)":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/grant(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"grant"},{"kind":"text","text":"("},{"preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","text":"ConsentCategory"},{"kind":"text","text":"...)"}],"title":"grant(_:)","abstract":[{"text":"Grants ","type":"text"},{"code":"categories","type":"codeVoice"},{"text":": their held events are delivered, oldest first, and later ones as they","type":"text"},{"text":" ","type":"text"},{"text":"are tracked.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/trackers\/consent\/grant(_:)"},"doc://Trackers/documentation/Trackers/Consent/init(_:heldRecordLimit:)":{"abstract":[{"text":"A consent with the categories in ","type":"text"},{"type":"codeVoice","code":"statuses"},{"text":" decided, and every other undecided.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/init(_:heldRecordLimit:)","role":"symbol","kind":"symbol","title":"init(_:heldRecordLimit:)","url":"\/documentation\/trackers\/consent\/init(_:heldrecordlimit:)","fragments":[{"text":"init","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"ConsentStatus","preciseIdentifier":"s:8Trackers13ConsentStatusO","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"heldRecordLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic"},"doc://Trackers/documentation/Trackers":{"role":"collection","title":"Trackers","abstract":[],"url":"\/documentation\/trackers","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol"},"doc://Trackers/documentation/Trackers/Consent/deny(_:)":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deny","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier"},{"text":"...)","kind":"text"}],"abstract":[{"text":"Denies ","type":"text"},{"type":"codeVoice","code":"categories"},{"text":": their held events are dropped, reported on ","type":"text"},{"identifier":"doc:\/\/Trackers\