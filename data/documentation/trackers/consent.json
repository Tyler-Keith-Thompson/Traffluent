":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Consent"}],"title":"Consent"},"doc://Trackers/documentation/Trackers/Consent/heldRecordCount":{"title":"heldRecordCount","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"heldRecordCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"role":"symbol","url":"\/documentation\/trackers\/consent\/heldrecordcount","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/heldRecordCount","abstract":[{"type":"text","text":"How many records are held, waiting for their category to be decided: those held in memory"},{"type":"text","text":" "},{"type":"text","text":"only and those a store recovered."}]},"doc://Trackers/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/Trackers\/s16SendableMetatypeP"},"doc://Trackers/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/Trackers\/s8SendableP"},"doc://Trackers/documentation/Trackers/Consent/status(of:)":{"role":"symbol","title":"status(of:)","url":"\/documentation\/trackers\/consent\/status(of:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"status"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers13ConsentStatusO","text":"ConsentStatus"}],"abstract":[{"text":"The status of ","type":"text"},{"code":"category","type":"codeVoice"},{"text":": undecided unless given or decided.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/status(of:)","kind":"symbol","type":"topic"},"doc://Trackers/documentation/Trackers/Consent/dropReports":{"url":"\/docum