{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Enricher"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"An enricher reads and sets values through typed "},{"type":"codeVoice","code":"ServiceContextKey"},{"type":"text","text":"s, so what it adds keeps its"},{"type":"text","text":" "},{"type":"text","text":"type all the way to the destinations:"}],"type":"paragraph"},{"syntax":"swift","code":["enum ExperimentKey: ServiceContextKey {","    typealias Value = String","}","","let experiment = Enricher { context in","    context[ExperimentKey.self] = \"new-checkout\"","}","let tracker = Tracker(enrichers: [experiment])"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A tracker’s worker runs its enrichers in order, on the context "},{"code":"track","type":"codeVoice"},{"type":"text","text":" took from"},{"type":"text","text":" "},{"code":"ServiceContext.current","type":"codeVoice"},{"type":"text","text":" when the event was tracked: an enricher sees what earlier ones set,"},{"type":"text","text":" "},{"type":"text","text":"and may override a value the caller’s context already holds. It runs on the worker, not the"},{"type":"text","text":" "},{"type":"text","text":"tracking caller’s thread, so it sees the caller’s context only, not its other task-local"},{"type":"text","text":" "},{"type":"text","text":"values or its actor."}],"type":"paragraph"}]}],"rel