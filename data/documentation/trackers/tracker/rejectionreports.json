{"metadata":{"role":"symbol","modules":[{"name":"Trackers"}],"roleHeading":"Instance Property","title":"rejectionReports","externalID":"s:8Trackers7TrackerV16rejectionReports11AsyncQueues0E5QueueVyAA15RejectionReportVGvp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"RejectionReport","preciseIdentifier":"s:8Trackers15RejectionReportV"},{"kind":"text","text":">"}],"symbolKind":"property","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L364","fileName":"Tracker.swift"}},"abstract":[{"type":"text","text":"A report of each event the tracker rejected because a property broke a constraint declared"},{"type":"text","text":" "},{"type":"text","text":"on it, in the order the rejections happen."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"sections":[],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"RejectionReport","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","preciseIdentifier":"s:8Trackers15RejectionReportV"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The tracker’s worker checks each event’s ","type":"text"},{"type":"codeVoice","code":"constraintViolation()"},{"text":" before anything else, so a","type":"text"},{"text":" ","type":"text"},{"text":"rejected event is never enriched, held by a consent, written to a store or delivered. A","type":"text"},{"text":" ","type":"text"},{"text":"record a store recovered is checked too, and one rejected is forgotten by the store. In","type":"text"},{"text":" ","type":"text"},{"text":"debug builds each rejection is also logged at error level.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read, merged: a rejection joins the waiting report of the same"},{"type":"text","text":" "},{"type":"text","text":"event, property and keyword, adding to its count and widening its timestamps. So the"},{"type":"text","text":" "},{"type":"text","text":"reports waiting unread are at most one per constraint the app declares, however many events"},{"type":"text","text":" "},{"type":"text","text":"break them. Copies of a tracker share one sequence, which ends once the tracker has"},{"type":"text","text":" "},{"type":"text","text":"finished and every report has been read. A "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"type":"text","text":" tracker’s is empty."}]},{"type":"paragraph","inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/trackers\/tracker\/rejectionreports"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Trackers/documentation/Trackers/Tracker/rejectionReports":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"RejectionReport","preciseIdentifier":"s:8Trackers15RejectionReportV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","abstract":[{"text":"A report of each event the tracker rejected because a property broke a constraint declared","type":"text"},{"text":" ","type":"text"},{"text":"on it, in the order the rejections happen.","type":"text"}],"title":"rejectionReports","url":"\/documentation\/trackers\/tracker\/rejectionreports","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports"},"doc://Trackers/documentation/Trackers/Tracker":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"title":"Tracker","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"url":"\/documentation\/trackers\/tracker","abstract":[{"text":"What app code tracks events with: it records each event, with the time, the caller’s source","type":"text"},{"text":" ","type":"text"},{"text":"location and the task’s context, as one of its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":".","type":"text"}]},"doc://Trackers/documentation/Trackers/Tracker/noOp":{"role":"symbol","title":"noOp","abstract":[{"type":"text","text":"A tracker that drops every event, logging each one at debug level. Its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"empty."}],"url":"\/documentation\/trackers\/tracker\/noop","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noOp","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Tracker","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},"doc://Trackers/documentation/Trackers/RejectionReport":{"url":"\/documentation\/trackers\/rejectionreport","title":"RejectionReport","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RejectionReport"}],"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","navigatorTitle":[{"kind":"identifier","text":"RejectionReport"}],"abstract":[{"text":"Events a tracker rejected because a property broke a constraint declared on it: the event’s","type":"text"},{"text":" ","type":"text"},{"text":"name, the property and the keyword it broke, how many were rejected and when they were tracked.","type":"text"}],"type":"topic","role":"symbol"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"title":"AsyncQueue","url":"\/documentation\/asyncqueues\/asyncqueue","type":"topic","kind":"symbol"},"doc://Trackers/documentation/Trackers":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"url":"\/documentation\/trackers","role":"collection"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV","text":"Tracker"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV7RecordsV","text":"Records"}],"kind":"symbol","abstract":[{"text":"The records of the events this tracker tracks, for a delivery to read.","type":"text"}],"url":"\/documentation\/trackers\/tracker\/records-swift.property","title":"records","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"}}}