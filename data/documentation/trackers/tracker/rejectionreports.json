{"abstract":[{"type":"text","text":"A report of each event the tracker rejected because a property broke a constraint declared"},{"type":"text","text":" "},{"type":"text","text":"on it, in the order the rejections happen."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"metadata":{"symbolKind":"property","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L364"},"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers15RejectionReportV","text":"RejectionReport"},{"kind":"text","text":">"}],"role":"symbol","roleHeading":"Instance Property","title":"rejectionReports","modules":[{"name":"Trackers"}],"externalID":"s:8Trackers7TrackerV16rejectionReports11AsyncQueues0E5QueueVyAA15RejectionReportVGvp"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","text":"RejectionReport","preciseIdentifier":"s:8Trackers15RejectionReportV"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The tracker’s worker checks each event’s ","type":"text"},{"code":"constraintViolation()","type":"codeVoice"},{"text":" before anything else, so a","type":"text"},{"text":" ","type":"text"},{"text":"rejected event is never enriched, held by a consent, written to a store or delivered. A","type":"text"},{"text":" ","type":"text"},{"text":"record a store recovered is checked too, and one rejected is forgotten by the store. In","type":"text"},{"text":" ","type":"text"},{"text":"debug builds each rejection is also logged at error level.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Reports wait until they are read, merged: a rejection joins the waiting report of the same","type":"text"},{"text":" ","type":"text"},{"text":"event, property and keyword, adding to its count and widening its timestamps. So the","type":"text"},{"text":" ","type":"text"},{"text":"reports waiting unread are at most one per constraint the app declares, however many events","type":"text"},{"text":" ","type":"text"},{"text":"break them. Copies of a tracker share one sequence, which ends once the tracker has","type":"text"},{"text":" ","type":"text"},{"text":"finished and every report has been read. A ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"text":" tracker’s is empty.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/rejectionreports"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Trackers/documentation/Trackers":{"abstract":[{"text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent.","type":"text"}],"role":"collection","url":"\/documentation\/trackers","title":"Trackers","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"topic"},"doc://Trackers/documentation/Trackers/Tracker/noOp":{"role":"symbol","url":"\/documentation\/trackers\/tracker\/noop","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","kind":"symbol","title":"noOp","abstract":[{"text":"A tracker that drops every event, logging each one at debug level. Its ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"empty.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"noOp"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier","text":"Tracker"}]},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","title":"AsyncQueue","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}],"kind":"symbol","fragments":[{"kind":