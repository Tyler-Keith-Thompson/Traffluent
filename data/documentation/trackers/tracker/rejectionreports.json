{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"sections":[],"variants":[{"paths":["\/documentation\/trackers\/tracker\/rejectionreports"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","interfaceLanguage":"swift"},"metadata":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"RejectionReport","preciseIdentifier":"s:8Trackers15RejectionReportV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"modules":[{"name":"Trackers"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L214","fileName":"Tracker.swift"},"roleHeading":"Instance Property","title":"rejectionReports","externalID":"s:8Trackers7TrackerV16rejectionReportsScSyAA15RejectionReportVGvp","symbolKind":"property"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","kind":"typeIdentifier","text":"RejectionReport","preciseIdentifier":"s:8Trackers15RejectionReportV"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The tracker’s worker checks each event’s ","type":"text"},{"type":"codeVoice","code":"constraintViolation()"},{"text":" before anything else, so a","type":"text"},{"text":" ","type":"text"},{"text":"rejected event is never enriched, held by a consent, written to a store or delivered. A","type":"text"},{"text":" ","type":"text"},{"text":"record a store recovered is checked too, and one rejected is forgotten by the store. In","type":"text"},{"text":" ","type":"text"},{"text":"debug builds each rejection is also logged at error level.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read, merged: a rejection joins the waiting report of the same"},{"text":" ","type":"text"},{"text":"event, property and keyword, adding to its count and widening its timestamps. So the","type":"text"},{"text":" ","type":"text"},{"text":"reports waiting unread are at most one per constraint the app declares, however many events","type":"text"},{"text":" ","type":"text"},{"text":"break them. Copies of a tracker share one sequence, which has one consumer and ends once the","type":"text"},{"text":" ","type":"text"},{"text":"tracker has finished. A ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"text":" tracker’s is empty.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"A report of each event the tracker rejected because a property broke a constraint declared","type":"text"},{"text":" ","type":"text"},{"text":"on it, in the order the rejections happen.","type":"text"}],"references":{"doc://Trackers/documentation/Trackers":{"title":"Trackers","abstract":[],"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://Trackers/documentation/Trackers/Tracker/rejectionReports":{"url":"\/documentation\/trackers\/tracker\/rejectionreports","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracke