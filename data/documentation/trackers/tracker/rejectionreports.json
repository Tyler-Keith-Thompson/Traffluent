:"identifier"}]},"doc://Trackers/documentation/Trackers/Tracker/noOp":{"kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noOp","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8Trackers7TrackerV","text":"Tracker","kind":"typeIdentifier"}],"type":"topic","title":"noOp","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","url":"\/documentation\/trackers\/tracker\/noop","abstract":[{"type":"text","text":"A tracker that drops every event, logging each one at debug level. Its "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference","isActive":true},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"empty."}]},"doc://Trackers/documentation/Trackers":{"type":"topic","role":"collection","identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers","kind":"symbol","url":"\/documentation\/trackers","abstract":[]},"doc://Trackers/documentation/Trackers/RejectionReport":{"url":"\/documentation\/trackers\/rejectionreport","type":"topic","abstract":[{"text":"Events a tracker rejected because a property broke a constraint declared on it: the event’s","type":"text"},{"text":" ","type":"text"},{"text":"name, the property and the keyword it broke, how many were rejected and when they were tracked.","type":"text"}],"title":"RejectionReport","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RejectionReport","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"RejectionReport","kind":"identifier"}]}}}