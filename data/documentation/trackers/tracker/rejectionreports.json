ps. So the","type":"text"},{"text":" ","type":"text"},{"text":"reports waiting unread are at most one per constraint the app declares, however many events","type":"text"},{"text":" ","type":"text"},{"text":"break them. Copies of a tracker share one sequence, which has one consumer and ends once the","type":"text"},{"text":" ","type":"text"},{"text":"tracker has finished. A ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true,"type":"reference"},{"text":" tracker’s is empty.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/rejectionreports"]}],"kind":"symbol","metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L214","fileName":"Tracker.swift"},"title":"rejectionReports","symbolKind":"property","externalID":"s:8Trackers7TrackerV16rejectionReportsScSyAA15RejectionReportVGvp","modules":[{"name":"Trackers"}],"roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"RejectionReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers15RejectionReportV"},{"text":">","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"references":{"doc://Trackers/documentation/Trackers/Tracker/rejectionReports":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind"