{"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","preciseIdentifier":"s:8Trackers15RejectionReportV","text":"RejectionReport","kind":"typeIdentifier"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s worker checks each event’s "},{"code":"constraintViolation()","type":"codeVoice"},{"text":" before anything else, so a","type":"text"},{"text":" ","type":"text"},{"text":"rejected event is never enriched, held by a consent, written to a store or delivered. A","type":"text"},{"text":" ","type":"text"},{"text":"record a store recovered is checked too, and one rejected is forgotten by the store. In","type":"text"},{"text":" ","type":"text"},{"text":"debug builds each rejection is also logged at error level.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read, merged: a rejection joins the waiting report of the same"},{"type":"text","text":" "},{"type":"text","text":"event, property and keyword, adding to its count and widening its timestamps. So the"},{"type":"text","text":" "},{"type":"text","text":"reports waiting unread are at most one per constraint the app declares, however many events"},{"type":"text","text":" "},{"type":"text","text":"break them. Copies of a tracker share one sequence, which ends once the tracker has"},{"type":"text","text":" "},{"type":"text","text":"finished and every report has been read. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},{"type":"text","text":" tracker’s is empty."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads the reports at a time. The first iterator to read holds them until its"},{"type":"text","text":" "},{"type":"text","text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a"},{"type":"text","text":" "},{"type":"text","text":"warning once, then reads on from the next report, so the first gets every report in order."},{"type":"text","text":" "},{"type":"text","text":"A reader cancelled while it waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/rejectionreports"]}],"metadata":{"title":"rejectionReports","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"RejectionReport","preciseIdentifier":"s:8Trackers15RejectionReportV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"externalID":"s:8Trackers7TrackerV16rejectionReports11AsyncQueues0E5QueueVyAA15RejectionReportVGvp","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L364"},"symbolKind":"property","modules":[{"name":"Trackers"}],"roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"abstract":[{"type":"text","text":"A report of each event the tracker rejected because a property broke a constraint declared"},{"type":"text","text":" "},{"type":"text","text":"on it, in the order the rejections happen."}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","url":"\/documentation\/trackers\/tracker\/records-swift.property","abstract":[{"text":"The records of the events this tracker tracks, for a delivery to read.","type":"text"}],"title":"records","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Records","preciseIdentifier":"s:8Trackers7TrackerV7RecordsV","kind":"typeIdentifier"}]},"doc://Trackers/documentation/Trackers/Tracker/noOp":{"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"noOp"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV"}],"role":"symbol","url":"\/documentation\/trackers\/tracker\/noop","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","abstract":[{"text":"A tracker that drops every event, logging each one at debug level. Its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"empty.","type":"text"}],"title":"noOp"},"doc://Trackers/documentation/Trackers/Tracker":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"url":"\/documentation\/trackers\/tracker","abstract":[{"text":"What app code tracks events with: it records each event, with the time, the caller’s source","type":"text"},{"text":" ","type":"text"},{"text":"location and the task’s context, as one of its ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"text":".","type":"text"}],"title":"Tracker","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}]},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}],"url":"\/documentation\/asyncqueues\/asyncqueue","type":"topic","kind":"symbol","navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","abstract":[{"type":"text","text":"The reports or deliveries a library type makes, in the order it makes them, kept until they"},{"type":"text","text":" "},{"type":"text","text":"are read; one reader at a time reads them."}],"title":"AsyncQueue"},"doc://Trackers/documentation/Trackers/RejectionReport":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RejectionReport"}],"role":"symbol","url":"\/documentation\/trackers\/rejectionreport","abstract":[{"text":"Events a tracker rejected because a property broke a constraint declared on it: the event’s","type":"text"},{"text":" ","type":"text"},{"text":"name, the property and the keyword it broke, how many were rejected and when they were tracked.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RejectionReport"}],"title":"RejectionReport"},"doc://Trackers/documentation/Trackers":{"role":"collection","url":"\/documentation\/trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"title":"Trackers","type":"topic","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://Trackers/documentation/Trackers/Tracker/rejectionReports":{"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","url":"\/documentation\/trackers\/tracker\/rejectionreports","kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:8Trackers15RejectionReportV","text":"RejectionReport","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"rejectionReports","abstract":[{"type":"text","text":"A report of each event the tracker rejected because a property broke a constraint declared"},{"type":"text","text":" "},{"type":"text","text":"on it, in the order the rejections happen."}]}}}