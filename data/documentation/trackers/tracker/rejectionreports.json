s\/documentation\/Trackers\/Tracker\/noOp","isActive":true,"type":"reference"},{"text":" tracker’s is empty.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Trackers"}],"title":"rejectionReports","externalID":"s:8Trackers7TrackerV16rejectionReportsScSyAA15RejectionReportVGvp","role":"symbol","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"RejectionReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers15RejectionReportV"},{"text":">","kind":"text"}],"roleHeading":"Instance Property","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L358"}},"variants":[{"paths":["\/documentation\/trackers\/tracker\/rejectionreports"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"abstract":[{"type":"text","text":"A report of each event the tracker rejected because a property broke a constraint declared"},{"type":"text","text":" "},{"type":"text","text":"on it, in the order the rejections happen."}],"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Trackers/documentation/Trackers/Tracker/noOp":{"type":"topic","url":"\/documentation\/trackers\/tracker\/noop","abstract":[{"text":"A tracker that drops every event, logging each one at debug level. Its ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference","isActive":true},{"text":" are","type":"text"},{"text":" ","type":"tex