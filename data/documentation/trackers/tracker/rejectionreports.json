{"sections":[],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","interfaceLanguage":"swift"},"metadata":{"role":"symbol","modules":[{"name":"Trackers"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L214","fileName":"Tracker.swift"},"title":"rejectionReports","externalID":"s:8Trackers7TrackerV16rejectionReportsScSyAA15RejectionReportVGvp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:ScS","kind":"typeIdentifier","text":"AsyncStream"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:8Trackers15RejectionReportV","kind":"typeIdentifier","text":"RejectionReport"},{"kind":"text","text":">"}],"roleHeading":"Instance Property","symbolKind":"property"},"kind":"symbol","abstract":[{"text":"A report of each event the tracker rejected because a property broke a constraint declared","type":"text"},{"text":" ","type":"text"},{"text":"on it, in the order the rejections happen.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/rejectionreports"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:ScS","kind":"typeIdentifier","text":"AsyncStream"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","preciseIdentifier":"s:8Trackers15RejectionReportV","kind":"typeIdentifier","text":"RejectionReport"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platfor