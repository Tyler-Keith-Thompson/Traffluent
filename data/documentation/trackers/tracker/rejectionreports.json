/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"empty.","type":"text"}],"type":"topic","url":"\/documentation\/trackers\/tracker\/noop","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Records","preciseIdentifier":"s:8Trackers7TrackerV7RecordsV"}],"url":"\/documentation\/trackers\/tracker\/records-swift.property","type":"topic","title":"records","abstract":[{"text":"The records of the events this tracker tracks, for a delivery to read.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},"doc://Trackers/documentation/Trackers/RejectionReport":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","url":"\/documentation\/trackers\/rejectionreport","abstract":[{"text":"Events a tracker rejected because a property broke a constraint declared on it: the event’s","type":"text"},{"text":" ","type":"text"},{"text":"name, the property and the keyword it broke, how many were rejected and when they were tracked.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RejectionReport","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"RejectionReport","kind":"identifier"}],"title":"RejectionReport","type":"topic"}}}