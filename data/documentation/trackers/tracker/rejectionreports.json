{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"metadata":{"roleHeading":"Instance Property","role":"symbol","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L214"},"modules":[{"name":"Trackers"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:ScS","kind":"typeIdentifier","text":"AsyncStream"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:8Trackers15RejectionReportV","kind":"typeIdentifier","text":"RejectionReport"},{"kind":"text","text":">"}],"symbolKind":"property","externalID":"s:8Trackers7TrackerV16rejectionReportsScSyAA15RejectionReportVGvp","title":"rejectionReports"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"RejectionReport","kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","preciseIdentifier":"s:8Trackers15RejectionReportV"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"The tracker’s worker checks each event’s ","type":"text"},{"code":"constraintViolation()","type":"codeVoice"},{"text":" before anything else, so a","type":"text"},{"text":" ","type":"text"},{"text":"rejected event is never enriched, held by a consent, written to a store or delivered. A","type":"text"},{"text":" ","type":"text"},{"text":"record a store recovered is checked too, and one rejected is forgotten by the store. In","type":"text"},{"text":" ","type":"text"},{"text":"debug builds each rejection is also logged at error level.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Reports wait until they are read, merged: a rejection joins the waiting report of the same","type":"text"},{"text":" ","type":"text"},{"text":"event, property and keyword, adding to its count and widening its timestamps. So the","type":"text"},{"text":" ","type":"text"},{"text":"reports waiting unread are at most one per constraint the app declares, however many events","type":"text"},{"text":" ","type":"text"},{"text":"break them. Copies of a tracker share one sequence, which has one consumer and ends once the","type":"text"},{"text":" ","type":"text"},{"text":"tracker has finished. A ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"text":" tracker’s is empty.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/rejectionreports"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports"},"abstract":[{"text":"A report of each event the tracker rejected because a property broke a constraint declared","type":"text"},{"text":" ","type":"text"},{"text":"on it, in the order the rejections happen.","type":"text"}],"kind":"symbol","references":{"doc://Trackers/documentation/Trackers/RejectionReport":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RejectionReport","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/trackers\/rejectionreport","title":"RejectionReport","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","navigatorTitle":[{"text":"Re