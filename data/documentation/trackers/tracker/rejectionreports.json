{"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"sections":[],"abstract":[{"type":"text","text":"A report of each event the tracker rejected because a property broke a constraint declared"},{"type":"text","text":" "},{"type":"text","text":"on it, in the order the rejections happen."}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","text":"RejectionReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers15RejectionReportV"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The tracker’s worker checks each event’s "},{"code":"constraintViolation()","type":"codeVoice"},{"type":"text","text":" before anything else, so a"},{"type":"text","text":" "},{"type":"text","text":"rejected event is never enriched, held by a consent, written to a store or delivered. A"},{"type":"text","text":" "},{"type":"text","text":"record a store recovered is checked too, and one rejected is forgotten by the store. In"},{"type":"text","text":" "},{"type":"text","text":"debug builds each rejection is also logged at error level."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Reports wait until they are read, merged: a rejection joins the waiting report of the same"},{"type":"text","text":" "},{"type":"text","text":"event, property and keyword, adding to its count and widening its timestamps. So the"},{"type":"text","text":" "},{"type":"text","text":"reports waiting unread are at most one per constraint the app declares, however many events"},{"type":"text","text":" "},{"type":"text","text":"break them. Copies of a tracker share one sequence, which ends once the tracker has"},{"type":"text","text":" "},{"type":"text","text":"finished and every report has been read. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},{"type":"text","text":" tracker’s is empty."}],"type":"paragraph"},{"inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/rejectionreports"]}],"metadata":{"symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"RejectionReport","preciseIdentifier":"s:8Trackers15RejectionReportV"},{"kind":"text","text":">"}],"modules":[{"name":"Trackers"}],"externalID":"s:8Trackers7TrackerV16rejectionReports11AsyncQueues0E5QueueVyAA15RejectionReportVGvp","roleHeading":"Instance Property","role":"symbol","title":"rejectionReports","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L364"}},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Trackers/documentation/Trackers":{"kind":"symbol","role":"collection","abstract":[{"text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent.","type":"text"}],"url":"\/documentation\/trackers","title":"Trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"topic"},"doc://Trackers/documentation/Trackers/Tracker/noOp":{"url":"\/documentation\/trackers\/tracker\/noop","title":"noOp","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"noOp"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier","text":"Tracker"}],"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","type":"topic","abstract":[{"type":"text","text":"A tracker that drops every event, logging each one at debug level. Its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"empty."}]},"doc://Trackers/documentation/Trackers/Tracker":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"role":"symbol","abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/trackers\/tracker","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"title":"Tracker","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","type":"topic"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","kind":"symbol","title":"records","abstract":[{"text":"The records of the events this tracker tracks, for a delivery to read.","type":"text"}],"type":"topic","url":"\/documentation\/trackers\/tracker\/records-swift.property","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier","text":"Tracker"},{"kind":"text","text":"."},{"preciseIdentifier":"s:8Trackers7TrackerV7RecordsV","kind":"typeIdentifier","text":"Records"}]},"doc://Trackers/documentation/Trackers/RejectionReport":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RejectionReport"}],"url":"\/documentation\/trackers\/rejectionreport","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RejectionReport"}],"type":"topic","title":"RejectionReport","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","kind":"symbol","abstract":[{"type":"text","text":"Events a tracker rejected because a property broke a constraint declared on it: the event’s"},{"type":"text","text":" "},{"type":"text","text":"name, the property and the keyword it broke, how many were rejected and when they were tracked."}]},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"url":"\/documentation\/asyncqueues\/asyncqueue","navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","title":"AsyncQueue","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}],"abstract":[{"text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}]},"doc://Trackers/documentation/Trackers/Tracker/rejectionReports":{"url":"\/documentation\/trackers\/tracker\/rejectionreports","title":"rejectionReports","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","text":"AsyncQueue"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:8Trackers15RejectionReportV","kind":"typeIdentifier","text":"RejectionReport"},{"kind":"text","text":">"}],"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","abstract":[{"text":"A report of each event the tracker rejected because a property broke a constraint declared","type":"text"},{"text":" ","type":"text"},{"text":"on it, in the order the rejections happen.","type":"text"}],"type":"topic"}}}