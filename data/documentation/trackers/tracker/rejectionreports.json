{"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"abstract":[{"text":"A report of each event the tracker rejected because a property broke a constraint declared","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"on it, in the order the rejections happen."}],"metadata":{"role":"symbol","title":"rejectionReports","roleHeading":"Instance Property","modules":[{"name":"Trackers"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"RejectionReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers15RejectionReportV"},{"text":">","kind":"text"}],"externalID":"s:8Trackers7TrackerV16rejectionReportsScSyAA15RejectionReportVGvp","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L214"},"symbolKind":"property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectionReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers15RejectionReportV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/RejectionReport","text":"RejectionReport"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s worker checks each event’s "},{"type":"codeVoice","code":"constraintViolation()"},{"type":"text","text":" before anything else, so a"},{"type":"text","text":" "},{"type":"text","text":"rejected event is never enriched, held by a consent, written to a store or delivered. A"},{"type":"text","text":" "},{"type":"text","text":"record a store recovered is checked too, and one rejected is forgotten by the store. In"},{"type":"text","text":" "},{"type":"text","text":"debug builds each rejection is also logged at error level."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read, merged: a rejection joins the waiting report of the same"},{"type":"text","text":" "},{"type":"text","text":"event, property and keyword, adding to its count and widening its timestamps. So the"},{"type":"text","text":" "},{"type":"text","text":"reports waiting unread are at most one per constraint the app declares, however many events"},{"type":"text","text":" "},{"type":"text","text":"break them. Copies of a tracker share one sequence, which has one consumer and ends once the"},{"type":"text","text":" "},{"type":"text","text":"tracker has finished. A "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"type":"text","text":" tracker’s is empty."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/rejectionreports"]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"references":{"doc://Trackers/documentation/Trackers/Tracker/rejectionReports":{"title":"rejectionReports","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"RejectionReport","kind":"typeIdentifier"