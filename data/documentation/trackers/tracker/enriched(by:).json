cher","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV"},{"text":") -> ","kind":"text"},{"text":"Tracker","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV"}],"role":"symbol","url":"\/documentation\/trackers\/tracker\/enriched(by:)","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)"}}}