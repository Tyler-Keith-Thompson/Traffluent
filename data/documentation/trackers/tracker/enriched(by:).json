uns the new enricher after the copy’s, so the newest sets a key last. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"type":"text","text":" tracker’s copy drops every event too."}]}],"kind":"content"}],"references":{"doc://Trackers/documentation/Trackers":{"type":"topic","abstract":[],"title":"Trackers","role":"collection","identifier":"doc:\/\/Trackers\/documentation\/Trackers","kind":"symbol","url":"\/documentation\/trackers"},"doc://Trackers/documentation/Trackers/Tracker":{"url":"\/documentation\/trackers\/tracker","abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"type":"text","text":"."}],"role":"symbol","navigatorTitle":[{"text":"Tracker","kind":"identifier"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","type":"topic","title":"Tracker","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV","text":"Tracker"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV7RecordsV","text":"Records"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","abstract":[{"type":"text","text":"The records of the events this tracker tracks, for a delivery to read."}],"url":"\/documentation\/trackers\/tracker