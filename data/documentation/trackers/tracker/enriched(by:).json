ocal "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":" doesn’t reach, such as"},{"type":"text","text":" "},{"type":"text","text":"a UI framework’s button actions: hand the part of the app a screen owns a tracker enriched"},{"type":"text","text":" "},{"type":"text","text":"with that screen."}]},{"type":"codeListing","code":["let checkout = tracker.enriched(by: Enricher { $0[ScreenKey.self] = \"Checkout\" })","checkout.track(SignedUp(plan: \"pro\"))  \/\/ its record's context[ScreenKey.self] is \"Checkout\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The tracker’s worker runs ","type":"text"},{"type":"codeVoice","code":"enricher"},{"type":"text","text":", never the tracking caller, on the context "},{"type":"codeVoice","code":"track"},{"type":"text","text":" "},{"type":"text","text":"took and before the enrichers the tracker was built with, which see what it set. Enriching"},{"type":"text","text":" "},{"type":"text","text":"a copy again runs the new enricher after the copy’s, so the newest sets a key last. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},{"type":"text","text":" tracker’s copy drops every event too."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/enriched(by:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)"},"kind":"symbol","metadata":{"externalID":"s:8Trackers7TrackerV8enriched2byAcA8EnricherV_tF","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L159","fileName":"Tracker.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enriched","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"tex