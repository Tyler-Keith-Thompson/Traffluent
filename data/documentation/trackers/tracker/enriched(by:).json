er’s copy drops every event too."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/trackers\/tracker\/enriched(by:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/enriched(by:)"},"references":{"doc://Trackers/documentation/Trackers":{"abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/trackers","title":"Trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://Trackers/documentation/Trackers/Tracker":{"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","role":"symbol","navigatorTitle":[{"text":"Tracker","kind":"identifier"}],"kind":"symbol","title":"Tracker","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"url":"\/documentation\/trackers\/tracker","type":"topic"},"doc://Events/documentation/Events/Enricher":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Enricher"}],"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"role":"symbol","type":"topic","title":"Enricher","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Enricher"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","url":"\/documentation\/events\/enricher"},"doc://Trackers/documen