cumentation\/trackers\/tracker\/noop","abstract":[{"type":"text","text":"A tracker that drops every event, logging each one at debug level. Its "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference","isActive":true},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"empty."}]}}}