uns the new enricher after the copy’s, so the newest sets a key last. A"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},{"type":"text","text":" tracker’s copy drops every event too."}]}],"kind":"content"}],"references":{"doc://Trackers/documentation/Trackers/Tracker/noOp":{"url":"\/documentation\/trackers\/tracker\/noop","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","title":"noOp","abstract":[{"type":"text","text":"A tracker that drops every event, logging each one at debug level. Its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"empty."}],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"noOp"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier","text":"Tracker"}],"kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker":{"navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":"."}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"title":"Tracker","url":"\/documentation\/trackers\/tracker"},"doc://Trackers/documentation/Trackers/Tracker/records-swift