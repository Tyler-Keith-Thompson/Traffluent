kers\/Tracker\/samplingDropReports"},{"type":"text","text":" if one leaves it out, then gates the record by its consent,"},{"type":"text","text":" "},{"type":"text","text":"writes it to its store and publishes it to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":". An event tracked after"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()"},{"type":"text","text":" is dropped and logged at debug level. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},{"type":"text","text":" tracker drops the event and"},{"type":"text","text":" "},{"type":"text","text":"logs it at debug level. So does "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current"},{"type":"text","text":" with no tracker bound or bootstrapped, except"},{"type":"text","text":" "},{"type":"text","text":"that the first event it drops at each call site is logged at warning level, so a missing"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" shows up in the logs rather than passing silently. A view whose tracker was"},{"type":"text","text":" "},{"type":"text","text":"never set tracks as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current"},{"type":"text","text":" does with nothing bound, through the tracker bootstrapped by"},{"type":"text","text":" "},{"type":"text","text":"the time it tracks."}],"type":"paragraph"}]}],"references":{"doc://Trackers/documentation/Trackers/Tracker/finish()":{"abstract":[{"type":"text","text":"Ends tracking: waits for the worker to handle every event already tracked, then ends"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentatio