rackers\/Tracker\/samplingDropReports","isActive":true},{"type":"text","text":" if one leaves it out, then gates the record by its consent,"},{"type":"text","text":" "},{"type":"text","text":"writes it to its store and publishes it to "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":". An event tracked after"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","isActive":true},{"type":"text","text":" is dropped and logged at debug level. A "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"type":"text","text":" tracker drops the event and"},{"type":"text","text":" "},{"type":"text","text":"logs it at debug level. So does "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","isActive":true},{"type":"text","text":" with no tracker bound, except that the first"},{"type":"text","text":" "},{"type":"text","text":"event it drops at each call site is logged at warning level, so a missing "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" "},{"type":"text","text":"shows up in the logs rather than passing silently."}]}]}],"references":{"doc://Trackers/documentation/Trackers/Sampler":{"navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"title":"Sampler","abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"type":"topic","role":"symbol","url":"\/documentation\/trackers\/sampler","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"ide