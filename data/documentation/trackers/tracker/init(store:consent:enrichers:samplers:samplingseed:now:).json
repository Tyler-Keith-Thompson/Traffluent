":"symbol","role":"collection","url":"\/documentation\/trackers","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://Persistence/documentation/Persistence/RecordStore":{"navigatorTitle":[{"text":"RecordStore","kind":"identifier"}],"type":"topic","title":"RecordStore","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","role":"symbol","abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/persistence\/recordstore"},"doc://Trackers/documentation/Trackers/Enricher":{"role":"symbol","navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"title":"Enricher","type":"topic","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","abstract":[{"text":"Adds to the context of each event a tracker tracks, before the record is delivered.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Enricher","kind":"identifier"}],"url":"\/documentation\/trackers\/enricher"},"doc://Trackers/documentation/Trackers/Consent":{"url":"\/documentation\/trackers\/consent","type":"topic","title":"Consent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"navigatorTitle":[{"kind":"identifier","text":"Consent"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{