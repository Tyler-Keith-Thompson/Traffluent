{"kind":"symbol","metadata":{"remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L122"},"role":"symbol","externalID":"s:8Trackers7TrackerV5store7consent9enrichers8samplers12samplingSeed3nowACx_AA7ConsentVSgSayAA8EnricherVGSayAA7SamplerVGs6UInt64V20FoundationEssentials4DateVyYbctc11Persistence11RecordStoreRzlufc","roleHeading":"Initializer","modules":[{"name":"Trackers"}],"title":"init(store:consent:enrichers:samplers:samplingSeed:now:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"store","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence11RecordStoreP"},{"text":", ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Consent","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7ConsentV"},{"text":"?, ","kind":"text"},{"text":"enrichers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV"},{"text":"], ","kind":"text"},{"text":"samplers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Sampler","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7SamplerV"},{"text":"], ","kind":"text"},{"text":"samplingSeed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt64","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":")","kind":"text"}],"symbolKind":"init"},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"abstract":[{"type":"text","text":"A tracker that writes every record to "},{"type":"codeVoice","code":"store"},{"type":"text","text":", so records survive the app ending, and"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":" start with the ones "},{"type":"codeVoice","code":"store"},{"type":"text","text":" kept from earlier runs."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)"]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"store","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","text":"RecordStore","preciseIdentifier":"s:11Persistence11RecordStoreP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","text":"Consent","preciseIdentifier":"s:8Trackers7ConsentV","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"enrichers","kind":"externalParam"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","text":"Enricher","preciseIdentifier":"s:8Trackers8EnricherV","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"samplers","kind":"externalParam"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","text":"Sampler","preciseIdentifier":"s:8Trackers7SamplerV","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"samplingSeed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt64","preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier"},{"text":" = .random(in: .min ... .max), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":" = { Date.now })","kind":"text"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Where each record is kept until it is delivered.","type":"text"}]}],"name":"store"},{"content":[{"inlineContent":[{"type":"text","text":"The user’s consent, which each event’s category must have before it is"},{"type":"text","text":" "},{"type":"text","text":"written and delivered; "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", every event delivered, by default."}],"type":"paragraph"}],"name":"consent"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What each event’s context gains, applied in order by the tracker’s worker."}]}],"name":"enrichers"},{"content":[{"inlineContent":[{"type":"text","text":"Which events, or groups of events, to keep a fraction of, decided by the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker after the enrichers and before the store; none by default, so every"},{"type":"text","text":" "},{"type":"text","text":"event is kept."}],"type":"paragraph"}],"name":"samplers"},{"content":[{"inlineContent":[{"text":"The seed the samplers’ decisions come from: fix it and which events are","type":"text"},{"text":" ","type":"text"},{"text":"kept is fixed too. Drawn from the system’s random number generator once, as the tracker","type":"text"},{"text":" ","type":"text"},{"text":"is made, by default. Fix it only in tests and replays: every launch with the same seed","type":"text"},{"text":" ","type":"text"},{"text":"makes the same decision for its first matching event, its second and so on, so a","type":"text"},{"text":" ","type":"text"},{"text":"fixed seed shipped to every device keeps the same events everywhere rather than the","type":"text"},{"text":" ","type":"text"},{"text":"sampler’s rate of them.","type":"text"}],"type":"paragraph"}],"name":"samplingSeed"},{"content":[{"inlineContent":[{"type":"text","text":"The wall-clock time each event is stamped with when it is tracked. It runs on the"},{"type":"text","text":" "},{"type":"text","text":"tracking caller’s thread, so keep it fast."}],"type":"paragraph"}],"name":"now"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The tracker’s worker writes each record as it reaches it, before publishing it to"},{"type":"text","text":" "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"type":"text","text":", rather than a stage reading "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"type":"text","text":", which runs in the delivery’s task,"},{"type":"text","text":" "},{"type":"text","text":"later, perhaps after a slow batch. Given "},{"type":"codeVoice","code":"consent"},{"type":"text","text":", a record is written once its category"},{"type":"text","text":" "},{"type":"text","text":"is granted, not while it is held, and the recovered records are gated again. The worker"},{"type":"text","text":" "},{"type":"text","text":"takes the recovered records from "},{"type":"codeVoice","code":"store"},{"type":"text","text":" before anything tracked."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"samplers"},{"type":"text","text":", a record they drop is never written. A record the store recovered was"},{"type":"text","text":" "},{"type":"text","text":"sampled in the run that wrote it, so it isn’t sampled again."}],"type":"paragraph"}]}],"references":{"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"kind":"symbol","type":"topic","title":"records","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Records","preciseIdentifier":"s:8Trackers7TrackerV7RecordsV"}],"url":"\/documentation\/trackers\/tracker\/records-swift.property","role":"symbol","abstract":[{"text":"The records of the events this tracker tracks, for a delivery to read.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},"doc://Trackers/documentation/Trackers/Tracker/init(store:consent:enrichers:samplers:samplingSeed:now:)":{"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Persistence11RecordStoreP","text":"RecordStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7ConsentV","text":"Consent"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"samplers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7SamplerV","text":"Sampler"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V","text":"UInt64"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":")"}],"title":"init(store:consent:enrichers:samplers:samplingSeed:now:)","url":"\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","abstract":[{"type":"text","text":"A tracker that writes every record to "},{"code":"store","type":"codeVoice"},{"type":"text","text":", so records survive the app ending, and"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"type":"text","text":" start with the ones "},{"code":"store","type":"codeVoice"},{"type":"text","text":" kept from earlier runs."}]},"doc://Trackers/documentation/Trackers/Sampler":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","title":"Sampler","abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"url":"\/documentation\/trackers\/sampler","type":"topic","kind":"symbol"},"doc://Persistence/documentation/Persistence/RecordStore":{"kind":"symbol","navigatorTitle":[{"text":"Record