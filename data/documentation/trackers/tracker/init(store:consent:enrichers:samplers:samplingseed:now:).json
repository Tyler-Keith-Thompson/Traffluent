ments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"title":"Sampler","url":"\/documentation\/trackers\/sampler","abstract":[{"text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written","type":"text"},{"text":" ","type":"text"},{"text":"or delivered: event by event, or a whole group of events, such as a session, at once.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"}}}