Voice","code":"store"},{"type":"text","text":" kept from earlier runs."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)"]}],"references":{"doc://Trackers/documentation/Trackers/Consent":{"title":"Consent","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Consent"}],"url":"\/documentation\/trackers\/consent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker":{"navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"type":"topic","kind":"symbol","url":"\/documentation\/trackers\/tracker","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":"."}],"role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","title":"Tracker"},"doc://Trackers/documentation/Trackers/Sampler":{"url":"\/documentation\/trackers\/sampler","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"type":"topic","title":"Sampler","abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or 