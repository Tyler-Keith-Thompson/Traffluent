{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Initializer","symbolKind":"init","externalID":"s:8Trackers7TrackerV5store7consent9enrichers8samplers12samplingSeed3nowACx_AA7ConsentVSgSayAA8EnricherVGSayAA7SamplerVGs6UInt64V20FoundationEssentials4DateVyYbctc11Persistence11RecordStoreRzlufc","role":"symbol","title":"init(store:consent:enrichers:samplers:samplingSeed:now:)","modules":[{"name":"Trackers"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11Persistence11RecordStoreP","kind":"typeIdentifier","text":"RecordStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers7ConsentV","kind":"typeIdentifier","text":"Consent"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8Trackers8EnricherV","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"samplers"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8Trackers7SamplerV","kind":"typeIdentifier","text":"Sampler"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier","text":"UInt64"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":")"}],"remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L122"}},"abstract":[{"type":"text","text":"A tracker that writes every record to "},{"type":"codeVoice","code":"store"},{"type":"text","text":", so records survive the app ending, and"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" start with the ones "},{"type":"codeVoice","code":"store"},{"type":"text","text":" kept from earlier runs."}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"},"sections":[],"variants":[{"paths":["\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence11RecordStoreP","text":"RecordStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7ConsentV","text":"Consent"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplers"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7SamplerV","text":"Sampler"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier","text":"UInt64"},{"kind":"text","text":" = .random(in: .min ... .max), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":" = { Date.now })"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"store","content":[{"inlineContent":[{"text":"Where each record is kept until it is delivered.","type":"text"}],"type":"paragraph"}]},{"name":"consent","content":[{"type":"paragraph","inlineContent":[{"text":"The user’s consent, which each event’s category must have before it is","type":"text"},{"text":" ","type":"text"},{"text":"written and delivered; ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", every event delivered, by default.","type":"text"}]}]},{"name":"enrichers","content":[{"type":"paragraph","inlineContent":[{"text":"What each event’s context gains, applied in order by the tracker’s worker.","type":"text"}]}]},{"name":"samplers","content":[{"type":"paragraph","inlineContent":[{"text":"Which events, or groups of events, to keep a fraction of, decided by the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s worker after the enrichers and before the store; none by default, so every","type":"text"},{"text":" ","type":"text"},{"text":"event is kept.","type":"text"}]}]},{"name":"samplingSeed","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The seed the samplers’ decisions come from: fix it and which events are"},{"type":"text","text":" "},{"type":"text","text":"kept is fixed too. Drawn from the system’s random number generator once, as the tracker"},{"type":"text","text":" "},{"type":"text","text":"is made, by default. Fix it only in tests and replays: every launch with the same seed"},{"type":"text","text":" "},{"type":"text","text":"makes the same decision for its first matching event, its second and so on, so a"},{"type":"text","text":" "},{"type":"text","text":"fixed seed shipped to every device keeps the same events everywhere rather than the"},{"type":"text","text":" "},{"type":"text","text":"sampler’s rate of them."}]}]},{"name":"now","content":[{"inlineContent":[{"type":"text","text":"The wall-clock time each event is stamped with when it is tracked. It runs on the"},{"type":"text","text":" "},{"type":"text","text":"tracking caller’s thread, so keep it fast."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The tracker’s worker writes each record as it reaches it, before publishing it to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":", rather than a stage reading "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":", which runs in the delivery’s task,"},{"type":"text","text":" "},{"type":"text","text":"later, perhaps after a slow batch. Given "},{"type":"codeVoice","code":"consent"},{"type":"text","text":", a record is written once its category"},{"type":"text","text":" "},{"type":"text","text":"is granted, not while it is held, and the recovered records are gated again. The worker"},{"type":"text","text":" "},{"type":"text","text":"takes the recovered records from "},{"type":"codeVoice","code":"store"},{"type":"text","text":" before anything tracked."}],"type":"paragraph"},{"inlineContent":[{"text":"Given ","type":"text"},{"code":"samplers","type":"codeVoice"},{"text":", a record they drop is never written. A record the store recovered was","type":"text"},{"text":" ","type":"text"},{"text":"sampled in the run that wrote it, so it isn’t sampled again.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://Trackers/documentation/Trackers/Sampler":{"navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"type":"topic","url":"\/documentation\/trackers\/sampler","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"title":"Sampler","abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},"doc://Persistence/documentation/Persistence/RecordStore":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","role":"symbol","type":"topic","url":"\/documentation\/persistence\/recordstore","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RecordStore"}],"navigatorTitle":[{"kind":"identifier","text":"RecordStore"}],"title":"RecordStore","kind":"symbol","abstract":[{"text":"Where a tracker keeps each record until it is delivered, so records survive the app ending.","type":"text"}]},"doc://Trackers/documentation/Trackers":{"title":"Trackers","abstract":[],"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","role":"collection","url":"\/documentation\/trackers","kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker":{"url":"\/documentation\/trackers\/tracker","role":"symbol","title":"Tracker","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"kind":"symbol"},"doc://Trackers/documentation/Trackers/Consent":{"navigatorTitle":[{"text":"Consent","kind":"identifier"}],"type":"topic","url":"\/documentation\/trackers\/consent","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"title":"Consent","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},"doc://Trackers/documentation/Trackers/Enricher":{"role":"symbol","navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Enricher","kind":"identifier"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","url":"\/documentation\/trackers\/enricher","title":"Enricher","type":"topic","abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"abstract":[{"text":"The records of the events this tracker tracks, for a delivery to read.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","title":"records","url":"\/documentation\/trackers\/tracker\/records-swift.property","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","fragments":[{"text":"var","kind":"keyword"},{"te