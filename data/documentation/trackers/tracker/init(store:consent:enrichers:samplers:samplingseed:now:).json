"name":"Trackers"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)"]}],"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"A tracker that writes every record to "},{"type":"codeVoice","code":"store"},{"type":"text","text":", so records survive the app ending, and"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" start with the ones "},{"type":"codeVoice","code":"store"},{"type":"text","text":" kept from earlier runs."}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","preciseIdentifier":"s:11Persistence11RecordStoreP","kind":"typeIdentifier","text":"RecordStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","preciseIdentifier":"s:8Trackers7ConsentV","kind":"typeIdentifier","text":"Consent"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","preciseIdentifier":"s:6Events8EnricherV","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplers"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","preciseIdentifier":"s:8Trackers7SamplerV","kind":"typeIdentifier","text":"Sampler"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier","text":"UInt64"},{"kind":"text","text":" = .random(in: .min ... .max), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":" = { Date.now })"}],"languages":["swift"]}]},{"parameters":[{"name":"store","content":[{"inlineContent":[{"type":"text","text":"Where each record is kept until it is delivered."}],"type":"paragraph"}]},{"name":"consent","content":[{"type":"paragraph","inlineContent":[{"text":"The user’s consent, which each event’s category must have before it is","type":"text"},{"text":" ","type":"text"},{"text":"written and delivered; ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", every event delivered, by default.","type":"text"}]}]},{"name":"enrichers","content":[{"type":"paragraph","inlineContent":[{"text":"What each event’s context gains, applied in order by the tracker’s worker.","type":"text"}]}]},{"name":"samplers","content":[{"type":"paragraph","inlineContent":[{"text":"Which events, or groups of events, to keep a fraction of, decided by the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s worker after the enrichers and before the store; none by default, so every","type":"text"},{"text":" ","type":"text"},{"text":"event is kept.","type":"text"}]}]},{"name":"samplingSeed","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The seed the samplers’ decisions come from: fix it and which events are"},{"type":"text","text":" "},{"type":"text","text":"kept is fixed too. Drawn from the system’s random number generator once, as the tracker"},{"type":"text","text":" "},{"type":"text","text":"is made, by default. Fix it only in tests and replays: every launch with the same seed"},{"type":"text","text":" "},{"type":"text","text":"makes the same decision for its first matching event, its second and so on, so a"},{"type":"text","text":" "},{"type":"text","text":"fixed seed shipped to every device keeps the same events everywhere rather than the"},{"type":"text","text":" "},{"type":"text","text":"sampler’s rate of them."}]}]},{"name":"now","content":[{"inlineContent":[{"type":"text","text":"The wall-clock time each event is stamped with when it is tracked. It runs on the"},{"type":"text","text":" "},{"type":"text","text":"tracking caller’s thread, so keep it fast."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The tracker’s worker writes each record as it reaches it, before publishing it to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference"},{"text":", rather than a stage reading ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference"},{"text":", which runs in the delivery’s task,","type":"text"},{"text":" ","type":"text"},{"text":"later, perhaps after a slow batch. Given ","type":"text"},{"code":"consent","type":"codeVoice"},{"text":", a record is written once its category","type":"text"},{"text":" ","type":"text"},{"text":"is granted, not while it is held, and the recovered records are gated again. The worker","type":"text"},{"text":" ","type":"text"},{"text":"takes the recovered records from ","type":"text"},{"code":"store","type":"codeVoice"},{"text":" before anything tracked.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Given ","type":"text"},{"type":"codeVoice","code":"samplers"},{"text":", a record they drop is never written. A record the store recovered was","type":"text"},{"text":" ","type":"text"},{"text":"sampled in the run that wrote it, so it isn’t sampled again.","type":"text"}]}]}],"references":{"doc://Persistence/documentation/Persistence/RecordStore":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","url":"\/documentation\/persistence\/recordstore","abstract":[{"text":"Where a tracker keeps each record until it is delivered, so records survive the app ending.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"title":"RecordStore","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"RecordStore","kind":"identifier"}]},"doc://Events/documentation/Events/Enricher":{"kind":"symbol","title":"Enricher","role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","abstract":[{"text":"Adds to the context of each event a tracker tracks, before the record is delivered.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Enricher","kind":"identifier"}],"navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"url":"\/documentation\/events\/enricher"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8Trackers7TrackerV","text":"Tracker","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:8Trackers7TrackerV7RecordsV","text":"Records","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The records of the events this tracker tracks, for a delivery to read."}],"kind":"symbol","title":"records","url":"\/documentation\/trackers\/tracker\/records-swift.property","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},"doc://Trackers/documentation/Trackers/Consent":{"role":"symbol","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"kind":"symbol","url":"\/documentation\/trackers\/consent","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"navigatorTitle":[{"text":"Consent","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","title":"Consent"},"doc://Trackers/documentation/Trackers/Sampler":{"navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","role":"symbol","url":"\/documentation\/trackers\/sampler","kind":"symbol","abstract":[{"text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written","type":"text"},{"text":" ","type":"text"},{"text":"or delivered: event by event, or a whole group of events, such as a session, at once.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"title":"Sampler"},"doc://Trackers/documentation/Trackers/Tracker":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","url":"\/documentation\/trackers\/tracker","navigatorTitle":[{"text":"Tracker","kind":"identifier"}],"title":"Tracker","type":"topic","abstract":[{"text":"What app code tracks events with: it records each event, with the time, the caller’s source","type":"text"},{"text":" ","type":"text"},{"text":"location and the task’s context, as one of its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":".","type":"text"}],"role":"symbol"},"doc://Trackers/documentation/Trackers/Tracker/init(store:consent:enrichers:samplers:samplingSeed:now:)":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","url":"\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)","abstract":[{"type":"text","text":"A tracker that writes every record to "},{"type":"codeVoice","code":"store"},{"type":"text","text":", so records survive the app ending, and"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" start with the ones "},{"type":"codeVoice","code":"store"},{"type":"text","text":" kept from earlier runs."}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"store","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11Persistence11RecordStoreP","text":"RecordStore","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8Trackers7ConsentV","text":"Consent","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"enrichers","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Events8EnricherV","text":"Enricher","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"samplers","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:8Trackers7SamplerV","text":"Sampler","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"samplingSeed","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s6UInt64V","text":"UInt64","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"now","kind":"externalP