{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11Persistence11RecordStoreP","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","kind":"typeIdentifier","text":"RecordStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers7ConsentV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","kind":"typeIdentifier","text":"Consent"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8Trackers8EnricherV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplers"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8Trackers7SamplerV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","kind":"typeIdentifier","text":"Sampler"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier","text":"UInt64"},{"kind":"text","text":" = .random(in: .min ... .max), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":" = { Date.now })"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where each record is kept until it is delivered."}]}],"name":"store"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user’s consent, which each event’s category must have before it is"},{"type":"text","text":" "},{"type":"text","text":"written and delivered; "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", every event delivered, by default."}]}],"name":"consent"},{"content":[{"type":"paragraph","inlineContent":[{"text":"What each event’s context gains, applied in order by the tracker’s worker.","type":"text"}]}],"name":"enrichers"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Which events, or groups of events, to keep a fraction of, decided by the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s worker after the enrichers and before the store; none by default, so every","type":"text"},{"text":" ","type":"text"},{"text":"event is kept.","type":"text"}]}],"name":"samplers"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The seed the samplers’ decisions come from: fix it and which events are"},{"type":"text","text":" "},{"type":"text","text":"kept is fixed too. Drawn from the system’s random number generator once, as the tracker"},{"type":"text","text":" "},{"type":"text","text":"is made, by default. Fix it only in tests and replays: every launch with the same seed"},{"type":"text","text":" "},{"type":"text","text":"makes the same decision for its first matching event, its second and so on, so a"},{"type":"text","text":" "},{"type":"text","text":"fixed seed shipped to every device keeps the same events everywhere rather than the"},{"type":"text","text":" "},{"type":"text","text":"sampler’s rate of them."}]}],"name":"samplingSeed"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time each event is stamped with when it is tracked. It runs on the"},{"type":"text","text":" "},{"type":"text","text":"tracking caller’s thread, so keep it fast."}]}],"name":"now"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"The tracker’s worker writes each record as it reaches it, before publishing it to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":", rather than a stage reading ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":", which runs in the delivery’s task,","type":"text"},{"text":" ","type":"text"},{"text":"later, perhaps after a slow batch. Given ","type":"text"},{"type":"codeVoice","code":"consent"},{"text":", a record is written once its category","type":"text"},{"text":" ","type":"text"},{"text":"is granted, not while it is held, and the recovered records are gated again. The worker","type":"text"},{"text":" ","type":"text"},{"text":"takes the recovered records from ","type":"text"},{"type":"codeVoice","code":"store"},{"text":" before anything tracked.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Given ","type":"text"},{"code":"samplers","type":"codeVoice"},{"text":", a record they drop is never written. A record the store recovered was","type":"text"},{"text":" ","type":"text"},{"text":"sampled in the run that wrote it, so it isn’t sampled again.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)"]}],"metadata":{"role":"symbol","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L122"},"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":