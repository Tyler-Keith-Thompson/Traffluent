erty","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"topic","role":"symbol","url":"\/documentation\/trackers\/tracker","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}]},"doc://Trackers/documentation/Trackers":{"kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"url":"\/documentation\/trackers"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8Trackers7TrackerV","text":"Tracker","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:8Trackers7TrackerV7RecordsV","text":"Records","kind":"typeIdentifier"}],"role":"symbol","title":"records","abstract":[{"type":"text","text":"The records of the events this tracker tracks, for a delivery to read."}],"kind":"symbol","url":"\/documentation\/trackers\/tracker\/records-swift.property","type":"topic"},"doc://Events/documentation/Events/Enricher":{"navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Enricher","kind":"identifier"}],"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"title":"Enricher","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","url":"\/documentation\/events\/enricher"},"doc://Trackers/documentation/Trackers/Sampler":{"navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"title":"Sampler","abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"type":"topic","role":"symbol","url":"\/documentation\/trackers\/sampler","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}]}}}