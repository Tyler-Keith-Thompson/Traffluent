":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference","isActive":true},{"type":"text","text":" start with the ones "},{"code":"store","type":"codeVoice"},{"type":"text","text":" kept from earlier runs."}],"references":{"doc://Trackers/documentation/Trackers/Consent":{"abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","role":"symbol","kind":"symbol","title":"Consent","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"navigatorTitle":[{"kind":"identifier","text":"Consent"}],"url":"\/documentation\/trackers\/consent"},"doc://Trackers/documentation/Trackers/Tracker":{"kind":"symbol","title":"Tracker","type":"topic","url":"\/documentation\/trackers\/tracker","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}]},"doc://Trackers/documentation/Trackers/Enricher":{"url":"\/documentation\/trackers\/enricher","role":"symbol","type":"topic","title":"Enricher","navigatorTitle":[{"kind":"identifier","text":"Enricher"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"kind":"symbol","fragments":[{"kind":"