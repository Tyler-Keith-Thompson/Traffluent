text":"UInt64","preciseIdentifier":"s:s6UInt64V"},{"kind":"text","text":" = .random(in: .min ... .max), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":" = { Date.now })"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"text":"Where each record is kept until it is delivered.","type":"text"}]}]},{"name":"consent","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user’s consent, which each event’s category must have before it is"},{"type":"text","text":" "},{"type":"text","text":"written and delivered; "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", every event delivered, by default."}]}]},{"name":"enrichers","content":[{"inlineContent":[{"type":"text","text":"What each event’s context gains, applied in order by the tracker’s worker."}],"type":"paragraph"}]},{"name":"samplers","content":[{"inlineContent":[{"type":"text","text":"Which events, or groups of events, to keep a fraction of, decided by the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker after the enrichers and before the store; none by default, so every"},{"type":"text","text":" "},{"type":"text","text":"event is kept."}],"type":"paragraph"}]},{"name":"samplingSeed","content":[{"inlineContent":[{"text":"The seed the samplers’ decisions come from: fix it and which events are","type":"text"},{"text":" ","type":"text"},{"text":"kept is fixed too. Drawn from the system’s random number generator once, as the tracker","type":"text"},{"text":" ","type":"text"},{"text":"is made, by default. Fix it only in tests and replays: every launch with the same seed","type":"text"},{"text":" ","type":"text"},{"text":"makes the same decision for its first matching event, its second and so on, so a","type":"text"},{"text":" ","type":"text"},{"text":"fixed seed shipped to every device keeps the same events everywhere rather than the","type":"text"},{"text":" ","type":"text"},{"text":"sampler’s rate of them.","type":"text"}],"type":"paragraph"}]},{"name":"now","content":[{"inlineContent":[{"text":"The wall-clock time each event is stamped with when it is tracked. It runs on the","type":"text"},{"text":" ","type":"text"},{"text":"tracking caller’s thread, so keep it fast.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The tracker’s worker writes each record as it reaches it, before publishing it to"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":", rather than a stage reading "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":", which runs in the delivery’s task,"},{"type":"text","text":" "},{"type":"text","text":"later, perhaps after a slow batch. Given "},{"type":"codeVoice","code":"consent"},{"type":"text","text":", a record is written once its category"},{"type":"text","text":" "},{"type":"text","text":"is granted, not while it is held, and the recovered records are gated again. The worker"},{"type":"text","text":" "},{"type":"text","text":"takes the recovered records from "},{"type":"codeVoice","code":"store"},{"type":"text","text":" before anything tracked."}],"type":"paragraph"},{"inlineContent":[{"text":"Given ","type":"text"},{"type":"codeVoice","code":"samplers"},{"text":", a record they drop is never written. A record the store recovered was","type":"text"},{"text":" ","type":"text"},{"text":"sampled in the run that wrote it, so it isn’t sampled again.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)"]}],"references":{"doc://Trackers/documentation/Trackers/Sampler":{"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","url":"\/documentation\/trackers\/sampler","title":"Sampler","navigatorTitle":[{"text":"Sampler","kind":"identifier"}]},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Records","preciseIdentifier":"s:8Trackers7TrackerV7RecordsV"}],"url":"\/documentation\/trackers\/tracker\/records-swift.property","type":"topic","title":"records","abstract":[{"text":"The records of the events this tracker tracks, for a delivery to read.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},"doc://Trackers/documentation/Trackers/Consent":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Consent","kind":"identifier"}],"url":"\/documentation\/trackers\/consent","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies 