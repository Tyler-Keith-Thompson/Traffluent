e","type":"codeVoice"},{"text":" kept from earlier runs.","type":"text"}],"variants":[{"paths":["\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Trackers/documentation/Trackers/Sampler":{"kind":"symbol","title":"Sampler","role":"symbol","url":"\/documentation\/trackers\/sampler","abstract":[{"text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written","type":"text"},{"text":" ","type":"text"},{"text":"or delivered: event by event, or a whole group of events, such as a session, at once.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Sampler"}]},"doc://Trackers/documentation/Trackers/Tracker":{"navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","title":"Tracker","type":"topic","role":"symbol","url":"\/documentation\/trackers\/tracker"},"doc://Trackers/documentation/Trackers/Enricher":{"navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":"