{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"init","role":"symbol","title":"init(store:consent:enrichers:samplers:samplingSeed:now:)","modules":[{"name":"Trackers"}],"externalID":"s:8Trackers7TrackerV5store7consent9enrichers8samplers12samplingSeed3nowACx_AA7ConsentVSgSayAA8EnricherVGSayAA7SamplerVGs6UInt64V20FoundationEssentials4DateVyYbctc11Persistence11RecordStoreRzlufc","roleHeading":"Initializer","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11Persistence11RecordStoreP","kind":"typeIdentifier","text":"RecordStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers7ConsentV","kind":"typeIdentifier","text":"Consent"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8Trackers8EnricherV","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"samplers"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8Trackers7SamplerV","kind":"typeIdentifier","text":"Sampler"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier","text":"UInt64"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":")"}],"remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L122"}},"abstract":[{"type":"text","text":"A tracker that writes every record to "},{"type":"codeVoice","code":"store"},{"type":"text","text":", so records survive the app ending, and"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" start with the ones "},{"type":"codeVoice","code":"store"},{"type":"text","text":" kept from earlier runs."}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11Persistence11RecordStoreP","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","kind":"typeIdentifier","text":"RecordStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers7ConsentV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","kind":"typeIdentifier","text":"Consent"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8Trackers8EnricherV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplers"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:8Trackers7SamplerV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","kind":"typeIdentifier","text":"Sampler"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier","text":"UInt64"},{"kind":"text","text":" = .random(in: .min ... .max), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":" = { Date.now })"}],"languages":["swift"],"platforms":["Linux"]}]},{"parameters":[{"name":"store","content":[{"inlineContent":[{"type":"text","text":"Where each record is kept until it is delivered."}],"type":"paragraph"}]},{"name":"consent","content":[{"type":"paragraph","inlineContent":[{"text":"The user’s consent, which each event’s category must have before it is","type":"text"},{"text":" ","type":"text"},{"text":"written and delivered; ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", every event delivered, by default.","type":"text"}]}]},{"name":"enrichers","content":[{"inlineContent":[{"type":"text","text":"What each event’s context gains, applied in order by the tracker’s worker."}],"type":"paragraph"}]},{"name":"samplers","content":[{"inlineContent":[{"type":"text","text":"Which events, or groups of events, to keep a fraction of, decided by the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker after the enrichers and before the store; none by default, so every"},{"type":"text","text":" "},{"type":"text","text":"event is kept."}],"type":"paragraph"}]},{"name":"samplingSeed","content":[{"inlineContent":[{"type":"text","text":"The seed the samplers’ decisions come from: fix it and which events are"},{"type":"text","text":" "},{"type":"text","text":"kept is fixed too. Drawn from the system’s random number generator once, as the tracker"},{"type":"text","text":" "},{"type":"text","text":"is made, by default. Fix it only in tests and replays: every launch with the same seed"},{"type":"text","text":" "},{"type":"text","text":"makes the same decision for its first matching event, its second and so on, so a"},{"type":"text","text":" "},{"type":"text","text":"fixed seed shipped to every device keeps the same events everywhere rather than the"},{"type":"text","text":" "},{"type":"text","text":"sampler’s rate of them."}],"type":"paragraph"}]},{"name":"now","content":[{"inlineContent":[{"text":"The wall-clock time each event is stamped with when it is tracked. It runs on the","type":"text"},{"text":" ","type":"text"},{"text":"tracking caller’s thread, so keep it fast.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s worker writes each record as it reaches it, before publishing it to"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":", rather than a stage reading "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":", which runs in the delivery’s task,"},{"type":"text","text":" "},{"type":"text","text":"later, perhaps after a slow batch. Given "},{"type":"codeVoice","code":"consent"},{"type":"text","text":", a record is written once its category"},{"type":"text","text":" "},{"type":"text","text":"is granted, not while it is held, and the recovered records are gated again. The worker"},{"type":"text","text":" "},{"type":"text","text":"takes the recovered records from "},{"type":"codeVoice","code":"store"},{"type":"text","text":" before anything tracked."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"samplers"},{"type":"text","text":", a record they drop is never written. A record the store recovered was"},{"type":"text","text":" "},{"type":"text","text":"sampled in the run that wrote it, so it isn’t sampled again."}]}]}],"references":{"doc://Trackers/documentation/Trackers/Sampler":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"abstract":[{"text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written","type":"text"},{"text":" ","type":"text"},{"text":"or delivered: event by event, or a whole group of events, such as a session, at once.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"topic","title":"Sampler","url":"\/documentation\/trackers\/sampler"},"doc://Persistence/documentation/Persistence/RecordStore":{"title":"RecordStore","abstract":[{"text":"Where a tracker keeps each record until it is delivered, so records survive the app ending.","type":"text"}],"navigatorTitle":[{"text":"RecordStore","kind":"identifier"}],"url":"\/documentation\/persistence\/recordstore","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","type":"topic"},"doc://Trackers/documentation/Trackers":{"kind":"symbol","role":"collection","abstract":[],"identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers","type":"topic","url":"\/documentation\/trackers"},"doc://Trackers/documentation/Trackers/Tracker":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/trackers\/tracker","kind":"symbol","title":"Tracker","type":"topic","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","navigatorTitle":[{"text":"Tracker","kind":"identifier"}]},"doc://Trackers/documentation/Trackers/Consent":{"title":"Consent","kind":"symbol","role":"symbol","url":"\/documentation\/trackers\/consent","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","abstract":[{"text":"The user’s consent, category by category, which a tracker given it applies to every event.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Consent"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}]},"doc://Trackers/documentation/Trackers/Tracker/init(store:consent:enrichers:samplers:samplingSeed:now:)":{"type":"topic","url":"\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Persistence11RecordStoreP","text":"RecordStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7ConsentV","text":"Consent"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"samplers"},{"kind