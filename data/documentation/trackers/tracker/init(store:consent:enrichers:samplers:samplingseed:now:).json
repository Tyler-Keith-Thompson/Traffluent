{"sections":[],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"A tracker that writes every record to ","type":"text"},{"code":"store","type":"codeVoice"},{"text":", so records survive the app ending, and","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"text":" start with the ones ","type":"text"},{"code":"store","type":"codeVoice"},{"text":" kept from earlier runs.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Persistence11RecordStoreP","text":"RecordStore","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7ConsentV","text":"Consent","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7SamplerV","text":"Sampler","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V","text":"UInt64"},{"kind":"text","text":" = .random(in: .min ... .max), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":" = { Date.now })"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where each record is kept until it is delivered."}]}]},{"name":"consent","content":[{"inlineContent":[{"type":"text","text":"The user’s consent, which each event’s category must have before it is"},{"type":"text","text":" "},{"type":"text","text":"written and delivered; "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", every event delivered, by default."}],"type":"paragraph"}]},{"name":"enrichers","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What each event’s context gains, applied in order by the tracker’s worker."}]}]},{"name":"samplers","content":[{"inlineContent":[{"text":"Which events, or groups of events, to keep a fraction of, decided by the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s worker after the enrichers and before the store; none by default, so every","type":"text"},{"text":" ","type":"text"},{"text":"event is kept.","type":"text"}],"type":"paragraph"}]},{"name":"samplingSeed","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The seed the samplers’ decisions come from: fix it and which events are"},{"type":"text","text":" "},{"type":"text","text":"kept is fixed too. Drawn from the system’s random number generator once, as the tracker"},{"type":"text","text":" "},{"type":"text","text":"is made, by default. Fix it only in tests and replays: every launch with the same seed"},{"type":"text","text":" "},{"type":"text","text":"makes the same decision for its first matching event, its second and so on, so a"},{"type":"text","text":" "},{"type":"text","text":"fixed seed shipped to every device keeps the same events everywhere rather than the"},{"type":"text","text":" "},{"type":"text","text":"sampler’s rate of them."}]}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time each event is stamped with when it is tracked. It runs on the"},{"type":"text","text":" "},{"type":"text","text":"tracking caller’s thread, so keep it fast."}]}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The tracker’s worker writes each record as it reaches it, before publishing it to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":", rather than a stage reading "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":", which runs in the delivery’s task,"},{"type":"text","text":" "},{"type":"text","text":"later, perhaps after a slow batch. Given "},{"type":"codeVoice","code":"consent"},{"type":"text","text":", a record is written once its category"},{"type":"text","text":" "},{"type":"text","text":"is granted, not while it is held, and the recovered records are gated again. The worker"},{"type":"text","text":" "},{"type":"text","text":"takes the recovered records from "},{"type":"codeVoice","code":"store"},{"type":"text","text":" before anything tracked."}],"type":"paragraph"},{"inlineContent":[{"text":"Given ","type":"text"},{"code":"samplers","type":"codeVoice"},{"text":", a record they drop is never written. A record the store recovered was","type":"text"},{"text":" ","type":"text"},{"text":"sampled in the run that wrote it, so it isn’t sampled again.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)"]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"metadata":{"title":"init(store:consent:enrichers:samplers:samplingSeed:now:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"store","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","preciseIdentifier":"s:11Persistence11RecordStoreP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Consent","preciseIdentifier":"s:8Trackers7ConsentV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"enrichers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Enricher","preciseIdentifier":"s:8Trackers8EnricherV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"samplers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Sampler","preciseIdentifier":"s:8Trackers7SamplerV","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"samplingSeed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt64","preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L122","fileName":"Tracker.swift"},"symbolKind":"init","role":"symbol","externalID":"s:8Track