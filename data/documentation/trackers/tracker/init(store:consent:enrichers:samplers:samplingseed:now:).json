{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","preciseIdentifier":"s:11Persistence11RecordStoreP","kind":"typeIdentifier","text":"RecordStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","preciseIdentifier":"s:8Trackers7ConsentV","kind":"typeIdentifier","text":"Consent"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","preciseIdentifier":"s:8Trackers8EnricherV","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplers"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","preciseIdentifier":"s:8Trackers7SamplerV","kind":"typeIdentifier","text":"Sampler"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier","text":"UInt64"},{"kind":"text","text":" = .random(in: .min ... .max), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":" = { Date.now })"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"store","content":[{"inlineContent":[{"text":"Where each record is kept until it is delivered.","type":"text"}],"type":"paragraph"}]},{"name":"consent","content":[{"inlineContent":[{"type":"text","text":"The user’s consent, which each event’s category must have before it is"},{"type":"text","text":" "},{"type":"text","text":"written and delivered; "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", every event delivered, by default."}],"type":"paragraph"}]},{"name":"enrichers","content":[{"inlineContent":[{"type":"text","text":"What each event’s context gains, applied in order by the tracker’s worker."}],"type":"paragraph"}]},{"name":"samplers","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which events, or groups of events, to keep a fraction of, decided by the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker after the enrichers and before the store; none by default, so every"},{"type":"text","text":" "},{"type":"text","text":"event is kept."}]}]},{"name":"samplingSeed","content":[{"inlineContent":[{"text":"The seed the samplers’ decisions come from: fix it and which events are","type":"text"},{"text":" ","type":"text"},{"text":"kept is fixed too. Drawn from the system’s random number generator once, as the tracker","type":"text"},{"text":" ","type":"text"},{"text":"is made, by default. Fix it only in tests and replays: every launch with the same seed","type":"text"},{"text":" ","type":"text"},{"text":"makes the same decision for its first matching event, its second and so on, so a","type":"text"},{"text":" ","type":"text"},{"text":"fixed seed shipped to every device keeps the same events everywhere rather than the","type":"text"},{"text":" ","type":"text"},{"text":"sampler’s rate of them.","type":"text"}],"type":"paragraph"}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"text":"The wall-clock time each event is stamped with when it is tracked. It runs on the","type":"text"},{"text":" ","type":"text"},{"text":"tracking caller’s thread, so keep it fast.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"The tracker’s worker writes each record as it reaches it, before publishing it to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":", rather than a stage reading ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":", which runs in the delivery’s task,","type":"text"},{"text":" ","type":"text"},{"text":"later, perhaps after a slow batch. Given ","type":"text"},{"code":"consent","type":"codeVoice"},{"text":", a record is written once its category","type":"text"},{"text":" ","type":"text"},{"text":"is granted, not while it is held, and the recovered records are gated again. The worker","type":"text"},{"text":" ","type":"text"},{"text":"takes the recovered records from ","type":"text"},{"code":"store","type":"codeVoice"},{"text":" before anything tracked.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"samplers"},{"type":"text","text":", a record they drop is never written. A record the store recovered was"},{"type":"text","text":" "},{"type":"text","text":"sampled in the run that wrote it, so it isn’t sampled again."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","variants":[{"paths":["\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"metadata":{"role":"symbol","externalID":"s:8Trackers7Trac