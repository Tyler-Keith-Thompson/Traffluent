rs\/Tracker.swift#L122"},"role":"symbol","title":"init(store:consent:enrichers:samplers:samplingSeed:now:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"store","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"typeIdentifier","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","preciseIdentifier":"s:11Persistence11RecordStoreP"},{"text":", ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Consent","kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","preciseIdentifier":"s:8Trackers7ConsentV"},{"text":"? = nil, ","kind":"text"},{"text":"enrichers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","preciseIdentifier":"s:8Trackers8EnricherV"},{"text":"] = [], ","kind":"text"},{"text":"samplers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Sampler","kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","preciseIdentifier":"s:8Trackers7SamplerV"},{"text":"] = [], ","kind":"text"},{"text":"samplingSeed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt64","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V"},{"text":" = .random(in: .min ... .max), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":" = { Date.now })","kind":"text"}]}]},{"parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where each record is kept until it is delivered."}]}]},{"name":"consent","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user’s consent, which each event’s category must have before it is"},{"type":"text","text":" "},{"type":"text","text":"written and delivered; "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", every event delivered, by default."}]}]},{"name":"enrichers","content":[{"type":"paragraph","inlineContent":[{"text":"What each event’s context gains, applied in order by the tracker’s worker.","type":"text"}]}]},{"name":"samplers","content":[{"type":"paragraph","inlineContent":[{"text":"Which events, or groups of events, to keep a fraction of, decided by the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s worker after the enrichers and before the store; none by default, so every","type":"text"},{"text":" ","type":"text"},{"text":"event is kept.","type":"text"}]}]},{"name":"samplingSeed","content":[{"inlineContent":[{"text":"The seed the samplers’ decisions come from: fix it and which events are","type":"text"},{"text":" ","type":"text"},{"text":"kept is fixed too. Drawn from the system’s random number generator once, as the tracker","type":"text"},{"text":" ","type":"text"},{"text":"is made, by default. Fix it only in tests and replays: every launch with the same seed","type":"text"},{"text":" ","type":"text"},{"text":"makes the same decision for its first matching event, its second and so on, so a","type":"text"},{"text":" ","type":"text"},{"text":"fixed seed shipped to every device keeps the same events everywhere rather than the","type":"text"},{"text":" ","type":"text"},{"text":"sampler’s rate of them.","type":"text"}],"type":"paragraph"}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time each event is stamped with when it is tracked. It runs on the"},{"type":"text","text":" "},{"type":"text","text":"tracking caller’s thread, so keep it fast."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"The tracker’s worker writes each record as it reaches it, before publishing it to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":", rather than a stage reading "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":", which runs in the delivery’s task,"},{"type":"text","text":" "},{"type":"text","text":"later, perhaps after a slow batch. Given "},{"type":"codeVoice","code":"consent"},{"type":"text","text":", a record is written once its category"},{"type":"text","text":" "},{"type":"text","text":"is granted, not while it is held, and the recovered records are gated again. The worker"},{"type":"text","text":" "},{"type":"text","text":"takes the recovered records from "},{"type":"codeVoice","code":"store"},{"type":"text","text":" before anything tracked."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"samplers"},{"type":"text","text":", a record they drop is never written. A record the store recovered was"},{"type":"text","text":" "},{"type":"text","text":"sampled in the run that wrote it, so it isn’t sampled again."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"text":"A tracker that writes every record to ","type":"text"},{"code":"store","type":"codeVoice"},{"text":", so records survive the app ending, and","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference"},{"text":" start with the ones ","type":"text"},{"code":"store","type":"codeVoice"},{"text":" kept from earlier runs.","type":"text"}],"variants":[{"paths":["\/documentation\/trackers\/tracker\/init(store:consent:enrichers:samplers:samplingseed:now:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Trackers/documentation/Trackers/Tracker/init(store:consent:enrichers:samplers:samplingSeed:now:)":{"abstract":[{"type":"text","text":"A tracker that writes every record to "},{"type":"codeVoice","code":"store"},{"type":"text","text":", so records survive the app ending, and"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" start with the ones "},{"type":"codeVoice","code":"store"},{"type":"text","text":" kept from earlier runs."}],"title":"init(store:consent:enrichers:samplers:samplingSeed:now:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"store"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Persistence11RecordStoreP","text":"RecordStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7ConsentV","text":"Consent"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV","text":"Enricher"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"samplers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7SamplerV","text":"Sampler"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V","text":"UInt64"},{"kind":"text","text":