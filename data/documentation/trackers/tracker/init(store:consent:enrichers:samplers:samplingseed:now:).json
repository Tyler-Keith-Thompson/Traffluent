,"text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}]},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8Trackers7TrackerV","text":"Tracker","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:8Trackers7TrackerV7RecordsV","text":"Records","kind":"typeIdentifier"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","title":"records","abstract":[{"type":"text","text":"The records of the events this tracker tracks, for a delivery to read."}],"url":"\/documentation\/trackers\/tracker\/records-swift.property","type":"topic","role":"symbol","kind":"symbol"},"doc://Persistence/documentation/Persistence/RecordStore":{"url":"\/documentation\/persistence\/recordstore","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"RecordStore","kind":"identifier"}],"title":"RecordStore"},"doc://Trackers/documentation/Trackers/Consent":{"url":"\/documentation\/trackers\/consent","type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Consent","kind":"identifier"}],"fragments":[{"text":"struct","kind":