{"abstract":[{"text":"A tracker recording every event it tracks, or, given ","type":"text"},{"code":"consent","type":"codeVoice"},{"text":", every event it consents to,","type":"text"},{"text":" ","type":"text"},{"text":"and, given ","type":"text"},{"code":"samplers","type":"codeVoice"},{"text":", the fraction of them they keep.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","text":"Consent","preciseIdentifier":"s:8Trackers7ConsentV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"enrichers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","text":"Enricher","preciseIdentifier":"s:8Trackers8EnricherV"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplers"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","text":"Sampler","preciseIdentifier":"s:8Trackers7SamplerV"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"samplingSeed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt64","preciseIdentifier":"s:s6UInt64V"},{"kind":"text","text":" = .random(in: .min ... .max), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":" = { Date.now })"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"consent","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user’s consent, which each event’s categ