{"sections":[],"abstract":[{"type":"text","text":"A tracker recording every event it tracks, or, given "},{"type":"codeVoice","code":"consent"},{"type":"text","text":", every event it consents to,"},{"type":"text","text":" "},{"type":"text","text":"and, given "},{"type":"codeVoice","code":"samplers"},{"type":"text","text":", the fraction of them they keep."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Consent","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7ConsentV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent"},{"text":"? = nil, ","kind":"text"},{"text":"enrichers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers8EnricherV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher"},{"text":"] = [], ","kind":"text"},{"text":"samplers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Sampler","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7SamplerV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"text":"] = [], ","kind":"text"},{"text":"samplingSeed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt64","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V"},{"text":" = .random(in: .min ... .max), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":" = { Date.now })","kind":"text"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"consent","content":[{"inlineContent":[{"type":"text","text":"The user’s consent, which each event’s category m