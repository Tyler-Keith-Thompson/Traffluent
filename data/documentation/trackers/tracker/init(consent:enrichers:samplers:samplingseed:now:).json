{"kind":"symbol","abstract":[{"text":"A tracker recording every event it tracks, or, given ","type":"text"},{"code":"consent","type":"codeVoice"},{"text":", every event it consents to,","type":"text"},{"text":" ","type":"text"},{"text":"and, given ","type":"text"},{"code":"samplers","type":"codeVoice"},{"text":", the fraction of them they keep.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Consent","preciseIdentifier":"s:8Trackers7ConsentV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"enrichers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Enricher","preciseIdentifier":"s:8Trackers8EnricherV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Enricher","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"samplers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Sampler","preciseIdentifier":"s:8Trackers7SamplerV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"samplingSeed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt64","preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier"},{"text":" = .random(in: .min ... .max), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":" = { Date.now })","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"