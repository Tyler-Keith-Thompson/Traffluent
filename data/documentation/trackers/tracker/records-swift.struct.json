y one after. A ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true,"type":"reference"},{"text":" tracker’s records are","type":"text"},{"text":" ","type":"text"},{"text":"empty.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"One task reads at a time, as with "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":": calling "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" while another task’s"},{"type":"text","text":" "},{"type":"text","text":"call is waiting traps. A reader that has been cancelled stops waiting as its cancellation"},{"type":"text","text":" "},{"type":"text","text":"reaches it, so start a new delivery once the cancelled one’s "},{"type":"codeVoice","code":"execute()"},{"type":"text","text":" has returned."}],"type":"paragraph"}]}],"sections":[],"topicSections":[{"anchor":"Structures","generated":true,"title":"Structures","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/AsyncIterator"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/makeAsyncIterator()"]},{"anchor":"Type-Aliases","generated":true,"title":"Type Aliases","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/Element","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/Failure"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/AsyncSequence-Implementations"]}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP","doc:\/\/Trackers\/Sci"]}],"kind":"symbol","abstract":[{"text":"The records of the events a tracker tracks