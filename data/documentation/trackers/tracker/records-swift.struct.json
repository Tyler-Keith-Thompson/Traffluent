{"abstract":[{"type":"text","text":"The records of the events a tracker tracks, in the order tracked: what a delivery reads."}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Records","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"code":["let tracker = Tracker()","let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination())"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The sequence ends once the tracker’s ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","isActive":true,"type":"reference"},{"text":" is called, or its every copy is","type":"text"},{"text":" ","type":"text"},{"text":"released, and every record before it has been read. Records tracked while nothing is reading wait in memory, without a","type":"text"},{"text":" ","type":"text"},{"text":"bound, for the next read, so none tracked before a delivery starts, or between two, is lost.","type":"text"},{"text":" ","type":"text"},{"text":"A read whose task is cancelled returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and takes nothing: the next read gets the","type":"text"},{"text":" ","type":"text"},{"text":"record it was waiting for, and every one after. A ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true,"type":"reference"},{"text":" tracker’s records are","type":"text"},{"text":" ","type":"text"},{"text":"empty.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads at a time. The first iterator to read holds the records until its iteration"},{"type":"text","text":" "},{"type":"text","text":"ends or the iterator is released, as it is when its task ends. An iterator that reads"},{"type":"text","text":" "},{"type":"text","text":"meanwhile waits its turn, logging a warning as it starts to, then reads on from the next"},{"type":"text","text":" "},{"type":"text","text":"record; several wait in the order they came, and one whose task is cancelled while it"},{"type":"text","text":" "},{"type":"text","text":"waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". So a delivery started right after a cancelled one has stopped, or"},{"type":"text","text":" "},{"type":"text","text":"while it is stopping, delivers every record the cancelled one didn’t read."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Records"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Records"}],"extendedModule":"Trackers","remoteSource":{"fileName":"Records.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Records.swift#L27"},"roleHeading":"Structure","externalID":"s:8Trackers7TrackerV7RecordsV","title":"Tracker.Records","modules":[{"name":"Trackers"}]},"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/AsyncIterator"],"anchor":"Structures"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/makeAsyncIterator()"],"anchor":"Instance-Methods"},{"generated":true,"title":"Type Aliases","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/Elem