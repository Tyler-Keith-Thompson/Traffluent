{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/records-swift.struct"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Records","kind":"identifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination())"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sequence ends once the tracker’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()"},{"type":"text","text":" is called, or its every copy is"},{"type":"text","text":" "},{"type":"text","text":"released, and every record before it has been read. Records tracked while nothing is reading wait in memory, without a"},{"type":"text","text":" "},{"type":"text","text":"bound, for the next read, so none tracked before a delivery starts, or between two, is lost."},{"type":"text","text":" "},{"type":"text","text":"A read whose task is cancelled returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and takes nothing: the next read gets the"},{"type":"text","text":" "},{"type":"text","text":"record it was waiting for, and every one after. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},{"type":"text","text":" tracker’s records are"},{"type":"text","text":" "},{"type":"text","text":"empty."}]},{"type":"paragraph","inlineContent":[{"text":"One task reads at a time. The first iterator to read holds the records until its iteration","type":"text"},{"text":" ","type":"text"},{"text":"ends or the iterator is released, as it is when its task ends. An iterator that reads","type":"text"},{"text":" ","type":"text"},{"text":"meanwhile waits its turn, logging a warning as it starts to, then reads on from the next","type":"text"},{"text":" ","type":"text"},{"text":"record; several wait in the order they came, and one whose task is cancelled while it","type":"text"},{"text":" ","type":"text"},{"text":"waits returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". So a delivery started right after a cancelled one has stopped, or","type":"text"},{"text":" ","type":"text"},{"text":"while it is stopping, delivers every record the cancelled one didn’t read.","type":"text"}]}]}],"metadata":{"title":"Tracker.Records","roleHeading":"Structure","extendedModule":"Trackers","externalID":"s:8Trackers7TrackerV7RecordsV","modules":[{"name":"Trackers"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Records","kind":"identifier"}],"symbolKind":"struct","remoteSource":{"fileName":"Records.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Records.swift#L28"},"navigatorTitle":[{"text":"Records","kind":"identifier"}],"role":"symbol"},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"The records of the events a tracker tracks, in the order tracked: what a delivery reads."}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/AsyncIterator"],"generated":true,"anchor":"Structures"},{"title":"Instance Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/makeAsyncIterator()"],"generated":true,"anchor":"Instance-Methods"},{"title":"