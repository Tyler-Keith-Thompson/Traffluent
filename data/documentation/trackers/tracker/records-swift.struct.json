{"abstract":[{"text":"The records of the events a tracker tracks, in the order tracked: what a delivery reads.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct"},"kind":"symbol","relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP","doc:\/\/Trackers\/Sci"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Records","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination())"]},{"type":"paragraph","inlineContent":[{"text":"The sequence ends once the tracker’s ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","type":"reference","isActive":true},{"text":" is called, or its every copy is","type":"text"},{"text":" ","type":"text"},{"text":"released, and every record before it has been read. Records tracked while nothing is reading wait in memory, without a","type":"text"},{"text":" ","type":"text"},{"text":"bound, for the next read, so none tracked before a delivery starts, or between two, is lost.","type":"text"},{"text":" ","type":"text"},{"text":"A read whose task is cancelled returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and takes nothing: the next read gets the","type":"text"},{"text":" ","type":"text"},{"text":"record it was waiting for, and every one after. A ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","type":"reference","isActive":true},{"text":" tracker’s records are","type":"text"},{"text":" ","type":"text"},{"text":"empty.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads at a time. The first iterator to read holds the records until its iteration"},{"type":"text","text":" "},{"type":"text","text":"ends or the iterator is released, as it is when its task ends. An iterator that reads"},{"type":"text","text":" "},{"type":"text","text":"meanwhile waits its turn, logging a warning as it starts to, then reads on from the next"},{"type":"text","text":" "},{"type":"text","text":"record; several wait in the order they came, and one whose task is cancelled while it"},{"type":"text","text":" "},{"type":"text","text":"waits returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". So a delivery started right after a cancelled one has stopped, or"},{"type":"text","text":" "},{"type":"text","text":"while it is stopping, delivers every record the cancelled one didn’t read."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/trackers\/tracker\/records-swift.struct"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"sections":[],"metadata":{"extendedModule":"Trackers","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Records","kind":"identifier"}],"modules":[{"name":"Trackers"}],"remoteSource":{"fileName":"Records.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Records.swift#L28"},"role":"symbol","navigatorTitle":[{"text":"Records","kind":"identifier"}],"externalID":"s:8Trackers7TrackerV7RecordsV","roleHeading":"Structure","symbolKind":"struct","title":"Tracker.Records"},"topicSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/AsyncIterator"],"anchor":"Structures","generated":true,"title":"Str