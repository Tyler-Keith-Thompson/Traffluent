{"abstract":[{"text":"The records of the events a tracker tracks, in the order tracked: what a delivery reads.","type":"text"}],"variants":[{"paths":["\/documentation\/trackers\/tracker\/records-swift.struct"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"Records"}],"extendedModule":"Trackers","roleHeading":"Structure","symbolKind":"struct","remoteSource":{"fileName":"Records.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Records.swift#L27"},"externalID":"s:8Trackers7TrackerV7RecordsV","role":"symbol","modules":[{"name":"Trackers"}],"title":"Tracker.Records","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Records"}]},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/AsyncIterator"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/makeAsyncIterator()"]},{"anchor":"Type-Aliases","title":"Type Aliases","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/Element","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/Failure"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/AsyncSequence-Implementations"]}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP","doc:\/\/Trackers\/Sci"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Records","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"code":["let tracker = Tracker()","let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination())"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sequence ends once the tracker’s "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","type":"reference","isActive":true},{"type":"text","text":" is called, or its every copy is"},{"type":"text","text":" "},{"type":"text","text":"released, and every record before it has been read. Records tracked while nothing is reading wait in memory, without a"},{"type":"text","text":" "},{"type":"text","text":"bound, for the next read, so none tracked before a delivery starts, or between two, is lost."},{"type":"text","text":" "},{"type":"text","text":"A read whose task is cancelled returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and takes nothing: the next read gets the"},{"type":"text","text":" "},{"type":"text","text":"record it was waiting for, and every one after. A "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","type":"reference","isActive":true},{"type":"text","text":" tracker’s records are"},{"type":"text","text":" "},{"type":"text","text":"empty."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads at a time. The first iterator to read holds the records until its iteration"},{"type":"text","text":" "},{"type":"text","text":"ends or the iterator is released, as it is when its task ends. An iterator that reads"},{"type":"text","text":" "},{"type":"text","text":"meanwhile waits its turn, logging a warning as it starts to, then reads on from the next"},{"type":"text","text":" "},{"type":"text","text":"record; several wait in the order they came, and one whose task is cancelled while it"},{"type":"text","text":" "},{"type":"text","text":"waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". So a delivery started right after a cancelled one has stopped, or"},{"type":"text","text":" "},{"type":"text","text":"while it is stopping, delivers every record the cancelled one didn’t read."}]}],"kind":"content"}],"sections":[],"kind":"symbol","references":{"doc://Trackers/Sci":{"title":"_Concurrency.AsyncSequence","identifier":"doc:\/\/Trackers\/Sci","type":"unresolvable"},"doc://Trackers/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Trackers\/s8SendableP","title":"Swift.Sendable"},"doc://Trackers/documentation/Trackers/Tracker/Records-swift.struct/Element":{"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/Element","title":"Tracker.Records.Element","navigatorTitle":[{"text":"Element","kind":"identifier"}],"abstract":[],"kind":"symbol","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"url":"\/documentation\/trackers\/tracker\/records-swift.struct\/element"},"doc://Trackers/documentation/Trackers/Tracker/Records-swift.struct/AsyncIterator":{"role":"symbol","url":"\/documentation\/trackers\/tracker\/records-swift.struct\/asynciterator","title":"Tracker.Records.AsyncIterator","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/AsyncIterator","navigatorTitle":[{"text":"AsyncIterator","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIterator","kind":"identifier"}],"abstract":[{"type":"text",