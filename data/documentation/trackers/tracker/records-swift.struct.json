ackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"text":" after them, so a delivery sends what is still pending and completes. Events","type":"text"},{"text":" ","type":"text"},{"text":"tracked afterwards are dropped.","type":"text"}],"kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker/Records-swift.struct/AsyncSequence-Implementations":{"type":"topic","abstract":[],"role":"collectionGroup","title":"AsyncSequence Implementations","url":"\/documentation\/trackers\/tracker\/records-swift.struct\/asyncsequence-implementations","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/AsyncSequence-Implementations","kind":"article"},"doc://Trackers/documentation/Trackers/Tracker/Records-swift.struct/Element":{"type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Element","kind":"identifier"}],"url":"\/documentation\/trackers\/tracker\/records-swift.struct\/element","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/Element","abstract":[],"title":"Tracker.Records.Element"},"doc://Trackers/s16SendableMetatypeP":{"identifier":"doc:\/\/Trackers\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","abstract":[{"type":"text","text":"The records of the events this tracker tracks, for a delivery to read."}],"role":"symbol","url":"\/documentation\/trackers\/tracker\/records-swift.property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier","text":"Tracker"},{"kind":"text","text":"."},{"preciseI