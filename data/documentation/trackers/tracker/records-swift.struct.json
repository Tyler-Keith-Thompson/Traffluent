ds","type":"text"},{"text":" ","type":"text"},{"text":"meanwhile waits its turn, logging a warning as it starts to, then reads on from the next","type":"text"},{"text":" ","type":"text"},{"text":"record; several wait in the order they came, and one whose task is cancelled while it","type":"text"},{"text":" ","type":"text"},{"text":"waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". So a delivery started right after a cancelled one has stopped, or","type":"text"},{"text":" ","type":"text"},{"text":"while it is stopping, delivers every record the cancelled one didn’t read.","type":"text"}]}],"kind":"content"}],"kind":"symbol","references":{"doc://Trackers/documentation/Trackers/Tracker/Records-swift.struct/AsyncSequence-Implementations":{"role":"collectionGroup","url":"\/documentation\/trackers\/tracker\/records-swift.struct\/asyncsequence-implementations","type":"topic","title":"AsyncSequence Implementations","kind":"article","abstract":[],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/AsyncSequence-Implementations"},"doc://Trackers/documentation/Trackers/Tracker/Records-swift.struct/makeAsyncIterator()":{"title":"makeAsyncIterator()","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An iterator over the records; reading starts with its first "},{"type":"codeVoice","code":"next()"},{"type":"text","text":"."}],"url":"\/documentation\/trackers\/tracker\/records-swift.struct\/makeasynciterator()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeAsyncIterator"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Records","preciseIdentifier":"s:8Trackers7TrackerV7RecordsV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"AsyncIterator","preciseIdentifier":"s:8Trackers7TrackerV7Records