tarts to, then reads on from the next"},{"type":"text","text":" "},{"type":"text","text":"record; several wait in the order they came, and one whose task is cancelled while it"},{"type":"text","text":" "},{"type":"text","text":"waits returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". So a delivery started right after a cancelled one has stopped, or"},{"type":"text","text":" "},{"type":"text","text":"while it is stopping, delivers every record the cancelled one didn’t read."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/records-swift.struct"]}],"metadata":{"navigatorTitle":[{"text":"Records","kind":"identifier"}],"role":"symbol","roleHeading":"Structure","title":"Tracker.Records","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Records","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Records.swift#L27","fileName":"Records.swift"},"extendedModule":"Trackers","symbolKind":"struct","modules":[{"name":"Trackers"}],"externalID":"s:8Trackers7TrackerV7RecordsV"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/AsyncIterator"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/makeAsyncIterator()"]},{"title":"Type Aliases","generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/Element","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/Failure"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/Trackers\/documentation