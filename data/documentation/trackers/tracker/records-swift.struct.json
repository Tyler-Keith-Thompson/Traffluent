{"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct","interfaceLanguage":"swift"},"sections":[],"metadata":{"modules":[{"name":"Trackers"}],"roleHeading":"Structure","externalID":"s:8Trackers7TrackerV7RecordsV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Records.swift#L27","fileName":"Records.swift"},"title":"Tracker.Records","symbolKind":"struct","extendedModule":"Trackers","navigatorTitle":[{"text":"Records","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Records","kind":"identifier"}],"role":"symbol"},"kind":"symbol","relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP","doc:\/\/Trackers\/Sci"],"type":"conformsTo","kind":"relationships"}],"variants":[{"paths":["\/documentation\/trackers\/tracker\/records-swift.struct"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Records","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination())"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sequence ends once the tracker’s "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","type":"reference","isActive":true},{"type":"text","text":" is called, or its every copy is"},{"type":"text","text":" "},{"type":"text","text":"released, and every record before it has been read. Records tracked while nothing is reading wait in memory, without a"},{"type":"text","text":" "},{"type":"text","text":"bound, for the next read, so none tracked before a delivery starts, or between two, is lost."},{"type":"text","text":" "},{"type":"text","text":"A read whose task is cancelled returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and takes nothing: the next read gets the"},{"type":"text","text":" "},{"type":"text","text":"record it was waiting for, and every one after. A "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","type":"reference","isActive":true},{"type":"text","text":" tracker’s records are"},{"type":"text","text":" "},{"type":"text","text":"empty."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads at a time. The first iterator to read holds the records until its iteration"},{"type":"text","text":" "},{"type":"text","text":"ends or the iterator is released, as it is when its task ends. An iterator that reads"},{"type":"text","text":" "},{"type":"text","text":"meanwhile waits its turn, logging a warning as it starts to, then reads on from the next"},{"type":"text","text":" "},{"type":"text","text":"record; several wait in the order they came, and one whose task is cancelled while it"},{"type":"text","text":" "},{"type":"text","text":"waits returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". So a delivery started right after a cancelled one has stopped, or"},{"type":"text","text":" "},{"type":"text","text":"while it is stopping, delivers every record the cancelled one didn’t read."}]}],"kind":"content"}],"abstract":[{"text":"The records of the events a tracker tracks, in the order tracked: what a delivery reads.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct\/AsyncIterator"],"generated":true,"anchor":"Str