,{"text":" ","type":"text"},{"text":"aren’t sampled again.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Reports wait until they are read, merged: a drop joins the waiting report of the same","type":"text"},{"type":"text","text":" "},{"type":"text","text":"event, adding to its count and widening its timestamps. So the reports waiting unread are at"},{"type":"text","text":" "},{"type":"text","text":"most one per event type, however many events are dropped. Copies of a tracker share one"},{"type":"text","text":" "},{"type":"text","text":"sequence, which has one consumer and ends once the tracker has finished. A "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"type":"text","text":" "},{"type":"text","text":"tracker’s is empty."}]}]}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/samplingdropreports"]}],"abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true,"type":"reference"},{"text":"s dropped, in the order the drops happen.","type":"text"}],"references":{"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"url":"\/documentation\/trackers\/tracker\/records-swift.property","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","kind":"symbol","abstract":[{"type":"text","text":"The records of the events this tracker tracks, for a delivery to read."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Records","preciseIdenti