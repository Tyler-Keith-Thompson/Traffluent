,"kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The tracker’s worker samples each record after its enrichers and before the consent, so a","type":"text"},{"text":" ","type":"text"},{"text":"dropped record is never held, written to a store or delivered. Records a store recovered","type":"text"},{"text":" ","type":"text"},{"text":"aren’t sampled again.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Reports wait until they are read, merged: a drop joins the waiting report of the same","type":"text"},{"text":" ","type":"text"},{"text":"event, adding to its count and widening its timestamps. So the reports waiting unread are at","type":"text"},{"text":" ","type":"text"},{"text":"most one per event type, however many events are dropped. Copies of a tracker share one","type":"text"},{"text":" ","type":"text"},{"text":"sequence, which has one consumer and ends once the tracker has finished. A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","type":"reference"},{"text":" ","type":"text"},{"text":"tracker’s is empty.","type":"text"}]}]}],"references":{"doc://Trackers/documentation/Trackers/SamplingDropReport":{"navigatorTitle":[{"text":"SamplingDropReport","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamplingDropReport","kind":"identifier"}],"title":"SamplingDropReport","role":"symbol","abstract":[{"text":"Events a tracker’s ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"reference","isActive":true},{"text":"s left out: the event’s name, how many were left out and when","type":"text"},{"text":" ","type":"text"},{"text":"they were tracked.","type":"text"}],"type":"topic","url":"\/documentat