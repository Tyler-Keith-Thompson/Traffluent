{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"metadata":{"roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"SamplingDropReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"text":">","kind":"text"}],"externalID":"s:8Trackers7TrackerV19samplingDropReports11AsyncQueues0F5QueueVyAA08SamplingD6ReportVGvp","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L391"},"symbolKind":"property","modules":[{"name":"Trackers"}],"role":"symbol","title":"samplingDropReports"},"abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"text":"s dropped, in the order the drops happen.","type":"text"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/samplingdropreports"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","text":"AsyncQueue"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV","kind":"typeIdentifier","text":"SamplingDropReport"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s worker samples each record after its enrichers and before the consent, so a"},{"type":"text","text":" "},{"type":"text","text":"dropped record is never held, written to a store or delivered. Records a store recovered"},{"type":"text","text":" "},{"type":"text","text":"aren’t sampled again."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read, merged: a drop joins the waiting report of the same"},{"type":"text","text":" "},{"type":"text","text":"event, adding to its count and widening its timestamps. So the reports waiting unread are at"},{"type":"text","text":" "},{"type":"text","text":"most one per event type, however many events are dropped. Copies of a tracker share one"},{"type":"text","text":" "},{"type":"text","text":"sequence, which ends once the tracker has finished and every report has been read. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"type":"text","text":" tracker’s is empty."}]},{"type":"paragraph","inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"references":{"doc://Trackers/documentation/Trackers/Sampler":{"role":"symbol","url":"\/documentation\/trackers\/sampler","abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"title":"Sampler","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"role":"symbol","title":"samplingDropReports","url":"\/documentation\/trackers\/tracker\/samplingdropreports","abstract":[{"type":"text","text":"A report of each event the tracker’s "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true,"type":"reference"},{"type":"text","text":"s dropped, in the order the drops happen."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"kind":"text","text":">"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"title":"AsyncQueue","url":"\/documentation\/asyncqueues\/asyncqueue","type":"topic","kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"title":"Tracker","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"url":"\/documentation\/trackers\/tracker","abstract":[{"text":"What app code tracks events with: it records each event, with the time, the caller’s source","type":"text"},{"text":" ","type":"text"},{"text":"location and the task’s context, as one of its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"text":".","type":"text"}]},"doc://Trackers/documentation/Trackers":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"url":"\/documentation\/trackers","role":"collection"},"doc://Trackers/documentation/Trackers/SamplingDropReport":{"title":"SamplingDropReport","url":"\/documentation\/trackers\/samplingdropreport","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SamplingDropReport"}],"kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport","navigatorTitle":[{"kind":"identifier","text":"SamplingDropReport"}],"abstract":[{"text":"Events a tracker’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"text":"s left out: the event’s name, how many were left out and when","type":"text"},{"text":" ","type":"text"},{"text":"they were tracked.","type":"text"}],"type":"topic","role":"symbol"},"doc://Trackers/documentation/Trackers/Tracker/noOp":{"role":"symbol","title":"noOp","abstract":[{"type":"text","text":"A tracker that drops every event, logging each one at debug level. Its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"empty."}],"url":"\/documentation\/trackers\/tracker\/noop","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noOp","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Tracker","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV","text":"Tracker"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV7RecordsV","text":"Records"}],"kind":"symbol","abstract":[{"text":"The records of the events this tracker tracks, for a delivery to read.","type":"text"}],"url":"\/documentation\/trackers\/tracker\/records-swift.property","title":"records","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"}}}