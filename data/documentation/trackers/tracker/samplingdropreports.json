/documentation\/Trackers\/Tracker\/noOp"},{"text":" ","type":"text"},{"text":"tracker’s is empty.","type":"text"}]}]}],"abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"reference"},{"text":"s dropped, in the order the drops happen.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/trackers\/tracker\/samplingdropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:ScS","kind":"typeIdentifier","text":"AsyncStream"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:8Trackers18SamplingDropReportV","kind":"typeIdentifier","text":"SamplingDropReport"},{"kind":"text","text":">"}],"modules":[{"name":"Trackers"}],"title":"samplingDropReports","externalID":"s:8Trackers7TrackerV19samplingDropReportsScSyAA08SamplingD6ReportVGvp","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L295"},"roleHeading":"Instance Property","role":"symbol"},"references":{"doc://Trackers/documentation/Trackers/Tracker":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"navigatorTitle":[{"text":"Tracker","kind":"identifier"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","role":"symbol","title":"Tracker","abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/