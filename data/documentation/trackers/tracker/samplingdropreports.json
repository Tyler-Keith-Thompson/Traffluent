{"abstract":[{"type":"text","text":"A report of each event the tracker’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"type":"text","text":"s dropped, in the order the drops happen."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport","text":"SamplingDropReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s worker samples each record after its enrichers and before the consent, so a"},{"type":"text","text":" "},{"type":"text","text":"dropped record is never held, written to a store or delivered. Records a store recovered"},{"type":"text","text":" "},{"type":"text","text":"aren’t sampled again."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read, merged: a drop joins the waiting report of the same"},{"type":"text","text":" "},{"type":"text","text":"event, adding to its count and widening its timestamps. So the reports waiting unread are at"},{"type":"text","text":" "},{"type":"text","text":"most one per event type, however many events are dropped. Copies of a tracker share one"},{"type":"text","text":" "},{"type":"text","text":"sequence, which has one consumer and ends once the tracker has finished. A "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"tracker’s is empty."}]}],"kind":"content"}],"metadata":{"modules":[{"name":"Trackers"}],"externalID":"s:8Trackers7TrackerV19samplingDropReportsScSyAA08SamplingD6ReportVGvp","title":"samplingDropReports","role":"symbol","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L234"},"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"kind":"text","text":">"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/samplingdropreports"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"kind":"symbol","references":{"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV","text":"Tracker"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV7RecordsV","text":"Records"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","abstract":[{"type":"text","text":"The records of the events this tracker tracks, for a delivery to read."}],"u