umentation\/Trackers\/Tracker\/noOp","url":"\/documentation\/trackers\/tracker\/noop","abstract":[{"type":"text","text":"A tracker that drops every event, logging each one at debug level. Its "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference","isActive":true},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"empty."}]},"doc://Trackers/documentation/Trackers/Tracker":{"url":"\/documentation\/trackers\/tracker","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","title":"Tracker","type":"topic","abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Tracker","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}]},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"kind":"symbol","type":"topic","title":"records","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Records","preciseIdentifier":"s:8Trackers7TrackerV7RecordsV"}],"url":"\/documentation\/trackers\/tracker\/records-swift.property","role":"symbol","abstract":[{"text":"The records of the events this tracker tracks, for a delivery to read.","type":"text"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},"doc://Trackers/documentation/Trackers/Tracker/samplin