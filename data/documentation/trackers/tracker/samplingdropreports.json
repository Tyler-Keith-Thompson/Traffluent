{"abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true},{"text":"s dropped, in the order the drops happen.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/samplingdropreports"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"SamplingDropReport","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV","kind":"typeIdentifier"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracker’s worker samples each record after its enrichers and before the consent, so a"},{"type":"text","text":" "},{"type":"text","text":"dropped record is never held, written to a store or delivered. Records a store recovered"},{"type":"text","text":" "},{"type":"text","text":"aren’t sampled again."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read, merged: a drop joins the waiting report of the same"},{"type":"text","text":" "},{"type":"text","text"