{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport","kind":"typeIdentifier","text":"SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The tracker’s worker samples each record after its enrichers and before the consent, so a","type":"text"},{"text":" ","type":"text"},{"text":"dropped record is never held, written to a store or delivered. Records a store recovered","type":"text"},{"text":" ","type":"text"},{"text":"aren’t sampled again.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Reports wait until they are read, merged: a drop joins the waiting report of the same","type":"text"},{"text":" ","type":"text"},{"text":"event, adding to its count and widening its timestamps. So the reports waiting unread are at","type":"text"},{"text":" ","type":"text"},{"text":"most one per event type, however many events are dropped. Copies of a tracker share one","type":"text"},{"text":" ","type":"text"},{"text":"sequence, which has one consumer and ends once the tracker has finished. A ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"tracker’s is empty.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/samplingdropreports"]}],"metadata":{"role":"symbol","modules":[{"name":"Trackers"}],"title":"samplingDropReports","roleHeading":"Instance Property","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L234","fileName":"Tracker.swift"},"externalID":"s:8Trackers7TrackerV19samplingDropReportsScSyAA08SamplingD6ReportVGvp","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers18SamplingDropReportV","text":"SamplingDropReport"},{"kind":"text","text":">"}]},"kind":"symbol","abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"reference","isActive":true},{"text":"s dropped, in the order the drops happen.","type":"text"}],"references":{"doc://Trackers/documentation/Trackers":{"role":"collection","title":"Trackers","abstract":[],"url":"\/documentation\/trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"topic","kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker/noOp":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","abstract":[{"type":"text","text":"A tracker that drops every event, logging each one at debug level. Its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","t