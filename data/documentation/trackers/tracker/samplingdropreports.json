, at once."}]},"doc://Trackers/documentation/Trackers/Tracker/noOp":{"abstract":[{"text":"A tracker that drops every event, logging each one at debug level. Its ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"empty.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noOp","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8Trackers7TrackerV","text":"Tracker","kind":"typeIdentifier"}],"type":"topic","title":"noOp","kind":"symbol","url":"\/documentation\/trackers\/tracker\/noop","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},"doc://Trackers/documentation/Trackers/Tracker":{"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"title":"Tracker","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Tracker","kind":"identifier"}],"url":"\/documentation\/trackers\/tracker","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker"},"doc://Trackers/documentation/Trackers":{"type":"topic","title":"Trackers","kind":"symbol","role":"collection","identifier":"doc:\/\/Trackers\/documentation\/Trackers","abstract":[],"url":"\/documentation\/trackers"},"doc://Trackers/documentation/Trackers/SamplingDropReport":{"kind":"symbol","url":"\/documentation\/trackers\/samplingdropreport","title":