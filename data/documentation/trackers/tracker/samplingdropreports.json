{"abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"reference","isActive":true},{"text":"s dropped, in the order the drops happen.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/trackers\/tracker\/samplingdropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Trackers"}],"title":"samplingDropReports","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"SamplingDropReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"text":">","kind":"text"}],"role":"symbol","roleHeading":"Instance Property","externalID":"s:8Trackers7TrackerV19samplingDropReports11AsyncQueues0F5QueueVyAA08SamplingD6ReportVGvp","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L391","fileName":"Tracker.swift"},"symbolKind":"property"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"SamplingDropReport","kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The tracker’s worker samples each record after its enrichers and before the consent, so a","type":"text"},{"text":" ","type":"text"},{"text":"dropped record is never held, written to a store or delivered. Records a store recovered","type":"text"},{"text":" ","type":"text"},{"text":"aren’t sampled again.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Reports wait until they are read, merged: a drop joins the waiting report of the same","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"event, adding to its count and widening its timestamps. So the reports waiting unread are at"},{"type":"text","text":" "},{"type":"text","text":"most one per event type, however many events are dropped. Copies of a tracker share one"},{"type":"text","text":" "},{"type":"text","text":"sequence, which ends once the tracker has finished and every report has been read. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true,"type":"reference"},{"type":"text","text":" tracker’s is empty."}]},{"type":"paragraph","inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"references":{"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"type":"topic","navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}],"url":"\/documentation\/asyncqueues\/asyncqueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","title":"AsyncQueue","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}]},"doc://Trackers/documentation/Trackers/Sampler":{"role":"symbol","kind":"symbol","type":"topic","navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"url":"\/documentation\/trackers\/sampler","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"title":"Sampler","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},"doc://Trackers/documentation/Trackers":{"type":"topic","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"url":"\/documentation\/trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers","title":"Trackers"},"doc://Trackers/documentation/Trackers/Tracker/noOp":{"url":"\/documentation\/trackers\/tracker\/noop","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","title":"noOp","type":"topic","role":"symbol","kind":"symbol","abstract":[{"text":"A tracker that drops every event, logging each one at debug level. Its ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"empty.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"noOp"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Tracker","preciseIdentifier":"s:8Trackers7TrackerV"}]},"doc://Trackers/documentation/Trackers/SamplingDropReport":{"role":"symbol","kind":"symbol","type":"topic","navigatorTitle":[{"text":"SamplingDropReport","kind":"identifier"}],"abstract":[{"type":"text","text":"Events a tracker’s "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"reference","isActive":true},{"type":"text","text":"s left out: the event’s name, how many were left out and when"},{"type":"text","text":" "},{"type":"text","text":"they were tracked."}],"url":"\/documentation\/trackers\/samplingdropreport","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamplingDropReport","kind":"identifier"}],"title":"SamplingDropReport","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport"},"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"title":"samplingDropReports","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","text":"AsyncQueue"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:8Trackers18SamplingDropReportV","kind":"typeIdentifier","text":"SamplingDropReport"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","type":"topic","url":"\/documentation\/t