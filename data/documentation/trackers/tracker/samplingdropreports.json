{"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","interfaceLanguage":"swift"},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L234","fileName":"Tracker.swift"},"modules":[{"name":"Trackers"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:8Trackers18SamplingDropReportV","text":"SamplingDropReport","kind":"typeIdentifier"},{"text":">","kind":"text"}],"symbolKind":"property","role":"symbol","title":"samplingDropReports","externalID":"s:8Trackers7TrackerV19samplingDropReportsScSyAA08SamplingD6ReportVGvp","roleHeading":"Instance Property"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/samplingdropreports"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"SamplingDropReport","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV","kind":"typeIdentifier"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The tracker’s worker samples each record after its enrichers and before the consent, so a","type":"text"},{"text":" ","type":"text"},{"text":"dropped record is never held, written to a store or delivered. Records a store recovered","type":"text"},{"text":" ","type":"text"},{"text":"aren’t sampled again.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Reports wait until they are read, merged: a drop joins the waiting report of the same"},{"type":"text","text":" "},{"type":"text","text":"event, adding to its count and widening its timestamps. So the reports waiting unread are at"},{"type":"text","text":" "},{"type":"text","text":"most one per event type, however many events are dropped. Copies of a tracker share one"},{"type":"text","text":" "},{"type":"text","text":"sequence, which has one consumer and ends once the tracker has finished. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},{"type":"text","text":" "},{"type":"text","text":"tracker’s is empty."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"sections":[],"abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true,"type":"reference"},{"text":"s dropped, in the order the drops happen.","type":"text"}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Trackers/documentation/Trackers/Sampler":{"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"abstract":[{"text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written","type":"text"},{"text":" ","type":"text"},{"text":"or delivered: event by event, or a whole group of events, such as a session, at once.","type":"text"}],"type":"topic","title":"Sampler","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"url":"\/documentation\/trackers\/sampler"},"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"kind":"text","text":">"}],"title":"samplingDropReports","type":"topic","abstract":[{"type":"text","text":"A report of each event the tracker’s "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true},{"type":"text","text":"s dropped, in the order the drops happen."}],"role":"symbol","kind":"symbol","url":"\/documentation\/trackers\/tracker\/samplingdropreports"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"role":"symbol","title":"records","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV","text":"Tracker"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV7RecordsV","text":"Records"}],"abstract":[{"type":"text","text":"The records of the events this tracker tracks, for a delivery to read."}],"url":"\/documentation\/trackers\/tracker\/records-swift.property","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker":{"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"identifier":"doc:\/