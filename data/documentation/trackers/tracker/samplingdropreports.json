{"sections":[],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true},{"text":"s dropped, in the order the drops happen.","type":"text"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport","kind":"typeIdentifier","text":"SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The tracker’s worker samples each record after its enrichers and before the consent, so a"},{"type":"text","text":" "},{"type":"text","text":"dropped record is never held, written to a store or delivered. Records a store recovered"},{"type":"text","text":" "},{"type":"text","text":"aren’t sampled again."}],"type":"paragraph"},{"inlineContent":[{"text":"Reports wait until they are read, merged: a drop joins the waiting report of the same","type":"text"},{"text":" ","type":"text"},{"text":"event, adding to its count and widening its timestamps. So the reports waiting unread are at","type":"text"},{"text":" ","type":"text"},{"text":"most one per event type, however many events are dropped. Copies of a tracker share one","type":"text"},{"text":" ","type":"text"},{"text":"sequence, which has one consumer and ends once the tracker has finished. A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},{"text":" ","type":"text"},{"text":"tracker’s is empty.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","interfaceLanguage":"swift"},"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers18SamplingDropReportV","text":"SamplingDropReport"},{"kind":"text","text":">"}],"symbolKind":"property","externalID":"s:8Trackers7TrackerV19samplingDropReportsScSyAA08SamplingD6ReportVGvp","remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L295"},"title":"samplingDropReports","modules":[{"name":"Trackers"}],"roleHeading":"Instance Property"},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/trackers\/tracker\/samplingdropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"url":"\/documentation\/trackers\/tracker\/samplingdropreports","abstract":[{"type":"text","text":"A report of each event the tracker’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"type":"text","text":"s dropped, in the order the drops happen."}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeId