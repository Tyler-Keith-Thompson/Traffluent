{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"remoteSource":{"fileName":"Sampler.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Sampler.swift#L28"},"roleHeading":"Structure","title":"Sampler","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"symbolKind":"struct","externalID":"s:8Trackers7SamplerV","navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"modules":[{"name":"Trackers"}],"role":"symbol"},"seeAlsoSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/SampleRate","doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey","doc:\/\/Trackers\/documentation\/Trackers\/InvalidSampleRate"],"title":"Sampling","generated":true,"anchor":"Sampling"}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A tracker built with samplers runs them on its worker, after its enrichers, so a sampler sees"},{"type":"text","text":" "},{"type":"text","text":"what they set:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker(samplers: [","    .events(of: Scrolled.self, rate: try SampleRate(0.1)),","    .events(where: { $0.consentCategory == .performance }, rate: try SampleRate(0.5)),","])"]},{"inlineContent":[{"type":"text","text":"Each sampler decides on its own, and a record is kept only if every sampler that applies to it"},{"type":"text","text":" "},{"type":"text","text":"keeps it. A kept record carries the product of their rates as its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey"},{"type":"text","text":"; one no"},{"type":"text","text":" "},{"type":"text","text":"sampler applies to is always kept and carries no key. Each dropped record is reported on"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The decisions come from the tracker’s sampling seed, the same on every platform and Swift"},{"type":"text","text":" "},{"type":"text","text":"release: with a seed fixed, which events are kept is fixed too. Each sampler draws from a"},{"type":"text","text":" "},{"type":"text","text":"stream of its own, picked by its place in the tracker’s list: appending a sampler changes no"},{"type":"text","text":" "},{"type":"text","text":"other’s decisions, but inserting, removing or reordering one gives every sampler after it a new"},{"type":"text","text":" "},{"type":"text","text":"stream, so it decides differently under the same seed."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"topicSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(of:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(where:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)"],"title":"Type Methods","generated":true,"anchor":"Type-Methods"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},"relationshipsSections":[{"identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}]