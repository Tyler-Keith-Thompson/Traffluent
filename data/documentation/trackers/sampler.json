{"relationshipsSections":[{"identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A tracker built with samplers runs them on its worker, after its enrichers, so a sampler sees"},{"type":"text","text":" "},{"type":"text","text":"what they set:"}],"type":"paragraph"},{"code":["let tracker = Tracker(samplers: [","    .events(of: Scrolled.self, rate: 0.1),","    .events(where: { $0.consentCategory == .performance }, rate: 0.5),","])"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each sampler decides on its own, and a record is kept only if every sampler that applies to it"},{"type":"text","text":" "},{"type":"text","text":"keeps it. A kept record carries the product of their rates as its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey","isActive":true},{"type":"text","text":"; one no"},{"type":"text","text":" "},{"type":"text","text":"sampler applies to is always kept and carries no key. Each dropped record is reported on"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The decisions come from the tracker’s sampling seed, the same on every platform and Swift","type":"text"},{"text":" ","type":"text"},{"text":"release: with a seed fixed, which events are kept is fixed too. Each sampler draws from a","type":"text"},{"text":" ","type":"text"},{"text":"stream of its own, picked by its place in the tracker’s list: appending a sampler changes no","type":"text"},{"text":" ","type":"text"},{"text":"other’s decisions, but inserting, removing or reordering one gives every sampler after it a new","type":"text"},{"text":" ","type":"text"},{"text":"stream, so it decides differently under the same seed.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(of:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(where:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)"],"anchor":"Type-Methods","title":"Type Methods","generated":true}],"abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"variants":[{"paths":["\/documentation\/trackers\/sampler"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"symbol","roleHeading":"Structure","title":"Sampler","externalID":"s:8Trackers7SamplerV","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"modules":[{"name":"Trackers"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Sampler.swift#L28","fileName":"Sampler.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}]},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},"references":{"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true},{"text":"s dropped, in the order the drops happen.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"SamplingDropReport","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"text":">","kind":"text"}],"title":"samplingDropReports","type":"topic","kind":"symbol","url":"\/documentation\/trackers\/tracker\/samplingdropreports","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},"doc://Trackers/documentation/Trackers/SampleRateKey":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SampleRateKey"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey","navigatorTitle":[{"kind":"identifier","text":"SampleRateKey"}],"url":"\/documentation\/trackers\/sampleratekey","abstract":[{"type":"text","text":"The "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":" key of the rate a record was kept at, which a tracker’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"type":"text","text":"s set on"},{"type":"text","text":" "},{"type":"text","text":"the context of every record they keep."}],"kind":"symbol","title":"SampleRateKey"},"doc://Trackers/documentation/Trackers/Sampler/grouped(by:where:rate:)":{"type":"topic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"grouped","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Key","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"by","kind":"externalPar