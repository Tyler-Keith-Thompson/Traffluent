{"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A tracker built with samplers runs them on its worker, after its enrichers, so a sampler sees"},{"type":"text","text":" "},{"type":"text","text":"what they set:"}],"type":"paragraph"},{"code":["let tracker = Tracker(samplers: [","    .events(of: Scrolled.self, rate: 0.1),","    .events(where: { $0.consentCategory == .performance }, rate: 0.5),","])"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each sampler decides on its own, and a record is kept only if every sampler that applies to it","type":"text"},{"text":" ","type":"text"},{"text":"keeps it. A kept record carries the product of their rates as its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey","type":"reference"},{"text":"; one no","type":"text"},{"text":" ","type":"text"},{"text":"sampler applies to is always kept and carries no key. Each dropped record is reported on","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The decisions come from the tracker’s sampling seed, the same on every platform and Swift","type":"text"},{"text":" ","type":"text"},{"text":"release: with a seed fixed, which events are kept is fixed too. Each sampler draws from a","type":"text"},{"text":" ","type":"text"},{"text":"stream of its own, picked by its place in the tracker’s list: appending a sampler changes no","type":"text"},{"text":" ","type":"text"},{"text":"other’s decisions, but inserting, removing or reordering one gives every sampler after it a new","type":"text"},{"text":" ","type":"text"},{"text":"stream, so it decides differently under the same seed.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"metadata":{"navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"externalID":"s:8Trackers7SamplerV","remoteSource":{"fileName":"Sampler.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Sampler.swift#L28"},"modules":[{"name":"Trackers"}],"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"symbolKind":"struct","role":"symbol","title":"Sampler"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/sampler"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"topicSections":[{"anchor":"Type-Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(of:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(where:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)"],"title":"Type Methods","generated":true}],"references":{"doc://Trackers/documentation/Trackers":{"title":"Trackers","abstract":[],"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers","role":"collection","url