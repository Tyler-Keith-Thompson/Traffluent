{"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(of:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(where:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)"],"title":"Type Methods","generated":true,"anchor":"Type-Methods"}],"relationshipsSections":[{"identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracker built with samplers runs them on its worker, after its enrichers, so a sampler sees"},{"type":"text","text":" "},{"type":"text","text":"what they set:"}]},{"code":["let tracker = Tracker(samplers: [","    .events(of: Scrolled.self, rate: 0.1),","    .events(where: { $0.consentCategory == .performance }, rate: 0.5),","])"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each sampler decides on its own, and a record is kept only if every sampler that applies to it"},{"type":"text","text":" "},{"type":"text","text":"keeps it. A kept record carries the product of their rates as its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey"},{"type":"text","text":"; one no"},{"type":"text","text":" "},{"type":"text","text":"sampler applies to is always kept and carries no key. Each dropped record is reported on"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The decisions come from the tracker’s sampling seed, the same on every platform and Swift","type":"text"},{"text":" ","type":"text"},{"text":"release: with a seed fixed, which events are kept is fixed too. Each sampler draws from a","type":"text"},{"text":" ","type":"text"},{"text":"stream of its own, picked by its place in the tracker’s list: appending a sampler changes no","type":"text"},{"text":" ","type":"text"},{"text":"other’s decisions, but inserting, removing or reordering one gives every sampler after it a new","type":"text"},{"text":" ","type":"text"},{"text":"stream, so it decides differently under the same seed.","type":"text"}]}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/sampler"]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"metadata":{"symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Sampler.swift#L28","fileName":"Sampler.swift"},"navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"title":"Sampler","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:8Trackers7SamplerV","modules":[{"name":"Trackers"}],"role":"symbol"},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","interfaceLanguage":"swift"},"references":{"doc://Trackers/s8SendableP":{"identifier":"doc:\/\/Trackers\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Trackers/documentation/Trackers/Tracker/