{"metadata":{"title":"Sampler","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Sampler.swift#L28","fileName":"Sampler.swift"},"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"externalID":"s:8Trackers7SamplerV","role":"symbol","modules":[{"name":"Trackers"}],"symbolKind":"struct","navigatorTitle":[{"text":"Sampler","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracker built with samplers runs them on its worker, after its enrichers, so a sampler sees"},{"type":"text","text":" "},{"type":"text","text":"what they set:"}]},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker(samplers: [","    .events(of: Scrolled.self, rate: 0.1),","    .events(where: { $0.consentCategory == .performance }, rate: 0.5),","])"]},{"type":"paragraph","inlineContent":[{"text":"Each sampler decides on its own, and a record is kept only if every sampler that applies to it","type":"text"},{"text":" ","type":"text"},{"text":"keeps it. A kept record carries the product of their rates as its ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey","type":"reference","isActive":true},{"text":"; one no","type":"text"},{"text":" ","type":"text"},{"text":"sampler applies to is always kept and carries no key. Each dropped record is reported on","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The decisions come from the tracker’s sampling seed, the same on every platform and Swift"},{"type":"text","text":" "},{"type":"text","text":"release: with a seed fixed, which events are kept is fixed too. Each sampler draws from a"},{"type":"text","text":" "},{"type":"text","text":"stream of its own, picked by its place in the tracker’s list: appending a sampler changes no"},{"type":"text","text":" "},{"type":"text","text":"other’s decisions, but inserting, removing or reordering one gives every sampler after it a new"},{"type":"text","text":" "},{"type":"text","text":"stream, so it decides differently under the same seed."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},"topicSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(of:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(where:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)"],"title":"Type Methods","anchor":"Type-Methods","generated":true}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/sampler"]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"relationshipsSections":[{"identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"references":{"doc://Trackers/documentation/Trackers/SampleRateKey":{"title":"SampleRateKey","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey","url":"\/documentat