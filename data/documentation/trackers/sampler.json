{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A tracker built with samplers runs them on its worker, after its enrichers, so a sampler sees","type":"text"},{"text":" ","type":"text"},{"text":"what they set:","type":"text"}]},{"type":"codeListing","code":["let tracker = Tracker(samplers: [","    .events(of: Scrolled.self, rate: try SampleRate(0.1)),","    .events(where: { $0.consentCategory == .performance }, rate: try SampleRate(0.5)),","])"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each sampler decides on its own, and a record is kept only if every sampler that applies to it"},{"type":"text","text":" "},{"type":"text","text":"keeps it. A kept record carries the product of their rates as its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey","isActive":true},{"type":"text","text":"; one no"},{"type":"text","text":" "},{"type":"text","text":"sampler applies to is always kept and carries no key. Each dropped record is reported on"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The decisions come from the tracker’s sampling seed, the same on every platform and Swift","type":"text"},{"text":" ","type":"text"},{"text":"release: with a seed fixed, which events are kept is fixed too. Each sampler draws from a","type":"text"},{"text":" ","type":"text"},{"text":"stream of its own, picked by its place in the tracker’s list: appending a sampler changes no","type":"text"},{"text":" ","type":"text"},{"text":"other’s decisions, but inserting, removing or reordering one gives every sampler after it a new","type":"text"},{"text":" ","type":"text"},{"text":"stream, so it decides differently under the same seed.","type":"text"}]}]}],"kind":"symbol","metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"modules":[{"name":"Trackers"}],"roleHeading":"Structure","role":"symbol","externalID":"s:8Trackers7SamplerV","navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"remoteSource":{"fileName":"Sampler.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Sampler.swift#L28"},"title":"Sampler","symbolKind":"struct"},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},"abstract":[{"text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written","type":"text"},{"text":" ","type":"text"},{"text":"or delivered: event by event, or a whole group of events, such as a session, at once.","type":"text"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/sampler"]}],"topicSections":[{"anchor":"Type-Methods","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(of:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(where:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)"],"generated":true,"title":"Type Methods"}],"seeAlsoSections":[{"anchor":"Sampling","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/SampleRate","doc:\/\/Trackers\/documentation\/Tracker