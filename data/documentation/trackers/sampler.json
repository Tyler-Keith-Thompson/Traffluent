{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"modules":[{"name":"Trackers"}],"externalID":"s:8Trackers7SamplerV","title":"Sampler","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Sampler.swift#L28","fileName":"Sampler.swift"},"symbolKind":"struct","role":"symbol","navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"roleHeading":"Structure"},"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(of:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(where:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)"],"generated":true,"anchor":"Type-Methods","title":"Type Methods"}],"kind":"symbol","abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"variants":[{"paths":["\/documentation\/trackers\/sampler"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracker built with samplers runs them on its worker, after its enrichers, so a sampler sees"},{"type":"text","text":" "},{"type":"text","text":"what they set:"}]},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker(samplers: [","    .events(of: Scrolled.self, rate: try SampleRate(0.1)),","    .events(where: { $0.consentCategory == .performance }, rate: try SampleRate(0.5)),","])"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each sampler decides on its own, and a record is kept only if every sampler that applies to it"},{"type":"text","text":" "},{"type":"text","text":"keeps it. A kept record carries the product of their rates as its "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey","isActive":true,"type":"reference"},{"type":"text","text":"; one no"},{"type":"text","text":" "},{"type":"text","text":"sampler applies to is always kept and carries no key. Each dropped record is reported on"},{"type":"text","text":" "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The decisions come from the tracker’s sampling seed, the same on every platform and Swift"},{"type":"text","text":" "},{"type":"text","text":"release: with a seed fixed, which events are kept is fixed too. Each sampler draws from a"},{"type":"text","text":" "},{"type":"text","text":"stream of its own, picked by its place in the tracker’s list: appending a sampler changes no"},{"type":"text","text":" "},{"type":"text","text":"other’s decisions, but inserting, removing or reordering one gives every sampler after it a new"},{"type":"text","text":" "},{"type":"text","text":"stream, so it decides differently under the same seed."}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/SampleRate","doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey","doc:\/\/Trackers\/documentation\/Trackers\/InvalidSampleRate"],"generated":true,"anchor":"Sampling","title":"Sampling"}],"relationshipsSections":[{"identifiers":["doc:\/\/Trackers\/s8SendableP","do