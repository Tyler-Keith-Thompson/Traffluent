{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracker built with samplers runs them on its worker, after its enrichers, so a sampler sees"},{"type":"text","text":" "},{"type":"text","text":"what they set:"}]},{"type":"codeListing","code":["let tracker = Tracker(samplers: [","    .events(of: Scrolled.self, rate: 0.1),","    .events(where: { $0.consentCategory == .performance }, rate: 0.5),","])"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each sampler decides on its own, and a record is kept only if every sampler that applies to it"},{"type":"text","text":" "},{"type":"text","text":"keeps it. A kept record carries the product of their rates as its "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey","type":"reference","isActive":true},{"type":"text","text":"; one no"},{"type":"text","text":" "},{"type":"text","text":"sampler applies to is always kept and carries no key. Each dropped record is reported on"},{"type":"text","text":" "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The decisions come from the tracker’s sampling seed, the same on every platform and Swift"},{"type":"text","text":" "},{"type":"text","text":"release: with a seed fixed, which events are kept is fixed too. Each sampler draws from a"},{"type":"text","text":" "},{"type":"text","text":"stream of its own, picked by its place in the tracker’s list: appending a sampler changes no"},{"type":"text","text":" "},{"type":"text","text":"other’s decisions, but inserting, removing or reordering one gives every sampler after it a new"},{"type":"text","text":" "},{"type":"text","text":"stream, so it decides differently under the same seed."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"paths":["\/documentation\/trackers\/sampler"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"metadata":{"modules":[{"name":"Trackers"}],"externalID":"s:8Trackers7SamplerV","title":"Sampler","role":"symbol","remoteSource":{"fileName":"Sampler.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Sampler.swift#L28"},"symbolKind":"struct","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Sampler"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},"topicSections":[{"anchor":"Type-Methods","title":"Type Methods","generated":true,"identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(of:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/events(where:rate:)","doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)"]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"kind":"relationships"}],"kind":"symbol","references":{"doc://Trackers/s8SendableP":{"identifier":"doc:\/\/Trackers\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://Trackers/documentation/Trackers/Sampler"