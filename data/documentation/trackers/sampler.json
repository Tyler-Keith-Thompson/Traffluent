s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SampleRateKey"},{"text":"; one no","type":"text"},{"text":" ","type":"text"},{"text":"sampler applies to is always kept and carries no key. Each dropped record is reported on","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The decisions come from the tracker’s sampling seed, the same on every platform and Swift","type":"text"},{"text":" ","type":"text"},{"text":"release: with a seed fixed, which events are kept is fixed too. Each sampler draws from a","type":"text"},{"text":" ","type":"text"},{"text":"stream of its own, picked by its place in the tracker’s list: appending a sampler changes no","type":"text"},{"text":" ","type":"text"},{"text":"other’s decisions, but inserting, removing or reordering one gives every sampler after it a new","type":"text"},{"text":" ","type":"text"},{"text":"stream, so it decides differently under the same seed.","type":"text"}]}]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/sampler"]}],"references":{"doc://Trackers/documentation/Trackers/Sampler/grouped(by:where:rate:)":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)","fragm