"},{"text":"it, by the record’s ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/SessionKey","type":"reference","isActive":true},{"text":". It needs the sessions enricher among the tracker’s","type":"text"},{"text":" ","type":"text"},{"text":"enrichers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For the app, device, operating system, locale and network an event was tracked on, use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"StandardContext"},{"text":". For the app’s opens and moves to the background, use ","type":"text"},{"type":"codeVoice","code":"LifecycleTracking"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"its ","type":"text"},{"type":"codeVoice","code":"ApplicationOpened"},{"text":" after a long time in the background starts a new session here, though","type":"text"},{"text":" ","type":"text"},{"text":"neither module knows about the other.","type":"text"}]},{"code":["import Sessions","import Trackers","","let tracker = Tracker(enrichers: [try .sessions(timeout: .seconds(15 * 60), kinds: [.started])])","tracker.track(SignedUp(plan: \"pro\"))  \/\/ tracks SessionStarted, then SignedUp, both with the same SessionKey"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/sessionsandstandardcontext","type":"reference"},{"text":" ","type":"text"},{"text":"covers sessions beside the standard context, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/samplingevents","type":"reference"},{"text":" ","type":"text"},{"text":"covers sampling.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/sessions"]}],"sections":[],"abstract":[{"type":"text","text":"Put eve