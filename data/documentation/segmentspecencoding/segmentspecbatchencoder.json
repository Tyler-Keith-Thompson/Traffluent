text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with one member, ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":", an array","type":"text"},{"text":" ","type":"text"},{"text":"of track calls, one per record, oldest first, with these members:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"anonymousId","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"context"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The standard context, in the spec’s field names (below), and ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"\"0.0.0.0\"","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"event","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"messageId"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"properties"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s stored properties, by name"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"request_ip"}],"type":"paragraph"}],[{"inlineContent":[{"code":"\"0.0.0.0\"","type":"codeVoice"},{"text":", in RudderStack’s calls alone","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"timestamp"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked, in ISO 8601 with milliseconds, in UTC","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"\"track\""}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"userId"},{"type":"text","text":", no "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" call, no traits,"},{"type":"text","text":" "},{"type":"text","text":"and no "},{"type":"codeVoice","code":"context.device.id"},{"type":"text","text":" or "},{"type":"codeVoice","code":"advertisingId"},{"type":"text","text":". An endpoint counts a user per "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"its anonymous users are sessions. A record with no session (one tracked by a tracker without"},{"type":"text","text":" "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store recovered after a relaunch, which keeps no context) is its"},{"type":"text","text":" "},{"type":"text","text":"own anonymous user, linked to nothing: the spec rejects a call with neither a "},{"type":"codeVoice","code":"userId"},{"type":"text","text":" nor an"},{"type":"text","text":" "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":". Segment deduplicates calls by "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":" over about the last 24 hours, and"},{"type":"text","text":" "},{"type":"text","text":"drops most duplicates rather than all, so a recovered record Segment had already stored before"},{"type":"text","text":" "},{"type":"text","text":"the app ended is most likely not stored again, whatever its "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":". RudderStack’s and"},{"type":"text","text":" "},{"type":"text","text":"Customer.io’s references don’t say whether they deduplicate. The record’s vendor identifier"},{"type":"text","text":" "},{"type":"text","text":"and trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"code":"context.ip","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"\"0.0.0.0\"","type":"codeVoice"},{"text":" in every call, which the spec reads as the user’s address, so","type":"text"},{"text":" ","type":"text"},{"text":"Segment records no address from the request. RudderStack fills in a ","type":"text"},{"code":"request_ip","type":"codeVoice"},{"text":" member from","type":"text"},{"text":" ","type":"text"},{"text":"the request unless the call has one, even when ","type":"text"},{"code":"context.ip","type":"codeVoice"},{"text":" is set, and passes it on to its","type":"text"},{"text":" ","type":"text"},{"text":"destinations, so RudderStack’s calls also carry ","type":"text"},{"code":"request_ip","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"\"0.0.0.0\"","type":"codeVoice"},{"text":". Customer.io’s","type":"text"},{"text":" ","type":"text"},{"text":"references don’t say whether ","type":"text"},{"code":"context.ip","type":"codeVoice"},{"text":" takes the place of the address it reads from an HTTP","type":"text"},{"text":" ","type":"text"},{"text":"request. No call to Segment or Customer.io carries ","type":"text"},{"code":"request_ip","type":"codeVoice"},{"text":", which their specs don’t have.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":", "},{"type":"codeVoice","code":"originalTimestamp"},{"type":"text","text":" or "},{"type":"codeVoice","code":"channel"},{"type":"text","text":" is sent. Without "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":" the endpoint takes"},{"type":"text","text":" "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":" as it is, uncorrected for the device’s clock; it is left out on purpose, as a"},{"type":"text","text":" "},{"type":"text","text":"retried request sends the same body again, whose "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":" would be the first attempt’s."},{"type":"text","text":" "},{"type":"text","text":"RudderStack, whose references list all three as required, fills them in from when it received"},{"type":"text","text":" "},{"type":"text","text":"the call."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context"},{"type":"text","text":" holds these members, for each of the keys the record’s context has a value for:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"app","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"namespace","type":"codeVoice"},{"type":"text","text":", the bundle identifier, "},{"code":"version","type":"codeVoice"},{"type":"text","text":" and "},{"code":"build","type":"codeVoice"},{"type":"text","text":", each left out when "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"; no "},{"code":"app","type":"codeVoice"},{"type":"text","text":" when all three are"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"device"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"model"},{"type":"text","text":", and "},{"type":"codeVoice","code":"type"},{"type":"text","text":", the platform as Segment’s Swift library names it: "},{"type":"codeVoice","code":"ios"},{"type":"text","text":" for a phone or pad, "},{"type":"codeVoice","code":"macos"},{"type":"text","text":", "},{"type":"codeVoice","code":"tvos"},{"type":"text","text":", "},{"type":"codeVoice","code":"watchos"},{"type":"text","text":" or "},{"type":"codeVoice","code":"visionos"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"locale","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"code":"en-US","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"network"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkKey"}]}],[{"type":"paragraph","inlineContent":[{"code":"wifi","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cellular","type":"codeVoice"},{"text":", whether the connection is each","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"os","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"name"},{"type":"text","text":" and "},{"type":"codeVoice","code":"version"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name is one of","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io’s semantic events, which delete or suppress people and devices, one whose event","type":"text"},{"text":" ","type":"text"},{"text":"isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp has no ISO 8601 form,","type":"text"},{"text":" ","type":"text"},{"text":"and one too large for a call (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError"},{"text":"). ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"},{"text":" returns them as","type":"text"},{"text":" ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/