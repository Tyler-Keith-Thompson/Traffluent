{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder"},"metadata":{"externalID":"s:19SegmentSpecEncoding0aB12BatchEncoderV","title":"SegmentSpecBatchEncoder","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentSpecBatchEncoder"}],"remoteSource":{"fileName":"SegmentSpecBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SegmentSpecEncoding\/SegmentSpecBatchEncoder.swift#L91"},"modules":[{"name":"SegmentSpecEncoding"}],"symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"text":"SegmentSpecBatchEncoder","kind":"identifier"}],"role":"symbol"},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/SegmentSpecEncoding\/s8SendableP","doc:\/\/SegmentSpecEncoding\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/segmentspecencoding\/segmentspecbatchencoder"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of the Segment spec’s batch call, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"can send events to Segment, RudderStack, Customer.io Data Pipelines, or another endpoint that","type":"text"},{"text":" ","type":"text"},{"text":"takes Segment’s ","type":"text"},{"code":"POST \/v1\/batch","type":"codeVoice"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentSpecBatchEncoder"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Make the destination with one of the factories, which fill in the endpoint, the credentials’","type":"text"},{"text":" ","type":"text"},{"text":"header field, this encoder and its limits:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)"],"type":"codeListing"},{"inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with one member, ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":", an array","type":"text"},{"text":" ","type":"text"},{"text":"of track calls, one per record, oldest first, with these members:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"anonymousId","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context, in the spec’s field names (below), and "},{"type":"codeVoice","code":"ip"},{"type":"text","text":" as "},{"type":"codeVoice","code":"\"0.0.0.0\""}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"messageId","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"request_ip"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":", in RudderStack’s calls alone"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601 with milliseconds, in UTC"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"track\"","type":"codeVoice"}]}]]],"type":"table"},{"inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"code":"userId","type":"codeVoice"},{"text":", no ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" call, no traits,","type":"text"},{"text":" ","type":"text"},{"text":"and no ","type":"text"},{"code":"context.device.id","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"advertisingId","type":"codeVoice"},{"text":". An endpoint counts a user per ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"its anonymous users are sessions. A record with no session (one tracked by a tracker without","type":"text"},{"text":" ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":") is its own anonymous user, linked to nothing: the spec rejects a call","type":"text"},{"text":" ","type":"text"},{"text":"with neither a ","type":"text"},{"code":"userId","type":"codeVoice"},{"text":" nor an ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":". A record a store recovers after a relaunch keeps","type":"text"},{"text":" ","type":"text"},{"text":"its session, so it goes out with the ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"messageId","type":"codeVoice"},{"text":" of its first send. Segment","type":"text"},{"text":" ","type":"text"},{"text":"deduplicates calls by ","type":"text"},{"code":"messageId","type":"codeVoice"},{"text":" over about the last 24 hours, and drops most duplicates","type":"text"},{"text":" ","type":"text"},{"text":"rather than all, so a recovered record Segment had already stored before the app ended is most","type":"text"},{"text":" ","type":"text"},{"text":"likely not stored again. RudderStack’s and Customer.io’s references don’t say whether they","type":"text"},{"text":" ","type":"text"},{"text":"deduplicate. The record’s vendor identifier","type":"text"},{"text":" ","type":"text"},{"text":"and trace context, and any other context value, aren’t sent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"context.ip","type":"codeVoice"},{"type":"text","text":" is "},{"code":"\"0.0.0.0\"","type":"codeVoice"},{"type":"text","text":" in every call, which the spec reads as the user’s address, so"},{"type":"text","text":" "},{"type":"text","text":"Segment records no address from the request. RudderStack fills in a "},{"code":"request_ip","type":"codeVoice"},{"type":"text","text":" member from"},{"type":"text","text":" "},{"type":"text","text":"the request unless the call has one, even when "},{"code":"context.ip","type":"codeVoice"},{"type":"text","text":" is set, and passes it on to its"},{"type":"text","text":" "},{"type":"text","text":"destinations, so RudderStack’s calls also carry "},{"code":"request_ip","type":"codeVoice"},{"type":"text","text":" as "},{"code":"\"0.0.0.0\"","type":"codeVoice"},{"type":"text","text":". Customer.io’s"},{"type":"text","text":" "},{"type":"text","text":"references don’t say whether "},{"code":"context.ip","type":"codeVoice"},{"type":"text","text":" takes the place of the address it reads from an HTTP"},{"type":"text","text":" "},{"type":"text","text":"request. No call to Segment or Customer.io carries "},{"code":"request_ip","type":"codeVoice"},{"type":"text","text":", which their specs don’t have."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":", "},{"type":"codeVoice","code":"originalTimestamp"},{"type":"text","text":" or "},{"type":"codeVoice","code":"channel"},{"type":"text","text":" is sent. Without "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":" the endpoint takes"},{"type":"text","text":" "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":" as it is, uncorrected for the device’s clock; it is left out on purpose, as a"},{"type":"text","text":" "},{"type":"text","text":"retried request sends the same body again, whose "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":" would be the first attempt’s."},{"type":"text","text":" "},{"type":"text","text":"RudderStack, whose references list all three as required, fills them in from when it received"},{"type":"text","text":" "},{"type":"text","text":"the call."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"code":"context","type":"codeVoice"},{"text":" holds these members, for each of the keys the record’s context has a value for:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"app","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"namespace","type":"codeVoice"},{"type":"text","text":", the bundle identifier, "},{"code":"version","type":"codeVoice"},{"type":"text","text":" and "},{"code":"build","type":"codeVoice"},{"type":"text","text":", each left out when "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"; no "},{"code":"app","type":"codeVoice"},{"type":"text","text":" when all three are"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"device","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"model"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"type"},{"text":", the platform as Segment’s Swift library names it: ","type":"text"},{"type":"codeVoice","code":"ios"},{"text":" for a phone or pad, ","type":"text"},{"type":"codeVoice","code":"macos"},{"text":", ","type":"text"},{"type":"codeVoice","code":"tvos"},{"text":", ","type":"text"},{"type":"codeVoice","code":"watchos"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"visionos"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"locale","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"type":"codeVoice","code":"en-US"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"network"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NetworkKey"}],"type":"paragraph"}],[{"inlineContent":[{"code":"wifi","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cellular","type":"codeVoice"},{"text":", whether the connection is each","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"os"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"name"},{"type":"text","text":" and "},{"type":"codeVoice","code":"version"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name is one of"},{"type":"text","text":" "},{"type":"text","text":"Customer.io’s semantic events, which delete or suppress people and devices, one whose event"},{"type":"text","text":" "},{"type":"text","text":"isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp has no ISO 8601 form,"},{"type":"text","text":" "},{"type":"text","text":"and one too large for a call ("},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError","isActive":true},{"type":"text","text":"). "},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as"},{"type":"text","text":" "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. A record sent again keeps its ","type":"text"},{"code":"messageId","type":"codeVoice"},{"text":". The bytes are the same for the same","type":"text"},{"text":" ","type":"text"},{"text":"records on every run and platform: no whitespace, object members in the order of their names’","type":"text"},{"text":" ","type":"text"},{"text":"UTF-8 bytes.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/init(plan:limit:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/Failure"],"title":"Type Aliases","generated":true,"anchor":"Type-Aliases"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/transientStatuses"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/outcome(of:for:)"],"title":"Type Methods","generated":true,"anchor":"Type-Methods"}],"references":{"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding":{"url":"\/documentation\/segmentspecencoding","title":"SegmentSpecEncoding","kind":"symbol","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","type":"topic","abstract":[{"type":"text","text":"Send records as Segment-spec track calls to Segment, RudderStack or Customer.io Data Pipelines."}],"role":"collection"},"doc://SegmentSpecEncoding/s16SendableMetatypeP":{"identifier":"doc:\/\/SegmentSpecEncoding\/s16SendableMetatypeP","title":"Swift.Se