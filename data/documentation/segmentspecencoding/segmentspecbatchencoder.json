rudderStack(writeKey:dataPlane:plan:backoff:clock:)","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","isActive":true},{"text":":","type":"text"}]},{"type":"codeListing","code":["let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with one member, ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":", an array","type":"text"},{"text":" ","type":"text"},{"text":"of track calls, one per record, oldest first, with these members:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"anonymousId"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"context","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The standard context, in the spec’s field names (below), and ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"\"0.0.0.0\"","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"messageId"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, by name"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"request_ip"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"0.0.0.0\""},{"text":", in RudderStack’s calls alone","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in ISO 8601 with milliseconds, in UTC","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"track\""}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"userId"},{"type":"text","text":", no "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" call, no traits,"},{"type":"text","text":" "},{"type":"text","text":"and no "},{"type":"codeVoice","code":"context.device.id"},{"type":"text","text":" or "},{"type":"codeVoice","code":"advertisingId"},{"type":"text","text":". An endpoint counts a user per "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"its anonymous users are sessions. A record with no session (one tracked by a tracker without"},{"type":"text","text":" "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store recovered after a relaunch, which keeps no context) is its"},{"type":"text","text":" "},{"type":"text","text":"own anonymous user, linked to nothing: the spec rejects a call with neither a "},{"type":"codeVoice","code":"userId"},{"type":"text","text":" nor an"},{"type":"text","text":" "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":". Segment deduplicates calls by "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":" over about the last 24 hours, and"},{"type":"text","text":" "},{"type":"text","text":"drops most duplicates rather than all, so a recovered record Segment had already stored before"},{"type":"text","text":" "},{"type":"text","text":"the app ended is most likely not stored again, whatever its "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":". RudderStack’s and"},{"type":"text","text":" "},{"type":"text","text":"Customer.io’s references don’t say whether they deduplicate. The record’s vendor identifier"},{"type":"text","text":" "},{"type":"text","text":"and trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context.ip"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"\"0.0.0.0\""},{"text":" in every call, which the spec reads as the user’s address, so","type":"text"},{"text":" ","type":"text"},{"text":"Segment records no address from the request. RudderStack fills in a ","type":"text"},{"type":"codeVoice","code":"request_ip"},{"text":" member from","type":"text"},{"text":" ","type":"text"},{"text":"the request unless the call has one, even when ","type":"text"},{"type":"codeVoice","code":"context.ip"},{"text":" is set, and passes it on to its","type":"text"},{"text":" ","type":"text"},{"text":"destinations, so RudderStack’s calls also carry ","type":"text"},{"type":"codeVoice","code":"request_ip"},{"text":" as ","type":"text"},{"type":"codeVoice","code":"\"0.0.0.0\""},{"text":". Customer.io’s","type":"text"},{"text":" ","type":"text"},{"text":"references don’t say whether ","type":"text"},{"type":"codeVoice","code":"context.ip"},{"text":" takes the place of the address it reads from an HTTP","type":"text"},{"text":" ","type":"text"},{"text":"request. No call to Segment or Customer.io carries ","type":"text"},{"type":"codeVoice","code":"request_ip"},{"text":", which their specs don’t have.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"No ","type":"text"},{"type":"codeVoice","code":"sentAt"},{"text":", ","type":"text"},{"type":"codeVoice","code":"originalTimestamp"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"channel"},{"text":" is sent. Without ","type":"text"},{"type":"codeVoice","code":"sentAt"},{"text":" the endpoint takes","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"timestamp"},{"text":" as it is, uncorrected for the device’s clock; it is left out on purpose, as a","type":"text"},{"text":" ","type":"text"},{"text":"retried request sends the same body again, whose ","type":"text"},{"type":"codeVoice","code":"sentAt"},{"text":" would be the first attempt’s.","type":"text"},{"text":" ","type":"text"},{"text":"RudderStack, whose references list all three as required, fills them in from when it received","type":"text"},{"text":" ","type":"text"},{"text":"the call.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context"},{"type":"text","text":" holds these members, for each of the keys the record’s context has a value for:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"app"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"namespace"},{"text":", the bundle identifier, ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"build"},{"text":", each left out when ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":"; no ","type":"text"},{"type":"codeVoice","code":"app"},{"text":" when all three are","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"device","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"model","type":"codeVoice"},{"type":"text","text":", and "},{"code":"type","type":"codeVoice"},{"type":"text","text":", the platform as Segment’s Swift library names it: "},{"code":"ios","type":"codeVoice"},{"type":"text","text":" for a phone or pad, "},{"code":"macos","type":"codeVoice"},{"type":"text","text":", "},{"code":"tvos","type":"codeVoice"},{"type":"text","text":", "},{"code":"watchos","type":"codeVoice"},{"type":"text","text":" or "},{"code":"visionos","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"locale","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"code":"en-US","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"network"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"wifi"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cellular"},{"type":"text","text":", whether the connection is each"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"os","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"code":"name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"version","type":"codeVoice"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name is one of","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io’s semantic events, which delete or suppress people and devices, one whose event","type":"text"},{"text":" ","type":"text"},{"text":"isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp has no ISO 8601 form,","type":"text"},{"text":" ","type":"text"},{"text":"and one too large for a call (","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError","isActive":true,"type":"reference"},{"text":"). ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" returns them as","type":"text"},{"text":" ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. A record sent again keeps its ","type":"text"},{"code":"messageId","type":"codeVoice"},{"text":". The bytes are the same for the same","type":"text"},{"text":" ","type":"text"},{"text":"records on every run and platform: no whitespace, object members in the order of their names’","type":"text"},{"text":" ","type":"text"},{"text":"UTF-8 bytes.","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/segmentspecencoding\/segmentspecbatchencoder"]}],"identifier":{"url":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/init(plan:limit:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for