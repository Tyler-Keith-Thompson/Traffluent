{"sections":[],"hierarchy":{"paths":[["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"]]},"abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of the Segment spec’s batch call, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to Segment, RudderStack, Customer.io Data Pipelines, or another endpoint that"},{"type":"text","text":" "},{"type":"text","text":"takes Segment’s "},{"type":"codeVoice","code":"POST \/v1\/batch"},{"type":"text","text":"."}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/init(plan:limit:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/Failure"],"title":"Type Aliases","anchor":"Type-Aliases"},{"generated":true,"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit"],"title":"Type Properties","anchor":"Type-Properties"}],"variants":[{"paths":["\/documentation\/segmentspecencoding\/segmentspecbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder"},"kind":"symbol","metadata":{"title":"SegmentSpecBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentSpecBatchEncoder","kind":"identifier"}],"externalID":"s:19SegmentSpecEncoding0aB12BatchEncoderV","modules":[{"name":"SegmentSpecEncoding"}],"roleHeading":"Structure","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SegmentSpecEncoding\/SegmentSpecBatchEncoder.swift#L90","fileName":"SegmentSpecBatchEncoder.swift"},"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SegmentSpecBatchEncoder"}]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/SegmentSpecEncoding\/s8SendableP","doc:\/\/SegmentSpecEncoding\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentSpecBatchEncoder","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with one of the factories, which fill in the endpoint, the credentials’"},{"type":"text","text":" "},{"type":"text","text":"header field, this encoder and its limits:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":" with one member, "},{"type":"codeVoice","code":"batch"},{"type":"text","text":", an array"},{"type":"text","text":" "},{"type":"text","text":"of track calls, one per record, oldest first, with these members:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"anonymousId"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context"}]}],[{"type":"paragraph","inlineContent":[{"text":"The standard context, in the spec’s field names (below), and ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"\"0.0.0.0\"","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"messageId"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"request_ip"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"0.0.0.0\"","type":"codeVoice"},{"type":"text","text":", in RudderStack’s calls alone"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601 with milliseconds, in UTC"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"type"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"track\"","type":"codeVoice"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"code":"userId","type":"codeVoice"},{"type":"text","text":", no "},{"code":"identify","type":"codeVoice"},{"type":"text","text":" call, no traits,"},{"type":"text","text":" "},{"type":"text","text":"and no "},{"code":"context.device.id","type":"codeVoice"},{"type":"text","text":" or "},{"code":"advertisingId","type":"codeVoice"},{"type":"text","text":". An endpoint counts a user per "},{"code":"anonymousId","type":"codeVoice"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"its anonymous users are sessions. A record with no session (one tracked by a tracker without"},{"type":"text","text":" "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":", or one a store recovered after a relaunch, which keeps no context) is its"},{"type":"text","text":" "},{"type":"text","text":"own anonymous user, linked to nothing: the spec rejects a call with neither a "},{"code":"userId","type":"codeVoice"},{"type":"text","text":" nor an"},{"type":"text","text":" "},{"code":"anonymousId","type":"codeVoice"},{"type":"text","text":". Segment deduplicates calls by "},{"code":"messageId","type":"codeVoice"},{"type":"text","text":" over about the last 24 hours, and"},{"type":"text","text":" "},{"type":"text","text":"drops most duplicates rather than all, so a recovered record Segment had already stored before"},{"type":"text","text":" "},{"type":"text","text":"the app ended is most likely not stored again, whatever its "},{"code":"anonymousId","type":"codeVoice"},{"type":"text","text":". RudderStack’s and"},{"type":"text","text":" "},{"type":"text","text":"Customer.io’s references don’t say whether they deduplicate. The record’s vendor identifier"},{"type":"text","text":" "},{"type":"text","text":"and trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" is "},{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":" in every call, which the spec reads as the user’s address, so"},{"type":"text","text":" "},{"type":"text","text":"Segment records no address from the request. RudderStack fills in a "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" member from"},{"type":"text","text":" "},{"type":"text","text":"the request unless the call has one, even when "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" is set, and passes it on to its"},{"type":"text","text":" "},{"type":"text","text":"destinations, so RudderStack’s calls also carry "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" as "},{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":". Customer.io’s"},{"type":"text","text":" "},{"type":"text","text":"references don’t say whether "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" takes the place of the address it reads from an HTTP"},{"type":"text","text":" "},{"type":"text","text":"request. No call to Segment or Customer.io carries "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":", which their specs don’t have."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":", "},{"type":"codeVoice","code":"originalTimestamp"},{"type":"text","text":" or "},{"type":"codeVoice","code":"channel"},{"type":"text","text":" is sent. Without "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":" the endpoint takes"},{"type":"text","text":" "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":" as it is, uncorrected for the device’s clock; it is left out on purpose, as a"},{"type":"text","text":" "},{"type":"text","text":"retried request sends the same body again, whose "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":" would be the first attempt’s."},{"type":"text","text":" "},{"type":"text","text":"RudderStack, whose references list all three as required, fills them in from when it received"},{"type":"text","text":" "},{"type":"text","text":"the call."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context"},{"type":"text","text":" holds these members, for each of the keys the record’s context has a value for:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"app","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"namespace"},{"text":", the bundle identifier, ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"build"},{"text":", each left out when ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":"; no ","type":"text"},{"type":"codeVoice","code":"app"},{"text":" when all three are","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"device"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"model"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"type"},{"text":", the platform as Segment’s Swift library names it: ","type":"text"},{"type":"codeVoice","code":"ios"},{"text":" for a phone or pad, ","type":"text"},{"type":"codeVoice","code":"macos"},{"text":", ","type":"text"},{"type":"codeVoice","code":"tvos"},{"text":", ","type":"text"},{"type":"codeVoice","code":"watchos"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"visionos"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"locale"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"type":"codeVoice","code":"en-US"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"network","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NetworkKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"wifi","type":"codeVoice"},{"type":"text","text":" and "},{"code":"cellular","type":"codeVoice"},{"type":"text","text":", whether the connection is each"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"os","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"version","type":"codeVoice"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event name is one of","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io’s semantic events, which delete or suppress people and devices, one whose event","type":"text"},{"text":" ","type":"text"},{"text":"isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds a value JSON can’t, one whose timestamp has no ISO 8601 form,","type":"text"},{"text":" ","type":"text"},{"text":"and one too large for a call (","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError","type":"reference"},{"text":"). ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)","type":"reference"},{"text":" returns them as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. A record sent again keeps its "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":". The bytes are the same for the same"},{"type":"text","text":" "},{"type":"text","text":"records on every run and platform: no whitespace, object members in the order of their names’"},{"type":"text","text":" "},{"type":"text","text":"UTF-8 bytes."}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/SegmentSpecEncodingError":{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError","title":"SegmentSpecEncodingError","role":"symbol","abstract":[{"text":"Why ","type":"text"},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","isActive":true},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for the batch.","type":"text"}],"url":"\/documentation\/segmentspecencodin