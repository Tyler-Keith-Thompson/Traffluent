{"hierarchy":{"paths":[["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"]]},"abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of the Segment spec’s batch call, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"can send events to Segment, RudderStack, Customer.io Data Pipelines, or another endpoint that"},{"type":"text","text":" "},{"type":"text","text":"takes Segment’s "},{"code":"POST \/v1\/batch","type":"codeVoice"},{"type":"text","text":"."}],"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentSpecBatchEncoder"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Make the destination with one of the factories, which fill in the endpoint, the credentials’","type":"text"},{"text":" ","type":"text"},{"text":"header field, this encoder and its limits:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","type":"reference","isActive":true},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":" with one member, "},{"code":"batch","type":"codeVoice"},{"type":"text","text":", an array"},{"type":"text","text":" "},{"type":"text","text":"of track calls, one per record, oldest first, with these members:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"anonymousId"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context"}]}],[{"type":"paragraph","inlineContent":[{"text":"The standard context, in the spec’s field names (below), and ","type":"text"},{"type":"codeVoice","code":"ip"},{"text":" as ","type":"text"},{"type":"codeVoice","code":"\"0.0.0.0\""}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"messageId"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"request_ip"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":", in RudderStack’s calls alone"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in ISO 8601 with milliseconds, in UTC","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"type"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"track\""}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"code":"userId","type":"codeVoice"},{"text":", no ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" call, no traits,","type":"text"},{"text":" ","type":"text"},{"text":"and no ","type":"text"},{"code":"context.device.id","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"advertisingId","type":"codeVoice"},{"text":". An endpoint counts a user per ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"its anonymous users are sessions. A record with no session (one tracked by a tracker without","type":"text"},{"text":" ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":", or one a store recovered after a relaunch, which keeps no context) is its","type":"text"},{"text":" ","type":"text"},{"text":"own anonymous user, linked to nothing: the spec rejects a call with neither a ","type":"text"},{"code":"userId","type":"codeVoice"},{"text":" nor an","type":"text"},{"text":" ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":". Segment deduplicates calls by ","type":"text"},{"code":"messageId","type":"codeVoice"},{"text":" over about the last 24 hours, and","type":"text"},{"text":" ","type":"text"},{"text":"drops most duplicates rather than all, so a recovered record Segment had already stored before","type":"text"},{"text":" ","type":"text"},{"text":"the app ended is most likely not stored again, whatever its ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":". RudderStack’s and","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io’s references don’t say whether they deduplicate. The record’s vendor identifier","type":"text"},{"text":" ","type":"text"},{"text":"and trace context, and any other context value, aren’t sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"context.ip","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"\"0.0.0.0\"","type":"codeVoice"},{"text":" in every call, which the spec reads as the user’s address, so","type":"text"},{"text":" ","type":"text"},{"text":"Segment records no address from the request. RudderStack fills in a ","type":"text"},{"code":"request_ip","type":"codeVoice"},{"text":" member from","type":"text"},{"text":" ","type":"text"},{"text":"the request unless the call has one, even when ","type":"text"},{"code":"context.ip","type":"codeVoice"},{"text":" is set, and passes it on to its","type":"text"},{"text":" ","type":"text"},{"text":"destinations, so RudderStack’s calls also carry ","type":"text"},{"code":"request_ip","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"\"0.0.0.0\"","type":"codeVoice"},{"text":". Customer.io’s","type":"text"},{"text":" ","type":"text"},{"text":"references don’t say whether ","type":"text"},{"code":"context.ip","type":"codeVoice"},{"text":" takes the place of the address it reads from an HTTP","type":"text"},{"text":" ","type":"text"},{"text":"request. No call to Segment or Customer.io carries ","type":"text"},{"code":"request_ip","type":"codeVoice"},{"text":", which their specs don’t have.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"No ","type":"text"},{"type":"codeVoice","code":"sentAt"},{"text":", ","type":"text"},{"type":"codeVoice","code":"originalTimestamp"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"channel"},{"text":" is sent. Without ","type":"text"},{"type":"codeVoice","code":"sentAt"},{"text":" the endpoint takes","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"timestamp"},{"text":" as it is, uncorrected for the device’s clock; it is left out on purpose, as a","type":"text"},{"text":" ","type":"text"},{"text":"retried request sends the same body again, whose ","type":"text"},{"type":"codeVoice","code":"sentAt"},{"text":" would be the first attempt’s.","type":"text"},{"text":" ","type":"text"},{"text":"RudderStack, whose references list all three as required, fills them in from when it received","type":"text"},{"text":" ","type":"text"},{"text":"the call.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"code":"context","type":"codeVoice"},{"type":"text","text":" holds these members, for each of the keys the record’s context has a value for:"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"app","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"namespace"},{"text":", the bundle identifier, ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"build"},{"text":", each left out when ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":"; no ","type":"text"},{"type":"codeVoice","code":"app"},{"text":" when all three are","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"device"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"code":"model","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"type","type":"codeVoice"},{"text":", the platform as Segment’s Swift library names it: ","type":"text"},{"code":"ios","type":"codeVoice"},{"text":" for a phone or pad, ","type":"text"},{"code":"macos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tvos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"watchos","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"visionos","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"locale","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"code":"en-US","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"network","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NetworkKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"wifi","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cellular","type":"codeVoice"},{"text":", whether the connection is each","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"os"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"name"},{"type":"text","text":" and "},{"type":"codeVoice","code":"version"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name is one of"},{"type":"text","text":" "},{"type":"text","text":"Customer.io’s semantic events, which delete or suppress people and devices, one whose event"},{"type":"text","text":" "},{"type":"text","text":"isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp has no ISO 8601 form,"},{"type":"text","text":" "},{"type":"text","text":"and one too large for a call ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError"},{"type":"text","text":"). "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"},{"type":"text","text":" returns them as"},{"type":"text","text":" "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. A record sent again keeps its "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":". The bytes are the same for the same"},{"type":"text","text":" "},{"type":"text","text":"records on every run and platform: no whitespace, object members in the order of their names’"},{"type":"text","text":" "},{"type":"text","text":"UTF-8 bytes."}]}],"kind":"content"}],"metadata":{"symbolKind":"struct","title":"SegmentSpecBatchEncoder","navigatorTitle":[{"kind":"identifier","text":"SegmentSpecBatchEncoder"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentSpecBatchEncoder","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SegmentSpecEncoding\/SegmentSpecBatchEncoder.swift#L90","fileName":"SegmentSpecBatchEncoder.swift"},"externalID":"s:19SegmentSpecEncoding0aB12BatchEncoderV","roleHeading":"Structure","role":"symbol","modules":[{"name":"SegmentSpecEncoding"}]},"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/SegmentSpecEncoding\/s8SendableP","doc:\/\/SegmentSpecEncoding\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/Segme