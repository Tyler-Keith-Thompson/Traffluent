{"hierarchy":{"paths":[["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"]]},"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of the Segment spec’s batch call, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"can send events to Segment, RudderStack, Customer.io Data Pipelines, or another endpoint that","type":"text"},{"text":" ","type":"text"},{"text":"takes Segment’s ","type":"text"},{"code":"POST \/v1\/batch","type":"codeVoice"},{"text":".","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/init(plan:limit:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/Failure"],"title":"Type Aliases","generated":true,"anchor":"Type-Aliases"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/transientStatuses"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/outcome(of:for:)"],"title":"Type Methods","generated":true,"anchor":"Type-Methods"}],"kind":"symbol","identifier":{"url":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/segmentspecencoding\/segmentspecbatchencoder"]}],"metadata":{"remoteSource":{"fileName":"SegmentSpecBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SegmentSpecEncoding\/SegmentSpecBatchEncoder.swift#L91"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentSpecBatchEncoder","kind":"identifier"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"SegmentSpecBatchEncoder"}],"modules":[{"name":"SegmentSpecEncoding"}],"title":"SegmentSpecBatchEncoder","roleHeading":"Structure","role":"symbol","externalID":"s:19SegmentSpecEncoding0aB12BatchEncoderV"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentSpecBatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with one of the factories, which fill in the endpoint, the credentials’"},{"type":"text","text":" "},{"type":"text","text":"header field, this encoder and its limits:"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":" with one member, "},{"type":"codeVoice","code":"batch"},{"type":"text","text":", an array"},{"type":"text","text":" "},{"type":"text","text":"of track calls, one per record, oldest first, with these members:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"anonymousId"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context, in the spec’s field names (below), and "},{"type":"codeVoice","code":"ip"},{"type":"text","text":" as "},{"type":"codeVoice","code":"\"0.0.0.0\""}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"messageId"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, by name"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"request_ip","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":", in RudderStack’s calls alone"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601 with milliseconds, in UTC"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"track\"","type":"codeVoice"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"userId"},{"type":"text","text":", no "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" call, no traits,"},{"type":"text","text":" "},{"type":"text","text":"and no "},{"type":"codeVoice","code":"context.device.id"},{"type":"text","text":" or "},{"type":"codeVoice","code":"advertisingId"},{"type":"text","text":". An endpoint counts a user per "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"its anonymous users are sessions. A record with no session (one tracked by a tracker without"},{"type":"text","text":" "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is its own anonymous user, linked to nothing: the spec rejects a call"},{"type":"text","text":" "},{"type":"text","text":"with neither a "},{"type":"codeVoice","code":"userId"},{"type":"text","text":" nor an "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":". A record a store recovers after a relaunch keeps"},{"type":"text","text":" "},{"type":"text","text":"its session, so it goes out with the "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":" and "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":" of its first send. Segment"},{"type":"text","text":" "},{"type":"text","text":"deduplicates calls by "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":" over about the last 24 hours, and drops most duplicates"},{"type":"text","text":" "},{"type":"text","text":"rather than all, so a recovered record Segment had already stored before the app ended is most"},{"type":"text","text":" "},{"type":"text","text":"likely not stored again. RudderStack’s and Customer.io’s references don’t say whether they"},{"type":"text","text":" "},{"type":"text","text":"deduplicate. The record’s vendor identifier"},{"type":"text","text":" "},{"type":"text","text":"and trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"code":"context.ip","type":"codeVoice"},{"type":"text","text":" is "},{"code":"\"0.0.0.0\"","type":"codeVoice"},{"type":"text","text":" in every call, which the spec reads as the user’s address, so"},{"type":"text","text":" "},{"type":"text","text":"Segment records no address from the request. RudderStack fills in a "},{"code":"request_ip","type":"codeVoice"},{"type":"text","text":" member from"},{"type":"text","text":" "},{"type":"text","text":"the request unless the call has one, even when "},{"code":"context.ip","type":"codeVoice"},{"type":"text","text":" is set, and passes it on to its"},{"type":"text","text":" "},{"type":"text","text":"destinations, so RudderStack’s calls also carry "},{"code":"request_ip","type":"codeVoice"},{"type":"text","text":" as "},{"code":"\"0.0.0.0\"","type":"codeVoice"},{"type":"text","text":". Customer.io’s"},{"type":"text","text":" "},{"type":"text","text":"references don’t say whether "},{"code":"context.ip","type":"codeVoice"},{"type":"text","text":" takes the place of the address it reads from an HTTP"},{"type":"text","text":" "},{"type":"text","text":"request. No call to Segment or Customer.io carries "},{"code":"request_ip","type":"codeVoice"},{"type":"text","text":", which their specs don’t have."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":", "},{"type":"codeVoice","code":"originalTimestamp"},{"type":"text","text":" or "},{"type":"codeVoice","code":"channel"},{"type":"text","text":" is sent. Without "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":" the endpoint takes"},{"type":"text","text":" "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":" as it is, uncorrected for the device’s clock; it is left out on purpose, as a"},{"type":"text","text":" "},{"type":"text","text":"retried request sends the same body again, whose "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":" would be the first attempt’s."},{"type":"text","text":" "},{"type":"text","text":"RudderStack, whose references list all three as required, fills them in from when it received"},{"type":"text","text":" "},{"type":"text","text":"the call."}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context"},{"text":" holds these members, for each of the keys the record’s context has a value for:","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"app","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"namespace","type":"codeVoice"},{"type":"text","text":", the bundle identifier, "},{"code":"version","type":"codeVoice"},{"type":"text","text":" and "},{"code":"build","type":"codeVoice"},{"type":"text","text":", each left out when "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"; no "},{"code":"app","type":"codeVoice"},{"type":"text","text":" when all three are"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"device","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"model"},{"type":"text","text":", and "},{"type":"codeVoice","code":"type"},{"type":"text","text":", the platform as Segment’s Swift library names it: "},{"type":"codeVoice","code":"ios"},{"type":"text","text":" for a phone or pad, "},{"type":"codeVoice","code":"macos"},{"type":"text","text":", "},{"type":"codeVoice","code":"tvos"},{"type":"text","text":", "},{"type":"codeVoice","code":"watchos"},{"type":"text","text":" or "},{"type":"codeVoice","code":"visionos"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"locale","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"type":"codeVoice","code":"en-US"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"network"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NetworkKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"wifi"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cellular"},{"text":", whether the connection is each","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"os"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"name"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"version"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name is one of","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io’s semantic events, which delete or suppress people and devices, one whose event","type":"text"},{"text":" ","type":"text"},{"text":"isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp has no ISO 8601 form,","type":"text"},{"text":" ","type":"text"},{"text":"and one too large for a call (","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError","type":"reference"},{"text":"). ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)","type":"reference"},{"text":" returns them as","type":"text"},{"text":" ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","typ