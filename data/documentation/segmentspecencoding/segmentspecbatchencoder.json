oice","code":"EventRecord\/id"},{"text":" when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"context","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context, in the spec’s field names (below), and "},{"code":"ip","type":"codeVoice"},{"type":"text","text":" as "},{"code":"\"0.0.0.0\"","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"messageId"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"request_ip"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":", in RudderStack’s calls alone"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601 with milliseconds, in UTC"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"track\""}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"code":"userId","type":"codeVoice"},{"text":", no ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" call, no traits,","type":"text"},{"text":" ","type":"text"},{"text":"and no ","type":"text"},{"code":"context.device.id","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"advertisingId","type":"codeVoice"},{"text":". An endpoint counts a user per ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"its anonymous users are sessions. A record with no session (one tracked by a tracker without","type":"text"},{"text":" ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":") is its own anonymous user, linked to nothing: the spec rejects a call","type":"text"},{"text":" ","type":"text"},{"text":"with neither a ","type":"text"},{"code":"userId","type":"codeVoice"},{"text":" nor an ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":". A record a store recovers after a relaunch keeps","type":"text"},{"text":" ","type":"text"},{"text":"its session, so it goes out with the ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"messageId","type":"codeVoice"},{"text":" of its first send. Segment","type":"text"},{"text":" ","type":"text"},{"text":"deduplicates calls by ","type":"text"},{"code":"messageId","type":"codeVoice"},{"text":" over about the last 24 hours, and drops most duplicates","type":"text"},{"text":" ","type":"text"},{"text":"rather than all, so a recovered record Segment had already stored before the app ended is most","type":"text"},{"text":" ","type":"text"},{"text":"likely not stored again. RudderStack’s and Customer.io’s references don’t say whether they","type":"text"},{"text":" ","type":"text"},{"text":"deduplicate. The record’s vendor identifier","type":"text"},{"text":" ","type":"text"},{"text":"and trace context, and any other context value, aren’t sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"context.ip","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"\"0.0.0.0\"","type":"codeVoice"},{"text":" in every call, which the spec reads as the user’s address, so","type":"text"},{"text":" ","type":"text"},{"text":"Segment records no address from the request. RudderStack fills in a ","type":"text"},{"code":"request_ip","type":"codeVoice"},{"text":" member from","type":"text"},{"text":" ","type":"text"},{"text":"the request unless the call has one, even when ","type":"text"},{"code":"context.ip","type":"codeVoice"},{"text":" is set, and passes it on to its","type":"text"},{"text":" ","type":"text"},{"text":"destinations, so RudderStack’s calls also carry ","type":"text"},{"code":"request_ip","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"\"0.0.0.0\"","type":"codeVoice"},{"text":". Customer.io’s","type":"text"},{"text":" ","type":"text"},{"text":"references don’t say whether ","type":"text"},{"code":"context.ip","type":"codeVoice"},{"text":" takes the place of the address it reads from an HTTP","type":"text"},{"text":" ","type":"text"},{"text":"request. No call to Segment or Customer.io carries ","type":"text"},{"code":"request_ip","type":"codeVoice"},{"text":", which their specs don’t have.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"No ","type":"text"},{"code":"sentAt","type":"codeVoice"},{"text":", ","type":"text"},{"code":"originalTimestamp","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"channel","type":"codeVoice"},{"text":" is sent. Without ","type":"text"},{"code":"sentAt","type":"codeVoice"},{"text":" the endpoint takes","type":"text"},{"text":" ","type":"text"},{"code":"timestamp","type":"codeVoice"},{"text":" as it is, uncorrected for the device’s clock; it is left out on purpose, as a","type":"text"},{"text":" ","type":"text"},{"text":"retried request sends the same body again, whose ","type":"text"},{"code":"sentAt","type":"codeVoice"},{"text":" would be the first attempt’s.","type":"text"},{"text":" ","type":"text"},{"text":"RudderStack, whose references list all three as required, fills them in from when it received","type":"text"},{"text":" ","type":"text"},{"text":"the call.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context"},{"type":"text","text":" holds these members, for each of the keys the record’s context has a value for:"}]},{"rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"app","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"namespace"},{"type":"text","text":", the bundle identifier, "},{"type":"codeVoice","code":"version"},{"type":"text","text":" and "},{"type":"codeVoice","code":"build"},{"type":"text","text":", each left out when "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"; no "},{"type":"codeVoice","code":"app"},{"type":"text","text":" when all three are"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"device"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type"