{"kind":"symbol","metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SegmentSpecEncoding\/SegmentSpecBatchEncoder.swift#L90","fileName":"SegmentSpecBatchEncoder.swift"},"externalID":"s:19SegmentSpecEncoding0aB12BatchEncoderV","role":"symbol","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentSpecBatchEncoder","kind":"identifier"}],"modules":[{"name":"SegmentSpecEncoding"}],"title":"SegmentSpecBatchEncoder","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"SegmentSpecBatchEncoder"}]},"variants":[{"paths":["\/documentation\/segmentspecencoding\/segmentspecbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"]]},"abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" of the Segment spec’s batch call, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"can send events to Segment, RudderStack, Customer.io Data Pipelines, or another endpoint that"},{"type":"text","text":" "},{"type":"text","text":"takes Segment’s "},{"code":"POST \/v1\/batch","type":"codeVoice"},{"type":"text","text":"."}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/init(plan:limit:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Type Aliases","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/Failure"],"generated":true,"anchor":"Type-Aliases"},{"title":"Type Properties","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit"],"generated":true,"anchor":"Type-Properties"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder"},"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/SegmentSpecEncoding\/s8SendableP","doc:\/\/SegmentSpecEncoding\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentSpecBatchEncoder","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Make the destination with one of the factories, which fill in the endpoint, the credentials’"},{"type":"text","text":" "},{"type":"text","text":"header field, this encoder and its limits:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":" with one member, "},{"type":"codeVoice","code":"batch"},{"type":"text","text":", an array"},{"type":"text","text":" "},{"type":"text","text":"of track calls, one per record, oldest first, with these members:"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"anonymousId","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context"}]}],[{"type":"paragraph","inlineContent":[{"text":"The standard context, in the spec’s field names (below), and ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"\"0.0.0.0\"","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"messageId"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, by name"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"request_ip","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":", in RudderStack’s calls alone"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601 with milliseconds, in UTC"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"track\"","type":"codeVoice"}]}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"userId"},{"type":"text","text":", no "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" call, no traits,"},{"type":"text","text":" "},{"type":"text","text":"and no "},{"type":"codeVoice","code":"context.device.id"},{"type":"text","text":" or "},{"type":"codeVoice","code":"advertisingId"},{"type":"text","text":". An endpoint counts a user per "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"its anonymous users are sessions. A record with no session (one tracked by a tracker without"},{"type":"text","text":" "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store recovered after a relaunch, which keeps no context) is its"},{"type":"text","text":" "},{"type":"text","text":"own anonymous user, linked to nothing: the spec rejects a call with neither a "},{"type":"codeVoice","code":"userId"},{"type":"text","text":" nor an"},{"type":"text","text":" "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":". Segment deduplicates calls by "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":" over about the last 24 hours, and"},{"type":"text","text":" "},{"type":"text","text":"drops most duplicates rather than all, so a recovered record Segment had already stored before"},{"type":"text","text":" "},{"type":"text","text":"the app ended is most likely not stored again, whatever its "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":". RudderStack’s and"},{"type":"text","text":" "},{"type":"text","text":"Customer.io’s references don’t say whether they deduplicate. The record’s vendor identifier"},{"type":"text","text":" "},{"type":"text","text":"and trace context, and any other context value, aren’t sent."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" is "},{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":" in every call, which the spec reads as the user’s address, so"},{"type":"text","text":" "},{"type":"text","text":"Segment records no address from the request. RudderStack fills in a "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" member from"},{"type":"text","text":" "},{"type":"text","text":"the request unless the call has one, even when "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" is set, and passes it on to its"},{"type":"text","text":" "},{"type":"text","text":"destinations, so RudderStack’s calls also carry "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" as "},{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":". Customer.io’s"},{"type":"text","text":" "},{"type":"text","text":"references don’t say whether "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" takes the place of the address it reads from an HTTP"},{"type":"text","text":" "},{"type":"text","text":"request. No call to Segment or Customer.io carries "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":", which their specs don’t have."}],"type":"paragraph"},{"inlineContent":[{"text":"No ","type":"text"},{"code":"sentAt","type":"codeVoice"},{"text":", ","type":"text"},{"code":"originalTimestamp","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"channel","type":"codeVoice"},{"text":" is sent. Without ","type":"text"},{"code":"sentAt","type":"codeVoice"},{"text":" the endpoint takes","type":"text"},{"text":" ","type":"text"},{"code":"timestamp","type":"codeVoice"},{"text":" as it is, uncorrected for the device’s clock; it is left out on purpose, as a","type":"text"},{"text":" ","type":"text"},{"text":"retried request sends the same body again, whose ","type":"text"},{"code":"sentAt","type":"codeVoice"},{"text":" would be the first attempt’s.","type":"text"},{"text":" ","type":"text"},{"text":"RudderStack, whose references list all three as required, fills them in from when it received","type":"text"},{"text":" ","type":"text"},{"text":"the call.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"context"},{"text":" holds these members, for each of the keys the record’s context has a value for:","type":"text"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"app"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"namespace"},{"type":"text","text":", the bundle identifier, "},{"type":"codeVoice","code":"version"},{"type":"text","text":" and "},{"type":"codeVoice","code":"build"},{"type":"text","text":", each left out when "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"; no "},{"type":"codeVoice","code":"app"},{"type":"text","text":" when all three are"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"device"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"code":"model","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"type","type":"codeVoice"},{"text":", the platform as Segment’s Swift library names it: ","type":"text"},{"code":"ios","type":"codeVoice"},{"text":" for a phone or pad, ","type":"text"},{"code":"macos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tvos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"watchos","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"visionos","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"locale","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"type":"codeVoice","code":"en-US"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"network"}]}],[{"type":"paragraph","inlineContent":[{"code":"NetworkKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"wifi","type":"codeVoice"},{"type":"text","text":" and "},{"code":"cellular","type":"codeVoice"},{"type":"text","text":", whether the connection is each"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"os","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"name","type":"codeVoice"},{"type":"text","text":" and "},{"code":"version","type":"codeVoice"}]}]]],"header":"row"},{"inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name is one of","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io’s semantic events, which delete or suppress people and devices, one whose event","type":"text"},{"text":" ","type":"text"},{"text":"isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp has no ISO 8601 form,","type":"text"},{"text":" ","type":"text"},{"text":"and one too large for a call (","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError","type":"reference"},{"text":"). ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)","type":"reference"},{"text":" returns them as","type":"text"},{"text":" ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. A record sent again keeps its "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":". The bytes are the same for the same"},{"type":"text","text":" "},{"type":"text","text":"records on every run and platform: no whitespace, object members in the order of their names’"},{"type":"text","text":" "},{"type":"text","text":"UTF-8 bytes."}],"type":"paragraph"}]}],"references":{"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/SegmentSpecBatchEncoder/init(plan:limit:)":{"title":"init(plan:limit:)","abstract":[{"type":"text","text":"An encoder of the events "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, splitting each batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":"."}],"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/init(plan:limit:)","url":"\/documentation\/segmentspecencoding\/segmentspecbatchencoder\/init(plan:limit:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON