one of the factories, which fill in the endpoint, the credentials’"},{"type":"text","text":" "},{"type":"text","text":"header field, this encoder and its limits:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)"},{"type":"text","text":":"}]},{"code":["let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":" with one member, "},{"code":"batch","type":"codeVoice"},{"type":"text","text":", an array"},{"type":"text","text":" "},{"type":"text","text":"of track calls, one per record, oldest first, with these members:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"anonymousId","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"context","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The standard context, in the spec’s field names (below), and ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"\"0.0.0.0\"","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"messageId"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"request_ip","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":", in RudderStack’s calls alone"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in ISO 8601 with milliseconds, in UTC","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"track\""}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"code":"userId","type":"codeVoice"},{"text":", no ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" call, no traits,","type":"text"},{"text":" ","type":"text"},{"text":"and no ","type":"text"},{"code":"context.device.id","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"advertisingId","type":"codeVoice"},{"text":". An endpoint counts a user per ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"its anonymous users are sessions. A record with no session (one tracked by a tracker without","type":"text"},{"text":" ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":") is its own anonymous user, linked to nothing: the spec rejects a call","type":"text"},{"text":" ","type":"text"},{"text":"with neither a ","type":"text"},{"code":"userId","type":"codeVoice"},{"text":" nor an ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":". A record a store recovers after a relaunch keeps","type":"text"},{"text":" ","type":"text"},{"text":"its session, so it goes out with the ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"messageId","type":"codeVoice"},{"text":" of its first send. Segment","type":"text"},{"text":" ","type":"text"},{"text":"deduplicates calls by ","type":"text"},{"code":"messageId","type":"codeVoice"},{"text":" over about the last 24 hours, and drops most duplicates","type":"text"},{"text":" ","type":"text"},{"text":"rather than all, so a recovered record Segment had already stored before the app ended is most","type":"text"},{"text":" ","type":"text"},{"text":"likely not stored again. RudderStack’s and Customer.io’s references don’t say whether they","type":"text"},{"text":" ","type":"text"},{"text":"deduplicate. The record’s vendor identifier","type":"text"},{"text":" ","type":"text"},{"text":"and trace context, and any other context value, aren’t sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" is "},{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":" in every call, which the spec reads as the user’s address, so"},{"type":"text","text":" "},{"type":"text","text":"Segment records no address from the request. RudderStack fills in a "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" member from"},{"type":"text","text":" "},{"type":"text","text":"the request unless the call has one, even when "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" is set, and passes it on to its"},{"type":"text","text":" "},{"type":"text","text":"destinations, so RudderStack’s calls also carry "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" as "},{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":". Customer.io’s"},{"type":"text","text":" "},{"type":"text","text":"references don’t say whether "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" takes the place of the address it reads from an HTTP"},{"type":"text","text":" "},{"type":"text","text":"request. No call to Segment or Customer.io carries "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":", which their specs don’t have."}]},{"type":"paragraph","inlineContent":[{"text":"No ","type":"text"},{"code":"sentAt","type":"codeVoice"},{"text":", ","type":"text"},{"code":"originalTimestamp","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"channel","type":"codeVoice"},{"text":" is sent. Without ","type":"text"},{"code":"sentAt","type":"codeVoice"},{"text":" the endpoint takes","type":"text"},{"text":" ","type":"text"},{"code":"timestamp","type":"codeVoice"},{"text":" as it is, uncorrected for the device’s clock; it is left out on purpose, as a","type":"text"},{"text":" ","type":"text"},{"text":"retried request sends the same body again, whose ","type":"text"},{"code":"sentAt","type":"codeVoice"},{"text":" would be the first attempt’s.","type":"text"},{"text":" ","type":"text"},{"text":"RudderStack, whose references list all three as required, fills them in from when it received","type":"text"},{"text":" ","type":"text"},{"text":"the call.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context"},{"type":"text","text":" holds these members, for each of the keys the record’s context has a value for:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"app","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"namespace"},{"type":"text","text":", the bundle identifier, "},{"type":"codeVoice","code":"version"},{"type":"text","text":" and "},{"type":"codeVoice","code":"build"},{"type":"text","text":", each left out when "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"; no "},{"type":"codeVoice","code":"app"},{"type":"text","text":" when all three are"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"device"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"model"},{"type":"text","text":", and "},{"type":"codeVoice","code":"type"},{"type":"text","text":", the platform as Segment’s Swift library names it: "},{"type":"codeVoice","code":"ios"},{"type":"text","text":" for a phone or pad, "},{"type":"codeVoice","code":"macos"},{"type":"text","text":", "},{"type":"codeVoice","code":"tvos"},{"type":"text","text":", "},{"type":"codeVoice","code":"watchos"},{"type":"text","text":" or "},{"type":"codeVoice","code":"visionos"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"locale","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The locale’s BCP 47 identifier, such as "},{"type":"codeVoice","code":"en-US"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"network","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NetworkKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"wifi"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cellular"},{"text":", whether the connection is each","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"os","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"name"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"version"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name is one of","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io’s semantic events, which delete or suppress people and devices, one whose event","type":"text"},{"text":" ","type":"text"},{"text":"isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp has no ISO 8601 form,","type":"text"},{"text":" ","type":"text"},{"text":"and one too large for a call (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError"},{"text":"). ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"},{"text":" returns them as","type":"text"},{"text":" ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. A record sent again keeps its ","type":"text"},{"code":"messageId","type":"codeVoice"},{"text":". The bytes are the same for the same","type":"text"},{"text":" ","type":"text"},{"text":"records on every run and platform: no whitespace, object members in the order of their names’","type":"text"},{"text":" ","type":"text"},