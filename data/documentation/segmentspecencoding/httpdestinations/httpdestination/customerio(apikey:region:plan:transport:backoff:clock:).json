xt":"CustomerIOSetupError","kind":"typeIdentifier","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:19SegmentSpecEncoding0aB12BatchEncoderV","text":"SegmentSpecBatchEncoder","kind":"typeIdentifier","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"apiKey","content":[{"type":"paragraph","inlineContent":[{"text":"The source’s public key (","type":"text"},{"code":"pk_...","type":"codeVoice"},{"text":"), from the workspace’s API Credentials page,","type":"text"},{"text":" ","type":"text"},{"text":"or a legacy Pipelines write key. Whitespace and newlines around it are trimmed off.","type":"text"}]}]},{"name":"region","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the workspace is: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion\/us"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion\/eu"},{"type":"text","text":"."}]}]},{"name":"plan","content":[{"inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}],"type":"paragraph"}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}]},{"name":"backoff","content":[{"inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, by default.","type":"text"}],"type":"paragraph"}]},{"name":"clock","content":[{"inlineContent":[{"type":"text","text":"The clock the waits are measured on."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The destination posts to the Pipelines API’s "},{"code":"\/v1\/batch","type":"codeVoice"},{"type":"text","text":" in "},{"code":"region","type":"codeVoice"},{"type":"text","text":", encoded by a"},{"type":"text","text":" "},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" of "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" within "},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"the key as a bearer token and "},{"code":"X-Strict-Mode: 1","type":"codeVoice"},{"type":"text","text":", and sends no trace context in its header"},{"type":"text","text":" "},{"type":"text","text":"fields. Without strict mode, Customer.io answers 200 for a request it drops, a key it"},{"type":"text","text":" "},{"type":"text","text":"doesn’t know included; in it, Customer.io answers 401 for a missing or wrong key and 400"},{"type":"text","text":" "},{"type":"text","text":"for a request it won’t process, and the destination drops and reports both. It retries no"},{"type":"text","text":" "},{"type":"text","text":"response, a 5xx, 408 or 429. In strict mode Customer.io refuses a whole batch when one call"},{"type":"text","text":" "},{"type":"text","text":"in it fails, so the encoder leaves out each call Customer.io documents refusing; a 400 for"},{"type":"text","text":" "},{"type":"text","text":"anything else drops the whole request."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each call carries "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" as "},{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":". Customer.io’s references don’t say whether"},{"type":"text","text":" "},{"type":"text","text":"it takes that in place of the address it reads from an HTTP request."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Customer.io’s public keys ("},{"type":"codeVoice","code":"pk_..."},{"type":"text","text":") are client keys, safe to ship in an app: they let a"},{"type":"text","text":" "},{"type":"text","text":"client send data to the source and read nothing. Its private keys ("},{"type":"codeVoice","code":"sk_..."},{"type":"text","text":") reach every"},{"type":"text","text":" "},{"type":"text","text":"Customer.io API, deleting people included, and must not ship in an app, so the factory"},{"type":"text","text":" "},{"type":"text","text":"refuses one."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/emptyAPIKey","isActive":true,"type":"reference"},{"text":" for a key that is empty or only whitespace,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/privateKey","isActive":true,"type":"reference"},{"text":" for a private key (","type":"text"},{"type":"codeVoice","code":"sk_..."},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/Custo