on\/SegmentSpecEncoding\/CustomerIORegion\/us"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion\/eu"},{"type":"text","text":"."}]}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}]},{"name":"backoff","content":[{"type":"paragraph","inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, by default.","type":"text"}]}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination posts to the Pipelines API’s "},{"code":"\/v1\/batch","type":"codeVoice"},{"type":"text","text":" in "},{"code":"region","type":"codeVoice"},{"type":"text","text":", encoded by a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder"},{"type":"text","text":" of "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" within "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"the key as a bearer token and "},{"code":"X-Strict-Mode: 1","type":"codeVoice"},{"type":"text","text":", and sends no trace context in its header"},{"type":"text","text":" "},{"type":"text","text":"fields. Without strict mode, Customer.io answers 200 for a request it drops, a key it"},{"type":"text","text":" "},{"type":"text","text":"doesn’t know included; in it, Customer.io answers 401 for a missing or wrong key and 400"},{"type":"text","text":" "},{"type":"text","text":"for a request it won’t process, and the destination drops and reports both. It retries no"},{"type":"text","text":" "},{"type":"text","text":"response, a 5xx, 408 or 429. In strict mode Customer.io refuses a whole batch when one call"},{"type":"text","text":" "},{"type":"text","text":"in it fails, so the encoder leaves out each call Customer.io documents refusing; a 400 for"},{"type":"text","text":" "},{"type":"text","text":"anything else drops the whole request."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call carries "},{"code":"context.ip","type":"codeVoice"},{"type":"text","text":" as "},{"code":"\"0.0.0.0\"","type":"codeVoice"},{"type":"text","text":". Customer.io’s references don’t say whether"},{"type":"text","text":" "},{"type":"text","text":"it takes that in place of the address it reads from an HTTP request."}]},{"type":"paragraph","inlineContent":[{"text":"Customer.io’s public keys (","type":"text"},{"code":"pk_...","type":"codeVoice"},{"text":") are client keys, safe to ship in an app: they let a","type":"text"},{"text":" ","type":"text"},{"text":"client send data to the source and read nothing. Its private keys (","type":"text"},{"code":"sk_...","type":"codeVoice"},{"text":") reach every","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io API, deleting people included, and must not ship in an app, so the factory","type":"text"},{"text":" ","type":"text"},{"text":"refuses one.","type":"text"}]},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier"