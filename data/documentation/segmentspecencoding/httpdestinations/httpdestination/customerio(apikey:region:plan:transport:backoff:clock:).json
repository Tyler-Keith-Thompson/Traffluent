y let a","type":"text"},{"text":" ","type":"text"},{"text":"client send data to the source and read nothing. Its private keys (","type":"text"},{"type":"codeVoice","code":"sk_..."},{"text":") reach every","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io API, deleting people included, and must not ship in an app, so the factory","type":"text"},{"text":" ","type":"text"},{"text":"refuses one.","type":"text"}],"type":"paragraph"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/emptyAPIKey","type":"reference","isActive":true},{"type":"text","text":" for a key that is empty or only whitespace,"},{"type":"text","text":" "},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/privateKey","type":"reference","isActive":true},{"type":"text","text":" for a private key ("},{"type":"codeVoice","code":"sk_..."},{"type":"text","text":"), and"},{"type":"text","text":" "},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/regionMismatch","type":"reference","isActive":true},{"type":"text","text":" for a key whose region ("},{"type":"codeVoice","code":"pk_us_..."},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"pk_eu_..."},{"type":"text","text":") isn’t "},{"type":"codeVoice","code":"region"},{"type":"text","text":"."}]}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/CustomerIOSetupError/emptyAPIKey":{"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"emptyAPIKey"}],"abstract":[{"type":"text","text":"The key is empty, or only whitespace. Customer.io ingests nothing without one."}],"title":"CustomerIOSetupError.emptyAPIKey","role":"symbol","kind":"symbol"