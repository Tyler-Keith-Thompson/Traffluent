eContent":[{"type":"text","text":"The source’s public key ("},{"type":"codeVoice","code":"pk_..."},{"type":"text","text":"), from the workspace’s API Credentials page,"},{"type":"text","text":" "},{"type":"text","text":"or a legacy Pipelines write key. Whitespace and newlines around it are trimmed off."}]}],"name":"apiKey"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Where the workspace is: ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion\/us","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion\/eu","type":"reference","isActive":true},{"text":".","type":"text"}]}],"name":"region"},{"content":[{"inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}],"type":"paragraph"}],"name":"plan"},{"content":[{"inlineContent":[{"text":"What sends each request.","type":"text"}],"type":"paragraph"}],"name":"transport"},{"content":[{"inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, by default.","type":"text"}],"type":"paragraph"}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}],"name":"clock"}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The destination posts to the Pipelines API’s ","type":"text"},{"code":"\/v1\/batch","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"region","type":"codeVoice"},{"text":", encoded by a","type":"text"},{"text":" ","type":"text"},{"identifie