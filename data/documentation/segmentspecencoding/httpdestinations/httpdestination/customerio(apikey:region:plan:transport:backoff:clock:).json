oc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","text":"SegmentSpecBatchEncoder","kind":"typeIdentifier"},{"text":">","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"apiKey","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The source’s public key ("},{"type":"codeVoice","code":"pk_..."},{"type":"text","text":"), from the workspace’s API Credentials page,"},{"type":"text","text":" "},{"type":"text","text":"or a legacy Pipelines write key. Whitespace and newlines around it are trimmed off."}]}]},{"name":"region","content":[{"type":"paragraph","inlineContent":[{"text":"Where the workspace is: ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion\/us"},{"text":" or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion\/eu"},{"text":".","type":"text"}]}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}]},{"name":"transport","content":[{"inlineContent":[{"type":"text","text":"What sends each request."}],"type":"paragraph"}]},{"name":"backoff","content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, by default."}],"type":"paragraph"}]},{"name":"clock","content":[{"inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The destination.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination posts to the Pipelines API’s "},{"code":"\/v1\/batch","type":"codeVoice"},{"type":"text","text":" in "},{"code":"region","type":"codeVoice"},{"type":"text","text":", encoded by a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","isActive":true},{"type":"text","text":" of "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" within "},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"the key as a bearer token and "},{"code":"X-Strict-Mode: 1","type":"codeVoice"},{"type":"text","text":", and sends no trace context in its header"},{"type":"text","text":" "},{"type":"text","text":"fields. Without strict mode, Customer.io answers 200 for a request it drops, a key it"},{"type":"text","text":" "},{"type":"text","text":"doesn’t know included; in it, Customer.io answers 401 for a missing or wrong key and 400"},{"type":"text","text":" "},{"type":"text","text":"for a request it won’t process, and the destination drops and reports both. It retries no"},{"type":"text","text":" "},{"type":"text","text":"response, a 5xx, 408 or 429. In strict mode Customer.io refuses a whole batch when one call"},{"type":"text","text":" "},{"type":"text","text":"in it fails, so the encoder leaves out each call Customer.io documents refusing; a 400 for"},{"type":"text","text":" "},{"type":"text","text":"anything else drops the whole request."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call carries "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" as "},{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":". Customer.io’s references don’t say whether"},{"type":"text","text":" "},{"type":"text","text":"it takes that in place of the address it reads from an HTTP request."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Customer.io’s public keys ("},{"type":"codeVoice","code":"pk_..."},{"type":"text","text":") are client keys, safe to ship in an app: they let a"},{"type":"text","text":" "},{"type":"text","text":"client send data to the source and read nothing. Its private keys ("},{"type":"codeVoice","code":"sk_..."},{"type":"text","text":") reach every"},{"type":"text","text":" "},{"type":"text","text":"Customer.io API, deleting people included, and must not ship in an app, so the factory"},{"type":"text","text":" "},{"type":"text","text":"refuses one."}]},{"name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/emptyAPIKey"},{"type":"text","text":" for a key that is empty or only whitespace,"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/privateKey"},{"type":"text","text":" for a private key ("},{"type":"codeVoice","code":"sk_..."},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/regionMismatch"},{"type":"text","text":" for a key whose region ("},{"type":"codeVoice","code":"pk_us_..."},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"pk_eu_..."},{"type":"text","text":") isn’t "},{"type":"codeVoice","code":"region"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"identifier":{"url":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:transport:backoff:clock:)","interfaceLanguage":"swift"},"kind":"symbo