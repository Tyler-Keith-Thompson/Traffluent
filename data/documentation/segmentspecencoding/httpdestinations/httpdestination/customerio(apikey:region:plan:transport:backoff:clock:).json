{"text":"or a legacy Pipelines write key. Whitespace and newlines around it are trimmed off.","type":"text"}]}],"name":"apiKey"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Where the workspace is: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion\/us","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion\/eu","type":"reference"},{"text":".","type":"text"}]}],"name":"region"},{"content":[{"inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}],"type":"paragraph"}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}],"name":"transport"},{"content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}],"name":"clock"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The destination posts to the Pipelines API’s "},{"code":"\/v1\/batch","type":"codeVoice"},{"type":"text","text":" in "},{"code":"region","type":"codeVoice"},{"type":"text","text":", encoded by a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder"},{"type":"text","text":" of "},{"code":"plan","typ