text":") reach every"},{"type":"text","text":" "},{"type":"text","text":"Customer.io API, deleting people included, and must not ship in an app, so the factory"},{"type":"text","text":" "},{"type":"text","text":"refuses one."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/emptyAPIKey","type":"reference"},{"text":" for a key that is empty or only whitespace,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/privateKey","type":"reference"},{"text":" for a private key (","type":"text"},{"type":"codeVoice","code":"sk_..."},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/regionMismatch","type":"reference"},{"text":" for a key whose region (","type":"text"},{"type":"codeVoice","code":"pk_us_..."},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"pk_eu_..."},{"text":") isn’t ","type":"text"},{"type":"codeVoice","code":"region"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note","name":"Throws","type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/segmentspecencoding\/httpdestinations\/httpdestination\/customerio(apikey:region:plan:transport:backoff:clock:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/SegmentSpecBatchEncoder/batchLimit":{"title":"batchLimit","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","abstract":[{"text":"The Segment spec’s limits on one request, which Segment, RudderStack and Customer.io all","type":"text"},{"text":" ","type":"text"},{"text":"accept: 2,500 calls, 5