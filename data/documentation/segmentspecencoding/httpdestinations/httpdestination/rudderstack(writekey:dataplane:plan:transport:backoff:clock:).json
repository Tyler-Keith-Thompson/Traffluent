s","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The source’s write key, from the source’s settings. Whitespace and newlines"},{"type":"text","text":" "},{"type":"text","text":"around it are trimmed off."}],"type":"paragraph"}],"name":"writeKey"},{"content":[{"inlineContent":[{"text":"The data plane’s URL, from the top of the workspace’s Connections page","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"https:\/\/<workspace>dataplane.rudderstack.com","type":"codeVoice"},{"text":"), or a self-hosted data plane’s, a path","type":"text"},{"text":" ","type":"text"},{"text":"included where it is served under one. Not the endpoint: the destination appends","type":"text"},{"text":" ","type":"text"},{"code":"\/v1\/batch","type":"codeVoice"},{"text":" itself.","type":"text"}],"type":"paragraph"}],"name":"dataPlane"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}],"name":"transport"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, by default."}]}],"name":"backoff"},{"content":[{"inlineContent":[{"type":"text","text":"The clock the waits are measured on."}],"type":"paragraph"}],"name":"clock"}]},{"kind":"content","content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"The destination.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The destination posts to the data plane’s "},{"code":"\/v1\/batch","type":"codeVoice"},{"type":"text","text":", encoded by a"},{"type":"text","text