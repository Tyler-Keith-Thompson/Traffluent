{"abstract":[{"type":"text","text":"Writes the plan’s files into "},{"type":"codeVoice","code":"directory"},{"type":"text","text":", creating it if needed, and deletes the"},{"type":"text","text":" "},{"type":"codeVoice","code":".schema.json"},{"type":"text","text":" and "},{"type":"codeVoice","code":".example.json"},{"type":"text","text":" files there that the plan doesn’t hold."}],"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"write"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"directory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"URL","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"CocoaError","preciseIdentifier":"s:20FoundationEssentials10CocoaErrorV"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"directory","content":[{"inlineContent":[{"type":"text","text":"The directory the plan’s files go in."}],"type":"paragraph"}]}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The files are "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","isActive":true},{"type":"text","text":" of the plan already in "},{"type":"codeVoice","code":"directory"},{"type":"text","text":", so each"},{"type":"text","text":" "},{"type":"text","text":"event’s document keeps, marked deprecated, the properties its version had there and no"},{"type":"text","text":" "},{"type":"text","text":"longer declares. The documents and examples there of an event’s earlier versions, below"},{"type"