ineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") in the size of the two plans."}],"type":"paragraph"}],"name":"Complexity","style":"note"}],"kind":"content"}],"metadata":{"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"check","kind":"identifier"},{"text":"(","kind":"text"},{"text":"against","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":".","kind":"text"},{"text":"File","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"text":"]) -> ","kind":"text"},{"text":"TrackingPlanCheck","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO"}],"remoteSource":{"fileName":"TrackingPlan+Check.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TrackingPlans\/TrackingPlan+Check.swift#L20"},"title":"check(against:)","role":"symbol","modules":[{"name":"TrackingPlans"}],"roleHeading":"Instance Method","externalID":"s:13TrackingPlans0A4PlanV5check7againstAA0aC5CheckOSayAC4FileVG_tF","extendedModule":"TrackingPlans"},"hierarchy":{"paths":[["doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan"]]},"identifier":{"url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://Events/documentation/Events/EventSchema":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"EventSchema"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventSchema"}],"url":"\/documentation\/events\/eventschema","title":"EventSchema","kind":"symbol","role":"symbol