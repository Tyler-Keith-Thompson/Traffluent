ence, as no export can recreate it. Only when that"},{"type":"text","text":" "},{"type":"text","text":"finds no difference are the bytes compared, each file that differs, is missing or is no"},{"type":"text","text":" "},{"type":"text","text":"longer part of the plan reported as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference\/fileOutOfDate(path:)"},{"type":"text","text":", so a"},{"type":"text","text":" "},{"type":"text","text":"match means the committed plan is exactly what "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)"},{"type":"text","text":" of it holds. Files of "},{"type":"codeVoice","code":"committed"},{"type":"text","text":" that a plan doesn’t"},{"type":"text","text":" "},{"type":"text","text":"write, any but "},{"type":"codeVoice","code":"tracking-plan.json"},{"type":"text","text":", "},{"type":"codeVoice","code":".schema.json"},{"type":"text","text":" and "},{"type":"codeVoice","code":".example.json"},{"type":"text","text":" files, are ignored."}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") in the size of the two plans."}]}],"type":"aside"}],"kind":"content"}],"kind":"symbol","metadata":{"title":"check(against:)","role":"symbol","externalID":"s:13TrackingPlans0A4PlanV5check7againstAA0aC5CheckOSayAC4FileVG_tF","extendedModule":"TrackingPlans","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"check","kind":"identifier"},{"text":"(","kind":"text"},{"text":"against","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifie