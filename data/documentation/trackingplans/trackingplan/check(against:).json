{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Compares the plan with ","type":"text"},{"code":"committed","type":"codeVoice"},{"text":", the files of a plan exported before, and reports every","type":"text"},{"text":" ","type":"text"},{"text":"difference.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"check","kind":"identifier"},{"text":"(","kind":"text"},{"text":"against","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"committed","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan"},{"text":".","kind":"text"},{"text":"File","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/File"},{"text":"]) -> ","kind":"text"},{"text":"TrackingPlanCheck","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCheck"}],"platforms":["Linux"],"languages":["swift"]}]},{"parameters":[{"name":"committed","content":[{"inlineContent":[{"type":"text","text":"The committed plan’s files, by their paths in its directory."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"inlineContent":[{"text":"The check, whose ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCheck\/description"},{"text":" is its report.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content"