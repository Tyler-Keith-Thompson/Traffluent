n.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is an executable of the app’s own because only a program that links the app’s event types"},{"type":"text","text":" "},{"type":"text","text":"holds their schemas: "},{"type":"codeVoice","code":"TrackingPlan()"},{"type":"text","text":" finds the events of the modules it links."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/files(carryingForward:)":{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","url":"\/documentation\/trackingplans\/trackingplan\/files(carryingforward:)","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"files","kind":"identifier"},{"text":"(","kind":"text"},{"text":"carryingForward","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":".","kind":"text"},{"text":"File","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"text":"]) -> [","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":".","kind":"text"},{"text":"File","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"text":"]","kind":"text"}],"title":"files(carryingForward:)","abstract":[{"type":"text","text":"The plan’s files, as "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files","isActive":true},{"type":"text","text":" lists them, with each event’s document keeping the"},{"type":"text","text":" "},{"type":"text","text":"properties its document in "},{"typ