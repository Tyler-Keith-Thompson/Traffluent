":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference\/consentCategoryChanged(event:version:committed:current:)","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"no"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference\/sensitivityChanged(event:version:property:isSensitive:)","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"no"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference\/constraintLoosened(event:version:property:keyword:committed:current:)","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"no"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference\/fileOutOfDate(path:)","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"no","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A removed property is compatible: a stored record that still holds it decodes with the entry"},{"type":"text","text":" "},{"type":"text","text":"skipped, and the event’s document keeps it, marked "},{"type":"codeVoice","code":"deprecated"},{"type":"text","text":" and not required, so a payload"},{"type":"text","text":" "},{"type":"text","text":"that holds it still validates. Declaring it again is compared with the schema it had: another"},{"type":"text","text":" "},{"type":"text","text":"type is "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference\/propertyRetyped(event:version:property:committed:current:)"},{"type":"text","text":", and the same one is"