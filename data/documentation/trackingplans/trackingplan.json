"code":"required"},{"type":"text","text":": the payloads and records of"},{"type":"text","text":" "},{"type":"text","text":"releases that sent it still hold it, and "},{"type":"codeVoice","code":"additionalProperties"},{"type":"text","text":" would otherwise reject them."},{"type":"text","text":" "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","type":"reference","isActive":true},{"type":"text","text":" carry it forward from the plan already"},{"type":"text","text":" "},{"type":"text","text":"exported, as "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","type":"reference","isActive":true},{"type":"text","text":" does."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"x-traffluent-version"},{"type":"text","text":" is the event’s version and "},{"type":"codeVoice","code":"x-traffluent-consent-category"},{"type":"text","text":" the name of"},{"type":"text","text":" "},{"type":"text","text":"its consent category."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A property’s schema follows its type as written: "},{"type":"codeVoice","code":"String"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"string"},{"type":"text","text":"; "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" a "},{"type":"codeVoice","code":"boolean"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Float"},{"type":"text","text":" a "},{"type":"codeVoice","code":"number"},{"type":"text","text":"; every integer type an "},{"type":"codeVoice","code":"integer"},{"type":"text","text":", with "},{"type":"codeVoice","code":"minimum"},{"type":"text","text":" and "},{"type":"codeVoice","code":"maximum"},{"type":"text","text":" "},{"type":"text","text":"for the types of 32 bits or fewer and a "},{"type":"codeVoice","code":"minimum"},{"type":"text","text":" of 0 for the unsigned ones; "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" a "},{"type":"codeVoice","code":"string"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"format"},{"type":"text","text":" "},{"type":"codeVoice","code":"date-time"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" one of "},{"type":"codeVoice","code":"format"},{"type":"text","text":" "},{"type":"codeVoice","code":"uuid"},{"type":"text","text":"; an array ("},{"type":"codeVoice","code":"[T]"},{"type":"text","text":", "},{"type":"codeVoice","code":"Array<T>"},{"type":"text","text":") an"},{"type":"text","text":" "},{"type":"codeVoice","code":"array"},{"type":"text","text":" whose "},{"type":"codeVoice","code":"items"},{"type":"text","text":" are "},{"type":"codeVoice","code":"T"},{"type":"text","text":"’s schema. An optional type ("},{"type":"codeVoice","code":"T?"},{"type":"text","text":", "},{"type":"codeVoice","code":"T!"},{"type":"text","text":", "},{"type":"codeVoice","code":"Optional<T>"},{"type":"text","text":") adds "},{"type":"codeVoice","code":"null"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"T"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"type"},{"type":"text","text":". "},{"type":"codeVoice","code":"Sensitive<T>"},{"type":"text","text":" is "},{"type":"codeVoice","code":"T"},{"type":"text","text":"’s schema with "},{"type":"codeVoice","code":"x-traffluent-sensitive: true"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Refined<T, Rule>"},{"type":"text","text":" is "},{"type":"codeVoice","code":"T"},{"type":"text","text":"‘s schema. Each may be qualified by its module ("},{"type":"c