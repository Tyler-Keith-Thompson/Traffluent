},{"type":"codeVoice","code":"string"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"type":"codeVoice","code":"format"},{"text":" ","type":"text"},{"type":"codeVoice","code":"date-time"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"UUID"},{"text":" one of ","type":"text"},{"type":"codeVoice","code":"format"},{"text":" ","type":"text"},{"type":"codeVoice","code":"uuid"},{"text":"; an array (","type":"text"},{"type":"codeVoice","code":"[T]"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Array<T>"},{"text":") an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"array"},{"text":" whose ","type":"text"},{"type":"codeVoice","code":"items"},{"text":" are ","type":"text"},{"type":"codeVoice","code":"T"},{"text":"’s schema. An optional type (","type":"text"},{"type":"codeVoice","code":"T?"},{"text":", ","type":"text"},{"type":"codeVoice","code":"T!"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Optional<T>"},{"text":") adds ","type":"text"},{"type":"codeVoice","code":"null"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"T"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"type"},{"text":". ","type":"text"},{"type":"codeVoice","code":"Sensitive<T>"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"T"},{"text":"’s schema with ","type":"text"},{"type":"codeVoice","code":"x-traffluent-sensitive: true"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Refined<T, Rule>"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"T"},{"text":"‘s schema. Each may be qualified by its module (","type":"text"},{"type":"codeVoice","code":"Swift.Int"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Foundation.Date"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Events.Sensitive"},{"text":"). Any other type, whose JSON shape the plan can’t know,","type":"text"},{"text":" ","type":"text"},{"text":"accepts any value and records the type in ","type":"text"},{"type":"codeVoice","code":"x-traffluent-swift-type"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A property’s "},{"identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","type":"reference","isActive":true},{"type":"text","text":"s (its "},{"code":"Refined","type":"codeVoice"},{"type":"text","text":" type’s rule’s and those declared"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"@Constrained","type":"codeVoice"},{"type":"text","text":") are added to its schema as the JSON Schema keywords they are: "},{"code":"minLength","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"maxLength","type":"codeVoice"},{"type":"text","text":", "},{"code":"minimum","type":"codeVoice"},{"type":"text","text":", "},{"code":"maximum","type":"codeVoice"},{"type":"text","text":", "},{"code":"minItems","type":"codeVoice"},{"type":"text","text":" and "},{"code":"maxItems","type":"codeVoice"},{"type":"text","text":", each merged with a bound the type"},{"type":"text","text":" "},{"type":"text","text":"has already by keeping the tighter. The first "},{"code":"pattern","type":"codeVoice"},{"type":"text","text":" is "},{"code":"pattern","type":"codeVoice"},{"type":"text","text":", with its example in"},{"type":"text","text":" "},{"code":"examples","type":"codeVoice"},{"type":"text","text":"; any other is a "},{"code":"pattern","type":"codeVoice"},{"type":"text","text":" of its own under "},{"code":"allOf","type":"codeVoice"},{"type":"text","text":". A bound with a fraction is"},{"type":"text","text":" "},{"type":"text","text":"written as a JSON number with one."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beside each document is the event’s example, "},{"type":"codeVoice","code":"<name>.v<version>.example.json"},{"type":"text","text":": a conformance"},{"type":"text","text":" "},{"type":"text","text"