","text":" a "},{"code":"string","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"of "},{"code":"format","type":"codeVoice"},{"type":"text","text":" "},{"code":"date-time","type":"codeVoice"},{"type":"text","text":" and "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":" one of "},{"code":"format","type":"codeVoice"},{"type":"text","text":" "},{"code":"uuid","type":"codeVoice"},{"type":"text","text":"; an array ("},{"code":"[T]","type":"codeVoice"},{"type":"text","text":", "},{"code":"Array<T>","type":"codeVoice"},{"type":"text","text":") an"},{"type":"text","text":" "},{"code":"array","type":"codeVoice"},{"type":"text","text":" whose "},{"code":"items","type":"codeVoice"},{"type":"text","text":" are "},{"code":"T","type":"codeVoice"},{"type":"text","text":"’s schema. An optional type ("},{"code":"T?","type":"codeVoice"},{"type":"text","text":", "},{"code":"T!","type":"codeVoice"},{"type":"text","text":", "},{"code":"Optional<T>","type":"codeVoice"},{"type":"text","text":") adds "},{"code":"null","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"to "},{"code":"T","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"type","type":"codeVoice"},{"type":"text","text":". "},{"code":"Sensitive<T>","type":"codeVoice"},{"type":"text","text":" is "},{"code":"T","type":"codeVoice"},{"type":"text","text":"’s schema with "},{"code":"x-traffluent-sensitive: true","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"Refined<T, Rule>","type":"codeVoice"},{"type":"text","text":" is "},{"code":"T","type":"codeVoice"},{"type":"text","text":"‘s schema. Each may be qualified by its module ("},{"code":"Swift.Int","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"Foundation.Date","type":"codeVoice"},{"type":"text","text":", "},{"code":"Events.Sensitive","type":"codeVoice"},{"type":"text","text":"). Any other type, whose JSON shape the plan can’t know,"},{"type":"text"