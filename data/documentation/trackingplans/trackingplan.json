ype":"text"},{"text":"of ","type":"text"},{"type":"codeVoice","code":"format"},{"text":" ","type":"text"},{"type":"codeVoice","code":"date-time"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"UUID"},{"text":" one of ","type":"text"},{"type":"codeVoice","code":"format"},{"text":" ","type":"text"},{"type":"codeVoice","code":"uuid"},{"text":"; an array (","type":"text"},{"type":"codeVoice","code":"[T]"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Array<T>"},{"text":") an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"array"},{"text":" whose ","type":"text"},{"type":"codeVoice","code":"items"},{"text":" are ","type":"text"},{"type":"codeVoice","code":"T"},{"text":"’s schema. An optional type (","type":"text"},{"type":"codeVoice","code":"T?"},{"text":", ","type":"text"},{"type":"codeVoice","code":"T!"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Optional<T>"},{"text":") adds ","type":"text"},{"type":"codeVoice","code":"null"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"T"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"type"},{"text":". ","type":"text"},{"type":"codeVoice","code":"Sensitive<T>"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"T"},{"text":"’s schema with ","type":"text"},{"type":"codeVoice","code":"x-traffluent-sensitive: true"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Refined<T, Rule>"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"T"},{"text":"‘s schema. Each may be qualified by its module (","type":"text"},{"type":"codeVoice","code":"Swift.Int"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Foundation.Date"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Events.Sensitive"},{"text":"). Any other type, whose JSON shape the plan can’t know,","type":"text"},{"text":" ","type":"text"},{"text":"accepts any value and records the type in ","