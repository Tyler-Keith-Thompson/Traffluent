{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrackingPlan"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"syntax":"swift","type":"codeListing","code":["import EventMacros","import TrackingPlans","","@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?","}","","let plan = TrackingPlan(schemas: [CheckoutStarted.schema])","plan.files.map(\\.path)","\/\/ [\"tracking-plan.json\", \"checkout_started.v2.schema.json\", \"checkout_started.v2.example.json\"]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plan’s files are values, so the same schemas give the same bytes on every run and"},{"type":"text","text":" "},{"type":"text","text":"platform: keys sorted by their UTF-8 bytes, two-space indentation, a trailing newline and no"},{"type":"text","text":" "},{"type":"text","text":"timestamps."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event’s document is named "},{"type":"codeVoice","code":"<name>.v<version>.schema.json"},{"type":"text","text":", its name with every byte but"},{"type":"text","text":" "},{"type":"text","text":"ASCII letters, digits, "},{"type":"codeVoice","code":"_"},{"type":"text","text":" and "},{"type":"codeVoice","code":"-"},{"type":"text","text":" percent-encoded ("},{"type":"codeVoice","code":"Box<String>"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Box%3CString%3E"},{"type":"text","text":"). The"},{"type":"text","text":" "},{"type":"text","text":"document describes the event’s properties as a JSON object:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$schema"},{"type":"text","text":" is draft 2020-12’s, and "},{"type":"codeVoice","code":"$id"},{"type":"text","text":" the document’s file name, so the index’s references"},{"type":"text","text":" "},{"type":"text","text":"to it resolve against the directory the plan is written to."}]}]},{"content":[{"inlineContent":[{"code":"title","type":"codeVoice"},{"type":"text","text":" is the event’s name, "},{"code":"type","type":"codeVoice"},{"type":"text","text":" is "},{"code":"object","type":"codeVoice"},{"type":"text","text":" and "},{"code":"additionalProperties","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"},{"text":" holds each stored property’s schema, and ","type":"text"},{"code":"required","type":"codeVoice"},{"text":" the names of the properties","type":"text"},{"text":" ","type":"text"},{"text":"that are neither optional nor have a default value, in declaration order: those every","type":"text"},{"text":" ","type":"text"},{"text":"release’s payloads hold. A property with a default value is marked ","type":"text"},{"code":"x-traffluent-default: true","type":"codeVoice"},{"text":", as a reader of a stored payload without it reads the default.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A property the event declared at this version and no longer does stays in "},{"type":"codeVoice","code":"properties"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"the schema it had and "},{"type":"codeVoice","code":"deprecated: true"},{"type":"text","text":", and out of "},{"type":"codeVoice","code":"required"},{"type":"text","text":": the payloads and records of"},{"type":"text","text":" "},{"type":"text","text":"releases that sent it still hold it, and "},{"type":"codeVoice","code":"additionalProperties"},{"type":"text","text":" would otherwise reject them."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","isActive":true},{"type":"text","text":" carry it forward from the plan already"},{"type":"text","text":" "},{"type":"text","text":"exported, as "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","isActive":true},{"type":"text","text":" does."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"x-traffluent-version"},{"type":"text","text":" is the event’s version and "},{"type":"codeVoice","code":"x-traffluent-consent-category"},{"type":"text","text":" the name of"},{"type":"text","text":" "},{"type":"text","text":"its consent category."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A property’s schema follows its type as written: ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"string","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" a ","type":"text"},{"code":"boolean","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":" a ","type":"text"},{"code":"number","type":"codeVoice"},{"text":"; every integer type an ","type":"text"},{"code":"integer","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"minimum","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"maximum","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for the types of 32 bits or fewer and a ","type":"text"},{"code":"minimum","type":"codeVoice"},{"text":" of 0 for the unsigned ones; ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" a ","type":"text"},{"code":"string","type":"codeVoice"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"format","type":"codeVoice"},{"text":" ","type":"text"},{"code":"date-time","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":" one of ","type":"text"},{"code":"format","type":"codeVoice"},{"text":" ","type":"text"},{"code":"uuid","type":"codeVoice"},{"text":"; an array (","type":"text"},{"code":"[T]","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Array<T>","type":"codeVoice"},{"text":") an","type":"text"},{"text":" ","type":"text"},{"code":"array","type":"codeVoice"},{"text":" whose ","type":"text"},{"code":"items","type":"codeVoice"},{"text":" are ","type":"text"},{"code":"T","type":"codeVoice"},{"text":"’s schema. An optional type (","type":"text"},{"code":"T?","type":"codeVoice"},{"text":", ","type":"text"},{"code":"T!","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Optional<T>","type":"codeVoice"},{"text":") adds ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"T","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"type","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Sensitive<T>","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"T","type":"codeVoice"},{"text":"’s schema with ","type":"text"},{"code":"x-traffluent-sensitive: true","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"Refined<T, Rule>","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"T","type":"codeVoice"},{"text":"‘s schema. Each may be qualified by its module (","type":"text"},{"code":"Swift.Int","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"Foundation.Date","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Events.Sensitive","type":"codeVoice"},{"text":"). Any other type, whose JSON shape the plan can’t know,","type":"text"},{"text":" ","type":"text"},{"text":"accepts any value and records the type in ","type":"text"},{"code":"x-traffluent-swift-type","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A property’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword"},{"type":"text","text":"s (its "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" type’s rule’s and those declared"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":") are added to its schema as the JSON Schema keywords they are: "},{"type":"codeVoice","code":"minLength"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"maxLength"},{"type":"text","text":", "},{"type":"codeVoice","code":"minimum"},{"type":"text","text":", "},{"type":"codeVoice","code":"maximum"},{"type":"text","text":", "},{"type":"codeVoice","code":"minItems"},{"type":"text","text":" and "},{"type":"codeVoice","code":"maxItems"},{"type":"text","text":", each merged with a bound the type"},{"type":"text","text":" "},{"type":"text","text":"has already by keeping the tighter. The first "},{"type":"codeVoice","code":"pattern"},{"type":"text","text":" is "},{"type":"codeVoice","code":"pattern"},{"type":"text","text":", with its example in"},{"type":"text","text":" "},{"type":"codeVoice","code":"examples"},{"type":"text","text":"; any other is a "},{"type":"codeVoice","code":"pattern"},{"type":"text","text":" of its own under "},{"type":"codeVoice","code":"allOf"},{"type":"text","text":". A bound with a fraction is"},{"type":"text","text":" "},{"type":"text","text":"written as a JSON number with one."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beside each document is the event’s example, "},{"type":"codeVoice","code":"<name>.v<version>.example.json"},{"type":"text","text":": a conformance"},{"type":"text","text":" "},{"type":"text","text":"vector, the payload of the event with every property present and set to a fixed value its"},{"type":"text","text":" "},{"type":"text","text":"schema accepts. Another platform’s code can encode the same event and compare. A "},{"type":"codeVoice","code":"string"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"example\""},{"type":"text","text":" (cut to its "},{"type":"codeVoice","code":"maxLength"},{"type":"text","text":", or "},{"type":"codeVoice","code":"x"},{"type":"text","text":" repeated to a "},{"type":"codeVoice","code":"minLength"},{"type":"text","text":" above 7, or its pattern’s"},{"type":"text","text":" "},{"type":"text","text":"example), one of "},{"type":"codeVoice","code":"format"},{"type":"text","text":" "},{"type":"codeVoice","code":"date-time"},{"type":"text","text":" is "},{"type":"codeVoice","code":"\"2001-01-01T00:00:00Z\""},{"type":"text","text":" and one of "},{"type":"codeVoice","code":"format"},{"type":"text","text":" "},{"type":"codeVoice","code":"uuid"},{"type":"text","text":" "},{"type":"text","text":"the nil UUID; a "},{"type":"codeVoice","code":"number"},{"type":"text","text":" or an "},{"type":"codeVoice","code":"integer"},{"type":"text","text":" is 0, or the nearest value its bounds allow; a"},{"type":"text","text":" "},{"type":"codeVoice","code":"boolean"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":"; an "},{"type":"codeVoice","code":"array"},{"type":"text","text":" holds one example of its "},{"type":"codeVoice","code":"items"},{"type":"text","text":", or as many as its"},{"type":"text","text":" "},{"type":"codeVoice","code":"minItems"},{"type":"text","text":" and "},{"type":"codeVoice","code":"maxItems"},{"type":"text","text":" allow; and a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The index, "},{"type":"codeVoice","code":"tracking-plan.json"},{"type":"text","text":", lists every event under "},{"type":"codeVoice","code":"events"},{"type":"text","text":", by name and then version,"},{"type":"text","text":" "},{"type":"text","text":"with its "},{"type":"codeVoice","code":"name"},{"type":"text","text":", "},{"type":"codeVoice","code":"version"},{"type":"text","text":", "},{"type":"codeVoice","code":"consentCategory"},{"type":"text","text":", "},{"type":"codeVoice","code":"schema"},{"type":"text","text":", its document’s file name, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"example"},{"type":"text","text":", its example’s."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)"},{"type":"text","text":" compares a plan with the one committed in a directory, reporting"},{"type":"text","text":" "},{"type":"text","text":"each "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference"},{"type":"text","text":"."}]}]}],"abstract":[{"text":"The JSON Schema (draft 2020-12) of every event an app tracks: one document per event and an","type":"text"},{"text":" ","type":"text"},{"text":"index, exported from the events’ ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"text":" values.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan"},"metadata":{"role":"symbol","roleHeading":"Structure","remoteSource":{"fileName":"TrackingPlan.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TrackingPlans\/TrackingPlan.swift#L76"},"title":"TrackingPlan","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrackingPlan"}],"symbolKind":"struct","externalID":"s:13TrackingPlans0A4PlanV","navigatorTitle":[{"text