":"text"},{"code":"$id","type":"codeVoice"},{"text":" the document’s file name, so the index’s references","type":"text"},{"text":" ","type":"text"},{"text":"to it resolve against the directory the plan is written to.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"title"},{"type":"text","text":" is the event’s name, "},{"type":"codeVoice","code":"type"},{"type":"text","text":" is "},{"type":"codeVoice","code":"object"},{"type":"text","text":" and "},{"type":"codeVoice","code":"additionalProperties"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"code":"properties","type":"codeVoice"},{"text":" holds each stored property’s schema, and ","type":"text"},{"code":"required","type":"codeVoice"},{"text":" the names of the properties","type":"text"},{"text":" ","type":"text"},{"text":"that are neither optional nor have a default value, in declaration order: those every","type":"text"},{"text":" ","type":"text"},{"text":"release’s payloads hold. A property with a default value is marked ","type":"text"},{"code":"x-traffluent-default: true","type":"codeVoice"},{"text":", as a reader of a stored payload without it reads the default.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A property the event declared at this version and no longer does stays in "},{"code":"properties","type":"codeVoice"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"the schema it had and "},{"code":"deprecated: true","type":"codeVoice"},{"type":"text","text":", and out of "},{"code":"required","type":"codeVoice"},{"type":"text","text":": the payloads and records of"},{"type":"text","text":" "},{"type":"text","text":"releases that sent it still hold it, and "},{"code":"additionalProperties","type":"codeVoice"},{"type":"text","text":" would otherwise reject them."},{"type":"tex