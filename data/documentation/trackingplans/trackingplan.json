n and no longer does stays in "},{"type":"codeVoice","code":"properties"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"the schema it had and "},{"type":"codeVoice","code":"deprecated: true"},{"type":"text","text":", and out of "},{"type":"codeVoice","code":"required"},{"type":"text","text":": the payloads and records of"},{"type":"text","text":" "},{"type":"text","text":"releases that sent it still hold it, and "},{"type":"codeVoice","code":"additionalProperties"},{"type":"text","text":" would otherwise reject them."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","isActive":true},{"type":"text","text":" carry it forward from the plan already"},{"type":"text","text":" "},{"type":"text","text":"exported, as "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","isActive":true},{"type":"text","text":" does."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"x-traffluent-version"},{"type":"text","text":" is the event’s version and "},{"type":"codeVoice","code":"x-traffluent-consent-category"},{"type":"text","text":" the name of"},{"type":"text","text":" "},{"type":"text","text":"its consent category."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A property’s schema follows its type as written: "},{"type":"codeVoice","code":"String"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"string"},{"type":"text","text":"; "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" a "},{"type":"codeVoice","code":"boolean"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Float"},{"type":"text","text":" a "},{"type":"codeVoice","code":"number"},{"type":"text","text":"; every integer type an "},{"type":"codeVoice","code":"integer"},{"type":"text","text":", with "},{"type":"codeVoice","code":"minimum"},{"type":"text","text":" and "},{"type":"codeVoice","code":"maximum"},{"type":"text","text":" "},{"type":"text","text":"for the types of 32 bits or fewer and a "},{"type":"codeVoice","code":"minimum"},{"type":"text","text":" of 0 for the unsigned ones; "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" a "},{"type":"codeVoice","code":"string"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"format"},{"type":"text","text":" "},{"type":"codeVoice","code":"date-time"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" one of "},{"type":"codeVoice","code":"format"},{"type":"text","text":" "},{"type":"codeVoice","code":"uuid"},{"type":"text","text":"; an array ("},{"type":"codeVoice","code":"[T]"},{"type":"text","text":", "},{"type":"codeVoice","code":"Array<T>"},{"type":"text","text":") an"},{"type":"text","text":" "},{"type":"codeVoice","code":"array"},{"type":"text","text":" whose "},{"type":"codeVoice","code":"items"},{"type":"text","text":" are "},{"type":"codeVoice","code":"T"},{"type":"text","text":"‘s schema. An optional type ("},{"type":"codeVoice","code":"T?"},{"type":"text","text":", "},{"type":"codeVoice","code":"T!"},{"type":"text","text":", "},{"type":"codeVoice","code":"Optional<T>"},{"type":"text","text":") adds "},{"type":"codeVoice","code":"null"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"T"},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"type"},{"type":"text","text":". "},{"type":"codeVoice","code":"Sensitive<T>"},{"type":"text","text":" is "},{"type":"codeVoice","code":"T"},{"type":"text","text":"‘s schema with "},{"type":"codeVoice","code":"x-traffluent-sensitive: true"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"allows "},{"type":"codeVoice","code":"null"},{"type":"text","text":" too as an array’s element, since a redacted element is "},{"type":"codeVoice","code":"null"},{"type":"text","text":"; and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Refined<T, Rule>"},{"type":"text","text":" is "},{"type":"codeVoice","code":"T"},{"type":"text","text":"‘s schema. Each may be qualified by its module ("},{"type":"codeVoice","code":"Swift.Int"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"Foundation.Date"},{"type":"text","text":", "},{"type":"codeVoice","code":"Events.Sensitive"},{"type":"text","text":"). A raw-value enum whose raw value is a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or an"},{"type":"text","text":" "},{"type":"text","text":"integer type, and whose cases are known (its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema\/Property\/enumeration"},{"type":"text","text":"), is"},{"type":"text","text":" "},{"type":"text","text":"its raw value’s schema with its raw values as "},{"type":"codeVoice","code":"enum"},{"type":"text","text":", which holds "},{"type":"codeVoice","code":"null"},{"type":"text","text":" too when the property"},{"type":"text","text":" "},{"type":"text","text":"is optional. Any other type, whose JSON shape the plan can’t know, accepts any value and"},{"type":"text","text":" "},{"type":"text","text":"records the type in "},{"type":"codeVoice","code":"x-traffluent-swift-type"},{"type":"text","text":". That includes an enum declared outside the event"},{"type":"text","text":" "},{"type":"text","text":"that isn’t "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":", and a typealias of an enum."}]},{"type":"paragraph","inlineContent":[{"text":"A property’s ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","isActive":true,"type":"reference"},{"text":"s (its ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" type’s rule’s and those declared","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"@Constrained","type":"codeVoice"},{"text":") are added to its schema as the JSON Schema keywords they are: ","type":"text"},{"code":"minLength","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"maxLength","type":"codeVoice"},{"text":", ","type":"text"},{"code":"minimum","type":"codeVoice"},{"text":", ","type":"text"},{"code":"maximum","type":"codeVoice"},{"text":", ","type":"text"},{"code":"minItems","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"maxItems","type":"codeVoice"},{"text":", each merged with a bound the type","type":"text"},{"text":" ","type":"text"},{"text":"has already by keeping the tighter. The first ","type":"text"},{"code":"pattern","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"pattern","type":"codeVoice"},{"text":", with its example in","type":"text"},{"text":" ","type":"text"},{"code":"examples","type":"codeVoice"},{"text":"; any other is a ","type":"text"},{"code":"pattern","type":"codeVoice"},{"text":" of its own under ","type":"text"},{"code":"allOf","type":"codeVoice"},{"text":". A bound with a fraction is","type":"text"},{"text":" ","type":"text"},{"text":"written as a JSON number with one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beside each document is the event’s example, "},{"code":"<name>.v<version>.example.json","type":"codeVoice"},{"type":"text","text":": a conformance"},{"type":"text","text":" "},{"type":"text","text":"vector, the payload of the event with every property present and set to a fixed value its"},{"type":"text","text":" "},{"type":"text","text":"schema accepts. Another platform’s code can encode the same event and compare. A "},{"code":"string","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"\"example\"","type":"codeVoice"},{"type":"text","text":" (cut to its "},{"code":"maxLength","type":"codeVoice"},{"type":"text","text":", or "},{"code":"x","type":"codeVoice"},{"type":"text","text":" repeated to a "},{"code":"minLength","type":"codeVoice"},{"type":"text","text":" above 7, or its pattern’s"},{"type":"text","text":" "},{"type":"text","text":"example), one of "},{"code":"format","type":"codeVoice"},{"type":"text","text":" "},{"code":"date-time","type":"codeVoice"},{"type":"text","text":" is "},{"code":"\"2001-01-01T00:00:00Z\"","type":"codeVoice"},{"type":"text","text":" and one of "},{"code":"format","type":"codeVoice"},{"type":"text","text":" "},{"code":"uuid","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the nil UUID; a "},{"code":"number","type":"codeVoice"},{"type":"text","text":" or an "},{"code":"integer","type":"codeVoice"},{"type":"text","text":" is 0, or the nearest value its bounds allow; a"},{"type":"text","text":" "},{"code":"boolean","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":"; an "},{"code":"array","type":"codeVoice"},{"type":"text","text":" holds one example of its "},{"code":"items","type":"codeVoice"},{"type":"text","text":", or as many as its"},{"type":"text","text":" "},{"code":"minItems","type":"codeVoice"},{"type":"text","text":" and "},{"code":"maxItems","type":"codeVoice"},{"type":"text","text":" allow; an enum is its first raw value; and a type the plan can’t map"},{"type":"text","text":" "},{"type":"text","text":"is "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The index, "},{"type":"codeVoice","code":"tracking-plan.json"},{"type":"text","text":", lists every event under "},{"type":"codeVoice","code":"events"},{"type":"text","text":", by name and then version,"},{"type":"text","text":" "},{"type":"text","te