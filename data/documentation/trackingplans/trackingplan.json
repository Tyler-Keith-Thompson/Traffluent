text"},{"code":"x-traffluent-sensitive: true","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"Refined<T, Rule>","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"T","type":"codeVoice"},{"text":"‘s schema. Each may be qualified by its module (","type":"text"},{"code":"Swift.Int","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"Foundation.Date","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Events.Sensitive","type":"codeVoice"},{"text":"). Any other type, whose JSON shape the plan can’t know,","type":"text"},{"text":" ","type":"text"},{"text":"accepts any value and records the type in ","type":"text"},{"code":"x-traffluent-swift-type","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A property’s ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","isActive":true,"type":"reference"},{"text":"s (its ","type":"text"},{"code":"Refined","type":"codeVoice"},{"text":" type’s rule’s and those declared","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"@Constrained","type":"codeVoice"},{"text":") are added to its schema as the JSON Schema keywords they are: ","type":"text"},{"code":"minLength","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"maxLength","type":"codeVoice"},{"text":", ","type":"text"},{"code":"minimum","type":"codeVoice"},{"text":", ","type":"text"},{"code":"maximum","type":"codeVoice"},{"text":", ","type":"text"},{"code":"minItems","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"maxItems","type":"codeVoice"},{"text":", each merged with a bound the type","type":"text"},{"text":" ","type":"text"},{"text":"has already by keeping the tighter. The first ","type":"text"},{"code":"pattern","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"pattern","type":"codeVoice"},{"text":", with its example in","type":"tex