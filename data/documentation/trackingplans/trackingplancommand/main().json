{"sections":[],"identifier":{"url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/main()","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Writes or checks ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan","isActive":true,"type":"reference"},{"text":" as the command’s arguments say, and exits.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand"]]},"metadata":{"roleHeading":"Type Method","symbolKind":"method","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TrackingPlans\/TrackingPlanCommand.swift#L60","fileName":"TrackingPlanCommand.swift"},"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"main","kind":"identifier"},{"text":"()","kind":"text"}],"modules":[{"name":"TrackingPlans"}],"externalID":"s:13TrackingPlans0A11PlanCommandPAAE4mainyyFZ","title":"main()","extendedModule":"TrackingPlans"},"variants":[{"paths":["\/documentation\/trackingplans\/trackingplancommand\/main()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"main","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"Given one argument, a directory, it writes the plan there, as "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"does: it exits with status 0 once the plan is written, and 73 ("},{"type":"codeVoice","code":"EX_CANTCREAT"},{"type":"text","text":") when a file"},{"type":"text","text":" "},{"type":"text","text":"can’t be written."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Given "},{"code":"check","type":"codeVoice"},{"type":"text","text":" and a directory, it compares the plan with the one committed there, as"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)"},{"type":"text","text":" does, printing the check’s report when they"},{"type":"text","text":" "},{"type":"text","text":"differ: it exits with status 0 when they match, 1 when a difference is breaking, and 2 when"},{"type":"text","text":" "},{"type":"text","text":"the committed plan is only out of date."}],"type":"paragraph"},{"inlineContent":[{"text":"Given ","type":"text"},{"code":"check --breaking-only","type":"codeVoice"},{"text":" and a directory, it compares them the same way but fails only","type":"text"},{"text":" ","type":"text"},{"text":"when a difference is breaking: it exits with status 1 then, printing the report, and 0 when","type":"text"},{"text":" ","type":"text"},{"text":"they match or the plan there is only out of date. It prints the differences of an","type":"text"},{"text":" ","type":"text"},{"text":"out-of-date plan to standard output, as information.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Given anything else, it exits with status 64 (","type":"text"},{"code":"EX_USAGE","type":"codeVoice"},{"text":"): ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" alone (write to ","type":"text"},{"code":".\/check","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for a directory of that name), ","type":"text"},{"code":"check --breaking-only","type":"codeVoice"},{"text":" alone, the flag in any other place,","type":"text"},{"text":" ","type":"text"},{"text":"or a directory whose name starts with ","type":"text"},{"code":"-","type":"codeVoice"},{"text":", as a mistyped option would (write ","type":"text"},{"code":".\/-name","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"one). When ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan"},{"text":" throws, it exits with status 65 (","type":"text"},{"code":"EX_DATAERR","type":"codeVoice"},{"text":"). Every failure is","type":"text"},{"text":" ","type":"text"},{"text":"printed to standard error.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/write(to:)":{"abstract":[{"text":"Writes the plan’s files into ","type":"text"},{"code":"directory","type":"codeVoice"},{"text":", creating it if needed, and deletes the","type":"text"},{"text":" ","type":"text"},{"code":".schema.json","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".example.json","type":"codeVoice"},{"text":" files there that the plan doesn’t hold.","type":"text"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"write"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"preciseIdentifier":"s:20FoundationEssentials3URLV","kind":"typeIdentifier","text":"URL"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:20FoundationEssentials10CocoaErrorV","kind":"typeIdentifier","text":"CocoaError"},{"kind":"text","text":")"}],"kind":"symbol","title":"write(to:)","url":"\/documentation\/trackingplans\/trackingplan\/write(to:)"},"doc://TrackingPlans/