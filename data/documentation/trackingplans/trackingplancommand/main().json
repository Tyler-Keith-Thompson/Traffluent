{"metadata":{"externalID":"s:13TrackingPlans0A11PlanCommandPAAE4mainyyFZ","symbolKind":"method","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"main"},{"kind":"text","text":"()"}],"extendedModule":"TrackingPlans","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TrackingPlans\/TrackingPlanCommand.swift#L65","fileName":"TrackingPlanCommand.swift"},"modules":[{"name":"TrackingPlans"}],"title":"main()","roleHeading":"Type Method"},"identifier":{"url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/main()","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"main"},{"kind":"text","text":"()"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given one argument, a directory, it writes the plan there, as "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"does: it exits with status 0 once the plan is written, and 73 ("},{"code":"EX_CANTCREAT","type":"codeVoice"},{"type":"text","text":") when a file"},{"type":"text","text":" "},{"type":"text","text":"can’t be written."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"check"},{"type":"text","text":" and a directory, it compares the plan with the one committed there, as"},{"type":"text","text":" "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","type":"reference","isActive":true},{"type":"text","text":" does, printing the check’s report when they"},{"type":"text","text":" "},{"type":"text","text":"differ: it exits with status 0 when they match, 1 when a difference is breaking, and 2 when"},{"type":"text","text":" "},{"type":"text","text":"the committed plan is only out of date."}]},{"type":"paragraph","inlineContent":[{"text":"Given ","type":"text"},{"code":"check --breaking-only","type":"codeVoice"},{"text":" and a directory, it compares them the same way but fails only","type":"text"},{"text":" ","type":"text"},{"text":"when a difference is breaking: it exits with status 1 then, printing the report, and 0 when","type":"text"},{"text":" ","type":"text"},{"text":"they match or the plan there is only out of date. It prints the differences of an","type":"text"},{"text":" ","type":"text"},{"text":"out-of-date plan to standard output, as information.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given anything else, it exits with status 64 ("},{"type":"codeVoice","code":"EX_USAGE"},{"type":"text","text":"): "},{"type":"codeVoice","code":"check"},{"type":"text","text":" alone (write to "},{"type":"codeVoice","code":".\/check"},{"type":"text","text":" "},{"type":"text","text":"for a directory of that name), "},{"type":"codeVoice","code":"check --breaking-only"},{"type":"text","text":" alone, the flag in any other place,"},{"type":"text","text":" "},{"type":"text","text":"or a directory whose name starts with "},{"type":"codeVoice","code":"-"},{"type":"text","text":", as a mistyped option would (write "},{"type":"codeVoice","code":".\/-name"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"one). When "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan","isActive":true,"type":"reference"},{"type":"text","text":" throws, it exits with status 65 ("},{"type":"codeVoice","code":"EX_DATAERR"},{"type":"text","text":"). Every failure is"},{"type":"text","text":" "},{"type":"text","text":"printed to standard error."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/trackingplans\/trackingplancommand\/main()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand"]]},"abstract":[{"type":"text","text":"Writes or checks "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan","isActive":true},{"type":"text","text":" as the command’s arguments say, and exits."}],"sections":[],"references":{"doc://TrackingPlans/documentation/TrackingPlans":{"type":"topic","role":"collection","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","kind":"symbol","title":"TrackingPlans","url":"\/documentation\/trackingplans","abstract":[{"type":"text","text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it."}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCommand":{"type":"topic","title":"TrackingPlanCommand","kind":"symbol","role":"symbol","url":"\/documentation\/trackingplans\/trackingplancommand","navigatorTitle":[{"kind":"identifier","text":"TrackingPlanCommand"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrackingPlanCommand"}],"abstract":[{"text":"An executable that writes a tracking plan: the type marked ","type":"text"},{"code":"@main","type":"codeVoice"},{"text":" in a target of the app’s","type":"text"},{"text":" ","type":"text"},{"text":"package that lists its events.","type":"text"}]},"doc://TrackingPlans/documentat