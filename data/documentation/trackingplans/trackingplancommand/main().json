{"abstract":[{"type":"text","text":"Writes or checks "},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan","type":"reference"},{"type":"text","text":" as the command’s arguments say, and exits."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/main()"},"sections":[],"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"main"},{"kind":"text","text":"()"}],"modules":[{"name":"TrackingPlans"}],"title":"main()","externalID":"s:13TrackingPlans0A11PlanCommandPAAE4mainyyFZ","roleHeading":"Type Method","extendedModule":"TrackingPlans","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TrackingPlans\/TrackingPlanCommand.swift#L75","fileName":"TrackingPlanCommand.swift"}},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"main"},{"kind":"text","text":"()"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Given one argument, a directory, it writes the plan there, as ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"does: it exits with status 0 once the plan is written, and 73 (","type":"text"},{"type":"codeVoice","code":"EX_CANTCREAT"},{"text":") when a file","type":"text"},{"text":" ","type":"text"},{"text":"can’t be written.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Given ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" and a directory, it compares the plan with the one committed there, as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","type":"reference"},{"text":" does, printing the check’s report when they","type":"text"},{"text":" ","type":"text"},{"text":"differ: it exits with status 0 when they match, 1 when a difference is breaking, and 2 when","type":"text"},{"text":" ","type":"text"},{"text":"the committed plan is only out of date.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Given ","type":"text"},{"code":"check --breaking-only","type":"codeVoice"},{"text":" and a directory, it compares them the same way but fails only","type":"text"},{"text":" ","type":"text"},{"text":"when a difference is breaking: it exits with status 1 then, printing the report, and 0 when","type":"text"},{"text":" ","type":"text"},{"text":"they match or the plan there is only out of date. It prints the differences of an","type":"text"},{"text":" ","type":"text"},{"text":"out-of-date plan to standard output, as information.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"iglu"},{"type":"text","text":", a vendor, the kind of registry ("},{"type":"codeVoice","code":"server"},{"type":"text","text":" for Iglu Server, "},{"type":"codeVoice","code":"static"},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"static repository) and a directory, it writes the plan’s events there as the schemas of an"},{"type":"text","text":" "},{"type":"text","text":"Iglu registry under that vendor, as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/writeIgluRegistry(to:vendor:registry:)"},{"type":"text","text":" "},{"type":"text","text":"does: it exits with status 0 once they are written, 64 ("},{"type":"codeVoice","code":"EX_USAGE"},{"type":"text","text":") for a vendor Iglu"},{"type":"text","text":" "},{"type":"text","text":"doesn’t take, 65 ("},{"type":"codeVoice","code":"EX_DATAERR"},{"type":"text","text":") for an event the registry can’t hold (a name Iglu doesn’t"},{"type":"text","text":" "},{"type":"text","text":"take, a keyword Snowplow doesn’t support, a breaking change at a published version, or, for"},{"type":"text","text":" "},{"type":"text","text":"a static repository, any change at one), and 73 when a file can’t be read or written."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given anything else, it exits with status 64 ("},{"code":"EX_USAGE","type":"codeVoice"},{"type":"text","text":"): "},{"code":"check","type":"codeVoice"},{"type":"text","text":" alone (write to "},{"code":".\/check","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"for a directory of that name), "},{"code":"check --breaking-only","type":"codeVoice"},{"type":"text","text":" alone, the flag in any other place,"},{"type":"text","text":" "},{"code":"iglu","type":"codeVoice"},{"type":"text","text":" without a vendor, a kind and a directory, a kind other than "},{"code":"server","type":"codeVoice"},{"type":"text","text":" or "},{"code":"static","type":"codeVoice"},{"type":"text","text":", or a"},{"type":"text","text":" "},{"type":"text","text":"directory or vendor whose name starts with "},{"code":"-","type":"codeVoice"},{"type":"text","text":", as a mistyped option would (write "},{"code":".\/-name","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"for a directory). When "},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan","type":"reference"},{"type":"text","text":" throws, it exits with status 65 ("},{"code":"EX_DATAERR","type":"codeVoice"},{"type":"text","text":"). Every"},{"type":"text","text":" "},{"type":"text","text":"failure is printed to standard error."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackingplans\/trackingplancommand\/main()"]}],"hierarchy":{"paths":[["doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand"]]},"references":{"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/writeIgluRegistry(to:vendor:registry:)":{"role":"symbol","abstract":[{"text":"Writes the plan’s events as the schemas of an Iglu registry of the kind ","type":"text"},{"code":"registry","type":"codeVoice"},{"text":" under","type":"text"},{"text":" ","type":"text"},{"code":"vendor","type":"codeVoice"},{"text":" into ","type":"text"},{"code":"directory","type":"codeVoice"},{"text":", the registry’s root, creating the directories needed.","type":"text"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/writeIgluRegistry(to:vendor:registry:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"writeIgluRegistry","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"vendor","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"registry","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans12IgluRegistryO","text":"IgluRegistry","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans15IgluExportErrorO","text":"IgluExportError","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"writeIgluRegistry(to:vendor:registry:)","type":"topic","url":"\/documentation\/trackingplans\/trackingplan\/writeigluregistry(to:vendor:registry:)","kind":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCommand/trackingPlan":{"abstract":[{"type":"text","text":"The plan the command writes."}],"kind":"symbol","role":"symbol","required":true,"title":"trackingPlan","url":"\/documentation\/trackingplans\/trackingplancommand\/trackingplan","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trackingPlan","kind":"identifier"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"}]},"doc://TrackingPlans/documentation/TrackingPlans":{"kind":"symbol","url":"\/documentation\/trackingplans","abstract":[{"text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it.","type":"text"}],"role":"collection","title":"TrackingPlans","type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCommand":{"navigatorTitle":[{"text":"TrackingPlanCommand","kind":"identifier"}],"kind":"symbol","title":"TrackingPlanCommand","url":"\/documentation\/trackingplans\/trackingplancommand","abstract":[{"type":"text","text":"An executable that writes a tracking plan: the type marked "},{"type":"codeVoice","code":"@main"},{"type":"text","text":" in a target of the app’s"},{"type":"text","text":" "},{"type":"text","text":"package that links the modules declaring its events."}],"type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlanCommand","kind":"identifier"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCommand/main()":{"title":"main()","abstract":[{"type":"text","text":"Writes or checks "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan","isActive":true},{"type":"text","text":" as the command’s arguments say, and exits."}],"url":"\/documentation\/trackingplans\/trackingplancommand\/main()","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"main","kind":"identifier"},{"text":"()","kind":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/main()"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/write(to:)":{"kind":"symbol","title":"write(to:)","url":"\/documentation\/trackingplans\/trackingplan\/write(to:)","abstract":[{"text":"Writes the plan’s files into ","type":"text"},{"type":"codeVoice","code":"directory"},{"text":", creating it if needed, and deletes the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".schema.json"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".example.json"},{"text":" files there that the plan doesn’t hold.","type":"text"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"write","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"CocoaError","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssential