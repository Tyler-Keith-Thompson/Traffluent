{"metadata":{"externalID":"s:13TrackingPlans0A11PlanCommandPAAE4mainyyFZ","title":"main()","roleHeading":"Type Method","modules":[{"name":"TrackingPlans"}],"extendedModule":"TrackingPlans","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TrackingPlans\/TrackingPlanCommand.swift#L75","fileName":"TrackingPlanCommand.swift"},"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"main","kind":"identifier"},{"text":"()","kind":"text"}],"symbolKind":"method"},"sections":[],"kind":"symbol","abstract":[{"text":"Writes or checks ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan"},{"text":" as the command’s arguments say, and exits.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/main()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"main","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given one argument, a directory, it writes the plan there, as "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"does: it exits with status 0 once the plan is written, and 73 ("},{"type":"codeVoice","code":"EX_CANTCREAT"},{"type":"text","text":") when a file"},{"type":"text","text":" "},{"type":"text","text":"can’t be written."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"check"},{"type":"text","text":" and a directory, it compares the plan with the one committed there, as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","isActive":true},{"type":"text","text":" does, printing the check’s report when they"},{"type":"text","text":" "},{"type":"text","text":"differ: it exits with status 0 when they match, 1 when a difference is breaking, and 2 when"},{"type":"text","text":" "},{"type":"text","text":"the committed plan is only out of date."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"check --breaking-only"},{"type":"text","text":" and a directory, it compares them the same way but fails only"},{"type":"text","text":" "},{"type":"text","text":"when a difference is breaking: it exits with status 1 then, printing the report, and 0 when"},{"type":"text","text":" "},{"type":"text","text":"they match or the plan there is only out of date. It prints the differences of an"},{"type":"text","text":" "},{"type":"text","text":"out-of-date plan to standard output, as information."}]},{"type":"paragraph","inlineContent":[{"text":"Given ","type":"text"},{"code":"iglu","type":"codeVoice"},{"text":", a vendor, the kind of registry (","type":"text"},{"code":"server","type":"codeVoice"},{"text":" for Iglu Server, ","type":"text"},{"code":"static","type":"codeVoice"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"static repository) and a directory, it writes the plan’s events there as the schemas of an","type":"text"},{"text":" ","type":"text"},{"text":"Iglu registry under that vendor, as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/writeIgluRegistry(to:vendor:registry:)","type":"reference"},{"text":" ","type":"text"},{"text":"does: it exits with status 0 once they are written, 64 (","type":"text"},{"code":"EX_USAGE","type":"codeVoice"},{"text":") for a vendor Iglu","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t take, 65 (","type":"text"},{"code":"EX_DATAERR","type":"codeVoice"},{"text":") for an event the registry can’t hold (a name Iglu doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"take, a keyword Snowplow doesn’t support, a breaking change at a published version, or, for","type":"text"},{"text":" ","type":"text"},{"text":"a static repository, any change at one), and 73 when a file can’t be read or written.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given anything else, it exits with status 64 ("},{"type":"codeVoice","code":"EX_USAGE"},{"type":"text","text":"): "},{"type":"codeVoice","code":"check"},{"type":"text","text":" alone (write to "},{"type":"codeVoice","code":".\/check"},{"type":"text","text":" "},{"type":"text","text":"for a directory of that name), "},{"type":"codeVoice","code":"check --breaking-only"},{"type":"text","text":" alone, the flag in any other place,"},{"type":"text","text":" "},{"type":"codeVoice","code":"iglu"},{"type":"text","text":" without a vendor, a kind and a directory, a kind other than "},{"type":"codeVoice","code":"server"},{"type":"text","text":" or "},{"type":"codeVoice","code":"static"},{"type":"text","text":", or a"},{"type":"text","text":" "},{"type":"text","text":"directory or vendor whose name starts with "},{"type":"codeVoice","code":"-"},{"type":"text","text":", as a mistyped option would (write "},{"type":"codeVoice","code":".\/-name"},{"type":"text","text":" "},{"type":"text","text":"for a directory). When "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan","type":"reference","isActive":true},{"type":"text","text":" throws, it exits with status 65 ("},{"type":"codeVoice","code":"EX_DATAERR"},{"type":"text","text":"). Every"},{"type":"text","text":" "},{"type":"text","text":"failure is printed to standard error."}]}]}],"variants":[{"paths":["\/documentation\/trackingplans\/trackingplancommand\/main()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCommand":{"url":"\/documentation\/trackingplans\/trackingplancommand","abstract":[{"text":"An executable that writes a tracking plan: the type marked ","type":"text"},{"type":"codeVoice","code":"@main"},{"text":" in a target of the app’s","type":"text"},{"text":" ","type":"text"},{"text":"package that links the modules declaring its events.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrackingPlanCommand"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand","title":"TrackingPlanCommand","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TrackingPlanCommand"}],"type":"topic"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(against:)":{"url":"\/documentation\/trackingplans\/trackingplan\/check(against:)","title":"check(against:)","abstract":[{"text":"Compares the plan with ","type":"text"},{"code":"committed","type":"codeVoice"},{"text":", the files of a plan exported before, and reports every","type":"text"},{"text":" ","type":"text"},{"text":"difference.","type":"text"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"check"},{"kind":"text","text":"("},{"kind":"externalParam","text":"against"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"TrackingPla