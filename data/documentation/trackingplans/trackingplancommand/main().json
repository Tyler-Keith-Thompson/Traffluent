{"metadata":{"extendedModule":"TrackingPlans","symbolKind":"method","externalID":"s:13TrackingPlans0A11PlanCommandPAAE4mainyyFZ","remoteSource":{"fileName":"TrackingPlanCommand.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TrackingPlans\/TrackingPlanCommand.swift#L75"},"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"main"},{"kind":"text","text":"()"}],"modules":[{"name":"TrackingPlans"}],"title":"main()","role":"symbol","roleHeading":"Type Method"},"hierarchy":{"paths":[["doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand"]]},"abstract":[{"type":"text","text":"Writes or checks "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan"},{"type":"text","text":" as the command’s arguments say, and exits."}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/main()","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"main"},{"kind":"text","text":"()"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given one argument, a directory, it writes the plan there, as "},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"does: it exits with status 0 once the plan is written, and 73 ("},{"code":"EX_CANTCREAT","type":"codeVoice"},{"type":"text","text":") when a file"},{"type":"text","text":" "},{"type":"text","text":"can’t be written."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given "},{"code":"check","type":"codeVoice"},{"type":"text","text":" and a directory, it compares the plan with the one committed there, as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","isActive":true},{"type":"text","text":" does, printing the check’s report when they"},{"type":"text","text":" "},{"type":"text","text":"differ: it exits with status 0 when they match, 1 when a difference is breaking, and 2 when"},{"type":"text","text":" "},{"type":"text","text":"the committed plan is only out of date."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"check --breaking-only"},{"type":"text","text":" and a directory, it compares them the same way but fails only"},{"type":"text","text":" "},{"type":"text","text":"when a difference is breaking: it exits with status 1 then, printing the report, and 0 when"},{"type":"text","text":" "},{"type":"text","text":"they match or the plan there is only out of date. It prints the differences of an"},{"type":"text","text":" "},{"type":"text","text":"out-of-date plan to standard output, as information."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given "},{"code":"iglu","type":"codeVoice"},{"type":"text","text":", a vendor, the kind of registry ("},{"code":"server","type":"codeVoice"},{"type":"text","text":" for Iglu Server, "},{"code":"static","type":"codeVoice"},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"static repository) and a directory, it writes the plan’s events there as the schemas of an"},{"type":"text","text":" "},{"type":"text","text":"Iglu registry under that vendor, as "},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/writeIgluRegistry(to:vendor:registry:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"does: it exits with status 0 once they are written, 64 ("},{"code":"EX_USAGE","type":"codeVoice"},{"type":"text","text":") for a vendor Iglu"},{"type":"text","text":" "},{"type":"text","text":"doesn’t take, 65 ("},{"code":"EX_DATAERR","type":"codeVoice"},{"type":"text","text":") for an event the registry can’t hold (a name Iglu doesn’t"},{"type":"text","text":" "},{"type":"text","text":"take, a keyword Snowplow doesn’t support, a breaking change at a published version, or, for"},{"type":"text","text":" "},{"type":"text","text":"a static repository, any change at one), and 73 when a file can’t be read or written."}]},{"type":"paragraph","inlineContent":[{"text":"Given anything else, it exits with status 64 (","type":"text"},{"code":"EX_USAGE","type":"codeVoice"},{"text":"): ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" alone (write to ","type":"text"},{"code":".\/check","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for a directory of that name), ","type":"text"},{"code":"check --breaking-only","type":"codeVoice"},{"text":" alone, the flag in any other place,","type":"text"},{"text":" ","type":"text"},{"code":"iglu","type":"codeVoice"},{"text":" without a vendor, a kind and a directory, a kind other than ","type":"text"},{"code":"server","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"static","type":"codeVoice"},{"text":", or a","type":"text"},{"text":" ","type":"text"},{"text":"directory or vendor whose name starts with ","type":"text"},{"code":"-","type":"codeVoice"},{"text":", as a mistyped option would (write ","type":"text"},{"code":".\/-name","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for a directory). When ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan"},{"text":" throws, it exits with status 65 (","type":"text"},{"code":"EX_DATAERR","type":"codeVoice"},{"text":"). Every","type":"text"},{"text":" ","type":"text"},{"text":"failure is printed to standard error.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/trackingplans\/trackingplancommand\/main()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://TrackingPlans/documentation/TrackingPlans":{"role":"collection","kind":"symbol","type":"topic","title":"TrackingPlans","abstract":[{"type":"text","text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it."}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","url":"\/documentation\/trackingplans"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCommand/main()":{"url":"\/documentation\/trackingplans\/trackingplancommand\/main()","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/main()","title":"main()","abstract":[{"type":"text","text":"Writes or checks "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan","isActive":true},{"type":"text","text":" as the command’s arguments say, and exits."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"main"},{"kind":"text","text":"()"}],"type":"topic","kind":"symbol","role":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCommand":{"url":"\/documentation\/trackingplans\/trackingplancommand","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand","title":"TrackingPlanCommand","abstract":[{"type":"text","text":"An executable that writes a tracking plan: the type marked "},{"type":"codeVoice","code":"@main"},{"type":"text","text":" in a target of the app’s"},{"type":"text","text":" "},{"type":"text","text":"package that links the modules declaring its events."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlanCommand","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"TrackingPlanCommand","kind":"identifier"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(againstDirectory:)":{"title":"check(againstDirectory:)","abstract":[{"type":"text","text":"Compares the plan with the one committed in "},{"type":"codeVoice","code":"directory"},{"type":"text","text":", as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)"},{"type":"text","text":" does with"},{"type":"text","text":" "},{"type":"text","text":"the directory’s files."}],"kind":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/check(againstdirectory:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"check","kind":"identifier"},{"text":"(","kind":"text"},{"text":"againstDirectory","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO","text":"TrackingPlanCheck","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/write(to:)":{"url":"\/documentation\/trackingplans\/trackingplan\/write(to:)","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","title":"write(to:)","abstract":[{"type":"text","text":"Writes the plan’s files into "},{"code":"directory","type":"codeVoice"},{"type":"text","text":", creating it if needed, and deletes the"},{"type":"text","text":" "},{"code":".schema.json","type":"codeVoice"},{"type":"text","text":" and "},{"code":".example.json","type":"codeVoice"},{"type":"text","text":" files there that the plan doesn’t hold."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"write","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","preciseIdentifier":"s:20FoundationEssentials3URLV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"CocoaError","preciseIdentifier":"s:20FoundationEssentials10CocoaErrorV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","kind":"symbol","role":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(against:)":{"role":"symbol","kind":"symbol","type":"topic","title":"check(against:)","abstract":[{"type":"text","text":"Compares the plan with "},{"code":"committed","type":"codeVoice"},{"type":"text","text":", the files of a plan exported before, and reports every"},{"type":"text","text":" "},{"type":"text","text":"difference."}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)","url":"\/documentation\/trackingplans\/trackingplan\/check(against:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"check"},{"kind":"text","text":"("},{"kind":"externalParam","text":"against"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"File","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","text":"TrackingPlanCheck","preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO"}]},"doc://TrackingPlans/documentation/TrackingPlan