{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackingplans\/trackingplancommand\/main()"]}],"metadata":{"externalID":"s:13TrackingPlans0A11PlanCommandPAAE4mainyyFZ","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"main"},{"kind":"text","text":"()"}],"extendedModule":"TrackingPlans","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TrackingPlans\/TrackingPlanCommand.swift#L75","fileName":"TrackingPlanCommand.swift"},"roleHeading":"Type Method","title":"main()","modules":[{"name":"TrackingPlans"}],"symbolKind":"method"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand"]]},"sections":[],"identifier":{"url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/main()","interfaceLanguage":"swift"},"abstract":[{"text":"Writes or checks ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan","type":"reference"},{"text":" as the command’s arguments say, and exits.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"main"},{"kind":"text","text":"()"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given one argument, a directory, it writes the plan there, as "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"does: it exits with status 0 once the plan is written, and 73 ("},{"code":"EX_CANTCREAT","type":"codeVoice"},{"type":"text","text":") when a file"},{"type":"text","text":" "},{"type":"text","text":"can’t be written."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given "},{"code":"check","type":"codeVoice"},{"type":"text","text":" and a directory, it compares the plan with the one committed there, as"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","type":"reference"},{"type":"text","text":" does, printing the check’s report when they"},{"type":"text","text":" "},{"type":"text","text":"differ: it exits with status 0 when they match, 1 when a difference is breaking, and 2 when"},{"type":"text","text":" "},{"type":"text","text":"the committed plan is only out of date."}]},{"type":"paragraph","inlineContent":[{"text":"Given ","type":"text"},{"code":"check --breaking-only","type":"codeVoice"},{"text":" and a directory, it compares them the same way but fails only","type":"text"},{"text":" ","type":"text"},{"text":"when a difference is breaking: it exits with status 1 then, printing the report, and 0 when","type":"text"},{"text":" ","type":"text"},{"text":"they match or the plan there is only out of date. It prints the differences of an","type":"text"},{"text":" ","type":"text"},{"text":"out-of-date plan to standard output, as information.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Given ","type":"text"},{"code":"iglu","type":"codeVoice"},{"text":", a vendor, the kind of registry (","type":"text"},{"code":"server","type":"codeVoice"},{"text":" for Iglu Server, ","type":"text"},{"code":"static","type":"codeVoice"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"static repository) and a directory, it writes the plan’s events there as the schemas of an","type":"text"},{"text":" ","type":"text"},{"text":"Iglu registry under that vendor, as ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/writeIgluRegistry(to:vendor:registry:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"does: it exits with status 0 once they are written, 64 (","type":"text"},{"code":"EX_USAGE","type":"codeVoice"},{"text":") for a vendor Iglu","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t take, 65 (","type":"text"},{"code":"EX_DATAERR","type":"codeVoice"},{"text":") for an event the registry can’t hold (a name Iglu doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"take, a keyword Snowplow doesn’t support, a breaking change at a published version, or, for","type":"text"},{"text":" ","type":"text"},{"text":"a static repository, any change at one), and 73 when a file can’t be read or written.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Given anything else, it exits with status 64 (","type":"text"},{"code":"EX_USAGE","type":"codeVoice"},{"text":"): ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" alone (write to ","type":"text"},{"code":".\/check","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for a directory of that name), ","type":"text"},{"code":"check --breaking-only","type":"codeVoice"},{"text":" alone, the flag in any other place,","type":"text"},{"text":" ","type":"text"},{"code":"iglu","type":"codeVoice"},{"text":" without a vendor, a kind and a directory, a kind other than ","type":"text"},{"code":"server","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"static","type":"codeVoice"},{"text":", or a","type":"text"},{"text":" ","type":"text"},{"text":"directory or vendor whose name starts with ","type":"text"},{"code":"-","type":"codeVoice"},{"text":", as a mistyped option would (write ","type":"text"},{"code":".\/-name","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for a directory). When ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan","isActive":true,"type":"reference"},{"text":" throws, it exits with status 65 (","type":"text"},{"code":"EX_DATAERR","type":"codeVoice"},{"text":"). Every","type":"text"},{"text":" ","type":"text"},{"text":"failure is printed to standard error.","type":"text"}]}]}],"references":{"doc://TrackingPlans/documentation/TrackingPlans":{"kind":"symbol","url":"\/documentation\/trackingplans","role":"collection","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","abstract":[{"type":"text","text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it."}],"type":"topic","title":"TrackingPlans"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/write(to:)":{"type":"topic","abstract":[{"type":"text","text":"Writes the plan’s files into "},{"code":"directory","type":"codeVoice"},{"type":"text","text":", creating it if needed, and deletes the"},{"type":"text","text":" "},{"code":".schema.json","type":"codeVoice"},{"type":"text","text":" and "},{"code":".example.json","type":"codeVoice"},{"type":"text","text":" files there that the plan doesn’t hold."}],"title":"write(to:)","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","kind":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/write(to:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"write","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"CocoaError","kind":"typeIdentifier","preciseIdentifier":"s:20Founda