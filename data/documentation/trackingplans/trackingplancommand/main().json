":"paragraph"},{"inlineContent":[{"text":"Given ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" and a directory, it compares the plan with the one committed there, as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","type":"reference"},{"text":" does, printing the check’s report when they","type":"text"},{"text":" ","type":"text"},{"text":"differ: it exits with status 0 when they match, 1 when a difference is breaking, and 2 when","type":"text"},{"text":" ","type":"text"},{"text":"the committed plan is only out of date.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Given anything else, "},{"type":"codeVoice","code":"check"},{"type":"text","text":" alone included (write to "},{"type":"codeVoice","code":".\/check"},{"type":"text","text":" for a directory of that"},{"type":"text","text":" "},{"type":"text","text":"name), it exits with status 64 ("},{"type":"codeVoice","code":"EX_USAGE"},{"type":"text","text":"). Every failure is printed to"},{"type":"text","text":" "},{"type":"text","text":"standard error."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/trackingplans\/trackingplancommand\/main()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/main()"},"references":{"doc://TrackingPlans/documentation/TrackingPlans":{"role":"collection","abstract":[],"type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","title":"TrackingPlans","url":"\/documentation\/trackingplans","kind":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(against:)":{"title":"check(against:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"check","kind":"identifier"},{"text