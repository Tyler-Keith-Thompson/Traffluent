destination"},{"type":"text","text":" "},{"type":"text","text":"covers the module these checks test."}]}]}],"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Checking a destination","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"],"anchor":"Checking-a-destination"},{"title":"Sending without a network","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"],"anchor":"Sending-without-a-network"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting"},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"metadata":{"roleHeading":"Framework","title":"DestinationTesting","role":"collection","symbolKind":"module","modules":[{"name":"DestinationTesting"}],"externalID":"DestinationTesting"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinationtesting"]}],"references":{"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck":{"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"ConformanceCheck","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/conformancecheck","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConformanceCheck","kind":"identifier"}],"title":"ConformanceCheck","abstract":[{"text":"One rule every vendor destination keeps, which ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"checks.","type":"text"}],"identifier":"doc:\/\/DestinationTestin