{"kind":"symbol","primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance"},{"type":"text","text":" runs the checks every vendor destination must pass, through a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"},{"type":"text","text":" that keeps each request and answers from a script rather than the network:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"its requests match recorded fixtures byte for byte;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is sent only after the adopter opts in, and only while the record reveals it;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"behind a tracker’s consent and ","type":"text"},{"type":"codeVoice","code":"accepting(_:)"},{"text":", it sends exactly the records it is handed;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;"}]}]},{"content":[{"inlineContent":[{"text":"no response, a 5xx, 408 and 429 are retried, and other failures are dropped and reported;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no request carries a trace context in its header fields, even while a tracer is active."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"},{"type":"text","text":"’s plan, transport and backoff. Run each "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck"},{"type":"text","text":" as a test case of"},{"type":"text","text":" "},{"type":"text","text":"its own:"}]},{"type":"codeListing","syntax":"swift","code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own"},{"type":"text","text":" "},{"type":"text","text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"expectTrackingPlan(_:matches:sourceLocation:)"},{"type":"text","text":" is, so every vendor module runs the same checks."},{"type":"text","text":" "},{"type":"text","text":"It imports Swift Testing, so add it to test targets only. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves it out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers the module these checks test."}]}],"kind":"content"}],"topicSections":[{"anchor":"Checking-a-destination","title":"Checking a destination","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"]},{"anchor":"Sending-without-a-network","title":"Sending without a network","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinationtesting"]}],"abstract":[{"text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[[]]},"metadata":{"externalID":"DestinationTesting","symbolKind":"module","modules":[{"name":"DestinationTesting"}],"roleHeading":"Framework","role":"collection","title":"DestinationTesting"},"references":{"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationSetup"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"DestinationSetup"}],"role":"symbol","url":"\/documentation\/destinationtesting\/destinationsetup","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","abstract":[{"text":"What a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference"},{"text":" check hands the vendor’s factory: the plan of the events it","type":"text"},{"text":" ","type":"text"},{"text":"sends, the transport to send them through, and a backoff short enough that a retry doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"hold the test up.","type":"text"}],"kind":"symbol","title":"DestinationSetup"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance/expect(_:sourceLocation:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expect","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ConformanceCheck","preciseIdentifier":"s:18DestinationTesting16ConformanceCheckO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"sourceLocation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SourceLocation","preciseIdentifier":"s:7Testing14SourceLocationV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"type":"topic","role":"symbol","url":"\/documentation\/destinationtesting\/destinationconformance\/expect(_:sourcelocation:)","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","abstract":[{"text":"Records an issue for each way the destination breaks ","type":"text"},{"code":"check","type":"codeVoice"},{"text":"’s rule.","type":"text"}],"kind":"symbol","title":"expect(_:sourceLocation:)"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConformanceCheck","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"ConformanceCheck","kind":"identifier"}],"role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","abstract":[{"text":"One rule every vendor destination keeps, which ","type":"text"},{"isActive":true,"identifier":"doc:\/\/DestinationT