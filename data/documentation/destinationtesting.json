{"kind":"symbol","identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true,"type":"reference"},{"text":" runs the checks every vendor destination must pass, through a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","isActive":true,"type":"reference"},{"text":" that keeps each request and answers from a script rather than the network:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"its requests match recorded fixtures byte for byte;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"behind a tracker’s consent and "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":", it sends exactly the records it is handed;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"no response, a 5xx, 408, 429 and each status of the encoder’s "},{"type":"codeVoice","code":"transientStatuses"},{"type":"text","text":" are retried,"},{"type":"text","text":" "},{"type":"text","text":"and other failures are dropped and reported;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a 2xx answer whose body the encoder can’t read, an empty one included, counts as delivered: sent"},{"type":"text","text":" "},{"type":"text","text":"once, nothing reported;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"no request carries a trace context in its header fields, even while a tracer is active.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"},{"type":"text","text":"‘s plan, transport and backoff. Every check’s records are tracked at the"},{"type":"text","text":" "},{"type":"text","text":"setup’s "},{"code":"timestamp","type":"codeVoice"},{"type":"text","text":"; a factory whose encoder leaves out records by their age takes it as the time"},{"type":"text","text":" "},{"type":"text","text":"it encodes at, so the checks pass whenever the test runs. Run each "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck"},{"type":"text","text":" as a test"},{"type":"text","text":" "},{"type":"text","text":"case of its own:"}]},{"type":"codeListing","code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own"},{"type":"text","text":" "},{"type":"text","text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"expectTrackingPlan(_:matches:sourceLocation:)"},{"type":"text","text":" is, so every vendor module runs the same checks."},{"type":"text","text":" "},{"type":"text","text":"It imports Swift Testing, so add it to test targets only. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves it out."}]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers the module these checks test.","type":"text"}]}],"kind":"content"}],"metadata":{"role":"collection","title":"DestinationTesting","symbolKind":"module","modules":[{"name":"DestinationTesting"}],"roleHeading":"Framework","externalID":"DestinationTesting"},"topicSections":[{"anchor":"Checking-a-destination","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"],"title":"Checking a destination"},{"anchor":"Sending-without-a-network","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"],"title":"Sending without a network"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinationtesting"]}],"hierarchy":{"paths":[[]]},"abstract":[{"text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance/expect(_:sourceLocation:)":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Records an issue for each way the destination breaks "},{"type":"codeVoice","code":"check"},{"type":"text","text":"’s rule."}],"kind":"symbol","url":"\/documentation\/destinationtesting\/destinationconformance\/expect(_:sourcelocation:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expect"},{"kind":"text","text":"("},{"preciseIdentifier":"s:18DestinationTesting16ConformanceCheckO","kind":"typeIdentifier","text":"ConformanceCheck"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7Testing14SourceLocationV","kind":"typeIdentifier","text":"SourceLocation"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","title":"expect(_:sourceLocation:)"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConformanceCheck"}],"title":"ConformanceCheck","url":"\/documentation\/destinationtesting\/conformancecheck","role":"symbol","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","type":"topic","abstract":[{"text":"One rule every vendor destination keeps, which ","type":"text"},{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","type":"reference"},{"text":" ","type":"text"},{"text":"checks.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"ConformanceCheck"}]},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance":{"kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","role":"symbol","title":"DestinationConformance","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationConformance"}],"type":"topic","url":"\/documentation\/destinationtesting\/destinationconformance","abstract":[{"type":"text","text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests"},{"type":"text","text":" "},{"type":"text","text":"match recorded fixtures byte for byte, and it keeps the library’s rules for "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"consent, oversized records, retries, 2xx answers and trace context."}],"navigatorTitle":[{"kind":"identifier","text":"DestinationConformance"}]},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationSetup","kind":"identifier"}],"navigatorTitle":[{"text":"DestinationSetup","kind":"identifier"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","type":"topic","url":"\/documentation\/destinationtesting\/destinationsetup","role":"symbol","abstract":[{"text":"What a ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference","isActive":true},{"text":" check hands the vendor’s factory: the plan of the events it","type":"text"},{"text":" ","type":"text"},{"text":"sends, the transport to send them through, a backoff short enough that a retry doesn’t hold the","type":"text"},{"text":" ","type":"text"},{"text":"test up, and when its records were tracked.","type":"text"}],"kind":"symbol","title":"DestinationSet