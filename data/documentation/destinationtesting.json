{"metadata":{"role":"collection","title":"DestinationTesting","externalID":"DestinationTesting","symbolKind":"module","modules":[{"name":"DestinationTesting"}],"roleHeading":"Framework"},"kind":"symbol","hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true,"type":"reference"},{"text":" runs the checks every vendor destination must pass, through a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","isActive":true,"type":"reference"},{"text":" that keeps each request and answers from a script rather than the network:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"its requests match recorded fixtures byte for byte;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"behind a tracker’s consent and "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":", it sends exactly the records it is handed;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no response, a 5xx, 408 and 429 are retried, and other failures are dropped and reported;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no request carries a trace context in its header fields, even while a tracer is active."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"},{"type":"text","text":"‘s plan, transport and backoff. Every check’s records are tracked at the"},{"type":"text","text":" "},{"type":"text","text":"setup’s "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":"; a factory whose encoder leaves out records by their age takes it as the time"},{"type":"text","text":" "},{"type":"text","text":"it encodes at, so the checks pass whenever the test runs. Run each "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck"},{"type":"text","text":" as a test"},{"type":"text","text":" "},{"type":"text","text":"case of its own:"}],"type":"paragraph"},{"syntax":"swift","code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own"},{"type":"text","text":" "},{"type":"text","text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s"},{"type":"text","text":" "},{"code":"expectTrackingPlan(_:matches:sourceLocation:)","type":"codeVoice"},{"type":"text","text":" is, so every vendor module runs the same checks."},{"type":"text","text":" "},{"type":"text","text":"It imports Swift Testing, so add it to test targets only. "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" leaves it out."}],"type":"paragraph"},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","type":"reference"},{"text":" ","type":"text"},{"text":"covers the module these checks test.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinationtesting"]}],"topicSections":[{"anchor":"Checking-a-destination","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"],"title":"Checking a destination"},{"anchor":"Sending-without-a-network","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"],"title":"Sending without a network"}],"abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"references":{"doc://DestinationTesting/documentation/DestinationTesting":{"role":"collection","type":"topic","url":"\/documentation\/destinationtesting","abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"kind":"symbol","title":"DestinationTesting","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"kind":"symbol","url":"\/documentation\/destinationtesting\/destinationsetup","role":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationSetup","kind":"identifier"}],"navigatorTitle":[{"text":"DestinationSetup","kind":"identifier"}],"type":"topic","title":"DestinationSetup","abstract":[{"type":"text","text":"What a "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true},{"type":"text","text":" check hands the vendor’s factory: the plan of the events it"},{"type":"text","text":" "},{"type":"text","text":"sends, the transport to send them through, a backoff short enough that a retry doesn’t hold the"},{"type":"text","text":" "},{"type":"text","text":"test up, and when its records were tracked."}]},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance":{"kind":"symbol","url":"\/documentation\/destinationtesting\/destinationconformance","role":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationConformance"}],"navigatorTitle":[{"kind":"identifier","text":"DestinationConformance"}],"type":"topic","title":"DestinationConformance","abstract":[{"type":"text","text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests"},{"type":"text","text":" "},{"type":"text","text":"match recorded fixtures byte for byte, and it keeps the library’s rules for "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"consent, oversized records, retries and trace context."}]},"doc://DestinationTesting/documentation/DestinationTesting/ScriptedTransport":{"url":"\/documentation\/destinationtesting\/scriptedtransport","title":"ScriptedTransport","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","abstract":[{"text":"An ","type":"text"},{"code":"HTTPTransport","type":"codeVoice"},{"text":" that answers each request from a script and keeps every request it is","type":"text"},{"text":" ","type":"text"},{"text":"sent: the seam a ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true,"type":"reference"},{"text":" check sends through instead of the network.","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScriptedTransport","kind":"identifier"}],"navigatorTitle":[{"text":"ScriptedTransport","kind":"identifier"}]},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck":{"kind":"symbol","type":"topic","navigatorTitle":[{"text":"ConformanceCheck","kind":"identifier"}],"title":"ConformanceCheck","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConformanceCheck","kind":"identifier"}],"abstract":[{"type":"text","text":"One rule every vendor destination keeps, which "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"checks."}],"url":"\/documentation\/destinationtesting\/conformancecheck","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance/expect(_:sourceLocation:)":{"kind":"symbol","url":"\/documentation\/destinationtesting\/destinationconformance\/expe