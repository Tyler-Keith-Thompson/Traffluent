{"identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","title":"DestinationTesting","modules":[{"name":"DestinationTesting"}],"role":"collection","symbolKind":"module","externalID":"DestinationTesting"},"topicSections":[{"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"],"title":"Checking a destination","anchor":"Checking-a-destination"},{"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"],"title":"Sending without a network","anchor":"Sending-without-a-network"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true},{"type":"text","text":" runs the checks every vendor destination must pass, through a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","isActive":true},{"type":"text","text":" that keeps each request and answers from a script rather than the network:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"its requests match recorded fixtures byte for byte;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"behind a tracker’s consent and "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", it sends exactly the records it is handed;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no response, a 5xx, 408, 429 and each status of the encoder’s "},{"type":"codeVoice","code":"transientStatuses"},{"type":"text","text":" are retried,"},{"type":"text","text":" "},{"type":"text","text":"and other failures are dropped and reported;"}]}]},{"content":[{"inlineContent":[{"text":"no request carries a trace context in its header fields, even while a tracer is active.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","type":"reference","isActive":true},{"type":"text","text":"‘s plan, transport and backoff. Every check’s records are tracked at the"},{"type":"text","text":" "},{"type":"text","text":"setup’s "},{"code":"timestamp","type":"codeVoice"},{"type":"text","text":"; a factory whose encoder leaves out records by their age takes it as the time"},{"type":"text","text":" "},{"type":"text","text":"it encodes at, so the checks pass whenever the test runs. Run each "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","type":"reference","isActive":true},{"type":"text","text":" as a test"},{"type":"text","text":" "},{"type":"text","text":"case of its own:"}],"type":"paragraph"},{"syntax":"swift","code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own"},{"type":"text","text":" "},{"type":"text","text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"expectTrackingPlan(_:matches:sourceLocation:)"},{"type":"text","text":" is, so every vendor module runs the same checks."},{"type":"text","text":" "},{"type":"text","text":"It imports Swift Testing, so add it to test targets only. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves it out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers the module these checks test."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/destinationtesting"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/writingavendordestination":{"title":"Writing a Vendor Destination","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","titleInlineContent":[{"type":"text","text":"Writing a Vendor Destination"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","type":"link"},"doc://DestinationTesting/documentation/DestinationTesting/ScriptedTransport":{"navigatorTitle":[{"text":"ScriptedTransport","kind":"identifier"}],"role":"symbol","abstract":[{"text":"An ","type":"text"},{"code":"HTTPTransport","type":"codeVoice"},{"text":" that answers each request from a script and keeps every request it is","type":"text"},{"text":" ","type":"text"},{"text":"sent: the seam a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference"},{"text":" check sends through instead of the network.","type":"text"}],"kind":"symbol","title":"ScriptedTransport","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScriptedTransport","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/scriptedtransport"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"navigatorTitle":[{"text":"DestinationSetup","kind":"identifier"}],"role":"symbol","abstract":[{"text":"What a ","type":"text"},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true},{"text":" check hands the vendor’s factory: the plan of the events it","type":"text"},{"text":" ","type":"text"},{"text":"sends, the transport to send them through, a backoff short enough that a retry doesn’t hold the","type":"text"},{"text":" ","type":"text"},{"text":"test up, and when its records were tracked.","type":"text"}],"kind":"symbol","title":"DestinationSetup","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationSetup","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/destinationsetup"},"doc://DestinationTesting/documentation/DestinationTesting":{"url":"\/documentation\/destinationtesting","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","kind":"symbol","type":"topic","role":"collection","abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"title":"DestinationTesting"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance/expect(_:sourceLocation:)":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","abstract":[{"text":"Records an issue for each way the destination breaks ","type":"text"},{"code":"check","type":"codeVoice"},{"text":"’s rule.","type":"text"}],"role":"symbol","type":"topic","title":"expect(_:sourceLocation:)","url":"\/documentation\/destinationtesting\/destinationconformance\/expect(_:sourcelocation:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expect","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ConformanceCheck","kind":"typeIdentifier","preciseIdentifier":"s:18DestinationTesting16ConformanceCheckO"},{"text":", ","kind":"text"},{"text":"sourceLocation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SourceLocation","kind":"typeIdentifier","preciseIdentifier":"s:7Testing14SourceLocationV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance":{"navigatorTitle":[{"text":"DestinationConformance","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests"},{"type":"text","text":" "},{"type":"text","text":"match recorded fixtures byte for byte, and it keeps the library’s rules for "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"consent, oversized records, retries and trace context."}],"kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","title":"DestinationConformance","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationConformance","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/destinationconformance"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck":{"abstract":[{"type":"text","text":"One rule every vendor destination keeps, which "},{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"checks."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ConformanceCheck"}],"url":"\/documentation\/destinationtesting\/conformancecheck","type":"topic","title":"ConformanceCheck","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConformanceCheck"}]}}}