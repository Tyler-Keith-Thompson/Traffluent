{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinationtesting"]}],"kind":"symbol","sections":[],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance"},{"type":"text","text":" runs the checks every vendor destination must pass, through a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"},{"type":"text","text":" that keeps each request and answers from a script rather than the network:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"its requests match recorded fixtures byte for byte;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"behind a tracker’s consent and "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", it sends exactly the records it is handed;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no response, a 5xx, 408, 429 and each status of the encoder’s "},{"type":"codeVoice","code":"transientStatuses"},{"type":"text","text":" are retried,"},{"type":"text","text":" "},{"type":"text","text":"and other failures are dropped and reported;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a 2xx answer whose body the encoder can’t read, an empty one included, counts as delivered: sent"},{"type":"text","text":" "},{"type":"text","text":"once, nothing reported;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"no request carries a trace context in its header fields, even while a tracer is active.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"},{"type":"text","text":"‘s plan, transport and backoff. Every check’s records are tracked at the"},{"type":"text","text":" "},{"type":"text","text":"setup’s "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":"; a factory whose encoder leaves out records by their age takes it as the time"},{"type":"text","text":" "},{"type":"text","text":"it encodes at, so the checks pass whenever the test runs. Run each "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck"},{"type":"text","text":" as a test"},{"type":"text","text":" "},{"type":"text","text":"case of its own:"}],"type":"paragraph"},{"syntax":"swift","code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own"},{"type":"text","text":" "},{"type":"text","text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"expectTrackingPlan(_:matches:sourceLocation:)"},{"type":"text","text":" is, so every vendor module runs the same checks."},{"type":"text","text":" "},{"type":"text","text":"It imports Swift Testing, so add it to test targets only. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves it out."}],"type":"paragraph"},{"inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers the module these checks test.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Framework","externalID":"DestinationTesting","title":"DestinationTesting","modules":[{"name":"DestinationTesting"}],"symbolKind":"module","role":"collection"},"identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"topicSections":[{"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"],"title":"Checking a destination","anchor":"Checking-a-destination"},{"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"],"title":"Sending without a network","anchor":"Sending-without-a-network"}],"references":{"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationConformance"}],"navigatorTitle":[{"kind":"identifier","text":"DestinationConformance"}],"type":"topic","abstract":[{"text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests","type":"text"},{"text":" ","type":"text"},{"text":"match recorded fixtures byte for byte, and it keeps the library’s rules for ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" values,","type":"text"},{"text":" ","type":"text"},{"text":"consent, oversized records, retries, 2xx answers and trace context.","type":"text"}],"url":"\/documentation\/destinationtesting\/destinationconformance","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","title":"DestinationConformance","kind":"symbol"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck":{"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConformanceCheck"}],"navigatorTitle":[{"kind":"identifier","text":"ConformanceCheck"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","abstract":[{"type":"text","text":"One rule every vendor destination keeps, which "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)"},{"type":"text","text":" "},{"type":"text","text":"checks."}],"kind":"symbol","title":"ConformanceCheck","url":"\/documentation\/destinationtesting\/conformancecheck","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting":{"url":"\/documentation\/destinationtesting","abstract":[{"text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record.","type":"text"}],"title":"DestinationTesting","type":"topic","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","kind":"symbol","role":"collection"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationSetup","kind":"identifier"}],"navigatorTitle":[{"text":"DestinationSetup","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"What a "},{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference"},{"type":"text","text":" check hands the vendor’s factory: the plan of the events it"},{"type":"text","text":" "},{"type":"text","text":"sends, the transport to send them through, a backoff short enough that a retry doesn’t hold the"},{"type":"text","text":" "},{"type":"text","text":"test up, and when its records were tracked."}],"url":"\/documentation\/destinationtesting\/destinationsetup","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","title":"DestinationSetup","kind":"symbol"},"doc://DestinationTesting/documentation/DestinationTesting/ScriptedTransport":{"abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"HTTPTransport"},{"type":"text","text":" that answers each request from a script and keeps every request it is"},{"type":"text","text":" "},{"type":"text","text":"sent: the seam a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance"},{"type":"text","text":" check sends through instead of the network."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","role":"symbol","type":"topic","title":"ScriptedTransport","kind":"symbol","fragments":[{"text":"struct","kin