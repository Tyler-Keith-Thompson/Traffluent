{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"module","roleHeading":"Framework","role":"collection","title":"DestinationTesting","externalID":"DestinationTesting","modules":[{"name":"DestinationTesting"}]},"kind":"symbol","identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"title":"Checking a destination","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"],"anchor":"Checking-a-destination"},{"title":"Sending without a network","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"],"anchor":"Sending-without-a-network"}],"abstract":[{"text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record.","type":"text"}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true},{"type":"text","text":" runs the checks every vendor destination must pass, through a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","isActive":true},{"type":"text","text":" that keeps each request and answers from a script rather than the network:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"its requests match recorded fixtures byte for byte;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"behind a tracker’s consent and ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":", it sends exactly the records it is handed;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no response, a 5xx, 408, 429 and each status of the encoder’s "},{"type":"codeVoice","code":"transientStatuses"},{"type":"text","text":" are retried,"},{"type":"text","text":" "},{"type":"text","text":"and other failures are dropped and reported;"}]}]},{"content":[{"inlineContent":[{"text":"a 2xx answer whose body the encoder can’t read, an empty one included, counts as delivered: sent","type":"text"},{"text":" ","type":"text"},{"text":"once, nothing reported;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no request carries a trace context in its header fields, even while a tracer is active."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"},{"type":"text","text":"‘s plan, transport and backoff. Every check’s records are tracked at the"},{"type":"text","text":" "},{"type":"text","text":"setup’s "},{"code":"timestamp","type":"codeVoice"},{"type":"text","text":"; a factory whose encoder leaves out records by their age takes it as the time"},{"type":"text","text":" "},{"type":"text","text":"it encodes at, so the checks pass whenever the test runs. Run each "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck"},{"type":"text","text":" as a test"},{"type":"text","text":" "},{"type":"text","text":"case of its own:"}]},{"type":"codeListing","syntax":"swift","code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own"},{"type":"text","text":" "},{"type":"text","text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s"},{"type":"text","text":" "},{"code":"expectTrackingPlan(_:matches:sourceLocation:)","type":"codeVoice"},{"type":"text","text":" is, so every vendor module runs the same checks."},{"type":"text","text":" "},{"type":"text","text":"It imports Swift Testing, so add it to test targets only. "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" leaves it out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"covers the module these checks test."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinationtesting"]}],"hierarchy":{"p