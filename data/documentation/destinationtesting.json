kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","title":"expect(_:sourceLocation:)"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"url":"\/documentation\/destinationtesting\/destinationsetup","kind":"symbol","abstract":[{"type":"text","text":"What a "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference","isActive":true},{"type":"text","text":" check hands the vendor’s factory: the plan of the events it"},{"type":"text","text":" "},{"type":"text","text":"sends, the transport to send them through, a backoff short enough that a retry doesn’t hold the"},{"type":"text","text":" "},{"type":"text","text":"test up, and when its records were tracked."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationSetup","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"DestinationSetup","kind":"identifier"}],"title":"DestinationSetup"},"doc://DestinationTesting/documentation/DestinationTesting/ScriptedTransport":{"url":"\/documentation\/destinationtesting\/scriptedtransport","type":"topic","role":"symbol","navigatorTitle":[{"text":"ScriptedTransport","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScriptedTransport","kind":"identifier"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"HTTPTransport"},{"type":"text","text":" that answers each request from a script and keeps every request it is"},{"type":"text","text":" "},{"type":"text","text":"sent: the seam a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting