{"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference","isActive":true},{"text":" runs the checks every vendor destination must pass, through a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","type":"reference","isActive":true},{"text":" that keeps each request and answers from a script rather than the network:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"its requests match recorded fixtures byte for byte;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"behind a tracker’s consent and "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", it sends exactly the records it is handed;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"no response, a 5xx, 408 and 429 are retried, and other failures are dropped and reported;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"no request carries a trace context in its header fields, even while a tracer is active."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"},{"type":"text","text":"’s plan, transport and backoff. Run each "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck"},{"type":"text","text":" as a test case of"},{"type":"text","text":" "},{"type":"text","text":"its own:"}]},{"type":"codeListing","syntax":"swift","code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own"},{"type":"text","text":" "},{"type":"text","text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"expectTrackingPlan(_:matches:sourceLocation:)"},{"type":"text","text":" is, so every vendor module runs the same checks."},{"type":"text","text":" "},{"type":"text","text":"It imports Swift Testing, so add it to test targets only. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves it out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers the module these checks test."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinationtesting"]}],"metadata":{"symbolKind":"module","title":"DestinationTesting","modules":[{"name":"DestinationTesting"}],"roleHeading":"Framework","externalID":"DestinationTesting","role":"collection"},"topicSections":[{"title":"Checking a destination","anchor":"Checking-a-destination","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"]},{"title":"Sending without a network","anchor":"Sending-without-a-network","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"]}],"identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance":{"navigatorTitle":[{"text":"DestinationConformance","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/destinationconformance","type":"topic","abstract":[{"type":"text","text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests"},{"type":"text","text":" "},{"type":"text","text":"match recorded fixtures byte for byte, and it keeps the library’s rules for "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"consent, oversized records, retries and trace context."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationConformance","kind":"identifier"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","title":"DestinationConformance","role":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/writingavendordestination":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","title":"Writing a Vendor Destination","titleInlineContent":[{"type":"text","text":"Writing a Vendor Destination"}]},"doc://DestinationTesting/documentation/DestinationTesting/ScriptedTransport":{"navigatorTitle":[{"kind":"identifier","text":"ScriptedTransport"}],"url":"\/documentation\/destinationtesting\/scriptedtransport","type":"topic","kind":"symbol","abstract":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"HTTPTransport"},{"text":" that answers each request from a script and keeps every request it is","type":"text"},{"text":" ","type":"text"},{"text":"sent: the seam a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance"},{"text":" check sends through instead of the network.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScriptedTransport"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","title":"ScriptedTransport","role":"symbol"},"doc://DestinationTesting/documentation/DestinationTesting":{"title":"DestinationTesting","type":"topic","url":"\/documentation\/destinationtesting","abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","kind":"symbol","role":"collection"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"abstract":[{"type":"text","text":"What a "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference","isActive":true},{"type":"text","text":" check hands the vendor’s factory: the plan of the events it"},{"type":"text","text":" "},{"type":"text","text":"sends, the transport to send them through, and a backoff short enough that a retry doesn’t"},{"type":"text","text":" "},{"type":"text","text":"hold the test up."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationSetup","kind":"identifier"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","url":"\/documentation\/destinationtesting\/destinationsetup","navigatorTitle":[{"text":"DestinationSetup","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","title":"DestinationSetup"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance/expect(_:sourceLocation:)":{"title":"expect(_:sourceLocation:)","type":"topic","url":"\/documentation\/destinationtesting\/destinationconformance\/expect(_:sourcelocation:)","abstract":[{"type":"text","text":"Records an issue for each way the destination breaks "},{"code":"check","type":"codeVoice"},{"type":"text","text":"’s rule."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expect"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:18DestinationTesting16ConformanceCheckO","text":"ConformanceCheck"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text"