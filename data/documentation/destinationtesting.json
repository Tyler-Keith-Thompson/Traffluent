{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true,"type":"reference"},{"text":" runs the checks every vendor destination must pass, through a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","isActive":true,"type":"reference"},{"text":" that keeps each request and answers from a script rather than the network:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"its requests match recorded fixtures byte for byte;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"behind a tracker’s consent and "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":", it sends exactly the records it is handed;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;"}]}]},{"content":[{"inlineContent":[{"text":"no response, a 5xx, 408 and 429 are retried, and other failures are dropped and reported;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no request carries a trace context in its header fields, even while a tracer is active."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the","type":"text"},{"text":" ","type":"text"},{