tent":[{"type":"text","text":"a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"behind a tracker’s consent and "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", it sends exactly the records it is handed;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no response, a 5xx, 408 and 429 are retried, and other failures are dropped and reported;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"no request carries a trace context in its header fields, even while a tracer is active."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"},{"type":"text","text":"‘s plan, transport and backoff. Every check’s records are tracked at the"},{"type":"text","text":" "},{"type":"text","text":"setup’s "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":"; a factory whose encoder leaves out records by their age takes it as the time"},{"type":"text","text":" "},{"type":"text","text":"it encodes at, so the checks pass whenever the test runs. Run each "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck"},{"type":"text","text":" as a test"},{"type":"text","text":" "},{"type":"text","text":"case of its own:"}],"type":"paragraph"},{"code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own","type":"text"},{"text":" ","type":"text"},{"text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s","type":"text"},{"text":" ","type":"text"},{"code":"expectTrackingPlan(_:matches:sourceLocation:)","type":"codeVoice"},{"text":" is, so every vendor module runs the same checks.","type":"text"},{"text":" ","type":"text"},{"text":"It imports Swift Testing, so add it to test targets only. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves it out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"covers the module these checks test.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance/expect(_:sourceLocation:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expect","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:18DestinationTesting16ConformanceCheckO","text":"ConformanceCheck","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"sourceLocation","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7Testing14SourceLocationV","text":"SourceLocation","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol","abstract":[{"text":"Records an issue for each way the destination breaks ","type":"text"},{"code":"check","type":"codeVoice"},{"text":"’s rule.","type":"text"}],"role":"symbol","url":"\/documentation\/destinationtesting\/destinationconformance\/expect(_:sourcelocation:)","title":"expect(_:sourceLocation:)","type":"topic","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConformanceCheck"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ConformanceCheck"}],"abstract":[{"type":"text","text":"One rule every vendor destination keeps, which "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"checks."}],"role":"symbol","type":"topic","title":"ConformanceCheck","url":"\/documentation\/destinationtesting\/conformancecheck","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck"},"doc://DestinationTesting/documentation/DestinationTesting":{"title":"DestinationTesting","kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","url":"\/documentation\/destinationtesting","abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}]},"doc://DestinationTesting/documentation/DestinationTesting/ScriptedTransport":{"abstract":[{"text":"An ","type":"text"},{"code":"HTTPTransport","type":"codeVoice"},{"text":" that answers each request from a script and keeps every request it is","type":"text"},{"text":" ","type":"text"},{"text":"sent: the seam a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference"},{"text":" check sends through instead of the network.","type":"text"}],"title":"ScriptedTransport","url":"\/documentation\/destinationtesting\/scriptedtransport","navigatorTitle":[{"kind":"identifier","text":"ScriptedTransport"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScriptedTransport"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","role":"symbol"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"abstract":[{"text":"What a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference"},{"text":" check hands the vendor’s factory: the plan of the events it","type":"text"},{"text":" ","type":"text"},{"text":"sends, the transport to send them through, a backoff short enough that a retry doesn’t hold the","type":"text"},{"text":" ","type":"text"},{"text":"test up, and when its records were tracked.","type":"text"}],"title":"DestinationSetup","url":"\/documentation\/destinationtesting\/destinationsetup","navigatorTitle":[{"text":"DestinationSetup","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationSetup","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","role":"symbol"},"https://tyle