","code":"check"},{"type":"text","text":"’s rule."}],"type":"topic","role":"symbol","title":"expect(_:sourceLocation:)"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance":{"type":"topic","url":"\/documentation\/destinationtesting\/destinationconformance","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationConformance"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","kind":"symbol","abstract":[{"type":"text","text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests"},{"type":"text","text":" "},{"type":"text","text":"match recorded fixtures byte for byte, and it keeps the library’s rules for "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"consent, oversized records, retries and trace context."}],"navigatorTitle":[{"kind":"identifier","text":"DestinationConformance"}],"title":"DestinationConformance"},"doc://DestinationTesting/documentation/DestinationTesting/ScriptedTransport":{"kind":"symbol","url":"\/documentation\/destinationtesting\/scriptedtransport","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScriptedTransport","kind":"identifier"}],"abstract":[{"type":"text","text":"An "},{"code":"HTTPTransport","type":"codeVoice"},{"type":"text","text":" that answers each request from a script and keeps every request it is"},{"type":"text","text":" "},{"type":"text","text":"sent: the seam a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance"},{"type":"text","text":" check sends through instead of the network."}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"ScriptedTransport","kind":"identifier"}],"title":"ScriptedTransport"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"type":"topic","url":"\/documentation\/destinationtesting\/destinationsetup","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationSetup"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","kind":"symbol","abstract":[{"type":"text","text":"What a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance"},{"type":"text","text":" check hands the vendor’s factory: the plan of the events it"},{"type":"text","text":" "},{"type":"text","text":"sends, the transport to send them through, and a backoff short enough that a retry doesn’t"},{"type":"text","text":" "},{"type":"text","text":"hold the test up."}],"navigatorTitle":[{"kind":"identifier","text":"DestinationSetup"}],"title":"DestinationSetup"}}}