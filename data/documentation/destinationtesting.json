{"abstract":[{"text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record.","type":"text"}],"identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true},{"text":" runs the checks every vendor destination must pass, through a","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","isActive":true},{"text":" that keeps each request and answers from a script rather than the network:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"its requests match recorded fixtures byte for byte;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is sent only after the adopter opts in, and only while the record reveals it;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"behind a tracker’s consent and "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":", it sends exactly the records it is handed;"}]}]},{"content":[{"inlineContent":[{"text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no response, a 5xx, 408 and 429 are retried, and other failures are dropped and reported;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"no request carries a trace context in its header fields, even while a tracer is active."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","isActive":true,"type":"reference"},{"text":"‘s plan, transport and backoff. Every check’s records are tracked at the","type":"text"},{"text":" ","type":"text"},{"text":"setup’s ","type":"text"},{"code":"timestamp","type":"codeVoice"},{"text":"; a factory whose encoder leaves out records by their age takes it as the time","type":"text"},{"text":" ","type":"text"},{"text":"it encodes at, so the checks pass whenever the test runs. Run each ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","isActive":true,"type":"reference"},{"text":" as a test","type":"text"},{"text":" ","type":"text"},{"text":"case of its own:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"syntax":"swift"},{"inlineContent":[{"text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own","type":"text"},{"text":" ","type":"text"},{"text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"expectTrackingPlan(_:matches:sourceLocation:)"},{"text":" is, so every vendor module runs the same checks.","type":"text"},{"text":" ","type":"text"},{"text":"It imports Swift Testing, so add it to test targets only. ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves it out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers the module these checks test."}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"DestinationTesting"}],"symbolKind":"module","roleHeading":"Framework","role":"collection","title":"DestinationTesting","externalID":"DestinationTesting"},"topicSections":[{"title":"Checking a destination","anchor":"Checking-a-destination","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"]},{"title":"Sending without a network","anchor":"Sending-without-a-network","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinationtesting"]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://DestinationTesting/documentation/DestinationTesting":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","title":"DestinationTesting","type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/destinationtesting","abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}]},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"url":"\/documentation\/destinationtesting\/destinationsetup","type":"topic","navigatorTitle":[{"text":"DestinationSetup","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationSetup","kind":"identifier"}],"abstract":[{"text":"What a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference"},{"text":" check hands the vendor’s factory: the plan of the events it","type":"text"},{"text":" ","type":"text"},{"text":"sends, the transport to send them through, a backoff short enough that a retry doesn’t hold the","type":"text"},{"text":" ","type":"text"},{"text":"test up, and when its records were tracked.","type":"text"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","role":"symbol","title":"DestinationSetup"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance":{"url":"\/documentation\/destinationtesting\/destinationconformance","type":"topic","navigatorTitle":[{"kind":"identifier","text":"DestinationConformance"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationConformance"}],"abstract":[{"text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests","type":"text"},{"text":" ","type":"text"},{"text":"match recorded fixtures byte for byte, and it keeps the library’s rules for ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" values,","type":"text"},{"text":" ","type":"text"},{"text":"consent, oversized records, retries and trace context.","type":"text"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","role":"symbol","title":"