{"abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"kind":"symbol","hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","role":"collection","title":"DestinationTesting","symbolKind":"module","modules":[{"name":"DestinationTesting"}],"externalID":"DestinationTesting"},"topicSections":[{"anchor":"Checking-a-destination","title":"Checking a destination","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"]},{"anchor":"Sending-without-a-network","title":"Sending without a network","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"]}],"identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true},{"type":"text","text":" runs the checks every vendor destination must pass, through a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","isActive":true},{"type":"text","text":" that keeps each request and answers from a script rather than the network:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"its requests match recorded fixtures byte for byte;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"behind a tracker’s consent and ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":", it sends exactly the records it is handed;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no response, a 5xx, 408, 429 and each status of the encoder’s "},{"type":"codeVoice","code":"transientStatuses"},{"type":"text","text":" are retried,"},{"type":"text","text":" "},{"type":"text","text":"and other failures are dropped and reported;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"a 2xx answer whose body the encoder can’t read, an empty one included, counts as delivered: sent"},{"type":"text","text":" "},{"type":"text","text":"once, nothing reported;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no request carries a trace context in its header fields, even while a tracer is active."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","isActive":true,"type":"reference"},{"type":"text","text":"‘s plan, transport and backoff. Every check’s records are tracked at the"},{"type":"text","text":" "},{"type":"text","text":"setup’s "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":"; a factory whose encoder leaves out records by their age takes it as the time"},{"type":"text","text":" "},{"type":"text","text":"it encodes at, so the checks pass whenever the test runs. Run each "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","isActive":true,"type":"reference"},{"type":"text","text":" as a test"},{"type":"text","text":" "},{"type":"text","text":"case of its own:"}]},{"code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own","type":"text"},{"text":" ","type":"text"},{"text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s","type":"text"},{"text":" ","type":"text"},{"code":"expectTrackingPlan(_:matches:sourceLocation:)","type":"codeVoice"},{"text":" is, so every vendor module runs the same checks.","type":"text"},{"text":" ","type":"text"},{"text":"It imports Swift Testing, so add it to test targets only. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves it out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers the module these checks test.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/destinationtesting"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://DestinationTesting/documentation/DestinationTesting/ScriptedTransport":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScriptedTransport","kind":"identifier"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","navigatorTitle":[{"text":"ScriptedTransport","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/scriptedtransport","kind":"symbol","title":"ScriptedTransport","role":"symbol","abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"HTTPTransport"},{"type":"text","text":" that answers each request from a script and keeps every request it is"},{"type":"text","text":" "},{"type":"text","text":"sent: the seam a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance"},{"type":"text","text":" check sends through instead of the network."}]},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"title":"DestinationSetup","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationSetup","kind":"identifier"}],"abstract":[{"type":"text","text":"What a "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true},{"type":"text","text":" check hands the vendor’s factory: the plan of the events it"},{"type":"text","text":" "},{"type":"text","text":"sends, the transport to send them through, a backoff short enough that a retry doesn’t hold the"},{"type":"text","text":" "},{"type":"text","text":"test up, and when its records were tracked."}],"role":"symbol","url":"\/documentation\/destinationtesting\/destinationsetup","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","navigatorTitle":[{"text":"DestinationSetup","kind":"identifier"}],"kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/writingavendordestination":{"title":"Writing a Vendor Destination","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","titleInlineContent":[{"type":"text","text":"Writing a Vendor Destination"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","type":"link"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance/expect(_:sourceLocation:)":{"type":"topic","role":"symbol","title":"expect(_:sourceLocation:)","url":"\/documentation\/destinationtesting\/destinationconformance\/expect(_:sourcelocation:)","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","kind":"symbol","abstract":[{"type":"text","text":"Records an issue for each way the destination breaks "},{"code":"check","type":"codeVoice"},{"type":"text","text":"’s rule."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expect"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"ConformanceCheck","preciseIdentifier":"s:18DestinationTesting16ConformanceCheckO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SourceLocation","preciseIdentifier":"s:7Testing14SourceLocationV"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}]},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance":{"type":"topic","role":"symbol","url":"\/documentation\/destinationtesting\/destinationconformance","title":"DestinationConformance","navigatorTitle":[{"kind":"identifier","text":"DestinationConformance"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","abstract":[{"type":"text","text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests"},{"type":"text","text":" "},{"type":"text","text":"match recorded fixtures byte for byte, and it keeps the library’s rules for "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"consent, oversized records, retries, 2xx answers and trace context."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationConformance"}]},"doc://DestinationTesting/documentation/DestinationTesting":{"type":"topic","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","url":"\/documentation\/destinationtesting","kind":"symbol","title":"DestinationTesting","role":"collection","abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}]},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck":{"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConformanceCheck","kind":"identifier"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","navigatorTitle":[{"text":"ConformanceCheck","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/conformancecheck","kind":"symbol","title":"ConformanceCheck","role":"symbol","abstract":[{"type":"text","text":"One rule every vendor destination keeps, which "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)"},{"type":"text","text":" "},{"type":"text","text":"checks."}]}}}