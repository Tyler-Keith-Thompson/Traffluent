{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"kind":"symbol","metadata":{"title":"DestinationTesting","externalID":"DestinationTesting","modules":[{"name":"DestinationTesting"}],"symbolKind":"module","roleHeading":"Framework","role":"collection"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true},{"type":"text","text":" runs the checks every vendor destination must pass, through a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","isActive":true},{"type":"text","text":" that keeps each request and answers from a script rather than the network:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"its requests match recorded fixtures byte for byte;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"behind a tracker’s consent and "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", it sends exactly the records it is handed;"}]}]},{"content":[{"inlineContent":[{"text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"no response, a 5xx, 408 and 429 are retried, and other failures are dropped and reported;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"no request carries a trace context in its header fields, even while a tracer is active.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"},{"type":"text","text":"‘s plan, transport and backoff. Every check’s records are tracked at the"},{"type":"text","text":" "},{"type":"text","text":"setup’s "},{"code":"timestamp","type":"codeVoice"},{"type":"text","text":"; a factory whose encoder leaves out records by their age takes it as the time"},{"type":"text","text":" "},{"type":"text","text":"it encodes at, so the checks pass whenever the test runs. Run each "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck"},{"type":"text","text":" as a test"},{"type":"text","text":" "},{"type":"text","text":"case of its own:"}],"type":"paragraph"},{"code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own","type":"text"},{"text":" ","type":"text"},{"text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s","type":"text"},{"text":" ","type":"text"},{"code":"expectTrackingPlan(_:matches:sourceLocation:)","type":"codeVoice"},{"text":" is, so every vendor module runs the same checks.","type":"text"},{"text":" ","type":"text"},{"text":"It imports Swift Testing, so add it to test targets only. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves it out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","type":"reference"},{"text":" ","type":"text"},{"text":"covers the module these checks test.","type":"text"}],"type":"paragraph"}]}],"topicSections":[{"title":"Checking a destination","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"],"anchor":"Checking-a-destination"},{"title":"Sending without a network","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"],"anchor":"Sending-without-a-network"}],"variants":[{"paths":["\/documentation\/destinationtesting"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting"},"hierarchy":{"paths":[[]]},"references":{"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance/expect(_:sourceLocation:)":{"url":"\/documentation\/destinationtesting\/destinationconformance\/expect(_:sourcelocation:)","abstract":[{"type":"text","text":"Records an issue for each way the destination breaks "},{"type":"codeVoice","code":"check"},{"type":"text","text":"’s rule."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expect"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:18DestinationTesting16ConformanceCheckO","text":"ConformanceCheck"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Testing14SourceLocationV","text":"SourceLocation"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"title":"expect(_:sourceLocation:)","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","kind":"symbol","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ScriptedTransport":{"type":"topic","url":"\/documentation\/destinationtesting\/scriptedtransport","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","abstract":[{"type":"text","text":"An "},{"type":"codeVoice","code":"HTTPTransport"},{"type":"text","text":" that answers each request from a script and keeps every request it is"},{"type":"text","text":" "},{"type":"text","text":"sent: the seam a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance"},{"type":"text","text":" check sends through instead of the network."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScriptedTransport","kind":"identifier"}],"title":"ScriptedTransport","kind":"symbol","navigatorTitle":[{"text":"ScriptedTransport","kind":"identifier"}],"role":"symbol"},"doc://DestinationTesting/documentation/DestinationTesting":{"url":"\/documentation\/destinationtesting","role":"collection","kind":"symbol","title":"DestinationTesting","abstract":[{"text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record.","type":"text"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck":{"url":"\/documentation\/destinationtesting\/conformancecheck","abstract":[{"text":"One rule every vendor destination keeps, which ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"checks.","type":"text"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConformanceCheck","kind":"identifier"}],"navigatorTitle":[{"text":"ConformanceCheck","kind":"identifier"}],"title":"ConformanceCheck","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","type":"topic","kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/writingavendordestination":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","title":"Writing a Vendor Destination","titleInlineContent":[{"type":"text","text":"Writing a Vendor Destination"}]},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","type":"topic","role":"symbol","abstract":[{"type":"text","text":"What a "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference","isActive":true},{"type":"text","text":" check hands the vendor’s factory: the plan of the events it"},{"type":"text","text":" "},{"type":"text","text":"sends, the transport to send them through, a backoff short enough that a retry doesn’t hold the"},{"type":"text","text":" "},{"type":"text","text":"test up, and when its records were tracked."}],"url":"\/documentation\/destinationtesting\/destinationsetup","title":"DestinationSetup","kind":"symbol","navigatorTitle":[{"text":"DestinationSetup","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationSetup","kind":"identifier"}]},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests"},{"type":"text","text":" "},{"type":"text","text":"match recorded fixtures byte for byte, and it keeps the library’s rules for "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"consent, oversized records, retries and trace context."}],"url":"\/documentation\/destinationtesting\/destinationconformance","kind":"symbol","title":"DestinationConformance","navigatorTitle":[{"kind":"identifier","text":"DestinationConformance"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationConformance"}]}}}