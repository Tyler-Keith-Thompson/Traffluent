{"hierarchy":{"paths":[[]]},"abstract":[{"text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"],"title":"Checking a destination","anchor":"Checking-a-destination"},{"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"],"title":"Sending without a network","anchor":"Sending-without-a-network"}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference"},{"text":" runs the checks every vendor destination must pass, through a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","type":"reference"},{"text":" that keeps each request and answers from a script rather than the network:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"its requests match recorded fixtures byte for byte;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"behind a tracker’s consent and "},{"type":"codeVoice","code":"accepting(_:)"},{"type":"text","text":", it sends exactly the records it is handed;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;"}]}]},{"content":[{"inlineContent":[{"text":"no response, a 5xx, 408 and 429 are retried, and other failures are dropped and reported;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"no request carries a trace context in its header fields, even while a tracer is active.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","isActive":true,"type":"reference"},{"text":"‘s plan, transport and backoff. Every check’s records are tracked at the","type":"text"},{"text":" ","type":"text"},{"text":"setup’s ","type":"text"},{"code":"timestamp","type":"codeVoice"},{"text":"; a factory whose encoder leaves out records by their age takes it as the time","type":"text"},{"text":" ","type":"text"},{"text":"it encodes at, so the checks pass whenever the test runs. Run each ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","isActive":true,"type":"reference"},{"text":" as a test","type":"text"},{"text":" ","type":"text"},{"text":"case of its own:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"]},{"type":"paragraph","inlineContent":[{"text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own","type":"text"},{"text":" ","type":"text"},{"text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s","type":"text"},{"text":" ","type":"text"},{"code":"expectTrackingPlan(_:matches:sourceLocation:)","type":"codeVoice"},{"text":" is, so every vendor module runs the same checks.","type":"text"},{"text":" ","type":"text"},{"text":"It imports Swift Testing, so add it to test targets only. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves it out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination"},{"type":"text","text":" "},{"type":"text","text":"covers the module these checks test."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/destinationtesting"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","interfaceLanguage":"swift"},"metadata":{"role":"collection","roleHeading":"Framework","modules":[{"name":"DestinationTesting"}],"title":"DestinationTesting","externalID":"DestinationTesting","symbolKind":"module"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","references":{"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck":{"navigatorTitle":[{"kind":"identifier","text":"ConformanceCheck"}],"title":"ConformanceCheck","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConformanceCheck"}],"kind":"symbol","abstract":[{"type":"text","text":"One rule every vendor destination keeps, which "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)"},{"type":"text","text":" "},{"type":"text","text":"checks."}],"type":"topic","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","url":"\/documentation\/destinationtesting\/conformancecheck"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance/expect(_:sourceLocation:)":{"title":"expect(_:sourceLocation:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expect"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"ConformanceCheck","preciseIdentifier":"s:18DestinationTesting16ConformanceCheckO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SourceLocation","preciseIdentifier":"s:7Testing14SourceLocationV"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"kind":"symbol","url":"\/documentation\/destinationtesting\/destinationconformance\/expect(_:sourcelocation:)","type":"topic","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","abstract":[{"text":"Records an issue for each way the destination breaks ","type":"text"},{"type":"codeVoice","code":"check"},{"text":"’s rule.","type":"text"}]},"doc://DestinationTesting/documentation/DestinationTesting":{"kind":"symbol","abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"type":"topic","url":"\/documentation\/destinationtesting","title":"DestinationTesting","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","role":"collection"},"doc://DestinationTesting/documentation/DestinationTesting/ScriptedTransport":{"kind":"symbol","navigatorTitle":[{"text":"ScriptedTransport","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScriptedTransport","kind":"identifier"}],"abstract":[{"type":"text","text":"An "},{"code":"HTTPTransport","type":"codeVoice"},{"type":"text","text":" that answers each request from a script and keeps every request it is"},{"type":"text","text":" "},{"type":"text","text":"sent: the seam a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance"},{"type":"text","text":" check sends through instead of the network."}],"type":"topic","url":"\/documentation\/destinationtesting\/scriptedtransport","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","title":"ScriptedTransport","role":"symbol"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"title":"DestinationSetup","navigatorTitle":[{"text":"DestinationSetup","kind":"identifier"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","abstract":[{"type":"text","text":"What a "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference","isActive":true},{"type":"text","text":" check hands the vendor’s factory: the plan of the events it"},{"type":"text","text":" "},{"type":"text","text":"sends, the transport to send them through, a backoff short enough that a retry doesn’t hold the"},{"type":"text","text":" "},{"type":"text","text":"test up, and when its records were tracked."}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationSetup","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/destinationsetup","kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/writingavendordestination":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","titleInlineContent":[{"type":"text","text":"Writing a Vendor Destination"}],"type":"link","title":"Writing a Vendor Destination","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance":{"title":"DestinationConformance","navigatorTitle":[{"kind":"identifier","text":"DestinationConformance"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","abstract":[{"type":"text","text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests"},{"type":"text","text":" "},{"type":"text","text":"match recorded fixtures byte for byte, and it keeps the library’s rules for "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"consent, oversized records, retries and trace context."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationConformance"}],"url":"\/documentation\/destinationtesting\/destinationconformance","kind":"symbol"}}}