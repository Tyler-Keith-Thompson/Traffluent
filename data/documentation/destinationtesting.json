{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference","isActive":true},{"type":"text","text":" runs the checks every vendor destination must pass, through a"},{"type":"text","text":" "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","type":"reference","isActive":true},{"type":"text","text":" that keeps each request and answers from a script rather than the network:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"its requests match recorded fixtures byte for byte;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}]}]},{"content":[{"inlineContent":[{"text":"behind a tracker’s consent and ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":", it sends exactly the records it is handed;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"no response, a 5xx, 408 and 429 are retried, and other failures are dropped and reported;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"no request carries a trace context in its header fields, even while a tracer is active."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/Destina