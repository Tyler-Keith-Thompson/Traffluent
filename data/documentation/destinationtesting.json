pe":"text","text":" "},{"type":"text","text":"sends, the transport to send them through, and a backoff short enough that a retry doesn’t"},{"type":"text","text":" "},{"type":"text","text":"hold the test up."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationSetup"}],"kind":"symbol","title":"DestinationSetup","url":"\/documentation\/destinationtesting\/destinationsetup","navigatorTitle":[{"kind":"identifier","text":"DestinationSetup"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ScriptedTransport":{"role":"symbol","url":"\/documentation\/destinationtesting\/scriptedtransport","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScriptedTransport"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScriptedTransport"}],"title":"ScriptedTransport","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","abstract":[{"text":"An ","type":"text"},{"code":"HTTPTransport","type":"codeVoice"},{"text":" that answers each request from a script and keeps every request it is","type":"text"},{"text":" ","type":"text"},{"text":"sent: the seam a ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference","isActive":true},{"text":" check sends through instead of the network.","type":"text"}],"type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance":{"role":"symbol","url":"\/documentation\/destinationtesting\/destinationconformance","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationConformance","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"DestinationConformance","kind":"identifier"}],"identifier":