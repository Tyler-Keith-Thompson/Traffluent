es,","type":"text"},{"text":" ","type":"text"},{"text":"consent, oversized records, retries, 2xx answers and trace context.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationConformance"}],"url":"\/documentation\/destinationtesting\/destinationconformance","navigatorTitle":[{"kind":"identifier","text":"DestinationConformance"}],"type":"topic","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","title":"DestinationConformance","kind":"symbol","role":"symbol"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck":{"abstract":[{"text":"One rule every vendor destination keeps, which ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"checks.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConformanceCheck"}],"url":"\/documentation\/destinationtesting\/conformancecheck","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","navigatorTitle":[{"kind":"identifier","text":"ConformanceCheck"}],"role":"symbol","title":"ConformanceCheck"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"abstract":[{"type":"text","text":"What a "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","isActive":true,"type":"reference"},{"type":"text","text":" check hands the vendor’s factory: the plan of the events it"},{"type":"text","text":" "},{"type":"text","text":"sends, the transport to send them through, a backoff short enough that a retry doesn’t hold the"},{"type":"text","text":" "},{"type":"text","text":"test up, and when its records were tracked."}],"typ