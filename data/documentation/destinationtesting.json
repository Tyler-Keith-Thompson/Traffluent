eported, and the rest of its batch is sent;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"no response, a 5xx, 408 and 429 are retried, and other failures are dropped and reported;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"no request carries a trace context in its header fields, even while a tracer is active.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","isActive":true},{"type":"text","text":"’s plan, transport and backoff. Run each "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","isActive":true},{"type":"text","text":" as a test case of"},{"type":"text","text":" "},{"type":"text","text":"its own:"}]},{"syntax":"swift","type":"codeListing","code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"]},{"type":"paragraph","inlineContent":[{"text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own","type":"text"},{"text":" ","type":"text"},{"text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"expectTrackingPlan(_:matches:sourceLocation:)"},{"text":" is, so every vendor module runs the same checks.","type":"text"},{"text":" ","type":"text"},{"text":"It imports Swift Testing, so add it to test targets only. ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves it out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers the module these checks test."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting"},"variants":[{"paths":["\/documentation\/destinationtesting"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record.","type":"text"}],"metadata":{"roleHeading":"Framework","modules":[{"name":"DestinationTesting"}],"title":"DestinationTesting","externalID":"DestinationTesting","role":"collection","symbolKind":"module"},"references":{"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"abstract":[{"text":"What a ","type":"text"},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference","isActive":true},{"text":" check hands the vendor’s factory: the plan of the events it","type":"text"},{"text":" ","type":"text"},{"text":"sends, the transport to send them through, and a backoff short enough that a retry doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"hold the test up.","type":"text"}],"kind":"symbol","title":"DestinationSetup","role":"symbol","type":"topic","url":"\/documentation\/destinationtesting\/destinationsetup","identifier":"doc:\/\/DestinationTesting\