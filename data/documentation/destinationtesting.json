{"sections":[],"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","interfaceLanguage":"swift"},"metadata":{"role":"collection","title":"DestinationTesting","externalID":"DestinationTesting","modules":[{"name":"DestinationTesting"}],"symbolKind":"module","roleHeading":"Framework"},"abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"topicSections":[{"anchor":"Checking-a-destination","title":"Checking a destination","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"]},{"anchor":"Sending-without-a-network","title":"Sending without a network","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"]}],"kind":"symbol","variants":[{"paths":["\/documentation\/destinationtesting"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance"},{"type":"text","text":" runs the checks every vendor destination must pass, through a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"},{"type":"text","text":" that keeps each request and answers from a script rather than the network:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"its requests match recorded fixtures byte for byte;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent only after the adopter opts in, and only while the record reveals it;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"behind a tracker’s consent and ","type":"text"},{"type":"codeVoice","code":"accepting(_:)"},{"text":", it sends exactly the records it is handed;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"no response, a 5xx, 408 and 429 are retried, and other failures are dropped and reported;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"no request carries a trace context in its header fields, even while a tracer is active.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","isActive":true},{"type":"text","text":"’s plan, transport and backoff. Run each "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","isActive":true},{"type":"text","text":" as a test case of"},{"type":"text","text":" "},{"type":"text","text":"its own:"}]},{"type":"codeListing","syntax":"swift","code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own"},{"type":"text","text":" "},{"type":"text","text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"expectTrackingPlan(_:matches:sourceLocation:)"},{"type":"text","text":" is, so every vendor module runs the same checks."},{"type":"text","text":" "},{"type":"text","text":"It imports Swift Testing, so add it to test targets only. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves it out."}]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination"},{"text":" ","type":"text"},{"text":"covers the module these checks test.","type":"text"}]}],"kind":"content"}],"references":{"doc://DestinationTesting/documentation/DestinationTesting":{"url":"\/documentation\/destinationtesting","title":"DestinationTesting","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","role":"collection"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConformanceCheck"}],"navigatorTitle":[{"kind":"identifier","text":"ConformanceCheck"}],"url":"\/documentation\/destinationtesting\/conformancech