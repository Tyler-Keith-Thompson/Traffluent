ext":"). A private key reaches","type":"text"},{"text":" ","type":"text"},{"text":"every Customer.io API, deleting and suppressing people included, and must not ship in an","type":"text"},{"text":" ","type":"text"},{"text":"app.","type":"text"}],"title":"CustomerIOSetupError.privateKey","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/privateKey","role":"symbol"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/SegmentSpecBatchEncoder/batchLimit":{"url":"\/documentation\/segmentspecencoding\/segmentspecbatchencoder\/batchlimit","kind":"symbol","role":"symbol","abstract":[{"text":"The Segment spec’s limits on one request, which Segment, RudderStack and Customer.io all","type":"text"},{"text":" ","type":"text"},{"text":"accept: 2,500 calls, 500,000 bytes of body, and 31,999 bytes of one call.","type":"text"}],"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","title":"batchLimit"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/customerIO(apiKey:region:plan:transport:backoff:clock:)":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerIO"},{"kind":"text","text":"("},{"kind":"externalParam","text":"apiKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CustomerIORegion","preciseIdentifier"