t","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"preciseIdentifier":"s:19SegmentSpecEncoding0A6RegionO","kind":"typeIdentifier","text":"SegmentRegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier","text":"Clock"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:19SegmentSpecEncoding0A10SetupErrorO","kind":"typeIdentifier","text":"SegmentSetupError"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","kind":"typeIdentifier","text":"URLSessionTransport"},{"kind":"text","text":", "},{"preciseIdentifier":"s:19SegmentSpecEncoding0aB12BatchEncoderV","kind":"typeIdentifier","text":"SegmentSpecBatchEncoder"},{"kind":"text","text":">"}]},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/RudderStackSetupError":{"title":"RudderStackSetupError","type":"topic","role":"symbol","url":"\/documentation\/segmentspecencoding\/rudderstacksetuperror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":