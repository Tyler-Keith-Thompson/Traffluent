{"identifier":{"url":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","abstract":[{"text":"Send records as Segment-spec track calls to Segment, RudderStack or Customer.io Data Pipelines.","type":"text"}],"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Sending to Segment","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:transport:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentRegion","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSetupError"],"anchor":"Sending-to-Segment"},{"title":"Sending to RudderStack","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:transport:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/RudderStackSetupError"],"anchor":"Sending-to-RudderStack"},{"title":"Sending to Customer.io Data Pipelines","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:transport:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError"],"anchor":"Sending-to-Customerio-Data-Pipelines"},{"title":"Encoding batches","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder"],"anchor":"Encoding-batches"},{"title":"Records left out","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError"],"anchor":"Records-left-out"}],"variants":[{"paths":["\/documentation\/segmentspecencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Segment, RudderStack and Customer.io Data Pipelines each take the same batch call of the Segment","type":"text"},{"text":" ","type":"text"},{"text":"spec, at endpoints of their own. One encoder, ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","type":"reference","isActive":true},{"text":", writes it, and a","type":"text"},{"text":" ","type":"text"},{"text":"factory for each fills in the endpoint and how the key travels:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)","isActive":true,"type":"reference"},{"type":"text","text":" posts to the"},{"type":"text","text":" "},{"code":"\/v1\/batch","type":"codeVoice"},{"type":"text","text":" of the workspace’s region ("},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentRegion","isActive":true,"type":"reference"},{"type":"text","text":"), with the write key as HTTP Basic"},{"type":"text","text":" "},{"type":"text","text":"authentication’s user name and an empty password."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":" posts to","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"\/v1\/batch","type":"codeVoice"},{"text":" of your data plane URL, with the write key the same way.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","isActive":true},{"text":" posts to the","type":"text"},{"text":" ","type":"text"},{"text":"Pipelines API’s ","type":"text"},{"type":"codeVoice","code":"\/v1\/batch"},{"text":" in the workspace’s region (","type":"text"},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion","isActive":true},{"text":"), with the key as a","type":"text"},{"text":" ","type":"text"},{"text":"bearer token and ","type":"text"},{"type":"codeVoice","code":"X-Strict-Mode: 1"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each splits a batch to the spec’s limits (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit"},{"text":"): 2,500 calls","type":"text"},{"text":" ","type":"text"},{"text":"and 500 KB a request, and under 32 KB a call, which all three accept. A batch with no record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder can write, an empty one included, makes no request. Each retries no response, a 5xx, 408","type":"text"},{"text":" ","type":"text"},{"text":"and 429, and drops and reports any other status. No trace context is sent. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" ","type":"text"},{"text":"leaves this module out; import it on its own.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The key goes in the "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":" header field, never in the body. It is a public client key:"},{"type":"text","text":" "},{"type":"text","text":"Segment’s and RudderStack’s write keys, and Customer.io’s public keys ("},{"type":"codeVoice","code":"pk_…"},{"type":"text","text":"), ship in their"},{"type":"text","text":" "},{"type":"text","text":"vendors’ own app and web libraries, and they let a client send data to the source and read"},{"type":"text","text":" "},{"type":"text","text":"nothing."},{"type":"text","text":" "},{"type":"text","text":"Customer.io’s private keys ("},{"type":"codeVoice","code":"sk_…"},{"type":"text","text":") reach every Customer.io API, deleting people included, so"},{"type":"text","text":" "},{"type":"text","text":"the factory throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/privateKey"},{"type":"text","text":" for one. Each factory throws for an empty"},{"type":"text","text":" "},{"type":"text","text":"key ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSetupError"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/RudderStackSetupError"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError"},{"type":"text","text":"), RudderStack’s"},{"type":"text","text":" "},{"type":"text","text":"for a data plane URL that isn’t a plain "},{"type":"codeVoice","code":"https"},{"type":"text","text":" URL, and Customer.io’s for a public key of the"},{"type":"text","text":" "},{"type":"text","text":"other region."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A region has no default. Segment and Customer.io keep a workspace’s data in the US or the EU, and"},{"type":"text","text":" "},{"type":"text","text":"events posted to the other region’s endpoint don’t reach it, so you pick the region on purpose."}],"type":"paragraph"},{"inlineContent":[{"text":"Each record becomes a track call of an anonymous user. Its ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":" is the record’s session,","type":"text"},{"text":" ","type":"text"},{"text":"from the sessions enricher; a record with no session is sent under its own record identifier. No","type":"text"},{"text":" ","type":"text"},{"code":"userId","type":"codeVoice"},{"text":", ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" call or traits are sent. Its ","type":"text"},{"code":"messageId","type":"codeVoice"},{"text":" is the record’s identifier, which","type":"text"},{"text":" ","type":"text"},{"text":"a redelivered record keeps, and its ","type":"text"},{"code":"timestamp","type":"codeVoice"},{"text":" the record’s timestamp in ISO 8601 with","type":"text"},{"text":" ","type":"text"},{"text":"milliseconds. The record’s vendor identifier and trace context aren’t sent. The standard context","type":"text"},{"text":" ","type":"text"},{"text":"goes in the spec’s ","type":"text"},{"code":"context","type":"codeVoice"},{"text":" fields (","type":"text"},{"code":"app","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device","type":"codeVoice"},{"text":", ","type":"text"},{"code":"locale","type":"codeVoice"},{"text":", ","type":"text"},{"code":"network","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"os","type":"codeVoice"},{"text":"), with no","type":"text"},{"text":" ","type":"text"},{"code":"device.id","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"advertisingId","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every call’s "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" is "},{"type":"codeVoice","code":"0.0.0.0"},{"type":"text","text":", which Segment takes in place of the request’s address, so"},{"type":"text","text":" "},{"type":"text","text":"it records none. RudderStack fills in a "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" from the request unless the call has one,"},{"type":"text","text":" "},{"type":"text","text":"even beside "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":", and passes it on to its destinations, so RudderStack’s calls also carry"},{"type":"text","text":" "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" as "},{"type":"codeVoice","code":"0.0.0.0"},{"type":"text","text":". Customer.io’s references don’t say whether "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" takes the place"},{"type":"text","text":" "},{"type":"text","text":"of the address it reads from an HTTP request, so it may still record the request’s."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each endpoint counts a user per "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":", so each session is one user in its reports, and so"},{"type":"text","text":" "},{"type":"text","text":"is each record sent without a session. On a plan billed by monthly tracked users, each counts as"},{"type":"text","text":" "},{"type":"text","text":"one. A record a store recovers after a relaunch has no session, so it goes out under its own"},{"type":"text","text":" "},{"type":"text","text":"identifier. Segment deduplicates calls by "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":", which the record keeps, and drops most"},{"type":"text","text":" "},{"type":"text","text":"duplicates within about 24 hours, not all, so one it stored before the app ended is most likely"},{"type":"text","text":" "},{"type":"text","text":"not stored again. RudderStack’s and Customer.io’s API references don’t say whether they"},{"type":"text","text":" "},{"type":"text","text":"deduplicate, so such a record may be stored twice there."}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is made with. A","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is never sent, whatever the record reveals. A record the encoder can’t write is","type":"text"},{"text":" ","type":"text"},{"text":"left out and the rest of the batch is sent: one the plan doesn’t describe, one named as one of","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io’s semantic events, which delete or suppress people and devices (","type":"text"},{"code":"User Deleted","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"User Suppressed","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Device Deleted","type":"codeVoice"},{"text":" and the rest), one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one holding","type":"text"},{"text":" ","type":"text"},{"text":"a value JSON can’t, one whose timestamp has no ISO 8601 form, and one too large for a call. The","type":"text"},{"text":" ","type":"text"},{"text":"destination reports each as ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" whose reason is a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError","isActive":true,"type":"reference"},{"text":", and the encoder logs a notice for each semantic event name in the","type":"text"},{"text":" ","type":"text"},{"text":"plan when the destination is made.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Segment answers 200 for every request but one too large or not JSON, so a wrong region, a write","type":"text"},{"text":" ","type":"text"},{"text":"key of no source, or a batch of more calls than it takes may be answered 200 with nothing stored.","type":"text"},{"text":" ","type":"text"},{"text":"Check the source’s debugger after setting the destination up. RudderStack answers a wrong write","type":"text"},{"text":" ","type":"text"},{"text":"key with 401, and Customer.io, in strict mode, with 401 too, so the destination reports those. In","type":"text"},{"text":" ","type":"text"},{"text":"strict mode Customer.io refuses a whole batch for one bad call, so the encoder leaves out each call","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io documents refusing; a 400 for anything else drops the whole request.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To send to PostHog, Amplitude or Mixpanel, use ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AmplitudeEncoding","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"MixpanelEncoding","type":"codeVoice"},{"text":" instead.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import HTTPDestinations","import SegmentSpecEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: segment)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers what each endpoint receives, and why, in more detail."}],"type":"paragraph"}]}],"metadata":{"role":"collection","modules":[{"name":"SegmentSpecEncoding"}],"roleHeading":"Framework","externalID":"SegmentSpecEncoding","title":"SegmentSpecEncoding","symbolKind":"module"},"references":{"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/SegmentSpecEncodingError":{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError","role":"symbol","kind":"symbol","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"SegmentSpecEncodingError","kind":"identifier"}],"title":"SegmentSpecEncodingError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentSpecEncodingError","kind":"identifier"}],"url":"\/documentation\/segmentspecencoding\/segmentspecencodingerror"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"url":"\/documentation\/httpdestinations\/batchencoder","title":"BatchEncoder","kind":"symbol","role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}]},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/CustomerIORegion":{"title":"CustomerIORegion","abstract":[{"text":"The region of a Customer.io workspace, which decides the Pipelines API endpoint its events are","type":"text"},{"text":" ","type":"text"},{"text":"posted to.","type":"text"}],"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion","url":"\/documentation\/segmentspecencoding\/customerioregion","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"CustomerIORegion","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomerIORegion","kind":"identifier"}]},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding":{"title":"SegmentSpecEncoding","abstract":[{"type":"text","text":"Send records as Segment-spec track calls to Segment, RudderStack or Customer.io Data Pipelines."}],"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","url":"\/documentation\/segmentspecencoding","type":"topic","kind":"symbol","role":"collection"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/CustomerIOSetupError":{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Why "},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:transport:backoff:clock:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"type":"topic","navigatorTitle":[{"text":"CustomerIOSetupError","kind":"identifier"}],"title":"CustomerIOSetupError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomerIOSetupError","kind":"identifier"}],"url":"\/documentation\/segmentspecencoding\/customeriosetuperror"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/customerIO(apiKey:region:plan:backoff:clock:)":{"title":"customerIO(apiKey:region:plan:backoff:clock:)","abstract":[{"text":"A destination that sends batches to the Customer.io Data Pipelines source of ","type":"text"},{"type":"codeVoice","code":"apiKey"},{"text":", in a","type":"text"},{"text":" ","type":"text"},{"text":"workspace in ","type":"text"},{"type":"codeVoice","code":"region"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"URLSession.shared"},{"text":", retrying a send that fails for now with the","type":"text"},{"text":" ","type":"text"},{"text":"waits of ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"clock"},{"text":".","type":"text"}],"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","url":"\/documentation\/segmentspecencoding\/httpdestinations\/httpdestination\/customerio(apikey:region:plan:backoff:clock:)","type":"topic","kind":"symbol","role":"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"Transport"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"URLSessionTransport"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Encoding"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"SegmentSpecBatchEncoder"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerIO","kind":"identifier"},{"text":"(","kind":"text"},{"text":"apiKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"CustomerIORegion","preciseIdentifier":"s:19SegmentSpecEncoding16CustomerIORegionO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"CustomerIOSetupError","preciseIdentifier":"s:19SegmentSpecEncoding20CustomerIOSetupErrorO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"URLSessionTransport","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"SegmentSpecBatchEncoder","preciseIdentifier":"s:19SegmentSpecEncoding0aB12BatchEncoderV","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/rudderStack(writeKey:dataPlane:plan:backoff:clock:)":{"kind":"symbol","title":"rudderStack(writeKey:dataPlane:plan:backoff:clock:)","role":"symbol","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpec