{"hierarchy":{"paths":[[]]},"abstract":[{"text":"Send records as Segment-spec track calls to Segment, RudderStack or Customer.io Data Pipelines.","type":"text"}],"topicSections":[{"anchor":"Sending-to-Segment","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:transport:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentRegion","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSetupError"],"title":"Sending to Segment"},{"anchor":"Sending-to-RudderStack","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:transport:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/RudderStackSetupError"],"title":"Sending to RudderStack"},{"anchor":"Sending-to-Customerio-Data-Pipelines","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:transport:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError"],"title":"Sending to Customer.io Data Pipelines"},{"anchor":"Encoding-batches","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder"],"title":"Encoding batches"},{"anchor":"Records-left-out","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError"],"title":"Records left out"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/segmentspecencoding"]}],"metadata":{"externalID":"SegmentSpecEncoding","modules":[{"name":"SegmentSpecEncoding"}],"title":"SegmentSpecEncoding","symbolKind":"module","role":"collection","roleHeading":"Framework"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Segment, RudderStack and Customer.io Data Pipelines each take the same batch call of the Segment","type":"text"},{"text":" ","type":"text"},{"text":"spec, at endpoints of their own. One encoder, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","type":"reference"},{"text":", writes it, and a","type":"text"},{"text":" ","type":"text"},{"text":"factory for each fills in the endpoint and how the key travels:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)","isActive":true,"type":"reference"},{"type":"text","text":" posts to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/v1\/batch"},{"type":"text","text":" of the workspace’s region ("},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentRegion","isActive":true,"type":"reference"},{"type":"text","text":"), with the write key as HTTP Basic"},{"type":"text","text":" "},{"type":"text","text":"authentication’s user name and an empty password."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)","isActive":true},{"type":"text","text":" posts to"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"\/v1\/batch","type":"codeVoice"},{"type":"text","text":" of your data plane URL, with the write key the same way."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":" posts to the","type":"text"},{"text":" ","type":"text"},{"text":"Pipelines API’s ","type":"text"},{"code":"\/v1\/batch","type":"codeVoice"},{"text":" in the workspace’s region (","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion","isActive":true,"type":"reference"},{"text":"), with the key as a","type":"text"},{"text":" ","type":"text"},{"text":"bearer token and ","type":"text"},{"code":"X-Strict-Mode: 1","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Each splits a batch to the spec’s limits (","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":"): 2,500 calls","type":"text"},{"text":" ","type":"text"},{"text":"and 500 KB a request, and under 32 KB a call, which all three accept. A batch with no record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder can write, an empty one included, makes no request. Each retries no response, a 5xx, 408","type":"text"},{"text":" ","type":"text"},{"text":"and 429, and drops and reports any other status. No trace context is sent. ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" ","type":"text"},{"text":"leaves this module out; import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The key goes in the ","type":"text"},{"type":"codeVoice","code":"Authorization"},{"text":" header field, never in the body. It is a public client key:","type":"text"},{"text":" ","type":"text"},{"text":"Segment’s and RudderStack’s write keys, and Customer.io’s public keys (","type":"text"},{"type":"codeVoice","code":"pk_…"},{"text":"), ship in their","type":"text"},{"text":" ","type":"text"},{"text":"vendors’ own app and web libraries, and they let a client send data to the source and read","type":"text"},{"text":" ","type":"text"},{"text":"nothing.","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io’s private keys (","type":"text"},{"type":"codeVoice","code":"sk_…"},{"text":") reach every Customer.io API, deleting people included, so","type":"text"},{"text":" ","type":"text"},{"text":"the factory throws ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/privateKey","type":"reference","isActive":true},{"text":" for one. Each factory throws for an empty","type":"text"},{"text":" ","type":"text"},{"text":"key (","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSetupError","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/RudderStackSetupError","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError","type":"reference","isActive":true},{"text":"), RudderStack’s","type":"text"},{"text":" ","type":"text"},{"text":"for a data plane URL that isn’t a plain ","type":"text"},{"type":"codeVoice","code":"https"},{"text":" URL, and Customer.io’s for a public key of the","type":"text"},{"text":" ","type":"text"},{"text":"other region.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A region has no default. Segment and Customer.io keep a workspace’s data in the US or the EU, and","type":"text"},{"text":" ","type":"text"},{"text":"events posted to the other region’s endpoint don’t reach it, so you pick the region on purpose.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each record becomes a track call of an anonymous user. Its ","type":"text"},{"code":"anonymousId","type":"codeVoice"},{"text":" is the record’s session,","type":"text"},{"text":" ","type":"text"},{"text":"from the sessions enricher; a record with no session is sent under its own record identifier. No","type":"text"},{"text":" ","type":"text"},{"code":"userId","type":"codeVoice"},{"text":", ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" call or traits are sent. Its ","type":"text"},{"code":"messageId","type":"codeVoice"},{"text":" is the record’s identifier, which","type":"text"},{"text":" ","type":"text"},{"text":"a redelivered record keeps, and its ","type":"text"},{"code":"timestamp","type":"codeVoice"},{"text":" the record’s timestamp in ISO 8601 with","type":"text"},{"text":" ","type":"text"},{"text":"milliseconds. The record’s vendor identifier and trace context aren’t sent. The standard context","type":"text"},{"text":" ","type":"text"},{"text":"goes in the spec’s ","type":"text"},{"code":"context","type":"codeVoice"},{"text":" fields (","type":"text"},{"code":"app","type":"codeVoice"},{"text":", ","type":"text"},{"code":"device","type":"codeVoice"},{"text":", ","type":"text"},{"code":"locale","type":"codeVoice"},{"text":", ","type":"text"},{"code":"network","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"os","type":"codeVoice"},{"text":"), with no","type":"text"},{"text":" ","type":"text"},{"code":"device.id","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"advertisingId","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every call’s "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" is "},{"type":"codeVoice","code":"0.0.0.0"},{"type":"text","text":", which Segment takes in place of the request’s address, so"},{"type":"text","text":" "},{"type":"text","text":"it records none. RudderStack fills in a "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" from the request unless the call has one,"},{"type":"text","text":" "},{"type":"text","text":"even beside "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":", and passes it on to its destinations, so RudderStack’s calls also carry"},{"type":"text","text":" "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" as "},{"type":"codeVoice","code":"0.0.0.0"},{"type":"text","text":". Customer.io’s references don’t say whether "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" takes the place"},{"type":"text","text":" "},{"type":"text","text":"of the address it reads from an HTTP request, so it may still record the request’s."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each endpoint counts a user per "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":", so each session is one user in its reports, and so"},{"type":"text","text":" "},{"type":"text","text":"is each record sent without a session. On a plan billed by monthly tracked users, each counts as"},{"type":"text","text":" "},{"type":"text","text":"one. A record a store recovers after a relaunch has no session, so it goes out under its own"},{"type":"text","text":" "},{"type":"text","text":"identifier. Segment deduplicates calls by "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":", which the record keeps, and drops most"},{"type":"text","text":" "},{"type":"text","text":"duplicates within about 24 hours, not all, so one it stored before the app ended is most likely"},{"type":"text","text":" "},{"type":"text","text":"not stored again. RudderStack’s and Customer.io’s API references don’t say whether they"},{"type":"text","text":" "},{"type":"text","text":"deduplicate, so such a record may be stored twice there."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" the encoder is made with. A"},{"type":"text","text":" "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is never sent, whatever the record reveals. A record the encoder can’t write is"},{"type":"text","text":" "},{"type":"text","text":"left out and the rest of the batch is sent: one the plan doesn’t describe, one named as one of"},{"type":"text","text":" "},{"type":"text","text":"Customer.io’s semantic events, which delete or suppress people and devices ("},{"code":"User Deleted","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"User Suppressed","type":"codeVoice"},{"type":"text","text":", "},{"code":"Device Deleted","type":"codeVoice"},{"type":"text","text":" and the rest), one whose event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one holding"},{"type":"text","text":" "},{"type":"text","text":"a value JSON can’t, one whose timestamp has no ISO 8601 form, and one too large for a call. The"},{"type":"text","text":" "},{"type":"text","text":"destination reports each as "},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"type":"text","text":", a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" whose reason is a"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError","type":"reference"},{"type":"text","text":", and the encoder logs a notice for each semantic event name in the"},{"type":"text","text":" "},{"type":"text","text":"plan when the destination is made."}]},{"type":"paragraph","inlineContent":[{"text":"Segment answers 200 for every request but one too large or not JSON, so a wrong region, a write","type":"text"},{"text":" ","type":"text"},{"text":"key of no source, or a batch of more calls than it takes may be answered 200 with nothing stored.","type":"text"},{"text":" ","type":"text"},{"text":"Check the source’s debugger after setting the destination up. RudderStack answers a wrong write","type":"text"},{"text":" ","type":"text"},{"text":"key with 401, and Customer.io, in strict mode, with 401 too, so the destination reports those. In","type":"text"},{"text":" ","type":"text"},{"text":"strict mode Customer.io refuses a whole batch for one bad call, so the encoder leaves out each call","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io documents refusing; a 400 for anything else drops the whole request.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to PostHog, Amplitude or Mixpanel, use "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":", "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"MixpanelEncoding"},{"type":"text","text":" instead."}]},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","import SegmentSpecEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: segment)"]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference"},{"text":" ","type":"text"},{"text":"covers what each endpoint receives, and why, in more detail.","type":"text"}]}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"},"references":{"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/customerIO(apiKey:region:plan:backoff:clock:)":{"title":"customerIO(apiKey:region:plan:backoff:clock:)","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" is "},{"type":"codeVoice","code":"URLSessionTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"SegmentSpecBatchEncoder"},{"type":"text","text":"."}]},"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","role":"symbol","abstract":[{"type":"text","text":"A destination that sends batches to the Customer.io Data Pipelines source of "},{"type":"codeVoice","code":"apiKey"},{"type":"text","text":", in a"},{"type":"text","text":" "},{"type":"text","text":"workspace in "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the"},{"type":"text","text":" "},{"type":"text","text":"waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"url":"\/documentation\/segmentspecencoding\/httpdestinations\/httpdestination\/customerio(apikey:region:plan:backoff:clock:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerIO"},{"kind":"text","text":"("},{"kind":"externalParam","text":"apiKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:19SegmentSpecEncoding16CustomerIORegionO","text":"CustomerIORegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:19SegmentSpecEncoding20CustomerIOSetupErrorO","text":"CustomerIOSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:19SegmentSpecEncoding0aB12BatchEncoderV","text":"SegmentSpecBatchEncoder"},{"kind":"text","text":">"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"isActive":true,"type":"reference","identifie