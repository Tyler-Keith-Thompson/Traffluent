tion\/customerIO(apiKey:region:plan:transport:backoff:clock:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"text"}],"type":"topic","title":"CustomerIOSetupError","role":"symbol","kind":"symbol","url":"\/documentation\/segmentspecencoding\/customeriosetuperror","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/CustomerIOSetupError/privateKey":{"title":"CustomerIOSetupError.privateKey","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/privateKey","type":"topic","url":"\/documentation\/segmentspecencoding\/customeriosetuperror\/privatekey","abstract":[{"text":"The key is a private key (","type":"text"},{"code":"sk_...","type":"codeVoice"},{"text":"), not a public one (","type":"text"},{"code":"pk_...","type":"codeVoice"},{"text":"). A private key reaches","type":"text"},{"text":" ","type":"text"},{"text":"every Customer.io API, deleting and suppressing people included, and must not ship in an","type":"text"},{"text":" ","type":"text"},{"text":"app.","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"privateKey","kind":"identifier"}],"role":"symbol","kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"type":"link"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/rudderStack(writeKey:dataPlane:plan:transport:backoff:clock:)":{"kind":"symbol","identifier":"doc:\/\/Segmen