{"topicSections":[{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:transport:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentRegion","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSetupError"],"anchor":"Sending-to-Segment","title":"Sending to Segment"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:transport:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/RudderStackSetupError"],"anchor":"Sending-to-RudderStack","title":"Sending to RudderStack"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:transport:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError"],"anchor":"Sending-to-Customerio-Data-Pipelines","title":"Sending to Customer.io Data Pipelines"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder"],"anchor":"Encoding-batches","title":"Encoding batches"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError"],"anchor":"Records-left-out","title":"Records left out"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"text":"Send records as Segment-spec track calls to Segment, RudderStack or Customer.io Data Pipelines.","type":"text"}],"variants":[{"paths":["\/documentation\/segmentspecencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"kind":"symbol","metadata":{"modules":[{"name":"SegmentSpecEncoding"}],"title":"SegmentSpecEncoding","symbolKind":"module","role":"collection","externalID":"SegmentSpecEncoding","roleHeading":"Framework"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Segment, RudderStack and Customer.io Data Pipelines each take the same batch call of the Segment"},{"type":"text","text":" "},{"type":"text","text":"spec, at endpoints of their own. One encoder, "},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","isActive":true},{"type":"text","text":", writes it, and a"},{"type":"text","text":" "},{"type":"text","text":"factory for each fills in the endpoint and how the key travels:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":" posts to the","type":"text"},{"text":" ","type":"text"},{"code":"\/v1\/batch","type":"codeVoice"},{"text":" of the workspace’s region (","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentRegion","isActive":true,"type":"reference"},{"text":"), with the write key as HTTP Basic","type":"text"},{"text":" ","type":"text"},{"text":"authentication’s user name and an empty password.","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":" posts to"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"\/v1\/batch"},{"type":"text","text":" of your data plane URL, with the write key the same way."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","type":"reference"},{"text":" posts to the","type":"text"},{"text":" ","type":"text"},{"text":"Pipelines API’s ","type":"text"},{"code":"\/v1\/batch","type":"codeVoice"},{"text":" in the workspace’s region (","type":"text"},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion","type":"reference"},{"text":"), with the key as a","type":"text"},{"text":" ","type":"text"},{"text":"bearer token and ","type":"text"},{"code":"X-Strict-Mode: 1","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Each splits a batch to the spec’s limits (","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":"): 2,500 calls","type":"text"},{"text":" ","type":"text"},{"text":"and 500 KB a request, and under 32 KB a call, which all three accept. A batch with no record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder can write, an empty one included, makes no request. Each retries no response, a 5xx, 408","type":"text"},{"text":" ","type":"text"},{"text":"and 429, and drops and reports any other status. No trace context is sent. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" ","type":"text"},{"text":"leaves this module out; import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The key goes in the ","type":"text"},{"code":"Authorization","type":"codeVoice"},{"text":" header field, never in the body. It is a public client key:","type":"text"},{"text":" ","type":"text"},{"text":"Segment’s and RudderStack’s write keys, and Customer.io’s public keys (","type":"text"},{"code":"pk_…","type":"codeVoice"},{"text":"), ship in their","type":"text"},{"text":" ","type":"text"},{"text":"vendors’ own app and web libraries, and they let a client send data to the source and read","type":"text"},{"text":" ","type":"text"},{"text":"nothing.","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io’s private keys (","type":"text"},{"code":"sk_…","type":"codeVoice"},{"text":") reach every Customer.io API, deleting people included, so","type":"text"},{"text":" ","type":"text"},{"text":"the factory throws ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/privateKey"},{"text":" for one. Each factory throws for an empty","type":"text"},{"text":" ","type":"text"},{"text":"key (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSetupError"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/RudderStackSetupError"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError"},{"text":"), RudderStack’s","type":"text"},{"text":" ","type":"text"},{"text":"for a data plane URL that isn’t a plain ","type":"text"},{"code":"https","type":"codeVoice"},{"text":" URL, and Customer.io’s for a public key of the","type":"text"},{"text":" ","type":"text"},{"text":"other region.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A region has no default. Segment and Customer.io keep a workspace’s data in the US or the EU, and"},{"type":"text","text":" "},{"type":"text","text":"events posted to the other region’s endpoint don’t reach it, so you pick the region on purpose."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each record becomes a track call of an anonymous user. Its "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":" is the record’s session,"},{"type":"text","text":" "},{"type":"text","text":"from the sessions enricher; a record with no session is sent under its own record identifier. No"},{"type":"text","text":" "},{"type":"codeVoice","code":"userId"},{"type":"text","text":", "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" call or traits are sent. Its "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":" is the record’s identifier, which"},{"type":"text","text":" "},{"type":"text","text":"a redelivered record keeps, and its "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":" the record’s timestamp in ISO 8601 with"},{"type":"text","text":" "},{"type":"text","text":"milliseconds. The record’s vendor identifier and trace context aren’t sent. The standard context"},{"type":"text","text":" "},{"type":"text","text":"goes in the spec’s "},{"type":"codeVoice","code":"context"},{"type":"text","text":" fields ("},{"type":"codeVoice","code":"app"},{"type":"text","text":", "},{"type":"codeVoice","code":"device"},{"type":"text","text":", "},{"type":"codeVoice","code":"locale"},{"type":"text","text":", "},{"type":"codeVoice","code":"network"},{"type":"text","text":" and "},{"type":"codeVoice","code":"os"},{"type":"text","text":"), with no"},{"type":"text","text":" "},{"type":"codeVoice","code":"device.id"},{"type":"text","text":" or "},{"type":"codeVoice","code":"advertisingId"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Every call’s ","type":"text"},{"code":"context.ip","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"0.0.0.0","type":"codeVoice"},{"text":", which Segment takes in place of the request’s address, so","type":"text"},{"text":" ","type":"text"},{"text":"it records none. RudderStack fills in a ","type":"text"},{"code":"request_ip","type":"codeVoice"},{"text":" from the request unless the call has one,","type":"text"},{"text":" ","type":"text"},{"text":"even beside ","type":"text"},{"code":"context.ip","type":"codeVoice"},{"text":", and passes it on to its destinations, so RudderStack’s calls also carry","type":"text"},{"text":" ","type":"text"},{"code":"request_ip","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"0.0.0.0","type":"codeVoice"},{"text":". Customer.io’s references don’t say whether ","type":"text"},{"code":"context.ip","type":"codeVoice"},{"text":" takes the place","type":"text"},{"text":" ","type":"text"},{"text":"of the address it reads from an HTTP request, so it may still record the request’s.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each endpoint counts a user per "},{"code":"anonymousId","type":"codeVoice"},{"type":"text","text":", so each session is one user in its reports, and so"},{"type":"text","text":" "},{"type":"text","text":"is each record sent without a session. On a plan billed by monthly tracked users, each counts as"},{"type":"text","text":" "},{"type":"text","text":"one. A record a store recovers after a relaunch has no session, so it goes out under its own"},{"type":"text","text":" "},{"type":"text","text":"identifier. Segment deduplicates calls by "},{"code":"messageId","type":"codeVoice"},{"type":"text","text":", which the record keeps, and drops most"},{"type":"text","text":" "},{"type":"text","text":"duplicates within about 24 hours, not all, so one it stored before the app ended is most likely"},{"type":"text","text":" "},{"type":"text","text":"not stored again. RudderStack’s and Customer.io’s API references don’t say whether they"},{"type":"text","text":" "},{"type":"text","text":"deduplicate, so such a record may be stored twice there."}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is made with. A","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is never sent, whatever the record reveals. A record the encoder can’t write is","type":"text"},{"text":" ","type":"text"},{"text":"left out and the rest of the batch is sent: one the plan doesn’t describe, one named as one of","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io’s semantic events, which delete or suppress people and devices (","type":"text"},{"code":"User Deleted","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"User Suppressed","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Device Deleted","type":"codeVoice"},{"text":" and the rest), one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one holding","type":"text"},{"text":" ","type":"text"},{"text":"a value JSON can’t, one whose timestamp has no ISO 8601 form, and one too large for a call. The","type":"text"},{"text":" ","type":"text"},{"text":"destination reports each as ","type":"text"},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"text":", a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" whose reason is a","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError"},{"text":", and the encoder logs a notice for each semantic event name in the","type":"text"},{"text":" ","type":"text"},{"text":"plan when the destination is made.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Segment answers 200 for every request but one too large or not JSON, so a wrong region, a write"},{"type":"text","text":" "},{"type":"text","text":"key of no source, or a batch of more calls than it takes may be answered 200 with nothing stored."},{"type":"text","text":" "},{"type":"text","text":"Check the source’s debugger after setting the destination up. RudderStack answers a wrong write"},{"type":"text","text":" "},{"type":"text","text":"key with 401, and Customer.io, in strict mode, with 401 too, so the destination reports those. In"},{"type":"text","text":" "},{"type":"text","text":"strict mode Customer.io refuses a whole batch for one bad call, so the encoder leaves out each call"},{"type":"text","text":" "},{"type":"text","text":"Customer.io documents refusing; a 400 for anything else drops the whole request."}]},{"type":"paragraph","inlineContent":[{"text":"To send to PostHog, Amplitude or Mixpanel, use ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AmplitudeEncoding","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"MixpanelEncoding","type":"codeVoice"},{"text":" instead.","type":"text"}]},{"code":["import HTTPDestinations","import SegmentSpecEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: segment)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what each endpoint receives, and why, in more detail."}]}]}],"references":{"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/rudderStack(writeKey:dataPlane:plan:transport:backoff:clock:)":{"abstract":[{"text":"A destination that sends batches to the RudderStack source of ","type":"text"},{"type":"codeVoice","code":"writeKey"},{"text":", through the data","type":"text"},{"text":" ","type":"text"},{"text":"plane at ","type":"text"},{"type":"codeVoice","code":"dataPlane"},{"text":", through ","type":"text"},{"type":"codeVoice","code":"transport"},{"text":", retrying a send that fails for now with the waits","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"clock"},{"text":".","type":"text"}],"url":"\/documentation\/segmentspecencoding\/httpdestinations\/httpdestination\/rudderstack(writekey:dataplane:plan:transport:backoff:clock:)","role":"symbol","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:transport:backoff:clock:)","kind":"symbol","title":"rudderStack(writeKey:dataPlane:plan:transport:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rudderStack","kind":"identifier"},{"text":"(","kind":"text"},{"text":"writeKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"dataPlane","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"RudderStackSetupError","kind":"typeIdentifier","preciseIdentifier":"s:19SegmentSpecEncoding21RudderStackSetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"SegmentSpecBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:19SegmentSpecEncoding0aB12BatchEncoderV"},{"text":">","kind":"text"}],"type":"topic"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/customerIO(apiKey:region:plan:backoff:clock:)":{"abstract":[{"type":"text","text":"A destination that sends batches to the Customer.io Data Pipelines source of "},{"type":"codeVoice","code":"apiKey"},{"type":"text","text":", in a"},{"type":"text","text":" "},{"type":"text","text":"workspace in "},{"type":"codeVoice","code":"region"},{"type":"text","text":", with "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the"},{"type":"text","text":" "},{"type":"text","text":"waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"url":"\/documentation\/segmentspecencoding\/httpdestinations\/httpdestination\/customerio(apikey:region:plan:backoff:clock:)","role":"symbol","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" is "},{"type":"codeVoice","code":"URLSessionTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"SegmentSpecBatchEncoder"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"kind":"symbol","title":"customerIO(apiKey:region:plan:backoff:clock:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerIO"},{"kind":"text","text":"("},{"kind":"externalParam","text":"apiKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:19SegmentSpecEncoding16CustomerIORegionO","text":"CustomerIORegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:19SegmentSpecEncoding20CustomerIOSetupErrorO","text":"CustomerIOSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:19SegmentSpecEncoding0aB12BatchEncoderV","text":"SegmentSpecBatchEncoder"},{"kind":"text","text":">"}],"type":"topic"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/RudderStackSetupError":{"url":"\/documentation\/segmentspecencoding\/rudderstacksetuperror","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:transport:backoff:clock:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RudderStackSetupError","kind":"identifier"}],"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/RudderStackSetupError","title":"RudderStackSetupError","navigatorTitle":[{"text":"RudderStackSetupError","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/CustomerIOSetupError/privateKey":{"title":"CustomerIOSetup