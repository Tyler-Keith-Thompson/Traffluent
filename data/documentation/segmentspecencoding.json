 calls to Segment, RudderStack or Customer.io Data Pipelines.","type":"text"}],"identifier":{"url":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","interfaceLanguage":"swift"},"references":{"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/rudderStack(writeKey:dataPlane:plan:transport:backoff:clock:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rudderStack","kind":"identifier"},{"text":"(","kind":"text"},{"text":"writeKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"dataPlane","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","preciseIdentifier":"s:20FoundationEssentials3URLV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"RudderStackSetupError","preciseIdentifier":"s:19SegmentSpecEncoding21RudderStackSetupErrorO","ki