","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"SegmentSpecBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:19SegmentSpecEncoding0aB12BatchEncoderV"},{"text":">","kind":"text"}],"title":"segment(writeKey:region:plan:transport:backoff:clock:)","url":"\/documentation\/segmentspecencoding\/httpdestinations\/httpdestination\/segment(writekey:region:plan:transport:backoff:clock:)","abstract":[{"type":"text","text":"A destination that sends batches to the Segment source of "},{"type":"codeVoice","code":"writeKey"},{"type":"text","text":", in a workspace in"},{"type":"text","text":" "},{"type":"codeVoice","code":"region"},{"type":"text","text":", through "},{"type":"codeVoice","code":"transport"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:transport:backoff:clock:)"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/SegmentSpecBatchEncoder/batchLimit":{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","url":"\/documentation\/segmentspecencoding\/segmentspecbatchencoder\/batchlimit","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"title":"batchLimit","abstract":[{"text":"The Segment spec’s limits on one request, which Segment, RudderStack and Customer.io all","type":"text"},{"text":" ","type":"text"},{"text":"accept: 2,500 calls, 500,000 bytes of body, and 31,999 bytes of one call.","type":"text"}]},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/customerIO(apiKey:region:plan:backoff:clock:)":{"kind":"symbol","url":"\/documentation\/segmentspecencoding\/httpdestinations\/httpdestination\/customerio(apikey:region:plan:backoff:clock:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerIO"},{"kind":"text","text":"("},{"kind":"externalParam","text":"apiKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CustomerIORegion","preciseIdentifier":"s:19SegmentSpecEncoding16CustomerIORegionO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{