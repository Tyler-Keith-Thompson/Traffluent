:"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"SegmentSpecBatchEncoder","preciseIdentifier":"s:19SegmentSpecEncoding0aB12BatchEncoderV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","kind":"symbol","abstract":[{"text":"A destination that sends batches to the RudderStack source of ","type":"text"},{"code":"writeKey","type":"codeVoice"},{"text":", through the data","type":"text"},{"text":" ","type":"text"},{"text":"plane at ","type":"text"},{"code":"dataPlane","type":"codeVoice"},{"text":", through ","type":"text"},{"code":"transport","type":"codeVoice"},{"text":", retrying a send that fails for now with the waits","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/SegmentSpecEncodingError":{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"title":"SegmentSpecEncodingError","kind":"symbol","url":"\/documentation\/segmentspecencoding\/segmentspecencodingerror","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentSpecEncodingError"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SegmentSpecEncodingError"}],"type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","type":"link","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/CustomerIOSetupError":{"url":"\/documentation\/segmentspecencoding\/customeriosetuperror","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError","title":"CustomerIOSetupError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomerIOSetupError"}],"role":"symbol","type":"topic","abstract":[{"text":"Why ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:transport:backoff:clock:)"},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"CustomerIOSetupError"}],"kind":"symbol"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/SegmentRegion":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentRegion","kind":"identifier"}],"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentRegion","title":"SegmentRegion","kind":"symbol","abstract":[{"text":"The region of a Segment workspace, which decides the batch endpoint its sources’ events are","type":"text"},{"text":" ","type":"text"},{"text":"posted to.","type":"text"}],"url":"\/documentation\/segmentspecencoding\/segmentregion","navigatorTitle":[{"text":"SegmentRegion","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/customerIO(apiKey:region:plan:transport:backoff:clock:)":{"url":"\/documentation\/segmentspecencoding\/httpdestinations\/httpdestination\/customerio(apikey:region:plan:transport:backoff:clock:)","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:transport:backoff:clock:)","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"HTTPTransport","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Encoding","type":"codeVoice"},{"type":"text","text":" is "},{"code":"SegmentSpecBatchEncoder","type":"codeVoice"},{"type":"text","text":"."}]},"title":"customerIO(apiKey:region:plan:transport:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerIO","kind":"identifier"},{"text":"(","kind":"text"},{"text":"apiKey","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:19SegmentSpecEncoding16CustomerIORegionO","text":"CustomerIORegion","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"t