{"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:transport:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentRegion","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSetupError"],"title":"Sending to Segment","anchor":"Sending-to-Segment"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:transport:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/RudderStackSetupError"],"title":"Sending to RudderStack","anchor":"Sending-to-RudderStack"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:transport:backoff:clock:)","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError"],"title":"Sending to Customer.io Data Pipelines","anchor":"Sending-to-Customerio-Data-Pipelines"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder"],"title":"Encoding batches","anchor":"Encoding-batches"},{"identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError"],"title":"Records left out","anchor":"Records-left-out"}],"sections":[],"hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","externalID":"SegmentSpecEncoding","role":"collection","title":"SegmentSpecEncoding","modules":[{"name":"SegmentSpecEncoding"}],"symbolKind":"module"},"identifier":{"url":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding","interfaceLanguage":"swift"},"abstract":[{"text":"Send records as Segment-spec track calls to Segment, RudderStack or Customer.io Data Pipelines.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/segmentspecencoding"]}],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Segment, RudderStack and Customer.io Data Pipelines each take the same batch call of the Segment"},{"type":"text","text":" "},{"type":"text","text":"spec, at endpoints of their own. One encoder, "},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":", writes it, and a"},{"type":"text","text":" "},{"type":"text","text":"factory for each fills in the endpoint and how the key travels:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)"},{"type":"text","text":" posts to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/v1\/batch"},{"type":"text","text":" of the workspace’s region ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentRegion"},{"type":"text","text":"), with the write key as HTTP Basic"},{"type":"text","text":" "},{"type":"text","text":"authentication’s user name and an empty password."}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)"},{"type":"text","text":" posts to"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"\/v1\/batch"},{"type":"text","text":" of your data plane URL, with the write key the same way."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","type":"reference","isActive":true},{"text":" posts to the","type":"text"},{"text":" ","type":"text"},{"text":"Pipelines API’s ","type":"text"},{"code":"\/v1\/batch","type":"codeVoice"},{"text":" in the workspace’s region (","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion","type":"reference","isActive":true},{"text":"), with the key as a","type":"text"},{"text":" ","type":"text"},{"text":"bearer token and ","type":"text"},{"code":"X-Strict-Mode: 1","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Each splits a batch to the spec’s limits ("},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":"): 2,500 calls"},{"type":"text","text":" "},{"type":"text","text":"and 500 KB a request, and under 32 KB a call, which all three accept. A batch with no record the"},{"type":"text","text":" "},{"type":"text","text":"encoder can write, an empty one included, makes no request. Each retries no response, a 5xx, 408"},{"type":"text","text":" "},{"type":"text","text":"and 429, and drops and reports any other status. No trace context is sent. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" "},{"type":"text","text":"leaves this module out; import it on its own."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The key goes in the "},{"type":"codeVoice","code":"Authorization"},{"type":"text","text":" header field, never in the body. It is a public client key:"},{"type":"text","text":" "},{"type":"text","text":"Segment’s and RudderStack’s write keys, and Customer.io’s public keys ("},{"type":"codeVoice","code":"pk_…"},{"type":"text","text":"), ship in their"},{"type":"text","text":" "},{"type":"text","text":"vendors’ own app and web libraries, and they let a client send data to the source and read"},{"type":"text","text":" "},{"type":"text","text":"nothing."},{"type":"text","text":" "},{"type":"text","text":"Customer.io’s private keys ("},{"type":"codeVoice","code":"sk_…"},{"type":"text","text":") reach every Customer.io API, deleting people included, so"},{"type":"text","text":" "},{"type":"text","text":"the factory throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError\/privateKey"},{"type":"text","text":" for one. Each factory throws for an empty"},{"type":"text","text":" "},{"type":"text","text":"key ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSetupError"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/RudderStackSetupError"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError"},{"type":"text","text":"), RudderStack’s"},{"type":"text","text":" "},{"type":"text","text":"for a data plane URL that isn’t a plain "},{"type":"codeVoice","code":"https"},{"type":"text","text":" URL, and Customer.io’s for a public key of the"},{"type":"text","text":" "},{"type":"text","text":"other region."}],"type":"paragraph"},{"inlineContent":[{"text":"A region has no default. Segment and Customer.io keep a workspace’s data in the US or the EU, and","type":"text"},{"text":" ","type":"text"},{"text":"events posted to the other region’s endpoint don’t reach it, so you pick the region on purpose.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each record becomes a track call of an anonymous user. Its "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":" is the record’s session,"},{"type":"text","text":" "},{"type":"text","text":"from the sessions enricher; a record with no session is sent under its own record identifier. No"},{"type":"text","text":" "},{"type":"codeVoice","code":"userId"},{"type":"text","text":", "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" call or traits are sent. Its "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":" is the record’s identifier, which"},{"type":"text","text":" "},{"type":"text","text":"a redelivered record keeps, and its "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":" the record’s timestamp in ISO 8601 with"},{"type":"text","text":" "},{"type":"text","text":"milliseconds. The record’s vendor identifier and trace context aren’t sent. The standard context"},{"type":"text","text":" "},{"type":"text","text":"goes in the spec’s "},{"type":"codeVoice","code":"context"},{"type":"text","text":" fields ("},{"type":"codeVoice","code":"app"},{"type":"text","text":", "},{"type":"codeVoice","code":"device"},{"type":"text","text":", "},{"type":"codeVoice","code":"locale"},{"type":"text","text":", "},{"type":"codeVoice","code":"network"},{"type":"text","text":" and "},{"type":"codeVoice","code":"os"},{"type":"text","text":"), with no"},{"type":"text","text":" "},{"type":"codeVoice","code":"device.id"},{"type":"text","text":" or "},{"type":"codeVoice","code":"advertisingId"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every call’s "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" is "},{"type":"codeVoice","code":"0.0.0.0"},{"type":"text","text":", which Segment takes in place of the request’s address, so"},{"type":"text","text":" "},{"type":"text","text":"it records none. RudderStack fills in a "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" from the request unless the call has one,"},{"type":"text","text":" "},{"type":"text","text":"even beside "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":", and passes it on to its destinations, so RudderStack’s calls also carry"},{"type":"text","text":" "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" as "},{"type":"codeVoice","code":"0.0.0.0"},{"type":"text","text":". Customer.io’s references don’t say whether "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" takes the place"},{"type":"text","text":" "},{"type":"text","text":"of the address it reads from an HTTP request, so it may still record the request’s."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each endpoint counts a user per "},{"type":"codeVoice","code":"anonymousId"},{"type":"text","text":", so each session is one user in its reports, and so"},{"type":"text","text":" "},{"type":"text","text":"is each record sent without a session. On a plan billed by monthly tracked users, each counts as"},{"type":"text","text":" "},{"type":"text","text":"one. A record a store recovers after a relaunch has no session, so it goes out under its own"},{"type":"text","text":" "},{"type":"text","text":"identifier. Segment deduplicates calls by "},{"type":"codeVoice","code":"messageId"},{"type":"text","text":", which the record keeps, and drops most"},{"type":"text","text":" "},{"type":"text","text":"duplicates within about 24 hours, not all, so one it stored before the app ended is most likely"},{"type":"text","text":" "},{"type":"text","text":"not stored again. RudderStack’s and Customer.io’s API references don’t say whether they"},{"type":"text","text":" "},{"type":"text","text":"deduplicate, so such a record may be stored twice there."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals. A record the encoder can’t write is"},{"type":"text","text":" "},{"type":"text","text":"left out and the rest of the batch is sent: one the plan doesn’t describe, one named as one of"},{"type":"text","text":" "},{"type":"text","text":"Customer.io’s semantic events, which delete or suppress people and devices ("},{"type":"codeVoice","code":"User Deleted"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"User Suppressed"},{"type":"text","text":", "},{"type":"codeVoice","code":"Device Deleted"},{"type":"text","text":" and the rest), one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one holding"},{"type":"text","text":" "},{"type":"text","text":"a value JSON can’t, one whose timestamp has no ISO 8601 form, and one too large for a call. The"},{"type":"text","text":" "},{"type":"text","text":"destination reports each as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" whose reason is a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError"},{"type":"text","text":", and the encoder logs a notice for each semantic event name in the"},{"type":"text","text":" "},{"type":"text","text":"plan when the destination is made."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Segment answers 200 for every request but one too large or not JSON, so a wrong region, a write"},{"type":"text","text":" "},{"type":"text","text":"key of no source, or a batch of more calls than it takes may be answered 200 with nothing stored."},{"type":"text","text":" "},{"type":"text","text":"Check the source’s debugger after setting the destination up. RudderStack answers a wrong write"},{"type":"text","text":" "},{"type":"text","text":"key with 401, and Customer.io, in strict mode, with 401 too, so the destination reports those. In"},{"type":"text","text":" "},{"type":"text","text":"strict mode Customer.io refuses a whole batch for one bad call, so the encoder leaves out each call"},{"type":"text","text":" "},{"type":"text","text":"Customer.io documents refusing; a 400 for anything else drops the whole request."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To send to PostHog, Amplitude or Mixpanel, use "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":", "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"MixpanelEncoding"},{"type":"text","text":" instead."}],"type":"paragraph"},{"code":["import HTTPDestinations","import SegmentSpecEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: segment)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference"},{"text":" ","type":"text"},{"text":"covers what each endpoint receives, and why, in more detail.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/customerIO(apiKey:region:plan:transport:backoff:clock:)":{"url":"\/documentation\/segmentspecencoding\/httpdestinations\/httpdestination\/customerio(apikey:region:plan:transport:backoff:clock:)","title":"customerIO(apiKey:region:plan:transport:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerIO","kind":"identifier"},{"text":"(","kind":"text"},{"text":"apiKey","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:19SegmentSpecEncoding16CustomerIORegionO","text":"CustomerIORegion","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:19SegmentSpecEncoding20CustomerIOSetupErrorO","text":"CustomerIOSetupError","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:19SegmentSpecEncoding0aB12BatchEncoderV","text":"SegmentSpecBatchEncoder","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:transport:backoff:clock:)","abstract":[{"type":"text","text":"A destination that sends batches to the Customer.io Data Pipelines source of "},{"code":"apiKey","type":"codeVoice"},{"type":"text","text":", in a"},{"type":"text","text":" "},{"type":"text","text":"workspace in "},{"code":"region","type":"codeVoice"},{"type":"text","text":", through "},{"code":"transport","type":"codeVoice"},{"type":"text","text":", retrying a send that fails for now with the"},{"type":"text","text":" "},{"type":"text","text":"waits of "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" on "},{"code":"clock","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","type":"topic"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/CustomerIOSetupError":{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomerIOSetupError","kind":"identifier"}],"url":"\/documentation\/segmentspecencoding\/customeriosetuperror","navigatorTitle":[{"text":"CustomerIOSetupError","kind":"identifier"}],"abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:transport:backoff:clock:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"text"}],"role":"symbol","type":"topic","title":"CustomerIOSetupError"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/SegmentSpecEncodingError":{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Why "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"title":"SegmentSpecEncodingError","url":"\/documentation\/segmentspecencoding\/segmentspecencodingerror","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentSpecEncodingError"}],"navigatorTitle":[{"kind":"identifier","text":"SegmentSpecEncodingError"}]},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/SegmentSpecBatchEncoder":{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder","type":"topic","kind":"symbol","role":"symbol","title":"SegmentSpecBatchEncoder","url":"\/documentation\/segmentspecencoding\/segmentspecbatchencoder","navigatorTitle":[{"kind":"identifier","text":"SegmentSpecBatchEncoder"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentSpecBatchEncoder"}],"abstract":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of the Segment spec’s batch call, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"can send events to Segment, RudderStack, Customer.io Data Pipelines, or another endpoint that","type":"text"},{"text":" ","type":"text"},{"text":"takes Segment’s ","type":"text"},{"code":"POST \/v1\/batch","type":"codeVoice"},{"text":".","type":"text"}]},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/customerIO(apiKey:region:plan:backoff:clock:)":{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","role":"symbol","type":"topic","title":"customerIO(apiKey:region:plan:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerIO","kind":"identifier"},{"text":"(","kind":"text"},{"text":"apiKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"CustomerIORegion","preciseIdentifier":"s:19SegmentSpecEncoding16CustomerIORegionO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier"},{"text":", "