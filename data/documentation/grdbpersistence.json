{"hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","symbolKind":"module","modules":[{"name":"GRDBPersistence"}],"externalID":"GRDBPersistence","role":"collection","title":"GRDBPersistence"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"DatabaseStore"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"RecordStore"},{"type":"text","text":" (module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},{"type":"text","text":") for apps on Apple platforms that"},{"type":"text","text":" "},{"type":"text","text":"already keep a GRDB database. It takes the app’s "},{"type":"codeVoice","code":"DatabaseQueue"},{"type":"text","text":" or "},{"type":"codeVoice","code":"DatabasePool"},{"type":"text","text":" and a table"},{"type":"text","text":" "},{"type":"text","text":"name, creates the table with a migration of its own, and opens no second SQLite database. It is a"},{"type":"text","text":" "},{"type":"text","text":"product of its own, which "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It makes the same promises as "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":". The tracker’s worker commits each record, in a"},{"type":"text","text":" "},{"type":"text","text":"transaction of its own, before publishing it. A batch’s rows are marked before any destination"},{"type":"text","text":" "},{"type":"text","text":"receives it and deleted once every destination has. The table holds at most "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":" bytes of"},{"type":"text","text":" "},{"type":"text","text":"encoded records, 5 MiB by default, with the oldest rows deleted to make room, and each drop is"},{"type":"text","text":" "},{"type":"text","text":"reported on "},{"type":"codeVoice","code":"DatabaseStore.dropReports"},{"type":"text","text":". Records are encoded as "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":" encodes them, so"},{"type":"text","text":" "},{"type":"text","text":"only events of the types in "},{"type":"codeVoice","code":"events"},{"type":"text","text":", which conform to "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":", are kept."}],"type":"paragraph"},{"inlineContent":[{"text":"How durable a commit is against power loss is the database’s choice, through its journal mode and","type":"text"},{"text":" ","type":"text"},{"code":"synchronous","type":"codeVoice"},{"text":" setting. ","type":"text"},{"code":"DatabaseStore.synchronize()","type":"codeVoice"},{"text":" checkpoints a database in WAL mode; call it","type":"text"},{"text":" ","type":"text"},{"text":"as the app moves to the background. Open one store per table at a time, and don’t open one from","type":"text"},{"text":" ","type":"text"},{"text":"inside an access to the same database.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An app with no database of its own uses "},{"code":"SegmentStore","type":"codeVoice"},{"type":"text","text":", which needs no GRDB."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import GRDB","import GRDBPersistence","","let database = try DatabaseQueue(path: databasePath)","let store = try DatabaseStore(events: [SignedUp.self], database: database, table: \"analyticsRecord\")","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)","tracker.track(SignedUp(plan: \"pro\"))"]},{"inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords"},{"type":"text","text":" "},{"type":"text","text":"covers what a store keeps, its bounds and recovery."}],"type":"paragraph"},{"anchor":"API","text":"API","type":"heading","level":2},{"inlineContent":[{"text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols","type":"text"},{"text":" ","type":"text"},{"text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them","type":"text"},{"text":" ","type":"text"},{"text":"for an Apple target.","type":"text"}],"type":"paragraph"},{"anchor":"Keeping-records-in-a-database","text":"Keeping records in a database","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"DatabaseStore"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"DatabaseStoreError","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"sections":[],"identifier":{"url":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/grdbpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"references":{"doc://Persistence/documentation/Persistence":{"abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"type":"topic","kind":"symbol","title":"Persistence","role":"collection","url":"\/documentation\/persistence","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"type":"topic","url":"\/documentation\/grdbpersistence","title":"GRDBPersistence","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","kind":"symbol","abstract":[{"type":"text","text":"Keep each record in a table of the app’s own GRDB database until it is delivered."}],"role":"collection"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/persistingrecords":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","titleInlineContent":[{"type":"text","text":"Persisting Records"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords"}}}