{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"hierarchy":{"paths":[[]]},"kind":"symbol","metadata":{"externalID":"GRDBPersistence","symbolKind":"module","modules":[{"name":"GRDBPersistence"}],"roleHeading":"Framework","role":"collection","title":"GRDBPersistence"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grdbpersistence"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DatabaseStore"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"RecordStore"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"reference","isActive":true},{"type":"text","text":") for apps on Apple platforms that"},{"type":"text","text":" "},{"type":"text","text":"already keep a GRDB database. It takes the app’s "},{"type":"codeVoice","code":"DatabaseQueue"},{"type":"text","text":" or "},{"type":"codeVoice","code":"DatabasePool"},{"type":"text","text":" and a table"},{"type":"text","text":" "},{"type":"text","text":"name, creates the table with a migration of its own, and opens no second SQLite database. It is a"},{"type":"text","text":" "},{"type":"text","text":"product of its own, which "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It makes the same promises as "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":". The tracker’s worker commits each record, in a"},{"type":"text","text":" "},{"type":"text","text":"transaction of its own, before publishing it. A batch’s rows are marked before any destination"},{"type":"text","text":" "},{"type":"text","text":"receives it and deleted once every destination has. The table holds at most "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":" bytes of"},{"type":"text","text":" "},{"type":"text","text":"encoded records, 5 MiB by default, with the oldest rows deleted to make room, and each drop is"},{"type":"text","text":" "},{"type":"text","text":"reported on "},{"type":"codeVoice","code":"DatabaseStore.dropReports"},{"type":"text","text":". Records are encoded as "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":" encodes them, so"},{"type":"text","text":" "},{"type":"text","text":"only events of the types in "},{"type":"codeVoice","code":"events"},{"type":"text","text":", which conform to "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":", are kept."}]},{"type":"paragraph","inlineContent":[{"text":"How durable a commit is against power loss is the database’s choice, through its journal mode and","type":"text"},{"text":" ","type":"text"},{"code":"synchronous","type":"codeVoice"},{"text":" setting. ","type":"text"},{"code":"DatabaseStore.synchronize()","type":"codeVoice"},{"text":" checkpoints a database in WAL mode; call it","type":"text"},{"text":" ","type":"text"},{"text":"as the app moves to the background. Open one store per table at a time, and don’t open one from","type":"text"},{"text":" ","type":"text"},{"text":"inside an access to the same database.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An app with no database of its own uses ","type":"text"},{"code":"SegmentStore","type":"codeVoice"},{"text":", which needs no GRDB.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import GRDB","import GRDBPersistence","","let database = try DatabaseQueue(path: databasePath)","let store = try DatabaseStore(events: [SignedUp.self], database: database, table: \"analyticsRecord\")","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)","tracker.track(SignedUp(plan: \"pro\"))"]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"covers what a store keeps, its bounds and recovery.","type":"text"}]},{"text":"API","type":"heading","anchor":"API","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols"},{"type":"text","text":" "},{"type":"text","text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them"},{"type":"text","text":" "},{"type":"text","text":"for an Apple target."}]},{"text":"Keeping records in a database","type":"heading","anchor":"Keeping-records-in-a-database","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DatabaseStore"}]}]}]}],"kind":"content"}],"references":{"doc://GRDBPersistence/documentation/GRDBPersistence":{"role":"collection","url":"\/documentation\/grdbpersistence","abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"kind":"symbol","title":"GRDBPersistence","type":"topic","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},"doc://Persistence/documentation/Persistence":{"title":"Persistence","role":"collection","url":"\/documentation\/persistence","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/persistingrecords":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","titleInlineContent":[{"type":"text","text":"Persisting Records"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","type":"link"}}}