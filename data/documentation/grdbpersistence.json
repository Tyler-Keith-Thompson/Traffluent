{"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[[]]},"abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"metadata":{"symbolKind":"module","roleHeading":"Framework","modules":[{"name":"GRDBPersistence"}],"role":"collection","externalID":"GRDBPersistence","title":"GRDBPersistence"},"variants":[{"paths":["\/documentation\/grdbpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DatabaseStore"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"RecordStore"},{"text":" (module ","type":"text"},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence","isActive":true},{"text":") for apps on Apple platforms that","type":"text"},{"text":" ","type":"text"},{"text":"already keep a GRDB database. It takes the app’s ","type":"text"},{"type":"codeVoice","code":"DatabaseQueue"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"DatabasePool"},{"text":" and a table","type":"text"},{"text":" ","type":"text"},{"text":"name, creates the table with a migration of its own, and opens no second SQLite database. It is a","type":"text"},{"text":" ","type":"text"},{"text":"product of its own, which ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It makes the same promises as "},{"code":"SegmentStore","type":"codeVoice"},{"type":"text","text":". The tracker’s worker commits each record, in a"},{"type":"text","text":" "},{"type":"text","text":"transaction of its own, before publishing it. A batch’s rows are marked before any destination"},{"type":"text","text":" "},{"type":"text","text":"receives it and deleted once every destination has. The table holds at most "},{"code":"byteBound","type":"codeVoice"},{"type":"text","text":" bytes of"},{"type":"text","text":" "},{"type":"text","text":"encoded records, 5 MiB by default, with the oldest rows deleted to make room, and each drop is"},{"type":"text","text":" "},{"type":"text","text":"reported on "},{"code":"DatabaseStore.dropReports","type":"codeVoice"},{"type":"text","text":". Records are encoded as "},{"code":"SegmentStore","type":"codeVoice"},{"type":"text","text":" encodes them, so"},{"type":"text","text":" "},{"type":"text","text":"only events of the types in "},{"code":"events","type":"codeVoice"},{"type":"text","text":", which conform to "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":", are kept. Rows written by"},{"type":"text","text":" "},{"type":"text","text":"Traffluent 0.0.44 or earlier, in an earlier encoding, aren’t read: each is deleted when the store"},{"type":"text","text":" "},{"type":"text","text":"opens and reported as "},{"code":".undecodable","type":"codeVoice"},{"type":"text","text":", or as "},{"code":".versionMismatch","type":"codeVoice"},{"type":"text","text":" where its stored version differs"},{"type":"text","text":" "},{"type":"text","text":"from its type’s."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"How durable a commit is against power loss is the database’s choice, through its journal mode and"},{"type":"text","text":" "},{"code":"synchronous","type":"codeVoice"},{"type":"text","text":" setting. "},{"code":"DatabaseStore.synchronize()","type":"codeVoice"},{"type":"text","text":" checkpoints a database in WAL mode; call it"},{"type":"text","text":" "},{"type":"text","text":"as the app moves to the background. Open one store per table at a time, and don’t open one from"},{"type":"text","text":" "},{"type":"text","text":"inside an access to the same database."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An app with no database of its own uses "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":", which needs no GRDB."}]},{"syntax":"swift","type":"codeListing","code":["import GRDB","import GRDBPersistence","","let database = try DatabaseQueue(path: databasePath)","let store = try DatabaseStore(events: [SignedUp.self], database: database, table: \"analyticsRecord\")","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)","tracker.track(SignedUp(plan: \"pro\"))"]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers what a store keeps, its bounds and recovery.","type":"text"}]},{"anchor":"API","text":"API","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols"},{"type":"text","text":" "},{"type":"text","text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them"},{"type":"text","text":" "},{"type":"text","text":"for an Apple target."}]},{"anchor":"Keeping-records-in-a-database","text":"Keeping records in a database","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"code":"DatabaseStore","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"DatabaseStoreError"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/persistingrecords":{"title":"Persisting Records","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","titleInlineContent":[{"type":"text","text":"Persisting Records"}]},"doc://Persistence/documentation/Persistence":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","url":"\/documentation\/persistence","kind":"symbol","type":"topic","title":"Persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"role":"collection"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"kind":"symbol","url":"\/documentation\/grdbpersistence","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","role":"collection","abstract":[{"type":"text","text":"Keep each record in a table of the app’s own GRDB database until it is delivered."}],"title":"GRDBPersistence","type":"topic"}}}