{"identifier":{"url":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","interfaceLanguage":"swift"},"abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"code":"DatabaseStore","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"RecordStore","type":"codeVoice"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","isActive":true,"type":"reference"},{"text":") for apps on Apple platforms that","type":"text"},{"text":" ","type":"text"},{"text":"already keep a GRDB database. It takes the app’s ","type":"text"},{"code":"DatabaseQueue","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"DatabasePool","type":"codeVoice"},{"text":" and a table","type":"text"},{"text":" ","type":"text"},{"text":"name, creates the table with a migration of its own, and opens no second SQLite database. It is a","type":"text"},{"text":" ","type":"text"},{"text":"product of its own, which ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It makes the same promises as ","type":"text"},{"type":"codeVoice","code":"SegmentStore"},{"text":". The tracker’s worker commits each record, in a","type":"text"},{"text":" ","type":"text"},{"text":"transaction of its own, before publishing it. A batch’s rows are marked before any destination","type":"text"},{"text":" ","type":"text"},{"text":"receives it and deleted once every destination has. The table holds at most ","type":"text"},{"type":"codeVoice","code":"byteBound"},{"text":" bytes of","type":"text"},{"text":" ","type":"text"},{"text":"encoded records, 5 MiB by default, with the oldest rows deleted to make room, and each drop is","type":"text"},{"text":" ","type":"text"},{"text":"reported on ","type":"text"},{"type":"codeVoice","code":"DatabaseStore.dropReports"},{"text":". Records are encoded as ","type":"text"},{"type":"codeVoice","code":"SegmentStore"},{"text":" encodes them, so","type":"text"},{"text":" ","type":"text"},{"text":"only events of the types in ","type":"text"},{"type":"codeVoice","code":"events"},{"text":", which conform to ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", are kept. Rows written by","type":"text"},{"text":" ","type":"text"},{"text":"Traffluent 0.0.44 or earlier, in an earlier encoding, aren’t read: each is deleted when the store","type":"text"},{"text":" ","type":"text"},{"text":"opens and reported as ","type":"text"},{"type":"codeVoice","code":".undecodable"},{"text":", or as ","type":"text"},{"type":"codeVoice","code":".versionMismatch"},{"text":" where its stored version differs","type":"text"},{"text":" ","type":"text"},{"text":"from its type’s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"How durable a commit is against power loss is the database’s choice, through its journal mode and","type":"text"},{"text":" ","type":"text"},{"code":"synchronous","type":"codeVoice"},{"text":" setting. ","type":"text"},{"code":"DatabaseStore.synchronize()","type":"codeVoice"},{"text":" checkpoints a database in WAL mode; call it","type":"text"},{"text":" ","type":"text"},{"text":"as the app moves to the background. Open one store per table at a time, and don’t open one from","type":"text"},{"text":" ","type":"text"},{"text":"inside an access to the same database.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An app with no database of its own uses ","type":"text"},{"code":"SegmentStore","type":"codeVoice"},{"text":", which needs no GRDB.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import GRDB","import GRDBPersistence","","let database = try DatabaseQueue(path: databasePath)","let store = try DatabaseStore(events: [SignedUp.self], database: database, table: \"analyticsRecord\")","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)","tracker.track(SignedUp(plan: \"pro\"))"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords"},{"type":"text","text":" "},{"type":"text","text":"covers what a store keeps, its bounds and recovery."}],"type":"paragraph"},{"text":"API","type":"heading","level":2,"anchor":"API"},{"inlineContent":[{"text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols","type":"text"},{"text":" ","type":"text"},{"text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them","type":"text"},{"text":" ","type":"text"},{"text":"for an Apple target.","type":"text"}],"type":"paragraph"},{"text":"Keeping records in a database","type":"heading","level":3,"anchor":"Keeping-records-in-a-database"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"DatabaseStore"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DatabaseStoreError"}]}]}]}]}],"variants":[{"paths":["\/documentation\/grdbpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"roleHeading":"Framework","title":"GRDBPersistence","externalID":"GRDBPersistence","modules":[{"name":"GRDBPersistence"}],"role":"collection","symbolKind":"module"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"hierarchy":{"paths":[[]]},"references":{"doc://GRDBPersistence/documentation/GRDBPersistence":{"kind":"symbol","url":"\/documentation\/grdbpersistence","abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"role":"collection","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","type":"topic","title":"GRDBPersistence"},"doc://Persistence/documentation/Persistence":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"role":"collection","kind":"symbol","type":"topic","title":"Persistence","url":"\/documentation\/persistence"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/persistingrecords":{"title":"Persisting Records","titleInlineContent":[{"text":"Persisting Records","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","type":"link"}}}