{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence"},"sections":[],"abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"DatabaseStore"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"RecordStore"},{"text":" (module ","type":"text"},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence","isActive":true},{"text":") for apps on Apple platforms that","type":"text"},{"text":" ","type":"text"},{"text":"already keep a GRDB database. It takes the app’s ","type":"text"},{"type":"codeVoice","code":"DatabaseQueue"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"DatabasePool"},{"text":" and a table","type":"text"},{"text":" ","type":"text"},{"text":"name, creates the table with a migration of its own, and opens no second SQLite database. It is a","type":"text"},{"text":" ","type":"text"},{"text":"product of its own, which ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It makes the same promises as "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":". The tracker’s worker commits each record, in a"},{"type":"text","text":" "},{"type":"text","text":"transaction of its own, before publishing it. A batch’s rows are marked before any destination"},{"type":"text","text":" "},{"type":"text","text":"receives it and deleted once every destination has. The table holds at most "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":" bytes of"},{"type":"text","text":" "},{"type":"text","text":"encoded records, 5 MiB by default, with the oldest rows deleted to make room, and each drop is"},{"type":"text","text":" "},{"type":"text","text":"reported on "},{"type":"codeVoice","code":"DatabaseStore.dropReports"},{"type":"text","text":". Records are encoded as "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":" encodes them, so"},{"type":"text","text":" "},{"type":"text","text":"only events of the types in "},{"type":"codeVoice","code":"events"},{"type":"text","text":", which conform to "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":", are kept."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"How durable a commit is against power loss is the database’s choice, through its journal mode and"},{"type":"text","text":" "},{"type":"codeVoice","code":"synchronous"},{"type":"text","text":" setting. "},{"type":"codeVoice","code":"DatabaseStore.synchronize()"},{"type":"text","text":" checkpoints a database in WAL mode; call it"},{"type":"text","text":" "},{"type":"text","text":"as the app moves to the background. Open one store per table at a time, and don’t open one from"},{"type":"text","text":" "},{"type":"text","text":"inside an access to the same database."}],"type":"paragraph"},{"inlineContent":[{"text":"An app with no database of its own uses ","type":"text"},{"code":"SegmentStore","type":"codeVoice"},{"text":", which needs no GRDB.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import GRDB","import GRDBPersistence","","let database = try DatabaseQueue(path: databasePath)","let store = try DatabaseStore(events: [SignedUp.self], database: database, table: \"analyticsRecord\")","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)","tracker.track(SignedUp(plan: \"pro\"))"],"type":"codeListing"},{"inlineContent":[{"text":"The guide ","type":"text"},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","isActive":true},{"text":" ","type":"text"},{"text":"covers what a store keeps, its bounds and recovery.","type":"text"}],"type":"paragraph"},{"text":"API","level":2,"anchor":"API","type":"heading"},{"inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols"},{"type":"text","text":" "},{"type":"text","text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them"},{"type":"text","text":" "},{"type":"text","text":"for an Apple target."}],"type":"paragraph"},{"text":"Keeping records in a database","level":3,"anchor":"Keeping-records-in-a-database","type":"heading"},{"items":[{"content":[{"inlineContent":[{"code":"DatabaseStore","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"metadata":{"modules":[{"name":"GRDBPersistence"}],"externalID":"GRDBPersistence","symbolKind":"module","roleHeading":"Framework","role":"collection","title":"GRDBPersistence"},"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/grdbpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Persistence/documentation/Persistence":{"title":"Persistence","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/persistence","identifier":"doc:\/\/Persistence\/documentation\/Persistence"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"type":"topic","title":"GRDBPersistence","kind":"symbol","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"url":"\/documentation\/grdbpersistence","role":"collection"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/persistingrecords":{"titleInlineContent":[{"type":"text","text":"Persisting Records"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","type":"link","title":"Persisting Records"}}}