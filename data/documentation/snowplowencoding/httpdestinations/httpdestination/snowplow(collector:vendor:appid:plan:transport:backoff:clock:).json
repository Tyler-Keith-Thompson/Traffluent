ation appends","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\/com.snowplowanalytics.snowplow\/tp2"},{"text":" itself.","type":"text"}],"type":"paragraph"}],"name":"collector"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The Iglu vendor of the events’ schemas, in reverse domain notation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"com.acme","type":"codeVoice"},{"text":"): the one the tracking plan’s Iglu export is given.","type":"text"}]}],"name":"vendor"},{"content":[{"inlineContent":[{"text":"The app’s ID, each event’s ","type":"text"},{"code":"aid","type":"codeVoice"},{"text":", which tells apart the apps and sites that send","type":"text"},{"text":" ","type":"text"},{"text":"to one pipeline.","type":"text"}],"type":"paragraph"}],"name":"appID"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}],"name":"transport"},{"content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}],"name":"clock"}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The destination posts to the collector’s "},{"code":"\/com.snowplowanalytics.snowplow\/tp2","type":"codeVoice"},{"type":"text","text":", the tracker"},{"type":"text","text":" "},{"type":"text","text":"protocol’s endpoint, encoded by a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder"},{"type":"text","text":" within"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit"},{"type":"text","text":", and sends no trace context in its header fields. It"},{"type":"text","text":" "},{"type":"text","text":"retries no response, a 5xx, 408 or 429, and drops and reports any other status, such as 413"},{"type":"text","text":" "},{"type":"text","text":"for a body over the collector’s limit."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every request carries "},{"type":"codeVoice","code":"SP-Anonymous: *"},{"type":"text","text":", so the collector sets no "},{"type":"codeVoice","code":"sp"},{"type":"text","text":" cookie, reads none,"},{"type":"text","text":" "},{"type":"text","text":"takes "},{"type":"codeVoice","code":"network_userid"},{"type":"text","text":" as all zeros, and records no IP address or forwarding header fields."},{"type":"text","text":" "},{"type":"text","text":"Without it the collector would set a cookie that "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" keeps and sends back, an"},{"type":"text","text":" "},{"type":"text","text":"identifier lasting across sessions (D4)."}],"type":"paragraph"},{"inlineContent":[{"text":"A collector takes events from anyone who can reach it, so the destination needs no key or","type":"text"},{"text":" ","type":"text"},{"text":"secret, and builds on every platform.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Throws","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowSetupError\/invalidCollector","type":"reference","isActive":true},{"text":" for