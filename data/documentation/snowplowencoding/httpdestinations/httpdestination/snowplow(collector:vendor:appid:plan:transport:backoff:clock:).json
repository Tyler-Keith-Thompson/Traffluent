ctor.example.com"},{"type":"text","text":"), a path included"},{"type":"text","text":" "},{"type":"text","text":"where it is served under one. Not the endpoint: the destination appends"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/com.snowplowanalytics.snowplow\/tp2"},{"type":"text","text":" itself."}]}]},{"name":"vendor","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Iglu vendor of the events’ schemas, in reverse domain notation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"com.acme"},{"type":"text","text":"): the one the tracking plan’s Iglu export is given."}]}]},{"name":"appID","content":[{"inlineContent":[{"type":"text","text":"The app’s ID, each event’s "},{"code":"aid","type":"codeVoice"},{"type":"text","text":", which tells apart the apps and sites that send"},{"type":"text","text":" "},{"type":"text","text":"to one pipeline."}],"type":"paragraph"}]},{"name":"plan","content":[{"inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}],"type":"paragraph"}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}]},{"name":"backoff","content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}]},{"name":"clock","content":[{"inlineContent":[{"type":"text","text":"The clock the waits are measured on."}],"type":"paragraph"}]}]},{"content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"inlineContent":[{"text":"The destination.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The destination posts to the collector’s "},{"type":"codeVoice","