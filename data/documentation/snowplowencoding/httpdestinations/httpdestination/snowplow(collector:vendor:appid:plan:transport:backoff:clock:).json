 ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff","kind":"typeIdentifier"},{"text":" = ExponentialBackoff(), ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":"> = ContinuousClock()) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowSetupError","preciseIdentifier":"s:16SnowplowEncoding0A10SetupErrorO","text":"SnowplowSetupError","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","preciseIdentifier":"s:16SnowplowEncoding0A12BatchEncoderV","text":"SnowplowBatchEncoder","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"collector","content":[{"inlineContent":[{"text":"The collector’s URL (","type":"text"},{"code":"https:\/\/collector.example.com","type":"codeVoice"},{"text":"), a path included","type":"text"},{"text":" ","type":"text"},{"text":"where it is served under one. Not the endpoint: the destination appends","type":"text"},{"text":" ","type":"text"},{"code":"\/com.snowplowanalytics.snowplow\/tp2","type":"codeVoice"},{"text":" itself.","type":"text"}],"type":"paragraph"}]},{"name":"vendor","content":[{"inlineContent":[{"type":"text","text":"The Iglu vendor of the events’ schemas, in reverse domain notation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"com.acme"},{"type":"text","text":"): the one the tracking plan’s Iglu export is given."}],"type":"paragraph"}]},{"name":"appID","content":[{"type":"paragraph","inlineContent":[{"text":"The app’s ID, each event’s ","type":"text"},{"code":"aid","type":"codeVoice"},{"text":", which tells apart the apps and sites that send","type":"text"},{"text":" ","type":"text"},{"text":"to one pipeline.","type":"text"}]}]},{"name":"plan","content":[{"inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}],"type":"paragraph"}]},{"name":"transport","content":[{"inlineContent":[{"type":"text","text":"What sends each request."}],"type":"paragraph"}]},{"name":"backoff","content":[{"type":"paragraph","inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, with full jitter, by default.","type":"text"}]}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}],"kind":"content"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination posts to the collector’s "},{"type":"codeVoice","code":"\/com.snowplowanalytics.snowplow\/tp2"},{"type":"text","text":", the tracker"},{"type":"text","text":" "},{"type":"text","text":"protocol’s endpoint, encoded by a "},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","isActive":true},{"type":"text","text":" within"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":", and sends no trace context in its header fields. It"},{"type":"text","text":" "},{"type":"text","text":"retries no response, a 5xx, 408 or 429, and drops and reports any other status, such as 413"},{"type":"text","text":" "},{"type":"text","text":"for a body over the collector’s limit."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every request carries "},{"type":"codeVoice","code":"SP-Anonymous: *"},{"type":"text","text":", so the collector sets no "},{"type":"codeVoice","code":"sp"},{"type":"text","text":" cookie, reads none,"},{"type":"text","text":" "},{"type":"text","text":"takes "},{"type":"codeVoice","code":"network_userid"},{"type":"text","text":" as all zeros, and records no IP address or forwarding header fields."},{"type":"text","text":" "},{"type":"text","text":"Without it the collector would set a cookie that "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" keeps and sends back, an"},{"type":"text","text":" "},{"type":"text","text":"identifier lasting across sessions (D4)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A collector takes events from anyone who can reach it, so the destination needs no key or"},{"type":"text","text":" "},{"type":"text","text":"secret, and builds on every platform."}]},{"name":"Throws","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/Snow