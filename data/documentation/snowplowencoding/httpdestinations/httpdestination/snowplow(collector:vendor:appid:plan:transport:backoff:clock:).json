:"The collector’s URL ("},{"type":"codeVoice","code":"https:\/\/collector.example.com"},{"type":"text","text":"), a path included"},{"type":"text","text":" "},{"type":"text","text":"where it is served under one. Not the endpoint: the destination appends"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/com.snowplowanalytics.snowplow\/tp2"},{"type":"text","text":" itself."}]}]},{"name":"vendor","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Iglu vendor of the events’ schemas, in reverse domain notation"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"com.acme"},{"type":"text","text":"): the one the tracking plan’s Iglu export is given."}]}]},{"name":"appID","content":[{"inlineContent":[{"type":"text","text":"The app’s ID, each event’s "},{"code":"aid","type":"codeVoice"},{"type":"text","text":", which tells apart the apps and sites that send"},{"type":"text","text":" "},{"type":"text","text":"to one pipeline."}],"type":"paragraph"}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}]}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}]},{"name":"backoff","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, by default."}]}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent"