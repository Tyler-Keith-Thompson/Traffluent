der","preciseIdentifier":"s:16SnowplowEncoding0A12BatchEncoderV"},{"kind":"text","text":">"}]}]},{"kind":"parameters","parameters":[{"name":"collector","content":[{"type":"paragraph","inlineContent":[{"text":"The collector’s URL (","type":"text"},{"type":"codeVoice","code":"https:\/\/collector.example.com"},{"text":"), a path included","type":"text"},{"text":" ","type":"text"},{"text":"where it is served under one. Not the endpoint: the destination appends","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\/com.snowplowanalytics.snowplow\/tp2"},{"text":" itself.","type":"text"}]}]},{"name":"vendor","content":[{"inlineContent":[{"text":"The Iglu vendor of the events’ schemas, in reverse domain notation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"com.acme","type":"codeVoice"},{"text":"): the one the tracking plan’s Iglu export is given.","type":"text"}],"type":"paragraph"}]},{"name":"appID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app’s ID, each event’s "},{"type":"codeVoice","code":"aid"},{"type":"text","text":", which tells apart the apps and sites that send"},{"type":"text","text":" "},{"type":"text","text":"to one pipeline."}]}]},{"name":"plan","content":[{"inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}],"type":"paragraph"}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}]},{"name":"backoff","content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"The destination.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"The destination posts to the collector’s ","type":"text"},{"type":"codeVoice","code":"\/com.snowplowanalytics.snowplow\/tp2"},{"text":", the tracker","type":"text"},{"text":" ","type":"text"},{"text":"protocol’s endpoint, encoded by a ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","type":"reference","isActive":true},{"text":" within","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":", and sends no trace context in its header fields. It","type":"text"},{"text":" ","type":"text"},{"text":"retries no response, a 5xx, 408 or 429, and drops and reports any other status, such as 413","type":"text"},{"text":" ","type":"text"},{"text":"for a body over the collector’s limit.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every request carries "},{"type":"codeVoice","code":"SP-Anonymous: *"},{"type":"text","text":", so the collector sets no "},{"type":"codeVoice","code":"sp"},{"type":"text","text":" cookie, reads none,"},{"type":"text","text":" "},{"type":"text","text":"takes "},{"type":"codeVoice","code":"network_userid"},{"type":"text","text":" as all zeros, and records no IP address or forwarding header fields."},{"type":"text","text":" "},{"type":"text","text":"Without it the collector would set a cookie that "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" keeps and sends back, an"},{"type":"text","text":" "},{"type":"text","text":"identifier lasting across sessions (D4)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A collector takes events from anyone who can reach it, so the destination needs no key or"},{"type":"text","text":" "},{"type":"text","text":"secret, and builds on every platform."}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowSetupError\/invalidCollector","isActive":true,"type":"reference"},{"text":" for a collector URL that isn’t ","type":"text"},{"code":"https","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"has no host name, has a user name or password, a query or fragment, or a path ending in","type":"text"},{"text":" ","type":"text"},{"code":"tp2","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"com.snowplowanalytics.snowplow","type":"codeVoice"},{"text":", in any case;","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowSetupError\/invalidVendor","isActive":true,"type":"reference"},{"text":" for a vendor Iglu doesn’t take; and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowSetupError\/invalidAppID","isActive":true,"type":"reference"},{"text":" for an empty app ID or one longer than 255 UTF-16","type":"text"},{"text":" ","type":"text"},{"text":"code units.","type":"text"}]}],"type":"aside"}]}],"references":{"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowSetupError/invalidVendor":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"invalidVendor"}],"abstract":[{"type":"text","text":"The vendor isn’t one Iglu takes in reverse domain notation: labels of ASCII letters,"},{"type":"text","text":" "},{"type":"text","text":"digits, "},{"type":"codeVoice","code":"-"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_"},{"type":"text","text":", joined by "},{"type":"codeVoice","code":"."},{"type":"text","text":", none of them empty ("},{"type":"codeVoice","code":"com.acme"},{"type":"text","text":"). Every event’s schema"},{"type":"text","text":" "},{"type":"text","text":"URI names it, so a collector would fail every event."}],"role":"symbol","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowSetupError\/invalidVendor","url":"\/documentation\/snowplowencoding\/snowplowsetuperror\/invalidvendor","type":"topic","kind":"symbol","title":"SnowplowSetupError.invalidVendor"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder":{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","title":"SnowplowBatchEncoder","navigatorTitle":[{"kind":"identifier","text":"SnowplowBatchEncoder"}],"type":"topic","url":"\/documentation\/snowplowencoding\/snowplowbatchencoder","abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Snowplow’s tracker protocol, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to a Snowplow collector’s "},{"type":"codeVoice","code":"POST \/com.snowplowanalytics.snowplow\/tp2"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"self-describing events whose schemas are the tracking plan’s."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}]},"doc://SnowplowEncoding/documentation/SnowplowEncoding":{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","title":"SnowplowEncoding","url":"\/documentation\/snowplowencoding","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Send records to a Snowplow collector as self-describing events, whose schemas come from the tracking plan."}],"role":"col