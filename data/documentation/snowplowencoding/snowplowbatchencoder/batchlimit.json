{"sections":[],"abstract":[{"type":"text","text":"Snowplow’s trackers’ limits on one request, 25 events and 40,000 bytes of body, and an event"},{"type":"text","text":" "},{"type":"text","text":"of up to 150,000 bytes in a request of its own."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit"},"variants":[{"paths":["\/documentation\/snowplowencoding\/snowplowbatchencoder\/batchlimit"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:16SnowplowEncoding0A12BatchEncoderV10batchLimit12PropertyJSON0cF0VvpZ","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"role":"symbol","roleHeading":"Type Property","modules":[{"name":"SnowplowEncoding"}],"symbolKind":"property","remoteSource":{"fileName":"SnowplowBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SnowplowEncoding\/SnowplowBatchEncoder.swift#L139"},"title":"batchLimit"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BatchLimit","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Snowplow’s mobile trackers send at most 25 events and 40,000 bytes in a request by default,","type":"text"},{"text":" ","type":"text"},{"text":"and an event larger than that in a request of its own. A collector refuses a body over 2 MB","type":"text"},{"text":" ","type":"text"},{"text":"with 413, and a request larger than its stream takes (192,000 bytes on SQS, 1 MB on","type":"text"},{"text":" ","type":"text"},{"text":"Kinesis, by default) becomes a failed event though the collector answers 200. So an event","type":"text"},{"text":" ","type":"text"},{"text":"of up to 150,000 bytes of JSON is sent alone, within the smallest of those, and a larger one","type":"text"},{"text":" ","type":"text"},{"text":"is left out as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError\/oversized(byteCount:)","type":"reference"},{"text":".","type":"text"}]}],"kind":"content"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"url":"\/documentation\/httpdestinations\/batchencoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":" sends.","type":"text"}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"title":"BatchEncoder","role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"topic"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/requests(for:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","text":"BatchRequests"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16SnowplowEncoding0aB5ErrorO","text":"SnowplowEncodingError"},{"kind":"text","text":">"}],"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","title":"requests(for:)","url":"\/documentation\/snowplowencoding\/snowplowbatchencoder\/requests(for:)","kind":"symbol","type":"topic","abstract":[{"code":"batch","type":"codeVoice"},{"type":"text","text":" as the tracker protocol’s requests, each within the encoder’s limit, with the"},{"type":"text","text":" "},{"type":"text","text":"records left out of them."}],"role":"symbol"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowEncodingError/oversized(byteCount:)":{"url":"\/documentation\/snowplowencoding\/snowplowencodingerror\/oversized(bytecount:)","abstract":[{"type":"text","text":"The event’s JSON is "},{"type":"codeVoice","code":"byteCount"},{"type":"text","text":" bytes, more than the encoder’s limit lets one record hold:"},{"type":"text","text":" "},{"type":"text","text":"150,000 bytes by default ("},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":"), within the smallest of a"},{"type":"text","text":" "},{"type":"text","text":"pipeline’s streams. Only "},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" leaves a record out for it."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"