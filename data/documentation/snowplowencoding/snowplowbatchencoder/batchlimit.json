 a"},{"type":"text","text":" "},{"type":"text","text":"pipeline’s streams. Only "},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" leaves a record out for it."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"url":"\/documentation\/httpdestinations\/batchencoder","type":"topic","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"text":" sends.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","role":"symbol","kind":"symbol","title":"BatchEncoder"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/requests(for:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","title":"requests(for:)","type":"topic","url":"\/documentation\/snowplowencoding\/snowplowbatchencoder\/requests(for:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"text":"<","kind":"text"},{"text":"SnowplowEncodingError","kind":"typeIdentifier","preciseIdentifier":"s:16SnowplowEncoding0aB5ErrorO"},{"text":">","kind":"text"}],"abstract":[{"type":"codeVoice","code":"batch"},{"text":" as the tracker protocol’s requests, each within the encoder’s limit, with the","type":"text"},{"text":" ","type":"text"},{"text":"records left out of them.","type":"text"}]},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/batchLimit":{"url":"\/documentation\/snowplowencoding\/snowplowbatchencoder\/batchlimit","title":"batchLimit","abstract":[{"type":"text","text":"Snowplow’s trackers’ limits on one request, 25 events and 40,000 bytes of body, and an event"},{"type":"text","text":" "},{"type":"text","text":"of up to 150,000 bytes in a request of its own."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","kind":"symbol","role":"symbol","type":"topic"},"doc://SnowplowEncoding/documentation/SnowplowEncoding":{"url":"\/documentation\/snowplowencoding","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","title":"SnowplowEncoding","role":"collection","kind":"symbol","type":"topic","abstract":[{"text":"Send records to a Snowplow collector as self-describing events, whose schemas come from the tracking plan.","type":"text"}]}}}