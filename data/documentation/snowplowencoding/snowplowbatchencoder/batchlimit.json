{"hierarchy":{"paths":[["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Snowplow’s mobile trackers send at most 25 events and 40,000 bytes in a request by default,"},{"type":"text","text":" "},{"type":"text","text":"and an event larger than that in a request of its own. A collector refuses a body over 2 MB"},{"type":"text","text":" "},{"type":"text","text":"with 413, and a request larger than its stream takes (192,000 bytes on SQS, 1 MB on"},{"type":"text","text":" "},{"type":"text","text":"Kinesis, by default) becomes a failed event though the collector answers 200. So an event"},{"type":"text","text":" "},{"type":"text","text":"of up to 150,000 bytes of JSON is sent alone, within the smallest of those, and a larger one"},{"type":"text","text":" "},{"type":"text","text":"is left out as "},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError\/oversized(byteCount:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"SnowplowEncoding"}],"symbolKind":"property","roleHeading":"Type Property","externalID":"s:16SnowplowEncoding0A12BatchEncoderV10batchLimit12PropertyJSON0cF0VvpZ","title":"batchLimit","role":"symbol","remoteSource":{"fileName":"SnowplowBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SnowplowEncoding\/SnowplowBatchEncoder.swift#L122"},"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","abstract":[{"text":"Snowplow’s trackers’ limits on one request, 25 events and 40,000 bytes of body, and an event","type":"text"},{"text":" ","type":"text"},{"text":"of up to 150,000 bytes in a request of its own.","type":"text"}],"variants":[{"paths":["\/documentation\/snowplowencoding\/snowplowbatchencoder\/batchlimit"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit"},"references":{"doc://PropertyJSON/documentation/PropertyJSON/BatchLimit":{"url":"\/documentation\/propertyjson\/batchlimit","title":"BatchLimit","abstract":[{"type":"text","text":"The most an ingestion endpoint takes in one request: how many records, how many bytes of body,"},{"type":"text","text":" "},{"type":"text","text":"and how many bytes of one record’s JSON."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchLimit"}],"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"BatchLimit"}]},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder":{"url":"\/documentation\/snowplowencoding\/snowplowbatchencoder","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","title":"SnowplowBatchEncoder","fragme