/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Snowplow’s tracker protocol, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"can send events to a Snowplow collector’s "},{"code":"POST \/com.snowplowanalytics.snowplow\/tp2","type":"codeVoice"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"self-describing events whose schemas are the tracking plan’s."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}],"type":"topic","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","navigatorTitle":[{"kind":"identifier","text":"SnowplowBatchEncoder"}],"kind":"symbol"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowEncodingError/oversized(byteCount:)":{"title":"SnowplowEncodingError.oversized(byteCount:)","kind":"symbol","url":"\/documentation\/snowplowencoding\/snowplowencodingerror\/oversized(bytecount:)","role":"symbol","abstract":[{"type":"text","text":"The event’s JSON is "},{"type":"codeVoice","code":"byteCount"},{"type":"text","text":" bytes, more than the encoder’s limit lets one record hold:"},{"type":"text","text":" "},{"type":"text","text":"150,000 bytes by default ("},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":"), within the smallest of a"},{"type":"text","text":" "},{"type":"text","text":"pipeline’s streams. Only "},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" leaves a record out for it."}],"type":"topic","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError\/oversized(byteCount:)","fragments":[{"text":"case","kind"