{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder"]]},"abstract":[{"type":"text","text":"Snowplow’s trackers’ limits on one request, 25 events and 40,000 bytes of body, and an event"},{"type":"text","text":" "},{"type":"text","text":"of up to 150,000 bytes in a request of its own."}],"variants":[{"paths":["\/documentation\/snowplowencoding\/snowplowbatchencoder\/batchlimit"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"metadata":{"modules":[{"name":"SnowplowEncoding"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SnowplowEncoding\/SnowplowBatchEncoder.swift#L139","fileName":"SnowplowBatchEncoder.swift"},"externalID":"s:16SnowplowEncoding0A12BatchEncoderV10batchLimit12PropertyJSON0cF0VvpZ","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"roleHeading":"Type Property","role":"symbol","title":"batchLimit","symbolKind":"property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Snowplow’s mobile trackers send at most 25 events and 40,000 bytes in a request by default,"},{"type":"text","text":" "},{"type":"text","text":"and an event larger than that in a request of its own. A collector refuses a body over 2 MB"},{"type":"text","text":" "},{"type":"text","text":"with 413, and a request larger than its stream takes (192,000 bytes on SQS, 1 MB on"},{"type":"text","text":" "},{"type":"text","text":"Kinesis, by default) becomes a failed event though the collector answers 200. So an event"},{"type":"text","text":" "},{"type":"text","text":"of up to 150,000 bytes of JSON is sent alone, within the smallest of those, and a larger one"},{"type":"text","text":" "},{"type":"text","text":"is left out as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError\/oversized(byteCount:)"},{"type":"text","text":"."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","interfaceLanguage":"swift"},"references":{"doc://PropertyJSON/documentation/PropertyJSON/BatchLimit":{"url":"\/documentation\/propertyjson\/batchlimit","abstract":[{"type":"text","text":"The most an ingestion endpoint takes in one request: how many records, how many bytes of body,"},{"type":"text","text":" "},{"type":"text","text":"and how many bytes of one record’s JSON."}],"type":"topic","navigatorTitle":[{"text":"BatchLimit","kind":"identifier"}],"role":"symbol","title":"BatchLimit","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchLimit","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/requests(for:)":{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","kind":"symbol","url":"\/documentation\/snowplowencoding\/snowplowbatchencoder\/requests(for:)","abstract":[{"type":"codeVoice","code":"batch"},{"type":"text","text":" as the tracker protocol’s requests, each within the encoder’s limit, with the"},{"type":"text","text":" "},{"type":"text","text":"records left out of them."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","text":"BatchRequests","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:16SnowplowEncoding0aB5ErrorO","text":"SnowplowEncodingError","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"requests(for:)","role":"symbol"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder":{"abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"type":"text","text":" of Snowplow’s tracker protocol, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to a Snowplow collector’s "},{"type":"codeVoice","code":"POST \/com.snowplowanalytics.snowplow\/tp2"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"self-describing events whose schemas are the tracking plan’s."}],"role":"symbol","navigatorTitle":[{"text":"SnowplowBatchEncoder","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/snowplowencoding\/snowplowbatchencoder","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SnowplowBatchEncoder","kind":"identifier"}],"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","title":"SnowplowBatchEncoder"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"role":"symbol","title":"BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowEncodingError/oversized(byteCount:)":{"abstract":[{"type":"text","text":"The event’s JSON is "},{"code":"byteCount","type":"codeVoice"},{"type":"text","text":" bytes, more than the encoder’s limit lets one record hold:"},{"type":"text","text":" "},{"type":"text","text":"150,000 bytes by default ("},{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","type":"reference"},{"type":"text","text":"), within the smallest of a"},{"type":"text","text":" "},{"type":"text","text":"pipeline’s streams. Only "},{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","type":"reference"},{"type":"text","text":" leaves a record out for it."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"oversized"},{"kind":"text","text":"("},{"kind":"externalParam","text":"byteCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"kind":"symbol","role":"symbol","title":"SnowplowEncodingError.oversized(byteCount:)","url":"\/documentation\/sno