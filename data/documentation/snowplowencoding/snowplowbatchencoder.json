{"metadata":{"symbolKind":"struct","roleHeading":"Structure","role":"symbol","title":"SnowplowBatchEncoder","modules":[{"name":"SnowplowEncoding"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}],"navigatorTitle":[{"text":"SnowplowBatchEncoder","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SnowplowEncoding\/SnowplowBatchEncoder.swift#L93","fileName":"SnowplowBatchEncoder.swift"},"externalID":"s:16SnowplowEncoding0A12BatchEncoderV"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"fills in the endpoint, the header field that keeps the collector from setting a cookie or","type":"text"},{"text":" ","type":"text"},{"text":"recording the request’s address, this encoder and its limits:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let snowplow = try HTTPDestination.snowplow(","    collector: collector,  \/\/ https:\/\/collector.example.com","    vendor: \"com.example\",  \/\/ your schemas' Iglu vendor","    appID: \"shop-ios\",","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"text":"The body is a self-describing JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":", of the schema","type":"text"},{"text":" ","type":"text"},{"code":"iglu:com.snowplowanalytics.snowplow\/payload_data\/jsonschema\/1-0-4","type":"codeVoice"},{"text":", whose ","type":"text"},{"code":"data","type":"codeVoice"},{"text":" is an array of","type":"text"},{"text":" ","type":"text"},{"text":"events, one per record, oldest first. Every member of an event is a string, as the tracker","type":"text"},{"text":" ","type":"text"},{"text":"protocol has them:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"aid"}]}],[{"type":"paragraph","inlineContent":[{"text":"The app ID the encoder is made with","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"co"}]}],[{"type":"paragraph","inlineContent":[{"text":"The standard context’s entities (below), as the text of a self-describing JSON array of ","type":"text"},{"type":"codeVoice","code":"contexts"},{"text":"; left out when there are none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"dtm","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ttm","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in epoch milliseconds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"e","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ue"},{"text":", a self-describing event","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"eid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"ip","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"0.0.0.0"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"p","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The platform: "},{"type":"codeVoice","code":"mob"},{"type":"text","text":" for a phone, pad, watch or Vision Pro, "},{"type":"codeVoice","code":"tv"},{"type":"text","text":" for an Apple TV, "},{"type":"codeVoice","code":"pc"},{"type":"text","text":" for a Mac, and "},{"type":"codeVoice","code":"app"},{"type":"text","text":" when the record has no device in its context"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID; left out when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"tv","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"traffluent","type":"codeVoice"},{"text":", the tracker","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"ue_pr","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event, as the text of a self-describing JSON "},{"type":"codeVoice","code":"unstruct_event"},{"type":"text","text":" holding the event’s own self-describing JSON: its schema, "},{"type":"codeVoice","code":"iglu:<vendor>\/<name>\/jsonschema\/<version>-0-0"},{"type":"text","text":", and its data, its stored properties by name"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"code":"duid","type":"codeVoice"},{"type":"text","text":", "},{"code":"uid","type":"codeVoice"},{"type":"text","text":", "},{"code":"nuid","type":"codeVoice"},{"type":"text","text":" or "},{"code":"tnuid","type":"codeVoice"},{"type":"text","text":", no"},{"type":"text","text":" "},{"code":"client_session","type":"codeVoice"},{"type":"text","text":" entity, whose "},{"code":"userId","type":"codeVoice"},{"type":"text","text":" lasts across sessions, and no "},{"code":"appleIdfv","type":"codeVoice"},{"type":"text","text":", "},{"code":"appleIdfa","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or other device identifier. Snowplow’s "},{"code":"domain_sessionid","type":"codeVoice"},{"type":"text","text":" is the session; a record with no"},{"type":"text","text":" "},{"type":"text","text":"session (one tracked by a tracker without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":", or one a store recovered after"},{"type":"text","text":" "},{"type":"text","text":"a relaunch, which keeps no context) is sent without one, linked to nothing. The record’s vendor"},{"type":"text","text":" "},{"type":"text","text":"identifier and trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event’s "},{"type":"codeVoice","code":"ttm"},{"type":"text","text":", its true timestamp, is the record’s timestamp, as is "},{"type":"codeVoice","code":"dtm"},{"type":"text","text":", so Snowplow’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"derived_tstamp"},{"type":"text","text":" is when the event was tracked, uncorrected for the device’s clock. No "},{"type":"codeVoice","code":"stm"},{"type":"text","text":" "},{"type":"text","text":"is sent: a retried request sends the same body again, so a sent time would be the first"},{"type":"text","text":" "},{"type":"text","text":"attempt’s, and Snowplow would move the event later by however long the retries took."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s schema is named after its "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Event\/schemaVersion"},{"type":"text","text":": version N is"},{"type":"text","text":" "},{"type":"text","text":"SchemaVer "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":". Each version of an event is a breaking change, a SchemaVer MODEL. A"},{"type":"text","text":" "},{"type":"text","text":"compatible change at the same version is an ADDITION, which the tracking plan’s Iglu export"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"TrackingPlan\/writeIgluRegistry(to:vendor:registry:)"},{"type":"text","text":") writes for Iglu Server as "},{"type":"codeVoice","code":"N-0-1"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"on, each superseding the ones before, so an event naming "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":" is validated against the"},{"type":"text","text":" "},{"type":"text","text":"newest of them. A static repository doesn’t supersede: there an event naming "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"validated against "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":" alone, so the export refuses an addition for one, and a change to an"},{"type":"text","text":" "},{"type":"text","text":"event needs a new version."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"data then validates against the event’s exported schema, which never requires a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"text","text":"property."}]},{"type":"paragraph","inlineContent":[{"code":"co","type":"codeVoice"},{"type":"text","text":" holds these entities, for the keys the record’s context has values for:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Entity"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Keys","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/mobile_context\/jsonschema\/1-0-3"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OperatingSystemKey"},{"type":"text","text":", both; "},{"type":"codeVoice","code":"NetworkKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":" if present"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"osType"},{"type":"text","text":" ("},{"type":"codeVoice","code":"ios"},{"type":"text","text":", "},{"type":"codeVoice","code":"tvos"},{"type":"text","text":", "},{"type":"codeVoice","code":"watchos"},{"type":"text","text":", "},{"type":"codeVoice","code":"visionos"},{"type":"text","text":", "},{"type":"codeVoice","code":"osx"},{"type":"text","text":"), "},{"type":"codeVoice","code":"osVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"deviceManufacturer"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Apple Inc."},{"type":"text","text":"), "},{"type":"codeVoice","code":"deviceModel"},{"type":"text","text":"; "},{"type":"codeVoice","code":"networkType"},{"type":"text","text":" ("},{"type":"codeVoice","code":"wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"mobile"},{"type":"text","text":", "},{"type":"codeVoice","code":"offline"},{"type":"text","text":"; left out for a wired or other connection); "},{"type":"codeVoice","code":"language"},{"type":"text","text":", the locale’s language code"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.mobile\/application\/jsonschema\/1-0-0"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"},{"text":", with both a version and a build","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"version","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"build","type":"codeVoice"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event name Iglu doesn’t"},{"type":"text","text":" "},{"type":"text","text":"take, one whose event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp"},{"type":"text","text":" "},{"type":"text","text":"is outside the years 0 to 9999, and one whose JSON is over 150,000 bytes"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","type":"reference"},{"type":"text","text":")."},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","type":"reference"},{"type":"text","text":" returns them as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","isActive":true},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","isActive":true},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. The collector answers 200 to every request it can read, and Snowplow validates","type":"text"},{"text":" ","type":"text"},{"text":"the events afterwards: an event whose data its schema rejects, or whose schema the pipeline’s","type":"text"},{"text":" ","type":"text"},{"text":"Iglu resolver can’t find, becomes a failed event, kept apart from the warehouse, though the","type":"text"},{"text":" ","type":"text"},{"text":"destination counts it as delivered. The bytes are the same for the same records on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"topicSections":[{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/init(vendor:appID:plan:limit:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)"],"title":"Instance Methods","anchor":"Instance-Methods","gener