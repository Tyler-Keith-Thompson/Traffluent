{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder"},"metadata":{"modules":[{"name":"SnowplowEncoding"}],"externalID":"s:16SnowplowEncoding0A12BatchEncoderV","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SnowplowEncoding\/SnowplowBatchEncoder.swift#L93","fileName":"SnowplowBatchEncoder.swift"},"title":"SnowplowBatchEncoder","navigatorTitle":[{"kind":"identifier","text":"SnowplowBatchEncoder"}],"symbolKind":"struct","role":"symbol"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:backoff:clock:)"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"fills in the endpoint, the header field that keeps the collector from setting a cookie or","type":"text"},{"text":" ","type":"text"},{"text":"recording the request’s address, this encoder and its limits:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let snowplow = try HTTPDestination.snowplow(","    collector: collector,  \/\/ https:\/\/collector.example.com","    vendor: \"com.example\",  \/\/ your schemas' Iglu vendor","    appID: \"shop-ios\",","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a self-describing JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":", of the schema"},{"type":"text","text":" "},{"code":"iglu:com.snowplowanalytics.snowplow\/payload_data\/jsonschema\/1-0-4","type":"codeVoice"},{"type":"text","text":", whose "},{"code":"data","type":"codeVoice"},{"type":"text","text":" is an array of"},{"type":"text","text":" "},{"type":"text","text":"events, one per record, oldest first. Every member of an event is a string, as the tracker"},{"type":"text","text":" "},{"type":"text","text":"protocol has them:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"aid"}]}],[{"type":"paragraph","inlineContent":[{"text":"The app ID the encoder is made with","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"co","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context’s entities (below), as the text of a self-describing JSON array of "},{"type":"codeVoice","code":"contexts"},{"type":"text","text":"; left out when there are none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dtm"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ttm"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in epoch milliseconds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"e","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ue","type":"codeVoice"},{"type":"text","text":", a self-describing event"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"eid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ip"}]}],[{"type":"paragraph","inlineContent":[{"code":"0.0.0.0","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"p","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The platform: ","type":"text"},{"code":"mob","type":"codeVoice"},{"text":" for a phone, pad, watch or Vision Pro, ","type":"text"},{"code":"tv","type":"codeVoice"},{"text":" for an Apple TV, ","type":"text"},{"code":"pc","type":"codeVoice"},{"text":" for a Mac, and ","type":"text"},{"code":"app","type":"codeVoice"},{"text":" when the record has no device in its context","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID; left out when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"tv"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"traffluent"},{"text":", the tracker","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ue_pr"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event, as the text of a self-describing JSON "},{"type":"codeVoice","code":"unstruct_event"},{"type":"text","text":" holding the event’s own self-describing JSON: its schema, "},{"type":"codeVoice","code":"iglu:<vendor>\/<name>\/jsonschema\/<version>-0-0"},{"type":"text","text":", and its data, its stored properties by name"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"duid"},{"type":"text","text":", "},{"type":"codeVoice","code":"uid"},{"type":"text","text":", "},{"type":"codeVoice","code":"nuid"},{"type":"text","text":" or "},{"type":"codeVoice","code":"tnuid"},{"type":"text","text":", no"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_session"},{"type":"text","text":" entity, whose "},{"type":"codeVoice","code":"userId"},{"type":"text","text":" lasts across sessions, and no "},{"type":"codeVoice","code":"appleIdfv"},{"type":"text","text":", "},{"type":"codeVoice","code":"appleIdfa"},{"type":"text","text":" "},{"type":"text","text":"or other device identifier. Snowplow’s "},{"type":"codeVoice","code":"domain_sessionid"},{"type":"text","text":" is the session; a record with no"},{"type":"text","text":" "},{"type":"text","text":"session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":", or one a store recovered after"},{"type":"text","text":" "},{"type":"text","text":"a relaunch, which keeps no context) is sent without one, linked to nothing. The record’s vendor"},{"type":"text","text":" "},{"type":"text","text":"identifier and trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event’s "},{"type":"codeVoice","code":"ttm"},{"type":"text","text":", its true timestamp, is the record’s timestamp, as is "},{"type":"codeVoice","code":"dtm"},{"type":"text","text":", so Snowplow’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"derived_tstamp"},{"type":"text","text":" is when the event was tracked, uncorrected for the device’s clock. No "},{"type":"codeVoice","code":"stm"},{"type":"text","text":" "},{"type":"text","text":"is sent: a retried request sends the same body again, so a sent time would be the first"},{"type":"text","text":" "},{"type":"text","text":"attempt’s, and Snowplow would move the event later by however long the retries took."}]},{"type":"paragraph","inlineContent":[{"text":"The event’s schema is named after its ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Event\/schemaVersion","type":"codeVoice"},{"text":": version N is","type":"text"},{"text":" ","type":"text"},{"text":"SchemaVer ","type":"text"},{"code":"N-0-0","type":"codeVoice"},{"text":". Each version of an event is a breaking change, a SchemaVer MODEL. A","type":"text"},{"text":" ","type":"text"},{"text":"compatible change at the same version is an ADDITION, which the tracking plan’s Iglu export","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"TrackingPlan\/writeIgluRegistry(to:vendor:registry:)","type":"codeVoice"},{"text":") writes for Iglu Server as ","type":"text"},{"code":"N-0-1","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"on, each superseding the ones before, so an event naming ","type":"text"},{"code":"N-0-0","type":"codeVoice"},{"text":" is validated against the","type":"text"},{"text":" ","type":"text"},{"text":"newest of them. A static repository doesn’t supersede: there an event naming ","type":"text"},{"code":"N-0-0","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"validated against ","type":"text"},{"code":"N-0-0","type":"codeVoice"},{"text":" alone, so the export refuses an addition for one, and a change to an","type":"text"},{"text":" ","type":"text"},{"text":"event needs a new version.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"data then validates against the event’s exported schema, which never requires a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"text","text":"property."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"co"},{"type":"text","text":" holds these entities, for the keys the record’s context has values for:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Entity"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Keys","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/mobile_context\/jsonschema\/1-0-3"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OperatingSystemKey"},{"type":"text","text":", both; "},{"type":"codeVoice","code":"NetworkKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":" if present"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"osType"},{"type":"text","text":" ("},{"type":"codeVoice","code":"ios"},{"type":"text","text":", "},{"type":"codeVoice","code":"tvos"},{"type":"text","text":", "},{"type":"codeVoice","code":"watchos"},{"type":"text","text":", "},{"type":"codeVoice","code":"visionos"},{"type":"text","text":", "},{"type":"codeVoice","code":"osx"},{"type":"text","text":"), "},{"type":"codeVoice","code":"osVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"deviceManufacturer"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Apple Inc."},{"type":"text","text":"), "},{"type":"codeVoice","code":"deviceModel"},{"type":"text","text":"; "},{"type":"codeVoice","code":"networkType"},{"type":"text","text":" ("},{"type":"codeVoice","code":"wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"mobile"},{"type":"text","text":", "},{"type":"codeVoice","code":"offline"},{"type":"text","text":"; left out for a wired or other connection); "},{"type":"codeVoice","code":"language"},{"type":"text","text":", the locale’s language code"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.mobile\/application\/jsonschema\/1-0-0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"},{"text":", with both a version and a build","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"version"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"build"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name Iglu doesn’t"},{"type":"text","text":" "},{"type":"text","text":"take, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp"},{"type":"text","text":" "},{"type":"text","text":"is outside the years 0 to 9999, and one whose JSON is over 150,000 bytes"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)"},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. The collector answers 200 to every request it can read, and Snowplow validates","type":"text"},{"text":" ","type":"text"},{"text":"the events afterwards: an event whose data its schema rejects, or whose schema the pipeline’s","type":"text"},{"text":" ","type":"text"},{"text":"Iglu resolver can’t find, becomes a failed event, kept apart from the warehouse, though the","type":"text"},{"text":" ","type":"text"},{"text":"destination counts it as delivered. The bytes are the same for the same records on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}]}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Snowplow’s tracker protocol, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to a Snowplow collector’s "},{"type":"codeVoice","code":"POST \/com.snowplowanalytics.snowplow\/tp2"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"self-describing events whose schemas are the tracking plan’s."}],"variants":[{"paths":["\/documentation\/snowplowencoding\/snowplowbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding"]]},"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/SnowplowEncoding\/s8SendableP","doc:\/\/SnowplowEncoding\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"topicSections":[{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/init(vendor:appID:plan:limit:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/Failure"],"generated":true,"anchor":"Type-Aliases","title":"Type Aliases"},{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit"],"generated":true,"anchor":"Type-Properties","title":"Type Properties"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"kind":"symbol","url":"\/documentation\/httpdestinations\/httpdestination","abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination",