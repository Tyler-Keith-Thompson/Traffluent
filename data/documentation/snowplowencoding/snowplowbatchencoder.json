rrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"role":"symbol","kind":"symbol","title":"Sensitive","type":"topic","url":"\/documentation\/events\/sensitive","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"navigatorTitle":[{"kind":"identifier","text":"Sensitive"}]},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/batchLimit":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"kind":"symbol","abstract":[{"text":"Snowplow’s trackers’ limits on one request, 25 events and 40,000 bytes of body, and an event","type":"text"},{"text":" ","type":"text"},{"text":"of up to 150,000 bytes in a request of its own.","type":"text"}],"title":"batchLimit","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","type":"topic","url":"\/documentation\/snowplowencoding\/snowplowbatchencoder\/batchlimit","role":"symbol"},"doc://SnowplowEncoding/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/SnowplowEncoding\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://SnowplowEncoding/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/SnowplowEncoding\/s8SendableP"},"doc://SnowplowEncoding/documentation/SnowplowEncoding":{"kind":"symbol","abstract":[{"text":"Send records to a Snowplow collector as self-describing events, whose schemas come from the tracking plan.","type":"text"}],"title":"SnowplowEncoding","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","type":"topic","url":"\/doc