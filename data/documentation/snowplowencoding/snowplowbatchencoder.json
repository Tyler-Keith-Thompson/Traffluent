rotocol, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"can send events to a Snowplow collector’s ","type":"text"},{"code":"POST \/com.snowplowanalytics.snowplow\/tp2","type":"codeVoice"},{"text":", as","type":"text"},{"text":" ","type":"text"},{"text":"self-describing events whose schemas are the tracking plan’s.","type":"text"}]},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/requests(for:)":{"kind":"symbol","role":"symbol","abstract":[{"type":"codeVoice","code":"batch"},{"type":"text","text":" as the tracker protocol’s requests, each within the encoder’s limit, with the"},{"type":"text","text":" "},{"type":"text","text":"records left out of them."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","text":"BatchRequests","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"SnowplowEncodingError","preciseIdentifier":"s:16SnowplowEncoding0aB5ErrorO"},{"kind":"text","text":">"}],"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","title":"requests(for:)","url":"\/documentation\/snowplowencoding\/snowplowbatchencoder\/requests(for:)","type":"topic"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/Failure":{"kind":"symbol","role":"symbol","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEnco