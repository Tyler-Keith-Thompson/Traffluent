{"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/SnowplowEncoding\/s8SendableP","doc:\/\/SnowplowEncoding\/s16SendableMetatypeP"],"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SnowplowBatchEncoder","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"fills in the endpoint, the header field that keeps the collector from setting a cookie or","type":"text"},{"text":" ","type":"text"},{"text":"recording the request’s address, this encoder and its limits:","type":"text"}]},{"type":"codeListing","code":["let snowplow = try HTTPDestination.snowplow(","    collector: collector,  \/\/ https:\/\/collector.example.com","    vendor: \"com.example\",  \/\/ your schemas' Iglu vendor","    appID: \"shop-ios\",","    plan: plan)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The body is a self-describing JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":", of the schema","type":"text"},{"text":" ","type":"text"},{"code":"iglu:com.snowplowanalytics.snowplow\/payload_data\/jsonschema\/1-0-4","type":"codeVoice"},{"text":", whose ","type":"text"},{"code":"data","type":"codeVoice"},{"text":" is an array of","type":"text"},{"text":" ","type":"text"},{"text":"events, one per record, oldest first. Every member of an event is a string, as the tracker","type":"text"},{"text":" ","type":"text"},{"text":"protocol has them:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"aid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app ID the encoder is made with"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"co"}]}],[{"type":"paragraph","inlineContent":[{"text":"The standard context’s entities (below), as the text of a self-describing JSON array of ","type":"text"},{"code":"contexts","type":"codeVoice"},{"text":"; left out when there are none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"dtm","type":"codeVoice"},{"type":"text","text":", "},{"code":"ttm","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in epoch milliseconds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"e"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ue"},{"type":"text","text":", a self-describing event"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"eid"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"ip","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"0.0.0.0"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"p"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The platform: "},{"type":"codeVoice","code":"mob"},{"type":"text","text":" for a phone, pad, watch or Vision Pro, "},{"type":"codeVoice","code":"tv"},{"type":"text","text":" for an Apple TV, "},{"type":"codeVoice","code":"pc"},{"type":"text","text":" for a Mac, and "},{"type":"codeVoice","code":"app"},{"type":"text","text":" when the record has no device in its context"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", as a lowercase UUID; left out when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"tv"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"traffluent"},{"type":"text","text":", the tracker"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"ue_pr","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event, as the text of a self-describing JSON "},{"type":"codeVoice","code":"unstruct_event"},{"type":"text","text":" holding the event’s own self-describing JSON: its schema, "},{"type":"codeVoice","code":"iglu:<vendor>\/<name>\/jsonschema\/<version>-0-0"},{"type":"text","text":", and its data, its stored properties by name"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"type":"codeVoice","code":"duid"},{"text":", ","type":"text"},{"type":"codeVoice","code":"uid"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nuid"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"tnuid"},{"text":", no","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"client_session"},{"text":" entity, whose ","type":"text"},{"type":"codeVoice","code":"userId"},{"text":" lasts across sessions, and no ","type":"text"},{"type":"codeVoice","code":"appleIdfv"},{"text":", ","type":"text"},{"type":"codeVoice","code":"appleIdfa"},{"text":" ","type":"text"},{"text":"or other device identifier. Snowplow’s ","type":"text"},{"type":"codeVoice","code":"domain_sessionid"},{"text":" is the session; a record with no","type":"text"},{"text":" ","type":"text"},{"text":"session (one tracked by a tracker without ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":") is sent without one, linked to","type":"text"},{"text":" ","type":"text"},{"text":"nothing. A record a store recovers after a relaunch keeps its session, so it goes out with the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"sid"},{"text":" of its first send. The record’s vendor","type":"text"},{"text":" ","type":"text"},{"text":"identifier and trace context, and any other context value, aren’t sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event’s "},{"type":"codeVoice","code":"ttm"},{"type":"text","text":", its true timestamp, is the record’s timestamp, as is "},{"type":"codeVoice","code":"dtm"},{"type":"text","text":", so Snowplow’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"derived_tstamp"},{"type":"text","text":" is when the event was tracked, uncorrected for the device’s clock. No "},{"type":"codeVoice","code":"stm"},{"type":"text","text":" "},{"type":"text","text":"is sent: a retried request sends the same body again, so a sent time would be the first"},{"type":"text","text":" "},{"type":"text","text":"attempt’s, and Snowplow would move the event later by however long the retries took."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s schema is named after its "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Event\/schemaVersion"},{"type":"text","text":": version N is"},{"type":"text","text":" "},{"type":"text","text":"SchemaVer "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":". Each version of an event is a breaking change, a SchemaVer MODEL. A"},{"type":"text","text":" "},{"type":"text","text":"compatible change at the same version is an ADDITION, which the tracking plan’s Iglu export"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"TrackingPlan\/writeIgluRegistry(to:vendor:registry:)"},{"type":"text","text":") writes for Iglu Server as "},{"type":"codeVoice","code":"N-0-1"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"on, each superseding the ones before, so an event naming "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":" is validated against the"},{"type":"text","text":" "},{"type":"text","text":"newest of them. A static repository doesn’t supersede: there an event naming "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"validated against "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":" alone, so the export refuses an addition for one, and a change to an"},{"type":"text","text":" "},{"type":"text","text":"event needs a new version."}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"data then validates against the event’s exported schema, which never requires a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"co","type":"codeVoice"},{"text":" holds these entities, for the keys the record’s context has values for:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Entity","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/mobile_context\/jsonschema\/1-0-3"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OperatingSystemKey"},{"type":"text","text":", both; "},{"type":"codeVoice","code":"NetworkKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":" if present"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"osType"},{"text":" (","type":"text"},{"type":"codeVoice","code":"ios"},{"text":", ","type":"text"},{"type":"codeVoice","code":"tvos"},{"text":", ","type":"text"},{"type":"codeVoice","code":"watchos"},{"text":", ","type":"text"},{"type":"codeVoice","code":"visionos"},{"text":", ","type":"text"},{"type":"codeVoice","code":"osx"},{"text":"), ","type":"text"},{"type":"codeVoice","code":"osVersion"},{"text":", ","type":"text"},{"type":"codeVoice","code":"deviceManufacturer"},{"text":" (","type":"text"},{"type":"codeVoice","code":"Apple Inc."},{"text":"), ","type":"text"},{"type":"codeVoice","code":"deviceModel"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"networkType"},{"text":" (","type":"text"},{"type":"codeVoice","code":"wifi"},{"text":", ","type":"text"},{"type":"codeVoice","code":"mobile"},{"text":", ","type":"text"},{"type":"codeVoice","code":"offline"},{"text":"; left out for a wired or other connection); ","type":"text"},{"type":"codeVoice","code":"language"},{"text":", the locale’s language code","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.mobile\/application\/jsonschema\/1-0-0"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"},{"type":"text","text":", with both a version and a build"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"version"},{"type":"text","text":" and "},{"type":"codeVoice","code":"build"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name Iglu doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"take, one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp","type":"text"},{"text":" ","type":"text"},{"text":"is outside the years 0 to 9999, and one whose JSON is over 150,000 bytes","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/request