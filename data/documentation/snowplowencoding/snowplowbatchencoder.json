ext"}],"type":"paragraph"},{"code":["let snowplow = try HTTPDestination.snowplow(","    collector: collector,  \/\/ https:\/\/collector.example.com","    vendor: \"com.example\",  \/\/ your schemas' Iglu vendor","    appID: \"shop-ios\",","    plan: plan)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The body is a self-describing JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":", of the schema"},{"type":"text","text":" "},{"code":"iglu:com.snowplowanalytics.snowplow\/payload_data\/jsonschema\/1-0-4","type":"codeVoice"},{"type":"text","text":", whose "},{"code":"data","type":"codeVoice"},{"type":"text","text":" is an array of"},{"type":"text","text":" "},{"type":"text","text":"events, one per record, oldest first. Every member of an event is a string, as the tracker"},{"type":"text","text":" "},{"type":"text","text":"protocol has them:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"aid"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app ID the encoder is made with"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"co"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context’s entities (below), as the text of a self-describing JSON array of "},{"type":"codeVoice","code":"contexts"},{"type":"text","text":"; left out when there are none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dtm"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ttm"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in epoch milliseconds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"e"}]}],[{"type":"paragraph","inlineContent":[{"code":"ue","type":"codeVoice"},{"type":"text","text":", a self-describing event"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"eid"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ip"}]}],[{"type":"paragraph","inlineContent":[{"code":"0.0.0.0","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"p"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The platform: "},{"type":"codeVoice","code":"mob"},{"type":"text","text":" for a phone, pad, watch or Vision Pro, "},{"type":"codeVoice","code":"tv"},{"type":"text","text":" for an Apple TV, "},{"type":"codeVoice","code":"pc"},{"type":"text","text":" for a Mac, and "},{"type":"codeVoice","code":"app"},{"type":"text","text":" when the record has no device in its context"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sid"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID; left out when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"tv","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"traffluent"},{"text":", the tracker","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ue_pr"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event, as the text of a self-describing JSON "},{"type":"codeVoice","code":"unstruct_event"},{"type":"text","text":" holding the event’s own self-describing JSON: its schema, "},{"type":"codeVoice","code":"iglu:<vendor>\/<name>\/jsonschema\/<version>-0-0"},{"type":"text","text":", and its data, its stored properties by name"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"code":"duid","type":"codeVoice"},{"type":"text","text":", "},{"code":"uid","type":"codeVoice"},{"type":"text","text":", "},{"code":"nuid","type":"codeVoice"},{"type":"text","text":" or "},{"code":"tnuid","type":"codeVoice"},{"type":"text","text":", no"},{"type":"text","text":" "},{"code":"client_session","type":"codeVoice"},{"type":"text","text":" entity, whose "},{"code":"userId","type":"codeVoice"},{"type":"text","text":" lasts across sessions, and no "},{"code":"appleIdfv","type":"codeVoice"},{"type":"text","text":", "},{"code":"appleIdfa","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or other device identifier. Snowplow’s "},{"code":"domain_sessionid","type":"codeVoice"},{"type":"text","text":" is the session; a record with no"},{"type":"text","text":" "},{"type":"text","text":"session (one tracked by a tracker without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":", or one a store recovered after"},{"type":"text","text":" "},{"type":"text","text":"a relaunch, which keeps no context) is sent without one, linked to nothing. The record’s vendor"},{"type":"text","text":" "},{"type":"text","text":"identifier and trace context, and any other context value, aren’t sent."}],"type":"paragraph"},{"inlineContent":[{"text":"Each event’s ","type":"text"},{"code":"ttm","type":"codeVoice"},{"text":", its true timestamp, is the record’s timestamp, as is ","type":"text"},{"code":"dtm","type":"codeVoice"},{"text":", so Snowplow’s","type":"text"},{"text":" ","type":"text"},{"code":"derived_tstamp","type":"codeVoice"},{"text":" is when the event was tracked, uncorrected for the device’s clock. No ","type":"text"},{"code":"stm","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is sent: a retried request sends the same body again, so a sent time would be the first","type":"text"},{"text":" ","type":"text"},{"text":"attempt’s, and Snowplow would move the event later by however long the retries took.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The event’s schema is named after its ","type":"text"},{"type":"codeVoice","code":"Event\/name"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Event\/schemaVersion"},{"text":": version N is","type":"text"},{"text":" ","type":"text"},{"text":"SchemaVer ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":". Each version of an event is a breaking change, a SchemaVer MODEL. A","type":"text"},{"text":" ","type":"text"},{"text":"compatible change at the same version is an ADDITION, which the tracking plan’s Iglu export","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"TrackingPlan\/writeIgluRegistry(to:vendor:registry:)"},{"text":") writes for Iglu Server as ","type":"text"},{"type":"codeVoice","code":"N-0-1"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"on, each superseding the ones before, so an event naming ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":" is validated against the","type":"text"},{"text":" ","type":"text"},{"text":"newest of them. A static repository doesn’t supersede: there an event naming ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"validated against ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":" alone, so the export refuses an addition for one, and a change to an","type":"text"},{"text":" ","type":"text"},{"text":"event needs a new version.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":", as ","type":"text"},{"type":"codeVoice","code":"PropertyReader"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"data then validates against the event’s exported schema, which never requires a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" ","type":"text"},{"text":"property.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"co","type":"codeVoice"},{"text":" holds these entities, for the keys the record’s context has values for:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Entity","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keys","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"iglu:com.snowplowanalytics.snowplow\/mobile_context\/jsonschema\/1-0-3","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"OperatingSystemKey"},{"text":", both; ","type":"text"},{"type":"codeVoice","code":"NetworkKey"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"LocaleKey"},{"text":" if present","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"osType"},{"type":"text","text":" ("},{"type":"codeVoice","code":"ios"},{"type":"text","text":", "},{"type":"codeVoice","code":"tvos"},{"type":"text","text":", "},{"type":"codeVoice","code":"watchos"},{"type":"text","text":", "},{"type":"codeVoice","code":"visionos"},{"type":"text","text":", "},{"type":"codeVoice","code":"osx"},{"type":"text","text":"), "},{"type":"codeVoice","code":"osVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"deviceManufacturer"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Apple Inc."},{"type":"text","text":"), "},{"type":"codeVoice","code":"deviceModel"},{"type":"text","text":"; "},{"type":"codeVoice","code":"networkType"},{"type":"text","text":" ("},{"type":"codeVoice","code":"wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"mobile"},{"type":"text","text":", "},{"type":"codeVoice","code":"offline"},{"type":"text","text":"; left out for a wired or other connection); "},{"type":"codeVoice","code":"language"},{"type":"text","text":", the locale’s language code"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"iglu:com.snowplowanalytics.mobile\/application\/jsonschema\/1-0-0","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"},{"type":"text","text":", with both a version and a build"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"version"},{"type":"text","text":" and "},{"type":"codeVoice","code":"build"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event name Iglu doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"take, one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds a value JSON can’t, one whose timestamp","type":"text"},{"text":" ","type":"text"},{"text":"is outside the years 0 to 9999, and one whose JSON is over 150,000 bytes","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","isActive":true},{"text":").","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","isActive":true},{"text":" returns them as ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. The collector answers 200 to every request it can read, and Snowplow validates","type":"text"},{"text":" ","type":"text"},{"text":"the events afterwards: an event whose data its schema rejects, or whose schema the pipeline’s","type":"text"},{"text":" ","type":"text"},{"text":"Iglu resolver can’t find, becomes a failed event, kept apart from the warehouse, though the","type":"text"},{"text":" ","type":"text"},{"text":"destination counts it as delivered. The bytes are the same for the same records on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder",