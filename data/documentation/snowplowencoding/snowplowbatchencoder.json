{"kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Snowplow’s tracker protocol, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to a Snowplow collector’s "},{"type":"codeVoice","code":"POST \/com.snowplowanalytics.snowplow\/tp2"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"self-describing events whose schemas are the tracking plan’s."}],"topicSections":[{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/init(vendor:appID:plan:limit:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/Failure"],"generated":true,"title":"Type Aliases","anchor":"Type-Aliases"},{"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit"],"generated":true,"title":"Type Properties","anchor":"Type-Properties"}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:backoff:clock:)"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"fills in the endpoint, the header field that keeps the collector from setting a cookie or","type":"text"},{"text":" ","type":"text"},{"text":"recording the request’s address, this encoder and its limits:","type":"text"}],"type":"paragraph"},{"code":["let snowplow = try HTTPDestination.snowplow(","    collector: collector,  \/\/ https:\/\/collector.example.com","    vendor: \"com.example\",  \/\/ your schemas' Iglu vendor","    appID: \"shop-ios\",","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The body is a self-describing JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", of the schema"},{"type":"text","text":" "},{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/payload_data\/jsonschema\/1-0-4"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"data"},{"type":"text","text":" is an array of"},{"type":"text","text":" "},{"type":"text","text":"events, one per record, oldest first. Every member of an event is a string, as the tracker"},{"type":"text","text":" "},{"type":"text","text":"protocol has them:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"aid","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The app ID the encoder is made with"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"co"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The standard context’s entities (below), as the text of a self-describing JSON array of ","type":"text"},{"code":"contexts","type":"codeVoice"},{"text":"; left out when there are none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"dtm","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ttm","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in epoch milliseconds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"e","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ue","type":"codeVoice"},{"text":", a self-describing event","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"eid","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID; a redelivered record keeps it"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"ip","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"0.0.0.0"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"p"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The platform: "},{"code":"mob","type":"codeVoice"},{"type":"text","text":" for a phone, pad, watch or Vision Pro, "},{"code":"tv","type":"codeVoice"},{"type":"text","text":" for an Apple TV, "},{"code":"pc","type":"codeVoice"},{"type":"text","text":" for a Mac, and "},{"code":"app","type":"codeVoice"},{"type":"text","text":" when the record has no device in its context"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"sid","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, its ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", as a lowercase UUID; left out when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"tv"}],"type":"paragraph"}],[{"inlineContent":[{"code":"traffluent","type":"codeVoice"},{"text":", the tracker","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ue_pr"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event, as the text of a self-describing JSON "},{"type":"codeVoice","code":"unstruct_event"},{"type":"text","text":" holding the event’s own self-describing JSON: its schema, "},{"type":"codeVoice","code":"iglu:<vendor>\/<name>\/jsonschema\/<version>-0-0"},{"type":"text","text":", and its data, its stored properties by name"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"code":"duid","type":"codeVoice"},{"text":", ","type":"text"},{"code":"uid","type":"codeVoice"},{"text":", ","type":"text"},{"code":"nuid","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"tnuid","type":"codeVoice"},{"text":", no","type":"text"},{"text":" ","type":"text"},{"code":"client_session","type":"codeVoice"},{"text":" entity, whose ","type":"text"},{"code":"userId","type":"codeVoice"},{"text":" lasts across sessions, and no ","type":"text"},{"code":"appleIdfv","type":"codeVoice"},{"text":", ","type":"text"},{"code":"appleIdfa","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or other device identifier. Snowplow’s ","type":"text"},{"code":"domain_sessionid","type":"codeVoice"},{"text":" is the session; a record with no","type":"text"},{"text":" ","type":"text"},{"text":"session (one tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":", or one a store recovered after","type":"text"},{"text":" ","type":"text"},{"text":"a relaunch, which keeps no context) is sent without one, linked to nothing. The record’s vendor","type":"text"},{"text":" ","type":"text"},{"text":"identifier and trace context, and any other context value, aren’t sent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each event’s "},{"code":"ttm","type":"codeVoice"},{"type":"text","text":", its true timestamp, is the record’s timestamp, as is "},{"code":"dtm","type":"codeVoice"},{"type":"text","text":", so Snowplow’s"},{"type":"text","text":" "},{"code":"derived_tstamp","type":"codeVoice"},{"type":"text","text":" is when the event was tracked, uncorrected for the device’s clock. No "},{"code":"stm","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is sent: a retried request sends the same body again, so a sent time would be the first"},{"type":"text","text":" "},{"type":"text","text":"attempt’s, and Snowplow would move the event later by however long the retries took."}],"type":"paragraph"},{"inlineContent":[{"text":"The event’s schema is named after its ","type":"text"},{"type":"codeVoice","code":"Event\/name"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Event\/schemaVersion"},{"text":": version N is","type":"text"},{"text":" ","type":"text"},{"text":"SchemaVer ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":". Each version of an event is a breaking change, a SchemaVer MODEL. A","type":"text"},{"text":" ","type":"text"},{"text":"compatible change at the same version is an ADDITION, which the tracking plan’s Iglu export","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"TrackingPlan\/writeIgluRegistry(to:vendor:registry:)"},{"text":") writes for Iglu Server as ","type":"text"},{"type":"codeVoice","code":"N-0-1"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"on, each superseding the ones before, so an event naming ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":" is validated against the","type":"text"},{"text":" ","type":"text"},{"text":"newest of them. A static repository doesn’t supersede: there an event naming ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"validated against ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":" alone, so the export refuses an addition for one, and a change to an","type":"text"},{"text":" ","type":"text"},{"text":"event needs a new version.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"data then validates against the event’s exported schema, which never requires a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"text","text":"property."}],"type":"paragraph"},{"inlineContent":[{"code":"co","type":"codeVoice"},{"text":" holds these entities, for the keys the record’s context has values for:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Entity"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keys","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/mobile_context\/jsonschema\/1-0-3"}]}],[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"OperatingSystemKey","type":"codeVoice"},{"text":", both; ","type":"text"},{"code":"NetworkKey","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"LocaleKey","type":"codeVoice"},{"text":" if present","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"osType","type":"codeVoice"},{"text":" (","type":"text"},{"code":"ios","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tvos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"watchos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"visionos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"osx","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"osVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"deviceManufacturer","type":"codeVoice"},{"text":" (","type":"text"},{"code":"Apple Inc.","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"deviceModel","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"networkType","type":"codeVoice"},{"text":" (","type":"text"},{"code":"wifi","type":"codeVoice"},{"text":", ","type":"text"},{"code":"mobile","type":"codeVoice"},{"text":", ","type":"text"},{"code":"offline","type":"codeVoice"},{"text":"; left out for a wired or other connection); ","type":"text"},{"code":"language","type":"codeVoice"},{"text":", the locale’s language code","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.mobile\/application\/jsonschema\/1-0-0"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"},{"text":", with both a version and a build","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"version"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"build"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name Iglu doesn’t"},{"type":"text","text":" "},{"type":"text","text":"take, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp"},{"type":"text","text":" "},{"type":"text","text":"is outside the years 0 to 9999, and one whose JSON is over 150,000 bytes"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. The collector answers 200 to every request it can read, and Snowplow validates"},{"type":"text","text":" "},{"type":"text","text":"the events afterwards: an event whose data its schema rejects, or whose schema the pipeline’s"},{"type":"text","text":" "},{"type":"text","text":"Iglu resolver can’t find, becomes a failed event, kept apart from the warehouse, though the"},{"type":"text","text":" "},{"type":"text","text":"destination counts it as delivered. The bytes are the same for the same records on every run"},{"type":"text","text":" "},{"type":"text","text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/snowplowencoding\/snowplowbatchencoder"]}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}],"role":"symbol","navigatorTitle":[{"text":"SnowplowBatchEncoder","kind":"identifier"}],"roleHeading":"Structure","symbolKind":"struct","remoteSource":{"fileName":"SnowplowBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SnowplowEncoding\/SnowplowBatchEncoder.swift#L93"},"title":"SnowplowBatchEncoder","modules":[{"name":"SnowplowEncoding"}],"externalID":"s:16SnowplowEncoding0A12BatchEncoderV"},"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/SnowplowEncoding\/s8SendableP","doc:\/\/SnowplowEncoding\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/init(vendor:appID:plan:limit:)":{"kind":"symbol","abstract":[{"type":"text","text":"An encoder of the events "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, whose schemas are under "},{"type":"codeVoice","code":"vendor"},{"type":"text","text":", sent as the"},{"type":"text","text":" "},{"type":"text","text":"app "},{"type":"codeVoice","code":"appID"},{"type":"text","text":", splitting each batch to "},{"type":"codeVoice","code":"limit"},{"ty