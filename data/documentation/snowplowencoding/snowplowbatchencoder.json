{"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/init(vendor:appID:plan:limit:)"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)"]},{"generated":true,"title":"Type Aliases","anchor":"Type-Aliases","identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/Failure"]},{"generated":true,"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/transientStatuses"]},{"generated":true,"title":"Type Methods","anchor":"Type-Methods","identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/outcome(of:for:)"]}],"sections":[],"abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Snowplow’s tracker protocol, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to a Snowplow collector’s "},{"type":"codeVoice","code":"POST \/com.snowplowanalytics.snowplow\/tp2"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"self-describing events whose schemas are the tracking plan’s."}],"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/SnowplowEncoding\/s8SendableP","doc:\/\/SnowplowEncoding\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SnowplowBatchEncoder","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"fills in the endpoint, the header field that keeps the collector from setting a cookie or","type":"text"},{"text":" ","type":"text"},{"text":"recording the request’s address, this encoder and its limits:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let snowplow = try HTTPDestination.snowplow(","    collector: collector,  \/\/ https:\/\/collector.example.com","    vendor: \"com.example\",  \/\/ your schemas' Iglu vendor","    appID: \"shop-ios\",","    plan: plan)"]},{"inlineContent":[{"text":"The body is a self-describing JSON object of content type ","type":"text"},{"type":"codeVoice","code":"application\/json"},{"text":", of the schema","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/payload_data\/jsonschema\/1-0-4"},{"text":", whose ","type":"text"},{"type":"codeVoice","code":"data"},{"text":" is an array of","type":"text"},{"text":" ","type":"text"},{"text":"events, one per record, oldest first. Every member of an event is a string, as the tracker","type":"text"},{"text":" ","type":"text"},{"text":"protocol has them:","type":"text"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"aid","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The app ID the encoder is made with"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"co","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The standard context’s entities (below), as the text of a self-describing JSON array of "},{"type":"codeVoice","code":"contexts"},{"type":"text","text":"; left out when there are none"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"dtm","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ttm","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in epoch milliseconds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"e"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ue"},{"type":"text","text":", a self-describing event"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"eid"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID; a redelivered record keeps it","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ip"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"0.0.0.0"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"p"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The platform: ","type":"text"},{"code":"mob","type":"codeVoice"},{"text":" for a phone, pad, watch or Vision Pro, ","type":"text"},{"code":"tv","type":"codeVoice"},{"text":" for an Apple TV, ","type":"text"},{"code":"pc","type":"codeVoice"},{"text":" for a Mac, and ","type":"text"},{"code":"app","type":"codeVoice"},{"text":" when the record has no device in its context","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"sid","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID; left out when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"tv"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"traffluent"},{"type":"text","text":", the tracker"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ue_pr"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event, as the text of a self-describing JSON ","type":"text"},{"type":"codeVoice","code":"unstruct_event"},{"text":" holding the event’s own self-describing JSON: its schema, ","type":"text"},{"type":"codeVoice","code":"iglu:<vendor>\/<name>\/jsonschema\/<version>-0-0"},{"text":", and its data, its stored properties by name","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"duid"},{"type":"text","text":", "},{"type":"codeVoice","code":"uid"},{"type":"text","text":", "},{"type":"codeVoice","code":"nuid"},{"type":"text","text":" or "},{"type":"codeVoice","code":"tnuid"},{"type":"text","text":", no"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_session"},{"type":"text","text":" entity, whose "},{"type":"codeVoice","code":"userId"},{"type":"text","text":" lasts across sessions, and no "},{"type":"codeVoice","code":"appleIdfv"},{"type":"text","text":", "},{"type":"codeVoice","code":"appleIdfa"},{"type":"text","text":" "},{"type":"text","text":"or other device identifier. Snowplow’s "},{"type":"codeVoice","code":"domain_sessionid"},{"type":"text","text":" is the session; a record with no"},{"type":"text","text":" "},{"type":"text","text":"session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is sent without one, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing. A record a store recovers after a relaunch keeps its session, so it goes out with the"},{"type":"text","text":" "},{"type":"codeVoice","code":"sid"},{"type":"text","text":" of its first send. The record’s vendor"},{"type":"text","text":" "},{"type":"text","text":"identifier and trace context, and any other context value, aren’t sent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each event’s "},{"code":"ttm","type":"codeVoice"},{"type":"text","text":", its true timestamp, is the record’s timestamp, as is "},{"code":"dtm","type":"codeVoice"},{"type":"text","text":", so Snowplow’s"},{"type":"text","text":" "},{"code":"derived_tstamp","type":"codeVoice"},{"type":"text","text":" is when the event was tracked, uncorrected for the device’s clock. No "},{"code":"stm","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is sent: a retried request sends the same body again, so a sent time would be the first"},{"type":"text","text":" "},{"type":"text","text":"attempt’s, and Snowplow would move the event later by however long the retries took."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The event’s schema is named after its "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Event\/schemaVersion","type":"codeVoice"},{"type":"text","text":": version N is"},{"type":"text","text":" "},{"type":"text","text":"SchemaVer "},{"code":"N-0-0","type":"codeVoice"},{"type":"text","text":". Each version of an event is a breaking change, a SchemaVer MODEL. A"},{"type":"text","text":" "},{"type":"text","text":"compatible change at the same version is an ADDITION, which the tracking plan’s Iglu export"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"TrackingPlan\/writeIgluRegistry(to:vendor:registry:)","type":"codeVoice"},{"type":"text","text":") writes for Iglu Server as "},{"code":"N-0-1","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"on, each superseding the ones before, so an event naming "},{"code":"N-0-0","type":"codeVoice"},{"type":"text","text":" is validated against the"},{"type":"text","text":" "},{"type":"text","text":"newest of them. A static repository doesn’t supersede: there an event naming "},{"code":"N-0-0","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"validated against "},{"code":"N-0-0","type":"codeVoice"},{"type":"text","text":" alone, so the export refuses an addition for one, and a change to an"},{"type":"text","text":" "},{"type":"text","text":"event needs a new version."}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":", as ","type":"text"},{"type":"codeVoice","code":"PropertyReader"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"data then validates against the event’s exported schema, which never requires a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" ","type":"text"},{"text":"property.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"co"},{"type":"text","text":" holds these entities, for the keys the record’s context has values for:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Entity"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keys","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/mobile_context\/jsonschema\/1-0-3"}]}],[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"},{"type":"text","text":" and "},{"code":"OperatingSystemKey","type":"codeVoice"},{"type":"text","text":", both; "},{"code":"NetworkKey","type":"codeVoice"},{"type":"text","text":" and "},{"code":"LocaleKey","type":"codeVoice"},{"type":"text","text":" if present"}]}],[{"type":"paragraph","inlineContent":[{"code":"osType","type":"codeVoice"},{"type":"text","text":" ("},{"code":"ios","type":"codeVoice"},{"type":"text","text":", "},{"code":"tvos","type":"codeVoice"},{"type":"text","text":", "},{"code":"watchos","type":"codeVoice"},{"type":"text","text":", "},{"code":"visionos","type":"codeVoice"},{"type":"text","text":", "},{"code":"osx","type":"codeVoice"},{"type":"text","text":"), "},{"code":"osVersion","type":"codeVoice"},{"type":"text","text":", "},{"code":"deviceManufacturer","type":"codeVoice"},{"type":"text","text":" ("},{"code":"Apple Inc.","type":"codeVoice"},{"type":"text","text":"), "},{"code":"deviceModel","type":"codeVoice"},{"type":"text","text":"; "},{"code":"networkType","type":"codeVoice"},{"type":"text","text":" ("},{"code":"wifi","type":"codeVoice"},{"type":"text","text":", "},{"code":"mobile","type":"codeVoice"},{"type":"text","text":", "},{"code":"offline","type":"codeVoice"},{"type":"text","text":"; left out for a wired or other connection); "},{"code":"language","type":"codeVoice"},{"type":"text","text":", the locale’s language code"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.mobile\/application\/jsonschema\/1-0-0"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ApplicationKey"},{"type":"text","text":", with both a version and a build"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"version"},{"type":"text","text":" and "},{"type":"codeVoice","code":"build"}]}]]]},{"inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event name Iglu doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"take, one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds a value JSON can’t, one whose timestamp","type":"text"},{"text":" ","type":"text"},{"text":"is outside the years 0 to 9999, and one whose JSON is over 150,000 bytes","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" returns them as ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","type":"reference","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. The collector answers 200 to every request it can read, and Snowplow validates"},{"type":"text","text":" "},{"type":"text","text":"the events afterwards: an event whose data its schema rejects, or whose schema the pipeline’s"},{"type":"text","text":" "},{"type":"text","text":"Iglu resolver can’t find, becomes a failed event, kept apart from the warehouse, though the"},{"type":"text","text":" "},{"type":"text","text":"destination counts it as delivered. The bytes are the same for the same records on every run"},{"type":"text","text":" "},{"type":"text","text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/snowplowencoding\/snowplowbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SnowplowEncoding"}],"role":"symbol","title":"SnowplowBatchEncoder","externalID":"s:16SnowplowEncoding0A12BatchEncoderV","navigatorTitle":[{"kind":"identifier","text":"SnowplowBatchEncoder"}],"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}],"remoteSource":{"fileName":"SnowplowBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SnowplowEncoding\/SnowplowBatchEncoder.swift#L94"},"roleHeading":"Structure"},"hierarchy":{"paths":[["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder"},"kind":"symbol","references":{"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/outcome(of:for:)":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO"}],"kind":"symbol","type":"topic","title":"outcome(of:for:)","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/outcome(of:for:)","role":"symbol","abstract":[{"text":"Every 2xx answer counts as delivered: a Snowplow collector answers 200 to every request it can read, and events are","type":"text"},{"text":" ","type":"text"},{"text":"validated later in the pipeline, so its answer says nothing about them.","type":"text"}],"url":"\/documentation\/snowplowencoding\/snowplowbatchencoder\/outcome(of:for:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"type":"topic","title":"BatchEncoder","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" sends.","type":"text"}],"kind":"symbol"},"doc://Events/documentation/Events/Sensitive":{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","url":"\/documentation\/events\/sensitive","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"type":"topic","title":"Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"kind":"symbol"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/Failure":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"kind":"symbol","type":"topic","title":"SnowplowBatchEncoder.Failure","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/Failure","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Failure"}],"abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"url":"\/documentation\/snowplowencoding\/snowplowbatchencoder\/failure"},"doc://SnowplowEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/SnowplowEncoding\/s16SendableMetatypeP"},"doc://SnowplowEncoding/s8SendableP":{"identifier":"doc:\/\/SnowplowEncoding\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/requests(for:)":{"role":"symbol","title":"requests(for:)","abstract":[{"code":"batch","type":"codeVoice"},{"type":"text","text":" as the tracker protocol’s requests, each within the encoder’s limit, with the"},{"type":"text","text":" "},{"type":"text","text":"records left out of them."}],"url":"\/documentation\/snowplowencoding\/snowplowbatchencoder\/requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","text":"BatchRequests","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"SnowplowEncodingError","preciseIdentifier":"s:16SnowplowEncoding0aB5ErrorO"},{"kind":"text","text":">"}],"type":"topic","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","kind":"symbol"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowEncodingError":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"role":"symbol","url":"\/documentation\/snowplowencoding\/snowplowencodingerror","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","title":"SnowplowEncodingError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowEncodingError"}],"navigatorTitle":[{"kind":"identifier","text":"SnowplowEncodingError"}]},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/init(v