uct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:backoff:clock:)","isActive":true},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"fills in the endpoint, the header field that keeps the collector from setting a cookie or"},{"type":"text","text":" "},{"type":"text","text":"recording the request’s address, this encoder and its limits:"}]},{"syntax":"swift","type":"codeListing","code":["let snowplow = try HTTPDestination.snowplow(","    collector: collector,  \/\/ https:\/\/collector.example.com","    vendor: \"com.example\",  \/\/ your schemas' Iglu vendor","    appID: \"shop-ios\",","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a self-describing JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", of the schema"},{"type":"text","text":" "},{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/payload_data\/jsonschema\/1-0-4"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"data"},{"type":"text","text":" is an array of"},{"type":"text","text":" "},{"type":"text","text":"events, one per record, oldest first. Every member of an event is a string, as the tracker"},{"type":"text","text":" "},{"type":"text","text":"protocol has them:"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"aid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The app ID the encoder is made with","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"co","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The standard context’s entities (below), as the text of a self-describing JSON array of ","type":"text"},{"code":"contexts","type":"codeVoice"},{"text":"; left out when there are none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dtm"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ttm"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in epoch milliseconds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"e","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ue","type":"codeVoice"},{"text":", a self-describing event","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"eid"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"ip","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"0.0.0.0","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"p"}]}],[{"type":"paragraph","inlineContent":[{"text":"The platform: ","type":"text"},{"code":"mob","type":"codeVoice"},{"text":" for a phone, pad, watch or Vision Pro, ","type":"text"},{"code":"tv","type":"codeVoice"},{"text":" for an Apple TV, ","type":"text"},{"code":"pc","type":"codeVoice"},{"text":" for a Mac, and ","type":"text"},{"code":"app","type":"codeVoice"},{"text":" when the record has no device in its context","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID; left out when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"tv"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"traffluent"},{"type":"text","text":", the tracker"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ue_pr"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event, as the text of a self-describing JSON "},{"type":"codeVoice","code":"unstruct_event"},{"type":"text","text":" holding the event’s own self-describing JSON: its schema, "},{"type":"codeVoice","code":"iglu:<vendor>\/<name>\/jsonschema\/<version>-0-0"},{"type":"text","text":", and its data, its stored properties by name"}]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"duid"},{"type":"text","text":", "},{"type":"codeVoice","code":"uid"},{"type":"text","text":", "},{"type":"codeVoice","code":"nuid"},{"type":"text","text":" or "},{"type":"codeVoice","code":"tnuid"},{"type":"text","text":", no"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_session"},{"type":"text","text":" entity, whose "},{"type":"codeVoice","code":"userId"},{"type":"text","text":" lasts across sessions, and no "},{"type":"codeVoice","code":"appleIdfv"},{"type":"text","text":", "},{"type":"codeVoice","code":"appleIdfa"},{"type":"text","text":" "},{"type":"text","text":"or other device identifier. Snowplow’s "},{"type":"codeVoice","code":"domain_sessionid"},{"type":"text","text":" is the session; a record with no"},{"type":"text","text":" "},{"type":"text","text":"session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is sent without one, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing. A record a store recovers after a relaunch keeps its session, so it goes out with the"},{"type":"text","text":" "},{"type":"codeVoice","code":"sid"},{"type":"text","text":" of its first send. The record’s vendor"},{"type":"text","text":" "},{"type":"text","text":"identifier and trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event’s "},{"type":"codeVoice","code":"ttm"},{"type":"text","text":", its true timestamp, is the record’s timestamp, as is "},{"type":"codeVoice","code":"dtm"},{"type":"text","text":", so Snowplow’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"derived_tstamp"},{"type":"text","text":" is when the event was tracked, uncorrected for the device’s clock. No "},{"type":"codeVoice","code":"stm"},{"type":"text","text":" "},{"type":"text","text":"is sent: a retried request sends the same body again, so a sent time would be the first"},{"type":"text","text":" "},{"type":"text","text":"attempt’s, and Snowplow would move the event later by however long the retries took."}]},{"type":"paragraph","inlineContent":[{"text":"The event’s schema is named after its ","type":"text"},{"type":"codeVoice","code":"Event\/name"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Event\/schemaVersion"},{"text":": version N is","type":"text"},{"text":" ","type":"text"},{"text":"SchemaVer ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":". Each version of an event is a breaking change, a SchemaVer MODEL. A","type":"text"},{"text":" ","type":"text"},{"text":"compatible change at the same version is an ADDITION, which the tracking plan’s Iglu export","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"TrackingPlan\/writeIgluRegistry(to:vendor:registry:)"},{"text":") writes for Iglu Server as ","type":"text"},{"type":"codeVoice","code":"N-0-1"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"on, each superseding the ones before, so an event naming ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":" is validated against the","type":"text"},{"text":" ","type":"text"},{"text":"newest of them. A static repository doesn’t supersede: there an event naming ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"validated against ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":" alone, so the export refuses an addition for one, and a change to an","type":"text"},{"text":" ","type":"text"},{"text":"event needs a new version.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"data then validates against the event’s exported schema, which never requires a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"co","type":"codeVoice"},{"text":" holds these entities, for the keys the record’s context has values for:","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Entity","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[