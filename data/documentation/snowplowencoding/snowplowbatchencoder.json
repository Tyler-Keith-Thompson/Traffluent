"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}]},"doc://Events/documentation/Events/Sensitive":{"abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"role":"symbol","url":"\/documentation\/events\/sensitive","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"kind":"symbol","title":"Sensitive","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowEncodingError":{"type":"topic","url":"\/documentation\/snowplowencoding\/snowplowencodingerror","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SnowplowEncodingError","kind":"identifier"}],"abstract":[{"text":"Why ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for the batch.","type":"text"}],"navigatorTitle":[{"text":"SnowplowEncod