{"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/DestinationTesting\/s8SendableP","doc:\/\/DestinationTesting\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationConformance","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Make one with the vendor’s factory, called with the kit’s "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","isActive":true},{"type":"text","text":" and short"},{"type":"text","text":" "},{"type":"text","text":"backoff, then run each "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","isActive":true},{"type":"text","text":" and each fixture from a test:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"]},{"inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue, at the caller’s source location, for every rule the"},{"type":"text","text":" "},{"type":"text","text":"destination breaks, and throws what the factory throws. Unlike a project’s own tests, which"},{"type":"text","text":" "},{"type":"text","text":"write their assertions out in full, this is a published assertion, shared on purpose, as"},{"type":"text","text":" "},{"type":"text","text":"TrackingPlanTesting’s "},{"type":"codeVoice","code":"expectTrackingPlan(_:matches:sourceLocation:)"},{"type":"text","text":" is: every vendor module"},{"type":"text","text":" "},{"type":"text","text":"runs the same checks. The checks send through the transport only, never the network, and run"},{"type":"text","text":" "},{"type":"text","text":"in well under a second; give the calling suite a "},{"type":"codeVoice","code":".timeLimit"},{"type":"text","text":", as a factory that keeps a copy"},{"type":"text","text":" "},{"type":"text","text":"of the destination it returns makes a check wait for ever."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinationtesting\/destinationconformance"]}],"identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"title":"Checking a destination","generated":true,"anchor":"Checking-a-destination","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"]}],"metadata":{"roleHeading":"Structure","symbolKind":"struct","externalID":"s:18DestinationTesting0A11ConformanceV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Dest