level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Make one with the vendor’s factory, called with the kit’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"},{"type":"text","text":" and short"},{"type":"text","text":" "},{"type":"text","text":"backoff, then run each "},{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck"},{"type":"text","text":" and each fixture from a test:"}],"type":"paragraph"},{"type":"codeListing","code":["@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue, at the caller’s source location, for every rule the"},{"type":"text","text":" "},{"type":"text","text":"destination breaks, and throws what the factory throws. Unlike a project’s own tests, which"},{"type":"text","text":" "},{"type":"text","text":"write their assertions out in full, this is a published assertion, shared on purpose, as"},{"type":"text","text":" "},{"type":"text","text":"TrackingPlanTesting’s "},{"code":"expectTrackingPlan(_:matches:sourceLocation:)","type":"codeVoice"},{"type":"text","text":" is: every vendor module"},{"type":"text","text":" "},{"type":"text","text":"runs the same checks. The checks send through the transport only, never the network, and run"},{"type":"text","text":" "},{"type":"text","text":"in well under a second; give the calling suite a "},{"code":".timeLimit","type":"codeVoice"},{"type":"text","text":", as a factory that keeps a copy"},{"type":"text","text":" "},{"type":"text","text":"of the destination it returns makes a check wait for ever."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests"},{"type":"text","text":" "},{"type":"text","text":"match recorded fixtures byte for byte, and it keeps the library’s rules for "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"consent, oversized records, retries and trace context."}],"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/init(limit:timestamp:bodyText:makeRevealingDestination:makeDestination:)"],"title":"Initializers"},{"anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expectRequests(of:plan:matchFixture:withExtension:subdirectory:in:sourceLocation:)"],"title":"Instance Methods"},{"anchor":"Type-Aliases","generated":true,"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/Factory"],"title":"Type Aliases"}],"identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/DestinationTesting\/documentation\/DestinationTesting"]]},"references":{"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance/expect(_:sourceLocation:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expect","kind":"identifier"},{"text":"(","kin