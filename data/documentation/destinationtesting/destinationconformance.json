{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests","type":"text"},{"text":" ","type":"text"},{"text":"match recorded fixtures byte for byte, and it keeps the library’s rules for ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" values,","type":"text"},{"text":" ","type":"text"},{"text":"consent, oversized records, retries and trace context.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"],"generated":true,"title":"Checking a destination","anchor":"Checking-a-destination"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationConformance"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Encoding"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","text":"BatchEncoder","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make one with the vendor’s factory, called with the kit’s "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","type":"reference","isActive":true},{"type":"text","text":" and short"},{"type":"text","text":" "},{"type":"text","text":"backoff, then run each "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck