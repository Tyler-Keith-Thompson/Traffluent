{"sections":[],"topicSections":[{"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/init(limit:timestamp:bodyText:makeRevealingDestination:makeDestination:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expectRequests(of:plan:matchFixture:withExtension:subdirectory:in:sourceLocation:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/Factory"],"title":"Type Aliases","anchor":"Type-Aliases","generated":true}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests"},{"type":"text","text":" "},{"type":"text","text":"match recorded fixtures byte for byte, and it keeps the library’s rules for "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"consent, oversized records, retries, 2xx answers and trace context."}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/DestinationTesting\/s8SendableP","doc:\/\/DestinationTesting\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"metadata":{"externalID":"s:18DestinationTesting0A11ConformanceV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationConformance","kind":"identifier"}],"symbolKind":"struct","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/DestinationTesting\/DestinationConformance.swift#L41","fileName":"DestinationConformance.swift"},"navigatorTitle":[{"kind":"identifier","text":"DestinationConformance"}],"roleHeading":"Structure","modules":[{"name":"DestinationTesting"}],"title":"DestinationConformance"},"identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/DestinationTesting\/documentation\/DestinationTesting"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationConformance","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","text":"BatchEncoder","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Make one with the vendor’s factory, called with the kit’s "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","isActive":true},{"type":"text","text":" and short"},{"type":"text","text":" "},{"type":"text","text":"backoff, then run each "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","isActive":true},{"type":"text","text":" and each fixture from a test:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"]},{"inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue, at the caller’s source location, for every rule the"},{"type":"text","text":" "},{"type":"text","text":"destination breaks, and throws what the factory throws. Unlike a project’s own tests, which"},{"type":"text","text":" "},{"type":"text","text":"write their assertions out in full, this is a published assertion, shared on purpose, as"},{"type":"text","text":" "},{"type":"text","text":"TrackingPlanTesting’s "},{"type":"codeVoice","code":"expectTrackingPlan(_:matches:sourceLocation:)"},{"type":"text","text":" is: every vendor module"},{"type":"text","text":" "},{"type":"text","text":"runs the same checks. The checks send through the transport only, never the network, and run"},{"type":"text","text":" "},{"type":"text","text":"in well under a second; give the calling suite a "},{"type":"codeVoice","code":".timeLimit"},{"type":"text","text":", as a factory that keeps a copy"},{"type":"text","text":" "},{"type":"text","text":"of the destination it returns makes a check wait for ever."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/destinationtesting\/destinationconformance"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"],"title":"Checking a destination","anchor":"Checking-a-destination","generated":true}],"kind":"symbol","references":{"doc://DestinationTesting/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/DestinationTesting\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://DestinationTesting/documentation/DestinationTest