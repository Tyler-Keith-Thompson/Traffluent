":"text"},{"text":" ","type":"text"},{"text":"TrackingPlanTesting’s ","type":"text"},{"code":"expectTrackingPlan(_:matches:sourceLocation:)","type":"codeVoice"},{"text":" is: every vendor module","type":"text"},{"text":" ","type":"text"},{"text":"runs the same checks. The checks send through the transport only, never the network, and run","type":"text"},{"text":" ","type":"text"},{"text":"in well under a second; give the calling suite a ","type":"text"},{"code":".timeLimit","type":"codeVoice"},{"text":", as a factory that keeps a copy","type":"text"},{"text":" ","type":"text"},{"text":"of the destination it returns makes a check wait for ever.","type":"text"}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","interfaceLanguage":"swift"},"relationshipsSections":[{"identifiers":["doc:\/\/DestinationTesting\/s8SendableP","doc:\/\/DestinationTesting\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"metadata":{"navigatorTitle":[{"text":"DestinationConformance","kind":"identifier"}],"title":"DestinationConformance","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/DestinationTesting\/DestinationConformance.swift#L41","fileName":"DestinationConformance.swift"},"symbolKind":"struct","modules":[{"name":"DestinationTesting"}],"externalID":"s:18DestinationTesting0A11ConformanceV","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationConformance","kind":"identifier"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/DestinationTesting\/documentation\/DestinationTesting"]]},"references":{"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance/init(limit:bodyText:makeRevealingDestination:makeDestination:)":{"type":"topic","title":"init(limit:bodyText:makeRevealingDestination:makeDestination:)","url":"\/doc