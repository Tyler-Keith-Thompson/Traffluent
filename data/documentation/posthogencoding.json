ol","url":"\/documentation\/httpdestinations\/batchencoder"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogEncodingError":{"kind":"symbol","abstract":[{"type":"text","text":"Why "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no record of"},{"type":"text","text":" "},{"type":"text","text":"a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"navigatorTitle":[{"kind":"identifier","text":"PostHogEncodingError"}],"type":"topic","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogEncodingError"}],"url":"\/documentation\/posthogencoding\/posthogencodingerror","role":"symbol","title":"PostHogEncodingError"},"doc://PostHogEncoding/documentation/PostHogEncoding/HTTPDestinations/HTTPDestination/postHog(projectToken:host:plan:transport:backoff:clock:)":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:transport:backoff:clock:)","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"postHog"},{"kind":"text","text":"("},{"kind":"externalParam","text":"projectToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam"