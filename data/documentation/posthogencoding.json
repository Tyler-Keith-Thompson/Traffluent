{"hierarchy":{"paths":[[]]},"abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"PostHogEncoding","symbolKind":"module","modules":[{"name":"PostHogEncoding"}],"role":"collection","roleHeading":"Framework","title":"PostHogEncoding"},"topicSections":[{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:transport:backoff:clock:)","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSetupError"],"anchor":"Sending-to-PostHog","title":"Sending to PostHog"},{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"],"anchor":"Encoding-batches","title":"Encoding batches"},{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"],"anchor":"Records-left-out","title":"Records left out"}],"variants":[{"paths":["\/documentation\/posthogencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","isActive":true},{"type":"text","text":" makes an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":") for your PostHog project in one call. It checks"},{"type":"text","text":" "},{"type":"text","text":"the project token and the host, posts to the host’s "},{"type":"codeVoice","code":"\/batch\/"},{"type":"text","text":" with a "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","isActive":true},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"splits each batch to PostHog’s limits ("},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":"). A batch with no"},{"type":"text","text":" "},{"type":"text","text":"record the encoder can write, an empty one included, makes no request. It retries no response, a"},{"type":"text","text":" "},{"type":"text","text":"5xx, 408 and 429, and drops and reports any other status. The project token goes in"},{"type":"text","text":" "},{"type":"text","text":"the body, so no header field is needed, and no trace context is sent. "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves"},{"type":"text","text":" "},{"type":"text","text":"this module out; import it on its own."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each record becomes an anonymous event. Its "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" is the record’s session, from the"},{"type":"text","text":" "},{"type":"text","text":"sessions enricher, also sent as "},{"type":"codeVoice","code":"$session_id"},{"type":"text","text":"; a record with no session is sent under its own"},{"type":"text","text":" "},{"type":"text","text":"record identifier. Its "},{"type":"codeVoice","code":"uuid"},{"type":"text","text":" is the record’s identifier, which a redelivered record keeps. Every"},{"type":"text","text":" "},{"type":"text","text":"event carries "},{"type":"codeVoice","code":"$process_person_profile: false"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$geoip_disable: true"},{"type":"text","text":". The record’s vendor"},{"type":"text","text":" "},{"type":"text","text":"identifier and trace context aren’t sent, and the standard context is sent as PostHog’s own"},{"type":"text","text":" "},{"type":"text","text":"properties ("},{"type":"codeVoice","code":"$app_version"},{"type":"text","text":", "},{"type":"codeVoice","code":"$device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$os_name"},{"type":"text","text":" and the like)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals, and a property whose name starts with"},{"type":"text","text":" "},{"type":"codeVoice","code":"$"},{"type":"text","text":" or is "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" is left out and logged. A record the encoder can’t write is left out and"},{"type":"text","text":" "},{"type":"text","text":"the rest of the batch is sent: one the plan doesn’t describe, one whose event name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one holding a value JSON can’t, and one too large for PostHog’s"},{"type":"text","text":" "},{"type":"text","text":"event limit. The destination reports each as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"reason is a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To send to TraffluentCollector, use "},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"CollectorEncoding"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"},{"code":["import HTTPDestinations","import PostHogEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let postHog = try HTTPDestination.postHog(","    projectToken: projectToken,","    host: postHogHost,  \/\/ https:\/\/us.i.posthog.com, https:\/\/eu.i.posthog.com or your own","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: postHog)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The guide ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"text":" ","type":"text"},{"text":"covers what PostHog receives, and why, in more detail.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","interfaceLanguage":"swift"},"references":{"doc://PostHogEncoding/documentation/PostHogEncoding/HTTPDestinations/HTTPDestination/postHog(projectToken:host:plan:backoff:clock:)":{"abstract":[{"text":"A destination that sends batches to the PostHog project of ","type":"text"},{"type":"codeVoice","code":"projectToken"},{"text":" at ","type":"text"},{"type":"codeVoice","code":"host"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"URLSession.shared"},{"text":", retrying a send that fails for now with the waits of ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"clock"},{"text":".","type":"text"}],"url":"\/documentation\/posthogencoding\/httpdestinations\/httpdestination\/posth