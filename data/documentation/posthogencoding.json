TTPDestination"},{"text":" sends.","type":"text"}],"kind":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","title":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/httpdestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"title":"HTTPDestinations"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/batchLimit":{"title":"batchLimit","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier","text":"BatchLimit"}],"type":"topic","kind":"symbol","abstract":[{"text":"PostHog’s limits on one request: 10,000,000 bytes of body and 1,000,000 bytes of one event,","type":"text"},{"text":" ","type":"text"},{"text":"with no limit on the count of events.","type":"text"}],"url":"\/documentation\/posthogencoding\/posthogbatchencoder\/batchlimit","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogEncodingError":{"title":"PostHogEncodingError","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogEncodingError"}],"navigatorTitle":[{"kind":"identifier","text":"PostHogEncodingError"}],"type":"topic","kind":"symbol","abstract":[{"text":"Why ","type":"text"},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","isActive":true},{"text":" couldn’t send a record, which it leaves out of the batch’s requests","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" reports as a drop. When it can encode no record of","type":"text"},{"text":" ","type":"text"},{"text":"a batch, it makes no request, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for the batch.","type":"text"}],"url":"\/documentation\/posthogencoding\/posthogencodingerror","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder":{"role":"symbol","navigatorTitle":[{"text":"PostHogBatchEncoder","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatchEncoder","kind":"identifier"}],"abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of PostHog’s batch capture API, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"can send events to PostHog Cloud or a self-hosted PostHog’s "},{"code":"POST \/batch\/","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/posthogencoding\/posthogbatchencoder","title":"PostHogBatchEncoder","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"},"doc://PostHogEncoding/documentation/PostHogEncoding/HTTPDestinations/HTTPDestination/postHog(projectToken:host:plan:transport:backoff:clock:)":{"url":"\/documentation\/posthogencoding\/httpdestinations\/httpdestination\/posthog(projecttoken:host:plan:transport:backoff:clock:)","kind":"symbol","abstract":[{"text":"A destination that sends batches to