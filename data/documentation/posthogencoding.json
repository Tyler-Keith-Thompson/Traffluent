ntation\/posthogencoding\/posthogbatchencoder\/batchlimit","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit","title":"batchLimit","abstract":[{"text":"PostHog’s limits on one request: 10,000,000 bytes of body and 1,000,000 bytes of one event,","type":"text"},{"text":" ","type":"text"},{"text":"with no limit on the count of events.","type":"text"}]},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder":{"navigatorTitle":[{"text":"PostHogBatchEncoder","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of PostHog’s batch capture API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to PostHog Cloud or a self-hosted PostHog’s "},{"type":"codeVoice","code":"POST \/batch\/"},{"type":"text","text":"."}],"url":"\/documentation\/posthogencoding\/posthogbatchencoder","kind":"symbol","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatchEncoder","kind":"identifier"}],"title":"PostHogBatchEncoder"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/httpdestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","title":"HTTPDestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}]},"doc://PostHogEncoding/documentation/PostHogEncoding":{"type":"topic","role":"collection","abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}],"url":"\/documentation\/posthogencoding",