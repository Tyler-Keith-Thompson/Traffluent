{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"anchor":"Encoding-batches","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatch"],"title":"Encoding batches"},{"anchor":"Records-left-out","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"],"title":"Records left out"}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","type":"reference"},{"text":" is the ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" for PostHog Cloud’s or a self-hosted PostHog’s","type":"text"},{"text":" ","type":"text"},{"code":"POST \/batch\/","type":"codeVoice"},{"text":". Give it to an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference"},{"text":") as its encoder, with","type":"text"},{"text":" ","type":"text"},{"text":"your instance’s ","type":"text"},{"code":"\/batch\/","type":"codeVoice"},{"text":" URL. The project token goes in the body, so no header field is needed.","type":"text"},{"text":" ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves this module out; import it on its own.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each record becomes an anonymous event. Its ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":" is the record’s session, from the","type":"text"},{"text":" ","type":"text"},{"text":"sessions enricher, also sent as ","type":"text"},{"code":"$session_id","type":"codeVoice"},{"text":"; a record with no session is sent under its own","type":"text"},{"text":" ","type":"text"},{"text":"record identifier. Its ","type":"text"},{"code":"uuid","type":"codeVoice"},{"text":" is the record’s identifier, which a redelivered record keeps. Every","type":"text"},{"text":" ","type":"text"},{"text":"event carries ","type":"text"},{"code":"$process_person_profile: false","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"$geoip_disable: true","type":"codeVoice"},{"text":". The record’s vendor","type":"text"},{"text":" ","type":"text"},{"text":"identifier and trace context aren’t sent, and the standard context is sent as PostHog’s own","type":"text"},{"text":" ","type":"text"},{"text":"properties (","type":"text"},{"code":"$app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$device_model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_name","type":"codeVoice"},{"text":" and the like).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in the ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":" the encoder is made with. A","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value is never sent, whatever the record reveals, and a property whose name starts with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"$"},{"text":" or is ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":" is left out and logged. A record the encoder can’t write is left out and","type":"text"},{"text":" ","type":"text"},{"text":"the rest of the batch is sent: one the plan doesn’t describe, one whose event name starts with ","type":"text"},{"type":"codeVoice","code":"$"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"BinaryCodable"},{"text":" and one holding a value JSON can’t.","type":"text"},{"text":" ","type":"text"},{"t