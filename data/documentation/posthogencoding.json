with the waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"type":"topic"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/batchLimit":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","title":"batchLimit","role":"symbol","abstract":[{"type":"text","text":"PostHog’s limits on one request: 10,000,000 bytes of body and 1,000,000 bytes of one event,"},{"type":"text","text":" "},{"type":"text","text":"with no limit on the count of events."}],"url":"\/documentation\/posthogencoding\/posthogbatchencoder\/batchlimit","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogEncodingError":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogEncodingError","kind":"identifier"}],"type":"topic","kind":"symbol","title":"PostHogEncodingError","role":"symbol","navigatorTitle":[{"text":"PostHogEncodingError","kind":"identifier"}],"abstract":[{"type":"text","text":"Why "},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","type":"reference"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no record of"},{"type":"text","text":" "},{"type":"text","text":"a batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"url":"\/documentation\/posthogencoding\/posthogencodingerror","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"type":"link","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"title":"BatchEncoder","type":"topic","role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" sends.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","url":"\/documentation\/httpdestinations","kind":"symbol","role":"collection","title":"HTTPDestinations"}}}