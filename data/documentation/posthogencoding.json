ext"},{"type":"codeVoice","code":"$"},{"text":" or is ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":" is left out and logged. A record the encoder can’t write is left out and","type":"text"},{"text":" ","type":"text"},{"text":"the rest of the batch is sent: one the plan doesn’t describe, one whose event name starts with ","type":"text"},{"type":"codeVoice","code":"$"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":" and one holding a value JSON can’t.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","isActive":true,"type":"reference"},{"text":" returns each as a ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To send to TraffluentCollector, use ","type":"text"},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"CollectorEncoding","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","import Instrumentation","import PostHogEncoding","import TrackingPlans","","let plan = try TrackingPlan(schemas: [SignedUp.schema, SessionStarted.schema, SessionEnded.schema])","let encoder = PostHogBatchEncoder(projectToken: projectToken, plan: plan)","let postHog = HTTPDestination(","    endpoint: postHogBatchURL,  \/\/ https:\/\/us.i.posthog.com\/batch\/, https:\/\/eu.i.posthog.com\/batch\/ or your own","    instrument: NoOpInstrument(),  \/\/ so no trace context goes to PostHog in the header fields","    encoder: encoder)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: postHog)"]},{"inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers what PostHog receives, and why, in more detail."}],"type":"paragraph"}]}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic","url":"\/documentation\/httpdestinations","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"role":"collection","kind":"symbol"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatch":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatch","kind":"symbol","abstract":[{"text":"A batch as ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)"},{"text":" encodes it: the body of the records it could","type":"text"},{"text":" ","type":"text"},{"text":"encode, and the records it left out.","type":"text"}],"title":"PostHogBatch","role":"symbol","navigatorTitle":[{"text":"PostHogBatch","kind":"identifier"}],"type":"topic","url":"\/documentation\/posthogencoding\/posthogbatch","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatch","kind":"identifier"}]},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogEncodingError":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"PostHogEncodingError"}],"title":"PostHogEncodingError","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","isActive":true},{"type":"text","text":" couldn’t encode a record, which it leaves out of the batch’s body"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","isActive":true},{"type":"text","text":". When it can encode no record of a batch,"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)","isActive":true},{"type":"text","text":" throws the first one’s, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing"},{"type":"text","text":" "},{"type":"text","text":"for the batch and logs the error."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogEncodingError"}],"kind":"symbol","role":"symbol","url":"\/documentation\/posthogencoding\/posthogencodingerror","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","title":"Choosing Destinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}]},"doc://PostHogEncoding/documentation/PostHogEncoding":{"kind":"symbol","abstract":[{"text":"Write batches of records for PostHog’s batch capture API, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","role":"collection","type":"topic","url":"\/documentation\/posthogencoding","title":"PostHogEncoding"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogSkippedRecord":{"url":"\/documentation\/posthogencoding\/posthogskippedre