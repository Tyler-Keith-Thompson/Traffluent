{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","isActive":true},{"type":"text","text":" is the "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" for PostHog Cloud’s or a self-hosted PostHog’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/batch\/"},{"type":"text","text":". Give it to an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":") as its encoder, with"},{"type":"text","text":" "},{"type":"text","text":"your instance’s "},{"type":"codeVoice","code":"\/batch\/"},{"type":"text","text":" URL. The project token goes in the body, so no header field is needed."},{"type":"text","text":" "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves this module out; import it on its own."}]},{"type":"paragraph","inlineContent":[{"text":"Each record becomes an anonymous event. Its ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":" is the record’s session, from the","type":"text"},{"text":" ","type":"text"},{"text":"sessions enricher, also sent as ","type":"text"},{"type":"codeVoice","code":"$session_id"},{"text":"; a record with no session is sent under its own","type":"text"},{"text":" ","type":"text"},{"text":"record identifier. Its ","type":"text"},{"type":"codeVoice","code":"uuid"},{"text":" is the record’s identifier, which a redelivered record keeps. Every","type":"text"},{"text":" ","type":"text"},{"text":"event carries ","type":"text"},{"type":"codeVoice","code":"$process_person_profile: false"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"$geoip_disable: true"},{"text":". The record’s vendor","type":"text"},{"text":" ","type":"text"},{"text":"identifier and trace context aren’t sent, and the standard context is sent as PostHog’s own","type":"text"},{"text":" ","type":"text"},{"text":"properties (","type":"text"},{"type":"codeVoice","code":"$app_version"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$device_model"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$os_name"},{"text":" and the like).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in the ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":" the encoder is made with. A","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is never sent, whatever the record reveals, and a property whose name starts with","type":"text"},{"text":" ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" or is ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":" is left out and logged. A record the encoder can’t write is left out and","type":"text"},{"text":" ","type":"text"},{"text":"the rest of the batch is sent: one the plan doesn’t describe, one whose event name starts with ","type":"text"},{"code":"$","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":" and one holding a value JSON can’t.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","isActive":true,"type":"reference"},{"text":" returns each as a ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to TraffluentCollector, use "},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"CollectorEncoding"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"instead."}]},{"syntax":"swift","type":"codeListing","code":["import HTTPDestinations","import Instrumentation","import PostHogEncoding","import TrackingPlans","","let plan = try TrackingPlan(schemas: [SignedUp.schema, SessionStarted.schema, SessionEnded.schema])","let encoder = PostHogBatchEncoder(projectToken: projectToken, plan: plan)","let postHog = HTTPDestination(","    endpoint: postHogBatchURL,  \/\/ https:\/\/us.i.posthog.com\/batch\/, https:\/\/eu.i.posthog.com\/batch\/ or your own","    instrument: NoOpInstrument(),  \/\/ so no trace context goes to PostHog in the header fields","    encoder: encoder)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: postHog)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what PostHog receives, and why, in more detail."}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Encoding batches","anchor":"Encoding-batches","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatch"]},{"title":"Records left out","anchor":"Records-left-out","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"]}],"hierarchy":{"paths":[[]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},"metadata":{"modules":[{"name":"PostHogEncoding"}],"externalID":"PostHogEncoding","role":"collection","sym