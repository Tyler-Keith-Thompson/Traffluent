{"abstract":[{"text":"Write batches of records for PostHog’s batch capture API, for an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" to send.","type":"text"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","topicSections":[{"anchor":"Encoding-batches","title":"Encoding batches","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatch"]},{"anchor":"Records-left-out","title":"Records left out","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"]}],"metadata":{"role":"collection","modules":[{"name":"PostHogEncoding"}],"externalID":"PostHogEncoding","symbolKind":"module","title":"PostHogEncoding","roleHeading":"Framework"},"variants":[{"paths":["\/documentation\/posthogencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" for PostHog Cloud’s or a self-hosted PostHog’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/batch\/"},{"type":"text","text":". Give it to an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":") as its encoder, with"},{"type":"text","text":" "},{"type":"text","text":"your instance’s "},{"type":"codeVoice","code":"\/batch\/"},{"type":"text","text":" URL. The project token goes in the body, so no header field is needed."},{"type":"text","text":" "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves this module out; import it on its own."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each record becomes an anonymous event. Its "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" is the record’s session, from the"},{"type":"text","text":" "},{"type":"text","text":"sessions enricher, also sent as "},{"type":"codeVoice","code":"$session_id"},{"type":"text","text":"; a record with no session is sent under its own"},{"type":"text","text":" "},{"type":"text","text":"record identifier. Its "},{"type":"codeVoice","code":"uuid"},{"type":"text","text":" is the record’s identifier, which a redelivered record keeps. Every"},{"type":"text","text":" "},{"type":"text","text":"event carries "},{"type":"codeVoice","code":"$process_person_profile: false"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$geoip_disable: true"},{"type":"text","text":". The record’s vendor"},{"type":"text","text":" "},{"type":"text","text":"identifier and trace context aren’t sent, and the standard context is sent as PostHog’s own"},{"type":"text","text":" "},{"type":"text","text":"properties ("},{"type":"codeVoice","code":"$app_version"},{"type":"text","text":", "},{"type":"codeVoice","code":"$device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$os_name"},{"type":"text","text":" and the like)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals, and a property whose name starts with"},{"type":"text","text":" "},{"type":"codeVoice","code":"$"},{"type":"text","text":" or is "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" is left out and logged. A record the encoder can’t write is left out and"},{"type":"text","text":" "},{"type":"text","text":"the rest of the batch is sent: one the plan doesn’t describe, one whose event name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" and one holding a value JSON can’t."},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","type":"reference"},{"type":"text","text":" returns each as a "},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"To send to TraffluentCollector, use ","type":"text"},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"CollectorEncoding","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import HTTPDestinations","import Instrumentation","import PostHogEncoding","import TrackingPlans","","let plan = try TrackingPlan(schemas: [SignedUp.schema, SessionStarted.schema, SessionEnded.schema])","let encoder = PostHogBatchEncoder(projectToken: projectToken, plan: plan)","let postHog = HTTPDestination(","    endpoint: postHogBatchURL,  \/\/ https:\/\/us.i.posthog.com\/batch\/, https:\/\/eu.i.posthog.com\/batch\/ or your own","    instrument: NoOpInstrument(),  \/\/ so no trace context goes to PostHog in the header fields","    encoder: encoder)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: postHog)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers what PostHog receives, and why, in more detail."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","interfaceLanguage":"swift"},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"title":"Choosing Destinations","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"abstract":[{"text":"What turns a batch of records into the body of the request ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":" sends.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","title":"BatchEncoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","kind":"symbol","type":"topic"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"abstract":[{"text":"Write batches of records for PostHog’s batch capture API, for an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" to send.","type":"text"}],"url":"\/documentation\/posthogencoding","kind":"symbol","title":"PostHogEncoding","role":"collection","type":"topic","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"title":"HTTPDestinations","type":"topic","url":"\/documentation\/httpdestinations","role":"collection","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}]},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatch":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatch","navigatorTitle":[{"text":"PostHogBatch","kind":"identifier"}],"url":"\/documentation\/posthogencoding\/posthogbatch","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatch","kind":"identifier"}],"type":"topic","title":"PostHogBatch","abstract":[{"text":"A batch as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)"},{"text":" encodes it: the body of the records it could","type":"text"},{"text":" ","type":"text"},{"text":"encode, and the records it left out.","type":"text"}],"role":"symbol"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/batch(of:)":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","url":"\/documentation\/posthogencoding\/posthogbatchencoder\/batch(of:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"PostHogBatch","kind":"typeIdentifier","preciseIdentifier":"s:15PostHogEncoding0aB5BatchV"}],"type":"topic","title":"batch(of:)","abstract":[{"code":"batch","type":"codeVoice"},{"text":" encoded as ","type":"text"