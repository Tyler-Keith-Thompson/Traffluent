t of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no record of"},{"type":"text","text":" "},{"type":"text","text":"a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"navigatorTitle":[{"text":"PostHogEncodingError","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"text":" sends.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"title":"BatchEncoder"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogSetupError":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogSetupError","kind":"identifier"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/posthogencoding\/posthogsetuperror","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSetupError","title":"PostHogSetupError","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:transport:backoff:clock:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"