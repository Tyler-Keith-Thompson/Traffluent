Encoder":{"url":"\/documentation\/posthogencoding\/posthogbatchencoder","abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" of PostHog’s batch capture API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"can send events to PostHog Cloud or a self-hosted PostHog’s ","type":"text"},{"code":"POST \/batch\/","type":"codeVoice"},{"text":".","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"PostHogBatchEncoder"}],"role":"symbol","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"title":"PostHogBatchEncoder"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"type":"topic","role":"collection","url":"\/documentation\/posthogencoding","title":"PostHogEncoding","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","kind":"symbol"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogEncodingError":{"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Why "},{"isActive":true,"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no record of"},{"type":"text","text":" "},{"type":"text","text":"a batch, it makes no request, and 