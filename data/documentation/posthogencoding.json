,"abstract":[{"type":"text","text":"A record "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"},{"type":"text","text":" left out of a batch’s body, and why."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"PostHogSkippedRecord","kind":"identifier"}]},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PostHogBatchEncoder"}],"type":"topic","url":"\/documentation\/posthogencoding\/posthogbatchencoder","abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of PostHog’s batch capture API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to PostHog Cloud or a self-hosted PostHog’s "},{"type":"codeVoice","code":"POST \/batch\/"},{"type":"text","text":"."}],"kind":"symbol","title":"PostHogBatchEncoder","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"url":"\/documentation\/httpdestinations","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","title":"HTTPDestinations","kind":"symbol","role":"collection"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatch":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatch"}],"role":"symbol","abstract":[{"text":"A batch as ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)","type":"reference","isActive":true},{"text":" encodes it: the body of the records it could","type":"text"},{"text":" ","type":"text"},{"text":"encode, and the records it left out.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"PostHogBatch"}],"kind":"symbol","url":"\/documentation\/posthogencoding\/posthogbatch","title":"PostHogBatch","type":"topic"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogEncodingError":{"abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t encode a record, which it leaves out of the batch’s body","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","isActive":true,"type":"reference"},{"text":". When it can encode no record of a batch,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)","isActive":true,"type":"reference"},{"text":" throws the first one’s, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing","type":"text"},{"text":" ","type":"text"},{"text":"for the batch and logs the error.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogEncodingError"}],"url":"\/documentation\/posthogencoding\/posthogencodingerror","type":"topic","navigatorTitle":[{"kind":"identifier","text":"PostHogEncodingError"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","title":"PostHogEncodingError","kind":"symbol","role":"symbol"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"kind":"symbol","title":