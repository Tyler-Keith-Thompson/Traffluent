{"sections":[],"abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/posthogencoding"]}],"kind":"symbol","hierarchy":{"paths":[[]]},"metadata":{"role":"collection","externalID":"PostHogEncoding","modules":[{"name":"PostHogEncoding"}],"title":"PostHogEncoding","roleHeading":"Framework","symbolKind":"module"},"topicSections":[{"title":"Sending to PostHog","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:transport:backoff:clock:)","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSetupError"],"anchor":"Sending-to-PostHog"},{"title":"Encoding batches","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"],"anchor":"Encoding-batches"},{"title":"Records left out","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"],"anchor":"Records-left-out"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":" makes an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"text":") for your PostHog project in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the project token and the host, posts to the host’s ","type":"text"},{"code":"\/batch\/","type":"codeVoice"},{"text":" with a ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","isActive":true,"type":"reference"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"splits each batch to PostHog’s limits (","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":"). A batch with no","type":"text"},{"text":" ","type":"text"},{"text":"record the encoder can write, an empty one included, makes no request. It retries no response, a","type":"text"},{"text":" ","type":"text"},{"text":"5xx, 408 and 429, and drops and reports any other status. The project token goes in","type":"text"},{"text":" ","type":"text"},{"text":"the body, so no header field is needed, and no trace context is sent. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves","type":"text"},{"text":" ","type":"text"},{"text":"this module out; import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each record becomes an anonymous event. Its ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":" is the record’s session, from the","type":"text"},{"text":" ","type":"text"},{"text":"sessions enricher, also sent as ","type":"text"},{"type":"codeVoice","code":"$session_id"},{"text":"; a record with no session is sent under its own","type":"text"},{"text":" ","type":"text"},{"text":"record identifier. Its ","type":"text"},{"type":"codeVoice","code":"uuid"},{"text":" is the record’s identifier, which a redelivered record keeps. Every","type":"text"},{"text":" ","type":"text"},{"text":"event carries ","type":"text"},{"type":"codeVoice","code":"$process_person_profile: false"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"$geoip_disable: true"},{"text":". The record’s vendor","type":"text"},{"text":" ","type":"text"},{"text":"identifier and trace context aren’t sent, and the standard context is sent as PostHog’s own","type":"text"},{"text":" ","type":"text"},{"text":"properties (","type":"text"},{"type":"codeVoice","code":"$app_version"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$device_model"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$os_name"},{"text":" and the like).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals, and a property whose name starts with"},{"type":"text","text":" "},{"type":"codeVoice","code":"$"},{"type":"text","text":" or is "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" is left out and logged. A record the encoder can’t write is left out and"},{"type":"text","text":" "},{"type":"text","text":"the rest of the batch is sent: one the plan doesn’t describe, one whose event name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one holding a value JSON can’t, one whose timestamp has no"},{"type":"text","text":" "},{"type":"text","text":"ISO 8601 form (NaN, infinite, or more than "},{"type":"codeVoice","code":"Int64.max"},{"type":"text","text":" milliseconds from 1970), and one too large"},{"type":"text","text":" "},{"type":"text","text":"for PostHog’s event limit. The destination reports each as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"reason is a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to TraffluentCollector, use "},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"CollectorEncoding"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"instead."}]},{"type":"codeListing","code":["import HTTPDestinations","import PostHogEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let postHog = try HTTPDestination.postHog(","    projectToken: projectToken,","    host: postHogHost,  \/\/ https:\/\/us.i.posthog.com, https:\/\/eu.i.posthog.com or your own","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: postHog)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"covers what PostHog receives, and why, in more detail."}]}]}],"references":{"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder":{"title":"PostHogBatchEncoder","abstract":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of PostHog’s batch capture API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" ","type":"text"},{"text":"can send events to PostHog Cloud or a self-hosted PostHog’s ","type":"text"},{"type":"codeVoice","code":"POST \/batch\/"},{"text":".","type":"text"}],"url":"\/documentation\/posthogencoding\/posthogbatchencoder","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PostHogBatchEncoder"}]},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogEncodingError":{"title":"PostHogEncodingError","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","type":"reference","isActive":true},{"text":" couldn’t send a record, which it leaves out of the batch’s requests","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no record of","type":"text"},{"text":" ","type":"text"},{"text":"a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"url":"\/documentation\/posthogencoding\/posthogencodingerror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogEncodingError","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","role":"symbol","navigatorTitle":[{"text":"PostHogEncodingError","kind":"identifier"}]},"doc://PostHogEncoding/documentation/PostHogEncoding/HTTPDestinations/HTTPDestination/postHog(projectToken:host:plan:transport:backoff:clock:)":{"title":"postHog(projectToken:host:plan:transport:backoff:clock:)","conformance":{"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"HTTPTransport"},{