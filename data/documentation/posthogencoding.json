{"hierarchy":{"paths":[[]]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/posthogencoding"]}],"metadata":{"externalID":"PostHogEncoding","roleHeading":"Framework","symbolKind":"module","title":"PostHogEncoding","role":"collection","modules":[{"name":"PostHogEncoding"}]},"topicSections":[{"anchor":"Sending-to-PostHog","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:transport:backoff:clock:)","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSetupError"],"title":"Sending to PostHog"},{"anchor":"Encoding-batches","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"],"title":"Encoding batches"},{"anchor":"Records-left-out","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"],"title":"Records left out"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding"},"abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","isActive":true,"type":"reference"},{"type":"text","text":" makes an"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"type":"text","text":") for your PostHog project in one call. It checks"},{"type":"text","text":" "},{"type":"text","text":"the project token and the host, posts to the host’s "},{"code":"\/batch\/","type":"codeVoice"},{"type":"text","text":" with a "},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"splits each batch to PostHog’s limits ("},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"type":"text","text":"). A batch with no"},{"type":"text","text":" "},{"type":"text","text":"record the encoder can write, an empty one included, makes no request. It retries no response, a"},{"type":"text","text":" "},{"type":"text","text":"5xx, 408 and 429, and drops and reports any other status. The project token goes in"},{"type":"text","text":" "},{"type":"text","text":"the body, so no header field is needed, and no trace context is sent. "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" leaves"},{"type":"text","text":" "},{"type":"text","text":"this module out; import it on its own."}],"type":"paragraph"},{"inlineContent":[{"text":"Each record becomes an anonymous event. Its ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":" is the record’s session, from the","type":"text"},{"text":" ","type":"text"},{"text":"sessions enricher, also sent as ","type":"text"},{"code":"$session_id","type":"codeVoice"},{"text":"; a record with no session is sent under its own","type":"text"},{"text":" ","type":"text"},{"text":"record identifier. Its ","type":"text"},{"code":"uuid","type":"codeVoice"},{"text":" is the record’s identifier, which a redelivered record keeps. Every","type":"text"},{"text":" ","type":"text"},{"text":"event carries ","type":"text"},{"code":"$process_person_profile: false","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"$geoip_disable: true","type":"codeVoice"},{"text":". The record’s vendor","type":"text"},{"text":" ","type":"text"},{"text":"identifier and trace context aren’t sent, and the standard context is sent as PostHog’s own","type":"text"},{"text":" ","type":"text"},{"text":"properties (","type":"text"},{"code":"$app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$device_model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_name","type":"codeVoice"},{"text":" and the like).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"code":"TrackingPlan","type":"codeVoice"},{"type":"text","text":" the encoder is made with. A"},{"type":"text","text":" "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is never sent, whatever the record reveals, and a property whose name starts with"},{"type":"text","text":" "},{"code":"$","type":"codeVoice"},{"type":"text","text":" or is "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":" is left out and logged. A record the encoder can’t write is left out and"},{"type":"text","text":" "},{"type":"text","text":"the rest of the batch is sent: one the plan doesn’t describe, one whose event name starts with "},{"code":"$","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"one whose event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one holding a value JSON can’t, and one too large for PostHog’s"},{"type":"text","text":" "},{"type":"text","text":"event limit. The destination reports each as "},{"code":"HTTPDropReport.skipped(_:)","type":"codeVoice"},{"type":"text","text":", a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"reason is a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To send to TraffluentCollector, use "},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"CollectorEncoding"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"},{"code":["import HTTPDestinations","import PostHogEncoding","import TrackingPlans","","let plan = try TrackingPlan(schemas: [SignedUp.schema, SessionStarted.schema, SessionEnded.schema])","let postHog = try HTTPDestination.postHog(","    projectToken: projectToken,","    host: postHogHost,  \/\/ https:\/\/us.i.posthog.com, https:\/\/eu.i.posthog.com or your own","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: postHog)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers what PostHog receives, and why, in more detail."}],"type":"paragraph"}]}],"references":{"doc://PostHogEncoding/documentation/PostHogEncoding/HTTPDestinations/HTTPDestination/postHog(projectToken:host:plan:transport:backoff:clock:)":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A destination that sends batches to the PostHog project of "},{"code":"projectToken","type":"codeVoice"},{"type":"text","text":" at "},{"code":"host","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"through "},{"code":"transport","type":"codeVoice"},{"type":"text","text":", retrying a send that fails for now with the waits of "},{"code":"backoff","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"clock","type":"codeVoice"},{"t