{"metadata":{"roleHeading":"Framework","symbolKind":"module","title":"PostHogEncoding","role":"collection","modules":[{"name":"PostHogEncoding"}],"externalID":"PostHogEncoding"},"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","interfaceLanguage":"swift"},"abstract":[{"text":"Write batches of records for PostHog’s batch capture API, for an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" to send.","type":"text"}],"topicSections":[{"anchor":"Encoding-batches","title":"Encoding batches","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatch"]},{"anchor":"Records-left-out","title":"Records left out","identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/posthogencoding"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" for PostHog Cloud’s or a self-hosted PostHog’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/batch\/"},{"type":"text","text":". Give it to an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":") as its encoder, with"},{"type":"text","text":" "},{"type":"text","text":"your instance’s "},{"type":"codeVoice","code":"\/batch\/"},{"type":"text","text":" URL. The project token goes in the body, so no header field is needed."},{"type":"text","text":" "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves this module out; import it on its own."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each record becomes an anonymous event. Its "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" is the record’s session, from the"},{"type":"text","text":" "},{"type":"text","text":"sessions enricher, also sent as "},{"type":"codeVoice","code":"$session_id"},{"type":"text","text":"; a record with no session is sent under its own"},{"type":"text","text":" "},{"type":"text","text":"record identifier. Its "},{"type":"codeVoice","code":"uuid"},{"type":"text","text":" is the record’s identifier, which a redelivered record keeps. Every"},{"type":"text","text":" "},{"type":"text","text":"event carries "},{"type":"codeVoice","code":"$process_person_profile: false"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$geoip_disable: true"},{"type":"text","text":". The record’s vendor"},{"type":"text","text":" "},{"type":"text","text":"identifier and trace context aren’t sent, and the standard context is sent as PostHog’s own"},{"type":"text","text":" "},{"type":"text","text":"properties ("},{"type":"codeVoice","code":"$app_version"},{"type":"text","text":", "},{"type":"codeVoice","code":"$device_model"},{"type":"text","text":", "},{"type":"codeVoice","code":"$os_name"},{"type":"text","text":" and the like)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals, and a property whose name starts with"},{"type":"text","text":" "},{"type":"codeVoice","code":"$"},{"type":"text","text":" or is "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" is left out and logged. A record the encoder can’t write is left out and"},{"type":"text","text":" "},{"type":"text","text":"the rest of the batch is sent: one the plan doesn’t describe, one whose event name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" and one holding a value JSON can’t."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batch(of:)"},{"type":"text","text":" returns each as a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"To send to TraffluentCollector, use ","type":"text"},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"text":" (module ","type":"text"},{"type":"codeVoice","code":"CollectorEncoding"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}]},{"code":["import HTTPDestinations","import Instrumentation","import PostHogEncoding","import TrackingPlans","","let plan = try TrackingPlan(schemas: [SignedUp.schema, SessionStarted.schema, SessionEnded.schema])","let encoder = PostHogBatchEncoder(projectToken: projectToken, plan: plan)","let postHog = HTTPDestination(","    endpoint: postHogBatchURL,  \/\/ https:\/\/us.i.posthog.com\/batch\/, https:\/\/eu.i.posthog.com\/batch\/ or your own","    instrument: NoOpInstrument(),  \/\/ so no trace context goes to PostHog in the header fields","    encoder: encoder)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: postHog)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what PostHog receives, and why, in more detail."}]}]}],"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogEncodingError":{"title":"PostHogEncodingError","navigatorTitle":[{"text":"PostHogEncodingError","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","abstract":[{"text":"Why ","type":"text"},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","isActive":true},{"text":" couldn’t encode a record, which it leaves out of the batch’s body","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord","isActive":true},{"text":". When it can encode no record of a batch,","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)","isActive":true},{"text":" throws the first one’s, and ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing","type":"text"},{"text":" ","type":"text"},{"text":"for the batch and logs the error.","type":"text"}],"url":"\/documentation\/posthogencoding\/posthogencodingerror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogEncodingError","kind":"identifier"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"text":"Send each batch of records to an HTTP end