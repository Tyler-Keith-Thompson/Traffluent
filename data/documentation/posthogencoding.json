tHogEncodingError"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder":{"navigatorTitle":[{"kind":"identifier","text":"PostHogBatchEncoder"}],"abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" of PostHog’s batch capture API, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"can send events to PostHog Cloud or a self-hosted PostHog’s "},{"code":"POST \/batch\/","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","title":"PostHogBatchEncoder","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"type":"topic","kind":"symbol","url":"\/documentation\/posthogencoding\/posthogbatchencoder"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogSetupError":{"type":"topic","abstract":[{"type":"text","text":"Why "},{"isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:transport:backoff:clock:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogSetupError","kind":"identifier"}],"title":"PostHogSetupError","navigatorTitle":[{"text":"PostHogSetupError","kind":"identifier"}],"url":"\/documentation\/posthogencoding\/posthogsetuperror","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSetupError"}}}