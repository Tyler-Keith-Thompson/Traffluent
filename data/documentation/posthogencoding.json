text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no record of","type":"text"},{"text":" ","type":"text"},{"text":"a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","url":"\/documentation\/posthogencoding\/posthogencodingerror"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogSetupError":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSetupError","kind":"symbol","type":"topic","url":"\/documentation\/posthogencoding\/posthogsetuperror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogSetupError","kind":"identifier"}],"abstract":[{"type":"text","text":"Why "},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:transport:backoff:clock:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"navigatorTitle":[{"text":"PostHogSetupError","kind":"identifier"}],"role":"symbol","title":"PostHogSetupError"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"kind":"symbol","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","url":"\/documentation\/posthogencoding\/posthogbatchencoder","title":"PostHogBatchEncoder","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of PostHog’s batch capture API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"t