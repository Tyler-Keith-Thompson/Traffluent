sActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSkippedRecord"},{"type":"text","text":". When it can encode no record of a batch,"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/encode(_:)"},{"type":"text","text":" throws the first one’s, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing"},{"type":"text","text":" "},{"type":"text","text":"for the batch and logs the error."}],"type":"topic"}}}