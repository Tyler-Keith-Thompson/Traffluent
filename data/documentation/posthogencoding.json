{"abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","hierarchy":{"paths":[[]]},"metadata":{"role":"collection","modules":[{"name":"PostHogEncoding"}],"title":"PostHogEncoding","externalID":"PostHogEncoding","roleHeading":"Framework","symbolKind":"module"},"topicSections":[{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:transport:backoff:clock:)","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSetupError"],"anchor":"Sending-to-PostHog","title":"Sending to PostHog"},{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"],"anchor":"Encoding-batches","title":"Encoding batches"},{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"],"anchor":"Records-left-out","title":"Records left out"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","isActive":true,"type":"reference"},{"text":" makes an","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"text":") for your PostHog project in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the project token and the host, posts to the host’s ","type":"text"},{"code":"\/batch\/","type":"codeVoice"},{"text":" with a ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","isActive":true,"type":"reference"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"splits each batch to PostHog’s limits (","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":"). A batch with no","type":"text"},{"text":" ","type":"text"},{"text":"record the encoder can write, an empty one included, makes no request. It retries no response, a","type":"text"},{"text":" ","type":"text"},{"text":"5xx, 408 and 429, and drops and reports any other status. The project token goes in","type":"text"},{"text":" ","type":"text"},{"text":"the body, so no header field is needed, and no trace context is sent. ","type":"text"},{"code":"import Traffluent","type":"codeVoice"},{"text":" leaves","type":"text"},{"text":" ","type":"text"},{"text":"this module out; import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each record becomes an anonymous event. Its ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":" is the record’s session, from the","type":"text"},{"text":" ","type":"text"},{"text":"sessions enricher, also sent as ","type":"text"},{"code":"$session_id","type":"codeVoice"},{"text":"; a record with no session is sent under its own","type":"text"},{"text":" ","type":"text"},{"text":"record identifier. Its ","type":"text"},{"code":"uuid","type":"codeVoice"},{"text":" is the record’s identifier, which a redelivered record keeps. Every","type":"text"},{"text":" ","type":"text"},{"text":"event carries ","type":"text"},{"code":"$process_person_profile: false","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"$geoip_disable: true","type":"codeVoice"},{"text":". The record’s vendor","type":"text"},{"text":" ","type":"text"},{"text":"identifier and trace context aren’t sent, and the standard context is sent as PostHog’s own","type":"text"},{"text":" ","type":"text"},{"text":"properties (","type":"text"},{"code":"$app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$device_model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_name","type":"codeVoice"},{"text":" and the like).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals, and a property whose name starts with"},{"type":"text","text":" "},{"type":"codeVoice","code":"$"},{"type":"text","text":" or is "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" is left out and logged. A record the encoder can’t write is left out and"},{"type":"text","text":" "},{"type":"text","text":"the rest of the batch is sent: one the plan doesn’t describe, one whose event name starts with "},{"type":"codeVoice","code":"$"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one holding a value JSON can’t, one whose timestamp has no"},{"type":"text","text":" "},{"type":"text","text":"ISO 8601 form (NaN, infinite, or more than "},{"type":"codeVoice","code":"Int64.max"},{"type":"text","text":" milliseconds from 1970), and one too large"},{"type":"text","text":" "},{"type":"text","text":"for PostHog’s event limit. The destination reports each as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"reason is a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"To send to TraffluentCollector, use ","type":"text"},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"CollectorEncoding","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}]},{"type":"codeListing","code":["import HTTPDestinations","import PostHogEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let postHog = try HTTPDestination.postHog(","    projectToken: projectToken,","    host: postHogHost,  \/\/ https:\/\/us.i.posthog.com, https:\/\/eu.i.posthog.com or your own","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: postHog)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference"},{"text":" ","type":"text"},{"text":"covers what PostHog receives, and why, in more detail.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/posthogencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","interfaceLanguage":"swift"},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","titleInlineContent":[{"text":"Choosing Destinations","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"navigatorTitle":[{"text":"BatchEncoder