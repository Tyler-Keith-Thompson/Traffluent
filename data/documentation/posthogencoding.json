 that sends batches to the PostHog project of "},{"type":"codeVoice","code":"projectToken"},{"type":"text","text":" at "},{"type":"codeVoice","code":"host"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"codeVoice","code":"transport"},{"type":"text","text":", retrying a send that fails for now with the waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"HTTPTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"PostHogBatchEncoder"},{"type":"text","text":"."}]},"title":"postHog(projectToken:host:plan:transport:backoff:clock:)","kind":"symbol","role":"symbol","url":"\/documentation\/posthogencoding\/httpdestinations\/httpdestination\/posthog(projecttoken:host:plan:transport:backoff:clock:)"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogSetupError":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogSetupError"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSetupError","role":"symbol","kind":"symbol","abstract":[{"text":"Why ","type":"text"},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:transport:backoff:clock:)","isActive":true},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"PostHogSetupError"}],"url":"\/documentation\/posthogencoding\/posthogsetuperror","title":"PostHogSetupError","type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"type":"link","title":"Choosing Destinations"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogBatchEncoder"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","role":"symbol","abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of PostHog’s batch capture API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to PostHog Cloud or a self-hosted PostHog’s "},{"type":"codeVoice","code":"POST \/batch\/"},{"type":"text","text":"."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PostHogBatchEncoder"}],"url":"\/documentation\/posthogencoding\/posthogbatchencoder","type":"topic","title":"PostHogBatchEncoder"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/batchLimit":{"abstract":[{"text":"PostHog’s limits on one request: 10,000,000 bytes of body and 1,000,000 bytes of one event,","type":"text"},{"text":" ","type":"text"},{"text":"with no limit on the count of events.","type":"text"}],"title":"batchLimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Propert