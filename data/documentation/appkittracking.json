{"sections":[],"abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use this module to track events from AppKit views and controls on macOS; elsewhere, Mac Catalyst","type":"text"},{"text":" ","type":"text"},{"text":"included, it builds empty. A Mac Catalyst app builds its views with UIKit, so it uses","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and SwiftUI views use","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"AppKit has no environment for views to inherit, so a view finds its tracker the way an action"},{"type":"text","text":" "},{"type":"text","text":"sent to the first responder finds its target. "},{"type":"codeVoice","code":"NSView.tracker"},{"type":"text","text":" asks the view’s responder"},{"type":"text","text":" "},{"type":"text","text":"chain (the view, its superviews and their view controllers, its window and window controller),"},{"type":"text","text":" "},{"type":"text","text":"then the window’s delegate and the application’s delegate, and takes the tracker of the first one"},{"type":"text","text":" "},{"type":"text","text":"that conforms to "},{"type":"codeVoice","code":"TrackerProviding"},{"type":"text","text":". It looks again each time it is read, so a view moved to"},{"type":"text","text":" "},{"type":"text","text":"another window tracks through that window’s tracker. A view below no provider gets "},{"type":"codeVoice","code":"Tracker.noOp"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which drops every event."}]},{"type":"paragraph","inlineContent":[{"code":"NSControl.track(_:)","type":"codeVoice"},{"type":"text","text":" tracks an event each time a"},{"type":"text","text":" "},{"type":"text","text":"control sends its action, just before the action:"}]},{"type":"codeListing","syntax":"swift","code":["import AppKit","import Traffluent","","@Event","struct ShareTapped {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","final class CartViewController: NSViewController, TrackerProviding {","    let tracker: Tracker","","    init(tracker: Tracker) {","        self.tracker = tracker","        super.init(nibName: nil, bundle: nil)","    }","","    required init?(coder: NSCoder) { nil }","","    override func loadView() {","        let share = NSButton(title: \"Share\", target: self, action: #selector(share(_:)))","        share.track(ShareTapped())  \/\/ after setting the target and action","        let checkOut = NSButton(title: \"Check out\", target: self, action: #selector(checkOut(_:)))","        view = NSStackView(views: [share, checkOut])","    }","","    @objc func share(_ sender: NSButton) {}","","    @objc func checkOut(_ sender: NSButton) {","        sender.tracker.track(CheckoutStarted(cartSize: 3))  \/\/ through this controller's tracker","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"A control has one target and action, so ","type":"text"},{"code":"track(_:)","type":"codeVoice"},{"text":" puts an object of its own in their place,","type":"text"},{"text":" ","type":"text"},{"text":"which tracks the event and then sends the control’s action on to its target. Call it after","type":"text"},{"text":" ","type":"text"},{"text":"setting them; setting them afterwards replaces the tracking.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The guide","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","isActive":true},{"text":" ","type":"text"},{"text":"covers all three frameworks.","type":"text"}]},{"type":"heading","text":"API","level":2,"anchor":"API"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols"},{"type":"text","text":" "},{"type":"text","text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them"},{"type":"text","text":" "},{"type":"text","text":"for an Apple target."}]},{"type":"heading","text":"Finding the tracker","level":3,"anchor":"Finding-the-tracker"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TrackerProviding"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSView.tracker"}]}]}]},{"type":"heading","text":"Tracking controls","level":3,"anchor":"Tracking-controls"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"NSControl.track(_:)","type":"codeVoice"}],"type":"paragraph"}]}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/appkittracking"]}],"metadata":{"modules":[{"name":"AppKitTracking"}],"roleHeading":"Framework","externalID":"AppKitTracking","symbolKind":"module","role":"collection","title":"AppKitTracking"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"title":"SwiftUITracking","titleInlineContent":[{"code":"SwiftUITracking","type":"codeVoice"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","title":"Tracking from SwiftUI, UIKit and AppKit","type":"link","titleInlineContent":[{"text":"Tracking from SwiftUI, UIKit and AppKit","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},"doc://AppKitTracking/documentation/AppKitTracking":{"type":"topic","kind":"symbol","title":"AppKitTracking","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","url":"\/documentation\/appkittracking","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"role":"collection"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/uikittracking":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking","title":"UIKitTracking","type":"link","titleInlineContent":[{"type":"codeVoice","code":"UIKitTracking"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking"}}}