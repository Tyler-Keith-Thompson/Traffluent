{"metadata":{"externalID":"AppKitTracking","symbolKind":"module","role":"collection","modules":[{"name":"AppKitTracking"}],"title":"AppKitTracking","roleHeading":"Framework"},"kind":"symbol","abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/appkittracking"]}],"hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Use this module to track events from AppKit views and controls on macOS; elsewhere, Mac Catalyst","type":"text"},{"text":" ","type":"text"},{"text":"included, it builds empty. A Mac Catalyst app builds its views with UIKit, so it uses","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and SwiftUI views use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"AppKit has no environment for views to inherit, so a view finds its tracker the way an action"},{"type":"text","text":" "},{"type":"text","text":"sent to the first responder finds its target. "},{"type":"codeVoice","code":"NSView.tracker"},{"type":"text","text":" asks the view’s responder"},{"type":"text","text":" "},{"type":"text","text":"chain (the view, its superviews and their view controllers, its window and window controller),"},{"type":"text","text":" "},{"type":"text","text":"then the window’s delegate and the application’s delegate, and takes the tracker of the first one"},{"type":"text","text":" "},{"type":"text","text":"that conforms to "},{"type":"codeVoice","code":"TrackerProviding"},{"type":"text","text":". It looks again each time it is read, so a view moved to"},{"type":"text","text":" "},{"type":"text","text":"another window tracks through that window’s tracker. A view below no provider gets "},{"type":"codeVoice","code":"Tracker.noOp"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which drops every event."}],"type":"paragraph"},{"inlineContent":[{"code":"NSControl.track(_:)","type":"codeVoice"},{"text":" tracks an event each time a","type":"text"},{"text":" ","type":"text"},{"text":"control sends its action, just before the action:","type":"text"}],"type":"paragraph"},{"code":["import AppKit","import Traffluent","","@Event","struct ShareTapped {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","final class CartViewController: NSViewController, TrackerProviding {","    let tracker: Tracker","","    init(tracker: Tracker) {","        self.tracker = tracker","        super.init(nibName: nil, bundle: nil)","    }","","    required init?(coder: NSCoder) { nil }","","    override func loadView() {","        let share = NSButton(title: \"Share\", target: self, action: #selector(share(_:)))","        share.track(ShareTapped())  \/\/ after setting the target and action","        let checkOut = NSButton(title: \"Check out\", target: self, action: #selector(checkOut(_:)))","        view = NSStackView(views: [share, checkOut])","    }","","    @objc func share(_ sender: NSButton) {}","","    @objc func checkOut(_ sender: NSButton) {","        sender.tracker.track(CheckoutStarted(cartSize: 3))  \/\/ through this controller's tracker","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A control has one target and action, so ","type":"text"},{"type":"codeVoice","code":"track(_:)"},{"text":" puts an object of its own in their place,","type":"text"},{"text":" ","type":"text"},{"text":"which tracks the event and then sends the control’s action on to its target. Call it after","type":"text"},{"text":" ","type":"text"},{"text":"setting them; setting them afterwards replaces the tracking.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}],"type":"paragraph"},{"text":"API","anchor":"API","level":2,"type":"heading"},{"inlineContent":[{"text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols","type":"text"},{"text":" ","type":"text"},{"text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them","type":"text"},{"text":" ","type":"text"},{"text":"for an Apple target.","type":"text"}],"type":"paragraph"},{"text":"Finding the tracker","anchor":"Finding-the-tracker","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"code":"TrackerProviding","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSView.tracker"}]}]}],"type":"unorderedList"},{"text":"Tracking controls","anchor":"Tracking-controls","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSControl.track(_:)"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://AppKitTracking/documentation/AppKitTracking":{"kind":"symbol","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}],"url":"\/documentation\/appkittracking","type":"topic","role":"collection","title":"AppKitTracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"title":"Tracking from SwiftUI, UIKit and AppKit","type":"link","titleInlineContent":[{"text":"Tracking from SwiftUI, UIKit and AppKit","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/uikittracking":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking","title":"UIKitTracking","titleInlineContent":[{"code":"UIKitTracking","type":"codeVoice"}],"type":"link"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","title":"SwiftUITracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","titleInlineContent":[{"type":"codeVoice","code":"SwiftUITracking"}],"type":"link"}}}