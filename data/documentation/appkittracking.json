{"sections":[],"kind":"symbol","primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"Use this module to track events from AppKit views and controls on macOS; elsewhere, Mac Catalyst","type":"text"},{"text":" ","type":"text"},{"text":"included, it builds empty. A Mac Catalyst app builds its views with UIKit, so it uses","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and SwiftUI views use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"AppKit has no environment for views to inherit, so a view finds its tracker the way an action"},{"type":"text","text":" "},{"type":"text","text":"sent to the first responder finds its target. "},{"type":"codeVoice","code":"NSView.tracker"},{"type":"text","text":" asks the view’s responder"},{"type":"text","text":" "},{"type":"text","text":"chain (the view, its superviews and their view controllers, its window and window controller),"},{"type":"text","text":" "},{"type":"text","text":"then the window’s delegate and the application’s delegate, and takes the tracker of the first one"},{"type":"text","text":" "},{"type":"text","text":"that conforms to "},{"type":"codeVoice","code":"TrackerProviding"},{"type":"text","text":". It looks again each time it is read, so a view moved to"},{"type":"text","text":" "},{"type":"text","text":"another window tracks through that window’s tracker. A view below no provider gets "},{"type":"codeVoice","code":"Tracker.noOp"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which drops every event."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"NSControl.track(_:)"},{"type":"text","text":" tracks an event each time a"},{"type":"text","text":" "},{"type":"text","text":"control sends its action, just before the action:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import AppKit","import Traffluent","","@Event","struct ShareTapped {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","final class CartViewController: NSViewController, TrackerProviding {","    let tracker: Tracker","","    init(tracker: Tracker) {","        self.tracker = tracker","        super.init(nibName: nil, bundle: nil)","    }","","    required init?(coder: NSCoder) { nil }","","    override func loadView() {","        let share = NSButton(title: \"Share\", target: self, action: #selector(share(_:)))","        share.track(ShareTapped())  \/\/ after setting the target and action","        let checkOut = NSButton(title: \"Check out\", target: self, action: #selector(checkOut(_:)))","        view = NSStackView(views: [share, checkOut])","    }","","    @objc func share(_ sender: NSButton) {}","","    @objc func checkOut(_ sender: NSButton) {","        sender.tracker.track(CheckoutStarted(cartSize: 3))  \/\/ through this controller's tracker","    }","}"]},{"inlineContent":[{"type":"text","text":"A control has one target and action, so "},{"type":"codeVoice","code":"track(_:)"},{"type":"text","text":" puts an object of its own in their place,"},{"type":"text","text":" "},{"type":"text","text":"which tracks the event and then sends the control’s action on to its target. Call it after"},{"type":"text","text":" "},{"type":"text","text":"setting them; setting them afterwards replaces the tracking."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}],"type":"paragraph"},{"level":2,"anchor":"API","type":"heading","text":"API"},{"inlineContent":[{"text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols","type":"text"},{"text":" ","type":"text"},{"text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them","type":"text"},{"text":" ","type":"text"},{"text":"for an Apple target.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Finding-the-tracker","type":"heading","text":"Finding the tracker"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TrackerProviding"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NSView.tracker","type":"codeVoice"}]}]}]},{"level":3,"anchor":"Tracking-controls","type":"heading","text":"Tracking controls"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"NSControl.track(_:)","type":"codeVoice"}]}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/appkittracking"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"module","title":"AppKitTracking","roleHeading":"Framework","role":"collection","externalID":"AppKitTracking","modules":[{"name":"AppKitTracking"}]},"abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/uikittracking":{"type":"link","titleInlineContent":[{"type":"codeVoice","code":"UIKitTracking"}],"title":"UIKitTracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"title":"Tracking from SwiftUI, UIKit and AppKit","type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","titleInlineContent":[{"text":"Tracking from SwiftUI, UIKit and AppKit","type":"text"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},"doc://AppKitTracking/documentation/AppKitTracking":{"title":"AppKitTracking","kind":"symbol","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"role":"collection","url":"\/documentation\/appkittracking","type":"topic","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"title":"SwiftUITracking","type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","titleInlineContent":[{"code":"SwiftUITracking","type":"codeVoice"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"}}}