{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use this module to track events from AppKit views and controls on macOS; elsewhere, Mac Catalyst"},{"type":"text","text":" "},{"type":"text","text":"included, it builds empty. A Mac Catalyst app builds its views with UIKit, so it uses"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and SwiftUI views use"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"AppKit has no environment for views to inherit, so a view finds its tracker the way an action","type":"text"},{"text":" ","type":"text"},{"text":"sent to the first responder finds its target. ","type":"text"},{"type":"codeVoice","code":"NSView.tracker"},{"text":" asks the view’s responder","type":"text"},{"text":" ","type":"text"},{"text":"chain (the view, its superviews and their view controllers, its window and window controller),","type":"text"},{"text":" ","type":"text"},{"text":"then the window’s delegate and the application’s delegate, and takes the tracker of the first one","type":"text"},{"text":" ","type":"text"},{"text":"that conforms to ","type":"text"},{"type":"codeVoice","code":"TrackerProviding"},{"text":". It looks again each time it is read, so a view moved to","type":"text"},{"text":" ","type":"text"},{"text":"another window tracks through that window’s tracker. A view below no provider tracks through the","type":"text"},{"text":" ","type":"text"},{"text":"tracker ","type":"text"},{"type":"codeVoice","code":"Tracker.bootstrap"},{"text":" made the process’s default, and with none it drops each event, warning","type":"text"},{"text":" ","type":"text"},{"text":"once per call site.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"NSControl.track(_:)","type":"codeVoice"},{"type":"text","text":" tracks an event each time a"},{"type":"text","text":" "},{"type":"text","text":"control sends its action, just before the action:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import AppKit","import Traffluent","","@Event","struct ShareTapped {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","final class CartViewController: NSViewController, TrackerProviding {","    let tracker: Tracker","","    init(tracker: Tracker) {","        self.tracker = tracker","        super.init(nibName: nil, bundle: nil)","    }","","    required init?(coder: NSCoder) { nil }","","    override func loadView() {","        let share = NSButton(title: \"Share\", target: self, action: #selector(share(_:)))","        share.track(ShareTapped())  \/\/ after setting the target and action","        let checkOut = NSButton(title: \"Check out\", target: self, action: #selector(checkOut(_:)))","        view = NSStackView(views: [share, checkOut])","    }","","    @objc func share(_ sender: NSButton) {}","","    @objc func checkOut(_ sender: NSButton) {","        sender.tracker.track(CheckoutStarted(cartSize: 3))  \/\/ through this controller's tracker","    }","}"]},{"inlineContent":[{"type":"text","text":"A control has one target and action, so "},{"type":"codeVoice","code":"track(_:)"},{"type":"text","text":" puts an object of its own in their place,"},{"type":"text","text":" "},{"type":"text","text":"which tracks the event and then sends the control’s action on to its target. Call it after"},{"type":"text","text":" "},{"type":"text","text":"setting them; setting them afterwards replaces the tracking."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}],"type":"paragraph"},{"text":"API","anchor":"API","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols"},{"type":"text","text":" "},{"type":"text","text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them"},{"type":"text","text":" "},{"type":"text","text":"for an Apple target."}],"type":"paragraph"},{"text":"Finding the tracker","anchor":"Finding-the-tracker","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"TrackerProviding"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSView.tracker"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Tracking controls","anchor":"Tracking-controls","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"code":"NSControl.track(_:)","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/appkittracking"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},"metadata":{"symbolKind":"module","modules":[{"name":"AppKitTracking"}],"roleHeading":"Framework","role":"collection","title":"AppKitTracking","externalID":"AppKitTracking"},"hierarchy":{"paths":[[]]},"abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}],"kind":"symbol","references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"type":"link","titleInlineContent":[{"type":"text","text":"Tracking from SwiftUI, UIKit and AppKit"}],"title":"Tracking from SwiftUI, UIKit and AppKit","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","title":"SwiftUITracking","titleInlineContent":[{"type":"codeVoice","code":"SwiftUITracking"}]},"doc://AppKitTracking/documentation/AppKitTracking":{"url":"\/documentation\/appkittracking","title":"AppKitTracking","type":"topic","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Let AppKit views find their tracker up the responder chain, and track what controls do."}],"identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/uikittracking":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking","title":"UIKitTracking","titleInlineContent":[{"type":"codeVoice","code":"UIKitTracking"}]}}}