:"codeListing"},{"inlineContent":[{"text":"A tracker checks the event on its worker before anything else and rejects one whose property","type":"text"},{"text":" ","type":"text"},{"text":"breaks a constraint, reporting it on ","type":"text"},{"code":"Tracker.rejectionReports","type":"codeVoice"},{"text":". An optional property’s","type":"text"},{"text":" ","type":"text"},{"text":"constraints apply only when it holds a value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each argument is a keyword written out with literals, so the macro checks it as it expands:","type":"text"},{"text":" ","type":"text"},{"code":".minLength","type":"codeVoice"},{"text":", ","type":"text"},{"code":".maxLength","type":"codeVoice"},{"text":", ","type":"text"},{"code":".minItems","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".maxItems","type":"codeVoice"},{"text":" take a non-negative integer,","type":"text"},{"text":" ","type":"text"},{"code":".minimum","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".maximum","type":"codeVoice"},{"text":" a number, and ","type":"text"},{"code":".pattern","type":"codeVoice"},{"text":" a regular expression that compiles and an","type":"text"},{"text":" ","type":"text"},{"text":"example it matches. A lower bound above its upper bound, or an example another keyword of the","type":"text"},{"text":" ","type":"text"},{"text":"property rejects, is a compile error. So is a keyword that doesn’t apply to the property’s","type":"text"},{"text":" ","type":"text"},{"text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,","type":"text"},{"text":" ","type":"text"},{"text":"arrays the counts. A ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" property takes none, as checking it would reveal","type":"text"},{"text":" ","type":"text"},{"text":"it; give it a ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true,"type":"reference"},{"text":" value instead, whose rule its type enforces. The attribute","type":"text"},{"text":" ","type":"text"},{"text":"anywhere but on a stored instance property of an ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct is an error.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"variants":[{"paths":["\/documentation\/eventmacros\/constrained(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"kind":"symbol","sections":[],"references":{"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"kind":"symbol","role":"symbol","abstract":[{"text":"Declares the constraints a stored property of an ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" struct satisfies, which ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" ","type":"text"},{"text":"checks and lists in the event’s schema.","type":"text"}],"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events17ValidationKeywordO","text":"ValidationKeyword"},{"kind":"text","text":"...)"}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"topic","title":"Constrained(_:)","url":"\/documentation\/eventmacros\/constrained(_:)"},"doc://Events/documentation/Events/Refined":{"url":"\/documentation\/events\/refined","fragments":[{"text":"stru