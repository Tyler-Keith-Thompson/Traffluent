swift"]}]},{"kind":"parameters","parameters":[{"name":"constraints","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The keywords, checked in order."}]}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"syntax":"swift","code":["@Event","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0), .maximum(100))","    var resultCount: Int","    @Constrained(.pattern(\"^[a-z]{2}-[A-Z]{2}$\", example: \"en-GB\"))","    var locale: String?","    @Constrained(.minItems(1))","    var filters: [String]","}"],"type":"codeListing"},{"inlineContent":[{"text":"A tracker checks the event on its worker before anything else and rejects one whose property","type":"text"},{"text":" ","type":"text"},{"text":"breaks a constraint, reporting it on ","type":"text"},{"code":"Tracker.rejectionReports","type":"codeVoice"},{"text":". An optional property’s","type":"text"},{"text":" ","type":"text"},{"text":"constraints apply only when it holds a value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each argument is a keyword written out with literals, so the macro checks it as it expands:"},{"type":"text","text":" "},{"code":".minLength","type":"codeVoice"},{"type":"text","text":", "},{"code":".maxLength","type":"codeVoice"},{"type":"text","text":", "},{"code":".minItems","type":"codeVoice"},{"type":"text","text":" and "},{"code":".maxItems","type":"codeVoice"},{"type":"text","text":" take a non-negative integer,"},{"type":"text","text":" "},{"code":".minimum","type":"codeVoice"},{"type":"text","text":" and "},{"code":".maximum","type":"codeVoice"},{"type":"text","text":" a number, and "},{"code":".pattern","type":"codeVoice"},{"type":"text","text":" a regular expression that compiles and an"},{"type":"text","text":" "},{"type":"text","text":"example it matches. A lower bound above its upper bound, or an example another keyword of the"},{"type":"text","text":" "},{"type":"text","text":"property rejects, is a compile error. So is a keyword that doesn’t apply to the property’s"},{"type":"text","text":" "},{"type":"text","text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,"},{"type":"text","text":" "},{"type":"text","text":"arrays the counts. A "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"type":"text","text":" property takes none, as checking it would reveal"},{"type":"text","text":" "},{"type":"text","text":"it; give it a "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","type":"reference","isActive":true},{"type":"text","text":" value instead, whose rule its type enforces. The attribute"},{"type":"text","text":" "},{"type":"text","text":"anywhere but on a stored instance property of an "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" struct is an error."}],"type":"paragraph"}]}],"references":{"doc://EventMacros/documentation/EventMacros":{"type":"topic","abstract":[],"url":"\/documentation\/eventmacros","kind":"symbol","title":"EventMacros","role":"collection","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","kind":"symbol","url":"\/documentation\/eventmacros\/constrained(_:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO"},{"kind":"text","text":"...)"}],"title":"Constrained(_:)"},"doc://Events/documentation/Events/Sensitive":{"type":"topic","kind":"symbol","url":"\/documentation\/events\/sensitive","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"title":"Sensitive","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},"doc://Events/documentation/Events/Refined":{"type":"topic","url":"\/documentation\/events\/refined","abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"type":"codeVoice","code":"Rule"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}],"title":"Refined","navigatorTitle":[{"text":"Refined","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},"doc://Events/documentation/Events/ValidationKeyword":{"identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","navigatorTitle":[{"text":"ValidationKeyword","kind":"identifier"}],"abstract":[{"type":"text","text":"A rule a property’s value must satisfy, as one of JSON Schema’s validation keywords (draft"},{"type":"text","text":" "},{"type":"text","text":"2020-12): a bound on a string’s length, on a number, or on an array’s count, or a pattern a"},{"type":"text","text":" "},{"type":"text","text":"string matches."}],"url":"\/documentation\/events\/validationkeyword","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ValidationKeyword","kind":"identifier"}],"title":"ValidationKeyword","role":"symbol","type":"topic","kind":"symbol"}}}