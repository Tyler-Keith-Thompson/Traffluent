{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(peer) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"constraints","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO","kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword"},{"text":"...)","kind":"text"}]}]},{"parameters":[{"name":"constraints","content":[{"inlineContent":[{"text":"The keywords, checked in order.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"codeListing","code":["@Event","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0), .maximum(100))","    var resultCount: Int","    @Constrained(.pattern(\"^[a-z]{2}-[A-Z]{2}$\", example: \"en-GB\"))","    var locale: String?","    @Constrained(.minItems(1))","    var filters: [String]","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"A tracker checks the event on its worker before anything else and rejects one whose property"},{"type":"text","text":" "},{"type":"text","text":"breaks a constraint, reporting it on "},{"type":"codeVoice","code":"Tracker.rejectionReports"},{"type":"text","text":". An optional property’s"},{"type":"text","text":" "},{"type":"text","text":"constraints apply only when it holds a value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each argument is a keyword written out with literals, so the macro checks it as it expands:"},{"type":"text","text":" "},{"type":"codeVoice","code":".minLength"},{"type":"text","text":", "},{"type":"codeVoice","code":".maxLength"},{"type":"text","text":", "},{"type":"codeVoice","code":".minItems"},{"type":"text","text":" and "},{"type":"codeVoice","code":".maxItems"},{"type":"text","text":" take a non-negative integer,"},{"type":"text","text":" "},{"type":"codeVoice","code":".minimum"},{"type":"text","text":" and "},{"type":"codeVoice","code":".maximum"},{"type":"text","text":" a number, and "},{"type":"codeVoice","code":".pattern"},{"type":"text","text":" a regular expression that compiles and an"},{"type":"text","text":" "},{"type":"text","text":"example it matches. A lower bound above its upper bound, or an example another keyword of the"},{"type":"text","text":" "},{"type":"text","text":"property rejects, is a compile error. So is a keyword that doesn’t apply to the property’s"},{"type":"text","text":" "},{"type":"text","text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,"},{"type":"text","text":" "},{"type":"text","text":"arrays the counts. A "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" property takes none, as checking it would reveal"},{"type":"text","text":" "},{"type":"text","text":"it; give it a "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true},{"type":"text","text":" value instead, whose rule its type enforces. The attribute"},{"type":"text","text":" "},{"type":"text","text":"anywhere but on a stored instance property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct is an error."}],"type":"paragraph"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)"},"abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" struct satisfies, which "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"variants":[{"paths":["\/documentation\/eventmacros\/constrained(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"externalID":"s:11EventMacros11Constrainedyy6Events17ValidationKeywordOd_tcfm","title":"Constrained(_:)","modules":[{"name":"EventMacros"}],"symbolKind":"macro","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L97","fileName":"Event.swift"},"roleHeading":"Macro","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO","kind":"typeIdentifier"},{"text":"...)","kind":"text"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"references":{"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"url":"\/documentation\/eventmacros\/constrained(_:)","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","title":"Constrained(_:)","abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Events17ValidationKeywordO","text":"ValidationKeyword","kind":"typeIdentifier"},{"text":"...)","kind":"text"}]},"doc://EventMacros/documentation/EventMacros":{"type":"topic","url":"\/documentation\/eventmacros","kind":"symbol