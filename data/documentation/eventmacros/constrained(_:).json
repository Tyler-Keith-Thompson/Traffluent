{"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)"},"kind":"symbol","metadata":{"modules":[{"name":"EventMacros"}],"externalID":"s:11EventMacros11Constrainedyy6Events17ValidationKeywordOd_tcfm","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L153","fileName":"Event.swift"},"roleHeading":"Macro","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO","kind":"typeIdentifier"},{"text":"...)","kind":"text"}],"title":"Constrained(_:)","symbolKind":"macro"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" struct satisfies, which "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(peer) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"constraints"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","kind":"typeIdentifier","text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO"},{"kind":"text","text":"...)"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"constraints","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The keywords, checked in order."}]}]}],"kind":"parameters"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"syntax":"swift","code":["@Event","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0), .maximum(100))","    var resultCount: Int","    @Constrained(.pattern(\"^[a-z]{2}-[A-Z]{2}$\", example: \"en-GB\"))","    var locale: String?","    @Constrained(.minItems(1))","    var filters: [String]","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A tracker checks the event on its worker before anything else and rejects one whose property"},{"type":"text","text":" "},{"type":"text","text":"breaks a constraint, reporting it on "},{"type":"codeVoice","code":"Tracker.rejectionReports"},{"type":"text","text":". An optional property’s"},{"type":"text","text":" "},{"type":"text","text":"constraints apply only when it holds a value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each argument is a keyword written out with literals, so the macro checks it as it expands:"},{"type":"text","text":" "},{"type":"codeVoice","code":".minLength"},{"type":"text","text":", "},{"type":"codeVoice","code":".maxLength"},{"type":"text","text":", "},{"type":"codeVoice","code":".minItems"},{"type":"text","text":" and "},{"type":"codeVoice","code":".maxItems"},{"type":"text","text":" take a non-negative integer,"},{"type":"text","text":" "},{"type":"codeVoice","code":".minimum"},{"type":"text","text":" and "},{"type":"codeVoice","code":".maximum"},{"type":"text","text":" a number, and "},{"type":"codeVoice","code":".pattern"},{"type":"text","text":" a regular expression that compiles and an"},{"type":"text","text":" "},{"type":"text","text":"example it matches. A lower bound above its upper bound, or an example another keyword of the"},{"type":"text","text":" "},{"type":"text","text":"property rejects, is a compile error. So is a keyword that doesn’t apply to the property’s"},{"type":"text","text":" "},{"type":"text","text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,"},{"type":"text","text":" "},{"type":"text","text":"arrays the counts. A "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" property takes none, as checking it would reveal"},{"type":"text","text":" "},{"type":"text","text":"it; give it a "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true},{"type":"text","text":" value instead, whose rule its type enforces. The attribute"},{"type":"text","text":" "},{"type":"text","text":"anywhere but on a stored instance property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct is an error."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/constrained(_:)"]}],"references":{"doc://Events/documentation/Events/Sensitive":{"title":"Sensitive","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"url":"\/documentation\/events\/sensitive","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}]},"doc://Events/documentation/Events/Refined":{"title":"Refined","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}],"url":"\/documentation\/events\/refined","abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"code":"Rule","type":"codeVoice"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"Refined","kind":"identifier"}]},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"title":"Constrained(_:)","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO"},{"kind":"text","text":"...)"}],"url":"\/documentation\/eventmacros\/constrained(_:)","abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" struct satisfies, which "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"kind":"symbol","type":"topic"},"doc://Events/documentation/Events/ValidationKeyword":{"identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","title":"ValidationKeyword","kind":"symbol","abstract":[{"type":"text","text":"A rule a property’s value must satisfy, as one of JSON Schema’s validation keywords (draft"},{"type":"text","text":" "},{"type":"text","text":"2020-12): a bound on a string’s length, on a number, or on an array’s count, or a pattern a"},{"type":"text","text":" "},{"type":"text","text":"string matches."}],"url":"\/documentation\/events\/validationkeyword","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ValidationKeyword","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"ValidationKeyword","kind":"identifier"}],"role":"symbol"},"doc://EventMacros/documentation/EventMacros"