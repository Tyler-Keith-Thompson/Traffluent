rejects, is a compile error. So is a keyword that doesn’t apply to the property’s","type":"text"},{"text":" ","type":"text"},{"text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,","type":"text"},{"text":" ","type":"text"},{"text":"arrays the counts. A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"text":" property takes none, as checking it would reveal","type":"text"},{"text":" ","type":"text"},{"text":"it; give it a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","type":"reference"},{"text":" value instead, whose rule its type enforces. The attribute","type":"text"},{"text":" ","type":"text"},{"text":"anywhere but on a stored instance property of an ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct is an error.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Events/documentation/Events/Sensitive":{"url":"\/documentation\/events\/sensitive","type":"topic","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"title":"Sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}]},"doc://Events/documentation/Events/Refined":{"abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"type":"codeVoice","code":"Rule"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"type":"topic","identifier":"