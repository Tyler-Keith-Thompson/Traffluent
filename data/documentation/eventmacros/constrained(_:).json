{"abstract":[{"text":"Declares the constraints a stored property of an ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" struct satisfies, which ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" ","type":"text"},{"text":"checks and lists in the event’s schema.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)"},"variants":[{"paths":["\/documentation\/eventmacros\/constrained(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"title":"Constrained(_:)","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L196","fileName":"Event.swift"},"modules":[{"name":"EventMacros"}],"roleHeading":"Macro","symbolKind":"macro","externalID":"s:11EventMacros11Constrainedyy6Events17ValidationKeywordOd_tcfm","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO"},{"kind":"text","text":"...)"}]},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(peer) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"constraints"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO","text":"ValidationKeyword"},{"kind":"text","text":"...)"}]}],"kind":"declarations"},{"parameters":[{"name":"constraints","content":[{"inlineContent":[{"type":"text","text":"The keywords, checked in order."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"codeListing","code":["@Event","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0), .maximum(100))","    var resultCount: Int","    @Constrained(.pattern(\"^[a-z]{2}-[A-Z]{2}$\", example: \"en-GB\"))","    var locale: String?","    @Constrained(.minItems(1))","    var filters: [String]","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracker checks the event on its worker before anything else and rejects one whose property"},{"type":"text","text":" "},{"type":"text","text":"breaks a constraint, reporting it on "},{"code":"Tracker.rejectionReports","type":"codeVoice"},{"type":"text","text":". An optional property’s"},{"type":"text","text":" "},{"type":"text","text":"constraints apply only when it holds a value."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each argument is a keyword written out with literals, so the macro checks it as it expands:"},{"type":"text","text":" "},{"type":"codeVoice","code":".minLength"},{"type":"text","text":", "},{"type":"codeVoice","code":".maxLength"},{"type":"text","text":", "},{"type":"codeVoice","code":".minItems"},{"type":"text","text":" and "},{"type":"codeVoice","code":".maxItems"},{"type":"text","text":" take a non-negative integer,"},{"type":"text","text":" "},{"type":"codeVoice","code":".minimum"},{"type":"text","text":" and "},{"type":"codeVoice","code":".maximum"},{"type":"text","text":" a number, and "},{"type":"codeVoice","code":".pattern"},{"type":"text","text":" a regular expression that compiles and an"},{"type":"text","text":" "},{"type":"text","text":"example it matches. A lower bound above its upper bound, or an example another keyword of the"},{"type":"text","text":" "},{"type":"text","text":"property rejects, is a compile error. So is a keyword that doesn’t apply to the property’s"},{"type":"text","text":" "},{"type":"text","text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,"},{"type":"text","text":" "},{"type":"text","text":"arrays the counts. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" property takes none, as checking it would reveal"},{"type":"text","text":" "},{"type":"text","text":"it; give it a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},{"type":"text","text":" value instead, whose rule its type enforces. The attribute"},{"type":"text","text":" "},{"type":"text","text":"anywhere but on a stored instance property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct is an error."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"references":{"doc://Events/documentation/Events/Refined":{"url":"\/documentation\/events\/refined","abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"type":"codeVoice","code":"Rule"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"navigatorTitle":[{"text":"Refined","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}],"title":"Refined"},"doc://Events/documentation/Events/Sensitive":{"navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"url":"\/documentation\/events\/sensitive","title":"Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","kind":"symbol"},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"url":"\/documentation\/eventmacros\/constrained(_:)","abstract":[{"text":"Declares the constraints a stored property of an ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct satisfies, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" ","type":"text"},{"text":"checks and lists in the event’s schema.","type":"text"}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO"},{"kind":"text","text":"...)"}],"title":"Constrained(_:)"},"doc://EventMacros/documentation/EventMacros":{"abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"url":"\/documentation\/eventmacros","title":"EventMacros","role":"collection","type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","kind":"symbol"},"doc://Events/documentation/Events/ValidationKeyword":{"url":"\/documentation\/events\/validationkeyword","abstract":[{"type":"text","text":"A rule a property’s value must satisfy, as one of JSON Schema’s validation keywords (draft"},{"type":"text","text":" "},{"type":"text","text":"2020-12): a bound on a string’s length, on a number, or on an array’s count, or a pattern a"},{"type":"text","text":" "},{"type":"text","text":"string matches.