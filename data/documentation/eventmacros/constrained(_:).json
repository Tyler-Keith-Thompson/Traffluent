type":"text","text":"constraints apply only when it holds a value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each argument is a keyword written out with literals, so the macro checks it as it expands:"},{"type":"text","text":" "},{"type":"codeVoice","code":".minLength"},{"type":"text","text":", "},{"type":"codeVoice","code":".maxLength"},{"type":"text","text":", "},{"type":"codeVoice","code":".minItems"},{"type":"text","text":" and "},{"type":"codeVoice","code":".maxItems"},{"type":"text","text":" take a non-negative integer,"},{"type":"text","text":" "},{"type":"codeVoice","code":".minimum"},{"type":"text","text":" and "},{"type":"codeVoice","code":".maximum"},{"type":"text","text":" a number, and "},{"type":"codeVoice","code":".pattern"},{"type":"text","text":" a regular expression that compiles and an"},{"type":"text","text":" "},{"type":"text","text":"example it matches. A lower bound above its upper bound, or an example another keyword of the"},{"type":"text","text":" "},{"type":"text","text":"property rejects, is a compile error. So is a keyword that doesn’t apply to the property’s"},{"type":"text","text":" "},{"type":"text","text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,"},{"type":"text","text":" "},{"type":"text","text":"arrays the counts. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" property takes none, as checking it would reveal"},{"type":"text","text":" "},{"type":"text","text":"it; give it a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},{"type":"text","text":" value instead, whose rule its type enforces. The attribute"},{"type":"text","text":" "},{"type":"text","text":"anywhere but on a stored instance property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct is an error."}],"type":"paragraph"}],"kind":"content"}]