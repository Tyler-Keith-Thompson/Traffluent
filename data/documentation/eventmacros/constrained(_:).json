nd":"parameters","parameters":[{"name":"constraints","content":[{"inlineContent":[{"type":"text","text":"The keywords, checked in order."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"code":["@Event","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0), .maximum(100))","    var resultCount: Int","    @Constrained(.pattern(\"^[a-z]{2}-[A-Z]{2}$\", example: \"en-GB\"))","    var locale: String?","    @Constrained(.minItems(1))","    var filters: [String]","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A tracker checks the event on its worker before anything else and rejects one whose property"},{"type":"text","text":" "},{"type":"text","text":"breaks a constraint, reporting it on "},{"code":"Tracker.rejectionReports","type":"codeVoice"},{"type":"text","text":". An optional property’s"},{"type":"text","text":" "},{"type":"text","text":"constraints apply only when it holds a value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each argument is a keyword written out with literals, so the macro checks it as it expands:"},{"type":"text","text":" "},{"code":".minLength","type":"codeVoice"},{"type":"text","text":", "},{"code":".maxLength","type":"codeVoice"},{"type":"text","text":", "},{"code":".minItems","type":"codeVoice"},{"type":"text","text":" and "},{"code":".maxItems","type":"codeVoice"},{"type":"text","text":" take a non-negative integer,"},{"type":"text","text":" "},{"code":".minimum","type":"codeVoice"},{"type":"text","text":" and "},{"code":".maximum","type":"codeVoice"},{"type":"text","text":" a number, and "},{"code":".pattern","type":"codeVoice"},{"type":"text","text":" a regular expression that compiles and an"},{"type":"text","text":" "},{"type":"text","text":"example it matches. A lower bound above its upper bound, or an example another keyword of the"},{"type":"text","text":" "},{"type":"text","text":"property rejects, is a compile error. So is a keyword that doesn’t apply to the property’s"},{"type":"text","text":" "},{"type":"text","text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,"},{"type":"text","text":" "},{"type":"text","text":"arrays the counts. A "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"type":"text","text":" property takes none, as checking it would reveal"},{"type":"text","text":" "},{"type":"text","text":"it; give it a "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","type":"reference","isActive":true},{"type":"text","text":" value instead, whose rule its type enforces. The attribute"},{"type":"text","text":" "},{"type":"text","text":"anywhere but on a stored instance property of an "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" struct is an error."}],"type":"paragraph"}]}],"sections":[],"references":{"doc://Events/documentation/Events/ValidationKeyword":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"A rule a property’s value must satisfy, as one of JSON Schema’s validation keywords (draft","type":"text"},{"text":" ","type":"text"},{"text":"2020-12): a bound on a string’s length, on a number, or on an array’s count, or a pattern a","type":"text"},{"text":" ","type":"text"},{"text":"string matches.","type":"text"}],"navigatorTitle":[{"text":"ValidationKeyword","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","url":"\/documentation\/events\/validationkeyword","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ValidationKeyword","kind":"identifier"}],"title":"ValidationKeyword"},"doc://EventMacros/documentation/EventMacros":{"abstract":[],"url":"\/documentation\/eventmacros","role":"collection","kind":"symbol","title":"EventMacros","identifier":"doc:\/\/Event