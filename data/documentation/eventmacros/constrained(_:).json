ameters":[{"name":"constraints","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The keywords, checked in order."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"syntax":"swift","code":["@Event","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0), .maximum(100))","    var resultCount: Int","    @Constrained(.pattern(\"^[a-z]{2}-[A-Z]{2}$\", example: \"en-GB\"))","    var locale: String?","    @Constrained(.minItems(1))","    var filters: [String]","}"],"type":"codeListing"},{"inlineContent":[{"text":"A tracker checks the event on its worker before anything else and rejects one whose property","type":"text"},{"text":" ","type":"text"},{"text":"breaks a constraint, reporting it on ","type":"text"},{"code":"Tracker.rejectionReports","type":"codeVoice"},{"text":". An optional property’s","type":"text"},{"text":" ","type":"text"},{"text":"constraints apply only when it holds a value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each argument is a keyword written out with literals, so the macro checks it as it expands:"},{"type":"text","text":" "},{"code":".minLength","type":"codeVoice"},{"type":"text","text":", "},{"code":".maxLength","type":"codeVoice"},{"type":"text","text":", "},{"code":".minItems","type":"codeVoice"},{"type":"text","text":" and "},{"code":".maxItems","type":"codeVoice"},{"type":"text","text":" take a non-negative integer,"},{"type":"text","text":" "},{"code":".minimum","type":"codeVoice"},{"type":"text","text":" and "},{"code":".maximum","type":"codeVoice"},{"type":"text","text":" a number, and "},{"code":".pattern","type":"codeVoice"},{"type":"text","text":" a regular expression that compiles and an"},{"type":"text","text":" "},{"type":"text","text":"example it matches. A lower bound above its upper bound, or an example another keyword of the"},{"type":"text","text":" "},{"type":"text","text":"property rejects, is a compile error. So is a keyword that doesn’t apply to the property’s"},{"type":"text","text":" "},{"type":"text","text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,"},{"type":"text","text":" "},{"type":"text","text":"arrays the counts. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" property takes none, as checking it would reveal"},{"type":"text","text":" "},{"type":"text","text":"it; give it a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},{"type":"text","text":" value instead, whose rule its type enforces. The attribute"},{"type":"text","text":" "},{"type":"text","text":"anywhere but on a stored instance property of an "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" struct is an error."}],"type":"paragraph"}]}],"kind":"symbol","references":{"doc://Events/documentation/Events/Sensitive":{"abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"role":"symbol","type":"topic","title":"Sensitive","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"url":"\/documentation\/events\/sensitive"},"doc://Events/documentation/Events/ValidationKeyword":{"navigatorTitle":[{"text":"ValidationKeyword","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ValidationKeyword","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","typ