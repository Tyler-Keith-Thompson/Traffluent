ngs take the lengths and patterns, integers and floating-point numbers the bounds,","type":"text"},{"text":" ","type":"text"},{"text":"arrays the counts. A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"text":" property takes none, as checking it would reveal","type":"text"},{"text":" ","type":"text"},{"text":"it; give it a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},{"text":" value instead, whose rule its type enforces. The attribute","type":"text"},{"text":" ","type":"text"},{"text":"anywhere but on a stored instance property of an ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct is an error.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/eventmacros\/constrained(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","references":{"doc://Events/documentation/Events/Sensitive":{"role":"symbol","kind":"symbol","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"url":"\/documentation\/events\/sensitive","title":"Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event