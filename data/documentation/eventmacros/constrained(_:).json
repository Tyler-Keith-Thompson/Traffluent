oesn’t apply to the property’s"},{"type":"text","text":" "},{"type":"text","text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,"},{"type":"text","text":" "},{"type":"text","text":"arrays the counts. A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" property takes none, as checking it would reveal"},{"type":"text","text":" "},{"type":"text","text":"it; give it a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},{"type":"text","text":" value instead, whose rule its type enforces. The attribute"},{"type":"text","text":" "},{"type":"text","text":"anywhere but on a stored instance property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct is an error."}],"type":"paragraph"}]}],"sections":[],"identifier":{"url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","interfaceLanguage":"swift"},"references":{"doc://Events/documentation/Events/ValidationKeyword":{"type":"topic","abstract":[{"text":"A rule a property’s value must satisfy, as one of JSON Schema’s validation keywords (draft","type":"text"},{"text":" ","type":"text"},{"text":"2020-12): a bound on a string’s length, on a number, or on an array’s count, or a pattern a","type":"text"},{"text":" ","type":"text"},{"text":"string matches.","type":"text"}],"role":"symbol","kind":"symbol","title":"ValidationKeyword","navigatorTitle":[{"text":"ValidationKeyword","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","url":"\/documentation\/events\/validationkeyword","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ValidationKeyword","kind":"identifier"}]},"doc://Events/documentation/Events/Refined":{"title":"Refined","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","type":"topic","navigatorTitle":[{"text":"Refined","kind"