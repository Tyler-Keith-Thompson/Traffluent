d {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0), .maximum(100))","    var resultCount: Int","    @Constrained(.pattern(\"^[a-z]{2}-[A-Z]{2}$\", example: \"en-GB\"))","    var locale: String?","    @Constrained(.minItems(1))","    var filters: [String]","}"]},{"inlineContent":[{"text":"A tracker checks the event on its worker before anything else and rejects one whose property","type":"text"},{"text":" ","type":"text"},{"text":"breaks a constraint, reporting it on ","type":"text"},{"type":"codeVoice","code":"Tracker.rejectionReports"},{"text":". An optional property’s","type":"text"},{"text":" ","type":"text"},{"text":"constraints apply only when it holds a value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each argument is a keyword written out with literals, so the macro checks it as it expands:"},{"type":"text","text":" "},{"type":"codeVoice","code":".minLength"},{"type":"text","text":", "},{"type":"codeVoice","code":".maxLength"},{"type":"text","text":", "},{"type":"codeVoice","code":".minItems"},{"type":"text","text":" and "},{"type":"codeVoice","code":".maxItems"},{"type":"text","text":" take a non-negative integer,"},{"type":"text","text":" "},{"type":"codeVoice","code":".minimum"},{"type":"text","text":" and "},{"type":"codeVoice","code":".maximum"},{"type":"text","text":" a number, and "},{"type":"codeVoice","code":".pattern"},{"type":"text","text":" a regular expression that compiles and an"},{"type":"text","text":" "},{"type":"text","text":"example it matches. A lower bound above its upper bound, or an example another keyword of the"},{"type":"text","text":" "},{"type":"text","text":"property rejects, is a compile error. So is a keyword that doesn’t apply to the property’s"},{"type":"text","text":" "},{"type":"text","text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,"},{"type":"text","text":" "},{"type":"text","text":"arrays the counts. A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" property takes none, as checking it would reveal"},{"type":"text","text":" "},{"type":"text","text":"it; give it a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},{"type":"text","text":" value instead, whose rule its type enforces. The attribute"},{"type":"text","text":" "},{"type":"text","text":"anywhere but on a stored instance property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct is an error."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/constrained(_:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"kind":"symbol","references":{"doc://EventMacros/documentation/EventMacros":{"type":"topic","role":"collection","kind":"symbol","title":"EventMacros","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","url":"\/documentation\/eventmacros","abstract":[{"type":"text","text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy."}]},"doc://Events/documentation/Events/Refined":{"type":"topic","navigatorTitle":[{"text":"Refined","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"code":"Rule","type":"codeVoice"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"kind":"symbol","url":"\/documentation\/events\/refined","role":"symbol","fragments":[{"text":"struct","kind":"keyword"}