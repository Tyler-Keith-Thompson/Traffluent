"type":"text","text":" property takes none, as checking it would reveal"},{"type":"text","text":" "},{"type":"text","text":"it; give it a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},{"type":"text","text":" value instead, whose rule its type enforces. The attribute"},{"type":"text","text":" "},{"type":"text","text":"anywhere but on a stored instance property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct is an error."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Declares the constraints a stored property of an ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct satisfies, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" ","type":"text"},{"text":"checks and lists in the event’s schema.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/constrained(_:)"]}],"references":{"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"type":"topic","abstract":[{"text":"Declares the constraints a stored property of an ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct satisfies, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" ","type":"text"},{"text":"checks and lists in the event’s schema.","type":"text"}],"kind":"symbol","title":"Constrained(_:)","url":"\/documentation\/eventmacros\/constrained(_:)","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO","kind":"typeIdentifier"},{"text":"...)","kind":"text"}],"role":"symbol"},"doc://Events/documentation/Events/ValidationKeyword":{"type":"topic","abstract":[{"text":"A rule a property’s v