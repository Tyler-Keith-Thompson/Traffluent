he lengths and patterns, integers and floating-point numbers the bounds,","type":"text"},{"text":" ","type":"text"},{"text":"arrays the counts. A ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" property takes none, as checking it would reveal","type":"text"},{"text":" ","type":"text"},{"text":"it; give it a ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true,"type":"reference"},{"text":" value instead, whose rule its type enforces. The attribute","type":"text"},{"text":" ","type":"text"},{"text":"anywhere but on a stored instance property of an ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct is an error.","type":"text"}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/constrained(_:)"]}],"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"references":{"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ValidationKeyword","kind":"typeIdentifier","preciseIdentifier":"s:6Events17ValidationKeywordO"},{"text":"...)","kind":"text"}],"title":"Constrained(_:)","url":"\/documentation\/eventmacros\/constrained(_:)","type":"topic","role":"symbol","kind":"symbol"},"doc://Events/documentation/Events/ValidationKeyword":{"title":"ValidationKeyword","identifier":"doc:\/\/Events\