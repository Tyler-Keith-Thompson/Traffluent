nt":[{"type":"text","text":"A tracker checks the event on its worker before anything else and rejects one whose property"},{"type":"text","text":" "},{"type":"text","text":"breaks a constraint, reporting it on "},{"type":"codeVoice","code":"Tracker.rejectionReports"},{"type":"text","text":". An optional property’s"},{"type":"text","text":" "},{"type":"text","text":"constraints apply only when it holds a value."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each argument is a keyword written out with literals, so the macro checks it as it expands:"},{"type":"text","text":" "},{"code":".minLength","type":"codeVoice"},{"type":"text","text":", "},{"code":".maxLength","type":"codeVoice"},{"type":"text","text":", "},{"code":".minItems","type":"codeVoice"},{"type":"text","text":" and "},{"code":".maxItems","type":"codeVoice"},{"type":"text","text":" take a non-negative integer,"},{"type":"text","text":" "},{"code":".minimum","type":"codeVoice"},{"type":"text","text":" and "},{"code":".maximum","type":"codeVoice"},{"type":"text","text":" a number, and "},{"code":".pattern","type":"codeVoice"},{"type":"text","text":" a regular expression that compiles and an"},{"type":"text","text":" "},{"type":"text","text":"example it matches. A lower bound above its upper bound, or an example another keyword of the"},{"type":"text","text":" "},{"type":"text","text":"property rejects, is a compile error. So is a keyword that doesn’t apply to the property’s"},{"type":"text","text":" "},{"type":"text","text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,"},{"type":"text","text":" "},{"type":"text","text":"arrays the counts. A "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"type":"text","text":" property takes none, as checking it would reveal"},{"type":"text","text":" "},{"type":"text","text":"it; give it a "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","type":"reference","isActive":true},{"type":"text","text":" value instead, whose rule its type enforces. The attribute"},{"type":"text","text":" "},{"type":"text","text":"anywhere but on a stored instance property of an "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" struct is an error."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" struct satisfies, which "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/constrained(_:)"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Events/documentation/Events/Sensitive":{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","url":"\/documentation\/events\/sensitive","role":"symbol","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"type":"topic","title":"Sensitive","kind":"symbol"},"doc://Events/documentation/Events/Refined":{"title":"Refined","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Refined"}],"navigatorTitle":[{"kind":"identifier","text":"Refined"}],"abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"type":"codeVoice","code":"Rule"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"url":"\/documentation\/events\/refined"},"doc://Events/documentation/Events/ValidationKeyword":{"identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","url":"\/documentation\/events\/validationkeyword","role":"symbol","abstract":[{"type":"text","text":"A rule a property’s value must satisfy, as one of JSON Schema’s validation keywords (draft"},{"type":"text","text":" "},{"type":"text","text":"2020-12): a bound on a string’s length, on a number, or on an array’s count, or a pattern a"},{"type":"text","text":" "},{"type":"text","text":"string matches."}],"navigatorTitle":[{"text":"ValidationKeyword","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ValidationKeyword","kind":"identifier"}],"type":"topic","title":"ValidationKeyword","kind":"symbol"},"doc://EventMacros/documentation/EventMacros":{"title":"EventMacros","type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/eventmacros"},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","url":"\/documentation\/eventmacros\/constrained(_:)","role":"symbol","abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"te