 So is a keyword that doesn’t apply to the property’s","type":"text"},{"text":" ","type":"text"},{"text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,","type":"text"},{"text":" ","type":"text"},{"text":"arrays the counts. A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"text":" property takes none, as checking it would reveal","type":"text"},{"text":" ","type":"text"},{"text":"it; give it a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","type":"reference"},{"text":" value instead, whose rule its type enforces. The attribute","type":"text"},{"text":" ","type":"text"},{"text":"anywhere but on a stored instance property of an ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" struct is an error.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"references":{"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" struct satisfies, which "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"url":"\/documentation\/eventmacros\/constrained(_:)","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"preciseIdentifier":"s:6Events17ValidationKeywordO","kind":"typeIdentifier","text":"ValidationKeyword"},{"kind":"text","text":"...)"}],"title":"Constrained(_:)","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"topic","kind":"symbol","role":"symbol"},"doc://Events/documentation/Events/Refined":{"abstract":[{"type":"text","text":"A value that satisfies every con