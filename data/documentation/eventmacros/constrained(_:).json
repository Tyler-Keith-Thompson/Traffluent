Linux"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The keywords, checked in order."}],"type":"paragraph"}],"name":"constraints"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"code":["@Event","struct SearchPerformed {","    @Constrained(.minLength(1), .maxLength(200))","    var query: String","    @Constrained(.minimum(0), .maximum(100))","    var resultCount: Int","    @Constrained(.pattern(\"^[a-z]{2}-[A-Z]{2}$\", example: \"en-GB\"))","    var locale: String?","    @Constrained(.minItems(1))","    var filters: [String]","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A tracker checks the event on its worker before anything else and rejects one whose property","type":"text"},{"text":" ","type":"text"},{"text":"breaks a constraint, reporting it on ","type":"text"},{"code":"Tracker.rejectionReports","type":"codeVoice"},{"text":". An optional property’s","type":"text"},{"text":" ","type":"text"},{"text":"constraints apply only when it holds a value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each argument is a keyword written out with literals, so the macro checks it as it expands:"},{"type":"text","text":" "},{"code":".minLength","type":"codeVoice"},{"type":"text","text":", "},{"code":".maxLength","type":"codeVoice"},{"type":"text","text":", "},{"code":".minItems","type":"codeVoice"},{"type":"text","text":" and "},{"code":".maxItems","type":"codeVoice"},{"type":"text","text":" take a non-negative integer,"},{"type":"text","text":" "},{"code":".minimum","type":"codeVoice"},{"type":"text","text":" and "},{"code":".maximum","type":"codeVoice"},{"type":"text","text":" a number, and "},{"code":".pattern","type":"codeVoice"},{"type":"text","text":" a regular expression that compiles and an"},{"type":"text","text":" "},{"type":"text","text":"example it matches. A lower bound above its upper bound, or an example another keyword of the"},{"type":"text","text":" "},{"type":"text","text":"property rejects, is a compile error. So is a keyword that doesn’t apply to the property’s"},{"type":"text","text":" "},{"type":"text","text":"type: strings take the lengths and patterns, integers and floating-point numbers the bounds,"},{"type":"text","text":" "},{"type":"text","text":"arrays the counts. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" property takes none, as checking it would reveal"},{"type":"text","text":" "},{"type":"text","text":"it; give it a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},{"type":"text","text":" value instead, whose rule its type enforces. The attribute"},{"type":"text","text":" "},{"type":"text","text":"anywhere but on a stored instance property of an "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" struct is an error."}],"type":"paragraph"}]}],"references":{"doc://Events/documentation/Events/Refined":{"url":"\/documentation\/events\/refined","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"type":"codeVoice","code":"Rule"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}],"navigatorTitle":[{"text":"Refined","kind":"identifier"}],"title":"Refined","type":"topic","kind":"symbol","role":"symbol"},"doc://Events/documentation/Events/Sensitive":{"title":"Sensitive","type":"topic","url":"\/documentation\/events\/sensitive","role":"symbol","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}]},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"url":"\/documentation\/eventmacros\/constrained(_:)","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Events17ValidationKeywordO","text":"ValidationKeyword","kind":"typeIdentifier"},{"text":"...)","kind":"text"}],"title":"Constrained(_:)","kind":"symbol","type":"topic","role":"symbol"},"doc://EventMacros/documentation/EventMacros":{"title":"EventMacros","type":"topic","url":"\/documentation\/eventmacros","role":"collection","kind":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","abstract":[{"type":"text","text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy."}]},"doc://Events/documentation/Events/ValidationKeyword":{"url":"\/documentation\/events\/validationkeyword","identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword","abstract":[{"type":"text","text":"A rule a property’s value must satisfy, as one of JSON Schema’s validation keywords (draft"},{"type":"text","text":" "},{"type":"text","text":"2020-12): a bound on a string’s length, on a number, or on an array’s count, or a pattern a"},{"type":"text","text":" "},{"type":"text","text":"string matches."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ValidationKeyword"}],"navigatorTitle":[{"kind":"identifier","text":"ValidationKeyword"}],"title":"ValidationKeyword","type":"topic","kind":"symbol","role":"symbol"}}}