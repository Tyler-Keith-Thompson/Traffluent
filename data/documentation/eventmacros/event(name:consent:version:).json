{"abstract":[{"type":"text","text":"Makes a struct an event: derives its "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" conformances, its name and its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true},{"type":"text","text":" from its declaration."}],"metadata":{"roleHeading":"Macro","externalID":"s:11EventMacros0A04name7consent7versionySSSg_6Events15ConsentCategoryVSgSitcfm","symbolKind":"macro","title":"Event(name:consent:version:)","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L107","fileName":"Event.swift"},"modules":[{"name":"EventMacros"}],"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"identifier":{"url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(extension, conformances: "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Event","kind":"typeIdentifier","text":"Event","preciseIdentifier":"s:6Events5EventP"},{"kind":"text","text":", "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","kind":"typeIdentifier","text":"BinaryCodable","preciseIdentifier":"s:11Persistence13BinaryCodableP"},{"kind":"text","text":", names: named(name), named(consentCategory), named(schemaVersion), named(schema), named(constraintViolation), named(encode(to:)), named(init(from:)), named(requireBinaryCodable), named(binaryCodableRequirements)) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","kind":"typeIdentifier","text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 1)"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"name","content":[{"inlineContent":[{"text":"The name destinations record the event under, a string literal; the type’s name when","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"consent","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The purpose the event is collected for; "},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","type":"reference","isActive":true},{"type":"text","text":" when "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]},{"name":"version","content":[{"inlineContent":[{"text":"The schema version, ","type":"text"},{"type":"codeVoice","code":"Event.schemaVersion"},{"text":": a positive integer literal, raised for","type":"text"},{"text":" ","type":"text"},{"text":"each breaking change; 1 by default.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The macro adds an extension holding:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var name"},{"type":"text","text":", when "},{"type":"codeVoice","code":"name"},{"type":"text","text":" is given; otherwise the type’s name, "},{"type":"codeVoice","code":"Event"},{"type":"text","text":"’s default."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var consentCategory"},{"type":"text","text":", when "},{"type":"codeVoice","code":"consent"},{"type":"text","text":" is given; otherwise "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"code":"static var schemaVersion","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" is given; otherwise 1, ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":"’s default.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"static var schema"},{"text":": an ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference","isActive":true},{"text":" with the event’s name, version and each stored","type":"text"},{"text":" ","type":"text"},{"text":"property’s name, type as written, optionality, whether it has a default value and validation","type":"text"},{"text":" ","type":"text"},{"text":"keywords (its ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","type":"reference","isActive":true},{"text":" type’s rule’s, then those ","type":"text"},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"reference","isActive":true},{"text":" declares), in","type":"text"},{"text":" ","type":"text"},{"text":"declaration order.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"constraintViolation()"},{"type":"text","text":", when a property declares constraints with "},{"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"first property, in declaration order, whose value breaks one, which a tracker rejects."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"encode(to:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":", which write a CBOR map of the stored properties, each under"},{"type":"text","text":" "},{"type":"text","text":"its name, in declaration order, and read each back by its name, as a hand-written conformance"},{"type":"text","text":" "},{"type":"text","text":"would. An optional property missing from the map reads as "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", and one with a default"},{"type":"text","text":" "},{"type":"text","text":"value as that value. A "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" property goes through its own conformance, so"},{"type":"text","text":" "},{"type":"text","text":"only a store’s encoder writes its value."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Every stored instance property is encoded, and needs a type annotation. Static and computed","type":"text"},{"text":" ","type":"text"},{"text":"properties are left out, and so is a ","type":"text"},{"type":"codeVoice","code":"let"},{"text":" with an initial value, which every value shares.","type":"text"},{"text":" ","type":"text"},{"text":"The struct keeps its memberwise initializer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A stored property whose type isn’t ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" is a compile error naming it:","type":"text"},{"text":" ","type":"text"},{"code":"static method 'requireBinaryCodable(bad:)' requires that 'Foo' conform to 'BinaryCodable'","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"a property ","type":"text"},{"code":"bad","type":"codeVoice"},{"text":" of type ","type":"text"},{"code":"Foo","type":"codeVoice"},{"text":". Applying the macro to anything but a struct, a property with no","type":"text"},{"text":" ","type":"text"},{"text":"type annotation, a ","type":"text"},{"code":"lazy","type":"codeVoice"},{"text":" property, a destructuring pattern, a name that isn’t a non-empty string","type":"text"},{"text":" ","type":"text"},{"text":"literal and a version that isn’t a positive integer literal are compile errors too.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Changing an event","anchor":"Changing-an-event","type":"heading"},{"inlineContent":[{"type":"text","text":"A store may still hold records written before an event’s stored properties changed: an app"},{"type":"text","text":" "},{"type":"text","text":"updates with records on disk it hasn’t delivered. "},{"code":"version","type":"codeVoice"},{"type":"text","text":" counts the changes those records"},{"type":"text","text":" "},{"type":"text","text":"can’t be read through, and only those. Each record carries the version it was stored at, and a"},{"type":"text","text":" "},{"type":"text","text":"store drops one stored at another version than the type’s now without reading it, reporting the"},{"type":"text","text":" "},{"type":"text","text":"event and both versions ("},{"code":"DropReport.versionMismatch","type":"codeVoice"},{"type":"text","text":"). A tracking plan’s check"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"code":"TrackingPlans","type":"codeVoice"},{"type":"text","text":") fails on a change that needs a new version while the version stayed"},{"type":"text","text":" "},{"type":"text","text":"the same, naming the event, the property and the change."}],"type":"paragraph"},{"inlineContent":[{"text":"These changes are compatible. Keep the version, and the records stored before the change are","type":"text"},{"text":" ","type":"text"},{"text":"read by each property’s name, in any order:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"These changes are breaking. Raise the version with each, and the records stored at the earlier","type":"text"},{"text":" ","type":"text"},{"text":"one are dropped and reported:","type":"text"}],"type":"paragraph"},{"code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A version raised for a change whose bytes would still read, such as a property that keeps its","type":"text"},{"text":" ","type":"text"},{"text":"type but changes its meaning, drops the earlier records all the same, so they are never read","type":"text"},{"text":" ","type":"text"},{"text":"as the new shape. Records are never migrated from one version to another.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"references":{"doc://Events/documentation/Events/ConsentCategory":{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","role":"symbol","url":"\/documentation\/events\/consentcategory","navigatorTitle":[{"text":"ConsentCategory","kind":"identifier"}],"type":"topic","kind":"symbol","title":"ConsentCategory","abstract":[{"text":"The purpose an event is collected for, which the user consents to or refuses: analytics,","type":"text"},{"text":" ","type":"text"},{"text":"advertising and the like.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsentCategory","kind":"identifier"}]},"doc://EventMacros/documentation/EventMacros":{"url":"\/documentation\/eventmacros","kind":"symbol","role":"collection","type":"topic","abstract":[],"title":"EventMacros","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},"doc://Events/documentation/Events/Sensitive":{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","role":"symbol","url":"\/documentation\/events\/sensitive","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"type":"topic","kind":"symbol","title":"Sensitive","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}]},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"url":"\/documentation\/eventmacros\/constrained(_:)","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"title":"Constrained(_:)","type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events17ValidationKeywordO","text":"ValidationKeyword"},{"kind":"text","text":"...)"}]},"doc://Events/documentation/Events/EventSchema":{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","role":"symbol","url":"\/documentation\/events\/eventschema","navigatorTitle":[{"kind":"identifier","text":"EventSchema"}],"type":"topic","kind":"symbol","title":"EventSchema","abstract":[{"type":"text","text":"The shape of an event type: its name, its schema version, its consent category and its stored"},{"type":"text","text":" "},{"type":"text","text":"properties in declaration order, as a value tooling reads."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventSchema"}]},"doc://Events/documentation/Events/Refined":{"url":"\/documentation\/events\/refined","kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A value that satisfies every constraint of "},