{"abstract":[{"text":"Makes a struct an event: derives its ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformances, its name and its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference"},{"text":" from its declaration.","type":"text"}],"metadata":{"symbolKind":"macro","role":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"remoteSource":{"fileName":"Event.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L157"},"externalID":"s:11EventMacros0A04name7consent7versionySSSg_6Events15ConsentCategoryVSgSitcfm","roleHeading":"Macro","title":"Event(name:consent:version:)","modules":[{"name":"EventMacros"}]},"identifier":{"url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Event","preciseIdentifier":"s:6Events5EventP","text":"Event","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:SE","text":"Encodable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:Se","text":"Decodable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"__DiscoverableEvent","kind":"typeIdentifier"},{"text":", names: named(name), named(consentCategory), named(schemaVersion), named(schema), named(constraintViolation), named(CodingKeys), named(encode(to:)), named(init(from:)), named(decodeValue), named(decodeIfPresentValue), named(requireCodable), named(codableRequirements)) ","kind":"text"},{"text":"@attached","kind":"attribute"},{"text":"(peer) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = 1)","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The name destinations record the event under, a string literal; the type’s name when","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". No other event in the program may share it, whatever its version.","type":"text"}],"type":"paragraph"}],"name":"name"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The purpose the event is collected for; ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","isActive":true,"type":"reference"},{"text":" when ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"consent"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The schema version, "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":": a positive integer literal, raised for"},{"type":"text","text":" "},{"type":"text","text":"each breaking change; 1 by default."}]}],"name":"version"}],"kind":"parameters"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"syntax":"swift","code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The macro adds a "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" extension, so the conformance works off the main actor, where"},{"type":"text","text":" "},{"type":"text","text":"the tracker encodes events, even when the struct is marked "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":"; such a struct’s stored"},{"type":"text","text":" "},{"type":"text","text":"properties must then be "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". The extension holds:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"static var name","type":"codeVoice"},{"text":": ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" when it is given; otherwise the type’s name,","type":"text"},{"text":" ","type":"text"},{"code":"String(describing: Self.self)","type":"codeVoice"},{"text":", the value of ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":"’s default.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"static var consentCategory"},{"type":"text","text":", when "},{"type":"codeVoice","code":"consent"},{"type":"text","text":" is given; otherwise "},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"static var schemaVersion","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" is given; otherwise 1, ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":"’s default.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var schema"},{"text":": an ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true,"type":"reference"},{"text":" with the event’s name, version and each stored","type":"text"},{"text":" ","type":"text"},{"text":"property’s name, type as written, optionality, whether it has a default value and validation","type":"text"},{"text":" ","type":"text"},{"text":"keywords (its ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true,"type":"reference"},{"text":" type’s rule’s, then those ","type":"text"},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true,"type":"reference"},{"text":" declares), in","type":"text"},{"text":" ","type":"text"},{"text":"declaration order. A property of a raw-value enum gets its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema\/Enumeration","isActive":true,"type":"reference"},{"text":", the cases’ raw values. The macro lists them when the","type":"text"},{"text":" ","type":"text"},{"text":"enum is declared inside the struct, and reads them from ","type":"text"},{"type":"codeVoice","code":"allCases"},{"text":" for one declared elsewhere","type":"text"},{"text":" ","type":"text"},{"text":"or with a case under ","type":"text"},{"type":"codeVoice","code":"#if"},{"text":". An enum declared elsewhere needs ","type":"text"},{"type":"codeVoice","code":"CaseIterable"},{"text":" for a tracking","type":"text"},{"text":" ","type":"text"},{"text":"plan to check its values; without it, and for a typealias of an enum, the plan accepts any","type":"text"},{"text":" ","type":"text"},{"text":"value.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"constraintViolation()"},{"type":"text","text":", when a property declares constraints with "},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"reference","isActive":true},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"first property, in declaration order, whose value breaks one, which a tracker rejects."}]}]},{"content":[{"inlineContent":[{"code":"CodingKeys","type":"codeVoice"},{"text":", ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" and the private functions it reads some types","type":"text"},{"text":" ","type":"text"},{"text":"through, which write a keyed container of the stored","type":"text"},{"text":" ","type":"text"},{"text":"properties, each under its name, and read each back by its name, as a hand-written","type":"text"},{"text":" ","type":"text"},{"text":"conformance would. A store writes the container as a CBOR map. An optional property’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is left out, and an optional property missing from the map reads as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":"; one with a","type":"text"},{"text":" ","type":"text"},{"text":"default value reads as that value, so its ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" is written. A ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" property, optional or","type":"text"},{"text":" ","type":"text"},{"text":"not, and each date in a ","type":"text"},{"code":"[Date]","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"[Date?]","type":"codeVoice"},{"text":" property, is written as the seconds since 2001","type":"text"},{"text":" ","type":"text"},{"text":"it stores, so it reads back exactly. A ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" inside a ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type of your own takes the","type":"text"},{"text":" ","type":"text"},{"text":"CBOR package’s own form, seconds since 1970, and reads back to within a rounding of a","type":"text"},{"text":" ","type":"text"},{"text":"microsecond’s scale. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"text":" property goes through its own conformance, so only a store writes its","type":"text"},{"text":" ","type":"text"},{"text":"value.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Beside the struct the macro adds a private record, which the compiler places in the binary so"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all"},{"type":"text","text":" lists the event at run time, and "},{"type":"codeVoice","code":"SegmentStore()"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"DatabaseStore(database:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TrackingPlan()"},{"type":"text","text":" take it without a list. The record holds the"},{"type":"text","text":" "},{"type":"text","text":"struct as an "},{"type":"codeVoice","code":"__DiscoverableEvent"},{"type":"text","text":", an underscored protocol the macro conforms it to and"},{"type":"text","text":" "},{"type":"text","text":"discovery reads, which the event’s code doesn’t use. A generic struct, or"},{"type":"text","text":" "},{"type":"text","text":"one nested in a generic type’s declaration, gets no record, as a record holds one concrete"},{"type":"text","text":" "},{"type":"text","text":"type: it isn’t discovered, and the macro adds a note saying to list it. So does one in an"},{"type":"text","text":" "},{"type":"text","text":"extension that names the type’s generic arguments ("},{"type":"codeVoice","code":"extension Box<Int>"},{"type":"text","text":") or has a "},{"type":"codeVoice","code":"where"},{"type":"text","text":" "},{"type":"text","text":"clause. A struct declared in a plain extension of a generic type doesn’t compile ("},{"type":"codeVoice","code":"static stored properties not supported in generic types"},{"type":"text","text":"), as the extension doesn’t say the type is"},{"type":"text","text":" "},{"type":"text","text":"generic; declare it outside the generic type."}],"type":"paragraph"},{"inlineContent":[{"text":"Beside the record the macro adds a function whose symbol is named for the event’s name,","type":"text"},{"text":" ","type":"text"},{"code":"$linkerset_kind_65766E74_key_","type":"codeVoice"},{"text":" and the name, its ASCII letters and digits as they are and every","type":"text"},{"text":" ","type":"text"},{"text":"other byte as ","type":"text"},{"code":"_","type":"codeVoice"},{"text":" and two hex digits. Two events of one name in one linked image, whatever their","type":"text"},{"text":" ","type":"text"},{"text":"versions, define that symbol twice and fail to build: in one module the compiler refuses the","type":"text"},{"text":" ","type":"text"},{"text":"second, and across the modules of one executable or library the linker does, naming the symbol.","type":"text"},{"text":" ","type":"text"},{"text":"The check doesn’t reach across images: a dynamic library, a library opened with ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":", or a","type":"text"},{"text":" ","type":"text"},{"text":"module linked into two images is caught only when a store or tracking plan reads","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","type":"reference"},{"text":" and throws for the duplicate name. A struct inside a ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"fileprivate","type":"codeVoice"},{"text":" type or extension gets no such function, as its symbol would be local to the","type":"text"},{"text":" ","type":"text"},{"text":"file, so only those run-time errors check its name. The name is the one ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" gives, or the","type":"text"},{"text":" ","type":"text"},{"text":"type’s, and the extension always declares it as ","type":"text"},{"code":"name","type":"codeVoice"},{"text":", so the name can’t differ from the one","type":"text"},{"text":" ","type":"text"},{"text":"checked: a struct that declares a static ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" itself is a compile error, with a Fix-It that","type":"text"},{"text":" ","type":"text"},{"text":"moves a string literal into ","type":"text"},{"code":"name","type":"codeVoice"},{"text":", and one declared in an extension or under ","type":"text"},{"code":"#if","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"redeclaration.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every stored instance property is encoded, and needs a type annotation. Static and computed"},{"type":"text","text":" "},{"type":"text","text":"properties are left out, and so is a "},{"type":"codeVoice","code":"let"},{"type":"text","text":" with an initial value, which every value shares."},{"type":"text","text":" "},{"type":"text","text":"The struct keeps its memberwise initializer."}],"type":"paragraph"},{"inlineContent":[{"text":"A stored property whose type isn’t ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" is a compile error naming it:","type":"text"},{"text":" ","type":"text"},{"code":"static method 'requireCodable(bad:)' requires that 'Foo' conform to 'Decodable'","type":"codeVoice"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"property ","type":"text"},{"code":"bad","type":"codeVoice"},{"text":" of type ","type":"text"},{"code":"Foo","type":"codeVoice"},{"text":". A raw-value enum is ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", written as its raw value, once it","type":"text"},{"text":" ","type":"text"},{"text":"declares the conformance (","type":"text"},{"code":"enum Reason: String, Codable","type":"codeVoice"},{"text":"). One declared inside the struct must","type":"text"},{"text":" ","type":"text"},{"text":"list it in its inheritance clause, even when an extension adds it, since the macro sees only","type":"text"},{"text":" ","type":"text"},{"text":"the struct; without it, the error is the macro’s own, at that clause. Applying the macro to","type":"text"},{"text":" ","type":"text"},{"text":"anything but a struct, a property with no type annotation, a ","type":"text"},{"code":"lazy","type":"codeVoice"},{"text":" property, a destructuring","type":"text"},{"text":" ","type":"text"},{"text":"pattern, a name that isn’t a non-empty string literal, a static ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" declared in the struct","type":"text"},{"text":" ","type":"text"},{"text":"and a version that isn’t a positive integer literal are compile errors too.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Changing-an-event","text":"Changing an event","type":"heading"},{"inlineContent":[{"type":"text","text":"A store may still hold records written before an event’s stored properties changed: an app"},{"type":"text","text":" "},{"type":"text","text":"updates with records on disk it hasn’t delivered. "},{"type":"codeVoice","code":"version"},{"type":"text","text":" counts the changes those records"},{"type":"text","text":" "},{"type":"text","text":"can’t be read through, and only those. Each record carries the version it was stored at, and a"},{"type":"text","text":" "},{"type":"text","text":"store drops one stored at another version than the type’s now without reading it, reporting the"},{"type":"text","text":" "},{"type":"text","text":"event and both versions ("},{"type":"codeVoice","code":"DropReport.versionMismatch"},{"type":"text","text":"). A tracking plan’s check"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":") fails on a change that needs a new version while the version stayed"},{"type":"text","text":" "},{"type":"text","text":"the same, naming the event, the property and the change."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These changes are compatible. Keep the version, and the records stored before the change are"},{"type":"text","text":" "},{"type":"text","text":"read by each property’s name, in any order:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"],"type":"codeListing"},{"inlineContent":[{"text":"These changes are breaking. Raise the version with each, and the records stored at the earlier","type":"text"},{"text":" ","type":"text"},{"text":"one are dropped and reported:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"],"type":"codeListing"},{"inlineContent":[{"text":"A version raised for a change whose bytes would still read, such as a property that keeps its","type":"text"},{"text":" ","type":"text"},{"text":"type but changes its meaning, drops the earlier records all the same, so they are never read","type":"text"},{"text":" ","type":"text"},{"text":"as the new shape. Records are never migrated from one version to another.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"references":{"doc://Events/documentation/Events/EventSchema":{"url":"\/documentation\/events\/eventschema","abstract":[{"type":"text","text":"The shape of an event type: its name, its schema version, its consent category and its stored"},{"type":"text","text":" "},{"type":"text","text":"properties in declaration order, as a value tooling reads."}],"navigatorTitle":[{"text":"EventSchema","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventSchema","kind":"identifier"}],"title":"EventSchema"},"doc://Events/documentation/Events/Refined":{"url":"\/documentation\/events\/refined","abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"type":"codeVoice","code":"Rule"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"navigatorTitle":[{"text":"Refined","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}],"title":"Refined"},"doc://EventMacros/documentation/EventMacros/Event(name:consent:version:)":{"abstract":[{"type":"text","text":"Makes a struct an event: derives its "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformances, its name and its"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference","isActive":true},{"type":"text","text":" from its declaration."}],"url":"\/documentation\/eventmacros\/event(name:consent:version:)","title":"Event(name:consent:version:)","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"text":"?, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","kind":"symbol"},"doc://Events/documentation/Events/DiscoveredEvent/all":{"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","abstract":[{"type":"text","text":"Every event type the program links, ordered by the UTF-8 bytes of their names, then by"},{"type":"text","text":" "},{"type":"text","text":"version, then by the types’ fully qualified names."}],"url":"\/documentation\/events\/discoveredevent\/all","title":"all","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"all"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15DiscoveredEventV","text":"DiscoveredEvent"},{"kind":"text","text":"]"}]},"doc://Events/documentation/Events/ConsentCategory/analytics":{"type":"topic","title":"analytics","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","role":"symbol","kind":"symbol","url":"\/documentation\/events\/consentcategory\/analytics","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"analytics"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"}],"abstract":[{"text":"Measuring how the product is used: the category of every event that names no other.","type":"text"}]},"doc://Events/documentation/Events/Event":{"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Event","url":"\/documentation\/events\/event","abstract":[{"type":"text","text":"Something that happened, recorded as a typed value."}],"navigatorTitle":[{"text":"Event","kind":"identifier"}],"title":"Event","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"}]},"doc://Events/documentation/Events/ConsentCategory":{"title":"ConsentCategory","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/events\/consentcategory","navigatorTitle":[{"text":"ConsentCategory","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsentCategory","kind":"identifier"}],"abstract":[{"type":"text","text":"The purpose an event is collected for, which the user consents to or refuses: analytics,"},{"type":"text","text":" "},{"type":"text","text":"advertising and the like."}]},"doc://EventMacros/documentation/EventMacros":{"abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"url":"\/documentation\/eventmacros","title":"EventMacros","role":"collection","type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","kind":"symbol"},"doc://Events/documentation/Events/Sensitive":{"navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"url":"\/documentation\/events\/sensitive","title":"Sensitive","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","kind":"symbol"},"doc://Events/documentation/Events/EventSchema/Enumeration":{"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema\/Enumeration","abstract":[{"type":"text","text":"The raw values a property of a raw-value enum is written as: the enum’s name, its raw value’s"},{"type":"text","text":" "},{"type":"text","text":"type and, where they are known, every case’s raw value."}],"url":"\/documentation\/events\/eventschema\/enumeration","navigatorTitle":[{"kind":"identifier","text":"Enumeration"}],"title":"EventSchema.Enumeration","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Enumeration"}]},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"url":"\/documentation\/eventmacros\/constrained(_:)","abstract":[{"text":"Declares the constraints a stored property of an ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct satisfies, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" ","type":"text"},{"text":"checks and lists in the event’s schema.","type":"text"}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO"},{"kind":"text","text":"...)"}],"title":"Constrained(_:)"}}}