ecodeIfPresentValue), named(requireCodable), named(codableRequirements)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory"},{"text":"? = nil, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":" = 1)","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name destinations record the event under, a string literal; the type’s name when"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"name"},{"content":[{"inlineContent":[{"type":"text","text":"The purpose the event is collected for; "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","isActive":true},{"type":"text","text":" when "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"consent"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The schema version, ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":": a positive integer literal, raised for","type":"text"},{"text":" ","type":"text"},{"text":"each breaking change; 1 by default.","type":"text"}]}],"name":"version"}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The macro adds an extension holding:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"static var name"},{"text":", when ","type":"text"},{"type":"codeVoice","code":"name"},{"text":" is given; otherwise the type’s name, ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":"’s default.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"static var consentCategory"},{"type":"text","text":", when "},{"type":"codeVoice","code":"consent"},{"type":"text","text":" is given; otherwise "},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"static var schemaVersion","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" is given; otherwise 1, ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":"’s default.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"static var schema","type":"codeVoice"},{"text":": an ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true,"type":"reference"},{"text":" with the event’s name, version and each stored","type":"text"},{"text":" ","type":"text"},{"text":"property’s name, type as written, optionality, whether it has a default value and validation","type":"text"},{"text":" ","type":"text"},{"text":"keywords (its ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true,"type":"reference"},{"text":" type’s rule’s, then those ","type":"text"},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true,"type":"reference"},{"text":" declares), in","type":"text"},{"text":" ","type":"text"},{"text":"declaration order.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"constraintViolation()","type":"codeVoice"},{"text":", when a property declares constraints with ","type":"text"},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"reference","isActive":true},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"first property, in declaration order, whose value breaks one, which a tracker rejects.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"CodingKeys","type":"codeVoice"},{"text":", ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" and the private functions it reads some types","type":"text"},{"text":" ","type":"text"},{"text":"through, which write a keyed container of the stored","type":"text"},{"text":" ","type":"text"},{"text":"properties, each under its name, and read each back by its name, as a hand-written","type":"text"},{"text":" ","type":"text"},{"text":"conformance would. A store writes the container as a CBOR map. An optional property’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is left out, and an optional property missing from the map reads as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":"; one with a","type":"text"},{"text":" ","type":"text"},{"text":"default value reads as that value, so its ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" is written. A ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" property, optional or","type":"text"},{"text":" ","type":"text"},{"text":"not, and each date in a ","type":"text"},{"code":"[Date]","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"[Date?]","type":"codeVoice"},{"text":" property, is written as the seconds since 2001","type":"text"},{"text":" ","type":"text"},{"text":"it stores, so it reads back exactly. A ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" inside a ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type of your own takes the","type":"text"},{"text":" ","type":"text"},{"text":"CBOR package’s own form, seconds since 1970, and reads back to within a rounding of a","type":"text"},{"text":" ","type":"text"},{"text":"microsecond’s scale. A","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"text":" property goes through its own conformance, so only a store writes its","type":"text"},{"text":" ","type":"text"},{"text":"value.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Every stored instance property is encoded, and needs a type annotation. Static and computed","type":"text"},{"text":" ","type":"text"},{"text":"properties are left out, and so is a ","type":"text"},{"type":"codeVoice","code":"let"},{"text":" with an initial value, which every value shares.","type":"text"},{"text":" ","type":"text"},{"text":"The struct keeps its memberwise initializer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A stored property whose type isn’t ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" is a compile error naming it:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"static method 'requireCodable(bad:)' requires that 'Foo' conform to 'Decodable'"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"property ","type":"text"},{"type":"codeVoice","code":"bad"},{"text":" of type ","type":"text"},{"type":"codeVoice","code":"Foo"},{"text":". Applying the macro to anything but a struct, a property with no","type":"text"},{"text":" ","type":"text"},{"text":"type annotation, a ","type":"text"},{"type":"codeVoice","code":"lazy"},{"text":" property, a destructuring pattern, a name that isn’t a non-empty string","type":"text"},{"text":" ","type":"text"},{"text":"literal and a version that isn’t a positive integer literal are compile errors too.","type":"text"}],"type":"paragraph"},{"text":"Changing an event","anchor":"Changing-an-event","level":2,"type":"heading"},{"inlineContent":[{"text":"A store may still hold records written before an event’s stored properties changed: an app","type":"text"},{"text":" ","type":"text"},{"text":"updates with records on disk it hasn’t delivered. ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" counts the changes those records","type":"text"},{"text":" ","type":"text"},{"text":"can’t be read through, and only those. Each record carries the version it was stored at, and a","type":"text"},{"text":" ","type":"text"},{"text":"store drops one stored at another version than the type’s now without reading it, reporting the","type":"text"},{"text":" ","type":"text"},{"text":"event and both versions (","type":"text"},{"code":"DropReport.versionMismatch","type":"codeVoice"},{"text":"). A tracking plan’s check","type":"text"},{"text":" ","type":"text"},{"text":"(module ","type":"text"},{"code":"TrackingPlans","type":"codeVoice"},{"text":") fails on a change that needs a new version while the version stayed","type":"text"},{"text":" ","type":"text"},{"text":"the same, naming the event, the property and the change.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These changes are compatible. Keep the version, and the records stored before the change are"},{"type":"text","text":" "},{"type":"text","text":"read by each property’s name, in any order:"}],"type":"paragraph"},{"code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"These changes are breaking. Raise the version with each, and the records stored at the earlier","type":"text"},{"text":" ","type":"text"},{"text":"one are dropped and reported:","type":"text"}],"type":"paragraph"},{"code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A version raised for a change whose bytes would still read, such as a property that keeps its","type":"text"},{"text":" ","type":"text"},{"text":"type but changes its meaning, drops the earlier records all the same, so they are never read","type":"text"},{"text":" ","type":"text"},{"text":"as the new shape. Records are never migrated from one version to another.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"]}],"abstract":[{"type":"text","text":"Makes a struct an event: derives its "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformances, its name and its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true},{"type":"text","text":" from its declaration."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://Events/documentation/Events/Refined":{"title":"Refined","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}],"url":"\/documentation\/events\/refined","abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"code":"Rule","type":"codeVoice"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"Refined","kind":"identifier"}]},"doc://Events/documentation/Events/ConsentCategory":{"navigatorTitle":[{"text":"ConsentCategory","kind":"identifier"}],"url":"\/documentation\/events\/consentcategory","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The purpose an event is collected for, which the user consents to or refuses: analytics,"},{"type":"text","text":" "},{"type":"text","text":"advertising and the like."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsentCategory","kind":"identifier"}],"title":"ConsentCategory","role":"symbol"},"doc://Events/documentation/Events/Event":{"title":"Event","identifier":"doc:\/\/Events\/documentation\/Events\/Event","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"url":"\/documentation\/events\/event","abstract":[{"text":"Something that happened, recorded as a typed value.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Event"}]},"doc://Events/documentation/Events/EventSchema":{"navigatorTitle":[{"kind":"identifier","text":"EventSchema"}],"url":"\/documentation\/events\/eventschema","type":"topic","identifier