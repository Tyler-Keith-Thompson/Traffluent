{"metadata":{"symbolKind":"macro","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"roleHeading":"Macro","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L107","fileName":"Event.swift"},"role":"symbol","title":"Event(name:consent:version:)","modules":[{"name":"EventMacros"}],"externalID":"s:11EventMacros0A04name7consent7versionySSSg_6Events15ConsentCategoryVSgSitcfm"},"identifier":{"url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Makes a struct an event: derives its "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" conformances, its name and its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"type":"text","text":" from its declaration."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(extension, conformances: "},{"preciseIdentifier":"s:6Events5EventP","kind":"typeIdentifier","text":"Event","identifier":"doc:\/\/Events\/documentation\/Events\/Event"},{"kind":"text","text":", "},{"preciseIdentifier":"s:11Persistence13BinaryCodableP","kind":"typeIdentifier","text":"BinaryCodable","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable"},{"kind":"text","text":", names: named(name), named(consentCategory), named(schemaVersion), named(schema), named(constraintViolation), named(encode(to:)), named(init(from:)), named(requireBinaryCodable), named(binaryCodableRequirements)) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","text":"ConsentCategory","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" = 1)"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name destinations record the event under, a string literal; the type’s name when"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"name"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The purpose the event is collected for; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics"},{"type":"text","text":" when "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"consent"},{"content":[{"inlineContent":[{"type":"text","text":"The schema version, "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":": a positive integer literal, raised for"},{"type":"text","text":" "},{"type":"text","text":"each breaking change; 1 by default."}],"type":"paragraph"}],"name":"version"}],"kind":"parameters"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The macro adds an extension holding:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"static var name","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" is given; otherwise the type’s name, ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":"’s default.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"static var consentCategory","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"consent","type":"codeVoice"},{"text":" is given; otherwise ","type":"text"},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"static var schemaVersion","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" is given; otherwise 1, ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":"’s default.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var schema"},{"type":"text","text":": an "},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true,"type":"reference"},{"type":"text","text":" with the event’s name, version and each stored"},{"type":"text","text":" "},{"type":"text","text":"property’s name, type as written, optionality, whether it has a default value and validation"},{"type":"text","text":" "},{"type":"text","text":"keywords (its "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true,"type":"reference"},{"type":"text","text":" type’s rule’s, then those "},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true,"type":"reference"},{"type":"text","text":" declares), in"},{"type":"text","text":" "},{"type":"text","text":"declaration order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"constraintViolation()","type":"codeVoice"},{"text":", when a property declares constraints with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"reference"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"first property, in declaration order, whose value breaks one, which a tracker rejects.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"encode(to:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":", which write a CBOR map of the stored properties, each under","type":"text"},{"text":" ","type":"text"},{"text":"its name, in declaration order, and read each back by its name, as a hand-written conformance","type":"text"},{"text":" ","type":"text"},{"text":"would. An optional property missing from the map reads as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", and one with a default","type":"text"},{"text":" ","type":"text"},{"text":"value as that value. A ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" property goes through its own conformance, so","type":"text"},{"text":" ","type":"text"},{"text":"only a store’s encoder writes its value.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Every stored instance property is encoded, and needs a type annotation. Static and computed"},{"type":"text","text":" "},{"type":"text","text":"properties are left out, and so is a "},{"type":"codeVoice","code":"let"},{"type":"text","text":" with an initial value, which every value shares."},{"type":"text","text":" "},{"type":"text","text":"The struct keeps its memberwise initializer."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A stored property whose type isn’t "},{"code":"BinaryCodable","type":"codeVoice"},{"type":"text","text":" is a compile error naming it:"},{"type":"text","text":" "},{"code":"static method 'requireBinaryCodable(bad:)' requires that 'Foo' conform to 'BinaryCodable'","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"a property "},{"code":"bad","type":"codeVoice"},{"type":"text","text":" of type "},{"code":"Foo","type":"codeVoice"},{"type":"text","text":". Applying the macro to anything but a struct, a property with no"},{"type":"text","text":" "},{"type":"text","text":"type annotation, a "},{"code":"lazy","type":"codeVoice"},{"type":"text","text":" property, a destructuring pattern, a name that isn’t a non-empty string"},{"type":"text","text":" "},{"type":"text","text":"literal and a version that isn’t a positive integer literal are compile errors too."}],"type":"paragraph"},{"text":"Changing an event","type":"heading","level":2,"anchor":"Changing-an-event"},{"inlineContent":[{"text":"A store may still hold records written before an event’s stored properties changed: an app","type":"text"},{"text":" ","type":"text"},{"text":"updates with records on disk it hasn’t delivered. ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" counts the changes those records","type":"text"},{"text":" ","type":"text"},{"text":"can’t be read through, and only those. Each record carries the version it was stored at, and a","type":"text"},{"text":" ","type":"text"},{"text":"store drops one stored at another version than the type’s now without reading it, reporting the","type":"text"},{"text":" ","type":"text"},{"text":"event and both versions (","type":"text"},{"type":"codeVoice","code":"DropReport.versionMismatch"},{"text":"). A tracking plan’s check","type":"text"},{"text":" ","type":"text"},{"text":"(module ","type":"text"},{"type":"codeVoice","code":"TrackingPlans"},{"text":") fails on a change that needs a new version while the version stayed","type":"text"},{"text":" ","type":"text"},{"text":"the same, naming the event, the property and the change.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These changes are compatible. Keep the version, and the records stored before the change are"},{"type":"text","text":" "},{"type":"text","text":"read by each property’s name, in any order:"}],"type":"paragraph"},{"code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"These changes are breaking. Raise the version with each, and the records stored at the earlier","type":"text"},{"text":" ","type":"text"},{"text":"one are dropped and reported:","type":"text"}],"type":"paragraph"},{"code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A version raised for a change whose bytes would still read, such as a property that keeps its"},{"type":"text","text":" "},{"type":"text","text":"type but changes its meaning, drops the earlier records all the same, so they are never read"},{"type":"text","text":" "},{"type":"text","text":"as the new shape. Records are never migrated from one version to another."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"references":{"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"role":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO","kind":"typeIdentifier"},{"text":"...)","kind":"text"}],"url":"\/documentation\/eventmacros\/constrained(_:)","title":"Constrained(_:)","kind":"symbol","type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" struct satisfies, which "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}]},"doc://Events/documentation/Events/ConsentCategory/analytics":{"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"analytics"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","text":"ConsentCategory"}],"url":"\/documentation\/events\/consentcategory\/analytics","title":"analytics","kind":"symbol","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","abstract":[{"text":"Measuring how the product is used: the category of every event that names no other.","type":"text"}]},"doc://Events/documentation/Events/Sensitive":{"url":"\/documentation\/events\/sensitive","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"kind":"symbol","title":"Sensitive","role":"symbol"},"doc://EventMacros/documentation/EventMacros":{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","url":"\/documentation\/eventmacros","type":"topic","abstract":[],"kind":"symbol","title":"EventMacros","role":"collection"},"doc://Events/documentation/Events/Event":{"navigatorTitle":[{"kind":"identifier","text":"Event"}],"kind":"symbol","title":"Event","type":"topic","abstract":[{"type":"text","text":"Something that happened, recorded as a typed value."}],"identifier":"doc:\/\/Events\/documentation\/Events\/Event","role":"symbol","url":"\/documentation\/events\/event","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}]},"doc://Persistence/documentation/Persistence/BinaryCodable":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryCodable"}],"navigatorTitle":[{"kind":"identifier","text":"BinaryCodable"}],"url":"\/documentation\/persistence\/binarycodable","kind":"symbol","title":"BinaryCodable","type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","abstract":[{"type":"text","text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk."}]},"doc://Events/documentation/Events/Refined":{"navigatorTitle":[{"text":"Refined","kind":"identifier"}],"kind":"symbol","title":"Refined","type":"topic","abstract":[{"text":"A value that satisfies every constraint of ","type":"text"},{"type":"codeVoice","code":"Rule"},{"text":", checked once as it is made, so a property of","type":"text"},{"text":" ","type":"text"},{"text":"this type can’t hold one that doesn’t.","type":"text"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","role":"symbol","url":"\/documentation\/events\/refined","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}]},"doc://Events/documentation/Events/ConsentCategory":{"navigatorTitle":[{"kind":"identifier","text":"ConsentCategory"}],"kind":"symbol","title":"ConsentCategory","type":"topic","abstract":[{"type":"text","text":"The purpose an event is collected for, which the user consents to or refuses: analytics,"},{"type":"text","text":" "},{"type":"text","text":"advertising and the like."}],"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","role":"symbol","url":"\/documentation\/events\/consentcategory","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsentCategory"}]},"doc://Events/documentation/Events/EventSchema":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventSchema"}],"navigatorTitle":[{"kind":"identifier","text":"EventSchema"}],"url":"\/documentation\/events\/eventschema","kind":"symbol","title":"EventSchema","type":"topic","abstract":[{"text":"The shape of an event type: its name, its schema version, its consent category and its stored","type":"text"},{"text":" ","type":"text"},{"text":"properties in declaration order, as a value tooling reads.","type":"text"}],"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},"doc://EventMacros/documentation/EventMacros/Event(name:consent:version:)":{"abstract":[{"text":"Makes a struct an event: derives its ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" conformances, its name and its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference"},{"text":" from its declaration.","type":"text"}],"url":"\/documentation\/eventmacros\/event(name:consent:version:)","type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","text":"ConsentCategory"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":")"}],"kind":"symbol","title":"Event(name:consent:version:)","role":"symbol"}}}