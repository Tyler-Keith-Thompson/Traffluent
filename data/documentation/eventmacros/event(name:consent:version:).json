{"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"metadata":{"roleHeading":"Macro","externalID":"s:11EventMacros0A04name7consent7versionySSSg_6Events15ConsentCategoryVSgSitcfm","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L107","fileName":"Event.swift"},"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"title":"Event(name:consent:version:)","symbolKind":"macro","modules":[{"name":"EventMacros"}],"role":"symbol"},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(extension, conformances: "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Event","kind":"typeIdentifier","text":"Event","preciseIdentifier":"s:6Events5EventP"},{"kind":"text","text":", "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","kind":"typeIdentifier","text":"BinaryCodable","preciseIdentifier":"s:11Persistence13BinaryCodableP"},{"kind":"text","text":", names: named(name), named(consentCategory), named(schemaVersion), named(schema), named(constraintViolation), named(encode(to:)), named(init(from:)), named(requireBinaryCodable), named(binaryCodableRequirements)) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","kind":"typeIdentifier","text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 1)"}]}]},{"parameters":[{"name":"name","content":[{"inlineContent":[{"type":"text","text":"The name destinations record the event under, a string literal; the type’s name when"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"consent","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The purpose the event is collected for; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics"},{"type":"text","text":" when "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}]},{"name":"version","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The schema version, "},{"code":"Event.schemaVersion","type":"codeVoice"},{"type":"text","text":": a positive integer literal, raised for"},{"type":"text","text":" "},{"type":"text","text":"each breaking change; 1 by default."}]}]}],"kind":"parameters"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"syntax":"swift","code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The macro adds an extension holding:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"static var name","type":"codeVoice"},{"type":"text","text":", when "},{"code":"name","type":"codeVoice"},{"type":"text","text":" is given; otherwise the type’s name, "},{"code":"Event","type":"codeVoice"},{"type":"text","text":"’s default."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"static var consentCategory","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"consent","type":"codeVoice"},{"text":" is given; otherwise ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var schemaVersion"},{"text":", when ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" is given; otherwise 1, ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":"’s default.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"static var schema","type":"codeVoice"},{"type":"text","text":": an "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true},{"type":"text","text":" with the event’s name, version and each stored"},{"type":"text","text":" "},{"type":"text","text":"property’s name, type as written, optionality, whether it has a default value and validation"},{"type":"text","text":" "},{"type":"text","text":"keywords (its "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true},{"type":"text","text":" type’s rule’s, then those "},{"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true},{"type":"text","text":" declares), in"},{"type":"text","text":" "},{"type":"text","text":"declaration order."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"constraintViolation()"},{"type":"text","text":", when a property declares constraints with "},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"reference","isActive":true},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"first property, in declaration order, whose value breaks one, which a tracker rejects."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":", which write a CBOR map of the stored properties, each under"},{"type":"text","text":" "},{"type":"text","text":"its name, in declaration order, and read each back by its name, as a hand-written conformance"},{"type":"text","text":" "},{"type":"text","text":"would. An optional property missing from the map reads as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", and one with a default"},{"type":"text","text":" "},{"type":"text","text":"value as that value. A "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" property goes through its own conformance, so"},{"type":"text","text":" "},{"type":"text","text":"only a store’s encoder writes its value."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Every stored instance property is encoded, and needs a type annotation. Static and computed","type":"text"},{"text":" ","type":"text"},{"text":"properties are left out, and so is a ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" with an initial value, which every value shares.","type":"text"},{"text":" ","type":"text"},{"text":"The struct keeps its memberwise initializer.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A stored property whose type isn’t "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" is a compile error naming it:"},{"type":"text","text":" "},{"type":"codeVoice","code":"static method 'requireBinaryCodable(bad:)' requires that 'Foo' conform to 'BinaryCodable'"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"a property "},{"type":"codeVoice","code":"bad"},{"type":"text","text":" of type "},{"type":"codeVoice","code":"Foo"},{"type":"text","text":". Applying the macro to anything but a struct, a property with no"},{"type":"text","text":" "},{"type":"text","text":"type annotation, a "},{"type":"codeVoice","code":"lazy"},{"type":"text","text":" property, a destructuring pattern, a name that isn’t a non-empty string"},{"type":"text","text":" "},{"type":"text","text":"literal and a version that isn’t a positive integer literal are compile errors too."}]},{"anchor":"Changing-an-event","text":"Changing an event","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A store may still hold records written before an event’s stored properties changed: an app"},{"type":"text","text":" "},{"type":"text","text":"updates with records on disk it hasn’t delivered. "},{"code":"version","type":"codeVoice"},{"type":"text","text":" counts the changes those records"},{"type":"text","text":" "},{"type":"text","text":"can’t be read through, and only those. Each record carries the version it was stored at, and a"},{"type":"text","text":" "},{"type":"text","text":"store drops one stored at another version than the type’s now without reading it, reporting the"},{"type":"text","text":" "},{"type":"text","text":"event and both versions ("},{"code":"DropReport.versionMismatch","type":"codeVoice"},{"type":"text","text":"). A tracking plan’s check"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"code":"TrackingPlans","type":"codeVoice"},{"type":"text","text":") fails on a change that needs a new version while the version stayed"},{"type":"text","text":" "},{"type":"text","text":"the same, naming the event, the property and the change."}]},{"type":"paragraph","inlineContent":[{"text":"These changes are compatible. Keep the version, and the records stored before the change are","type":"text"},{"text":" ","type":"text"},{"text":"read by each property’s name, in any order:","type":"text"}]},{"syntax":"swift","code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"These changes are breaking. Raise the version with each, and the records stored at the earlier","type":"text"},{"text":" ","type":"text"},{"text":"one are dropped and reported:","type":"text"}]},{"syntax":"swift","code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"A version raised for a change whose bytes would still read, such as a property that keeps its","type":"text"},{"text":" ","type":"text"},{"text":"type but changes its meaning, drops the earlier records all the same, so they are never read","type":"text"},{"text":" ","type":"text"},{"text":"as the new shape. Records are never migrated from one version to another.","type":"text"}]}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)"},"abstract":[{"text":"Makes a struct an event: derives its ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" conformances, its name and its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"text":" from its declaration.","type":"text"}],"sections":[],"variants":[{"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EventMacros/documentation/EventMacros":{"abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","kind":"symbol","url":"\/documentation\/eventmacros","title":"EventMacros","role":"collection"},"doc://Events/documentation/Events/Event":{"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/events\/event","navigatorTitle":[{"kind":"identifier","text":"Event"}],"abstract":[{"type":"text","text":"Something that happened, recorded as a typed value."}],"title":"Event","identifier":"doc:\/\/Events\/documentation\/Events\/Event","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}]},"doc://Persistence/documentation/Persistence/BinaryCodable":{"abstract":[{"type":"text","text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk."}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","navigatorTitle":[{"kind":"identifier","text":"BinaryCodable"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryCodable"}],"url":"\/documentation\/persistence\/binarycodable","title":"BinaryCodable","role":"symbol"},"doc://Events/documentation/Events/EventSchema":{"url":"\/documentation\/events\/eventschema","kind":"symbol","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","abstract":[{"text":"The shape of an event type: its name, its schema version, its consent category and its stored","type":"text"},{"text":" ","type":"text"},{"text":"properties in declaration order, as a value tooling reads.","type":"text"}],"title":"EventSchema","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventSchema","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"EventSchema","kind":"identifier"}]},"doc://Events/documentation/Events/ConsentCategory":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/events\/consentcategory","navigatorTitle":[{"text":"ConsentCategory","kind":"identifier"}],"abstract":[{"type":"text","text":"The purpose an event is collected for, which the user consents to or refuses: analytics,"},{"type":"text","text":" "},{"type":"text","text":"advertising and the like."}],"title":"ConsentCategory","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsentCategory","kind":"identifier"}]},"doc://Events/documentation/Events/Refined":{"abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"type":"codeVoice","code":"Rule"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","navigatorTitle":[{"text":"Refined","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}],"url":"\/documentation\/events\/refined","title":"Refined","role":"symbol"},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"url":"\/documentation\/eventmacros\/constrained(_:)","kind":"symbol","type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"title":"Constrained(_:)","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO"},{"kind":"text","text":"...)"}],"role":"symbol"},"doc://Events/documentation/Events/ConsentCategory/analytics":{"abstract":[{"type":"text","text":"Measuring how the product is used: the category of every event that names no other."}],"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"analytics"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"}],"url":"\/documentation\/events\/consentcategory\/analytics","title":"analytics","role":"symbol"},"doc://Events/documentation/Events/Sensitive":{"url":"\/documentation\/events\/sensitive","type":"topic","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"title":"Sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}]},"doc://EventMacros/documentation/EventMacros/Event(name:consent:version:)":{"abstract":[{"text":"Makes a struct an event: derives its ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"BinaryCodable"},{"text":" conformances, its name and its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference","isActive":true},{"text":" from its declaration.","type":"text"}],"type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","kind":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/eventmacros\/event(name:consent:version:)","title":"Event(name:consent:version:)","role":"symbol"}}}