ext","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}]},"doc://Events/documentation/Events/EventSchema":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventSchema","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"EventSchema","kind":"identifier"}],"url":"\/documentation\/events\/eventschema","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","abstract":[{"type":"text","text":"The shape of an event type: its name, its schema version, its consent category and its stored"},{"type":"text","text":" "},{"type":"text","text":"properties in declaration order, as a value tooling reads."}],"kind":"symbol","title":"EventSchema"},"doc://EventMacros/documentation/EventMacros/Event(name:consent:version:)":{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","type":"topic","title":"Event(name:consent:version:)","url":"\/documentation\/eventmacros\/event(name:consent:version:)","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Makes a struct an event: derives its "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformances, its name and its"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"type":"text","text":" from its declaration."}]},"doc://Events/documentation/Events/Sensitive":{"url":"\/documentation\/events\/sensitive","title":"Sensitive","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"topic","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}]},"doc://Events/documentation/Events/ConsentCategory":{"title":"ConsentCategory","kind":"symbol","abstract":[{"type":"text","text":"The purpose an event is collected for, which the user consents to or refuses: analytics,"},{"type":"text","text":" "},{"type":"text","text":"advertising and the like."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsentCategory"}],"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","navigatorTitle":[{"kind":"identifier","text":"ConsentCategory"}],"url":"\/documentation\/events\/consentcategory","role":"symbol"},"doc://Events/documentation/Events/DiscoveredEvent/all":{"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"all","kind":"identifier"},{"text":": [","kind":"text"},{"text":"DiscoveredEvent","kind":"typeIdentifier","preciseIdentifier":"s:6Events15DiscoveredEventV"},{"text":"]","kind":"text"}],"role":"symbol","url":"\/documentation\/events\/discoveredevent\/all","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","abstract":[{"text":"Every event type the program links, ordered by the UTF-8 bytes of their names, then by","type":"text"},{"text":" ","type":"text"},{"text":"version, then by the types’ fully qualified names.","type":"text"}],"title":"all"},"doc://Events/documentation/Events/ConsentCategory/analytics":{"title":"analytics","kind":"symbol","abstract":[{"type":"text","text":"Measuring how the product is used: the category of every event that names no other."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"analytics","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","url":"\/documentation\/events\/consentcategory\/analytics","role":"symbol"},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"url":"\/documentation\/eventmacros\/constrained(_:)","title":"Constrained(_:)","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"topic","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ValidationKeyword","kind":"typeIdentifier","preciseIdentifier":"s:6Events17ValidationKeywordO"},{"text":"...)","kind":"text"}],"role":"symbol","kind":"symbol","abstract":[{"text":"Declares the constraints a stored property of an ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct satisfies, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" ","type":"text"},{"text":"checks and lists in the event’s schema.","type":"text"}]}}}