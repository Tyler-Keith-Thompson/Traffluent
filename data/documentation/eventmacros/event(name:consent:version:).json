"kind":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)"},"doc://Events/documentation/Events/ConsentCategory/analytics":{"title":"analytics","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"analytics","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory","kind":"typeIdentifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","role":"symbol","abstract":[{"type":"text","text":"Measuring how the product is used: the category of every event that names no other."}],"type":"topic","kind":"symbol","url":"\/documentation\/events\/consentcategory\/analytics"},"doc://Events/documentation/Events/EventSchema":{"title":"EventSchema","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventSchema","kind":"identifier"}],"navigatorTitle":[{"text":"EventSchema","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","role":"symbol","type":"topic","abstract":[{"text":"The shape of an event type: its name, its schema version, its consent category and its stored","type":"text"},{"text":" ","type":"text"},{"text":"properties in declaration order, as a value tooling reads.","type":"text"}],"url":"\/documentation\/events\/eventschema","kind":"symbol"},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"url":"\/documentation\/eventmacros\/constrained(_:)","type":"topic","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","title":"Constrained(_:)","abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schem