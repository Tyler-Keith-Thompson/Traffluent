{"identifier":{"url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Makes a struct an event: derives its "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformances, its name and its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"type":"text","text":" from its declaration."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"text":"Event","kind":"typeIdentifier","preciseIdentifier":"s:6Events5EventP","identifier":"doc:\/\/Events\/documentation\/Events\/Event"},{"text":", ","kind":"text"},{"text":"Encodable","kind":"typeIdentifier","preciseIdentifier":"s:SE"},{"text":", ","kind":"text"},{"text":"Decodable","kind":"typeIdentifier","preciseIdentifier":"s:Se"},{"text":", ","kind":"text"},{"text":"__DiscoverableEvent","kind":"typeIdentifier"},{"text":", names: named(name), named(consentCategory), named(schemaVersion), named(schema), named(constraintViolation), named(CodingKeys), named(encode(to:)), named(init(from:)), named(decodeValue), named(decodeIfPresentValue), named(requireCodable), named(codableRequirements)) ","kind":"text"},{"text":"@attached","kind":"attribute"},{"text":"(peer) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory"},{"text":"? = nil, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = 1)","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name destinations record the event under, a string literal; the type’s name when"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"name"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The purpose the event is collected for; ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","isActive":true,"type":"reference"},{"text":" when ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}]}],"name":"consent"},{"content":[{"inlineContent":[{"type":"text","text":"The schema version, "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":": a positive integer literal, raised for"},{"type":"text","text":" "},{"type":"text","text":"each breaking change; 1 by default."}],"type":"paragraph"}],"name":"version"}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"codeListing","code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"],"syntax":"swift"},{"inlineContent":[{"text":"The macro adds a ","type":"text"},{"code":"nonisolated","type":"codeVoice"},{"text":" extension, so the conformance works off the main actor, where","type":"text"},{"text":" ","type":"text"},{"text":"the tracker encodes events, even when the struct is marked ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":"; such a struct’s stored","type":"text"},{"text":" ","type":"text"},{"text":"properties must then be ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":". The extension holds:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var name"},{"text":", when ","type":"text"},{"type":"codeVoice","code":"name"},{"text":" is given; otherwise the type’s name, ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":"’s default.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"static var consentCategory"},{"type":"text","text":", when "},{"type":"codeVoice","code":"consent"},{"type":"text","text":" is given; otherwise "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var schemaVersion"},{"type":"text","text":", when "},{"type":"codeVoice","code":"version"},{"type":"text","text":" is given; otherwise 1, "},{"type":"codeVoice","code":"Event"},{"type":"text","text":"’s default."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"static var schema"},{"type":"text","text":": an "},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference","isActive":true},{"type":"text","text":" with the event’s name, version and each stored"},{"type":"text","text":" "},{"type":"text","text":"property’s name, type as written, optionality, whether it has a default value and validation"},{"type":"text","text":" "},{"type":"text","text":"keywords (its "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","type":"reference","isActive":true},{"type":"text","text":" type’s rule’s, then those "},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"reference","isActive":true},{"type":"text","text":" declares), in"},{"type":"text","text":" "},{"type":"text","text":"declaration order. A property of a raw-value enum gets its"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema\/Enumeration","type":"reference","isActive":true},{"type":"text","text":", the cases’ raw values. The macro lists them when the"},{"type":"text","text":" "},{"type":"text","text":"enum is declared inside the struct, and reads them from "},{"type":"codeVoice","code":"allCases"},{"type":"text","text":" for one declared elsewhere"},{"type":"text","text":" "},{"type":"text","text":"or with a case under "},{"type":"codeVoice","code":"#if"},{"type":"text","text":". An enum declared elsewhere needs "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":" for a tracking"},{"type":"text","text":" "},{"type":"text","text":"plan to check its values; without it, and for a typealias of an enum, the plan accepts any"},{"type":"text","text":" "},{"type":"text","text":"value."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"constraintViolation()","type":"codeVoice"},{"text":", when a property declares constraints with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"first property, in declaration order, whose value breaks one, which a tracker rejects.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CodingKeys"},{"type":"text","text":", "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" and the private functions it reads some types"},{"type":"text","text":" "},{"type":"text","text":"through, which write a keyed container of the stored"},{"type":"text","text":" "},{"type":"text","text":"properties, each under its name, and read each back by its name, as a hand-written"},{"type":"text","text":" "},{"type":"text","text":"conformance would. A store writes the container as a CBOR map. An optional property’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" "},{"type":"text","text":"is left out, and an optional property missing from the map reads as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"; one with a"},{"type":"text","text":" "},{"type":"text","text":"default value reads as that value, so its "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" is written. A "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" property, optional or"},{"type":"text","text":" "},{"type":"text","text":"not, and each date in a "},{"type":"codeVoice","code":"[Date]"},{"type":"text","text":" or "},{"type":"codeVoice","code":"[Date?]"},{"type":"text","text":" property, is written as the seconds since 2001"},{"type":"text","text":" "},{"type":"text","text":"it stores, so it reads back exactly. A "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" inside a "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type of your own takes the"},{"type":"text","text":" "},{"type":"text","text":"CBOR package’s own form, seconds since 1970, and reads back to within a rounding of a"},{"type":"text","text":" "},{"type":"text","text":"microsecond’s scale. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" property goes through its own conformance, so only a store writes its"},{"type":"text","text":" "},{"type":"text","text":"value."}]}]}]},{"inlineContent":[{"text":"Beside the struct the macro adds a private record, which the compiler places in the binary so","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all"},{"text":" lists the event at run time, and ","type":"text"},{"type":"codeVoice","code":"SegmentStore()"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DatabaseStore(database:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"TrackingPlan()"},{"text":" take it without a list. The record holds the","type":"text"},{"text":" ","type":"text"},{"text":"struct as an ","type":"text"},{"type":"codeVoice","code":"__DiscoverableEvent"},{"text":", an underscored protocol the macro conforms it to and","type":"text"},{"text":" ","type":"text"},{"text":"discovery reads, which the event’s code doesn’t use. A generic struct, or","type":"text"},{"text":" ","type":"text"},{"text":"one nested in a generic type’s declaration, gets no record, as a record holds one concrete","type":"text"},{"text":" ","type":"text"},{"text":"type: it isn’t discovered, and the macro adds a note saying to list it. A struct declared in an","type":"text"},{"text":" ","type":"text"},{"text":"extension of a generic type doesn’t compile (","type":"text"},{"type":"codeVoice","code":"static stored properties not supported in generic types"},{"text":"), as the extension doesn’t say the type is generic; declare it outside the","type":"text"},{"text":" ","type":"text"},{"text":"generic type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every stored instance property is encoded, and needs a type annotation. Static and computed"},{"type":"text","text":" "},{"type":"text","text":"properties are left out, and so is a "},{"code":"let","type":"codeVoice"},{"type":"text","text":" with an initial value, which every value shares."},{"type":"text","text":" "},{"type":"text","text":"The struct keeps its memberwise initializer."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A stored property whose type isn’t "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" is a compile error naming it:"},{"type":"text","text":" "},{"type":"codeVoice","code":"static method 'requireCodable(bad:)' requires that 'Foo' conform to 'Decodable'"},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"property "},{"type":"codeVoice","code":"bad"},{"type":"text","text":" of type "},{"type":"codeVoice","code":"Foo"},{"type":"text","text":". A raw-value enum is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", written as its raw value, once it"},{"type":"text","text":" "},{"type":"text","text":"declares the conformance ("},{"type":"codeVoice","code":"enum Reason: String, Codable"},{"type":"text","text":"). One declared inside the struct must"},{"type":"text","text":" "},{"type":"text","text":"list it in its inheritance clause, even when an extension adds it, since the macro sees only"},{"type":"text","text":" "},{"type":"text","text":"the struct; without it, the error is the macro’s own, at that clause. Applying the macro to"},{"type":"text","text":" "},{"type":"text","text":"anything but a struct, a property with no type annotation, a "},{"type":"codeVoice","code":"lazy"},{"type":"text","text":" property, a destructuring"},{"type":"text","text":" "},{"type":"text","text":"pattern, a name that isn’t a non-empty string literal and a version that isn’t a positive"},{"type":"text","text":" "},{"type":"text","text":"integer literal are compile errors too."}],"type":"paragraph"},{"level":2,"text":"Changing an event","type":"heading","anchor":"Changing-an-event"},{"inlineContent":[{"type":"text","text":"A store may still hold records written before an event’s stored properties changed: an app"},{"type":"text","text":" "},{"type":"text","text":"updates with records on disk it hasn’t delivered. "},{"type":"codeVoice","code":"version"},{"type":"text","text":" counts the changes those records"},{"type":"text","text":" "},{"type":"text","text":"can’t be read through, and only those. Each record carries the version it was stored at, and a"},{"type":"text","text":" "},{"type":"text","text":"store drops one stored at another version than the type’s now without reading it, reporting the"},{"type":"text","text":" "},{"type":"text","text":"event and both versions ("},{"type":"codeVoice","code":"DropReport.versionMismatch"},{"type":"text","text":"). A tracking plan’s check"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":") fails on a change that needs a new version while the version stayed"},{"type":"text","text":" "},{"type":"text","text":"the same, naming the event, the property and the change."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These changes are compatible. Keep the version, and the records stored before the change are"},{"type":"text","text":" "},{"type":"text","text":"read by each property’s name, in any order:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"These changes are breaking. Raise the version with each, and the records stored at the earlier"},{"type":"text","text":" "},{"type":"text","text":"one are dropped and reported:"}],"type":"paragraph"},{"type":"codeListing","code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"],"syntax":"swift"},{"inlineContent":[{"text":"A version raised for a change whose bytes would still read, such as a property that keeps its","type":"text"},{"text":" ","type":"text"},{"text":"type but changes its meaning, drops the earlier records all the same, so they are never read","type":"text"},{"text":" ","type":"text"},{"text":"as the new shape. Records are never migrated from one version to another.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"]}],"metadata":{"title":"Event(name:consent:version:)","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L140","fileName":"Event.swift"},"externalID":"s:11EventMacros0A04name7consent7versionySSSg_6Events15ConsentCategoryVSgSitcfm","modules":[{"name":"EventMacros"}],"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"text":"?, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"symbolKind":"macro","role":"symbol","roleHeading":"Macro"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"references":{"doc://Events/documentation/Events/EventSchema/Enumeration":{"title":"EventSchema.Enumeration","kind":"symbol","abstract":[{"type":"text","t