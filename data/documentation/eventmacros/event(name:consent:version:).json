{"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"metadata":{"role":"symbol","symbolKind":"macro","title":"Event(name:consent:version:)","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L107","fileName":"Event.swift"},"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","text":"ConsentCategory"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":")"}],"modules":[{"name":"EventMacros"}],"roleHeading":"Macro","externalID":"s:11EventMacros0A04name7consent7versionySSSg_6Events15ConsentCategoryVSgSitcfm"},"identifier":{"url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(extension, conformances: "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Event","kind":"typeIdentifier","text":"Event","preciseIdentifier":"s:6Events5EventP"},{"kind":"text","text":", "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","kind":"typeIdentifier","text":"BinaryCodable","preciseIdentifier":"s:11Persistence13BinaryCodableP"},{"kind":"text","text":", names: named(name), named(consentCategory), named(schemaVersion), named(schema), named(constraintViolation), named(encode(to:)), named(init(from:)), named(requireBinaryCodable), named(binaryCodableRequirements)) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","kind":"typeIdentifier","text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 1)"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"name","content":[{"inlineContent":[{"type":"text","text":"The name destinations record the event under, a string literal; the type’s name when"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"consent","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The purpose the event is collected for; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics"},{"type":"text","text":" when "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]},{"name":"version","content":[{"inlineContent":[{"text":"The schema version, ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":": a positive integer literal, raised for","type":"text"},{"text":" ","type":"text"},{"text":"each breaking change; 1 by default.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The macro adds an extension holding:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var name"},{"type":"text","text":", when "},{"type":"codeVoice","code":"name"},{"type":"text","text":" is given; otherwise the type’s name, "},{"type":"codeVoice","code":"Event"},{"type":"text","text":"’s default."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"static var consentCategory"},{"type":"text","text":", when "},{"type":"codeVoice","code":"consent"},{"type":"text","text":" is given; otherwise "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"static var schemaVersion","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" is given; otherwise 1, ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":"’s default.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"static var schema","type":"codeVoice"},{"text":": an ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true,"type":"reference"},{"text":" with the event’s name, version and each stored","type":"text"},{"text":" ","type":"text"},{"text":"property’s name, type as written, optionality, whether it has a default value and validation","type":"text"},{"text":" ","type":"text"},{"text":"keywords (its ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true,"type":"reference"},{"text":" type’s rule’s, then those ","type":"text"},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true,"type":"reference"},{"text":" declares), in","type":"text"},{"text":" ","type":"text"},{"text":"declaration order.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"constraintViolation()"},{"type":"text","text":", when a property declares constraints with "},{"isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"reference"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"first property, in declaration order, whose value breaks one, which a tracker rejects."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":", which write a CBOR map of the stored properties, each under"},{"type":"text","text":" "},{"type":"text","text":"its name, in declaration order, and read each back by its name, as a hand-written conformance"},{"type":"text","text":" "},{"type":"text","text":"would. An optional property missing from the map reads as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", and one with a default"},{"type":"text","text":" "},{"type":"text","text":"value as that value. A "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"type":"text","text":" property goes through its own conformance, so"},{"type":"text","text":" "},{"type":"text","text":"only a store’s encoder writes its value."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Every stored instance property is encoded, and needs a type annotation. Static and computed"},{"type":"text","text":" "},{"type":"text","text":"properties are left out, and so is a "},{"code":"let","type":"codeVoice"},{"type":"text","text":" with an initial value, which every value shares."},{"type":"text","text":" "},{"type":"text","text":"The struct keeps its memberwise initializer."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A stored property whose type isn’t "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" is a compile error naming it:"},{"type":"text","text":" "},{"type":"codeVoice","code":"static method 'requireBinaryCodable(bad:)' requires that 'Foo' conform to 'BinaryCodable'"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"a property "},{"type":"codeVoice","code":"bad"},{"type":"text","text":" of type "},{"type":"codeVoice","code":"Foo"},{"type":"text","text":". Applying the macro to anything but a struct, a property with no"},{"type":"text","text":" "},{"type":"text","text":"type annotation, a "},{"type":"codeVoice","code":"lazy"},{"type":"text","text":" property, a destructuring pattern, a name that isn’t a non-empty string"},{"type":"text","text":" "},{"type":"text","text":"literal and a version that isn’t a positive integer literal are compile errors too."}],"type":"paragraph"},{"anchor":"Changing-an-event","level":2,"type":"heading","text":"Changing an event"},{"inlineContent":[{"text":"A store may still hold records written before an event’s stored properties changed: an app","type":"text"},{"text":" ","type":"text"},{"text":"updates with records on disk it hasn’t delivered. ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" counts the changes those records","type":"text"},{"text":" ","type":"text"},{"text":"can’t be read through, and only those. Each record carries the version it was stored at, and a","type":"text"},{"text":" ","type":"text"},{"text":"store drops one stored at another version than the type’s now without reading it, reporting the","type":"text"},{"text":" ","type":"text"},{"text":"event and both versions (","type":"text"},{"type":"codeVoice","code":"DropReport.versionMismatch"},{"text":"). A tracking plan’s check","type":"text"},{"text":" ","type":"text"},{"text":"(module ","type":"text"},{"type":"codeVoice","code":"TrackingPlans"},{"text":") fails on a change that needs a new version while the version stayed","type":"text"},{"text":" ","type":"text"},{"text":"the same, naming the event, the property and the change.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These changes are compatible. Keep the version, and the records stored before the change are"},{"type":"text","text":" "},{"type":"text","text":"read by each property’s name, in any order:"}],"type":"paragraph"},{"code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"These changes are breaking. Raise the version with each, and the records stored at the earlier","type":"text"},{"text":" ","type":"text"},{"text":"one are dropped and reported:","type":"text"}],"type":"paragraph"},{"code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A version raised for a change whose bytes would still read, such as a property that keeps its","type":"text"},{"text":" ","type":"text"},{"text":"type but changes its meaning, drops the earlier records all the same, so they are never read","type":"text"},{"text":" ","type":"text"},{"text":"as the new shape. Records are never migrated from one version to another.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Makes a struct an event: derives its "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" conformances, its name and its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"type":"text","text":" from its declaration."}],"references":{"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","kind":"symbol","url":"\/documentation\/eventmacros\/constrained(_:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO"},{"kind":"text","text":"...)"}],"title":"Constrained(_:)"},"doc://Events/documentation/Events/EventSchema":{"type":"topic","url":"\/documentation\/events\/eventschema","abstract":[{"type":"text","text":"The shape of an event type: its name, its schema version, its consent category and its stored"},{"type":"text","text":" "},{"type":"text","text":"properties in declaration order, as a value tooling reads."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventSchema","kind":"identifier"}],"title":"EventSchema","navigatorTitle":[{"text":"EventSchema","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},"doc://Events/documentation/Events/ConsentCategory":{"abstract":[{"type":"text","text":"The purpose an event is collected for, which the user consents to or refuses: analytics,"},{"type":"text","text":" "},{"type":"text","text":"advertising and the like."}],"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","kind":"symbol","navigatorTitle":[{"text":"ConsentCategory","kind":"identifier"}],"url":"\/documentation\/events\/consentcategory","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsentCategory","kind":"identifier"}],"title":"ConsentCategory"},"doc://EventMacros/documentation/EventMacros":{"type":"topic","abstract":[],"url":"\/documentation\/eventmacros","kind":"symbol","title":"EventMacros","role":"collection","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},"doc://Events/documentation/Events/ConsentCategory/analytics":{"abstract":[{"text":"Measuring how the product is used: the category of every event that names no other.","type":"text"}],"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","kind":"symbol","url":"\/documentation\/events\/consentcategory\/analytics","role":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"analytics","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV"}],"title":"analytics"},"doc://Events/documentation/Events/Event":{"type":"topic","kind":"symbol","url":"\/documentation\/events\/event","abstract":[{"te