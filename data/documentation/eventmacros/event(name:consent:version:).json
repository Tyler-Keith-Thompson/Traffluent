tion order, as a value tooling reads.","type":"text"}],"role":"symbol","type":"topic","title":"EventSchema","navigatorTitle":[{"text":"EventSchema","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventSchema","kind":"identifier"}],"url":"\/documentation\/events\/eventschema"},"doc://Persistence/documentation/Persistence/BinaryCodable":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","role":"symbol","abstract":[{"text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryCodable"}],"title":"BinaryCodable","kind":"symbol","url":"\/documentation\/persistence\/binarycodable","navigatorTitle":[{"kind":"identifier","text":"BinaryCodable"}]},"doc://Events/documentation/Events/Sensitive":{"abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"role":"symbol","type":"topic","title":"Sensitive","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"url":"\/documentation\/events\/sensitive"}}}