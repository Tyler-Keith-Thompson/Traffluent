{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"abstract":[{"text":"Makes a struct an event: derives its ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" conformances, its name and its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference"},{"text":" from its declaration.","type":"text"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"text":"Event","kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/Event","preciseIdentifier":"s:6Events5EventP"},{"text":", ","kind":"text"},{"text":"BinaryCodable","kind":"typeIdentifier","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","preciseIdentifier":"s:11Persistence13BinaryCodableP"},{"text":", names: named(name), named(consentCategory), named(schemaVersion), named(schema), named(constraintViolation), named(encode(to:)), named(init(from:)), named(requireBinaryCodable), named(binaryCodableRequirements)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"text":"? = nil, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = 1)","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The name destinations record the event under, a string literal; the type’s name when","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"name"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The purpose the event is collected for; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics"},{"type":"text","text":" when "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"consent"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The schema version, "},{"code":"Event.schemaVersion","type":"codeVoice"},{"type":"text","text":": a positive integer literal, raised for"},{"type":"text","text":" "},{"type":"text","text":"each breaking change; 1 by default."}]}],"name":"version"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"codeListing","syntax":"swift","code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The macro adds an extension holding:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var name"},{"type":"text","text":", when "},{"type":"codeVoice","code":"name"},{"type":"text","text":" is given; otherwise the type’s name, "},{"type":"codeVoice","code":"Event"},{"type":"text","text":"’s default."}]}]},{"content":[{"inlineContent":[{"code":"static var consentCategory","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"consent","type":"codeVoice"},{"text":" is given; otherwise ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"static var schemaVersion"},{"type":"text","text":", when "},{"type":"codeVoice","code":"version"},{"type":"text","text":" is given; otherwise 1, "},{"type":"codeVoice","code":"Event"},{"type":"text","text":"’s default."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"static var schema"},{"type":"text","text":": an "},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference","isActive":true},{"type":"text","text":" with the event’s name, version and each stored"},{"type":"text","text":" "},{"type":"text","text":"property’s name, type as written, optionality, whether it has a default value and validation"},{"type":"text","text":" "},{"type":"text","text":"keywords (its "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","type":"reference","isActive":true},{"type":"text","text":" type’s rule’s, then those "},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"reference","isActive":true},{"type":"text","text":" declares), in"},{"type":"text","text":" "},{"type":"text","text":"declaration order."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"constraintViolation()"},{"type":"text","text":", when a property declares constraints with "},{"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"first property, in declaration order, whose value breaks one, which a tracker rejects."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"encode(to:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":", which write a CBOR map of the stored properties, each under","type":"text"},{"text":" ","type":"text"},{"text":"its name, in declaration order, and read each back by its name, as a hand-written conformance","type":"text"},{"text":" ","type":"text"},{"text":"would. An optional property missing from the map reads as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", and one with a default","type":"text"},{"text":" ","type":"text"},{"text":"value as that value. A ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" property goes through its own conformance, so","type":"text"},{"text":" ","type":"text"},{"text":"only a store’s encoder writes its value.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Every stored instance property is encoded, and needs a type annotation. Static and computed","type":"text"},{"text":" ","type":"text"},{"text":"properties are left out, and so is a ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" with an initial value, which every value shares.","type":"text"},{"text":" ","type":"text"},{"text":"The struct keeps its memberwise initializer.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A stored property whose type isn’t ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" is a compile error naming it:","type":"text"},{"text":" ","type":"text"},{"code":"static method 'requireBinaryCodable(bad:)' requires that 'Foo' conform to 'BinaryCodable'","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"a property ","type":"text"},{"code":"bad","type":"codeVoice"},{"text":" of type ","type":"text"},{"code":"Foo","type":"codeVoice"},{"text":". Applying the macro to anything but a struct, a property with no","type":"text"},{"text":" ","type":"text"},{"text":"type annotation, a ","type":"text"},{"code":"lazy","type":"codeVoice"},{"text":" property, a destructuring pattern, a name that isn’t a non-empty string","type":"text"},{"text":" ","type":"text"},{"text":"literal and a version that isn’t a positive integer literal are compile errors too.","type":"text"}]},{"type":"heading","level":2,"anchor":"Changing-an-event","text":"Changing an event"},{"type":"paragraph","inlineContent":[{"text":"A store may still hold records written before an event’s stored properties changed: an app","type":"text"},{"text":" ","type":"text"},{"text":"updates with records on disk it hasn’t delivered. ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" counts the changes those records","type":"text"},{"text":" ","type":"text"},{"text":"can’t be read through, and only those. Each record carries the version it was stored at, and a","type":"text"},{"text":" ","type":"text"},{"text":"store drops one stored at another version than the type’s now without reading it, reporting the","type":"text"},{"text":" ","type":"text"},{"text":"event and both versions (","type":"text"},{"type":"codeVoice","code":"DropReport.versionMismatch"},{"text":"). A tracking plan’s check","type":"text"},{"text":" ","type":"text"},{"text":"(module ","type":"text"},{"type":"codeVoice","code":"TrackingPlans"},{"text":") fails on a change that needs a new version while the version stayed","type":"text"},{"text":" ","type":"text"},{"text":"the same, naming the event, the property and the change.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"These changes are compatible. Keep the version, and the records stored before the change are","type":"text"},{"text":" ","type":"text"},{"text":"read by each property’s name, in any order:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These changes are breaking. Raise the version with each, and the records stored at the earlier"},{"type":"text","text":" "},{"type":"text","text":"one are dropped and reported:"}]},{"type":"codeListing","syntax":"swift","code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A version raised for a change whose bytes would still read, such as a property that keeps its"},{"type":"text","text":" "},{"type":"text","text":"type but changes its meaning, drops the earlier records all the same, so they are never read"},{"type":"text","text":" "},{"type":"text","text":"as the new shape. Records are never migrated from one version to another."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"identifier":{"url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","interfaceLanguage":"swift"},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L107","fileName":"Event.swift"},"symbolKind":"macro","externalID":"s:11EventMacros0A04name7consent7versionySSSg_6Events15ConsentCategoryVSgSitcfm","modules":[{"name":"EventMacros"}],"title":"Event(name:consent:version:)","roleHeading":"Macro","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"role":"symbol"},"variants":[{"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Events/documentation/Events/Sensitive":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"title":"Sensitive","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"url":"\/documentation\/events\/sensitive"},"doc://Events/documentation/Events/Refined":{"abstract":[{"text":"A value that satisfies every constraint of ","type":"text"},{"code":"Rule","type":"codeVoice"},{"text":", checked once as it is made, so a property of","type":"text"},{"text":" ","type":"text"},{"text":"this type can’t hold one that doesn’t.","type":"text"}],"type":"topic","url":"\/documentation\/events\/refined","title":"Refined","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}],"navigatorTitle":[{"text":"Refined","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"type":"topic","abstract":[{"text":"Declares the constraints a stored property of an ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct satisfies, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" ","type":"text"},{"text":"checks and lists in the event’s schema.","type":"text"}],"kind":"symbol","title":"Constrained(_:)","url":"\/documentation\/eventmacros\/constrained(_:)","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO","kind":"typeIdentifier"},{"text":"...)","kind":"text"}],"role":"symbol"},"doc://Events/documentation/Events/EventSchema":{"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","url":"\/documentation\/events\/eventschema","title":"EventSchema","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventSchema","kind":"identifier"}],"navigatorTitle":[{"text":"EventSchema","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The shape of an event type: its name, its schema version, its consent category and its stored"},{"type":"text","text":" "},{"type":"text","text":"properties in declaration order, as a value tooling reads."}]},"doc://Events/documentation/Events/ConsentCategory/analytics":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"analytics","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier"}],"title":"analytics","abstract":[{"type":"text","text":"Measuring how the product is used: the category of every event that names no other."}],"type":"topic","url":"\/documentation\/events\/consentcategory\/analytics"},"doc://Events/documentation/Events/Event":{"abstract":[{"type":"text","text":"Something that happened, recorded as a typed value."}],"identifier":"doc:\/\/Events\/documentation\/Events\/Event","url":"\/documentation\/events\/event","title":"Event","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"}],"navigatorTitle":[{"text":"Event","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic"},"doc://Events/documentation/Events/ConsentCategory":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsentCategory","kind":"identifier"}],"title":"ConsentCategory","abstract":[{"text":"The purpose an event is collected for, which the user consents to or refuses: analytics,","type":"text"},{"text":" ","type":"text"},{"text":"advertising and the like.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"ConsentCategory","kind":"identifier"}],"url":"\/documentation\/events\/consentcategory"},"doc://EventMacros/documentation/EventMacros/Event(name:consent:version:)":{"abstract":[{"text":"Makes a struct an event: derives its ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" conformances, its name and its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference"},{"text":" from its declaration.","type":"text"}],"type":"topic","url":"\/documentation\/eventmacros\/event(name:consent:version:)","title":"Event(name:consent:version:)","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"text":"?, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)"},"doc://EventMacros/documentation/EventMacros":{"type":"topic","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"kind":"symbol","title":"EventMacros","url":"\/documentation\/eventmacros","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","role":"collection"},"doc://Persistence/documentation/Persistence/BinaryCodable":{"abstract":[{"type":"text","text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk."}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","url":"\/documentation\/persistence\/binarycodable","title":"BinaryCodable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryCodable","kind":"identifier"}],"navigatorTitle":[{"text":"BinaryCodable","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic"}}}