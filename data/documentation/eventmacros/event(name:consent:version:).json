{"metadata":{"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"remoteSource":{"fileName":"Event.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L140"},"modules":[{"name":"EventMacros"}],"roleHeading":"Macro","title":"Event(name:consent:version:)","externalID":"s:11EventMacros0A04name7consent7versionySSSg_6Events15ConsentCategoryVSgSitcfm","symbolKind":"macro","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)"},"sections":[],"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"kind":"symbol","abstract":[{"text":"Makes a struct an event: derives its ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformances, its name and its","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true},{"text":" from its declaration.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"preciseIdentifier":"s:6Events5EventP","identifier":"doc:\/\/Events\/documentation\/Events\/Event","text":"Event","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:SE","text":"Encodable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:Se","text":"Decodable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"__DiscoverableEvent","kind":"typeIdentifier"},{"text":", names: named(name), named(consentCategory), named(schemaVersion), named(schema), named(constraintViolation), named(CodingKeys), named(encode(to:)), named(init(from:)), named(decodeValue), named(decodeIfPresentValue), named(requireCodable), named(codableRequirements)) ","kind":"text"},{"text":"@attached","kind":"attribute"},{"text":"(peer) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events15ConsentCategoryV","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","text":"ConsentCategory","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = 1)","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"name","content":[{"type":"paragraph","inlineContent":[{"text":"The name destinations record the event under, a string literal; the type’s name when","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]},{"name":"consent","content":[{"inlineContent":[{"type":"text","text":"The purpose the event is collected for; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics"},{"type":"text","text":" when "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"version","content":[{"inlineContent":[{"type":"text","text":"The schema version, "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":": a positive integer literal, raised for"},{"type":"text","text":" "},{"type":"text","text":"each breaking change; 1 by default."}],"type":"paragraph"}]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"codeListing","syntax":"swift","code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The macro adds a "},{"code":"nonisolated","type":"codeVoice"},{"type":"text","text":" extension, so the conformance works off the main actor, where"},{"type":"text","text":" "},{"type":"text","text":"the tracker encodes events, even when the struct is marked "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":"; such a struct’s stored"},{"type":"text","text":" "},{"type":"text","text":"properties must then be "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":". The extension holds:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var name"},{"type":"text","text":", when "},{"type":"codeVoice","code":"name"},{"type":"text","text":" is given; otherwise the type’s name, "},{"type":"codeVoice","code":"Event"},{"type":"text","text":"’s default."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"static var consentCategory"},{"text":", when ","type":"text"},{"type":"codeVoice","code":"consent"},{"text":" is given; otherwise ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"static var schemaVersion","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" is given; otherwise 1, ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":"’s default.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"static var schema","type":"codeVoice"},{"text":": an ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true,"type":"reference"},{"text":" with the event’s name, version and each stored","type":"text"},{"text":" ","type":"text"},{"text":"property’s name, type as written, optionality, whether it has a default value and validation","type":"text"},{"text":" ","type":"text"},{"text":"keywords (its ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true,"type":"reference"},{"text":" type’s rule’s, then those ","type":"text"},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true,"type":"reference"},{"text":" declares), in","type":"text"},{"text":" ","type":"text"},{"text":"declaration order. A property of a raw-value enum gets its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema\/Enumeration","isActive":true,"type":"reference"},{"text":", the cases’ raw values. The macro lists them when the","type":"text"},{"text":" ","type":"text"},{"text":"enum is declared inside the struct, and reads them from ","type":"text"},{"code":"allCases","type":"codeVoice"},{"text":" for one declared elsewhere","type":"text"},{"text":" ","type":"text"},{"text":"or with a case under ","type":"text"},{"code":"#if","type":"codeVoice"},{"text":". An enum declared elsewhere needs ","type":"text"},{"code":"CaseIterable","type":"codeVoice"},{"text":" for a tracking","type":"text"},{"text":" ","type":"text"},{"text":"plan to check its values; without it, and for a typealias of an enum, the plan accepts any","type":"text"},{"text":" ","type":"text"},{"text":"value.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"constraintViolation()"},{"type":"text","text":", when a property declares constraints with "},{"isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"reference"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"first property, in declaration order, whose value breaks one, which a tracker rejects."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CodingKeys"},{"text":", ","type":"text"},{"type":"codeVoice","code":"encode(to:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":" and the private functions it reads some types","type":"text"},{"text":" ","type":"text"},{"text":"through, which write a keyed container of the stored","type":"text"},{"text":" ","type":"text"},{"text":"properties, each under its name, and read each back by its name, as a hand-written","type":"text"},{"text":" ","type":"text"},{"text":"conformance would. A store writes the container as a CBOR map. An optional property’s ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" ","type":"text"},{"text":"is left out, and an optional property missing from the map reads as ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":"; one with a","type":"text"},{"text":" ","type":"text"},{"text":"default value reads as that value, so its ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" is written. A ","type":"text"},{"type":"codeVoice","code":"Date"},{"text":" property, optional or","type":"text"},{"text":" ","type":"text"},{"text":"not, and each date in a ","type":"text"},{"type":"codeVoice","code":"[Date]"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"[Date?]"},{"text":" property, is written as the seconds since 2001","type":"text"},{"text":" ","type":"text"},{"text":"it stores, so it reads back exactly. A ","type":"text"},{"type":"codeVoice","code":"Date"},{"text":" inside a ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" type of your own takes the","type":"text"},{"text":" ","type":"text"},{"text":"CBOR package’s own form, seconds since 1970, and reads back to within a rounding of a","type":"text"},{"text":" ","type":"text"},{"text":"microsecond’s scale. A","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"text":" property goes through its own conformance, so only a store writes its","type":"text"},{"text":" ","type":"text"},{"text":"value.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Beside the struct the macro adds a private record, which the compiler places in the binary so"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","isActive":true,"type":"reference"},{"type":"text","text":" lists the event at run time, and "},{"code":"SegmentStore()","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"DatabaseStore(database:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"TrackingPlan()","type":"codeVoice"},{"type":"text","text":" take it without a list. The record holds the"},{"type":"text","text":" "},{"type":"text","text":"struct as an "},{"code":"__DiscoverableEvent","type":"codeVoice"},{"type":"text","text":", an underscored protocol the macro conforms it to and"},{"type":"text","text":" "},{"type":"text","text":"discovery reads, which the event’s code doesn’t use. A generic struct, or"},{"type":"text","text":" "},{"type":"text","text":"one nested in a generic type’s declaration, gets no record, as a record holds one concrete"},{"type":"text","text":" "},{"type":"text","text":"type: it isn’t discovered, and the macro adds a note saying to list it. A struct declared in an"},{"type":"text","text":" "},{"type":"text","text":"extension of a generic type doesn’t compile ("},{"code":"static stored properties not supported in generic types","type":"codeVoice"},{"type":"text","text":"), as the extension doesn’t say the type is generic; declare it outside the"},{"type":"text","text":" "},{"type":"text","text":"generic type."}]},{"type":"paragraph","inlineContent":[{"text":"Every stored instance property is encoded, and needs a type annotation. Static and computed","type":"text"},{"text":" ","type":"text"},{"text":"properties are left out, and so is a ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" with an initial value, which every value shares.","type":"text"},{"text":" ","type":"text"},{"text":"The struct keeps its memberwise initializer.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A stored property whose type isn’t "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" is a compile error naming it:"},{"type":"text","text":" "},{"type":"codeVoice","code":"static method 'requireCodable(bad:)' requires that 'Foo' conform to 'Decodable'"},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"property "},{"type":"codeVoice","code":"bad"},{"type":"text","text":" of type "},{"type":"codeVoice","code":"Foo"},{"type":"text","text":". A raw-value enum is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", written as its raw value, once it"},{"type":"text","text":" "},{"type":"text","text":"declares the conformance ("},{"type":"codeVoice","code":"enum Reason: String, Codable"},{"type":"text","text":"). One declared inside the struct must"},{"type":"text","text":" "},{"type":"text","text":"list it in its inheritance clause, even when an extension adds it, since the macro sees only"},{"type":"text","text":" "},{"type":"text","text":"the struct; without it, the error is the macro’s own, at that clause. Applying the macro to"},{"type":"text","text":" "},{"type":"text","text":"anything but a struct, a property with no type annotation, a "},{"type":"codeVoice","code":"lazy"},{"type":"text","text":" property, a destructuring"},{"type":"text","text":" "},{"type":"text","text":"pattern, a name that isn’t a non-empty string literal and a version that isn’t a positive"},{"type":"text","text":" "},{"type":"text","text":"integer literal are compile errors too."}]},{"type":"heading","anchor":"Changing-an-event","level":2,"text":"Changing an event"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A store may still hold records written before an event’s stored properties changed: an app"},{"type":"text","text":" "},{"type":"text","text":"updates with records on disk it hasn’t delivered. "},{"code":"version","type":"codeVoice"},{"type":"text","text":" counts the changes those records"},{"type":"text","text":" "},{"type":"text","text":"can’t be read through, and only those. Each record carries the version it was stored at, and a"},{"type":"text","text":" "},{"type":"text","text":"store drops one stored at another version than the type’s now without reading it, reporting the"},{"type":"text","text":" "},{"type":"text","text":"event and both versions ("},{"code":"DropReport.versionMismatch","type":"codeVoice"},{"type":"text","text":"). A tracking plan’s check"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"code":"TrackingPlans","type":"codeVoice"},{"type":"text","text":") fails on a change that needs a new version while the version stayed"},{"type":"text","text":" "},{"type":"text","text":"the same, naming the event, the property and the change."}]},{"type":"paragraph","inlineContent":[{"text":"These changes are compatible. Keep the version, and the records stored before the change are","type":"text"},{"text":" ","type":"text"},{"text":"read by each property’s name, in any order:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"]},{"type":"paragraph","inlineContent":[{"text":"These changes are breaking. Raise the version with each, and the records stored at the earlier","type":"text"},{"text":" ","type":"text"},{"text":"one are dropped and reported:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"]},{"type":"paragraph","inlineContent":[{"text":"A version raised for a change whose bytes would still read, such as a property that keeps its","type":"text"},{"text":" ","type":"text"},{"text":"type but changes its meaning, drops the earlier records all the same, so they are never read","type":"text"},{"text":" ","type":"text"},{"text":"as the new shape. Records are never migrated from one version to another.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"]}],"references":{"doc://Events/documentation/Events/Refined":{"title":"Refined","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Refined"}],"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Refined"}],"abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"type":"codeVoice","code":"Rule"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"url":"\/documentation\/events\/refined"},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"title":"Constrained(_:)","kind":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"topic","role":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ValidationKeyword","kind":"typeIdentifier","preciseIdentifier":"s:6Events17ValidationKeywordO"},{"text":"...)","kind":"text"}],"abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"url":"\/documentation\/eventmacros\/constrained(_:)"},"doc://Events/documentation/Events/EventSchema/Enumeration":{"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema\/Enumeration","kind":"symbol","title":"EventSchema.Enumeration","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Enumeration"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Enumeration"}],"url":"\/documentation\/events\/eventschema\/enumeration","abstract":[{"text":"The raw values a property of a raw-value enum is written as: the enum’s name, its raw value’s","type":"text"},{"text":" ","type":"text"},{"text":"type and, where they are known, every case’s raw value.","type":"text"}]},"doc://Events/documentation/Events/Sensitive":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"type":"topic","url":"\/documentation\/events\/sensitive","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"title":"Sensitive","role":"symbol"},"doc://Events/documentation/Events/ConsentCategory/analytics":{"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","title":"analytics","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"analytics"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV"}],"abstract":[{"text":"Measuring how the product is used: the category of every event that names no other.","type":"text"}],"url":"\/documentation\/events\/consentcategory\/analytics"},"doc://Events/documentation/Events/Event":{"identifier":"doc:\/\/Events\/documentation\/Events\/Event","type":"topic","kind":"symbol","title":"Event","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Event"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"url":"\/documentation\/events\/event","abstract":[{"text":"Something that happened, recorded as a typed value.","type":"text"}]},"doc://Events/documentation/Events/DiscoveredEvent/all":{"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredE