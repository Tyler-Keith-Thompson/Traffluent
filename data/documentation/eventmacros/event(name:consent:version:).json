{"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","interfaceLanguage":"swift"},"abstract":[{"text":"Makes a struct an event: derives its ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" conformances, its name and its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference"},{"text":" from its declaration.","type":"text"}],"metadata":{"symbolKind":"macro","role":"symbol","title":"Event(name:consent:version:)","externalID":"s:11EventMacros0A04name7consent7versionySSSg_6Events15ConsentCategoryVSgSitcfm","modules":[{"name":"EventMacros"}],"roleHeading":"Macro","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"remoteSource":{"fileName":"Event.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L107"}},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Event","preciseIdentifier":"s:6Events5EventP","text":"Event","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","preciseIdentifier":"s:11Persistence13BinaryCodableP","text":"BinaryCodable","kind":"typeIdentifier"},{"text":", names: named(name), named(consentCategory), named(schemaVersion), named(schema), named(constraintViolation), named(encode(to:)), named(init(from:)), named(requireBinaryCodable), named(binaryCodableRequirements)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = 1)","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"name","content":[{"type":"paragraph","inlineContent":[{"text":"The name destinations record the event under, a string literal; the type’s name when","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]},{"name":"consent","content":[{"type":"paragraph","inlineContent":[{"text":"The purpose the event is collected for; ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","isActive":true,"type":"reference"},{"text":" when ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]},{"name":"version","content":[{"type":"paragraph","inlineContent":[{"text":"The schema version, ","type":"text"},{"type":"codeVoice","code":"Event.schemaVersion"},{"text":": a positive integer literal, raised for","type":"text"},{"text":" ","type":"text"},{"text":"each breaking change; 1 by default.","type":"text"}]}]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"codeListing","syntax":"swift","code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"]},{"type":"paragraph","inlineContent":[{"text":"The macro adds an extension holding:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"static var name","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" is given; otherwise the type’s name, ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":"’s default.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"static var consentCategory","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"consent","type":"codeVoice"},{"text":" is given; otherwise ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"static var schemaVersion"},{"type":"text","text":", when "},{"type":"codeVoice","code":"version"},{"type":"text","text":" is given; otherwise 1, "},{"type":"codeVoice","code":"Event"},{"type":"text","text":"’s default."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var schema"},{"type":"text","text":": an "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true},{"type":"text","text":" with the event’s name, version and each stored"},{"type":"text","text":" "},{"type":"text","text":"property’s name, type as written, optionality, whether it has a default value and validation"},{"type":"text","text":" "},{"type":"text","text":"keywords (its "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true},{"type":"text","text":" type’s rule’s, then those "},{"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true},{"type":"text","text":" declares), in"},{"type":"text","text":" "},{"type":"text","text":"declaration order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"constraintViolation()"},{"type":"text","text":", when a property declares constraints with "},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true,"type":"reference"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"first property, in declaration order, whose value breaks one, which a tracker rejects."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":", which write a CBOR map of the stored properties, each under"},{"type":"text","text":" "},{"type":"text","text":"its name, in declaration order, and read each back by its name, as a hand-written conformance"},{"type":"text","text":" "},{"type":"text","text":"would. An optional property missing from the map reads as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", and one with a default"},{"type":"text","text":" "},{"type":"text","text":"value as that value. A "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" property goes through its own conformance, so"},{"type":"text","text":" "},{"type":"text","text":"only a store’s encoder writes its value."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every stored instance property is encoded, and needs a type annotation. Static and computed"},{"type":"text","text":" "},{"type":"text","text":"properties are left out, and so is a "},{"code":"let","type":"codeVoice"},{"type":"text","text":" with an initial value, which every value shares."},{"type":"text","text":" "},{"type":"text","text":"The struct keeps its memberwise initializer."}]},{"type":"paragraph","inlineContent":[{"text":"A stored property whose type isn’t ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" is a compile error naming it:","type":"text"},{"text":" ","type":"text"},{"code":"static method 'requireBinaryCodable(bad:)' requires that 'Foo' conform to 'BinaryCodable'","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"a property ","type":"text"},{"code":"bad","type":"codeVoice"},{"text":" of type ","type":"text"},{"code":"Foo","type":"codeVoice"},{"text":". Applying the macro to anything but a struct, a property with no","type":"text"},{"text":" ","type":"text"},{"text":"type annotation, a ","type":"text"},{"code":"lazy","type":"codeVoice"},{"text":" property, a destructuring pattern, a name that isn’t a non-empty string","type":"text"},{"text":" ","type":"text"},{"text":"literal and a version that isn’t a positive integer literal are compile errors too.","type":"text"}]},{"type":"heading","anchor":"Changing-an-event","level":2,"text":"Changing an event"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A store may still hold records written before an event’s stored properties changed: an app"},{"type":"text","text":" "},{"type":"text","text":"updates with records on disk it hasn’t delivered. "},{"type":"codeVoice","code":"version"},{"type":"text","text":" counts the changes those records"},{"type":"text","text":" "},{"type":"text","text":"can’t be read through, and only those. Each record carries the version it was stored at, and a"},{"type":"text","text":" "},{"type":"text","text":"store drops one stored at another version than the type’s now without reading it, reporting the"},{"type":"text","text":" "},{"type":"text","text":"event and both versions ("},{"type":"codeVoice","code":"DropReport.versionMismatch"},{"type":"text","text":"). A tracking plan’s check"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":") fails on a change that needs a new version while the version stayed"},{"type":"text","text":" "},{"type":"text","text":"the same, naming the event, the property and the change."}]},{"type":"paragraph","inlineContent":[{"text":"These changes are compatible. Keep the version, and the records stored before the change are","type":"text"},{"text":" ","type":"text"},{"text":"read by each property’s name, in any order:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"]},{"type":"paragraph","inlineContent":[{"text":"These changes are breaking. Raise the version with each, and the records stored at the earlier","type":"text"},{"text":" ","type":"text"},{"text":"one are dropped and reported:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"]},{"type":"paragraph","inlineContent":[{"text":"A version raised for a change whose bytes would still read, such as a property that keeps its","type":"text"},{"text":" ","type":"text"},{"text":"type but changes its meaning, drops the earlier records all the same, so they are never read","type":"text"},{"text":" ","type":"text"},{"text":"as the new shape. Records are never migrated from one version to another.","type":"text"}]}],"kind":"content"}],"references":{"doc://EventMacros/documentation/EventMacros":{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros","role":"collection","title":"EventMacros","abstract":[{"text":"Derive an event’s conformances, name and schema from its struct declaration, and declare the constraints its properties satisfy.","type":"text"}],"url":"\/documentation\/eventmacros","type":"topic","kind":"symbol"},"doc://Events/documentation/Events/Refined":{"kind":"symbol","abstract":[{"text":"A value that satisfies every constraint of ","type":"text"},{"code":"Rule","type":"codeVoice"},{"text":", checked once as it is made, so a property of","type":"text"},{"text":" ","type":"text"},{"text":"this type can’t hold one that doesn’t.","type":"text"}],"role":"symbol","title":"Refined","navigatorTitle":[{"text":"Refined","kind":"identifier"}],"url":"\/documentation\/events\/refined","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","type":"topic"},"doc://Events/documentation/Events/ConsentCategory/analytics":{"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","type":"topic","url":"\/documentation\/events\/consentcategory\/analytics","kind":"symbol","title":"analytics","abstract":[{"text":"Measuring how the product is used: the category of every event that names no other.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"analytics","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV"}]},"doc://Events/documentation/Events/Event":{"kind":"symbol","abstract":[{"type":"text","text":"Something that happened, recorded as a typed value."}],"role":"symbol","title":"Event","navigatorTitle":[{"kind":"identifier","text":"Event"}],"url":"\/documentation\/events\/event","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Event"},"doc://Events/documentation/Events/ConsentCategory":{"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","type":"topic","url":"\/documentation\/events\/consentcategory","kind":"symbol","navigatorTitle":[{"text":"ConsentCategory","kind":"identifier"}],"title":"ConsentCategory","abstract":[{"type":"text","text":"The purpose an event is collected for, which the user consents to or refuses: analytics,"},{"type":"text","text":" "},{"type":"text","text":"advertising and the like."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsentCategory","kind":"identifier"}]},"doc://EventMacros/documentation/EventMacros/Event(name:consent:version:)":{"kind":"symbol","abstract":[{"type":"text","text":"Makes a struct an event: derives its "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" conformances, its name and its"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"type":"text","text":" from its declaration."}],"role":"symbol","title":"Event(name:consent:version:)","url":"\/documentation\/eventmacros\/event(name:consent:version:)","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","type":"topic"},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"kind":"symbol","abstract":[{"text":"Declares the constraints a stored property of an ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct satisfies, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" ","type":"text"},{"text":"checks and lists in the event’s schema.","type":"text"}],"role":"symbol","title":"Constrained(_:)","url":"\/documentation\/eventmacros\/constrained(_:)","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constrained"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events17ValidationKeywordO","text":"ValidationKeyword"},{"kind":"text","text":"...)"}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","type":"topic"},"doc://Persistence/documentation/Persistence/BinaryCodable":{"role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","url":"\/documentation\/persistence\/binarycodable","type":"topic","kind":"symbol","navigatorTitle":[{"text":"BinaryCodable","kind":"identifier"}],"title":"BinaryCodable","abstract":[{"type":"text","text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryCodable","kind":"identifier"}]},"doc://Events/documentation/Events/Sensitive":{"kind":"symbol","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"role":"symbol","title":"Sensitive","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"url":"\/documentation\/events\/sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},"doc://Events/documentation/Events/EventSchema":{"kind":"symbol","abstract":[{"type":"text","text":"The shape of an event type: its name, its schema version, its consent category and its stored"},{"type":"text","text":" "},{"type":"text","text":"properties in declaration order, as a value tooling reads."}],"role":"symbol","title":"EventSchema","navigatorTitle":[{"text":"EventSchema","kind":"identifier"}],"url":"\/documentation\/events\/eventschema","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventSchema","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"topic"}}}