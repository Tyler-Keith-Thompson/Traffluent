{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Makes a struct an event: derives its "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformances, its name and its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true},{"type":"text","text":" from its declaration."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"text":"Event","identifier":"doc:\/\/Events\/documentation\/Events\/Event","kind":"typeIdentifier","preciseIdentifier":"s:6Events5EventP"},{"text":", ","kind":"text"},{"text":"Encodable","kind":"typeIdentifier","preciseIdentifier":"s:SE"},{"text":", ","kind":"text"},{"text":"Decodable","kind":"typeIdentifier","preciseIdentifier":"s:Se"},{"text":", names: named(name), named(consentCategory), named(schemaVersion), named(schema), named(constraintViolation), named(CodingKeys), named(encode(to:)), named(init(from:)), named(decodeValue), named(decodeIfPresentValue), named(requireCodable), named(codableRequirements)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ConsentCategory","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"text":"? = nil, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = 1)","kind":"text"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The name destinations record the event under, a string literal; the type’s name when"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"name"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The purpose the event is collected for; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics"},{"type":"text","text":" when "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"consent"},{"content":[{"inlineContent":[{"text":"The schema version, ","type":"text"},{"code":"Event.schemaVersion","type":"codeVoice"},{"text":": a positive integer literal, raised for","type":"text"},{"text":" ","type":"text"},{"text":"each breaking change; 1 by default.","type":"text"}],"type":"paragraph"}],"name":"version"}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The macro adds an extension holding:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"static var name"},{"text":", when ","type":"text"},{"type":"codeVoice","code":"name"},{"text":" is given; otherwise the type’s name, ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":"’s default.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var consentCategory"},{"type":"text","text":", when "},{"type":"codeVoice","code":"consent"},{"type":"text","text":" is given; otherwise "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var schemaVersion"},{"type":"text","text":", when "},{"type":"codeVoice","code":"version"},{"type":"text","text":" is given; otherwise 1, "},{"type":"codeVoice","code":"Event"},{"type":"text","text":"’s default."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var schema"},{"type":"text","text":": an "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true},{"type":"text","text":" with the event’s name, version and each stored"},{"type":"text","text":" "},{"type":"text","text":"property’s name, type as written, optionality, whether it has a default value and validation"},{"type":"text","text":" "},{"type":"text","text":"keywords (its "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true},{"type":"text","text":" type’s rule’s, then those "},{"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true},{"type":"text","text":" declares), in"},{"type":"text","text":" "},{"type":"text","text":"declaration order. A property of a raw-value enum gets its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema\/Enumeration","isActive":true},{"type":"text","text":", the cases’ raw values. The macro lists them when the"},{"type":"text","text":" "},{"type":"text","text":"enum is declared inside the struct, and reads them from "},{"type":"codeVoice","code":"allCases"},{"type":"text","text":" for one declared elsewhere"},{"type":"text","text":" "},{"type":"text","text":"or with a case under "},{"type":"codeVoice","code":"#if"},{"type":"text","text":". An enum declared elsewhere needs "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":" for a tracking"},{"type":"text","text":" "},{"type":"text","text":"plan to check its values; without it, and for a typealias of an enum, the plan accepts any"},{"type":"text","text":" "},{"type":"text","text":"value."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"constraintViolation()"},{"type":"text","text":", when a property declares constraints with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"first property, in declaration order, whose value breaks one, which a tracker rejects."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"CodingKeys","type":"codeVoice"},{"text":", ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" and the private functions it reads some types","type":"text"},{"text":" ","type":"text"},{"text":"through, which write a keyed container of the stored","type":"text"},{"text":" ","type":"text"},{"text":"properties, each under its name, and read each back by its name, as a hand-written","type":"text"},{"text":" ","type":"text"},{"text":"conformance would. A store writes the container as a CBOR map. An optional property’s ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is left out, and an optional property missing from the map reads as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":"; one with a","type":"text"},{"text":" ","type":"text"},{"text":"default value reads as that value, so its ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" is written. A ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" property, optional or","type":"text"},{"text":" ","type":"text"},{"text":"not, and each date in a ","type":"text"},{"code":"[Date]","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"[Date?]","type":"codeVoice"},{"text":" property, is written as the seconds since 2001","type":"text"},{"text":" ","type":"text"},{"text":"it stores, so it reads back exactly. A ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" inside a ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type of your own takes the","type":"text"},{"text":" ","type":"text"},{"text":"CBOR package’s own form, seconds since 1970, and reads back to within a rounding of a","type":"text"},{"text":" ","type":"text"},{"text":"microsecond’s scale. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"text":" property goes through its own conformance, so only a store writes its","type":"text"},{"text":" ","type":"text"},{"text":"value.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Every stored instance property is encoded, and needs a type annotation. Static and computed","type":"text"},{"text":" ","type":"text"},{"text":"properties are left out, and so is a ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" with an initial value, which every value shares.","type":"text"},{"text":" ","type":"text"},{"text":"The struct keeps its memberwise initializer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A stored property whose type isn’t ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" is a compile error naming it:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"static method 'requireCodable(bad:)' requires that 'Foo' conform to 'Decodable'"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"property ","type":"text"},{"type":"codeVoice","code":"bad"},{"text":" of type ","type":"text"},{"type":"codeVoice","code":"Foo"},{"text":". A raw-value enum is ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", written as its raw value, once it","type":"text"},{"text":" ","type":"text"},{"text":"declares the conformance (","type":"text"},{"type":"codeVoice","code":"enum Reason: String, Codable"},{"text":"). One declared inside the struct must","type":"text"},{"text":" ","type":"text"},{"text":"list it in its inheritance clause, even when an extension adds it, since the macro sees only","type":"text"},{"text":" ","type":"text"},{"text":"the struct; without it, the error is the macro’s own, at that clause. Applying the macro to","type":"text"},{"text":" ","type":"text"},{"text":"anything but a struct, a property with no type annotation, a ","type":"text"},{"type":"codeVoice","code":"lazy"},{"text":" property, a destructuring","type":"text"},{"text":" ","type":"text"},{"text":"pattern, a name that isn’t a non-empty string literal and a version that isn’t a positive","type":"text"},{"text":" ","type":"text"},{"text":"integer literal are compile errors too.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Changing-an-event","text":"Changing an event","type":"heading"},{"inlineContent":[{"text":"A store may still hold records written before an event’s stored properties changed: an app","type":"text"},{"text":" ","type":"text"},{"text":"updates with records on disk it hasn’t delivered. ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" counts the changes those records","type":"text"},{"text":" ","type":"text"},{"text":"can’t be read through, and only those. Each record carries the version it was stored at, and a","type":"text"},{"text":" ","type":"text"},{"text":"store drops one stored at another version than the type’s now without reading it, reporting the","type":"text"},{"text":" ","type":"text"},{"text":"event and both versions (","type":"text"},{"type":"codeVoice","code":"DropReport.versionMismatch"},{"text":"). A tracking plan’s check","type":"text"},{"text":" ","type":"text"},{"text":"(module ","type":"text"},{"type":"codeVoice","code":"TrackingPlans"},{"text":") fails on a change that needs a new version while the version stayed","type":"text"},{"text":" ","type":"text"},{"text":"the same, naming the event, the property and the change.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"These changes are compatible. Keep the version, and the records stored before the change are","type":"text"},{"text":" ","type":"text"},{"text":"read by each property’s name, in any order:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"These changes are breaking. Raise the version with each, and the records stored at the earlier"},{"type":"text","text":" "},{"type":"text","text":"one are dropped and reported:"}],"type":"paragraph"},{"code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A version raised for a change whose bytes would still read, such as a property that keeps its"},{"type":"text","text":" "},{"type":"text","text":"type but changes its meaning, drops the earlier records all the same, so they are never read"},{"type":"text","text":" "},{"type":"text","text":"as the new shape. Records are never migrated from one version to another."}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"]}],"metadata":{"modules":[{"name":"EventMacros"}],"roleHeading":"Macro","remoteSource":{"fileName":"Event.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L123"},"symbolKind":"macro","externalID":"s:11EventMacros0A04name7consent7versionySSSg_6Events15ConsentCategoryVSgSitcfm","role":"symbol","title":"Event(name:consent:version:)","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"text":"?, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}]},"references":{"doc://Events/documentation/Events/ConsentCategory/analytics":{"title":"analytics","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"analytics","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory","kind":"typeIdentifier"}],"type":"