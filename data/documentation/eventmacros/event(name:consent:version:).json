:" conformances, its name and its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"type":"text","text":" from its declaration."}],"url":"\/documentation\/eventmacros\/event(name:consent:version:)","title":"Event(name:consent:version:)"},"doc://Events/documentation/Events/ConsentCategory":{"url":"\/documentation\/events\/consentcategory","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsentCategory"}],"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","type":"topic","kind":"symbol","title":"ConsentCategory","abstract":[{"text":"The purpose an event is collected for, which the user consents to or refuses: analytics,","type":"text"},{"text":" ","type":"text"},{"text":"advertising and the like.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ConsentCategory"}]},"doc://Events/documentation/Events/Refined":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}],"navigatorTitle":[{"text":"Refined","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Refined","kind":"symbol","abstract":[{"text":"A value that satisfies every constraint of ","type":"text"},{"code":"Rule","type":"codeVoice"},{"text":", checked once as it is made, so a property of","type":"text"},{"text":" ","type":"text"},{"text":"this type can’t hold one that doesn’t.","type":"text"}],"title":"Refined","url":"\/documentation\/events\/refined"},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"url":"\/documentation\/eventmacros\/constrained(_:)","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ValidationKeyword","preciseIdentifier":"s:6Events17ValidationKeywordO","kind":"typeIdentifier"},{"text":"...)","kind":"text"}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","kind":"symbol","type":"topic","title":"Constrained(_:)","abstract":[{"text":"Declares the constraints a stored property of an ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" struct satisfies, which ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" ","type":"text"},{"text":"checks and lists in the event’s schema.","type":"text"}],"role":"symbol"},"doc://Events/documentation/Events/DiscoveredEvent/all":{"url":"\/documentation\/events\/discoveredevent\/all","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"all"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:6Events15DiscoveredEventV","kind":"typeIdentifier","text":"DiscoveredEvent"},{"kind":"text","text":"]"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","kind":"symbol","title":"all","abstract":[{"type":"text","text":"Every event type the program links, ordered by the UTF-8 bytes of their names, then by"},{"type":"text","text":" "},{"type":"text","text":"version, then by the types’ fully qualified names."}],"type":"topic"},"doc://Events/documentation/Events/Event":{"url":"\/documentation\/events\/event","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Event","type":"topic","kind":"symbol","title":"Event","abstract":[{"type":"text","text":"Something that happened, recorded as a typed value."}],"role":"symbol","navigatorTitle":[{"text":"Event","kind":"identifier"}]}}}