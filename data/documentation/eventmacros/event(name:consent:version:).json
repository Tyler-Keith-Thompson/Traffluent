{"hierarchy":{"paths":[["doc:\/\/EventMacros\/documentation\/EventMacros"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Event","preciseIdentifier":"s:6Events5EventP","text":"Event","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","preciseIdentifier":"s:11Persistence13BinaryCodableP","text":"BinaryCodable","kind":"typeIdentifier"},{"text":", names: named(name), named(consentCategory), named(schemaVersion), named(schema), named(constraintViolation), named(encode(to:)), named(init(from:)), named(requireBinaryCodable), named(binaryCodableRequirements)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = 1)","kind":"text"}],"platforms":["Linux"]}]},{"parameters":[{"name":"name","content":[{"inlineContent":[{"type":"text","text":"The name destinations record the event under, a string literal; the type’s name when"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"consent","content":[{"inlineContent":[{"type":"text","text":"The purpose the event is collected for; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics"},{"type":"text","text":" when "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"version","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The schema version, "},{"type":"codeVoice","code":"Event.schemaVersion"},{"type":"text","text":": a positive integer literal, raised for"},{"type":"text","text":" "},{"type":"text","text":"each breaking change; 1 by default."}]}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"syntax":"swift","type":"codeListing","code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"]},{"inlineContent":[{"type":"text","text":"The macro adds an extension holding:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var name"},{"type":"text","text":", when "},{"type":"codeVoice","code":"name"},{"type":"text","text":" is given; otherwise the type’s name, "},{"type":"codeVoice","code":"Event"},{"type":"text","text":"’s default."}]}]},{"content":[{"inlineContent":[{"code":"static var consentCategory","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"consent","type":"codeVoice"},{"text":" is given; otherwise ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var schemaVersion"},{"text":", when ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" is given; otherwise 1, ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":"’s default.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"static var schema","type":"codeVoice"},{"text":": an ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true,"type":"reference"},{"text":" with the event’s name, version and each stored","type":"text"},{"text":" ","type":"text"},{"text":"property’s name, type as written, optionality, whether it has a default value and validation","type":"text"},{"text":" ","type":"text"},{"text":"keywords (its ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","isActive":true,"type":"reference"},{"text":" type’s rule’s, then those ","type":"text"},{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true,"type":"reference"},{"text":" declares), in","type":"text"},{"text":" ","type":"text"},{"text":"declaration order.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"constraintViolation()"},{"type":"text","text":", when a property declares constraints with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"first property, in declaration order, whose value breaks one, which a tracker rejects."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":", which write a CBOR map of the stored properties, each under"},{"type":"text","text":" "},{"type":"text","text":"its name, in declaration order, and read each back by its name, as a hand-written conformance"},{"type":"text","text":" "},{"type":"text","text":"would. An optional property missing from the map reads as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", and one with a default"},{"type":"text","text":" "},{"type":"text","text":"value as that value. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" property goes through its own conformance, so"},{"type":"text","text":" "},{"type":"text","text":"only a store’s encoder writes its value."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Every stored instance property is encoded, and needs a type annotation. Static and computed"},{"type":"text","text":" "},{"type":"text","text":"properties are left out, and so is a "},{"type":"codeVoice","code":"let"},{"type":"text","text":" with an initial value, which every value shares."},{"type":"text","text":" "},{"type":"text","text":"The struct keeps its memberwise initializer."}],"type":"paragraph"},{"inlineContent":[{"text":"A stored property whose type isn’t ","type":"text"},{"code":"BinaryCodable","type":"codeVoice"},{"text":" is a compile error naming it:","type":"text"},{"text":" ","type":"text"},{"code":"static method 'requireBinaryCodable(bad:)' requires that 'Foo' conform to 'BinaryCodable'","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"a property ","type":"text"},{"code":"bad","type":"codeVoice"},{"text":" of type ","type":"text"},{"code":"Foo","type":"codeVoice"},{"text":". Applying the macro to anything but a struct, a property with no","type":"text"},{"text":" ","type":"text"},{"text":"type annotation, a ","type":"text"},{"code":"lazy","type":"codeVoice"},{"text":" property, a destructuring pattern, a name that isn’t a non-empty string","type":"text"},{"text":" ","type":"text"},{"text":"literal and a version that isn’t a positive integer literal are compile errors too.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Changing an event","type":"heading","anchor":"Changing-an-event"},{"inlineContent":[{"type":"text","text":"A store may still hold records written before an event’s stored properties changed: an app"},{"type":"text","text":" "},{"type":"text","text":"updates with records on disk it hasn’t delivered. "},{"code":"version","type":"codeVoice"},{"type":"text","text":" counts the changes those records"},{"type":"text","text":" "},{"type":"text","text":"can’t be read through, and only those. Each record carries the version it was stored at, and a"},{"type":"text","text":" "},{"type":"text","text":"store drops one stored at another version than the type’s now without reading it, reporting the"},{"type":"text","text":" "},{"type":"text","text":"event and both versions ("},{"code":"DropReport.versionMismatch","type":"codeVoice"},{"type":"text","text":"). A tracking plan’s check"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"code":"TrackingPlans","type":"codeVoice"},{"type":"text","text":") fails on a change that needs a new version while the version stayed"},{"type":"text","text":" "},{"type":"text","text":"the same, naming the event, the property and the change."}],"type":"paragraph"},{"inlineContent":[{"text":"These changes are compatible. Keep the version, and the records stored before the change are","type":"text"},{"text":" ","type":"text"},{"text":"read by each property’s name, in any order:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"]},{"inlineContent":[{"type":"text","text":"These changes are breaking. Raise the version with each, and the records stored at the earlier"},{"type":"text","text":" "},{"type":"text","text":"one are dropped and reported:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"]},{"inlineContent":[{"type":"text","text":"A version raised for a change whose bytes would still read, such as a property that keeps its"},{"type":"text","text":" "},{"type":"text","text":"type but changes its meaning, drops the earlier records all the same, so they are never read"},{"type":"text","text":" "},{"type":"text","text":"as the new shape. Records are never migrated from one version to another."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"EventMacros"}],"symbolKind":"macro","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"title":"Event(name:consent:version:)","externalID":"s:11EventMacros0A04name7consent7versionySSSg_6Events15ConsentCategoryVSgSitcfm","roleHeading":"Macro","remoteSource":{"fileName":"Event.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/EventMacros\/Event.swift#L107"},"role":"symbol"},"abstract":[{"text":"Makes a struct an event: derives its ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"BinaryCodable"},{"text":" conformances, its name and its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"reference","isActive":true},{"text":" from its declaration.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)"},"references":{"doc://Events/documentation/Events/Event":{"url":"\/documentation\/events\/event","abstract":[{"text":"Something that happened, recorded as a typed value.","type":"text"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Event","kind":"symbol","title":"Event","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"}],"navigatorTitle":[{"text":"Event","kind":"identifier"}]},"doc://EventMacros/documentation/EventMacros":{"role":"collection","url":"\/documentation\/eventmacros","title":"EventMacros","abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros"},"doc://Persistence/documentation/Persistence/BinaryCodable":{"title":"BinaryCodable","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryCodable"}],"navigatorTitle":[{"kind":"identifier","text":"BinaryCodable"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","role":"symbol","type":"topic","abstract":[{"text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk.","type":"text"}],"kind":"sym