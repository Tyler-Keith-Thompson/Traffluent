aking change; 1 by default.","type":"text"}],"type":"paragraph"}],"name":"version"}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"codeListing","syntax":"swift","code":["import EventMacros","","@Event(name: \"signed_up\", consent: .functional, version: 2)","struct SignedUp {","    var plan: String","    var seats: Int?","    var email: Sensitive<String>","}"]},{"type":"paragraph","inlineContent":[{"text":"The macro adds an extension holding:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var name"},{"type":"text","text":", when "},{"type":"codeVoice","code":"name"},{"type":"text","text":" is given; otherwise the type’s name, "},{"type":"codeVoice","code":"Event"},{"type":"text","text":"’s default."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"static var consentCategory","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"consent","type":"codeVoice"},{"text":" is given; otherwise ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory\/analytics","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"static var schemaVersion","type":"codeVoice"},{"text":", when ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" is given; otherwise 1, ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":"’s default.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static var schema"},{"type":"text","text":": an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},{"type":"text","text":" with the event’s name, version and each stored"},{"type":"text","text":" "},{"type":"text","text":"property’s name, type as written, optionality, whether it has a default value and validation"},{"type":"text","text":" "},{"type":"text","text":"keywords (its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},{"type":"text","text":" type’s rule’s, then those "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)"},{"type":"text","text":" declares), in"},{"type":"text","text":" "},{"type":"text","text":"declaration order."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"constraintViolation()"},{"type":"text","text":", when a property declares constraints with "},{"type":"reference","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","isActive":true},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"first property, in declaration order, whose value breaks one, which a tracker rejects."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encode(to:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":", which write a CBOR map of the stored properties, each under","type":"text"},{"text":" ","type":"text"},{"text":"its name, in declaration order, and read each back by its name, as a hand-written conformance","type":"text"},{"text":" ","type":"text"},{"text":"would. An optional property missing from the map reads as ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", and one with a default","type":"text"},{"text":" ","type":"text"},{"text":"value as that value. A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"text":" property goes through its own conformance, so","type":"text"},{"text":" ","type":"text"},{"text":"only a store’s encoder writes its value.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every stored instance property is encoded, and needs a type annotation. Static and computed"},{"type":"text","text":" "},{"type":"text","text":"properties are left out, and so is a "},{"code":"let","type":"codeVoice"},{"type":"text","text":" with an initial value, which every value shares."},{"type":"text","text":" "},{"type":"text","text":"The struct keeps its memberwise initializer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A stored property whose type isn’t "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" is a compile error naming it:"},{"type":"text","text":" "},{"type":"codeVoice","code":"static method 'requireBinaryCodable(bad:)' requires that 'Foo' conform to 'BinaryCodable'"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"a property "},{"type":"codeVoice","code":"bad"},{"type":"text","text":" of type "},{"type":"codeVoice","code":"Foo"},{"type":"text","text":". Applying the macro to anything but a struct, a property with no"},{"type":"text","text":" "},{"type":"text","text":"type annotation, a "},{"type":"codeVoice","code":"lazy"},{"type":"text","text":" property, a destructuring pattern, a name that isn’t a non-empty string"},{"type":"text","text":" "},{"type":"text","text":"literal and a version that isn’t a positive integer literal are compile errors too."}]},{"level":2,"type":"heading","anchor":"Changing-an-event","text":"Changing an event"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A store may still hold records written before an event’s stored properties changed: an app"},{"type":"text","text":" "},{"type":"text","text":"updates with records on disk it hasn’t delivered. "},{"code":"version","type":"codeVoice"},{"type":"text","text":" counts the changes those records"},{"type":"text","text":" "},{"type":"text","text":"can’t be read through, and only those. Each record carries the version it was stored at, and a"},{"type":"text","text":" "},{"type":"text","text":"store drops one stored at another version than the type’s now without reading it, reporting the"},{"type":"text","text":" "},{"type":"text","text":"event and both versions ("},{"code":"DropReport.versionMismatch","type":"codeVoice"},{"type":"text","text":"). A tracking plan’s check"},{"type":"text","text":" "},{"type":"text","text":"(module "},{"code":"TrackingPlans","type":"codeVoice"},{"type":"text","text":") fails on a change that needs a new version while the version stayed"},{"type":"text","text":" "},{"type":"text","text":"the same, naming the event, the property and the change."}]},{"type":"paragraph","inlineContent":[{"text":"These changes are compatible. Keep the version, and the records stored before the change are","type":"text"},{"text":" ","type":"text"},{"text":"read by each property’s name, in any order:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Version 1, as released.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var screen: String","}","","\/\/ Still version 1: a record stored above reads with coupon nil, currency \"USD\" and screen","\/\/ skipped.","@Event(name: \"checkout_started\")","struct CheckoutStarted {","    var cartSize: Int","    var coupon: String?          \/\/ an optional property added: nil","    var currency: String = \"USD\" \/\/ a property with a default value added: the default","                                 \/\/ screen removed: its stored value is skipped","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These changes are breaking. Raise the version with each, and the records stored at the earlier"},{"type":"text","text":" "},{"type":"text","text":"one are dropped and reported:"}]},{"type":"codeListing","syntax":"swift","code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var cartSize: Double  \/\/ a property's type changed (it was Int)","    var coupon: String    \/\/ an optional property made required (it was String?)","    var paymentMethod: String \/\/ a required property added, with no default value","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A version raised for a change whose bytes would still read, such as a property that keeps its"},{"type":"text","text":" "},{"type":"text","text":"type but changes its meaning, drops the earlier records all the same, so they are never read"},{"type":"text","text":" "},{"type":"text","text":"as the new shape. Records are never migrated from one version to another."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eventmacros\/event(name:consent:version:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","interfaceLanguage":"swift"},"references":{"doc://EventMacros/documentation/EventMacros/Event(name:consent:version:)":{"title":"Event(name:consent:version:)","identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":"(","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ConsentCategory","kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV"},{"text":"?, ","kind":"text"},{"text":"version","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"url":"\/documentation\/eventmacros\/event(name:consent:version:)","type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Makes a struct an event: derives its "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" and "},{"code":"BinaryCodable","type":"codeVoice"},{"type":"text","text":" conformances, 