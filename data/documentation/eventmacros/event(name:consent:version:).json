.","type":"text"}],"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Event(name:consent:version:)","kind":"symbol","url":"\/documentation\/eventmacros\/event(name:consent:version:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":"("},{"kind":"externalParam","text":"name"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"consent"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","text":"ConsentCategory"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":")"}],"title":"Event(name:consent:version:)"},"doc://Events/documentation/Events/Refined":{"type":"topic","url":"\/documentation\/events\/refined","abstract":[{"type":"text","text":"A value that satisfies every constraint of "},{"type":"codeVoice","code":"Rule"},{"type":"text","text":", checked once as it is made, so a property of"},{"type":"text","text":" "},{"type":"text","text":"this type can’t hold one that doesn’t."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}],"title":"Refined","navigatorTitle":[{"text":"Refined","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Refined"}}}