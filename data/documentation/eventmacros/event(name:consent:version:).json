a"},{"type":"text","text":" from its declaration."}],"url":"\/documentation\/eventmacros\/event(name:consent:version:)"},"doc://Events/documentation/Events/Sensitive":{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","url":"\/documentation\/events\/sensitive","role":"symbol","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"type":"topic","title":"Sensitive","kind":"symbol"},"doc://EventMacros/documentation/EventMacros/Constrained(_:)":{"identifier":"doc:\/\/EventMacros\/documentation\/EventMacros\/Constrained(_:)","url":"\/documentation\/eventmacros\/constrained(_:)","role":"symbol","abstract":[{"type":"text","text":"Declares the constraints a stored property of an "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" struct satisfies, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" "},{"type":"text","text":"checks and lists in the event’s schema."}],"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constrained","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ValidationKeyword","kind":"typeIdentifier","preciseIdentifier":"s:6Events17ValidationKeywordO"},{"text":"...)","kind":"text"}],"type":"topic","kind":"symbol","title":"Constrained(_:)"},"doc://Events/documentation/Events/ConsentCategory":{"type":"topic","title":"ConsentCategory","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConsentCategory","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","url":"\/documentation\/events\/consentcategory","abstract":[{"text":"The purpose an event is collected for, which the use