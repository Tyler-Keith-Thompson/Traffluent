":"Event(name:consent:version:)","abstract":[{"type":"text","text":"Makes a struct an event: derives its "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" and "},{"type":"codeVoice","code":"BinaryCodable"},{"type":"text","text":" conformances, its name and its"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","isActive":true},{"type":"text","text":" from its declaration."}]},"doc://Events/documentation/Events/EventSchema":{"url":"\/documentation\/events\/eventschema","abstract":[{"text":"The shape of an event type: its name, its schema version, its consent category and its stored","type":"text"},{"text":" ","type":"text"},{"text":"properties in declaration order, as a value tooling reads.","type":"text"}],"navigatorTitle":[{"text":"EventSchema","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventSchema","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","title":"EventSchema","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema"},"doc://Persistence/documentation/Persistence/BinaryCodable":{"url":"\/documentation\/persistence\/binarycodable","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryCodable","kind":"identifier"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"BinaryCodable","kind":"identifier"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","abstract":[{"text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk.","type":"text"}],"title":"BinaryCodable"},"doc://Events/documentation/Events/Sensitive":{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted