":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://Events/documentation/Events/ConsentCategory":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConsentCategory"}],"identifier":"doc:\/\/Events\/documentation\/Events\/ConsentCategory","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ConsentCategory"}],"url":"\/documentation\/events\/consentcategory","title":"ConsentCategory","abstract":[{"type":"text","text":"The purpose an event is collected for, which the user consents to or refuses: analytics,"},{"type":"text","text":" "},{"type":"text","text":"advertising and the like."}],"kind":"symbol"},"doc://Events/documentation/Events/Sensitive":{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"type":"topic","url":"\/documentation\/events\/sensitive","role":"symbol","title":"Sensitive","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}]},"doc://Persistence/documentation/Persistence/BinaryCodable":{"kind":"symbol","url":"\/documentation\/persistence\/binarycodable","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/BinaryCodable","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryCodable"}],"type":"topic","abstract":[{"type":"text","text":"A value with a compact binary form, CBOR (RFC 8949), that a store keeps on disk."}],"title":"BinaryCodable","navigatorTitle":[{"kind":"identifier","text":"BinaryCodable"}]},"doc://Events/documentation/Events/EventSchema":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventSchema","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"topic","navigatorTitle":[{"text":"EventSchema","kind":"identifier"}],"url":"\/documentation\/events\/eventschema","title":"EventSchema","abstract":[{"type":"text","text":"The shape of an event type: its name, its schema version, its consent category and its stored"},{"type":"text","text":" "},{"type":"text","text":"properties in declaration order, as a value tooling reads."}],"kind":"symbol"},"doc://Events/documentation/Events/Refined":{"identifier":"doc:\/\/Events\/documentation\/Events\/Refined","abstract":[{"text":"A value that satisfies every constraint of ","type":"text"},{"code":"Rule","type":"codeVoice"},{"text":", checked once as it is made, so a property of","type":"text"},{"text":" ","type":"text"},{"text":"this type can’t hold one that doesn’t.","type":"text"}],"navigatorTitle":[{"text":"Refined","kind":"identifier"}],"type":"topic","url":"\/documentation\/events\/refined","role":"symbol","kind":"symbol","title":"Refined","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Refined","kind":"identifier"}]},"doc://Events/documentation/Events/Event":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Event","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Event"}],"url":"\/documentation\/events\/event","title":"Event","abstract":[{"type":"text","text":"Something that happened, recorded as a typed value."}],"kind":"symbol"}}}