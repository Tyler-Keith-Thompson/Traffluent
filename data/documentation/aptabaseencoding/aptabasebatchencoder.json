verview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with "},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, the app key’s header field, this encoder and its limits:"}]},{"code":["let aptabase = try HTTPDestination.aptabase(","    appKey: appKey,  \/\/ from the app's Instructions page: A-EU-…, A-US-… or A-SH-…","    isDebug: false,  \/\/ true for builds whose events only Debug mode should show","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON array, of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", of one event per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. Each event is an object of these members:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"eventName"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionId"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"props"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s stored properties, flattened; left out when there are none"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"systemProps"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The standard context, ","type":"text"},{"code":"isDebug","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sdkVersion","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"timestamp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"code":"systemProps","type":"codeVoice"},{"type":"text","text":" holds "},{"code":"osName","type":"codeVoice"},{"type":"text","text":" and "},{"code":"osVersion","type":"codeVoice"},{"type":"text","text":" from "},{"code":"OperatingSystemKey","type":"codeVoice"},{"type":"text","text":", "},{"code":"appVersion","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"appBuildNumber","type":"codeVoice"},{"type":"text","text":" from "},{"code":"ApplicationKey","type":"codeVoice"},{"type":"text","text":", "},{"code":"deviceModel","type":"codeVoice"},{"type":"text","text":" from "},{"code":"DeviceKey","type":"codeVoice"},{"type":"text","text":", and "},{"code":"locale","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"code":"LocaleKey","type":"codeVoice"},{"type":"text","text":"‘s language and region ("},{"code":"en-US","type":"codeVoice"},{"type":"text","text":"), each left out when the context has no value for it;"},{"type":"text","text":" "},{"code":"isDebug","type":"codeVoice"},{"type":"text","text":", as the encoder is made with; and "},{"code":"sdkVersion","type":"codeVoice"},{"type":"text","text":", which Aptabase requires, always"},{"type":"text","text":" "},{"code":"Traffluent","type":"codeVoice"},{"type":"text","text":". A member longer than Aptabase takes (30 characters of the system’s name, 100 of"},{"type":"text","text":" "},{"type":"text","text":"its version, 50 of the app’s version, 20 of its build and 100 of the device’s model, counted"},{"type":"text","text":" "},{"type":"text","text":"in UTF-16) is left out and the event is sent without it, as Aptabase refuses the whole request"},{"type":"text","text":" "},{"type":"text","text":"holding one. The encoder logs a notice the first time it leaves out each member."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: Aptabase has no member for a user or a device. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":") is a session of"},{"type":"text","text":" "},{"type":"text","text":"its own: Aptabase takes no event without a session. A record a store recovers after a relaunch"},{"type":"text","text":" "},{"type":"text","text":"keeps its session, so it goes out in the session of its first send. The record’s vendor identifier, trace context and other context"},{"type":"text","text":" "},{"type":"text","text":"values aren’t sent. Aptabase counts users itself, from a hash of each request’s IP address and"},{"type":"text","text":" "},{"code":"User-Agent","type":"codeVoice"},{"type":"text","text":" header field with a salt it changes every day."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. Aptabase stores a string, a number or a boolean as a"},{"type":"text","text":" "},{"type":"text","text":"property’s value, and only a placeholder for an object or array, so an object or array is"},{"type":"text","text":" "},{"type":"text","text":"spread into a property per value it holds, named after its path, joined by "},{"type":"codeVoice","code":"."},{"type":"text","text":" ("},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":"), and a "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is left out."}]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe; one whose event name is only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace or over 60 characters; one with a property whose name, once flattened, is empty, only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace or over 40 characters, whose string value is over 180 characters, or whose number is","type":"text"},{"text":" ","type":"text"},{"text":"too large for Aptabase; one whose values flatten to one name; one whose event isn’t","type":"text"},{"text":" ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":"; one that holds a value","type":"text"},{"text":" ","type":"text"},{"text":"JSON can’t; one whose timestamp is outside the years 1 to 9999, or more than 23 hours before","type":"text"},{"text":" ","type":"text"},{"text":"the batch is encoded; and one too large for a request (","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","type":"reference","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, gives each a deadline 23 hours after its oldest record was tracked, and makes none for"},{"type":"text","text":" "},{"type":"text","text":"a batch with no record it can write, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for it. Aptabase"},{"type":"text","text":" "},{"type":"text","text":"doesn’t remove duplicates, so a record sent again, after a retry whose answer was lost or a"},{"type":"text","text":" "},{"type":"text","text":"store’s redelivery, is counted twice. The bytes are the same for the same records on every run"},{"type":"text","text":" "},{"type":"text","text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes."}]}]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/AptabaseEncoding\/s8SendableP","doc:\/\/AptabaseEncoding\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"meta