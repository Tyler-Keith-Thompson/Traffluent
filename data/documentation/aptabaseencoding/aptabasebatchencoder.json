baseEncoding/AptabaseBatchEncoder/transientStatuses":{"title":"transientStatuses","abstract":[{"text":"The status Aptabase answers that ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries, beside 408, 429 and every 5xx:","type":"text"},{"text":" ","type":"text"},{"text":"418, which Aptabase answers when a request’s body arrives slower than 60 bytes a second","type":"text"},{"text":" ","type":"text"},{"text":"after a 10-second grace period, as over a poor connection.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientStatuses","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"TransientStatus","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/transientstatuses"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder":{"navigatorTitle":[{"text":"AptabaseBatchEncoder","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AptabaseBatchEncoder","kind":"identifier"}],"url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder","type":"topic","kind":"symbol","role":"symbol","title":"AptabaseBatchEncoder","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of Aptabase’s events API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to an Aptabase app’s ","type":"text"},{"code":"POST \/api\/v0\/events","type":"codeVoice"},{"text":".","type":"text"}]}}}