/init(isDebug:plan:limit:now:)","title":"init(isDebug:plan:limit:now:)","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/init(isdebug:plan:limit:now:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"isDebug"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"limit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier","text":"BatchLimit"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":")"}],"role":"symbol","abstract":[{"text":"An encoder of the events ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" describes, marking every event as a debug event or not as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"isDebug"},{"text":" says, splitting each batch to ","type":"text"},{"type":"codeVoice","code":"limit"},{"text":", leaving out records more than 23 hours","type":"text"},{"text":" ","type":"text"},{"text":"older than ","type":"text"},{"type":"codeVoice","code":"now"},{"text":" gives.","type":"text"}]},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/BatchEncoder-Implementations":{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/BatchEncoder-Implementations","kind":"article","title":"BatchEncoder Implementations","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/batchencoder-implementations","type":"topic","role":"collectionGroup","abstract":[]},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/Failure":{"kind":"symbol","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/Failure","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"title":"AptabaseBatchEncoder.Failure","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/failure"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/requests(for:)":{"url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/requests(for:)","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","text":"BatchRequests","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"AptabaseEncodingError","preciseIdentifier":"s:16AptabaseEncoding0aB5ErrorO"},{"kind":"text","text":">"}],"role":"symbol","type":"topic","abstract":[{"code":"batch","type":"codeVoice"},{"text":" as the requests Aptabase takes, each within the encoder’s limit and with a deadline","type":"text"},{"text":" ","type":"text"},{"text":"23 hours after its oldest record was tracked, with the records left out of them.","type":"text"}],"title":"requests(for:)","kind":"symbol"},"doc://Events/documentation/Events/Sensitive":{"kind":"symbol","type":"topic","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","url":"\/documentation\/events\/sensitive","title":"Sensitive","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"role":"symbol","abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}]},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseEncodingError":{"role":"symbol","abstract":[{"type":"text","text":"Why "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AptabaseEncodingError"}],"url":"\/documentation\/aptabaseencoding\/aptabaseencodingerror","title":"AptabaseEncodingError","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AptabaseEncodingError"}]},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder":{"role":"symbol","abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Aptabase’s events API, so an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to an Aptabase app’s "},{"code":"POST \/api\/v0\/events","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AptabaseBatchEncoder"}],"url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder","title":"AptabaseBatchEncoder","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AptabaseBatchEncoder"}]},"doc://AptabaseEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/AptabaseEncoding\/s16SendableMetatypeP"}}}