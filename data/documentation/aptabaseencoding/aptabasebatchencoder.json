{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/aptabaseencoding\/aptabasebatchencoder"]}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/AptabaseEncoding\/s8SendableP","doc:\/\/AptabaseEncoding\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/init(isDebug:plan:limit:now:)"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)"],"generated":true},{"anchor":"Type-Aliases","title":"Type Aliases","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/Failure"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses"],"generated":true},{"anchor":"Type-Methods","title":"Type Methods","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/outcome(of:for:)"],"generated":true}],"kind":"symbol","metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AptabaseBatchEncoder","kind":"identifier"}],"title":"AptabaseBatchEncoder","externalID":"s:16AptabaseEncoding0A12BatchEncoderV","symbolKind":"struct","roleHeading":"Structure","modules":[{"name":"AptabaseEncoding"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AptabaseBatchEncoder"}],"remoteSource":{"fileName":"AptabaseBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AptabaseEncoding\/AptabaseBatchEncoder.swift#L74"}},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AptabaseBatchEncoder"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, the app key’s header field, this encoder and its limits:"}]},{"syntax":"swift","type":"codeListing","code":["let aptabase = try HTTPDestination.aptabase(","    appKey: appKey,  \/\/ from the app's Instructions page: A-EU-…, A-US-… or A-SH-…","    isDebug: false,  \/\/ true for builds whose events only Debug mode should show","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON array, of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", of one event per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. Each event is an object of these members:"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"eventName"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionId"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":" the same way when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"props"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s stored properties, flattened; left out when there are none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"systemProps"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The standard context, "},{"code":"isDebug","type":"codeVoice"},{"type":"text","text":" and "},{"code":"sdkVersion","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"timestamp"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"systemProps"},{"type":"text","text":" holds "},{"type":"codeVoice","code":"osName"},{"type":"text","text":" and "},{"type":"codeVoice","code":"osVersion"},{"type":"text","text":" from "},{"type":"codeVoice","code":"OperatingSystemKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"appVersion"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"appBuildNumber"},{"type":"text","text":" from "},{"type":"codeVoice","code":"ApplicationKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"deviceModel"},{"type":"text","text":" from "},{"type":"codeVoice","code":"DeviceKey"},{"type":"text","text":", and "},{"type":"codeVoice","code":"locale"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":"‘s language and region ("},{"type":"codeVoice","code":"en-US"},{"type":"text","text":"), each left out when the context has no value for it;"},{"type":"text","text":" "},{"type":"codeVoice","code":"isDebug"},{"type":"text","text":", as the encoder is made with; and "},{"type":"codeVoice","code":"sdkVersion"},{"type":"text","text":", which Aptabase requires, always"},{"type":"text","text":" "},{"type":"codeVoice","code":"Traffluent"},{"type":"text","text":". A member longer than Aptabase takes (30 characters of the system’s name, 100 of"},{"type":"text","text":" "},{"type":"text","text":"its version, 50 of the app’s version, 20 of its build and 100 of the device’s model, counted"},{"type":"text","text":" "},{"type":"text","text":"in UTF-16) is left out and the event is sent without it, as Aptabase refuses the whole request"},{"type":"text","text":" "},{"type":"text","text":"holding one. The encoder logs a notice the first time it leaves out each member."}]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: Aptabase has no member for a user or a device. A","type":"text"},{"text":" ","type":"text"},{"text":"record with no session (one tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":") is a session of","type":"text"},{"text":" ","type":"text"},{"text":"its own: Aptabase takes no event without a session. A record a store recovers after a relaunch","type":"text"},{"text":" ","type":"text"},{"text":"keeps its session, so it goes out in the session of its first send. The record’s vendor identifier, trace context and other context","type":"text"},{"text":" ","type":"text"},{"text":"values aren’t sent. Aptabase counts users itself, from a hash of each request’s IP address and","type":"text"},{"text":" ","type":"text"},{"code":"User-Agent","type":"codeVoice"},{"text":" header field with a salt it changes every day.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. Aptabase stores a string, a number or a boolean as a"},{"type":"text","text":" "},{"type":"text","text":"property’s value, and only a placeholder for an object or array, so an object or array is"},{"type":"text","text":" "},{"type":"text","text":"spread into a property per value it holds, named after its path, joined by "},{"type":"codeVoice","code":"."},{"type":"text","text":" ("},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":"), and a "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is left out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe; one whose event name is only"},{"type":"text","text":" "},{"type":"text","text":"whitespace or over 60 characters; one with a property whose name, once flattened, is empty, only"},{"type":"text","text":" "},{"type":"text","text":"whitespace or over 40 characters, whose string value is over 180 characters, or whose number is"},{"type":"text","text":" "},{"type":"text","text":"too large for Aptabase; one whose values flatten to one name; one whose event isn’t"},{"type":"text","text":" "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":"; one that holds a value"},{"type":"text","text":" "},{"type":"text","text":"JSON can’t; one whose timestamp is outside the years 1 to 9999, or more than 23 hours before"},{"type":"text","text":" "},{"type":"text","text":"the batch is encoded; and one too large for a request ("},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, gives each a deadline 23 hours after its oldest record was tracked, and makes none for"},{"type":"text","text":" "},{"type":"text","text":"a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for it. Aptabase"},{"type":"text","text":" "},{"type":"text","text":"doesn’t remove duplicates, so a record sent again, after a retry whose answer was lost or a"},{"type":"text","text":" "},{"type":"text","text":"store’s redelivery, is counted twice. The bytes are the same for the same records on every run"},{"type":"text","text":" "},{"type":"text","text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes."}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"type":"text","text":" of Aptabase’s events API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to an Aptabase app’s "},{"type":"codeVoice","code":"POST \/api\/v0\/events"},{"type":"text","text":"."}],"references":{"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/batchLimit":{"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"role":"symbol","abstract":[{"type":"text","text":"Aptabase’s limits on one request: 25 events, and 1,000,000 bytes of body and of one event."}],"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","kind":"symbol","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/batchlimit","title":"batchLimit"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseEncodingError":{"title":"AptabaseEncodingError","abstract":[{"type":"text","text":"Why "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AptabaseEncodingError","kind":"identifier"}],"url":"\/documentation\/aptabaseencoding\/aptabaseencodingerror","navigatorTitle":[{"text":"AptabaseEncodingError","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"type":"topic","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"text":" sends.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","title":"BatchEncoder","url":"\/documentation\/httpdestinations\/batchencoder","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}]},"doc://AptabaseEncoding/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/AptabaseEncoding\/s8SendableP"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/HTTPDestinations/HTTPDestination/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)":{"title":"aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":