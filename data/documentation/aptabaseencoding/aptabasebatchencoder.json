{"kind":"symbol","variants":[{"paths":["\/documentation\/aptabaseencoding\/aptabasebatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding"]]},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AptabaseBatchEncoder"}],"navigatorTitle":[{"kind":"identifier","text":"AptabaseBatchEncoder"}],"role":"symbol","externalID":"s:16AptabaseEncoding0A12BatchEncoderV","title":"AptabaseBatchEncoder","modules":[{"name":"AptabaseEncoding"}],"remoteSource":{"fileName":"AptabaseBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AptabaseEncoding\/AptabaseBatchEncoder.swift#L74"},"symbolKind":"struct","roleHeading":"Structure"},"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/init(isDebug:plan:limit:now:)"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)"]},{"title":"Type Aliases","anchor":"Type-Aliases","generated":true,"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/Failure"]},{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AptabaseBatchEncoder","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"Make the destination with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, the app key’s header field, this encoder and its limits:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let aptabase = try HTTPDestination.aptabase(","    appKey: appKey,  \/\/ from the app's Instructions page: A-EU-…, A-US-… or A-SH-…","    isDebug: false,  \/\/ true for builds whose events only Debug mode should show","    plan: plan)"]},{"inlineContent":[{"type":"text","text":"The body is a JSON array, of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", of one event per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. Each event is an object of these members:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"eventName","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sessionId"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"props","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, flattened; left out when there are none"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"systemProps","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The standard context, ","type":"text"},{"code":"isDebug","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sdkVersion","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601, in UTC with milliseconds"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"codeVoice","code":"systemProps"},{"type":"text","text":" holds "},{"type":"codeVoice","code":"osName"},{"type":"text","text":" and "},{"type":"codeVoice","code":"osVersion"},{"type":"text","text":" from "},{"type":"codeVoice","code":"OperatingSystemKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"appVersion"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"appBuildNumber"},{"type":"text","text":" from "},{"type":"codeVoice","code":"ApplicationKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"deviceModel"},{"type":"text","text":" from "},{"type":"codeVoice","code":"DeviceKey"},{"type":"text","text":", and "},{"type":"codeVoice","code":"locale"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":"‘s language and region ("},{"type":"codeVoice","code":"en-US"},{"type":"text","text":"), each left out when the context has no value for it;"},{"type":"text","text":" "},{"type":"codeVoice","code":"isDebug"},{"type":"text","text":", as the encoder is made with; and "},{"type":"codeVoice","code":"sdkVersion"},{"type":"text","text":", which Aptabase requires, always"},{"type":"text","text":" "},{"type":"codeVoice","code":"Traffluent"},{"type":"text","text":". A member longer than Aptabase takes (30 characters of the system’s name, 100 of"},{"type":"text","text":" "},{"type":"text","text":"its version, 50 of the app’s version, 20 of its build and 100 of the device’s model, counted"},{"type":"text","text":" "},{"type":"text","text":"in UTF-16) is left out and the event is sent without it, as Aptabase refuses the whole request"},{"type":"text","text":" "},{"type":"text","text":"holding one. The encoder logs a notice the first time it leaves out each member."}],"type":"paragraph"},{"inlineContent":[{"text":"The session is the only identifier sent: Aptabase has no member for a user or a device. A","type":"text"},{"text":" ","type":"text"},{"text":"record with no session (one tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":") is a session of","type":"text"},{"text":" ","type":"text"},{"text":"its own: Aptabase takes no event without a session. A record a store recovers after a relaunch","type":"text"},{"text":" ","type":"text"},{"text":"keeps its session, so it goes out in the session of its first send. The record’s vendor identifier, trace context and other context","type":"text"},{"text":" ","type":"text"},{"text":"values aren’t sent. Aptabase counts users itself, from a hash of each request’s IP address and","type":"text"},{"text":" ","type":"text"},{"code":"User-Agent","type":"codeVoice"},{"text":" header field with a salt it changes every day.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, and so is an element of an array. Aptabase stores a string, a number or a boolean as a","type":"text"},{"text":" ","type":"text"},{"text":"property’s value, and only a placeholder for an object or array, so an object or array is","type":"text"},{"text":" ","type":"text"},{"text":"spread into a property per value it holds, named after its path, joined by ","type":"text"},{"code":".","type":"codeVoice"},{"text":" (","type":"text"},{"code":"cart.size","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"tags.0","type":"codeVoice"},{"text":"), and a ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" is left out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe; one whose event name is only"},{"type":"text","text":" "},{"type":"text","text":"whitespace or over 60 characters; one with a property whose name, once flattened, is empty, only"},{"type":"text","text":" "},{"type":"text","text":"whitespace or over 40 characters, whose string value is over 180 characters, or whose number is"},{"type":"text","text":" "},{"type":"text","text":"too large for Aptabase; one whose values flatten to one name; one whose event isn’t"},{"type":"text","text":" "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":"; one that holds a value"},{"type":"text","text":" "},{"type":"text","text":"JSON can’t; one whose timestamp is outside the years 1 to 9999, or more than 23 hours before"},{"type":"text","text":" "},{"type":"text","text":"the batch is encoded; and one too large for a request ("},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, gives each a deadline 23 hours after its oldest record was tracked, and makes none for","type":"text"},{"text":" ","type":"text"},{"text":"a batch with no record it can write, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for it. Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t remove duplicates, so a record sent again, after a retry whose answer was lost or a","type":"text"},{"text":" ","type":"text"},{"text":"store’s redelivery, is counted twice. The bytes are the same for the same records on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":