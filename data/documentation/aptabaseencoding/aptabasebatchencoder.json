{"metadata":{"modules":[{"name":"AptabaseEncoding"}],"roleHeading":"Structure","title":"AptabaseBatchEncoder","symbolKind":"struct","externalID":"s:16AptabaseEncoding0A12BatchEncoderV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AptabaseBatchEncoder"}],"remoteSource":{"fileName":"AptabaseBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AptabaseEncoding\/AptabaseBatchEncoder.swift#L74"},"role":"symbol","navigatorTitle":[{"text":"AptabaseBatchEncoder","kind":"identifier"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},"sections":[],"abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Aptabase’s events API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to an Aptabase app’s "},{"type":"codeVoice","code":"POST \/api\/v0\/events"},{"type":"text","text":"."}],"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/init(isDebug:plan:limit:now:)"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)"]},{"generated":true,"title":"Type Aliases","anchor":"Type-Aliases","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/Failure"]},{"generated":true,"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses"]},{"generated":true,"title":"Type Methods","anchor":"Type-Methods","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/outcome(of:for:)"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/BatchEncoder-Implementations"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/AptabaseEncoding\/s8SendableP","doc:\/\/AptabaseEncoding\/s16SendableMetatypeP"],"type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AptabaseBatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"Make the destination with "},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, the app key’s header field, this encoder and its limits:"}],"type":"paragraph"},{"type":"codeListing","code":["let aptabase = try HTTPDestination.aptabase(","    appKey: appKey,  \/\/ from the app's Instructions page: A-EU-…, A-US-… or A-SH-…","    isDebug: false,  \/\/ true for builds whose events only Debug mode should show","    plan: plan)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The body is a JSON array, of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", of one event per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. Each event is an object of these members:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"eventName","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sessionId"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"props"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, flattened; left out when there are none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"systemProps"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context, "},{"type":"codeVoice","code":"isDebug"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sdkVersion"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601, in UTC with milliseconds"}]}]]]},{"inlineContent":[{"type":"codeVoice","code":"systemProps"},{"text":" holds ","type":"text"},{"type":"codeVoice","code":"osName"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"osVersion"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"OperatingSystemKey"},{"text":", ","type":"text"},{"type":"codeVoice","code":"appVersion"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"appBuildNumber"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"ApplicationKey"},{"text":", ","type":"text"},{"type":"codeVoice","code":"deviceModel"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"DeviceKey"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"locale"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LocaleKey"},{"text":"‘s language and region (","type":"text"},{"type":"codeVoice","code":"en-US"},{"text":"), each left out when the context has no value for it;","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"isDebug"},{"text":", as the encoder is made with; and ","type":"text"},{"type":"codeVoice","code":"sdkVersion"},{"text":", which Aptabase requires, always","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Traffluent"},{"text":". A member longer than Aptabase takes (30 characters of the system’s name, 100 of","type":"text"},{"text":" ","type":"text"},{"text":"its version, 50 of the app’s version, 20 of its build and 100 of the device’s model, counted","type":"text"},{"text":" ","type":"text"},{"text":"in UTF-16) is left out and the event is sent without it, as Aptabase refuses the whole request","type":"text"},{"text":" ","type":"text"},{"text":"holding one. The encoder logs a notice the first time it leaves out each member.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: Aptabase has no member for a user or a device. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is a session of"},{"type":"text","text":" "},{"type":"text","text":"its own: Aptabase takes no event without a session. A record a store recovers after a relaunch"},{"type":"text","text":" "},{"type":"text","text":"keeps its session, so it goes out in the session of its first send. The record’s vendor identifier, trace context and other context"},{"type":"text","text":" "},{"type":"text","text":"values aren’t sent. Aptabase counts users itself, from a hash of each request’s IP address and"},{"type":"text","text":" "},{"type":"codeVoice","code":"User-Agent"},{"type":"text","text":" header field with a salt it changes every day."}],"type":"paragraph"},{"inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, and so is an element of an array. Aptabase stores a string, a number or a boolean as a","type":"text"},{"text":" ","type":"text"},{"text":"property’s value, and only a placeholder for an object or array, so an object or array is","type":"text"},{"text":" ","type":"text"},{"text":"spread into a property per value it holds, named after its path, joined by ","type":"text"},{"code":".","type":"codeVoice"},{"text":" (","type":"text"},{"code":"cart.size","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"tags.0","type":"codeVoice"},{"text":"), and a ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" is left out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe; one whose event name is only"},{"type":"text","text":" "},{"type":"text","text":"whitespace or over 60 characters; one with a property whose name, once flattened, is empty, only"},{"type":"text","text":" "},{"type":"text","text":"whitespace or over 40 characters, whose string value is over 180 characters, or whose number is"},{"type":"text","text":" "},{"type":"text","text":"too large for Aptabase; one whose values flatten to one name; one whose event isn’t"},{"type":"text","text":" "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":"; one that holds a value"},{"type":"text","text":" "},{"type":"text","text":"JSON can’t; one whose timestamp is outside the years 1 to 9999, or more than 23 hours before"},{"type":"text","text":" "},{"type":"text","text":"the batch is encoded; and one too large for a request ("},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, gives each a deadline 23 hours after its oldest record was tracked, and makes none for"},{"type":"text","text":" "},{"type":"text","text":"a batch with no record it can write, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for it. Aptabase"},{"type":"text","text":" "},{"type":"text","text":"doesn’t remove duplicates, so a record sent again, after a retry whose answer was lost or a"},{"type":"text","text":" "},{"type":"text","text":"store’s redelivery, is counted twice. The bytes are the same for the same records on every run"},{"type":"text","text":" "},{"type":"text","text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/aptabaseencoding\/aptabasebatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding"]]},"references":{"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseEncodingError":{"title":"AptabaseEncodingError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AptabaseEncodingError"}],"type":"topic","url":"\/documentation\/aptabaseencoding\/aptabaseencodingerror","navigatorTitle":[{"kind":"identifier","text":"AptabaseEncodingError"}],"role":"symbol","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"kind":"symbol","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError"},"doc://AptabaseEncoding/documentation/AptabaseEncoding":{"abstract":[{"type":"text","text":"Send records to Aptabase, in its cloud or on your own server, through its events API."}],"kind":"symbol","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","title":"AptabaseEncoding","type":"topic","role":"collection","url":"\/documentation\/aptabaseencoding"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/requests(for:)":{"abstract":[{"code":"batch","type":"codeVoice"},{"type":"text","text":" as the requests Aptabase takes, each within the encoder’s limit and with a deadline"},{"type":"text","text":" "},{"type":"text","text":"23 hours after its oldest record was tracked, with the records left out of them."}],"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","title":"requests(for:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","kind":"typeIdentifier","text":"BatchRequests"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:16AptabaseEncoding0aB5ErrorO","kind":"typeIdentifier","text":"AptabaseEncodingError"},{"kind":"text","text":">"}],"url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/requests(for:)"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/Failure":{"navi