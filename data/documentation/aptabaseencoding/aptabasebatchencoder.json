bug:plan:backoff:clock:now:)","abstract":[{"text":"A destination that sends batches to the Aptabase app of ","type":"text"},{"code":"appKey","type":"codeVoice"},{"text":", at the region its key","type":"text"},{"text":" ","type":"text"},{"text":"names or, for a self-hosted key, at ","type":"text"},{"code":"host","type":"codeVoice"},{"text":", marking every event as a debug event or not as","type":"text"},{"text":" ","type":"text"},{"code":"isDebug","type":"codeVoice"},{"text":" says, with ","type":"text"},{"code":"URLSession.shared","type":"codeVoice"},{"text":", retrying a send that fails for now with the waits","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","kind":"symbol","role":"symbol"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/outcome(of:for:)":{"type":"topic","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/outcome(of:for:)","title":"outcome(of:for:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","kind":"typeIdentifier","text":"HTTPTransportResponse"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","kind":"typeIdentifier","text":"EncodedRequest"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","kind":"typeIdentifier","text":"ResponseOutcome"}],"kind":"symbol","abstract":[{"type":"text","text":"What Aptabase’s 2xx answer means: rejected when its body is an object holding an "},{"type":"codeVoice","code":"error"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and delivered otherwise."}],"role":"symbol","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/outcome(of:for:)"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/Failure":{"navigatorTitle":[{"kind":"identifier","text":"Failure"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/failure","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/Failure","abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"type":"topic","title":"AptabaseBatchEncoder.Failure","kind":"symbol","role":"symbol"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/batchLimit":{"role":"symbol","title":"batchLimit","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/batchlimit","abstract":[{"type":"text","text":"Aptabase’s limits on one request: 25 events, and 1,000,000 bytes of body and of one event."}],"kind":"symbol","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}],"type":"topic"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/transientStatuses":{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/transientstatuses","kind":"symbol","rol