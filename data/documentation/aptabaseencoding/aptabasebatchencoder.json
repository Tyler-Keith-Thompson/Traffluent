tination"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to an Aptabase app’s ","type":"text"},{"type":"codeVoice","code":"POST \/api\/v0\/events"},{"text":".","type":"text"}],"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","kind":"symbol","title":"AptabaseBatchEncoder","navigatorTitle":[{"text":"AptabaseBatchEncoder","kind":"identifier"}],"role":"symbol"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/outcome(of:for:)":{"role":"symbol","type":"topic","abstract":[{"text":"What Aptabase’s 2xx answer means: rejected when its body is an object holding an ","type":"text"},{"code":"error","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and delivered otherwise.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO"}],"kind":"symbol","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/outcome(of:for:)","title":"outcome(of:for:)","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/outcome(of:for:)"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/init(isDebug:plan:limit:now:)":{"title":"init(isDebug:plan:limit:now:)","kind":"symbol","url":"\/documentation\/aptabaseenc