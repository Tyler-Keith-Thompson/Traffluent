nd":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A10SetupErrorO","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError","text":"AptabaseSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A12BatchEncoderV","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","text":"AptabaseBatchEncoder"},{"kind":"text","text":">"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app’s key, from the Instructions page of its Aptabase dashboard, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"A-EU-1234567890"},{"type":"text","text":". Whitespace and newlines around it are trimmed off."}]}],"name":"appKey"},{"content":[{"inlineContent":[{"type":"text","text":"The URL a self-hosted server is reached at ("},{"type":"codeVoice","code":"https:\/\/aptabase.example.com"},{"type":"text","text":"), a"},{"type":"text","text":" "},{"type":"text","text":"path included where it is served under one; required for an "},{"type":"codeVoice","code":"A-SH-"},{"type":"text","text":" or "},{"type":"codeVoice","code":"A-DEV-"},{"type":"text","text":" key and"},{"type":"text","text":" "},{"type":"text","text":"refused for a cloud key, so "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" by default. Not the endpoint: the destination appends"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/api\/v0\/events"},{"type":"text","text":" itself."}],"type":"paragraph"}],"name":"host"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Whether every event is a debug event, which Aptabase’s dashboard shows only in","type":"text"},{"text":" ","type":"text"},{"text":"its Debug mode and keeps for less time: ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" for a development or internal build,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" for one users run. There is no default: ","type":"text"},{"type":"codeVoice","code":"#if DEBUG"},{"text":" in a library tells its own","type":"text"},{"text":" ","type":"text"},{"text":"build configuration, not the app’s, so the app decides, from its own build settings.","type":"text"}]}],"name":"isDebug"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}]}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}],"name":"transport"},{"content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}],"name":"clock"},{"content":[{"inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,","type":"text"},{"text":" ","type":"text"},{"text":"and each request’s deadline is checked against before it is sent; the system’s clock by","type":"text"},{"text":" ","type":"text"},{"text":"default. When it reads NaN or infinite, every record is left out.","type":"text"}],"type":"paragraph"}],"name":"now"}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"The destination.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"The destination posts each batch to the events API, ","type":"text"},{"code":"\/api\/v0\/events","type":"codeVoice"},{"text":", of","type":"text"},{"text":" ","type":"text"},{"code":"https:\/\/eu.aptabase.com","type":"codeVoice"},{"text":" for an ","type":"text"},{"code":"A-EU-","type":"codeVoice"},{"text":" key, ","type":"text"},{"code":"https:\/\/us.aptabase.com","type":"codeVoice"},{"text":" for an ","type":"text"},{"code":"A-US-","type":"codeVoice"},{"text":" key,","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"host","type":"codeVoice"},{"text":" for a self-hosted key (","type":"text"},{"code":"A-SH-","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"A-DEV-","type":"codeVoice"},{"text":" for a server run in development),","type":"text"},{"text":" ","type":"text"},{"text":"with the key in its ","type":"text"},{"code":"App-Key","type":"codeVoice"},{"text":" header field, encoded by an ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},{"text":" within","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit"},{"text":". It sends no trace context. It retries no response, a","type":"text"},{"text":" ","type":"text"},{"text":"5xx, 408 or 429, such as Aptabase answers past its rate limit, and 418, which Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"answers when a request’s body arrives slower than 60 bytes a second after a 10-second grace","type":"text"},{"text":" ","type":"text"},{"text":"period, as over a poor connection (","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses"},{"text":"). It drops and","type":"text"},{"text":" ","type":"text"},{"text":"reports any other status, such as 400 for a request Aptabase can’t take.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The app key is public, as Aptabase’s SDKs ship it in every app, and the events API takes no","type":"text"},{"text":" ","type":"text"},{"text":"other credential, so the destination builds on every platform: an app sends to Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"directly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Aptabase takes no event tracked more than a day before it arrives, and answers 200 while"},{"type":"text","text":" "},{"type":"text","text":"storing nothing for one, so the encoder leaves out a record tracked more than 23 hours"},{"type":"text","text":" "},{"type":"text","text":"before it is encoded ("},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError\/timestampOutsideWindow","isActive":true},{"type":"text","text":"). A request is"},{"type":"text","text":" "},{"type":"text","text":"encoded once and retried as it is, so one still undelivered 23 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record was tracked, by the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":"."}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/emptyAppKey"},{"type":"text","text":" for a key that is empty or only whitespace,"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/malformedAppKey"},{"type":"text","text":" for one that isn’t "},{"type":"codeVoice","code":"A-<region>-<body>"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/unknownRegion"},{"type":"text","text":" for a region other than "},{"type":"codeVoice","code":"EU"},{"type":"text","text":", "},{"type":"codeVoice","code":"US"},{"type":"text","text":", "},{"type":"codeVoice","code":"SH"},{"type":"text","text":" and "},{"type":"codeVoice","code":"DEV"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/selfHostedAppKeyWithoutHost"},{"type":"text","text":" for a self-hosted key without "},{"type":"codeVoice","code":"host"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/cloudAppKeyWithHost"},{"type":"text","text":" for a cloud key with one, and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/invalidHost"},{"type":"text","text":" for a host that isn’t a plain "},{"type":"codeVoice","code":"https"},{"type":"text","text":" URL of the"},{"type":"text","text":" "},{"type":"text","text":"server."}]}],"type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination"]]},"identifier":{"url":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"A destination that sends batches to the Aptabase app of "},{"type":"codeVoice","code":"appKey"},{"type":"text","text":", at the region its key"},{"type":"text","text":" "},{"type":"text","text":"names or, for a self-hosted key, at "},{"type":"codeVoice","code":"host"},{"type":"text","text":", marking every event as a debug event or not as"},{"type":"text","text":" "},{"type":"codeVoice","code":"isDebug"},{"type":"text","text":" says, through "},{"type":"codeVoice","code":"transport"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff":{"kind":"symbol","url":"\/documentation\/httpdestinations\/exponentialbackoff","title":"ExponentialBackoff","abstract":[{"text":"How long ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" waits before each new attempt at a batch that wasn’t delivered:","type":"text"},{"text":" ","type":"text"},{"text":"binary exponential backoff, each nominal wait twice the one before, up to a maximum, with","type":"text"},{"text":" ","type":"text"},{"