ier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":" = ExponentialBackoff(), ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":"> = ContinuousClock(), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":" = { Date.now }) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError","text":"AptabaseSetupError","kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A10SetupErrorO"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","text":"AptabaseBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A12BatchEncoderV"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The app’s key, from the Instructions page of its Aptabase dashboard, such as","type":"text"},{"text":" ","type":"text"},{"code":"A-EU-1234567890","type":"codeVoice"},{"text":". Whitespace and newlines around it are trimmed off.","type":"text"}]}],"name":"appKey"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The URL a self-hosted server is reached at (","type":"text"},{"code":"https:\/\/aptabase.example.com","type":"codeVoice"},{"text":"), a","type":"text"},{"text":" ","type":"text"},{"text":"path included where it is served under one; required for an ","type":"text"},{"code":"A-SH-","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"A-DEV-","type":"codeVoice"},{"text":" key and","type":"text"},{"text":" ","type":"text"},{"text":"refused for a cloud key, so ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" by default. Not the endpoint: the destination appends","type":"text"},{"text":" ","type":"text"},{"code":"\/api\/v0\/events","type":"codeVoice"},{"text":" itself.","type":"text"}]}],"name":"host"},{"content":[{"inlineContent":[{"text":"Whether every event is a debug event, which Aptabase’s dashboard shows only in","type":"text"},{"text":" ","type":"text"},{"text":"its Debug mode and keeps for less time: ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for a development or internal build,","type":"text"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for one users run. There is no default: ","type":"text"},{"code":"#if DEBUG","type":"codeVoice"},{"text":" in a library tells its own","type":"text"},{"text":" ","type":"text"},{"text":"build configuration, not the app’s, so the app decides, from its own build settings.","type":"text"}],"type":"paragraph"}],"name":"isDebug"},{"content":[{"inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}],"type":"paragraph"}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}],"name":"transport"},{"content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}],"name":"clock"},{"content":[{"inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,","type":"text"},{"text":" ","type":"text"},{"text":"and each request’s deadline is checked against before it is sent; the system’s clock by","type":"text"},{"text":" ","type":"text"},{"text":"default. When it reads NaN or infinite, every record is left out.","type":"text"}],"type":"paragraph"}],"name":"now"}]},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The destination posts each batch to the events API, "},{"code":"\/api\/v0\/events","type":"codeVoice"},{"type":"text","text":", of"},{"type":"text","text":" "},{"code":"https:\/\/eu.aptabase.com","type":"codeVoice"},{"type":"text","text":" for an "},{"code":"A-EU-","type":"codeVoice"},{"type":"text","text":" key, "},{"code":"https:\/\/us.aptabase.com","type":"codeVoice"},{"type":"text","text":" for an "},{"code":"A-US-","type":"codeVoice"},{"type":"text","text":" key,"},{"type":"text","text":" "},{"type":"text","text":"or "},{"code":"host","type":"codeVoice"},{"type":"text","text":" for a self-hosted key ("},{"code":"A-SH-","type":"codeVoice"},{"type":"text","text":", or "},{"code":"A-DEV-","type":"codeVoice"},{"type":"text","text":" for a server run in development),"},{"type":"text","text":" "},{"type":"text","text":"with the key in its "},{"code":"App-Key","type":"codeVoice"},{"type":"text","text":" header field, encoded by an "},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","isActive":true},{"type":"text","text":" within"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":". It sends no trace context. It retries no response, a"},{"type":"text","text":" "},{"type":"text","text":"5xx, 408 or 429, such as Aptabase answers past its rate limit, and 418, which Aptabase"},{"type":"text","text":" "},{"type":"text","text":"answers when a request’s body arrives slower than 60 bytes a second after a 10-second grace"},{"type":"text","text":" "},{"type":"text","text":"period, as over a poor connection ("},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses","isActive":true},{"type":"text","text":"). It drops and"},{"type":"text","text":" "},{"type":"text","text":"reports any other status, such as 400 for a request Aptabase can’t take."}],"type":"paragraph"},{"inlineContent":[{"text":"The app key is public, as Aptabase’s SDKs ship it in every app, and the events API takes no","type":"text"},{"text":" ","type":"text"},{"text":"other credential, so the destination builds on every platform: an app sends to Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"directly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Aptabase takes no event tracked more than a day before it arrives, and answers 200 while"},{"type":"text","text":" "},{"type":"text","text":"storing nothing for one, so the encoder leaves out a record tracked more than 23 hours"},{"type":"text","text":" "},{"type":"text","text":"before it is encoded ("},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError\/timestampOutsideWindow","type":"reference","isActive":true},{"type":"text","text":"). A request is"},{"type":"text","text":" "},{"type":"text","text":"encoded once and retried as it is, so one still undelivered 23 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record was tracked, by the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"aside","name":"Throws","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/emptyAppKey"},{"type":"text","text":" for a key that is empty or only whitespace,"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/malformedAppKey"},{"type":"text","text":" for one that isn’t "},{"type":"codeVoice","code":"A-<region>-<body>"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/unknownRegion"},{"type":"text","text":" for a region other than "},{"type":"codeVoice","code":"EU"},{"type":"text","text":", "},{"type":"codeVoice","code":"US"},{"type":"text","text":", "},{"type":"codeVoice","code":"SH"},{"type":"text","text":" and "},{"type":"codeVoice","code":"DEV"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/selfHostedAppKeyWithoutHost"},{"type":"text","text":" for a self-hosted key without "},{"type":"codeVoice","code":"host"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/cloudAppKeyWithHost"},{"type":"text","text":" for a cloud key with one, and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/invalidHost"},{"type":"text","text":" for a host that isn’t a plain "},{"type":"codeVoice","code":"https"},{"type":"text","text":" URL of the"},{"type":"text","text":" "},{"type":"text","text":"server."}],"type":"paragraph"}]}]}],"kind":"symbol","metadata":{"modules":[{"name":"AptabaseEncoding","relatedModules":["HTTPDestinations"]}],"conformance":{"constraints":[{"type":"codeVoice","code":"Transport"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"HTTPTransport"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Encoding"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"AptabaseBatchEncoder"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"extendedModule":"HTTPDestinations","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"aptabase","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appKey","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"host","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials3URLV","text":"U