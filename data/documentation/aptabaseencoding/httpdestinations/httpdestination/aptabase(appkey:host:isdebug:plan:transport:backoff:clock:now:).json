ocumentation\/HTTPDestinations\/ExponentialBackoff","text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"kind":"text","text":" = ExponentialBackoff(), "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError","text":"AptabaseSetupError","preciseIdentifier":"s:16AptabaseEncoding0A10SetupErrorO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","text":"AptabaseBatchEncoder","preciseIdentifier":"s:16AptabaseEncoding0A12BatchEncoderV"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"appKey","content":[{"inlineContent":[{"text":"The app’s key, from the Instructions page of its Aptabase dashboard, such as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"A-EU-1234567890"},{"text":". Whitespace and newlines around it are trimmed off.","type":"text"}],"type":"paragraph"}]},{"name":"host","content":[{"inlineContent":[{"type":"text","text":"The URL a self-hosted server is reached at ("},{"type":"codeVoice","code":"https:\/\/aptabase.example.com"},{"type":"text","text":"), a"},{"type":"text","text":" "},{"type":"text","text":"path included where it is served under one; required for an "},{"type":"codeVoice","code":"A-SH-"},{"type":"text","text":" or "},{"type":"codeVoice","code":"A-DEV-"},{"type":"text","text":" key and"},{"type":"text","text":" "},{"type":"text","text":"refused for a cloud key, so "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" by default. Not the endpoint: the destination appends"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/api\/v0\/events"},{"type":"text","text":" itself."}],"type":"paragraph"}]},{"name":"isDebug","content":[{"inlineContent":[{"type":"text","text":"Whether every event is a debug event, which Aptabase’s dashboard shows only in"},{"type":"text","text":" "},{"type":"text","text":"its Debug mode and keeps for less time: "},{"code":"true","type":"codeVoice"},{"type":"text","text":" for a development or internal build,"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":" for one users run. There is no default: "},{"code":"#if DEBUG","type":"codeVoice"},{"type":"text","text":" in a library tells its own"},{"type":"text","text":" "},{"type":"text","text":"build configuration, not the app’s, so the app decides, from its own build settings."}],"type":"paragraph"}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}]}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}]},{"name":"backoff","content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,"},{"type":"text","text":" "},{"type":"text","text":"and each request’s deadline is checked against before it is sent; the system’s clock by"},{"type":"text","text":" "},{"type":"text","text":"default. When it reads NaN or infinite, every record is left out."}]}]}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"The destination posts each batch to the events API, ","type":"text"},{"code":"\/api\/v0\/events","type":"codeVoice"},{"text":", of","type":"text"},{"text":" ","type":"text"},{"code":"https:\/\/eu.aptabase.com","type":"codeVoice"},{"text":" for an ","type":"text"},{"code":"A-EU-","type":"codeVoice"},{"text":" key, ","type":"text"},{"code":"https:\/\/us.aptabase.com","type":"codeVoice"},{"text":" for an ","type":"text"},{"code":"A-US-","type":"codeVoice"},{"text":" key,","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"host","type":"codeVoice"},{"text":" for a self-hosted key (","type":"text"},{"code":"A-SH-","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"A-DEV-","type":"codeVoice"},{"text":" for a server run in development),","type":"text"},{"text":" ","type":"text"},{"text":"with the key in its ","type":"text"},{"code":"App-Key","type":"codeVoice"},{"text":" header field, encoded by an ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","isActive":true,"type":"reference"},{"text":" within","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":". It sends no trace context. It retries no response, a","type":"text"},{"text":" ","type":"text"},{"text":"5xx, 408 or 429, such as Aptabase answers past its rate limit, and 418, which Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"answers when a request’s body arrives slower than 60 bytes a second after a 10-second grace","type":"text"},{"text":" ","type":"text"},{"text":"period, as over a poor connection (","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses","isActive":true,"type":"reference"},{"text":"). It drops and","type":"text"},{"text":" ","type":"text"},{"text":"reports any other status, such as 400 for a request Aptabase can’t take.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The app key is public, as Aptabase’s SDKs ship it in every app, and the events API takes no","type":"text"},{"text":" ","type":"text"},{"text":"other credential, so the destination builds on every platform: an app sends to Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"directly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Aptabase takes no event tracked more than a day before it arrives, and answers 200 while"},{"type":"text","text":" "},{"type":"text","text":"storing nothing for one, so the encoder leaves out a record tracked more than 23 hours"},{"type":"text","text":" "},{"type":"text","text":"before it is encoded ("},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError\/timestampOutsideWindow","isActive":true,"type":"reference"},{"type":"text","text":"). A request is"},{"type":"text","text":" "},{"type":"text","text":"encoded once and retried as it is, so one still undelivered 23 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record was tracked, by the time "},{"code":"now","type":"codeVoice"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/emptyAppKey"},{"text":" for a key that is empty or only whitespace,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/malformedAppKey"},{"text":" for one that isn’t ","type":"text"},{"code":"A-<region>-<body>","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/unknownRegion"},{"text":" for a region other than ","type":"text"},{"code":"EU","type":"codeVoice"},{"text":", ","type":"text"},{"code":"US","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SH","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"DEV","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/selfHostedAppKeyWithoutHost"},{"text":" for a self-hosted key without ","type":"text"},{"code":"host","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEnco