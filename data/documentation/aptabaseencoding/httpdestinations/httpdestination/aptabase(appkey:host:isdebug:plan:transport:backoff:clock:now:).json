:"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A10SetupErrorO","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError","text":"AptabaseSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A12BatchEncoderV","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","text":"AptabaseBatchEncoder"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"appKey","content":[{"inlineContent":[{"type":"text","text":"The app’s key, from the Instructions page of its Aptabase dashboard, such as"},{"type":"text","text":" "},{"code":"A-EU-1234567890","type":"codeVoice"},{"type":"text","text":". Whitespace and newlines around it are trimmed off."}],"type":"paragraph"}]},{"name":"host","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The URL a self-hosted server is reached at ("},{"code":"https:\/\/aptabase.example.com","type":"codeVoice"},{"type":"text","text":"), a"},{"type":"text","text":" "},{"type":"text","text":"path included where it is served under one; required for an "},{"code":"A-SH-","type":"codeVoice"},{"type":"text","text":" or "},{"code":"A-DEV-","type":"codeVoice"},{"type":"text","text":" key and"},{"type":"text","text":" "},{"type":"text","text":"refused for a cloud key, so "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" by default. Not the endpoint: the destination appends"},{"type":"text","text":" "},{"code":"\/api\/v0\/events","type":"codeVoice"},{"type":"text","text":" itself."}]}]},{"name":"isDebug","content":[{"inlineContent":[{"text":"Whether every event is a debug event, which Aptabase’s dashboard shows only in","type":"text"},{"text":" ","type":"text"},{"text":"its Debug mode and keeps for less time: ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" for a development or internal build,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" for one users run. There is no default: ","type":"text"},{"type":"codeVoice","code":"#if DEBUG"},{"text":" in a library tells its own","type":"text"},{"text":" ","type":"text"},{"text":"build configuration, not the app’s, so the app decides, from its own build settings.","type":"text"}],"type":"paragraph"}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}]}]},{"name":"transport","content":[{"inlineContent":[{"type":"text","text":"What sends each request."}],"type":"paragraph"}]},{"name":"backoff","content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, by default."}],"type":"paragraph"}]},{"name":"clock","content":[{"inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}],"type":"paragraph"}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,","type":"text"},{"text":" ","type":"text"},{"text":"and each request’s deadline is checked against before it is sent; the system’s clock by","type":"text"},{"text":" ","type":"text"},{"text":"default. When it reads NaN or infinite, every record is left out.","type":"text"}]}]}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"text":"The destination.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The destination posts each batch to the events API, ","type":"text"},{"code":"\/api\/v0\/events","type":"codeVoice"},{"text":", of","type":"text"},{"text":" ","type":"text"},{"code":"https:\/\/eu.aptabase.com","type":"codeVoice"},{"text":" for an ","type":"text"},{"code":"A-EU-","type":"codeVoice"},{"text":" key, ","type":"text"},{"code":"https:\/\/us.aptabase.com","type":"codeVoice"},{"text":" for an ","type":"text"},{"code":"A-US-","type":"codeVoice"},{"text":" key,","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"host","type":"codeVoice"},{"text":" for a self-hosted key (","type":"text"},{"code":"A-SH-","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"A-DEV-","type":"codeVoice"},{"text":" for a server run in development),","type":"text"},{"text":" ","type":"text"},{"text":"with the key in its ","type":"text"},{"code":"App-Key","type":"codeVoice"},{"text":" header field, encoded by an ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","isActive":true,"type":"reference"},{"text":" within","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":". It sends no trace context. It retries no response, a","type":"text"},{"text":" ","type":"text"},{"text":"5xx, 408 or 429, such as Aptabase answers past its rate limit, and drops and reports any","type":"text"},{"text":" ","type":"text"},{"text":"other status, such as 400 for a request Aptabase can’t take. That includes 418, which","type":"text"},{"text":" ","type":"text"},{"text":"Aptabase answers when a request’s body arrives slower than 60 bytes a second after a","type":"text"},{"text":" ","type":"text"},{"text":"10-second grace period, as over a poor connection: its records are dropped, reported as","type":"text"},{"text":" ","type":"text"},{"text":"rejected, rather than retried.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The app key is public, as Aptabase’s SDKs ship it in every app, and the events API takes no","type":"text"},{"text":" ","type":"text"},{"text":"other credential, so the destination builds on every platform: an app sends to Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"directly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Aptabase takes no event tracked more than a day before it arrives, and answers 200 while","type":"text"},{"text":" ","type":"text"},{"text":"storing nothing for one, so the encoder leaves out a record tracked more than 23 hours","type":"text"},{"text":" ","type":"text"},{"text":"before it is encoded (","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError\/timestampOutsideWindow"},{"text":"). A request is","type":"text"},{"text":" ","type":"text"},{"text":"encoded once and retried as it is, so one still undelivered 23 hours after its oldest","type":"text"},{"text":" ","type":"text"},{"text":"record was tracked, by the time ","type":"text"},{"type":"codeVoice","code":"now"},{"text":" gives, isn’t sent again: it is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"text":".","type":"text"}]},{"style":"note","type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/emptyAppKey"},{"type":"text","text":" for a key that is empty or only whitespace,"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/malformedAppKey"},{"type":"text","text":" for one that isn’t "},{"type":"codeVoice","code":"A-<region>-<body>"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/unknownRegion"},{"type":"text","text":" for a region other than "},{"type":"codeVoice","code":"EU"},{"type":"text","text":", "},{"type":"codeVoice","code":"US"},{"type":"text","text":", "},{"type":"codeVoice","code":"SH"},{"type":"text","text":" and "},{"type":"codeVoice","code":"DEV"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/selfHostedAppKeyWithoutHost"},{"type":"text","text":" for a self-hosted key without "},{"type":"codeVoice","code":"host"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/cloudAppKeyWithHost"},{"type":"text","text":" for a cloud key with one, and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/invalidHost"},{"type":"text","text":" for a host that isn’t a plain "},{"type":"codeVoice","code":"https"},{"type":"text","text":" URL of the"},{"type":"text","text":" "},{"type":"text","text":"server."}]}]}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/aptabaseencoding\/httpdestinations\/httpdestination\/aptabase(appkey:host:isdebug:plan:transport:backoff:clock:now:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)"},"seeAlsoSections":[{"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError"],"generated":true,"anchor":"Sending-to-Aptabase","title":"Sending to Aptabase"}],"references":{"doc://AptabaseEncoding/documentation/AptabaseEncoding/HTTPDestinations/HTTPDestination/aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)":{"kind":"symbol","title":"aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)","url":"\/documentation\/aptabaseencoding\/httpdestinations\/httpdestination\/aptabase(appkey:host:isdebug:plan:transport:backoff:clock:now:)","type":"topic","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind