gPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","kind":"typeIdentifier","text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"kind":"text","text":" = ExponentialBackoff(), "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError","kind":"typeIdentifier","text":"AptabaseSetupError","preciseIdentifier":"s:16AptabaseEncoding0A10SetupErrorO"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","kind":"typeIdentifier","text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","kind":"typeIdentifier","text":"AptabaseBatchEncoder","preciseIdentifier":"s:16AptabaseEncoding0A12BatchEncoderV"},{"kind":"text","text":">"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app’s key, from the Instructions page of its Aptabase dashboard, such as"},{"type":"text","text":" "},{"code":"A-EU-1234567890","type":"codeVoice"},{"type":"text","text":". Whitespace and newlines around it are trimmed off."}]}],"name":"appKey"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The URL a self-hosted server is reached at (","type":"text"},{"code":"https:\/\/aptabase.example.com","type":"codeVoice"},{"text":"), a","type":"text"},{"text":" ","type":"text"},{"text":"path included where it is served under one; required for an ","type":"text"},{"code":"A-SH-","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"A-DEV-","type":"codeVoice"},{"text":" key and","type":"text"},{"text":" ","type":"text"},{"text":"refused for a cloud key, so ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" by default. Not the endpoint: the destination appends","type":"text"},{"text":" ","type":"text"},{"code":"\/api\/v0\/events","type":"codeVoice"},{"text":" itself.","type":"text"}]}],"name":"host"},{"content":[{"inlineContent":[{"text":"Whether every event is a debug event, which Aptabase’s dashboard shows only in","type":"text"},{"text":" ","type":"text"},{"text":"its Debug mode and keeps for less time: ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for a development or internal build,","type":"text"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for one users run. There is no default: ","type":"text"},{"code":"#if DEBUG","type":"codeVoice"},{"text":" in a library tells its own","type":"text"},{"text":" ","type":"text"},{"text":"build configuration, not the app’s, so the app decides, from its own build settings.","type":"text"}],"type":"paragraph"}],"name":"isDebug"},{"content":[{"inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}],"type":"paragraph"}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}],"name":"transport"},{"content":[{"type":"paragraph","inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, by default.","type":"text"}]}],"name":"backoff"},{"content":[{"inlineContent":[{"type":"text","text":"The clock the waits are measured on."}],"type":"paragraph"}],"name":"clock"},{"content":[{"inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,","type":"text"},{"text":" ","type":"text"},{"text":"and each request’s deadline is checked against before it is sent; the system’s clock by","type":"text"},{"text":" ","type":"text"},{"text":"default. When it reads NaN or infinite, every record is left out.","type":"text"}],"type":"paragraph"}],"name":"now"}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The destination.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The destination posts each batch to the events API, ","type":"text"},{"type":"codeVoice","code":"\/api\/v0\/events"},{"text":", of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"https:\/\/eu.aptabase.com"},{"text":" for an ","type":"text"},{"type":"codeVoice","code":"A-EU-"},{"text":" key, ","type":"text"},{"type":"codeVoice","code":"https:\/\/us.aptabase.com"},{"text":" for an ","type":"text"},{"type":"codeVoice","code":"A-US-"},{"text":" key,","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"type":"codeVoice","code":"host"},{"text":" for a self-hosted key (","type":"text"},{"type":"codeVoice","code":"A-SH-"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"A-DEV-"},{"text":" for a server run in development),","type":"text"},{"text":" ","type":"text"},{"text":"with the key in its ","type":"text"},{"type":"codeVoice","code":"App-Key"},{"text":" header field, encoded by an ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","type":"reference","isActive":true},{"text":" within","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":". It sends no trace context. It retries no response, a","type":"text"},{"text":" ","type":"text"},{"text":"5xx, 408 or 429, such as Aptabase answers past its rate limit, and 418, which Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"answers when a request’s body arrives slower than 60 bytes a second after a 10-second grace","type":"text"},{"text":" ","type":"text"},{"text":"period, as over a poor connection (","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses","type":"reference","isActive":true},{"text":"). It drops and","type":"text"},{"text":" ","type":"text"},{"text":"reports any other status, such as 400 for a request Aptabase can’t take.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app key is public, as Aptabase’s SDKs ship it in every app, and the events API takes no"},{"type":"text","text":" "},{"type":"text","text":"other credential, so the destination builds on every platform: an app sends to Aptabase"},{"type":"text","text":" "},{"type":"text","text":"directly."}]},{"type":"paragraph","inlineContent":[{"text":"Aptabase takes no event tracked more than a day before it arrives, and answers 200 while","type":"text"},{"text":" ","type":"text"},{"text":"storing nothing for one, so the encoder leaves out a record tracked more than 23 hours","type":"text"},{"text":" ","type":"text"},{"text":"before it is encoded (","type":"text"},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError\/timestampOutsideWindow","type":"reference"},{"text":"). A request is","type":"text"},{"text":" ","type":"text"},{"text":"encoded once and retried as it is, so one still undelivered 23 hours after its oldest","type":"text"},{"text":" ","type":"text"},{"text":"record was tracked, by the time ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" gives, isn’t sent again: it is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":".","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/emptyAppKey"},{"type":"text","text":" for a key that is empty or only whitespace,"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/malformedAppKey"},{"type":"text","text":" for one that isn’t "},{"type":"codeVoice","code":"A-<region>-<body>"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/unknownRegion"},{"type":"text","text":" for a region other than "},{"type":"codeVoice","code":"EU"},{"type":"text","text":", "},{"type":"codeVoice","code":"US"},{"type":"text","text":", "},{"type":"codeVoice","code":"SH"},{"type":"text","text":" and "},{"type":"codeVoice","code":"DEV"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/