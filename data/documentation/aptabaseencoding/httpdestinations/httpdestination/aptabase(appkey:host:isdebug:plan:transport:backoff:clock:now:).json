text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":"> = ContinuousClock(), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":" = { Date.now }) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"AptabaseSetupError","kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A10SetupErrorO","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AptabaseBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A12BatchEncoderV","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"appKey","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app’s key, from the Instructions page of its Aptabase dashboard, such as"},{"type":"text","text":" "},{"code":"A-EU-1234567890","type":"codeVoice"},{"type":"text","text":". Whitespace and newlines around it are trimmed off."}]}]},{"name":"host","content":[{"inlineContent":[{"text":"The URL a self-hosted server is reached at (","type":"text"},{"type":"codeVoice","code":"https:\/\/aptabase.example.com"},{"text":"), a","type":"text"},{"text":" ","type":"text"},{"text":"path included where it is served under one; required for an ","type":"text"},{"type":"codeVoice","code":"A-SH-"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"A-DEV-"},{"text":" key and","type":"text"},{"text":" ","type":"text"},{"text":"refused for a cloud key, so ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" by default. Not the endpoint: the destination appends","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\/api\/v0\/events"},{"text":" itself.","type":"text"}],"type":"paragraph"}]},{"name":"isDebug","content":[{"inlineContent":[{"type":"text","text":"Whether every event is a debug event, which Aptabase’s dashboard shows only in"},{"type":"text","text":" "},{"type":"text","text":"its Debug mode and keeps for less time: "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for a development or internal build,"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for one users run. There is no default: "},{"type":"codeVoice","code":"#if DEBUG"},{"type":"text","text":" in a library tells its own"},{"type":"text","text":" "},{"type":"text","text":"build configuration, not the app’s, so the app decides, from its own build settings."}],"type":"paragraph"}]},{"name":"plan","content":[{"inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}],"type":"paragraph"}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}]},{"name":"backoff","content":[{"inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, with full jitter, by default.","type":"text"}],"type":"paragraph"}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}]},{"name":"now","content":[{"inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,","type":"text"},{"text":" ","type":"text"},{"text":"and each request’s deadline is checked against before it is sent; the system’s clock by","type":"text"},{"text":" ","type":"text"},{"text":"default. When it reads NaN or infinite, every record is left out.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The destination.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination posts each batch to the events API, "},{"type":"codeVoice","code":"\/api\/v0\/events"},{"type":"text","text":", of"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/eu.aptabase.com"},{"type":"text","text":" for an "},{"type":"codeVoice","code":"A-EU-"},{"type":"text","text":" key, "},{"type":"codeVoice","code":"https:\/\/us.aptabase.com"},{"type":"text","text":" for an "},{"type":"codeVoice","code":"A-US-"},{"type":"text","text":" key,"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"host"},{"type":"text","text":" for a self-hosted key ("},{"type":"codeVoice","code":"A-SH-"},{"type":"text","text":", or "},{"type":"codeVoice","code":"A-DEV-"},{"type":"text","text":" for a server run in development),"},{"type":"text","text":" "},{"type":"text","text":"with the key in its "},{"type":"codeVoice","code":"App-Key"},{"type":"text","text":" header field, encoded by an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},{"type":"text","text":" within"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit"},{"type":"text","text":". It sends no trace context. It retries no response, a"},{"type":"text","text":" "},{"type":"text","text":"5xx, 408 or 429, such as Aptabase answers past its rate limit, and 418, which Aptabase"},{"type":"text","text":" "},{"type":"text","text":"answers when a request’s body arrives slower than 60 bytes a second after a 10-second grace"},{"type":"text","text":" "},{"type":"text","text":"period, as over a poor connection ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses"},{"type":"text","text":"). It drops and"},{"type":"text","text":" "},{"type":"text","text":"reports any other status, such as 400 for a request Aptabase can’t take."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app key is public, as Aptabase’s SDKs ship it in every app, and the events API takes no"},{"type":"text","text":" "},{"type":"text","text":"other credential, so the destination builds on every platform: an app sends to Aptabase"},{"type":"text","text":" "},{"type":"text","text":"directly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Aptabase takes no event tracked more than a day before it arrives, and answers 200 while"},{"type":"text","text":" "},{"type":"text","text":"storing nothing for one, so the encoder leaves out a record tracked more than 23 hours"},{"type":"text","text":" "},{"type":"text","text":"before it is encoded ("},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError\/timestampOutsideWindow","isActive":true},{"type":"text","text":"). A request is"},{"type":"text","text":" "},{"type":"text","text":"encoded once and retried as it is, so one still undelivered 23 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record was tracked, by the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":"."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/emptyAppKey","type":"reference"},{"text":" for a key that is empty or only whitespace,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/malformedAppKey","type":"reference"},{"text":" for one that isn’t ","type":"text"},{"code":"A-<region>-<body>","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/unknownRegion","type":"reference"},{"text":" for a region other than ","type":"text"},{"code":"EU","type":"codeVoice"},{"text":", ","type":"text"},{"code":"US","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SH","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"DEV","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/selfHostedAppKeyWithoutHost","type":"reference"},{"text":" for a self-hosted key without ","type":"text"},{"code":"host","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/cloudAppKeyWithHost","type":"reference"},{"text":" for a cloud key with one, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/invalidHost","type":"reference"},{"text":" for a host that isn’t a plain ","type":"text"},{"code":"https","type":"codeVoice"},{"text":" URL of the","type":"text"},{"text":" ","type":"text"},{"text":"server.","type":"text"}]}],"type":"aside","style":"note","name":"Throws"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"A destination that sends batches to the Aptabase app of "},{"type":"codeVoice","code":"appKey"},{"type":"text","text":", at the region its key"},{"type":"text","text":" "},{"type":"text","text":"names or, for a self-hosted key, at "},{"type":"codeVoice","code":"host"},{"type":"text","text":", marking every event as a debug event or not as"},{"type":"text","text":" "},{"type":"codeVoice","code":"isDebug"},{"type":"text","text":" says, through "},{"type":"codeVoice","code":"transport"},{"type":"text","text":", retrying a send that fails for now with the waits of"},{"type":"text","text":" "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/aptabaseencoding\/httpdestinations\/httpdestination\/aptabase(appkey:host:isdebug:plan:transport:backoff:clock:now:)"]}],"references":{"doc://AptabaseEncoding/documentation/AptabaseEncoding/HTTPDestinations/HTTPDestination/aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)":{"url":"\/documentation\/aptabaseencoding\/httpdestinations\/httpdestination\/aptabase(appkey:host:isdebug:plan:transport:backoff:clock:now:)","type":"topic","title":"aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"aptabase"},{"kind":"text","text":"("},{"kind":"externalParam","text":