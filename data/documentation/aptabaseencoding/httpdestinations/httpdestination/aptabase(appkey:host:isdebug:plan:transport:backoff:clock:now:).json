:": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"isDebug"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff"},{"kind":"text","text":" = ExponentialBackoff(), "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A10SetupErrorO","text":"AptabaseSetupError","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A12BatchEncoderV","text":"AptabaseBatchEncoder","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},{"kind":"text","text":">"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The app’s key, from the Instructions page of its Aptabase dashboard, such as","type":"text"},{"text":" ","type":"text"},{"code":"A-EU-1234567890","type":"codeVoice"},{"text":". Whitespace and newlines around it are trimmed off.","type":"text"}]}],"name":"appKey"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The URL a self-hosted server is reached at (","type":"text"},{"code":"https:\/\/aptabase.example.com","type":"codeVoice"},{"text":"), a","type":"text"},{"text":" ","type":"text"},{"text":"path included where it is served under one; required for an ","type":"text"},{"code":"A-SH-","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"A-DEV-","type":"codeVoice"},{"text":" key and","type":"text"},{"text":" ","type":"text"},{"text":"refused for a cloud key, so ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" by default. Not the endpoint: the destination appends","type":"text"},{"text":" ","type":"text"},{"code":"\/api\/v0\/events","type":"codeVoice"},{"text":" itself.","type":"text"}]}],"name":"host"},{"content":[{"inlineContent":[{"type":"text","text":"Whether every event is a debug event, which Aptabase’s dashboard shows only in"},{"type":"text","text":" "},{"type":"text","text":"its Debug mode and keeps for less time: "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for a development or internal build,"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for one users run. There is no default: "},{"type":"codeVoice","code":"#if DEBUG"},{"type":"text","text":" in a library tells its own"},{"type":"text","text":" "},{"type":"text","text":"build configuration, not the app’s, so the app decides, from its own build settings."}],"type":"paragraph"}],"name":"isDebug"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}]}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}],"name":"transport"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}]}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}],"name":"clock"},{"content":[{"inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,","type":"text"},{"text":" ","type":"text"},{"text":"and each request’s deadline is checked against before it is sent; the system’s clock by","type":"text"},{"text":" ","type":"text"},{"text":"default. When it reads NaN or infinite, every record is left out.","type":"text"}],"type":"paragraph"}],"name":"now"}]},{"kind":"content","content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination posts each batch to the events API, "},{"type":"codeVoice","code":"\/api\/v0\/events"},{"type":"text","text":", of"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/eu.aptabase.com"},{"type":"text","text":" for an "},{"type":"codeVoice","code":"A-EU-"},{"type":"text","text":" key, "},{"type":"codeVoice","code":"https:\/\/us.aptabase.com"},{"type":"text","text":" for an "},{"type":"codeVoice","code":"A-US-"},{"type":"text","text":" key,"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"host"},{"type":"text","text":" for a self-hosted key ("},{"type":"codeVoice","code":"A-SH-"},{"type":"text","text":", or "},{"type":"codeVoice","code":"A-DEV-"},{"type":"text","text":" for a server run in development),"},{"type":"text","text":" "},{"type":"text","text":"with the key in its "},{"type":"codeVoice","code":"App-Key"},{"type":"text","text":" header field, encoded by an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},{"type":"text","text":" within"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit"},{"type":"text","text":". It sends no trace context. It retries no response, a"},{"type":"text","text":" "},{"type":"text","text":"5xx, 408 or 429, such as Aptabase answers past its rate limit, and 418, which Aptabase"},{"type":"text","text":" "},{"type":"text","text":"answers when a request’s body arrives slower than 60 bytes a second after a 10-second grace"},{"type":"text","text":" "},{"type":"text","text":"period, as over a poor connection ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses"},{"type":"text","text":"). It drops and"},{"type":"text","text":" "},{"type":"text","text":"reports any other status, such as 400 for a request Aptabase can’t take."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app key is public, as Aptabase’s SDKs ship it in every app, and the events API takes no"},{"type":"text","text":" "},{"type":"text","text":"other credential, so the destination builds on every platform: an app sends to Aptabase"},{"type":"text","text":" "},{"type":"text","text":"directly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Aptabase takes no event tracked more than a day before it arrives, and answers 200 while"},{"type":"text","text":" "},{"type":"text","text":"storing nothing for one, so the encoder leaves out a record tracked more than 23 hours"},{"type":"text","text":" "},{"type":"text","text":"before it is encoded ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError\/timestampOutsideWindow"},{"type":"text","text":"). A request is"},{"type":"text","text":" "},{"type":"text","text":"encoded once and retried as it is, so one still undelivered 23 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record was tracked, by the time "},{"code":"now","type":"codeVoice"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"type":"text","text":"."}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/emptyAppKey"},{"type":"text","text":" for a key that is empty or only whitespace,"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/malformedAppKey"},{"type":"text","text":" for one that isn’t "},{"code":"A-<region>-<body>","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/unknownRegion"},{"type":"text","text":" for a region other than "},{"code":"EU","type":"codeVoice"},{"type":"text","text":", "},{"code":"US","type":"codeVoice"},{"type":"text","text":", "},{"code":"SH","type":"codeVoice"},{"type":"text","text":" and "},{"code":"DEV","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/selfHostedAppKeyWithoutHost"},{"type":"text","text":" for a self-hosted key without "},{"code":"host","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/cloudAppKeyWithHost"},{"type":"text","text":" for a cloud key with one, and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/invalidHost"},{"type":"text","text":" for a host that isn’t a plain "},{"code":"https","type":"codeVoice"},{"type":"text","text":" URL of the"},{"type":"text","text":" "},{"type":"text","text":"server."}]}],"name":"Throws"}]}],"references":{"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseEncodingError/timestampOutsideWindow":{"role":"symbol","abstract":[{"text":"The record was tracked more than 23 hours before the batch was encoded, or the clock the","type":"text"},{"text":" ","type":"text"},{"text":"encoder reads gave a NaN or infinite time. Aptabase drops an event more than a day old while","type":"text"},{"text":" ","type":"text"},{"text":"answering 200; the hour to spare is for a queue on the server and clocks that disagree.","type":"text"}],"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodin