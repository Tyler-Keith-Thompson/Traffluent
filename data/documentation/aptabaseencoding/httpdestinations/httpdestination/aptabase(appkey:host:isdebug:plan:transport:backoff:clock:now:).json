kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"text":"? = nil, ","kind":"text"},{"text":"isDebug","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":" = ExponentialBackoff(), ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":"> = ContinuousClock(), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":" = { Date.now }) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"AptabaseSetupError","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError","kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A10SetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AptabaseBatchEncoder","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A12BatchEncoderV"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"appKey","content":[{"inlineContent":[{"type":"text","text":"The app’s key, from the Instructions page of its Aptabase dashboard, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"A-EU-1234567890"},{"type":"text","text":". Whitespace and newlines around it are trimmed off."}],"type":"paragraph"}]},{"name":"host","content":[{"inlineContent":[{"type":"text","text":"The URL a self-hosted server is reached at ("},{"type":"codeVoice","code":"https:\/\/aptabase.example.com"},{"type":"text","text":"), a"},{"type":"text","text":" "},{"type":"text","text":"path included where it is served under one; required for an "},{"type":"codeVoice","code":"A-SH-"},{"type":"text","text":" or "},{"type":"codeVoice","code":"A-DEV-"},{"type":"text","text":" key and"},{"type":"text","text":" "},{"type":"text","text":"refused for a cloud key, so "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" by default. Not the endpoint: the destination appends"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/api\/v0\/events"},{"type":"text","text":" itself."}],"type":"paragraph"}]},{"name":"isDebug","content":[{"inlineContent":[{"text":"Whether every event is a debug event, which Aptabase’s dashboard shows only in","type":"text"},{"text":" ","type":"text"},{"text":"its Debug mode and keeps for less time: ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for a development or internal build,","type":"text"},{"text":" ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for one users run. There is no default: ","type":"text"},{"code":"#if DEBUG","type":"codeVoice"},{"text":" in a library tells its own","type":"text"},{"text":" ","type":"text"},{"text":"build configuration, not the app’s, so the app decides, from its own build settings.","type":"text"}],"type":"paragraph"}]},{"name":"plan","content":[{"inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}],"type":"paragraph"}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}]},{"name":"backoff","content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,"},{"type":"text","text":" "},{"type":"text","text":"and each request’s deadline is checked against before it is sent; the system’s clock by"},{"type":"text","text":" "},{"type":"text","text":"default. When it reads NaN or infinite, every record is left out."}]}]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The destination posts each batch to the events API, "},{"code":"\/api\/v0\/events","type":"codeVoice"},{"type":"text","text":", of"},{"type":"text","text":" "},{"code":"https:\/\/eu.aptabase.com","type":"codeVoice"},{"type":"text","text":" for an "},{"code":"A-EU-","type":"codeVoice"},{"type":"text","text":" key, "},{"code":"https:\/\/us.aptabase.com","type":"codeVoice"},{"type":"text","text":" for an "},{"code":"A-US-","type":"codeVoice"},{"type":"text","text":" key,"},{"type":"text","text":" "},{"type":"text","text":"or "},{"code":"host","type":"codeVoice"},{"type":"text","text":" for a self-hosted key ("},{"code":"A-SH-","type":"codeVoice"},{"type":"text","text":", or "},{"code":"A-DEV-","type":"codeVoice"},{"type":"text","text":" for a server run in development),"},{"type":"text","text":" "},{"type":"text","text":"with the key in its "},{"code":"App-Key","type":"codeVoice"},{"type":"text","text":" header field, encoded by an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},{"type":"text","text":" within"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit"},{"type":"text","text":". It sends no trace context. It retries no response, a"},{"type":"text","text":" "},{"type":"text","text":"5xx, 408 or 429, such as Aptabase answers past its rate limit, and 418, which Aptabase"},{"type":"text","text":" "},{"type":"text","text":"answers when a request’s body arrives slower than 60 bytes a second after a 10-second grace"},{"type":"text","text":" "},{"type":"text","text":"period, as over a poor connection ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses"},{"type":"text","text":"). It drops and"},{"type":"text","text":" "},{"type":"text","text":"reports any other status, such as 400 for a request Aptabase can’t take."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The app key is public, as Aptabase’s SDKs ship it in every app, and the events API takes no"},{"type":"text","text":" "},{"type":"text","text":"other credential, so the destination builds on every platform: an app sends to Aptabase"},{"type":"text","text":" "},{"type":"text","text":"directly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Aptabase takes no event tracked more than a day before it arrives, and answers 200 while"},{"type":"text","text":" "},{"type":"text","text":"storing nothing for one, so the encoder leaves out a record tracked more than 23 hours"},{"type":"text","text":" "},{"type":"text","text":"before it is encoded ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError\/timestampOutsideWindow"},{"type":"text","text":"). A request is"},{"type":"text","text":" "},{"type":"text","text":"encoded once and retried as it is, so one still undelivered 23 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record was tracked, by the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/emptyAppKey","isActive":true,"type":"reference"},{"text":" for a key that is empty or only whitespace,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/malformedAppKey","isActive":true,"type":"reference"},{"text":" for one that isn’t ","type":"text"},{"code":"A-<region>-<body>","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/unknownRegion","isActive":true,"type":"reference"},{"text":" for a region other than ","type":"text"},{"code":"EU","type":"codeVoice"},{"text":", ","type":"text"},{"code":"US","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SH","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"DEV","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/selfHostedAppKeyWithoutHost","isActive":true,"type":"reference"},{"text":" for a self-hosted key without ","type":"text"},{"code":"host","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/cloudAppKeyWithHost","isActive":true,"type":"reference"},{"text":" for a cloud key with one, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/invalidHost","isActive":true,"type":"reference"},{"text":" for a host that isn’t a plain ","type":"text"},{"code":"https","type":"codeVoice"},{"text":" URL of the","type":"text"},{"text":" ","type":"text"},{"text":"server.","type":"text"}]}],"style":"note","type":"aside"}]}],"references":{"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseSetupError/unknownRegion":{"abstract":[{"text":"The app key’s region, its second part, is none Aptabase makes keys for: ","type":"text"},{"code":"EU","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"US","type":"codeVoice"},{"text":", its","type":"text"},{"text":" ","type":"text"},{"text":"cloud’s regions, ","type":"text"},{"code":"SH","type":"codeVoice"},{"text":", a self-hosted server’s, and ","type":"text"},{"code":"DEV","type":"codeVoice"},{"text":", a server run in development. A","type":"text"},{"text":" ","type":"text"},{"text":"region is written in capitals, as Aptabase writes it.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/unknownRegion","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknownRegion","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/aptabaseencoding\/aptabasesetuperror\/unknownregion","title":"AptabaseSetupError.unknownRegion"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseSetupError/malformedAppKey":{"type":"topic","title":"AptabaseSetupError.malformedAppKey","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"malformedAppKey"}],"kind":"symbol","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/malformedAppKey","abstract":[{"text":"The app key isn’t ","type":"text"},{"type":"codeVoice","code":"A-"},{"text":", a region, ","type":"text"},{"type":"codeVoice","code":"-"},{"text":" and a body of ASCII letters and digits, such as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"A-EU-1234567890"},{"text":": it has more or fewer than three parts, a first part other than ","type":"text"},{"type":"codeVoice","code":"A"},{"text":", or a","type":"text"},{"text":" ","type":"text"},{"text":"body that is empty or holds another character.","type":"text"}],"role":"symbol","url":"\/documentation\/aptabaseencoding\/aptabasesetuperror\/malformedappkey"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseEncodingError/timestampOutsideWindow":{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError\/timestampOutsideWindow","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"timestampOutsideWindow"}],"type":"topic","abstract":[{"text":"The record was tracked more than 23 hours before the batch was encoded, or the clock the","type":"text"},{"text":" ","type":"text"},{"text":"encoder reads gave a NaN or infinite time. Aptabase drops an event more than a day old while","type":"text"},{"text":" ","type":"text"},{"text":"answering 200; the hour to spare is for a queue on the server and clocks that disagree.","type":"text"}],"kind":"symbol","role":"symbol","title":"AptabaseEncodingError.timestampOutsideWindow","url":"\/documentation\/aptabaseencoding\/aptabaseencodingerror\/timestampoutsidewindow"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/transientStatuses":{"abstract":[{"type":"text","text":"The status Aptabase answers that "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries, beside 408, 429 and every 5xx:"},{"type":"text","text":" "},{"type":"text","text":"418, which Aptabase answers when a request’s body arrives slower than 60 bytes a second"},{"type":"text","text":" "},{"type":"text","text":"after a 10-second grace period, as over a poor connection."}],"url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/transientstatuses","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses","title":"transientStatuses","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientStatuses","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","text":"TransientStatus","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://AptabaseEncoding/documentation/AptabaseEncoding/HTTPDestinations":{"title":"HTTPDestinations","url":"\/documentation\/aptabaseencoding\/httpdestinations","abstract":[],"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations","type":"topic