{"abstract":[{"type":"text","text":"Why "},{"isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","type":"reference"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"relationshipsSections":[{"identifiers":["doc:\/\/AptabaseEncoding\/SQ","doc:\/\/AptabaseEncoding\/s5ErrorP","doc:\/\/AptabaseEncoding\/SH","doc:\/\/AptabaseEncoding\/s8SendableP","doc:\/\/AptabaseEncoding\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"metadata":{"symbolKind":"enum","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AptabaseEncoding\/AptabaseEncodingError.swift#L11","fileName":"AptabaseEncodingError.swift"},"role":"symbol","roleHeading":"Enumeration","modules":[{"name":"AptabaseEncoding"}],"externalID":"s:16AptabaseEncoding0aB5ErrorO","title":"AptabaseEncodingError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AptabaseEncodingError"}],"navigatorTitle":[{"kind":"identifier","text":"AptabaseEncodingError"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AptabaseEncodingError","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Aptabase