# Hand-written: UI tests, which drive an app with real touches through XCUIApplication, of what no
# test inside the app can bring about, as UIKit has no public way to make a touch. SwiftPM never
# sees this directory, and scripts/modules.py doesn't generate it.

load("@rules_apple//apple:ios.bzl", "ios_application", "ios_ui_test")
load("@rules_apple//apple/testing/default_runner:ios_xctestrun_runner.bzl", "ios_xctestrun_runner")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools:swift_rules.bzl", "swift_library")

BUNDLE_ID = "com.example.traffluent.controltracking"

swift_library(
    name = "ControlTrackingAppLibrary",
    testonly = True,
    srcs = glob(["App/**/*.swift"]),
    module_name = "ControlTrackingApp",
    tags = ["debug-only"],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        "//Sources/AutomaticControlTracking",
        "//Sources/Events",
        "//Sources/SwiftUITracking",
        "//Sources/Trackers",
        "//Sources/UIKitTracking",
    ],
)

ios_application(
    name = "ControlTrackingApp",
    testonly = True,
    bundle_id = BUNDLE_ID,
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["App/Info.plist"],
    minimum_os_version = "18.0",
    # Built only as the UI test's host, which only a Mac runs: `bazel test //...` on Linux would
    # otherwise build it and find no iOS toolchain. Not `target_compatible_with`: the rule builds
    # itself for iOS, where no constraint tells the host machine apart.
    tags = [
        "debug-only",
        "manual",
    ],
    deps = [":ControlTrackingAppLibrary"],
)

swift_library(
    name = "AutomaticControlTrackingUITestsLibrary",
    testonly = True,
    srcs = glob(["Tests/**/*.swift"]),
    module_name = "AutomaticControlTrackingUITests",
    tags = ["debug-only"],
    target_compatible_with = ["@platforms//os:ios"],
)

# Removes the app from the simulator before each run. The runner reuses a booted simulator, and
# installing over an earlier install keeps any file whose size and modification time match. Bazel
# gives every file the same fixed time, and a small change to the app's code rarely changes its
# binary's size (Mach-O segments are page-aligned), so without this the tests can run an earlier
# build of the app.
genrule(
    name = "uninstall_app_script",
    outs = ["uninstall_app.sh"],
    cmd = """cat > $@ <<'EOF'
#!/bin/bash
# Fails only when simctl does; an app that isn't installed is already gone.
xcrun simctl uninstall "$$SIMULATOR_UDID" %s
EOF""" % BUNDLE_ID,
    tags = ["manual"],
)

sh_binary(
    name = "uninstall_app",
    srcs = [":uninstall_app_script"],
    tags = ["manual"],
)

# An iPad, where a second scene shows beside the first (an iPhone shows one scene at a time), in
# order. The OS version is --ios_simulator_version's (.bazelrc).
ios_xctestrun_runner(
    name = "ipad_runner",
    device_type = "iPad Pro 13-inch (M4)",
    pre_action = ":uninstall_app",
    random = False,
    # Used only as the UI test's runner, which only a Mac runs: since rules_apple 5 the runner needs
    # the Mac tools toolchain, so `bazel test //...` on Linux would otherwise fail resolving it.
    tags = ["manual"],
)

# `resources:simulator:1` runs one simulator test at a time (.bazelrc).
ios_ui_test(
    name = "AutomaticControlTrackingUITests",
    size = "large",
    minimum_os_version = "18.0",
    tags = [
        "debug-only",
        "resources:simulator:1",
    ],
    runner = ":ipad_runner",
    # The simulator is the Mac's alone, so elsewhere `bazel test //...` skips the bundle.
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    test_host = ":ControlTrackingApp",
    deps = [":AutomaticControlTrackingUITestsLibrary"],
)
