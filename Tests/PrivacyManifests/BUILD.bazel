# GENERATED by scripts/modules.py (PRIVACY_MANIFEST) — add or remove a module's PrivacyInfo.xcprivacy,
# then run `just modules`.

load("@rules_apple//apple:macos.bzl", "macos_bundle")
load("//tools:python_test.bzl", "python_test")

# A loadable bundle linking every module that ships a privacy manifest, so rules_apple copies their
# manifest bundles into it as it would into an app.
macos_bundle(
    name = "PrivacyManifestsBundle",
    bundle_id = "com.example.traffluent.privacymanifests",
    infoplists = ["Info.plist"],
    minimum_os_version = "15.0",
    tags = ["debug-only"],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//Sources/SwiftUITracking",
        "//Sources/UIKitTracking",
        "//Sources/AppKitTracking",
        "//Sources/AutomaticScreenTracking",
        "//Sources/AutomaticControlTracking",
        "//Sources/LifecycleTracking",
        "//Sources/Sessions",
        "//Sources/StandardContext",
    ],
)

# Every module's manifest is in the bundle, in a bundle of the name SwiftPM gives it, the same as
# its source, and declares no tracking. The arguments are the manifest bundles' names.
python_test(
    name = "PrivacyManifests",
    size = "small",
    src = "privacy_manifests_test.py",
    args = [
        "Traffluent_SwiftUITracking",
        "Traffluent_UIKitTracking",
        "Traffluent_AppKitTracking",
        "Traffluent_AutomaticScreenTracking",
        "Traffluent_AutomaticControlTracking",
        "Traffluent_LifecycleTracking",
        "Traffluent_Sessions",
        "Traffluent_StandardContext",
    ],
    data = [
        ":PrivacyManifestsBundle",
        "//Sources/SwiftUITracking:PrivacyInfo.xcprivacy",
        "//Sources/UIKitTracking:PrivacyInfo.xcprivacy",
        "//Sources/AppKitTracking:PrivacyInfo.xcprivacy",
        "//Sources/AutomaticScreenTracking:PrivacyInfo.xcprivacy",
        "//Sources/AutomaticControlTracking:PrivacyInfo.xcprivacy",
        "//Sources/LifecycleTracking:PrivacyInfo.xcprivacy",
        "//Sources/Sessions:PrivacyInfo.xcprivacy",
        "//Sources/StandardContext:PrivacyInfo.xcprivacy",
    ],
    tags = ["debug-only"],
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
