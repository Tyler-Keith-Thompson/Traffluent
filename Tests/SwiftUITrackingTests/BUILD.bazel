# GENERATED by scripts/modules.py — edit the table there, then run `just modules`.

load("@rules_apple//apple:ios.bzl", "ios_unit_test")
load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("//tools:swift_rules.bzl", "swift_library", "swift_test")

# The tests, built once and linked into two runners.
# Tagged `debug-only`: none of these relies on speed, so
# `--config=release` neither builds nor runs them (.bazelrc).
swift_library(
    name = "SwiftUITrackingTestsLibrary",
    testonly = True,
    # Tests are found through metadata the linker would otherwise drop, since nothing
    # references them by name.
    alwayslink = True,
    srcs = glob(["**/*.swift"]),
    module_name = "SwiftUITrackingTests",
    tags = ["debug-only"],
    # Read by //:package_swift_test, which checks Package.swift against the Bazel graph.
    visibility = ["//:__pkg__"],
    deps = [
        "//Sources/SwiftUITracking",
        "//Sources/UIKitTracking",
        "//Sources/EventMacros",
        "//Sources/Events",
        "//Sources/Persistence",
        "//Sources/Trackers",
        "@swiftpkg_swift_distributed_tracing//:Instrumentation",
    ],
)

# `bazel test` / `just test`: a standalone executable, fast to start and run in Bazel's sandbox.
swift_test(
    name = "SwiftUITrackingTests",
    size = "small",
    tags = ["debug-only"],
    deps = [":SwiftUITrackingTestsLibrary"],
)

# The generated Xcode project: a real .xctest bundle (an MH_BUNDLE), which is what Xcode's test
# runner loads. `manual` keeps it out of `bazel test //...`; it runs through xcodebuild, so it
# is only for Xcode. XCTest refuses exit tests in a sandboxed host, hence `no-sandbox`.
macos_unit_test(
    name = "SwiftUITrackingTestsBundle",
    bundle_name = "SwiftUITrackingTests",
    size = "small",
    minimum_os_version = "15.0",
    tags = ["manual", "no-sandbox"],
    # Visible so `//:xcodeproj` can name it as a top-level target.
    visibility = ["//visibility:public"],
    deps = [":SwiftUITrackingTestsLibrary"],
)

# The same tests in the iOS simulator (SIMULATOR_TESTS in scripts/modules.py), where the code
# under `#if canImport(UIKit)` compiles. iOS only, so `bazel build //...` builds it through the
# bundle below alone.
swift_library(
    name = "SwiftUITrackingTestsSimulatorLibrary",
    testonly = True,
    alwayslink = True,
    srcs = glob(["**/*.swift"]),
    module_name = "SwiftUITrackingTests",
    tags = ["debug-only"],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        "//Sources/SwiftUITracking",
        "//Sources/UIKitTracking",
        "//Sources/EventMacros",
        "//Sources/Events",
        "//Sources/Persistence",
        "//Sources/Trackers",
        "@swiftpkg_swift_distributed_tracing//:Instrumentation",
    ],
)

# Run inside the test host (tools/test_host), which gives windows a scene.
# `resources:simulator:1` runs one simulator test at a time (.bazelrc).
ios_unit_test(
    name = "SwiftUITrackingTestsSimulator",
    size = "medium",
    minimum_os_version = "18.0",
    tags = [
        "debug-only",
        "resources:simulator:1",
    ],
    # The simulator is the Mac's alone, so elsewhere `bazel test //...` skips the bundle.
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    test_host = "//tools/test_host",
    visibility = ["//visibility:public"],
    deps = [":SwiftUITrackingTestsSimulatorLibrary"],
)
