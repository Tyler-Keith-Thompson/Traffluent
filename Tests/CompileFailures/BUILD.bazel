# Orders' and Checkout's sources again, each a shared library of its own that the program opens with
# dlopen. The link check doesn't reach across images, so the program runs; it exits 0 only when
# SegmentStore() and TrackingPlan() refuse the two events of one name at run time, naming both.
swift_link_test(
    name = "DuplicateEventNamesInLoadedLibraries",
    size = "small",
    loaded_libraries = {
        "Orders/OrderPlaced.swift": "Orders",
        "Checkout/OrderPlaced.swift": "Checkout",
    },
    main = "DuplicateEventNamesInLoadedLibraries.swift",
    plugins = {"//Sources/EventMacrosPlugin": "EventMacrosPlugin"},
    tags = ["debug-only"],
    deps = [
        "//Sources/EventMacros",
        "//Sources/Events",
        "//Sources/Persistence",
        "//Sources/TrackingPlans",
    ],
)
