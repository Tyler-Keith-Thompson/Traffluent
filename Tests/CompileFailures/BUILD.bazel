# Two modules linked into one program, each with an event named OrderPlaced: the linker refuses the
# program, naming the symbol of the name, the unique key @Event gives each event's record.
# Checkout's archive is read on demand, as a build that doesn't force archives in reads it: its
# record and its key's symbol come in together.
swift_link_test(
    name = "DuplicateEventNames",
    size = "small",
    expected_errors = [
        "duplicate symbol",
        "$linkerset_kind_65766E74_key_OrderPlaced",
    ],
    main = "DuplicateEventNames.swift",
    on_demand = [":Checkout"],
    tags = ["debug-only"],
    deps = [
        ":Checkout",
        ":Orders",
    ],
)

# The same name at another version clashes too: the key is the name alone.
swift_link_test(
    name = "DuplicateEventNamesAcrossVersions",
    size = "small",
    expected_errors = [
        "duplicate symbol",
        "$linkerset_kind_65766E74_key_OrderPlaced",
    ],
    main = "DuplicateEventNamesAcrossVersions.swift",
    tags = ["debug-only"],
    deps = [
        ":Fulfillment",
        ":Orders",
    ],
)

