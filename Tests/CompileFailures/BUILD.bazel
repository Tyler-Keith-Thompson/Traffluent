# Sources that must fail to compile, each checked for the errors it must report
# (tools/compile_failure_test.bzl). SwiftPM never sees this directory: no target holds it.

load("//tools:compile_failure_test.bzl", "swift_compile_failure_test")

# @Event on a struct with a stored property whose type isn't Codable: the error names the
# property, through the requirement the macro generates for each one.
swift_compile_failure_test(
    name = "EventNonCodableProperty",
    size = "small",
    src = "EventNonCodableProperty.swift",
    expected_errors = [
        "error: static method 'requireCodable(position:)' requires that 'Coordinate' conform to 'Decodable'",
    ],
    plugin = "//Sources/EventMacrosPlugin",
    plugin_module_name = "EventMacrosPlugin",
    tags = ["debug-only"],
    deps = ["//Sources/EventMacros"],
)

# The same struct with every property Codable compiles, so the check above fails for the
# property's type alone and not because this rule can't build the fixture.
swift_compile_failure_test(
    name = "EventCodablePropertiesControl",
    size = "small",
    src = "EventCodablePropertiesControl.swift",
    plugin = "//Sources/EventMacrosPlugin",
    plugin_module_name = "EventMacrosPlugin",
    tags = ["debug-only"],
    deps = ["//Sources/EventMacros"],
)

# @Constrained with a keyword that doesn't apply to the property's type: the error names the
# keyword, the property's type and the type it applies to.
swift_compile_failure_test(
    name = "EventConstraintWrongType",
    size = "small",
    src = "EventConstraintWrongType.swift",
    expected_errors = [
        "error: referencing static method 'minLength' on 'Constraint' requires the types 'Int' and 'String' be equivalent",
    ],
    plugin = "//Sources/EventMacrosPlugin",
    plugin_module_name = "EventMacrosPlugin",
    tags = ["debug-only"],
    deps = ["//Sources/EventMacros"],
)

# The same event with keywords that apply to each property's type compiles.
swift_compile_failure_test(
    name = "EventConstraintControl",
    size = "small",
    src = "EventConstraintControl.swift",
    plugin = "//Sources/EventMacrosPlugin",
    plugin_module_name = "EventMacrosPlugin",
    tags = ["debug-only"],
    deps = ["//Sources/EventMacros"],
)

# @Event on a struct holding a raw-value enum declared inside it that lists no Codable: the macro's
# error, at the enum's inheritance clause.
swift_compile_failure_test(
    name = "EventEnumNotCodable",
    size = "small",
    src = "EventEnumNotCodable.swift",
    expected_errors = [
        "error: @Event writes enum Reason as its raw value through Codable; add Codable to its inheritance clause",
    ],
    plugin = "//Sources/EventMacrosPlugin",
    plugin_module_name = "EventMacrosPlugin",
    tags = ["debug-only"],
    deps = ["//Sources/EventMacros"],
)

# A raw-value enum declared outside the event, which the macro can't see, that isn't Codable: the
# requirement's error names the property.
swift_compile_failure_test(
    name = "EventOutsideEnumNotCodable",
    size = "small",
    src = "EventOutsideEnumNotCodable.swift",
    expected_errors = [
        "error: static method 'requireCodable(priority:)' requires that 'Priority' conform to 'Decodable'",
    ],
    plugin = "//Sources/EventMacrosPlugin",
    plugin_module_name = "EventMacrosPlugin",
    tags = ["debug-only"],
    deps = ["//Sources/EventMacros"],
)

# The same enums, Codable, compile.
swift_compile_failure_test(
    name = "EventEnumControl",
    size = "small",
    src = "EventEnumControl.swift",
    plugin = "//Sources/EventMacrosPlugin",
    plugin_module_name = "EventMacrosPlugin",
    tags = ["debug-only"],
    deps = ["//Sources/EventMacros"],
)
