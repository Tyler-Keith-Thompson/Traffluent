# @Event on a struct declared in an extension of a generic type: the discovery record the macro
# adds is a static stored property, which a type nested in a generic one can't hold.
swift_compile_failure_test(
    name = "EventInGenericExtension",
    size = "small",
    src = "EventInGenericExtension.swift",
    expected_errors = [
        "error: static stored properties not supported in generic types",
    ],
    plugin = "//Sources/EventMacrosPlugin",
    plugin_module_name = "EventMacrosPlugin",
    tags = ["debug-only"],
    deps = ["//Sources/EventMacros"],
)

# The same event in an extension of a type that isn't generic compiles.
swift_compile_failure_test(
    name = "EventInExtensionControl",
    size = "small",
    src = "EventInExtensionControl.swift",
    plugin = "//Sources/EventMacrosPlugin",
    plugin_module_name = "EventMacrosPlugin",
    tags = ["debug-only"],
    deps = ["//Sources/EventMacros"],
)

# @Event on a struct declared in a function: the compiler's refusal of an extension macro on a local
# type is the only error. LinkerSets refuses the record there too; the macro writes none and leaves
# the refusal unsaid, rather than adding a second error.
swift_compile_failure_test(
    name = "EventInFunction",
    size = "small",
    src = "EventInFunction.swift",
    error_count = 1,
    expected_errors = [
        "error: local type cannot have attached extension macro",
    ],
    plugin = "//Sources/EventMacrosPlugin",
    plugin_module_name = "EventMacrosPlugin",
    tags = ["debug-only"],
    deps = ["//Sources/EventMacros"],
)

# Another package's top-level `JSON`, for the two checks below; only they reach it.
swift_library(
    name = "OtherJSON",
    testonly = True,
    srcs = ["OtherJSON/JSON.swift"],
    module_name = "OtherJSON",
)

# A file that imports Traffluent and another module's `JSON` names it unqualified: the umbrella
# leaves JSONValues out (NON_UMBRELLA_MODULES in scripts/modules.py), so it declares no `JSON`.
swift_compile_failure_test(
    name = "UmbrellaBesideOtherJSONControl",
    size = "small",
    src = "UmbrellaBesideOtherJSONControl.swift",
    tags = ["debug-only"],
    deps = [
        ":OtherJSON",
        "//Sources/Traffluent",
    ],
)

# The same file importing JSONValues as well fails with the ambiguity the umbrella would bring
# were it to re-export JSONValues, so the control passes because of the umbrella, not because the
# check can't see a second `JSON`.
swift_compile_failure_test(
    name = "UmbrellaBesideOtherJSONWithJSONValues",
    size = "small",
    src = "UmbrellaBesideOtherJSONWithJSONValues.swift",
    expected_errors = [
        "error: 'JSON' is ambiguous for type lookup in this context",
    ],
    tags = ["debug-only"],
    deps = [
        ":OtherJSON",
        "//Sources/JSONValues",
        "//Sources/Traffluent",
    ],
)

# A file that imports Traffluent alone declares @Event structs and compiles: their records name
# LinkerSetsRuntime.LinkerSetRecord, which the umbrella re-exports through EventMacros.
swift_compile_failure_test(
    name = "UmbrellaEventControl",
    size = "small",
    src = "UmbrellaEventControl.swift",
    plugin = "//Sources/EventMacrosPlugin",
    plugin_module_name = "EventMacrosPlugin",
    tags = ["debug-only"],
    deps = ["//Sources/Traffluent"],
)

# The same file naming LinkerSet and LinkerSetKind fails: EventMacros re-exports LinkerSetRecord
# alone, so the rest of LinkerSetsRuntime stays out of an adopter's scope.
swift_compile_failure_test(
    name = "UmbrellaHidesLinkerSet",
    size = "small",
    src = "UmbrellaHidesLinkerSet.swift",
    expected_errors = [
        "error: cannot find 'LinkerSetKind' in scope",
        "error: cannot find 'LinkerSet' in scope",
    ],
    plugin = "//Sources/EventMacrosPlugin",
    plugin_module_name = "EventMacrosPlugin",
    tags = ["debug-only"],
    deps = ["//Sources/Traffluent"],
)

# The googleAnalytics factories take an API secret, so they are compiled for macOS and Linux alone.
# This rule compiles for the host, not iOS, so it pins the server half: a declaration of each
# factory's very name and parameters, returning another type, makes a call ambiguous, which shows
# the library's are there. GoogleAnalyticsAvailabilityTests declares the same in the iOS simulator,
# where they compile because the library's are not.
swift_compile_failure_test(
    name = "GoogleAnalyticsFactoryOnServer",
    size = "small",
    src = "GoogleAnalyticsFactoryOnServer.swift",
    expected_errors = [
        "error: ambiguous use of 'googleAnalytics(measurementID:apiSecret:region:plan:transport:backoff:clock:now:)'",
        "error: ambiguous use of 'googleAnalytics(measurementID:apiSecret:region:plan:backoff:clock:now:)'",
    ],
    error_count = 2,
    tags = ["debug-only"],
    deps = [
        "//Sources/GoogleAnalyticsEncoding",
        "//Sources/HTTPDestinations",
        "//Sources/TrackingPlans",
    ],
)

# The same calls without the declarations compile: the library's factories are found on the host.
swift_compile_failure_test(
    name = "GoogleAnalyticsFactoryOnServerControl",
    size = "small",
    src = "GoogleAnalyticsFactoryOnServerControl.swift",
    tags = ["debug-only"],
    deps = [
        "//Sources/GoogleAnalyticsEncoding",
        "//Sources/HTTPDestinations",
        "//Sources/TrackingPlans",
    ],
)
