# GENERATED by scripts/modules.py — edit the table there, then run `just modules`.

load("@rules_apple//apple:ios.bzl", "ios_unit_test")
load("@rules_apple//apple:resources.bzl", "apple_resource_bundle")
load("//tools:swift_rules.bzl", "swift_library")

# The tests, run in the iOS simulator: the target depends on an iOS module (IOS_MODULES in
# scripts/modules.py) or is in SIMULATOR_TESTS. Tagged `debug-only`, like every target but the speed-reliant ones.
swift_library(
    name = "AutomaticScreenTrackingUIKitTestsLibrary",
    testonly = True,
    srcs = glob(["**/*.swift"]),
    data = [":Snapshots"],
    module_name = "AutomaticScreenTrackingUIKitTests",
    tags = ["debug-only"],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        "//Sources/AutomaticScreenTracking",
        "//Sources/SwiftUITracking",
        "//Sources/UIKitTracking",
        "//Sources/Events",
        "//Sources/Trackers",
    ],
)

# The snapshot references under __Snapshots__, which the tests read from their bundle
# (tools/snapshots; `just record-snapshots` rewrites them).
apple_resource_bundle(
    name = "Snapshots",
    testonly = True,
    structured_resources = glob(["__Snapshots__/**"], allow_empty = True),
    tags = ["debug-only"],
)

# `bazel test` and the generated Xcode project both run this bundle in the simulator, inside the
# test host (tools/test_host), which gives windows a scene. The runner drives xcodebuild
# directly; the default one fails a run that holds only Swift Testing tests.
# `resources:simulator:1` runs one simulator test at a time (.bazelrc).
ios_unit_test(
    name = "AutomaticScreenTrackingUIKitTests",
    size = "medium",
    minimum_os_version = "18.0",
    tags = [
        "debug-only",
        "resources:simulator:1",
    ],
    runner = "@rules_apple//apple/testing/default_runner:ios_xctestrun_ordered_runner",
    # The simulator is the Mac's alone, so elsewhere `bazel test //...` skips the bundle.
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    test_host = "//tools/test_host",
    visibility = ["//visibility:public"],
    deps = [":AutomaticScreenTrackingUIKitTestsLibrary"],
)
