load("@rules_apple//apple:ios.bzl", "ios_unit_test")
load("//tools:swift_rules.bzl", "swift_library")

# Hand-written, not generated, like the other Examples BUILD files: the checkout's automatic
# tracking, which only UIKit's window scenes do, checked in the iOS simulator. Package.swift has no
# target for this directory. `manual` keeps it out of `bazel test //...`, so `just test` never
# builds the examples; `just example-ios-test` runs it.
swift_library(
    name = "StoreViewsSimulatorTestsLibrary",
    testonly = True,
    # Tests are found through metadata the linker would otherwise drop, since nothing references
    # them by name.
    alwayslink = True,
    srcs = glob(["**/*.swift"]),
    module_name = "StoreViewsSimulatorTests",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        "//Examples/Sources/StoreEvents",
        "//Examples/Sources/StoreModel",
        "//Examples/Sources/StoreViews",
        "//Sources/AutomaticControlTracking",
        "//Sources/AutomaticScreenTracking",
        "//Sources/Events",
        "//Sources/SwiftUITracking",
        "//Sources/Trackers",
    ],
)

# Run inside the test host (tools/test_host), which gives windows a scene.
# `resources:simulator:1` runs one simulator test at a time (.bazelrc).
ios_unit_test(
    name = "StoreViewsSimulatorTests",
    size = "medium",
    minimum_os_version = "18.0",
    tags = [
        "manual",
        "resources:simulator:1",
    ],
    test_host = "//tools/test_host",
    deps = [":StoreViewsSimulatorTestsLibrary"],
)
