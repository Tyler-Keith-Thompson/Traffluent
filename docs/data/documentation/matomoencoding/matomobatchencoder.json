"text":"request’s included.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","role":"symbol","type":"topic","title":"batchLimit","url":"\/documentation\/matomoencoding\/matomobatchencoder\/batchlimit"},"doc://MatomoEncoding/s16SendableMetatypeP":{"identifier":"doc:\/\/MatomoEncoding\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/requests(for:)":{"url":"\/documentation\/matomoencoding\/matomobatchencoder\/requests(for:)","abstract":[{"code":"batch","type":"codeVoice"},{"text":" as the bulk requests Matomo takes, each within the encoder’s limit, with the records","type":"text"},{"text":" ","type":"text"},{"text":"left out of them.","type":"text"}],"role":"symbol","title":"requests(for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","kind":"typeIdentifier","text":"BatchRequests"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14MatomoEncoding0aB5ErrorO","kind":"typeIdentifier","text":"MatomoEncodingError"},{"kind":"text","text":">"}],"kind":"symbol","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)","type":"topic"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoDimensions/unmappedProperties(in:)":{"abstract":[{"type":"text","text":"The properties of "},{"code":"plan","type":"codeVoice"},{"type":"text","text":"’s events that no mapping names, and that Matomo is never sent."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"unm