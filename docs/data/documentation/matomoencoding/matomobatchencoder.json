ext","text":" "},{"type":"text","text":"each event in "},{"type":"codeVoice","code":"category"},{"type":"text","text":" and each property "},{"type":"codeVoice","code":"dimensions"},{"type":"text","text":" maps as its custom dimension, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"type":"text","text":" is "},{"code":"URLSessionTransport","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Encoding","type":"codeVoice"},{"type":"text","text":" is "},{"code":"MatomoBatchEncoder","type":"codeVoice"},{"type":"text","text":"."}]},"type":"topic","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/HTTPDestinations\/HTTPDestination\/matomo(url:siteID:dimensions:category:plan:backoff:clock:now:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"matomo","kind":"identifier"},{"text":"(","kind":"text"},{"text":"url","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","preciseIdentifier":"s:20FoundationEssentials3URLV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"siteID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"dimensions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MatomoDimensions","preciseIdentifier":"s:14MatomoEncoding0A10DimensionsV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"category","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"MatomoSetupError","preciseIdentifier":"s:14MatomoEncoding0A10SetupErrorO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"URLSessionTransport","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"MatomoBatchEncoder","preciseIdentifier":"s:14MatomoEncoding0A12BatchEncoderV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/matomoencoding\/httpdestinations\/httpdestination\/matomo(url:siteid:dimensions:category:plan:backoff:clock:now:)"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MatomoBatchEncoder"}],"kind":