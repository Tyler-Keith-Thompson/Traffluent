/MatomoBatchEncoder\/outcome(of:for:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","kind":"typeIdentifier"}],"role":"symbol","url":"\/documentation\/matomoencoding\/matomobatchencoder\/outcome(of:for:)","title":"outcome(of:for:)","abstract":[{"type":"text","text":"What Matomo’s 2xx answer to "},{"type":"codeVoice","code":"request"},{"type":"text","text":" means: transient when Matomo counted fewer of its"},{"type":"text","text":" "},{"type":"text","text":"tracking requests than were sent, rejected when it refused every one it counted, and"},{"type":"text","text":" "},{"type":"text","text":"delivered otherwise."}]},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/batchLimit":{"kind":"symbol","url":"\/documentation\/matomoencoding\/matomobatchencoder\/batchlimit","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","role":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The limits of one request: 20 tracking requests and 1,000,000 bytes of body, a tracking"},{"type":"text","text":" "},{"type":"text","text":"request’s included."}],"title":"batchLimit"},"doc://MatomoEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/MatomoEncoding\/s16SendableMetatypeP","type":"unresolvable"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder":{"type":"topic","kind":"symbol","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoBatchEncoder","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"MatomoBatchEncoder","kind":"identifier"}],"url":"\/documentation\/matomoencoding\/matomobatchencoder","title":"MatomoBatchEncoder","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Matomo’s bulk tracking API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to a Matomo installation’s "},{"type":"codeVoice","code":"POST \/matomo.php"},{"type":"text","text":"."}]},"doc://MatomoEncoding/documentation/MatomoEncoding":{"kind":"symbol","type":"topic","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","url":"\/documentation\/matomoencoding","role":"collection","title":"MatomoEncoding","abstract":[{"type":"text","text":"Send records to a Matomo installation as events, through its bulk tracking API."}]},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/transientStatuses":{"kind":"symbol","url":"\/documentation\/matomoencoding\/matomobatchencoder\/transientstatuses","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/transientStatuses","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},