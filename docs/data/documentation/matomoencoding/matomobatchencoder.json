xt":" and each property ","type":"text"},{"code":"dimensions","type":"codeVoice"},{"text":" maps as its custom dimension, with","type":"text"},{"text":" ","type":"text"},{"code":"URLSession.shared","type":"codeVoice"},{"text":", retrying a send that fails for now with the waits of ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"matomo","kind":"identifier"},{"text":"(","kind":"text"},{"text":"url","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"text":", ","kind":"text"},{"text":"siteID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"dimensions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MatomoDimensions","kind":"typeIdentifier","preciseIdentifier":"s:14MatomoEncoding0A10DimensionsV"},{"text":", ","kind":"text"},{"text":"category","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Co