{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MatomoBatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/HTTPDestinations\/HTTPDestination\/matomo(url:siteID:dimensions:category:plan:backoff:clock:now:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}]},{"code":["let matomo = try HTTPDestination.matomo(","    url: url,  \/\/ where Matomo is installed: https:\/\/analytics.example.com","    siteID: 3,  \/\/ the app's site in Matomo","    dimensions: [\"plan\": 1, \"seats\": 2],  \/\/ custom dimensions made in Matomo","    category: \"Shop\",  \/\/ each event's category","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", "},{"type":"codeVoice","code":"{\"requests\":[…]}"},{"type":"text","text":", whose"},{"type":"text","text":" "},{"type":"codeVoice","code":"requests"},{"type":"text","text":" are one tracking request per record, oldest first, as Matomo asks for them: each a"},{"type":"text","text":" "},{"type":"text","text":"string, "},{"type":"codeVoice","code":"?"},{"type":"text","text":" and the request’s query, every value percent-encoded but for RFC 3986’s unreserved"},{"type":"text","text":" "},{"type":"text","text":"characters. Each request is a Matomo event, with these parameters in this order:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Parameter","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"idsite","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The site ID the encoder is made with","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"rec","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"1"},{"type":"text","text":", without which Matomo records nothing"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"apiv","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"1","type":"codeVoice"},{"text":", the Tracking API’s version","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"_id"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The visitor: the last 64 bits of the record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as 16 lowercase hexadecimal digits; of the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"cdt"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked, in whole seconds since 1970, rounded down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ca"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"1"},{"type":"text","text":": the request is an event, not a page view, should Matomo’s Events plugin be turned off"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"e_c"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The category the encoder is made with"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"e_a"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":", as it is","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"lang","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s locale’s BCP 47 identifier, "},{"type":"codeVoice","code":"en-US"},{"type":"text","text":", when its context has a "},{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"dimension<ID>"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Each mapped property’s value, by the dimension’s ID, from lowest to highest","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent. Matomo counts a visitor per "},{"type":"codeVoice","code":"_id"},{"type":"text","text":", so its visitors are"},{"type":"text","text":" "},{"type":"text","text":"sessions, each a new visitor of one visit. A record with no session (one tracked by a tracker"},{"type":"text","text":" "},{"type":"text","text":"without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is its own visitor, linked to nothing. A record a store recovers"},{"type":"text","text":" "},{"type":"text","text":"after a relaunch keeps its session, so it goes out under the "},{"type":"codeVoice","code":"_id"},{"type":"text","text":" of its first send. No "},{"type":"codeVoice","code":"uid"},{"type":"text","text":", "},{"type":"codeVoice","code":"cid"},{"type":"text","text":", "},{"type":"codeVoice","code":"token_auth"},{"type":"text","text":", "},{"type":"codeVoice","code":"cip"},{"type":"text","text":" or device"},{"type":"text","text":" "},{"type":"text","text":"identifier is sent, and nothing of the record’s context but its locale, nor its trace context."}]},{"type":"paragraph","inlineContent":[{"text":"A property reaches Matomo only as the custom dimension ","type":"text"},{"code":"dimensions","type":"codeVoice"},{"text":" maps it to, read through","type":"text"},{"text":" ","type":"text"},{"text":"the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads it: a string as it is, a number as JSON","type":"text"},{"text":" ","type":"text"},{"text":"writes it, a Boolean as ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and an array or object as its JSON. A ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" is left","type":"text"},{"text":" ","type":"text"},{"text":"out. A ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is","type":"text"},{"text":" ","type":"text"},{"text":"left out, and an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":". Every other property is left out, and the","type":"text"},{"text":" ","type":"text"},{"text":"encoder logs a notice once, when it is made, for each event of the plan with properties no","type":"text"},{"text":" ","type":"text"},{"text":"dimension is mapped to (","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoDimensions\/unmappedProperties(in:)","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write, or that Matomo would refuse or store other than it is, is","type":"text"},{"text":" ","type":"text"},{"text":"left out of the request, and the batch’s other records are sent: one whose event and version","type":"text"},{"text":" ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name Matomo would empty or cut short, one whose event","type":"text"},{"text":" ","type":"text"},{"text":"isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp has no whole seconds","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"Int64","type":"codeVoice"},{"text":" or is more than 23 hours before or after the batch is encoded, one with a dimension’s","type":"text"},{"text":" ","type":"text"},{"text":"value longer than Matomo keeps, and one whose request is over 1,000,000 bytes","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError","isActive":true},{"text":"). ","type":"text"},{"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)","isActive":true},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each request’s ","type":"text"},{"code":"EncodedRequest\/deadline","type":"codeVoice"},{"text":" is 23 hours after its oldest record was tracked, so","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops a request still being retried by then, every record of it, the younger","type":"text"},{"text":" ","type":"text"},{"text":"ones included, and reports it as ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":", rather","type":"text"},{"text":" ","type":"text"},{"text":"than send it to a Matomo that would answer 200 and store nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. Matomo answers 200 to a bulk request it reads, counting the tracking requests"},{"type":"text","text":" "},{"type":"text","text":"it refuses as "},{"type":"codeVoice","code":"invalid"},{"type":"text","text":" in its answer without storing them; 400 to a body it can’t read, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops and reports with every record of the request; and 500 when its database"},{"type":"text","text":" "},{"type":"text","text":"fails, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries. A 200 that says Matomo tracked none of the request’s"},{"type":"text","text":" "},{"type":"text","text":"tracking requests is rejected ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/outcome(of:for:)"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops and reports it"},{"type":"text","text":" "},{"type":"text","text":"too; one that refused only some isn’t, as its answer doesn’t say which. It doesn’t remove duplicates, so a record sent again is"},{"type":"text","text":" "},{"type":"text","text":"counted again. The bytes are the same for the same records, time and configuration on every run"},{"type":"text","text":" "},{"type":"text","text":"and platform."}]}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"text":" of Matomo’s bulk tracking API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to a Matomo installation’s ","type":"text"},{"type":"codeVoice","code":"POST \/matomo.php"},{"text":".","type":"text"}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/MatomoEncoding\/s8SendableP","doc:\/\/MatomoEncoding\/s16SendableMetatypeP"],"kind":"relationships"}],"identifier":{"url":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding"]]},"sections":[],"metadata":{"title":"MatomoBatchEncoder","roleHeading":"Structure","symbolKind":"struct","externalID":"s:14MatomoEncoding0A12BatchEncoderV","remoteSource":{"fileName":"MatomoBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MatomoEncoding\/MatomoBatchEncoder.swift#L82"},"role":"symbol","modules":[{"name":"MatomoEncoding"}],"navigatorTitle":[{"text":"MatomoBatchEncoder","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MatomoBatchEncoder"}]},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/init(siteID:dimensions:category:plan:limit:now:)"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/requests(for:)"],"generated":true},{"anchor":"Type-Aliases","title":"Type Aliases","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/Failure"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/transientStatuses"],"generated":true},{"anchor":"Type-Methods","title":"Type Methods","identifiers":["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/outcome(of:for:)"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/matomoencoding\/matomobatchencoder"]}],"references":{"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/transientStatuses":{"abstract":[{"type":"text","text":"No status beyond the 408, 429 and 5xx that "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" retries for every encoder."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientStatuses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","text":"TransientStatus"},{"kind":"text","text":">"}],"url":"\/documentation\/matomoencoding\/matomobatchencoder\/transientstatuses","role":"symbol","kind":"symbol","title":"transientStatuses","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/transientStatuses","type":"topic"},"doc://MatomoEncoding/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/MatomoEncoding\/s16SendableMetatypeP"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/Failure":{"role":"symbol","navigatorTitle":[{"text":"Failure","kind":"identifier"}],"kind":"symbol","type":"topic","abstra