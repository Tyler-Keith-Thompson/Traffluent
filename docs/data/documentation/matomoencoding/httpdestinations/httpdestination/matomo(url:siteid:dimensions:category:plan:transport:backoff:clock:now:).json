coding0A12BatchEncoderV"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The URL Matomo is installed at ("},{"type":"codeVoice","code":"https:\/\/analytics.example.com"},{"type":"text","text":"), a path included"},{"type":"text","text":" "},{"type":"text","text":"where it is served under one ("},{"type":"codeVoice","code":"https:\/\/example.com\/matomo\/"},{"type":"text","text":"). Not the endpoint: the"},{"type":"text","text":" "},{"type":"text","text":"destination appends "},{"type":"codeVoice","code":"matomo.php"},{"type":"text","text":" itself."}],"type":"paragraph"}],"name":"url"},{"content":[{"inlineContent":[{"text":"The site’s ID in Matomo, from its Websites settings.","type":"text"}],"type":"paragraph"}],"name":"siteID"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The custom dimension each property is sent as, by the property’s name, as"},{"type":"text","text":" "},{"type":"text","text":"made in Matomo’s Custom Dimensions settings; a property it doesn’t name is never sent."}]}],"name":"dimensions"},{"content":[{"inlineContent":[{"type":"text","text":"Every event’s category, "},{"type":"codeVoice","code":"e_c"},{"type":"text","text":", such as the app’s name. Each event’s action,"},{"type":"text","text":" "},{"type":"codeVoice","code":"e_a"},{"type":"text","text":", is its name."}],"type":"paragraph"}],"name":"category"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}]}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}],"name":"transport"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}]}],"