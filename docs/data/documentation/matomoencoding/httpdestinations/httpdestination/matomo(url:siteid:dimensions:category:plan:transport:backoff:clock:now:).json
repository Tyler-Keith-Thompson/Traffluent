neContent":[{"text":"The destination posts bulk tracking requests to the installation’s ","type":"text"},{"code":"matomo.php","type":"codeVoice"},{"text":", encoded by","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","type":"reference"},{"text":" within ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/batchLimit","type":"reference"},{"text":", and sends no trace context","type":"text"},{"text":" ","type":"text"},{"text":"in its header fields. It retries no response, a 5xx, 408 or 429, and drops and reports any","type":"text"},{"text":" ","type":"text"},{"text":"other status, such as 400 for a body Matomo can’t read.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The destination sends no "},{"code":"token_auth","type":"codeVoice"},{"type":"text","text":", and takes none: a token is a secret, and any secret"},{"type":"text","text":" "},{"type":"text","text":"an app holds is public. Matomo takes events from anyone who can reach it, so the destination"},{"type":"text","text":" "},{"type":"text","text":"builds on every platform. Without a token, Matomo takes no event tracked more than a day"},{"type":"text","text":" "},{"type":"text","text":"before it arrives, so the encoder leaves out a record tracked more than 23 hours before it"},{"type":"text","text":" "},{"type":"text","text":"is encoded ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoEncodingError\/timestampOutsideWindow"},{"type":"text","text":"). A request is encoded once and"},{"type":"text","text":" "},{"type":"text","text":"retried as it is, so one still undelivered 23 hours after its oldest record was tracked, by"},{"type":"text","text":" "},{"type":"text","text":"the time "},{"code":"now","type":"codeVoice"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"type":"text","text":", rather than reach Matomo too late to"},{"type":"text","text":" "},{"type":"text","text":"be stored."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidURL","isActive":true,"type":"reference"},{"text":" for a URL that isn’t ","type":"text"},{"code":"https","type":"codeVoice"},{"text":", has no host name,","type":"text"},{"text":" ","type":"text"},{"text":"has a user name or password, a query or fragment, or a path ending in a ","type":"text"},{"code":".php","type":"codeVoice"},{"text":" file, in","type":"text"},{"text":" ","type":"text"},{"text":"any case; ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidSiteID","isActive":true,"type":"reference"},{"text":" for a site ID below 1;","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidCategory","isActive":true,"type":"reference"},{"text":" for a category Matomo would empty or cut short; and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/invalidDimension(property:dimension:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/duplicateProperty(_:)","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoSetupError\/unknownProperty(_:)","isActive":true,"type":"reference"},{"text":",","type":"text