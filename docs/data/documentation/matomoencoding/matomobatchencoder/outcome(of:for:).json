{"abstract":[{"type":"text","text":"What Matomo’s 2xx answer to "},{"type":"codeVoice","code":"request"},{"type":"text","text":" means: transient when Matomo counted fewer of its"},{"type":"text","text":" "},{"type":"text","text":"tracking requests than were sent, rejected when it refused every one it counted, and"},{"type":"text","text":" "},{"type":"text","text":"delivered otherwise."}],"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder"]]},"metadata":{"externalID":"s:14MatomoEncoding0A12BatchEncoderV7outcome2of3for16HTTPDestinations15ResponseOutcomeOAG013HTTPTransportI0V_AG14EncodedRequestVtFZ","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MatomoEncoding\/MatomoBatchEncoder.swift#L116","fileName":"MatomoBatchEncoder.swift"},"title":"outcome(of:for:)","role":"symbol","roleHeading":"Type Method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","text":"HTTPTransportResponse","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","text":"EncodedRequest","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","text":"ResponseOutcome","kind":"typeIdentifier"}],"modules":[{"name":"MatomoEncoding"}],"symbolKind":"method"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"response","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","text":"HTTPTransportResponse","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"request","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","text":"EncodedRequest","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","text":"ResponseOutcome","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"response","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The 2xx answer."}]}]},{"name":"request","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The request it answers, a tracking request for each of its records."}]}]}]},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Whether Matomo stored the request’s tracking requests, as far as its answer says."}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Matomo answers a bulk request it reads with 200 and ","type":"text"},{"code":"{\"status\": \"success\", \"tracked\": n, \"invalid\": m}","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"tracked","type":"codeVoice"},{"tex