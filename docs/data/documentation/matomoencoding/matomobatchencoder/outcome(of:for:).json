{"sections":[],"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","abstract":[{"type":"text","text":"What Matomo’s 2xx answer to "},{"type":"codeVoice","code":"request"},{"type":"text","text":" means: transient when Matomo counted fewer of its"},{"type":"text","text":" "},{"type":"text","text":"tracking requests than were sent, rejected when it refused every one it counted, and"},{"type":"text","text":" "},{"type":"text","text":"delivered otherwise."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"response"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse","text":"HTTPTransportResponse"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":" "},{"kind":"internalParam","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","text":"EncodedRequest"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome","text":"ResponseOutcome"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The 2xx answer.","type":"text"}],"ty