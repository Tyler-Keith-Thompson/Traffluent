text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"response","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"HTTPTransportResponse","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"request","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"EncodedRequest","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ResponseOutcome","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The 2xx answer."}]}],"name":"response"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The request it answers, a tracking request for each of its records."}]}],"name":"request"}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"Whether Matomo stored the request’s tracking requests, as far as its answer says."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Matomo answers a bulk request it reads with 200 and ","type":"text"},{"type":"codeVoice","code":"{\"status\": \"success\", \"tracked\": n, \"invalid\": m}"},{"text":". When ","type":"text"},{"type":"codeVoice","code":"tracked"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"invalid"},{"text":" add up to fewer than the request’s tracking","type":"text"},{"text":" ","type":"text"},{"text":"requests, or are both 0, Matomo skipped some without saying so, as it does after a database","type":"text"},{"text":" ","type":"text"},{"text":"lock wait timeout, and the answer is ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)"},{"text":":","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends the request again until its deadline, 23 hours after its oldest","type":"text"},{"text":" ","type":"text"},{"text":"record, and Matomo, which removes no duplicates, counts the ones it tracked again. When it","type":"text"},{"text":" ","type":"text"},{"text":"tracked none and refused some, as for a site ID of no site, the answer is","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)"},{"text":", so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" drops the","type":"text"},{"text":" ","type":"text"},{"text":"request and reports it. When it tracked some and refused others, the answer says how many","type":"text"},{"text":" ","type":"text"},{"text":"but not which, so the request is delivered, with a notice logged. A body that isn’t such an","type":"text"},{"text":" ","type":"text"},{"text":"answer, an empty one or one with a negative count included, is delivered. That includes","type":"text"},{"text":" ","type":"text"},{"text":"the image a server with the QueuedTracking plugin’s queue on sends for every bulk request,","type":"text"},{"text":" ","type":"text"},{"text":"before it checks any tracking request: such a server stores the valid ones later and drops","type":"text"},{"text":" ","type":"text"},{"text":"the others, a site ID of no site included, without a report.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/matomoencoding\/matomobatchencoder\/outcome(of:for:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder"]]},"references":{"doc://MatomoEncoding/documentation/MatomoEncoding":{"role":"collection","type":"topic","abstract":[{"type":"text","text":"Send records to a Matomo installation as events, through its bulk tracking API."}],"kind":"symbol","title":"MatomoEncoding","url":"\/documentation\/matomoencoding","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/outcome(of:for:)":{"required":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","url":"\/documentation\/httpdestinations\/batchencoder\/outcome(of:for:)","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","text":"HTTPTransportResponse","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","text":"EncodedRequest","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","text":"ResponseOutcome","kind":"typeIdentifier"}],"title":"outcome(of:for:)","kind":"symbol","abstract":[{"text":"What the successful (2xx) answer ","type":"text"},{"code":"response","type":"codeVoice"},{"text":" to ","