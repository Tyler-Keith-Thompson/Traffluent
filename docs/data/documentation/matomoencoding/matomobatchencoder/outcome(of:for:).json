{"abstract":[{"text":"What Matomo’s 2xx answer to ","type":"text"},{"type":"codeVoice","code":"request"},{"text":" means: transient when Matomo counted fewer of its","type":"text"},{"text":" ","type":"text"},{"text":"tracking requests than were sent, rejected when it refused every one it counted, and","type":"text"},{"text":" ","type":"text"},{"text":"delivered otherwise.","type":"text"}],"metadata":{"externalID":"s:14MatomoEncoding0A12BatchEncoderV7outcome2of3for16HTTPDestinations15ResponseOutcomeOAG013HTTPTransportI0V_AG14EncodedRequestVtFZ","role":"symbol","roleHeading":"Type Method","title":"outcome(of:for:)","modules":[{"name":"MatomoEncoding"}],"symbolKind":"method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","text":"HTTPTransportResponse","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","text":"EncodedRequest","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","text":"ResponseOutcome","kind":"typeIdentifier"}],"remoteSource":{"fileName":"MatomoBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MatomoEncoding\/MatomoBatchEncoder.swift#L128"}},"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"response"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse","kind":"typeIdentifier","text":"HTTPTransportResponse"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":" "},{"kind":"internalParam","text":"request"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","kind":"typeIdentifier","text":"EncodedRequest"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome","kind":"typeIdentifier","text":"ResponseOutcome"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"response","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The 2xx answer."}]}]},{"name":"request","content":[{"type":"paragraph","inlineContent":[{"text":"The request it answers, a tracking request for each of its records.","type":"text"}]}]}]},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"Whether Matomo stored the request’s tracking requests, as far as its answer says.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Matomo answers a bulk request it reads with 200 and "},{"type":"codeVoice","code":"{\"status\": \"success\", \"tracked\": n, \"invalid\": m}"},{"type":"text","text":". When "},{"type":"codeVoice","code":"tracked"},{"type":"text","text":" and "},{"type":"codeVoice","code":"invalid"},{"type":"text","text":" add up to fewer than the request’s tracking"},{"type":"text","text":" "},{"type":"text","text":"requests, or are both 0, Matomo skipped some without saying so, as it does after a database"},{"type":"text","text":" "},{"type":"text","text":"lock wait timeout, and the answer is "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)","isActive":true},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends the request again until its deadline, 23 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record, and Matomo, which removes no duplicates, counts the ones it tracked again. When it"},{"type":"text","text":" "},{"type":"text","text":"tracked none and refused some, as for a site ID of no site, the answer is"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)","isActive":true},{"type":"text","text":", so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops the"},{"type":"text","text":" "},{"type":"text","text":"request and reports it. When it tracked some and refused others, the answer says how many"},{"type":"text","text":" "},{"type":"text","text":"but not which, so the request is delivered, with a notice logged. A body that isn’t such an"},{"type":"text","text":" "},{"type":"text","text":"answer, an empty one or one with a negative count included, is delivered. That includes"},{"type":"text","text":" "},{"type":"text","text":"the image a server with the QueuedTracking plugin’s queue on sends for every bulk request,"},{"type":"text","text":" "},{"type":"text","text":"before it checks any tracking request: such a server stores the valid ones later and drops"},{"type":"text","text":" "},{"type":"text","text":"the others, a site ID of no site included, without a report."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/matomoencoding\/matomobatchencoder\/outcome(of:for:)"]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/outcome(of:for:)"},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransportResponse":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPTransportResponse"}],"abstract":[{"type":"text","text":"What an "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","isActive":true},{"type":"text","text":" received for a request: the response’s status and header fields, and"},{"type":"text","text":" "},{"type":"text","text":"its body."}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse","navigatorTitle":[{"kind":"identifier","text":"HTTPTransportResponse"}],"role":"symbol","type":"topic","title":"HTTPTransportResponse","url":"\/documentation\/httpdestinations\/httptransportresponse"},"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder/outcome(of:for:)":{"abstract":[{"text":"What Matomo’s 2xx answer to ","type":"text"},{"code":"request","type":"codeVoice"},{"text":" means: transient when Matomo counted fewer of its","type":"text"},{"text":" ","type":"text"},{"text":"tracking requests than were sent, rejected when it refused every one it counted, and","type":"text"},{"text":" ","type":"text"},{"text":"delivered otherwise.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalPa