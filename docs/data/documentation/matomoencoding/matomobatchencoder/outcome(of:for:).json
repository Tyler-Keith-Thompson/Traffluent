{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"response"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","text":"HTTPTransportResponse"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":" "},{"kind":"internalParam","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","text":"EncodedRequest"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","text":"ResponseOutcome"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The 2xx answer."}],"type":"paragraph"}],"name":"response"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The request it answers, a tracking request for each of its records.","type":"text"}]}],"name":"request"}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"Whether Matomo stored the request’s tracking requests, as far as its answer says."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Matomo answers a bulk request it reads with 200 and ","type":"text"},{"type":"codeVoice","code":"{\"status\": \"success\", \"tracked\": n, \"invalid\": m}"},{"text":". When ","type":"text"},{"type":"codeVoice","code":"tracked"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"invalid"},{"text":" add up to fewer than the request’s tracking","type":"text"},{"text":" ","type":"text"},{"text":"requests, or are both 0, Matomo skipped some without saying so, as it does after a database","type":"text"},{"text":" ","type":"text"},{"text":"lock wait timeout, and the answer is ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)","isActive":true,"type":"reference"},{"text":":","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends the request again until its deadline, 23 hours after its oldest","type":"text"},{"text":" ","type":"text"},{"text":"record, and Matomo, which removes no duplicates, counts the ones it tracked again. When it","type":"text"},{"text":" ","type":"text"},{"text":"tracked none and refused some, as for a site ID of no site, the answer is","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)","isActive":true,"type":"reference"},{"text":", so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" drops the","type":"text"},{"text":" ","type":"text"},{"text":"request and reports it. When it tracked some and refused others, the answer says how many","type":"text"},{"text":" ","type":"text"},{"text":"but not which, so the request is delivered, with a notice logged. A body that isn’t such an","type":"text"},{"text":" ","type":"text"},{"text":"answer, an empty one or one with a negative count included, is delivered. That includes","type":"text"},{"text":" ","type":"text"},{"text":"the image a server with the QueuedTracking plugin’s queue on sends for every bulk request,","type":"text"},{"text":" ","type":"text"},{"text":"before it checks any tracking request: such a server stores the valid ones later and drops","type":"text"},{"text":" ","type":"text"},{"text":"the others, a site ID of no site included, without a report.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder"]]},"metadata":{"modules":[{"name":"MatomoEncoding"}],"externalID":"s:14MatomoEncoding0A12BatchEncoderV7outcome2of3for16HTTPDestinations15ResponseOutcomeOAG013HTTPTransportI0V_AG14EncodedRequestVtFZ","role":"symbol","remoteSource":{"fileName":"MatomoBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MatomoEncoding\/MatomoBatchEncoder.swift#L128"},"roleHeading":"Type Method","title":"outcome(of:for:)","symbolKind":"method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"HTTPTransportResponse","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EncodedRequest","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV"},{"text":") -> ","kind":"text"},{"text":"ResponseOutcome","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/matomoencoding\/matomobatchencoder\/outcome(of:for:)"]}],"abstract":[{"type":"text","text":"What Matomo’s 2xx answer to "},{"code":"request","type":"codeVoice"},{"type":"text","text":" means: transient when Matomo counted fewer of its"},{"type":"text","text":" "},{"type":"text","text":"tracking requests than were sent, rejected when it refused every one it counted, and"},{"type":"text","text":" "},{"type":"text","text":"delivered otherwise."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder\/outcome(of:for:)"},"references":{"doc://MatomoEncoding/documentation/MatomoEncoding/MatomoBatchEncoder":{"type":"topic","kind":"symbol","identifier":"doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatomoBatchEncoder","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"MatomoBatchEncoder","kind":"identifier"}],"url":"\/documentation\/matomoencoding\/matomobatchencoder","title":"MatomoBatchEncoder","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Matomo’s bulk tracking API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to a Matomo installation’s "},{"type":"codeVoice","code":"POST \/matomo.php"},{"type":"text","text":"."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/ResponseOutcome/rejected(reason:)":{"title":"ResponseOutcome.rejected(reason:)","url":"\/documentation\/httpdestinations\/responseoutcome\/rejected(reason:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejected"},{"kind":"text","text":"("},{"kind":"externalParam","text":"reason"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}],"role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)","kind":"symbol","abstract":[{"type":"text","text":"The vendor stored none of the request’s records, and wouldn’t if it were sent again, for"},{"type":"text","text":" "},{"type":"codeVoice","code":"reason"},{"type":"text","text":", the vendor’s own words where its body has them: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" drops the"},{"type":"text","text":" "},{"type":"text","text":"request and reports it as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)"},{"type":"text","text":"."}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/ResponseOutcome":{"type":"topic","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResponseOutcome"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ResponseOutcome"}],"url":"\/documentation\/httpdestinations\/responseoutcome","title":"ResponseOutcome","abstract":[{"type":"text","text":"What a successful (2xx) answer to a request means, as its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" reads the answer’s"},{"type":"text","text":" "},{"type":"text","text":"body ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)"},{"type":"text","text":")."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/ResponseOutcome/transient(reason:)":{"title":"ResponseOutcome.transient(reason:)","url":"\/documentation\/httpdestinations\/responseoutcome\/transient(reason:)","fragments":[{"text":