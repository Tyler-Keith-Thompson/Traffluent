{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding","doc:\/\/MatomoEncoding\/documentation\/MatomoEncoding\/MatomoBatchEncoder"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"response","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"HTTPTransportResponse","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"request","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"EncodedRequest","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV"},{"text":") -> ","kind":"text"},{"text":"ResponseOutcome","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The 2xx answer.","type":"text"}]}],"name":"response"},{"content":[{"inlineContent":[{"type":"text","text":"The request it answers, a tracking request for each of its records."}],"type":"paragraph"}],"name":"request"}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether Matomo stored the request’s tracking requests, as far as its answer says."}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Matomo answers a bulk request it reads with 200 and "},{"code":"{\"status\": \"success\", \"tracked\": n, \"invalid\": m}","type":"codeVoice"},{"type":"text","text":". When "},{"code":"tracked","type":"codeVoice"},{"type":"text","text":" and "},{"code":"invalid","type":"codeVoice"},{"type":"text","text":" add up to fewer than the request’s tracking"},{"type":"text","text":" "},{"type":"text","text":"requests, or are both 0, Matomo skipped some without saying so, as it does after a database"},{"type":"text","text":" "},{"type":"text","text":"lock wait timeout, and the answer is "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)"},{"type":"text","text":":"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends the request again until its deadline, 23 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record, and Matomo, which removes no duplicates, counts the ones it tracked again. When it"},{"type":"text","text":" "},{"type":"text","text":"tracked none and refused some, as for a site ID of no site, the answer is"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)"},{"type":"text","text":", so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" drops the"},{"type":"text","text":" "},{"type":"text","text":"request and reports it. When it tracked some and refused others, the answer says how many"},{"type":"text","text":" "},{"type":"text","text":"but not which, so the request is delivered, with a notice logged. A body that isn’t such an"},{"type":"text","text":" "},{"type":"text","text":"answer, an empty one or one with a negative count included, is delivered. That includes"},{"type":"text","text":" "},{"type":"text","text":"the image a server with the QueuedTracking plugin’s queue on sends for every bulk request,"},{"type":"text","text":" "},{"type":"text","text":"before it checks any tracking request: such a server stores the valid ones later and drops"},{"type":"text","text":" "},{"type":"text","text":"the others, a site ID of no site included, without a report."}]}]}],"metadata":{"remoteSource":{"fileName":"MatomoBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MatomoEncoding\/MatomoBatchEncoder.swift#L128"},"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","kind":"typeIdentifier"}],"roleHeading":"Type Method","modules":[{"name":"MatomoEncoding"}],"role":"symbol","externalID":"s:14MatomoEncoding0A12BatchEncoderV7outcome2of3for16HTTPDestinations15ResponseOutcomeOAG013HTTPTransportI0V_AG14EncodedRequestVtFZ","symbolKind":"method","title":"outcome(of:for:)"},"abstract":[{"type":"text","text":"What Matomo’s 2xx answer to "},{"type":"codeVoice","code":"request"},{"type":"text","text":" means: transient when Matomo counted fewer of its"},{"type":"text","text":" "},{"type":"text","text":"tracking requests than were sent, 