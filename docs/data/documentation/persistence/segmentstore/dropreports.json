{"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"]]},"metadata":{"title":"dropReports","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L169","fileName":"SegmentStore.swift"},"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"DropReport","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence10DropReportO"},{"text":">","kind":"text"}],"symbolKind":"property","role":"symbol","modules":[{"name":"Persistence"}],"externalID":"s:11Persistence12SegmentStoreV11dropReports11AsyncQueues0F5QueueVyAA10DropReportOGvp","roleHeading":"Instance Property"},"kind":"symbol","abstract":[{"text":"A report of each drop, in the order they happen, from recovery onwards.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue"},{"text":"<","kind":"text"},{"text":"DropReport","preciseIdentifier":"s:11Persistence10DropReportO","kind":"typeIdentifier","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait, without a bound, until they are read, so none is missed by reading late."},{"type":"text","text":" "},{"type":"text","text":"Drops are rare (each is a whole segment, or bytes recovery couldn’t read), so they don’t"},{"type":"text","text":" "},{"type":"text","text":"pile up. The sequence ends once the store is gone and every report has been read."}]},{"type":"paragraph","inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/persistence\/segmentstore\/dropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Persistence/documentation/Persistence":{"kind":"symbol","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"title":"Persistence","role":"collection","identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"topic","url":"\/documentation\/persistence"},"doc://Persistence/documentation/Persistence/SegmentStore/dropReports":{"title":"dropReports","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"DropReport","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence10DropReportO"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A report of each drop, in the order they happen, from recovery onwards."}],"kind":"symbol","url":"\/documentation\/persistence\/segmentstore\/dropreports","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","type":"topic"},"doc://Persistence/documentation/Persistence/SegmentStore":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"url":"\/documentation\/persistence\/segmentstore","kind":"symbol","title":"SegmentStore","type":"topic","role":"symbol","abstract":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true,"type":"reference"},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}]},"doc://Persistence/documentation/Persistence/RecordStore":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","navigatorTitle":[{"text":"RecordStore","kind":"identifier"}],"url":"\/documentation\/persistence\/recordstore","kind":"symbol","title":"RecordStore","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}]},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"kind":"symbol","title":"AsyncQueue","abstract":[{"text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","type":"topic","url":"\/documentation\/asyncqueues\/asyncqueue"},"doc://Persistence/documentation/Persistence/DropReport":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","navigatorTitle":[{"text":"DropReport","kind":"identifier"}],"url":"\/documentation\/persistence\/dropreport","kind":"symbol","title":"DropReport","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Records a store dropped before they were delivered, and why."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DropReport","kind":"identifier"}]}}}