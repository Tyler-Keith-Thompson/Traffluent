{"abstract":[{"text":"A report of each drop, in the order they happen, from recovery onwards.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"]]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DropReport","preciseIdentifier":"s:11Persistence10DropReportO","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","kind":"typeIdentifier"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait, without a bound, until they are read, so none is missed by reading late."},{"type":"text","text":" "},{"type":"text","text":"Drops are rare (each is a whole segment, or bytes recovery couldn’t read), so they don’t"},{"type":"text","text":" "},{"type":"text","text":"pile up. The sequence ends once the store is gone and every report has been read."}]},{"type":"paragraph","inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"metadata":{"title":"dropReports","role":"symbol","modules":[{"name":"Persistence"}],"externalID":"s:11Persistence12SegmentStoreV11dropReports11AsyncQueues0F5QueueVyAA10DropReportOGvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"DropReport","kind":"typeIdentifier","preciseIdentifier":"s:11Persistence10DropReportO"},{"text":">","kind":"text"}],"symbolKind":"property","roleHeading":"Instance Property","remoteSource":{"fileName":"SegmentStore.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L179"}},"sections":[],"variants":[{"paths":["\/documentation\/persistence\/segmentstore\/dropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Persistence/documentation/Persistence":{"abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"type":"topic","kind":"symbol","title":"Persistence","role":"collection","identifier":"doc:\/\/Persistence\/documentation\/Persistence","url":"\/documentation\/persistence"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}],"title":"AsyncQueue","navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","url":"\/documentation\/asyncqueues\/asyncqueue"},"doc://Persistence/documentation/Persistence/SegmentStore":{"abstract":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","isActive":true},{"text":" that keeps records in a directory of append-only segment files, bounded in","type":"text"},{"text":" ","type":"text"},{"text":"size, until they are delivered.","type":"text"}],"type":"topic","kind":"symbol","title":"SegmentStore","role":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore","url":"\/documentation\/persistence\/segmentstore","navigatorTitle":[{"kind":"identifier","text":"SegmentStore"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}]},"doc://Persistence/documentation/Persistence/DropReport":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Records a store dropped before they were delivered, and why."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DropReport"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DropReport"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport","title":"DropReport","url":"\/documentation\/persistence\/dropreport"},"doc://Persistence/documentation/Persistence/RecordStore":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RecordStore"}],"title":"RecordStore","navigatorTitle":[{"kind":"identifier","text":"RecordStore"}],"type":"topic","abstract":[{"text":"Where a tracker keeps each record until it is delivered, so records survive the app ending.","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Persistence\/documenta