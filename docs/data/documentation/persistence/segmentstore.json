{"abstract":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore"},{"type":"text","text":" that keeps records in a directory of append-only segment files, bounded in"},{"type":"text","text":" "},{"type":"text","text":"size, until they are delivered."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/s8SendableP","doc:\/\/Persistence\/s16SendableMetatypeP"],"title":"Conforms To"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","doc:\/\/Persistence\/documentation\/Persistence\/DropReport"],"generated":true,"anchor":"Stores","title":"Stores"}],"metadata":{"role":"symbol","navigatorTitle":[{"text":"SegmentStore","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"Persistence"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStore","kind":"identifier"}],"externalID":"s:11Persistence12SegmentStoreV","remoteSource":{"fileName":"SegmentStore.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Persistence\/SegmentStore.swift#L88"},"roleHeading":"Structure","title":"SegmentStore"},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Persistence\/documentation\/Persistence"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore"},"topicSections":[{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(directory:byteBound:segmentByteCount:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/byteCount","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/append(_:)","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/takeRecoveredRecords()"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory"],"generated":true,"anchor":"Type-Properties","title":"Type Properties"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentStore"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"code":["let store = try SegmentStore()","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Write-through."}],"type":"strong"},{"text":" A tracker’s worker writes each record as it reaches it, before publishing","type":"text"},{"text":" ","type":"text"},{"text":"it, with one ","type":"text"},{"type":"codeVoice","code":"write()"},{"text":", off the tracking caller’s thread, so the record survives the app","type":"text"},{"text":" ","type":"text"},{"text":"crashing or being killed from then on. The store makes the log durable against","type":"text"},{"text":" ","type":"text"},{"text":"power loss too (","type":"text"},{"type":"codeVoice","code":"fsync"},{"text":") once per batch, before the batch is delivered, and whenever","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/synchronize()"},{"text":" is called: call it, after the tracker’s ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":", as the app moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background or terminates.","type":"text"},{"text":" ","type":"text"},{"text":"A record whose write fails (the disk is full, say) is kept in memory only, and reported as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/writeFailed(recordCount:timestamps:)"},{"text":", and so is one whose event’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"encode(to:)"},{"text":" throws.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"What is kept.","type":"text"}]},{"type":"text","text":" Every event "},{"code":"DiscoveredEvent.all","type":"codeVoice"},{"type":"text","text":" lists, the "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" structs of every"},{"type":"text","text":" "},{"type":"text","text":"module the program links and the library’s own, or only the "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" types in "},{"code":"events","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Events of any other type are kept in memory only: they are delivered in this run like any"},{"type":"text","text":" "},{"type":"text","text":"other, are never written, and are lost if the app ends first. The first record of each such"},{"type":"text","text":" "},{"type":"text","text":"type is reported as "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","isActive":true,"type":"reference"},{"type":"text","text":", so a type left out by mistake,"},{"type":"text","text":" "},{"type":"text","text":"such as one that conforms to "},{"code":"Event","type":"codeVoice"},{"type":"text","text":" by hand, shows up."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"A recovered record’s context."}]},{"text":" A record keeps these keys of its context, written in the","type":"text"},{"text":" ","type":"text"},{"text":"record’s own bytes, so a record recovered after a relaunch reaches destinations as it was","type":"text"},{"text":" ","type":"text"},{"text":"tracked:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"SessionKey","type":"codeVoice"},{"text":", so a vendor destination sends it under the same identity as the first time;","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"SampleRateKey","type":"codeVoice"},{"type":"text","text":", so it is weighted by the rate it was sampled at;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ScreenKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ApplicationKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DeviceKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"OperatingSystemKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"LocaleKey","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"NetworkKey","type":"codeVoice"},{"text":", so it is attributed to where it was tracked, not to the run that uploads it.","type":"text"},{"text":" ","type":"text"},{"text":"A locale is kept as its identifier, so a preference the identifier doesn’t spell is lost.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The store writes these keys whatever set them, so don’t build a screen name, or an app or"},{"type":"text","text":" "},{"type":"text","text":"device value, from user data."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A key the record didn’t have comes back absent. No other key is kept, so a recovered record"},{"type":"text","text":" "},{"type":"text","text":"is otherwise in the top-level "},{"type":"codeVoice","code":"ServiceContext"},{"type":"text","text":": not "},{"type":"codeVoice","code":"VendorIdentifierKey"},{"type":"text","text":", which Traffluent"},{"type":"text","text":" "},{"type":"text","text":"never stores; not a key of the app’s own, such as an account’s, which the store can’t tell"},{"type":"text","text":" "},{"type":"text","text":"from an identifier; and not the trace context, as its span ended with the earlier run."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deleting."}]},{"text":" A segment is deleted as a whole once every record in it is delivered, so a","type":"text"},{"text":" ","type":"text"},{"text":"log whose records are all delivered holds no files. A record’s context goes with its","type":"text"},{"text":" ","type":"text"},{"text":"segment: the store keeps no session apart from the records tracked in it. A segment kept","type":"text"},{"text":" ","type":"text"},{"text":"for one undelivered record keeps its delivered ones too, sessions and all. Only recovery","type":"text"},{"text":" ","type":"text"},{"text":"rewrites a segment: one still holding","type":"text"},{"text":" ","type":"text"},{"text":"records after it drops some (","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)","type":"reference","isActive":true},{"text":") is","type":"text"},{"text":" ","type":"text"},{"text":"rewritten without them, so each drop is reported once. Should the rewrite fail, the","type":"text"},{"text":" ","type":"text"},{"text":"segment is kept as it was and the next launch reports those drops again.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reading back."}]},{"text":" When a destination’s full buffer drops a batch on its way through a","type":"text"},{"text":" ","type":"text"},{"text":"delivery, the delivery reads that batch’s records back from the log once the destination","type":"text"},{"text":" ","type":"text"},{"text":"has caught up, reading each segment they are in once, and hands them to it in this run,","type":"text"},{"text":" ","type":"text"},{"text":"each in the context it was tracked in, which the delivery keeps. A record the bound dropped","type":"text"},{"text":" ","type":"text"},{"text":"before the read finished isn’t read back, and one that can’t be read or decoded is logged","type":"text"},{"text":" ","type":"text"},{"text":"and waits for a later launch.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Bound."}]},{"type":"text","text":" The log never holds more than "},{"code":"byteBound","type":"codeVoice"},{"type":"text","text":" bytes. When a record wouldn’t fit, the"},{"type":"text","text":" "},{"type":"text","text":"oldest segments are deleted until it does, and each one deleted with records not yet"},{"type":"text","text":" "},{"type":"text","text":"delivered yields a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport"},{"type":"text","text":" on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/dropReports"},{"type":"text","text":". A record too large for an empty log"},{"type":"text","text":" "},{"type":"text","text":"is kept in memory only."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Recovery."}],"type":"strong"},{"type":"text","text":" A store opened on a directory recovers the records earlier runs left there"},{"type":"text","text":" "},{"type":"text","text":"and a tracker given the store delivers them first. Each segment is cut at its first torn or"},{"type":"text","text":" "},{"type":"text","text":"corrupt record, keeping every intact record before it, and the bytes cut off are reported."},{"type":"text","text":" "},{"type":"text","text":"A segment comes back whole, delivered records and all. Each record a delivery had started on"},{"type":"text","text":" "},{"type":"text","text":"comes back with "},{"type":"codeVoice","code":"isRedelivered"},{"type":"text","text":" set, as it may have reached a destination already: one"},{"type":"text","text":" "},{"type":"text","text":"delivered before the app ended, or one delivered just as it ended, before the store could"},{"type":"text","text":" "},{"type":"text","text":"delete its segment. A record whose delivery mark can’t be written is held back from that"},{"type":"text","text":" "},{"type":"text","text":"delivery, so it is never sent twice unannounced, and delivered on a later launch."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Other versions."}]},{"text":" A segment a newer release of the app wrote, in a later version of the","type":"text"},{"text":" ","type":"text"},{"text":"format, is left on disk untouched after a rollback, for that release to deliver: this one","type":"text"},{"text":" ","type":"text"},{"text":"neither reads it nor counts it toward the bound. A segment in an earlier version, which this","type":"text"},{"text":" ","type":"text"},{"text":"one can’t read, is deleted and reported as a","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Changed event types."}]},{"type":"text","text":" Each record’s event is a map of its properties by name, so a record"},{"type":"text","text":" "},{"type":"text","text":"written before its type changed still reads: a property removed since is skipped, an"},{"type":"text","text":" "},{"type":"text","text":"optional one added since is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" and one with a default value added since has it. A record"},{"type":"text","text":" "},{"type":"text","text":"stored at another "},{"code":"Event.schemaVersion","type":"codeVoice"},{"type":"text","text":" than its type’s now is dropped without being read and"},{"type":"text","text":" "},{"type":"text","text":"reported as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/versionMismatch(event:storedVersion:currentVersion:recordCount:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"One at the same version that can’t be read all the same, after a required property was added"},{"type":"text","text":" "},{"type":"text","text":"or a property’s type changed without raising the version, is dropped and reported as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Open one store per directory at a time; two would delete each other’s segments. Copies of a"},{"type":"text","text":" "},{"type":"text","text":"store share its log."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/persistence\/segmentstore"]}],"references":{"doc://Persistence/documentation/Persistence/SegmentStoreError":{"url":"\/documentation\/persistence\/segmentstoreerror","abstract":[{"type":"text","text":"The error "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)"},{"type":"text","text":" throws: an"},{"type":"text","text":" "},{"type":"text","text":"argument it can’t open a store with, or the file system’s failure."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentStoreError","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"SegmentStoreError","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStoreError","title":"SegmentStoreError"},"doc://Persistence/documentation/Persistence/SegmentStore/pendingRecordCount":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/pendingRecordCount","type":"topic","abstract":[{"text":"How many records the log keeps that are not yet delivered.","type":"text"}],"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pendingRecordCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/persistence\/segmentstore\/pendingrecordcount","role":"symbol","title":"pendingRecordCount"},"doc://Persistence/documentation/Persistence/SegmentStore/directory":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/directory","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"directory"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13SystemPackage8FilePathV","kind":"typeIdentifier","text":"FilePath"}],"kind":"symbol","type":"topic","title":"directory","abstract":[{"type":"text","text":"Where the store keeps its segments."}],"url":"\/documentation\/persistence\/segmentstore\/directory","role":"symbol"},"doc://Persistence/documentation/Persistence/DropReport/notPersisted(event:)":{"title":"DropReport.notPersisted(event:)","abstract":[{"type":"text","text":"A record of the event named "},{"type":"codeVoice","code":"event"},{"type":"text","text":" was kept in memory only because its type isn’t one of"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"events"},{"type":"text","text":": its records are delivered in this run, but never written, so they are"},{"type":"text","text":" "},{"type":"text","text":"lost if the app ends first. Reported once per type, on its first record, for as long as the"},{"type":"text","text":" "},{"type":"text","text":"store lives; a type left out by mistake is added to "},{"type":"codeVoice","code":"events"},{"type":"text","text":"."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notPersisted","kind":"identifier"},{"text":"(","kind":"text"},{"text":"event","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/notPersisted(event:)","url":"\/documentation\/persistence\/dropreport\/notpersisted(event:)","kind":"symbol","role":"symbol"},"doc://Persistence/documentation/Persistence/DropReport/undecodable(recordCount:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"undecodable","kind":"identifier"},{"text":"(","kind":"text"},{"text":"recordCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/undecodable(recordCount:)","abstract":[{"type":"text","text":"Recovery read "},{"code":"recordCount","type":"codeVoice"},{"type":"text","text":" intact records it couldn’t decode: their event type isn’t in"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"code":"events","type":"codeVoice"},{"type":"text","text":", or its "},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":" threw, as it does for a record"},{"type":"text","text":" "},{"type":"text","text":"written before a required property was added or a property’s type changed while the"},{"type":"text","text":" "},{"type":"text","text":"event’s "},{"code":"Event.schemaVersion","type":"codeVoice"},{"type":"text","text":" stayed the same."}],"kind":"symbol","role":"symbol","url":"\/documentation\/persistence\/dropreport\/undecodable(recordcount:)","type":"topic","title":"DropReport.undecodable(recordCount:)"},"doc://Persistence/documentation/Persistence/SegmentStore/init(events:directory:byteBound:segmentByteCount:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"events","kind":"externalParam"},{"text":": [any (","kind":"text"},{"preciseIdentifier":"s:6Events5EventP","text":"Event","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"preciseIdentifier":"s:s7Codablea","text":"Codable","kind":"typeIdentifier"},{"text":").Type], ","kind":"text"},{"text":"directory","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13SystemPackage8FilePathV","text":"FilePath","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"byteBound","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"segmentByteCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11Persistence17SegmentStoreErrorO","text":"SegmentStoreError","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/init(events:directory:byteBound:segmentByteCount:)","abstract":[{"text":"A store keeping events of the types ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"directory"},{"text":"; it recovers the records","type":"text"},{"text":" ","type":"text"},{"text":"already there.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/init(events:directory:bytebound:segmentbytecount:)","type":"topic","title":"init(events:directory:byteBound:segmentByteCount:)"},"doc://Persistence/documentation/Persistence/SegmentStore/defaultByteBound":{"title":"defaultByteBound","abstract":[{"text":"The bound a store has unless it is given another: 5 MiB (5,242,880 bytes).","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultByteBound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"type":"topic","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultByteBound","url":"\/documentation\/persistence\/segmentstore\/defaultbytebound","kind":"symbol","role":"symbol"},"doc://Persistence/documentation/Persistence/SegmentStore/defaultDirectory":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultDirectory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SystemPackage8FilePathV","text":"FilePath"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/SegmentStore\/defaultDirectory","abstract":[{"type":"text","text":"Where a store keeps its segments unless it is given a directory."}],"kind":"symbol","role":"symbol","url":"\/documentation\/persistence\/segmentstore\/defaultdirectory","type":"topic","title":"defaultDirectory"},"doc://Persistence/documentation/Persistence/DropReport/corruption(byteCount:)":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"corruption"},{"kind":"text","text":"("},{"kind":"externalParam","text":"byteCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/DropReport\/corruption(byteCount:)","abstract":[{"type":"text","text":"Recovery found a torn or corrupt record, or a segment header it couldn’t read, and"},{"type":"text","text":" "},{"type":"text","text":"discarded the "},{"code":"byteCount","type":"codeVoice"},{"type":"text","text":" bytes from there to the end of the segment."}],"kind":"symbol","role":"symbol","url":"\/documentation\/persistence\/dropreport\/corruption(bytecount:)","type":"topic","title":"DropReport.corruption(byteCount:)"},"doc://Persistence/documentation/Persistence/SegmentStore/init(directory:byteBound:segmentByteCount:)":{"url":"\/documentation\/persistence\/segmentstore\/init(directory:bytebound:segmentbytecount:)","abstract":[{"type":"text","text":"A store keeping events of every type the program declares with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"library’s own, in "},{"type":"codeVoice","code":"directory"},{"type":"text","text":"; it recovers the records already there."}],"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"directory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"FilePath","preciseIdentifier":"s:13SystemPackage8FilePathV"},{"kind":"text","text":", "},{"kind