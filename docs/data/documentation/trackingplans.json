mmitted"},{"type":"text","text":" while it"},{"type":"text","text":" "},{"type":"text","text":"still describes the event, or the one to publish next."}],"type":"topic"},"doc://Events/documentation/Events/EventSchema":{"kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema","type":"topic","role":"symbol","title":"EventSchema","abstract":[{"text":"The shape of an event type: its name, its schema version, its consent category and its stored","type":"text"},{"text":" ","type":"text"},{"text":"properties in declaration order, as a value tooling reads.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventSchema"}],"navigatorTitle":[{"kind":"identifier","text":"EventSchema"}],"url":"\/documentation\/events\/eventschema"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCommand":{"role":"symbol","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand","url":"\/documentation\/trackingplans\/trackingplancommand","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlanCommand","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"TrackingPlanCommand","kind":"identifier"}],"abstract":[{"type":"text","text":"An executable that writes a tracking plan: the type marked "},{"type":"codeVoice","code":"@main"},{"type":"text","text":" in a target of the app’s"},{"type":"text","text":" "},{"type":"text","text":"package that links the modules declaring its events."}],"type":"topic","title":"TrackingPlanCommand"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(against:)":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"check","kind":"identifier"},{"text":"(","kind":"text"},{"text":"against","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV","text":"File","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO","text":"TrackingPlanCheck","kind":"typeIdentifier"}],"abstract":[{"text":"Compares the plan with ","type":"text"},{"code":"committed","type":"codeVoice"},{"text":", the files of a plan exported before, and reports every","type":"text"},{"text":" ","type":"text"},{"text":"difference.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/check(against:)","title":"check(against:)","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/schemas":{"kind":"symbol","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/schemas","type":"topic","role":"symbol","abstract":[{"text":"The plan’s event schemas, ordered by the UTF-8 bytes of their names and then by version.","type":"text"}],"title":"schemas","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"schemas","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Events11EventSchemaV","text":"EventSchema","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/trackingplans\/trackingplan\/schemas"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/File":{"kind":"symbol","type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/File","role":"symbol","title":"TrackingPlan.File","abstract":[{"type":"text","text":"One file of a tracking plan: its path within the plan’s directory and its bytes."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"File","kind":"identifier"}],"navigatorTitle":[{"text":"File","kind":"identifier"}],"url":"\/documentation\/trackingplans\/trackingplan\/file"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/init(schemas:)":{"role":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/init(schemas:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"schemas","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Events11EventSchemaV","text":"EventSchema","kind":"typeIdentifier"},{"text":"]) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A9PlanErrorO","text":"TrackingPlanError","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/init(schemas:)","kind":"symbol","title":"init(schemas:)","abstract":[{"text":"The plan of the events ","type":"text"},{"code":"schemas","type":"codeVoice"},{"text":" describe, in any order, or an error naming the first rule","type":"text"},{"text":" ","type":"text"},{"text":"they break.","type":"text"}],"type":"topic"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/files(carryingForward:)":{"role":"symbol","title":"files(carryingForward:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"files"},{"kind":"text","text":"("},{"kind":"externalParam","text":"carryingForward"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV","text":"File"},{"kind":"text","text":"]) -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV","text":"File"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","abstract":[{"text":"The plan’s files, as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files"},{"text":" lists them, with each event’s document keeping the","type":"text"},{"text":" ","type":"text"},{"text":"properties its document in ","type":"text"},{"type":"codeVoice","code":"committed"},{"text":", at the same name and version, has that the event","type":"text"},{"text":" ","type":"text"},{"text":"no longer declares: each with its schema there, marked ","type":"text"},{"type":"codeVoice","code":"deprecated: true"},{"text":". The documents in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"committed"},{"text":" of an event’s earlier versions, below the newest the plan lists, are kept too,","type":"text"},{"text":" ","type":"text"},{"text":"with their examples, byte for byte, and listed in the index.","type":"text"}],"url":"\/documentation\/trackingplans\/trackingplan\/files(carryingforward:)","kind":"symbol","type":"topic"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/init()":{"role":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/init()","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"() "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A9PlanErrorO","text":"TrackingPlanError"},{"kind":"text","text":")"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/init()","kind":"symbol","title":"init()","abstract":[{"type":"text","text":"The plan of every event the program declares with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and of the library’s own, or"},{"type":"text","text":" "},{"type":"text","text":"an error naming the first rule they break."}],"type":"topic"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/files":{"role":"symbol","title":"files","fragments":[{"kind":"key