kind":"text"},{"text":"schemas","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventSchema","preciseIdentifier":"s:6Events11EventSchemaV","kind":"typeIdentifier"},{"text":"]) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"TrackingPlanError","preciseIdentifier":"s:13TrackingPlans0A9PlanErrorO","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/init(schemas:)"},"doc://TrackingPlans/documentation/TrackingPlans/IgluExportError":{"url":"\/documentation\/trackingplans\/igluexporterror","navigatorTitle":[{"text":"IgluExportError","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IgluExportError","kind":"identifier"}],"abstract":[{"type":"text","text":"Why a tracking plan couldn’t be written as an Iglu registry"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/igluFiles(vendor:registry:carryingForward:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/writeIgluRegistry(to:vendor:registry:)","isActive":true},{"type":"text","text":")."}],"title":"IgluExportError"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/File":{"kind":"symbol","type":"topic","url":"\/documentation\/trackingplans\/trackingplan\/file","abstract":[{"text":"One file of a tracking plan: its path within the plan’s directory and its bytes.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"File","kind":"identifier"}],"navigatorTitle":[{"text":"File","kind":"identifier"}],"identifier":"doc:\/\/TrackingP