re, and reports every"},{"type":"text","text":" "},{"type":"text","text":"difference."}],"title":"check(against:)","url":"\/documentation\/trackingplans\/trackingplan\/check(against:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)","type":"topic"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(againstDirectory:)":{"url":"\/documentation\/trackingplans\/trackingplan\/check(againstdirectory:)","abstract":[{"text":"Compares the plan with the one committed in ","type":"text"},{"code":"directory","type":"codeVoice"},{"text":", as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)","type":"reference"},{"text":" does with","type":"text"},{"text":" ","type":"text"},{"text":"the directory’s files.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"check","kind":"identifier"},{"text":"(","kind":"text"},{"text":"againstDirectory","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials3URLV","text":"URL","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO","text":"TrackingPlanCheck","kind":"typeIdentifier"}],"title":"check(againstDirectory:)","kind":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/IgluRegistry":{"navigatorTitle":[{"kind":"identifier","text":"IgluRegistry"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"IgluRegistry"}],"kind":"symbol","abstract":[{"type":"text","text":"The kind of Iglu registry a tracking plan’s schemas are published to, which decides whether a"},{"type":"text","text":" "},{"type":"text","text":"compatible change can be