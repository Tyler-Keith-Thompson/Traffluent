Instance Methods","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Type Aliases","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/Failure"],"anchor":"Type-Aliases"},{"generated":true,"title":"Type Properties","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/transientStatuses"],"anchor":"Type-Properties"},{"generated":true,"title":"Type Methods","identifiers":["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/outcome(of:for:)"],"anchor":"Type-Methods"}],"hierarchy":{"paths":[["doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SegmentSpecBatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with one of the factories, which fill in the endpoint, the credentials’"},{"type":"text","text":" "},{"type":"text","text":"header field, this encoder and its limits:"},{"type":"text","text":" "},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/segment(writeKey:region:plan:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["let segment = try HTTPDestination.segment(","    writeKey: writeKey,","    region: .us,  \/\/ or .eu, where the workspace is","    plan: plan)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":" with one member, "},{"code":"batch","type":"codeVoice"},{"type":"text","text":", an array"},{"type":"text","text":" "},{"type":"text","text":"of track calls, one per record, oldest first, with these members:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"anonymousId","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"context","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context, in the spec’s field names (below), and "},{"type":"codeVoice","code":"ip"},{"type":"text","text":" as "},{"type":"codeVoice","code":"\"0.0.0.0\""}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"messageId","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, by name"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"request_ip"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":", in RudderStack’s calls alone"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in ISO 8601 with milliseconds, in UTC","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"type"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"track\""}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"code":"userId","type":"codeVoice"},{"type":"text","text":", no "},{"code":"identify","type":"codeVoice"},{"type":"text","text":" call, no traits,"},{"type":"text","text":" "},{"type":"text","text":"and no "},{"code":"context.device.id","type":"codeVoice"},{"type":"text","text":" or "},{"code":"advertisingId","type":"codeVoice"},{"type":"text","text":". An endpoint counts a user per "},{"code":"anonymousId","type":"codeVoice"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"its anonymous users are sessions. A record with no session (one tracked by a tracker without"},{"type":"text","text":" "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":") is its own anonymous user, linked to nothing: the spec rejects a call"},{"type":"text","text":" "},{"type":"text","text":"with neither a "},{"code":"userId","type":"codeVoice"},{"type":"text","text":" nor an "},{"code":"anonymousId","type":"codeVoice"},{"type":"text","text":". A record a store recovers after a relaunch keeps"},{"type":"text","text":" "},{"type":"text","text":"its session, so it goes out with the "},{"code":"anonymousId","type":"codeVoice"},{"type":"text","text":" and "},{"code":"messageId","type":"codeVoice"},{"type":"text","text":" of its first send. Segment"},{"type":"text","text":" "},{"type":"text","text":"deduplicates calls by "},{"code":"messageId","type":"codeVoice"},{"type":"text","text":" over about the last 24 hours, and drops most duplicates"},{"type":"text","text":" "},{"type":"text","text":"rather than all, so a recovered record Segment had already stored before the app ended is most"},{"type":"text","text":" "},{"type":"text","text":"likely not stored again. RudderStack’s and Customer.io’s references don’t say whether they"},{"type":"text","text":" "},{"type":"text","text":"deduplicate. The record’s vendor identifier"},{"type":"text","text":" "},{"type":"text","text":"and trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" is "},{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":" in every call, which the spec reads as the user’s address, so"},{"type":"text","text":" "},{"type":"text","text":"Segment records no address from the request. RudderStack fills in a "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" member from"},{"type":"text","text":" "},{"type":"text","text":"the request unless the call has one, even when "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" is set, and passes it on to its"},{"type":"text","text":" "},{"type":"text","text":"destinations, so RudderStack’s calls also carry "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":" as "},{"type":"codeVoice","code":"\"0.0.0.0\""},{"type":"text","text":". Customer.io’s"},{"type":"text","text":" "},{"type":"text","text":"references don’t say whether "},{"type":"codeVoice","code":"context.ip"},{"type":"text","text":" takes the place of the address it reads from an HTTP"},{"type":"text","text":" "},{"type":"text","text":"request. No call to Segment or Customer.io carries "},{"type":"codeVoice","code":"request_ip"},{"type":"text","text":", which their specs don’t have."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":", "},{"type":"codeVoice","code":"originalTimestamp"},{"type":"text","text":" or "},{"type":"codeVoice","code":"channel"},{"type":"text","text":" is sent. Without "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":" the endpoint takes"},{"type":"text","text":" "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":" as it is, uncorrected for the device’s clock; it is left out on purpose, as a"},{"type":"text","text":" "},{"type":"text","text":"retried request sends the same body again, whose "},{"type":"codeVoice","code":"sentAt"},{"type":"text","text":" would be the first attempt’s."},{"type":"text","text":" "},{"type":"text","text":"RudderStack, whose references list all three as required, fills them in from when it received"},{"type":"text","text":" "},{"type":"text","text":"the call."}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"context"},{"type":"text","text":" holds these members, for each of the keys the record’s context has a value for:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"app"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"namespace","type":"codeVoice"},{"type":"text","text":", the bundle identifier, "},{"code":"version","type":"codeVoice"},{"type":"text","text":" and "},{"code":"build","type":"codeVoice"},{"type":"text","text":", each left out when "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"; no "},{"code":"app","type":"codeVoice"},{"type":"text","text":" when all three are"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"device","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"model"},{"type":"text","text":", and "},{"type":"codeVoice","code":"type"},{"type":"text","text":", the platform as Segment’s Swift library names it: "},{"type":"codeVoice","code":"ios"},{"type":"text","text":" for a phone or pad, "},{"type":"codeVoice","code":"macos"},{"type":"text","text":", "},{"type":"codeVoice","code":"tvos"},{"type":"text","text":", "},{"type":"codeVoice","code":"watchos"},{"type":"text","text":" or "},{"type":"codeVoice","code":"visionos"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"locale"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"type":"codeVoice","code":"en-US"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"network","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NetworkKey"}],"type":"paragraph"}],[{"inlineContent":[{"code":"wifi","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cellular","type":"codeVoice"},{"text":", whether the connection is each","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"os","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}],"type":"paragraph"}],[{"inlineContent":[{"code":"name","type":"codeVoice"},{"type":"text","text":" and "},{"code":"version","type":"codeVoice"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe, one whose event name is one of","type":"text"},{"text":" ","type":"text"},{"text":"Customer.io’s semantic events, which delete or suppress people and devices, one whose event","type":"text"},{"text":" ","type":"text"},{"text":"isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one that holds a value JSON can’t, one whose timestamp has no ISO 8601 form,","type":"text"},{"text":" ","type":"text"},{"text":"and one too large for a call (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecEncodingError"},{"text":"). ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)"},{"text":" returns them as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/SegmentSpecBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. A record sent again keeps its "},{"code":"messageId","type":"codeVoice"},{"type":"text","text":". The bytes are the same for the same"},{"type":"text","text":" "},{"type":"text","text":"records on every run and platform: no whitespace, object members in the order of their names’"},{"type":"text","text":" "},{"type":"text","text":"UTF-8 bytes."}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/SegmentSpecBatchEncoder/transientStatuses":{"abstract":[{"text":"No status beyond the 408, 429 and 5xx that ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" retries for every encoder.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientStatuses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set",