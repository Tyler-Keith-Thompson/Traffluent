xt":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:19SegmentSpecEncoding21RudderStackSetupErrorO","text":"RudderStackSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:19SegmentSpecEncoding0aB12BatchEncoderV","text":"SegmentSpecBatchEncoder"},{"kind":"text","text":">"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A destination that sends batches to the RudderStack source of "},{"type":"codeVoice","code":"writeKey"},{"type":"text","text":", through the data"},{"type":"text","text":" "},{"type":"text","text":"plane at "},{"type":"codeVoice","code":"dataPlane"},{"type":"text","text":", through "},{"type":"codeVoice","code":"transport"},{"type":"text","text":", retrying a send that fails for now with the waits"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"role":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","title":"Choosing Destinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/CustomerIORegion":{"abstract":[{"type":"text","text":"The region of a Customer.io workspace, which decides the Pipelines API endpoint its events are"},{"type":"text","text":" "},{"type":"text","text":"posted to."}],"role":"symbol","title":"CustomerIORegion","url":"\/documentation\/segmentspecencoding\/customerioregion","type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomerIORegion","kind":"identifier"}],"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIORegion","navigatorTitle":[{"text":"CustomerIORegion","kind":"identifier"}]},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/RudderStackSetupError":{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/RudderStackSetupError","title":"RudderStackSetupError","url":"\/documentation\/segmentspecencoding\/rudderstacksetuperror","navigatorTitle":[{"kind":"identifier","text":"RudderStackSetupError"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RudderStackSetupError"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Why "},{"isActive":true,"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:transport:backoff:clock:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"role":"symbol"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/CustomerIOSetupError":{"abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/customerIO(apiKey:region:plan:transport:backoff:clock:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"url":"\/documentation\/segmentspecencoding\/customeriosetuperror","role":"symbol","navigatorTitle":[{"text":"CustomerIOSetupError","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomerIOSetupError","kind":"identifier"}],"title":"CustomerIOSetupError","type":"topic","kind":"symbol","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/CustomerIOSetupError"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding":{"type":"topic","abstract":[{"type":"text","text":"Send records as Segment-spec track calls to Segment, RudderStack or Customer.io Data Pipelines."}],"title":"SegmentSpecEncoding","kind":"symbol","role":"collection","url":"\/documentation\/segmentspecencoding","identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding"},"doc://SegmentSpecEncoding/documentation/SegmentSpecEncoding/HTTPDestinations/HTTPDestination/rudderStack(writeKey:dataPlane:plan:backoff:clock:)":{"identifier":"doc:\/\/SegmentSpecEncoding\/documentation\/SegmentSpecEncoding\/HTTPDestinations\/HTTPDestination\/rudderStack(writeKey:dataPlane:plan:backoff:clock:)","title":"rudderStack(writeKey:dataPlane:plan:backoff:clock:)","url":"\/documentation\/segmentspecencoding\/httpdestinations\/httpdestination\/rudderstack(writekey:dataplane:plan:backoff:clock:)","conformance":{"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" is "},{"type":"codeVoice","code":"URLSessionTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice",