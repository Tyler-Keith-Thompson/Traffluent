t":"each screen."}],"kind":"symbol"},"doc://LifecycleTracking/documentation/LifecycleTracking":{"role":"collection","type":"topic","title":"LifecycleTracking","url":"\/documentation\/lifecycletracking","abstract":[{"type":"text","text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s records durable as the app leaves the foreground."}],"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","kind":"symbol"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"role":"article","type":"topic","title":"Automatic Tracking","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"url":"\/documentation\/traffluent\/automatictracking"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","type":"topic","role":"collection","url":"\/documentation\/googleanalyticsencoding","title":"GoogleAnalyticsEncoding","abstract":[{"type":"text","text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol."}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","type":"topic","title":"Tracking Events","kind":"article","url":"\/documentation\/traffluent\/trackingevents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents"},"doc://Destinations/documentation/Destinations":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"topic","role":"collection","url":"\/documentation\/destinations","title":"Destinati