rd on disk until it is delivered, so a record the app tracked survives the process ending."}],"url":"\/documentation\/traffluent\/persistingrecords","kind":"article","role":"article","title":"Persisting Records","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},"doc://AptabaseEncoding/documentation/AptabaseEncoding":{"abstract":[{"text":"Send records to Aptabase, in its cloud or on your own server, through its events API.","type":"text"}],"url":"\/documentation\/aptabaseencoding","kind":"symbol","role":"collection","type":"topic","title":"AptabaseEncoding","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding"},"doc://Persistence/documentation/Persistence":{"title":"Persistence","url":"\/documentation\/persistence","kind":"symbol","role":"collection","identifier":"doc:\/\/Persistence\/documentation\/Persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"type":"topic"},"doc://Events/documentation/Events":{"identifier":"doc:\/\/Events\/documentation\/Events","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"url":"\/documentation\/events","type":"topic","role":"collection","kind":"symbol","title":"Events"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding":{"abstract":[{"type":"text","text":"Send records to an Amplitude project through its HTTP V2 API."}],"url":"\/documentation\/amplitudeencoding","kind":"symbol","role":"collection","title":"AmplitudeEncoding","type":"topic","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"},"doc://HeapEncoding/documentation/HeapEncoding":{"abstract":[{"text":"Send records to Heap as custom events, through its server-side bulk track API.","type":"text"}],"url"