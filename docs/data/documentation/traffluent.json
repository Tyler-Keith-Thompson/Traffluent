estinationTesting":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","type":"topic","role":"collection","url":"\/documentation\/destinationtesting","title":"DestinationTesting","abstract":[{"text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record.","type":"text"}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","role":"article","url":"\/documentation\/traffluent\/definingevents","title":"Defining Events","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":", and constrain which values its properties may hold.","type":"text"}],"kind":"article"},"doc://SwiftUITracking/documentation/SwiftUITracking":{"role":"collection","type":"topic","title":"SwiftUITracking","kind":"symbol","abstract":[{"type":"text","text":"Give SwiftUI views a tracker through the environment, and track what they do with view modifiers."}],"identifier":"doc:\/\/SwiftUITracking\/documentation\/SwiftUITracking","url":"\/documentation\/swiftuitracking"},"doc://Events/documentation/Events":{"identifier":"doc:\/\/Events\/documentation\/Events","type":"topic","role":"collection","url":"\/documentation\/events","title":"Events","abstract":[{"type":"text","text":"The types every other module shares: the "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" protocol, the values its properties can hold, and the record a tracker makes of each event."}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"topic","role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan","abstract":[{"type":"text","text":"Tell the p