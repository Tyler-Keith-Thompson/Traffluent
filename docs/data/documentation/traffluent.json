oc://Traffluent/documentation/Traffluent/SamplingEvents":{"url":"\/documentation\/traffluent\/samplingevents","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","title":"Sampling Events","role":"article"},"doc://Sessions/documentation/Sessions":{"role":"collection","identifier":"doc:\/\/Sessions\/documentation\/Sessions","abstract":[{"type":"text","text":"Put every event a tracker tracks in a session, and sample whole sessions."}],"type":"topic","title":"Sessions","kind":"symbol","url":"\/documentation\/sessions"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"url":"\/documentation\/automaticcontroltracking","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","title":"AutomaticControlTracking","role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"type":"topic","title":"Tracking from SwiftUI, UIKit and AppKit","kind":"article","url":"\/documentation\/traffluent\/trackingfromviews"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests","type":"topic","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s o