uent\/documentation\/Traffluent\/SessionsAndStandardContext","kind":"article","role":"article","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"url":"\/documentation\/traffluent\/sessionsandstandardcontext","type":"topic","title":"Sessions and Standard Context"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","kind":"article","role":"article","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"url":"\/documentation\/traffluent\/identifyingpeople","type":"topic","title":"Identifying People"},"doc://AutomaticScreenTracking/documentation/AutomaticScreenTracking":{"identifier":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","url":"\/documentation\/automaticscreentracking","role":"collection","abstract":[{"type":"text","text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on"},{"type":"text","text":" "},{"type":"text","text":"each screen."}],"title":"AutomaticScreenTracking","type":"topic","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"kind":"symbol","url":"\/documentation\/httpdestinations","type":"topic","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"title":"HTTPDestinations","role":"collection","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"doc://Traffluent/documentation/Traffluent/PrivacyManifests":{"kind":"article","url":"\/documentation\/traffluent\/privacymanifests","type":"topic","abstract":[{"type":"text","text":"What each module can collect, the required-reason APIs it calls, and the privacy manifest it ships, so you can fill in your app’s own manifest and privacy labels."}],"title":"Privacy Manifests","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PrivacyManifests"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","title":"Consent Gating","url":"\/documentation\/traffluent\/consentgating","role":"article","kind":"article","abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"type":"topic"},"doc://AsyncQueues/documentation/AsyncQueues":{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues","type":"topic","url":"\/documentation\/asyncqueues","role":"collection","kind":"symbol","abstract":[{"text":"The sequence type of every report and delivery stream the library hands out, and of an app’s own, read by one task at a time.","type":"text"}],"title":"AsyncQueues"},"doc://TrackingPlanTesting/documentation/TrackingPlanTesting":{"kind":"symbol","url":"\/documentation\/trackingplantesting","type":"topic","abstract":[{"type":"text","text":"Fail a Swift Testing test when an app’s events no longer match its committed tracking plan, so every change to an event comes with a change to the plan."}],"title":"TrackingPlanTesting","role":"collection","identifier":"doc:\/\/TrackingPlanTesting\/documentation\/TrackingPlanTesting"},"doc://UIKitTracking/documentation/UIKitTracking":{"kind":"symbol","url":"\/documentation\/uikittracking","type":"topic","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"title":"UIKitTracking","role":"collection","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","kind":"article","role":"article","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to a