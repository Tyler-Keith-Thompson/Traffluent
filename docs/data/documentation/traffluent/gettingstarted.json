{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"This walkthrough builds the analytics of a small store app, one step at a time. The code comes","type":"text"},{"text":" ","type":"text"},{"text":"from the store app in the package’s","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","type":"reference","isActive":true},{"text":", cut down","type":"text"},{"text":" ","type":"text"},{"text":"where the app does more than a step needs. Run that app to see every step working together","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Examples\/README.md","type":"codeVoice"},{"text":" says how). Each step links to the guide that covers it in full.","type":"text"}],"type":"paragraph"},{"anchor":"Add-the-package","type":"heading","level":3,"text":"Add the package"},{"inlineContent":[{"text":"Add Traffluent to your package’s dependencies:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\", from: \"0.0.37\"),","],"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then add products to your targets. "},{"type":"codeVoice","code":"Traffluent"},{"type":"text","text":" imports almost every module. "},{"type":"codeVoice","code":"TrackingPlans"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which the delivery below needs, and "},{"type":"codeVoice","code":"TrackerTesting"},{"type":"text","text":", for tests, are products of their own:"}],"type":"paragraph"},{"syntax":"swift","code":[".target(name: \"MyApp\", dependencies: [","    .product(name: \"Traffluent\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","]),",".testTarget(name: \"MyAppTests\", dependencies: [","    \"MyApp\",","    .product(name: \"TrackerTesting\", package: \"Traffluent\"),","]),"],"type":"codeListing"},{"anchor":"Declare-the-events","type":"heading","level":3,"text":"Declare the events"},{"inlineContent":[{"type":"text","text":"Declare each event as a struct marked "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", with a fixed name, which is what servers and"},{"type":"text","text":" "},{"type":"text","text":"stored records know it by. A property can carry constraints the tracker checks before anything"},{"type":"text","text":" "},{"type":"text","text":"else, and a personal value is "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":", which a destination can leave out with"},{"type":"text","text":" "},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["import Traffluent","","@Event(name: \"product_added_to_cart\")","struct ProductAddedToCart: Equatable {","    @Constrained(.pattern(\"^[a-z0-9]+(-[a-z0-9]+)*$\", example: \"canvas-tote\"))","    var productID: String","    @Constrained(.minimum(1), .maximum(10))","    var quantity: Int","}","","@Event(name: \"signed_up\", consent: .functional)","struct SignedUp {","    var plan: String","    var email: Sensitive<String>","    var referrer: String?","}"],"type":"codeListing"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"ProductAddedToCart","type":"codeVoice"},{"text":" with a quantity of 0 is rejected and never delivered. ","type":"text"},{"code":"SignedUp","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"collected for the ","type":"text"},{"code":"functional","type":"codeVoice"},{"text":" consent category; events are ","type":"text"},{"code":"analytics","type":"codeVoice"},{"text":" unless they say otherwise.","type":"text"},{"text":" ","type":"text"},{"text":"Its email address is ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":", so the tracking plan never requires it, and a record whose email","type":"text"},{"text":" ","type":"text"},{"text":"a destination left out still matches the plan. The store app declares its events in a module of their own, ","type":"text"},{"code":"StoreEvents","type":"codeVoice"},{"text":". See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Build-the-tracker","type":"heading","level":3,"text":"Build the tracker"},{"inlineContent":[{"type":"text","text":"Build one tracker where the app starts. A "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":" keeps each record on disk until it is"},{"type":"text","text":" "},{"type":"text","text":"delivered, so events tracked just before the app ends are sent on the next launch. A "},{"type":"codeVoice","code":"Consent"},{"type":"text","text":" "},{"type":"text","text":"holds each event until the user grants its category. The enrichers stamp every event with its"},{"type":"text","text":" "},{"type":"text","text":"session and with the app, device, operating system, locale and network it was tracked on:"}],"type":"paragraph"},{"syntax":"swift","code":["let consent = Consent(savedDecisions)","let store = try SegmentStore()","let tracker = Tracker(","    store: store,","    consent: consent,","    enrichers: [.sessions(), .application(), .device(), .operatingSystem(), .locale(), .network()]",")"],"type":"codeListing"},{"inlineContent":[{"code":"Consent","type":"codeVoice"},{"text":" keeps decisions in memory only. ","type":"text"},{"code":"savedDecisions","type":"codeVoice"},{"text":" is what the user chose at an earlier","type":"text"},{"text":" ","type":"text"},{"text":"launch, which the app saved (the store app’s ","type":"text"},{"code":"ConsentPreferences","type":"codeVoice"},{"text":" saves them to a file). The store","type":"text"},{"text":" ","type":"text"},{"text":"keeps every event the app declares with ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":", in any of its modules, and the events the","type":"text"},{"text":" ","type":"text"},{"text":"library tracks for it, such as screen views and the sessions’ start and end, with no list to keep","type":"text"},{"text":" ","type":"text"},{"text":"up to date. See ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Make-the-tracker-reachable","type":"heading","level":3,"text":"Make the tracker reachable"},{"inlineContent":[{"text":"Code that runs inside a task can read the tracker bound with ","type":"text"},{"type":"codeVoice","code":"withTracker"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"plus\", email: Sensitive(\"ada@example.com\"), referrer: nil))","}"],"type":"codeListing"},{"inlineContent":[{"text":"Code that no binding reaches, such as a detached task or a SwiftUI button’s action, finds the","type":"text"},{"text":" ","type":"text"},{"text":"tracker through ","type":"text"},{"type":"codeVoice","code":"Tracker.current"},{"text":" only once it is the process’s default. Make it the default once,","type":"text"},{"text":" ","type":"text"},{"text":"as the app starts, in your ","type":"text"},{"type":"codeVoice","code":"App"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["try Tracker.bootstrap(tracker)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A second call throws "},{"type":"codeVoice","code":"TrackerAlreadyBootstrapped"},{"type":"text","text":" and leaves the first tracker in place, and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" binding still wins inside its scope."}],"type":"paragraph"},{"inlineContent":[{"text":"Views don’t read ","type":"text"},{"type":"codeVoice","code":"Tracker.current"},{"text":". They read the tracker from the environment, where each screen","type":"text"},{"text":" ","type":"text"},{"text":"adds its name to it, so set it at the root of the views, in your ","type":"text"},{"type":"codeVoice","code":"App"},{"text":"’s body:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["WindowGroup {","    StoreView()","        .tracker(tracker)","}"],"type":"codeListing"},{"inlineContent":[{"text":"The store app also turns on lifecycle tracking as it launches, which tracks opens and moves to the","type":"text"},{"text":" ","type":"text"},{"text":"background (","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true,"type":"reference"},{"text":"). See ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Track-from-code-and-from-views","type":"heading","level":3,"text":"Track from code and from views"},{"inlineContent":[{"type":"text","text":"Code that changes something worth tracking tracks through "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":". The store’s cart"},{"type":"text","text":" "},{"type":"text","text":"tracks "},{"type":"codeVoice","code":"ProductAddedToCart"},{"type":"text","text":" as a product goes in, and throws before tracking anything when the"},{"type":"text","text":" "},{"type":"text","text":"quantity is out of range:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Product: Identifiable, Hashable {","    var id: String","    var name: String","    var priceInCents: Int","","    static let catalog = [","        Product(id: \"canvas-tote\", name: \"Canvas Tote\", priceInCents: 2_400),","        Product(id: \"enamel-mug\", name: \"Enamel Mug\", priceInCents: 1_800),","    ]","}","","struct QuantityOutOfRange: Error, Equatable {}","","struct Cart {","    struct Line: Equatable {","        var product: Product","        var quantity: Int","    }","","    private(set) var lines: [Line] = []","","    static let quantities = 1...10","","    mutating func add(_ product: Product, quantity: Int = 1) throws(QuantityOutOfRange) {","        guard Self.quantities.contains(quantity) else { throw QuantityOutOfRange() }","        lines.append(Line(product: product, quantity: quantity))","        Tracker.current.track(ProductAddedToCart(productID: product.id, quantity: quantity))","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"trackScreen(_:)","type":"codeVoice"},{"type":"text","text":", applied where a screen’s view is placed, tracks "},{"code":"ScreenViewed","type":"codeVoice"},{"type":"text","text":" each time it"},{"type":"text","text":" "},{"type":"text","text":"appears and stamps the events tracked inside it with the screen’s name. "},{"code":"Tracker.current","type":"codeVoice"},{"type":"text","text":" works in"},{"type":"text","text":" "},{"type":"text","text":"a button’s action too, because the app bootstrapped its tracker, but that tracker doesn’t know"},{"type":"text","text":" "},{"type":"text","text":"which screen the button is on. So the view binds the environment’s tracker around the cart’s"},{"type":"text","text":" "},{"type":"text","text":"change with "},{"code":"withTracker","type":"codeVoice"},{"type":"text","text":", and the event carries the screen’s name:"}],"type":"paragraph"},{"syntax":"swift","code":["struct StoreView: View {","    @State private var cart = Cart()","","    var body: some View {","        NavigationStack {","            List(Product.catalog) { product in","                NavigationLink(product.name) {","                    ProductView(product: product, cart: $cart)","                        .trackScreen(\"Product\")","                }","            }","            .trackScreen(\"Catalog\")","        }","    }","}","","struct ProductView: View {","    let product: Product","    @Binding var cart: Cart","    @Environment(\\.tracker) private var tracker","","    var body: some View {","        Button(\"Add to Cart\") {","            \/\/ The default quantity, 1, is in range, so the cart never refuses it.","            try? withTracker(tracker) { try cart.add(product) }","        }","        .navigationTitle(product.name)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"UIKit and AppKit find the tracker through a trait and the responder chain. See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","isActive":true,"type":"reference"},{"text":" for screens and controls that track","type":"text"},{"text":" ","type":"text"},{"text":"themselves.","type":"text"}],"type":"paragraph"},{"anchor":"Deliver-to-a-server","type":"heading","level":3,"text":"Deliver to a server"},{"inlineContent":[{"text":"A delivery batches the tracker’s records and hands each batch to its destinations. To send them","type":"text"},{"text":" ","type":"text"},{"text":"to a TraffluentCollector, deliver to an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" with a ","type":"text"},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"writes each record’s properties through the event’s schema in a ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":". Like the store,","type":"text"},{"text":" ","type":"text"},{"text":"the plan holds every event the app declares and the library’s own. ","type":"text"},{"type":"codeVoice","code":"redactingSensitiveValues()"},{"text":" ","type":"text"},{"text":"keeps the email address off this destination:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import TrackingPlans","","let plan = try TrackingPlan()","let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: CollectorBatchEncoder(plan: plan))","let delivery = tracker.records","    .batch()","    .deliver(to: collector.redactingSensitiveValues())","let delivering = Task { try await delivery.execute() }"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"batch()"},{"type":"text","text":" sends 20 records at a time, or every 30 seconds while any are waiting. Nothing runs until"},{"type":"text","text":" "},{"type":"codeVoice","code":"execute()"},{"type":"text","text":", and the delivery runs for as long as the tracker does, so start it once and keep the"},{"type":"text","text":" "},{"type":"text","text":"task if the app needs to stop it. A send that gets no response, a 5xx, 408 or 429 is sent again with backoff"},{"type":"text","text":" "},{"type":"text","text":"until it arrives, and the store keeps its records meanwhile. To send to PostHog instead, make the"},{"type":"text","text":" "},{"type":"text","text":"destination with "},{"type":"codeVoice","code":"HTTPDestination.postHog(projectToken:host:plan:)"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Watch-what-is-dropped","type":"heading","level":3,"text":"Watch what is dropped"},{"inlineContent":[{"type":"text","text":"Each event that doesn’t reach the server shows up in a report. The tracker reports a broken"},{"type":"text","text":" "},{"type":"text","text":"constraint, the consent a denied category, the store a record it couldn’t keep, the destination a"},{"type":"text","text":" "},{"type":"text","text":"batch the server refused, and the delivery a batch its full buffer dropped. Read every report in"},{"type":"text","text":" "},{"type":"text","text":"one task:"}],"type":"paragraph"},{"syntax":"swift","code":["let rejections = tracker.rejectionReports","let consentDrops = consent.dropReports","let storeDrops = store.dropReports","let collectorDrops = collector.dropReports","let bufferDrops = delivery.bufferDropReports","Task {","    await withDiscardingTaskGroup { group in","        group.addTask { for await report in rejections { print(\"Rejected: \\(report)\") } }","        group.addTask { for await report in consentDrops { print(\"Not consented: \\(report)\") } }","        group.addTask { for await report in storeDrops { print(\"Not stored: \\(report)\") } }","        group.addTask { for await report in collectorDrops { print(\"Not sent: \\(report)\") } }","        group.addTask { for await report in bufferDrops { print(\"Buffer full: \\(report)\") } }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"One task reads each stream at a time: a second reader waits, with a warning in the log, until the","type":"text"},{"text":" ","type":"text"},{"text":"first one’s iteration ends or its iterator is released. A reader that stops calling ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" but","type":"text"},{"text":" ","type":"text"},{"text":"keeps its iterator keeps the turn, so read each stream in one place and fan its reports out from","type":"text"},{"text":" ","type":"text"},{"text":"there. The task","type":"text"},{"text":" ","type":"text"},{"text":"reads the streams, not their owners, so it keeps no store, destination or delivery alive. The","type":"text"},{"text":" ","type":"text"},{"text":"store app merges them into one ","type":"text"},{"code":"AsyncQueue","type":"codeVoice"},{"text":" of its own type, ","type":"text"},{"code":"AnalyticsDrop","type":"codeVoice"},{"text":", so a second reader","type":"text"},{"text":" ","type":"text"},{"text":"of that waits its turn too, and logs each one.","type":"text"}],"type":"paragraph"},{"anchor":"Export-and-check-the-tracking-plan","type":"heading","level":3,"text":"Export and check the tracking plan"},{"inlineContent":[{"type":"text","text":"The tracking plan is a JSON Schema document for each event, committed beside the code, that the"},{"type":"text","text":" "},{"type":"text","text":"people and services reading the events can review. A small executable that lists the plan above"},{"type":"text","text":" "},{"type":"text","text":"writes it, and a check fails when the events no longer match it:"}],"type":"paragraph"},{"syntax":"sh","code":["swift package --allow-writing-to-package-directory export-tracking-plan","swift package check-tracking-plan"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","isActive":true},{"type":"text","text":" for the executable, the check from a test and catching breaking"},{"type":"text","text":" "},{"type":"text","text":"changes in CI."}],"type":"paragraph"},{"anchor":"Test-what-the-code-tracks","type":"heading","level":3,"text":"Test what the code tracks"},{"inlineContent":[{"type":"codeVoice","code":"withRecordingTracker"},{"type":"text","text":" binds a fresh tracker for the test’s body, which "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"cart reaches in place of the app’s, and returns what it tracked, so tests running at the same time"},{"type":"text","text":" "},{"type":"text","text":"never see each other’s events:"}],"type":"paragraph"},{"syntax":"swift","code":["import Testing","import TrackerTesting","","@Test(\"Adding a product tracks ProductAddedToCart with its identifier and the quantity\")","func add() async throws {","    let tote = Product(id: \"canvas-tote\", name: \"Canvas Tote\", priceInCents: 2_400)","    var sut = Cart()","    let expectedEvents = [ProductAddedToCart(productID: \"canvas-tote\", quantity: 2)]","    let expectedLines = [Cart.Line(product: tote, quantity: 2)]","","    let tracked = try await withRecordingTracker { try sut.add(tote, quantity: 2) }","","    #expect(tracked.events(of: ProductAddedToCart.self) == expectedEvents)","    #expect(sut.lines == expectedLines)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","interfaceLanguage":"swift"},"abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"variants":[{"paths":["\/documentation\/traffluent\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"],"anchor":"Essentials"}],"metadata":{"modules":[{"name":"Traffluent"}],"title":"Getting Started","roleHeading":"Article","role":"article"},"sections":[],"kind":"article","references":{"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"url":"\/documentation\/traffluent\/automatictracking","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","type":"topic","kind":"article","title":"Automatic Tracking","role":"article"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"type":"topic","title":"Sessions and Standard Context","kind":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"url":"\/documentation\/traffluent\/definingevents","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", and constrain which values its properties may hold."}],"kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","title":"Defining Events","role":"article"},"doc://Traffluent/documentation/Traffluent":{"role":"collection","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"type":"topic","title":"Traffluent","kind":"symbol","url":"\/documentation\/traffluent"},"doc://Traffluent/documentation/Traffluent/TestingWhatYouTrack":{"url":"\/documentation\/traffluent\/testingwhatyoutrack","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack","title":"Testing What Your Code Tracks","role":"article"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"type":"topic","title":"Choosing Destinations","kind":"article","url":"\/documentation\/traffluent\/choosingdestinations"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"url":"\/documentation\/posthogencoding","abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","title":"PostHogEncoding","role":"collection"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"topic","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"title":"Exporting and Checking a Tracking Plan","kind":"article","url":"\/documentation\/traffluent\/trackingplanworkflow"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"url":"\/documentation\/traffluent\/consentgating","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","kind":"article","type":"topic","title":"Consent Gating","role":"article"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"type":"topic","title":"Tracking from SwiftUI, UIKit and AppKit","kind":"article","url":"\/documentation\/traffluent\/trackingfromviews"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending.","type":"text"}],"kind":"article","type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","title":"Persisting Records","role":"article"},"https://github.com/Tyler-Keith-Thompson/Traffluent/tree/main/Examples":{"title":"Examples","titleInlineContent":[{"type":"codeVoice","code":"Examples"}],"identifier":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/tree\/main\/Examples","type":"link"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"type":"topic","title":"Tracking Events","kind":"article","url":"\/documentation\/traffluent\/trackingevents"}}}