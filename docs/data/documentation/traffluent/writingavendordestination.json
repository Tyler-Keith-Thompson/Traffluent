and nothing is reported: the encoder’s "},{"type":"codeVoice","code":"BatchEncoder.outcome(of:for:)"},{"type":"text","text":" counts an"},{"type":"text","text":" "},{"type":"text","text":"answer it can’t read as delivered, so a vendor’s answer that changes shape never makes the"},{"type":"text","text":" "},{"type":"text","text":"destination send the same request again and again, or drop what the vendor stored."}],"title":"ConformanceCheck.unreadableSuccessDelivered","kind":"symbol","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unreadableSuccessDelivered","kind":"identifier"}],"url":"\/documentation\/destinationtesting\/conformancecheck\/unreadablesuccessdelivered"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/sensitiveValuesRedacted":{"role":"symbol","title":"ConformanceCheck.sensitiveValuesRedacted","abstract":[{"type":"text","text":"A "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" value is never sent by the default destination, even by a record that reveals"},{"type":"text","text":" "},{"type":"text","text":"it. With the adopter’s opt-in, it is sent while the record reveals it, and not once the"},{"type":"text","text":" "},{"type":"text","text":"record is redacted."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","type":"topic","url":"\/documentation\/destinationtesting\/conformancecheck\/sensitivevaluesredacted","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sensitiveValuesRedacted","kind":"identifier"}],"kind":"symbol"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/oversizedRecordSkipped":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","type":"topic","title":"ConformanceCheck.oversizedRecordSkipped","abstract":[{"type":"text","text":"A record too large f