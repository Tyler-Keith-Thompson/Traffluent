{"variants":[{"paths":["\/documentation\/traffluent\/writingavendordestination"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Traffluent"}],"title":"Writing a Vendor Destination"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"},"kind":"article","sections":[],"abstract":[{"text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A vendor destination is an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" with an encoder that writes the vendor’s ingestion"},{"type":"text","text":" "},{"type":"text","text":"format. "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" already does the batching, retries, drop reports and trace context, so the"},{"type":"text","text":" "},{"type":"text","text":"vendor module adds three things:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"an encoder, a ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" that writes each record as the vendor’s JSON and splits a batch to","type":"text"},{"text":" ","type":"text"},{"text":"the vendor’s limits;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a factory on "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" that checks what the adopter passes and fills in the endpoint, the"},{"type":"text","text":" "},{"type":"text","text":"encoder and the limits, so setup is one call;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"tests that run "},{"type":"codeVoice","code":"DestinationTesting"},{"type":"text","text":"’s conformance checks and compare its requests with recorded"},{"type":"text","text":" "},{"type":"text","text":"fixtures."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Write the encoder against the vendor’s public HTTP API, not its SDK, so the app links nothing of","type":"text"},{"text":" ","type":"text"},{"text":"the vendor’s. ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","type":"reference","isActive":true},{"text":" is built this way and is a full example to copy.","type":"text"}],"type":"paragraph"},{"level":3,"text":"The module","type":"heading","anchor":"The-module"},{"inlineContent":[{"text":"Make the module depend on ","type":"text"},{"code":"HTTPDestinations","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PropertyJSON","type":"codeVoice"},{"text":", ","type":"text"},{"code":"JSONValues","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"TrackingPlans","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and on swift-distributed-tracing’s ","type":"text"},{"code":"Instrumentation","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"NoOpInstrument","type":"codeVoice"},{"text":". Its tests depend on","type":"text"},{"text":" ","type":"text"},{"code":"DestinationTesting","type":"codeVoice"},{"text":" as well. ","type":"text"},{"code":"PropertyJSON","type":"codeVoice"},{"text":" holds the vendor-neutral pieces an encoder is built","type":"text"},{"text":" ","type":"text"},{"text":"from, ","type":"text"},{"code":"JSONValues","type":"codeVoice"},{"text":" the ","type":"text"},{"code":"JSON","type":"codeVoice"},{"text":" value it writes, and ","type":"text"},{"code":"TrackingPlans","type":"codeVoice"},{"text":" the app’s ","type":"text"},{"code":"TrackingPlan","type":"codeVoice"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"the encoder reads properties through. ","type":"text"},{"code":"DestinationTesting","type":"codeVoice"},{"text":" imports Swift Testing, so it goes in","type":"text"},{"text":" ","type":"text"},{"text":"test targets only.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".target(name: \"AcmeEncoding\", dependencies: [","    .product(name: \"HTTPDestinations\", package: \"Traffluent\"),","    .product(name: \"PropertyJSON\", package: \"Traffluent\"),","    .product(name: \"JSONValues\", package: \"Traffluent\"),","    .product(name: \"TrackingPlans\", package: \"Traffluent\"),","    .product(name: \"Instrumentation\", package: \"swift-distributed-tracing\"),","]),",".testTarget(name: \"AcmeEncodingTests\", dependencies: [","    \"AcmeEncoding\",","    .product(name: \"DestinationTesting\", package: \"Traffluent\"),","], resources: [.copy(\"Fixtures\")]),"]},{"level":3,"text":"The encoder","type":"heading","anchor":"The-encoder"},{"inlineContent":[{"type":"text","text":"The examples here are for Acme, a made-up vendor whose API takes"},{"type":"text","text":" "},{"type":"codeVoice","code":"{\"api_key\": …, \"events\": [{\"event\", \"user_id\", \"insert_id\", \"time\", \"properties\", \"context\"}]}"},{"type":"text","text":" "},{"type":"text","text":"and allows at most 500 events and 1,000,000 bytes a request, and 32,000 bytes an event."},{"type":"text","text":" "},{"type":"codeVoice","code":"PropertyJSON"},{"type":"text","text":" supplies each piece of such a record:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads an event’s properties through its schema in the app’s "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"leaving out "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values unless you ask for them and the record reveals them."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EventRecord.standardContext"},{"type":"text","text":" is the app, device, locale, network and operating system as JSON,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"flattened(separator:)"},{"type":"text","text":" turns it into the one level of dotted keys most vendors take."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Date.iso8601Timestamp"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Date.millisecondsSince1970()"},{"text":" are the two timestamp formats vendors","type":"text"},{"text":" ","type":"text"},{"text":"ask for.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"EventRecord.pseudonymousIdentity"},{"type":"text","text":" is who the event is about: the record’s session, or the record"},{"type":"text","text":" "},{"type":"text","text":"itself when it has none, and never a person ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople"},{"type":"text","text":"). "},{"type":"codeVoice","code":"deduplicationID"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"identifier a vendor drops repeats by, which a redelivered record keeps."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"BatchLimit.requests(for:in:encoding:oversized:)","type":"codeVoice"},{"type":"text","text":" splits a batch into requests of a"},{"type":"text","text":" "},{"code":"JSONEnvelope","type":"codeVoice"},{"type":"text","text":" within the vendor’s limits, and leaves out a record that fits in none of them."}]}]}]},{"syntax":"swift","type":"codeListing","code":["\/\/\/ Why the Acme encoder left a record out.","enum AcmeEncodingError: Error, Hashable {","    case unreadable(PropertyReadingError)","    case contextKeyCollision(key: String)","    case unrepresentableTimestamp","    case oversized(byteCount: Int)","}","","struct AcmeBatchEncoder: BatchEncoder {","    \/\/\/ Acme's limits on one request.","    static let batchLimit = (try? BatchLimit(maximumRecordCount: 500, maximumByteCount: 1_000_000, maximumRecordByteCount: 32_000)) ?? .unlimited","","    typealias Failure = AcmeEncodingError","","    private let reader: PropertyReader","    private let envelope: JSONEnvelope","","    init(apiKey: String, plan: TrackingPlan) {","        reader = PropertyReader(plan: plan)","        envelope = JSONEnvelope([\"api_key\": .string(apiKey)], arrayMember: \"events\")","    }","","    func requests(for batch: [EventRecord]) -> BatchRequests<AcmeEncodingError> {","        Self.batchLimit.requests(for: batch, in: envelope) { record throws(AcmeEncodingError) in","            try json(of: record)","        } oversized: { byteCount in","            .oversized(byteCount: byteCount)","        }","    }","","    private func json(of record: EventRecord) throws(AcmeEncodingError) -> JSON {","        let properties: [String: JSON]","        do {","            properties = try reader.properties(of: record, includingSensitiveValues: false)","        } catch {","            throw .unreadable(error)","        }","        let context: [String: JSON]","        do {","            context = try record.standardContext.flattened()","        } catch {","            throw .contextKeyCollision(key: error.key)","        }","        let time: Int64","        do {","            time = try record.timestamp.millisecondsSince1970()","        } catch {","            throw .unrepresentableTimestamp","        }","        return .object([","            \"event\": .string(record.name),","            \"user_id\": .string(record.pseudonymousIdentity.uuid.uuidString.lowercased()),","            \"insert_id\": .string(record.deduplicationID),","            \"time\": .integer(time),","            \"properties\": .object(properties),","            \"context\": .object(context),","        ])","    }","}"]},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" implements "},{"type":"codeVoice","code":"requests(for:)"},{"type":"text","text":" and declares "},{"type":"codeVoice","code":"transientStatuses"},{"type":"text","text":" and "},{"type":"codeVoice","code":"outcome(of:for:)"},{"type":"text","text":" (below), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Failure"},{"type":"text","text":" names the reason a record is left out, as "},{"type":"codeVoice","code":"requests(for:)"},{"type":"text","text":" doesn’t throw. "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends the requests in order, and"},{"type":"text","text":" "},{"type":"text","text":"reports each record left out as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":". Pass "},{"type":"codeVoice","code":"includingSensitiveValues: true"},{"type":"text","text":" only if the"},{"type":"text","text":" "},{"type":"text","text":"vendor’s terms allow the values, and then only through a factory the adopter opts in with."}],"type":"paragraph"},{"inlineContent":[{"text":"If the vendor misdates or ignores an event past some age but still answers 2xx, pass an age a","type":"text"},{"text":" ","type":"text"},{"text":"little short of it to ","type":"text"},{"code":"limit.requests(for:in:maximumAge:encoding:oversized:)","type":"codeVoice"},{"text":", which throws","type":"text"},{"text":" ","type":"text"},{"code":"NegativeMaximumAge","type":"codeVoice"},{"text":" for one below zero. The spare time covers a request’s trip to the vendor and","type":"text"},{"text":" ","type":"text"},{"text":"clocks that disagree. Each request then has a deadline that long after its oldest record was","type":"text"},{"text":" ","type":"text"},{"text":"tracked, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops a request still being retried by then, all of its records, and","type":"text"},{"text":" ","type":"text"},{"text":"reports it as ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":", rather than send records the","type":"text"},{"text":" ","type":"text"},{"text":"vendor would store wrongly. Have the factory pass its ","type":"text"},{"code":"now:","type":"codeVoice"},{"text":" to both the encoder and the","type":"text"},{"text":" ","type":"text"},{"text":"destination, so one clock decides what is encoded and what is sent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries no response, a 5xx, 408 and 429, and drops a request answered with any"},{"type":"text","text":" "},{"type":"text","text":"other status. Every encoder declares "},{"type":"codeVoice","code":"transientStatuses"},{"type":"text","text":", as there is no default: "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" when the"},{"type":"text","text":" "},{"type":"text","text":"vendor answers only those to a request worth sending again. If it answers some other failure for"},{"type":"text","text":" "},{"type":"text","text":"one, list that status, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries it too. A "},{"type":"codeVoice","code":"TransientStatus"},{"type":"text","text":" is a client or server error (4xx or 5xx); any other status throws"},{"type":"text","text":" "},{"type":"codeVoice","code":"InvalidTransientStatus"},{"type":"text","text":", as a 2xx is read by "},{"type":"codeVoice","code":"outcome(of:for:)"},{"type":"text","text":" instead (below):"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension AcmeBatchEncoder {","    \/\/\/ Acme answers 425 Too Early while a new region starts up, and takes the request later.","    static let transientStatuses: Set<TransientStatus> = (try? TransientStatus(425)).map { [$0] } ?? []","}"]},{"inlineContent":[{"type":"text","text":"The set belongs to the encoder’s type, so every destination made with that encoder retries those"},{"type":"text","text":" "},{"type":"text","text":"statuses, whether it comes from the factory or not. The conformance checks read it too. An encoder"},{"type":"text","text":" "},{"type":"text","text":"that wraps another, to filter or rename records, forwards the inner encoder’s set"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"static var transientStatuses: Set<TransientStatus> { Inner.transientStatuses }"},{"type":"text","text":"), or the"},{"type":"text","text":" "},{"type":"text","text":"vendor’s retries are lost."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every encoder implements "},{"type":"codeVoice","code":"outcome(of:for:)"},{"type":"text","text":" too, which is called for every 2xx answer, with its status"},{"type":"text","text":" "},{"type":"text","text":"and body. Return "},{"type":"codeVoice","code":".delivered"},{"type":"text","text":" when the vendor documents no 2xx that means “not stored”. If the"},{"type":"text","text":" "},{"type":"text","text":"vendor answers 200 and says in the body that it stored nothing, read that answer: return "},{"type":"codeVoice","code":".rejected(reason:)"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"one that will never be stored, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops and reports as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.rejectedInBody(status:reason:recordIDs:)"},{"type":"text","text":", and "},{"type":"codeVoice","code":".transient(reason:)"},{"type":"text","text":" for one worth"},{"type":"text","text":" "},{"type":"text","text":"sending again, which it retries like a 5xx. Return "},{"type":"codeVoice","code":".delivered"},{"type":"text","text":" for a body you can’t read, an"},{"type":"text","text":" "},{"type":"text","text":"empty one included, as a proxy or a changed API might answer; otherwise the request would be"},{"type":"text","text":" "},{"type":"text","text":"resent or dropped for an answer the vendor never documented. Cite the documentation the answer"},{"type":"text","text":" "},{"type":"text","text":"comes from in a comment:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension AcmeBatchEncoder {","    private struct Answer: Decodable {","        let accepted: Bool","        let error: String?","    }","","    \/\/ Acme's ingestion reference answers 200 with {\"accepted\": false, \"error\": \"...\"} for an","    \/\/ unknown API key, and {\"accepted\": true} for a request it stored.","    static func outcome(of response: HTTPTransportResponse, for request: EncodedRequest) -> ResponseOutcome {","        guard let answer = try? JSONDecoder().decode(Answer.self, from: response.body), !answer.accepted else {","            return .delivered","        }","        return .rejected(reason: answer.error ?? \"Acme accepted none of the request\")","    }","}"]},{"inlineContent":[{"type":"text","text":"An encoder that wraps another forwards its "},{"type":"codeVoice","code":"outcome(of:for:)"},{"type":"text","text":" the same way"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"static func outcome(of response: HTTPTransportResponse, for request: EncodedRequest) -> ResponseOutcome { Inner.outcome(of: response, for: request) }"},{"type":"text","text":")."}],"type":"paragraph"},{"level":3,"text":"The factory","type":"heading","anchor":"The-factory"},{"inlineContent":[{"text":"The factory is a static method on ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" constrained to the encoder, so adopters write","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"try HTTPDestination.acme(...)"},{"text":". It throws a typed error for input the vendor would refuse, so a","type":"text"},{"text":" ","type":"text"},{"text":"mistake shows up at launch, not later as a stream of rejected requests. It also takes a transport","type":"text"},{"text":" ","type":"text"},{"text":"and a backoff, which the conformance checks need. It passes ","type":"text"},{"type":"codeVoice","code":"NoOpInstrument()"},{"text":", so no request","type":"text"},{"text":" ","type":"text"},{"text":"carries the app’s trace context to the vendor, whatever tracer the app bootstraps.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/\/ Why the Acme factory couldn't make a destination.","enum AcmeSetupError: Error, Hashable {","    case emptyAPIKey","    case invalidHost","}","","extension HTTPDestination where Encoding == AcmeBatchEncoder {","    static func acme(","        apiKey: String,","        host: URL,","        plan: TrackingPlan,","        transport: Transport,","        backoff: ExponentialBackoff = ExponentialBackoff()","    ) throws(AcmeSetupError) -> HTTPDestination<Transport, AcmeBatchEncoder> {","        guard !apiKey.isEmpty else { throw .emptyAPIKey }","        guard host.scheme == \"https\", host.host() != nil else { throw .invalidHost }","        return HTTPDestination(","            endpoint: host.appending(path: \"v1\/events\"),","            \/\/ Acme doesn't read a trace context, so the app's traces aren't sent to it.","            instrument: NoOpInstrument(),","            transport: transport,","            encoder: AcmeBatchEncoder(apiKey: apiKey, plan: plan),","            backoff: backoff)","    }","}"]},{"inlineContent":[{"type":"text","text":"Offer an overload without "},{"code":"transport:","type":"codeVoice"},{"type":"text","text":" that passes "},{"code":"URLSessionTransport()","type":"codeVoice"},{"type":"text","text":", as PostHog’s does, so"},{"type":"text","text":" "},{"type":"text","text":"an app needn’t name one."}],"type":"paragraph"},{"level":3,"text":"The conformance checks","type":"heading","anchor":"The-conformance-checks"},{"inlineContent":[{"type":"codeVoice","code":"DestinationConformance"},{"text":" runs the checks every vendor destination must pass. Give it the vendor’s","type":"text"},{"text":" ","type":"text"},{"text":"limit and a closure that calls the factory with the setup’s plan, transport and backoff:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted"},{"type":"text","text":": no "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is sent"},{"type":"text","text":" "},{"type":"text","text":"without the adopter’s opt-in."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","type":"reference","isActive":true},{"type":"text","text":": behind consent and "},{"code":"accepting(_:)","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"destination sends exactly the records it is handed."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","isActive":true,"type":"reference"},{"text":": a record over the limit is","type":"text"},{"text":" ","type":"text"},{"text":"skipped and reported.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","isActive":true},{"type":"text","text":": failures are retried or dropped as"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" classifies them, the encoder’s "},{"code":"transientStatuses","type":"codeVoice"},{"type":"text","text":" among the retried ones."}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/unreadableSuccessDelivered"},{"type":"text","text":": a 2xx whose body the"},{"type":"text","text":" "},{"type":"text","text":"encoder can’t read, an empty one included, counts as delivered: sent once, nothing reported."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld","isActive":true},{"type":"text","text":": no request carries a trace context,"},{"type":"text","text":" "},{"type":"text","text":"even while a tracer is active."}]}]}]},{"inlineContent":[{"code":"expectRequests(of:plan:matchFixture:withExtension:subdirectory:in:sourceLocation:)","type":"codeVoice"},{"text":" compares the","type":"text"},{"text":" ","type":"text"},{"text":"requests a hand-worked batch makes with a fixture in the test target’s resources, byte for byte.","type":"text"},{"text":" ","type":"text"},{"text":"When the fixture is missing, the issue it records holds the requests, so you can check them by hand","type":"text"},{"text":" ","type":"text"},{"text":"against the vendor’s documentation and save them as the fixture.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Test(arguments: ConformanceCheck.allCases)","func acmeConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/acme.example.com\"))","    let conformance = DestinationConformance(limit: AcmeBatchEncoder.batchLimit) { setup in","        try HTTPDestination.acme(apiKey: \"test-key\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"]},{"inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for each rule the destination breaks. The kit is a"},{"type":"text","text":" "},{"type":"text","text":"shared assertion on purpose, so every vendor module runs the same checks. Every check’s records are"},{"type":"text","text":" "},{"type":"text","text":"tracked at "},{"type":"codeVoice","code":"setup.timestamp"},{"type":"text","text":"; if your encoder leaves out records older than the vendor takes, give"},{"type":"text","text":" "},{"type":"text","text":"it that as the time it encodes at, as "},{"type":"codeVoice","code":"GoogleAnalyticsEncoding"},{"type":"text","text":"’s tests do."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"],"title":"Guides","generated":true,"anchor":"Guides"}],"references":{"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","type":"topic","role":"collection","url":"\/documentation\/traffluent","title":"Traffluent","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"kind":"symbol"},"doc://Traffluent/documentation/Traffluent/ConsentGating":{"role":"article","type":"topic","title":"Consent Gating","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","abstract":[{"type":"text","text":"Deliver an event only once the user grants the purpose it is collected for."}],"url":"\/documentation\/traffluent\/consentgating"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","role":"article","url":"\/documentation\/traffluent\/definingevents","title":"Defining Events","abstract":[{"text":"Derive an event’s conformances and schema from its declaration with ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":", and constrain which values its properties may hold.","type":"text"}],"kind":"article"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/transientFailuresRetried":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/transientFailuresRetried","type":"topic","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/transientfailuresretried","title":"ConformanceCheck.transientFailuresRetried","abstract":[{"type":"text","text":"A request that gets no response, a 5xx, 408, 429 or a status of the encoder’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"BatchEncoder.transientStatuses"},{"type":"text","text":" is sent again, byte for byte, until it is delivered, and"},{"type":"text","text":" "},{"type":"text","text":"nothing is reported."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientFailuresRetried","kind":"identifier"}]},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"role":"article","type":"topic","title":"Persisting Records","url":"\/documentation\/traffluent\/persistingrecords","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","kind":"article"},"doc://Traffluent/documentation/Traffluent/IdentifyingPeople":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/IdentifyingPeople","type":"topic","role":"article","url":"\/documentation\/traffluent\/identifyingpeople","title":"Identifying People","abstract":[{"type":"text","text":"Traffluent knows people only by a pseudonymous session. An identifier that outlives one is yours to add, store, reset and gate with consent."}],"kind":"article"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","type":"topic","role":"article","url":"\/documentation\/traffluent\/sessionsandstandardcontext","title":"Sessions and Standard Context","abstract":[{"text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on.","type":"text"}],"kind":"article"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/consentHolds":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"consentHolds"}],"abstract":[{"text":"Behind a tracker’s ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":" and the destination’s ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":", the destination sends","type":"text"},{"text":" ","type":"text"},{"text":"the event of a granted category it accepts, and not the event of a denied category or of","type":"text"},{"text":" ","type":"text"},{"text":"one it doesn’t accept.","type":"text"}],"title":"ConformanceCheck.consentHolds","kind":"symbol","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/consentHolds","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/consentholds","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/traceContextWithheld":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/traceContextWithheld","type":"topic","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/tracecontextwithheld","title":"ConformanceCheck.traceContextWithheld","abstract":[{"type":"text","text":"No request carries a trace context in its header fields ("},{"type":"codeVoice","code":"traceparent"},{"type":"text","text":", "},{"type":"codeVoice","code":"tracestate"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"text","text":"whatever the instrument injects), even while a tracer is active and the record was tracked"},{"type":"text","text":" "},{"type":"text","text":"in a span: a vendor’s destination passes "},{"type":"codeVoice","code":"NoOpInstrument()"},{"type":"text","text":", so the app’s traces stay in"},{"type":"text","text":" "},{"type":"text","text":"the app."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"traceContextWithheld"}]},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/sensitiveValuesRedacted":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"sensitiveValuesRedacted"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/sensitiveValuesRedacted","title":"ConformanceCheck.sensitiveValuesRedacted","kind":"symbol","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent by the default destination, even by a record that reveals"},{"type":"text","text":" "},{"type":"text","text":"it. With the adopter’s opt-in, it is sent while the record reveals it, and not once the"},{"type":"text","text":" "},{"type":"text","text":"record is redacted."}],"role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/sensitivevaluesredacted","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/unreadableSuccessDelivered":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/unreadableSuccessDelivered","type":"topic","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/unreadablesuccessdelivered","title":"ConformanceCheck.unreadableSuccessDelivered","abstract":[{"type":"text","text":"A request answered 2xx with a body no vendor writes, an empty one or one that isn’t JSON,"},{"type":"text","text":" "},{"type":"text","text":"is sent once and nothing is reported: the encoder’s "},{"code":"BatchEncoder.outcome(of:for:)","type":"codeVoice"},{"type":"text","text":" counts an"},{"type":"text","text":" "},{"type":"text","text":"answer it can’t read as delivered, so a vendor’s answer that changes shape never makes the"},{"type":"text","text":" "},{"type":"text","text":"destination send the same request again and again, or drop what the vendor stored."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unreadableSuccessDelivered","kind":"identifier"}]},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/rejectionsDropped":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejectionsDropped","kind":"identifier"}],"abstract":[{"text":"A request answered with a status retrying won’t change (400, 401, 403, 404, 413, 422, less","type":"text"},{"text":" ","type":"text"},{"text":"any the encoder lists in ","type":"text"},{"code":"BatchEncoder.transientStatuses","type":"codeVoice"},{"text":") is sent once and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.rejected(status:recordIDs:)","type":"codeVoice"},{"text":". An encoder that lists all six is checked","type":"text"},{"text":" ","type":"text"},{"text":"with the first client error (4xx) it doesn’t list; one that lists every client error","type":"text"},{"text":" ","type":"text"},{"text":"records an issue, as no rejection is left to check.","type":"text"}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/rejectionsDropped","kind":"symbol","title":"ConformanceCheck.rejectionsDropped","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/rejectionsdropped","type":"topic"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"role":"article","type":"topic","title":"Automatic Tracking","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","abstract":[{"text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen.","type":"text"}],"url":"\/documentation\/traffluent\/automatictracking"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","type":"topic","role":"article","url":"\/documentation\/traffluent\/samplingevents","title":"Sampling Events","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"kind":"article"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"topic","role":"article","url":"\/documentation\/traffluent\/trackingplanworkflow","title":"Exporting and Checking a Tracking Plan","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"kind":"article"},"doc://PostHogEncoding/documentation/PostHogEncoding":{"role":"collection","type":"topic","title":"PostHogEncoding","url":"\/documentation\/posthogencoding","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","abstract":[{"text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API.","type":"text"}],"kind":"symbol"},"doc://DestinationTesting/documentation/DestinationTesting/ConformanceCheck/oversizedRecordSkipped":{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck\/oversizedRecordSkipped","type":"topic","role":"symbol","url":"\/documentation\/destinationtesting\/conformancecheck\/oversizedrecordskipped","title":"ConformanceCheck.oversizedRecordSkipped","abstract":[{"type":"text","text":"A record too large for the vendor’s limit is left out and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", and the batch’s other records are sent."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oversizedRecordSkipped","kind":"identifier"}]}}}