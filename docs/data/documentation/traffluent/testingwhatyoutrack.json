{"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"abstract":[{"text":"Run a test’s body with a fresh tracker and check the events it tracked.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"]}],"variants":[{"paths":["\/documentation\/traffluent\/testingwhatyoutrack"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Article","role":"article","title":"Testing What Your Code Tracks"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"Add the "},{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","type":"reference","isActive":true},{"type":"text","text":" product to the test target. "},{"code":"withRecordingTracker","type":"codeVoice"},{"type":"text","text":" binds a fresh"},{"type":"text","text":" "},{"type":"text","text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in"},{"type":"text","text":" "},{"type":"text","text":"order. Here "},{"code":"SignedUp","type":"codeVoice"},{"type":"text","text":" is "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"]},{"inlineContent":[{"type":"text","text":"Each call has a tracker of its own, so tests running at the same time never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. The body may be sync or async, and may return a value, read as "},{"type":"codeVoice","code":"tracked.value"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"tracked.names"},{"type":"text","text":" lists every event’s name and "},{"type":"codeVoice","code":"tracked.records"},{"type":"text","text":" every record."}],"type":"paragraph"},{"inlineContent":[{"text":"Most code needs nothing more: it tracks through ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":", which falls back to the tracker","type":"text"},{"text":" ","type":"text"},{"text":"the app bootstrapped, and the test’s binding wins over that one. A view whose tracker was never set","type":"text"},{"text":" ","type":"text"},{"text":"that binds its tracker with ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":" reaches the test’s tracker too. Pass a tracker instead where the","type":"text"},{"text":" ","type":"text"},{"text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with ","type":"text"},{"code":"tracker(_:)","type":"codeVoice"},{"text":", such as a preview’s,","type":"text"},{"text":" ","type":"text"},{"text":"reaches the view’s environment but not code that reads ","type":"text"},{"code":"Tracker.current","type":"codeVoice"},{"text":". Such a test takes the","type":"text"},{"text":" ","type":"text"},{"text":"tracker the body is given and sets it on the view: ","type":"text"},{"code":"withRecordingTracker { tracker in … }","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Traffluent/documentation/Traffluent":{"role":"collection","type":"topic","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","url":"\/documentation\/traffluent","kind":"symbol","title":"Traffluent"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"type":"topic","url":"\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","kind":"article","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}]},"doc://TrackerTesting/documentation/TrackerTesting":{"abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"title":"TrackerTesting","kind":"symbol","type":"topic","url":"\/documentation\/trackertesting","role":"collection","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"kind":"article","url":"\/documentation\/traffluent\/gettingstarted","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","role":"article","title":"Getting Started","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"type":"topic"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"title":"Tracking from SwiftUI, UIKit and AppKit","kind":"article","type":"topic","url":"\/documentation\/traffluent\/trackingfromviews","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","type":"topic","abstract":[{"text":"Track typed events with a tracker, then deliver them in batches to any number of destinations.","type":"text"}],"url":"\/documentation\/traffluent\/trackingevents","kind":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","title":"Tracking Events"}}}