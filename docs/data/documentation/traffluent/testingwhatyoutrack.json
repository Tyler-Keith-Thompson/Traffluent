"code":"tracked.value","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"tracked.names","type":"codeVoice"},{"text":" lists every event’s name and ","type":"text"},{"code":"tracked.records","type":"codeVoice"},{"text":" every record.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Most code needs nothing more: it tracks through "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":", which falls back to the tracker"},{"type":"text","text":" "},{"type":"text","text":"the app bootstrapped, and the test’s binding wins over that one. A view whose tracker was never set"},{"type":"text","text":" "},{"type":"text","text":"that binds its tracker with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" reaches the test’s tracker too. Pass a tracker instead where the"},{"type":"text","text":" "},{"type":"text","text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", such as a preview’s,"},{"type":"text","text":" "},{"type":"text","text":"reaches the view’s environment but not code that reads "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":". Such a test takes the"},{"type":"text","text":" "},{"type":"text","text":"tracker the body is given and sets it on the view: "},{"type":"codeVoice","code":"withRecordingTracker { tracker in … }"},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/testingwhatyoutrack"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Article","title":"Testing What Your Code Tracks","modules":[{"name":"Traffluent"}],"role":"article"},"kind":"article","hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"references":{"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/docum