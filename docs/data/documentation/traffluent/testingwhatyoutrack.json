{"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"kind":"article","sections":[],"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"title":"Essentials","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"metadata":{"role":"article","title":"Testing What Your Code Tracks","modules":[{"name":"Traffluent"}],"roleHeading":"Article"},"abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","type":"reference","isActive":true},{"text":" product to the test target. ","type":"text"},{"code":"withRecordingTracker","type":"codeVoice"},{"text":" binds a fresh","type":"text"},{"text":" ","type":"text"},{"text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in","type":"text"},{"text":" ","type":"text"},{"text":"order. Here ","type":"text"},{"code":"SignedUp","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"]},{"type":"paragraph","inlineContent":[{"text":"Each call has a tracker of its own, so tests running at the same time never see each other’s","type":"text"},{"text":" ","type":"text"},{"text":"events. The body may be sync or async, and may return a value, read as ","type":"text"},{"code":"tracked.value","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"tracked.names","type":"codeVoice"},{"text":" lists every event’s name and ","type":"text"},{"code":"tracked.records","type":"codeVoice"},{"text":" every record.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most code needs nothing more: it tracks through "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":", which falls back to the tracker"},{"type":"text","text":" "},{"type":"text","text":"the app bootstrapped, and the test’s binding wins over that one. A view whose tracker was never set"},{"type":"text","text":" "},{"type":"text","text":"that binds its tracker with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" reaches the test’s tracker too. Pass a tracker instead where the"},{"type":"text","text":" "},{"type":"text","text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", such as a preview’s,"},{"type":"text","text":" "},{"type":"text","text":"reaches the view’s environment but not code that reads "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":". Such a test takes the"},{"type":"text","text":" "},{"type":"text","text":"tracker the body is given and sets it on the view: "},{"type":"codeVoice","code":"withRecordingTracker { tracker in … }"},{"type":"text","text":"."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/testingwhatyoutrack"]}],"references":{"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"role":"article","url":"\/documentation\/traffluent\/trackingfromviews","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","abstract":[{"text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do.","type":"text"}],"kind":"article","title":"Tracking from SwiftUI, UIKit and AppKit","type":"topic"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","type":"topic","title":"Choosing Destinations","abstract":[{"text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see.","type":"text"}],"role":"article","kind":"article","url":"\/documentation\/traffluent\/choosingdestinations"},"doc://Traffluent/documentation/Traffluent":{"role":"collection","type":"topic","title":"Traffluent","url":"\/documentation\/traffluent","kind":"symbol","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}]},"doc://TrackerTesting/documentation/TrackerTesting":{"role":"collection","url":"\/documentation\/trackertesting","identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","kind":"symbol","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"title":"TrackerTesting","type":"topic"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","title":"Getting Started","abstract":[{"text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks.","type":"text"}],"role":"article","kind":"article","url":"\/documentation\/traffluent\/gettingstarted"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"role":"article","url":"\/documentati