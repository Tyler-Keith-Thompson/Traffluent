{"kind":"article","sections":[],"metadata":{"modules":[{"name":"Traffluent"}],"roleHeading":"Article","role":"article","title":"Testing What Your Code Tracks"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked."}],"variants":[{"paths":["\/documentation\/traffluent\/testingwhatyoutrack"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"title":"Essentials","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews"],"anchor":"Essentials"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","isActive":true,"type":"reference"},{"text":" product to the test target. ","type":"text"},{"code":"withRecordingTracker","type":"codeVoice"},{"text":" binds a fresh","type":"text"},{"text":" ","type":"text"},{"text":"tracker to the test’s task for the length of its body, then returns every event tracked in it, in","type":"text"},{"text":" ","type":"text"},{"text":"order. Here ","type":"text"},{"code":"SignedUp","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["import Testing","import TrackerTesting","","@Test func signingUpTracksThePlan() async {","    let tracked = await withRecordingTracker {","        Tracker.current.track(SignedUp(plan: \"pro\"))","    }","    #expect(tracked.events(of: SignedUp.self) == [SignedUp(plan: \"pro\")])","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call has a tracker of its own, so tests running at the same time never see each other’s"},{"type":"text","text":" "},{"type":"text","text":"events. The body may be sync or async, and may return a value, read as "},{"code":"tracked.value","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"code":"tracked.names","type":"codeVoice"},{"type":"text","text":" lists every event’s name and "},{"code":"tracked.records","type":"codeVoice"},{"type":"text","text":" every record."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most code needs nothing more: it tracks through "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":", which falls back to the tracker"},{"type":"text","text":" "},{"type":"text","text":"the app bootstrapped, and the test’s binding wins over that one. A view whose tracker was never set"},{"type":"text","text":" "},{"type":"text","text":"that binds its tracker with "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" reaches the test’s tracker too. Pass a tracker instead where the"},{"type":"text","text":" "},{"type":"text","text":"code reads one set for a single view tree. A tracker given to a SwiftUI view with "},{"type":"codeVoice","code":"tracker(_:)"},{"type":"text","text":", such as a preview’s,"},{"type":"text","text":" "},{"type":"text","text":"reaches the view’s environment but not code that reads "},{"type":"codeVoice","code":"Tracker.current"},{"type":"text","text":". Such a test takes the"},{"type":"text","text":" "},{"type":"text","text":"tracker the body is given and sets it on the view: "},{"type":"codeVoice","code":"withRecordingTracker { tracker in … }"},{"type":"text","text":"."}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/TestingWhatYouTrack"},"references":{"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"title":"Traffluent","url":"\/documentation\/traffluent","type":"topic","role":"collection","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://Traffluent/documentation/Traffluent/ChoosingDestinations":{"kind":"article","url":"\/documentation\/traffluent\/choosingdestinations","role":"article","title":"Choosing Destinations","abstract":[{"type":"text","text":"Deliver events to your logs, your traces, a server or memory, and decide what each destination may see."}],"type":"topic","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/ChoosingDestinations"},"doc://TrackerTesting/documentation/TrackerTesting":{"kind":"symbol","abstract":[{"type":"text","text":"Run a test’s body with a fresh tracker and check the events it tracked, in order."}],"identifier":"doc:\/\/TrackerTesting\/documentation\/TrackerTesting","url":"\/documentation\/trackertesting","type":"topic","role":"collection","title":"TrackerTesting"},"doc://Traffluent/documentation/Traffluent/GettingStarted":{"kind":"article","url":"\/documentation\/traffluent\/gettingstarted","role":"article","type":"topic","abstract":[{"type":"text","text":"Add Traffluent to an app, declare its events, deliver them to a server and test what the app tracks."}],"title":"Getting Started","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/GettingStarted"},"doc://Traffluent/documentation/Traffluent/TrackingFromViews":{"kind":"article","abstract":[{"type":"text","text":"Give views the tracker the way each framework passes values down, and let modifiers and controls track what views do."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingFromViews","url":"\/documentation\/traffluent\/trackingfromviews","type":"topic","role":"article","title":"Tracking from SwiftUI, UIKit and AppKit"},"doc://Traffluent/documentation/Traffluent/TrackingEvents":{"kind":"article","url":"\/documentati