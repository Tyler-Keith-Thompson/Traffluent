uent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/traffluent"}}}