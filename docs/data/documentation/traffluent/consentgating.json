{"metadata":{"modules":[{"name":"Traffluent"}],"title":"Consent Gating","role":"article","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"],"generated":true}],"identifier":{"url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/traffluent\/consentgating"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each event type names the purpose it is collected for, its ","type":"text"},{"type":"codeVoice","code":"consentCategory"},{"text":", which is ","type":"text"},{"type":"codeVoice","code":".analytics"},{"text":" ","type":"text"},{"text":"unless its ","type":"text"},{"type":"codeVoice","code":"@Event(consent:)"},{"text":" says otherwise. Give the tracker a ","type":"text"},{"type":"codeVoice","code":"Consent"},{"text":", which the app updates as the user","type":"text"},{"text":" ","type":"text"},{"text":"decides, and an event reaches a destination only once its category is granted:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Event(consent: .advertising)","struct AdClicked {","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tracker given no consent delivers every event."}]},{"level":3,"text":"Undecided, granted and denied","type":"heading","anchor":"Undecided-granted-and-denied"},{"type":"paragraph","inlineContent":[{"text":"A category is undecided until the app grants or denies it. While it is undecided, its events are","type":"text"},{"text":" ","type":"text"},{"text":"held in memory, not written to a store, up to ","type":"text"},{"code":"heldRecordLimit","type":"codeVoice"},{"text":" records (1,000 by default) across","type":"text"},{"text":" ","type":"text"},{"text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order","type":"text"},{"text":" ","type":"text"},{"text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while","type":"text"},{"text":" ","type":"text"},{"text":"their category is denied are never collected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"grant","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"deny","type":"codeVoice"},{"text":" return at once: they record the decision, and the tracker’s worker releases or","type":"text"},{"text":" ","type":"text"},{"text":"drops what it held. Every drop of a record that was held or kept is reported on","type":"text"},{"text":" ","type":"text"},{"code":"consent.dropReports","type":"codeVoice"},{"text":" as a ","type":"text"},{"code":"ConsentDropReport","type":"codeVoice"},{"text":" as it happens, so none is lost silently. Held","type":"text"},{"text":" ","type":"text"},{"text":"records are lost if the app ends first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are"},{"type":"text","text":" "},{"type":"text","text":"held outside the bound, since the store still keeps them, and the store forgets each one that is"},{"type":"text","text":" "},{"type":"text","text":"denied."}]},{"level":3,"text":"Destinations","type":"heading","anchor":"Destinations"},{"type":"paragraph","inlineContent":[{"text":"A destination receives every category the consent lets through, unless ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":" narrows it","type":"text"},{"text":" ","type":"text"},{"text":"to the categories it serves, as the second destination above takes only advertising.","type":"text"}]}],"kind":"content"}],"references":{"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","abstract":[{"text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once.","type":"text"}],"type":"topic","title":"Sampling Events","kind":"article","role":"article","url":"\/documentation\/traffluent\/samplingevents"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","type":"topic","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"title":"Defining Events","kind":"article","role":"article","url":"\/documentation\/traffluent\/definingevents"},"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"role":"article","title":"Automatic Tracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","url":"\/documentation\/traffluent\/automatictracking","type":"topic","kind":"article"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"role":"article","title":"Exporting and Checking a Tracking Plan","abstract":[{"type":"text","text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","type":"topic","url":"\/documentation\/traffluent\/trackingplanworkflow","kind":"article"},"doc://Traffluent/documentation/Traffluent":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent","title":"Traffluent","abstract":[{"text":"Typed analytics events for Swift, delivered in batches to any number of destinations.","type":"text"}],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/traffluent"},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination","abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"title":"Writing a Vendor Destination","type":"topic","kind":"article","role":"article","url":"\/documentation\/traffluent\/writingavendordestination"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","type":"topic","title":"Persisting Records","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"kind":"article","role":"article","url":"\/documentation\/traffluent\/persistingrecords"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"role":"article","title":"Sessions and Standard Context","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","url":"\/documentation\/traffluent\/sessionsandstandardcontext","type":"topic","kind":"article"}}}