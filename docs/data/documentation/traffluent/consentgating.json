{"sections":[],"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"Consent Gating","modules":[{"name":"Traffluent"}]},"hierarchy":{"paths":[["doc:\/\/Traffluent\/documentation\/Traffluent"]]},"abstract":[{"text":"Deliver an event only once the user grants the purpose it is collected for.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traffluent\/consentgating"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking","doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext","doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords","doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow","doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"],"title":"Guides","generated":true,"anchor":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"Each event type names the purpose it is collected for, its ","type":"text"},{"code":"consentCategory","type":"codeVoice"},{"text":", which is ","type":"text"},{"code":".analytics","type":"codeVoice"},{"text":" ","type":"text"},{"text":"unless its ","type":"text"},{"code":"@Event(consent:)","type":"codeVoice"},{"text":" says otherwise. Give the tracker a ","type":"text"},{"code":"Consent","type":"codeVoice"},{"text":", which the app updates as the user","type":"text"},{"text":" ","type":"text"},{"text":"decides, and an event reaches a destination only once its category is granted:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Event(consent: .advertising)","struct AdClicked {","    var campaign: String","}","","let consent = Consent([.analytics: .granted])","let tracker = Tracker(consent: consent)","let delivery = tracker.records.batch().deliver(","    to: ConsoleDestination(),","    ConsoleDestination().accepting(.advertising)",")","tracker.track(SignedUp(plan: \"pro\"))          \/\/ delivered: analytics is granted","tracker.track(AdClicked(campaign: \"spring\"))  \/\/ held: advertising is undecided","consent.grant(.advertising)                   \/\/ delivers the held AdClicked"]},{"inlineContent":[{"type":"text","text":"A tracker given no consent delivers every event."}],"type":"paragraph"},{"text":"Undecided, granted and denied","level":3,"type":"heading","anchor":"Undecided-granted-and-denied"},{"inlineContent":[{"type":"text","text":"A category is undecided until the app grants or denies it. While it is undecided, its events are"},{"type":"text","text":" "},{"type":"text","text":"held in memory, not written to a store, up to "},{"type":"codeVoice","code":"heldRecordLimit"},{"type":"text","text":" records (1,000 by default) across"},{"type":"text","text":" "},{"type":"text","text":"every category, the oldest dropped first when the hold is full. Granting delivers them in the order"},{"type":"text","text":" "},{"type":"text","text":"they were tracked, before anything tracked after the grant. Denying drops them. Events tracked while"},{"type":"text","text":" "},{"type":"text","text":"their category is denied are never collected."}],"type":"paragraph"},{"inlineContent":[{"code":"grant","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"deny","type":"codeVoice"},{"text":" return at once: they record the decision, and the tracker’s worker releases or","type":"text"},{"text":" ","type":"text"},{"text":"drops what it held. Every drop of a record that was held or kept is reported on","type":"text"},{"text":" ","type":"text"},{"code":"consent.dropReports","type":"codeVoice"},{"text":" as a ","type":"text"},{"code":"ConsentDropReport","type":"codeVoice"},{"text":" as it happens, so none is lost silently. Held","type":"text"},{"text":" ","type":"text"},{"text":"records are lost if the app ends first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Records that a store recovered from an earlier run are gated again as the tracker starts. They are","type":"text"},{"text":" ","type":"text"},{"text":"held outside the bound, since the store still keeps them, and the store forgets each one that is","type":"text"},{"text":" ","type":"text"},{"text":"denied.","type":"text"}],"type":"paragraph"},{"text":"Destinations","level":3,"type":"heading","anchor":"Destinations"},{"inlineContent":[{"text":"A destination receives every category the consent lets through, unless ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":" narrows it","type":"text"},{"text":" ","type":"text"},{"text":"to the categories it serves, as the second destination above takes only advertising.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traffluent\/documentation\/Traffluent\/ConsentGating"},"references":{"doc://Traffluent/documentation/Traffluent/AutomaticTracking":{"kind":"article","url":"\/documentation\/traffluent\/automatictracking","role":"article","type":"topic","title":"Automatic Tracking","abstract":[{"type":"text","text":"Track screen views, control activations and the app’s lifecycle without a call at each place they happen."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/AutomaticTracking"},"doc://Traffluent/documentation/Traffluent/TrackingPlanWorkflow":{"kind":"article","title":"Exporting and Checking a Tracking Plan","abstract":[{"text":"Tell the people and services that read your events what each event holds, and hear about a change that would break their data before it ships.","type":"text"}],"url":"\/documentation\/traffluent\/trackingplanworkflow","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/TrackingPlanWorkflow"},"doc://Traffluent/documentation/Traffluent/WritingAVendorDestination":{"kind":"article","url":"\/documentation\/traffluent\/writingavendordestination","role":"article","abstract":[{"type":"text","text":"Send events to an analytics vendor Traffluent doesn’t cover yet, from a module of your own, with the same rules as the destinations it ships."}],"type":"topic","title":"Writing a Vendor Destination","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/WritingAVendorDestination"},"doc://Traffluent/documentation/Traffluent/SessionsAndStandardContext":{"kind":"article","abstract":[{"type":"text","text":"Stamp every event with its session and with the app, device, system, locale and network it was tracked on."}],"title":"Sessions and Standard Context","url":"\/documentation\/traffluent\/sessionsandstandardcontext","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SessionsAndStandardContext"},"doc://Traffluent/documentation/Traffluent/DefiningEvents":{"kind":"article","abstract":[{"type":"text","text":"Derive an event’s conformances and schema from its declaration with "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":", and constrain which values its properties may hold."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/DefiningEvents","url":"\/documentation\/traffluent\/definingevents","type":"topic","role":"article","title":"Defining Events"},"doc://Traffluent/documentation/Traffluent":{"kind":"symbol","abstract":[{"type":"text","text":"Typed analytics events for Swift, delivered in batches to any number of destinations."}],"title":"Traffluent","url":"\/documentation\/traffluent","type":"topic","role":"collection","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent"},"doc://Traffluent/documentation/Traffluent/PersistingRecords":{"kind":"article","url":"\/documentation\/traffluent\/persistingrecords","role":"article","type":"topic","title":"Persisting Records","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so a record the app tracked survives the process ending."}],"identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/PersistingRecords"},"doc://Traffluent/documentation/Traffluent/SamplingEvents":{"title":"Sampling Events","abstract":[{"type":"text","text":"Keep a seeded fraction of the events a tracker tracks, event by event or a whole session at once."}],"kind":"article","url":"\/documentation\/traffluent\/samplingevents","type":"topic","role":"article","identifier":"doc:\/\/Traffluent\/documentation\/Traffluent\/SamplingEvents"}}}