":"text","text":"declares the file timestamp or disk space reason it needs."}]},{"level":3,"type":"heading","anchor":"Collected-data","text":"Collected data"},{"type":"paragraph","inlineContent":[{"text":"Every declaration below is ","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeLinked"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" (Traffluent links nothing","type":"text"},{"text":" ","type":"text"},{"text":"to the user’s identity), ","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypeTracking"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", and has the one purpose","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSPrivacyCollectedDataTypePurposeAnalytics"},{"text":". A module declares a type only when it makes data of","type":"text"},{"text":" ","type":"text"},{"text":"that type itself; it is collected only once your app turns the module on and delivers the records","type":"text"},{"text":" ","type":"text"},{"text":"off the device.","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Module","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Data type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What it makes, once your app turns it on"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Device ID (","type":"text"},{"code":"NSPrivacyCollectedDataTypeDeviceID","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Enricher.vendorIdentifier()"},{"type":"text","text":": the platform’s "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":", as a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"co