{"sections":[],"abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}],"variants":[{"paths":["\/documentation\/appkittracking"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Framework","externalID":"AppKitTracking","title":"AppKitTracking","role":"collection","modules":[{"name":"AppKitTracking"}],"symbolKind":"module"},"identifier":{"url":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use this module to track events from AppKit views and controls on macOS; elsewhere, Mac Catalyst","type":"text"},{"text":" ","type":"text"},{"text":"included, it builds empty. A Mac Catalyst app builds its views with UIKit, so it uses","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and SwiftUI views use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"AppKit has no environment for views to inherit, so a view finds its tracker the way an action","type":"text"},{"text":" ","type":"text"},{"text":"sent to the first responder finds its target. ","type":"text"},{"type":"codeVoice","code":"NSView.tracker"},{"text":" asks the view’s responder","type":"text"},{"text":" ","type":"text"},{"text":"chain (the view, its superviews and their view controllers, its window and window controller),","type":"text"},{"text":" ","type":"text"},{"text":"then the window’s delegate and the application’s delegate, and takes the tracker of the first one","type":"text"},{"text":" ","type":"text"},{"text":"that conforms to ","type":"text"},{"type":"codeVoice","code":"TrackerProviding"},{"text":". It looks again each time it is read, so a view moved to","type":"text"},{"text":" ","type":"text"},{"text":"another window tracks through that window’s tracker. A view below no provider tracks through the","type":"text"},{"text":" ","type":"text"},{"text":"tracker ","type":"text"},{"type":"codeVoice","code":"Tracker.bootstrap"},{"text":" made the process’s default, and with none it drops each event, warning","type":"text"},{"text":" ","type":"text"},{"text":"once per call site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSControl.track(_:)"},{"type":"text","text":" tracks an event each time a"},{"type":"text","text":" "},{"type":"text","text":"control sends its action, just before the action:"}]},{"code":["import AppKit","import Traffluent","","@Event","struct ShareTapped {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","final class CartViewController: NSViewController, TrackerProviding {","    let tracker: Tracker","","    init(tracker: Tracker) {","        self.tracker = tracker","        super.init(nibName: nil, bundle: nil)","    }","","    required init?(coder: NSCoder) { nil }","","    override func loadView() {","        let share = NSButton(title: \"Share\", target: self, action: #selector(share(_:)))","        share.track(ShareTapped())  \/\/ after setting the target and action","        let checkOut = NSButton(title: \"Check out\", target: self, action: #selector(checkOut(_:)))","        view = NSStackView(views: [share, checkOut])","    }","","    @objc func share(_ sender: NSButton) {}","","    @objc func checkOut(_ sender: NSButton) {","        sender.tracker.track(CheckoutStarted(cartSize: 3))  \/\/ through this controller's tracker","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A control has one target and action, so "},{"code":"track(_:)","type":"codeVoice"},{"type":"text","text":" puts an object of its own in their place,"},{"type":"text","text":" "},{"type":"text","text":"which tracks the event and then sends the control’s action on to its target. Call it after"},{"type":"text","text":" "},{"type":"text","text":"setting them; setting them afterwards replaces the tracking."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews"},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}]},{"level":2,"type":"heading","text":"API","anchor":"API"},{"type":"paragraph","inlineContent":[{"text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols","type":"text"},{"text":" ","type":"text"},{"text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them","type":"text"},{"text":" ","type":"text"},{"text":"for an Apple target.","type":"text"}]},{"level":3,"type":"heading","text":"Finding the tracker","anchor":"Finding-the-tracker"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"TrackerProviding","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSView.tracker"}],"type":"paragraph"}]}]},{"level":3,"type":"heading","text":"Tracking controls","anchor":"Tracking-controls"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSControl.track(_:)"}]}]}]}]}],"kind":"symbol","hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","titleInlineContent":[{"code":"SwiftUITracking","type":"codeVoice"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","title":"SwiftUITracking","type":"link"},"doc://AppKitTracking/documentation/AppKitTracking":{"title":"AppKitTracking","type":"topic","identifier":"doc:\/\/AppKitTracking\/documentation\/AppKitTracking","abstract":[{"text":"Let AppKit views find their tracker up the responder chain, and track what controls do.","type":"text"}],"role":"collection","url":"\/documentation\/appkittracking","kind":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","titleInlineContent":[{"type":"text","text":"Tracking from SwiftUI, UIKit and AppKit"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","title":"Tracking from SwiftUI, UIKit and AppKit","type":"link"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/uikittracking":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking","type":"link","title":"UIKitTracking","titleInlineContent":[{"type":"codeVoice","code":"UIKitTracking"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/uikittracking"}}}