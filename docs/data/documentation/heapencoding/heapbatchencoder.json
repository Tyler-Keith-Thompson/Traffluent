{"hierarchy":{"paths":[["doc:\/\/HeapEncoding\/documentation\/HeapEncoding"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Structure","title":"HeapBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapBatchEncoder","kind":"identifier"}],"externalID":"s:12HeapEncoding0A12BatchEncoderV","modules":[{"name":"HeapEncoding"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HeapEncoding\/HeapBatchEncoder.swift#L66","fileName":"HeapBatchEncoder.swift"},"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"HeapBatchEncoder"}]},"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HeapEncoding\/s8SendableP","doc:\/\/HeapEncoding\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapBatchEncoder"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with "},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}]},{"type":"codeListing","syntax":"swift","code":["let heap = try HTTPDestination.heap(","    appID: appID,  \/\/ the environment's ID, from Heap's project settings","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with two members: ","type":"text"},{"code":"app_id","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"app ID the encoder is made with, without leading or trailing whitespace, and ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", an array","type":"text"},{"text":" ","type":"text"},{"text":"of one track event per record, oldest first. Each event is an object of these members:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"type":"codeVoice","code":"Event\/name"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"identity"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"idempotency_key"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, flattened; left out when there are none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601, in UTC with milliseconds"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", which is Heap’s own ID of a"},{"type":"text","text":" "},{"type":"text","text":"user, and no "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":". Heap makes a user for each identity it hasn’t seen, so its users are"},{"type":"text","text":" "},{"type":"text","text":"sessions. A record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"its own user of one event, linked to nothing: Heap takes no event without an identity. The record’s vendor identifier,"},{"type":"text","text":" "},{"type":"text","text":"trace context and standard context, and any other context value, aren’t sent: Heap keeps no"},{"type":"text","text":" "},{"type":"text","text":"built-in property of a server-side event, so they would sit among the event’s own properties,"},{"type":"text","text":" "},{"type":"text","text":"under names of the encoder’s choosing."}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":", as ","type":"text"},{"type":"codeVoice","code":"PropertyReader"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, and so is an element of an array. Heap takes a number or a string as a property’s value,","type":"text"},{"text":" ","type":"text"},{"text":"so an object or array is spread into a property per value it holds, named after its path,","type":"text"},{"text":" ","type":"text"},{"text":"joined by ","type":"text"},{"type":"codeVoice","code":"."},{"text":" (","type":"text"},{"type":"codeVoice","code":"cart.size"},{"text":", ","type":"text"},{"type":"codeVoice","code":"tags.0"},{"text":"), a boolean is sent as the string ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"null"},{"text":" is left out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name is over 1,024","type":"text"},{"text":" ","type":"text"},{"text":"characters, one with a property Heap reserves or a property name or string value of","type":"text"},{"text":" ","type":"text"},{"text":"1,024 characters or more, one whose values flatten to one name, one whose event isn’t","type":"text"},{"text":" ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp is outside the years 1 to","type":"text"},{"text":" ","type":"text"},{"text":"9999, and one too large for a request (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError"},{"text":"). ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"},{"text":" returns them","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. Heap answers a request it takes with 200 and one it can’t with 400, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops and reports with every record of the request. Heap stores an event"},{"type":"text","text":" "},{"type":"text","text":"once per "},{"type":"codeVoice","code":"idempotency_key"},{"type":"text","text":" within one identity, so a record sent again under the same session"},{"type":"text","text":" "},{"type":"text","text":"is stored once. A record a store recovers after a relaunch keeps its session, so it is sent"},{"type":"text","text":" "},{"type":"text","text":"under the identity of its first send, and Heap stores it once. The bytes are the same for the"},{"type":"text","text":" "},{"type":"text","text":"same records on every run and platform: no whitespace, object members in the order of their"},{"type":"text","text":" "},{"type":"text","text":"names’ UTF-8 bytes."}]}],"kind":"content"}],"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)"]},{"anchor":"Instance-Methods","title":"Instance Methods"