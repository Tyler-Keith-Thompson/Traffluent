ts as a drop. When it can encode no record of a"},{"type":"text","text":" "},{"type":"text","text":"batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}]},"doc://HeapEncoding/s8SendableP":{"identifier":"doc:\/\/HeapEncoding\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://HeapEncoding/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/HeapEncoding\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/outcome(of:for:)":{"url":"\/documentation\/heapencoding\/heapbatchencoder\/outcome(of:for:)","title":"outcome(of:for:)","type":"topic","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/outcome(of:for:)","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","kind":"typeIdentifier","text":"HTTPTransportResponse"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","kind":"typeIdentifier","text":"EncodedRequest"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","kind":"typeIdentifier","text":"ResponseOutcome"}],"role":"symbol","abstract":[{"type":"text","text":"Every 2xx answer counts as delivered: Heap answers 200 only to a request it takes, and one it can’t with 400."}]},"doc://Events/documentation/Events/Sensitive":{"url":"\/documentation\/events\/sensitive","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensitive","kind":"identifier"}],"abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}],"role":"symbol","title":"Sensitive","navigatorTitle":[{"text":"Sensitive","kind":"identifier"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/transientStatuses":{"url":"\/documentation\/heapencoding\/heapbatchencoder\/transientstatuses","title":"transientStatuses","type":"topic","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/transientStatuses","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientStatuses","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"TransientStatus","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"No status beyond the 408, 429 and 5xx that "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries for every encoder."}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/requests(for:)":{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"codeVoice","code":"batch"},{"text":" as the requests Heap takes, each within the encoder’s limit, with the records left","type":"text"},{"text":" ","type":"text"},{"text":"out of them.","type":"text"}],"url":"\/documentation\/heapencoding\/heapbatchencoder\/requests(for:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"text":"<","kind":"text"},{"text":"HeapEncodingError","kind":"typeIdentifier","preciseIdentifier":"s:12HeapEncoding0aB5ErrorO"},{"text":">","kind":"text"}],"title":"requests(for:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"title":"BatchEncoder","role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","kind":"symbol","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" sends.","type":"text"}],"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"}}}