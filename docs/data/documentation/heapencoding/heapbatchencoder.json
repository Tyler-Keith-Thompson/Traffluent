{"kind":"symbol","topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)"]},{"title":"Type Aliases","generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/Failure"]},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/transientStatuses"]},{"title":"Type Methods","generated":true,"anchor":"Type-Methods","identifiers":["doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/outcome(of:for:)"]}],"variants":[{"paths":["\/documentation\/heapencoding\/heapbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HeapEncoding\/HeapBatchEncoder.swift#L66","fileName":"HeapBatchEncoder.swift"},"roleHeading":"Structure","title":"HeapBatchEncoder","role":"symbol","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"HeapBatchEncoder"}],"modules":[{"name":"HeapEncoding"}],"externalID":"s:12HeapEncoding0A12BatchEncoderV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeapBatchEncoder","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/HeapEncoding\/documentation\/HeapEncoding"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HeapEncoding\/s8SendableP","doc:\/\/HeapEncoding\/s16SendableMetatypeP"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeapBatchEncoder"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Make the destination with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HTTPDestinations\/HTTPDestination\/heap(appID:region:plan:backoff:clock:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and its limits:","type":"text"}]},{"type":"codeListing","code":["let heap = try HTTPDestination.heap(","    appID: appID,  \/\/ the environment's ID, from Heap's project settings","    region: .us,  \/\/ or .eu, where the project's data resides","    plan: plan)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":" with two members: ","type":"text"},{"code":"app_id","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"app ID the encoder is made with, without leading or trailing whitespace, and ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", an array","type":"text"},{"text":" ","type":"text"},{"text":"of one track event per record, oldest first. Each event is an object of these members:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"event","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"identity"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":" the same way when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"idempotency_key","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s stored properties, flattened; left out when there are none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"type":"codeVoice","code":"user_id"},{"text":", which is Heap’s own ID of a","type":"text"},{"text":" ","type":"text"},{"text":"user, and no ","type":"text"},{"type":"codeVoice","code":"session_id"},{"text":". Heap makes a user for each identity it hasn’t seen, so its users are","type":"text"},{"text":" ","type":"text"},{"text":"sessions. A record with no session (one tracked by a tracker without ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":") is","type":"text"},{"text":" ","type":"text"},{"text":"its own user of one event, linked to nothing: Heap takes no event without an identity. The record’s vendor identifier,","type":"text"},{"text":" ","type":"text"},{"text":"trace context and standard context, and any other context value, aren’t sent: Heap keeps no","type":"text"},{"text":" ","type":"text"},{"text":"built-in property of a server-side event, so they would sit among the event’s own properties,","type":"text"},{"text":" ","type":"text"},{"text":"under names of the encoder’s choosing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true,"type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, and so is an element of an array. Heap takes a number or a string as a property’s value,","type":"text"},{"text":" ","type":"text"},{"text":"so an object or array is spread into a property per value it holds, named after its path,","type":"text"},{"text":" ","type":"text"},{"text":"joined by ","type":"text"},{"code":".","type":"codeVoice"},{"text":" (","type":"text"},{"code":"cart.size","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tags.0","type":"codeVoice"},{"text":"), a boolean is sent as the string ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" is left out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event name is over 1,024"},{"type":"text","text":" "},{"type":"text","text":"characters, one with a property Heap reserves or a property name or string value of"},{"type":"text","text":" "},{"type":"text","text":"1,024 characters or more, one whose values flatten to one name, one whose event isn’t"},{"type":"text","text":" "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is outside the years 1 to"},{"type":"text","text":" "},{"type":"text","text":"9999, and one too large for a request ("},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapEncodingError","isActive":true,"type":"reference"},{"type":"text","text":"). "},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"type":"text","text":" returns them"},{"type":"text","text":" "},{"type":"text","text":"as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Heap answers a request it takes with 200 and one it can’t with 400, which","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" drops and reports with every record of the request. Heap stores an event","type":"text"},{"text":" ","type":"text"},{"text":"once per ","type":"text"},{"code":"idempotency_key","type":"codeVoice"},{"text":" within one identity, so a record sent again under the same session","type":"text"},{"text":" ","type":"text"},{"text":"is stored once. A record a store recovers after a relaunch keeps its session, so it is sent","type":"text"},{"text":" ","type":"text"},{"text":"under the identity of its first send, and Heap stores it once. The bytes are the same for the","type":"text"},{"text":" ","type":"text"},{"text":"same records on every run and platform: no whitespace, object members in the order of their","type":"text"},{"text":" ","type":"text"},{"text":"names’ UTF-8 bytes.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Heap’s server-side bulk track API, so an"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send events to a Heap environment’s "},{"type":"codeVoice","code":"POST \/api\/track"},{"type":"text","text":"."}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"title":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" sends.","type":"text"}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"url":"\/documentation\/httpdestinations\/batchencoder","role":"symbol","kind":"symbol"},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/init(appID:plan:limit:)":{"kind":"symbol","url":"\/documentation\/heapencoding\/heapbatchencoder\/init(appid:plan:limit:)","title":"init(appID:plan:limit:)","role":"symbol","type":"topic","abstract":[{"type":"text","text":"An encoder of the events "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, for the Heap environment "},{"type":"codeVoice","code":"appID"},{"type":"text","text":", splitting each"},{"type":"text","text":" "},{"type":"text","text":"batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":"."}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\/HeapBatchEncoder\/init(appID:plan:limit:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"appID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"limit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:12HeapEncoding0A10SetupErrorO","text":"HeapSetupError"},{"kind":"text","text":")"}]},"doc://HeapEncoding/documentation/HeapEncoding/HeapBatchEncoder/outcome(of:for:)":{"abstract":[{"type":"text","text":"Every 2xx answer counts as delivered: Heap answers 200 only to a request it takes, and one it can’t with 400."}],"identifier":"doc:\/\/HeapEncoding\/documentation\/HeapEncoding\