{"hierarchy":{"paths":[["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"]]},"sections":[],"identifier":{"url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder","interfaceLanguage":"swift"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/AmplitudeEncoding\/s8SendableP","doc:\/\/AmplitudeEncoding\/s16SendableMetatypeP"]}],"abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" of Amplitude’s HTTP V2 API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to an Amplitude project’s ","type":"text"},{"code":"POST \/2\/httpapi","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeBatchEncoder"}]}]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with "},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and Amplitude’s limits:"}]},{"code":["let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .eu,  \/\/ or .us, where the project's data resides","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON object of content type ","type":"text"},{"type":"codeVoice","code":"application\/json"},{"text":" with two members: ","type":"text"},{"type":"codeVoice","code":"api_key"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"project’s API key, and ","type":"text"},{"type":"codeVoice","code":"events"},{"text":", one object per record, oldest first, with these members:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"device_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event_properties"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, by name","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"event_type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"insert_id"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"session_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The session’s start in Unix milliseconds, the first 48 bits of its version 7 "},{"code":"SessionKey","type":"codeVoice"},{"type":"text","text":"; left out for a record with no session, or a session key of another version"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"time"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in whole milliseconds since 1970"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The session is the only identifier sent: there is no ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":", and no ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":", ","type":"text"},{"code":"idfv","type":"codeVoice"},{"text":" or other","type":"text"},{"text":" ","type":"text"},{"text":"device identifier. Amplitude counts a user per ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":", so its unique users are sessions. A","type":"text"},{"text":" ","type":"text"},{"text":"record with no session (one tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":") is its own","type":"text"},{"text":" ","type":"text"},{"text":"anonymous user, linked to nothing: Amplitude rejects an event with neither a ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":" nor a","type":"text"},{"text":" ","type":"text"},{"code":"user_id","type":"codeVoice"},{"text":". Amplitude drops a second copy of an event with the same ","type":"text"},{"code":"insert_id","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A record a store recovers after a relaunch keeps its session, so it goes out with the","type":"text"},{"text":" ","type":"text"},{"code":"device_id","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"session_id","type":"codeVoice"},{"text":" of its first send, and Amplitude drops it if it had already stored","type":"text"},{"text":" ","type":"text"},{"text":"it before the app ended. The","type":"text"},{"text":" ","type":"text"},{"text":"record’s vendor identifier and trace context, and any other context value, aren’t sent. Nor is","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"ip","type":"codeVoice"},{"text":": neither an address nor ","type":"text"},{"code":"$remote","type":"codeVoice"},{"text":", which asks Amplitude to look the user’s location up","type":"text"},{"text":" ","type":"text"},{"text":"from the request’s address.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Amplitude limits each string value to 1,024 characters; the encoder sends longer ones as they","type":"text"},{"text":" ","type":"text"},{"text":"are.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event also holds these members, for each of the keys the record’s context has a value"},{"type":"text","text":" "},{"type":"text","text":"for:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"app_version"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The version, left out when ","type":"text"},{"code":"nil","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"device_model"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"language","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocaleKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"code":"en-US","type":"codeVoice"},{"text":", which Amplitude stores as the language’s name","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"platform"},{"type":"text","text":", "},{"type":"codeVoice","code":"os_name"},{"type":"text","text":", "},{"type":"codeVoice","code":"os_version"}]}],[{"type":"paragraph","inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The operating system’s name, its name again, and its version","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name Amplitude keeps"},{"type":"text","text":" "},{"type":"text","text":"for its own events, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one"},{"type":"text","text":" "},{"type":"text","text":"whose timestamp has no epoch-milliseconds form, and one too large for a request"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","isActive":true},{"type":"text","text":"). "},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. Amplitude answers a request it takes with 200, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries"},{"type":"text","text":" "},{"type":"text","text":"one that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400 or"},{"type":"text","text":" "},{"type":"text","text":"413. A record sent again keeps its "},{"type":"codeVoice","code":"insert_id"},{"type":"text","text":". The bytes are the same for the same records on"},{"type":"text","text":" "},{"type":"text","text":"every run and platform: no whitespace, object members in the order of their names’ UTF-8"},{"type":"text","text":" "},{"type":"text","text":"bytes."}]}],"kind":"content"}],"v