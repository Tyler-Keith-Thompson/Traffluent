{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/amplitudeencoding\/amplitudebatchencoder"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"navigatorTitle":[{"text":"AmplitudeBatchEncoder","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeBatchEncoder"}],"title":"AmplitudeBatchEncoder","externalID":"s:17AmplitudeEncoding0A12BatchEncoderV","remoteSource":{"fileName":"AmplitudeBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AmplitudeEncoding\/AmplitudeBatchEncoder.swift#L75"},"modules":[{"name":"AmplitudeEncoding"}],"symbolKind":"struct","roleHeading":"Structure","role":"symbol"},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/init(apiKey:plan:limit:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/Failure"],"title":"Type Aliases","anchor":"Type-Aliases","generated":true},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/transientStatuses"],"title":"Type Properties","anchor":"Type-Properties","generated":true},{"identifiers":["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/outcome(of:for:)"],"title":"Type Methods","anchor":"Type-Methods","generated":true}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeBatchEncoder","kind":"identifier"}]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:backoff:clock:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and Amplitude’s limits:"}]},{"code":["let amplitude = try HTTPDestination.amplitude(","    apiKey: apiKey,","    region: .eu,  \/\/ or .us, where the project's data resides","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":" with two members: "},{"code":"api_key","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"project’s API key, and "},{"code":"events","type":"codeVoice"},{"type":"text","text":", one object per record, oldest first, with these members:"}]},{"rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"device_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"event_properties"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s stored properties, by name","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"event_type","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"insert_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"session_id"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The session’s start in Unix milliseconds, the first 48 bits of its version 7 "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":"; left out for a record with no session, or a session key of another version"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"time","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in whole milliseconds since 1970"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":", and no "},{"type":"codeVoice","code":"ip"},{"type":"text","text":", "},{"type":"codeVoice","code":"idfv"},{"type":"text","text":" or other"},{"type":"text","text":" "},{"type":"text","text":"device identifier. Amplitude counts a user per "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":", so its unique users are sessions. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is its own"},{"type":"text","text":" "},{"type":"text","text":"anonymous user, linked to nothing: Amplitude rejects an event with neither a "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":" nor a"},{"type":"text","text":" "},{"type":"codeVoice","code":"user_id"},{"type":"text","text":". Amplitude drops a second copy of an event with the same "},{"type":"codeVoice","code":"insert_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A record a store recovers after a relaunch keeps its session, so it goes out with the"},{"type":"text","text":" "},{"type":"codeVoice","code":"device_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"session_id"},{"type":"text","text":" of its first send, and Amplitude drops it if it had already stored"},{"type":"text","text":" "},{"type":"text","text":"it before the app ended. The"},{"type":"text","text":" "},{"type":"text","text":"record’s vendor identifier and trace context, and any other context value, aren’t sent. Nor is"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"ip"},{"type":"text","text":": neither an address nor "},{"type":"codeVoice","code":"$remote"},{"type":"text","text":", which asks Amplitude to look the user’s location up"},{"type":"text","text":" "},{"type":"text","text":"from the request’s address."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Amplitude limits each string value to 1,024 characters; the encoder sends longer ones as they"},{"type":"text","text":" "},{"type":"text","text":"are."}]},{"type":"paragraph","inlineContent":[{"text":"Each event also holds these members, for each of the keys the record’s context has a value","type":"text"},{"text":" ","type":"text"},{"text":"for:","type":"text"}]},{"rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"app_version"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The version, left out when ","type":"text"},{"type":"codeVoice","code":"nil"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"device_model"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The model","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"language","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The locale’s BCP 47 identifier, such as ","type":"text"},{"code":"en-US","type":"codeVoice"},{"text":", which Amplitude stores as the language’s name","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"platform"},{"text":", ","type":"text"},{"type":"codeVoice","code":"os_name"},{"text":", ","type":"text"},{"type":"codeVoice","code":"os_version"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The operating system’s name, its name again, and its version","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name Amplitude keeps","type":"text"},{"text":" ","type":"text"},{"text":"for its own events, one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one","type":"text"},{"text":" ","type":"text"},{"text":"whose timestamp has no epoch-milliseconds form, and one too large for a request","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","isActive":true,"type":"reference"},{"text":"). ","type":"text"},{"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. Amplitude answers a request it takes with 200, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries","type":"text"},{"text":" ","type":"text"},{"text":"one that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400 or","type":"text"},{"text":" ","type":"text"},{"text":"413. A record sent again keeps its ","type":"text"},{"code":"insert_id","type":"codeVoice"},{"text":". The bytes are the same for the same records on","type":"text"},{"text":" ","type":"text"},{"text":"every run and platform: no whitespace, object members in the order of their names’ UTF-8","type":"text"},{"text":" ","type":"text"},{"text":"bytes.","type":"text"}]}]}],"abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Amplitude’s HTTP V2 API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to an Amplitude project’s "},{"type":"codeVoice","code":"POST \/2\/httpapi"},{"type":"text","text":"."}],"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/AmplitudeEncoding\/s8SendableP","doc:\/\/AmplitudeEncoding\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding"]]},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/H