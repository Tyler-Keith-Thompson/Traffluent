ntifier","text":"BatchEncoder"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"text":" sends.","type":"text"}],"type":"topic","title":"BatchEncoder","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder/batchLimit":{"title":"batchLimit","abstract":[{"text":"Amplitude’s limits on one request: 10 events and 1,000,000 bytes of body, an event’s","type":"text"},{"text":" ","type":"text"},{"text":"included.","type":"text"}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/batchLimit","url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder\/batchlimit","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeBatchEncoder/init(apiKey:plan:limit:)":{"url":"\/documentation\/amplitudeencoding\/amplitudebatchencoder\/init(apikey:plan:limit:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder\/init(apiKey:plan:limit:)","abstract":[{"type":"text","text":"An encoder of the events "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" describes, for the Amplitude project of "},{"code":"apiKey","type":"codeVoice"},{"type":"text","text":", splitting"},{"type":"text","text":" "},{"type":"text","text":"each batch to "},{"code":"limit","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","title":"init(apiKey:plan:limit:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"apiKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"},{"text":")","kind":"text"}]},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeEncodingError":{"abstract":[{"type":"text","text":"Why "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeBatchEncoder"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"url":"\/documentation\/amplitudeencoding\/amplitudeencodingerror","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"AmplitudeEncodingError","kind":"identifier"}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeEncodingError","kind":"identifier"}],"identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeEncodingError","title":"AmplitudeEncodingError"}}}