{"topicSections":[{"title":"Destinations","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","doc:\/\/Destinations\/documentation\/Destinations\/InvalidCapacity"],"anchor":"Destinations"},{"title":"Delivering","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)","doc:\/\/Destinations\/documentation\/Destinations\/Delivery","doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"],"anchor":"Delivering"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations"},"kind":"symbol","metadata":{"role":"collection","title":"Destinations","roleHeading":"Framework","externalID":"Destinations","modules":[{"name":"Destinations"}],"symbolKind":"module"},"hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","type":"reference","isActive":true},{"text":" is a plain sink with one requirement, ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference","isActive":true},{"text":", which is given","type":"text"},{"text":" ","type":"text"},{"text":"a batch of records, oldest first. Delivering is a chain of operators over a tracker’s records:","type":"text"},{"text":" ","type":"text"},{"code":"batch()","type":"codeVoice"},{"text":" gathers them into batches of 20, and every 30 seconds while any are pending, and","type":"text"},{"text":" ","type":"text"},{"code":"deliver(to:batchBufferLimit:)","type":"codeVoice"},{"text":" makes a ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","type":"reference","isActive":true},{"text":", which hands each batch to every","type":"text"},{"text":" ","type":"text"},{"text":"destination. It holds a lazy unit of work, ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/work","type":"reference","isActive":true},{"text":", that runs once you call ","type":"text"},{"code":"execute()","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each destination receives its batches in order, one at a time, from a buffer of its own, so a","type":"text"},{"text":" ","type":"text"},{"text":"slow one delays only itself. A full buffer drops its oldest batch and reports it as a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","isActive":true,"type":"reference"},{"text":" on the delivery’s ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","isActive":true,"type":"reference"},{"text":", which one task reads at a","type":"text"},{"text":" ","type":"text"},{"text":"time, as every report stream does. When the tracker has a store, the delivery reads the dropped","type":"text"},{"text":" ","type":"text"},{"text":"batch’s records back for that destination once it catches up, and tells the store when each batch","type":"text"},{"text":" ","type":"text"},{"text":"has reached every destination.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What a destination receives is narrowed by modifiers: "},{"isActive":true,"type":"reference",