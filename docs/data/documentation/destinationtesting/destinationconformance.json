from a test:"}],"type":"paragraph"},{"syntax":"swift","code":["@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue, at the caller’s source location, for every rule the"},{"type":"text","text":" "},{"type":"text","text":"destination breaks, and throws what the factory throws. Unlike a project’s own tests, which"},{"type":"text","text":" "},{"type":"text","text":"write their assertions out in full, this is a published assertion, shared on purpose, as"},{"type":"text","text":" "},{"type":"text","text":"TrackingPlanTesting’s "},{"type":"codeVoice","code":"expectTrackingPlan(_:matches:sourceLocation:)"},{"type":"text","text":" is: every vendor module"},{"type":"text","text":" "},{"type":"text","text":"runs the same checks. The checks send through the transport only, never the network, and run"},{"type":"text","text":" "},{"type":"text","text":"in well under a second; give the calling suite a "},{"type":"codeVoice","code":".timeLimit"},{"type":"text","text":", as a factory that keeps a copy"},{"type":"text","text":" "},{"type":"text","text":"of the destination it returns makes a check wait for ever."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/destinationtesting\/destinationconformance"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"DestinationConformance","remoteSource":{"fileName":"DestinationConformance.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destina