{"abstract":[{"text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests","type":"text"},{"text":" ","type":"text"},{"text":"match recorded fixtures byte for byte, and it keeps the library’s rules for ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" values,","type":"text"},{"text":" ","type":"text"},{"text":"consent, oversized records, retries, 2xx answers and trace context.","type":"text"}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationConformance"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Encoding"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Make one with the vendor’s factory, called with the kit’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","type":"reference"},{"text":" and short","type":"text"},{"text":" ","type":"text"},{"text":"backoff, then run each ","type":"text"},{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","type":"reference"},{"text":" and each fixture from a test:","type":"text"}]},{"type":"codeListing","code":["@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let