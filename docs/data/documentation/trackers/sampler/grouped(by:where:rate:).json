n\/Events\/SampleRate","url":"\/documentation\/events\/samplerate","title":"SampleRate","type":"topic","abstract":[{"type":"text","text":"The fraction of events, or of groups of events, a "},{"type":"codeVoice","code":"Sampler"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"Trackers"},{"type":"text","text":") keeps: a"},{"type":"text","text":" "},{"type":"text","text":"probability from 0, none, to 1, every one."}],"role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SampleRate","kind":"identifier"}]},"doc://Trackers/documentation/Trackers":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","role":"collection","type":"topic","title":"Trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"url":"\/documentation\/trackers","kind":"symbol"}}}