":"method","roleHeading":"Type Method","role":"symbol"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"grouped","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Key","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"key","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"where","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"selects","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" (","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":" = { _ in true }, ","kind":"text"},{"text":"rate","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Events10SampleRateV","text":"SampleRate","kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/SampleRate"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:8Trackers7SamplerV","text":"Sampler","kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:15Instrumentation0A10ContextKeyP","text":"InstrumentationContextKey","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:15Instrumentation0A10ContextKeyP5ValueQa","text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s23CustomStringConvertibleP","text":"CustomStringConvertible","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:15Instrumentation0A10ContextKeyP5ValueQa","text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The context key whose value names a record’s group.","type":"text"}],"type":"paragraph"}],"name":"key"},{"content":[{"inlineContent":[{"text":"Whether the sampler applies to a record; every record by default.","type":"text"}],"type":"paragraph"}],"name":"selects"},{"content":[{"inlineContent":[{"text":"The fraction of the groups to keep.","type":"text"}],"type":"paragraph"}],"name":"rate"}]},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The sampler.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"Every record of a group gets the same decision, made from the tracker’s sampling seed and"},{"type":"text","text":" "},{"type":"text","text":"the value’s "},{"type":"codeVoice","code":"description"},{"type":"text","text":", so values with equal descriptions make one group. Use a key whose"},{"type":"text","text":" "},{"type":"text","text":"value describes itself stably and consistently with "},{"type":"codeVoice","code":"=="},{"type":"text","text":", such as a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"type described by reflection changes group, and so decision, when its fields change. Nothing is"},{"type":"text","text":" "},{"type":"text","text":"remembered: the decision is made again for each group, from the seed alone, and a sampler"},{"type":"text","text":" "},{"type":"text","text":"keeps only the latest group’s to skip making it again for the next record of that group."},{"type":"text","text":" "},{"type":"text","text":"A record whose context holds no value of "},{"type":"codeVoice","code":"key"},{"type":"text","text":" belongs to no group, so the sampler doesn’t"},{"type":"text","text":" "},{"type":"text","text":"apply to it."}],"type":"paragraph"},{"type":"codeListing","code":["let tracker = Tracker(enrichers: [experiment], samplers: [.grouped(by: ExperimentKey.self, rate: try SampleRate(0.5))])"],"syntax":"swift"}],"kind":"content"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Sampler"]]},"sections":[],"references":{"doc://Trackers/documentation/Trackers/Sampler":{"abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"title":"Sampler","url":"\/documentation\/trackers\/sampler","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},"doc://Trackers/documentation/Trackers/Sampler/grouped(by:where:rate:)":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler\/grouped(by:where:rate:)","title":"grouped(by:where:rate:)","abstract":[{"text":"A sampler that keeps or drops whole groups of records, those whose contexts h