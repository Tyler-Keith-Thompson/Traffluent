{"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"A tracker is a value. Build one where the app starts, start delivering its records, and either","type":"text"},{"text":" ","type":"text"},{"text":"pass the tracker down or bind it to a task with ","type":"text"},{"type":"codeVoice","code":"withTracker"},{"text":" and read it anywhere inside with","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: ConsoleDestination())","withTracker(tracker) {","    Tracker.current.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()"]},{"inlineContent":[{"text":"Copies share one stream of records. A binding reaches the work run inside ","type":"text"},{"code":"withTracker","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"the child tasks it starts, but not a detached task or callbacks a framework runs on tasks of","type":"text"},{"text":" ","type":"text"},{"text":"its own, such as a UI framework’s button actions: pass those a tracker, or make the app’s","type":"text"},{"text":" ","type":"text"},{"text":"tracker the process’s default once, at launch, with ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/bootstrap(_:)","isActive":true,"type":"reference"},{"text":", which ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","isActive":true,"type":"reference"},{"text":" falls","type":"text"},{"text":" ","type":"text"},{"text":"back to wherever no tracker is bound.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)","type":"reference","isActive":true},{"type":"text","text":" does nothing but accept the event, from any"},{"type":"text","text":" "},{"type":"text","text":"thread: it reads the clock, captures the call site and the task’s "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":", and queues"},{"type":"text","text":" "},{"type":"text","text":"them. A worker the tracker owns, which never runs on the main actor, does everything else, in"},{"type":"text","text":" "},{"type":"text","text":"the order events were tracked: the constraints’ check, the enrichers, the samplers, the consent,"},{"type":"text","text":" "},{"type":"text","text":"a store’s writes, and publishing to "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference","isActive":true},{"type":"text","text":". No API runs that work on a caller’s thread. "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()","type":"reference","isActive":true},{"type":"text","text":" waits for the worker to"},{"type":"text","text":" "},{"type":"text","text":"catch up; "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","type":"reference","isActive":true},{"type":"text","text":" does too, then ends the records."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Tracked events wait in memory, without a bound, until the worker reaches them. The queue"},{"type":"text","text":" "},{"type":"text","text":"can’t be bounded without losing something it mustn’t: it also carries consent decisions and"},{"type":"text","text":" "},{"type":"text","text":"the waits of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/flush()"},{"type":"text","text":", and "},{"code":"track","type":"codeVoice"},{"type":"text","text":" can’t wait for room without blocking its caller."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Without a store, records live in memory only, and records not yet delivered are lost if the"},{"type":"text","text":" "},{"type":"text","text":"process exits. A tracker given a "},{"type":"codeVoice","code":"RecordStore"},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","isActive":true},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"delivers what the store kept from earlier runs first, and writes each record to it once the"},{"type":"text","text":" "},{"type":"text","text":"worker reaches it: a record is durable from then on, and one tracked moments before the"},{"type":"text","text":" "},{"type":"text","text":"process is killed, not yet reached, is lost."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tracker given "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"type":"text","text":"s keeps a seeded fraction of the events they apply to, dropping the"},{"type":"text","text":" "},{"type":"text","text":"rest before they are held, written or delivered and reporting them on"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"A tracker given a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","type":"reference"},{"text":" delivers an event only once its category is granted, holding it","type":"text"},{"text":" ","type":"text"},{"text":"while undecided and dropping it when denied; one given none delivers every event.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"metadata":{"roleHeading":"Structure","modules":[{"name":"Trackers"}],"title":"Tracker","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"navigatorTitle":[{"text":"Tracker","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L55","fileName":"Tracker.swift"},"externalID":"s:8Trackers7TrackerV","role":"symbol","symbolKind":"struct"},"seeAlsoSections":[{"title":"Tracking","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/withTracker(_:_:)-7fax9","doc:\/\/Trackers\/documentation\/Trackers\/withTracker(_:_:)-24yuc","doc:\/\/Trackers\/documentation\/Trackers\/TrackerAlreadyBootstrapped"],"anchor":"Tracking","generated":true}],"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker"]}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Trackers\/s8SendableP","doc:\/\/Trackers\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"kind":"symbol","topicSections":[{"title":"Structures","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/Records-swift.struct"],"anchor":"Structures","generated":true},{"title":"Initializers","identifiers":["doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(consent:enrichers:samplers:samplingSeed:now:)","doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:co