{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/samplingdropreports"]}],"abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"reference","isActive":true},{"text":"s dropped, in the order the drops happen.","type":"text"}],"metadata":{"externalID":"s:8Trackers7TrackerV19samplingDropReports11AsyncQueues0F5QueueVyAA08SamplingD6ReportVGvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:8Trackers18SamplingDropReportV","text":"SamplingDropReport","kind":"typeIdentifier"},{"text":">","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L391","fileName":"Tracker.swift"},"role":"symbol","title":"samplingDropReports","symbolKind":"property","modules":[{"name":"Trackers"}],"roleHeading":"Instance Property"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"SamplingDropReport","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The tracker’s worker samples each record after its enrichers and before the consent, so a","type":"text"},{"text":" ","type":"text"},{"text":"dropped record is never held, written to a store or delivered. Records a store recovered","type":"text"},{"text":" ","type":"text"},{"text":"aren’t sampled again.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read, merged: a drop joins the waiting report of the same"},{"type":"text","text":" "},{"type":"text","text":"event, adding to its count and widening its timestamps. So the reports waiting unread are at"},{"type":"text","text":" "},{"type":"text","text":"most one per event type, however many events are dropped. Copies of a tracker share one"},{"type":"text","text":" "},{"type":"text","text":"sequence, which ends once the tracker has finished and every report has been read. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},{"type":"text","text":" tracker’s is empty."}]},{"type":"paragraph","inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]}],"references":{"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"abstract":[{"type":"text","text":"A report of each event the tracker’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler"},{"type":"text","text":"s dropped, in the order the drops happen."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","text":"AsyncQueue"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:8Trackers18SamplingDropReportV","kind":"typeIdentifier","text":"SamplingDropReport"},{"kind":"text","text":">"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/trackers\/tracker\/samplingdropreports","title":"samplingDropReports","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},"doc://Trackers/documentation/Trackers/Tracker/noOp":{"abstract":[{"type":"text","text":"A tracker that drops every event, logging each one at debug level. Its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"empty."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noOp","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Tracker","kind":"typeIdentifier","preciseIdentifier":"s:8Trackers7TrackerV"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/trackers\/tracker\/noop","title":"noOp","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},"doc://Trackers/documentation/Trackers":{"abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/trackers","title":"Trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://Trackers/documentation/Trackers/SamplingDropReport":{"title":"SamplingDropReport","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamplingDropReport","kind":"identifier"}],"type":"topic","url":"\/documentation\/trackers\/samplingdropreport","navigatorTitle":[{"text":"SamplingDropReport","kind":"identifier"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport","abstract":[{"type":"text","text":"Events a tracker’s "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true,"type":"reference"},{"type":"text","text":"s left out: the event’s name, how many were left out and when"},{"type":"text","text":" "},{"type":"text","text":"they were tracked."}],"kind":"symbol","role":"symbol"},"doc://Trackers/documentation/Trackers/Sampler":{"title":"Sampler","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"url":"\/documentation\/trackers\/sampler","type":"topic","navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","abstract":[{"text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written","type":"text"},{"text":" ","type":"text"},{"text":"or delivered: event by event, or a whole group of events, such as a session, at once.","type":"text"}],"kind":"symbol","role":"symbol"},"doc://Trackers/documentation/Trackers/Tracker":{"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","role":"symbol","navigatorTitle":[{"text":"Tracker","kind":"identifier"}],"kind":"symbol","title":"Tracker","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"url":"\/documentation\/trackers\/tracker","type":"topic"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"type":"topic","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","abstract":[{"text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"kind":"symbol","url":"\/documentation\/asyncqueues\/asyncqueue","title":"AsyncQueue","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}]},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"url":"\/documentation\/trackers\/tracker\/records-swift.property","abstract":[{"text":"The records of the events this tracker tracks, for a delivery to read.","type":"text"}],"role":"symbol","title":"records","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8Trackers7TrackerV","text":"Tracker","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:8Trackers7TrackerV7RecordsV","text":"Records","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"}}}