{"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"SamplingDropReport","kind":"typeIdentifier","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The tracker’s worker samples each record after its enrichers and before the consent, so a","type":"text"},{"text":" ","type":"text"},{"text":"dropped record is never held, written to a store or delivered. Records a store recovered","type":"text"},{"text":" ","type":"text"},{"text":"aren’t sampled again.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Reports wait until they are read, merged: a drop joins the waiting report of the same"},{"type":"text","text":" "},{"type":"text","text":"event, adding to its count and widening its timestamps. So the reports waiting unread are at"},{"type":"text","text":" "},{"type":"text","text":"most one per event type, however many events are dropped. Copies of a tracker share one"},{"type":"text","text":" "},{"type":"text","text":"sequence, which ends once the tracker has finished and every report has been read. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"type":"text","text":" tracker’s is empty."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"One task reads the reports at a time. The first iterator to read holds them until its"},{"type":"text","text":" "},{"type":"text","text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a"},{"type":"text","text":" "},{"type":"text","text":"warning once, then reads on from the next report, so the first gets every report in order."},{"type":"text","text":" "},{"type":"text","text":"A reader cancelled while it waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers18SamplingDropReportV","text":"SamplingDropReport"},{"kind":"text","text":">"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L391","fileName":"Tracker.swift"},"externalID":"s:8Trackers7TrackerV19samplingDropReports11AsyncQueues0F5QueueVyAA08SamplingD6ReportVGvp","title":"samplingDropReports","roleHeading":"Instance Property","modules":[{"name":"Trackers"}],"symbolKind":"property"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackers\/tracker\/samplingdropreports"]}],"abstract":[{"text":"A report of each event the tracker’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"reference"},{"text":"s dropped, in the order the drops happen.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Tracke