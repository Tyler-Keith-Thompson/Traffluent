{"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/SamplingDropReport","text":"SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV","kind":"typeIdentifier"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The tracker’s worker samples each record after its enrichers and before the consent, so a","type":"text"},{"text":" ","type":"text"},{"text":"dropped record is never held, written to a store or delivered. Records a store recovered","type":"text"},{"text":" ","type":"text"},{"text":"aren’t sampled again.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reports wait until they are read, merged: a drop joins the waiting report of the same"},{"type":"text","text":" "},{"type":"text","text":"event, adding to its count and widening its timestamps. So the reports waiting unread are at"},{"type":"text","text":" "},{"type":"text","text":"most one per event type, however many events are dropped. Copies of a tracker share one"},{"type":"text","text":" "},{"type":"text","text":"sequence, which ends once the tracker has finished and every report has been read. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"type":"text","text":" tracker’s is empty."}]},{"type":"paragraph","inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in order.","type":"text"},{"text":" ","type":"text"},{"text":"A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"A report of each event the tracker’s "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","isActive":true},{"type":"text","text":"s dropped, in the order the drops happen."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"metadata":{"remoteSource":{"fileName":"Tracker.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Trackers\/Tracker.swift#L391"},"title":"samplingDropReports","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","text":"AsyncQueue"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:8Trackers18SamplingDropReportV","kind":"typeIdentifier","text":"SamplingDropReport"},{"kind":"text","text":">"}],"roleHeading":"Instance Property","modules":[{"name":"Trackers"}],"symbolKind":"property","externalID":"s:8Trackers7TrackerV19samplingDropReports11AsyncQueues0F5QueueVyAA08SamplingD6ReportVGvp"},"variants":[{"paths":["\/documentation\/trackers\/tracker\/samplingdropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Trackers/documentation/Trackers":{"abstract":[{"text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent.","type":"text"}],"role":"collection","url":"\/documentation\/trackers","title":"Trackers","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"topic"},"doc://Trackers/documentation/Trackers/Sampler":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"url":"\/documentation\/trackers\/sampler","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"kind":"symbol","title":"Sampler","type":"topic"},"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"title":"samplingDropReports","kind":"symbol","type":"topic","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/samplingDropReports","abstract":[{"type":"text","text":"A report of each event the tracker’s "},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","type":"reference","isActive":true},{"type":"text","text":"s dropped, in the order the drops happen."}],"url":"\/documentation\/trackers\/tracker\/samplingdropreports","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"samplingDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"SamplingDropReport","preciseIdentifier":"s:8Trackers18SamplingDropReportV","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Trackers/documentation/Trackers/Tracker/noOp":{"role":"symbol","url":"\/documentation\/trackers\/tracker\/noop","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","kind":"symbol","title":"noOp","abstract":[{"text":"A tracker that drops every event, logging each one at debug level. Its ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"empty.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"noOp"},{"kind":"text","text":": "},{"preciseIdentifier":"s:8Trackers7TrackerV","kind":"typeIdentifier","text":"Tracker"}]},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","title":"AsyncQueue","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"type":"topic","url":"\/documentation\/asyncqueues\/asyncqueue"},"doc://Trackers/documentation/Trackers/Tracker/records-swift.property":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","abstract":[{"text":"The records of the events this tracker tracks, for a delivery to read.","type":"text"}],"type":"topic","url":"\/documentation\/trackers\/tracker\/records-swift.property","title":"records","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kin