":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/rejectionReports","role":"symbol","url":"\/documentation\/trackers\/tracker\/rejectionreports"},"doc://Trackers/documentation/Trackers/Tracker":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","abstract":[{"text":"What app code tracks events with: it records each event, with the time, the caller’s source","type":"text"},{"text":" ","type":"text"},{"text":"location and the task’s context, as one of its ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"text":".","type":"text"}],"title":"Tracker","url":"\/documentation\/trackers\/tracker","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tracker","kind":"identifier"}],"navigatorTitle":[{"text":"Tracker","kind":"identifier"}],"type":"topic"},"doc://Trackers/documentation/Trackers":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","role":"collection","type":"topic","title":"Trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"url":"\/documentation\/trackers","kind":"symbol"}}}