":"text","text":" if one leaves it out, then gates the record by its consent,"},{"type":"text","text":" "},{"type":"text","text":"writes it to its store and publishes it to "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":". An event tracked after"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()","isActive":true},{"type":"text","text":" is dropped and logged at debug level. A "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp","isActive":true},{"type":"text","text":" tracker drops the event and"},{"type":"text","text":" "},{"type":"text","text":"logs it at debug level. So does "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","isActive":true},{"type":"text","text":" with no tracker bound or bootstrapped, except"},{"type":"text","text":" "},{"type":"text","text":"that the first event it drops at each call site is logged at warning level, so a missing"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" shows up in the logs rather than passing silently. A view whose tracker was"},{"type":"text","text":" "},{"type":"text","text":"never set tracks as "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current","isActive":true},{"type":"text","text":" does with nothing bound, through the tracker bootstrapped by"},{"type":"text","text":" "},{"type":"text","text":"the time it tracks."}]}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Trackers/documentation/Trackers/Sampler":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","kind":"symbol","type":"topic","title":"Sampler","abstract":[{"text":"Keeps a fraction of the events it applies to, and drops the rest before they are held,