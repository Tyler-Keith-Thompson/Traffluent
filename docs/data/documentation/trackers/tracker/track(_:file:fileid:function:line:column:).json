xt":" "},{"type":"text","text":"writes it to its store and publishes it to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":". An event tracked after"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/finish()"},{"type":"text","text":" is dropped and logged at debug level. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/noOp"},{"type":"text","text":" tracker drops the event and"},{"type":"text","text":" "},{"type":"text","text":"logs it at debug level. So does "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current"},{"type":"text","text":" with no tracker bound or bootstrapped, except"},{"type":"text","text":" "},{"type":"text","text":"that the first event it drops at each call site is logged at warning level, so a missing"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTracker"},{"type":"text","text":" shows up in the logs rather than passing silently. A view whose tracker was"},{"type":"text","text":" "},{"type":"text","text":"never set tracks as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/current"},{"type":"text","text":" does with nothing bound, through the tracker bootstrapped by"},{"type":"text","text":" "},{"type":"text","text":"the time it tracks."}]}]}],"sections":[],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/track(_:file:fileID:function:line:column:)","interfaceLanguage":"swift"},"references":{"doc://Trackers/documentation/Trackers/Tracker/samplingDropReports":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplingDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentif