entSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"store","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","preciseIdentifier":"s:11Persistence11RecordStoreP","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Consent","preciseIdentifier":"s:8Trackers7ConsentV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"enrichers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Enricher","preciseIdentifier":"s:6Events8EnricherV","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"samplers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Sampler","preciseIdentifier":"s:8Trackers7SamplerV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"samplingSeed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt64","preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier"},{"text":" = .random(in: .min ... .max), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":" = { Date.now })","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where each record is kept until it is delivered."}]}],"name":"store"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user’s consent, which each event’s category must have before it is"},{"type":"text","text":" "},{"type":"text","text":"written and delivered; "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", every event delivered, by default."}]}],"name":"consent"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What each event’s context gains, applied in order by the tracker’s worker."}]}],"name":"enrichers"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which events, or groups of events, to keep a fraction of, decided by the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker after the enrichers and before the store; none by default, so every"},{"type":"text","text":" "},{"type":"text","text":"event is kept."}]}],"name":"samplers"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The seed the samplers’ decisions come from: fix it and which events are","type":"text"},{"text":" ","type":"text"},{"text":"kept is fixed too. Drawn from the system’s random number generator once, as the tracker","type":"text"},{"text":" ","type":"text"},{"text":"is made, by default. Fix it only in tests and replays: every launch with the same seed","type":"text"},{"text":" ","type":"text"},{"text":"makes the same decision for its first matching event, its second and so on, so a","type":"text"},{"text":" ","type":"text"},{"text":"fixed seed shipped to every device keeps the same events everywhere rather than the","type":"text"},{"text":" ","type":"text"},{"text":"sampler’s rate of them.","type":"text"}]}],"name":"samplingSeed"},{"content":[{"inlineContent":[{"type":"text","text":"The wall-clock time each event is stamped with when it is tracked. It runs on the"},{"type":"text","text":" "},{"type":"text","text":"tracking caller’s thread, so keep it fast."}],"type":"paragraph"}],"name":"now"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"The tracker’s worker writes each record as it reaches it, before publishing it to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference","isActive":true},{"text":", rather than a stage reading ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","type":"reference","isActive":true},{"text":", which runs in the delivery’s task,","type":"text"},{"text":" ","type":"text"},{"text":"later, perhaps after a slow batch. Given ","type":"text"},{"code":"consent","type":"codeVoice"},{"text":", a record is written once its category","type":"text"},{"text":" ","type":"text"},{"text":"is granted, not while it is held, and the recovered records are gated again. The worker","type":"text"},{"text":" ","type":"text"},{"text":"takes the recovered records from ","type":"text"},{"code":"store","type":"codeVoice"},{"text":" before anything tracked.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"samplers"},{"type":"text","text":", a record they drop is never written. A record the store recovered was"},{"type":"text","text":" "},{"type":"text","text":"sampled in the run that wrote it, so it isn’t sampled again."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"A tracker that writes every record to "},{"type":"codeVoice","code":"store"},{"type":"text","text":", so records survive the app ending, and"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true},{"type":"text","text":" sta