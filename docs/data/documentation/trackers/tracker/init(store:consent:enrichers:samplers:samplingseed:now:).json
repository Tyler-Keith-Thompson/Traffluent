":"Enricher","navigatorTitle":[{"kind":"identifier","text":"Enricher"}],"abstract":[{"text":"Adds to the context of each event a tracker tracks, before the record is delivered.","type":"text"}]},"doc://Trackers/documentation/Trackers/Consent":{"kind":"symbol","role":"symbol","url":"\/documentation\/trackers\/consent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Consent"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","navigatorTitle":[{"kind":"identifier","text":"Consent"}],"type":"topic","abstract":[{"type":"text","text":"The user’s consent, category by category, which a tracker given it applies to every event."}],"title":"Consent"},"doc://Trackers/documentation/Trackers":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers","abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"url":"\/documentation\/trackers","role":"collection","type":"topic","title":"Trackers","kind":"symbol"},"doc://Trackers/documentation/Trackers/Tracker":{"url":"\/documentation\/trackers\/tracker","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker","role":"symbol","title":"Tracker","navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"abstract":[{"type":"text","text":"What app code tracks events with: it records each event, with the time, the caller’s source"},{"type":"text","text":" "},{"type":"text","text":"location and the task’s context, as one of its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":"."}]},"doc://Persistence/documentation/Persistence/RecordStore":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/Rec