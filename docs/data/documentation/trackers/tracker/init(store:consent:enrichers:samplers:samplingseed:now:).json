ntentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"store","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","preciseIdentifier":"s:11Persistence11RecordStoreP","identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"consent","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Consent","preciseIdentifier":"s:8Trackers7ConsentV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"enrichers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Enricher","preciseIdentifier":"s:6Events8EnricherV","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"samplers","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Sampler","preciseIdentifier":"s:8Trackers7SamplerV","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","kind":"typeIdentifier"},{"text":"] = [], ","kind":"text"},{"text":"samplingSeed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt64","preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier"},{"text":" = .random(in: .min ... .max), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":" = { Date.now })","kind":"text"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Where each record is kept until it is delivered.","type":"text"}]}],"name":"store"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user’s consent, which each event’s category must have before it is","type":"text"},{"text":" ","type":"text"},{"text":"written and delivered; ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", every event delivered, by default.","type":"text"}]}],"name":"consent"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What each event’s context gains, applied in order by the tracker’s worker."}]}],"name":"enrichers"},{"content":[{"inlineContent":[{"text":"Which events, or groups of events, to keep a fraction of, decided by the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s worker after the enrichers and before the store; none by default, so every","type":"text"},{"text":" ","type":"text"},{"text":"event is kept.","type":"text"}],"type":"paragraph"}],"name":"samplers"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The seed the samplers’ decisions come from: fix it and which events are"},{"type":"text","text":" "},{"type":"text","text":"kept is fixed too. Drawn from the system’s random number generator once, as the tracker"},{"type":"text","text":" "},{"type":"text","text":"is made, by default. Fix it only in tests and replays: every launch with the same seed"},{"type":"text","text":" "},{"type":"text","text":"makes the same decision for its first matching event, its second and so on, so a"},{"type":"text","text":" "},{"type":"text","text":"fixed seed shipped to every device keeps the same events everywhere rather than the"},{"type":"text","text":" "},{"type":"text","text":"sampler’s rate of them."}]}],"name":"samplingSeed"},{"content":[{"inlineContent":[{"type":"text","text":"The wall-clock time each event is stamped with when it is tracked. It runs on the"},{"type":"text","text":" "},{"type":"text","text":"tracking caller’s thread, so keep it fast."}],"type":"paragraph"}],"name":"now"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The tracker’s worker writes each record as it reaches it, before publishing it to"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":", rather than a stage reading "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property"},{"type":"text","text":", which runs in the delivery’s task,"},{"type":"text","text":" "},{"type":"text","text":"later, perhaps after a slow batch. Given "},{"type":"codeVoice","code":"consent"},{"type":"text","text":", a record is written once its category"},{"type":"text","text":" "},{"type":"text","text":"is granted, not while it is held, and the recovered records are gated again. The worker"},{"type":"text","text":" "},{"type":"text","text":"takes the recovered records from "},{"type":"codeVoice","code":"store"},{"type":"text","text":" before anything tracked."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"samplers"},{"type":"text","text":", a record they drop is never written. A record the store recovered was"},{"type":"text","text":" "},{"type":"text","text":"sampled in the run that wrote it, so it isn’t sampled again."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A tracker that writes every record to ","type":"text"},{"code":"store","type":"codeVoice"},{"text":", so records survive the app ending, and","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/records-swift.property","isActive":true,"type":"reference"},{"text":" start with the ones ","type":"text"},{"code":"store","type":"codeVoice"},{"text":" kept from earlier runs.","type":"text"}],"identifier":{"url":"doc:\/\/Trackers\/documentation\/Trackers\/Tracker\/init(store:consent:enrichers:samplers:samplingSeed:now:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Trackers\/documentation\/Trackers","doc:\/\/Trackers\/documentation\/Trackers\/Tracker"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"references":{"doc://Trackers/documentation/Trackers":{"abstract":[{"text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent.","type":"text"}],"role":"collection","url":"\/documentation\/trackers","title":"Trackers","kind":"symbol","identifier":"doc:\/\/Trackers\/documentation\/Trackers","type":"topic"},"doc://Trackers/documentation/Trackers/Sampler":{"identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Sampler","abstract":[{"type":"text","text":"Keeps a fraction of the events it applies to, and drops the rest before they are held, written"},{"type":"text","text":" "},{"type":"text","text":"or delivered: event by event, or a whole group of events, such as a session, at once."}],"navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"url":"\/documentation\/trackers\/sampler","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"kind":"symbol","title":"Sampler","type":"topic"},"doc://Persistence/documentation/Persistence/RecordStore":{"abstract":[{"type":"text","text":"Where a tracker keeps each record until it is delivered, so records survive the app ending."}],"kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordStore","kind":"identifier"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence\/RecordStore","role":"symbol","navigatorTitle":[{"text":"RecordStore","kind":"identifier"}],"title":"RecordStore","url":"\/documentation\/persistence\/recordstore"},"doc://Events/documentation/Events/Enricher":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/