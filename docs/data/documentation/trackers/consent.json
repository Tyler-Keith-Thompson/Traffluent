"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultHeldRecordLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]},"doc://Trackers/documentation/Trackers/Consent/deny(_:)":{"abstract":[{"text":"Denies ","type":"text"},{"type":"codeVoice","code":"categories"},{"text":": their held events are dropped, reported on ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/dropReports"},{"text":", and later","type":"text"},{"text":" ","type":"text"},{"text":"ones are not collected.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deny"},{"kind":"text","text":"("},{"preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier","text":"ConsentCategory"},{"kind":"text","text":"...)"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/trackers\/consent\/deny(_:)","title":"deny(_:)","identifier":"doc:\/\/Trackers\/documentation\/Trackers\/Consent\/deny(_:)"},"doc://Trackers/documentation/Trackers":{"abstract":[{"type":"text","text":"The tracker app code tracks events with, and what it applies to each event before it is delivered: enrichers, samplers and consent."}],"role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/trackers","title":"Trackers","identifier":"doc:\/\/Trackers\/documentation\/Trackers"},"doc://Trackers/documentation/Trackers/Consent/status(of:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"status"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events15ConsentCategoryV","text":"ConsentCategory"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:8Trackers13ConsentStatusO","text":"