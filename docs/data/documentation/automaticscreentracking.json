{"hierarchy":{"paths":[[]]},"metadata":{"role":"collection","modules":[{"name":"AutomaticScreenTracking"}],"roleHeading":"Framework","externalID":"AutomaticScreenTracking","title":"AutomaticScreenTracking","symbolKind":"module"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/automaticscreentracking"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/AutomaticScreenTracking\/documentation\/AutomaticScreenTracking","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Track a screen view each time a screen’s view controller appears, without a modifier or a call on"},{"type":"text","text":" "},{"type":"text","text":"each screen."}],"kind":"symbol","sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Use this module when an app’s screens should track their own views: on iOS, iPadOS, tvOS,"},{"type":"text","text":" "},{"type":"text","text":"visionOS and Mac Catalyst through a "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":", and on macOS through an "},{"type":"codeVoice","code":"NSWindow"},{"type":"text","text":". On"},{"type":"text","text":" "},{"type":"text","text":"watchOS and Linux it builds empty. To track one screen by hand, or a view a macOS"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":" pushes, give it "},{"type":"codeVoice","code":"trackScreen(_:)"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"},{"inlineContent":[{"text":"Nothing is tracked until a window scene or a window turns it on with ","type":"text"},{"code":"trackScreensAutomatically","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"A screen is a view controller on screen none of whose children is: the one a navigation","type":"text"},{"text":" ","type":"text"},{"text":"controller shows, a tab’s, one presented. It tracks ","type":"text"},{"code":"ScreenViewed","type":"codeVoice"},{"text":" once as it appears, and again","type":"text"},{"text":" ","type":"text"},{"text":"when it reappears after being covered or hidden. The screen is named after its controller’s type,","type":"text"},{"text":" ","type":"text"},{"text":"or for a hosting controller after the type of the SwiftUI view it shows. The closure gets each","type":"text"},{"text":" ","type":"text"},{"code":"DiscoveredScreen","type":"codeVoice"},{"text":" and returns the event to track, renamed, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to skip the screen:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackScreensAutomatically { screen in","    screen.name == \"DebugMenuViewController\" ? nil : ScreenViewed(screen: screen.name)","}"]},{"inlineContent":[{"type":"text","text":"On macOS, a window turns it on, and each screen view goes through the tracker the screen’s view"},{"type":"text","text":" "},{"type":"text","text":"finds up its responder chain ("},{"type":"codeVoice","code":"NSView.tracker"},{"type":"text","text":", from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"type":"text","text":"):"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import AppKit","import SwiftUI","","struct PreferencesView: View {","    var body: some View {","        Text(\"Preferences\")","    }","}","","final class PreferencesWindowController: NSWindowController, TrackerProviding {","    let tracker: Tracker","","    init(tracker: Tracker) {","        self.tracker = tracker","        super.init(window: NSWindow(contentViewController: NSHostingController(rootView: PreferencesView())))","    }","","    required init?(coder: NSCoder) { nil }","}","","let controller = PreferencesWindowController(tracker: tracker)","controller.window?.trackScreensAutomatically()  \/\/ tracks ScreenViewed(screen: \"PreferencesView\")","controller.showWindow(nil)"]},{"inlineContent":[{"code":"kinds:","type":"codeVoice"},{"type":"text","text":" limits tracking to UIKit’s (or AppKit’s) view controllers or to SwiftUI’s views. A"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI screen given "},{"code":"trackScreen(_:)","type":"codeVoice"},{"type":"text","text":" is left to that modifier, so it isn’t tracked twice."},{"type":"text","text":" "},{"type":"text","text":"Discovery looks after each turn of the main run loop, swizzles nothing, and touches no other scene"},{"type":"text","text":" "},{"type":"text","text":"or window. On a UIKit platform, each screen view goes through the tracker the screen’s traits"},{"type":"text","text":" "},{"type":"text","text":"hold, so each scene keeps its own."}],"type":"paragraph"},{"inlineContent":[{"text":"This documentation is built on macOS, so ","type":"text"},{"type":"codeVoice","code":"UIWindowScene"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"trackScreensAutomatically(kinds:_:)"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"stopTrackingScreensAutomatically()"},{"text":" have no pages here; they take the same parameters as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSWindow"},{"text":"’s, with ","type":"text"},{"type":"codeVoice","code":"kinds:"},{"text":" defaulting to ","type":"text"},{"type":"codeVoice","code":"[.uiKit, .swiftUI]"},{"text":", and their doc comments are in the","type":"text"},{"text":" ","type":"text"},{"text":"sources.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking"},{"type":"text","text":" "},{"type":"text","text":"also covers control activations and the app’s lifecycle."}],"type":"paragraph"},{"type":"heading","text":"API","anchor":"API","level":2},{"inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols"},{"type":"text","text":" "},{"type":"text","text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them"},{"type":"text","text":" "},{"type":"text","text":"for an Apple target."}],"type":"paragraph"},{"type":"heading","text":"Tracking a window’s screens","anchor":"Tracking-a-windows-screens","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"NSWindow.trackScreensAutomatically(kinds:_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSWindow.stopTrackingScreensAutomatically()"}],"type":"paragraph"}]}]},{"type":"heading","text":"Naming screens","anchor":"Naming-screens","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"DiscoveredScreen","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"DiscoveredScreen.Kind","type":"codeVoice"}]}]}]}],"kind":"content"}],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/automatictracking":{"titleInlineContent":[{"text":"Automatic Tracking","type":"text"}],"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","title":"Automatic Tr