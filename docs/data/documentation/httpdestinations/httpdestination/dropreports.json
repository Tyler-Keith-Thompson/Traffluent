{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"A report of each batch dropped without being delivered, in the order they are dropped."}],"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/httpdestinations\/httpdestination\/dropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"]]},"metadata":{"title":"dropReports","externalID":"s:16HTTPDestinations15HTTPDestinationV11dropReports11AsyncQueues0E5QueueVyAA14HTTPDropReportOy7FailureQy_GGvp","modules":[{"name":"HTTPDestinations"}],"roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO","text":"HTTPDropReport"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa","text":"Failure"},{"kind":"text","text":">>"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L185","fileName":"HTTPDestination.swift"},"role":"symbol","symbolKind":"property"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","identifier":"doc