"type":"text","text":" "},{"type":"text","text":"A reader cancelled while it waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport":{"title":"HTTPDropReport","url":"\/documentation\/httpdestinations\/httpdropreport","navigatorTitle":[{"text":"HTTPDropReport","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDropReport","kind":"identifier"}],"role":"symbol","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","kind":"symbol","abstract":[{"type":"text","text":"A batch "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" dropped without delivering it, and why."}]},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","title":"AsyncQueue","abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}],"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/asyncqueues\/asyncqueue","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/dropReports":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dropReports"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier","text":"AsyncQueue"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO","kind":"typeIdentifier","text":"HTTPDropReport"},{"kind":"tex