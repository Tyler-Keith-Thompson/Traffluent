{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)"},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outcome"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"response"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse","text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":" "},{"kind":"internalParam","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","text":"EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome","text":"ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"response","content":[{"inlineContent":[{"text":"The answer: a 2xx status, its header fields and its body.","type":"text"}],"type":"paragraph"}]},{"name":"request","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The request it answers, as the encoder made it."}]}]}]},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Whether the request’s records were delivered, refused for good, or refused for","type":"text"},{"text":" ","type":"text"},{"text":"now.","type":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" calls it for every 2xx answer, and only for those, with the answer’s","type":"text"},{"text":" ","type":"text"},{"text":"status, header fields and body, and the request it answers, for a vendor whose answer is","type":"text"},{"text":" ","type":"text"},{"text":"read against what was sent (a count of the records it took, say). An encoder for a vendor that stores what it answers 2xx to","type":"text"},{"text":" ","type":"text"},{"text":"returns ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/delivered","isActive":true,"type":"reference"},{"text":". One for a vendor that answers 2xx to a request it","type":"text"},{"text":" ","type":"text"},{"text":"stores nothing of, and says so in the body (Mixpanel’s ","type":"text"},{"code":"{\"status\": 0, \"error\": ...}","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"returns ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)","isActive":true,"type":"reference"},{"text":", which drops and reports the request, or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)","isActive":true,"type":"reference"},{"text":", which sends it again. A body the vendor doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"document, an empty one or one that doesn’t parse included, is","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/delivered","isActive":true,"type":"reference"},{"text":": the request did arrive, and sending it again after an","type":"text"},{"text":" ","type":"text"},{"text":"answer the encoder can’t read would repeat it for as long as the vendor keeps answering","type":"text"},{"text":" ","type":"text"},{"text":"that way. The conformance kit’s ","type":"text"},{"code":"unreadableSuccessDelivered","type":"codeVoice"},{"text":" check holds an encoder to","type":"text"},{"text":" ","type":"text"},{"text":"this. An encoder that wraps another forwards the wrapped encoder’s outcome.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A transient outcome is sent again until it is delivered, rejected, or past the request’s"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline"},{"type":"text","text":". A request with no deadline is sent again for as long as the"},{"type":"text","text":" "},{"type":"text","text":"vendor keeps answering that way, so an encoder whose requests have none returns"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)"},{"type":"text","text":" rather than "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)"},{"type":"text","text":" "},{"type":"text","text":"unless the vendor documents that the answer passes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A vendor fact, as "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","isActive":true},{"type":"text","text":" is, so it is static, with no default: a conformer"},{"type":"text","text":" "},{"type":"text","text":"that leaves it out, or misspells it, doesn’t compile, rather than silently counting a"},{"type":"text","text":" "},{"type":"text","text":"refused request as delivered."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"]]},"variants":[{"paths":["\/documentation\/httpdestinations\/batchencoder\/outcome(of:for:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"What the successful (2xx) answer ","type":"text"},{"type":"codeVoice","code":"response"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"request"},{"text":", one of this encoder’s requests,","type":"text"},{"text":" ","type":"text"},{"text":"means: whether the vendor stored the request’s records.","type":"text"}],"metadata":{"externalID":"s:16HTTPDestinations12BatchEncoderP7outcome2of3forAA15ResponseOutcomeOAA013HTTPTransportG0V_AA14EncodedRequestVtFZ","roleHeading":"Type Method","symbolKind":"method","modules":[{"name":"HTTPDestinations"}],"required":true,"title":"outcome(of:for:)","remoteSource":{"fileName":"BatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/BatchEncoder.swift#L101"},"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","kind":"typeIdentifier"}],"role":"symbol"},"references