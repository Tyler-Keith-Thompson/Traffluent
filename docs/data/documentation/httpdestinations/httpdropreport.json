{"sections":[],"abstract":[{"text":"A batch ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":" dropped without delivering it, and why.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/SQ","doc:\/\/HTTPDestinations\/SH","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo"}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","interfaceLanguage":"swift"},"metadata":{"symbolKind":"enum","roleHeading":"Enumeration","externalID":"s:16HTTPDestinations14HTTPDropReportO","modules":[{"name":"HTTPDestinations"}],"navigatorTitle":[{"text":"HTTPDropReport","kind":"identifier"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDropReport","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDropReport.swift#L17","fileName":"HTTPDropReport.swift"},"title":"HTTPDropReport"},"kind":"symbol","seeAlsoSections":[{"title":"Sending batches","generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"],"anchor":"Sending-batches"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDropReport","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"}]}]},{"content":[{"anchor":"overview","level":2,"type":"heading","te