{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","interfaceLanguage":"swift"},"metadata":{"symbolKind":"struct","externalID":"s:16HTTPDestinations15HTTPDestinationV","modules":[{"name":"HTTPDestinations"}],"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L96","fileName":"HTTPDestination.swift"},"title":"HTTPDestination"},"kind":"symbol","seeAlsoSections":[{"title":"Sending batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"generated":true,"anchor":"Sending-batches"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Transport"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Encoding"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP","text":"HTTPTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","text":"BatchEncoder"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wire shape, for a server that ingests these batches:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The requests the encoder splits each batch into (","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":"), in the","type":"text"},{"text":" ","type":"text"},{"text":"order the delivery hands batches over, each request sent only once the previous one is","type":"text"},{"text":" ","type":"text"},{"text":"delivered or dropped.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The method is "},{"code":"POST","type":"codeVoice"},{"type":"text","text":" and the URL is the configured endpoint."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The header fields are the configured ones, then the trace context of the request’s first","type":"text"},{"text":" ","type":"text"},{"text":"record, then ","type":"text"},{"type":"codeVoice","code":"Content-Type"},{"text":", each replacing fields of the same name before it:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"The instrument injects the first (oldest) record’s ","type":"text"},{"code":"EventRecord\/context","type":"codeVoice"},{"text":", so a server","type":"text"},{"text":" ","type":"text"},{"text":"extracting it joins the request, and the events, to the trace the app was in. Its field","type":"text"},{"text":" ","type":"text"},{"text":"names are the instrument’s: ","type":"text"},{"code":"traceparent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"tracestate","type":"codeVoice"},{"text":" for a W3C Trace Context tracer.","type":"text"},{"text":" ","type":"text"},{"text":"A record tracked outside any span, or an instrument that injects nothing (the default","type":"text"},{"text":" ","type":"text"},{"code":"NoOpInstrument","type":"codeVoice"},{"text":" when none is bootstrapped), adds no fields.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the first record’s context travels in the header fields, though a request may hold"},{"type":"text","text":" "},{"type":"text","text":"records tracked in other traces. A server that needs each record’s context reads it from"},{"type":"text","text":" "},{"type":"text","text":"the body, where a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" writes it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" is always the encoder’s "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","isActive":true},{"type":"text","text":", whatever a configured"},{"type":"text","text":" "},{"type":"text","text":"field or the instrument wrote."}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is exactly the encoder’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},{"type":"text","text":" for the request’s records, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. The format is the encoder’s; events need no "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A response with a 2xx status means the request arrived, and the encoder reads its body to"},{"type":"text","text":" "},{"type":"text","text":"say whether the vendor stored it ("},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","isActive":true,"type":"reference"},{"type":"text","text":"): most vendors answer 2xx"},{"type":"text","text":" "},{"type":"text","text":"only to what they store, and their encoders count every 2xx as delivered. A vendor that"},{"type":"text","text":" "},{"type":"text","text":"answers 2xx to a request it stores nothing of, and says so in the body (Mixpanel’s"},{"type":"text","text":" "},{"code":"{\"status\": 0, \"error\": ...}","type":"codeVoice"},{"type":"text","text":"), has the request dropped and reported"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)","isActive":true,"type":"reference"},{"type":"text","text":"), or, for a refusal its vendor"},{"type":"text","text":" "},{"type":"text","text":"says may pass, sent again as after a 5xx, until the request’s deadline. An encoder should"},{"type":"text","text":" "},{"type":"text","text":"count a body it can’t read, an empty one included, as delivered, so an answer that changes"},{"type":"text","text":" "},{"type":"text","text":"shape never makes the destination send the same request again and again; the"},{"type":"text","text":" "},{"type":"text","text":"DestinationTesting conformance kit checks that it does."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A request the transport can never send ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"malformed or unsupported URL, or an "},{"type":"codeVoice","code":"http"},{"type":"text","text":" URL App Transport Security refuses) isn’t sent"},{"type":"text","text":" "},{"type":"text","text":"again."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"No response, a 5xx status, 408 Request Timeout, 429 Too Many Requests, or a status the","type":"text"},{"text":" ","type":"text"},{"text":"encoder lists in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses"},{"text":" means it didn’t arrive yet: the same","type":"text"},{"text":" ","type":"text"},{"text":"request is sent again after the backoff’s next wait, for as long as it takes. A","type":"text"},{"text":" ","type":"text"},{"code":"Retry-After","type":"codeVoice"},{"text":" field is not read; the backoff alone sets the wait.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Any other status means the endpoint won’t take the request, and it isn’t sent again. The"},{"type":"text","text":" "},{"type":"text","text":"batch’s later requests are still sent."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A request with a deadline ("},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","isActive":true},{"type":"text","text":") is sent only while the destination’s"},{"type":"text","text":" "},{"type":"text","text":"wall clock reads that time or earlier, checked before every attempt, the first included, and"},{"type":"text","text":" "},{"type":"text","text":"again when an attempt fails. One still undelivered once it has passed isn’t sent again, and"},{"type":"text","text":" "},{"type":"text","text":"is reported without waiting out a backoff, so a vendor that would misdate or ignore records"},{"type":"text","text":" "},{"type":"text","text":"that old never receives them. The whole request is dropped, its younger records too; the"},{"type":"text","text":" "},{"type":"text","text":"batch’s later requests are still sent."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A record can arrive twice: a request the server took whose response was lost is sent","type":"text"},{"text":" ","type":"text"},{"text":"again, and a record a store redelivers after the app was stopped mid-send","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"EventRecord\/isRedelivered","type":"codeVoice"},{"text":") may have arrived before. Its ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" is the one it was","type":"text"},{"text":" ","type":"text"},{"text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one","type":"text"},{"text":" ","type":"text"},{"text":"copy.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A batch of several requests is acknowledged only once every request is delivered or dropped.","type":"text"},{"text":" ","type":"text"},{"text":"A delivery cancelled, or an app stopped, after some of its requests arrived hands the whole","type":"text"},{"text":" ","type":"text"},{"text":"batch over again, so those requests are sent again too: a server that keeps one copy per","type":"text"},{"text":" ","type":"text"},{"text":"record identifier absorbs them. The records the encoder leaves out are then reported again.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},{"type":"text","text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so"},{"type":"text","text":" "},{"type":"text","text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being"},{"type":"text","text":" "},{"type":"text","text":"retried when the app ends is delivered again on the next launch. A request the endpoint"},{"type":"text","text":" "},{"type":"text","text":"rejects, by its status or in a 2xx answer’s body, that can’t be sent or that passed its"},{"type":"text","text":" "},{"type":"text","text":"deadline, a batch the encoder can’t encode, and"},{"type":"text","text":" "},{"type":"text","text":"a record the encoder leaves out of its requests are dropped: logged at error level and"},{"type":"text","text":" "},{"type":"text","text":"reported on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"},{"type":"text","text":". Each failed attempt that will be retried is logged at notice"},{"type":"text","text":" "},{"type":"text","text":"level."},{"type":"text","text":" "},{"type":"text","text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},{"type":"text","text":" returns without logging or reporting it, or sending the batch’s later"},{"type":"text","text":" "},{"type":"text","text":"requests. A request whose wait before the next attempt throws something other than"},{"type":"text","text":" "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" (a custom clock’s failure) is given up on, logged at error level but not"},{"type":"text","text":" "},{"type":"text","text":"reported, and the batch’s next request is sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,"},{"type":"text","text":" "},{"type":"text","text":"which drops its oldest batch when full and reports it on the delivery’s "},{"code":"bufferDropReports","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"With a store, a dropped batch’s records aren’t lost: once this destination has caught up, the"},{"type":"text","text":" "},{"type":"text","text":"delivery reads them back from the store and hands them to it again, in the same run, so they"},{"type":"text","text":" "},{"type":"text","text":"are sent once the endpoint answers."},{"type":"text","text":" "},{"type":"text","text":"Without a store, the records of a dropped batch are lost."}]},{"type":"codeListing","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"],"syntax":"swift"}]}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:randomNumberGenerator:now:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:randomNumberGenerator:now:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations\/httpdestination"]}],"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"sections":[],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport":{"url":"\/documentation\/httpdestinations\/httpdropreport","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDropReport","kind":"identifier"}],"role":"symbol","type":"topic","title":"HTTPDropReport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","navigatorTitle":[{"text":"HTTPDropReport","kind":"identifier"}],"abstract":[{"type":"text","text":"A batch "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" dropped without delivering it, and why."}],"kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/dropReports":{"title":"dropReports","abstract":[{"type":"text","text":"A report of each batch dropped without being delivered, in the order they are dropped."}],"url":"\/documentation\/httpdestinations\/httpdestination\/dropreports","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"HTTPDropReport","preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Failure","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/transientStatuses":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientStatuses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"TransientStatus","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV"},{"kind":"text","text":">"}],"kind":"symbol","required":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","type":"topic","role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder\/transientstatuses","title":"transientStatuses","abstract":[{"type":"text","text":"The failure statuses, beyond 408 Request Timeout, 429 Too Many Requests and every 5xx, that"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"type":"text","text":" sends a request of this encoder again after: "},{"code":"[]","type":"codeVoice"},{"type":"text","text":" for none."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/receive(_:)":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)","abstract":[{"text":"Sends ","type":"text"},{"code":"batch","type":"codeVoice"},{"text":" to the endpoint, as the requests its encoder splits it into, one after","type":"text"},{"text":" ","type":"text"},{"text":"another; sends each again after each transient failure, and returns once every one is","type":"text"},{"text":" ","type":"text"},{"text":"delivered or dropped, or the delivery is cancelled.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"receive","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":"]) ","kind":"text"},{"text":"async","kind":"keyword"}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/httpdestinations\/httpdestination\/receive(_:)","title":"receive(_:)"},"doc://Destinations/documentation/Destinations/Destination":{"kind":"symbol","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","url":"\/documentation\/destinations\/destination","abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"role":"symbol","type":"topic","title":"Destination"},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedBatch/body":{"abstract":[{"text":"The request body.","type":"text"}],"title":"body","url":"\/documentation\/httpdestinations\/encodedbatch\/body","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:20FoundationEssentials4DataV","kind":"typeIdentifier"}],"role":"symbol","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},"doc://HTTPDestinations/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/HTTPDestinations\/s8SendableP","type":"unresolvable"},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedBatch/contentType":{"title":"contentType","abstract":[{"type":"text","text":"The body’s media type, sent as the request’s "},{"code":"Content-Type","type":"codeVoice"},{"type":"text","text":": "},{"code":"\"application\/json\"","type":"codeVoice"},{"type":"text","text":", say."}],"url":"\/documentation\/httpdestinations\/encodedbatch\/contenttype","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contentType","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"role":"symbol","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType"},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedRequest/deadline":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"deadline"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":"?"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The latest wall-clock time at which the request may be sent, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when it may be sent"},{"type":"text","text":" "},{"type":"text","text":"at any time."}],"url":"\/documentation\/httpdestinations\/encodedrequest\/deadline","title":"deadline","role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline"},"doc://HTTPDestinations/documentation/HTTPDestinations/ResponseOutcome/rejected(reason:)":{"title":"ResponseOutcome.rejected(reason:)","abstract":[{"text":"The vendor stored none of the request’s records, and wouldn’t if it were sent again, for","type":"text"},{"text":" ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":", the vendor’s own words where its body has them: ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" drops the","type":"text"},{"text":" ","type":"text"},{"text":"request and reports it as ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejected"},{"kind":"text","text":"("},{"kind":"externalParam","text":"reason"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":")"}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/httpdestinations\/responseoutcome\/rejected(reason:)","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransportError/invalidRequest(reason:)":{"title":"HTTPTransportError.invalidRequest(reason:)","abstract":[{"text":"The transport can never send the request as it is: its URL is malformed or of a scheme the","type":"text"},{"text":" ","type":"text"},{"text":"transport doesn’t support, or the platform refuses it, as App Transport Security refuses","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"http","type":"codeVoice"},{"text":" URL.","type":"text"}],"url":"\/documentation\/httpdestinations\/httptransporterror\/invalidrequest(reason:)","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"invalidRequest","kind":"identifier"},{"text":"(","kind":"text"},{"text":"reason","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransport":{"navigatorTitle":[{"text":"HTTPTransport","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPTransport","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","url"