{"metadata":{"roleHeading":"Structure","modules":[{"name":"HTTPDestinations"}],"externalID":"s:16HTTPDestinations15HTTPDestinationV","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"title":"HTTPDestination","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"remoteSource":{"fileName":"HTTPDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/HTTPDestination.swift#L96"}},"hierarchy":{"paths":[["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations\/httpdestination"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Transport"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Encoding"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:16HTTPDestinations13HTTPTransportP","kind":"typeIdentifier","text":"HTTPTransport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP","kind":"typeIdentifier","text":"BatchEncoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wire shape, for a server that ingests these batches:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The requests the encoder splits each batch into ("},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/requests(for:)","type":"reference"},{"type":"text","text":"), in the"},{"type":"text","text":" "},{"type":"text","text":"order the delivery hands batches over, each request sent only once the previous one is"},{"type":"text","text":" "},{"type":"text","text":"delivered or dropped."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The method is "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" and the URL is the configured endpoint."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The header fields are the configured ones, then the trace context of the request’s first"},{"type":"text","text":" "},{"type":"text","text":"record, then "},{"code":"Content-Type","type":"codeVoice"},{"type":"text","text":", each replacing fields of the same name before it:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The instrument injects the first (oldest) record’s "},{"type":"codeVoice","code":"EventRecord\/context"},{"type":"text","text":", so a server"},{"type":"text","text":" "},{"type":"text","text":"extracting it joins the request, and the events, to the trace the app was in. Its field"},{"type":"text","text":" "},{"type":"text","text":"names are the instrument’s: "},{"type":"codeVoice","code":"traceparent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"tracestate"},{"type":"text","text":" for a W3C Trace Context tracer."},{"type":"text","text":" "},{"type":"text","text":"A record tracked outside any span, or an instrument that injects nothing (the default"},{"type":"text","text":" "},{"type":"codeVoice","code":"NoOpInstrument"},{"type":"text","text":" when none is bootstrapped), adds no fields."}]}]},{"content":[{"inlineContent":[{"text":"Only the first record’s context travels in the header fields, though a request may hold","type":"text"},{"text":" ","type":"text"},{"text":"records tracked in other traces. A server that needs each record’s context reads it from","type":"text"},{"text":" ","type":"text"},{"text":"the body, where a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" writes it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Content-Type"},{"type":"text","text":" is always the encoder’s "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/contentType","type":"reference","isActive":true},{"type":"text","text":", whatever a configured"},{"type":"text","text":" "},{"type":"text","text":"field or the instrument wrote."}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is exactly the encoder’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body"},{"type":"text","text":" for the request’s records, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. The format is the encoder’s; events need no "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A response with a 2xx status means the request arrived, and the encoder reads its body to"},{"type":"text","text":" "},{"type":"text","text":"say whether the vendor stored it ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)"},{"type":"text","text":"): most vendors answer 2xx"},{"type":"text","text":" "},{"type":"text","text":"only to what they store, and their encoders count every 2xx as delivered. A vendor that"},{"type":"text","text":" "},{"type":"text","text":"answers 2xx to a request it stores nothing of, and says so in the body (Mixpanel’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"type":"text","text":"), has the request dropped and reported"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)"},{"type":"text","text":"), or, for a refusal its vendor"},{"type":"text","text":" "},{"type":"text","text":"says may pass, sent again as after a 5xx, until the request’s deadline. An encoder should"},{"type":"text","text":" "},{"type":"text","text":"count a body it can’t read, an empty one included, as delivered, so an answer that changes"},{"type":"text","text":" "},{"type":"text","text":"shape never makes the destination send the same request again and again; the"},{"type":"text","text":" "},{"type":"text","text":"DestinationTesting conformance kit checks that it does."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A request the transport can never send ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)"},{"type":"text","text":": a"},{"type":"text","text":" "},{"type":"text","text":"malformed or unsupported URL, or an "},{"code":"http","type":"codeVoice"},{"type":"text","text":" URL App Transport Security refuses) isn’t sent"},{"type":"text","text":" "},{"type":"text","text":"again."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No response, a 5xx status, 408 Request Timeout, 429 Too Many Requests, or a status the"},{"type":"text","text":" "},{"type":"text","text":"encoder lists in "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","isActive":true},{"type":"text","text":" means it didn’t arrive yet: the same"},{"type":"text","text":" "},{"type":"text","text":"request is sent again after the backoff’s next wait, for as long as it takes. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Retry-After"},{"type":"text","text":" field is not read; the backoff alone sets the wait."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any other status means the endpoint won’t take the request, and it isn’t sent again. The"},{"type":"text","text":" "},{"type":"text","text":"batch’s later requests are still sent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A request with a deadline ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline"},{"type":"text","text":") is sent only while the destination’s"},{"type":"text","text":" "},{"type":"text","text":"wall clock reads that time or earlier, checked before every attempt, the first included, and"},{"type":"text","text":" "},{"type":"text","text":"again when an attempt fails. One still undelivered once it has passed isn’t sent again, and"},{"type":"text","text":" "},{"type":"text","text":"is reported without waiting out a backoff, so a vendor that would misdate or ignore records"},{"type":"text","text":" "},{"type":"text","text":"that old never receives them. The whole request is dropped, its younger records too; the"},{"type":"text","text":" "},{"type":"text","text":"batch’s later requests are still sent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A record can arrive twice: a request the server took whose response was lost is sent"},{"type":"text","text":" "},{"type":"text","text":"again, and a record a store redelivers after the app was stopped mid-send"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"EventRecord\/isRedelivered"},{"type":"text","text":") may have arrived before. Its "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" is the one it was"},{"type":"text","text":" "},{"type":"text","text":"first sent with, so an encoder that writes each record’s identifier lets the server keep one"},{"type":"text","text":" "},{"type":"text","text":"copy."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A batch of several requests is acknowledged only once every request is delivered or dropped.","type":"text"},{"text":" ","type":"text"},{"text":"A delivery cancelled, or an app stopped, after some of its requests arrived hands the whole","type":"text"},{"text":" ","type":"text"},{"text":"batch over again, so those requests are sent again too: a server that keeps one copy per","type":"text"},{"text":" ","type":"text"},{"text":"record identifier absorbs them. The records the encoder leaves out are then reported again.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},{"type":"text","text":" returns once the batch is delivered, dropped, or the delivery is cancelled, so"},{"type":"text","text":" "},{"type":"text","text":"a tracker’s store keeps the records of a batch until it arrives, and a batch still being"},{"type":"text","text":" "},{"type":"text","text":"retried when the app ends is delivered again on the next launch. A request the endpoint"},{"type":"text","text":" "},{"type":"text","text":"rejects, by its status or in a 2xx answer’s body, that can’t be sent or that passed its"},{"type":"text","text":" "},{"type":"text","text":"deadline, a batch the encoder can’t encode, and"},{"type":"text","text":" "},{"type":"text","text":"a record the encoder leaves out of its requests are dropped: logged at error level and"},{"type":"text","text":" "},{"type":"text","text":"reported on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"},{"type":"text","text":". Each failed attempt that will be retried is logged at notice"},{"type":"text","text":" "},{"type":"text","text":"level."},{"type":"text","text":" "},{"type":"text","text":"Cancelling the delivery cancels the send in flight or the wait before the next one, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"},{"type":"text","text":" returns without logging or reporting it, or sending the batch’s later"},{"type":"text","text":" "},{"type":"text","text":"requests. A request whose wait before the next attempt throws something other than"},{"type":"text","text":" "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" (a custom clock’s failure) is given up on, logged at error level but not"},{"type":"text","text":" "},{"type":"text","text":"reported, and the batch’s next request is sent."}]},{"type":"paragraph","inlineContent":[{"text":"While a batch is retried, the delivery’s later batches wait in this destination’s buffer,","type":"text"},{"text":" ","type":"text"},{"text":"which drops its oldest batch when full and reports it on the delivery’s ","type":"text"},{"type":"codeVoice","code":"bufferDropReports"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"With a store, a dropped batch’s records aren’t lost: once this destination has caught up, the","type":"text"},{"text":" ","type":"text"},{"text":"delivery reads them back from the store and hands them to it again, in the same run, so they","type":"text"},{"text":" ","type":"text"},{"text":"are sent once the endpoint answers.","type":"text"},{"text":" ","type":"text"},{"text":"Without a store, the records of a dropped batch are lost.","type":"text"}]},{"syntax":"swift","code":["let collector = HTTPDestination(","    endpoint: collectorURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder())","let delivery = tracker.records.batch().deliver(to: collector)"],"type":"codeListing"}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"relationshipsSections":[{"identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"topicSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:encoder:backoff:clock:randomNumberGenerator:now:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:randomNumberGenerator:now:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/receive(_:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/Destination-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"generated":true,"title":"Sending batches","anchor":"Sending-batches"}],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/ResponseOutcome/rejected(reason:)":{"abstract":[{"type":"text","text":"The vendor stored none of the request’s records, and wouldn’t if it were sent again, for"},{"type":"text","text":" "},{"type":"codeVoice","code":"reason"},{"type":"text","text":", the vendor’s own words where its body has them: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" drops the"},{"type":"text","text":" "},{"type":"text","text":"request and reports it as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)"},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)","type":"topic","url":"\/documentation\/httpdestinations\/responseoutcome\/rejected(reason:)","title":"ResponseOutcome.rejected(reason:)","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rejected","kind":"identifier"},{"text":"(","kind":"text"},{"text":"reason","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://Destinations/documentation/Destinations/Destination":{"navigatorTitle":[{"text":"Destination","kind":"identifier"}],"url":"\/documentation\/destinations\/destination","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","type":"topic","abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"role":"symbol","title":"Destination"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"type":"topic","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","kind":"symbol","url":"\/documentation\/httpdestinations","title":"HTTPDestinations","role":"collection"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/transientStatuses":{"required":true,"url":"\/documentation\/httpdestinations\/batchencoder\/transientstatuses","abstract":[{"text":"The failure statuses, beyond 408 Request Timeout, 429 Too Many Requests and every 5xx, that","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":" sends a request of this encoder again after: ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" for none.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transientStatuses","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"TransientStatus","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","title":"transientStatuses","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedBatch/body":{"kind":"symbol","abstract":[{"text":"The request body.","type":"text"}],"title":"body","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch\/body","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"body"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DataV","text":"Data"}],"url":"\/documentation\/httpdestinations\/encodedbatch\/body","role":"symbol","type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransportError/invalidRequest(reason:)":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError\/invalidRequest(reason:)","type":"topic","url":"\/documentation\/httpdestinations\/httptransporterror\/invalidrequest(reason:)","abstract":[{"type":"text","text":"The transport can never send the request as it is: its URL is malformed or of a scheme the"},{"type":"text","text":" "},{"type":"text","text":"transport doesn’t support, or the platform refuses it, as App Transport Security refuses"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"http"},{"type":"text","text":" URL."}],"title":"HTTPTransportError.invalidRequest(reason:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"invalidRequest"},{"kind":"text","text":"("},{"kind":"externalParam","text":"reason"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/init(endpoint:headerFields:instrument:transport:encoder:backoff:clock:randomNumberGenerator:now:)":{"kind":"symbol","url":"\/documentation\/httpdestinations\/httpdestination\/init(endpoint:headerfields:instrument:transport:encoder:backoff:clock:randomnumbergenerator:now:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"endpoint"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"URL","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"headerFields"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"HTTPFields","preciseIdentifier":"s:9HTTPTypes10HTTPFieldsV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"instrument"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"Instrument","preciseIdentifier":"s:15Instrumentation10InstrumentP"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"encoder"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Encoding"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ExponentialBackoff","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"randomNumberGenerator"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"kind":"text","text":")"}],"role":"symbol","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/init(endpoint:headerFields:instrument:transp