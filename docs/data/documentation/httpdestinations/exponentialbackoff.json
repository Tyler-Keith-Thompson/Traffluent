{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExponentialBackoff"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"code":"ExponentialBackoff()","type":"codeVoice"},{"text":" has nominal waits of 1, 2, 4, 8, 16 and 32 seconds, then 60 seconds for","type":"text"},{"text":" ","type":"text"},{"text":"every retry after that, with full jitter, as this one does:","type":"text"}]},{"type":"codeListing","code":["let backoff = try ExponentialBackoff(initialDelay: .seconds(1), maximumDelay: .seconds(60), jitter: .full)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/delay(beforeRetry:)","type":"reference"},{"type":"text","text":" is the nominal wait. What "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"type":"text","text":" sleeps before each retry"},{"type":"text","text":" "},{"type":"text","text":"depends on the backoff’s jitter:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/full","isActive":true,"type":"reference"},{"type":"text","text":", the default: a random wait, at least zero and less than the nominal one,"},{"type":"text","text":" "},{"type":"text","text":"drawn afresh before each retry from the destination’s random number generator."}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/none","isActive":true,"type":"reference"},{"type":"text","text":": the nominal wait. It is exact when both delays count their attoseconds in"},{"type":"text","text":" "},{"type":"text","text":"53 significant bits or fewer, as any whole number of milliseconds under 295 seconds does;"},{"type":"text","text":" "},{"type":"text","text":"otherwise it is within about one part in 2⁵³ of it."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Jitter is on by default because apps tend to be refused all at once. A rate limiter’s window,"},{"type":"text","text":" "},{"type":"text","text":"or an outage ending, refuses many apps at the same moment. Without jitter they would all retry"},{"type":"text","text":" "},{"type":"text","text":"at the same moments too, and each wave would be refused like the one before. Full jitter"},{"type":"text","text":" "},{"type":"text","text":"spreads each wave over the whole wait. It also halves the average wait, so an app retries"},{"type":"text","text":" "},{"type":"text","text":"about twice as often during a long outage."}]}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/HTTPDestinations\/SQ","doc:\/\/HTTPDestinations\/SH","doc:\/\/HTTPDestinations\/s8SendableP","doc:\/\/HTTPDestinations\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations\/exponentialbackoff"]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/init(initialDelay:maximumDelay:jitter:)","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/init(jitter:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/Exponen