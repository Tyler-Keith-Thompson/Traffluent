{"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"],"anchor":"Waiting-between-attempts","title":"Waiting between attempts"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExponentialBackoff","kind":"identifier"}],"platforms":["Linux"]}]},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"code":"ExponentialBackoff()","type":"codeVoice"},{"type":"text","text":" has nominal waits of 1, 2, 4, 8, 16 and 32 seconds, then 60 seconds for"},{"type":"text","text":" "},{"type":"text","text":"every retry after that, with full jitter, as this one does:"}],"type":"paragraph"},{"syntax":"swift","code":["let backoff = try ExponentialBackoff(initialDelay: .seconds(1), maximumDelay: .seconds(60), jitter: .full)"],"type":"codeListing"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/delay(beforeRetry:)"},{"type":"text","text":" is the nominal wait. What "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sleeps before each retry"},{"type":"text","text":" "},{"type":"text","text":"depends on the backoff’s jitter:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/full","isActive":true},{"type":"text","text":", the default: a random wait, at least zero and less than the nominal one,"},{"type":"text","text":" "},{"type":"text","text":"drawn afresh before each retry from the destination’s random number generator."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/none","type":"reference","isActive":true},{"type":"text","text":": the nominal wait. It is exact when both delays count their attoseconds in"},{"type":"text","text":" "},{"type":"text","text":"53 significant bits or fewer, as any whole number of milliseconds under 295 seconds does;"},{"type":"text","text":" "},{"type":"text","text":"otherwise it is within about one part in 2⁵³ of it."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Jitter is on by default because apps tend to be refused all at once. A rate limiter’s window,"},{"type":"text","text":" "},{"type":"text","text":"or an outage ending, refuses many apps at the same moment. Without jitter they would all retry"},{"type":"text","text":" "},{"type":"text","text":"at the same moments too, and each wave would be refused like the one before. Full jitter"},{"type":"text","text":" "},{"type":"text","text":"spreads each wave over the whole wait. It also halves the average wait, so an app retries"},{"type":"text","text":" "},{"type":"text","text":"about twice as often during a long outage."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/httpdestinations\/exponentialbackoff"]}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExponentialBackoff","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"ExponentialBackoff"}],"externalID":"s:16HTTPDestinations18ExponentialBackoffV","roleHeading":"Structure","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/HTTPDestinations\/ExponentialBackoff.swift#L26","fileName":"ExponentialBackoff.swift"},"role":"symbol","title":"ExponentialBackoff","modules":[{"name":"HTTPDestinations"}]},"