{"hierarchy":{"paths":[["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding"]]},"abstract":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"type":"text","text":" of Aptabase’s events API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"send events to an Aptabase app’s "},{"type":"codeVoice","code":"POST \/api\/v0\/events"},{"type":"text","text":"."}],"kind":"symbol","topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/init(isDebug:plan:limit:now:)"],"anchor":"Initializers"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)"],"anchor":"Instance-Methods"},{"title":"Type Aliases","generated":true,"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/Failure"],"anchor":"Type-Aliases"},{"title":"Type Properties","generated":true,"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses"],"anchor":"Type-Properties"},{"title":"Type Methods","generated":true,"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/outcome(of:for:)"],"anchor":"Type-Methods"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/AptabaseEncoding\/s8SendableP","doc:\/\/AptabaseEncoding\/s16SendableMetatypeP"],"kind":"relationships"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/aptabaseencoding\/aptabasebatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","interfaceLanguage":"swift"},"metadata":{"role":"symbol","title":"AptabaseBatchEncoder","navigatorTitle":[{"kind":"identifier","text":"AptabaseBatchEncoder"}],"modules":[{"name":"AptabaseEncoding"}],"externalID":"s:16AptabaseEncoding0A12BatchEncoderV","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AptabaseBatchEncoder"}],"symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AptabaseEncoding\/AptabaseBatchEncoder.swift#L74","fileName":"AptabaseBatchEncoder.swift"}},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AptabaseBatchEncoder"}],"platforms":["Linux"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with "},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, the app key’s header field, this encoder and its limits:"}]},{"type":"codeListing","syntax":"swift","code":["let aptabase = try HTTPDestination.aptabase(","    appKey: appKey,  \/\/ from the app's Instructions page: A-EU-…, A-US-… or A-SH-…","    isDebug: false,  \/\/ true for builds whose events only Debug mode should show","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON array, of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":", of one event per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. Each event is an object of these members:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"eventName","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionId"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"props"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The event’s stored properties, flattened; left out when there are none"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"systemProps","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The standard context, "},{"type":"codeVoice","code":"isDebug"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sdkVersion"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"timestamp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"systemProps"},{"type":"text","text":" holds "},{"type":"codeVoice","code":"osName"},{"type":"text","text":" and "},{"type":"codeVoice","code":"osVersion"},{"type":"text","text":" from "},{"type":"codeVoice","code":"OperatingSystemKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"appVersion"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"appBuildNumber"},{"type":"text","text":" from "},{"type":"codeVoice","code":"ApplicationKey"},{"type":"text","text":", "},{"type":"codeVoice","code":"deviceModel"},{"type":"text","text":" from "},{"type":"codeVoice","code":"DeviceKey"},{"type":"text","text":", and "},{"type":"codeVoice","code":"locale"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":"‘s language and region ("},{"type":"codeVoice","code":"en-US"},{"type":"text","text":"), each left out when the context has no value for it;"},{"type":"text","text":" "},{"type":"codeVoice","code":"isDebug"},{"type":"text","text":", as the encoder is made with; and "},{"type":"codeVoice","code":"sdkVersion"},{"type":"text","text":", which Aptabase requires, always"},{"type":"text","text":" "},{"type":"codeVoice","code":"Traffluent"},{"type":"text","text":". A member longer than Aptabase takes (30 characters of the system’s name, 100 of"},{"type":"text","text":" "},{"type":"text","text":"its version, 50 of the app’s version, 20 of its build and 100 of the device’s model, counted"},{"type":"text","text":" "},{"type":"text","text":"in UTF-16) is left out and the event is sent without it, as Aptabase refuses the whole request"},{"type":"text","text":" "},{"type":"text","text":"holding one. The encoder logs a notice the first time it leaves out each member."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: Aptabase has no member for a user or a device. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is a session of"},{"type":"text","text":" "},{"type":"text","text":"its own: Aptabase takes no event without a session. A record a store recovers after a relaunch"},{"type":"text","text":" "},{"type":"text","text":"keeps its session, so it goes out in the session of its first send. The record’s vendor identifier, trace context and other context"},{"type":"text","text":" "},{"type":"text","text":"values aren’t sent. Aptabase counts users itself, from a hash of each request’s IP address and"},{"type":"text","text":" "},{"type":"codeVoice","code":"User-Agent"},{"type":"text","text":" header field with a salt it changes every day."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. Aptabase stores a string, a number or a boolean as a"},{"type":"text","text":" "},{"type":"text","text":"property’s value, and only a placeholder for an object or array, so an object or array is"},{"type":"text","text":" "},{"type":"text","text":"spread into a property per value it holds, named after its path, joined by "},{"code":".","type":"codeVoice"},{"type":"text","text":" ("},{"code":"cart.size","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"tags.0","type":"codeVoice"},{"type":"text","text":"), and a "},{"code":"null","type":"codeVoice"},{"type":"text","text":" is left out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe; one whose event name is only"},{"type":"text","text":" "},{"type":"text","text":"whitespace or over 60 characters; one with a property whose name, once flattened, is empty, only"},{"type":"text","text":" "},{"type":"text","text":"whitespace or over 40 characters, whose string value is over 180 characters, or whose number is"},{"type":"text","text":" "},{"type":"text","text":"too large for Aptabase; one whose values flatten to one name; one whose event isn’t"},{"type":"text","text":" "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":"; one that holds a value"},{"type":"text","text":" "},{"type":"text","text":"JSON can’t; one whose timestamp is outside the years 1 to 9999, or more than 23 hours before"},{"type":"text","text":" "},{"type":"text","text":"the batch is encoded; and one too large for a request ("},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, gives each a deadline 23 hours after its oldest record was tracked, and makes none for","type":"text"},{"text":" ","type":"text"},{"text":"a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for it. Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t remove duplicates, so a record sent again, after a retry whose answer was lost or a","type":"text"},{"text":" ","type":"text"},{"text":"store’s redelivery, is counted twice. The bytes are the same for the same records on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}]}],"kind":"content"}],"references":{"doc://Events/documentation/Events/Sensitive":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"url":"\/documentation\/events\/sensitive","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","abstract":[{"type":"text","text":"A property value that a destination reads only through the record it arrived in, and not at all"},{"type":"text","text":" "},{"type":"text","text":"once the record is redacted."}],"title":"Sensitive","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}]},"doc://AptabaseEncoding/documentation/AptabaseEncoding":{"role":"collection","title":"AptabaseEncoding","abstract":[{"type":"text","text":"Send records to Aptabase, in its cloud or on your own server, through its events API."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","url":"\/documentation\/aptabaseencoding"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/requests(for:)":{"role":"symbol","title":"requests(for:)","abstract":[{"type":"codeVoice","code":"batch"},{"type":"text","text":" as the requests Aptabase takes, each within the encoder’s limit and with a deadline"},{"type":"text","text":" "},{"type":"text","text":"23 hours after its oldest record was tracked, with the records left out of them."}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","text":"BatchRequests"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0aB5ErrorO","text":"AptabaseEncodingError"},{"kind":"text","text":">"}],"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/requests(for:)"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/Failure":{"kind":"symbol","title":"AptabaseBatchEncoder.Failure","type":"topic","role":"symbol","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/failure","abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/Failure","navigatorTitle":[{"kind":"identifier","text":"Failure"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}]},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/init(isDebug:plan:limit:now:)":{"kind":"symbol","title":"init(isDebug:plan:limit:now:)","abstract":[{"text":"An encoder of the events ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" describes, marking every event as a debug event or not as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"isDebug"},{"text":" says, splitting each batch to ","type":"text"},{"type":"codeVoice","code":"limit"},{"text":", leaving out records more than 23 hours","type":"text"},{"text":" ","type":"text"},{"text":"older than ","type":"text"},{"type":"codeVoice","code":"now"},{"text":" gives.","type":"text"}],"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/init(isDebug:plan:limit:now:)","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/init(isdebug:plan:limit:now:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"isDebug","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","role":"symbol"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder":{"kind":"symbol","title":"AptabaseBatchEncoder","type":"topic","role":"symbol","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder","abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" of Aptabase’s events API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","typ