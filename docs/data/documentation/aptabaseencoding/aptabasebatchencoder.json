{"metadata":{"title":"AptabaseBatchEncoder","navigatorTitle":[{"text":"AptabaseBatchEncoder","kind":"identifier"}],"role":"symbol","externalID":"s:16AptabaseEncoding0A12BatchEncoderV","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/AptabaseEncoding\/AptabaseBatchEncoder.swift#L74","fileName":"AptabaseBatchEncoder.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AptabaseBatchEncoder"}],"roleHeading":"Structure","modules":[{"name":"AptabaseEncoding"}]},"identifier":{"url":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","interfaceLanguage":"swift"},"abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" of Aptabase’s events API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"send events to an Aptabase app’s ","type":"text"},{"type":"codeVoice","code":"POST \/api\/v0\/events"},{"text":".","type":"text"}],"kind":"symbol","topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/init(isDebug:plan:limit:now:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Type Aliases","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/Failure"],"anchor":"Type-Aliases"},{"generated":true,"title":"Type Properties","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses"],"anchor":"Type-Properties"},{"generated":true,"title":"Type Methods","identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/outcome(of:for:)"],"anchor":"Type-Methods"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AptabaseBatchEncoder","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Make the destination with ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, the app key’s header field, this encoder and its limits:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let aptabase = try HTTPDestination.aptabase(","    appKey: appKey,  \/\/ from the app's Instructions page: A-EU-…, A-US-… or A-SH-…","    isDebug: false,  \/\/ true for builds whose events only Debug mode should show","    plan: plan)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The body is a JSON array, of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":", of one event per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. Each event is an object of these members:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"eventName"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s ","type":"text"},{"type":"codeVoice","code":"Event\/name"},{"text":", as it is","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sessionId","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"props"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event’s stored properties, flattened; left out when there are none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"systemProps","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context, "},{"type":"codeVoice","code":"isDebug"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sdkVersion"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in ISO 8601, in UTC with milliseconds","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"code":"systemProps","type":"codeVoice"},{"text":" holds ","type":"text"},{"code":"osName","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"osVersion","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"OperatingSystemKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"appVersion","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"appBuildNumber","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"ApplicationKey","type":"codeVoice"},{"text":", ","type":"text"},{"code":"deviceModel","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"DeviceKey","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"locale","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"code":"LocaleKey","type":"codeVoice"},{"text":"‘s language and region (","type":"text"},{"code":"en-US","type":"codeVoice"},{"text":"), each left out when the context has no value for it;","type":"text"},{"text":" ","type":"text"},{"code":"isDebug","type":"codeVoice"},{"text":", as the encoder is made with; and ","type":"text"},{"code":"sdkVersion","type":"codeVoice"},{"text":", which Aptabase requires, always","type":"text"},{"text":" ","type":"text"},{"code":"Traffluent","type":"codeVoice"},{"text":". A member longer than Aptabase takes (30 characters of the system’s name, 100 of","type":"text"},{"text":" ","type":"text"},{"text":"its version, 50 of the app’s version, 20 of its build and 100 of the device’s model, counted","type":"text"},{"text":" ","type":"text"},{"text":"in UTF-16) is left out and the event is sent without it, as Aptabase refuses the whole request","type":"text"},{"text":" ","type":"text"},{"text":"holding one. The encoder logs a notice the first time it leaves out each member.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: Aptabase has no member for a user or a device. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is a session of"},{"type":"text","text":" "},{"type":"text","text":"its own: Aptabase takes no event without a session. A record a store recovers after a relaunch"},{"type":"text","text":" "},{"type":"text","text":"keeps its session, so it goes out in the session of its first send. The record’s vendor identifier, trace context and other context"},{"type":"text","text":" "},{"type":"text","text":"values aren’t sent. Aptabase counts users itself, from a hash of each request’s IP address and"},{"type":"text","text":" "},{"type":"codeVoice","code":"User-Agent"},{"type":"text","text":" header field with a salt it changes every day."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. Aptabase stores a string, a number or a boolean as a"},{"type":"text","text":" "},{"type":"text","text":"property’s value, and only a placeholder for an object or array, so an object or array is"},{"type":"text","text":" "},{"type":"text","text":"spread into a property per value it holds, named after its path, joined by "},{"type":"codeVoice","code":"."},{"type":"text","text":" ("},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":"), and a "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is left out."}],"type":"paragraph"},{"inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" doesn’t describe; one whose event name is only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace or over 60 characters; one with a property whose name, once flattened, is empty, only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace or over 40 characters, whose string value is over 180 characters, or whose number is","type":"text"},{"text":" ","type":"text"},{"text":"too large for Aptabase; one whose values flatten to one name; one whose event isn’t","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":"; one that holds a value","type":"text"},{"text":" ","type":"text"},{"text":"JSON can’t; one whose timestamp is outside the years 1 to 9999, or more than 23 hours before","type":"text"},{"text":" ","type":"text"},{"text":"the batch is encoded; and one too large for a request (","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError","type":"reference","isActive":true},{"text":").","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" returns them as ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":"s, which ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"type":"codeVoice","code":"dropReports"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, gives each a deadline 23 hours after its oldest record was tracked, and makes none for","type":"text"},{"text":" ","type":"text"},{"text":"a batch with no record it can write, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for it. Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t remove duplicates, so a record sent again, after a retry whose answer was lost or a","type":"text"},{"text":" ","type":"text"},{"text":"store’s redelivery, is counted twice. The bytes are the same for the same records on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/aptabaseencoding\/aptabasebatchencoder"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/AptabaseEncoding\/s8SendableP","doc:\/\/AptabaseEncoding\/s16SendableMetatypeP"],"kind":"relationships"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding"]]},"references":{"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/Failure":{"abstract":[{"type":"text","text":"Why a record was left out of the batch’s requests."}],"type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"navigatorTitle":[{"kind":"identifier","text":"Failure"}],"kind":"symbol","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/failure","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/Failure","role":"symbol","title":"AptabaseBatchEncoder.Failure"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/HTTPDestinations/HTTPDestination/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)":{"url":"\/documentation\/aptabaseencoding\/httpdestinations\/httpdestination\/aptabase(appkey:host:isdebug:plan:backoff:clock:now:)","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" is "},{"type":"codeVoice","code":"URLSessionTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding