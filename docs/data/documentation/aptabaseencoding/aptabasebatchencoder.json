ts oldest record was tracked, with the records left out of them."}],"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/requests(for:)","type":"topic","role":"symbol"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/outcome(of:for:)":{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/outcome(of:for:)","url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/outcome(of:for:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"HTTPTransportResponse","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EncodedRequest","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV"},{"text":") -> ","kind":"text"},{"text":"ResponseOutcome","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO"}],"abstract":[{"text":"What Aptabase’s 2xx answer means: rejected when its body is an object holding an ","type":"text"},{"code":"error","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and delivered otherwise.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","title":"outcome(of:for:)"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseBatchEncoder/Failure":{"url":"\/documentation\/aptabaseencoding\/aptabasebatchencoder\/failure","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"}],"title":"AptabaseBatchEncoder.Failure","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"iden