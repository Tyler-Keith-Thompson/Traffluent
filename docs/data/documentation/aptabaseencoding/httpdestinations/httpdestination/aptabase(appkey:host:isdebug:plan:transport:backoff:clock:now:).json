":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AptabaseBatchEncoder","kind":"typeIdentifier","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","preciseIdentifier":"s:16AptabaseEncoding0A12BatchEncoderV"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app’s key, from the Instructions page of its Aptabase dashboard, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"A-EU-1234567890"},{"type":"text","text":". Whitespace and newlines around it are trimmed off."}]}],"name":"appKey"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The URL a self-hosted server is reached at ("},{"code":"https:\/\/aptabase.example.com","type":"codeVoice"},{"type":"text","text":"), a"},{"type":"text","text":" "},{"type":"text","text":"path included where it is served under one; required for an "},{"code":"A-SH-","type":"codeVoice"},{"type":"text","text":" or "},{"code":"A-DEV-","type":"codeVoice"},{"type":"text","text":" key and"},{"type":"text","text":" "},{"type":"text","text":"refused for a cloud key, so "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" by default. Not the endpoint: the destination appends"},{"type":"text","text":" "},{"code":"\/api\/v0\/events","type":"codeVoice"},{"type":"text","text":" itself."}]}],"name":"host"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether every event is a debug event, which Aptabase’s dashboard shows only in"},{"type":"text","text":" "},{"type":"text","text":"its Debug mode and keeps for less time: "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for a development or internal build,"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for one users run. There is no default: "},{"type":"codeVoice","code":"#if DEBUG"},{"type":"text","text":" in a library tells its own"},{"type":"text","text":" "},{"type":"text","text":"build configuration, not the app’s, so the app decides, from its own build settings."}]}],"name":"isDebug"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}],"name":"plan"},{"content":[{"inlineContent":[{"text":"What sends each request.","type":"text"}],"type":"paragraph"}],"name":"transport"},{"content":[{"type":"paragraph","inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, with full jitter, by default.","type":"text"}]}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}],"name":"clock"},{"content":[{"inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,"},{"type":"text","text":" "},{"type":"text","text":"and each request’s deadline is checked against before it is sent; the system’s clock by"},{"type":"text","text":" "},{"type":"text","text":"default. When it reads NaN or infinite, every record is left out."}],"type":"paragraph"}],"name":"now"}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination posts each batch to the events API, "},{"type":"codeVoice","code":"\/api\/v0\/events"},{"type":"text","text":", of"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/eu.aptabase.com"},{"type":"text","text":" for an "},{"type":"codeVoice","code":"A-EU-"},{"type":"text","text":" key, "},{"type":"codeVoice","code":"https:\/\/us.aptabase.com"},{"type":"text","text":" for an "},{"type":"codeVoice","code":"A-US-"},{"type":"text","text":" key,"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"host"},{"type":"text","text":" for a self-hosted key ("},{"type":"codeVoice","code":"A-SH-"},{"type":"text","text":", or "},{"type":"codeVoice","code":"A-DEV-"},{"type":"text","text":" for a server run in development),"},{"type":"text","text":" "},{"type":"text","text":"with the key in its "},{"type":"codeVoice","code":"App-Key"},{"type":"text","text":" header field, encoded by an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},{"type":"text","text":" within"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit"},{"type":"text","text":". It sends no trace context. It retries no response, a"},{"type":"text","text":" "},{"type":"text","text":"5xx, 408 or 429, such as Aptabase answers past its rate limit, and 418, which Aptabase"},{"type":"text","text":" "},{"type":"text","text":"answers when a request’s body arrives slower than 60 bytes a second after a 10-second grace"},{"type":"text","text":" "},{"type":"text","text":"period, as over a poor connection ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses"},{"type":"text","text":"). It drops and"},{"type":"text","text":" "},{"type":"text","text":"reports any other status, such as 400 for a request Aptabase can’t take."}]},{"type":"paragraph","inlineContent":[{"text":"The app key is public, as Aptabase’s SDKs ship it in every app, and the events API takes no","type":"text"},{"text":" ","type":"text"},{"text":"other credential, so the destination builds on every platform: an app sends to Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"directly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Aptabase takes no event tracked more than a day before it arrives, and answers 200 while","type":"text"},{"text":" ","type":"text"},{"text":"storing nothing for one, so the encoder leaves out a record tracked more than 23 hours","type":"text"},{"text":" ","type":"text"},{"text":"before it is encoded (","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError\/timestampOutsideWindow","type":"reference","isActive":true},{"text":"). A request is","type":"text"},{"text":" ","type":"text"},{"text":"encoded once and retried as it is, so one still undelivered 23 hours after its oldest","type":"text"},{"text":" ","type":"text"},{"text":"record was tracked, by the time ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" gives, isn’t sent again: it is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":".","type":"text"}]},{"style":"note","type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/emptyAppKey","type":"reference","isActive":true},{"text":" for a key that is empty or only whitespace,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/malformedAppKey","type":"reference","isActive":true},{"text":" for one that isn’t ","type":"text"},{"code":"A-<region>-<body>","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"