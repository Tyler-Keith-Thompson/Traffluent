text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV"},{"text":" = { Date.now }) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError","text":"AptabaseSetupError","kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A10SetupErrorO"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","text":"AptabaseBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A12BatchEncoderV"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The app’s key, from the Instructions page of its Aptabase dashboard, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"A-EU-1234567890"},{"type":"text","text":". Whitespace and newlines around it are trimmed off."}],"type":"paragraph"}],"name":"appKey"},{"content":[{"inlineContent":[{"text":"The URL a self-hosted server is reached at (","type":"text"},{"code":"https:\/\/aptabase.example.com","type":"codeVoice"},{"text":"), a","type":"text"},{"text":" ","type":"text"},{"text":"path included where it is served under one; required for an ","type":"text"},{"code":"A-SH-","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"A-DEV-","type":"codeVoice"},{"text":" key and","type":"text"},{"text":" ","type":"text"},{"text":"refused for a cloud key, so ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" by default. Not the endpoint: the destination appends","type":"text"},{"text":" ","type":"text"},{"code":"\/api\/v0\/events","type":"codeVoice"},{"text":" itself.","type":"text"}],"type":"paragraph"}],"name":"host"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether every event is a debug event, which Aptabase’s dashboard shows only in"},{"type":"text","text":" "},{"type":"text","text":"its Debug mode and keeps for less time: "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for a development or internal build,"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for one users run. There is no default: "},{"type":"codeVoice","code":"#if DEBUG"},{"type":"text","text":" in a library tells its own"},{"type":"text","text":" "},{"type":"text","text":"build configuration, not the app’s, so the app decides, from its own build settings."}]}],"name":"isDebug"},{"content":[{"inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}],"type":"paragraph"}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}],"name":"transport"},{"content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}],"name":"clock"},{"content":[{"inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,"},{"type":"text","text":" "},{"type":"text","text":"and each request’s deadline is checked against before it is sent; the system’s clock by"},{"type":"text","text":" "},{"type":"text","text":"default. When it reads NaN or infinite, every record is left out."}],"type":"paragraph"}],"name":"now"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The destination posts each batch to the events API, "},{"type":"codeVoice","code":"\/api\/v0\/events"},{"type":"text","text":", of"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/eu.aptabase.com"},{"type":"text","text":" for an "},{"type":"codeVoice","code":"A-EU-"},{"type":"text","text":" key, "},{"type":"codeVoice","code":"https:\/\/us.aptabase.com"},{"type":"text","text":" for an "},{"type":"codeVoice","code":"A-US-"},{"type":"text","text":" key,"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"host"},{"type":"text","text":" for a self-hosted key ("},{"type":"codeVoice","code":"A-SH-"},{"type":"text","text":", or "},{"type":"codeVoice","code":"A-DEV-"},{"type":"text","text":" for a server run in development),"},{"type":"text","text":" "},{"type":"text","text":"with the key in its "},{"type":"codeVoice","code":"App-Key"},{"type":"text","text":" header field, encoded by an "},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","type":"reference","isActive":true},{"type":"text","text":" within"},{"type":"text","text":" "},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit","type":"reference","isActive":true},{"type":"text","text":". It sends no trace context. It retries no response, a"},{"type":"text","text":" "},{"type":"text","text":"5xx, 408 or 429, such as Aptabase answers past its rate limit, and 418, which Aptabase"},{"type":"text","text":" "},{"type":"text","text":"answers when a request’s body arrives slower than 60 bytes a second after a 10-second grace"},{"type":"text","text":" "},{"type":"text","text":"period, as over a poor connection ("},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses","type":"reference","isActive":true},{"type":"text","text":"). It drops and"},{"type":"text","text":" "},{"type":"text","text":"reports any other status, such as 400 for a request Aptabase can’t take."}],"type":"paragraph"},{"inlineContent":[{"text":"The app key is public, as Aptabase’s SDKs ship it in every app, and the events API takes no","type":"text"},{"text":" ","type":"text"},{"text":"other credential, so the destination builds on every platform: an app sends to Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"directly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Aptabase takes no event tracked more than a day before it arrives, and answers 200 while"},{"type":"text","text":" "},{"type":"text","text":"storing nothing for one, so the encoder leaves out a record tracked more than 23 hours"},{"type":"text","text":" "},{"type":"text","text":"before it is encoded ("},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError\/timestampOutsideWindow","isActive":true},{"type":"text","text":"). A request is"},{"type":"text","text":" "},{"type":"text","text":"encoded once and retried as it is, so one still undelivered 23 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record was tracked, by the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":"."}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/emptyAppKey","isActive":true,"type":"reference"},{"text":" for a key that is empty or only whitespace,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/malformedAppKey","isActive":true,"type":"reference"},{"text":" for one that isn’t ","type":"text"},{"type":"codeVoice","code":"A-<region>-<body>"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/unknownRegion","isActive":true,"type":"reference"},{"text":" for a region other than ","type":"text"},{"type":"codeVoice","code":"EU"},{"text":", ","type":"text"},{"type":"codeVoice","code":"US"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SH"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"DEV"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/selfHostedAppKeyWithoutHost","isActive":true,"type":"reference"},{"text":" for a self-hosted key without ","type":"text"},{"type":"codeVoice","code":"host"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/cloudAppKeyWithHost","isActive":true,"type":"reference"},{"text":" for a cloud key with one, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/invalidHost","isActive":true,"type":"reference"},{"text":" for a host that isn’t a plain ","type":"text"},{"type":"codeVoice","code":"https"},{"text":" URL of the","type":"text"},{"text":" ","type":"text"},{"text":"server.","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding","doc:\/\/AptabaseEnco