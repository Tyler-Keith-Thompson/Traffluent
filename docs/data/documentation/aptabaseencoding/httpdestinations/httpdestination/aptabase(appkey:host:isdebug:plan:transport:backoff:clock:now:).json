"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A10SetupErrorO","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError","text":"AptabaseSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A12BatchEncoderV","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder","text":"AptabaseBatchEncoder"},{"kind":"text","text":">"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The app’s key, from the Instructions page of its Aptabase dashboard, such as","type":"text"},{"text":" ","type":"text"},{"code":"A-EU-1234567890","type":"codeVoice"},{"text":". Whitespace and newlines around it are trimmed off.","type":"text"}]}],"name":"appKey"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The URL a self-hosted server is reached at ("},{"type":"codeVoice","code":"https:\/\/aptabase.example.com"},{"type":"text","text":"), a"},{"type":"text","text":" "},{"type":"text","text":"path included where it is served under one; required for an "},{"type":"codeVoice","code":"A-SH-"},{"type":"text","text":" or "},{"type":"codeVoice","code":"A-DEV-"},{"type":"text","text":" key and"},{"type":"text","text":" "},{"type":"text","text":"refused for a cloud key, so "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" by default. Not the endpoint: the destination appends"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/api\/v0\/events"},{"type":"text","text":" itself."}]}],"name":"host"},{"content":[{"inlineContent":[{"type":"text","text":"Whether every event is a debug event, which Aptabase’s dashboard shows only in"},{"type":"text","text":" "},{"type":"text","text":"its Debug mode and keeps for less time: "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for a development or internal build,"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for one users run. There is no default: "},{"type":"codeVoice","code":"#if DEBUG"},{"type":"text","text":" in a library tells its own"},{"type":"text","text":" "},{"type":"text","text":"build configuration, not the app’s, so the app decides, from its own build settings."}],"type":"paragraph"}],"name":"isDebug"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}]}],"name":"plan"},{"content":[{"inlineContent":[{"type":"text","text":"What sends each request."}],"type":"paragraph"}],"name":"transport"},{"content":[{"inlineContent":[{"text":"How long to wait before each new attempt at a request; 1 second, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, with full jitter, by default.","type":"text"}],"type":"paragraph"}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}],"name":"clock"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 23 hours are measured from,","type":"text"},{"text":" ","type":"text"},{"text":"and each request’s deadline is checked against before it is sent; the system’s clock by","type":"text"},{"text":" ","type":"text"},{"text":"default. When it reads NaN or infinite, every record is left out.","type":"text"}]}],"name":"now"}]},{"kind":"content","content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"inlineContent":[{"type":"text","text":"The destination."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The destination posts each batch to the events API, "},{"type":"codeVoice","code":"\/api\/v0\/events"},{"type":"text","text":", of"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/eu.aptabase.com"},{"type":"text","text":" for an "},{"type":"codeVoice","code":"A-EU-"},{"type":"text","text":" key, "},{"type":"codeVoice","code":"https:\/\/us.aptabase.com"},{"type":"text","text":" for an "},{"type":"codeVoice","code":"A-US-"},{"type":"text","text":" key,"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"host"},{"type":"text","text":" for a self-hosted key ("},{"type":"codeVoice","code":"A-SH-"},{"type":"text","text":", or "},{"type":"codeVoice","code":"A-DEV-"},{"type":"text","text":" for a server run in development),"},{"type":"text","text":" "},{"type":"text","text":"with the key in its "},{"type":"codeVoice","code":"App-Key"},{"type":"text","text":" header field, encoded by an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder"},{"type":"text","text":" within"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/batchLimit"},{"type":"text","text":". It sends no trace context. It retries no response, a"},{"type":"text","text":" "},{"type":"text","text":"5xx, 408 or 429, such as Aptabase answers past its rate limit, and 418, which Aptabase"},{"type":"text","text":" "},{"type":"text","text":"answers when a request’s body arrives slower than 60 bytes a second after a 10-second grace"},{"type":"text","text":" "},{"type":"text","text":"period, as over a poor connection ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseBatchEncoder\/transientStatuses"},{"type":"text","text":"). It drops and"},{"type":"text","text":" "},{"type":"text","text":"reports any other status, such as 400 for a request Aptabase can’t take."}],"type":"paragraph"},{"inlineContent":[{"text":"The app key is public, as Aptabase’s SDKs ship it in every app, and the events API takes no","type":"text"},{"text":" ","type":"text"},{"text":"other credential, so the destination builds on every platform: an app sends to Aptabase","type":"text"},{"text":" ","type":"text"},{"text":"directly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Aptabase takes no event tracked more than a day before it arrives, and answers 200 while"},{"type":"text","text":" "},{"type":"text","text":"storing nothing for one, so the encoder leaves out a record tracked more than 23 hours"},{"type":"text","text":" "},{"type":"text","text":"before it is encoded ("},{"type":"reference","identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseEncodingError\/timestampOutsideWindow","isActive":true},{"type":"text","text":"). A request is"},{"type":"text","text":" "},{"type":"text","text":"encoded once and retried as it is, so one still undelivered 23 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record was tracked, by the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/emptyAppKey"},{"type":"text","text":" for a key that is empty or only whitespace,"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/malformedAppKey"},{"type":"text","text":" for one that isn’t "},{"code":"A-<region>-<body>","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/unknownRegion"},{"type":"text","text":" for a region other than "},{"code":"EU","type":"codeVoice"},{"type":"text","text":", "},{"code":"US","type":"codeVoice"},{"type":"text","text":", "},{"code":"SH","type":"codeVoice"},{"type":"text","text":" and "},{"code":"DEV","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/selfHostedAppKeyWithoutHost"},{"type":"text","text":" for a self-hosted key without "},{"code":"host","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/cloudAppKeyWithHost"},{"type":"text","text":" for a cloud key with one, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError\/invalidHost"},{"type":"text","text":" for a host that isn’t a plain "},{"code":"https","type":"codeVoice"},{"type":"text","text":" URL of the"},{"type":"text","text":" "},{"type":"text","text":"server."}]}],"type":"aside"}]}],"sections":[],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"A destination that sends batches to the Aptabase app of ","type":"text"},{"type":"codeVoice","code":"appKey"},{"text":", at the region its key","type":"text"},{"text":" ","type":"text"},{"text":"names or, for a self-hosted key, at ","type":"text"},{"type":"codeVoice","code":"host"},{"text":", marking every event as a debug event or not as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"isDebug"},{"text":" says, through ","type":"text"},{"type":"codeVoice","code":"transport"},{"text":", retrying a send that fails for now with the waits of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"clock"},{"text":".","type":"text"}],"seeAlsoSections":[{"anchor":"Sending-to-Aptabase","generated":true,"identifiers":["doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:backoff:clock:now:)","doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/AptabaseSetupError"],"title":"Sending to Aptabase"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/aptabaseencoding\/httpdestinations\/httpdestination\/aptabase(appkey:host:isdebug:plan:transport:backoff:clock:now:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AptabaseEncoding\/documentation\/AptabaseEncoding\/HTTPDestinations\/HTTPDestination\/aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)"},"metadata":{"symbolKind":"method","role":"symbol","modules":[{"relatedModules":["HTTPDestinations"],"name":"AptabaseEncoding"}],"title":"aptabase(appKey:host:isDebug:plan:transport:backoff:clock:now:)","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"HTTPTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"co