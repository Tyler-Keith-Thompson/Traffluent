{"metadata":{"symbolKind":"module","role":"collection","externalID":"MixpanelEncoding","modules":[{"name":"MixpanelEncoding"}],"title":"MixpanelEncoding","roleHeading":"Framework"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"topicSections":[{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:now:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:now:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/ExponentialBackoff\/mixpanel","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"],"anchor":"Sending-to-Mixpanel","title":"Sending to Mixpanel"},{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"],"anchor":"Encoding-batches","title":"Encoding batches"},{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError"],"anchor":"Records-left-out","title":"Records left out"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:now:)","isActive":true,"type":"reference"},{"text":" makes an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true,"type":"reference"},{"text":") for your Mixpanel project in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the project token, posts to the ","type":"text"},{"type":"codeVoice","code":"\/track"},{"text":" endpoint of the project’s data residency","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","isActive":true,"type":"reference"},{"text":"), with ","type":"text"},{"type":"codeVoice","code":"verbose=1"},{"text":", through a ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","isActive":true,"type":"reference"},{"text":", and splits each batch to Mixpanel’s limits","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":"): 2,000 events and 2 MB a request. A batch with no record the","type":"text"},{"text":" ","type":"text"},{"text":"encoder can write, an empty one included, makes no request. It retries no response, a 5xx, 408","type":"text"},{"text":" ","type":"text"},{"text":"and 429, waiting ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/ExponentialBackoff\/mixpanel","isActive":true,"type":"reference"},{"text":": Mixpanel’s recommended","type":"text"},{"text":" ","type":"text"},{"text":"schedule, 2 s doubling to 60 s. The full jitter on top is Traffluent’s own choice. It drops and","type":"text"},{"text":" ","type":"text"},{"text":"reports any other status. The token goes in each event, so no header field is needed, and no","type":"text"},{"text":" ","type":"text"},{"text":"trace context is sent. ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves this module out; import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The project token is public: Mixpanel’s own apps and web pages ship it. The destination takes"},{"type":"text","text":" "},{"type":"text","text":"nothing else. Never put the project’s secret or a service account’s credentials in an app; they"},{"type":"text","text":" "},{"type":"text","text":"belong to Mixpanel’s import API, for servers. The factory throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"},{"type":"text","text":" for an"},{"type":"text","text":" "},{"type":"text","text":"empty token, and for one with a character other than a letter or digit, which no project token"},{"type":"text","text":" "},{"type":"text","text":"has."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The region has no default. A project’s data resides in the US, the EU or India, and Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"ingests nothing for it from another residency’s endpoint, so you pick the region on purpose."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each record becomes an event of an anonymous user. Its "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":" is the record’s session,"},{"type":"text","text":" "},{"type":"text","text":"from the sessions enricher, also sent as "},{"code":"$device_id","type":"codeVoice"},{"type":"text","text":"; a record with no session is sent under its"},{"type":"text","text":" "},{"type":"text","text":"own record identifier, with no "},{"code":"$device_id","type":"codeVoice"},{"type":"text","text":". Under Simplified ID Merge, Mixpanel shows a"},{"type":"text","text":" "},{"type":"text","text":"session’s events under "},{"code":"$device:<session>","type":"codeVoice"},{"type":"text","text":", and a sessionless record’s under its bare record"},{"type":"text","text":" "},{"type":"text","text":"identifier. No "},{"code":"$user_id","type":"codeVoice"},{"type":"text","text":" is sent. Its "},{"code":"$insert_id","type":"codeVoice"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"record’s identifier, which a redelivered record keeps, and its "},{"code":"time","type":"codeVoice"},{"type":"text","text":" the record’s timestamp in"},{"type":"text","text":" "},{"type":"text","text":"epoch milliseconds. The record’s vendor identifier and trace context aren’t sent. Each event’s"},{"type":"text","text":" "},{"code":"ip","type":"codeVoice"},{"type":"text","text":" is "},{"code":"0","type":"codeVoice"},{"type":"text","text":", as is the endpoint’s, so Mixpanel adds no location from the request’s address. The"},{"type":"text","text":" "},{"type":"text","text":"standard context is sent as Mixpanel’s default properties ("},{"code":"$app_version_string","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"$app_build_number","type":"codeVoice"},{"type":"text","text":", "},{"code":"$model","type":"codeVoice"},{"type":"text","text":", "},{"code":"$wifi","type":"codeVoice"},{"type":"text","text":", "},{"code":"$os","type":"codeVoice"},{"type":"text","text":" and "},{"code":"$os_version","type":"codeVoice"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"text":"Mixpanel counts a user per ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":", so each session is one user in its reports, and so is","type":"text"},{"text":" ","type":"text"},{"text":"each record sent without a session. On a Mixpanel plan billed by monthly tracked users, each counts","type":"text"},{"text":" ","type":"text"},{"text":"as one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in the ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":" the encoder is made with. A","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value is never sent, whatever the record reveals. A record the encoder can’t write is","type":"text"},{"text":" ","type":"text"},{"text":"left out and the rest of the batch is sent: one the plan doesn’t describe, one whose event name","type":"text"},{"text":" ","type":"text"},{"text":"starts with ","type":"text"},{"type":"codeVoice","code":"$"},{"text":", as Mixpanel’s own events’ names do, one with a property Mixpanel reads for itself","type":"text"},{"text":" ","type":"text"},{"text":"(a ","type":"text"},{"type":"codeVoice","code":"$"},{"text":"-prefixed one, ","type":"text"},{"type":"codeVoice","code":"token"},{"text":", ","type":"text"},{"type":"codeVoice","code":"time"},{"text":", ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ip"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"bucket"},{"text":"), one of 255 properties or","type":"text"},{"text":" ","type":"text"},{"text":"more counting the encoder’s own, one holding an array of 255 elements or more, one whose property","type":"text"},{"text":" ","type":"text"},{"text":"nests objects more than 3 deep, one whose event isn’t","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one holding a value JSON can’t, one whose timestamp is before 1971 or has no","type":"text"},{"text":" ","type":"text"},{"text":"epoch-milliseconds form, one tracked more than 119 hours before its batch is encoded or more than","type":"text"},{"text":" ","type":"text"},{"text":"an hour after, and one too large for Mixpanel. The destination reports each as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"text":", a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":" whose reason is a ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Mixpanel answers 200 even when it finds no valid event in a request. The endpoint asks for","type":"text"},{"text":" ","type":"text"},{"code":"verbose=1","type":"codeVoice"},{"text":", so the answer’s body says so, ","type":"text"},{"code":"{\"status\": 0, \"error\": ...}","type":"codeVoice"},{"text":", and the destination","type":"text"},{"text":" ","type":"text"},{"text":"drops the request and reports it as ","type":"text"},{"code":"HTTPDropReport.rejectedInBody(status:reason:recordIDs:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"with Mixpanel’s error as the reason. A ","type":"text"},{"code":"status","type":"codeVoice"},{"text":" of 1 means only that one event or more was well","type":"text"},{"text":" ","type":"text"},{"text":"formed: it doesn’t confirm that the token names a project, so a wrong region, or a token of no","type":"text"},{"text":" ","type":"text"},{"text":"project, may be answered 200 with nothing stored. Check the project’s Live View after setting the","type":"text"},{"text":" ","type":"text"},{"text":"destination up.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Mixpanel’s track API ingests only events from the last 5 days, and answers 200 to an older one","type":"text"},{"text":" ","type":"text"},{"text":"while storing nothing. So the destination drops and reports such a record rather than send it.","type":"text"},{"text":" ","type":"text"},{"text":"The encoder leaves out a record tracked more than 119 hours (5 days less an hour, for clocks that","type":"text"},{"text":" ","type":"text"},{"text":"disagree) before its batch is encoded, as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow","type":"reference","isActive":true},{"text":". Each request has a deadline 119 hours after its","type":"text"},{"text":" ","type":"text"},{"text":"oldest record was tracked, and a request still being retried when it passes isn’t sent again: it","type":"text"},{"text":" ","type":"text"},{"text":"is reported as ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"text":". Pass the factory’s ","type":"text"},{"type":"codeVoice","code":"now:"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"clock of your own to test this.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To send to PostHog or Amplitude, use "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":" instead."}]},{"code":["import HTTPDestinations","import MixpanelEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let mixpanel = try HTTPDestination.mixpanel(","    projectToken: projectToken,","    region: .us,  \/\/ or .eu or .india, where the project's data resides","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: mixpanel)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what Mixpanel receives, and why, in more detail."}]}]}],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/mixpanelencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination/mixpanel(projectToken:region:plan:transport:backoff:clock:now:)":{"conformance":{"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"HTTPTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"MixpanelBatchEncoder"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"kind":"symbol","url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:transport:backoff:clock:now:)","abstract":[{"text":"A destination that sends batches to the Mixpanel project of ","type":"text"},{"type":"codeVoice","code":"projectToken"},{"text":", whose data","type":"text"},{"text":" ","type":"text"},{"text":"resides in ","type":"text"},{"type":"codeVoice","code":"region"},{"text":", through ","type":"text"},{"type":"codeVoice","code":"transport"},{"text":", retrying a send that fails for now with the waits","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"clock"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mixpanel"},{"kind":"text","text":"("},{"kind":"externalParam","text":"projectToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A6RegionO","text":"MixpanelRegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO","text":"MixpanelSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV","text":"MixpanelBatchEncoder"},{"kind":"text","text":">"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:now:)","title":"mixpanel(projectToken:region:plan:transport:backoff:clock:now:)","type":"topic","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"url":"\/documentation\/httpdestinations\/batchencoder","kind":"symbol","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}],"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"title":"BatchEncoder","role":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"title":"MixpanelEncoding","abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","url":"\/documentation\/mixpanelencoding","type":"topic","kind":"symbol","role":"collection"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/ExponentialBackoff/mixpanel":{"type":"topic","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/ExponentialBackoff\/mixpanel","title":"mixpanel","abstract":[{"text":"Mixpanel’s recommended schedule, 2 s doubling to 60 s, with full jitter: a nominal wait of","type":"text"},{"text":" ","type":"text"},{"text":"2 seconds before the first retry, doubling up to 60 seconds. Mixpanel recommends the","type":"text"},{"text":" ","type":"text"},{"text":"schedule; the full jitter is Traffluent’s, as for every destination.","type":"text"}],"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"}],"url":"\/documentation\/mixpanelencoding\/httpdestinations\/exponentialbackoff\/mixpanel"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder":{"title":"MixpanelBatchEncoder","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Mixpanel’s track API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send"},{"type":"text","text":" "},{"type":"text","text":"events to a Mixpanel project’s "},{"type":"codeVoice","code":"POST \/track"},{"type":"text","text":"."}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"MixpanelBatchEncoder","kind":"identifier"}],"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder","type":"topic","kind":"symbol","role":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelSetupError":{"type":"topic","url":"\/documentation\/mixpanelencoding\/mixpanelsetuperror","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError","kind":"symbol","abstract":[{"type":"text","text":"Why "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:transport:backoff:clock:now:)"},{"type":"text","text":" "},{"type":"text","text":"couldn’t make a destination."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelSetupError","kind":"identifier"}],"navigatorTitle":[{"text":"MixpanelSetupError","kind":"identifier"}],"title":"MixpanelSetupError"},"doc://HTTPDestinations/documentation/HTTPDestinations":{"kind":"symbol","title":"HTTPDestinations","url":"\/documentation\/httpdestinations","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"role":"collection","type":"topic"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelEncodingError"}],"url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"topic","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" reports as a drop. When it can encode no","type":"text"},{"text":" ","type":"text"},{"text":"record of a batch, it makes no request, and ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends nothing for the batch.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MixpanelEncodingError"}],"title":"MixpanelEncodingError","role":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination/mixpanel(projectToken:region:plan:backoff:clock:now:)":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"type":"text","text":" is "},{"code":"URLSessionTransport","type":"codeVoice"},{"type"