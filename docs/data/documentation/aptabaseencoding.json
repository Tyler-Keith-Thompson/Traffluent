,"text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A10SetupErrorO","text":"AptabaseSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:16AptabaseEncoding0A12BatchEncoderV","text":"AptabaseBatchEncoder"},{"kind":"text","text":">"}],"kind":"symbol","title":"aptabase(appKey:host:isDebug:plan:backoff:clock:now:)"},"doc://AptabaseEncoding/documentation/AptabaseEncoding/AptabaseSetupError":{"navigatorTitle":[{"kind":"identifier","text":"AptabaseSetupError"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/aptabas