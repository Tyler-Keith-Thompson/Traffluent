":true},{"type":"text","text":" check sends through instead of the network."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","navigatorTitle":[{"text":"ScriptedTransport","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DestinationConformance"}],"title":"DestinationConformance","url":"\/documentation\/destinationtesting\/destinationconformance","role":"symbol","abstract":[{"type":"text","text":"The checks every vendor destination passes, run from the vendor module’s tests: its requests"},{"type":"text","text":" "},{"type":"text","text":"match recorded fixtures byte for byte, and it keeps the library’s rules for "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values,"},{"type":"text","text":" "},{"type":"text","text":"consent, oversized records, retries, 2xx answers and trace context."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","navigatorTitle":[{"kind":"identifier","text":"DestinationConformance"}],"kind":"symbol","type":"topic"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationSetup":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DestinationSetup","kind":"identifier"}],"navigatorTitle":[{"text":"DestinationSetup","kind":"identifier"}],"title":"DestinationSetup","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup","url":"\/documentation\/destinationtesting\/destinationsetup","type":"topic","role":"symbol","abstract":[{"text":"What a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference"},{"text":" check hands the vendor’s factory: the plan of the events it","type":"text"},{"text":" ","type":"text"},{"text":"sends, the transport to send them through, a backoff short enough that a retry doesn’t hold the","type":"text"},{"text":" ","type":"text"},{"text":"test up, and when its records were tracked.","type":"text"}],"kind":"symbol"},"doc://DestinationTesting/documentation/DestinationTesting":{"url":"\/documentation\/destinationtesting","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record."}],"role":"collection","identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting","title":"DestinationTesting"},"doc://DestinationTesting/documentation/DestinationTesting/DestinationConformance/expect(_:sourceLocation:)":{"role":"symbol","type":"topic","url":"\/documentation\/destinationtesting\/destinationconformance\/expect(_:sourcelocation:)","title":"expect(_:sourceLocation:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expect"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:18DestinationTesting16ConformanceCheckO","text":"ConformanceCheck"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sourceLocation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Testing14SourceLocationV","text":"SourceLocation"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"abstract":[{"type":"text","text":"Records an issue for each way the destination breaks "},{"type":"codeVoice","code":"check"},{"type":"text","text":"’s rule."}],"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance\/expect(_:sourceLocation:)"}}}