{"topicSections":[{"title":"Checking a destination","anchor":"Checking-a-destination","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck","doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"]},{"title":"Sending without a network","anchor":"Sending-without-a-network","identifiers":["doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport"]}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationConformance","type":"reference","isActive":true},{"type":"text","text":" runs the checks every vendor destination must pass, through a"},{"type":"text","text":" "},{"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ScriptedTransport","type":"reference","isActive":true},{"type":"text","text":" that keeps each request and answers from a script rather than the network:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"its requests match recorded fixtures byte for byte;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value is sent only after the adopter opts in, and only while the record reveals it;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"behind a tracker’s consent and ","type":"text"},{"code":"accepting(_:)","type":"codeVoice"},{"text":", it sends exactly the records it is handed;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"a record over the vendor’s limit is left out and reported, and the rest of its batch is sent;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"no response, a 5xx, 408, 429 and each status of the encoder’s ","type":"text"},{"code":"transientStatuses","type":"codeVoice"},{"text":" are retried,","type":"text"},{"text":" ","type":"text"},{"text":"and other failures are dropped and reported;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a 2xx answer whose body the encoder can’t read, an empty one included, counts as delivered: sent","type":"text"},{"text":" ","type":"text"},{"text":"once, nothing reported;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"no request carries a trace context in its header fields, even while a tracer is active.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make it with the vendor’s limit and a closure that calls the vendor’s factory with the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/DestinationSetup"},{"type":"text","text":"‘s plan, transport and backoff. Every check’s records are tracked at the"},{"type":"text","text":" "},{"type":"text","text":"setup’s "},{"type":"codeVoice","code":"timestamp"},{"type":"text","text":"; a factory whose encoder leaves out records by their age takes it as the time"},{"type":"text","text":" "},{"type":"text","text":"it encodes at, so the checks pass whenever the test runs. Run each "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting\/ConformanceCheck"},{"type":"text","text":" as a test"},{"type":"text","text":" "},{"type":"text","text":"case of its own:"}]},{"type":"codeListing","code":["import DestinationTesting","import Foundation","import HTTPDestinations","import PostHogEncoding","import Testing","","@Test(arguments: ConformanceCheck.allCases)","func postHogConformance(check: ConformanceCheck) async throws {","    let host = try #require(URL(string: \"https:\/\/posthog.example.com\"))","    let conformance = DestinationConformance(limit: PostHogBatchEncoder.batchLimit) { setup in","        try HTTPDestination.postHog(projectToken: \"phc_test\", host: host, plan: setup.plan, transport: setup.transport, backoff: setup.backoff)","    }","    try await conformance.expect(check)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each check records a Swift Testing issue for every rule the destination breaks. A project’s own"},{"type":"text","text":" "},{"type":"text","text":"tests write their assertions out in full. This one is shared on purpose, as TrackingPlanTesting’s"},{"type":"text","text":" "},{"code":"expectTrackingPlan(_:matches:sourceLocation:)","type":"codeVoice"},{"type":"text","text":" is, so every vendor module runs the same checks."},{"type":"text","text":" "},{"type":"text","text":"It imports Swift Testing, so add it to test targets only. "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" leaves it out."}]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/writingavendordestination"},{"text":" ","type":"text"},{"text":"covers the module these checks test.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/DestinationTesting\/documentation\/DestinationTesting"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/destinationtesting"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"collection","externalID":"DestinationTesting","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"DestinationTesting"}],"title":"DestinationTesting"},"abstract":[{"text":"Check from Swift Testing that a vendor destination keeps the library’s rules and sends what its fixtures record.","type":"text"}],"kind":"symbol","hierarchy":{"p