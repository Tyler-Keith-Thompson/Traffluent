{"sections":[],"topicSections":[{"identifiers":["doc:\/\/Events\/documentation\/Events\/Event","doc:\/\/Events\/documentation\/Events\/ConsentCategory","doc:\/\/Events\/documentation\/Events\/EventSchema","doc:\/\/Events\/documentation\/Events\/EventSchema\/Enumeration","doc:\/\/Events\/documentation\/Events\/DiscoveredEvent"],"title":"Events","anchor":"Events"},{"identifiers":["doc:\/\/Events\/documentation\/Events\/Sensitive","doc:\/\/Events\/documentation\/Events\/Refined","doc:\/\/Events\/documentation\/Events\/Refinement","doc:\/\/Events\/documentation\/Events\/Constraint","doc:\/\/Events\/documentation\/Events\/ValidationKeyword","doc:\/\/Events\/documentation\/Events\/UnsatisfiedConstraint","doc:\/\/Events\/documentation\/Events\/InvalidConstraint","doc:\/\/Events\/documentation\/Events\/ConstraintViolation"],"title":"Property values","anchor":"Property-values"},{"identifiers":["doc:\/\/Events\/documentation\/Events\/EventRecord","doc:\/\/Events\/documentation\/Events\/SourceLocation","doc:\/\/Events\/documentation\/Events\/Enricher"],"title":"Records","anchor":"Records"},{"identifiers":["doc:\/\/Events\/documentation\/Events\/SessionKey","doc:\/\/Events\/documentation\/Events\/SampleRateKey","doc:\/\/Events\/documentation\/Events\/SampleRate","doc:\/\/Events\/documentation\/Events\/InvalidSampleRate","doc:\/\/Events\/documentation\/Events\/ScreenKey","doc:\/\/Events\/documentation\/Events\/ApplicationKey","doc:\/\/Events\/documentation\/Events\/DeviceKey","doc:\/\/Events\/documentation\/Events\/OperatingSystemKey","doc:\/\/Events\/documentation\/Events\/LocaleKey","doc:\/\/Events\/documentation\/Events\/NetworkKey"],"title":"Context a store keeps","abstract":[{"text":"The keys a store writes beside each record, so a record recovered after a relaunch carries them as","type":"text"},{"text":" ","type":"text"},{"text":"it was tracked. Other modules set them: ","type":"text"},{"type":"codeVoice","code":"Sessions"},{"text":", a tracker’s samplers (","type":"text"