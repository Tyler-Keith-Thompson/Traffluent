gory\/analytics","type":"reference","isActive":true},{"text":" and 1.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two property types carry rules of their own. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value, such as an email address,"},{"type":"text","text":" "},{"type":"text","text":"prints as "},{"type":"codeVoice","code":"<redacted>"},{"type":"text","text":" and has no public accessor: a destination reads it through"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/reveal(_:)"},{"type":"text","text":", which gives "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" once a delivery has redacted the record. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Refined"},{"type":"text","text":" value satisfies every "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Constraint"},{"type":"text","text":" its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Refinement"},{"type":"text","text":" lists, checked once as it is"},{"type":"text","text":" "},{"type":"text","text":"made: its initializer throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/UnsatisfiedConstraint"},{"type":"text","text":" for a value that breaks one. Each"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Constraint"},{"type":"text","text":" spelling throws "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/InvalidConstraint"},{"type":"text","text":" for an argument no schema can hold, such as"},{"type":"text","text":" "},{"type":"text","text":"a negative length."}]},{"type":"paragraph","inl