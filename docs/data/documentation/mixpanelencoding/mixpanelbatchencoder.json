{"identifier":{"url":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/init(projectToken:plan:limit:now:)"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)"]},{"generated":true,"anchor":"Type-Aliases","title":"Type Aliases","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/Failure"]},{"generated":true,"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/transientStatuses"]},{"generated":true,"anchor":"Type-Methods","title":"Type Methods","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)"]}],"sections":[],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/MixpanelEncoding\/s8SendableP","doc:\/\/MixpanelEncoding\/s16SendableMetatypeP"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Make the destination with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:now:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and Mixpanel’s limits:"}],"type":"paragraph"},{"syntax":"swift","code":["let mixpanel = try HTTPDestination.mixpanel(","    projectToken: projectToken,","    region: .eu,  \/\/ or .us or .india, where the project's data resides","    plan: plan)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The body is a JSON array of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", one object per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first, each with two members: "},{"type":"codeVoice","code":"event"},{"type":"text","text":", the event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":" as it is, and "},{"type":"codeVoice","code":"properties"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"event’s stored properties by name, then these members:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$device_id"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; left out for a record with no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$insert_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"distinct_id"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, as ","type":"text"},{"type":"codeVoice","code":"$device_id"},{"text":" holds it; the record’s own ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":" when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ip"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"0\"","type":"codeVoice"},{"text":", so Mixpanel adds no location from the request’s address","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"time","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in whole milliseconds since 1970"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"token"}]}],[{"type":"paragraph","inlineContent":[{"text":"The project token","type":"text"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"code":"$user_id","type":"codeVoice"},{"type":"text","text":", and no other device"},{"type":"text","text":" "},{"type":"text","text":"identifier. Mixpanel counts a user per "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":", so its unique users are sessions. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":") is its own"},{"type":"text","text":" "},{"type":"text","text":"anonymous user, linked to nothing, rather than an event with no "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":", which Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"would attribute to no user, or to a hash of the request’s address. Mixpanel treats two events"},{"type":"text","text":" "},{"type":"text","text":"of the same "},{"code":"event","type":"codeVoice"},{"type":"text","text":", "},{"code":"time","type":"codeVoice"},{"type":"text","text":", "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":" and "},{"code":"$insert_id","type":"codeVoice"},{"type":"text","text":" as one. A record a store recovers"},{"type":"text","text":" "},{"type":"text","text":"after a relaunch keeps its session, so it goes out with the "},{"code":"distinct_id","type":"codeVoice"},{"type":"text","text":" and "},{"code":"$device_id","type":"codeVoice"},{"type":"text","text":" of"},{"type":"text","text":" "},{"type":"text","text":"its first send, and Mixpanel treats it as the copy it had already stored, if it had. The record’s vendor identifier and"},{"type":"text","text":" "},{"type":"text","text":"trace context, and any other context value, aren’t sent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Mixpanel cuts each string down to 255 characters. It drops an event of 255 properties or more,"},{"type":"text","text":" "},{"type":"text","text":"counting the members above and the default properties below, one holding an array of 255"},{"type":"text","text":" "},{"type":"text","text":"elements or more, and one whose property nests objects more than 3 deep, though it answers"},{"type":"text","text":" "},{"type":"text","text":"200: the encoder enforces these limits, leaving such a record out of the request."}],"type":"paragraph"},{"inlineContent":[{"code":"properties","type":"codeVoice"},{"text":" also holds Mixpanel’s default properties, named as its Swift SDK names them, for","type":"text"},{"text":" ","type":"text"},{"text":"each of the keys the record’s context has a value for:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$app_version_string","type":"codeVoice"},{"type":"text","text":", "},{"code":"$app_build_number","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The version and build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$model"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The model"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$wifi"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether the connection is Wi-Fi"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$os"},{"type":"text","text":", "},{"type":"codeVoice","code":"$os_version"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The operating system’s name and version"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event name starts with"},{"type":"text","text":" "},{"code":"$","type":"codeVoice"},{"type":"text","text":", as Mixpanel’s own events’ do, one with a property named as one Mixpanel reads for itself,"},{"type":"text","text":" "},{"type":"text","text":"one past Mixpanel’s limits on properties, array elements or nesting, one whose event isn’t"},{"type":"text","text":" "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is no"},{"type":"text","text":" "},{"code":"time","type":"codeVoice"},{"type":"text","text":" Mixpanel takes, one tracked more than 119 hours (5 days less an hour) before the batch"},{"type":"text","text":" "},{"type":"text","text":"is encoded or more than an hour after, and one too large for Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, gives each a deadline 119 hours after its oldest record was tracked, and makes none","type":"text"},{"text":" ","type":"text"},{"text":"for a batch with no record it can write, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends nothing for it. Mixpanel","type":"text"},{"text":" ","type":"text"},{"text":"answers a request it reads with 200, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" retries one","type":"text"},{"text":" ","type":"text"},{"text":"that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400, 401 or","type":"text"},{"text":" ","type":"text"},{"text":"413. It answers 200 as well to a request in which it finds no valid event, and says so in the","type":"text"},{"text":" ","type":"text"},{"text":"body: with ","type":"text"},{"type":"codeVoice","code":"verbose=1"},{"text":", which the destination’s endpoint sets, ","type":"text"},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"text":".","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)","type":"reference","isActive":true},{"text":" reads that as rejected, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" drops the request and reports it","type":"text"},{"text":" ","type":"text"},{"text":"with Mixpanel’s error. A ","type":"text"},{"type":"codeVoice","code":"status"},{"text":" of 1 means only that one event or more was well formed, not","type":"text"},{"text":" ","type":"text"},{"text":"that the token names a project, so a wrong region, or a token of no project, may still be","type":"text"},{"text":" ","type":"text"},{"text":"answered 200 with nothing stored: check the project’s Live View after setting it up.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The track API ingests only events from the last 5 days, and answers 200 while storing nothing","type":"text"},{"text":" ","type":"text"},{"text":"for an older one. So a record older than that, such as one a store kept through a long time","type":"text"},{"text":" ","type":"text"},{"text":"offline, is dropped and reported rather than sent: left out when its batch is encoded","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow","isActive":true},{"text":"), or, when its request is still being retried","type":"text"},{"text":" ","type":"text"},{"text":"at the deadline, dropped with the request and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":". The hour to spare is for a queue on","type":"text"},{"text":" ","type":"text"},{"text":"Mixpanel’s side and clocks that disagree. Mixpanel also rejects an event more than an hour in","type":"text"},{"text":" ","type":"text"},{"text":"the future, so a record tracked more than an hour after its batch is encoded is left out as","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow","isActive":true},{"text":" too.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A record sent again keeps its "},{"type":"codeVoice","code":"$insert_id"},{"type":"text","text":". The bytes are the same for the same records on"},{"type":"text","text":" "},{"type":"text","text":"every run and platform: no whitespace, object members in the order of their names’ UTF-8 bytes."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"]]},"kind":"symbol","abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Mixpanel’s track API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send"},{"type":"text","text":" "},{"type":"text","text":"events to a Mixpanel project’s "},{"type":"codeVoice","code":"POST \/track"},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mixpanelencoding\/mixpanelbatchencoder"]}],"metadata":{"remoteSource":{"fileName":"MixpanelBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MixpanelEncoding\/MixpanelBatchEncoder.swift#L98"},"modules":[{"name":"MixpanelEncoding"}],"role":"symbol","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"title":"MixpanelBatchEncoder","symbolKind":"struct","externalID":"s:16MixpanelEncoding0A12BatchEncoderV","navigatorTitle":[{"kind":"identifier","text":"MixpanelBatchEncoder"}]},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"title":"BatchEncoder","abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" sends.","type":"text"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/Failure":{"title":"MixpanelBatchEncoder.Failure","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/failure","abstract":[{"text":"Why a record was left out of the batch’s requests.","type":"text"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"identifier"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/Failure","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Failure","kind":"identifier"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/HTTPDestinations/HTTPDestination/mixpanel(projectToken:region:plan:backoff:clock:now:)":{"type":"topic","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:now:)","role":"symbol","url":"\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:backoff:clock:now:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16MixpanelEncoding0A6RegionO","text":"MixpanelRegion","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","text":"ExponentialBackoff","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO","text":"MixpanelSetupError","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV","text":"MixpanelBatchEncoder","kind":"typeIdentifier"},{"text":">","kind":"text"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" is "},{"type":"codeVoice","code":"URLSessionTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"MixpanelBatchEncoder"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"title":"mixpanel(projectToken:region:plan:backoff:clock:now:)","abstract":[{"text":"A destination that sends batches to the Mixpanel project of ","type":"text"},{"type":"codeVoice","code":"projectToken"},{"text":", whose data","type":"text"},{"text":" ","type":"text"},{"text":"resides in ","type":"text"},{"type":"codeVoice","code":"region"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"URLSession.shared"},{"text":", retrying a send that fails for now with the","type":"text"},{"text":" ","type":"text"},{"text":"waits of ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"clock"},{"text":".","type":"text"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/init(projectToken:plan:limit:now:)":{"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"projectToken"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"limit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier","text":"BatchLimit"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier","text":"Date"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"An encoder of the events "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, for the Mixpanel project of "},{"type":"codeVoice","code":"projectToken"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"splitting each batch to "},{"type":"codeVoice","code":"limit"},{"type":"text","text":", leaving out records more than 119 hours older than "},{"type":"codeVoice","code":"now"},{"type":"text","text":" "},{"type":"text","text":"gives, or more than an hour newer."}],"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/init(projecttoken:plan:limit:now:)","kind":"symbol","title":"init(projectToken:plan:limit:now:)","type":"topic","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/init(projectToken:plan:limit:now:)"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"title":"MixpanelEncodingError","url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelEncodingError","kind":"identifier"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"MixpanelEncodingError","kind":"identifier"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder":{"title":"MixpanelBatchEncoder","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder","abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"text":" of Mixpanel’s track API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" can send","type":"text"},{"text":" ","type":"text"},{"text":"events to a Mixpanel project’s ","type":"text"},{"code":"POST \/track","type":"codeVoice"},{"text":".","type