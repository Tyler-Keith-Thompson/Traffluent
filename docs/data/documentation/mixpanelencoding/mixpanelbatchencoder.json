{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Make the destination with ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:now:)","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and Mixpanel’s limits:","type":"text"}]},{"syntax":"swift","code":["let mixpanel = try HTTPDestination.mixpanel(","    projectToken: projectToken,","    region: .eu,  \/\/ or .us or .india, where the project's data resides","    plan: plan)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a JSON array of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", one object per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first, each with two members: "},{"type":"codeVoice","code":"event"},{"type":"text","text":", the event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":" as it is, and "},{"type":"codeVoice","code":"properties"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"event’s stored properties by name, then these members:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"$device_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; left out for a record with no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$insert_id"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID string; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"distinct_id","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, as "},{"type":"codeVoice","code":"$device_id"},{"type":"text","text":" holds it; the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ip"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"0\""},{"type":"text","text":", so Mixpanel adds no location from the request’s address"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"time"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in whole milliseconds since 1970","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"token","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The project token","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"$user_id"},{"type":"text","text":", and no other device"},{"type":"text","text":" "},{"type":"text","text":"identifier. Mixpanel counts a user per "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", so its unique users are sessions. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is its own"},{"type":"text","text":" "},{"type":"text","text":"anonymous user, linked to nothing, rather than an event with no "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", which Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"would attribute to no user, or to a hash of the request’s address. Mixpanel treats two events"},{"type":"text","text":" "},{"type":"text","text":"of the same "},{"type":"codeVoice","code":"event"},{"type":"text","text":", "},{"type":"codeVoice","code":"time"},{"type":"text","text":", "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$insert_id"},{"type":"text","text":" as one. A record a store recovers"},{"type":"text","text":" "},{"type":"text","text":"after a relaunch keeps its session, so it goes out with the "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$device_id"},{"type":"text","text":" of"},{"type":"text","text":" "},{"type":"text","text":"its first send, and Mixpanel treats it as the copy it had already stored, if it had. The record’s vendor identifier and"},{"type":"text","text":" "},{"type":"text","text":"trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Mixpanel cuts each string down to 255 characters. It drops an event of 255 properties or more,"},{"type":"text","text":" "},{"type":"text","text":"counting the members above and the default properties below, one holding an array of 255"},{"type":"text","text":" "},{"type":"text","text":"elements or more, and one whose property nests objects more than 3 deep, though it answers"},{"type":"text","text":" "},{"type":"text","text":"200: the encoder enforces these limits, leaving such a record out of the request."}]},{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"},{"text":" also holds Mixpanel’s default properties, named as its Swift SDK names them, for","type":"text"},{"text":" ","type":"text"},{"text":"each of the keys the record’s context has a value for:","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$app_version_string"},{"type":"text","text":", "},{"type":"codeVoice","code":"$app_build_number"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The version and build, each left out when ","type":"text"},{"type":"codeVoice","code":"nil"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$model","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The model"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$wifi"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NetworkKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Whether the connection is Wi-Fi","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$os"},{"type":"text","text":", "},{"type":"codeVoice","code":"$os_version"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The operating system’s name and version"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name starts with"},{"type":"text","text":" "},{"type":"codeVoice","code":"$"},{"type":"text","text":", as Mixpanel’s own events’ do, one with a property named as one Mixpanel reads for itself,"},{"type":"text","text":" "},{"type":"text","text":"one past Mixpanel’s limits on properties, array elements or nesting, one whose event isn’t"},{"type":"text","text":" "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is no"},{"type":"text","text":" "},{"type":"codeVoice","code":"time"},{"type":"text","text":" Mixpanel takes, one tracked more than 119 hours (5 days less an hour) before the batch"},{"type":"text","text":" "},{"type":"text","text":"is encoded or more than an hour after, and one too large for Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","type":"reference","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, gives each a deadline 119 hours after its oldest record was tracked, and makes none"},{"type":"text","text":" "},{"type":"text","text":"for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for it. Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"answers a request it reads with 200, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries one"},{"type":"text","text":" "},{"type":"text","text":"that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400, 401 or"},{"type":"text","text":" "},{"type":"text","text":"413. It answers 200 as well to a request in which it finds no valid event, and says so in the"},{"type":"text","text":" "},{"type":"text","text":"body: with "},{"type":"codeVoice","code":"verbose=1"},{"type":"text","text":", which the destination’s endpoint sets, "},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"type":"text","text":"."},{"type":"text","text":" "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)","type":"reference","isActive":true},{"type":"text","text":" reads that as rejected, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" drops the request and reports it"},{"type":"text","text":" "},{"type":"text","text":"with Mixpanel’s error. A "},{"type":"codeVoice","code":"status"},{"type":"text","text":" of 1 means only that one event or more was well formed, not"},{"type":"text","text":" "},{"type":"text","text":"that the token names a project, so a wrong region, or a token of no project, may still be"},{"type":"text","text":" "},{"type":"text","text":"answered 200 with nothing stored: check the project’s Live View after setting it up."}]},{"type":"paragraph","inlineContent":[{"text":"The track API ingests only events from the last 5 days, and answers 200 while storing nothing","type":"text"},{"text":" ","type":"text"},{"text":"for an older one. So a record older than that, such as one a store kept through a long time","type":"text"},{"text":" ","type":"text"},{"text":"offline, is dropped and reported rather than sent: left out when its batch is encoded","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow"},{"text":"), or, when its request is still being retried","type":"text"},{"text":" ","type":"text"},{"text":"at the deadline, dropped with the request and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":". The hour to spare is for a queue on","type":"text"},{"text":" ","type":"text"},{"text":"Mixpanel’s side and clocks that disagree. Mixpanel also rejects an event more than an hour in","type":"text"},{"text":" ","type":"text"},{"text":"the future, so a record tracked more than an hour after its batch is encoded is left out as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow"},{"text":" too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A record sent again keeps its ","type":"text"},{"type":"codeVoice","code":"$insert_id"},{"text":". The bytes are the same for the same records on","type":"text"},{"text":" ","type":"text"},{"text":"every run and platform: no whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}]}],"kind":"content"}],"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/init(projectToken:plan:limit:now:)"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)"]},{"title":"Type Aliases","anchor":"Type-Aliases","generated":true,"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/Failure"]},{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/transientStatuses"]},{"title":"Type Methods","anchor":"Type-Methods","generated":true,"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)"]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/MixpanelEncoding\/s8SendableP","doc:\/\/MixpanelEncoding\/s16SendableMetatypeP"]}],"metadata":{"symbolKind":"struct","modules":[{"name":"MixpanelEncoding"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MixpanelEncoding\/MixpanelBatchEncoder.swift#L98","fileName":"MixpanelBatchEncoder.swift"},"role":"symbol","externalID":"s:16MixpanelEncoding0A12BatchEncoderV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"title":"MixpanelBatchEncoder","roleHeading":"Structure","navigatorTitle":[{"text":"MixpanelBatchEncoder","kind":"identifier"}]},"identifier":{"url":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","interfaceLanguage":"swift"},"abstract":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"text":" of Mixpanel’s track API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can send","type":"text"},{"text":" ","type":"text"},{"text":"events to a Mixpanel project’s ","type":"text"},{"type":"codeVoice","code":"POST \/track"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mixpanelencoding\/mixpanelbatchencoder"]}],"references":{"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/transientStatuses":{"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/transientstatuses","type":"topic","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/transientStatuses","role":"symbol","title":"transientStatuses","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientStatuses"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:16HTTPDestinations15TransientStatusV","kind":"typeIdentifier","text":"TransientStatus"},{"kind":"text","text":">"}],"abstract":[{"text":"No status beyond the 408, 429 and 5xx that ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" retries for every encoder.","type":"text"}],"kind":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder":{"role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" of Mixpanel’s track API, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" can send","type":"text"},{"text":" ","type":"text"},{"text":"events to a Mixpanel project’s ","type":"text"},{"type":"codeVoice","code":"POST \/track"},{"text":".","type":"text"}],"title":"MixpanelBatchEncoder","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","type":"topic","navigatorTitle":[{"text":"MixpanelBatchEncoder","kind":"identifier"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends."}],"title":"BatchEncoder","kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"topic","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/batchLimit":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/batchlimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier","text":"BatchLimit"}],"role":"symbol","abstract":[{"type":"text","text":"Mixpanel’s limits on one request: 2,000 events, 2,000,000 bytes of body, and 999,999 bytes"},{"type":"text","text":" "},{"type":"text","text":"of one event."}],"kind":"symbol","type":"topic","title":"batchLimit"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/outcome(of:for:)":{"kind":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/outcome(of:for:)","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)","role":"symbol","title":"outcome(of:for:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","text":"HTTPTransportResponse","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","text":"EncodedRequest","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","text":"ResponseOutcome","kind":"typeIdentifier"}],"abstract":[{"text":"What Mixpanel’s 2xx answer means: rejected when it found no valid event in the request,","type":"text"},{"text":" ","type":"text"},{"text":"and delivered otherwise.","type":"text"}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"url":"\/documentation\/httpdestinations\/httpdestination","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"role":"symbol","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"kind":"symbol","type":"topic","title":"HTTPDestination"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError/timestampOutsideWindow":{"role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror\/timestampoutsidewindow","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timestampOutsideWindow","kind":"identifier"}],"abstract":[{"type":"text","text":"The record was tracked more than 119 hours before the batch was encoded or more than an"},{"type":"text","text":" "},{"type":"text","text":"hour after it, or the clock the encoder reads gave a NaN or infinite time. Mixpanel’s track"},{"type":"text","text":" "},{"type":"text","text":"API drops an event more than 5 days old while answering 200, the hour to spare being for a"},{"type":"text","text":" "},{"type":"text","text":"queue on Mixpanel’s side and clocks that disagree, and rejects one more than an hour in the"},{"type":"text","text":" "},{"type":"text","text":"future."}],"title":"MixpanelEncodingError.timestampOutsideWindow","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow","type":"topic"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"role":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelEncodingError","kind":"identifier"}],"abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"title":"MixpanelEncodingError","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"topic","navigatorTitle":[{"text":"MixpanelEncodingError","kind":"identifier"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/requests(for:)":{"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/requests(for:)","title":"requests(for:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requests"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV","text":"BatchRequests"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0aB5ErrorO","text":"MixpanelEncodingError"},{"kind":"text","text":">"}],"abstract":[{"type":"