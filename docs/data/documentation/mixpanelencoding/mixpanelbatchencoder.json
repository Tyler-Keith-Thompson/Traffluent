{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Make the destination with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:now:)","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and Mixpanel’s limits:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let mixpanel = try HTTPDestination.mixpanel(","    projectToken: projectToken,","    region: .eu,  \/\/ or .us or .india, where the project's data resides","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON array of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":", one object per record, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first, each with two members: ","type":"text"},{"code":"event","type":"codeVoice"},{"text":", the event’s ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":" as it is, and ","type":"text"},{"code":"properties","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"event’s stored properties by name, then these members:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$device_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":", as a lowercase UUID string; left out for a record with no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$insert_id"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID string; a redelivered record keeps it"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"distinct_id","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, as "},{"code":"$device_id","type":"codeVoice"},{"type":"text","text":" holds it; the record’s own "},{"code":"EventRecord\/id","type":"codeVoice"},{"type":"text","text":" when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ip"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"\"0\""},{"type":"text","text":", so Mixpanel adds no location from the request’s address"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"time"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When the event was tracked, in whole milliseconds since 1970","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"token"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The project token"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"$user_id"},{"type":"text","text":", and no other device"},{"type":"text","text":" "},{"type":"text","text":"identifier. Mixpanel counts a user per "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", so its unique users are sessions. A"},{"type":"text","text":" "},{"type":"text","text":"record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is its own"},{"type":"text","text":" "},{"type":"text","text":"anonymous user, linked to nothing, rather than an event with no "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", which Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"would attribute to no user, or to a hash of the request’s address. Mixpanel treats two events"},{"type":"text","text":" "},{"type":"text","text":"of the same "},{"type":"codeVoice","code":"event"},{"type":"text","text":", "},{"type":"codeVoice","code":"time"},{"type":"text","text":", "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$insert_id"},{"type":"text","text":" as one. A record a store recovers"},{"type":"text","text":" "},{"type":"text","text":"after a relaunch keeps its session, so it goes out with the "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"$device_id"},{"type":"text","text":" of"},{"type":"text","text":" "},{"type":"text","text":"its first send, and Mixpanel treats it as the copy it had already stored, if it had. The record’s vendor identifier and"},{"type":"text","text":" "},{"type":"text","text":"trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":", as ","type":"text"},{"code":"PropertyReader","type":"codeVoice"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference"},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"code":"null","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Mixpanel cuts each string down to 255 characters. It drops an event of 255 properties or more,","type":"text"},{"text":" ","type":"text"},{"text":"counting the members above and the default properties below, one holding an array of 255","type":"text"},{"text":" ","type":"text"},{"text":"elements or more, and one whose property nests objects more than 3 deep, though it answers","type":"text"},{"text":" ","type":"text"},{"text":"200: the encoder enforces these limits, leaving such a record out of the request.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"properties"},{"text":" also holds Mixpanel’s default properties, named as its Swift SDK names them, for","type":"text"},{"text":" ","type":"text"},{"text":"each of the keys the record’s context has a value for:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$app_version_string"},{"type":"text","text":", "},{"type":"codeVoice","code":"$app_build_number"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The version and build, each left out when "},{"type":"codeVoice","code":"nil"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$model","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The model","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"$wifi","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NetworkKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Whether the connection is Wi-Fi","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"$os"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$os_version"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The operating system’s name and version","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name starts with","type":"text"},{"text":" ","type":"text"},{"code":"$","type":"codeVoice"},{"text":", as Mixpanel’s own events’ do, one with a property named as one Mixpanel reads for itself,","type":"text"},{"text":" ","type":"text"},{"text":"one past Mixpanel’s limits on properties, array elements or nesting, one whose event isn’t","type":"text"},{"text":" ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp is no","type":"text"},{"text":" ","type":"text"},{"code":"time","type":"codeVoice"},{"text":" Mixpanel takes, one tracked more than 119 hours (5 days less an hour) before the batch","type":"text"},{"text":" ","type":"text"},{"text":"is encoded or more than an hour after, and one too large for Mixpanel","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"reference","isActive":true},{"text":").","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, gives each a deadline 119 hours after its oldest record was tracked, and makes none"},{"type":"text","text":" "},{"type":"text","text":"for a batch with no record it can write, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for it. Mixpanel"},{"type":"text","text":" "},{"type":"text","text":"answers a request it reads with 200, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" retries one"},{"type":"text","text":" "},{"type":"text","text":"that gets no response, a 5xx, 408 or 429, and drops one it rejects, such as with 400, 401 or"},{"type":"text","text":" "},{"type":"text","text":"413. It answers 200 as well to a request in which it finds no valid event, and says so in the"},{"type":"text","text":" "},{"type":"text","text":"body: with "},{"code":"verbose=1","type":"codeVoice"},{"type":"text","text":", which the destination’s endpoint sets, "},{"code":"{\"status\": 0, \"error\": ...}","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)","isActive":true},{"type":"text","text":" reads that as rejected, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" drops the request and reports it"},{"type":"text","text":" "},{"type":"text","text":"with Mixpanel’s error. A "},{"code":"status","type":"codeVoice"},{"type":"text","text":" of 1 means only that one event or more was well formed, not"},{"type":"text","text":" "},{"type":"text","text":"that the token names a project, so a wrong region, or a token of no project, may still be"},{"type":"text","text":" "},{"type":"text","text":"answered 200 with nothing stored: check the project’s Live View after setting it up."}]},{"type":"paragraph","inlineContent":[{"text":"The track API ingests only events from the last 5 days, and answers 200 while storing nothing","type":"text"},{"text":" ","type":"text"},{"text":"for an older one. So a record older than that, such as one a store kept through a long time","type":"text"},{"text":" ","type":"text"},{"text":"offline, is dropped and reported rather than sent: left out when its batch is encoded","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow","isActive":true,"type":"reference"},{"text":"), or, when its request is still being retried","type":"text"},{"text":" ","type":"text"},{"text":"at the deadline, dropped with the request and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":". The hour to spare is for a queue on","type":"text"},{"text":" ","type":"text"},{"text":"Mixpanel’s side and clocks that disagree. Mixpanel also rejects an event more than an hour in","type":"text"},{"text":" ","type":"text"},{"text":"the future, so a record tracked more than an hour after its batch is encoded is left out as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow","isActive":true,"type":"reference"},{"text":" too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A record sent again keeps its ","type":"text"},{"type":"codeVoice","code":"$insert_id"},{"text":". The bytes are the same for the same records on","type":"text"},{"text":" ","type":"text"},{"text":"every run and platform: no whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder"},{"type":"text","text":" of Mixpanel’s track API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send"},{"type":"text","text":" "},{"type":"text","text":"events to a Mixpanel project’s "},{"type":"codeVoice","code":"POST \/track"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/mixpanelencoding\/mixpanelbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding"]]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/MixpanelEncoding\/s8SendableP","doc:\/\/MixpanelEncoding\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"kind":"symbol","sections":[],"metadata":{"title":"MixpanelBatchEncoder","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelBatchEncoder"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"MixpanelBatchEncoder"}],"externalID":"s:16MixpanelEncoding0A12BatchEncoderV","remoteSource":{"fileName":"MixpanelBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MixpanelEncoding\/MixpanelBatchEncoder.swift#L98"},"modules":[{"name":"MixpanelEncoding"}],"role":"symbol"},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/init(projectToken:plan:limit:now:)"],"anchor":"Initializers","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)"],"anchor":"Instance-Methods","generated":true},{"title":"Type Aliases","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/Failure"],"anchor":"Type-Aliases","generated":true},{"title":"Type Properties","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/transientStatuses"],"anchor":"Type-Properties","generated":true},{"title":"Type Methods","identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)"],"anchor":"Type-Methods","generated":true}],"references":{"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/requests(for:)":{"title":"requests(for:)","url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/requests(for:)","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/requests(for:)","kind":"symbol","abstract":[{"code":"batch","type":"codeVoice"},{"text":" as the requests Mixpanel takes, each within the encoder’s limit and with a deadline","type":"text"},{"text":" ","type":"text"},{"text":"119 hours after its oldest record was tracked, with the records left out of them.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requests","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]) -> ","kind":"text"},{"text":"BatchRequests","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations13BatchRequestsV"},{"text":"<","kind":"text"},{"text":"MixpanelEncodingError","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0aB5ErrorO"},{"text":">","kind":"text"}],"type":"topic"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/init(projectToken:plan:limit:now:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"limit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/init(projecttoken:plan:limit:now:)","kind":"symbol","type":"topic","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/init(projectToken:plan:limit:now:)","abstract":[{"text":"An encoder of the events ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" describes, for the Mixpanel project of ","type":"text"},{"code":"projectToken","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"splitting each batch to ","type":"text"},{"code":"limit","type":"codeVoice"},{"text":", leaving out records more than 119 hours older than ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" ","type":"text"},{"text":"gives, or more than an hour newer.","type":"text"}],"title":"init(projectToken:plan:limit:now:)","role":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder":{"title":"MixpanelBatchEncoder","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Mixpanel’s track API, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" can send"},{"type":"text","text":" "},{"type":"text","text":"events to a Mixpanel project’s "},{"type":"codeVoice","code":"POST \/track"},{"type":"text","text":"."}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MixpanelBatchEncoder","kind":"identifier"}],"navigatorTitle":[{"text":"MixpanelBatchEncoder","kind":"identifier"}],"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder","type":"topic","kind":"symbol","role":"symbol"},"doc://MixpanelEncoding/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/MixpanelEncoding\/s16SendableMetatypeP"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"url":"\/documentation\/httpdestinations\/batchencoder","kind":"symbol","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}],"navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"title":"BatchEncoder","role":"symbol"},"doc://Events/documentation/Events/Sensitive":{"role":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","title":"Sensitive","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sensitive"}],"url":"\/documentation\/events\/sensitive","navigatorTitle":[{"kind":"identifier","text":"Sensitive"}],"abstract":[{"text":"A property value that a destination reads only through the record it arrived in, and not at all","type":"text"},{"text":" ","type":"text"},{"text":"once the record is redacted.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"title":"HTTPDestination","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"url":"\/documentation\/httpdestinations\/httpdestination","type":"topic","kind":"symbol","role":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/outcome(of:for:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"HTTPTransportResponse","preciseIdentifier":"s:16HTTPDestinations21HTTPTransportResponseV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EncodedRequest","preciseIdentifier":"s:16HTTPDestinations14EncodedRequestV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ResponseOutcome","preciseIdentifier":"s:16HTTPDestinations15ResponseOutcomeO","kind":"typeIdentifier"}],"url":"\/documentation\/mixpanelencoding\/mixpanelbatchencoder\/outcome(of:for:)","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/outcome(of:for:)","type":"topic","abstract":[{"text":"What Mixpanel’s 2xx answer means: rejected when it found no valid event in the request,","type":"text"},{"text":" ","type":"text"},{"text":"and delivered otherwise.","type":"text"}],"title":"outcome(of:for:)","role":"symbol"},"doc://MixpanelEncoding/s8SendableP":{"identifier":"doc:\/\/MixpanelEncoding\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"title":"MixpanelEncoding","abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","url":"\/documentation\/mixpanelencoding","type":"topic","kind":"symbol","role":"collection"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MixpanelEncodingError"}],"url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror","kind":"symbol","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError","type":"topic","abstract":[{"text":"Why ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","isActive":true,"type":"reference"},{"text":" couldn’t send a record, which it leaves out of the batch’s","type":"text"},{"text":" ","type":"text"},{"text":"requests as a ","type":"text"},{"code":"S