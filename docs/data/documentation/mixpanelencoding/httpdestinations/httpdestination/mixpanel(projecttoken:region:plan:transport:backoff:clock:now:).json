t":"<","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":"> = ContinuousClock(), ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Date","preciseIdentifier":"s:20FoundationEssentials4DateV","kind":"typeIdentifier"},{"text":" = { Date.now }) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"MixpanelSetupError","preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO","kind":"typeIdentifier","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"MixpanelBatchEncoder","preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV","kind":"typeIdentifier","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"projectToken","content":[{"type":"paragraph","inlineContent":[{"text":"The project’s token, from the project’s settings. Whitespace and newlines","type":"text"},{"text":" ","type":"text"},{"text":"around it are trimmed off.","type":"text"}]}]},{"name":"region","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the project’s data resides: "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/us","isActive":true},{"type":"text","text":", Mixpanel’s default,"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/eu","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/india","isActive":true},{"type":"text","text":"."}]}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}]},{"name":"backoff","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 2 seconds, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}]}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"text":"The wall-clock time a batch is encoded at, which the 119 hours are measured from,","type":"text"},{"text":" ","type":"text"},{"text":"and each request’s deadline is checked against before it is sent; the system’s clock by","type":"text"},{"text":" ","type":"text"},{"text":"default. When it reads NaN or infinite, every record is left out.","type":"text"}]}]}]},{"content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"The destination posts to the ","type":"text"},{"type":"codeVoice","code":"\/track"},{"text":" endpoint of ","type":"text"},{"type":"codeVoice","code":"region"},{"text":", encoded by a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","type":"reference"},{"text":" of ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":" within ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","type":"reference"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"ip=0"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so Mixpanel adds no location from the request’s address, and ","type":"text"},{"type":"codeVoice","code":"verbose=1"},{"text":", so Mixpanel says","type":"text"},{"text":" ","type":"text"},{"text":"in its answer whether it found a valid event, and sends no trace context in its header","type":"text"},{"text":" ","type":"text"},{"text":"fields. It retries what Mixpanel says to retry, no response, a 5xx, 408 or 429, and drops","type":"text"},{"text":" ","type":"text"},{"text":"and reports any other status, such as 400 for an invalid request, and a 200 whose body is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"text":", reported as ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.rejectedInBody"},{"text":" with Mixpanel’s","type":"text"},{"text":" ","type":"text"},{"text":"error. A status of 1 doesn’t confirm the token names a project, so a wrong region, or a","type":"text"},{"text":" ","type":"text"},{"text":"token of no project, may still be answered 200 with nothing stored: check the project’s","type":"text"},{"text":" ","type":"text"},{"text":"Live View after setting it up.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Mixpanel’s track API takes no event tracked more than 5 days before it arrives, and answers"},{"type":"text","text":" "},{"type":"text","text":"200 while storing nothing for one, so the encoder leaves out a record tracked more than 119"},{"type":"text","text":" "},{"type":"text","text":"hours before it is encoded, or more than an hour after, which Mixpanel rejects too"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow","type":"reference","isActive":true},{"type":"text","text":"). A request is"},{"type":"text","text":" "},{"type":"text","text":"encoded once and retried as it is, so one still undelivered 119 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record was tracked, by the time "},{"code":"now","type":"codeVoice"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The encoder logs a notice for each property of ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" named as one Mixpanel reserves, as","type":"text"},{"text":" ","type":"text"},{"text":"every record of its event will be skipped","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/reservedPropertyName(event:property:)","type":"reference","isActive":true},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The track API takes the project token, which is public, so the destination takes nothing","type":"text"},{"text":" ","type":"text"},{"text":"else: never the project’s secret or a service account’s credentials, which Mixpanel’s","type":"text"},{"text":" ","type":"text"},{"text":"import API takes and which must not ship in an app.","type":"text"}],"type":"paragraph"},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError\/emptyProjectToken","isActive":true},{"type":"text","text":" for a token that is empty or only"},{"type":"text","text":" "},{"type":"text","text":"whitespace, and "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError\/malformedProjectToken","isActive":true},{"type":"text","text":" for one holding a character"},{"type":"text","text":" "},{"type":"text","text":"other than an ASCII letter or digit."}],"type":"paragraph"}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination\/mixpanel(projectToken:region:plan:backoff:clock:now:)","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/ExponentialBackoff\/mixpanel","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError"],"generated":true,"anchor":"Sending-to-Mixpanel","title":"Sending to Mixpanel"}],"metadata":{"symbolKind":"method","modules":[{"name":"MixpanelEncoding","relatedModules":["HTTPDestinations"]}],"remoteSource":{"fileName":"HTTPDestination+Mixpanel.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/MixpanelEncoding\/HTTPDestination+Mixpanel.swift#L55"},"extendedModule":"HTTPDestinations","role":"symbol","externalID":"s:16HTTPDestinations15HTTPDestinationV16MixpanelEncodingAD0C12BatchEncoderVRs_rlE8mixpanel12projectToken6region4plan9transport7backoff5clock3nowACyxAFGSS_AD0C6RegionO13TrackingPlans0Q4PlanVxAA18ExponentialBackoffVqd__20FoundationEssentials4DateVyYbctAD0C10SetupErrorOYK12_Concurrency5ClockRd__s8DurationVA2_Rtd__lFZ","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"HTTPTransport","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Encoding","type":"codeVoice"},{"typ