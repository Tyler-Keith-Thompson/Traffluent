ext":" () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError","preciseIdentifier":"s:16MixpanelEncoding0A10SetupErrorO","text":"MixpanelSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","preciseIdentifier":"s:16MixpanelEncoding0A12BatchEncoderV","text":"MixpanelBatchEncoder"},{"kind":"text","text":">"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"projectToken","content":[{"inlineContent":[{"type":"text","text":"The project’s token, from the project’s settings. Whitespace and newlines"},{"type":"text","text":" "},{"type":"text","text":"around it are trimmed off."}],"type":"paragraph"}]},{"name":"region","content":[{"inlineContent":[{"type":"text","text":"Where the project’s data resides: "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/us","isActive":true},{"type":"text","text":", Mixpanel’s default,"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/eu","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/india","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}]},{"name":"transport","content":[{"inlineContent":[{"text":"What sends each request.","type":"text"}],"type":"paragraph"}]},{"name":"backoff","content":[{"type":"paragraph","inlineContent":[{"text":"How long to wait before each new attempt at a request; 2 seconds, doubling up","type":"text"},{"text":" ","type":"text"},{"text":"to 60 seconds, with full jitter, by default.","type":"text"}]}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, which the 119 hours are measured from,"},{"type":"text","text":" "},{"type":"text","text":"and each request’s deadline is checked against before it is sent; the system’s clock by"},{"type":"text","text":" "},{"type":"text","text":"default. When it reads NaN or infinite, every record is left out."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The destination.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The destination posts to the ","type":"text"},{"code":"\/track","type":"codeVoice"},{"text":" endpoint of ","type":"text"},{"code":"region","type":"codeVoice"},{"text":", encoded by a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","isActive":true,"type":"reference"},{"text":" of ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" within ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":", with ","type":"text"},{"code":"ip=0","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so Mixpanel adds no location from the request’s address, and ","type":"text"},{"code":"verbose=1","type":"codeVoice"},{"text":", so Mixpanel says","type":"text"},{"text":" ","type":"text"},{"text":"in its answer whether it found a valid event, and sends no trace context in its header","type":"text"},{"text":" ","type":"text"},{"text":"fields. It retries what Mixpanel says to retry, no response, a 5xx, 408 or 429, and drops","type":"text"},{"text":" ","type":"text"},{"text":"and reports any other status, such as 400 for an invalid request, and a 200 whose body is","type":"text"},{"text":" ","type":"text"},{"code":"{\"status\": 0, \"error\": ...}","type":"codeVoice"},{"text":", reported as ","type":"text"},{"code":"HTTPDropReport.rejectedInBody","type":"codeVoice"},{"text":" with Mixpanel’s","type":"text"},{"text":" ","type":"text"},{"text":"error. A status of 1 doesn’t confirm the token names a project, so a wrong region, or a","type":"text"},{"text":" ","type":"text"},{"text":"token of no project, may still be answered 200 with nothing stored: check the project’s","type":"text"},{"text":" ","type":"text"},{"text":"Live View after setting it up.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Mixpanel’s track API takes no event tracked more than 5 days before it arrives, and answers","type":"text"},{"text":" ","type":"text"},{"text":"200 while storing nothing for one, so the encoder leaves out a record tracked more than 119","type":"text"},{"text":" ","type":"text"},{"text":"hours before it is encoded, or more than an hour after, which Mixpanel rejects too","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow","isActive":true,"type":"reference"},{"text":"). A request is","type":"text"},{"text":" ","type":"text"},{"text":"encoded once and retried as it is, so one still undelivered 119 hours after its oldest","type":"text"},{"text":" ","type":"text"},{"text":"record was tracked, by the time ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" gives, isn’t sent again: it is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The encoder logs a notice for each property of "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" named as one Mixpanel reserves, as"},{"type":"text","text":" "},{"type":"text","text":"every record of its event will be skipped"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/reservedPropertyName(event:property:)"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"text":"The track API takes the project token, which is public, so the destination takes nothing","type":"text"},{"text":" ","type":"text"},{"text":"else: never the project’s secret or a service account’s credentials, which Mixpanel’s","type":"text"},{"text":" ","type":"text"},{"text":"import API takes and which must not ship in an app.","type":"text"}]},{"name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError\/emptyProjectToken","type":"reference","isActive":true},{"type":"text","text":" for a token that is empty or only"},{"type":"text","text":" "},{"type":"text","text":"whitespace, and "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError\/malformedProjectToken","type":"reference","isActive":true},{"type":"text","text":" for one holding a character"},{"type":"text","text":" "},{"type":"text","text":"other than an ASCII letter or digit."}],"type":"paragraph"}],"type":"aside","style":"note"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","metadata":{"externalID":"s:16HTTPDestinations15HTTPDestinationV16MixpanelEncodingAD0C12BatchEncoderVRs_rlE8mixpanel12projectToken6region4plan9transport7backoff5clock3nowACyxAFGSS_AD0C6RegionO13TrackingPlans0Q4PlanVxAA18ExponentialBackoffVqd__20FoundationEssentials4DateVyYbctAD0C10SetupErrorOYK12_Concurrency5ClockRd__s8DurationVA2_Rtd__lFZ","roleHeading":"Type Method","title":"mixpanel(projectToken:region:plan:transport:backoff:clock:now:)","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"HTTPTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"MixpanelBatchEncoder","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"role":"symbol","symbolKind":"method","extendedModule":"HTTPDestinations","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mixpanel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"projectToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MixpanelRegion","kind":"typeIdentifier","preciseIdentifier":"s:16MixpanelEncoding0A6RegionO"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"t