"text","text":" "},{"type":"text","text":"answers a request with a token it doesn’t know with 200 and stores nothing, so the factory"},{"type":"text","text":" "},{"type":"text","text":"refuses a malformed one when the destination is made."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"malformedProjectToken"}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError\/malformedProjectToken","title":"MixpanelSetupError.malformedProjectToken","type":"topic","role":"symbol"},"doc://MixpanelEncoding/documentation/MixpanelEncoding":{"title":"MixpanelEncoding","abstract":[{"type":"text","text":"Send records to a Mixpanel project through its track API."}],"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","url":"\/documentation\/mixpanelencoding","type":"topic","kind":"symbol","role":"collection"},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelEncodingError/reservedPropertyName(event:property:)":{"kind":"symbol","url":"\/documentation\/mixpanelencoding\/mixpanelencodingerror\/reservedpropertyname(event:property:)","role":"symbol","abstract":[{"type":"text","text":"A property’s name is one Mixpanel reads for itself: one starting with "},{"type":"codeVoice","code":"$"},{"type":"text","text":" ("},{"type":"codeVoice","code":"$insert_id"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"$user_id"},{"type":"text","text":", "},{"type":"codeVoice","code":"$ignore"},{"type":"text","text":" and Mixpanel’s default properties), or "},{"type":"codeVoice","code":"token"},{"type":"text","text":", "},{"type":"codeVoice","code":"time"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"distinct_id"},{"type":"text","text":", "},{"type":"codeVoice","code":"ip"},{"type":"text","text":" or "},{"type":"codeVoice","code":"bucket"},{"type":"text","text":". Sent, it would change how Mixpanel ingests the eve