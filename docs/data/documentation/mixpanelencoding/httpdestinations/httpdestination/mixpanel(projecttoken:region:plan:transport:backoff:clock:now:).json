n","content":[{"inlineContent":[{"type":"text","text":"The project’s token, from the project’s settings. Whitespace and newlines"},{"type":"text","text":" "},{"type":"text","text":"around it are trimmed off."}],"type":"paragraph"}]},{"name":"region","content":[{"inlineContent":[{"text":"Where the project’s data resides: ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/us","type":"reference","isActive":true},{"text":", Mixpanel’s default,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/eu","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelRegion\/india","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"plan","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}]},{"name":"transport","content":[{"type":"paragraph","inlineContent":[{"text":"What sends each request.","type":"text"}]}]},{"name":"backoff","content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 2 seconds, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}]},{"name":"now","content":[{"inlineContent":[{"type":"text","text":"The wall-clock time a batch is encoded at, which the 119 hours are measured from,"},{"type":"text","text":" "},{"type":"text","text":"and each request’s deadline is checked against before it is sent; the system’s clock by"},{"type":"text","text":" "},{"type":"text","text":"default. When it reads NaN or infinite, every record is left out."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The destination.","type":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The destination posts to the "},{"code":"\/track","type":"codeVoice"},{"type":"text","text":" endpoint of "},{"code":"region","type":"codeVoice"},{"type":"text","text":", encoded by a"},{"type":"text","text":" "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder","type":"reference","isActive":true},{"type":"text","text":" of "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" within "},{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","type":"reference","isActive":true},{"type":"text","text":", with "},{"code":"ip=0","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so Mixpanel adds no location from the request’s address, and "},{"code":"verbose=1","type":"codeVoice"},{"type":"text","text":", so Mixpanel says"},{"type":"text","text":" "},{"type":"text","text":"in its answer whether it found a valid event, and sends no trace context in its header"},{"type":"text","text":" "},{"type":"text","text":"fields. It retries what Mixpanel says to retry, no response, a 5xx, 408 or 429, and drops"},{"type":"text","text":" "},{"type":"text","text":"and reports any other status, such as 400 for an invalid request, and a 200 whose body is"},{"type":"text","text":" "},{"code":"{\"status\": 0, \"error\": ...}","type":"codeVoice"},{"type":"text","text":", reported as "},{"code":"HTTPDropReport.rejectedInBody","type":"codeVoice"},{"type":"text","text":" with Mixpanel’s"},{"type":"text","text":" "},{"type":"text","text":"error. A status of 1 doesn’t confirm the token names a project, so a wrong region, or a"},{"type":"text","text":" "},{"type":"text","text":"token of no project, may still be answered 200 with nothing stored: check the project’s"},{"type":"text","text":" "},{"type":"text","text":"Live View after setting it up."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Mixpanel’s track API takes no event tracked more than 5 days before it arrives, and answers"},{"type":"text","text":" "},{"type":"text","text":"200 while storing nothing for one, so the encoder leaves out a record tracked more than 119"},{"type":"text","text":" "},{"type":"text","text":"hours before it is encoded, or more than an hour after, which Mixpanel rejects too"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/timestampOutsideWindow","isActive":true},{"type":"text","text":"). A request is"},{"type":"text","text":" "},{"type":"text","text":"encoded once and retried as it is, so one still undelivered 119 hours after its oldest"},{"type":"text","text":" "},{"type":"text","text":"record was tracked, by the time "},{"type":"codeVoice","code":"now"},{"type":"text","text":" gives, isn’t sent again: it is dropped and reported as"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The encoder logs a notice for each property of ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" named as one Mixpanel reserves, as","type":"text"},{"text":" ","type":"text"},{"text":"every record of its event will be skipped","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelEncodingError\/reservedPropertyName(event:property:)","type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The track API takes the project token, which is public, so the destination takes nothing"},{"type":"text","text":" "},{"type":"text","text":"else: never the project’s secret or a service account’s credentials, which Mixpanel’s"},{"type":"text","text":" "},{"type":"text","text":"import API takes and which must not ship in an app."}],"type":"paragraph"},{"name":"Throws","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError\/emptyProjectToken","isActive":true},{"text":" for a token that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace, and ","type":"text"},{"type":"reference","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError\/malformedProjectToken","isActive":true},{"text":" for one holding a character","type":"text"},{"text":" ","type":"text"},{"text":"other than an ASCII letter or digit.","type":"text"}]}]}]}],"variants":[{"paths":["\/documentation\/mixpanelencoding\/httpdestinations\/httpdestination\/mixpanel(projecttoken:region:plan:transport:backoff:clock:now:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations","doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/HTTPDestinations\/HTTPDestination"]]},"references":{"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelBatchEncoder/batchLimit":{"identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelBatchEncoder\/batchLimit","kind":"symbol","role":"symbol","abstract":[{"text":"Mixpanel’s limits on one request: 2,000 events, 2,000,000 bytes of body, and 999,999 bytes","type":"text"},{"text":" ","type":"text"},{"text":"of one event.","type":"text"}],"url":"\/documentation\/mixpane