type":"topic","kind":"symbol","abstract":[{"text":"The token holds a character other than an ASCII letter or digit. Every Mixpanel project","type":"text"},{"text":" ","type":"text"},{"text":"token is alphanumeric, and a service account’s username (","type":"text"},{"type":"codeVoice","code":"name.1a2b3c.mp-service-account"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"is not, nor a credential for Mixpanel’s import API, which must not ship in an app. Mixpanel","type":"text"},{"text":" ","type":"text"},{"text":"answers a request with a token it doesn’t know with 200 and stores nothing, so the factory","type":"text"},{"text":" ","type":"text"},{"text":"refuses a malformed one when the destination is made.","type":"text"}],"title":"MixpanelSetupError.malformedProjectToken","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"malformedProjectToken","kind":"identifier"}]},"doc://MixpanelEncoding/documentation/MixpanelEncoding/MixpanelSetupError/emptyProjectToken":{"url":"\/documentation\/mixpanelencoding\/mixpanelsetuperror\/emptyprojecttoken","role":"symbol","type":"topic","identifier":"doc:\/\/MixpanelEncoding\/documentation\/MixpanelEncoding\/MixpanelSetupError\/emptyProjectToken","kind":"symbol","abstract":[{"type":"text","text":"The project token is empty, or only whitespace. Mixpanel ingests nothing without one."}],"title":"MixpanelSetupError.emptyProjectToken","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"emptyProjectToken","kind":"identifier"}]},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlan","kind":"identifier"}],"abstract":[{"text":"The JSON Schema (draft 2020-12) of every event an app tracks: one document per event and an","type":"text"},{"text":" ","type":"text"},{"text":"index, exported from the events’ ","type":"text"},{"identifier":"doc:\/\/Events\