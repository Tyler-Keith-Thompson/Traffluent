{"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"UIKitTracking"}],"roleHeading":"Framework","externalID":"UIKitTracking","title":"UIKitTracking","symbolKind":"module","role":"collection"},"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this module to track events from UIKit views, view controllers and controls on iOS, iPadOS,"},{"type":"text","text":" "},{"type":"text","text":"tvOS, visionOS and Mac Catalyst; elsewhere it builds empty, and on macOS and watchOS its API isn’t"},{"type":"text","text":" "},{"type":"text","text":"there. SwiftUI views use"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and AppKit views on macOS use"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The tracker is a UIKit trait, ","type":"text"},{"code":"TrackerTrait","type":"codeVoice"},{"text":". Set it on a window scene’s ","type":"text"},{"code":"traitOverrides","type":"codeVoice"},{"text":" as the","type":"text"},{"text":" ","type":"text"},{"text":"scene connects, and every view controller and view in the scene’s windows inherits it, the way","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI views inherit their environment. Read it in any of them as ","type":"text"},{"code":"traitCollection.tracker","type":"codeVoice"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"view controller or view can set its own for everything below it, and each scene keeps its own, so","type":"text"},{"text":" ","type":"text"},{"text":"two windows can track through two trackers. Until a tracker is set, the trait’s tracker tracks","type":"text"},{"text":" ","type":"text"},{"text":"through the one ","type":"text"},{"code":"Tracker.bootstrap","type":"codeVoice"},{"text":" made the process’s default, and with none it drops each event,","type":"text"},{"text":" ","type":"text"},{"text":"warning once per call site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"UIControl.track(_:for:)","type":"codeVoice"},{"text":" tracks an event each time a control sends the given control events","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":".primaryActionTriggered","type":"codeVoice"},{"text":" by default), through the tracker the control’s traits hold at that","type":"text"},{"text":" ","type":"text"},{"text":"moment:","type":"text"}]},{"code":["import Traffluent","import UIKit","","@Event","struct ShareTapped {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","final class CartViewController: UIViewController {","    let share = UIButton(configuration: .filled())","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        checkOut.addTarget(self, action: #selector(checkOut(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","        view.addSubview(checkOut)","    }","","    @objc func checkOut(_ sender: UIButton) {","        sender.traitCollection.tracker.track(CheckoutStarted(cartSize: 3))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"track(_:for:)"},{"text":" adds a ","type":"text"},{"type":"codeVoice","code":"UIAction"},{"text":" beside the control’s other actions and targets, so they still","type":"text"},{"text":" ","type":"text"},{"text":"run, and returns it; pass it to ","type":"text"},{"type":"codeVoice","code":"removeAction(_:for:)"},{"text":" to stop tracking. Where SwiftUI hosts","type":"text"},{"text":" ","type":"text"},{"text":"UIKit, or UIKit hosts SwiftUI, the trait and SwiftUI’s ","type":"text"},{"type":"codeVoice","code":"\\.tracker"},{"text":" are one value.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}]},{"text":"API","type":"heading","anchor":"API","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where the module is empty, so its symbols have no pages"},{"type":"text","text":" "},{"type":"text","text":"of their own here. Their doc comments are in the sources, and Xcode shows them for an iOS target."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"TrackerTrait","type":"codeVoice"},{"type":"text","text":": the trait holding the tracker. Until one is set, it holds a stand-in that"},{"type":"text","text":" "},{"type":"text","text":"resolves when it tracks: to the bootstrapped tracker, or, with none, to a drop and a warning."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"UITraitCollection.tracker"},{"type":"text","text":": reads the trait."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UIMutableTraits.tracker"},{"type":"text","text":": sets the trait on a window scene’s, view controller’s or view’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"traitOverrides"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"UIControl.track(_:for:)"},{"text":": tracks an event each time the control sends the given control events.","type":"text"}],"type":"paragraph"}]}]}]}],"abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/uikittracking"]}],"references":{"doc://UIKitTracking/documentation/UIKitTracking":{"url":"\/documentation\/uikittracking","kind":"symbol","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","type":"topic","title":"UIKitTracking","abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"role":"collection"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"title":"SwiftUITracking","titleInlineContent":[{"type":"codeVoice","code":"SwiftUITracking"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"link"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"title":"AppKitTracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"link","titleInlineContent":[{"type":"codeVoice","code":"AppKitTracking"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","titleInlineContent":[{"text":"Tracking from SwiftUI, UIKit and AppKit","type":"text"}