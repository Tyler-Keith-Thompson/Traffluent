{"abstract":[{"text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do.","type":"text"}],"metadata":{"roleHeading":"Framework","role":"collection","modules":[{"name":"UIKitTracking"}],"symbolKind":"module","externalID":"UIKitTracking","title":"UIKitTracking"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this module to track events from UIKit views, view controllers and controls on iOS, iPadOS,"},{"type":"text","text":" "},{"type":"text","text":"tvOS, visionOS and Mac Catalyst; elsewhere it builds empty, and on macOS and watchOS its API isn’t"},{"type":"text","text":" "},{"type":"text","text":"there. SwiftUI views use"},{"type":"text","text":" "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and AppKit views on macOS use"},{"type":"text","text":" "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tracker is a UIKit trait, "},{"type":"codeVoice","code":"TrackerTrait"},{"type":"text","text":". Set it on a window scene’s "},{"type":"codeVoice","code":"traitOverrides"},{"type":"text","text":" as the"},{"type":"text","text":" "},{"type":"text","text":"scene connects, and every view controller and view in the scene’s windows inherits it, the way"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI views inherit their environment. Read it in any of them as "},{"type":"codeVoice","code":"traitCollection.tracker"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"view controller or view can set its own for everything below it, and each scene keeps its own, so"},{"type":"text","text":" "},{"type":"text","text":"two windows can track through two trackers. Until a tracker is set, the trait’s tracker tracks"},{"type":"text","text":" "},{"type":"text","text":"through the one "},{"type":"codeVoice","code":"Tracker.bootstrap"},{"type":"text","text":" made the process’s default, and with none it drops each event,"},{"type":"text","text":" "},{"type":"text","text":"warning once per call site."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"UIControl.track(_:for:)"},{"text":" tracks an event each time a control sends the given control events","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":".primaryActionTriggered"},{"text":" by default), through the tracker the control’s traits hold at that","type":"text"},{"text":" ","type":"text"},{"text":"moment:","type":"text"}],"type":"paragraph"},{"code":["import Traffluent","import UIKit","","@Event","struct ShareTapped {}","","@Event","struct CheckoutStarted {","    var cartSize: Int","}","","final class CartViewController: UIViewController {","    let share = UIButton(configuration: .filled())","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        share.track(ShareTapped())  \/\/ through the tracker the button's traits hold when it is tapped","        checkOut.addTarget(self, action: #selector(checkOut(_:)), for: .primaryActionTriggered)","        view.addSubview(share)","        view.addSubview(checkOut)","    }","","    @objc func checkOut(_ sender: UIButton) {","        sender.traitCollection.tracker.track(CheckoutStarted(cartSize: 3))","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:):","windowScene.traitOverrides.tracker = tracker"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"track(_:for:)","type":"codeVoice"},{"type":"text","text":" adds a "},{"code":"UIAction","type":"codeVoice"},{"type":"text","text":" beside the control’s other actions and targets, so they still"},{"type":"text","text":" "},{"type":"text","text":"run, and returns it; pass it to "},{"code":"removeAction(_:for:)","type":"codeVoice"},{"type":"text","text":" to stop tracking. Where SwiftUI hosts"},{"type":"text","text":" "},{"type":"text","text":"UIKit, or UIKit hosts SwiftUI, the trait and SwiftUI’s "},{"code":"\\.tracker","type":"codeVoice"},{"type":"text","text":" are one value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers all three frameworks."}],"type":"paragraph"},{"level":2,"text":"API","anchor":"API","type":"heading"},{"inlineContent":[{"text":"The documentation site is built on Linux, where the module is empty, so its symbols have no pages","type":"text"},{"text":" ","type":"text"},{"text":"of their own here. Their doc comments are in the sources, and Xcode shows them for an iOS target.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"TrackerTrait"},{"text":": the trait holding the tracker. Until one is set, it holds a stand-in that","type":"text"},{"text":" ","type":"text"},{"text":"resolves when it tracks: to the bootstrapped tracker, or, with none, to a drop and a warning.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UITraitCollection.tracker","type":"codeVoice"},{"text":": reads the trait.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UIMutableTraits.tracker","type":"codeVoice"},{"text":": sets the trait on a window scene’s, view controller’s or view’s","type":"text"},{"text":" ","type":"text"},{"code":"traitOverrides","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UIControl.track(_:for:)"},{"type":"text","text":": tracks an event each time the control sends the given control events."}]}]}],"type":"unorderedList"}]}],"identifier":{"url":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/uikittracking"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://UIKitTracking/documentation/UIKitTracking":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Hand UIKit views and view controllers their tracker as a trait, and track what controls do."}],"url":"\/documentation\/uikittracking","title":"UIKitTracking","role":"collection","identifier":"doc:\/\/UIKitTracking\/documentation\/UIKitTracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","title":"AppKitTracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"link","titleInlineContent":[{"type":"codeVoice","code":"AppKitTracking"}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"type":"link","title":"SwiftUITracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","titleInlineContent":[{"type":"codeVoice","code":"SwiftUITracking"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/trackingfromviews":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","title":"Tracking from SwiftUI, UIKit and AppKit","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/trackingfromviews","titleInlineContent":[{"text":"Tracking from SwiftUI, UIKit and AppKit","type":"text"}]}}}