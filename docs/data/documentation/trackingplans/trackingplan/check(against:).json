:"text","text":" "},{"type":"text","text":"version the committed index lists beside a later one of the same event, and this plan"},{"type":"text","text":" "},{"type":"text","text":"doesn’t list, is one "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)"},{"type":"text","text":" keeps as it is: it is compared by its bytes alone, and"},{"type":"text","text":" "},{"type":"text","text":"an earlier version never committed is no difference, as no export can recreate it. Only when that"},{"type":"text","text":" "},{"type":"text","text":"finds no difference are the bytes compared, each file that differs, is missing or is no"},{"type":"text","text":" "},{"type":"text","text":"longer part of the plan reported as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference\/fileOutOfDate(path:)"},{"type":"text","text":", so a"},{"type":"text","text":" "},{"type":"text","text":"match means the committed plan is exactly what "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)"},{"type":"text","text":" of it holds. Files of "},{"type":"codeVoice","code":"committed"},{"type":"text","text":" that a plan doesn’t"},{"type":"text","text":" "},{"type":"text","text":"write, any but "},{"type":"codeVoice","code":"tracking-plan.json"},{"type":"text","text":", "},{"type":"codeVoice","code":".schema.json"},{"type":"text","text":" and "},{"type":"codeVoice","code":".example.json"},{"type":"text","text":" files, are ignored."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" log "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") in the size of the two plans."}]}],"style":"note","n