":"text","text":" "},{"type":"text","text":"no longer declares: each with its schema there, marked "},{"code":"deprecated: true","type":"codeVoice"},{"type":"text","text":". The documents in"},{"type":"text","text":" "},{"code":"committed","type":"codeVoice"},{"type":"text","text":" of an event’s earlier versions, below the newest the plan lists, are kept too,"},{"type":"text","text":" "},{"type":"text","text":"with their examples, byte for byte, and listed in the index."}],"kind":"symbol","url":"\/documentation\/trackingplans\/trackingplan\/files(carryingforward:)","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","title":"files(carryingForward:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"files","kind":"identifier"},{"text":"(","kind":"text"},{"text":"carryingForward","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":".","kind":"text"},{"text":"File","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"text":"]) -> [","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":".","kind":"text"},{"text":"File","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV"},{"text":"]","kind":"text"}]},"doc://TrackingPlans/documentation/TrackingPlans":{"url":"\/documentation\/trackingplans","title":"TrackingPlans","type":"topic","abstract":[{"type":"text","text":"Export every event an app tracks as JSON Schema that people and services outside the app can read, and check each change against the plan committed before it."}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans","role":"collection","kind":"symbol"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCheck/description":{"type":"topic","url":"\/documentation\/trackingplans\/trackingpl