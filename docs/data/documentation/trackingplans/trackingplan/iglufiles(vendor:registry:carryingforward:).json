,"preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"File","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/File","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The Iglu vendor of the app’s schemas, in reverse domain notation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"com.acme","type":"codeVoice"},{"text":"), which the app’s Snowplow destination is given too.","type":"text"}],"type":"paragraph"}],"name":"vendor"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The kind of registry the files are published to."}]}],"name":"registry"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The files of the registry exported before, with their paths from its root"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"schemas\/…","type":"codeVoice"},{"type":"text","text":"). A file that isn’t an Iglu version "},{"code":"N-0-k","type":"codeVoice"},{"type":"text","text":" of one of the plan’s events at"},{"type":"text","text":" "},{"type":"text","text":"the version N the plan lists is ignored."}]}],"name":"committed"}],"kind":"parameters"},{"content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"inlineContent":[{"type":"text","text":"One file per event of the plan, in the order of "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/schemas","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each file is at "},{"code":"schemas\/<vendor>\/<name>\/jsonschema\/<SchemaVer>","type":"codeVoice"},{"type":"text","text":", the layout of an Iglu"},{"type":"text","text":" "},{"type":"text","text":"static repository, which "},{"code":"igluctl","type":"codeVoice"},{"type":"text","text":" publishes and Iglu Server takes. It holds the event’s"},{"type":"text","text":" "},{"type":"text","text":"document as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files"},{"type":"text","text":" writes it, as a self-describing schema: "},{"code":"$schema","type":"codeVoice"},{"type":"text","text":" is Iglu’s"},{"type":"text","text":" "},{"type":"text","text":"self-describing meta-schema, "},{"code":"self","type":"codeVoice"},{"type":"text","text":" names the vendor, the event’s name, the format"},{"type":"text","text":" "},{"code":"jsonschema","type":"codeVoice"},{"type":"text","text":" and the version, and "},{"code":"$id","type":"codeVoice"},{"type":"text","text":", a file name of the plan’s, is left out."}]},{"type":"paragraph","inlineContent":[{"text":"Version N of an event is SchemaVer ","type":"text"},{"code":"N-0-0","type":"codeVoice"},{"text":", the version every event of it names: each","type":"text"},{"text":" ","type":"text"},{"text":"version of an event is a breaking change, a SchemaVer MODEL. The newest version of the event","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"committed","type":"codeVoice"},{"text":", ","type":"text"},{"code":"N-0-k","type":"codeVoice"},{"text":", is compared with the event by what the two mean, as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)","type":"reference"},{"text":" compares a plan, not by their bytes:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"When nothing differs, the file returned is the committed one, byte for byte, however it","type":"text"},{"text":" ","type":"text"},{"text":"is formatted.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When a difference is breaking (","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference\/isBreaking","isActive":true,"type":"reference"},{"text":"), the export throws","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/breakingChange(event:version:)","isActive":true,"type":"reference"},{"text":": a payload the published schema accepts","type":"text"},{"text":" ","type":"text"},{"text":"could fail the new one, which Iglu publishes only as a new MODEL, so raise the event’s","type":"text"},{"text":" ","type":"text"},{"text":"version.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When every difference is compatible (an optional or defaulted property added, a property"},{"type":"text","text":" "},{"type":"text","text":"removed, a constraint loosened), it is an ADDITION. For "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluRegistry\/server","isActive":true},{"type":"text","text":" the file"},{"type":"text","text":" "},{"type":"text","text":"returned is "},{"type":"codeVoice","code":"N-0-(k+1)"},{"type":"text","text":", which lists every earlier "},{"type":"codeVoice","code":"N-0-*"},{"type":"text","text":" in "},{"type":"codeVoice","code":"$supersedes"},{"type":"text","text":", so Snowplow"},{"type":"text","text":" "},{"type":"text","text":"validates events naming "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":" against it; it keeps the properties of "},{"type":"codeVoice","code":"N-0-k"},{"type":"text","text":" the event"},{"type":"text","text":" "},{"type":"text","text":"no longer declares, marked "},{"type":"codeVoice","code":"deprecated"},{"type":"text","text":" and not required, as "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"keeps them. A static repository doesn’t supersede, so for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluRegistry\/staticRepository","isActive":true},{"type":"text","text":" the export throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/additionNeedsNewVersion(event:version:)","isActive":true},{"type":"text","text":" instead."}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/invalidVendor","isActive":true},{"text":" for a vendor that isn’t one;","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/invalidSchemaKey(event:version:)","isActive":true},{"text":" for an event whose name Iglu doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"take or whose version is below 1; ","type":"text"},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/allOf(event:version:)","isActive":true},{"text":" for a property","type":"text"},{"text":" ","type":"text"},{"text":"of more than one pattern; ","type":"text"},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/breakingChange(event:version:)","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/additionNeedsNewVersion(event:version:)","isActive":true},{"text":" as above; and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/fileSystem(_:)","isActive":true},{"text":" with ","type":"text"},{"type":"codeVoice","code":"CocoaError.fileReadCorruptFile"},{"text":" for a newest","type":"text"},{"text":" ","type":"text"},{"text":"committed version that isn’t a schema the plan wrote.","type":"text"}]}],"type":"aside","name":"Throws"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") in the size of the plan and the registry.","type":"text"}]}],"type":"aside","name":"Complexity"}],"kind":"content"}],"abstract":[{"type":"text","text":"The plan’s events as the schemas of an Iglu registry of the kind "},{"type":"codeVoice","code":"registry"},{"type":"text","text":" under "},{"type":"codeVoice","code":"vendor"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"one file per event and version: the newest Iglu version of each in "},{"type":"codeVoice","code":"committed"},{"type":"text","text":" while it"},{"type":"text","text":" "},{"type":"text","text":"still describes the event, or the one to publish next."}],"identifier":{"url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/igluFiles(vendor:registry:carryingForward:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackingplans\/trackingplan\/iglufiles(vendor:registry:carryingforward:)"]}],"references":{"doc://TrackingPlans/documentation/TrackingPlans/IgluExportError/fileSystem(_:)":{"url":"\/documentation\/trackingplans\/igluexporterror\/filesystem(_:)","type":"topic","abstract":[{"text":"A file of the registry couldn’t be read, written, or its directory made, or one already","type":"text"},{"text":" ","type":"text"},{"text":"there isn