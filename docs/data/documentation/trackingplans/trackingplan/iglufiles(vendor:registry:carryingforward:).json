{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/igluFiles(vendor:registry:carryingForward:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackingplans\/trackingplan\/iglufiles(vendor:registry:carryingforward:)"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"igluFiles"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vendor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"registry"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluRegistry","preciseIdentifier":"s:13TrackingPlans12IgluRegistryO","text":"IgluRegistry"},{"kind":"text","text":", "},{"kind":"externalParam","text":"carryingForward"},{"kind":"text","text":" "},{"kind":"internalParam","text":"committed"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/File","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV","text":"File"},{"kind":"text","text":"]) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError","preciseIdentifier":"s:13TrackingPlans15IgluExportErrorO","text":"IgluExportError"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/File","preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV","text":"File"},{"kind":"text","text":"]"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The Iglu vendor of the app’s schemas, in reverse domain notation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"com.acme"},{"text":"), which the app’s Snowplow destination is given too.","type":"text"}]}],"name":"vendor"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The kind of registry the files are published to."}]}],"name":"registry"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The files of the registry exported before, with their paths from its root","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"schemas\/…"},{"text":"). A file that isn’t an Iglu version ","type":"text"},{"type":"codeVoice","code":"N-0-k"},{"text":" of one of the plan’s events at","type":"text"},{"text":" ","type":"text"},{"text":"the version N the plan lists is ignored.","type":"text"}]}],"name":"committed"}]},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"One file per event of the plan, in the order of ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/schemas","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Each file is at "},{"type":"codeVoice","code":"schemas\/<vendor>\/<name>\/jsonschema\/<SchemaVer>"},{"type":"text","text":", the layout of an Iglu"},{"type":"text","text":" "},{"type":"text","text":"static repository, which "},{"type":"codeVoice","code":"igluctl"},{"type":"text","text":" publishes and Iglu Server takes. It holds the event’s"},{"type":"text","text":" "},{"type":"text","text":"document as "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files","isActive":true},{"type":"text","text":" writes it, as a self-describing schema: "},{"type":"codeVoice","code":"$schema"},{"type":"text","text":" is Iglu’s"},{"type":"text","text":" "},{"type":"text","text":"self-describing meta-schema, "},{"type":"codeVoice","code":"self"},{"type":"text","text":" names the vendor, the event’s name, the format"},{"type":"text","text":" "},{"type":"codeVoice","code":"jsonschema"},{"type":"text","text":" and the version, and "},{"type":"codeVoice","code":"$id"},{"type":"text","text":", a file name of the plan’s, is left out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Version N of an event is SchemaVer "},{"code":"N-0-0","type":"codeVoice"},{"type":"text","text":", the version every event of it names: each"},{"type":"text","text":" "},{"type":"text","text":"version of an event is a breaking change, a SchemaVer MODEL. The newest version of the event"},{"type":"text","text":" "},{"type":"text","text":"in "},{"code":"committed","type":"codeVoice"},{"type":"text","text":", "},{"code":"N-0-k","type":"codeVoice"},{"type":"text","text":", is compared with the event by what the two mean, as"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)","type":"reference"},{"type":"text","text":" compares a plan, not by their bytes:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When nothing differs, the file returned is the committed one, byte for byte, however it"},{"type":"text","text":" "},{"type":"text","text":"is formatted."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When a difference is breaking ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanDifference\/isBreaking"},{"type":"text","text":"), the export throws"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/breakingChange(event:version:)"},{"type":"text","text":": a payload the published schema accepts"},{"type":"text","text":" "},{"type":"text","text":"could fail the new one, which Iglu publishes only as a new MODEL, so raise the event’s"},{"type":"text","text":" "},{"type":"text","text":"version."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When every difference is compatible (an optional or defaulted property added, a property"},{"type":"text","text":" "},{"type":"text","text":"removed, a constraint loosened), it is an ADDITION. For "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluRegistry\/server","isActive":true},{"type":"text","text":" the file"},{"type":"text","text":" "},{"type":"text","text":"returned is "},{"type":"codeVoice","code":"N-0-(k+1)"},{"type":"text","text":", which lists every earlier "},{"type":"codeVoice","code":"N-0-*"},{"type":"text","text":" in "},{"type":"codeVoice","code":"$supersedes"},{"type":"text","text":", so Snowplow"},{"type":"text","text":" "},{"type":"text","text":"validates events naming "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":" against it; it keeps the properties of "},{"type":"codeVoice","code":"N-0-k"},{"type":"text","text":" the event"},{"type":"text","text":" "},{"type":"text","text":"no longer declares, marked "},{"type":"codeVoice","code":"deprecated"},{"type":"text","text":" and not required, as "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/files(carryingForward:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"keeps them. A static repository doesn’t supersede, so for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluRegistry\/staticRepository","isActive":true},{"type":"text","text":" the export throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/additionNeedsNewVersion(event:version:)","isActive":true},{"type":"text","text":" instead."}]}]}]},{"type":"aside","style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/invalidVendor","isActive":true,"type":"reference"},{"type":"text","text":" for a vendor that isn’t one;"},{"type":"text","text":" "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/invalidSchemaKey(event:version:)","isActive":true,"type":"reference"},{"type":"text","text":" for an event whose name Iglu doesn’t"},{"type":"text","text":" "},{"type":"text","text":"take or whose version is below 1; "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/allOf(event:version:)","isActive":true,"type":"reference"},{"type":"text","text":" for a property"},{"type":"text","text":" "},{"type":"text","text":"of more than one pattern; "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/breakingChange(event:version:)","isActive":true,"type":"reference"},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/additionNeedsNewVersion(event:version:)","isActive":true,"type":"reference"},{"type":"text","text":" as above; and"},{"type":"text","text":" "},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError\/fileSystem(_:)","isActive":true,"type":"reference"},{"type":"text","text":" with "},{"code":"CocoaError.fileReadCorruptFile","type":"codeVoice"},{"type":"text","text":" for a newest"},{"type":"text","text":" "},{"type":"text","text":"committed version that isn’t a schema the plan wrote."}]}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") in the size of the plan and the registry.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"The plan’s events as the schemas of an Iglu registry of the kind "},{"type":"codeVoice","code":"registry"},{"type":"text","text":" under "},{"type":"codeVoice","code":"vendor"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"one file per event and version: the newest Iglu version of each in "},{"type":"codeVoice","code":"committed"},{"type":"text","text":" while it"},{"type":"text","text":" "},{"type":"text","text":"still describes the event, or the one to publish next."}],"seeAlsoSections":[{"anchor":"Exporting-an-Iglu-registry","identifiers":["doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/writeIgluRegistry(to:vendor:registry:)","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluRegistry","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/IgluExportError"],"title":"Exporting an Iglu registry","generated":true}],"hierarchy":{"paths":[["doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan"]]},"metadata":{"modules":[{"name":"TrackingPlans"}],"externalID":"s:13TrackingPlans0A4PlanV9igluFiles6vendor8registry15carryingForwardSayAC4FileVGSS_AA12IgluRegistryOA