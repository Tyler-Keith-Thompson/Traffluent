{"abstract":[{"type":"text","text":"Writes or checks "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan"},{"type":"text","text":" as the command’s arguments say, and exits."}],"hierarchy":{"paths":[["doc:\/\/TrackingPlans\/documentation\/TrackingPlans","doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trackingplans\/trackingplancommand\/main()"]}],"identifier":{"url":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/main()","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"main","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Given one argument, a directory, it writes the plan there, as ","type":"text"},{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"does: it exits with status 0 once the plan is written, and 73 (","type":"text"},{"code":"EX_CANTCREAT","type":"codeVoice"},{"text":") when a file","type":"text"},{"text":" ","type":"text"},{"text":"can’t be written.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Given ","type":"text"},{"code":"check","type":"codeVoice"},{"text":" and a directory, it compares the plan with the one committed there, as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","type":"reference"},{"text":" does, printing the check’s report when they","type":"text"},{"text":" ","type":"text"},{"text":"differ: it exits with status 0 when they match, 1 when a difference is breaking, and 2 when","type":"text"},{"text":" ","type":"text"},{"text":"the committed plan is only out of date.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"check --breaking-only"},{"type":"text","text":" and a directory, it compares them the same way but fails only"},{"type":"text","text":" "},{"type":"text","text":"when a difference is breaking: it exits with status 1 then, printing the report, and 0 when"},{"type":"text","text":" "},{"type":"text","text":"they match or the plan there is only out of date. It prints the differences of an"},{"type":"text","text":" "},{"type":"text","text":"out-of-date plan to standard output, as information."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Given "},{"type":"codeVoice","code":"iglu"},{"type":"text","text":", a vendor, the kind of registry ("},{"type":"codeVoice","code":"server"},{"type":"text","text":" for Iglu Server, "},{"type":"codeVoice","code":"static"},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"static repository) and a directory, it writes the plan’s events there as the schemas of an"},{"type":"text","text":" "},{"type":"text","text":"Iglu registry under that vendor, as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/writeIgluRegistry(to:vendor:registry:)"},{"type":"text","text":" "},{"type":"text","text":"does: it exits with status 0 once they are written, 64 ("},{"type":"codeVoice","code":"EX_USAGE"},{"type":"text","text":") for a vendor Iglu"},{"type":"text","text":" "},{"type":"text","text":"doesn’t take, 65 ("},{"type":"codeVoice","code":"EX_DATAERR"},{"type":"text","text":") for an event the registry can’t hold (a name Iglu doesn’t"},{"type":"text","text":" "},{"type":"text","text":"take, a keyword Snowplow doesn’t support, a breaking change at a published version, or, for"},{"type":"text","text":" "},{"type":"text","text":"a static repository, any change at one), and 73 when a file can’t be read or written."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Given anything else, it exits with status 64 ("},{"type":"codeVoice","code":"EX_USAGE"},{"type":"text","text":"): "},{"type":"codeVoice","code":"check"},{"type":"text","text":" alone (write to "},{"type":"codeVoice","code":".\/check"},{"type":"text","text":" "},{"type":"text","text":"for a directory of that name), "},{"type":"codeVoice","code":"check --breaking-only"},{"type":"text","text":" alone, the flag in any other place,"},{"type":"text","text":" "},{"type":"codeVoice","code":"iglu"},{"type":"text","text":" without a vendor, a kind and a directory, a kind other than "},{"type":"codeVoice","code":"server"},{"type":"text","text":" or "},{"type":"codeVoice","code":"static"},{"type":"text","text":", or a"},{"type":"text","text":" "},{"type":"text","text":"directory or vendor whose name starts with "},{"type":"codeVoice","code":"-"},{"type":"text","text":", as a mistyped option would (write "},{"type":"codeVoice","code":".\/-name"},{"type":"text","text":" "},{"type":"text","text":"for a directory). When "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan","isActive":true},{"type":"text","text":" throws, it exits with status 65 ("},{"type":"codeVoice","code":"EX_DATAERR"},{"type":"text","text":"). Every"},{"type":"text","text":" "},{"type":"text","text":"failure is printed to standard error."}],"type":"paragraph"}]}],"sections":[],"kind":"symbol","metadata":{"title":"main()","externalID":"s:13TrackingPlans0A11PlanCommandPAAE4mainyyFZ","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TrackingPlans\/TrackingPlanCommand.swift#L75","fileName":"TrackingPlanCommand.swift"},"roleHeading":"Type Method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"main"},{"kind":"text","text":"()"}],"modules":[{"name":"TrackingPlans"}],"symbolKind":"method","role":"symbol","extendedModule":"TrackingPlans"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCommand/trackingPlan":{"url":"\/documentation\/trackingplans\/trackingplancommand\/trackingplan","type":"topic","required":true,"abstract":[{"type":"text","text":"The plan the command writes."}],"kind":"symbol","title":"trackingPlan","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trackingPlan","kind":"identifier"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand\/trackingPlan"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(againstDirectory:)":{"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"check","kind":"identifier"},{"text":"(","kind":"text"},{"text":"againstDirectory","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials3URLV"},{"text":") -> ","kind":"text"},{"text":"TrackingPlanCheck","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO"}],"url":"\/documentation\/trackingplans\/trackingplan\/check(againstdirectory:)","title":"check(againstDirectory:)","abstract":[{"text":"Compares the plan with the one committed in ","type":"text"},{"cod