ded."}],"title":"writeIgluRegistry(to:vendor:registry:)"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlan/check(against:)":{"abstract":[{"type":"text","text":"Compares the plan with "},{"type":"codeVoice","code":"committed"},{"type":"text","text":", the files of a plan exported before, and reports every"},{"type":"text","text":" "},{"type":"text","text":"difference."}],"role":"symbol","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(against:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"check","kind":"identifier"},{"text":"(","kind":"text"},{"text":"against","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV","text":"TrackingPlan","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A4PlanV4FileV","text":"File","kind":"typeIdentifier"},{"text":"]) -> ","kind":"text"},{"preciseIdentifier":"s:13TrackingPlans0A9PlanCheckO","text":"TrackingPlanCheck","kind":"typeIdentifier"}],"url":"\/documentation\/trackingplans\/trackingplan\/check(against:)","title":"check(against:)","type":"topic"},"doc://TrackingPlans/documentation/TrackingPlans/TrackingPlanCommand":{"navigatorTitle":[{"text":"TrackingPlanCommand","kind":"identifier"}],"abstract":[{"text":"An executable that writes a tracking plan: the type marked ","type":"text"},{"code":"@main","type":"codeVoice"},{"text":" in a target of the app’s","type":"text"},{"text":" ","type":"text"},{"text":"package that links the modules declaring its events.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrackingPlanCommand","kind":"identifier"}],"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlanCommand","type":"topic","role":"symbol","url":"\/documentation\/trackingplans\/trackingplancommand","kind":"symbol","title":"TrackingPlanCommand"},"doc://TrackingPlans/d