o-space indentation, a trailing newline and no","type":"text"},{"text":" ","type":"text"},{"text":"timestamps.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each event’s document is named ","type":"text"},{"type":"codeVoice","code":"<name>.v<version>.schema.json"},{"text":", its name with every byte but","type":"text"},{"text":" ","type":"text"},{"text":"ASCII letters, digits, ","type":"text"},{"type":"codeVoice","code":"_"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"-"},{"text":" percent-encoded (","type":"text"},{"type":"codeVoice","code":"Box<String>"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Box%3CString%3E"},{"text":"). The","type":"text"},{"text":" ","type":"text"},{"text":"document describes the event’s properties as a JSON object:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$schema"},{"type":"text","text":" is draft 2020-12’s, and "},{"type":"codeVoice","code":"$id"},{"type":"text","text":" the document’s file name, so the index’s references"},{"type":"text","text":" "},{"type":"text","text":"to it resolve against the directory the plan is written to."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"title"},{"text":" is the event’s name, ","type":"text"},{"type":"codeVoice","code":"type"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"object"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"additionalProperties"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"properties","type":"codeVoice"},{"text":" holds each stored property’s schema, and ","type":"text"},{"code":"required","type":"codeVoice"},{"text":" the names of the properties","type":"text"},{"text":" ","type":"text"},{"text":"that are neither optional, nor have a default value, nor are ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":", in declaration","type":"text"},{"text":" ","type":"text"},{"text":"order: those every release’s payloads hold, whichever destination sent them. A property with","type":"text"},{"text":" ","type":"text"},{"text":"a default value is marked ","type":"text"},{"code":"x-traffluent-default: true","type":"codeVoice"},{"text":", as a reader of a stored payload","type":"text"},{"text":" ","type":"text"},{"text":"without it reads the default. A ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" property is never required, as a destination","type":"text"},{"text":" ","type":"text"},{"text":"that redacts it (","type":"text"},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"text":") leaves it out.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A property the event declared at this version and no longer does stays in "},{"type":"codeVoice","code":"properties"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"the schema it had and "},{"type":"codeVoice","code":"deprecated: true"},{"type":"text","text":", and out of "},{"type":"codeVoice","code":"required"},{"type":"text","text":": the payloads and records of"},{"type":"text","text":" "},{"type":"text","text":"releases that sent it still hold it, and "},{"type":"codeVoice","code":"additionalProperties"},{"type":"text","text":" would otherwise reject them."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","isActive":true},{"type":"text","text":" carry it forward from the plan already"},{"type":"text","text":" "},{"type":"text","text":"exported, as "},{"type":"reference","identifier":"doc:\/\/TrackingPlan