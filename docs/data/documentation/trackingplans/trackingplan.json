ce","code":"Array<T>"},{"type":"text","text":") an"},{"type":"text","text":" "},{"type":"codeVoice","code":"array"},{"type":"text","text":" whose "},{"type":"codeVoice","code":"items"},{"type":"text","text":" are "},{"type":"codeVoice","code":"T"},{"type":"text","text":"‘s schema. An optional type ("},{"type":"codeVoice","code":"T?"},{"type":"text","text":", "},{"type":"codeVoice","code":"T!"},{"type":"text","text":", "},{"type":"codeVoice","code":"Optional<T>"},{"type":"text","text":") adds "},{"type":"codeVoice","code":"null"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"T"},{"type":"text","text":"‘s "},{"type":"codeVoice","code":"type"},{"type":"text","text":". "},{"type":"codeVoice","code":"Sensitive<T>"},{"type":"text","text":" is "},{"type":"codeVoice","code":"T"},{"type":"text","text":"‘s schema with "},{"type":"codeVoice","code":"x-traffluent-sensitive: true"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"allows "},{"type":"codeVoice","code":"null"},{"type":"text","text":" too as an array’s element, since a redacted element is "},{"type":"codeVoice","code":"null"},{"type":"text","text":"; and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Refined<T, Rule>"},{"type":"text","text":" is "},{"type":"codeVoice","code":"T"},{"type":"text","text":"‘s schema. Each may be qualified by its module ("},{"type":"codeVoice","code":"Swift.Int"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"Foundation.Date"},{"type":"text","text":", "},{"type":"codeVoice","code":"Events.Sensitive"},{"type":"text","text":"). A raw-value enum whose raw value is a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or an"},{"type":"text","text":" "},{"type":"text","text":"integer type, and whose cases are known (its "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventSchema\/Property\/enumeration","isActive":true},{"type":"text","text":"), is"},{"type":"text","text":" "},{"type":"text","text":"its raw value’s schema with its raw values as "},{"type":"codeVoice","code":"enum"},{"type":"text","text":", which holds "},{"type":"codeVoice","code":"null"},{"type":"text","text":" too when the property"},{"type":"text","text":" "},{"type":"text","text":"is optional. Any other type, whose JSON shape the plan can’t know, accepts any value and"},{"type":"text","text":" "},{"type":"text","text":"records the type in "},{"type":"codeVoice","code":"x-traffluent-swift-type"},{"type":"text","text":". That includes an enum declared outside the event"},{"type":"text","text":" "},{"type":"text","text":"that isn’t "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":", and a typealias of an enum."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A property’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/ValidationKeyword"},{"type":"text","text":"s (its "},{"type":"codeVoice","code":"Refined"},{"type":"text","text":" type’s rule’s and those declared"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"@Constrained"},{"type":"text","text":") are added to its schema as the JSON Schema keywords they are: "},{"type":"codeVoice","code":"minLength"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"maxLength"},{"type":"text","text":", "},{"type":"codeVoice","code":"minimum"},{"type":"text","text":", "},{"type":"codeVoice","code":"maximum"},{"type":"text","text":", "},{"type":"codeVoice","code":"minItems"},{"type":"text","text":" and "},{"type":"codeVoice","code":"maxItems"},{"type":"text","text":", each merged with a bound the type"},{"type":"text","text":" "},{"type":"text","text":"has already by keeping the tighter. The first "},{"type":"codeVoice","code":"pattern"},{"type":"text","text":" is "},{"type":"codeVoice","code":"pattern"},{"type":"text","text":", with its example in"},{"type":"text","text":" "},{"type":"codeVoice","code":"examples"},{"type":"text","text":"; any other is a "},{"type":"codeVoice","code":"pattern"},{"type":"text","text":" of its own under "},{"type":"codeVoice","code":"allOf"},{"type":"text","text":". A bound with a fraction is"},{"type":"text","text":" "},{"type":"text","text":"written as a JSON number with one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Beside each document is the event’s example, "},{"code":"<name>.v<version>.example.json","type":"codeVoice"},{"type":"text","text":": a conformance"},{"type":"text","text":" "},{"type":"text","text":"vector, the payload of the event with every property present and set to a fixed value its"},{"type":"text","text":" "},{"type":"text","text":"schema accepts. Another platform’s code can encode the same event and compare. A "},{"code":"string","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"\"example\"","type":"codeVoice"},{"type":"text","text":" (cut to its "},{"code":"maxLength","type":"codeVoice"},{"type":"text","text":", or "},{"code":"x","type":"codeVoice"},{"type":"text","text":" repeated to a "},{"code":"minLength","type":"codeVoice"},{"type":"text","text":" above 7, or its pattern’s"},{"type":"text","text":" "},{"type":"text","text":"example), one of "},{"code":"format","type":"codeVoice"},{"type":"text","text":" "},{"code":"date-time","type":"codeVoice"},{"type":"text","text":" is "},{"code":"\"2001-01-01T00:00:00Z\"","type":"codeVoice"},{"type":"text","text":" and one of "},{"code":"format","type":"codeVoice"},{"type":"text","text":" "},{"code":"uuid","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the nil UUID; a "},{"code":"number","type":"codeVoice"},{"type":"text","text":" or an "},{"code":"integer","type":"codeVoice"},{"type":"text","text":" is 0, or the nearest value its bounds allow; a"},{"type":"text","text":" "},{"code":"boolean","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":"; an "},{"code":"array","type":"codeVoice"},{"type":"text","text":" holds one example of its "},{"code":"items","type":"codeVoice"},{"type":"text","text":", or as many as its"},{"type":"text","text":" "},{"code":"minItems","type":"codeVoice"},{"type":"text","text":" and "},{"code":"maxItems","type":"codeVoice"},{"type":"text","text":" allow; an enum is its first raw value; and a type the plan can’t map"},{"type":"text","text":" "},{"type":"text","text":"is "},{"code":"null","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The index, ","type":"text"},{"code":"tracking-plan.json","type":"codeVoice"},{"text":", lists every event under ","type":"text"},{"code":"events","type":"codeVoice"},{"text":", by name and then version,","type":"text"},{"text":" ","type":"text"},{"text":"with its ","type":"text"},{"code":"name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"consentCategory","type":"codeVoice"},{"text":", ","type":"text"},{"code":"schema","type":"codeVoice"},{"text":", its document’s file name, and","type":"text"},{"text":" ","type":"text"},{"code":"example","type":"codeVoice"},{"text":", its example’s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An event’s earlier versions stay in the plan once exported. "},{"type":"reference","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","isActive":true},{"type":"text","text":" keeps the documents"},{"type":"text","text":" "},{"type":"text","text":"and examples a directory holds of an event at a version below the plan’s, as they are, and the"},{"type":"text","text":" "},{"type":"text","text":"index lists them, since releases still installed send that version and a record doesn’t say"},{"type":"text","text":" "},{"type":"text","text":"which version it is."}],"type":"pa