d","type":"codeVoice"},{"text":" the names of the properties","type":"text"},{"text":" ","type":"text"},{"text":"that are neither optional, nor have a default value, nor are ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":", in declaration","type":"text"},{"text":" ","type":"text"},{"text":"order: those every release’s payloads hold, whichever destination sent them. A property with","type":"text"},{"text":" ","type":"text"},{"text":"a default value is marked ","type":"text"},{"code":"x-traffluent-default: true","type":"codeVoice"},{"text":", as a reader of a stored payload","type":"text"},{"text":" ","type":"text"},{"text":"without it reads the default. A ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" property is never required, as a destination","type":"text"},{"text":" ","type":"text"},{"text":"that redacts it (","type":"text"},{"code":"redactingSensitiveValues()","type":"codeVoice"},{"text":") leaves it out.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"A property the event declared at this version and no longer does stays in ","type":"text"},{"code":"properties","type":"codeVoice"},{"text":", with","type":"text"},{"text":" ","type":"text"},{"text":"the schema it had and ","type":"text"},{"code":"deprecated: true","type":"codeVoice"},{"text":", and out of ","type":"text"},{"code":"required","type":"codeVoice"},{"text":": the payloads and records of","type":"text"},{"text":" ","type":"text"},{"text":"releases that sent it still hold it, and ","type":"text"},{"code":"additionalProperties","type":"codeVoice"},{"text":" would otherwise reject them.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/write(to:)","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan\/check(againstDirectory:)","type":"reference"},{"text":" carry it forward f