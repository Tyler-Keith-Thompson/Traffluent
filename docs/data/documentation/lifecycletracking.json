{"identifier":{"url":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/lifecycletracking"]}],"metadata":{"symbolKind":"module","role":"collection","modules":[{"name":"LifecycleTracking"}],"title":"LifecycleTracking","externalID":"LifecycleTracking","roleHeading":"Framework"},"kind":"symbol","abstract":[{"type":"text","text":"Track the app’s installs, updates, opens, moves to the background and terminations, and make the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s records durable as the app leaves the foreground."}],"topicSections":[{"title":"Tracking the lifecycle","anchor":"Tracking-the-lifecycle","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker\/trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"]},{"title":"Events","anchor":"Events","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated"]},{"title":"Keeping the version","anchor":"Keeping-the-version","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore"]},{"title":"Delivering as the app leaves","anchor":"Delivering-as-the-app-leaves","identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy"]},{"title":"Extended Modules","generated":true,"identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Afluent"],"anchor":"Extended-Modules"}],"sections":[],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Use this module to track the application’s lifecycle on any platform. Nothing is tracked until","type":"text"},{"text":" ","type":"text"},{"text":"the app calls ","type":"text"},{"type":"codeVoice","code":"trackLifecycle"},{"text":" on its tracker as it launches, and keeps the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation","type":"reference","isActive":true},{"text":" it returns; tracking stops when that is cancelled, finished or released.","type":"text"},{"text":" ","type":"text"},{"text":"For the screens and controls inside the app, see","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As it starts, it compares the app’s version (","type":"text"},{"code":"CFBundleShortVersionString","type":"codeVoice"},{"text":" by default, or","type":"text"},{"text":" ","type":"text"},{"code":"version:","type":"codeVoice"},{"text":") with the one its ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore","type":"reference","isActive":true},{"text":" saved at the last launch. No saved version tracks","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","type":"reference","isActive":true},{"text":", a different one ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","type":"reference","isActive":true},{"text":", the same one neither. Then it","type":"text"},{"text":" ","type":"text"},{"text":"tracks ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference","isActive":true},{"text":". After that, from ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":"’s, ","type":"text"},{"code":"WKApplication","type":"codeVoice"},{"text":"’s or","type":"text"},{"text":" ","type":"text"},{"code":"NSApplication","type":"codeVoice"},{"text":"’s notifications, it tracks ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference","isActive":true},{"text":" from","type":"text"},{"text":" ","type":"text"},{"text":"the background and, where the platform reports it, ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","type":"reference","isActive":true},{"text":", each once per","type":"text"},{"text":" ","type":"text"},{"text":"transition. A server or a tool on Linux has no notifications, so it calls","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","type":"reference","isActive":true},{"text":" as it ends:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let tracker = Tracker()","let lifecycle = tracker.trackLifecycle(version: \"2.1\", versionStore: InMemoryVersionStore(version: \"2.0\"))","\/\/ tracks ApplicationUpdated(previousVersion: \"2.0\", version: \"2.1\"), then ApplicationOpened(fromBackground: false)","","\/\/ ... the process's work ...","","await lifecycle.finish()  \/\/ tracks ApplicationTerminated","await tracker.finish()"],"type":"codeListing"},{"inlineContent":[{"text":"The store keeps the version and nothing else. ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","isActive":true,"type":"reference"},{"text":" keeps it in a file, by default","type":"text"},{"text":" ","type":"text"},{"text":"beside a ","type":"text"},{"code":"SegmentStore","type":"codeVoice"},{"text":"’s records; ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/InMemoryVersionStore","isActive":true,"type":"reference"},{"text":" keeps it in memory, for tests; any type","type":"text"},{"text":" ","type":"text"},{"text":"of yours can conform. ","type":"text"},{"code":"kinds:","type":"codeVoice"},{"text":" turns kinds of event off, while the version is still saved.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As the app leaves the foreground, it waits for the tracker’s worker to write every record tracked","type":"text"},{"text":" ","type":"text"},{"text":"so far to the tracker’s store, then calls the store’s ","type":"text"},{"code":"synchronize()","type":"codeVoice"},{"text":". A delivery batched with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","type":"reference","isActive":true},{"text":" (","type":"text"},{"code":".lifecycle","type":"codeVoice"},{"text":") sends what is pending as it reads the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"text":" record. The notification’s handler only hands the transition on; the","type":"text"},{"text":" ","type":"text"},{"text":"work runs on a task of its own, and where the system suspends apps in the background it holds","type":"text"},{"text":" ","type":"text"},{"t