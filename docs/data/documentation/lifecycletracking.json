"type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":"’s, ","type":"text"},{"code":"WKApplication","type":"codeVoice"},{"text":"’s or","type":"text"},{"text":" ","type":"text"},{"code":"NSApplication","type":"codeVoice"},{"text":"’s notifications, it tracks ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","isActive":true,"type":"reference"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"text":"the background and, where the platform reports it, ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true,"type":"reference"},{"text":", each once per","type":"text"},{"text":" ","type":"text"},{"text":"transition. A server or a tool on Linux has no notifications, so it calls","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true,"type":"reference"},{"text":" as it ends:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let tracker = Tracker()","let lifecycle = tracker.trackLifecycle(version: \"2.1\", versionStore: InMemoryVersionStore(version: \"2.0\"))","\/\/ tracks ApplicationUpdated(previousVersion: \"2.0\", version: \"2.1\"), then ApplicationOpened(fromBackground: false)","","\/\/ ... the process's work ...","","await lifecycle.finish()  \/\/ tracks ApplicationTerminated","await tracker.finish()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The store keeps the version and nothing else. "},{"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore","isActive":true},{"type":"text","text":" keeps it in a file, by default"},{"type":"text","text":" "},{"typ