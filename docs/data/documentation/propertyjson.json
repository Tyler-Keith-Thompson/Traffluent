{"identifier":{"url":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON","interfaceLanguage":"swift"},"metadata":{"title":"PropertyJSON","roleHeading":"Framework","symbolKind":"module","modules":[{"name":"PropertyJSON"}],"externalID":"PropertyJSON","role":"collection"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"A vendor destination’s encoder writes each record as the vendor’s JSON. This module has the parts","type":"text"},{"text":" ","type":"text"},{"text":"every such encoder needs, so each vendor module writes only its own format:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader","isActive":true,"type":"reference"},{"type":"text","text":" reads an event’s properties through its schema in a "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"writes a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value only when asked to and the record reveals it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"EventRecord.standardContext","type":"codeVoice"},{"text":" is the standard context (app, device, locale, network, operating","type":"text"},{"text":" ","type":"text"},{"text":"system) as JSON, and ","type":"text"},{"code":"flattened(separator:)","type":"codeVoice"},{"text":" turns nested JSON into one level of dotted keys.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Date.iso8601Timestamp","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Date.millisecondsSince1970()","type":"codeVoice"},{"text":" are the two timestamp formats vendors","type":"text"},{"text":" ","type":"text"},{"text":"take, both rounded down to the millisecond. The ISO 8601 form uses the proleptic Gregorian","type":"text"},{"text":" ","type":"te