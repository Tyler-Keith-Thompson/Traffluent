{"abstract":[{"text":"The vendor-neutral pieces a JSON ","type":"text"},{"type":"codeVoice","code":"BatchEncoder"},{"text":" is built from: properties, context, timestamps, identity and batch splitting.","type":"text"}],"hierarchy":{"paths":[[]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON"},"metadata":{"symbolKind":"module","externalID":"PropertyJSON","role":"collection","title":"PropertyJSON","modules":[{"name":"PropertyJSON"}],"roleHeading":"Framework"},"variants":[{"paths":["\/documentation\/propertyjson"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vendor destination’s encoder writes each record as the vendor’s JSON. This module has the parts"},{"type":"text","text":" "},{"type":"text","text":"every such encoder needs, so each vendor module writes only its own format:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/PropertyReader"},{"type":"text","text":" reads an event’s properties through its schema in a "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"writes a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value only when asked to and the record reveals it."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"EventRecord.standardContext"},{"type":"text","text":" is the standard context (app, device, locale, network, operating"},{"type":"text","text":" "},{"type":"text","text":"system) as JSON, and "},{"type":"codeVoice","code":"flattened(separator:)"},{"type":"text","text":" turns nested JSON into one level of dotted keys."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Date.iso8601Timestamp","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Date.millisecondsSince1970()","type":"codeVoice"},{"text":" are the two timestamp formats vendors","type":"text"},{"text":" ","type":"text"},{"text":"take, both rounded down to the millisecond. The ISO 8601 form uses the proleptic Gregorian","type":"text"},{"text":" ","type":"text"},{"text":"calendar for every date, as the standard does, dates before the reform of 1582 included.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"EventRecord.pseudonymousIdentity","type":"codeVoice"},{"text":" is the record’s session, or the record itself when it has","type":"text"},{"text":" ","type":"text"},{"text":"none, and ","type":"text"},{"code":"EventRecord.deduplicationID","type":"codeVoice"},{"text":" the identifier a vendor drops repeats by.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","isActive":true},{"text":" splits a batch into requests of a ","type":"text"},{"type":"reference","identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/JSONEnvelope","isActive":true},{"text":" within a vendor’s limits on","type":"text"},{"text":" ","type":"text"},{"text":"records and bytes, and leaves out a record that fits in none of them as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(module ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"text":").","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties, context and envelopes are "},{"type":"codeVoice","code":"JSON"},{"type":"text","text":" values, a type from "},{"type":"reference","identifier":"doc:\/\/JSONValues\/documentation\/JSONValues","isActi