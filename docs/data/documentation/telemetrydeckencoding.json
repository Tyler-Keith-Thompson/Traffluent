lock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:21TelemetryDeckEncoding0aB10SetupErrorO","text":"TelemetryDeckSetupError","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","text":"HTTPDestination","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV","text":"URLSessionTransport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:21TelemetryDeckEncoding0aB12BatchEncoderV","text":"TelemetryDeckBatchEncoder","kind":"typeIdentifier"},{"text":">","kind":"text"}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"URLSessionTransport","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Encoding","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"TelemetryDeckBatchEncoder","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"type":"topic","kind":"symbol","abstract":[{"text":"A destination that sends batches to the TelemetryDeck app ","type":"text"},{"type":"codeVoice","code":"appID"},{"text":", in the organization’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"namespace"},{"text":", marking every event as a test event or not as ","type":"text"},{"type":"codeVoice","code":"testMode"},{"text":" says, with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"URLSession.shared"},{"text":", retrying a send that fails for now with the waits of ","type":"text"},{"type":"codeVoice","code":"backoff"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"clock"},{"text":".","type":"text"}],"url":"\/documentation\/telemetrydeckencoding\/httpdestinations\/httpdestination\/telemetrydeck(appid:namespace:testmode:plan:backoff:clock:)","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","title":"telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/HTTPDestinations/HTTPDestination/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)":{"title":"telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"telemetryDeck","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"namespace","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"testMode","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeId