{"sections":[],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Sending-to-TelemetryDeck","title":"Sending to TelemetryDeck","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError"]},{"anchor":"Encoding-batches","title":"Encoding batches","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"]},{"anchor":"Records-left-out","title":"Records left out","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"makes an "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":") for TelemetryDeck in one call. It checks"},{"type":"text","text":" "},{"type":"text","text":"the app ID and your organization’s namespace, then posts to"},{"type":"text","text":" "},{"code":"https:\/\/nom.telemetrydeck.com\/v3\/<namespace>\/","type":"codeVoice"},{"type":"text","text":" with a "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","isActive":true},{"type":"text","text":". Each batch is"},{"type":"text","text":" "},{"type":"text","text":"split to "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","isActive":true},{"type":"text","text":": 100 signals a request, as TelemetryDeck’s"},{"type":"text","text":" "},{"type":"text","text":"SwiftSDK sends them; 333,333 bytes a signal, a third of Ingest API v3’s limit of 1,000,000; and"},{"type":"text","text":" "},{"type":"text","text":"1,000,000 bytes a request, the encoder’s own bound, as TelemetryDeck documents none. A batch with no record the encoder can write, an empty one included, makes"},{"type":"text","text":" "},{"type":"text","text":"no request. The destination retries no response, a 5xx (TelemetryDeck answers 503 while its queue"},{"type":"text","text":" "},{"type":"text","text":"is full), 408 and 429, and drops and reports any other status. No trace context is sent."},{"type":"text","text":" "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" leaves this module out, so import it on its own."}]},{"type":"paragraph","inlineContent":[{"text":"The app ID only says which app a signal belongs to, and TelemetryDeck’s own SDKs ship it inside","type":"text"},{"text":" ","type":"text"},{"text":"every app, so the destination builds on every platform and an app sends to TelemetryDeck directly.","type":"text"}]},{"type":"codeListing","code":["import HTTPDestinations","import TelemetryDeckEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: telemetryDeck)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The factory throws ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError","isActive":true,"type":"reference"},{"text":" for an app ID that is empty or only whitespace,","type":"text"},{"text":" ","type":"text"},{"text":"and for a namespace TelemetryDeck doesn’t take. A namespace holds only ASCII letters, digits, ","type":"text"},{"type":"codeVoice","code":"."},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"_"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"-"},{"text":", and can’t be ","type":"text"},{"type":"codeVoice","code":"w"},{"text":", ","type":"text"},{"type":"codeVoice","code":"."},{"text":" or ","type":"text"},{"type":"codeVoice","code":".."},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"testMode","type":"codeVoice"},{"type":"text","text":" has no default. TelemetryDeck shows test signals only in its Test Mode, apart from your"},{"type":"text","text":" "},{"type":"text","text":"real users, and its SDK picks test mode for debug builds. Pass whatever your app uses to tell its"},{"type":"text","text":" "},{"type":"text","text":"builds apart, such as "},{"code":"true","type":"codeVoice"},{"type":"text","text":" under "},{"code":"#if DEBUG","type":"codeVoice"},{"type":"text","text":" and "},{"code":"false","type":"codeVoice"},{"type":"text","text":" otherwise."}]},{"anchor":"User-counts-are-sessions","type":"heading","level":3,"text":"User counts are sessions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TelemetryDeck counts users by "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":". The destination sends the record’s session, from the"},{"type":"text","text":" "},{"type":"text","text":"sessions enricher, as "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":", hashed the way TelemetryDeck’s SDKs hash a user identifier:"},{"type":"text","text":" "},{"type":"text","text":"SHA-256 of the lowercase UUID, in lowercase hex, with the SDKs’ default, empty salt."},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck salts and hashes "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":" again on its server. The same session is also the"},{"type":"text","text":" "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":", in the clear, so a salt of the app’s own would hide nothing, and the destination takes"},{"type":"text","text":" "},{"type":"text","text":"none. Nothing else identifies a record: no vendor identifier, device identifier or"},{"type":"text","text":" "},{"type":"text","text":"account, and no trace context."}]},{"type":"paragraph","inlineContent":[{"text":"So TelemetryDeck’s user counts are session counts. A person who opens the app three times is three","type":"text"},{"text":" ","type":"text"},{"text":"users, and its retention charts show how long a session lasts, not whether people come back. That","type":"text"},{"text":" ","type":"text"},{"text":"is the library’s default, for privacy. To count devices instead, put","type":"text"},{"text":" ","type":"text"},{"code":"StandardContext","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"VendorIdentifierKey","type":"codeVoice"},{"text":" in the records’ context and send them through a","type":"text"},{"text":" ","type":"text"},{"text":"destination that reads it, or write your own enricher and encoder that send the identifier you","type":"text"},{"text":" ","type":"text"},{"text":"choose. This encoder sends the session alone.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record with no session, from a tracker without the sessions enricher, is its own user: its"},{"type":"text","text":" "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":" is the hash of the record’s identifier, and it has no "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":". A record a store"},{"type":"text","text":" "},{"type":"text","text":"recovered after a relaunch keeps its session, and with it the "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":" and "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":" of its"},{"type":"text","text":" "},{"type":"text","text":"first send. Making up a session"},{"type":"text","text":" "},{"type":"text","text":"would join unrelated records, and skipping the record would lose it."}]},{"anchor":"What-TelemetryDeck-receives","type":"heading","level":3,"text":"What TelemetryDeck receives"},{"type":"paragraph","inlineContent":[{"text":"Each request is a JSON array of signals, one per record. Every signal has:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"appID","type":"codeVoice"},{"type":"text","text":", as given, without surrounding whitespace;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"},{"type":"text","text":", the event’s name;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"clientUser"},{"text":", the hashed session, and ","type":"text"},{"type":"codeVoice","code":"sessionID"},{"text":", the session;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"receivedAt"},{"text":", the record’s timestamp in ISO 8601 with milliseconds, so a signal sent late still","type":"text"},{"text":" ","type":"text"},{"text":"counts at the time it was tracked;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isTestMode"},{"type":"text","text":", "},{"type":"codeVoice","code":"\"true\""},{"type":"text","text":" or "},{"type":"codeVoice","code":"\"false\""},{"type":"text","text":";"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.SDK.name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Traffluent","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s properties are read through the event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is"},{"type":"text","text":" "},{"type":"text","text":"made with, and sit beside these, each keeping its JSON type. TelemetryDeck doesn’t index nested"},{"type":"text","text":" "},{"type":"text","text":"values, so an object or array is flattened into dotted names: a "},{"type":"codeVoice","code":"cart"},{"type":"text","text":" holding "},{"type":"codeVoice","code":"size"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"cart.size"},{"type":"text","text":", and the first element of "},{"type":"codeVoice","code":"tags"},{"type":"text","text":" is "},{"type":"codeVoice","code":"tags.0"},{"type":"text","text":". A "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" property is left out. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals. No "},{"type":"codeVoice","code":"floatValue"},{"type":"text","text":" is sent."}]},{"type":"paragraph","inlineContent":[{"text":"The standard context, when the record has it, becomes TelemetryDeck’s built-in parameters:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Context","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Parameters","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.version"},{"text":", ","type":"text"},{"type":"codeVoice","code":".buildNumber"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".versionAndBuildNumber"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"DeviceKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TelemetryDeck.Device.modelName","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.operatingSystem"},{"type":"text","text":", "},{"type":"codeVoice","code":".platform"},{"type":"text","text":", "},{"type":"codeVoice","code":".systemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":".systemMajorVersion"},{"type":"text","text":" and "},{"type":"codeVoice","code":".systemMajorMinorVersion"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TelemetryDeck.RunContext.locale","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".language","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"TelemetryDeck.UserPreference.region","type":"codeVoice"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"The bundle identifier, the form factor and the network aren’t sent.","type":"text"}]},{"anchor":"Records-left-out","type":"heading","level":3,"text":"Records left out"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"one the plan doesn’t describe, whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", or that holds a value JSON can’t;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one whose event name or parameter name, once flattened, holds anything but ASCII letters, digits,","type":"text"},{"text":" ","type":"text"},{"code":".","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"-","type":"codeVoice"},{"text":", or is empty. TelemetryDeck refuses the whole request for one such name.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one whose event name or parameter name starts with ","type":"text"},{"type":"codeVoice","code":"TelemetryDeck."},{"text":", in any case: TelemetryDeck","type":"text"},{"text":" ","type":"text"},{"text":"reserves that scope for its SDKs’ parameters and its server’s;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one with a parameter named as one of a signal’s own members, ","type":"text"},{"type":"codeVoice","code":"appID"},{"text":", ","type":"text"},{"type":"codeVoice","code":"clientUser"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"receivedAt"},{"text":", ","type":"text"},{"type":"codeVoice","code":"type"},{"text":", ","type":"text"},{"type":"codeVoice","code":"sessionID"},{"text":", ","type":"text"},{"type":"codeVoice","code":"isTestMode"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"floatValue"},{"text":", spelled exactly so: in the flat","type":"text"},{"text":" ","type":"text"},{"text":"signal it would replace the member. A name like one in another case, such as ","type":"text"},{"type":"codeVoice","code":"Type"},{"text":", is sent.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose values flatten to the same name twice;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose timestamp falls outside the years 1 to 9999, which TelemetryDeck can’t parse;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"one whose JSON is over 333,333 bytes. TelemetryDeck refuses the whole request for a signal over"},{"type":"text","text":" "},{"type":"text","text":"1,000,000 bytes as its server writes it, which may be larger than the encoder’s; a third leaves"},{"type":"text","text":" "},{"type":"text","text":"room for the escapes a re-encoder commonly adds."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination reports each as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" whose reason is a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"},{"type":"text","text":". When the destination is made, it logs a notice for each event and"},{"type":"text","text":" "},{"type":"text","text":"property of the plan whose name would be left out."}]},{"anchor":"What-TelemetryDeck-doesnt-report","type":"heading","level":3,"text":"What TelemetryDeck doesn’t report"},{"type":"paragraph","inlineContent":[{"text":"TelemetryDeck answers 200 to any namespace and any app ID it can read, so a typo in either loses","type":"text"},{"text":" ","type":"text"},{"text":"every signal without an error. Check that the first signals show up in the dashboard, in Test Mode","type":"text"},{"text":" ","type":"text"},{"text":"when ","type":"text"},{"type":"codeVoice","code":"testMode"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"TelemetryDeck doesn’t remove duplicates. A record is sent more than once when a request is retried"},{"type":"text","text":" "},{"type":"text","text":"after TelemetryDeck stored it but the answer was lost, when a delivery sends a cancelled batch"},{"type":"text","text":" "},{"type":"text","text":"again, and when a store redelivers records after a relaunch, and TelemetryDeck counts each copy."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers what TelemetryDeck receives, and why, in more detail."}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"externalID":"TelemetryDeckEncoding","modules":[{"name":"TelemetryDeckEncoding"}],"roleHeading":"Framework","title":"TelemetryDeckEncoding","role":"collection","symbolKind":"module"},"kind":"symbol","abstract":[{"text":"Send records to TelemetryDeck as signals, through its Ingest API v3.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding"]}],"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/HTTPDestinations/HTTPDestination/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)":{"kind":"symbol","url":"\/documentation\/telemetrydeckencoding\/httpdestinations\/httpdestination\/telemetrydeck(appid:namespace:testmode:plan:backoff:clock:)","role":"symbol","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","conformance":{"constraints":[{"type":"codeVoice","code":"Transport"},{"type":"text","text":" is "},{"type":"codeVoice","code":"URLSessionTransport"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encoding"},{"type":"text","text":" is "},{"type":"codeVoice","code":"TelemetryDeckBatchEncoder"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"title":"telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","abstract":[{"type":"text","text":"A destination that sends batches to the TelemetryDeck app "},{"type":"codeVoice","code":"appID"},{"type":"text","text":", in the organization’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"namespace"},{"type":"text","text":", marking every event as a test event or not as "},{"type":"codeVoice","code":"testMode"},{"type":"text","text":" says, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"URLSession.shared"},{"type":"text","text":", retrying a send that fails for now with the waits of "},{"type":"codeVoice","code":"backoff"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"clock"},{"type":"text","text":"."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"telemetryDeck","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"namespace","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"testMode","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"TelemetryDeckSetupError","kind":"typeIdentifier","preciseIdentifier":"s:21TelemetryDeckEncoding0aB10SetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"URLSessionTransport","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations19URLSessionTransportV"},{"text":", ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:21TelemetryDeckEncoding0aB12BatchEncoderV"},{"text":">","kind":"text"}],"type":"topic"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/batchLimit":{"kind":"symbol","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/batchlimit","role":"symbol","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","title":"batchLimit","abstract":[{"type":"text","text":"TelemetryDeck’s limits on one request: 100 events and 1,000,000 bytes of body, and 333,333"},{"type":"text","text":" "},{"type":"text","text":"bytes of one event."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"kind":"symbol","url":"\/documentation\/httpdestinations\/batchencoder","role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"title":"BatchEncoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestinatio