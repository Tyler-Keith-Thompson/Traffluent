{"identifier":{"url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"topicSections":[{"title":"Sending to TelemetryDeck","anchor":"Sending-to-TelemetryDeck","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError"]},{"title":"Encoding batches","anchor":"Encoding-batches","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"]},{"title":"Records left out","anchor":"Records-left-out","identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError"]}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","isActive":true},{"text":" ","type":"text"},{"text":"makes an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"text":") for TelemetryDeck in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the app ID and your organization’s namespace, then posts to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"https:\/\/nom.telemetrydeck.com\/v3\/<namespace>\/"},{"text":" with a ","type":"text"},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","isActive":true},{"text":". Each batch is","type":"text"},{"text":" ","type":"text"},{"text":"split to ","type":"text"},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","isActive":true},{"text":": 100 signals a request, as TelemetryDeck’s","type":"text"},{"text":" ","type":"text"},{"text":"SwiftSDK sends them; 333,333 bytes a signal, a third of Ingest API v3’s limit of 1,000,000; and","type":"text"},{"text":" ","type":"text"},{"text":"1,000,000 bytes a request, the encoder’s own bound, as TelemetryDeck documents none. A batch with no record the encoder can write, an empty one included, makes","type":"text"},{"text":" ","type":"text"},{"text":"no request. The destination retries no response, a 5xx (TelemetryDeck answers 503 while its queue","type":"text"},{"text":" ","type":"text"},{"text":"is full), 408 and 429, and drops and reports any other status. No trace context is sent.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves this module out, so import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app ID only says which app a signal belongs to, and TelemetryDeck’s own SDKs ship it inside"},{"type":"text","text":" "},{"type":"text","text":"every app, so the destination builds on every platform and an app sends to TelemetryDeck directly."}]},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","import TelemetryDeckEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: telemetryDeck)"]},{"type":"paragraph","inlineContent":[{"text":"The factory throws ","type":"text"},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckSetupError","isActive":true,"type":"reference"},{"text":" for an app ID that is empty or only whitespace,","type":"text"},{"text":" ","type":"text"},{"text":"and for a namespace TelemetryDeck doesn’t take. A namespace holds only ASCII letters, digits, ","type":"text"},{"code":".","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"_","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"-","type":"codeVoice"},{"text":", and can’t be ","type":"text"},{"code":"w","type":"codeVoice"},{"text":", ","type":"text"},{"code":".","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"..","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"testMode"},{"type":"text","text":" has no default. TelemetryDeck shows test signals only in its Test Mode, apart from your"},{"type":"text","text":" "},{"type":"text","text":"real users, and its SDK picks test mode for debug builds. Pass whatever your app uses to tell its"},{"type":"text","text":" "},{"type":"text","text":"builds apart, such as "},{"type":"codeVoice","code":"true"},{"type":"text","text":" under "},{"type":"codeVoice","code":"#if DEBUG"},{"type":"text","text":" and "},{"type":"codeVoice","code":"false"},{"type":"text","text":" otherwise."}]},{"level":3,"anchor":"User-counts-are-sessions","type":"heading","text":"User counts are sessions"},{"type":"paragraph","inlineContent":[{"text":"TelemetryDeck counts users by ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":". The destination sends the record’s session, from the","type":"text"},{"text":" ","type":"text"},{"text":"sessions enricher, as ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":", hashed the way TelemetryDeck’s SDKs hash a user identifier:","type":"text"},{"text":" ","type":"text"},{"text":"SHA-256 of the lowercase UUID, in lowercase hex, with the SDKs’ default, empty salt.","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck salts and hashes ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" again on its server. The same session is also the","type":"text"},{"text":" ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", in the clear, so a salt of the app’s own would hide nothing, and the destination takes","type":"text"},{"text":" ","type":"text"},{"text":"none. Nothing else identifies a record: no vendor identifier, device identifier or","type":"text"},{"text":" ","type":"text"},{"text":"account, and no trace context.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"So TelemetryDeck’s user counts are session counts. A person who opens the app three times is three","type":"text"},{"text":" ","type":"text"},{"text":"users, and its retention charts show how long a session lasts, not whether people come back. That","type":"text"},{"text":" ","type":"text"},{"text":"is the library’s default, for privacy. To count devices instead, put","type":"text"},{"text":" ","type":"text"},{"code":"StandardContext","type":"codeVoice"},{"text":"‘s ","type":"text"},{"code":"VendorIdentifierKey","type":"codeVoice"},{"text":" in the records’ context and send them through a","type":"text"},{"text":" ","type":"text"},{"text":"destination that reads it, or write your own enricher and encoder that send the identifier you","type":"text"},{"text":" ","type":"text"},{"text":"choose. This encoder sends the session alone.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record with no session, from a tracker without the sessions enricher, is its own user: its"},{"type":"text","text":" "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":" is the hash of the record’s identifier, and it has no "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":". A record a store"},{"type":"text","text":" "},{"type":"text","text":"recovered after a relaunch keeps its session, and with it the "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":" of its"},{"type":"text","text":" "},{"type":"text","text":"first send. Making up a session"},{"type":"text","text":" "},{"type":"text","text":"would join unrelated records, and skipping the record would lose it."}]},{"level":3,"anchor":"What-TelemetryDeck-receives","type":"heading","text":"What TelemetryDeck receives"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each request is a JSON array of signals, one per record. Every signal has:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"appID"},{"text":", as given, without surrounding whitespace;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"type","type":"codeVoice"},{"type":"text","text":", the event’s name;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"clientUser"},{"text":", the hashed session, and ","type":"text"},{"type":"codeVoice","code":"sessionID"},{"text":", the session;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"receivedAt"},{"type":"text","text":", the record’s timestamp in ISO 8601 with milliseconds, so a signal sent late still"},{"type":"text","text":" "},{"type":"text","text":"counts at the time it was tracked;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"isTestMode","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"true\"","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"\"false\"","type":"codeVoice"},{"text":";","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.SDK.name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Traffluent","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The record’s properties are read through the event’s schema in the ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":" the encoder is","type":"text"},{"text":" ","type":"text"},{"text":"made with, and sit beside these, each keeping its JSON type. TelemetryDeck doesn’t index nested","type":"text"},{"text":" ","type":"text"},{"text":"values, so an object or array is flattened into dotted names: a ","type":"text"},{"type":"codeVoice","code":"cart"},{"text":" holding ","type":"text"},{"type":"codeVoice","code":"size"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"cart.size"},{"text":", and the first element of ","type":"text"},{"type":"codeVoice","code":"tags"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"tags.0"},{"text":". A ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" property is left out. A","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value is never sent, whatever the record reveals. No ","type":"text"},{"type":"codeVoice","code":"floatValue"},{"text":" is sent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context, when the record has it, becomes TelemetryDeck’s built-in parameters:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Context"}]}],[{"type":"paragraph","inlineContent":[{"text":"Parameters","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.version"},{"type":"text","text":", "},{"type":"codeVoice","code":".buildNumber"},{"type":"text","text":" and "},{"type":"codeVoice","code":".versionAndBuildNumber"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.modelName"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}]}],[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.Device.operatingSystem","type":"codeVoice"},{"text":", ","type":"text"},{"code":".platform","type":"codeVoice"},{"text":", ","type":"text"},{"code":".systemVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":".systemMajorVersion","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".systemMajorMinorVersion","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"LocaleKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.locale"},{"type":"text","text":" and "},{"type":"codeVoice","code":".language"},{"type":"text","text":", and "},{"type":"codeVoice","code":"TelemetryDeck.UserPreference.region"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The bundle identifier, the form factor and the network aren’t sent."}]},{"level":3,"anchor":"Records-left-out","type":"heading","text":"Records left out"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"one the plan doesn’t describe, whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", or that holds a value JSON can’t;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one whose event name or parameter name, once flattened, holds anything but ASCII letters, digits,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"."},{"text":", ","type":"text"},{"type":"codeVoice","code":"_"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"-"},{"text":", or is empty. TelemetryDeck refuses the whole request for one such name.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose event name or parameter name starts with "},{"code":"TelemetryDeck.","type":"codeVoice"},{"type":"text","text":", in any case: TelemetryDeck"},{"type":"text","text":" "},{"type":"text","text":"reserves that scope for its SDKs’ parameters and its server’s;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one with a parameter named as one of a signal’s own members, ","type":"text"},{"code":"appID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"receivedAt","type":"codeVoice"},{"text":", ","type":"text"},{"code":"type","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isTestMode","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"floatValue","type":"codeVoice"},{"text":", spelled exactly so: in the flat","type":"text"},{"text":" ","type":"text"},{"text":"signal it would replace the member. A name like one in another case, such as ","type":"text"},{"code":"Type","type":"codeVoice"},{"text":", is sent.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose values flatten to the same name twice;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one whose timestamp falls outside the years 1 to 9999, which TelemetryDeck can’t parse;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one whose JSON is over 333,333 bytes. TelemetryDeck refuses the whole request for a signal over","type":"text"},{"text":" ","type":"text"},{"text":"1,000,000 bytes as its server writes it, which may be larger than the encoder’s; a third leaves","type":"text"},{"text":" ","type":"text"},{"text":"room for the escapes a re-encoder commonly adds.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination reports each as "},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" whose reason is a"},{"type":"text","text":" "},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","isActive":true,"type":"reference"},{"type":"text","text":". When the destination is made, it logs a notice for each event and"},{"type":"text","text":" "},{"type":"text","text":"property of the plan whose name would be left out."}]},{"level":3,"anchor":"What-TelemetryDeck-doesnt-report","type":"heading","text":"What TelemetryDeck doesn’t report"},{"type":"paragraph","inlineContent":[{"text":"TelemetryDeck answers 200 to any namespace and any app ID it can read, so a typo in either loses","type":"text"},{"text":" ","type":"text"},{"text":"every signal without an error. Check that the first signals show up in the dashboard, in Test Mode","type":"text"},{"text":" ","type":"text"},{"text":"when ","type":"text"},{"code":"testMode","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"TelemetryDeck doesn’t remove duplicates. A record is sent more than once when a request is retried","type":"text"},{"text":" ","type":"text"},{"text":"after TelemetryDeck stored it but the answer was lost, when a delivery sends a cancelled batch","type":"text"},{"text":" ","type":"text"},{"text":"again, and when a store redelivers records after a relaunch, and TelemetryDeck counts each copy.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"covers what TelemetryDeck receives, and why, in more detail.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/telemetrydeckencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"symbolKind":"module","roleHeading":"Framework","title":"TelemetryDeckEncoding","modules":[{"name":"TelemetryDeckEncoding"}],"externalID":"TelemetryDeckEncoding","role":"collection"},"abstract":[{"type":"text","text":"Send records to TelemetryDeck as signals, through its Ingest API v3."}],"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/HTTPDestinations/HTTPDestination/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)":{"type":"topic","abstract":[{"text":"A destination that sends batches to the TelemetryDeck app ","type":"text"},{"code":"appID","type":"codeVoice"},{"text":", in the organization’s","type":"text"},{"text":" ","type":"text"},{"code":"namespace","type":"codeVoice"},{"text":", marking every event as a test event or not as ","type":"text"},{"code":"testMode","type":"codeVoice"},{"text":" says, through","type":"text"},{"text":" ","type":"text"},{"code":"transport","type":"codeVoice"},{"text":", retrying a send that fails for now with the waits of ","type":"text"},{"code":"backoff","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"clock","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/telemetrydeckencoding\/httpdestinations\/httpdestination\/telemetrydeck(appid:namespace:testmode:plan:transport:backoff:clock:)","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"telemetryDeck","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"namespace","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"testMode","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV"},{"text":", ","kind":"text"},{"text":"transport","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"backoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ExponentialBackoff","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"<","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"TelemetryDeckSetupError","kind":"typeIdentifier","preciseIdentifier":"s:21TelemetryDeckEncoding0aB10SetupErrorO"},{"text":") -> ","kind":"text"},{"text":"HTTPDestination","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV"},{"text":"<","kind":"text"},{"text":"Transport","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"typeIdentifier","preciseIdentifier":"s:21TelemetryDeckEncoding0aB12BatchEncoderV"},{"text":">","kind":"text"}],"title":"telemetryDeck(appID:namespace:testMode:plan:transport:backoff:clock:)","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Transport","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"HTTPTransport","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Encoding","type":"codeVoice"},{"type":"text","text":" is "},{"code":"TelemetryDeckBatchEncoder","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"kind":"symbol"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding":{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","kind":"symbol","type":"topic","title":"TelemetryDeckEncoding","url":"\/documentation\/telemetrydeckencoding","abstract":[{"text":"Send records to TelemetryDeck as signals, through its Ingest API v3.","type":"text"}],"role":"collection"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckEncodingError":{"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckencodingerror","abstract":[{"type":"text","text":"Why "},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s"},{"type":"text","text":" "},{"type":"text","text":"requests as a "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":", and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" reports as a drop. When it can encode no"},{"type":"text","text":" "},{"type":"text","text":"record of a batch, it makes no request, and "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends nothing for the batch."}],"type":"topic","fragments":[{"text":"e