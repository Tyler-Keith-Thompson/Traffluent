333 bytes of an","type":"text"},{"text":" ","type":"text"},{"text":"event are a third of Ingest API v3’s limit: TelemetryDeck refuses a whole request when one","type":"text"},{"text":" ","type":"text"},{"text":"event’s JSON is over 1,000,000 bytes as its server writes it, which may be larger than the","type":"text"},{"text":" ","type":"text"},{"text":"encoder’s, and a third leaves room for the escapes a re-encoder commonly adds, such as ","type":"text"},{"code":"\\u","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and four hex digits for a character outside ASCII, and a space after each ","type":"text"},{"code":":","type":"codeVoice"},{"text":" and ","type":"text"},{"code":",","type":"codeVoice"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"larger event is left out as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"TelemetryDeck documents no limit on a request; its 1,000,000 bytes are the encoder’s own","type":"text"},{"text":" ","type":"text"},{"text":"bound, the most one event may be, which keeps a request to a size a retry can send again.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"]]},"sections":[],"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of TelemetryDeck’s Ingest API v3, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to an organization’s "},{"type":"codeVoice","code":"POST \/v3\/<namespace>\/"},{"type":"text","text":"."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"title":"TelemetryDeckBatchEncoder","role":"symbol","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding":{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding","kind":"symbol","type":"topic","title":"TelemetryDeckEncoding","url":"\/documentation\/telemetrydeckencoding","abstract":[{"text":"Send records to TelemetryDeck as signals, through its Ingest API v3.","type":"text"}],"role":"collection"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckEncodingError/oversized(byteCount:)":{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)","kind":"symbol","title":"TelemetryDeckEncodingError.oversized(byteCount:)","type":"topic","url":"\/documentation\/telemetrydeckencoding\/telemetrydeckencodingerror\/oversized(bytecount:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"oversized"},{"kind":"text","text":"("},{"kind":"externalParam","text":"byteCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"The event’s JSON is "},{"type":"codeVoice","code":"byteCount"},{"type":"text","text":" bytes, more than the encoder’s limit lets one record hold:"},{"type":"text","text":" "},{"type":"text","text":"333,333 bytes by default ("},{"type":"referenc