:"text","text":"The 100 events are what TelemetryDeck’s SwiftSDK sends in a request. The 333,333 bytes of an"},{"type":"text","text":" "},{"type":"text","text":"event are a third of Ingest API v3’s limit: TelemetryDeck refuses a whole request when one"},{"type":"text","text":" "},{"type":"text","text":"event’s JSON is over 1,000,000 bytes as its server writes it, which may be larger than the"},{"type":"text","text":" "},{"type":"text","text":"encoder’s, and a third leaves room for the escapes a re-encoder commonly adds, such as "},{"code":"\\u","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and four hex digits for a character outside ASCII, and a space after each "},{"code":":","type":"codeVoice"},{"type":"text","text":" and "},{"code":",","type":"codeVoice"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"larger event is left out as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError\/oversized(byteCount:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck documents no limit on a request; its 1,000,000 bytes are the encoder’s own"},{"type":"text","text":" "},{"type":"text","text":"bound, the most one event may be, which keeps a request to a size a retry can send again."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder\/batchlimit"]}],"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/batchLimit":{"title":"batchLimit","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"}],"ident