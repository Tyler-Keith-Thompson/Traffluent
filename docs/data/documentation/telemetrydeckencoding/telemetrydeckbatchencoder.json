{"topicSections":[{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/Failure"],"generated":true,"title":"Type Aliases","anchor":"Type-Aliases"},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/transientStatuses"],"generated":true,"title":"Type Properties","anchor":"Type-Properties"},{"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/outcome(of:for:)"],"generated":true,"title":"Type Methods","anchor":"Type-Methods"}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/TelemetryDeckEncoding\/s8SendableP","doc:\/\/TelemetryDeckEncoding\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships"}],"metadata":{"roleHeading":"Structure","externalID":"s:21TelemetryDeckEncoding0aB12BatchEncoderV","modules":[{"name":"TelemetryDeckEncoding"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder.swift#L86","fileName":"TelemetryDeckBatchEncoder.swift"},"title":"TelemetryDeckBatchEncoder","symbolKind":"struct","navigatorTitle":[{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}]},"abstract":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" of TelemetryDeck’s Ingest API v3, so an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" ","type":"text"},{"text":"can send events to an organization’s ","type":"text"},{"type":"codeVoice","code":"POST \/v3\/<namespace>\/"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which fills in the endpoint, this encoder and its limits:"}]},{"syntax":"swift","type":"codeListing","code":["let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)"]},{"type":"paragraph","inlineContent":[{"text":"The body is a JSON array of content type ","type":"text"},{"code":"application\/json","type":"codeVoice"},{"text":", one event per record, oldest","type":"text"},{"text":" ","type":"text"},{"text":"first. Each event is a flat object of these members:","type":"text"}]},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"appID"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The app ID the encoder is made with, without leading or trailing whitespace","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"clientUser","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The SHA256 of the record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" as a lowercase UUID string, as 64 lowercase hexadecimal digits; of the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"isTestMode","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"\"true\"","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"\"false\"","type":"codeVoice"},{"text":", as the encoder is made with","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"receivedAt"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601, in UTC with milliseconds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionID"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; left out when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"type","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event’s ","type":"text"},{"type":"codeVoice","code":"Event\/name"},{"text":", as it is","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.SDK.name","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Traffluent"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Each of the event’s stored properties"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Its value, read through the event’s schema in the plan; a nested value spread into one member per scalar it holds, named after its path, joined by ","type":"text"},{"code":".","type":"codeVoice"},{"text":" (","type":"text"},{"code":"cart.size","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tags.0","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent, hashed as TelemetryDeck’s SDKs hash a user’s"},{"type":"text","text":" "},{"type":"text","text":"identifier with their default, empty salt; TelemetryDeck salts and hashes it again before"},{"type":"text","text":" "},{"type":"text","text":"storing it. No salt of the app’s own is taken: "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":" sends the same session in the"},{"type":"text","text":" "},{"type":"text","text":"clear, so a salt would hide nothing. TelemetryDeck counts a user per "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":", so its users"},{"type":"text","text":" "},{"type":"text","text":"are sessions. A record with no session (one tracked by a tracker without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"is its own user of one event, with no "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":", linked to nothing: TelemetryDeck refuses an"},{"type":"text","text":" "},{"type":"text","text":"event without a "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":". A record a store recovers after a relaunch keeps its session, so"},{"type":"text","text":" "},{"type":"text","text":"it goes out with the "},{"code":"clientUser","type":"codeVoice"},{"type":"text","text":" and "},{"code":"sessionID","type":"codeVoice"},{"type":"text","text":" of its first send. The record’s vendor identifier and trace context, and"},{"type":"text","text":" "},{"type":"text","text":"any other context value, aren’t sent. Nor is a "},{"code":"floatValue","type":"codeVoice"},{"type":"text","text":": a number among the properties"},{"type":"text","text":" "},{"type":"text","text":"keeps its JSON type in Ingest API v3."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive"},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. A "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is left out too, as TelemetryDeck stores no"},{"type":"text","text":" "},{"type":"text","text":"value for it. TelemetryDeck stores a nested object without indexing it and leaves arrays"},{"type":"text","text":" "},{"type":"text","text":"undefined, so the encoder spreads both into members of their own."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event also holds these of TelemetryDeck’s built-in parameters, for each of the keys the"},{"type":"text","text":" "},{"type":"text","text":"record’s context has a value for:"}]},{"header":"row","rows":[[[{"inlineContent":[{"text":"Parameter","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.version"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.AppInfo.buildNumber"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The version and the build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.versionAndBuildNumber"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"},{"type":"text","text":", with both a version and a build"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"2.4.1 (build 418)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.modelName"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The model","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.Device.operatingSystem","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TelemetryDeck.Device.platform","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The operating system’s name, ","type":"text"},{"code":"iOS","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.systemVersion"},{"text":", ","type":"text"},{"type":"codeVoice","code":"TelemetryDeck.Device.systemMajorVersion"},{"text":", ","type":"text"},{"type":"codeVoice","code":"TelemetryDeck.Device.systemMajorMinorVersion"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"},{"text":", with a version","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The name and the version, its first component and its first two: "},{"code":"iOS 26.1.0","type":"codeVoice"},{"type":"text","text":", "},{"code":"iOS 26","type":"codeVoice"},{"type":"text","text":", "},{"code":"iOS 26.1","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.locale"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The locale’s identifier, "},{"type":"codeVoice","code":"en_US"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.language"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"},{"text":", with a language","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The language’s code, "},{"type":"codeVoice","code":"en"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.UserPreference.region","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":", with a region"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The region’s code, ","type":"text"},{"type":"codeVoice","code":"US"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event name or parameter"},{"type":"text","text":" "},{"type":"text","text":"name TelemetryDeck refuses or keeps for itself, one whose values flatten to one name, one whose"},{"type":"text","text":" "},{"type":"text","text":"event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is outside the"},{"type":"text","text":" "},{"type":"text","text":"years 1 to 9999, and one whose JSON is over 333,333 bytes ("},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. TelemetryDeck answers a request it takes with 200, and checks every event of a"},{"type":"text","text":" "},{"type":"text","text":"request before storing any: it answers 422 when one breaks a rule, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"drops and reports with every record of the request. It answers 503 when its queue is full,"},{"type":"text","text":" "},{"type":"text","text":"which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries. It doesn’t remove duplicates, so a record sent again is"},{"type":"text","text":" "},{"type":"text","text":"counted again. The bytes are the same for the same records on every run and platform: no"},{"type":"text","text":" "},{"type":"text","text":"whitespace, object members in the order of their names’ UTF-8 bytes."}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"]]},"sections":[],"references":{"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder":{"url":"\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder","abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of TelemetryDeck’s Ingest API v3, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to an organization’s "},{"type":"codeVoice","code":"POST \/v3\/<namespace>\/"},{"type":"text","text":"."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"title":"TelemetryDeckBatchEncoder","role":"symbol","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder"},"doc://TelemetryDeckEncoding/documentation/TelemetryDeckEncoding/TelemetryDeckBatchEncoder/init(appID:testMode:plan:limit:)":{"title":"init(appID:testMode:plan:limit:)","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncod