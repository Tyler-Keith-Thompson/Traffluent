{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding"]]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/init(appID:testMode:plan:limit:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/Failure"],"title":"Type Aliases","anchor":"Type-Aliases"},{"generated":true,"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit","doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/transientStatuses"],"title":"Type Properties","anchor":"Type-Properties"},{"generated":true,"identifiers":["doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/outcome(of:for:)"],"title":"Type Methods","anchor":"Type-Methods"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/TelemetryDeckEncoding\/s8SendableP","doc:\/\/TelemetryDeckEncoding\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TelemetryDeckBatchEncoder","kind":"identifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/HTTPDestinations\/HTTPDestination\/telemetryDeck(appID:namespace:testMode:plan:backoff:clock:)","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which fills in the endpoint, this encoder and its limits:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let telemetryDeck = try HTTPDestination.telemetryDeck(","    appID: appID,  \/\/ from the app's settings in the TelemetryDeck dashboard","    namespace: \"com.example\",  \/\/ your organization's namespace","    testMode: false,  \/\/ true for builds whose signals only Test Mode should show","    plan: plan)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The body is a JSON array of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", one event per record, oldest"},{"type":"text","text":" "},{"type":"text","text":"first. Each event is a flat object of these members:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"appID","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app ID the encoder is made with, without leading or trailing whitespace"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"clientUser","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SHA256 of the record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":" as a lowercase UUID string, as 64 lowercase hexadecimal digits; of the record’s own "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":" the same way when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isTestMode"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"true\"","type":"codeVoice"},{"type":"text","text":" or "},{"code":"\"false\"","type":"codeVoice"},{"type":"text","text":", as the encoder is made with"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"receivedAt","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601, in UTC with milliseconds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sessionID","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID string; left out when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.SDK.name"}]}],[{"type":"paragraph","inlineContent":[{"code":"Traffluent","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Each of the event’s stored properties","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Its value, read through the event’s schema in the plan; a nested value spread into one member per scalar it holds, named after its path, joined by ","type":"text"},{"code":".","type":"codeVoice"},{"text":" (","type":"text"},{"code":"cart.size","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tags.0","type":"codeVoice"},{"text":")","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"The session is the only identifier sent, hashed as TelemetryDeck’s SDKs hash a user’s","type":"text"},{"text":" ","type":"text"},{"text":"identifier with their default, empty salt; TelemetryDeck salts and hashes it again before","type":"text"},{"text":" ","type":"text"},{"text":"storing it. No salt of the app’s own is taken: ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":" sends the same session in the","type":"text"},{"text":" ","type":"text"},{"text":"clear, so a salt would hide nothing. TelemetryDeck counts a user per ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":", so its users","type":"text"},{"text":" ","type":"text"},{"text":"are sessions. A record with no session (one tracked by a tracker without ","type":"text"},{"code":"Enricher.sessions()","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"is its own user of one event, with no ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":", linked to nothing: TelemetryDeck refuses an","type":"text"},{"text":" ","type":"text"},{"text":"event without a ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":". A record a store recovers after a relaunch keeps its session, so","type":"text"},{"text":" ","type":"text"},{"text":"it goes out with the ","type":"text"},{"code":"clientUser","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sessionID","type":"codeVoice"},{"text":" of its first send. The record’s vendor identifier and trace context, and","type":"text"},{"text":" ","type":"text"},{"text":"any other context value, aren’t sent. Nor is a ","type":"text"},{"code":"floatValue","type":"codeVoice"},{"text":": a number among the properties","type":"text"},{"text":" ","type":"text"},{"text":"keeps its JSON type in Ingest API v3.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. A "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is left out too, as TelemetryDeck stores no"},{"type":"text","text":" "},{"type":"text","text":"value for it. TelemetryDeck stores a nested object without indexing it and leaves arrays"},{"type":"text","text":" "},{"type":"text","text":"undefined, so the encoder spreads both into members of their own."}],"type":"paragraph"},{"inlineContent":[{"text":"Each event also holds these of TelemetryDeck’s built-in parameters, for each of the keys the","type":"text"},{"text":" ","type":"text"},{"text":"record’s context has a value for:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Parameter"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.AppInfo.version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"TelemetryDeck.AppInfo.buildNumber","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The version and the build, each left out when ","type":"text"},{"code":"nil","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.AppInfo.versionAndBuildNumber"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ApplicationKey","type":"codeVoice"},{"text":", with both a version and a build","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"2.4.1 (build 418)"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.Device.modelName","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The model"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.operatingSystem"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.Device.platform"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OperatingSystemKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The operating system’s name, "},{"type":"codeVoice","code":"iOS"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.Device.systemVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.Device.systemMajorVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"TelemetryDeck.Device.systemMajorMinorVersion"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"OperatingSystemKey"},{"text":", with a version","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The name and the version, its first component and its first two: "},{"code":"iOS 26.1.0","type":"codeVoice"},{"type":"text","text":", "},{"code":"iOS 26","type":"codeVoice"},{"type":"text","text":", "},{"code":"iOS 26.1","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.RunContext.locale"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The locale’s identifier, "},{"type":"codeVoice","code":"en_US"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"TelemetryDeck.RunContext.language","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":", with a language"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The language’s code, "},{"code":"en","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"TelemetryDeck.UserPreference.region"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LocaleKey","type":"codeVoice"},{"type":"text","text":", with a region"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The region’s code, ","type":"text"},{"code":"US","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" doesn’t describe, one whose event name or parameter"},{"type":"text","text":" "},{"type":"text","text":"name TelemetryDeck refuses or keeps for itself, one whose values flatten to one name, one whose"},{"type":"text","text":" "},{"type":"text","text":"event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp is outside the"},{"type":"text","text":" "},{"type":"text","text":"years 1 to 9999, and one whose JSON is over 333,333 bytes ("},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckEncodingError","isActive":true,"type":"reference"},{"type":"text","text":")."},{"type":"text","text":" "},{"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"type":"text","text":" returns them as "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":"s, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/requests(for:)"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TelemetryDeckEncoding\/documentation\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder\/batchLimit"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. TelemetryDeck answers a request it takes with 200, and checks every event of a"},{"type":"text","text":" "},{"type":"text","text":"request before storing any: it answers 422 when one breaks a rule, which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"drops and reports with every record of the request. It answers 503 when its queue is full,"},{"type":"text","text":" "},{"type":"text","text":"which "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" retries. It doesn’t remove duplicates, so a record sent again is"},{"type":"text","text":" "},{"type":"text","text":"counted again. The bytes are the same for the same records on every run and platform: no"},{"type":"text","text":" "},{"type":"text","text":"whitespace, object members in the order of their names’ UTF-8 bytes."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/telemetrydeckencoding\/telemetrydeckbatchencoder"]}],"metadata":{"modules":[{"name":"TelemetryDeckEncoding"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TelemetryDeckBatchEncoder"}],"remoteSource":{"fileName":"TelemetryDeckBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/TelemetryDeckEncoding\/TelemetryDeckBatchEncoder.swift#L86"},"roleHeading":"Structure","title":"TelemetryDeckBatchEncoder","externalID":"s:21TelemetryDeckEncoding0aB12BatchEncoderV","navigator