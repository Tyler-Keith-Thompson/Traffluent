e":"text"},{"text":" ","type":"text"},{"text":"first. Each event is a flat object of these members:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Member","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"appID"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app ID the encoder is made with, without leading or trailing whitespace"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"clientUser","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The SHA256 of the record’s session, its ","type":"text"},{"code":"SessionKey","type":"codeVoice"},{"text":" as a lowercase UUID string, as 64 lowercase hexadecimal digits; of the record’s own ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":" the same way when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isTestMode"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"true\""},{"text":" or ","type":"text"},{"type":"codeVoice","code":"\"false\""},{"text":", as the encoder is made with","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"receivedAt"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the event was tracked, in ISO 8601, in UTC with milliseconds"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sessionID","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s session, its ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", as a lowercase UUID string; left out when its context has no session","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":", as it is"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"TelemetryDeck.SDK.name","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Traffluent"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Each of the event’s stored properties","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its value, read through the event’s schema in the plan; a nested value spread into one member per scalar it holds, named after its path, joined by "},{"code":".","type":"codeVoice"},{"type":"text","text":" ("},{"code":"cart.size","type":"codeVoice"},{"type":"text","text":", "},{"code":"tags.0","type":"codeVoice"},{"type":"text","text":")"}]}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent, hashed as TelemetryDeck’s SDKs hash a user’s"},{"type":"text","text":" "},{"type":"text","text":"identifier with their default, empty salt; TelemetryDeck salts and hashes it again before"},{"type":"text","text":" "},{"type":"text","text":"storing it. No salt of the app’s own is taken: "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":" sends the same session in the"},{"type":"text","text":" "},{"type":"text","text":"clear, so a salt would hide nothing. TelemetryDeck counts a user per "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":", so its users"},{"type":"text","text":" "},{"type":"text","text":"are sessions. A record with no session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"is its own user of one event, with no "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":", linked to nothing: TelemetryDeck refuses an"},{"type":"text","text":" "},{"type":"text","text":"event without a "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":". A record a store recovers after a relaunch keeps its session, so"},{"type":"text","text":" "},{"type":"text","text":"it goes out with the "},{"type":"codeVoice","code":"clientUser"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sessionID"},{"type":"text","text":" of its first send. The record’s vendor identifier and trace context, and"},{"type":"text","text":" "},{"type":"text","text":"any other context value, aren’t sent. Nor is a "},{"type":"codeVoice","code":"floatValue"},{"type":"text","text":": a number among the properties"},{"type":"text","text":" "},{"type":"text","text":"keeps its JSON type in Ingest API v3."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, and so is an element of an array. A "},{"type":"codeVoice","code":"null"},{"type":"text","text":" is left out too, as TelemetryDeck stores no"},{"type":"text","text":" "},{"type":"text","text":"value for it. TelemetryDeck stores a nested object without indexing it and leaves arrays"},{"type":"text","text":" "},{"type":"text","text":"undefined, so the encoder spreads both into members of their own."}]},{"type":"paragraph","inlineContent":[{"text":"Each event also holds these of TelemetryDeck’s built-in parameters, for each of the keys the","type":"text"},{"text":" ","type":"text"},{"text":"record’s context has a value for:","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Parameter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],