{"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/Destination"]]},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34","fileName":"Enriched.swift"},"title":"enriched(by:)","modules":[{"name":"Destinations"}],"symbolKind":"method","extendedModule":"Destinations","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"}],"roleHeading":"Instance Method","externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF"},"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/destination\/enriched(by:)"]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"This destination, receiving each record with its context changed by "},{"type":"codeVoice","code":"enricher"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":" "},{"kind":"internalParam","text":"enricher"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Enricher","preciseIdentifier":"s:6Events8EnricherV","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},{"kind":"text","text":"\n"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What each record this destination receives adds to its context."}]}],"name":"enricher"}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A destination that hands this one each batch with its records enriched.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"codeListing","syntax":"swift","code":["let delivery = tracker.records.batch().deliver(","    to: ownBackend.enriched(by: Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The enricher runs on each record of a batch as the delivery hands the batch to this"},{"type":"text","text":" "},{"type":"text","text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:"},{"type":"text","text":" "},{"type":"text","text":"the others are handed the same records without it. It runs on every record the destination"},{"type":"text","text":" "},{"type":"text","text":"receives, records a store recovered from an earlier run included, and reads any value it"},{"type":"text","text":" "},{"type":"text","text":"computes at delivery rather than when the event was tracked. So it suits values about the"},{"type":"text","text":" "},{"type":"text","text":"destination or the delivery, such as a region or a deployment tag, rather than about the"},{"type":"text","text":" "},{"type":"text","text":"event: a recovered record would get this run’s app version and the network at upload time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like the other modifiers, the one applied last sees each record first: in"},{"type":"text","text":" "},{"type":"codeVoice","code":"destination.enriched(by: first).enriched(by: second)"},{"type":"text","text":", "},{"type":"codeVoice","code":"second"},{"type":"text","text":" runs, then "},{"type":"codeVoice","code":"first"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"sees what "},{"type":"codeVoice","code":"second"},{"type":"text","text":" set and has the last word on a key both set."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records the enricher adds before a record, as "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":" adds "},{"type":"codeVoice","code":"SessionStarted"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"SessionEnded"},{"type":"text","text":", are left out: they would reach the destination without passing the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as"},{"type":"text","text":" "},{"type":"text","text":"it is called. Give that kind of enricher to the tracker instead."}]},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") enricher calls for a batch of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" records."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"}],"kind":"content"}],"references":{"doc://Destinations/documentation/Destinations/Destination/enriched(by:)":{"url":"\/documentation\/destinations\/destination\/enriched(by:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","title":"enriched(by:)","role":"symbol","kind":"symbol","abstract":[{"text":"This destination, receiving each record with its context changed by ","type":"text"},{"code":"enricher","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"topic","role":"collection","title":"Destinations","kind":"symbol","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}]},"doc://Events/documentation/Events/Enricher":{"abstract":[{"type":"text","text":"Adds to the context of each event a tracker tracks, before the record is delivered."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Enricher","kind":"identifier"}],"url":"\/documentation\/events\/enricher","navigatorTitle":[{"text":"Enricher","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","title":"Enricher","type":"topic"},"doc://Destinations/documentation/Destinations/Destination":{"kind":"symbol","url":"\/documentation\/destinations\/destination","title":"Destination","type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"navigatorTitle":[{"kind":"identifier","text":"Destination"}],"role":"symbol"}}}