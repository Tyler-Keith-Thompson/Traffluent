{"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations"]]},"topicSections":[{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"],"generated":true}],"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/Destinations\/s8SendableP","doc:\/\/Destinations\/s16SendableMetatypeP"],"kind":"relationships"},{"type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"],"kind":"relationships"}],"variants":[{"paths":["\/documentation\/destinations\/destination"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"metadata":{"symbolKind":"protocol","role":"symbol","modules":[{"name":"Destinations"}],"title":"Destination","externalID":"s:12Destinations11DestinationP","roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Destination"}],"remoteSource":{"fileName":"Destination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Destination.swift#L27"}},"sections":[],"kind":"symbol","abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"code":"deliver(to:batchBufferLimit:)","type":"codeVoice"},{"text":" gives each destination its batches in the order the events","type":"text"},{"text":" ","type":"text"},{"text":"were tracked, one at a time: the next batch comes once ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference","isActive":true},{"text":" returns. Batches that","type":"text"},{"text":" ","type":"text"},{"text":"arrive meanwhile wait in a buffer of the destination’s own, which drops its oldest batch when","type":"text"},{"text":" ","type":"text"},{"text":"full, so a destination that falls behind doesn’t hold up the others.","type":"text"},{"text":" ","type":"text"},{"text":"The delivery reports each batch dropped. Once the destination has caught up, it gets the","type":"text"},{"text":" ","type":"text"},{"text":"dropped batch’s records that a store keeps, read back from the store, after the newer batches","type":"text"},{"text":" ","type":"text"},{"text":"it received meanwhile; those kept in memory only are lost.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"type":"text","text":" should return as soon as the batch is somewhere it won’t be lost, and honour"},{"type":"text","text":" "},{"type":"text","text":"cancellation: a delivery waits for it before it completes, and cancels it when the delivery is"},{"type":"text","text":" "},{"type":"text","text":"cancelled. Until it returns, this destination’s later batches wait in its buffer. A"},{"type":"text","text":" "},{"type":"text","text":"destination handles its own errors (a failed upload, say); the delivery has none to receive."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When a tracker keeps its records in a store, returning from "},{"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","isActive":true},{"type":"text","text":" is what tells the"},{"type":"text","text":" "},{"type":"text","text":"store a batch arrived: once every destination has returned for it, uncancelled, the store"},{"type":"text","text":" "},{"type":"text","text":"forgets those records. A destination that buffers or retries should return only once the"},{"type":"text","text":" "},{"type":"text","text":"batch is somewhere it won’t be lost; a record whose "},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"type":"text","text":" is set may"},{"type":"text","text":" "},{"type":"text","text":"have reached it in an earlier run."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What a destination receives is narrowed by modifiers rather than by code of its own:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)"},{"type":"text","text":" for the consent categories it serves, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()"},{"type":"text","text":". A destination given none receives every record as tracked."}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Destinations","title":"Destinations","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","doc:\/\/Destinations\/documentation\/Destinations\/InvalidCapacity"],"generated":true}],"references":{"doc://Destinations/documentation/Destinations/Destination/accepting(_:)":{"url":"\/documentation\/destinations\/destination\/accepting(_:)","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","type":"topic","role":"symbol","title":"accepting(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accepting","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ConsentCategory","preciseIdentifier":"s:6Events15ConsentCategoryV","kind":"typeIdentifier"},{"text":"...) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"This destination, receiving only the events in "},{"type":"codeVoice","code":"categories"},{"type":"text","text":"."}]},"doc://Destinations/documentation/Destinations/Destination/enriched(by:)":{"url":"\/documentation\/destinations\/destination\/enriched(by:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","title":"enriched(by:)","role":"symbol","kind":"symbol","abstract":[{"text":"This destination, receiving each record with its context cha