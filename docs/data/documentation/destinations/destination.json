text":"]) ","kind":"text"},{"text":"async","kind":"keyword"}],"url":"\/documentation\/destinations\/destination\/receive(_:)","kind":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","title":"receive(_:)","required":true,"type":"topic"},"doc://Destinations/documentation/Destinations/InMemoryDestination/init(capacity:)":{"abstract":[{"type":"text","text":"A destination that keeps the newest "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" records it receives."}],"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:12Destinations15InvalidCapacityV","kind":"typeIdentifier","text":"InvalidCapacity"},{"kind":"text","text":")"}],"url":"\/documentation\/destinations\/inmemorydestination\/init(capacity:)","kind":"symbol","title":"init(capacity:)","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/init(capacity:)","type":"topic"},"doc://Destinations/documentation/Destinations/Destination/redactingSensitiveValues()":{"abstract":[{"type":"text","text":"This destination, receiving each record with its "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" values redacted:"},{"type":"text","text":" "},{"code":"EventRecord.reveal(_:)","type":"codeVoice"},{"type":"text","text":" gives "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for every one."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"redactingSensitiveValues"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations11DestinationP","text":"Desti