{"sections":[],"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"symbol","roleHeading":"Protocol","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"modules":[{"name":"Destinations"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"title":"Destination","externalID":"s:12Destinations11DestinationP","remoteSource":{"fileName":"Destination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Destination.swift#L27"},"symbolKind":"protocol"},"abstract":[{"text":"Where a delivery sends events: a plain sink that records the batches it receives.","type":"text"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Destinations\/s8SendableP","doc:\/\/Destinations\/s16SendableMetatypeP"],"title":"Inherits From","type":"inheritsFrom"},{"kind":"relationships","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"],"title":"Conforming Types","type":"conformingTypes"}],"seeAlsoSections":[{"anchor":"Destinations","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/ConsoleDestination","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination","doc:\/\/Destinations\/documentation\/Destinations\/InvalidCapacity"],"title":"Destinations","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"code":"deliver(to:batchBufferLimit:)","type":"codeVoice"},{"text":" gives each destination its batches in the order the events","type":"text"},{"text":" ","type":"text"},{"text":"were tracked, one at a time: the next batch comes once ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)","type":"reference","isActive":true},{"text":" returns. Batches that","type":"text"},{"text":" ","type":"text"},{"text":"arrive meanwhile wait in a buffer of the destination’s own, which drops its oldest batch when","type":"text"},{"text":" ","type":"text"},{"text":"full, so a destination that falls behind doesn’t hold up the others.","type":"text"},{"text":" ","type":"text"},{"text":"The delivery reports each batch dropped. Once the destination has caught up, it gets the","type":"text"},{"text":" ","type":"text"},{"text":"dropped batch’s records that a store keeps, read back from the store, after the newer batches","type":"text"},{"text":" ","type":"text"},{"text":"it received meanwhile; those kept in memory only are lost.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"text":" should return as soon as the batch is somewhere it won’t be lost, and honour","type":"text"},{"text":" ","type":"text"},{"text":"cancellation: a delivery waits for it before it completes, and cancels it when the delivery is","type":"text"},{"text":" ","type":"text"},{"text":"cancelled. Until it returns, this destination’s later batches wait in its buffer. A","type":"text"},{"text":" ","type":"text"},{"text":"destination handles its own errors (a failed upload, say); the delivery has none to receive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When a tracker keeps its records in a store, returning from ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/receive(_:)"},{"text":" is what tells the","type":"text"},{"text":" ","type":"text"},{"text":"store a batch arrived: once every destination has returned for it, uncancelled, the store","type":"text"},{"text":" ","type":"text"},{"text":"forgets those records. A destination that buffers or retries should return only once the","type":"text"},{"text":" ","type":"text"},{"text":"batch is somewhere it won’t be lost; a record whose ","type":"text"},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"text":" is set may","type":"text"},{"text":" ","type":"text"},{"text":"have reached it in an earlier run.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"What a destination receives is narrowed by modifiers rather than by code of its own:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","type":"reference"},{"text":" for the consent categories it serves, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/redactingSensitiveValues()","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","type":"reference"},{"text":". A destination given none receives every record as tracked.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/destination"]}],"topicSections":[{"anchor":"Instance-Methods","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/Destination\/accepting(_:)","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/droppingCallSite()","doc:\/\/Destinations\/documentation\/Destinations\/Destination\/enriched(by:)","doc:\/\/Destinations\/documentation\/Destinations\/Destinati