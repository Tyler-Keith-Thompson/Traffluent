quence","url":"\/documentation\/destinations\/_concurrency\/asyncsequence","title":"AsyncSequence","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:Sci","text":"AsyncSequence"}]},"doc://Destinations/documentation/Destinations/Destination":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Destination","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Destination","kind":"identifier"}],"kind":"symbol","title":"Destination","abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"url":"\/documentation\/destinations\/destination","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination"},"doc://Destinations/documentation/Destinations/_Concurrency":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","kind":"symbol","abstract":[],"role":"collection","type":"topic","url":"\/documentation\/destinations\/_concurrency","title":"_Concurrency"},"doc://Destinations/documentation/Destinations/BufferDropReport":{"title":"BufferDropReport","role":"symbol","url":"\/documentation\/destinations\/bufferdropreport","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BufferDropReport","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","kind":"symbol","abstract":[{"type":"text","text":"Batches a destination’s full buffer dropped before the destination received them."}],"navigatorTitle":[{"text":"BufferDropReport","kind":"identifier"}]}}}