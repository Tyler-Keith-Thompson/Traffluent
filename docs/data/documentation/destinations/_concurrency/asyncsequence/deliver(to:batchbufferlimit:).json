:">"}],"type":"topic","url":"\/documentation\/destinations\/delivery\/bufferdropreports","title":"bufferDropReports","abstract":[{"type":"text","text":"A report of the batches each destination’s full buffer drops, in the order they are"},{"type":"text","text":" "},{"type":"text","text":"dropped."}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","kind":"symbol"},"doc://Destinations/documentation/Destinations/_Concurrency":{"kind":"symbol","type":"topic","title":"_Concurrency","abstract":[],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","role":"collection","url":"\/documentation\/destinations\/_concurrency"},"doc://Destinations/documentation/Destinations/Delivery":{"title":"Delivery","navigatorTitle":[{"text":"Delivery","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Delivery","kind":"identifier"}],"url":"\/documentation\/destinations\/delivery","type":"topic","kind":"symbol","abstract":[{"text":"The work of delivering a sequence’s batches to destinations, made by ","type":"text"},{"type":"codeVoice","code":"deliver(to:)"},{"text":", and the","type":"text"},{"text":" ","type":"text"},{"text":"reports of the batches their full buffers drop.","type":"text"}]},"doc://Destinations/documentation/Destinations/Destination":{"kind":"symbol","url":"\/documentation\/destinations\/destination","title":"Destination","type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Destination"}],"abstract":[{"type":"text","text":"Where a delivery sends events: a plain sink that records the batches it receives."}],"navigatorTitle":[{"kind":"identifier","text":"Destination"}],"role":"symbol"},"doc://Destinations/documentation/D