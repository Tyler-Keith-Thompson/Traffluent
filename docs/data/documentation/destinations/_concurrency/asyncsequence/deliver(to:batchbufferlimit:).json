{"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/_concurrency\/asyncsequence\/deliver(to:batchbufferlimit:)"]}],"identifier":{"url":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:batchBufferLimit:)","interfaceLanguage":"swift"},"sections":[],"metadata":{"symbolKind":"method","modules":[{"name":"Destinations","relatedModules":["_Concurrency"]}],"role":"symbol","title":"deliver(to:batchBufferLimit:)","externalID":"s:Sci12Destinationss8SendableRzSay6Events11EventRecordVG7ElementRtzrlE7deliver2to16batchBufferLimitAA8DeliveryVAA11Destination_pd_SitAA012InvalidBatchjK0VYKF","extendedModule":"_Concurrency","roleHeading":"Instance Method","conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[EventRecord]"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Self"},{"type":"text","text":" is "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliver","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier"},{"text":"..., ","kind":"text"},{"text":"batchBufferLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"InvalidBatchBufferLimit","preciseIdentifier":"s:12Destinations23InvalidBatchBufferLimitV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Delivery","preciseIdentifier":"s:12Destinations8DeliveryV","kind":"typeIdentifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Deliver.swift#L59","fileName":"Deliver.swift"}},"kind":"symbol","abstract":[{"text":"The work of delivering each batch of this sequence to every destination, until the","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliver"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"destinations"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","text":"Destination","preciseIdentifier":"s:12Destinations11DestinationP"},{"kind":"text","text":"..., "},{"kind":"externalParam","text":"batchBufferLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","text":"InvalidBatchBufferLimit","preciseIdentifier":"s:12Destinations23InvalidBatchBufferLimitV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","text":"Delivery","preciseIdentifier":"s:12Destinations8DeliveryV"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"destinations","content":[{"inlineContent":[{"type":"text","text":"Where each batch goes."}],"type":"paragraph"}]},{"name":"batchBufferLimit","content":[{"inlineContent":[{"text":"How many batches each destination may have waiting while it is","type":"text"},{"text":" ","type":"text"},{"text":"still receiving an earlier one. A tenth of how many dropped batches it keeps track of","type":"text"},{"text":" ","type":"text"},{"text":"to read back.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The delivery, holding the unit of work that completes once the last batch is","type":"text"},{"text":" ","type":"text"},{"text":"delivered, and throws what the sequence throws, or ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" when cancelled;","type":"text"},{"text":" ","type":"text"},{"text":"its ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","isActive":true,"type":"reference"},{"text":" report the batches full buffers drop.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"syntax":"swift","code":["let delivery = tracker.records","    .batch(strategy: .count(20))","    .deliver(to: ConsoleDestination(), vendor)","try await delivery.execute()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each destination receives its batches in order, one at a time, from a buffer of its own,"},{"type":"text","text":" "},{"type":"text","text":"so a slow destination delays only itself. When a batch arrives while a destination’s"},{"type":"text","text":" "},{"type":"text","text":"buffer already holds "},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" batches, the oldest waiting batch is dropped,"},{"type":"text","text":" "},{"type":"text","text":"logged and reported on the delivery’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports"},{"type":"text","text":", where the drops no"},{"type":"text","text":" "},{"type":"text","text":"one has read yet wait as one "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"},{"type":"text","text":" per destination. Its records kept in"},{"type":"text","text":" "},{"type":"text","text":"memory only are lost. Those a store keeps are not: once that destination has received"},{"type":"text","text":" "},{"type":"text","text":"every batch waiting in its buffer, the delivery reads them back from the store and hands"},{"type":"text","text":" "},{"type":"text","text":"them to that destination alone, one dropped batch at a time, oldest first. Read back, a"},{"type":"text","text":" "},{"type":"text","text":"record is as it was dropped: its "},{"type":"codeVoice","code":"EventRecord.id"},{"type":"text","text":", "},{"type":"codeVoice","code":"EventRecord.isRedelivered"},{"type":"text","text":", sensitive"},{"type":"text","text":" "},{"type":"text","text":"values and context, which the delivery keeps meanwhile. The delivery keeps track of at"},{"type":"text","text":" "},{"type":"text","text":"most ten times "},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" dropped batches per destination; past that it forgets"},{"type":"text","text":" "},{"type":"text","text":"the oldest, whose records stay in the store for the next launch, and logs it. Once the"},{"type":"text","text":" "},{"type":"text","text":"sequence ends, the work completes after every destination has received its last batch,"},{"type":"text","text":" "},{"type":"text","text":"the ones read back included."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records a store keeps (those with an "},{"type":"codeVoice","code":"EventRecord.deliveryTag"},{"type":"text","text":") are reported to it:"},{"type":"text","text":" "},{"type":"text","text":"before a batch goes to any destination, and again once every destination’s "},{"type":"codeVoice","code":"receive"},{"type":"text","text":" "},{"type":"text","text":"has returned for it without being cancelled, when the store may forget them. A record"},{"type":"text","text":" "},{"type":"text","text":"the store couldn’t mark as being delivered is left out of the batch, and a batch left"},{"type":"text","text":" "},{"type":"text","text":"with no records isn’t sent. A record that some destination never received, because the"},{"type":"text","text":" "},{"type":"text","text":"store no longer kept it or couldn’t read it back when the delivery asked, is never"},{"type":"text","text":" "},{"type":"text","text":"acknowledged, so a store that still keeps it delivers it on the next launch."}],"type":"paragraph"},{"inlineContent":[{"text":"Records the delivery has read but not delivered are lost to this run when it is cancelled","type":"text"},{"text":" ","type":"text"},{"text":"or fails. Without a store they are gone; a store never had them acknowledged, so it","type":"text"},{"text":" ","type":"text"},{"text":"delivers them on the next launch (unless its bound drops them first, which it reports).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Nothing runs until the work is executed, and each execution reads the sequence again, so"},{"type":"text","text":" "},{"type":"text","text":"a delivery that finished or failed can be executed again (a retry). Cancelling it drops"},{"type":"text","text":" "},{"type":"text","text":"the batches its destinations had waiting, and is permanent, as for every Afluent unit of"},{"type":"text","text":" "},{"type":"text","text":"work: executing a cancelled delivery again throws "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" at once, so build a"},{"type":"text","text":" "},{"type":"text","text":"new one instead."}],"type":"paragraph"},{"name":"Throws","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","type":"reference","isActive":true},{"type":"text","text":" when "},{"type":"codeVoice","code":"batchBufferLimit"},{"type":"text","text":" is below 1."}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Delivering","generated":true,"title":"Delivering","identifiers":["doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/batch(clock:)","doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence\/deliver(to:)","doc:\/\/Destinations\/documentation\/Destinations\/Delivery","doc:\/\/Destinations\/documentation\/Destinations\/InvalidBatchBufferLimit","doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport"]}],"references":{"doc://Destinations/documentation/Destinations/BufferDropReport":{"url":"\/documentation\/destinations\/bufferdropreport","title":"BufferDropReport","kind":"symbol","abstract":[{"text":"Batches a destination’s full buffer dropped before the destination received them.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","navigatorTitle":[{"text":"BufferDropReport","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BufferDropReport","kind":"identifier"}]},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"topic","role":"collection","title":"Destinations","kind":"symbol","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}]},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence":{"url":"\/documentation\/destinations\/_concurrency\/asyncsequence","title":"AsyncSequence","kind":"symbol","abstract":[],"role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/_Concurrency\/AsyncSequence","navigatorTitle":[{"kind":"identifier","text":"AsyncSequence"}],"type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncSequence","preciseIdentifier":"s:Sci"}]},"doc://Destinations/documentation/Destinations/_Concurrency/AsyncSequence/batch(clock:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"("},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier","text":"Clock"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier","text":"AsyncSequences"},{"kind":"text","text":"."},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","kind":"typeIdentifier","text":"Batch"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"preciseIdentifier":"s:7Afluent19EitherBatchStrategyV","kind":"typeIdentifier","text":"EitherBatchStrategy"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier","text":"EventRecord"},{"kind":"text","text":">>"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"ty