{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bufferDropReports"},{"kind":"text","text":": "},{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV","text":"BufferDropReport"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"Reports no one has read yet merge, one per destination: a destination’s later drops add","type":"text"},{"text":" ","type":"text"},{"text":"their record counts to its waiting report and widen its timestamps, so the reports waiting","type":"text"},{"text":" ","type":"text"},{"text":"are at most one per destination, and a late reader still learns every count lost. The","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends once this delivery, every copy of it and every unit of work built on","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/work","isActive":true,"type":"reference"},{"text":" are gone, their executions have returned, and every report has been read. Read","type":"text"},{"text":" ","type":"text"},{"text":"the sequence into a constant before starting the task that reads it, so the task holds the","type":"text"},{"text":" ","type":"text"},{"text":"reports and not the delivery.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"One task reads the reports at a time. The first iterator to read holds them until its","type":"text"},{"text":" ","type":"text"},{"text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a","type":"text"},{"text":" ","type":"text"},{"text":"warning once, then reads on from the next report, so the first gets every report in","type":"text"},{"text":" ","type":"text"},{"text":"order. A reader cancelled while it waits returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"sections":[],"metadata":{"title":"bufferDropReports","externalID":"s:12Destinations8DeliveryV17bufferDropReports11AsyncQueues0F5QueueVyAA06BufferD6ReportVGvp","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bufferDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV","text":"BufferDropReport"},{"kind":"text","text":">"}],"roleHeading":"Instance Property","symbolKind":"property","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Delivery.swift#L50","fileName":"Delivery.swift"},"modules":[{"name":"Destinations"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports"},"kind":"symbol","abstract":[{"type":"text","text":"A report of the batches each destination’s full buffer drops, in the order they are"},{"type":"text","text":" "},{"type":"text","text":"dropped."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/delivery\/bufferdropreports"]}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/Delivery"]]},"references":{"doc://Destinations/documentation/Destinations/Delivery/work":{"type":"topic","role":"symbol","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/work","kind":"symbol","title":"work","url":"\/documentation\/destinations\/delivery\/work","abstract":[{"type":"text","text":"The unit of work that delivers: executing it runs the delivery."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"work","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DeferredTask","preciseIdentifier":"s:7Afluent12DeferredTaskC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Destinations/documentation/Destinations/BufferDropReport":{"title":"BufferDropReport","role":"symbol","url":"\/documentation\/destinations\/bufferdropreport","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BufferDropReport","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","kind":"symbol","abstract":[{"type":"text","text":"Batches a destination’s full buffer dropped before the destination received them."}],"navigatorTitle":[{"text":"BufferDropReport","kind":"identifier"}]},"doc://Destinations/documentation/Destinations/Delivery":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Delivery","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Delivery","kind":"identifier"}],"kind":"symbol","title":"Delivery","abstract":[{"text":"The work of delivering a sequence’s batches to destinations, made by ","type":"text"},{"code":"deliver(to:)","type":"codeVoice"},{"text":", and the","type":"text"},{"text":" ","type":"text"},{"text":"reports of the batches their full buffers drop.","type":"text"}],"url":"\/documentation\/destinations\/delivery","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery"},"doc://Destinations/documentation/Destinations":{"kind":"symbol","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}],"url":"\/documentation\/destinations","type":"topic","role":"collection","title":"Destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"abstract":[{"text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"role":"symbol","title":"AsyncQueue","url":"\/documentation\/asyncqueues\/asyncqueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}]},"doc://Destinations/documentation/Destinations/Delivery/bufferDropReports":{"type":"topic","role":"symbol","title":"bufferDropReports","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports","kind":"symbol","url":"\/documentation\/destinations\/delivery\/bufferdropreports","abstract":[{"type":"text","text":"A report of the batches each destination’s full buffer drops, in the order they are"},{"type":"text","text":" "},{"type":"text","text":"dropped."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bufferDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:12Destinations16BufferDropReportV","text":"BufferDropReport","kind":"typeIdentifier"},{"text":">","kind":"text"}]}}}