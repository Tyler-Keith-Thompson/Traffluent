:">","kind":"text"}],"abstract":[{"type":"text","text":"The unit of work that delivers: executing it runs the delivery."}]},"doc://Destinations/documentation/Destinations":{"type":"topic","title":"Destinations","role":"collection","kind":"symbol","url":"\/documentation\/destinations","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"type":"codeVoice","code":"Destination"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches.","type":"text"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations"},"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"role":"symbol","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","url":"\/documentation\/asyncqueues\/asyncqueue","title":"AsyncQueue","abstract":[{"text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"navigatorTitle":[{"text":"AsyncQueue","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncQueue","kind":"identifier"}]},"doc://Destinations/documentation/Destinations/Delivery":{"title":"Delivery","role":"symbol","abstract":[{"type":"text","text":"The work of delivering a sequence’s batches to destinations, made by "},{"code":"deliver(to:)","type":"codeVoice"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"reports of the batches their full buffers drop."}],"type":"topic","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","url":"\/documentation\/destinations\/delivery","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Delivery"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Delivery"}]}}}