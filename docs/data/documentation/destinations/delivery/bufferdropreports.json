{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bufferDropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"BufferDropReport","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/BufferDropReport","preciseIdentifier":"s:12Destinations16BufferDropReportV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Reports no one has read yet merge, one per destination: a destination’s later drops add"},{"type":"text","text":" "},{"type":"text","text":"their record counts to its waiting report and widen its timestamps, so the reports waiting"},{"type":"text","text":" "},{"type":"text","text":"are at most one per destination, and a late reader still learns every count lost. The"},{"type":"text","text":" "},{"type":"text","text":"sequence ends once this delivery, every copy of it and every unit of work built on"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/work"},{"type":"text","text":" are gone, their executions have returned, and every report has been read. Read"},{"type":"text","text":" "},{"type":"text","text":"the sequence into a constant before starting the task that reads it, so the task holds the"},{"type":"text","text":" "},{"type":"text","text":"reports and not the delivery."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"One task reads the reports at a time. The first iterator to read holds them until its"},{"type":"text","text":" "},{"type":"text","text":"iteration ends or it is released; a second reader meanwhile waits its turn, logging a"},{"type":"text","text":" "},{"type":"text","text":"warning once, then reads on from the next report, so the first gets every report in"},{"type":"text","text":" "},{"type":"text","text":"order. A reader cancelled while it waits returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"sections":[],"metadata":{"modules":[{"name":"Destinations"}],"roleHeading":"Instance Property","title":"bufferDropReports","symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bufferDropReports"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12Destinations16BufferDropReportV","text":"BufferDropReport"},{"kind":"text","text":">"}],"remoteSource":{"fileName":"Delivery.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Delivery.swift#L50"},"externalID":"s:12Destinations8DeliveryV17bufferDropReports11AsyncQueues0F5QueueVyAA06BufferD6ReportVGvp","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery\/bufferDropReports"},"variants":[{"paths":["\/documentation\/destinations\/delivery\/bufferdropreports"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A report of the batches each destination’s full buffer drops, in the order they are"},{"type":"text","text":" "},{"type":"text","text":"dropped."}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/Delivery"]]},"references":{"doc://AsyncQueues/documentation/AsyncQueues/AsyncQueue":{"kind":"symbol","url":"\/documentation\/asyncqueues\/asyncqueue","title":"AsyncQueue","type":"topic","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncQueue"}],"abstract":[{"type":"text","text":"Elements in the order they are enqueued, kept until they are read; one reader at a time reads"},{"type":"text","text":" "},{"type":"text","text":"them."}],"navigatorTitle":[{"kind":"identifier","text":"AsyncQueue"}],"role":"symbol"},"doc://Destinations/documentation/Destinations":{"url":"\/documentation\/destinations","identifier":"doc:\/\/Destinations\/documentation\/Destinations","type":"topic","role":"collection","title":"Destinations","kind":"symbol","abstract":[{"type":"text","text":"Where tracked events go: the "},{"type":"codeVoice","code":"Destination"},{"type":"text","text":" protocol, the modifiers that narrow what a destination receives, and the delivery that hands it batches."}]},"doc://Destinations/documentation/Destinations/Delivery":{"title":"Delivery","navigatorTitle":[{"text":"Delivery","kind":"identifier"}],"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Delivery","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Delivery","kind":"identifier"}],"url":"\/documentation\/destinations\/delivery","type":"topic","kind":"symbol","abstract":[{"text":"The work of delivering a sequence’s batches to destinations, made by ","type":"text"},{"type":"codeVoice","code":"deliver(to:)"},{"text":", and the","type":"text"},{"text":" ","type":"text"},{"text":"reports of the batches their full buffers drop.","type":"text"}]},"doc://Destinations/documentation/Destinations/BufferDropReport":{"url":"\/documentation\/destinations\/bufferdropreport","title":"BufferDropReport","kind":"symbol","abstract":[{"text":"Batches a destination’s full buffer dropped before the destination received them.","type":"text"}],"role":"sy