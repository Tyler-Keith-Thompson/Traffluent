{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":" "},{"kind":"internalParam","text":"enricher"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/Destinations\/documentation\/Destinations\/Destination","preciseIdentifier":"s:12Destinations11DestinationP","text":"Destination"},{"kind":"text","text":"\n"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"What each record this destination receives adds to its context.","type":"text"}]}],"name":"enricher"}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A destination that hands this one each batch with its records enriched.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"code":["let delivery = tracker.records.batch().deliver(","    to: ownBackend.enriched(by: Enricher { $0[RegionKey.self] = \"eu-west\" }),","    vendor",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The enricher runs on each record of a batch as the delivery hands the batch to this"},{"type":"text","text":" "},{"type":"text","text":"destination, not on the tracker’s worker, so what it sets reaches this destination alone:"},{"type":"text","text":" "},{"type":"text","text":"the others are handed the same records without it. It runs on every record the destination"},{"type":"text","text":" "},{"type":"text","text":"receives, records a store recovered from an earlier run included, and reads any value it"},{"type":"text","text":" "},{"type":"text","text":"computes at delivery rather than when the event was tracked. So it suits values about the"},{"type":"text","text":" "},{"type":"text","text":"destination or the delivery, such as a region or a deployment tag, rather than about the"},{"type":"text","text":" "},{"type":"text","text":"event: a recovered record would get this run’s app version and the network at upload time."}],"type":"paragraph"},{"inlineContent":[{"text":"Like the other modifiers, the one applied last sees each record first: in","type":"text"},{"text":" ","type":"text"},{"code":"destination.enriched(by: first).enriched(by: second)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"second","type":"codeVoice"},{"text":" runs, then ","type":"text"},{"code":"first","type":"codeVoice"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"sees what ","type":"text"},{"code":"second","type":"codeVoice"},{"text":" set and has the last word on a key both set.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Records the enricher adds before a record, as ","type":"text"},{"type":"codeVoice","code":"Enricher.sessions()"},{"text":" adds ","type":"text"},{"type":"codeVoice","code":"SessionStarted"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"SessionEnded"},{"text":", are left out: they would reach the destination without passing the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s consent, samplers or store. Given such an enricher, this logs a warning once, as","type":"text"},{"text":" ","type":"text"},{"text":"it is called. Give that kind of enricher to the tracker instead.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") enricher calls for a batch of ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" records.","type":"text"}]}],"name":"Complexity"}]}],"sections":[],"variants":[{"paths":["\/documentation\/destinations\/inmemorydestination\/enriched(by:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/enriched(by:)"},"metadata":{"externalID":"s:12Destinations11DestinationPAAE8enriched2byQr6Events8EnricherV_tF::SYNTHESIZED::s:12Destinations19InMemoryDestinationV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/Enriched.swift#L34","fileName":"Enriched.swift"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enriched"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Events8EnricherV","kind":"typeIdentifier","text":"Enricher"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:12Destinations11DestinationP","kind":"typeIdentifier","text":"Destination"}],"modules":[{"name":"Destinations"}],"title":"enriched(by:)","role":"symbol","symbolKind":"method","roleHeading":"Instance Method","extendedModule":"Destinations"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"]]},"abstract":[{"type":"text","text":"This destination, receiving each record with its context changed by "},{"code":"enricher","type":"codeVoice"},{"type":"text","text":"."}],"references":{"doc://Destinations/documentation/Destinations/InMemoryDestination/enriched(by:)":{"kind":"symbol","url":"\/documentation\/destinations\/inmemoryd