{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliveries","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue","kind":"typeIdentifier"},{"text":"<[","kind":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":"]> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Batches not yet read wait in a buffer of the newest ","type":"text"},{"type":"codeVoice","code":"capacity"},{"text":" batches; a slower reader","type":"text"},{"text":" ","type":"text"},{"text":"misses the older ones, and reads ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/records"},{"text":" for what is kept. The sequence ends once the","type":"text"},{"text":" ","type":"text"},{"text":"destination and every copy of it are gone and every batch kept has been read.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One task reads the batches at a time; it can fan each one out to the rest of the app. The"},{"type":"text","text":" "},{"type":"text","text":"first iterator to read holds them until its iteration ends or it is released; a second"},{"type":"text","text":" "},{"type":"text","text":"reader meanwhile waits its turn, logging a warning once, then reads on from the next batch,"},{"type":"text","text":" "},{"type":"text","text":"so the first gets every batch in order. A reader cancelled while it waits returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"metadata":{"roleHeading":"Instance Property","symbolKind":"property","role":"symbol","remoteSource":{"fileName":"InMemoryDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/InMemoryDestination.swift#L108"},"modules":[{"name":"Destinations"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliveries","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV","kind":"typeIdentifier"},{"text":"<[","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":"]>","kind":"text"}],"externalID":"s:12Destinations19InMemoryDestinationV10deliveries11AsyncQueues0F5QueueVySay6Events11EventRecordVGGvp","title":"deliveries"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/deliveries"},"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/destinations\/inmemorydestination\/deliveries"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"]]},"abstract":[{"text":"Each batch as it is received, whole, for a reader that waits for a delivery: a view that","type":"text"},{"text":" ","type":"text"},{"text":"refreshes, or a test that reads once a batch arrives.","type":"text"}],"references":{"doc://Destinations/documentation/Destinations/InMemoryDestination/deliveries":{"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/deliveries","abstract":[{"text":"Each batch as it is received, whole, for a reader that waits for a delivery: a view that","type":"text"},{"text":" ","type":"text"},{"text":"refreshes, or a test that