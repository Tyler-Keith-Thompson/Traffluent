{"metadata":{"role":"symbol","externalID":"s:12Destinations19InMemoryDestinationV10deliveries11AsyncQueues0F5QueueVySay6Events11EventRecordVGGvp","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliveries"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AsyncQueue","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"kind":"text","text":"<["},{"kind":"typeIdentifier","text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV"},{"kind":"text","text":"]>"}],"symbolKind":"property","title":"deliveries","modules":[{"name":"Destinations"}],"remoteSource":{"fileName":"InMemoryDestination.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Destinations\/InMemoryDestination.swift#L108"}},"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"deliveries"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV","text":"AsyncQueue","identifier":"doc:\/\/AsyncQueues\/documentation\/AsyncQueues\/AsyncQueue"},{"kind":"text","text":"<["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord"},{"kind":"text","text":"]> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Batches not yet read wait in a buffer of the newest "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" batches; a slower reader"},{"type":"text","text":" "},{"type":"text","text":"misses the older ones, and reads "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/records"},{"type":"text","text":" for what is kept. The sequence ends once the"},{"type":"text","text":" "},{"type":"text","text":"destination and every copy of it are gone and every batch kept has been read."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"One task reads the batches at a time; it can fan each one out to the rest of the app. The"},{"type":"text","text":" "},{"type":"text","text":"first iterator to read holds them until its iteration ends or it is released; a second"},{"type":"text","text":" "},{"type":"text","text":"reader meanwhile waits its turn, logging a warning once, then reads on from the next batch,"},{"type":"text","text":" "},{"type":"text","text":"so the first gets every batch in order. A reader cancelled while it waits returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/destinations\/inmemorydestination\/deliveries"]}],"hierarchy":{"paths":[["doc:\/\/Destinations\/documentation\/Destinations","doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination"]]},"abstract":[{"text":"Each batch as it is received, whole, for a reader that waits for a delivery: a view that","type":"text"},{"text":" ","type":"text"},{"text":"refreshes, or a test that reads once a batch arrives.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Destinations\/documentation\/Destinations\/InMemoryDestination\/deliveries"},"references":{"doc://Destinations/documentation/Destinations":{"type":"topic","title":"Destinations","role":"collection","kind":"symbol","url":"\/documentation\/destinations","abstract":[{"text":"Where tracked events go: the ","type":"text"},{"type":"codeVoice","code":"Destination"},{"text":" protocol, the modifiers that narrow what a destination receives, and the delivery tha