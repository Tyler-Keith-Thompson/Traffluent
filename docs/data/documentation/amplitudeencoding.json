,"text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"}]},"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","kind":"symbol","url":"\/documentation\/httpdestinations","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"title":"HTTPDestinations","type":"topic","role":"collection"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeRegion":{"navigatorTitle":[{"kind":"identifier","text":"AmplitudeRegion"}],"title":"AmplitudeRegion","type":"topic","url":"\/documentation\/amplitudeencoding\/amplituderegion","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeRegion"}],"role":"symbol","abstract":[{"type":"text","text":"The data center an Amplitude project’s data resides in, which decides the HTTP V2 endpoint its"},{"type":"text","text":" "},{"type":"text","text":"events are posted to."}],"kind":"symbol"},"doc://AmplitudeEncoding/documentation/AmplitudeEncoding/AmplitudeSetupError":{"type":"topic","title":"AmplitudeSetupError","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeSetupError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AmplitudeSetupError"}],"abstract":[{"text":"Why ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/HTTPDestinations\/HTTPDestination\/amplitude(apiKey:region:plan:transport:backoff:clock:)"},{"text":" ","type":"text"},{"text":"couldn’t make a destination.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AmplitudeSetupError"}],"kind":"symbol","url":"\