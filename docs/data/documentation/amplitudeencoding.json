s the HTTP V2 endpoint its","type":"text"},{"text":" ","type":"text"},{"text":"events are posted to.","type":"text"}],"url":"\/documentation\/amplitudeencoding\/amplituderegion","identifier":"doc:\/\/AmplitudeEncoding\/documentation\/AmplitudeEncoding\/AmplitudeRegion","navigatorTitle":[{"text":"AmplitudeRegion","kind":"identifier"}],"title":"AmplitudeRegion","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AmplitudeRegion","kind":"identifier"}],"role":"symbol","type":"topic"}}}