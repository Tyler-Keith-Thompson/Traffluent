{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grdbpersistence"]}],"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Keep each record in a table of the app’s own GRDB database until it is delivered."}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","interfaceLanguage":"swift"},"metadata":{"symbolKind":"module","roleHeading":"Framework","role":"collection","title":"GRDBPersistence","modules":[{"name":"GRDBPersistence"}],"externalID":"GRDBPersistence"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"DatabaseStore","type":"codeVoice"},{"type":"text","text":" is a "},{"code":"RecordStore","type":"codeVoice"},{"type":"text","text":" (module "},{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","type":"reference","isActive":true},{"type":"text","text":") for apps on Apple platforms that"},{"type":"text","text":" "},{"type":"text","text":"already keep a GRDB database. It takes the app’s "},{"code":"DatabaseQueue","type":"codeVoice"},{"type":"text","text":" or "},{"code":"DatabasePool","type":"codeVoice"},{"type":"text","text":" and a table"},{"type":"text","text":" "},{"type":"text","text":"name, creates the table with a migration of its own, and opens no second SQLite database. It is a"},{"type":"text","text":" "},{"type":"text","text":"product of its own, which "},{"code":"import Traffluent","type":"codeVoice"},{"type":"text","text":" leaves out."}]},{"type":"paragraph","inlineContent":[{"text":"It makes the same promises as ","type":"text"},{"type":"codeVoice","code":"SegmentStore"},{"text":". The tracker’s worker commits each record, in a","type":"text"},{"text":" ","type":"text"},{"text":"transaction of its own, before publishing it. A batch’s rows are marked before any destination","type":"text"},{"text":" ","type":"text"},{"text":"receives it and deleted once every destination has. The table holds at most ","type":"text"},{"type":"codeVoice","code":"byteBound"},{"text":" bytes of","type":"text"},{"text":" ","type":"text"},{"text":"encoded records, 5 MiB by default, with the oldest rows deleted to make room, and each drop is","type":"text"},{"text":" ","type":"text"},{"text":"reported on ","type":"text"},{"type":"codeVoice","code":"DatabaseStore.dropReports"},{"text":". Records are encoded as ","type":"text"},{"type":"codeVoice","code":"SegmentStore"},{"text":" encodes them, and","type":"text"},{"text":" ","type":"text"},{"text":"the same events are kept: every ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" in the program and the library’s own, or only the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" types ","type":"text"},{"type":"codeVoice","code":"DatabaseStore(events:database:)"},{"text":" lists. Rows written by","type":"text"},{"text":" ","type":"text"},{"text":"Traffluent 0.0.44 or earlier, in an earlier encoding, aren’t read: each is deleted when the store","type":"text"},{"text":" ","type":"text"},{"text":"opens and reported as ","type":"text"},{"type":"codeVoice","code":".undecodable"},{"text":", or as ","type":"text"},{"type":"codeVoice","code":".versionMismatch"},{"text":" where its stored version differs","type":"text"},{"text":" ","type":"text"},{"text":"from its type’s.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"How durable a commit is against power loss is the database’s choice, through its journal mode and"},{"type":"text","text":" "},{"type":"codeVoice","code":"synchronous"},{"type":"text","text":" setting. "},{"type":"codeVoice","code":"DatabaseStore.synchronize()"},{"type":"text","text":" checkpoints a database in WAL mode; call it"},{"type":"text","text":" "},{"type":"text","text":"as the app moves to the background. Open one store per table at a time, and don’t open one from"},{"type":"text","text":" "},{"type":"text","text":"inside an access to the same database."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once a delivered record’s row is deleted, and in WAL mode once a later "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":" succeeds,"},{"type":"text","text":" "},{"type":"text","text":"nothing of it is left in the database’s main file or its "},{"type":"codeVoice","code":"-wal"},{"type":"text","text":" file. The store’s deletes run"},{"type":"text","text":" "},{"type":"text","text":"with SQLite’s "},{"type":"codeVoice","code":"secure_delete"},{"type":"text","text":" ON and its inserts with at least FAST, so freed pages and moved rows"},{"type":"text","text":" "},{"type":"text","text":"are zeroed, and the app’s own setting is put back after each. In WAL mode, "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":" "},{"type":"text","text":"truncates the log, which until then holds the deleted rows’ earlier bytes. While another"},{"type":"text","text":" "},{"type":"text","text":"connection reads or writes the database, such as a "},{"type":"codeVoice","code":"DatabasePool"},{"type":"text","text":" read whose transaction is still"},{"type":"text","text":" "},{"type":"text","text":"open, the log can’t be truncated, and the delivered records’ bytes, "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" values and session"},{"type":"text","text":" "},{"type":"text","text":"included, stay in the "},{"type":"codeVoice","code":"-wal"},{"type":"text","text":" file until a later "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":" runs after that connection is"},{"type":"text","text":" "},{"type":"text","text":"done. Inside a transaction, "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":" checkpoints nothing."}]},{"type":"paragraph","inlineContent":[{"text":"Nothing is promised outside those two files: a ","type":"text"},{"code":"-journal","type":"codeVoice"},{"text":" the app keeps with","type":"text"},{"text":" ","type":"text"},{"code":"journal_mode=PERSIST","type":"codeVoice"},{"text":" can hold earlier rows’ bytes, and the file system may keep the blocks a","type":"text"},{"text":" ","type":"text"},{"text":"truncated or deleted file gave up. ","type":"text"},{"code":"DatabaseStore","type":"codeVoice"},{"text":"’s documentation covers how long","type":"text"},{"text":" ","type":"text"},{"code":"synchronize()","type":"codeVoice"},{"text":" waits under each busy mode, and how a ","type":"text"},{"code":"DatabasePool","type":"codeVoice"},{"text":" empties the log itself.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An app with no database of its own uses "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":", which needs no GRDB."}]},{"code":["import GRDB","import GRDBPersistence","","let database = try DatabaseQueue(path: databasePath)","let store = try DatabaseStore(database: database, table: \"analyticsRecord\")","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)","tracker.track(SignedUp(plan: \"pro\"))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","type":"reference"},{"text":" ","type":"text"},{"text":"covers what a store keeps, its bounds and recovery.","type":"text"}]},{"type":"heading","text":"API","anchor":"API","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols"},{"type":"text","text":" "},{"type":"text","text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them"},{"type":"text","text":" "},{"type":"text","text":"for an Apple target."}]},{"type":"heading","text":"Keeping records in a database","anchor":"Keeping-records-in-a-database","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"DatabaseStore","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"DatabaseStoreError","type":"codeVoice"}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://Persistence/documentation/Persistence":{"identifier":"doc:\/\/Persistence\/documentation\/Persistence","role":"collection","title":"Persistence","type":"topic","url":"\/documentation\/persistence","abstract":[{"type":"text","text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending."}],"kind":"symbol"},"doc://GRDBPersistence/documentation/GRDBPersistence":{"type":"topic","title":"GRDBPersistence","url":"\/documentation\/grdbpersistence","abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","role":"collection"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/persistingrecords":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","type":"link","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","title":"Persisting Records","titleInlineContent":[{"type":"text","text":"Persisting Records"}]}}}