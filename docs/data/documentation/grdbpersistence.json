{"variants":[{"paths":["\/documentation\/grdbpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"DatabaseStore"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"RecordStore"},{"type":"text","text":" (module "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Persistence\/documentation\/Persistence"},{"type":"text","text":") for apps on Apple platforms that"},{"type":"text","text":" "},{"type":"text","text":"already keep a GRDB database. It takes the app’s "},{"type":"codeVoice","code":"DatabaseQueue"},{"type":"text","text":" or "},{"type":"codeVoice","code":"DatabasePool"},{"type":"text","text":" and a table"},{"type":"text","text":" "},{"type":"text","text":"name, creates the table with a migration of its own, and opens no second SQLite database. It is a"},{"type":"text","text":" "},{"type":"text","text":"product of its own, which "},{"type":"codeVoice","code":"import Traffluent"},{"type":"text","text":" leaves out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It makes the same promises as "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":". The tracker’s worker commits each record, in a"},{"type":"text","text":" "},{"type":"text","text":"transaction of its own, before publishing it. A batch’s rows are marked before any destination"},{"type":"text","text":" "},{"type":"text","text":"receives it and deleted once every destination has. The table holds at most "},{"type":"codeVoice","code":"byteBound"},{"type":"text","text":" bytes of"},{"type":"text","text":" "},{"type":"text","text":"encoded records, 5 MiB by default, with the oldest rows deleted to make room, and each drop is"},{"type":"text","text":" "},{"type":"text","text":"reported on "},{"type":"codeVoice","code":"DatabaseStore.dropReports"},{"type":"text","text":". Records are encoded as "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":" encodes them, and"},{"type":"text","text":" "},{"type":"text","text":"the same events are kept: every "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" in the program and the library’s own, or only the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" types "},{"type":"codeVoice","code":"DatabaseStore(events:database:)"},{"type":"text","text":" lists. Rows written by"},{"type":"text","text":" "},{"type":"text","text":"Traffluent 0.0.44 or earlier, in an earlier encoding, aren’t read: each is deleted when the store"},{"type":"text","text":" "},{"type":"text","text":"opens and reported as "},{"type":"codeVoice","code":".undecodable"},{"type":"text","text":", or as "},{"type":"codeVoice","code":".versionMismatch"},{"type":"text","text":" where its stored version differs"},{"type":"text","text":" "},{"type":"text","text":"from its type’s."}],"type":"paragraph"},{"inlineContent":[{"text":"How durable a commit is against power loss is the database’s choice, through its journal mode and","type":"text"},{"text":" ","type":"text"},{"code":"synchronous","type":"codeVoice"},{"text":" setting. ","type":"text"},{"code":"DatabaseStore.synchronize()","type":"codeVoice"},{"text":" checkpoints a database in WAL mode; call it","type":"text"},{"text":" ","type":"text"},{"text":"as the app moves to the background. Open one store per table at a time, and don’t open one from","type":"text"},{"text":" ","type":"text"},{"text":"inside an access to the same database.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An app with no database of its own uses "},{"type":"codeVoice","code":"SegmentStore"},{"type":"text","text":", which needs no GRDB."}],"type":"paragraph"},{"code":["import GRDB","import GRDBPersistence","","let database = try DatabaseQueue(path: databasePath)","let store = try DatabaseStore(database: database, table: \"analyticsRecord\")","let tracker = Tracker(store: store)","let delivery = tracker.records.batch().deliver(to: vendor)","tracker.track(SignedUp(plan: \"pro\"))"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The guide "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"covers what a store keeps, its bounds and recovery."}],"type":"paragraph"},{"text":"API","anchor":"API","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The documentation site is built on Linux, where this module’s API isn’t there, so its symbols"},{"type":"text","text":" "},{"type":"text","text":"have no pages of their own here. Their doc comments are in the sources, and Xcode shows them"},{"type":"text","text":" "},{"type":"text","text":"for an Apple target."}],"type":"paragraph"},{"text":"Keeping records in a database","anchor":"Keeping-records-in-a-database","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DatabaseStore"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DatabaseStoreError"}]}]}]}],"kind":"content"}],"metadata":{"symbolKind":"module","modules":[{"name":"GRDBPersistence"}],"roleHeading":"Framework","role":"collection","externalID":"GRDBPersistence","title":"GRDBPersistence"},"hierarchy":{"paths":[[]]},"sections":[],"abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","interfaceLanguage":"swift"},"references":{"doc://GRDBPersistence/documentation/GRDBPersistence":{"title":"GRDBPersistence","kind":"symbol","abstract":[{"text":"Keep each record in a table of the app’s own GRDB database until it is delivered.","type":"text"}],"url":"\/documentation\/grdbpersistence","type":"topic","identifier":"doc:\/\/GRDBPersistence\/documentation\/GRDBPersistence","role":"collection"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/persistingrecords":{"title":"Persisting Records","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/persistingrecords","type":"link","titleInlineContent":[{"text":"Persisting Records","type":"text"}]},"doc://Persistence/documentation/Persistence":{"title":"Persistence","type":"topic","role":"collection","url":"\/documentation\/persistence","abstract":[{"text":"Keep each record on disk until it is delivered, so the records a tracker tracked survive the app ending.","type":"text"}],"identifier":"doc:\/\/Persistence\/documentation\/Persistence","kind":"symbol"}}}