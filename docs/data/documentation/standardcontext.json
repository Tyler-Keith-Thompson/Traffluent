{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/standardcontext"]}],"hierarchy":{"paths":[[]]},"sections":[],"identifier":{"url":"doc:\/\/StandardContext\/documentation\/StandardContext","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"module","role":"collection","title":"StandardContext","externalID":"StandardContext","modules":[{"name":"StandardContext"}],"roleHeading":"Framework"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"Each standard value has an enricher of its own, and nothing is added to a record until the app","type":"text"},{"text":" ","type":"text"},{"text":"builds its tracker with that enricher. Each one sets a typed ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" key whose value a","type":"text"},{"text":" ","type":"text"},{"text":"destination reads from the record’s context: ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/ApplicationKey","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/DeviceKey","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/OperatingSystemKey","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/LocaleKey","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/NetworkKey","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The app, device, operating system and locale are read once, when the enricher is made, never per","type":"text"},{"text":" ","type":"text"},{"text":"event. The network connection changes while the app runs, so on Apple platforms ","type":"text"},{"code":"network()","type":"codeVoice"},{"text":" starts","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"code":"NWPathMonitor","type":"codeVoice"},{"text":" of its own and sets the latest connection on each record. Give each tracker its","type":"text"},{"text":" ","type":"text"},{"text":"own call. Off Apple platforms there is no device and no path monitor, so those two enrichers set","type":"text"},{"text":" ","type":"text"},{"text":"nothing, and a server or tool, whose process usually has no Info.plist, passes its own app to","type":"text"},{"text":" ","type":"text"},{"code":"application(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"vendorIdentifier()"},{"type":"text","text":", made on the main actor, adds the platform’s identifier for vendor as a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value. It is the one identifier here that outlives a session, so add it only when the"},{"type":"text","text":" "},{"type":"text","text":"app has decided to and has the user’s consent. It is never stored or made up: on macOS and Linux,"},{"type":"text","text":" "},{"type":"text","text":"which have none, records carry no key."}],"type":"paragraph"},{"inlineContent":[{"text":"For the session an event was tracked in, use ","type":"text"},{"code":"Sessions","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import StandardContext","import Trackers","","let tracker = Tracker(enrichers: [.application(), .operatingSystem(), .locale(), .network()])","tracker.track(SignedUp(plan: \"pro\"))","\/\/ A destination reads each value from the record's context:","\/\/ record.context[ApplicationKey.self]?.version, record.context[OperatingSystemKey.self]?.name"]},{"inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/sessionsandstandardcontext","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"covers each value and the identifier for vendor in more detail.","type":"text"}],"type":"paragraph"}]}],"topicSections":[{"anchor":"The-app","title":"The app","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/application(_:)","doc:\/\/StandardContext\/documentation\/StandardContext\/ApplicationKey"]},{"anchor":"The-device","title":"The device","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/device(_:)","doc:\/\/StandardContext\/documentation\/StandardContext\/DeviceKey"]},{"anchor":"The-operating-system","title":"The operating system","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/operatingSystem(_:)","doc:\/\/StandardContext\/documentation\/StandardContext\/OperatingSystemKey"]},{"anchor":"The-locale","title":"The locale","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/locale(_:)","doc:\/\/StandardContext\/documentation\/StandardContext\/LocaleKey"]},{"anchor":"The-network-connection","title":"The network connection","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/network()","doc:\/\/StandardContext\/documentation\/StandardContext\/NetworkKey"]},{"anchor":"The-identifier-for-vendor","title":"The identifier for vendor","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/vendorIde