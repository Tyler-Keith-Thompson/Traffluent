{"topicSections":[{"identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/application(_:)"],"title":"The app","anchor":"The-app"},{"identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/device(_:)"],"title":"The device","anchor":"The-device"},{"identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/operatingSystem(_:)"],"title":"The operating system","anchor":"The-operating-system"},{"identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/locale(_:)"],"title":"The locale","anchor":"The-locale"},{"identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/network()"],"title":"The network connection","anchor":"The-network-connection"},{"identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/vendorIdentifier()","doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey"],"title":"The identifier for vendor","anchor":"The-identifier-for-vendor"},{"anchor":"Extended-Modules","identifiers":["doc:\/\/StandardContext\/documentation\/StandardContext\/Events"],"title":"Extended Modules","generated":true}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each standard value has an enricher of its own, and nothing is added to a record until the app","type":"text"},{"text":" ","type":"text"},{"text":"builds its tracker with that enricher. Each one sets a typed ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" key whose value a","type":"text"},{"text":" ","type":"text"},{"text":"destination reads from the record’s context: ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/ApplicationKey","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/DeviceKey","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/OperatingSystemKey","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/LocaleKey","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/NetworkKey","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/VendorIdentifierKey","type":"reference","isActive":true},{"text":". The first five are in the ","type":"text"},{"code":"Events","type":"codeVoice"},{"text":" module, as a store keeps them beside","type":"text"},{"text":" ","type":"text"},{"text":"each record, so a record recovered after a relaunch carries the values it was tracked with. This","type":"text"},{"text":" ","type":"text"},{"text":"module reads the values the platform reports.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The app, device, operating system and locale are read once, when the enricher is made, never per","type":"text"},{"text":" ","type":"text"},{"text":"event. The network connection changes while the app runs, so on Apple platforms ","type":"text"},{"type":"codeVoice","code":"network()"},{"text":" starts","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"NWPathMonitor"},{"text":" of its own and sets the latest connection on each record. Give each tracker its","type":"text"},{"text":" ","type":"text"},{"text":"own call. Off Apple platforms there is no device and no path monitor, so those two enrichers set","type":"text"},{"text":" ","type":"text"},{"text":"nothing, and a server or tool, whose process usually has no Info.plist, passes its own app to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"application(_:)"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"vendorIdentifier()","type":"codeVoice"},{"text":", made on the main actor, adds the platform’s identifier for vendor as a","type":"text"},{"text":" ","type":"text"},{"code":"Sensitive","type":"codeVoice"},{"text":" value. It is the one identifier here that outlives a session, so add it only when the","type":"text"},{"text":" ","type":"text"},{"text":"app has decided to and has the user’s consent. It is never stored or made up: on macOS and Linux,","type":"text"},{"text":" ","type":"text"},{"text":"which have none, records carry no key, and a store never writes it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For the session an event was tracked in, use ","type":"text"},{"type":"codeVoice","code":"Sessions"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import StandardContext","import Trackers","","let tracker = Tracker(enrichers: [.application(), .operatingSystem(), .locale(), .network()])","tracker.track(SignedUp(plan: \"pro\"))","\/\/ A destination reads each value from the record's context:","\/\/ record.context[ApplicationKey.self]?.version, record.context[OperatingSystemKey.self]?.name"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/sessionsandstandardcontext"},{"type":"text","text":" "},{"type":"text","text":"covers each value and the identifier for vendor in more detail."}]}],"kind":"content"}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/StandardContext\/documentation\/StandardContext"},"sections":[],"metadata":{"modules":[{"name":"StandardContext"}],"symbolKind":"module","roleHeading":"Framework","title":"StandardContext","role":"collection","externalID":"StandardContext"},"variants":[{"paths":["\/documentation\/standardcontext"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"abstract":[{"text":"Stamp every event with the app, device, operating system, locale and network connection it was tracked on.","type":"text"}],"references":{"doc://StandardContext/documentation/StandardContext/Events/Enricher/network()":{"identifier":"doc:\/\/StandardContext\/documentation\/StandardContext\/Events\/Enricher\/network()","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"network"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events8EnricherV","text":"Enricher"}],"url":"\/documentation\/standardcontext\/events\/enricher\/network()","title":"network()","abstract":[{"type":"text","text":"An enricher that sets every record’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/NetworkKey"},{"type":"text","text":" to the connection the device uses when"},{"type":"text","text":" "},{"type":"text","text":"the tracker’s worker reaches it, or, given to a destination with "},{"type":"codeVoice","code":"enriched(by:)"},{"type":"text","text":", when the"},{"type":"text","text":" "},{"type":"text","text":"delivery hands that destination the record’s batch."}]},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/sessionsandstandardcontext":{"titleInlineContent":[{"type":"text","text":"Sessions and Standard Context"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/sessionsandstandardcontext","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/sessionsandstandardcontext","title":"Sessions and Standard Context","type":"link"},"doc://StandardContext/documentation/StandardContext/Events/Enricher/operatingSystem(_:)":{"title":"operatingSystem(_:)","ki