 "},{"kind":"keyword","text":"#file"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#fileID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"function"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#function"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#line"},{"kind":"text","text":", "},{"kind":"externalParam","text":"column"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#column"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NonPositiveSessionTimeout","preciseIdentifier":"s:8Sessions25NonPositiveSessionTimeoutV","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/NonPositiveSessionTimeout"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Enricher","preciseIdentifier":"s:6Events8EnricherV","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The inactivity after which the next event starts a new session."}]}],"name":"timeout"},{"content":[{"inlineContent":[{"type":"text","text":"The session events to track; both by default. Leaving one out, or both, tracks"},{"type":"text","text":" "},{"type":"text","text":"none of that kind, and every record still carries its session’s key."}],"type":"paragraph"}],"name":"kinds"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s file; leave it to its default."}]}],"name":"file"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s module and file name; leave it to its default.","type":"text"}]}],"name":"fileID"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s enclosing declaration; leave it to its default."}]}],"name":"function"},{"content":[{"inlineContent":[{"text":"The caller’s line; leave it to its default.","type":"text"}],"type":"paragraph"}],"name":"line"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s column; leave it to its default."}]}],"name":"column"}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The enricher, which runs on the tracker’s worker like any other.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Nothing is put in a session until the app turns it on, among the enrichers it builds its","type":"text"},{"text":" ","type":"text"},{"text":"tracker with, so every event the tracker tracks carries the key, through any copy of it:","type":"text"}],"type":"paragraph"},{"code":["let tracker = Tracker(enrichers: [.sessions()])"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Inactivity is measured between records’ timestamps, the time each event was tracked, and","type":"text"},{"text":" ","type":"text"},{"text":"not when the tracker’s worker reaches it. So the app returning from the background past the","type":"text"},{"text":" ","type":"text"},{"text":"timeout starts a new session with its first event, such as ","type":"text"},{"code":"ApplicationOpened","type":"codeVoice"},{"text":" (module","type":"text"},{"text":" ","type":"text"},{"code":"LifecycleTracking","type":"codeVoice"},{"text":"), and one returning sooner goes on with the same.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The first event the tracker tracks starts the first session: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted"},{"text":" comes","type":"text"},{"text":" ","type":"text"},{"text":"before it, stamped with its time. A session ends only when an event comes after the","type":"text"},{"text":" ","type":"text"},{"text":"timeout: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded"},{"text":", stamped with the time of the session’s last event, then","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted"},{"text":", stamped with the new event’s, come before that event. So a run’s last","type":"text"},{"text":" ","type":"text"},{"text":"session ends with no ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded"},{"text":": a destination takes its end from its last event. Each","type":"text"},{"text":" ","type":"text"},{"text":"session event carries the key of the session it starts or ends, and the context the event","type":"text"},{"text":" ","type":"text"},{"text":"that ended the session had when this enricher reached it; the enrichers after this one run","type":"text"},{"text":" ","type":"text"},{"text":"on them too. Their call site is this call’s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A session’s identifier is a version 7 UUID: the session’s start in Unix milliseconds, then"},{"type":"text","text":" "},{"type":"text","text":"random bits, never derived from the device, the user or another identifier. It is held in"},{"type":"text","text":" "},{"type":"text","text":"this enricher’s memory and nowhere else: neither a store nor anything else writes it to disk,"},{"type":"text","text":" "},{"type":"text","text":"and a new enricher, as on the next launch, starts with a new session. Records a store"},{"type":"text","text":" "},{"type":"text","text":"kept from an earlier run aren’t enriched again, so they carry no key."}],"type":"paragraph"},{"inlineContent":[{"text":"The enricher’s sessions are its own, created by this call: give each tracker its own call.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/NonPositiveSessionTimeout","isActive":true},{"type":"text","text":" when "},{"type":"codeVoice","code":"timeout"},{"type":"text","text":" is zero or less."}]}],"style":"note","type":"aside","name":"Throws"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Sessions\/documentation\/Sessions","doc:\/\/Sessions\/documentation\/Sessions\/Events","doc:\/\/Sessions\/documentation\/Sessions\/Events\/Enricher"]]},"abstract":[{"type":"text","text":"An enricher that puts every event in a session: it sets each record’s "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/SessionKey","isActive":true},{"type":"text","text":" to its"},{"type":"text","text":" "},{"type":"text","text":"session’s identifier, and starts a new session when an event comes "},{"type":"codeVoice","code":"timeout"},{"type":"text","text":" or more after"},{"type":"text","text":" "},{"type":"text","text":"the one before it, tracking "},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true},{"type":"text","text":" before that event."}],"identifier":{"url":"doc:\/\/Sessions\/documentation\/Sessions\/Events\/Enricher\/sessions(timeout:kinds:file:fileID:function:line:column:)","interfaceLanguage":"swift"},"secti