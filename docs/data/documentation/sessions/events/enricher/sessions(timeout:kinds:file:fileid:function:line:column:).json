t":" and "},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","isActive":true,"type":"reference"},{"type":"text","text":" before that event."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sessions","kind":"identifier"},{"text":"(","kind":"text"},{"text":"timeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":", ","kind":"text"},{"text":"kinds","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"SessionEventKind","kind":"typeIdentifier","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEventKind","preciseIdentifier":"s:8Sessions16SessionEventKindO"},{"text":"> = Set(SessionEventKind.allCases), ","kind":"text"},{"text":"file","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#file","kind":"keyword"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#fileID","kind":"keyword"},{"text":", ","kind":"text"},{"text":"function","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#function","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NonPositiveSessionTimeout","kind":"typeIdentifier","identifier":"doc:\/\/Sessions\/documentation\/Sessions\/NonPositiveSessionTimeout","preciseIdentifier":"s:8Sessions25NonPositiveSessionTimeoutV"},{"text":") -> ","kind":"text"},{"text":"Enricher","kind":"typeIdentifier","identifier":"doc:\/\/Events\/documentation\/Events\/Enricher","preciseIdentifier":"s:6Events8EnricherV"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"timeout","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The inactivity after which the next event starts a new session."}]}]},{"name":"kinds","content":[{"type":"paragraph","inlineContent":[{"text":"The session events to track; both by default. Leaving one out, or both, tracks","type":"text"},{"text":" ","type":"text"},{"text":"none of that kind, and every record still carries its session’s key.","type":"text"}]}]},{"name":"file","content":[{"inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}],"type":"paragraph"}]},{"name":"fileID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}]}]},{"name":"function","content":[{"inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}],"type":"paragraph"}]},{"name":"line","content":[{"inlineContent":[{"text":"The caller’s line; leave it to its default.","type":"text"}],"type":"paragraph"}]},{"name":"column","content":[{"inlineContent":[{"type":"text","text":"The caller’s column; leave it to its default."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The enricher, which runs on the tracker’s worker like any other.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing is put in a session until the app turns it on, among the enrichers it builds its"},{"type":"text","text":" "},{"type":"text","text":"tracker with, so every event the tracker tracks carries the key, through any copy of it:"}]},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker(enrichers: [.sessions()])"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inactivity is measured between records’ timestamps, the time each event was tracked, and"},{"type":"text","text":" "},{"type":"text","text":"not when the tracker’s worker reaches it. So the app returning from the background past the"},{"type":"text","text":" "},{"type":"text","text":"timeout starts a new session with its first event, such as "},{"type":"codeVoice","code":"ApplicationOpened"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"codeVoice","code":"LifecycleTracking"},{"type":"text","text":"), and one returning sooner goes on with the same."}]},{"type":"paragraph","inlineContent":[{"text":"The first event the tracker tracks starts the first session: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","type":"reference"},{"text":" comes","type":"text"},{"text":" ","type":"text"},{"text":"before it, stamped with its time. A session ends only when an event comes after the","type":"text"},{"text":" ","type":"text"},{"text":"timeout: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","type":"reference"},{"text":", stamped with the time of the session’s last event, then","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionStarted","type":"reference"},{"text":", stamped with the new event’s, come before that event. So a run’s last","type":"text"},{"text":" ","type":"text"},{"text":"session ends with no ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/SessionEnded","type":"reference"},{"text":": a destination takes its end from its last event. Each","type":"text"},{"text":" ","type":"text"},{"text":"session event carries the key of the session it starts or ends, and the context the event","type":"text"},{"text":" ","type":"text"},{"text":"that ended the session had when this enricher reached it; the enrichers after this one run","type":"text"},{"text":" ","type":"text"},{"text":"on them too. Their call site is this call’s.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A session’s identifier is a version 7 UUID: the session’s start in Unix milliseconds, then"},{"type":"text","text":" "},{"type":"text","text":"random bits, never derived from the device, the user or another identifier. It is held in"},{"type":"text","text":" "},{"type":"text","text":"this enricher’s memory and nowhere else: neither a store nor anything else writes it to disk,"},{"type":"text","text":" "},{"type":"text","text":"and a new enricher, as on the next launch, starts with a new session. Records a store"},{"type":"text","text":" "},{"type":"text","text":"kept from an earlier run aren’t enriched again, so they carry no key."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The enricher’s sessions are its own, created by this call: give each tracker its own call."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/Sessions\/documentation\/Sessions\/NonPositiveSessionTimeout","isActive":true,"type":"reference"},{"text":" when ","type":"text"},{"code":"timeout","type":"codeVoice"},{"text":" is zero or less.","type":"text"}]}],"name":"Throws","style":"note"}]}],"secti