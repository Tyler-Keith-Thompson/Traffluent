xt","text":"("},{"type":"codeVoice","code":"com.acme"},{"type":"text","text":"): the one the tracking plan’s Iglu export is given."}]}],"name":"vendor"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The app’s ID, each event’s ","type":"text"},{"code":"aid","type":"codeVoice"},{"text":", which tells apart the apps and sites that send","type":"text"},{"text":" ","type":"text"},{"text":"to one pipeline.","type":"text"}]}],"name":"appID"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}]}],"name":"plan"},{"content":[{"inlineContent":[{"type":"text","text":"What sends each request."}],"type":"paragraph"}],"name":"transport"},{"content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The clock the waits are measured on.","type":"text"}]}],"name":"clock"}]},{"content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The destination posts to the collector’s "},{"type":"codeVoice","code":"\/com.snowplowanalytics.snowplow\/tp2"},{"type":"text","text":", the tracker"},{"type":"text","text":" "},{"type":"text","text":"protocol’s endpoint, encoded by a "},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","type":"reference","isActive":true},{"type":"text","text":" within"},{"type":"text","text":" "},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","type":"reference","isActive":true},{"type":"text","text":", and sends no trace context in its header fields. It"},{"type":"text","text":" "},{"type":"text","text":"retries no response, a 5xx, 408 or 429, and drops and reports any other status, such as 413"},{"type":"text","text":" "},{"type":"text","text":"for a body over the collector’s limit."}],"type":"paragraph"},{"inlineContent":[{"text":"Every request carries ","type":"text"},{"code":"SP-Anonymous: *","type":"codeVoice"},{"text":", so the collector sets no ","type":"text"},{"code":"sp","type":"codeVoice"},{"text":" cookie, reads none,","type":"text"},{"text":" ","type":"text"},{"text":"takes ","type":"text"},{"code":"network_userid","type":"codeVoice"},{"text":" as all zeros, and records no IP address or forwarding header fields.","type":"text"},{"text":" ","type":"text"},{"text":"Without it the collector would set a cookie that ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" keeps and sends back, an","type":"text"},{"text":" ","type":"text"},{"text":"identifier lasting across sessions (D4).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A collector takes events from anyone who can reach it, so the destination needs no key or","type":"text"},{"text":" ","type":"text"},{"text":"secret, and builds on every platform.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Throws","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowSetupError\/invalidCollector","isActive":true},{"type":"text","text":" for a collector URL that isn’t "},{"type":"codeVoice","code":"https"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"has no host name, has a user name or password, a query or fragment, or a path ending in"},{"type":"text","text":" "},{"type":"codeVoice","code":"tp2"},{"type":"text","text":" or "},{"type":"codeVoice","code":"com.snowplowanalytics.snowplow