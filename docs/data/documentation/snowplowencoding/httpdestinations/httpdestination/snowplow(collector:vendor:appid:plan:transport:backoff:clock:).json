https:\/\/collector.example.com"},{"type":"text","text":"), a path included"},{"type":"text","text":" "},{"type":"text","text":"where it is served under one. Not the endpoint: the destination appends"},{"type":"text","text":" "},{"type":"codeVoice","code":"\/com.snowplowanalytics.snowplow\/tp2"},{"type":"text","text":" itself."}]}],"name":"collector"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The Iglu vendor of the events’ schemas, in reverse domain notation","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"com.acme","type":"codeVoice"},{"text":"): the one the tracking plan’s Iglu export is given.","type":"text"}]}],"name":"vendor"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app’s ID, each event’s "},{"code":"aid","type":"codeVoice"},{"type":"text","text":", which tells apart the apps and sites that send"},{"type":"text","text":" "},{"type":"text","text":"to one pipeline."}]}],"name":"appID"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tracking plan of every event the destination is given."}]}],"name":"plan"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What sends each request."}]}],"name":"transport"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}]}],"name":"backoff"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock the waits are measured on."}]}],"name":"clock"}]},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The destination.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The destination posts to the collector’s ","type":"text"},{"code":"\/com.snowplowanalytics.snowplow\/tp2","type":"codeVoice"},{"text":", the tracker","type":"text"},{"text":" ","type":"text"},{"text":"protocol’s endpoint, encoded by a ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","isActive":true,"type":"reference"},{"text":" within","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","isActive":true,"type":"reference"},{"text":", and sends no trace context in its header fields. It","type":"text"},{"text":" ","type":"text"},{"text":"retries no response, a 5xx, 408 or 429, and drops and reports any other status, such as 413","type":"text"},{"text":" ","type":"text"},{"text":"for a body over the collector’s limit.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every request carries "},{"code":"SP-Anonymous: *","type":"codeVoice"},{"type":"text","text":", so the collector sets no "},{"code":"sp","type":"codeVoice"},{"type":"text","text":" cookie, reads none,"},{"type":"text","text":" "},{"type":"text","text":"takes "},{"code":"network_userid","type":"codeVoice"},{"type":"text","text":" as all zeros, and records no IP address or forwarding header fields."},{"type":"text","text":" "},{"type":"text","text":"Without it the collector would set a cookie that "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" keeps and sends back, an"},{"type":"text","text":" "},{"type":"text","text":"identifier lasting across sessions (D4)."}],"type":"paragraph"},{"inlineContent":[{"text":"A collector takes events from anyone who can reach it, so the destination needs no key or","type":"text"},{"text":" ","type":"text"},{"text":"secret, and builds on every platform.","type":"text"}],"type":"paragraph"},{"name":"Throws","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","ide