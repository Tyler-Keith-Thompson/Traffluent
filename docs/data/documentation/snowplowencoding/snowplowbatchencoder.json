Source":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SnowplowEncoding\/SnowplowBatchEncoder.swift#L94","fileName":"SnowplowBatchEncoder.swift"},"symbolKind":"struct","externalID":"s:16SnowplowEncoding0A12BatchEncoderV","roleHeading":"Structure","navigatorTitle":[{"text":"SnowplowBatchEncoder","kind":"identifier"}],"modules":[{"name":"SnowplowEncoding"}],"title":"SnowplowBatchEncoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SnowplowBatchEncoder","kind":"identifier"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Make the destination with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:backoff:clock:)","type":"reference"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"fills in the endpoint, the header field that keeps the collector from setting a cookie or","type":"text"},{"text":" ","type":"text"},{"text":"recording the request’s address, this encoder and its limits:","type":"text"}]},{"code":["let snowplow = try HTTPDestination.snowplow(","    collector: collector,  \/\/ https:\/\/collector.example.com","    vendor: \"com.example\",  \/\/ your schemas' Iglu vendor","    appID: \"shop-ios\",","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a self-describing JSON object of content type "},{"code":"application\/json","type":"codeVoice"},{"type":"text","text":", of the schema"},{"type":"text","text":" "},{"code":"iglu:com.snowplowanalytics.snowplow\/payload_data\/jsonschema\/1-0-4","type":"codeVoice"},{"type":"text","text":", whose "},{"code":"data","type":"codeVoice"},{"type":"text","text":" is an array of"},{"type":"text","text":" "},{"type":"text","text":"events, one per record, oldest first. Every member of an event is a string, as the tracker"},{"type":"text","text":" "},{"type":"text","text":"protocol has them:"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"aid"}]}],[{"type":"paragraph","inlineContent":[{"text":"The app ID the encoder is made with","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"co","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context’s entities (below), as the text of a self-describing JSON array of "},{"type":"codeVoice","code":"contexts"},{"type":"text","text":"; left out when there are none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dtm"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ttm"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in epoch milliseconds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"e"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ue"},{"text":", a self-describing event","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"eid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"code":"EventRecord\/id","type":"codeVoice"},{"text":", as a lowercase UUID; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ip"}]}],[{"type":"paragraph","inlineContent":[{"code":"0.0.0.0","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"p","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The platform: ","type":"text"},{"code":"mob","type":"codeVoice"},{"text":" for a phone, pad, watch or Vision Pro, ","type":"text"},{"code":"tv","type":"codeVoice"},{"text":" for an Apple TV, ","type":"text"},{"code":"pc","type":"codeVoice"},{"text":" for a Mac, and ","type":"text"},{"code":"app","type":"codeVoice"},{"text":" when the record has no device in its context","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sid"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID; left out when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"tv"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"traffluent"},{"text":", the tracker","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ue_pr"}]}],[{"type":"paragraph","inlineContent":[{"text":"The event, as the text of a self-describing JSON ","type":"text"},{"code":"unstruct_event","type":"codeVoice"},{"text":" holding the event’s own self-describing JSON: its schema, ","type":"text"},{"code":"iglu:<vendor>\/<name>\/jsonschema\/<version>-0-0","type":"codeVoice"},{"text":", and its data, its stored properties by name","type":"text"}]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"code":"duid","type":"codeVoice"},{"type":"text","text":", "},{"code":"uid","type":"codeVoice"},{"type":"text","text":", "},{"code":"nuid","type":"codeVoice"},{"type":"text","text":" or "},{"code":"tnuid","type":"codeVoice"},{"type":"text","text":", no"},{"type":"text","text":" "},{"code":"client_session","type":"codeVoice"},{"type":"text","text":" entity, whose "},{"code":"userId","type":"codeVoice"},{"type":"text","text":" lasts across sessions, and no "},{"code":"appleIdfv","type":"codeVoice"},{"type":"text","text":", "},{"code":"appleIdfa","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or other device identifier. Snowplow’s "},{"code":"domain_sessionid","type":"codeVoice"},{"type":"text","text":" is the session; a record with no"},{"type":"text","text":" "},{"type":"text","text":"session (one tracked by a tracker without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":") is sent without one, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing. A record a store recovers after a relaunch keeps its session, so it goes out with the"},{"type":"text","text":" "},{"code":"sid","type":"codeVoice"},{"type":"text","text":" of its first send. The record’s vendor"},{"type":"text","text":" "},{"type":"text","text":"identifier and trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"text":"Each event’s ","type":"text"},{"type":"codeVoice","code":"ttm"},{"text":", its true timestamp, is the record’s timestamp, as is ","type":"text"},{"type":"codeVoice","code":"dtm"},{"text":", so Snowplow’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"derived_tstamp"},{"text":" is when the event was tracked, uncorrected for the device’s clock. No ","type":"text"},{"type":"codeVoice","code":"stm"},{"text":" ","type":"text"},{"text":"is sent: a retried request sends the same body again, so a sent time would be the first","type":"text"},{"text":" ","type":"text"},{"text":"attempt’s, and Snowplow would move the event later by however long the retries took.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The event’s schema is named after its "},{"type":"codeVoice","code":"Event\/name"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Event\/schemaVersion"},{"type":"text","text":": version N is"},{"type":"text","text":" "},{"type":"text","text":"SchemaVer "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":". Each version of an event is a breaking change, a SchemaVer MODEL. A"},{"type":"text","text":" "},{"type":"text","text":"compatible change at the same version is an ADDITION, which the tracking plan’s Iglu export"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"TrackingPlan\/writeIgluRegistry(to:vendor:registry:)"},{"type":"text","text":") writes for Iglu Server as "},{"type":"codeVoice","code":"N-0-1"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"on, each superseding the ones before, so an event naming "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":" is validated against the"},{"type":"text","text":" "},{"type":"text","text":"newest of them. A static repository doesn’t supersede: there an event naming "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"validated against "},{"type":"codeVoice","code":"N-0-0"},{"type":"text","text":" alone, so the export refuses an addition for one, and a change to an"},{"type":"text","text":" "},{"type":"text","text":"event needs a new version."}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":", as ","type":"text"},{"type":"codeVoice","code":"PropertyReader"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"data then validates against the event’s exported schema, which never requires a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" ","type":"text"},{"text":"property.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"co"},{"type":"text","text":" holds these entities, for the keys the record’s context has values for:"}]},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Entity"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Keys"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"iglu:com.snowplowanalytics.snowplow\/mobile_context\/jsonschema\/1-0-3","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DeviceKey"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"OperatingSystemKey"},{"text":", both; ","type":"text"},{"type":"codeVoice","code":"NetworkKey"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"LocaleKey"},{"text":" if present","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"osType"},{"text":" (","type":"text"},{"type":"codeVoice","code":"ios"},{"text":", ","type":"text"},{"type":"codeVoice","code":"tvos"},{"text":", ","type":"text"},{"type":"codeVoice","code":"watchos"},{"text":", ","type":"text"},{"type":"codeVoice","code":"visionos"},{"text":", ","type":"text"},{"type":"codeVoice","code":"osx"},{"text":"), ","type":"text"},{"type":"codeVoice","code":"osVersion"},{"text":", ","type":"text"},{"type":"codeVoice","code":"deviceManufacturer"},{"text":" (","type":"text"},{"type":"codeVoice","code":"Apple Inc."},{"text":"), ","type":"text"},{"type":"codeVoice","code":"deviceModel"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"networkType"},{"text":" (","type":"text"},{"type":"codeVoice","code":"wifi"},{"text":", ","type":"text"},{"type":"codeVoice","code":"mobile"},{"text":", ","type":"text"},{"type":"codeVoice","code":"offline"},{"text":"; left out for a wired or other connection); ","type":"text"},{"type":"codeVoice","code":"language"},{"text":", the locale’s language code","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"iglu:com.snowplowanalytics.mobile\/application\/jsonschema\/1-0-0","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ApplicationKey"},{"type":"text","text":", with both a version and a build"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"version"},{"type":"text","text":" and "},{"type":"codeVoice","code":"build"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name Iglu doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"take, one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp","type":"text"},{"text":" ","type":"text"},{"text":"is outside the years 0 to 9999, and one whose JSON is over 150,000 bytes","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","isActive":true,"type":"reference"},{"text":").","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","isActive":true,"type":"reference"},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","type":"reference"},{"type":"text","text":" splits a batch into requests within the encoder’s limit, "},{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","type":"reference"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default, and makes none for a batch with no record it can write, so "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"nothing for it. The collector answers 200 to every request it can read, and Snowplow validates"},{"type":"text","text":" "},{"type":"text","text":"the events afterwards: an event whose data its schema rejects, or whose schema the pipeline’s"},{"type":"text","text":" "},{"type":"text","text":"Iglu resolver can’t find, becomes a failed event, kept apart from the warehouse, though the"},{"type":"text","text":" "},{"type":"text","text":"destination counts it as delivered. The bytes are the same for the same records on every run"},{"type":"text","text":" "},{"type":"text","text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/snowplowencoding\/snowplowbatchencoder"]}],"identifier":{"url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://SnowplowEncoding/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/SnowplowEncoding\/s8SendableP"}