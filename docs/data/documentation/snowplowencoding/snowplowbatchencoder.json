wEncoding\/SnowplowBatchEncoder\/Failure"]},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/transientStatuses"]},{"title":"Type Methods","generated":true,"anchor":"Type-Methods","identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/outcome(of:for:)"]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/SnowplowEncoding\/s8SendableP","doc:\/\/SnowplowEncoding\/s16SendableMetatypeP"],"kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SnowplowBatchEncoder","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with"},{"type":"text","text":" "},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:backoff:clock:)","isActive":true,"type":"reference"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"fills in the endpoint, the header field that keeps the collector from setting a cookie or"},{"type":"text","text":" "},{"type":"text","text":"recording the request’s address, this encoder and its limits:"}]},{"code":["let snowplow = try HTTPDestination.snowplow(","    collector: collector,  \/\/ https:\/\/collector.example.com","    vendor: \"com.example\",  \/\/ your schemas' Iglu vendor","    appID: \"shop-ios\",","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a self-describing JSON object of content type "},{"type":"codeVoice","code":"application\/json"},{"type":"text","text":", of the schema"},{"type":"text","text":" "},{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/payload_data\/jsonschema\/1-0-4"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"data"},{"type":"text","text":" is an array of"},{"type":"text","text":" "},{"type":"text","text":"events, one per record, oldest first. Every member of an event is a string, as the tracker"},{"type":"text","text":" "},{"type":"text","text":"protocol has them:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Member","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Holds","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"aid"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The app ID the encoder is made with"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"co"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The standard context’s entities (below), as the text of a self-describing JSON array of "},{"type":"codeVoice","code":"contexts"},{"type":"text","text":"; left out when there are none"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"dtm"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ttm"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in epoch milliseconds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"e"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ue"},{"type":"text","text":", a self-describing event"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"eid","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s "},{"type":"codeVoice","code":"EventRecord\/id"},{"type":"text","text":", as a lowercase UUID; a redelivered record keeps it"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ip"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"0.0.0.0"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"p"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The platform: "},{"type":"codeVoice","code":"mob"},{"type":"text","text":" for a phone, pad, watch or Vision Pro, "},{"type":"codeVoice","code":"tv"},{"type":"text","text":" for an Apple TV, "},{"type":"codeVoice","code":"pc"},{"type":"text","text":" for a Mac, and "},{"type":"codeVoice","code":"app"},{"type":"text","text":" when the record has no device in its context"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"sid","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s session, its ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", as a lowercase UUID; left out when its context has no session","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"tv","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"traffluent","type":"codeVoice"},{"type":"text","text":", the tracker"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ue_pr"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event, as the text of a self-describing JSON ","type":"text"},{"type":"codeVoice","code":"unstruct_event"},{"text":" holding the event’s own self-describing JSON: its schema, ","type":"text"},{"type":"codeVoice","code":"iglu:<vendor>\/<name>\/jsonschema\/<version>-0-0"},{"text":", and its data, its stored properties by name","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"code":"duid","type":"codeVoice"},{"type":"text","text":", "},{"code":"uid","type":"codeVoice"},{"type":"text","text":", "},{"code":"nuid","type":"codeVoice"},{"type":"text","text":" or "},{"code":"tnuid","type":"codeVoice"},{"type":"text","text":", no"},{"type":"text","text":" "},{"code":"client_session","type":"codeVoice"},{"type":"text","text":" entity, whose "},{"code":"userId","type":"codeVoice"},{"type":"text","text":" lasts across sessions, and no "},{"code":"appleIdfv","type":"codeVoice"},{"type":"text","text":", "},{"code":"appleIdfa","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or other device identifier. Snowplow’s "},{"code":"domain_sessionid","type":"codeVoice"},{"type":"text","text":" is the session; a record with no"},{"type":"text","text":" "},{"type":"text","text":"session (one tracked by a tracker without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":") is sent without one, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing. A record a store recovers after a relaunch keeps its session, so it goes out with the"},{"type":"text","text":" "},{"code":"sid","type":"codeVoice"},{"type":"text","text":" of its first send. The record’s vendor"},{"type":"text","text":" "},{"type":"text","text":"identifier and trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each event’s "},{"type":"codeVoice","code":"ttm"},{"type":"text","text":", its true timestamp, is the record’s timestamp, as is "},{"type":"codeVoice","code":"dtm"},{"type":"text","text":", so Snowplow’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"derived_tstamp"},{"type":"text","text":" is when the event was tracked, uncorrected for the device’s clock. No "},{"type":"codeVoice","code":"stm"},{"type":"text","text":" "},{"type":"text","text":"is sent: a retried request sends the same body again, so a sent time would be the first"},{"type":"text","text":" "},{"type":"text","text":"attempt’s, and Snowplow would move the event later by however long the retries took."}]},{"type":"paragraph","inlineContent":[{"text":"The event’s schema is named after its ","type":"text"},{"code":"Event\/name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Event\/schemaVersion","type":"codeVoice"},{"text":": version N is","type":"text"},{"text":" ","type":"text"},{"text":"SchemaVer ","type":"text"},{"code":"N-0-0","type":"codeVoice"},{"text":". Each version of an event is a breaking change, a SchemaVer MODEL. A","type":"text"},{"text":" ","type":"text"},{"text":"compatible change at the same version is an ADDITION, which the tracking plan’s Iglu export","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"TrackingPlan\/writeIgluRegistry(to:vendor:registry:)","type":"codeVoice"},{"text":") writes for Iglu Server as ","type":"text"},{"code":"N-0-1","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"on, each superseding the ones before, so an event naming ","type":"text"},{"code":"N-0-0","type":"codeVoice"},{"text":" is validated against the","type":"text"},{"text":" ","type":"text"},{"text":"newest of them. A static repository doesn’t supersede: there an event naming ","type":"text"},{"code":"N-0-0","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"validated against ","type":"text"},{"code":"N-0-0","type":"codeVoice"},{"text":" alone, so the export refuses an addition for one, and a change to an","type":"text"},{"text":" ","type":"text"},{"text":"event needs a new version.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in ","type":"text"},{"type":"codeVoice","code":"plan"},{"text":", as ","type":"text"},{"type":"codeVoice","code":"PropertyReader"},{"text":" reads them. A","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"text":" value is never sent, whatever the record reveals: the property is left","type":"text"},{"text":" ","type":"text"},{"text":"out, an element of an array is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":", and one inside a type the plan can’t map is ","type":"text"},{"type":"codeVoice","code":"null"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"data then validates against the event’s exported schema, which never requires a ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" ","type":"text"},{"text":"property.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"co","type":"codeVoice"},{"text":" holds these entities, for the keys the record’s context has values for:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Entity"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/mobile_context\/jsonschema\/1-0-3"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeviceKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OperatingSystemKey"},{"type":"text","text":", both; "},{"type":"codeVoice","code":"NetworkKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"LocaleKey"},{"type":"text","text":" if present"}]}],[{"type":"paragraph","inlineContent":[{"code":"osType","type":"codeVoice"},{"text":" (","type":"text"},{"code":"ios","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tvos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"watchos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"visionos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"osx","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"osVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"deviceManufacturer","type":"codeVoice"},{"text":" (","type":"text"},{"code":"Apple Inc.","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"deviceModel","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"networkType","type":"codeVoice"},{"text":" (","type":"text"},{"code":"wifi","type":"codeVoice"},{"text":", ","type":"text"},{"code":"mobile","type":"codeVoice"},{"text":", ","type":"text"},{"code":"offline","type":"codeVoice"},{"text":"; left out for a wired or other connection); ","type":"text"},{"code":"language","type":"codeVoice"},{"text":", the locale’s language code","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"iglu:com.snowplowanalytics.mobile\/application\/jsonschema\/1-0-0","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"},{"text":", with both a version and a build","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"version"},{"type":"text","text":" and "},{"type":"codeVoice","code":"build"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name Iglu doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"take, one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp","type":"text"},{"text":" ","type":"text"},{"text":"is outside the years 0 to 9999, and one whose JSON is over 150,000 bytes","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","type":"reference","isActive":true},{"text":").","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. The collector answers 200 to every request it can read, and Snowplow validates","type":"text"},{"text":" ","type":"text"},{"text":"the events afterwards: an event whose data its schema rejects, or whose schema the pipeline’s","type":"text"},{"text":" ","type":"text"},{"text":"Iglu resolver can’t find, becomes a failed event, kept apart from the warehouse, though the","type":"text"},{"text":" ","type":"text"},{"text":"destination counts it as delivered. The bytes are the same for the same records on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}]}],"kind":"content"}],"references":{"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowEncodingError":{"type":"topic","identifier":"doc:\/\/SnowplowEncoding\/docu