ation\/snowplowencoding\/snowplowbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding"]]},"sections":[],"metadata":{"externalID":"s:16SnowplowEncoding0A12BatchEncoderV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SnowplowBatchEncoder","kind":"identifier"}],"role":"symbol","symbolKind":"struct","title":"SnowplowBatchEncoder","modules":[{"name":"SnowplowEncoding"}],"navigatorTitle":[{"text":"SnowplowBatchEncoder","kind":"identifier"}],"roleHeading":"Structure","remoteSource":{"fileName":"SnowplowBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SnowplowEncoding\/SnowplowBatchEncoder.swift#L94"}},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SnowplowBatchEncoder","kind":"identifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make the destination with"},{"type":"text","text":" "},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:backoff:clock:)","isActive":true,"type":"reference"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"fills in the endpoint, the header field that keeps the collector from setting a cookie or"},{"type":"text","text":" "},{"type":"text","text":"recording the request’s address, this encoder and its limits:"}]},{"code":["let snowplow = try HTTPDestination.snowplow(","    collector: collector,  \/\/ https:\/\/collector.example.com","    vendor: \"com.example\",  \/\/ your schemas' Iglu vendor","    appID: \"shop-ios\",","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The body is a self-describing JSON object of content type ","type":"text"},{"type":"codeVoice","code":"application\/json"},{"text":", of the schema","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/payload_data\/jsonschema\/1-0-4"},{"text":", whose ","type":"text"},{"type":"codeVoice","code":"data"},{"text":" is an array of","type":"text"},{"text":" ","type":"text"},{"text":"events, one per record, oldest first. Every member of an event is a string, as the tracker","type":"text"},{"text":" ","type":"text"},{"text":"protocol has them:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Member"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"aid"}]}],[{"type":"paragraph","inlineContent":[{"text":"The app ID the encoder is made with","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"co"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard context’s entities (below), as the text of a self-describing JSON array of "},{"type":"codeVoice","code":"contexts"},{"type":"text","text":"; left out when there are none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dtm"},{"type":"text","text":", "},{"type":"codeVoice","code":"ttm"}]}],[{"type":"paragraph","inlineContent":[{"text":"When the event was tracked, in epoch milliseconds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"e","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ue"},{"text":", a self-describing event","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"eid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID; a redelivered record keeps it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"ip","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"0.0.0.0","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"p"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The platform: "},{"code":"mob","type":"codeVoice"},{"type":"text","text":" for a phone, pad, watch or Vision Pro, "},{"code":"tv","type":"codeVoice"},{"type":"text","text":" for an Apple TV, "},{"code":"pc","type":"codeVoice"},{"type":"text","text":" for a Mac, and "},{"code":"app","type":"codeVoice"},{"type":"text","text":" when the record has no device in its context"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sid","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID; left out when its context has no session"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"tv"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"traffluent"},{"type":"text","text":", the tracker"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"ue_pr","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The event, as the text of a self-describing JSON "},{"type":"codeVoice","code":"unstruct_event"},{"type":"text","text":" holding the event’s own self-describing JSON: its schema, "},{"type":"codeVoice","code":"iglu:<vendor>\/<name>\/jsonschema\/<version>-0-0"},{"type":"text","text":", and its data, its stored properties by name"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"type":"codeVoice","code":"duid"},{"type":"text","text":", "},{"type":"codeVoice","code":"uid"},{"type":"text","text":", "},{"type":"codeVoice","code":"nuid"},{"type":"text","text":" or "},{"type":"codeVoice","code":"tnuid"},{"type":"text","text":", no"},{"type":"text","text":" "},{"type":"codeVoice","code":"client_session"},{"type":"text","text":" entity, whose "},{"type":"codeVoice","code":"userId"},{"type":"text","text":" lasts across sessions, and no "},{"type":"codeVoice","code":"appleIdfv"},{"type":"text","text":", "},{"type":"codeVoice","code":"appleIdfa"},{"type":"text","text":" "},{"type":"text","text":"or other device identifier. Snowplow’s "},{"type":"codeVoice","code":"domain_sessionid"},{"type":"text","text":" is the session; a record with no"},{"type":"text","text":" "},{"type":"text","text":"session (one tracked by a tracker without "},{"type":"codeVoice","code":"Enricher.sessions()"},{"type":"text","text":") is sent without one, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing. A record a store recovers after a relaunch keeps its session, so it goes out with the"},{"type":"text","text":" "},{"type":"codeVoice","code":"sid"},{"type":"text","text":" of its first send. The record’s vendor"},{"type":"text","text":" "},{"type":"text","text":"identifier and trace context, and any other context value, aren’t sent."}]},{"type":"paragraph","inlineContent":[{"text":"Each event’s ","type":"text"},{"type":"codeVoice","code":"ttm"},{"text":", its true timestamp, is the record’s timestamp, as is ","type":"text"},{"type":"codeVoice","code":"dtm"},{"text":", so Snowplow’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"derived_tstamp"},{"text":" is when the event was tracked, uncorrected for the device’s clock. No ","type":"text"},{"type":"codeVoice","code":"stm"},{"text":" ","type":"text"},{"text":"is sent: a retried request sends the same body again, so a sent time would be the first","type":"text"},{"text":" ","type":"text"},{"text":"attempt’s, and Snowplow would move the event later by however long the retries took.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The event’s schema is named after its ","type":"text"},{"type":"codeVoice","code":"Event\/name"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Event\/schemaVersion"},{"text":": version N is","type":"text"},{"text":" ","type":"text"},{"text":"SchemaVer ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":". Each version of an event is a breaking change, a SchemaVer MODEL. A","type":"text"},{"text":" ","type":"text"},{"text":"compatible change at the same version is an ADDITION, which the tracking plan’s Iglu export","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"TrackingPlan\/writeIgluRegistry(to:vendor:registry:)"},{"text":") writes for Iglu Server as ","type":"text"},{"type":"codeVoice","code":"N-0-1"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"on, each superseding the ones before, so an event naming ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":" is validated against the","type":"text"},{"text":" ","type":"text"},{"text":"newest of them. A static repository doesn’t supersede: there an event naming ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"validated against ","type":"text"},{"type":"codeVoice","code":"N-0-0"},{"text":" alone, so the export refuses an addition for one, and a change to an","type":"text"},{"text":" ","type":"text"},{"text":"event needs a new version.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"code":"plan","type":"codeVoice"},{"type":"text","text":", as "},{"code":"PropertyReader","type":"codeVoice"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","type":"reference","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"code":"null","type":"codeVoice"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"code":"null","type":"codeVoice"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"data then validates against the event’s exported schema, which never requires a "},{"code":"Sensitive","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"property."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"co"},{"text":" holds these entities, for the keys the record’s context has values for:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Entity"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys"}]}],[{"type":"paragraph","inlineContent":[{"text":"Holds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"iglu:com.snowplowanalytics.snowplow\/mobile_context\/jsonschema\/1-0-3","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"OperatingSystemKey","type":"codeVoice"},{"text":", both; ","type":"text"},{"code":"NetworkKey","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"LocaleKey","type":"codeVoice"},{"text":" if present","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"osType"},{"type":"text","text":" ("},{"type":"codeVoice","code":"ios"},{"type":"text","text":", "},{"type":"codeVoice","code":"tvos"},{"type":"text","text":", "},{"type":"codeVoice","code":"watchos"},{"type":"text","text":", "},{"type":"codeVoice","code":"visionos"},{"type":"text","text":", "},{"type":"codeVoice","code":"osx"},{"type":"text","text":"), "},{"type":"codeVoice","code":"osVersion"},{"type":"text","text":", "},{"type":"codeVoice","code":"deviceManufacturer"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Apple Inc."},{"type":"text","text":"), "},{"type":"codeVoice","code":"deviceModel"},{"type":"text","text":"; "},{"type":"codeVoice","code":"networkType"},{"type":"text","text":" ("},{"type":"codeVoice","code":"wifi"},{"type":"text","text":", "},{"type":"codeVoice","code":"mobile"},{"type":"text","text":", "},{"type":"codeVoice","code":"offline"},{"type":"text","text":"; left out for a wired or other connection); "},{"type":"codeVoice","code":"language"},{"type":"text","text":", the locale’s language code"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.mobile\/application\/jsonschema\/1-0-0"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"},{"type":"text","text":", with both a version and a build"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"version"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"build"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"A record the encoder can’t write is left out of the request, and the batch’s other records are","type":"text"},{"text":" ","type":"text"},{"text":"sent: one whose event and version ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" doesn’t describe, one whose event name Iglu doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"take, one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one that holds a value JSON can’t, one whose timestamp","type":"text"},{"text":" ","type":"text"},{"text":"is outside the years 0 to 9999, and one whose JSON is over 150,000 bytes","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","isActive":true},{"text":").","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","isActive":true},{"text":" returns them as ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":"s, which ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" logs and reports","type":"text"},{"text":" ","type":"text"},{"text":"on its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","type":"reference"},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","type":"reference"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. The collector answers 200 to every request it can read, and Snowplow validates","type":"text"},{"text":" ","type":"text"},{"text":"the events afterwards: an event whose data its schema rejects, or whose schema the pipeline’s","type":"text"},{"text":" ","type":"text"},{"text":"Iglu resolver can’t find, becomes a failed event, kept apart from the warehouse, though the","type":"text"},{"text":" ","type":"text"},{"text":"destination counts it as delivered. The bytes are the same for the same records on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}]}]}],"references":{"doc://Events/documentation/Events/Sensitive":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sensiti