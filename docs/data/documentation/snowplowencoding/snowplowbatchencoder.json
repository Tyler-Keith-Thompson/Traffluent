{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Make the destination with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/HTTPDestinations\/HTTPDestination\/snowplow(collector:vendor:appID:plan:backoff:clock:)"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"fills in the endpoint, the header field that keeps the collector from setting a cookie or"},{"type":"text","text":" "},{"type":"text","text":"recording the request’s address, this encoder and its limits:"}],"type":"paragraph"},{"code":["let snowplow = try HTTPDestination.snowplow(","    collector: collector,  \/\/ https:\/\/collector.example.com","    vendor: \"com.example\",  \/\/ your schemas' Iglu vendor","    appID: \"shop-ios\",","    plan: plan)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The body is a self-describing JSON object of content type ","type":"text"},{"type":"codeVoice","code":"application\/json"},{"text":", of the schema","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/payload_data\/jsonschema\/1-0-4"},{"text":", whose ","type":"text"},{"type":"codeVoice","code":"data"},{"text":" is an array of","type":"text"},{"text":" ","type":"text"},{"text":"events, one per record, oldest first. Every member of an event is a string, as the tracker","type":"text"},{"text":" ","type":"text"},{"text":"protocol has them:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Member"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Holds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"aid"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The app ID the encoder is made with"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"co","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The standard context’s entities (below), as the text of a self-describing JSON array of "},{"type":"codeVoice","code":"contexts"},{"type":"text","text":"; left out when there are none"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"dtm","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ttm","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When the event was tracked, in epoch milliseconds"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"e"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ue","type":"codeVoice"},{"text":", a self-describing event","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"eid","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The record’s ","type":"text"},{"type":"codeVoice","code":"EventRecord\/id"},{"text":", as a lowercase UUID; a redelivered record keeps it","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"ip","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"0.0.0.0","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"p","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The platform: "},{"type":"codeVoice","code":"mob"},{"type":"text","text":" for a phone, pad, watch or Vision Pro, "},{"type":"codeVoice","code":"tv"},{"type":"text","text":" for an Apple TV, "},{"type":"codeVoice","code":"pc"},{"type":"text","text":" for a Mac, and "},{"type":"codeVoice","code":"app"},{"type":"text","text":" when the record has no device in its context"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sid"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The record’s session, its "},{"type":"codeVoice","code":"SessionKey"},{"type":"text","text":", as a lowercase UUID; left out when its context has no session"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"tv"}],"type":"paragraph"}],[{"inlineContent":[{"code":"traffluent","type":"codeVoice"},{"type":"text","text":", the tracker"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ue_pr"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The event, as the text of a self-describing JSON ","type":"text"},{"code":"unstruct_event","type":"codeVoice"},{"text":" holding the event’s own self-describing JSON: its schema, ","type":"text"},{"code":"iglu:<vendor>\/<name>\/jsonschema\/<version>-0-0","type":"codeVoice"},{"text":", and its data, its stored properties by name","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"The session is the only identifier sent: there is no "},{"code":"duid","type":"codeVoice"},{"type":"text","text":", "},{"code":"uid","type":"codeVoice"},{"type":"text","text":", "},{"code":"nuid","type":"codeVoice"},{"type":"text","text":" or "},{"code":"tnuid","type":"codeVoice"},{"type":"text","text":", no"},{"type":"text","text":" "},{"code":"client_session","type":"codeVoice"},{"type":"text","text":" entity, whose "},{"code":"userId","type":"codeVoice"},{"type":"text","text":" lasts across sessions, and no "},{"code":"appleIdfv","type":"codeVoice"},{"type":"text","text":", "},{"code":"appleIdfa","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or other device identifier. Snowplow’s "},{"code":"domain_sessionid","type":"codeVoice"},{"type":"text","text":" is the session; a record with no"},{"type":"text","text":" "},{"type":"text","text":"session (one tracked by a tracker without "},{"code":"Enricher.sessions()","type":"codeVoice"},{"type":"text","text":") is sent without one, linked to"},{"type":"text","text":" "},{"type":"text","text":"nothing. A record a store recovers after a relaunch keeps its session, so it goes out with the"},{"type":"text","text":" "},{"code":"sid","type":"codeVoice"},{"type":"text","text":" of its first send. The record’s vendor"},{"type":"text","text":" "},{"type":"text","text":"identifier and trace context, and any other context value, aren’t sent."}],"type":"paragraph"},{"inlineContent":[{"text":"Each event’s ","type":"text"},{"type":"codeVoice","code":"ttm"},{"text":", its true timestamp, is the record’s timestamp, as is ","type":"text"},{"type":"codeVoice","code":"dtm"},{"text":", so Snowplow’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"derived_tstamp"},{"text":" is when the event was tracked, uncorrected for the device’s clock. No ","type":"text"},{"type":"codeVoice","code":"stm"},{"text":" ","type":"text"},{"text":"is sent: a retried request sends the same body again, so a sent time would be the first","type":"text"},{"text":" ","type":"text"},{"text":"attempt’s, and Snowplow would move the event later by however long the retries took.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The event’s schema is named after its "},{"code":"Event\/name","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Event\/schemaVersion","type":"codeVoice"},{"type":"text","text":": version N is"},{"type":"text","text":" "},{"type":"text","text":"SchemaVer "},{"code":"N-0-0","type":"codeVoice"},{"type":"text","text":". Each version of an event is a breaking change, a SchemaVer MODEL. A"},{"type":"text","text":" "},{"type":"text","text":"compatible change at the same version is an ADDITION, which the tracking plan’s Iglu export"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"TrackingPlan\/writeIgluRegistry(to:vendor:registry:)","type":"codeVoice"},{"type":"text","text":") writes for Iglu Server as "},{"code":"N-0-1","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"on, each superseding the ones before, so an event naming "},{"code":"N-0-0","type":"codeVoice"},{"type":"text","text":" is validated against the"},{"type":"text","text":" "},{"type":"text","text":"newest of them. A static repository doesn’t supersede: there an event naming "},{"code":"N-0-0","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"validated against "},{"code":"N-0-0","type":"codeVoice"},{"type":"text","text":" alone, so the export refuses an addition for one, and a change to an"},{"type":"text","text":" "},{"type":"text","text":"event needs a new version."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Properties are read through the event’s schema in "},{"type":"codeVoice","code":"plan"},{"type":"text","text":", as "},{"type":"codeVoice","code":"PropertyReader"},{"type":"text","text":" reads them. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Sensitive","isActive":true},{"type":"text","text":" value is never sent, whatever the record reveals: the property is left"},{"type":"text","text":" "},{"type":"text","text":"out, an element of an array is "},{"type":"codeVoice","code":"null"},{"type":"text","text":", and one inside a type the plan can’t map is "},{"type":"codeVoice","code":"null"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"data then validates against the event’s exported schema, which never requires a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"text","text":"property."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"co"},{"type":"text","text":" holds these entities, for the keys the record’s context has values for:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Entity","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keys","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Holds"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.snowplow\/mobile_context\/jsonschema\/1-0-3"}]}],[{"type":"paragraph","inlineContent":[{"code":"DeviceKey","type":"codeVoice"},{"type":"text","text":" and "},{"code":"OperatingSystemKey","type":"codeVoice"},{"type":"text","text":", both; "},{"code":"NetworkKey","type":"codeVoice"},{"type":"text","text":" and "},{"code":"LocaleKey","type":"codeVoice"},{"type":"text","text":" if present"}]}],[{"type":"paragraph","inlineContent":[{"code":"osType","type":"codeVoice"},{"text":" (","type":"text"},{"code":"ios","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tvos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"watchos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"visionos","type":"codeVoice"},{"text":", ","type":"text"},{"code":"osx","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"osVersion","type":"codeVoice"},{"text":", ","type":"text"},{"code":"deviceManufacturer","type":"codeVoice"},{"text":" (","type":"text"},{"code":"Apple Inc.","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"deviceModel","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"networkType","type":"codeVoice"},{"text":" (","type":"text"},{"code":"wifi","type":"codeVoice"},{"text":", ","type":"text"},{"code":"mobile","type":"codeVoice"},{"text":", ","type":"text"},{"code":"offline","type":"codeVoice"},{"text":"; left out for a wired or other connection); ","type":"text"},{"code":"language","type":"codeVoice"},{"text":", the locale’s language code","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iglu:com.snowplowanalytics.mobile\/application\/jsonschema\/1-0-0"}]}],[{"type":"paragraph","inlineContent":[{"code":"ApplicationKey","type":"codeVoice"},{"type":"text","text":", with both a version and a build"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"version"},{"type":"text","text":" and "},{"type":"codeVoice","code":"build"}]}]]]},{"inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out of the request, and the batch’s other records are"},{"type":"text","text":" "},{"type":"text","text":"sent: one whose event and version "},{"code":"plan","type":"codeVoice"},{"type":"text","text":" doesn’t describe, one whose event name Iglu doesn’t"},{"type":"text","text":" "},{"type":"text","text":"take, one whose event isn’t "},{"code":"Encodable","type":"codeVoice"},{"type":"text","text":", one that holds a value JSON can’t, one whose timestamp"},{"type":"text","text":" "},{"type":"text","text":"is outside the years 0 to 9999, and one whose JSON is over 150,000 bytes"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","isActive":true},{"type":"text","text":" returns them as "},{"code":"SkippedRecord","type":"codeVoice"},{"type":"text","text":"s, which "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" logs and reports"},{"type":"text","text":" "},{"type":"text","text":"on its "},{"code":"dropReports","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" splits a batch into requests within the encoder’s limit, ","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","type":"reference","isActive":true},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"default, and makes none for a batch with no record it can write, so ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing for it. The collector answers 200 to every request it can read, and Snowplow validates","type":"text"},{"text":" ","type":"text"},{"text":"the events afterwards: an event whose data its schema rejects, or whose schema the pipeline’s","type":"text"},{"text":" ","type":"text"},{"text":"Iglu resolver can’t find, becomes a failed event, kept apart from the warehouse, though the","type":"text"},{"text":" ","type":"text"},{"text":"destination counts it as delivered. The bytes are the same for the same records on every run","type":"text"},{"text":" ","type":"text"},{"text":"and platform: no whitespace, object members in the order of their names’ UTF-8 bytes.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"type":"text","text":" of Snowplow’s tracker protocol, so an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" "},{"type":"text","text":"can send events to a Snowplow collector’s "},{"type":"codeVoice","code":"POST \/com.snowplowanalytics.snowplow\/tp2"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"self-describing events whose schemas are the tracking plan’s."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/init(vendor:appID:plan:limit:)"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)"]},{"title":"Type Aliases","anchor":"Type-Aliases","generated":true,"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/Failure"]},{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/transientStatuses"]},{"title":"Type Methods","anchor":"Type-Methods","generated":true,"identifiers":["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/outcome(of:for:)"]}],"variants":[{"paths":["\/documentation\/snowplowencoding\/snowplowbatchencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/SnowplowEncoding\/s8SendableP","doc:\/\/SnowplowEncoding\/s16SendableMetatypeP"]}],"metadata":{"role":"symbol","roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SnowplowEncoding\/SnowplowBatchEncoder.swift#L94","fileName":"SnowplowBatchEncoder.swift"},"title":"SnowplowBatchEncoder","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnowplowBatchEncoder"}],"externalID":"s:16SnowplowEncoding0A12BatchEncoderV","symbolKind":"struct","navigatorTitle":[{"text":"SnowplowBatchEncoder","kind":"identifier"}],"modules":[{"name":"SnowplowEncoding"}]},"identifier":{"url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding"]]},"references":{"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/transientStatuses":{"abstract":[{"text":"No status beyond the 