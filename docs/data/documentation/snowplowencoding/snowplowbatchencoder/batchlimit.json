ctive":true,"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit"},{"text":"), within the smallest of a","type":"text"},{"text":" ","type":"text"},{"text":"pipeline’s streams. Only ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/requests(for:)"},{"text":" leaves a record out for it.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol"},"doc://SnowplowEncoding/documentation/SnowplowEncoding":{"role":"collection","url":"\/documentation\/snowplowencoding","kind":"symbol","title":"SnowplowEncoding","type":"topic","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","abstract":[{"text":"Send records to a Snowplow collector as self-describing events, whose schemas come from the tracking plan.","type":"text"}]},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowBatchEncoder/batchLimit":{"url":"\/documentation\/snowplowencoding\/snowplowbatchencoder\/batchlimit","type":"topic","title":"batchLimit","identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit","kind":"typeIdentifier"}],"role":"symbol","kind":"symbol","abstract":[{"text":"Snowplow’s trackers’ limits on one request, 25 events and 40,000 bytes of body, and an event","type":"text"},{"text":" ","type":"text"},{"text":"of up to 150,000 bytes in a request of its own.","type":"text"}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"B