{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"text":"Snowplow’s trackers’ limits on one request, 25 events and 40,000 bytes of body, and an event","type":"text"},{"text":" ","type":"text"},{"text":"of up to 150,000 bytes in a request of its own.","type":"text"}],"metadata":{"role":"symbol","remoteSource":{"fileName":"SnowplowBatchEncoder.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/SnowplowEncoding\/SnowplowBatchEncoder.swift#L139"},"symbolKind":"property","externalID":"s:16SnowplowEncoding0A12BatchEncoderV10batchLimit12PropertyJSON0cF0VvpZ","roleHeading":"Type Property","modules":[{"name":"SnowplowEncoding"}],"title":"batchLimit","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batchLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BatchLimit","kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"identifier":"doc:\/\/PropertyJSON\/documentation\/PropertyJSON\/BatchLimit","kind":"typeIdentifier","text":"BatchLimit","preciseIdentifier":"s:12PropertyJSON10BatchLimitV"}]}]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Snowplow’s mobile trackers send at most 25 events and 40,000 bytes in a request by default,"},{"type":"text","text":" "},{"type":"text","text":"and an event larger than that in a request of its own. A collector refuses a body over 2 MB"},{"type":"text","text":" "},{"type":"text","text":"with 413, and a request larger than its stream takes (192,0