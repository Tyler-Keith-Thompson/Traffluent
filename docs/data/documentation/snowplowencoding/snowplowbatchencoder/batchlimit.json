,000 bytes of JSON is sent alone, within the smallest of those, and a larger one"},{"type":"text","text":" "},{"type":"text","text":"is left out as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowEncodingError\/oversized(byteCount:)"},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/snowplowencoding\/snowplowbatchencoder\/batchlimit"]}],"abstract":[{"text":"Snowplow’s trackers’ limits on one request, 25 events and 40,000 bytes of body, and an event","type":"text"},{"text":" ","type":"text"},{"text":"of up to 150,000 bytes in a request of its own.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEncoder\/batchLimit"},"sections":[],"references":{"doc://SnowplowEncoding/documentation/SnowplowEncoding":{"url":"\/documentation\/snowplowencoding","kind":"symbol","title":"SnowplowEncoding","abstract":[{"type":"text","text":"Send records to a Snowplow collector as self-describing events, whose schemas come from the tracking plan."}],"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding","role":"collection","type":"topic"},"doc://SnowplowEncoding/documentation/SnowplowEncoding/SnowplowEncodingError/oversized(byteCount:)":{"role":"symbol","title":"SnowplowEncodingError.oversized(byteCount:)","kind":"symbol","abstract":[{"text":"The event’s JSON is ","type":"text"},{"code":"byteCount","type":"codeVoice"},{"text":" bytes, more than the encoder’s limit lets one record hold:","type":"text"},{"text":" ","type":"text"},{"text":"150,000 bytes by default (","type":"text"},{"identifier":"doc:\/\/SnowplowEncoding\/documentation\/SnowplowEncoding\/SnowplowBatchEnco