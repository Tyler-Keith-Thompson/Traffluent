{"metadata":{"modules":[{"name":"AutomaticControlTracking"}],"externalID":"AutomaticControlTracking","symbolKind":"module","role":"collection","roleHeading":"Framework","title":"AutomaticControlTracking"},"hierarchy":{"paths":[[]]},"kind":"symbol","primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this module when an app’s UIKit controls should track their own activations, such as a button"},{"type":"text","text":" "},{"type":"text","text":"tapped or a switch flipped. The discovery runs on iOS, iPadOS, tvOS, visionOS and Mac"},{"type":"text","text":" "},{"type":"text","text":"Catalyst, through a "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":". "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"},{"type":"text","text":", the event it tracks, builds on every"},{"type":"text","text":" "},{"type":"text","text":"platform, so a tracking plan or a server can name it. SwiftUI’s controls are never tracked"},{"type":"text","text":" "},{"type":"text","text":"automatically: give them "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"macOS has no equivalent; give an "},{"type":"codeVoice","code":"NSControl"},{"type":"text","text":" "},{"type":"codeVoice","code":"track(_:)"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Nothing is tracked until a window scene turns it on with ","type":"text"},{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":". Each","type":"text"},{"text":" ","type":"text"},{"text":"control is named after its ","type":"text"},{"code":"accessibilityIdentifier","type":"codeVoice"},{"text":", never its title or other text, which may be","type":"text"},{"text":" ","type":"text"},{"text":"a person’s data, and carries its kind, the first public UIKit class it is (","type":"text"},{"code":"\"UIButton\"","type":"codeVoice"},{"text":"). By","type":"text"},{"text":" ","type":"text"},{"text":"default a control without an identifier is skipped:","type":"text"}]},{"code":["import UIKit","","final class CartViewController: UIViewController {","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        checkOut.accessibilityIdentifier = \"checkout-button\"  \/\/ tracked as ControlActivated(control: \"checkout-button\", kind: \"UIButton\")","        view.addSubview(checkOut)","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackControlsAutomatically()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Give ","type":"text"},{"code":"trackControlsAutomatically","type":"codeVoice"},{"text":" a closure to rename a control or skip it: it gets each","type":"text"},{"text":" ","type":"text"},{"code":"DiscoveredControl","type":"codeVoice"},{"text":", with its identifier, kind and screen, and returns the event, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". Each","type":"text"},{"text":" ","type":"text"},{"text":"record’s context carries the control’s screen, the type of the view controller it is in, as","type":"text"},{"text":" ","type":"text"},{"code":"ScreenKey","type":"codeVoice"},{"text":", unless the tracker’s enrichers set one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A touch that ends off the control tracks nothing, and neither do activations"},{"type":"text","text":" "},{"type":"text","text":"without a touch, such as VoiceOver’s, or actions the app sends itself with "},{"type":"codeVoice","code":"sendActions(for:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"except to a control the last touch was on and didn’t activate. Each activation goes"},{"type":"text","text":" "},{"type":"text","text":"through the tracker the control’s traits hold, so each scene keeps its own. The scene adds a"},{"type":"text","text":" "},{"type":"text","text":"gesture recognizer to each of its windows that never recognizes, so it holds up no touch, and"},{"type":"text","text":" "},{"type":"text","text":"swizzles nothing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This documentation is built on macOS, so "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"stopTrackingControlsAutomatically()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"DiscoveredControl"},{"type":"text","text":", have no pages here; their doc"},{"type":"text","text":" "},{"type":"text","text":"comments are in the sources."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking"},{"type":"text","text":" "},{"type":"text","text":"also covers screen views and the app’s lifecycle."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"topicSections":[{"title":"The event","identifiers":["doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"],"anchor":"The-event"}],"variants":[{"paths":["\/documentation\/automaticcontroltracking"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","interfaceLanguage":"swift"},"sections":[],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","titleInlineContent":[{"code":"AppKitTracking","type":"codeVoice"}],"title":"AppKitTracking"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"kind":"symbol","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","url":"\/documentation\/automaticcontroltracking","title":"AutomaticControlTracking","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}],"type":"topic","role":"collection"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated":{"url":"\/documentation\/automaticcontroltracking\/controlactivated","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","navigatorTitle":[{"kind":"identifier","text":"ControlActivated"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ControlActivated"}],"abstract":[{"type":"text","text":"Someone activated the control named "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control"},{"type":"text","text":", such as by tapping a button or flipping a"},{"type":"text","text":" "},{"type":"text","text":"switch: what "},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"type":"text","text":" tracks for each activation it discovers."}],"title":"ControlActivated","type":"topic","kind":"symbol","role":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"title":"SwiftUITracking","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","titleInlineContent":[{"type":"codeVoice","code":"SwiftUITracking"}]},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated/control":{"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","url":"\/documentation\/automaticcontroltracking\/controlactivated\/control","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"control"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"abstract":[{"text":"The activated control’s name: its accessibility identifier, unless the predicate given to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"text":" named it otherwise.","type":"text"}],"title":"control","type":"topic","kind":"symbol","role":"symbol"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/automatictracking":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","titleInlineContent":[{"text":"Automatic Tracking","type":"text"}],"type":"link","title":"Automatic Tracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking"}}}