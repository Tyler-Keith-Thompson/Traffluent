{"kind":"symbol","abstract":[{"type":"text","text":"Track a control activation each time a touch activates a UIKit control, without a call on each"},{"type":"text","text":" "},{"type":"text","text":"control."}],"identifier":{"url":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"AutomaticControlTracking"}],"role":"collection","title":"AutomaticControlTracking","symbolKind":"module","roleHeading":"Framework","externalID":"AutomaticControlTracking"},"variants":[{"paths":["\/documentation\/automaticcontroltracking"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"The event","identifiers":["doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"],"anchor":"The-event"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Use this module when an app’s UIKit controls should track their own activations, such as a button"},{"type":"text","text":" "},{"type":"text","text":"tapped or a switch flipped. The discovery runs on iOS, iPadOS, tvOS, visionOS and Mac"},{"type":"text","text":" "},{"type":"text","text":"Catalyst, through a "},{"type":"codeVoice","code":"UIWindowScene"},{"type":"text","text":". "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated"},{"type":"text","text":", the event it tracks, builds on every"},{"type":"text","text":" "},{"type":"text","text":"platform, so a tracking plan or a server can name it. SwiftUI’s controls are never tracked"},{"type":"text","text":" "},{"type":"text","text":"automatically: give them "},{"type":"codeVoice","code":"trackOnTap(_:)"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"macOS has no equivalent; give an "},{"type":"codeVoice","code":"NSControl"},{"type":"text","text":" "},{"type":"codeVoice","code":"track(_:)"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Nothing is tracked until a window scene turns it on with "},{"type":"codeVoice","code":"trackControlsAutomatically"},{"type":"text","text":". Each"},{"type":"text","text":" "},{"type":"text","text":"control is named after its "},{"type":"codeVoice","code":"accessibilityIdentifier"},{"type":"text","text":", never its title or other text, which may be"},{"type":"text","text":" "},{"type":"text","text":"a person’s data, and carries its kind, the first public UIKit class it is ("},{"type":"codeVoice","code":"\"UIButton\""},{"type":"text","text":"). By"},{"type":"text","text":" "},{"type":"text","text":"default a control without an identifier is skipped:"}],"type":"paragraph"},{"code":["import UIKit","","final class CartViewController: UIViewController {","    let checkOut = UIButton(configuration: .filled())","","    override func viewDidLoad() {","        super.viewDidLoad()","        checkOut.accessibilityIdentifier = \"checkout-button\"  \/\/ tracked as ControlActivated(control: \"checkout-button\", kind: \"UIButton\")","        view.addSubview(checkOut)","    }","}","","\/\/ In the scene delegate's scene(_:willConnectTo:options:), beside the scene's tracker:","windowScene.traitOverrides.tracker = tracker","windowScene.trackControlsAutomatically()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Give "},{"type":"codeVoice","code":"trackControlsAutomatically"},{"type":"text","text":" a closure to rename a control or skip it: it gets each"},{"type":"text","text":" "},{"type":"codeVoice","code":"DiscoveredControl"},{"type":"text","text":", with its identifier, kind and screen, and returns the event, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Each"},{"type":"text","text":" "},{"type":"text","text":"record’s context carries the control’s screen, the type of the view controller it is in, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"ScreenKey"},{"type":"text","text":", unless the tracker’s enrichers set one."}],"type":"paragraph"},{"inlineContent":[{"text":"A touch that ends off the control tracks nothing, and neither do activations","type":"text"},{"text":" ","type":"text"},{"text":"without a touch, such as VoiceOver’s, or actions the app sends itself with ","type":"text"},{"code":"sendActions(for:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"except to a control the last touch was on and didn’t activate. Each activation goes","type":"text"},{"text":" ","type":"text"},{"text":"through the tracker the control’s traits hold, so each scene keeps its own. The scene adds a","type":"text"},{"text":" ","type":"text"},{"text":"gesture recognizer to each of its windows that never recognizes, so it holds up no touch, and","type":"text"},{"text":" ","type":"text"},{"text":"swizzles nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This documentation is built on macOS, so ","type":"text"},{"code":"UIWindowScene","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"trackControlsAutomatically(_:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"stopTrackingControlsAutomatically()","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"DiscoveredControl","type":"codeVoice"},{"text":", have no pages here; their doc","type":"text"},{"text":" ","type":"text"},{"text":"comments are in the sources.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The guide"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking"},{"type":"text","text":" "},{"type":"text","text":"also covers screen views and the app’s lifecycle."}],"type":"paragraph"}]}],"references":{"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated/control":{"kind":"symbol","abstract":[{"type":"text","text":"The activated control’s name: its accessibility identifier, unless the predicate given to"},{"type":"text","text":" "},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"type":"text","text":" named it otherwise."}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"control"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"type":"topic","role":"symbol","title":"control","url":"\/documentation\/automaticcontroltracking\/controlactivated\/control"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking/ControlActivated":{"kind":"symbol","abstract":[{"type":"text","text":"Someone activated the control named "},{"type":"reference","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated\/control","isActive":true},{"type":"text","text":", such as by tapping a button or flipping a"},{"type":"text","text":" "},{"type":"text","text":"switch: what "},{"type":"codeVoice","code":"trackControlsAutomatically(_:)"},{"type":"text","text":" tracks for each activation it discovers."}],"identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking\/ControlActivated","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ControlActivated"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ControlActivated"}],"role":"symbol","title":"ControlActivated","url":"\/documentation\/automaticcontroltracking\/controlactivated"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/swiftuitracking":{"title":"SwiftUITracking","titleInlineContent":[{"code":"SwiftUITracking","type":"codeVoice"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/swiftuitracking","type":"link"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/appkittracking":{"title":"AppKitTracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/appkittracking","titleInlineContent":[{"type":"codeVoice","code":"AppKitTracking"}],"type":"link"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/automatictracking":{"type":"link","titleInlineContent":[{"text":"Automatic Tracking","type":"text"}],"title":"Automatic Tracking","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/automatictracking"},"doc://AutomaticControlTracking/documentation/AutomaticControlTracking":{"url":"\/documentation\/automaticcontroltracking","title":"AutomaticControlTracking","identifier":"doc:\/\/AutomaticControlTracking\/documentation\/AutomaticControlTracking","type":"topic","kind":"symbol","abstract":[{"text":"Track a control activation each time a touch activates a UIKit control, without a call on each","type":"text"},{"text":" ","type":"text"},{"text":"control.","type":"text"}],"role":"collection"}}}