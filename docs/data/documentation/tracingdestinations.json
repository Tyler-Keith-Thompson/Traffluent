{"topicSections":[{"title":"Destinations","identifiers":["doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"],"anchor":"Destinations"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","isActive":true,"type":"reference"},{"text":" finds each record’s span from the ","type":"text"},{"type":"codeVoice","code":"ServiceContext"},{"text":" the event was tracked","type":"text"},{"text":" ","type":"text"},{"text":"in, so a delivery that runs later, under another span or none, still adds the event to the right","type":"text"},{"text":" ","type":"text"},{"text":"one. Each span event is named after the event, stamped with the time it was tracked, and carries","type":"text"},{"text":" ","type":"text"},{"text":"the event’s description under ","type":"text"},{"type":"codeVoice","code":"event"},{"text":" and its call site under OpenTelemetry’s ","type":"text"},{"type":"codeVoice","code":"code.*"},{"text":" attribute","type":"text"},{"text":" ","type":"text"},{"text":"names.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Span events can’t be added to a span that has ended. A record tracked outside any span, or whose"},{"type":"text","text":" "},{"type":"text","text":"span ended before its batch was delivered, is left out. Batch tightly enough for your spans to"},{"type":"text","text":" "},{"type":"text","text":"outlive their batches, and deliver to another destination as well for the events that must not be"},{"type":"text","text":" "},{"type":"text","text":"lost. To write events to your logs instead, use "},{"type":"codeVoice","code":"LoggerDestination"},{"type":"text","text":" in the "},{"type":"codeVoice","code":"LoggingDestinations"},{"type":"text","text":" "},{"type":"text","text":"module."}],"type":"paragraph"},{"syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: SpanEventDestination(tracer: tracer))","let span = tracer.startSpan(\"checkout\")","ServiceContext.withValue(span.context) {","    tracker.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()","span.end()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tracingdestinations"]}],"identifier":{"url":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"metadata":{"modules":[{"name":"TracingDestinations"}],"role":"collection","symbolKind":"module","title":"TracingDestinations","roleHeading":"Framework","externalID":"TracingDestinations"},"references":{"doc://TracingDestinations/documentation/TracingDestinations/SpanEventDestination":{"navigatorTitle":[{"text":"SpanEventDestination","kind":"identifier"}],"type":"topic","abstract":[{"text":"A destination that adds each event to the span that was active when the event was tracked.","type":"text"}],"kind":"symbol","url":"\/documentation\/tracingdestinations\/spaneventdestination","title":"SpanEventDestination","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanEventDestination","kind":"identifier"}]},"doc://TracingDestinations/documentation/TracingDestinations":{"abstract":[{"type":"text","text":"A destination that adds each tracked event to the span that was active when it was tracked."}],"title":"TracingDestinations","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","kind":"symbol","type":"topic","url":"\/documentation\/tracingdestinations","role":"collection"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"type":"link"}}}