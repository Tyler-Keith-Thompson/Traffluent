{"kind":"symbol","abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"metadata":{"role":"collection","roleHeading":"Framework","symbolKind":"module","title":"TracingDestinations","modules":[{"name":"TracingDestinations"}],"externalID":"TracingDestinations"},"sections":[],"topicSections":[{"anchor":"Destinations","title":"Destinations","identifiers":["doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tracingdestinations"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","isActive":true,"type":"reference"},{"text":" finds each record’s span from the ","type":"text"},{"code":"ServiceContext","type":"codeVoice"},{"text":" the event was tracked","type":"text"},{"text":" ","type":"text"},{"text":"in, so a delivery that runs later, under another span or none, still adds the event to the right","type":"text"},{"text":" ","type":"text"},{"text":"one. Each span event is named after the event, stamped with the time it was tracked, and carries","type":"text"},{"text":" ","type":"text"},{"text":"the event’s description under ","type":"text"},{"code":"event","type":"codeVoice"},{"text":" and its call site under OpenTelemetry’s ","type":"text"},{"code":"code.*","type":"codeVoice"},{"text":" attribute","type":"text"},{"text":" ","type":"text"},{"text":"names.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Span events can’t be added to a span that has ended. A record tracked outside any span, or whose"},{"type":"text","text":" "},{"type":"text","text":"span ended before its batch was delivered, is left out. Batch tightly enough for your spans to"},{"type":"text","text":" "},{"type":"text","text":"outlive their batches, and deliver to another destination as well for the events that must not be"},{"type":"text","text":" "},{"type":"text","text":"lost. To write events to your logs instead, use "},{"type":"codeVoice","code":"LoggerDestination"},{"type":"text","text":" in the "},{"type":"codeVoice","code":"LoggingDestinations"},{"type":"text","text":" "},{"type":"text","text":"module."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let tracker = Tracker()","let delivery = tracker.records.batch().deliver(to: SpanEventDestination(tracer: tracer))","let span = tracer.startSpan(\"checkout\")","ServiceContext.withValue(span.context) {","    tracker.track(SignedUp(plan: \"pro\"))","}","await tracker.finish()","try await delivery.execute()","span.end()"]},{"inlineContent":[{"type":"text","text":"The umbrella guide on this area is"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://TracingDestinations/documentation/TracingDestinations":{"role":"collection","identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations","abstract":[{"text":"A destination that adds each tracked event to the span that was active when it was tracked.","type":"text"}],"title":"TracingDestinations","url":"\/documentation\/tracingdestinations","kind":"symbol","type":"topic"},"doc://TracingDestinations/documentation/TracingDestinations/SpanEventDestination":{"navigatorTitle":[{"text":"SpanEventDestination","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A destination that adds each event to the span that was active when the event was tracked."}],"title":"SpanEventDestination","url":"\/documentation\/tracingdestinations\/spaneventdestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanEventDestination","kind":"identifier"}],"identifier":"doc:\/\/TracingDestinations\/documentation\/TracingDestinations\/SpanEventDestination","role":"symbol","type":"topic"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"type":"link","title":"Choosing Destinations","url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}]}}}