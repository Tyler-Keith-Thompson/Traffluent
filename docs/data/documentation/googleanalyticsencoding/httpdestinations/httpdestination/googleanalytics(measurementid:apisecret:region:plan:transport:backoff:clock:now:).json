"text":", "},{"kind":"externalParam","text":"apiSecret"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"region"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB6RegionO","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","text":"GoogleAnalyticsRegion"},{"kind":"text","text":", "},{"kind":"externalParam","text":"plan"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13TrackingPlans0A4PlanV","identifier":"doc:\/\/TrackingPlans\/documentation\/TrackingPlans\/TrackingPlan","text":"TrackingPlan"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"backoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations18ExponentialBackoffV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","text":"ExponentialBackoff"},{"kind":"text","text":" = ExponentialBackoff(), "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":"> = ContinuousClock(), "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":" = { Date.now }) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB10SetupErrorO","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError","text":"GoogleAnalyticsSetupError"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations15HTTPDestinationV","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","text":"HTTPDestination"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Transport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:23GoogleAnalyticsEncoding0aB12BatchEncoderV","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","text":"GoogleAnalyticsBatchEncoder"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"measurementID","content":[{"inlineContent":[{"type":"text","text":"The web or data stream’s measurement ID, "},{"type":"codeVoice","code":"G-"},{"type":"text","text":" followed by letters and"},{"type":"text","text":" "},{"type":"text","text":"digits, from the stream’s details in Google Analytics’ Admin. Whitespace and newlines"},{"type":"text","text":" "},{"type":"text","text":"around it are trimmed off."}],"type":"paragraph"}]},{"name":"apiSecret","content":[{"inlineContent":[{"type":"text","text":"An API secret of the stream, from its Measurement Protocol API secrets in"},{"type":"text","text":" "},{"type":"text","text":"Google Analytics’ Admin. Whitespace and newlines around it are trimmed off."}],"type":"paragraph"}]},{"name":"region","content":[{"inlineContent":[{"text":"Where Google collects the data: ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/global","isActive":true,"type":"reference"},{"text":", its default","type":"text"},{"text":" ","type":"text"},{"text":"endpoint, or ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/eu","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"plan","content":[{"inlineContent":[{"text":"The tracking plan of every event the destination is given.","type":"text"}],"type":"paragraph"}]},{"name":"transport","content":[{"inlineContent":[{"type":"text","text":"What sends each request."}],"type":"paragraph"}]},{"name":"backoff","content":[{"inlineContent":[{"type":"text","text":"How long to wait before each new attempt at a request; 1 second, doubling up"},{"type":"text","text":" "},{"type":"text","text":"to 60 seconds, with full jitter, by default."}],"type":"paragraph"}]},{"name":"clock","content":[{"inlineContent":[{"type":"text","text":"The clock the waits are measured on."}],"type":"paragraph"}]},{"name":"now","content":[{"type":"paragraph","inlineContent":[{"text":"The wall-clock time a batch is encoded at, and each request’s deadline is checked","type":"text"},{"text":" ","type":"text"},{"text":"against before it is sent; the system’s clock by default.","type":"text"}]}]}]},{"content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination."}]}],"kind":"content"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The destination posts to the Measurement Protocol’s ","type":"text"},{"code":"\/mp\/collect","type":"codeVoice"},{"text":" endpoint of ","type":"text"},{"code":"region","type":"codeVoice"},{"text":", with","type":"text"},{"text":" ","type":"text"},{"text":"the measurement ID and API secret in its query, encoded by a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"plan","type":"codeVoice"},{"text":" within ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder\/batchLimit"},{"text":" that leaves out each record","type":"text"},{"text":" ","type":"text"},{"text":"tracked more than 71 hours before, or more than 15 minutes after, the time ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" gives as a","type":"text"},{"text":" ","type":"text"},{"text":"batch is encoded: Google Analytics takes 72, and the hour to spare is for the request to","type":"text"},{"text":" ","type":"text"},{"text":"reach Google and clocks that disagree. It sends no trace context in its header fields. It","type":"text"},{"text":" ","type":"text"},{"text":"retries no response, a 5xx, 408 or 429, and drops and reports any other status. A request","type":"text"},{"text":" ","type":"text"},{"text":"still undelivered 71 hours after its oldest record was tracked, by the time ","type":"text"},{"code":"now","type":"codeVoice"},{"text":" gives,","type":"text"},{"text":" ","type":"text"},{"text":"isn’t sent again: the whole request is dropped, its younger records too, and reported as","type":"text"},{"text":" ","type":"text"},{"code":"HTTPDropReport.deadlineExceeded(deadline:recordIDs:)","type":"codeVoice"},{"text":", as Google Analytics would store its","type":"text"},{"text":" ","type":"text"},{"text":"oldest records as 72 hours old. The Measurement Protocol answers","type":"text"},{"text":" ","type":"text"},{"text":"2xx to every request it receives, so a wrong measurement ID or API secret, or a request it","type":"text"},{"text":" ","type":"text"},{"text":"can’t read, is answered 2xx with nothing stored: check the property’s Realtime report after","type":"text"},{"text":" ","type":"text"},{"text":"setting it up.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The API secret lets anyone holding it send events to the property, so this factory is"},{"type":"text","text":" "},{"type":"text","text":"for a server, and must never be given a secret in an app. It is compiled for macOS and"},{"type":"text","text":" "},{"type":"text","text":"Linux alone, so an app for iOS, iPadOS, tvOS, watchOS, visionOS or Mac Catalyst that calls"},{"type":"text","text":" "},{"type":"text","text":"it fails to compile. A Mac app (AppKit or SwiftUI) compiles it, but the factory refuses it"},{"type":"text","text":" "},{"type":"text","text":"at run time: it throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle"},{"type":"text","text":" when the main bundle is an"},{"type":"text","text":" "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".appex"},{"type":"text","text":". To get an app’s events here, send them to a server of yours that"},{"type":"text","text":" "},{"type":"text","text":"makes this destination; see the module’s article for what that server does."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The secret is in the query of every request’s URL, so don’t log the destination, its"},{"type":"text","text":" "},{"type":"text","text":"requests or a transport’s URLs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The encoder logs a notice for each event and property of "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" named as Google Analytics"},{"type":"text","text":" "},{"type":"text","text":"refuses, or keeps for itself, as every record of that event will be skipped"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsEncodingError","isActive":true},{"type":"text","text":")."}]},{"type":"aside","style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","isActive":true,"type":"reference"},{"text":" in an app or an app extension,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID","isActive":true,"type":"reference"},{"text":" for a measurement ID that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace, ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID","isActive":true,"type":"reference"},{"text":" for one that isn’t ","type":"text"},{"code":"G-","type":"codeVoice"},{"text":" ","type":"text"},{"text":"followed by uppercase ASCII letters and digits, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret","isActive":true,"type":"reference"},{"text":" for a secret that is empty or only","type":"text"},{"text":" ","type":"text"},{"text":"whitespace.","type":"text"}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/googleanalyticsencoding\/httpdestinations\/httpdestination\/googleanalytics(measurementid:apisecret:region:plan:transport:backoff:clock:now:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/HTTPDestinations":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/HTTPDestinations","role":"collection","url":"\/documentation\/googleanalyticsencoding\/httpdestinations","type":"topic","title":"HTTPDestinations"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"url":"\/documentation\/httpdestinations\/httpdestination","abstract":[{"type":"text","text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder"},{"type":"text","text":" "},{"type":"text","text":"splits it into, and sends each again until it arrives."}],"type":"topic","navigatorTitle":[{"text":"HTTPDestination","kind":"identifier"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","title":"HTTPDestination","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDestination","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"abstract":[{"text":"What turns a batch of records into the requests ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"text":" sends.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","navigatorTitle":[{"text":"BatchEncoder","kind":"identifier"}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchEncoder","kind":"identifier"}],"url":"\/documentation\/httpdestinations\/batchencoder","type":"topic","title":"BatchEncoder"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsBatchEncoder":{"abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true,"type":"reference"},{"type":"text","text":" of Google Analytics 4’s Measurement Protocol, so an"},{"type":"text","text":" "},{"code":"HTTPDestination","type":"codeVoice"},{"type":"text","text":" on a server can send events to a web or data stream’s "},{"code":"POST \/mp\/collect","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsbatchencoder","role":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsBatchEncoder","navigatorTitle":[{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsBatchEncoder","kind":"identifier"}],"title":"GoogleAnalyticsBatchEncoder"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsRegion/global":{"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsregion\/global","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"global"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion\/global","abstract":[{"text":"Google’s default collection endpoint: ","type":"text"},{"code":"https:\/\/www.google-analytics.com","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","title":"GoogleAnalyticsRegion.global"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsRegion":{"role":"symbol","title":"GoogleAnalyticsRegion","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsRegion","kind":"identifier"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","navigatorTitle":[{"text":"GoogleAnalyticsRegion","kind":"identifier"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsregion","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Where Google Analytics collects a stream’s events, which decides the Measurement Protocol"},{"type":"text","text":" "},{"type":"text","text":"endpoint they are posted to."}]},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/appBundle":{"title":"GoogleAnalyticsSetupError.appBundle","kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"appBundle"}],"abstract":[{"type":"text","text":"The process is an app or an app extension: its main bundle is an "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or "},{"type":"codeVoice","code":".appex"},{"type":"text","text":" "},{"type":"text","text":"directory. The factory is compiled for macOS so a server written for it can run there, and a"},{"type":"text","text":" "},{"type":"text","text":"Mac app compiles it too, but an app ships the API secret to everyone who installs it, and"},{"type":"text","text":" "},{"type":"text","text":"anyone holding the secret can send events to the property. Send the app’s events to a relay"},{"type":"text","text":" "},{"type":"text","text":"of yours instead, which forwards them to Google Analytics."}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/appbundle","type":"topic"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/emptyAPISecret":{"abstract":[{"type":"text","text":"The API secret is empty, or only whitespace. The Measurement Protocol stores nothing for a"},{"type":"text","text":" "},{"type":"text","text":"request without one."}],"kind":"symbol","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"emptyAPISecret","kind":"identifier"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/emptyapisecret","type":"topic","title":"GoogleAnalyticsSetupError.emptyAPISecret"},"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff":{"type":"topic","url":"\/docume