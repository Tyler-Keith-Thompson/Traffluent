ntation/GoogleAnalyticsEncoding":{"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding","kind":"symbol","abstract":[{"text":"Send records from a server to a Google Analytics 4 web or data stream through the Measurement Protocol.","type":"text"}],"title":"GoogleAnalyticsEncoding","url":"\/documentation\/googleanalyticsencoding","type":"topic","role":"collection"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/emptyAPISecret":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"emptyAPISecret","kind":"identifier"}],"type":"topic","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/emptyapisecret","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The API secret is empty, or only whitespace. The Measurement Protocol stores nothing for a"},{"type":"text","text":" "},{"type":"text","text":"request without one."}],"title":"GoogleAnalyticsSetupError.emptyAPISecret","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyAPISecret"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/Error-Implementations":{"type":"topic","kind":"article","title":"Error Implementations","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/Error-Implementations","abstract":[],"role":"collectionGroup","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/error-implementations"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/emptyMeasurementID":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"emptyMeasurementID","kind":"identifier"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/emptyMeasurementID","role":"symbol","title":"GoogleAnalyticsSetupError.emptyMeasurementID","type":"topic","abstract":[{"text":"The measurement ID is empty, or only whitespace.","type":"text"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/emptymeasurementid","kind":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsRegion":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GoogleAnalyticsRegion","kind":"identifier"}],"navigatorTitle":[{"text":"GoogleAnalyticsRegion","kind":"identifier"}],"identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsRegion","role":"symbol","title":"GoogleAnalyticsRegion","type":"topic","abstract":[{"text":"Where Google Analytics collects a stream’s events, which decides the Measurement Protocol","type":"text"},{"text":" ","type":"text"},{"text":"endpoint they are posted to.","type":"text"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticsregion","kind":"symbol"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/malformedMeasurementID":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"malformedMeasurementID","kind":"identifier"}],"type":"topic","url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/malformedmeasurementid","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The measurement ID isn’t "},{"type":"codeVoice","code":"G-"},{"type":"text","text":" followed by uppercase ASCII letters and digits, the form of"},{"type":"text","text":" "},{"type":"text","text":"every web stream’s ID ("},{"type":"codeVoice","code":"G-1A2B3C4D5E"},{"type":"text","text":"). The Measurement Protocol answers a request for a"},{"type":"text","text":" "},{"type":"text","text":"stream it doesn’t know with 2xx and stores nothing, so the factory refuses a malformed ID"},{"type":"text","text":" "},{"type":"text","text":"when the destination is made. A stream ID, an app stream’s Firebase app ID, a Universal"},{"type":"text","text":" "},{"type":"text","text":"Analytics ID ("},{"type":"codeVoice","code":"UA-…"},{"type":"text","text":") or a Google tag ID ("},{"type":"codeVoice","code":"GT-…"},{"type":"text","text":") is refused as well."}],"title":"GoogleAnalyticsSetupError.malformedMeasurementID","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/malformedMeasurementID"},"doc://GoogleAnalyticsEncoding/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/GoogleAnalyticsEncoding\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://GoogleAnalyticsEncoding/documentation/GoogleAnalyticsEncoding/GoogleAnalyticsSetupError/appBundle":{"type":"topic","kind":"symbol","title":"GoogleAnalyticsSetupError.appBundle","identifier":"doc:\/\/GoogleAnalyticsEncoding\/documentation\/GoogleAnalyticsEncoding\/GoogleAnalyticsSetupError\/appBundle","abstract":[{"type":"text","text":"The process is an app or an app extension: its main bundle is an "},{"type":"codeVoice","code":".app"},{"type":"text","text":" or "},{"type":"codeVoice","code":".appex"},{"type":"text","text":" "},{"type":"text","text":"directory. The factory is compiled for macOS so a server written for it can run there, and a"},{"type":"text","text":" "},{"type":"text","text":"Mac app compiles it too, but an app ships the API secret to everyone who installs it, and"},{"type":"text","text":" "},{"type":"text","text":"anyone holding the secret can send events to the property. Send the app’s events to a relay"},{"type":"text","text":" "},{"type":"text","text":"of yours instead, which forwards them to Google Analytics."}],"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"appBundle","kind":"identifier"}],"url":"\/documentation\/googleanalyticsencoding\/googleanalyticssetuperror\/appbundle"}}}