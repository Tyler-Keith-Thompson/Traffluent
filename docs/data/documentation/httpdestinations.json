{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"HTTPDestinations"}],"role":"collection","externalID":"HTTPDestinations","symbolKind":"module","roleHeading":"Framework","title":"HTTPDestinations"},"topicSections":[{"anchor":"Sending-batches","title":"Sending batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"]},{"anchor":"Encoding-a-batch","title":"Encoding a batch","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"]},{"anchor":"Reading-a-2xx-answer","title":"Reading a 2xx answer","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse"]},{"anchor":"Splitting-a-batch-into-requests","title":"Splitting a batch into requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchRequests","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/SkippedRecord"]},{"anchor":"Retrying-a-vendors-own-statuses","title":"Retrying a vendor’s own statuses","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/TransientStatus","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidTransientStatus"]},{"anchor":"Waiting-between-attempts","title":"Waiting between attempts","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"]},{"anchor":"Sending-requests","title":"Sending requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError"]}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"text":" is a destination that posts each batch it receives as the requests its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference"},{"text":" splits it into: one request for an endpoint without limits. Each body is whatever","type":"text"},{"text":" ","type":"text"},{"text":"the encoder writes for its records, so events need no ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance and the wire format is","type":"text"},{"text":" ","type":"text"},{"text":"yours. It sends with ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" through","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","type":"reference"},{"text":" by default, or through any ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","type":"reference"},{"text":" you pass.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","isActive":true},{"text":": nominally 1 second, doubling up to 60 seconds, unless you pass another. So","type":"text"},{"text":" ","type":"text"},{"text":"is one answered with a status the encoder lists in ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","isActive":true},{"text":", which every","type":"text"},{"text":" ","type":"text"},{"text":"encoder declares: empty for most servers, or each other failure its vendor answers to a request","type":"text"},{"text":" ","type":"text"},{"text":"worth sending again, such as Aptabase’s 418 for a slow upload.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A 2xx counts as delivered unless the encoder’s ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","isActive":true,"type":"reference"},{"text":" reads its body and","type":"text"},{"text":" ","type":"text"},{"text":"says otherwise. Some vendors answer 200 to a request they didn’t store, and say so only in the","type":"text"},{"text":" ","type":"text"},{"text":"body: Mixpanel’s ","type":"text"},{"code":"{\"status\": 0}","type":"codeVoice"},{"text":", or Aptabase’s ","type":"text"},{"code":"{\"error\": ...}","type":"codeVoice"},{"text":" for an unknown key. A 2xx the","type":"text"},{"text":" ","type":"text"},{"text":"encoder reads as ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)","isActive":true,"type":"reference"},{"text":" is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)","isActive":true,"type":"reference"},{"text":". One it reads as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)","isActive":true,"type":"reference"},{"text":" is sent again under the same backoff and deadline as a 5xx.","type":"text"},{"text":" ","type":"text"},{"text":"An encoder should count an empty body, or one it can’t read, as delivered, so an answer it","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t recognize never sends a request again and again; the DestinationTesting conformance kit","type":"text"},{"text":" ","type":"text"},{"text":"checks that it does. A transient answer is retried until the request’s deadline, so an encoder","type":"text"},{"text":" ","type":"text"},{"text":"whose requests have none should return rejected instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each wait has full jitter by default: a random wait shorter than the nominal one, so apps refused","type":"text"},{"text":" ","type":"text"},{"text":"at the same moment retry at different moments. Pass ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/none","isActive":true,"type":"reference"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"nominal waits. In tests, pass a seeded generator as ","type":"text"},{"code":"randomNumberGenerator:","type":"codeVoice"},{"text":" for jittered waits","type":"text"},{"text":" ","type":"text"},{"text":"that repeat from one run to the next, as long as one request retries at a time: copies of a","type":"text"},{"text":" ","type":"text"},{"text":"destination retrying at once share the generator’s draws in the order they ask for them. Never","type":"text"},{"text":" ","type":"text"},{"text":"seed it in production, where every device would then wait the same, which defeats the jitter. The","type":"text"},{"text":" ","type":"text"},{"text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store","type":"text"},{"text":" ","type":"text"},{"text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose","type":"text"},{"text":" ","type":"text"},{"text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","isActive":true,"type":"reference"},{"text":" as an ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","isActive":true,"type":"reference"},{"text":", as is each record the encoder leaves out","type":"text"},{"text":" ","type":"text"},{"text":"of its requests. So is a request still undelivered at its ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","isActive":true,"type":"reference"},{"text":", which an","type":"text"},{"text":" ","type":"text"},{"text":"encoder sets for a vendor that misdates or ignores old events: the destination checks it on its","type":"text"},{"text":" ","type":"text"},{"code":"now:","type":"codeVoice"},{"text":" clock before every attempt and sends nothing more once it has passed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The tracing instrument injects the trace context of each request’s first record into its header","type":"text"},{"text":" ","type":"text"},{"text":"fields, and ","type":"text"},{"type":"codeVoice","code":"Content-Type"},{"text":" is always the encoder’s.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s"},{"type":"text","text":" "},{"type":"text","text":"format, give the destination a "},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"CollectorEncoding"},{"type":"text","text":"); for PostHog,"},{"type":"text","text":" "},{"type":"text","text":"make it with "},{"type":"codeVoice","code":"HTTPDestination.postHog(projectToken:host:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Amplitude, with "},{"type":"codeVoice","code":"HTTPDestination.amplitude(apiKey:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Mixpanel, with "},{"type":"codeVoice","code":"HTTPDestination.mixpanel(projectToken:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"MixpanelEncoding"},{"type":"text","text":");"},{"type":"text","text":" "},{"type":"text","text":"for Segment, RudderStack or Customer.io Data Pipelines, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.segment(writeKey:region:plan:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"rudderStack(writeKey:dataPlane:plan:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"customerIO(apiKey:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"SegmentSpecEncoding"},{"type":"text","text":"); for Google Analytics 4, from a"},{"type":"text","text":" "},{"type":"text","text":"server, with "},{"type":"codeVoice","code":"HTTPDestination.googleAnalytics(measurementID:apiSecret:region:plan:)"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"codeVoice","code":"GoogleAnalyticsEncoding"},{"type":"text","text":"); for Snowplow, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.snowplow(collector:vendor:appID:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"SnowplowEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck, with "},{"type":"codeVoice","code":"HTTPDestination.telemetryDeck(appID:namespace:testMode:plan:)"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"codeVoice","code":"TelemetryDeckEncoding"},{"type":"text","text":"); for Matomo, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.matomo(url:siteID:dimensions:category:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"MatomoEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Heap, with "},{"type":"codeVoice","code":"HTTPDestination.heap(appID:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"HeapEncoding"},{"type":"text","text":"); for Aptabase, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.aptabase(appKey:host:isDebug:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"AptabaseEncoding"},{"type":"text","text":"). To read events"},{"type":"text","text":" "},{"type":"text","text":"inside the app or in a test, use"},{"type":"text","text":" "},{"type":"codeVoice","code":"InMemoryDestination"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"Destinations"},{"type":"text","text":") instead."}]},{"type":"codeListing","code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    static let transientStatuses: Set<TransientStatus> = []","","    static func outcome(of response: HTTPTransportResponse, for request: EncodedRequest) -> ResponseOutcome {","        .delivered","    }","","    func requests(for batch: [EventRecord]) -> BatchRequests<Never> {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        let body = EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","        return BatchRequests(requests: [EncodedRequest(body: body, recordIDs: batch.map(\\.id))], skippedRecords: [])","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: try ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"covers this destination beside the others, and what a delivery does while a batch is retried."}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}],"variants":[{"paths":["\/documentation\/httpdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"sections":[],"references":{"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransportResponse":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse","title":"HTTPTransportResponse","url":"\/documentation\/httpdestinations\/httptransportresponse","role":"symbol","abstract":[{"type":"text","text":"What an "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","isActive":true},{"type":"text","text":" received for a request: the response’s status and header fields, and"},{"type":"text","text":" "},{"type":"text","text":"its body."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HTTPTransportResponse"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPTransportResponse"}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/EncodedRequest/deadline":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"deadline"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials4DateV","text":"Date"},{"kind":"text","text":"?"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The latest wall-clock time at which the request may be sent, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when it may be sent"},{"type":"text","text":" "},{"type":"text","text":"at any time."}],"url":"\/documentation\/httpdestinations\/encodedrequest\/deadline","title":"deadline","role":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/transientStatuses":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"transientStatuses"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"TransientStatus","preciseIdentifier":"s:16HTTPDestinations15TransientStatusV"},{"kind":"text","text":">"}],"kind":"symbol","required":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","type":"topic","role":"symbol","url":"\/documentation\/httpdestinations\/batchencoder\/transientstatuses","title":"transientStatuses","abstract":[{"type":"text","text":"The failure statuses, beyond 408 Request Timeout, 429 Too Many Requests and every 5xx, that"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference"},{"type":"text","text":" sends a request of this encoder again after: "},{"code":"[]","type":"codeVoice"},{"type":"text","text":" for none."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff/Jitter-swift.enum/none":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/none","title":"ExponentialBackoff.Jitter.none","url":"\/documentation\/httpdestinations\/exponentialbackoff\/jitter-swift.enum\/none","role":"symbol","abstract":[{"text":"The nominal wait, exactly.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"none"}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport":{"url":"\/documentation\/httpdestinations\/httpdropreport","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPDropReport","kind":"identifier"}],"role":"symbol","type":"topic","title":"HTTPDropReport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","navigatorTitle":[{"text":"HTTPDropReport","kind":"identifier"}],"abstract":[{"type":"text","text":"A batch "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" dropped without delivering it, and why."}],"kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport/rejectedInBody(status:reason:recordIDs:)":{"abstract":[{"text":"The endpoint answered with ","type":"text"},{"type":"codeVoice","code":"status"},{"text":", a 2xx, but the answer’s body says the vendor stored","type":"text"},{"text":" ","type":"text"},{"text":"none of the records and won’t if they are sent again (","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","isActive":true},{"text":" ","type":"text"},{"text":"returned ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)","isActive":true},{"text":"), for ","type":"text"},{"type":"codeVoice","code":"reason"},{"text":", so the batch of the records","type":"text"},{"text":" ","type":"text"},{"text":"identified by ","type":"text"},{"type":"codeVoice","code":"recordIDs"},{"text":", oldest first, was dropped. Mixpanel’s track API, answering 200","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"{\"status\": 0, \"error\": ...}"},{"text":", is one such vendor.","type":"text"}],"title":"HTTPDropReport.rejectedInBody(status:reason:recordIDs:)","url":"\/documentation\/httpdestinations\/httpdropreport\/rejectedinbody(status:reason:recordids:)","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"rejectedInBody"},{"kind":"text","text":"("},{"kind":"externalParam","text":"status"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9HTTPTypes12HTTPResponseV","kind":"typeIdentifier","text":"HTTPResponse"},{"kind":"text","text":"."},{"preciseIdentifier":"s:9HTTPTypes12HTTPResponseV6StatusV","kind":"typeIdentifier","text":"Status"},{"kind":"text","text":", "},{"kind":"externalParam","text":"reason"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"recordIDs"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:20FoundationEssentials4UUIDV","kind":"typeIdentifier","text":"UUID"},{"kind":"text","text":"])"}],"role":"symbol","type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","title":"ExponentialBackoff","url":"\/documentation\/httpdestinations\/exponentialbackoff","role":"symbol","abstract":[{"text":"How long ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true,"type":"reference"},{"text":" waits before each new attempt at a batch that wasn’t delivered:","type":"text"},{"text":" ","type":"text"},{"text":"binary exponential backoff, each nominal wait twice the one before, up to a maximum, with","type":"text"},{"text":" ","type":"text"},{"text":"jitter.","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ExponentialBackoff"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExponentialBackoff"}],"type":"topic"},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder":{"url":"\/documentation\/httpdestinations\/batchencoder","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchEncoder"}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchEncoder"}],"title":"BatchEncoder","abstract":[{"type":"text","text":"What turns a batch of records into the requests "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},{"type":"text","text":" sends."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/BatchEncoder/outcome(of:for:)":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)","required":true,"abstract":[{"text":"What the successful (2xx) answer ","type":"text"},{"code":"response","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"request","type":"codeVoice"},{"text":", one of this encoder’s requests,","type":"text"},{"text":" ","type":"text"},{"text":"means: whether the vendor stored the request’s records.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outcome","kind":"identifier