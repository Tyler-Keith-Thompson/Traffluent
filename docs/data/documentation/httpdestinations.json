{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"text":" is a destination that posts each batch it receives as the requests its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","type":"reference","isActive":true},{"text":" splits it into: one request for an endpoint without limits. Each body is whatever","type":"text"},{"text":" ","type":"text"},{"text":"the encoder writes for its records, so events need no ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance and the wire format is","type":"text"},{"text":" ","type":"text"},{"text":"yours. It sends with ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" through","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","type":"reference","isActive":true},{"text":" by default, or through any ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","type":"reference","isActive":true},{"text":" you pass.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A send that gets no response, or a 5xx, 408 or 429 status, is sent again after the next wait of its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","isActive":true,"type":"reference"},{"text":": nominally 1 second, doubling up to 60 seconds, unless you pass another. So","type":"text"},{"text":" ","type":"text"},{"text":"is one answered with a status the encoder lists in ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/transientStatuses","isActive":true,"type":"reference"},{"text":", which every","type":"text"},{"text":" ","type":"text"},{"text":"encoder declares: empty for most servers, or each other failure its vendor answers to a request","type":"text"},{"text":" ","type":"text"},{"text":"worth sending again, such as Aptabase’s 418 for a slow upload.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A 2xx counts as delivered unless the encoder’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder\/outcome(of:for:)"},{"text":" reads its body and","type":"text"},{"text":" ","type":"text"},{"text":"says otherwise. Some vendors answer 200 to a request they didn’t store, and say so only in the","type":"text"},{"text":" ","type":"text"},{"text":"body: Mixpanel’s ","type":"text"},{"type":"codeVoice","code":"{\"status\": 0}"},{"text":", or Aptabase’s ","type":"text"},{"type":"codeVoice","code":"{\"error\": ...}"},{"text":" for an unknown key. A 2xx the","type":"text"},{"text":" ","type":"text"},{"text":"encoder reads as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/rejected(reason:)"},{"text":" is dropped and reported as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport\/rejectedInBody(status:reason:recordIDs:)"},{"text":". One it reads as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)"},{"text":" is sent again under the same backoff and deadline as a 5xx.","type":"text"},{"text":" ","type":"text"},{"text":"An encoder should count an empty body, or one it can’t read, as delivered, so an answer it","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t recognize never sends a request again and again; the DestinationTesting conformance kit","type":"text"},{"text":" ","type":"text"},{"text":"checks that it does. A transient answer is retried until the request’s deadline, so an encoder","type":"text"},{"text":" ","type":"text"},{"text":"whose requests have none should return rejected instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each wait has full jitter by default: a random wait shorter than the nominal one, so apps refused","type":"text"},{"text":" ","type":"text"},{"text":"at the same moment retry at different moments. Pass ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/none","type":"reference"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"nominal waits. In tests, pass a seeded generator as ","type":"text"},{"code":"randomNumberGenerator:","type":"codeVoice"},{"text":" for jittered waits","type":"text"},{"text":" ","type":"text"},{"text":"that repeat from one run to the next, as long as one request retries at a time: copies of a","type":"text"},{"text":" ","type":"text"},{"text":"destination retrying at once share the generator’s draws in the order they ask for them. Never","type":"text"},{"text":" ","type":"text"},{"text":"seed it in production, where every device would then wait the same, which defeats the jitter. The","type":"text"},{"text":" ","type":"text"},{"text":"destination takes the next batch only once this one is delivered or dropped, so a tracker’s store","type":"text"},{"text":" ","type":"text"},{"text":"keeps the batch’s records until then. A batch the endpoint answers with any other status, whose","type":"text"},{"text":" ","type":"text"},{"text":"request can never be sent, or that the encoder can’t encode is dropped, logged and reported on","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","type":"reference"},{"text":" as an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","type":"reference"},{"text":", as is each record the encoder leaves out","type":"text"},{"text":" ","type":"text"},{"text":"of its requests. So is a request still undelivered at its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest\/deadline","type":"reference"},{"text":", which an","type":"text"},{"text":" ","type":"text"},{"text":"encoder sets for a vendor that misdates or ignores old events: the destination checks it on its","type":"text"},{"text":" ","type":"text"},{"code":"now:","type":"codeVoice"},{"text":" clock before every attempt and sends nothing more once it has passed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The tracing instrument injects the trace context of each request’s first record into its header","type":"text"},{"text":" ","type":"text"},{"text":"fields, and ","type":"text"},{"code":"Content-Type","type":"codeVoice"},{"text":" is always the encoder’s.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reach for this module to send to a server whose format you write yourself. For TraffluentCollector’s"},{"type":"text","text":" "},{"type":"text","text":"format, give the destination a "},{"type":"codeVoice","code":"CollectorBatchEncoder"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"CollectorEncoding"},{"type":"text","text":"); for PostHog,"},{"type":"text","text":" "},{"type":"text","text":"make it with "},{"type":"codeVoice","code":"HTTPDestination.postHog(projectToken:host:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"PostHogEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Amplitude, with "},{"type":"codeVoice","code":"HTTPDestination.amplitude(apiKey:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"AmplitudeEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Mixpanel, with "},{"type":"codeVoice","code":"HTTPDestination.mixpanel(projectToken:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"MixpanelEncoding"},{"type":"text","text":");"},{"type":"text","text":" "},{"type":"text","text":"for Segment, RudderStack or Customer.io Data Pipelines, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.segment(writeKey:region:plan:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"rudderStack(writeKey:dataPlane:plan:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"customerIO(apiKey:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"SegmentSpecEncoding"},{"type":"text","text":"); for Google Analytics 4, from a"},{"type":"text","text":" "},{"type":"text","text":"server, with "},{"type":"codeVoice","code":"HTTPDestination.googleAnalytics(measurementID:apiSecret:region:plan:)"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"codeVoice","code":"GoogleAnalyticsEncoding"},{"type":"text","text":"); for Snowplow, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.snowplow(collector:vendor:appID:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"SnowplowEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"TelemetryDeck, with "},{"type":"codeVoice","code":"HTTPDestination.telemetryDeck(appID:namespace:testMode:plan:)"},{"type":"text","text":" (module"},{"type":"text","text":" "},{"type":"codeVoice","code":"TelemetryDeckEncoding"},{"type":"text","text":"); for Matomo, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.matomo(url:siteID:dimensions:category:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"MatomoEncoding"},{"type":"text","text":"); for"},{"type":"text","text":" "},{"type":"text","text":"Heap, with "},{"type":"codeVoice","code":"HTTPDestination.heap(appID:region:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"HeapEncoding"},{"type":"text","text":"); for Aptabase, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"HTTPDestination.aptabase(appKey:host:isDebug:plan:)"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"AptabaseEncoding"},{"type":"text","text":"). To read events"},{"type":"text","text":" "},{"type":"text","text":"inside the app or in a test, use"},{"type":"text","text":" "},{"type":"codeVoice","code":"InMemoryDestination"},{"type":"text","text":" (module "},{"type":"codeVoice","code":"Destinations"},{"type":"text","text":") instead."}]},{"type":"codeListing","code":["import HTTPDestinations","","struct PlansEncoder: BatchEncoder {","    static let transientStatuses: Set<TransientStatus> = []","","    static func outcome(of response: HTTPTransportResponse, for request: EncodedRequest) -> ResponseOutcome {","        .delivered","    }","","    func requests(for batch: [EventRecord]) -> BatchRequests<Never> {","        let plans = batch.compactMap { ($0.event as? SignedUp)?.plan }","        let body = EncodedBatch(body: Data(plans.joined(separator: \"\\n\").utf8), contentType: \"text\/plain\")","        return BatchRequests(requests: [EncodedRequest(body: body, recordIDs: batch.map(\\.id))], skippedRecords: [])","    }","}","","let server = HTTPDestination(","    endpoint: endpointURL,","    headerFields: [.authorization: \"Bearer \\(token)\"],","    encoder: PlansEncoder(),","    backoff: try ExponentialBackoff(initialDelay: .seconds(2), maximumDelay: .seconds(120)))","let drops = server.dropReports","let watching = Task {","    for await drop in drops {","        print(\"Dropped a batch: \\(drop)\")","    }","}","let delivery = tracker.records.batch().deliver(to: server)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"covers this destination beside the others, and what a delivery does while a batch is retried.","type":"text"}]}]}],"topicSections":[{"title":"Sending batches","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport"],"anchor":"Sending-batches"},{"title":"Encoding a batch","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedBatch"],"anchor":"Encoding-a-batch"},{"title":"Reading a 2xx answer","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse"],"anchor":"Reading-a-2xx-answer"},{"title":"Splitting a batch into requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchRequests","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/EncodedRequest","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/SkippedRecord"],"anchor":"Splitting-a-batch-into-requests"},{"title":"Retrying a vendor’s own statuses","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/TransientStatus","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidTransientStatus"],"anchor":"Retrying-a-vendors-own-statuses"},{"title":"Waiting between attempts","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidBackoff","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/NonPositiveRetry"],"anchor":"Waiting-between-attempts"},{"title":"Sending requests","identifiers":["doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/URLSessionTransport","doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportError"],"anchor":"Sending-requests"}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},"metadata":{"symbolKind":"module","roleHeading":"Framework","role":"collection","title":"HTTPDestinations","modules":[{"name":"HTTPDestinations"}],"externalID":"HTTPDestinations"},"kind":"symbol","abstract":[{"type":"text","text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives."}],"variants":[{"paths":["\/documentation\/httpdestinations"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","titleInlineContent":[{"type":"text","text":"Choosing Destinations"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations"},"doc://HTTPDestinations/documentation/HTTPDestinations/InvalidTransientStatus":{"type":"topic","title":"InvalidTransientStatus","url":"\/documentation\/httpdestinations\/invalidtransientstatus","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InvalidTransientStatus","kind":"identifier"}],"navigatorTitle":[{"text":"InvalidTransientStatus","kind":"identifier"}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/InvalidTransientStatus","abstract":[{"text":"The error ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/TransientStatus\/init(_:)","type":"reference","isActive":true},{"text":" throws for a status that is neither a client error","type":"text"},{"text":" ","type":"text"},{"text":"(4xx) nor a server error (5xx).","type":"text"}],"kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDestination"}],"abstract":[{"text":"A destination that sends each batch it receives to an HTTP endpoint, as the requests its encoder","type":"text"},{"text":" ","type":"text"},{"text":"splits it into, and sends each again until it arrives.","type":"text"}],"type":"topic","title":"HTTPDestination","role":"symbol","url":"\/documentation\/httpdestinations\/httpdestination","navigatorTitle":[{"kind":"identifier","text":"HTTPDestination"}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination"},"doc://HTTPDestinations/documentation/HTTPDestinations/ExponentialBackoff/Jitter-swift.enum/none":{"url":"\/documentation\/httpdestinations\/exponentialbackoff\/jitter-swift.enum\/none","abstract":[{"text":"The nominal wait, exactly.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"none"}],"kind":"symbol","title":"ExponentialBackoff.Jitter.none","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/Jitter-swift.enum\/none"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransportResponse":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPTransportResponse"}],"type":"topic","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransportResponse","navigatorTitle":[{"kind":"identifier","text":"HTTPTransportResponse"}],"url":"\/documentation\/httpdestinations\/httptransportresponse","title":"HTTPTransportResponse","abstract":[{"type":"text","text":"What an "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","isActive":true},{"type":"text","text":" received for a request: the response’s status and header fields, and"},{"type":"text","text":" "},{"type":"text","text":"its body."}],"role":"symbol","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/ResponseOutcome/transient(reason:)":{"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transient","kind":"identifier"},{"text":"(","kind":"text"},{"text":"reason","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"The vendor stored none of the request’s records for now, for "},{"code":"reason","type":"codeVoice"},{"type":"text","text":", and may store them"},{"type":"text","text":" "},{"type":"text","text":"if it is sent again: "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" sends it again as it does after a 5xx, with the"},{"type":"text","text":" "},{"type":"text","text":"same backoff and the same deadline."}],"type":"topic","title":"ResponseOutcome.transient(reason:)","url":"\/documentation\/httpdestinations\/responseoutcome\/transient(reason:)","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ResponseOutcome\/transient(reason:)","kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDropReport":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPDropReport"}],"url":"\/documentation\/httpdestinations\/httpdropreport","title":"HTTPDropReport","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDropReport","navigatorTitle":[{"kind":"identifier","text":"HTTPDropReport"}],"abstract":[{"text":"A batch ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"text":" dropped without delivering it, and why.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPDestination/dropReports":{"title":"dropReports","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropReports","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AsyncQueue","kind":"typeIdentifier","preciseIdentifier":"s:11AsyncQueues0A5QueueV"},{"text":"<","kind":"text"},{"text":"HTTPDropReport","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations14HTTPDropReportO"},{"text":"<","kind":"text"},{"text":"Encoding","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations12BatchEncoderP7FailureQa"},{"text":">>","kind":"text"}],"url":"\/documentation\/httpdestinations\/httpdestination\/dropreports","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination\/dropReports","abstract":[{"type":"text","text":"A report of each batch dropped without being delivered, in the order they are dropped."}]},"doc://HTTPDestinations/documentation/HTTPDestinations/HTTPTransport":{"title":"HTTPTransport","role":"symbol","url":"\/documentation\/httpdestinations\/httptransport","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HTTPTransport"}],"abstract":[{"type":"text","text":"What sends an HTTP request and returns the server’s response: the seam between"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","isActive":true},{"type":"text","text":" and the network."}],"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPTransport","type":"topic","navigatorTitle":[{"kind":"identifier","text":"HTTPTransport"}],"kind":"symbol"},"doc://HTTPDestinations/documentation/HTTPDestinations/TransientStatus/init(_:)":{"type":"topic","title":"init(_:)","url":"\/documentation\/httpdestinations\/transientstatus\/init(_:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"HTTPResponse","kind":"typeIdentifier","preciseIdentifier":"s:9HTTPTypes12HTTPResponseV"},{"text":".","kind":"text"},{"text":"Status","kind":"typeIdentifier","preciseIdentifier":"s:9HTTPTypes12HTTPResponseV6StatusV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"InvalidTransientStatus","kind":"typeIdentifier","preciseIdentifier":"s:16HTTPDestinations22InvalidTransientStatusV"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"The failure status "},{"type":"codeVoice","code":"status"},{"type":"text","text":", for "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/HTTPDestination","type":"reference","isActive":true},{"type":"text","text":" to retry."}],"kind":"symbol","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/TransientStatus\/init(_:)"},"doc://HTTPDestinations/documentation/HTTPDestinations/NonPositiveRetry":{"title":"NonPositiveRetry","url":"\/documentation\/httpdestinations\/nonpositiveretry","navigatorTitle":[{"text":"NonPositiveRetry","kind":"identifier"}],"abstract":[{"type":"text","text":"The error "},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/ExponentialBackoff\/delay(beforeRetry:)","type":"reference","isActive":true},{"type":"text","text":" throws for a retry numbered below 1."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NonPositiveRetry","kind":"