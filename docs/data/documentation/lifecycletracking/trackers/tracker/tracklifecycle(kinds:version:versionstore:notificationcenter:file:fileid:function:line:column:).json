rtVersionString\"] as? String, ","kind":"text"},{"text":"versionStore","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VersionStore","kind":"typeIdentifier","preciseIdentifier":"s:17LifecycleTracking12VersionStoreP","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore"},{"text":" = FileVersionStore(), ","kind":"text"},{"text":"notificationCenter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"NotificationCenter","kind":"typeIdentifier","preciseIdentifier":"s:20FoundationEssentials18NotificationCenterC"},{"text":" = .default, ","kind":"text"},{"text":"file","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#file","kind":"keyword"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#fileID","kind":"keyword"},{"text":", ","kind":"text"},{"text":"function","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" = ","kind":"text"},{"text":"#function","kind":"keyword"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = ","kind":"text"},{"text":"#column","kind":"keyword"},{"text":") -> ","kind":"text"},{"text":"LifecycleObservation","kind":"typeIdentifier","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The kinds of event to track; every kind by default. Leaving one out doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"stop the rest of the work: the version is still saved, and the records still made","type":"text"},{"text":" ","type":"text"},{"text":"durable on backgrounding.","type":"text"}]}],"name":"kinds"},{"content":[{"inlineContent":[{"type":"text","text":"The version the app runs at now; the bundle’s "},{"code":"CFBundleShortVersionString","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"by default. "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" tracks neither installs nor updates, and saves nothing."}],"type":"paragraph"}],"name":"version"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Where the version is kept from one launch to the next; a","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"SegmentStore.defaultDirectory"},{"text":" by default.","type":"text"}]}],"name":"versionStore"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the platform posts its lifecycle notifications; the default"},{"type":"text","text":" "},{"type":"text","text":"center by default."}]}],"name":"notificationCenter"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s file; leave it to its default."}]}],"name":"file"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s module and file name; leave it to its default."}]}],"name":"fileID"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s enclosing declaration; leave it to its default.","type":"text"}]}],"name":"function"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s line; leave it to its default."}]}],"name":"line"},{"content":[{"inlineContent":[{"type":"text","text":"The caller’s column; leave it to its default."}],"type":"paragraph"}],"name":"column"}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The observation, which tracks until it is cancelled, finished or released."}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"Nothing is tracked until this is called. Call it as the app launches, such as in its"},{"type":"text","text":" "},{"type":"text","text":"application delegate’s "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":", and keep what it"},{"type":"text","text":" "},{"type":"text","text":"returns:"}],"type":"paragraph"},{"code":["lifecycle = tracker.trackLifecycle()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"As it starts, it compares ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" with the one ","type":"text"},{"code":"versionStore","type":"codeVoice"},{"text":" saved: none tracks an","type":"text"},{"text":" ","type":"text"},{"text":"install, another an update, the same neither; it then saves ","type":"text"},{"code":"version","type":"codeVoice"},{"text":". Then it tracks an","type":"text"},{"text":" ","type":"text"},{"text":"open, not from the background. After that, each transition tracks once, however many times","type":"text"},{"text":" ","type":"text"},{"text":"it is reported:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s notifications. Entering"},{"type":"text","text":" "},{"type":"text","text":"the background tracks "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded"},{"type":"text","text":", returning to the foreground"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened"},{"type":"text","text":" from the background, and terminating "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A scene-based app gets them once for the whole app, not per scene."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"watchOS: ","type":"text"},{"code":"WKApplication","type":"codeVoice"},{"text":"‘s, without termination, which watchOS doesn’t report.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"macOS: "},{"type":"codeVoice","code":"NSApplication"},{"type":"text","text":"’s. Another app becoming active counts as the background, this"},{"type":"text","text":" "},{"type":"text","text":"one becoming active again as the foreground."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Linux: no notifications; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()"},{"type":"text","text":" tracks the termination."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls","type":"text"},{"text":" ","type":"text"},{"text":"the store’s ","type":"text"},{"code":"synchronize()","type":"codeVoice"},{"text":". A delivery batched with ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","isActive":true,"type":"reference"},{"text":" sends what","type":"text"},{"text":" ","type":"text"},{"text":"is pending as it reads the ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","isActive":true,"type":"reference"},{"text":" record. A notification’s handler only","type":"text"},{"text":" ","type":"text"},{"text":"hands the transition on; the tracking, the version store and the store’s work run on a","type":"text"},{"text":" ","type":"text"},{"text":"task of their own, never on the thread that posted it. Where the system suspends an app in the","type":"text"},{"text":" ","type":"text"},{"text":"background (all but macOS and Mac Catalyst), the handler asks it for background time","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"ProcessInfo.performExpiringActivity","type":"codeVoice"},{"text":"), held until the records are durable. A termination’s records are made durable the same way, without","type":"text"},{"text":" ","type":"text"},{"text":"holding the main thread up: what the process doesn’t finish before it exits is what the","type":"text"},{"text":" ","type":"text"},{"text":"tracker’s documented loss window takes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per","type":"text"},{"text":" ","type":"text"},{"text":"tracker.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/lifecycletracking\/trackers\/tracker\/tracklifecycle(kinds:version:versionstore:notificationcenter:file:fileid:function:line:column:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","references":{"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationIns