{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Tracks the app’s lifecycle through this tracker until the observation it returns is","type":"text"},{"text":" ","type":"text"},{"text":"cancelled, finished or released: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationInstalled","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationUpdated","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference"},{"text":" as it starts, then ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference"},{"text":" again and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","type":"reference"},{"text":" as the app moves.","type":"text"}],"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"],"title":"Tracking the lifecycle","generated":true,"anchor":"Tracking-the-lifecycle"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/lifecycletracking\/trackers\/tracker\/tracklifecycle(kinds:version:versionstore:notificationcenter:file:fileid:function:line:column:)"]}],"sections":[],"identifier":{"url":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/Trackers\/Tracker\/trackLifecycle(kinds:version:versionStore:notificationCenter:file:fileID:function:line:column:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trackLifecycle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kinds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"LifecycleObservation","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV4KindO","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/Kind"},{"kind":"text","text":"> = Set(LifecycleObservation.Kind.allCases), "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String, "},{"kind":"externalParam","text":"versionStore"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"VersionStore","preciseIdentifier":"s:17LifecycleTracking12VersionStoreP","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/VersionStore"},{"kind":"text","text":" = FileVersionStore(), "},{"kind":"externalParam","text":"notificationCenter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"NotificationCenter","preciseIdentifier":"s:20FoundationEssentials18NotificationCenterC"},{"kind":"text","text":" = .default, "},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#file"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#fileID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"function"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#function"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#line"},{"kind":"text","text":", "},{"kind":"externalParam","text":"column"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#column"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"LifecycleObservation","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation"}],"platforms":["Linux"]}]},{"parameters":[{"name":"kinds","content":[{"type":"paragraph","inlineContent":[{"text":"The kinds of event to track; every kind by default. Leaving one out doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"stop the rest of the work: the version is still saved, and the records still made","type":"text"},{"text":" ","type":"text"},{"text":"durable on backgrounding.","type":"text"}]}]},{"name":"version","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The version the app runs at now; the bundle’s "},{"type":"codeVoice","code":"CFBundleShortVersionString"},{"type":"text","text":" "},{"type":"text","text":"by default. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" tracks neither installs nor updates, and saves nothing."}]}]},{"name":"versionStore","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the version is kept from one launch to the next; a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/FileVersionStore"},{"type":"text","text":" in "},{"type":"codeVoice","code":"SegmentStore.defaultDirectory"},{"type":"text","text":" by default."}]}]},{"name":"notificationCenter","content":[{"inlineContent":[{"text":"Where the platform posts its lifecycle notifications; the default","type":"text"},{"text":" ","type":"text"},{"text":"center by default.","type":"text"}],"type":"paragraph"}]},{"name":"file","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s file; leave it to its default.","type":"text"}]}]},{"name":"fileID","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s module and file name; leave it to its default.","type":"text"}]}]},{"name":"function","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s enclosing declaration; leave it to its default."}]}]},{"name":"line","content":[{"type":"paragraph","inlineContent":[{"text":"The caller’s line; leave it to its default.","type":"text"}]}]},{"name":"column","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller’s column; leave it to its default."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The observation, which tracks until it is cancelled, finished or released."}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing is tracked until this is called. Call it as the app launches, such as in its"},{"type":"text","text":" "},{"type":"text","text":"application delegate’s "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":", and keep what it"},{"type":"text","text":" "},{"type":"text","text":"returns:"}]},{"type":"codeListing","syntax":"swift","code":["lifecycle = tracker.trackLifecycle()"]},{"type":"paragraph","inlineContent":[{"text":"As it starts, it compares ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" with the one ","type":"text"},{"code":"versionStore","type":"codeVoice"},{"text":" saved: none tracks an","type":"text"},{"text":" ","type":"text"},{"text":"install, another an update, the same neither; it then saves ","type":"text"},{"code":"version","type":"codeVoice"},{"text":". Then it tracks an","type":"text"},{"text":" ","type":"text"},{"text":"open, not from the background. After that, each transition tracks once, however many times","type":"text"},{"text":" ","type":"text"},{"text":"it is reported:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"iOS, iPadOS, tvOS, visionOS and Mac Catalyst: "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":"’s notifications. Entering"},{"type":"text","text":" "},{"type":"text","text":"the background tracks "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"type":"text","text":", returning to the foreground"},{"type":"text","text":" "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened","type":"reference","isActive":true},{"type":"text","text":" from the background, and terminating "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"A scene-based app gets them once for the whole app, not per scene."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"watchOS: ","type":"text"},{"code":"WKApplication","type":"codeVoice"},{"text":"‘s, without termination, which watchOS doesn’t report.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"macOS: ","type":"text"},{"code":"NSApplication","type":"codeVoice"},{"text":"’s. Another app becoming active counts as the background, this","type":"text"},{"text":" ","type":"text"},{"text":"one becoming active again as the foreground.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Linux: no notifications; ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","isActive":true,"type":"reference"},{"text":" tracks the termination.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Leaving the foreground, it also makes the tracker’s records durable: it waits for the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s worker to write every record tracked so far to the tracker’s store, then calls"},{"type":"text","text":" "},{"type":"text","text":"the store’s "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":". A delivery batched with "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleBatchStrategy","type":"reference","isActive":true},{"type":"text","text":" sends what"},{"type":"text","text":" "},{"type":"text","text":"is pending as it reads the "},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationBackgrounded","type":"reference","isActive":true},{"type":"text","text":" record. A notification’s handler only"},{"type":"text","text":" "},{"type":"text","text":"hands the transition on; the tracking, the version store and the store’s work run on a"},{"type":"text","text":" "},{"type":"text","text":"task of their own, never on the thread that posted it. Where the system suspends an app in the"},{"type":"text","text":" "},{"type":"text","text":"background (all but macOS and Mac Catalyst), the handler asks it for background time"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"ProcessInfo.performExpiringActivity"},{"type":"text","text":"), held until the records are durable. A termination’s records are made durable the same way, without"},{"type":"text","text":" "},{"type":"text","text":"holding the main thread up: what the process doesn’t finish before it exits is what the"},{"type":"text","text":" "},{"type":"text","text":"tracker’s documented loss window takes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It keeps no state outside what it returns. Two calls observe twice, so call it once per"},{"type":"text","text":" "},{"type":"text","text":"tracker."}]}]}],"metadata":{"modules":[{"name":"LifecycleTracking","relatedModules":["Trackers"]}],"extendedModule":"Trackers","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trackLifecycle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kinds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV","text":"LifecycleObservation"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:17LifecycleTracking0A11ObservationV4KindO","text":"Kind"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"version"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"versionStore"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:17LifecycleTracking12VersionStoreP","text":"VersionStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"notificationCenter"},{"kind":"text","text":": "},{"kind"