ing","type":"topic","title":"LifecycleTracking","role":"collection","url":"\/documentation\/lifecycletracking"},"doc://LifecycleTracking/documentation/LifecycleTracking/ApplicationOpened/fromBackground":{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationOpened\/fromBackground","role":"symbol","url":"\/documentation\/lifecycletracking\/applicationopened\/frombackground","type":"topic","abstract":[{"text":"Whether the app came back from the background, rather than being launched.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fromBackground","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"fromBackground","kind":"symbol"},"doc://LifecycleTracking/documentation/LifecycleTracking/LifecycleObservation/finish()":{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/finish()","role":"symbol","url":"\/documentation\/lifecycletracking\/lifecycleobservation\/finish()","abstract":[{"text":"Ends the app’s lifecycle: stops observing it, then tracks ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/ApplicationTerminated","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"unless one was tracked already or ","type":"text"},{"identifier":"doc:\/\/LifecycleTracking\/documentation\/LifecycleTracking\/LifecycleObservation\/Kind\/terminated","isActive":true,"type":"reference"},{"text":" is off, and makes the tracker’s","type":"text"},{"text":" ","type":"text"},{"text":"records durable as on backgrounding. Returns once that is done, or at once if tracking","type":"text"},{"text":" ","type":"text"},{"text":"was cancelled.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finish"},{"kind":"text","text":"() "},{"ki