{"identifier":{"url":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscoveredEvent"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","isActive":true},{"type":"text","text":" lists every one the program links, from every module, so a store or a tracking plan"},{"type":"text","text":" "},{"type":"text","text":"can be built from it with no list to keep: "},{"code":"SegmentStore()","type":"codeVoice"},{"type":"text","text":", "},{"code":"DatabaseStore(database:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"TrackingPlan()","type":"codeVoice"},{"type":"text","text":" each use it."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Traffluent","","@Event(name: \"signed_up\")","struct SignedUp {","    var plan: String","}","","DiscoveredEvent.all.map { $0.type.name }","\/\/ [\"ApplicationBackgrounded\", ..., \"SessionStarted\", \"signed_up\"]"]},{"inlineContent":[{"type":"text","text":"Each "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" struct is discovered, wherever it is declared, unless it is generic or nested in"},{"type":"text","text":" "},{"type":"text","text":"a generic type, as neither can hold the record "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":" places in the binary; the macro notes"},{"type":"text","text":" "},{"type":"text","text":"each one where it is declared. One declared in an extension of a generic type doesn’t compile."},{"type":"text","text":" "},{"type":"text","text":"The library’s own events are discovered too: "},{"code":"SessionStarted","type":"codeVoice"},{"type":"text","text":", "},{"code":"SessionEnded","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"ScreenViewed","type":"codeVoice"},{"type":"text","text":", "},{"code":"ControlActivated","type":"codeVoice"},{"type":"text","text":" and the "},{"code":"Application","type":"codeVoice"},{"type":"text","text":" events of "},{"code":"LifecycleTracking","type":"codeVoice"},{"type":"text","text":", once"},{"type":"text","text":" "},{"type":"text","text":"their modules are linked. An event that conforms to "},{"identifier":"doc:\/\/Events\/documentation\/Events\/Event","isActive":true,"type":"reference"},{"type":"text","text":" by hand, without "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":", isn’t:"},{"type":"text","text":" "},{"type":"text","text":"list it beside the discovered ones, "},{"code":"DiscoveredEvent.all.map(\\.type) + [Legacy.self]","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Limits","type":"heading","text":"Limits"},{"items":[{"content":[{"inlineContent":[{"text":"An object file in a static archive that nothing references brings no record into the","type":"text"},{"text":" ","type":"text"},{"text":"program: the linker leaves it out. That happens with CocoaPods’ static libraries, a static","type":"text"},{"text":" ","type":"text"},{"text":"XCFramework, or a Bazel library with ","type":"text"},{"code":"alwayslink = False","type":"codeVoice"},{"text":". SwiftPM, and Bazel’s","type":"text"},{"text":" ","type":"text"},{"code":"alwayslink = True","type":"codeVoice"},{"text":", link every object file. Link such a library whole (","type":"text"},{"code":"-force_load","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"text":"Apple platforms, ","type":"text"},{"code":"--whole-archive","type":"codeVoice"},{"text":" on Linux) to have its events found.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","isActive":true},{"type":"text","text":" holds the events of the images loaded when it is called: the program and the"},{"type":"text","text":" "},{"type":"text","text":"dynamic libraries it links. A library opened later with "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" adds its events from then on."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A library that loads or unloads while "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all"},{"type":"text","text":" is read is either read whole or left out of"},{"type":"text","text":" "},{"type":"text","text":"that read. On Apple platforms one that dyld adds before the read starts is found; on Linux a"},{"type":"text","text":" "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" or "},{"type":"codeVoice","code":"dlclose"},{"type":"text","text":" waits for the read, so the library is missed. The next read sees it."}]}]},{"content":[{"inlineContent":[{"text":"Don’t ","type":"text"},{"type":"codeVoice","code":"dlclose"},{"text":" a library that declares events while the process runs. On Apple platforms","type":"text"},{"text":" ","type":"text"},{"text":"dyld keeps it mapped and its events are still found. On Linux the loader unmaps it while the","type":"text"},{"text":" ","type":"text"},{"text":"Swift runtime keeps its types registered, and the process can crash later. Keep plug-ins","type":"text"},{"text":" ","type":"text"},{"text":"open, or open them with ","type":"text"},{"type":"codeVoice","code":"RTLD_NODELETE"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A module that declares events, linked into two images, lists each of its events twice, and"},{"type":"text","text":" "},{"type":"text","text":"stores and plans refuse the duplicate. Link each such module into one image."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Two events of one name in one linked image, the modules linked statically into one executable","type":"text"},{"text":" ","type":"text"},{"text":"or library, fail to build: ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" gives each record a symbol named for the event’s name,","type":"text"},{"text":" ","type":"text"},{"text":"which the compiler or the linker refuses to define twice. Separate images are never compared,","type":"text"},{"text":" ","type":"text"},{"text":"so a name shared with a dynamic library, a library opened with ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":", or a module linked","type":"text"},{"text":" ","type":"text"},{"text":"into two images is found only here, and a store or plan built from ","type":"text"},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all","isActive":true},{"text":" refuses it. So is","type":"text"},{"text":" ","type":"text"},{"text":"one declared inside a ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"fileprivate","type":"codeVoice"},{"text":" type, whose symbol is local to its file.","type":"text"}]}]}],"type":"unorderedList"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Events\/s8SendableP","doc:\/\/Events\/s16SendableMetatypeP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/discoveredevent"]}],"topicSections":[{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/schema","doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/type"]},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/Events\/documentation\/Events\/DiscoveredEvent\/all"]}],"sections":[],"seeAlsoSections":[{"title":"Events","generated":true,"anchor":"Events","identifiers":["doc:\/\/Events\/documentation\/Events\/Event","doc:\/\/Events\/documentation\/Events\/ConsentCategory","doc:\/\/Events\/documentation\/Events\/EventSchema","doc:\/\/Events\/documentation\/Events\/EventSchema\/Enumeration"]}],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events"]]},"abstract":[{"text":"An event type found in the running program: one declared with ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":", or one of the","type":"text"},{"text":" ","type":"text"},{"text":"library’s own events, with its schema.","type":"text"}],"metadata":{"externalID":"s:6Events15DiscoveredEventV","modules":[{"name":"Events"}],"title":"DiscoveredEvent","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscoveredEvent","kind":"identifier"}],"symbolKind":"struct","navigatorTitle":[{"text":"DiscoveredEvent","kind":"identifier"}],"roleHeading":"Structure","remoteSource":{"fileName":"DiscoveredEvent.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DiscoveredEvent.swift#L54"}},"references":{"doc://Events/documentation/Events/Event":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Event","navigatorTitle":[{"text":"Event","kind":"identifier"}],"abstract":[{"type":"text","text":"Something that happened, recorded as a typed value."}],"kind":"symbol","title":"Event","url":"\/documentation\/events\/event","type":"topic","role":"symbol"},"doc://Events/documentation/Events/DiscoveredEvent/all":{"title":"all","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"all","kind":"identifier"},{"text":": ["