{"defaultImplementationsSections":[{"identifiers":["doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)-4jg2u"],"title":"Acknowledger Implementations","anchor":"Acknowledger-Implementations"}],"hierarchy":{"paths":[["doc:\/\/Events\/documentation\/Events","doc:\/\/Events\/documentation\/Events\/Acknowledger"]]},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/events\/acknowledger\/records(at:)"]}],"metadata":{"title":"records(at:)","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Traffluent\/blob\/main\/Sources\/Events\/DeliveryTag.swift#L77","fileName":"DeliveryTag.swift"},"modules":[{"name":"Events"}],"role":"symbol","required":true,"roleHeading":"Instance Method","externalID":"s:6Events12AcknowledgerP7records2atSayAA11EventRecordVGSays6UInt64VG_tF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V","text":"UInt64"},{"kind":"text","text":"]) -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord"},{"kind":"text","text":"]"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"positions","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"UInt64","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V"},{"text":"]) -> [","kind":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","text":"EventRecord","kind":"typeIdentifier","preciseIdentifier":"s:6Events11EventRecordV"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"positions","content":[{"inlineContent":[{"type":"text","text":"The positions of records in this store a delivery handed to"},{"type":"text","text":" "},{"type":"text","text":"destinations."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The records kept at those positions, each tagged with its ","type":"text"},{"identifier":"doc:\/\/Events\/documentation\/Events\/DeliveryTag","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"naming this store, in any order.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"A delivery calls it once that destination has caught up, hands it the records returned,"},{"type":"text","text":" "},{"type":"text","text":"and counts its receipt towards "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/acknowledge(_:)","isActive":true},{"type":"text","text":" for those records alone. A position the"},{"type":"text","text":" "},{"type":"text","text":"store no longer keeps (its bound dropped the record, which it reports) gives no record, and"},{"type":"text","text":" "},{"type":"text","text":"neither does any position when the store can’t read records back, as with the default"},{"type":"text","text":" "},{"type":"text","text":"implementation. The delivery never acknowledges a record it couldn’t hand to every"},{"type":"text","text":" "},{"type":"text","text":"destination, so a store that still keeps one delivers it on a later launch, with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","isActive":true},{"type":"text","text":" set."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A store of your own should implement it. Without it, the default returns no records, so a"},{"type":"text","text":" "},{"type":"text","text":"batch a full buffer dropped isn’t sent again in this run: the destination whose buffer"},{"type":"text","text":" "},{"type":"text","text":"dropped it never gets it in this run, every destination gets it again on the next launch,"},{"type":"text","text":" "},{"type":"text","text":"marked redelivered, and the store holds it until then, toward its bound."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The delivery gives each record returned the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"sensitive-value visibility and the "},{"code":"ServiceContext","type":"codeVoice"},{"type":"text","text":" the record had when the buffer dropped"},{"type":"text","text":" "},{"type":"text","text":"it, so a store needn’t keep them. A record tagged with another store is ignored."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)","interfaceLanguage":"swift"},"abstract":[{"text":"The records this store still keeps at ","type":"text"},{"code":"positions","type":"codeVoice"},{"text":", read back for a destination whose","type":"text"},{"text":" ","type":"text"},{"text":"delivery buffer dropped them before it received them.","type":"text"}],"references":{"doc://Events/documentation/Events/EventRecord/isRedelivered":{"type":"topic","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord\/isRedelivered","title":"isRedelivered","abstract":[{"type":"text","text":"Whether the record may have reached a destination before: it was handed to a delivery in an"},{"type":"text","text":" "},{"type":"text","text":"earlier run of the app, which ended before the delivery was acknowledged."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isRedelivered"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"kind":"symbol","role":"symbol","url":"\/documentation\/events\/eventrecord\/isredelivered"},"doc://Events/documentation/Events/EventRecord":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventRecord","kind":"identifier"}],"navigatorTitle":[{"text":"EventRecord","kind":"identifier"}],"url":"\/documentation\/events\/eventrecord","identifier":"doc:\/\/Events\/documentation\/Events\/EventRecord","type":"topic","title":"EventRecord","kind":"symbol","abstract":[{"text":"A tracked event: the event itself, when it was tracked, where, and the context it was tracked in.","type":"text"}]},"doc://Events/documentation/Events":{"url":"\/documentation\/events","role":"collection","type":"topic","identifier":"doc:\/\/Events\/documentation\/Events","title":"Events","abstract":[{"text":"The types every other module shares: the ","type":"text"},{"code":"Event","type":"codeVoice"},{"text":" protocol, the values its properties can hold, and the record a tracker makes of each event.","type":"text"}],"kind":"symbol"},"doc://Events/documentation/Events/Acknowledger/records(at:)":{"type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"UInt64","preciseIdentifier":"s:s6UInt64V","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"text":"EventRecord","preciseIdentifier":"s:6Events11EventRecordV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)","role":"symbol","title":"records(at:)","required":true,"url":"\/documentation\/events\/acknowledger\/records(at:)","abstract":[{"type":"text","text":"The records this store still keeps at "},{"type":"codeVoice","code":"positions"},{"type":"text","text":", read back for a destination whose"},{"type":"text","text":" "},{"type":"text","text":"delivery buffer dropped them before it received them."}],"defaultImplementations":1},"doc://Events/documentation/Events/Acknowledger/acknowledge(_:)":{"required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"acknowledge","kind":"identifier"},{"text":"([","kind":"text"},{"text":"UInt64","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt64V"},{"text":"])","kind":"text"}],"url":"\/documentation\/events\/acknowledger\/acknowledge(_:)","abstract":[{"text":"Every destination has received the records at ","type":"text"},{"code":"positions","type":"codeVoice"},{"text":", so the store can forget them.","type":"text"}],"title":"acknowledge(_:)","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/acknowledge(_:)"},"doc://Events/documentation/Events/Acknowledger/records(at:)-4jg2u":{"abstract":[{"type":"text","text":"No records: a store that can’t read its records back keeps those of a batch a"},{"type":"text","text":" "},{"type":"text","text":"destination’s full buffer dropped for a later launch to deliver."}],"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:s6UInt64V","text":"UInt64","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"preciseIdentifier":"s:6Events11EventRecordV","text":"EventRecord","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","title":"records(at:)","url":"\/documentation\/events\/acknowledger\/records(at:)-4jg2u","identifier":"doc:\/\/Events\/documentation\/Events\/Acknowledger\/records(at:)-4jg2u"},"doc://Events/