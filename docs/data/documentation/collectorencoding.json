{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"title":"Encoding batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"],"anchor":"Encoding-batches"},{"title":"Records left out","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"],"anchor":"Records-left-out"},{"title":"Decoding batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/DecodedCollectorBatch","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoderError","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/NotACollectorBatch"],"anchor":"Decoding-batches"},{"title":"Records that can’t be read","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/UndecodedRecord","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorDecodingError"],"anchor":"Records-that-cant-be-read"}],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" for a self-hosted TraffluentCollector’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/v1\/batches"},{"type":"text","text":". Give it to an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":") as its encoder,"},{"type":"text","text":" "},{"type":"text","text":"and pass the collector’s API key to the destination as an "},{"type":"codeVoice","code":"Authorization: Bearer"},{"type":"text","text":" header field."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record"},{"type":"text","text":" "},{"type":"text","text":"keeps), the event’s name and version, its timestamp, whether it is redelivered, its properties and"},{"type":"text","text":" "},{"type":"text","text":"its context."},{"type":"text","text":" "},{"type":"text","text":"Properties are read from the event’s "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" form, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. The context holds the standard"},{"type":"text","text":" "},{"type":"text","text":"context keys the record has values for, its session and sample rate, and its trace context. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is written only while the record reveals it; once redacted, a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"text","text":"property is left out, and an array’s element, or a value inside a type the plan can’t map, is"},{"type":"text","text":" "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and"},{"type":"text","text":" "},{"type":"text","text":"version the plan doesn’t describe, one whose event isn’t "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":", one holding a value"},{"type":"text","text":" "},{"type":"text","text":"JSON can’t, such as a NaN, and one whose timestamp has no ISO 8601 form (NaN, infinite, or more"},{"type":"text","text":" "},{"type":"text","text":"than "},{"type":"codeVoice","code":"Int64.max"},{"type":"text","text":" milliseconds from 1970). "},{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/requests(for:)"},{"type":"text","text":" returns each record left out"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":" (module "},{"isActive":true,"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"type":"text","text":"), which the destination logs and reports on"},{"type":"text","text":" "},{"type":"text","text":"its "},{"type":"codeVoice","code":"dropReports"},{"type":"text","text":". When no record of a batch can be written, the destination sends nothing."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)"},{"type":"text","text":" returns the same body and skipped records without a"},{"type":"text","text":" "},{"type":"text","text":"destination."}]},{"type":"paragraph","inlineContent":[{"text":"To send to a server of your own format, write a ","type":"text"},{"code":"BatchEncoder","type":"codeVoice"},{"text":" of your own. To send to PostHog,","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"code":"PostHogBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"PostHogEncoding","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The guide "},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers sending to the collector beside the other destinations."}]},{"type":"heading","level":3,"anchor":"Reading-batches-back","text":"Reading batches back"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder","type":"reference"},{"type":"text","text":" reads a body the encoder wrote back into "},{"code":"EventRecord","type":"codeVoice"},{"type":"text","text":"s, for a server"},{"type":"text","text":" "},{"type":"text","text":"that receives an app’s batches and hands them to another destination, such as a relay in front"},{"type":"text","text":" "},{"type":"text","text":"of Google Analytics. Make it with the plan the app’s encoder was made with. It finds each record’s"},{"type":"text","text":" "},{"type":"text","text":"event type by name and version among the "},{"code":"@Event","type":"codeVoice"},{"type":"text","text":"s the server links, or among the types you list"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder\/init(plan:events:instrument:)","type":"reference"},{"type":"text","text":")."}]},{"type":"codeListing","syntax":"swift","code":["import CollectorEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let decoder = try CollectorBatchDecoder(plan: plan)","let batch = try decoder.batch(from: body)  \/\/ a body CollectorBatchEncoder wrote","await destination.receive(batch.records)"]},{"type":"paragraph","inlineContent":[{"text":"Each record keeps its identifier, timestamp (to the millisecond), event, redelivery flag and the","type":"text"},{"text":" ","type":"text"},{"text":"context the body holds: its session’s ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", its sample rate, the standard context and its","type":"text"},{"text":" ","type":"text"},{"text":"trace context, which the decoder’s instrument extracts. Encoding the records again with an encoder","type":"text"},{"text":" ","type":"text"},{"text":"of the same plan writes the same bytes. A record the decoder can’t read is left out and the rest","type":"text"},{"text":" ","type":"text"},{"text":"are read: one of an event it has no type for, one at a version it has no type for or the plan","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t describe, one missing a member or holding what the encoder never writes, and one with a","type":"text"},{"text":" ","type":"text"},{"text":"property the event’s type can’t read: a required ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" property a delivery redacted, an","type":"text"},{"text":" ","type":"text"},{"text":"array of non-optional ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" elements it redacted, or an integer outside its property’s type.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each record states its event’s version, and is read into the decoder’s type of that name and","type":"text"},{"text":" ","type":"text"},{"text":"version. Once an app raises an event’s version, its releases still installed send the earlier","type":"text"},{"text":" ","type":"text"},{"text":"one, so the server keeps a type for each version the apps send. Two ","type":"text"},{"type":"codeVoice","code":"@Event"},{"text":" types of one name","type":"text"},{"text":" ","type":"text"},{"text":"build only when the earlier one sits in a ","type":"text"},{"type":"codeVoice","code":"private"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"fileprivate"},{"text":" scope, where the decoder and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"TrackingPlan()"},{"text":" still find it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Event(name: \"checkout_started\", version: 2)","struct CheckoutStarted {","    var items: Int","    var currency: String","}","","\/\/ Version 1, which releases still installed send.","private enum EarlierVersions {","    @Event(name: \"checkout_started\")","    struct CheckoutStarted {","        var items: Int","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Declare the earlier version’s type at file scope, as above, or ","type":"text"},{"code":"fileprivate","type":"codeVoice"},{"text":" inside another type:","type":"text"},{"text":" ","type":"text"},{"code":"@Event","type":"codeVoice"},{"text":" can’t expand inside a type that is a ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" member of another","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/definingevents"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record at a version the server has no type for is reported as "},{"code":"unknownVersion","type":"codeVoice"},{"type":"text","text":". Apps built with"},{"type":"text","text":" "},{"type":"text","text":"an earlier Traffluent send no version, and the decoder reads such a record at version 1, or at the"},{"type":"text","text":" "},{"type":"text","text":"lowest version it has when it has no version 1. Those apps sent version 1 unless the event declared"},{"type":"text","text":" "},{"type":"text","text":"another. A record one of them sent at a raised version is read at version 1 too: it is reported"},{"type":"text","text":" "},{"type":"text","text":"as "},{"code":"undecodableProperty","type":"codeVoice"},{"type":"text","text":" when its properties don’t fit that type, and is read as version 1 when"},{"type":"text","text":" "},{"type":"text","text":"they fit."},{"type":"text","text":" "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/DecodedCollectorBatch\/undecodedRecords","isActive":true,"type":"reference"},{"type":"text","text":" holds a report of each, an "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/UndecodedRecord","isActive":true,"type":"reference"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"reason is a "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorDecodingError","isActive":true,"type":"reference"},{"type":"text","text":". A body that isn’t a collector batch at all throws"},{"type":"text","text":" "},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/NotACollectorBatch","isActive":true,"type":"reference"},{"type":"text","text":"."}]}]}],"abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" to send,","type":"text"},{"text":" ","type":"text"},{"text":"and read them back into records on a server.","type":"text"}],"variants":[{"paths":["\/documentation\/collectorencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"CollectorEncoding","symbolKind":"module","modules":[{"name":"CollectorEncoding"}],"externalID":"CollectorEncoding","roleHeading":"Framework","role":"collection"},"hierarchy":{"paths":[[]]},"references":{"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder":{"abstract":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestination