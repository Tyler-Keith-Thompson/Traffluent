{"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"role":"collection","modules":[{"name":"CollectorEncoding"}],"roleHeading":"Framework","title":"CollectorEncoding","externalID":"CollectorEncoding","symbolKind":"module"},"identifier":{"url":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Write batches of records in TraffluentCollector’s ingest format, for an ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" to send,","type":"text"},{"text":" ","type":"text"},{"text":"and read them back into records on a server.","type":"text"}],"variants":[{"paths":["\/documentation\/collectorencoding"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","isActive":true},{"type":"text","text":" is the "},{"type":"codeVoice","code":"BatchEncoder"},{"type":"text","text":" for a self-hosted TraffluentCollector’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"POST \/v1\/batches"},{"type":"text","text":". Give it to an "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" (module "},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","isActive":true},{"type":"text","text":") as its encoder,"},{"type":"text","text":" "},{"type":"text","text":"and pass the collector’s API key to the destination as an "},{"type":"codeVoice","code":"Authorization: Bearer"},{"type":"text","text":" header field."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The body is JSON: one object per record, with the record’s identifier (which a redelivered record"},{"type":"text","text":" "},{"type":"text","text":"keeps), the event’s name, its timestamp, whether it is redelivered, its properties and its context."},{"type":"text","text":" "},{"type":"text","text":"Properties are read from the event’s "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" form, which "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":" derives, through the"},{"type":"text","text":" "},{"type":"text","text":"event’s schema in the "},{"type":"codeVoice","code":"TrackingPlan"},{"type":"text","text":" the encoder is made with. The context holds the standard"},{"type":"text","text":" "},{"type":"text","text":"context keys the record has values for, its session and sample rate, and its trace context. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" value is written only while the record reveals it; once redacted, a "},{"type":"codeVoice","code":"Sensitive"},{"type":"text","text":" "},{"type":"text","text":"property is left out, and an array’s element, or a value inside a type the plan can’t map, is"},{"type":"text","text":" "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"A record the encoder can’t write is left out and the rest of the batch is sent: one whose event and","type":"text"},{"text":" ","type":"text"},{"text":"version the plan doesn’t describe, one whose event isn’t ","type":"text"},{"code":"Encodable","type":"codeVoice"},{"text":", one holding a value","type":"text"},{"text":" ","type":"text"},{"text":"JSON can’t, such as a NaN, and one whose timestamp has no ISO 8601 form (NaN, infinite, or more","type":"text"},{"text":" ","type":"text"},{"text":"than ","type":"text"},{"code":"Int64.max","type":"codeVoice"},{"text":" milliseconds from 1970). ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/requests(for:)","type":"reference","isActive":true},{"text":" returns each record left out","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"code":"SkippedRecord","type":"codeVoice"},{"text":" (module ","type":"text"},{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"reference","isActive":true},{"text":"), which the destination logs and reports on","type":"text"},{"text":" ","type":"text"},{"text":"its ","type":"text"},{"code":"dropReports","type":"codeVoice"},{"text":". When no record of a batch can be written, the destination sends nothing.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","type":"reference","isActive":true},{"text":" returns the same body and skipped records without a","type":"text"},{"text":" ","type":"text"},{"text":"destination.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To send to a server of your own format, write a "},{"code":"BatchEncoder","type":"codeVoice"},{"type":"text","text":" of your own. To send to PostHog,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"code":"PostHogBatchEncoder","type":"codeVoice"},{"type":"text","text":" (module "},{"code":"PostHogEncoding","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"code":["import CollectorEncoding","import HTTPDestinations","import TrackingPlans","","let plan = try TrackingPlan()","let encoder = CollectorBatchEncoder(plan: plan)","let collector = HTTPDestination(","    endpoint: collectorURL,  \/\/ https:\/\/collector.example.com\/v1\/batches","    headerFields: [.authorization: \"Bearer \\(apiKey)\"],","    encoder: encoder)","let delivery = tracker.records.batch().deliver(to: collector)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The guide "},{"type":"reference","isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations"},{"type":"text","text":" "},{"type":"text","text":"covers sending to the collector beside the other destinations."}],"type":"paragraph"},{"anchor":"Reading-batches-back","level":3,"text":"Reading batches back","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder","type":"reference","isActive":true},{"type":"text","text":" reads a body the encoder wrote back into "},{"type":"codeVoice","code":"EventRecord"},{"type":"text","text":"s, for a server"},{"type":"text","text":" "},{"type":"text","text":"that receives an app’s batches and hands them to another destination, such as a relay in front"},{"type":"text","text":" "},{"type":"text","text":"of Google Analytics. Make it with the plan the app’s encoder was made with. It finds each record’s"},{"type":"text","text":" "},{"type":"text","text":"event type by name among the "},{"type":"codeVoice","code":"@Event"},{"type":"text","text":"s the server links, or among the types you list"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder\/init(plan:events:instrument:)","type":"reference","isActive":true},{"type":"text","text":")."}],"type":"paragraph"},{"code":["import CollectorEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let decoder = try CollectorBatchDecoder(plan: plan)","let batch = try decoder.batch(from: body)  \/\/ a body CollectorBatchEncoder wrote","await destination.receive(batch.records)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each record keeps its identifier, timestamp (to the millisecond), event, redelivery flag and the","type":"text"},{"text":" ","type":"text"},{"text":"context the body holds: its session’s ","type":"text"},{"type":"codeVoice","code":"SessionKey"},{"text":", its sample rate, the standard context and its","type":"text"},{"text":" ","type":"text"},{"text":"trace context, which the decoder’s instrument extracts. Encoding the records again with an encoder","type":"text"},{"text":" ","type":"text"},{"text":"of the same plan writes the same bytes. A record the decoder can’t read is left out and the rest","type":"text"},{"text":" ","type":"text"},{"text":"are read: one of an event it has no type of, or whose type’s version the plan doesn’t describe, one","type":"text"},{"text":" ","type":"text"},{"text":"missing a member or holding what the encoder never writes, and one with a property the event’s","type":"text"},{"text":" ","type":"text"},{"text":"type can’t read: a required ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" property a delivery redacted, an array of non-optional","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" elements it redacted, or an integer outside its property’s type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The body names each record’s event but not its version, so a record is read at the version of the"},{"type":"text","text":" "},{"type":"text","text":"decoder’s type of that name. Deploy the server with the event types the apps send. Once an event’s"},{"type":"text","text":" "},{"type":"text","text":"version is raised, a record from an app still at the earlier version is read as the newer one:"},{"type":"text","text":" "},{"type":"text","text":"reported as "},{"type":"codeVoice","code":"undecodableProperty"},{"type":"text","text":" when its properties don’t fit the newer type, and read as the"},{"type":"text","text":" "},{"type":"text","text":"newer version when they do."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/DecodedCollectorBatch\/undecodedRecords","isActive":true},{"type":"text","text":" holds a report of each, an "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/UndecodedRecord","isActive":true},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"reason is a "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorDecodingError","isActive":true},{"type":"text","text":". A body that isn’t a collector batch at all throws"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/NotACollectorBatch","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"topicSections":[{"title":"Encoding batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch"],"anchor":"Encoding-batches"},{"title":"Records left out","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorEncodingError"],"anchor":"Records-left-out"},{"title":"Decoding batches","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/DecodedCollectorBatch","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoderError","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/NotACollectorBatch"],"anchor":"Decoding-batches"},{"title":"Records that can’t be read","identifiers":["doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/UndecodedRecord","doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorDecodingError"],"anchor":"Records-that-cant-be-read"}],"references":{"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchDecoder/init(plan:events:instrument:)":{"type":"topic","url":"\/documentation\/collectorencoding\/collectorbatchdecoder\/init(plan:events:instrument:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder\/init(plan:events:instrument:)","abstract":[{"type":"text","text":"A decoder of records of "},{"type":"codeVoice","code":"events"},{"type":"text","text":", whose properties "},{"type":"codeVoice","code":"plan"},{"type":"text","text":" describes, extracting each"},{"type":"text","text":" "},{"type":"text","text":"record’s trace context as "},{"type":"codeVoice","code":"instrument"},{"type":"text","text":" does."}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"plan","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TrackingPlan","preciseIdentifier":"s:13TrackingPlans0A4PlanV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"events","kind":"externalParam"},{"text":": [any (","kind":"text"},{"text":"Event","preciseIdentifier":"s:6Events5EventP","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"text":"Decodable","preciseIdentifier":"s:Se","kind":"typeIdentifier"},{"text":").Type], ","kind":"text"},{"text":"instrument","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Instrument","preciseIdentifier":"s:15Instrumentation10InstrumentP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"CollectorBatchDecoderError","preciseIdentifier":"s:17CollectorEncoding0A17BatchDecoderErrorO","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(plan:events:instrument:)"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatch":{"abstract":[{"text":"A batch as ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","isActive":true,"type":"reference"},{"text":" encodes it: the body of the records it could","type":"text"},{"text":" ","type":"text"},{"text":"encode, and the records it left out.","type":"text"}],"kind":"symbol","title":"CollectorBatch","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch","url":"\/documentation\/collectorencoding\/collectorbatch","n