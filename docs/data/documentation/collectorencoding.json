e body of the records it could"},{"type":"text","text":" "},{"type":"text","text":"encode, and the records it left out."}],"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatch","title":"CollectorBatch","kind":"symbol","url":"\/documentation\/collectorencoding\/collectorbatch","navigatorTitle":[{"text":"CollectorBatch","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CollectorBatch","kind":"identifier"}],"type":"topic"},"doc://CollectorEncoding/documentation/CollectorEncoding/DecodedCollectorBatch":{"url":"\/documentation\/collectorencoding\/decodedcollectorbatch","title":"DecodedCollectorBatch","type":"topic","abstract":[{"text":"A collector batch as ","type":"text"},{"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchDecoder\/batch(from:)","isActive":true,"type":"reference"},{"text":" reads it: the records it read back,","type":"text"},{"text":" ","type":"text"},{"text":"and the ones it couldn’t.","type":"text"}],"navigatorTitle":[{"text":"DecodedCollectorBatch","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DecodedCollectorBatch","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/DecodedCollectorBatch"},"doc://CollectorEncoding/documentation/CollectorEncoding/CollectorBatchEncoder/batch(of:)":{"role":"symbol","abstract":[{"type":"text","text":"The body of "},{"type":"codeVoice","code":"batch"},{"type":"text","text":" in TraffluentCollector’s ingest format, and the records left out of it."}],"identifier":"doc:\/\/CollectorEncoding\/documentation\/CollectorEncoding\/CollectorBatchEncoder\/batch(of:)","title":"batch(of:)","kind":"symbol","url":"\/documentation\/collectorencoding\/collectorbatchencoder\/batch(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","