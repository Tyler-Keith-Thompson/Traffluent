":{"type":"topic","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","kind":"symbol","role":"collection","url":"\/documentation\/posthogencoding","abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}],"title":"PostHogEncoding"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder/batchLimit":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"batchLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12PropertyJSON10BatchLimitV","text":"BatchLimit"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit","role":"symbol","url":"\/documentation\/posthogencoding\/posthogbatchencoder\/batchlimit","abstract":[{"text":"PostHog’s limits on one request: 10,000,000 bytes of body and 1,000,000 bytes of one event,","type":"text"},{"text":" ","type":"text"},{"text":"with no limit on the count of events.","type":"text"}],"title":"batchLimit"},"https://tyler-keith-thompson.github.io/Traffluent/documentation/traffluent/choosingdestinations":{"titleInlineContent":[{"text":"Choosing Destinations","type":"text"}],"url":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"link","identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","title":"Choosing Destinations"},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder":{"role":"symbol","title":"PostHogBatchEncoder","kind":"symbol","navigatorTitle":[{"text":"PostHogBatchEncoder","kind":"identifier"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","abstract":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations\/BatchEncoder","isActive":true},{"text":" of PostHog’s batch capture API, so an ","type":"text"},{"code":"HTTPDestination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"can send events to PostHog Cloud or a self-hosted PostHog’s ","type":"text"},{"code":"POST \/batch\/","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","url":"\/documentation\/posthogencoding\/posthogbatchencoder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostHogBatchEncoder","kind":"identifier"}]},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogEncodingError":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostHogEncodingError"}],"navigatorTitle":[{"kind":"identifier","text":"PostHogEncodingError"}],"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","role":"symbol","url":"\/documentation\/posthogencoding\/posthogencodingerror","abstract":[{"type":"text","text":"Why "},{"type":"reference","identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","isActive":true},{"type":"text","text":" couldn’t send a record, which it leaves out of the batch’s requests"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"codeVoice","code":"SkippedRecord"},{"type":"text","text":", and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" reports as a drop. When it can encode no record of"},{"type":"text","text":" "},{"type":"text","text":"a batch, it makes no request, and "},{"type":"codeVoice","code":"HTTPDestination"},{"type":"text","text":" sends nothing for the batch."}],"title":"PostHogEncodingError"}}}