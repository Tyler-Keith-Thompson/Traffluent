{"identifier":{"url":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Send records to PostHog Cloud or a self-hosted PostHog through its batch capture API."}],"topicSections":[{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:transport:backoff:clock:)","doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogSetupError"],"anchor":"Sending-to-PostHog","title":"Sending to PostHog"},{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"],"anchor":"Encoding-batches","title":"Encoding batches"},{"identifiers":["doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError"],"anchor":"Records-left-out","title":"Records left out"}],"sections":[],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/HTTPDestinations\/HTTPDestination\/postHog(projectToken:host:plan:backoff:clock:)"},{"text":" makes an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HTTPDestination"},{"text":" (module ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations"},{"text":") for your PostHog project in one call. It checks","type":"text"},{"text":" ","type":"text"},{"text":"the project token and the host, posts to the host’s ","type":"text"},{"type":"codeVoice","code":"\/batch\/"},{"text":" with a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"splits each batch to PostHog’s limits (","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder\/batchLimit"},{"text":"). A batch with no","type":"text"},{"text":" ","type":"text"},{"text":"record the encoder can write, an empty one included, makes no request. It retries no response, a","type":"text"},{"text":" ","type":"text"},{"text":"5xx, 408 and 429, and drops and reports any other status. The project token goes in","type":"text"},{"text":" ","type":"text"},{"text":"the body, so no header field is needed, and no trace context is sent. ","type":"text"},{"type":"codeVoice","code":"import Traffluent"},{"text":" leaves","type":"text"},{"text":" ","type":"text"},{"text":"this module out; import it on its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each record becomes an anonymous event. Its ","type":"text"},{"code":"distinct_id","type":"codeVoice"},{"text":" is the record’s session, from the","type":"text"},{"text":" ","type":"text"},{"text":"sessions enricher, also sent as ","type":"text"},{"code":"$session_id","type":"codeVoice"},{"text":"; a record with no session is sent under its own","type":"text"},{"text":" ","type":"text"},{"text":"record identifier. Its ","type":"text"},{"code":"uuid","type":"codeVoice"},{"text":" is the record’s identifier, which a redelivered record keeps. Every","type":"text"},{"text":" ","type":"text"},{"text":"event carries ","type":"text"},{"code":"$process_person_profile: false","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"$geoip_disable: true","type":"codeVoice"},{"text":". The record’s vendor","type":"text"},{"text":" ","type":"text"},{"text":"identifier and trace context aren’t sent, and the standard context is sent as PostHog’s own","type":"text"},{"text":" ","type":"text"},{"text":"properties (","type":"text"},{"code":"$app_version","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$device_model","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$os_name","type":"codeVoice"},{"text":" and the like).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Properties are read through the event’s schema in the ","type":"text"},{"type":"codeVoice","code":"TrackingPlan"},{"text":" the encoder is made with. A","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sensitive"},{"text":" value is never sent, whatever the record reveals, and a property whose name starts with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"$"},{"text":" or is ","type":"text"},{"type":"codeVoice","code":"distinct_id"},{"text":" is left out and logged. A record the encoder can’t write is left out and","type":"text"},{"text":" ","type":"text"},{"text":"the rest of the batch is sent: one the plan doesn’t describe, one whose event name starts with ","type":"text"},{"type":"codeVoice","code":"$"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"one whose event isn’t ","type":"text"},{"type":"codeVoice","code":"Encodable"},{"text":", one holding a value JSON can’t, one whose timestamp has no","type":"text"},{"text":" ","type":"text"},{"text":"ISO 8601 form (NaN, infinite, or more than ","type":"text"},{"type":"codeVoice","code":"Int64.max"},{"text":" milliseconds from 1970), and one too large","type":"text"},{"text":" ","type":"text"},{"text":"for PostHog’s event limit. The destination reports each as ","type":"text"},{"type":"codeVoice","code":"HTTPDropReport.skipped(_:)"},{"text":", a ","type":"text"},{"type":"codeVoice","code":"SkippedRecord"},{"text":" whose","type":"text"},{"text":" ","type":"text"},{"text":"reason is a ","type":"text"},{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogEncodingError","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To send to TraffluentCollector, use ","type":"text"},{"code":"CollectorBatchEncoder","type":"codeVoice"},{"text":" (module ","type":"text"},{"code":"CollectorEncoding","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import HTTPDestinations","import PostHogEncoding","import TrackingPlans","","let plan = try TrackingPlan()","let postHog = try HTTPDestination.postHog(","    projectToken: projectToken,","    host: postHogHost,  \/\/ https:\/\/us.i.posthog.com, https:\/\/eu.i.posthog.com or your own","    plan: plan)","let tracker = Tracker(enrichers: [.sessions()])","let delivery = tracker.records.batch().deliver(to: postHog)"]},{"type":"paragraph","inlineContent":[{"text":"The guide ","type":"text"},{"identifier":"https:\/\/tyler-keith-thompson.github.io\/Traffluent\/documentation\/traffluent\/choosingdestinations","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"covers what PostHog receives, and why, in more detail.","type":"text"}]}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/posthogencoding"]}],"metadata":{"roleHeading":"Framework","role":"collection","title":"PostHogEncoding","symbolKind":"module","externalID":"PostHogEncoding","modules":[{"name":"PostHogEncoding"}]},"references":{"doc://HTTPDestinations/documentation/HTTPDestinations":{"identifier":"doc:\/\/HTTPDestinations\/documentation\/HTTPDestinations","type":"topic","role":"collection","title":"HTTPDestinations","url":"\/documentation\/httpdestinations","kind":"symbol","abstract":[{"text":"Send each batch of records to an HTTP endpoint, and send it again until it arrives.","type":"text"}]},"doc://PostHogEncoding/documentation/PostHogEncoding/PostHogBatchEncoder":{"identifier":"doc:\/\/PostHogEncoding\/documentation\/PostHogEncoding\/PostHogBatchEncoder","abstract":[